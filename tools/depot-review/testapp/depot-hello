"""Depot Hello: the smallest app that goes through Depot review end to end."""
import sys

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gtk  # noqa: E402

VERSION = "@VERSION@"


class Hello(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.nmcmil.DepotHello")

    def do_activate(self):
        window = Gtk.ApplicationWindow(application=self, title="Depot Hello", default_width=720,
                                       default_height=460)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, valign=Gtk.Align.CENTER)
        title = Gtk.Label(label="Hello from Depot")
        title.add_css_class("title-1")
        box.append(title)
        box.append(Gtk.Label(label=f"Reviewed, signed and installed. Version {VERSION}."))
        window.set_child(box)
        window.present()


if __name__ == "__main__":
    sys.exit(Hello().run(sys.argv))
