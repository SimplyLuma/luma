-- SPDX-License-Identifier: Apache-2.0
-- Luma touch roles: a learned contact-role classifier for libinput 1.31.
-- Generated by `touchlab export-plugin` from plugins/luma-touch-roles.lua.in;
-- the model tables below come from a trained model file.
--
-- Every contact on a touchpad or touchscreen is classified at 25, 50, 100
-- and 200 ms after it lands (and at lift); the votes accumulate. Contacts
-- whose role libinput must not track (resting thumb, clicking thumb, palm,
-- brush) get ABS_MT_TOOL_TYPE = MT_TOOL_PALM on their slot: libinput drops
-- them from pointer motion, taps, gestures and the clickfinger count (a
-- lone pressing thumb still clicks left), and on touchscreens cancels the
-- touch. If the role changes back, the slot returns to MT_TOOL_FINGER and
-- libinput takes the touch up again. The firmware's own palm flag always
-- wins. Key presses are read for their time only.
libinput:register({1})

local ROLES = {"point", "second", "thumb-rest", "thumb-click", "palm", "brush"}
local SUPPRESS = {false, false, true, true, true, true}
local WINDOWS = {25, 50, 100, 200}
local VOTE = {[25] = 0.6, [50] = 0.8, [100] = 1.0, [200] = 1.2}
local RELEASE_MARGIN = 0.2       -- a held contact is released only when "track" leads by this much
local KEEP_MS = 5000
local MT_TOOL_FINGER, MT_TOOL_PALM = 0, 2
local NAN = 0 / 0

-- @FORCE_PADS@

-- @MODEL@

-- @EVAL@

local function ok(v) return v == v end
local function hypot(a, b) return math.sqrt(a * a + b * b) end

-- @FEATURES_BEGIN@ (kept in step with touchlab/rfeatures.py contact_features)
local MASK_INPUTS = {"pressure", "force", "size", "confidence", "button", "direct", "keyboard"}
local P_MASKED = {"p_first", "p_max", "p_mean", "p_last", "p_std", "p_rise", "p_t_max_ms", "p_drop",
                  "p_settle_cv", "p_area", "p_rise_ms", "p_at_button"}
local S_MASKED = {"maj_first", "maj_max", "maj_mean", "maj_growth", "min_max", "aspect"}
local C_MASKED = {"conf_first", "conf_frac", "conf_false_ms"}
local K_MASKED = {"since_key_ms", "keys_1s", "keys_300ms", "keys_window"}

local function on(mask, bit) return (mask[bit] or 0) ~= 0 end

local function contact_features(c, others, keys, w, h, mask, window, roles)
  local t_down = c.t_down
  local fin = t_down + window
  local n = 0
  for i = 1, #c.t do
    if c.t[i] <= fin then n = i else break end
  end
  if n < 1 then n = 1 end
  local tq = c.t[n]
  local lifted = c.t_up ~= nil and c.t_up <= fin
  local x0, y0 = c.x[1], c.y[1]
  local f = {window_ms = window}
  for _, bit in ipairs(MASK_INPUTS) do f["m_" .. bit] = on(mask, bit) and 1 or 0 end
  f.x_rel = x0 / w
  f.y_rel = y0 / h
  f.edge_x_mm = math.min(x0, w - x0)
  f.edge_top_mm = y0
  f.edge_bottom_mm = h - y0
  f.edge_min_mm = math.min(f.edge_x_mm, y0, h - y0)
  f.n = n
  f.elapsed_ms = (lifted and c.t_up or math.min(fin, tq)) - t_down
  f.lifted = lifted and 1 or 0
  local path, smax, ssum, still = 0.0, 0.0, 0.0, 0
  for i = 2, n do
    local d = hypot(c.x[i] - c.x[i - 1], c.y[i] - c.y[i - 1])
    local dt = math.max(1e-4, c.t[i] - c.t[i - 1])
    local sp = d / dt * 1000.0
    path = path + d
    ssum = ssum + sp
    if sp > smax then smax = sp end
    if sp < 10.0 then still = still + 1 end
  end
  local net = hypot(c.x[n] - x0, c.y[n] - y0)
  local mdisp = 0.0
  for i = 1, n do
    local d = hypot(c.x[i] - x0, c.y[i] - y0)
    if d > mdisp then mdisp = d end
  end
  f.path_mm = path
  f.net_mm = net
  f.max_disp_mm = mdisp
  f.straightness = path > 1e-6 and net / path or 0.0
  f.speed_max = smax
  f.speed_mean = n > 1 and ssum / (n - 1) or 0.0
  local j = n
  while j > 1 and c.t[j - 1] >= tq - 20.0 do j = j - 1 end
  if j < n then
    f.speed_last = hypot(c.x[n] - c.x[j], c.y[n] - c.y[j]) / math.max(1e-3, tq - c.t[j]) * 1000.0
  else
    f.speed_last = 0.0
  end
  f.still_frac = n > 1 and still / (n - 1) or 1.0
  local acc = 0.0
  if n > 2 and net > 1e-6 then
    local ux, uy = (c.x[n] - x0) / net, (c.y[n] - y0) / net
    for i = 1, n do
      local e = (c.x[i] - x0) * uy - (c.y[i] - y0) * ux
      acc = acc + e * e
    end
  else
    for i = 1, n do acc = acc + (c.x[i] - x0) ^ 2 + (c.y[i] - y0) ^ 2 end
  end
  f.jitter_mm = math.sqrt(acc / n)
  for _, k in ipairs(P_MASKED) do f[k] = NAN end
  if on(mask, "pressure") and ok(c.p[1]) then
    local p = c.p
    local pmax, psum, imax = p[1], 0.0, 1
    for i = 1, n do
      psum = psum + p[i]
      if p[i] > pmax then pmax, imax = p[i], i end
    end
    local pmean = psum / n
    local var = 0.0
    for i = 1, n do var = var + (p[i] - pmean) ^ 2 end
    f.p_first, f.p_max, f.p_mean, f.p_last = p[1], pmax, pmean, p[n]
    f.p_std = math.sqrt(var / n)
    local e = 1
    for i = 1, n do if c.t[i] <= t_down + 30.0 then e = i end end
    f.p_rise = e > 1 and (p[e] - p[1]) / math.max(1e-3, c.t[e] - c.t[1]) * 1000.0 or 0.0
    f.p_t_max_ms = c.t[imax] - t_down
    f.p_drop = pmax - p[n]
    local a = n // 2
    local hs, hv = 0.0, 0.0
    for i = a + 1, n do hs = hs + p[i] end
    local hm = hs / (n - a)
    for i = a + 1, n do hv = hv + (p[i] - hm) ^ 2 end
    f.p_settle_cv = hm > 1e-6 and math.sqrt(hv / (n - a)) / hm or 0.0
    local area = 0.0
    for i = 2, n do area = area + (p[i] + p[i - 1]) * 0.5 * (c.t[i] - c.t[i - 1]) end
    f.p_area = area
    local r = 1
    while r < n and p[r] < 0.8 * pmax do r = r + 1 end
    f.p_rise_ms = c.t[r] - t_down
  end
  for _, k in ipairs(S_MASKED) do f[k] = NAN end
  if on(mask, "size") and ok(c.maj[1]) then
    local mx, ms = c.maj[1], 0.0
    for i = 1, n do
      ms = ms + c.maj[i]
      if c.maj[i] > mx then mx = c.maj[i] end
    end
    f.maj_first, f.maj_max, f.maj_mean = c.maj[1], mx, ms / n
    f.maj_growth = c.maj[n] - c.maj[1]
    if on(mask, "minor") and ok(c.mn[1]) then
      local mn = c.mn[1]
      for i = 1, n do if c.mn[i] > mn then mn = c.mn[i] end end
      f.min_max = mn
      f.aspect = mx / math.max(0.1, mn)
    end
  end
  for _, k in ipairs(C_MASKED) do f[k] = NAN end
  if on(mask, "confidence") and ok(c.conf[1]) then
    local bad, first_bad = 0, -1.0
    for i = 1, n do
      if c.conf[i] < 0.5 then
        bad = bad + 1
        if first_bad < 0 then first_bad = c.t[i] - t_down end
      end
    end
    f.conf_first, f.conf_frac, f.conf_false_ms = c.conf[1], bad / n, first_bad
  end
  f.button, f.button_at_ms = NAN, NAN
  if on(mask, "button") then
    local b = 0
    for i = 1, n do if c.btn[i] > 0 and b == 0 then b = i end end
    f.button = b > 0 and 1 or 0
    f.button_at_ms = b > 0 and c.t[b] - t_down or -1.0
    if b > 0 and on(mask, "pressure") and ok(c.p[b]) then f.p_at_button = c.p[b] end
  end
  local down, now, landed, prev_down, prev_up = 0, 0, 0, -1e18, -1e18
  local nearest, nearest_dy, nearest_speed, nearest_down = NAN, NAN, NAN, NAN
  local nearest_key, moving, still_o, ysum, ycount = nil, 0, 0, 0.0, 0
  local best = {point = NAN, second = NAN, thumb = NAN, palm = NAN}
  for _, o in ipairs(others) do
    if o.t_down < t_down and o.t_down > prev_down then prev_down = o.t_down end
    if o.t_up ~= nil and o.t_up <= t_down and o.t_up > prev_up then prev_up = o.t_up end
    if not (o.t_down > fin or (o.t_up ~= nil and o.t_up < t_down)) then
      if o.t_down <= t_down and (o.t_up == nil or o.t_up > t_down) then
        down = down + 1
        local k = 0
        for i = 1, #o.t do if o.t[i] <= t_down then k = i end end
        if k > 0 then
          local d = hypot(o.x[k] - x0, o.y[k] - y0)
          if not ok(nearest_down) or d < nearest_down then nearest_down = d end
        end
      end
      if o.t_down > t_down then landed = landed + 1 end
      if o.t_down <= tq and (o.t_up == nil or o.t_up > tq) then now = now + 1 end
      local k, k0 = 0, 0
      for i = 1, #o.t do
        if o.t[i] <= tq then
          k = i
          if k0 == 0 and o.t[i] >= t_down then k0 = i end
        end
      end
      if k > 0 then
        local sp = 0.0
        if k0 > 0 and k > k0 then
          local dist = 0.0
          for i = k0 + 1, k do dist = dist + hypot(o.x[i] - o.x[i - 1], o.y[i] - o.y[i - 1]) end
          sp = dist / math.max(1e-3, o.t[k] - o.t[k0]) * 1000.0
        end
        if sp > 15.0 then moving = moving + 1 else still_o = still_o + 1 end
        ysum = ysum + o.y[k]
        ycount = ycount + 1
        local d = hypot(o.x[k] - c.x[n], o.y[k] - c.y[n])
        if not ok(nearest) or d < nearest then
          nearest, nearest_dy, nearest_speed, nearest_key = d, c.y[n] - o.y[k], sp, o.key
        end
        local pr = roles and roles[o.key]
        if pr then
          local vals = {point = pr[1], second = pr[2], thumb = pr[3] + pr[4], palm = pr[5] + pr[6]}
          for _, name in ipairs({"point", "second", "thumb", "palm"}) do
            local v = vals[name]
            if not ok(best[name]) or v > best[name] then best[name] = v end
          end
        end
      end
    end
  end
  f.others_down, f.others_now, f.others_landed = down, now, landed
  f.first_on_pad = down == 0 and 1 or 0
  f.since_prev_down_ms = math.min(5000.0, t_down - prev_down)
  f.since_prev_up_ms = math.min(5000.0, t_down - prev_up)
  f.nearest_mm, f.nearest_down_mm = nearest, nearest_down
  f.nearest_dy_mm, f.nearest_speed = nearest_dy, nearest_speed
  f.others_moving, f.others_still = moving, still_o
  f.rel_y_mm = ycount > 0 and c.y[n] - ysum / ycount or NAN
  for _, k in ipairs(K_MASKED) do f[k] = NAN end
  if on(mask, "keyboard") then
    local last, k1, k3, kw = -1e18, 0, 0, 0
    for _, kt in ipairs(keys) do
      if kt <= t_down then
        if kt > last then last = kt end
        if kt > t_down - 1000.0 then k1 = k1 + 1 end
        if kt > t_down - 300.0 then k3 = k3 + 1 end
      elseif kt <= fin then
        kw = kw + 1
      end
    end
    f.since_key_ms = math.min(10000.0, t_down - last)
    f.keys_1s, f.keys_300ms, f.keys_window = k1, k3, kw
  end
  f.o_point, f.o_second, f.o_thumb, f.o_palm = best.point, best.second, best.thumb, best.palm
  f.nearest_role = NAN
  if roles and nearest_key ~= nil and roles[nearest_key] then
    local pr = roles[nearest_key]
    local top = 1
    for i = 2, #ROLES do if pr[i] > pr[top] then top = i end end
    f.nearest_role = top - 1
  end
  local out = {}
  for i, name in ipairs(NAMES) do
    local v = f[name]
    if v == nil then v = NAN end
    out[i] = v
  end
  return out
end
-- @FEATURES_END@

local function pick(model_idx, row)
  local x = {}
  for j = 1, #model_idx do x[j] = row[model_idx[j]] end
  return x
end

local function index_of(names)
  local pos = {}
  for i, n in ipairs(NAMES) do pos[n] = i end
  local idx = {}
  for j, n in ipairs(names) do idx[j] = pos[n] end
  return idx
end
local IDX1, IDX2 = index_of(STAGE1.features), index_of(STAGE2.features)

-- The others' latest stage-1 opinion that existed at the end of this contact's window.
local function roles_for(c, others, window)
  local fin = c.t_down + window
  local n = 1
  for i = 1, #c.t do if c.t[i] <= fin then n = i end end
  local tq = c.t[n]
  local out = {}
  for _, o in ipairs(others) do
    local bw = nil
    for w, p in pairs(o.s1) do
      local ready = (o.t_up == nil or o.t_up > o.t_down + w) and o.t_down + w or o.t_up
      if ready <= tq and (bw == nil or w > bw) then bw = w end
    end
    if bw then out[o.key] = o.s1[bw] end
  end
  return out
end

-- @RUNTIME_BEGIN@
local keys = {}
local devices = {}
local serial = 0

local function push_key(t)
  keys[#keys + 1] = t
  if #keys > 64 then table.remove(keys, 1) end
end

local function evaluate(dev, c, window)
  local others = {}
  for _, o in pairs(dev.slots) do if o ~= c then others[#others + 1] = o end end
  for _, o in ipairs(dev.recent) do others[#others + 1] = o end
  -- The role context only fills the stage-2 columns, so one row serves both stages.
  local roles = roles_for(c, others, window)
  local row = contact_features(c, others, keys, dev.w, dev.h, dev.mask, window, roles)
  c.s1[window] = softmax(model_raw(STAGE1, pick(IDX1, row)))
  local p = softmax(model_raw(STAGE2, pick(IDX2, row)))
  for k = 1, #ROLES do c.votes[k] = c.votes[k] + VOTE[window] * p[k] end
  local top = 1
  for k = 2, #ROLES do if c.votes[k] > c.votes[top] then top = k end end
  c.role = top
  local z, track = 0.0, 0.0
  for k = 1, #ROLES do
    z = z + c.votes[k]
    if not SUPPRESS[k] then track = track + c.votes[k] end
  end
  c.track_share = track / z
end

local function due(dev, c, now_ms)
  local changed = false
  for _, w in ipairs(WINDOWS) do
    if not c.done[w] and (c.t_down + w <= now_ms or (c.t_up ~= nil)) and #c.t > 0 then
      c.done[w] = true
      evaluate(dev, c, w)
      changed = true
    end
  end
  return changed
end

-- The tool type libinput should see for a slot. A held contact is released only
-- when "track" leads clearly, so a borderline contact doesn't flicker.
local function wanted_tool(dev, slot, c)
  if c.kernel_palm then return MT_TOOL_PALM end
  -- Before the first window a new contact shows the kernel's tool type: it must not inherit the
  -- palm flag this plugin set on the slot's previous contact.
  if c.role == nil then return dev.ktool[slot] or MT_TOOL_FINGER end
  local shown = dev.ltool[slot] or MT_TOOL_FINGER
  if SUPPRESS[c.role] then return MT_TOOL_PALM end
  if shown == MT_TOOL_PALM and c.track_share < 0.5 + RELEASE_MARGIN then return MT_TOOL_PALM end
  return MT_TOOL_FINGER
end

local function changes(dev, out)
  for slot, c in pairs(dev.slots) do
    local want = wanted_tool(dev, slot, c)
    if want ~= (dev.ltool[slot] or MT_TOOL_FINGER) then
      out[#out + 1] = {usage = evdev.ABS_MT_SLOT, value = slot}
      out[#out + 1] = {usage = evdev.ABS_MT_TOOL_TYPE, value = want}
      dev.ltool[slot] = want
    end
  end
  if #out > 0 then out[#out + 1] = {usage = evdev.ABS_MT_SLOT, value = dev.cur_slot} end
  return out
end

local function next_due(now_ms)
  local best = nil
  for _, dev in ipairs(devices) do
    for _, c in pairs(dev.slots) do
      for _, w in ipairs(WINDOWS) do
        if not c.done[w] then
          local t = c.t_down + w
          if best == nil or t < best then best = t end
          break
        end
      end
    end
  end
  if best then libinput:timer_set_absolute(math.floor(best * 1000)) end
end

local function trim_recent(dev, now_ms)
  local keep = {}
  for _, o in ipairs(dev.recent) do
    if o.t_up and o.t_up >= now_ms - KEEP_MS then keep[#keep + 1] = o end
  end
  dev.recent = keep
end

local function frame_handler(dev)
  return function(_device, frame, timestamp)
    local now_ms = timestamp / 1000.0
    local out, rewrote = {}, false
    local touched = {}
    for _, e in ipairs(frame) do
      local u, v = e.usage, e.value
      local keep = true
      if u == evdev.ABS_MT_SLOT then
        dev.cur_slot = v
      elseif u == evdev.ABS_MT_TRACKING_ID then
        local s = dev.cur_slot
        if v >= 0 then
          serial = serial + 1
          -- The kernel sends only changed values per slot, so the slot's last tool type
          -- (and position, pressure, size) carry over to the new contact.
          dev.slots[s] = {key = serial, t_down = now_ms, t = {}, x = {}, y = {}, p = {}, maj = {}, mn = {},
                          conf = {}, btn = {}, s1 = {}, votes = {0, 0, 0, 0, 0, 0}, done = {},
                          kernel_palm = (dev.ktool[s] or MT_TOOL_FINGER) == MT_TOOL_PALM}
        elseif dev.slots[s] then
          local c = dev.slots[s]
          c.t_up = now_ms
          due(dev, c, now_ms)
          dev.slots[s] = nil
          dev.recent[#dev.recent + 1] = c
        end
      elseif u == evdev.ABS_MT_TOOL_TYPE then
        local s = dev.cur_slot
        dev.ktool[s] = v
        local c = dev.slots[s]
        local want = v
        if c then
          c.kernel_palm = v == MT_TOOL_PALM
          want = wanted_tool(dev, s, c)
        end
        if want ~= v then
          out[#out + 1] = {usage = u, value = want}
          keep, rewrote = false, true
        end
        dev.ltool[s] = want
      elseif u == evdev.BTN_LEFT then
        dev.button = v
      else
        local r = dev.raw[dev.cur_slot]
        if r == nil then
          r = {}
          dev.raw[dev.cur_slot] = r
        end
        if u == evdev.ABS_MT_POSITION_X then r.x = v
        elseif u == evdev.ABS_MT_POSITION_Y then r.y = v
        elseif u == evdev.ABS_MT_PRESSURE then r.p = v
        elseif u == evdev.ABS_MT_TOUCH_MAJOR then r.maj = v
        elseif u == evdev.ABS_MT_TOUCH_MINOR then r.mn = v
        end
      end
      if keep then out[#out + 1] = e end
    end
    -- One sample per active contact per frame.
    for s, c in pairs(dev.slots) do
      local r = dev.raw[s]
      if r and r.x and r.y then
        local i = #c.t + 1
        c.t[i] = now_ms
        c.x[i] = (r.x - dev.x0) / dev.rx
        c.y[i] = (r.y - dev.y0) / dev.ry
        c.p[i] = (dev.mask.pressure == 1 and r.p) and (r.p - dev.p0) / dev.pr or NAN
        c.maj[i] = (dev.mask.size == 1 and r.maj) and r.maj / dev.rx or NAN
        c.mn[i] = (dev.mask.minor == 1 and r.mn) and r.mn / dev.rx or NAN
        c.conf[i] = dev.mask.confidence == 1 and (c.kernel_palm and 0.0 or 1.0) or NAN
        c.btn[i] = dev.button
        if i > 400 then
          -- Keep the first 40 samples (this contact's own windows) and the recent past (for
          -- contacts that land later); drop the middle so a long rest stays small.
          for _, a in ipairs({c.t, c.x, c.y, c.p, c.maj, c.mn, c.conf, c.btn}) do table.remove(a, 41) end
        end
      end
    end
    for _, c in pairs(dev.slots) do due(dev, c, now_ms) end
    trim_recent(dev, now_ms)
    local extra = changes(dev, {})
    if #extra > 0 or rewrote then
      local last = out[#out]
      if last and last.usage == evdev.SYN_REPORT then
        out[#out] = nil
        for _, e in ipairs(extra) do out[#out + 1] = e end
        out[#out + 1] = last
      else
        for _, e in ipairs(extra) do out[#out + 1] = e end
      end
    end
    next_due(now_ms)
    if #extra > 0 or rewrote then return out end
  end
end

libinput:connect("timer-expired", function(now_us)
  local now_ms = now_us / 1000.0
  for _, dev in ipairs(devices) do
    local any = false
    for _, c in pairs(dev.slots) do any = due(dev, c, now_ms) or any end
    if any then
      local extra = changes(dev, {})
      if #extra > 0 then
        extra[#extra + 1] = {usage = evdev.SYN_REPORT, value = 0}
        dev.device:append_frame(extra)
      end
    end
  end
  next_due(now_ms)
end)

local function axis_mm(a, fallback_mm)
  if a.resolution and a.resolution > 0 then return a.resolution end
  return (a.maximum - a.minimum) / fallback_mm
end

libinput:connect("new-evdev-device", function(device)
  local props = device:udev_properties()
  if props.ID_INPUT_KEYBOARD == "1" and props.ID_INPUT_TOUCHPAD ~= "1" then
    device:connect("evdev-frame", function(_d, frame, timestamp)
      for _, e in ipairs(frame) do
        -- Only the time of a press; the key itself is never kept.
        if (e.usage >> 16) == 1 and e.value == 1 then push_key(timestamp / 1000.0) break end
      end
    end)
    return
  end
  local direct = props.ID_INPUT_TOUCHSCREEN == "1"
  if props.ID_INPUT_TOUCHPAD ~= "1" and not direct then return end
  local abs, usages, info = device:absinfos(), device:usages(), device:info()
  local ax, ay = abs[evdev.ABS_MT_POSITION_X], abs[evdev.ABS_MT_POSITION_Y]
  if not ax or not ay then return end
  local rx, ry = axis_mm(ax, direct and 70 or 100), axis_mm(ay, direct and 150 or 60)
  local pa = abs[evdev.ABS_MT_PRESSURE]
  local id = string.format("%04x:%04x:%04x", info.bustype or 0, info.vid or 0, info.pid or 0)
  local force = FORCE_PADS[id] or (pa ~= nil and (pa.resolution or 0) > 0)
  local external = props.ID_INTEGRATION == "external"
  local dev = {
    device = device, slots = {}, recent = {}, raw = {}, ktool = {}, ltool = {}, cur_slot = 0, button = 0,
    x0 = ax.minimum, y0 = ay.minimum, rx = rx, ry = ry,
    w = (ax.maximum - ax.minimum) / rx, h = (ay.maximum - ay.minimum) / ry,
    p0 = pa and pa.minimum or 0, pr = pa and math.max(1, pa.maximum - pa.minimum) or 1,
    mask = {
      pressure = pa and 1 or 0, force = (pa and force) and 1 or 0,
      size = abs[evdev.ABS_MT_TOUCH_MAJOR] and 1 or 0,
      minor = (abs[evdev.ABS_MT_TOUCH_MAJOR] and abs[evdev.ABS_MT_TOUCH_MINOR]) and 1 or 0,
      confidence = abs[evdev.ABS_MT_TOOL_TYPE] and 1 or 0,
      button = (usages[evdev.BTN_LEFT] and not direct) and 1 or 0,
      direct = direct and 1 or 0, keyboard = (not direct and not external) and 1 or 0,
    },
  }
  if not abs[evdev.ABS_MT_TOOL_TYPE] then
    -- libinput only honours MT_TOOL_PALM on devices with a tool-type axis (tp->palm.use_mt_tool);
    -- add one before libinput configures the device. The mask keeps confidence = 0: the
    -- firmware never sets it, only this plugin does.
    device:set_absinfo(evdev.ABS_MT_TOOL_TYPE, {minimum = 0, maximum = 2, resolution = 0, fuzz = 0, flat = 0})
  end
  devices[#devices + 1] = dev
  device:connect("evdev-frame", frame_handler(dev))
  libinput:log_info(string.format("luma-touch-roles: %s (%s), %.0fx%.0f mm, pressure %d force %d size %d conf %d",
                                  device:name(), id, dev.w, dev.h, dev.mask.pressure, dev.mask.force,
                                  dev.mask.size, dev.mask.confidence))
end)
-- @RUNTIME_END@
