  ],
  "phone_states": [
    "month",
    "week",
    "flow",
    "day",
    "empty-day",
    "event",
    "holiday",
    "calendars",
    "date-menu",
    "panel-closed",
    "new-event",
    "event-more",
    "quick-parsed",
    "parsed-editor",
    "invitee-suggestions",
    "draft-alerts",
    "rsvp-maybe",
    "video-call",
    "draft-day",
    "draft-start",
    "draft-end",
    "draft-calendar"
  ],
  "groups": [
    {
      "name": "window controls",
      "spec": "#w-calendar > .wctl",
      "info_only": true
    },
    {
      "name": "title row",
      "spec": "#cal-top"
    },
    {
      "name": "action center",
      "spec": "#cal-draft"
    },
    {
      "name": "action bar",
      "spec": "#cal-bar"
    },
    {
      "name": "details",
      "spec": "#cal-det"
    },
    {
      "name": "date heading",
      "spec": "#cal-head"
    },
    {
      "name": "corner pill",
      "spec": "#cal-cals"
    },
    {
      "name": "menu",
      "spec": "#w-calendar > .pop"
    },
    {
      "name": "month",
      "spec": "#cal-body .cmonth"
    },
    {
      "name": "week",
      "spec": "#cal-body .cweek"
    },
    {
      "name": "flow",
      "spec": "#cal-body .cflow"
    },
    {
      "name": "main",
      "spec": "#cal-main"
    }
  ],
  "pairs": [
    {
      "spec": "#cal-main",
      "gtk": "cal-main",
      "name": "island"
    },
    {
      "spec": "#cal-head",
      "gtk": "cal-head",
      "name": "date heading"
    },
    {
      "spec": "#cal-cals",
      "gtk": "cal-cals",
      "name": "corner pill"
    },
    {
      "spec": "#cal-body",
      "gtk": "cal-body",
      "name": "calendar surface"
    },
    {
      "spec": "#cal-det",
      "gtk": "cal-det",
      "name": "details pane"
    },
    {
      "spec": "#cal-bar",
      "gtk": "cal-bar",
      "name": "quick entry"
    },
    {
      "spec": "#cal-draft",
      "gtk": "cal-draft",
      "name": "event editor"
    }
  ],
  "about": "Calendar fixtures and Studio both use 10:30 AM so queued captures compare the same now-line, free time and quick-entry defaults."
}
