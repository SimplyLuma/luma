          "click": "[data-arinew]"
        },
        {
          "eval": "(() => { const timeout = window.setTimeout.bind(window); window.setTimeout = (fn, ms, ...args) => timeout(fn, ms === 900 ? 5000 : ms, ...args); })()"
        },
        {
          "click": "[data-arisug=\"local\"]",
          "wait": 1
        }
      ],
      "gtk": [
        {
          "env": {
            "LUMA_ARI_STATE": "busy"
          }
        }
      ]
    },
    {
      "name": "model-downloading",
      "spec": [
        {
          "click": "[data-ariview=\"models\"]"
        },
        {
          "eval": "(() => { const interval = window.setInterval.bind(window); window.setInterval = (fn, ms, ...args) => { if (ms !== 260) return interval(fn, ms, ...args); const id = interval(() => { const random = Math.random; Math.random = () => .8; try { for (let i = 0; i < 5; i++) fn(...args); } finally { Math.random = random; clearInterval(id); } }, ms); return id; }; })()"
        },
        {
          "click": "[data-arget=\"qwen14\"]"
        }
      ],
      "gtk": [
        {
          "env": {
            "LUMA_ARI_STATE": "model-downloading"
          }
        }
      ]
    },
    {
      "name": "provider-checking",
      "spec": [
        {
          "click": "[data-ariview=\"models\"]"
        },
        {
          "click": ".aricl [data-arikey=\"openai\"]"
        },
        {
          "eval": "(() => { const e = document.querySelector(\"[data-apkey]\"); e.value = \"fixture-test-key\"; e.dispatchEvent(new Event('input', {bubbles:true})); })()"
        },
        {
          "eval": "(() => { const timeout = window.setTimeout.bind(window); window.setTimeout = (fn, ms, ...args) => timeout(fn, ms === 900 ? 5000 : ms, ...args); })()"
        },
        {
          "click": "[data-aptest]",
          "wait": 1
        }
      ],
      "gtk": [
        {
          "env": {
            "LUMA_ARI_STATE": "provider-checking"
          }
        }
      ]
    },
    {
      "name": "approval-working",
      "spec": [
        {
          "eval": "(() => { const original = window.setTimeout; window.setTimeout = (fn, ms, ...args) => original(fn, ms === 1100 ? 5000 : ms, ...args); })()"
        },
        {
          "click": "[data-ariok=\"budget\"]"
        },
        {
          "eval": "(() => { const win = document.querySelector('#w-ari'); if (win.classList.contains('phone') && !win.classList.contains('navopen')) win.querySelector('[data-navtoggle]').click(); })()"
        },
        {
          "click": "[data-ariview=\"activity\"]"
        },
        {
          "eval": "(() => { const win = document.querySelector('#w-ari'); if (win.classList.contains('phone') && win.classList.contains('navopen')) win.querySelector('[data-navtoggle]').click(); })()"
        },
        {
          "eval": "(() => { const win = document.querySelector('#w-ari'); if (win.classList.contains('phone') && !win.classList.contains('navopen')) win.querySelector('[data-navtoggle]').click(); })()"
        },
        {
          "click": "[data-aric=\"budget\"]"
        },
        {
          "eval": "(() => { const win = document.querySelector('#w-ari'); if (win.classList.contains('phone') && win.classList.contains('navopen')) win.querySelector('[data-navtoggle]').click(); })()"
        },
        {
          "wait": 100
        },
        {
          "eval": "(() => { const win = document.querySelector('#w-ari'), card = win.querySelector('[data-arichain=\"budget\"]'); if (!card || !card.querySelector('.aristate.run') || !card.querySelector('.arstep .arispin')) throw new Error('pending approval receipt must show Working and spinner'); if (card.querySelector('[data-ariok]') || card.querySelector('[data-arino]') || card.querySelector('[data-ariundo]')) throw new Error('pending approval must remove decision actions'); if (win.classList.contains('phone')) { if (win.classList.contains('navopen')) throw new Error('choosing chat must close Places drawer'); const c = card.getBoundingClientRect(), w = win.getBoundingClientRect(); if (c.left < w.left || c.right > w.right) throw new Error('pending receipt clips at phone width'); } })()"
        }
      ],
      "gtk": [
        {
          "env": {
            "LUMA_ARI_STATE": "approval-working"
          }
        }
      ]
    },
    {
      "name": "provider-error",
      "spec": [
        {
          "click": "[data-ariview=\"models\"]"
        },
        {
          "eval": "(() => { const assign = Object.assign; delete window.__ariProviderState; window.__ariRestoreAssign = () => { Object.assign = assign; }; Object.assign = function(target, ...sources) { const result = assign(target, ...sources); if (sources.some(value => value && value.step === 'key' && ['prov', 'key', 'test', 'sel'].every(key => Object.prototype.hasOwnProperty.call(value, key)))) { window.__ariProviderState = target; Object.assign = assign; } return result; }; })()"
        },
        {
          "click": ".aricl [data-arikey=\"openai\"]"
        },
        {
          "eval": "(() => { window.__ariRestoreAssign?.(); delete window.__ariRestoreAssign; if (!window.__ariProviderState) throw new Error('Provider fixture must capture the private reference state'); const e = document.querySelector('[data-apkey]'); e.value = 'fixture-test-key'; e.dispatchEvent(new Event('input', {bubbles:true})); })()"
        },
        {
          "click": "[data-aptest]",
          "wait": 1200
        },
        {
          "eval": "(() => { const provider = window.__ariProviderState, choice = document.querySelector('#ari-sheet [data-apmod]'); if (!provider || !choice) throw new Error('Provider fixture must reach the existing model renderer'); provider.test = 'bad'; choice.click(); provider.sel = {}; delete window.__ariProviderState; if (!document.querySelector('.aptest.bad')?.textContent.includes('That key didn’t work')) throw new Error('Provider failure feedback must remain visible'); if (document.querySelector('[data-aptest]').disabled) throw new Error('Provider check must permit retry'); })()"
        }
      ],
      "gtk": [
        {
          "env": {
            "LUMA_ARI_STATE": "provider-error"
          }
        }
      ]
    }
