{
  "app": "memos",
  "title": "Memos",
  "spec": {
    "url": "mockups/luma-next-70.html?app=memos",
    "phone_url": "mockups/luma-next-71.html?phone=1",
    "phone_before": [{"eval": "lumaPhone.open('memos')", "wait": 1500}],
    "phone_viewport": {"width": 390, "height": 844},
    "window": "#w-memos",
    "exclude": [".grip", ".pop.toast-gone"]
  },
  "gtk": {
    "module": "voice_memos",
    "fixtures": ["tests/fixtures/memos-v70.json", "tests/fixtures/memos-v70"],
    "env": {"LUMA_MEMOS_FIXTURE": "{run}/fixtures/memos-v70.json"}
  },
  "states": [
    {"name": "memo", "about": "Launch dry run, the opening state", "spec": [], "gtk": []},
    {"name": "search", "about": "Search inside spoken words", "spec": [{"eval": "(() => { const e=document.querySelector('#me-side [data-meq]'); e.value='notification lip'; e.dispatchEvent(new Event('input',{bubbles:true})); })()"}], "gtk": [{"env": {"LUMA_MEMOS_SEARCH": "notification lip"}}]},
    {"name": "music", "about": "A recording with no speech", "spec": [{"click": "[data-meopen=\"hum\"]"}], "gtk": [{"env": {"LUMA_MEMOS_STATE": "music"}}]},
    {"name": "filter-menu", "about": "Sidebar foot filter menu", "spec": [{"click": "#me-side [data-lui-filter]"}], "gtk": [{"activate": "me-filter"}]},
    {"name": "favourites", "about": "Sidebar foot filter and its list heading", "spec": [{"click": "#me-side [data-lui-filter]"}, {"click": "[data-meview=\"fav\"]"}], "spec_phone": [{"click": "[data-mepx=\"show\"]"}, {"click": "[data-meview=\"fav\"]"}], "gtk": [{"env": {"LUMA_MEMOS_STATE": "favourites"}}]},
    {"name": "deleted-empty", "about": "Recently deleted empty state", "spec": [{"click": "#me-side [data-lui-filter]"}, {"click": "[data-meview=\"deleted\"]"}], "spec_phone": [{"click": "[data-mepx=\"show\"]"}, {"click": "[data-meview=\"deleted\"]"}], "gtk": [{"env": {"LUMA_MEMOS_STATE": "deleted-empty"}}]},
    {"name": "more", "about": "The current memo's More menu", "spec": [{"click": "[data-memore]"}], "gtk": [{"activate": "me-more"}]},
    {"name": "share", "about": "Share the current memo", "spec": [{"click": "[data-meshare]"}], "gtk": [{"activate": "me-share"}]},
    {"name": "speed", "about": "Playback speed menu", "spec": [{"click": "[data-mespeed]"}], "gtk": [{"activate": "me-speed"}]},
    {"name": "recording", "about": "Recording at 1.4 seconds with its first live word", "spec": [{"eval": "(async()=>{const raf=requestAnimationFrame.bind(window),cancel=cancelAnimationFrame.bind(window);let hold=false;const pending=new Set;window.requestAnimationFrame=cb=>{if(hold)return 0;let id=raf(t=>{pending.delete(id);cb(t)});pending.add(id);return id};if(!document.querySelector('[data-merec]'))document.querySelector('[data-mepx=\"new\"]').click();document.querySelector('[data-merec]').click();await new Promise(resolve=>{const check=()=>{const sub=document.querySelector('#me-body .metime.big small'),word=document.querySelector('#me-body .metx.live span');if(sub?.textContent.trim()==='.4'&&word?.textContent.includes('Reminder')){hold=true;for(const id of pending)cancel(id);resolve()}else raf(check)};check()})})()"}], "gtk": [{"env": {"LUMA_MEMOS_STATE": "recording"}}]},
    {"name": "list", "about": "A phone opens on its list", "phone_only": true, "spec": [], "gtk": []},
    {"name": "page", "about": "Launch dry run pushed from the list", "phone_only": true, "spec": [{"click": "[data-meopen=\"dry\"]"}], "gtk": [{"env": {"LUMA_MEMOS_STATE": "open"}}]},
    {"name": "show-panel", "about": "The list bar grown into Show", "phone_only": true, "spec": [{"click": "[data-mepx=\"show\"]"}], "gtk": [{"env": {"LUMA_MEMOS_PANEL": "show"}}]},
    {"name": "new-panel", "about": "The list bar grown into New memo", "phone_only": true, "spec": [{"click": "[data-mepx=\"new\"]"}], "gtk": [{"env": {"LUMA_MEMOS_PANEL": "new"}}]},
    {"name": "share-panel", "about": "The memo bar grown into Share", "phone_only": true, "spec": [{"click": "[data-meopen=\"dry\"]"}, {"click": "[data-mepx=\"share\"]"}], "gtk": [{"env": {"LUMA_MEMOS_STATE": "open", "LUMA_MEMOS_PANEL": "share"}}]},
    {"name": "more-panel", "about": "The memo bar grown into More", "phone_only": true, "spec": [{"click": "[data-meopen=\"dry\"]"}, {"click": "[data-mepx=\"more\"]"}], "gtk": [{"env": {"LUMA_MEMOS_STATE": "open", "LUMA_MEMOS_PANEL": "more"}}]}
  ],
  "phone_states": ["list", "page", "search", "music", "favourites", "deleted-empty", "show-panel", "new-panel", "share-panel", "more-panel", "recording"],
  "groups": [
    {"name": "window controls", "spec": "#w-memos > .wctl", "info_only": true},
    {"name": "title row", "spec": "#me-top"},
    {"name": "title island", "spec": "#me-isl"},
    {"name": "sidebar foot", "spec": "#me-side .sfoot"},
    {"name": "sidebar", "spec": "#me-side"},
    {"name": "corner", "spec": "#me-corner"},
    {"name": "recording deck", "spec": "#me-body .medeck"},
    {"name": "transcript", "spec": "#me-body .metx"},
    {"name": "action bar", "spec": "#me-bar"},
    {"name": "menu", "spec": "#w-memos > .pop, #w-memos > .crpop"},
    {"name": "main", "spec": "#me-main"}
  ],
  "pairs": [
    {"spec": "#me-side", "gtk": "me-sidebar", "name": "sidebar"},
    {"spec": "#me-main", "gtk": "me-island", "name": "island"},
    {"spec": "#me-corner", "gtk": "me-corner", "name": "corner pill"},
    {"spec": "#me-bar", "gtk": "me-action", "name": "action center"},
    {"spec": "#me-isl", "gtk": "me-title-island", "name": "title island"}
  ]
}
