          "eval": "(() => { const menu=document.querySelector('#vw-pop'); if (!menu || !menu.getClientRects().length) throw new Error('Detected-text actions did not open'); const actions=menu.querySelectorAll('[data-vwddgo]'); if (actions.length < 2 || !menu.textContent.includes('Copy')) throw new Error('Detected-text actions missing'); })()"
