          "eval": "(async () => { const button=document.querySelector('[data-vwpage=\"3\"]'); if (!button.classList.contains('on')) throw new Error('Page 3 did not select'); const page=document.querySelector('.vwpage[data-page=\"3\"]'), scroll=document.querySelector('#vw-pscroll'), target=page.offsetTop-60, deadline=performance.now()+2000; let settled=0; while (performance.now()<deadline && settled<2) { settled=Math.abs(scroll.scrollTop-target)<=2 ? settled+1 : 0; await new Promise(resolve=>setTimeout(resolve,16)); } if (!button.classList.contains('on')) throw new Error('Page 3 did not stay selected'); if (settled<2 || Math.abs(scroll.scrollTop-target)>2) throw new Error('Page 3 did not scroll: '+JSON.stringify({actual:scroll.scrollTop,target,maximum:scroll.scrollHeight-scroll.clientHeight})); })()"
