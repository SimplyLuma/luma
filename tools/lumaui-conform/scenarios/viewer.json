      "gtk": [
        {
          "env": {
            "LUMA_VIEWER_STATE": "information",
            "LUMA_VIEWER_SELECTED": "offsite",
            "LUMA_VIEWER_MODE": "view"
          }
        }
      ]
    },
    {
      "name": "markup",
      "spec": [
        {
          "click": "[data-vwopen=\"offsite\"]"
        },
        {
          "click": "[data-vwmode=\"markup\"]"
        }
