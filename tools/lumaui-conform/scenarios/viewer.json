    {
      "name": "pdf-page-2",
      "spec": [
        {
          "click": "[data-vwopen=\"lease\"]"
        },
        {
          "click": "[data-vwpage=\"2\"]",
          "wait": 600
        },
        {
          "eval": "(async () => { const button=document.querySelector('[data-vwpage=\"2\"]'); if (!button.classList.contains('on')) throw new Error('Page 2 did not select'); const page=document.querySelector('.vwpage[data-page=\"2\"]'), scroll=document.querySelector('#vw-pscroll'), target=page.offsetTop-60, deadline=performance.now()+2000; let settled=0; while (performance.now()<deadline && settled<2) { settled=Math.abs(scroll.scrollTop-target)<=2 ? settled+1 : 0; await new Promise(resolve=>setTimeout(resolve,16)); } if (!button.classList.contains('on')) throw new Error('Page 2 did not stay selected'); if (settled<2 || Math.abs(scroll.scrollTop-target)>2) throw new Error('Page 2 did not scroll: '+JSON.stringify({actual:scroll.scrollTop,target,maximum:scroll.scrollHeight-scroll.clientHeight})); })()"
        }
      ],
      "gtk": [
        {
          "env": {
            "LUMA_VIEWER_STATE": "pdf-page-2",
            "LUMA_VIEWER_SELECTED": "lease",
            "LUMA_VIEWER_MODE": "view"
          }
        },
        {
          "activate": "vw-page-thumbnail-2"
        }
      ],
      "about": "Desktop and phone activate the visible page 2 thumbnail, scroll to that PDF page and update the page counter; no substituted phone state."
    },
    {
      "name": "pdf-page-3",
      "spec": [
        {
          "click": "[data-vwopen=\"lease\"]"
