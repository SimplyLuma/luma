    },
    {
      "name": "pdf-filled",
      "spec": [
        {
          "click": "[data-vwopen=\"lease\"]"
        },
        {
          "eval": "(() => { const values = {tenant: 'Nick Field', orig: '01/01/2026', date: '09/25/2026'}; for (const [key, value] of Object.entries(values)) { const entry = document.querySelector('[data-vwfld=\"' + key + '\"]'); entry.value = value; entry.dispatchEvent(new Event('input', {bubbles: true})); } })()"
        },
        {
          "eval": "(() => { for (const [key,value] of Object.entries({tenant:'Nick Field',orig:'01/01/2026',date:'09/25/2026'})) { if (document.querySelector('[data-vwfld=\"'+key+'\"]').value!==value) throw new Error('PDF field '+key+' not filled'); } })()"
        }
      ],
      "gtk": [
        {
          "env": {
            "LUMA_VIEWER_STATE": "pdf-filled",
            "LUMA_VIEWER_SELECTED": "lease",
            "LUMA_VIEWER_MODE": "view"
          }
        }
      ],
      "about": "The same three editable PDF fields retain entered values on desktop and phone; no substituted phone state. Capture assertions inspect native field values."
