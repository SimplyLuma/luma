      "gtk": [
        {
          "env": {
            "LUMA_VIEWER_STATE": "markup",
            "LUMA_VIEWER_SELECTED": "offsite",
            "LUMA_VIEWER_MODE": "markup"
          }
        }
      ]
    },
    {
      "name": "inline-editor",
      "about": "The same actual annotation textbox opens at a document point on desktop and phone; keyboard/focus commit and cancel are tested natively.",
      "spec": [
        {
          "click": "[data-vwopen=\"offsite\"]"
        },
        {
          "click": "[data-vwmode=\"markup\"]"
        },
        {
          "click": "[data-vwtool=\"text\"]"
        },
        {
          "eval": "(() => { const s=document.querySelector('#vw-ann'),r=s.getBoundingClientRect();s.dispatchEvent(new PointerEvent('pointerdown',{bubbles:true,button:0,clientX:r.left+r.width*.2,clientY:r.top+r.height*.2})); })()"
        },
        {
          "eval": "(() => { const input=document.querySelector('#vw-tin'); if (!input || !input.getClientRects().length || input.placeholder!=='Type here' || input.getAttribute('aria-label')!=='Text to place' || input.value!=='') throw new Error('Annotation editor did not open'); })()"
        }
      ],
      "gtk": [
        {
          "env": {
            "LUMA_VIEWER_STATE": "inline-editor",
            "LUMA_VIEWER_SELECTED": "offsite",
            "LUMA_VIEWER_MODE": "markup"
          }
        }
      ]
    },
