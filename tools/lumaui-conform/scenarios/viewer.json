{
  "app": "viewer",
  "title": "Viewer",
  "spec": {
    "url": "mockups/luma-next-70.html?app=viewer",
    "window": "#w-viewer",
    "exclude": [
      ".grip",
      ".pop.toast-gone"
    ]
  },
  "gtk": {
    "module": "luma_viewer.application",
    "pythonpath": [
      "src/luma-viewer"
    ],
    "fixtures": [
      "tests/fixtures/viewer-v70.json",
      "tests/fixtures/viewer-v70",
      "tests/fixtures/viewer-v70-data"
    ],
    "env": {
      "LUMA_VIEWER_FIXTURE": "{run}/fixtures/viewer-v70.json",
      "LUMA_VIEWER_STYLE_PATH": "{run}/src/src/luma-viewer/viewer.css",
      "XDG_DATA_HOME": "{run}/fixtures/viewer-v70-data",
      "XDG_DATA_DIRS": "{run}/fixtures/viewer-v70-data:/usr/local/share:/usr/share"
    }
  },
  "states": [
    {
      "name": "view",
      "spec": [
        {
          "click": "[data-vwopen=\"offsite\"]"
        }
      ],
      "gtk": [
        {
          "env": {
            "LUMA_VIEWER_STATE": "view",
            "LUMA_VIEWER_SELECTED": "offsite",
            "LUMA_VIEWER_MODE": "view"
          }
        }
      ]
    },
    {
      "name": "information",
      "spec": [
        {
          "click": "[data-vwopen=\"offsite\"]"
        },
        {
