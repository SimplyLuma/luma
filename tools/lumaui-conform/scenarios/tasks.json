  "groups": [
    {
      "name": "window controls",
      "spec": "#w-tasks > .wctl",
      "info_only": true
    },
    {
      "name": "title row",
      "spec": "#tk-top"
    },
    {
      "name": "sidebar foot",
      "spec": "#tk-side .tkfoot"
    },
    {
      "name": "sidebar",
      "spec": "#tk-side"
    },
    {
      "name": "menu",
