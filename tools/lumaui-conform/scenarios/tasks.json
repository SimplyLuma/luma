    {
      "name": "task",
      "spec": [
        {
          "click": "[data-tkpick=\"t100\"]"
        }
      ],
      "gtk": [
        {
          "activate": "tk-pick-t100"
        }
      ]
    },
    {
      "name": "due",
      "spec": [
        {
          "click": "[data-tkpick=\"t100\"]"
        },
        {
          "click": "#tk-det [data-tkdue]"
        }
      ],
      "gtk": [
        {
          "activate": "tk-pick-t100"
        },
        {
          "activate": "tk-due"
        }
      ]
    },
    {
      "name": "assigned",
      "spec": [
        {
          "click": "[data-tkpick=\"t100\"]"
