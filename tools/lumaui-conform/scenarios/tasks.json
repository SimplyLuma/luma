        }
      ],
      "gtk": [
        {
          "activate": "tk-pick-t100"
        },
        {
          "activate": "tk-assign"
        }
      ]
    },
    {
      "name": "move",
      "spec": [
        {
          "click": "[data-tkpick=\"t100\"]"
        },
        {
          "click": "#tk-det [data-tkmove]"
        }
      ],
      "gtk": [
        {
          "activate": "tk-pick-t100"
        },
        {
          "activate": "tk-move"
        }
      ]
    },
    {
      "name": "more",
      "spec": [
