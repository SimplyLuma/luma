    {
      "name": "task details",
      "spec": "#tk-det"
    },
    {
      "name": "suggestions",
      "spec": "#tk-body .tkgrp.sug"
    },
    {
      "name": "main",
      "spec": "#tk-main"
    }
  ],
  "groups_note": "Items take the first group whose spec box contains them, so list inner regions before outer ones. info_only groups are reported, never failed.",
