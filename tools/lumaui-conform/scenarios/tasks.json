      ],
      "gtk": [
        {
          "activate": "tk-pick-t100"
        },
        {
          "activate": "tk-more"
        }
      ]
    },
    {
      "name": "share",
      "spec": [
        {
          "click": "[data-tkview=\"launch\"]"
        },
        {
          "click": "[data-tkshare]"
        }
      ],
      "gtk": [
        {
          "activate": "tk-view-launch"
        },
        {
          "activate": "tk-share"
        }
      ]
    },
    {
      "name": "launch-done",
      "spec": [
        {
          "click": "[data-tkview=\"launch\"]"
        },
        {
          "click": "[data-tkshowdone]"
        }
      ],
      "gtk": [
        {
          "activate": "tk-view-launch"
        },
        {
          "activate": "tk-show-done"
        }
      ]
    },
    {
      "name": "new",
      "spec": [
        {
          "click": "[data-tknew]"
        }
      ],
      "gtk": [
        {
          "activate": "tk-new"
        }
      ]
    },
    {
      "name": "new-parsed",
      "spec": [
        {
          "click": "[data-tknew]"
        },
        {
          "eval": "(() => { const i = document.querySelector('[data-tkadd]'); i.value = 'Call Theo tomorrow 3pm !high #Launch @Priya'; i.dispatchEvent(new Event('input', {bubbles:true})); })()"
        }
      ],
      "gtk": [
        {
          "activate": "tk-new"
        },
        {
          "env": {
            "LUMA_TASKS_DRAFT": "Call Theo tomorrow 3pm !high #Launch @Priya"
          }
        }
      ]
    },
    {
      "name": "search-empty",
      "spec": [
        {
          "eval": "(() => { const i = document.querySelector('[data-tkq]'); i.value = 'no matching task'; i.dispatchEvent(new Event('input', {bubbles:true})); })()"
        }
      ],
      "gtk": [
        {
          "env": {
            "LUMA_TASKS_QUERY": "no matching task"
          }
        }
      ]
    },
    {
      "name": "hide-suggestions",
      "spec": [
        {
          "click": "[data-tksugx]"
        }
      ],
      "gtk": [
        {
          "activate": "tk-hide-suggestions"
        }
      ]
    }
  ],
  "phone_states": [
    "today",
    "upcoming",
    "mine",
    "flag",
    "done",
    "personal",
    "launch",
    "home",
    "groc",
    "task",
