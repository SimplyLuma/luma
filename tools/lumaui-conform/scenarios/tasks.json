{
  "app": "tasks",
  "title": "Tasks",
  "spec": {
    "url": "mockups/luma-next-70.html?app=tasks",
    "window": "#w-tasks",
    "exclude": [
      ".grip",
      ".pop.toast-gone"
    ]
  },
  "gtk": {
    "module": "tasks",
    "fixtures": [
      "tests/fixtures/tasks-v70.json",
      "tests/fixtures/tasks-v70"
    ],
    "env": {
      "LUMA_TASKS_FIXTURE": "{run}/fixtures/tasks-v70.json"
    }
  },
  "states": [
    {
      "name": "today",
      "about": "Opening state: no task selected, details closed",
      "spec": [],
      "gtk": []
    },
    {
      "name": "upcoming",
      "spec": [
        {
          "click": "[data-tkview=\"upcoming\"]"
        }
      ],
      "gtk": [
        {
          "activate": "tk-view-upcoming"
        }
      ]
    },
    {
      "name": "mine",
      "spec": [
        {
          "click": "[data-tkview=\"mine\"]"
        }
      ],
      "gtk": [
        {
          "activate": "tk-view-mine"
        }
      ]
    },
    {
      "name": "flag",
      "spec": [
        {
          "click": "[data-tkview=\"flag\"]"
        }
      ],
      "gtk": [
        {
          "activate": "tk-view-flag"
        }
      ]
    },
    {
      "name": "done",
      "spec": [
        {
          "click": "[data-tkview=\"done\"]"
        }
      ],
      "gtk": [
        {
          "activate": "tk-view-done"
        }
      ]
    },
    {
      "name": "personal",
      "spec": [
        {
          "click": "[data-tkview=\"personal\"]"
        }
      ],
      "gtk": [
        {
          "activate": "tk-view-personal"
        }
      ]
    },
    {
      "name": "launch",
      "spec": [
        {
          "click": "[data-tkview=\"launch\"]"
        }
      ],
      "gtk": [
        {
          "activate": "tk-view-launch"
        }
      ]
    },
    {
      "name": "home",
      "spec": [
        {
          "click": "[data-tkview=\"home\"]"
        }
      ],
      "gtk": [
        {
          "activate": "tk-view-home"
        }
      ]
    },
    {
      "name": "groc",
      "spec": [
        {
          "click": "[data-tkview=\"groc\"]"
        }
      ],
      "gtk": [
        {
          "activate": "tk-view-groc"
