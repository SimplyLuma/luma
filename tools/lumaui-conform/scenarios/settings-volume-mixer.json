{
  "app": "settings-volume-mixer",
  "title": "Settings: Volume mixer",
  "about": "Settings › Sound › Volume mixer (gnome-control-center 0108, the active patch series) against the published reference (Design Center mockups/sound-mixer/settings.html), drawn from the fixture's CFMIX. The reference is the page alone: its stage takes the Settings window's size with the page, 680 px wide as in the simulator, where the main island puts it; its transport keys are given the names the row's keys have; the sidebar and the title row are left out of the GTK side. LumaUI's glyphs come from the worktree (LUMA_APPKIT_ICON_PATH), so ones newer than the capture image's icon theme draw.",
  "spec": {
    "root": "design-center",
    "url": "mockups/sound-mixer/settings.html",
    "window": "#stage",
    "ready": "html[data-ready]",
    "exclude": [],
    "viewport": {
      "width": 1180,
      "height": 1100
    },
    "before": [
      {
        "eval": "(() => { if (matchMedia('(prefers-color-scheme: light)').matches) document.documentElement.dataset.mode = 'light'; const s = document.querySelector('#stage'); s.style.boxSizing = 'border-box'; s.style.width = '1180px'; s.style.margin = '0'; s.style.padding = '46px 0 0 228px'; const page = s.querySelector('.cfpage'); page.style.boxSizing = 'border-box'; page.style.width = '680px'; for (const keys of s.querySelectorAll('.mxctl')) { const b = [...keys.querySelectorAll('button')]; if (b.length === 3) { b[0].setAttribute('aria-label', 'Previous'); b[2].setAttribute('aria-label', 'Next'); } } const play = [...s.querySelectorAll('.mxctl .pp')]; ['Pause', 'Play', 'Pause'].forEach((l, i) => play[i] && play[i].setAttribute('aria-label', l)); })()",
        "wait": 300
      }
    ]
  },
  "gtk": {
    "module": "settings",
    "fixtures": [
      "tests/fixtures/settings-v70.json",
      "assets/wallpapers/prism.png",
      "assets/icon-theme/Prairie/scalable/apps/luma-v3-documents.svg",
