#!/bin/sh
# SPDX-License-Identifier: Apache-2.0

set -eu

idle_delay_previous=
extend_test_idle() {
  command -v gsettings >/dev/null 2>&1 || return 0
  idle_delay_previous=$(gsettings get org.gnome.desktop.session idle-delay \
    2>/dev/null) || {
      idle_delay_previous=
      return 0
    }
  # Keep display sleep enabled during hands-on trials, but leave enough time
  # to evaluate a keyboard without the nested compositor idling underneath it.
  gsettings set org.gnome.desktop.session idle-delay 300
}
restore_test_idle() {
  [ -n "$idle_delay_previous" ] || return 0
  gsettings set org.gnome.desktop.session idle-delay \
    "$idle_delay_previous" 2>/dev/null || true
}

engine=${1:-}
case "$engine" in
  stevia)
    candidate=/usr/bin/phosh-osk-stevia
    ;;
  squeekboard)
    candidate=/usr/libexec/luma-keyboard-labs/squeekboard
    ;;
  wvkbd)
    candidate=/usr/libexec/luma-keyboard-labs/wvkbd-mobintl
    ;;
  sysboard)
    candidate=/usr/libexec/luma-keyboard-labs/sysboard/sysboard
    ;;
  plasma|maliit-lomiri|lomiri)
    case "$engine" in
      lomiri)
        runtime_root=/var/lib/luma-keyboard-labs/lomiri-questing
        ;;
      *)
        runtime_root=/var/lib/luma-keyboard-labs/kde-f44
        ;;
    esac
    for path in "$runtime_root/usr/bin/kwin_wayland" \
      /usr/bin/bwrap /usr/libexec/luma-kwin-keyboard-engine \
      /usr/libexec/luma-keyboard-lab-entry; do
      [ -x "$path" ] || {
        printf 'keyboard lab: required path is missing: %s\n' "$path" >&2
        exit 1
      }
    done
    case "$engine" in
      plasma)
        kwin_engine=plasma
        candidate=$runtime_root/usr/bin/plasma-keyboard
        ;;
      maliit-lomiri)
        kwin_engine=maliit
        candidate=$runtime_root/usr/bin/maliit-keyboard
        ;;
      lomiri)
        kwin_engine=lomiri
        candidate=$runtime_root/usr/bin/maliit-server
        ;;
    esac
    [ -x "$candidate" ] || {
      printf 'keyboard lab: required path is missing: %s\n' "$candidate" >&2
      exit 1
    }
    ;;
  *)
    printf 'keyboard lab: unsupported engine: %s\n' "$engine" >&2
    exit 2
    ;;
esac

if [ -n "${kwin_engine:-}" ]; then
  if [ "$kwin_engine" = lomiri ]; then
    export LUMA_LOMIRI_KEYBOARD_START_DELAY=2
    export LUMA_KWIN_COMPOSE=Q
  else
    export LUMA_LOMIRI_KEYBOARD_START_DELAY=0
    export LUMA_KWIN_COMPOSE=O2
  fi
  kwin_pid=
  notify_outer() {
    gdbus call --session \
      --dest org.project_luma.Handheld \
      --object-path /org/project_luma/Handheld \
      --method org.project_luma.Handheld1.SetExternalKeyboardVisible \
      "$1" >/dev/null 2>&1 || true
  }
  cleanup_kwin() {
    notify_outer false
    if [ -n "$kwin_pid" ]; then
      kill -TERM "$kwin_pid" 2>/dev/null || true
      wait "$kwin_pid" 2>/dev/null || true
    fi
    restore_test_idle
  }
  trap cleanup_kwin EXIT HUP INT TERM
  extend_test_idle

  # Only Luma's existing Wayland socket and session bus enter this read-only
  # Fedora runtime. A private home, /tmp, /run, and /dev are discarded when
  # the lab closes; the production compositor and input method are unchanged.
  bwrap \
    --ro-bind "$runtime_root" / \
    --proc /proc \
    --dev /dev \
    --ro-bind /sys /sys \
    --tmpfs /run \
    --dir /run/user \
    --dir "/run/user/$(id -u)" \
    --ro-bind "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" \
      "/run/user/$(id -u)/$WAYLAND_DISPLAY" \
    --ro-bind "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY.lock" \
      "/run/user/$(id -u)/$WAYLAND_DISPLAY.lock" \
    --ro-bind "$XDG_RUNTIME_DIR/bus" "/run/user/$(id -u)/bus" \
    --ro-bind /usr/libexec/luma-kwin-keyboard-engine \
      "/run/user/$(id -u)/luma-kwin-keyboard-engine" \
    --ro-bind /usr/libexec/luma-keyboard-lab-entry \
      "/run/user/$(id -u)/luma-keyboard-lab-entry" \
    --tmpfs /tmp \
    --tmpfs /home \
    --dir /home/luma \
    --setenv HOME /home/luma \
    --setenv USER luma \
    --setenv LOGNAME luma \
    --setenv XDG_RUNTIME_DIR "/run/user/$(id -u)" \
    --setenv DBUS_SESSION_BUS_ADDRESS \
      "unix:path=/run/user/$(id -u)/bus" \
    --setenv WAYLAND_DISPLAY "$WAYLAND_DISPLAY" \
    --setenv QT_QPA_PLATFORM wayland \
    --setenv LANG "${LUMA_KEYBOARD_LOCALE:-en_US.UTF-8}" \
    --setenv LC_ALL "${LUMA_KEYBOARD_LOCALE:-en_US.UTF-8}" \
    --setenv QT_VIRTUALKEYBOARD_HUNSPELL_DATA_PATH /usr/share/hunspell \
    --setenv KWIN_COMPOSE "$LUMA_KWIN_COMPOSE" \
    --setenv LUMA_KWIN_KEYBOARD_ENGINE "$kwin_engine" \
    --setenv LUMA_LOMIRI_KEYBOARD_START_DELAY \
      "$LUMA_LOMIRI_KEYBOARD_START_DELAY" \
    /usr/bin/kwin_wayland \
      --wayland-display "$WAYLAND_DISPLAY" \
      --socket "luma-kwin-$kwin_engine-$$" \
      --width 720 --height 1280 --scale 1 \
      --no-lockscreen --no-global-shortcuts --no-kactivities \
      --inputmethod "/run/user/$(id -u)/luma-kwin-keyboard-engine" \
      --exit-with-session "/run/user/$(id -u)/luma-keyboard-lab-entry $engine" &
  kwin_pid=$!

  ready=false
  for _attempt in $(seq 1 100); do
    if gdbus call --session --dest org.kde.KWin \
        --object-path /VirtualKeyboard \
        --method org.freedesktop.DBus.Properties.Get \
        org.kde.kwin.VirtualKeyboard available 2>/dev/null | grep -Fq '<true>'; then
      ready=true
      break
    fi
    kill -0 "$kwin_pid" 2>/dev/null || break
    sleep 0.1
  done
  [ "$ready" = true ] || {
    printf 'keyboard lab: %s KWin input method did not become available\n' \
      "$engine" >&2
    exit 1
  }

  visible=false
  for _attempt in $(seq 1 50); do
    gdbus call --session --dest org.kde.KWin \
      --object-path /VirtualKeyboard \
      --method org.freedesktop.DBus.Properties.Set \
      org.kde.kwin.VirtualKeyboard mode '<int32 2>' >/dev/null 2>&1 || true
    gdbus call --session --dest org.kde.KWin \
      --object-path /VirtualKeyboard \
      --method org.kde.kwin.VirtualKeyboard.forceActivate >/dev/null
    if gdbus call --session --dest org.kde.KWin \
        --object-path /VirtualKeyboard \
        --method org.freedesktop.DBus.Properties.Get \
        org.kde.kwin.VirtualKeyboard visible 2>/dev/null | grep -Fq '<true>'; then
      visible=true
      break
    fi
    kill -0 "$kwin_pid" 2>/dev/null || break
    sleep 0.1
  done
  if [ "$visible" != true ] && [ "$engine" != lomiri ]; then
    printf 'keyboard lab: %s did not become visible\n' "$engine" >&2
    exit 1
  fi
  # Lomiri's Qt 5 Maliit server successfully binds KWin's input-method-v1
  # context and creates its QML surface, but does not drive KWin 6's newer
  # `visible` D-Bus property. Process/QML/protocol health is therefore the
  # acceptance gate for this isolated legacy-protocol comparison.
  notify_outer true
  wait "$kwin_pid"
  kwin_pid=
  exit 0
fi

for path in /usr/bin/phoc "$candidate" \
  /usr/libexec/luma-keyboard-lab-session; do
      [ -x "$path" ] || {
        printf 'keyboard lab: required path is missing: %s\n' "$path" >&2
        exit 1
      }
done

lab_dir=$(mktemp -d "${XDG_RUNTIME_DIR:?}/luma-keyboard-lab.XXXXXX")
cleanup() {
  if [ -n "${phoc_pid:-}" ]; then
    kill -TERM "$phoc_pid" 2>/dev/null || true
    wait "$phoc_pid" 2>/dev/null || true
  fi
  rm -rf "$lab_dir"
  restore_test_idle
}
trap cleanup EXIT HUP INT TERM
extend_test_idle

config=$lab_dir/phoc.ini
printf '%s\n' \
  '[core]' \
  'xwayland=false' \
  '' \
  '[output:WL-1]' \
  'mode=720x1280' \
  'phys_width=68' \
  'phys_height=121' \
  'scale=1' >"$config"

# WAYLAND_DISPLAY from Luma makes wlroots choose its nested Wayland backend.
# The lab is one ordinary Luma window; the physical compositor, session,
# production input method, network, and power policy remain untouched.
export WLR_BACKENDS=wayland
export WLR_LIBINPUT_NO_DEVICES=1
export GDK_BACKEND=wayland
# Candidate file-backed preferences are intentionally isolated from both Luma
# and a later lab run. Keep the session dconf backend available: Stevia uses it
# for live input-surface state as well as user preferences.
export XDG_CONFIG_HOME="$lab_dir/config"
mkdir -p "$XDG_CONFIG_HOME"

/usr/bin/phoc \
  --no-xwayland \
  --socket "luma-keyboard-lab-$$" \
  --config "$config" \
  --exec "/usr/libexec/luma-keyboard-lab-session $engine" &
phoc_pid=$!
wait "$phoc_pid"
phoc_pid=
