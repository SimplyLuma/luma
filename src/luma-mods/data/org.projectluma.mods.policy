<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Project Luma</vendor>
  <vendor_url>https://github.com/SimplyLuma/luma</vendor_url>
  <action id="org.projectluma.mods.stage-system">
    <description>Prepare a reviewed system Mod</description>
    <message>Authentication is required to prepare this system Mod</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
  <action id="org.projectluma.mods.activate-system">
    <description>Restart into a reviewed system Mod</description>
    <message>Authentication is required to restart into this system Mod</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
  <action id="org.projectluma.mods.rollback-system">
    <description>Return to the previous Luma system composition</description>
    <message>Authentication is required to restore the previous system composition</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
</policyconfig>
