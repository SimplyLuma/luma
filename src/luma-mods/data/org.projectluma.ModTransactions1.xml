<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.projectluma.ModTransactions1">
    <method name="GetStatus">
      <arg name="status_json" type="s" direction="out"/>
    </method>
    <method name="StageCatalog">
      <arg name="mod_id" type="s" direction="in"/>
      <arg name="reviewed_snapshot_id" type="s" direction="in"/>
      <arg name="reviewed_composition_sha256" type="s" direction="in"/>
      <arg name="allow_user_interaction" type="b" direction="in"/>
      <arg name="candidate_id" type="s" direction="out"/>
    </method>
    <method name="Activate">
      <arg name="candidate_id" type="s" direction="in"/>
      <arg name="allow_user_interaction" type="b" direction="in"/>
    </method>
    <method name="Rollback">
      <arg name="candidate_id" type="s" direction="in"/>
      <arg name="allow_user_interaction" type="b" direction="in"/>
    </method>
  </interface>
</node>
