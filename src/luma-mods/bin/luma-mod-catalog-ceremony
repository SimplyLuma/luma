#!/usr/bin/python3
# SPDX-License-Identifier: Apache-2.0

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from luma_mods.catalog_ceremony import prepare
from luma_mods.errors import LumaModsError


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Prepare a verified, keyless Luma catalog ceremony request."
    )
    parser.add_argument("policy", type=Path)
    parser.add_argument("handoff", type=Path)
    parser.add_argument("output", type=Path)
    args = parser.parse_args()
    try:
        request = prepare(args.policy, args.handoff, args.output)
    except (LumaModsError, OSError) as error:
        print(f"luma-mod-catalog-ceremony: {error}", file=sys.stderr)
        return 2
    print(json.dumps(request, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
