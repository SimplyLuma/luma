[Unit]
Description=Project Luma FP6 notice when the mobile radio needs Android once
# Runs inside the graphical session, after the shell provides notifications.
# Never Type=oneshot under default.target: a unit default.target waits for
# delays user@.service, and with it the login (20261015.22 login loop).
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=/run/luma/fp6-modem-state.json

[Service]
Type=exec
ExecStart=/usr/libexec/luma-fp6-modem-state-notify
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
