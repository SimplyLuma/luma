# SPDX-License-Identifier: MPL-2.0
[Unit]
Description=Luma saved passwords (open the login keyring of an automatic sign-in)
Documentation=https://projectluma.org/saved-passwords
# Before anything in the session can ask for a secret. It is ordered before
# graphical-session-pre.target on purpose; the bound is a few seconds (the
# keyring daemon is activated on demand) and a failure never blocks the
# session (WantedBy, and the command always exits 0).
Before=graphical-session-pre.target
After=dbus.socket gnome-keyring-daemon.socket
ConditionUser=!@system

[Service]
Type=oneshot
ExecStart=/usr/libexec/luma-keyring --autologin
TimeoutStartSec=10
Slice=session.slice
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
LimitCORE=0
MemoryHigh=64M

[Install]
WantedBy=graphical-session-pre.target
