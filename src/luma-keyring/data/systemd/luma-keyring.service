[Unit]
Description=Luma saved passwords (the login keyring's state, and its first unlock)
Documentation=https://projectluma.org/saved-passwords
PartOf=graphical-session.target
# The shell is up (it draws the sheet; it owns the system prompter), and
# nothing that starts with the graphical session has asked for a secret yet:
# when the keyring needs its first unlock, Luma's sheet is the first to ask.
After=gnome-session-initialized.target gnome-keyring-daemon.service luma-keyring-autologin.service
Before=graphical-session.target

[Service]
# READY=1 at once when there is nothing to ask, once the sheet is up when
# there is, and never later than a few seconds either way (see ready.py);
# the session never waits on a person.
Type=notify
NotifyAccess=main
ExecStart=/usr/libexec/luma-keyring --gapplication-service
TimeoutStartSec=30
# It looks once, says its piece and goes; a failure is not worth a loop.
Restart=no
Slice=session.slice
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
# The recovery prompt derives a key with Argon2id (64 MiB).
LimitCORE=0
MemoryHigh=256M

[Install]
WantedBy=graphical-session.target
