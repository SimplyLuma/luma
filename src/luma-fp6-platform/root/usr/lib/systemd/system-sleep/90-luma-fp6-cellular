#!/usr/bin/bash
# SPDX-License-Identifier: Apache-2.0

# systemd calls system-sleep hooks with "pre" or "post" as argv[1].  Queue
# recovery asynchronously so wake-up is never held behind modem enumeration.

set -u

if [[ ${1:-} == post ]]; then
  systemctl --no-block start luma-fp6-cellular-resume.service
fi
