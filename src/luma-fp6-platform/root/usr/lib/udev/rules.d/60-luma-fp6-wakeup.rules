# The Bluetooth UART RX wake line (GPIO 51) fires during every suspend
# attempt and aborts it. The power key and RTC alarms still wake the phone.
# The driver is built in and binds before udev starts, so a normal boot sees
# only the coldplug "add" event.
ACTION=="add|bind", SUBSYSTEM=="platform", KERNEL=="890000.serial", ATTR{power/wakeup}="disabled"
