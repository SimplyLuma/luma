[Unit]
Description=Luma setup (first boot)
RefuseManualStart=true
RefuseManualStop=true
BindsTo=gnome-session.target
After=gnome-session.target

[Service]
Type=simple
ExecStart=/usr/libexec/luma-setup
# The setup ends the session when it ends: signed in, GDM closes this display;
# if it ever fails, GDM starts it again.
ExecStopPost=-/usr/libexec/gnome-session-ctl --shutdown
Restart=no
