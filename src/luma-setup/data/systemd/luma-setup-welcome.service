[Unit]
Description=Luma setup: the steps after the first sign-in
# Once, for an account first boot made (its welcome file), until it is done or left.
ConditionPathExists=/var/lib/luma-setup/welcome/%u
ConditionPathExists=!%S/luma-setup/welcome-done
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
# On screen as soon as it can be: the sheet reads the appearance itself, and the
# portal is still starting in a first session.
Environment=ADW_DISABLE_PORTAL=1
ExecStart=/usr/libexec/luma-setup --welcome
Restart=no

[Install]
WantedBy=graphical-session.target
