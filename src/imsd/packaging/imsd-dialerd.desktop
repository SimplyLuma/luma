[Desktop Entry]
Type=Application
Name=IMS Dialer Daemon
Comment=Plasma Dialer backend for imsd (replaces plasma-dialer's modem-daemon)
Exec=/usr/bin/imsd-dialerd
Icon=call-start
NoDisplay=true
X-KDE-autostart-phase=1
X-KDE-StartupNotify=false
