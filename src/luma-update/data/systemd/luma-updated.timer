# SPDX-License-Identifier: Apache-2.0
# ADR-030 section 6: check 2 minutes after boot, so a new computer or phone
# sees its update soon after it is online, then every 6 hours. A
# NetworkManager dispatcher script also starts a check when a connection
# comes up; luma-updated spaces automatic checks an hour apart.
[Unit]
Description=Check for Luma system updates periodically

[Timer]
OnBootSec=2min
OnUnitActiveSec=6h
RandomizedDelaySec=30s
AccuracySec=15s
Persistent=true
Unit=luma-update-check.service

[Install]
WantedBy=timers.target
