# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Mark the boot slot successful after its new kernel booted
Documentation=https://github.com/SimplyLuma/luma/blob/main/devices/README.md
# Only while a slot written by luma-device-boot.service is on trial. A trial
# boot that never gets here is undone by the bootloader's A/B fallback.
ConditionPathExists=/run/ostree-booted
ConditionPathExists=/var/lib/luma-device-boot/pending.json
After=multi-user.target luma-device-boot.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/luma-device-boot confirm
StateDirectory=luma-device-boot
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
