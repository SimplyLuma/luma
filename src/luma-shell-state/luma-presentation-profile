"""Project a validated boot experience into readable ephemeral session state."""
from pathlib import Path
import sys

base = Path(__file__).resolve().parent
sys.path.insert(0, str(base / "luma-shell-state" if (base / "luma-shell-state").is_dir() else base))
from luma_shell_state import presentation_profile, record_device_class

def read(path):
    try:
        return Path(path).read_text(encoding="utf-8").strip().strip("\0")
    except (OSError, UnicodeError):
        return ""

try:
    chassis = int(read("/sys/class/dmi/id/chassis_type"))
except ValueError:
    chassis = None
record_device_class()
requested = read("/sys/firmware/qemu_fw_cfg/by_name/opt/luma/experience/raw")
# TV is a posture over the Desktop presentation: keep it for read_device_posture;
# read_presentation_profile maps it to Desktop.
profile = "tv" if requested == "tv" else presentation_profile(requested,
                               read("/etc/luma-device-class"), chassis,
                               read("/sys/firmware/devicetree/base/chassis-type"))
directory = Path("/run/luma")
directory.mkdir(mode=0o755, parents=True, exist_ok=True)
target = directory / "experience"
target.write_text(profile + "\n", encoding="utf-8")
target.chmod(0o644)
