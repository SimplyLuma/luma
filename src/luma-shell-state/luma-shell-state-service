"""Session D-Bus broker for the canonical Project Luma shell state."""

from __future__ import annotations

import sys
import json
from pathlib import Path

_base = Path(__file__).resolve().parent
sys.path.insert(0, str(_base / "luma-shell-state" if (_base / "luma-shell-state").is_dir() else _base))

from gi.repository import Gio, GLib

from luma_shell_state import (
    InvalidState,
    LUMA_GTK3_THEMES,
    build_snapshot,
    detect_renderer,
    encode_snapshot,
    gtk_theme_for_appearance,
    normalize_app_ids,
    normalize_appearance,
    normalize_idle_delay,
    presentation_button_layout,
    presentation_idle_default,
    normalize_shelf,
    normalize_wallpaper_uri,
    normalize_presentation,
    normalize_capabilities,
    normalize_home_layout,
    presentation_state,
    read_presentation_profile,
)


BUS_NAME = "org.project_luma.ShellState1"
OBJECT_PATH = "/org/project_luma/ShellState1"
INTERFACE = BUS_NAME

INTROSPECTION_XML = """
<node>
  <interface name="org.project_luma.ShellState1">
    <property name="Presentation" type="s" access="read"/>
    <property name="InputCapabilities" type="a{sb}" access="read"/>
    <method name="GetSnapshot">
      <arg name="snapshot" type="s" direction="out"/>
    </method>
    <method name="SetFavorites">
      <arg name="application_ids" type="as" direction="in"/>
    </method>
    <method name="SetHomeApps">
      <arg name="application_ids" type="as" direction="in"/>
    </method>
    <method name="SetWallpaper">
      <arg name="uri" type="s" direction="in"/>
    </method>
    <method name="SetAppearance">
      <arg name="appearance" type="s" direction="in"/>
    </method>
    <method name="SetIdleDelay">
      <arg name="seconds" type="u" direction="in"/>
    </method>
    <method name="SetPresentation">
      <arg name="mode" type="s" direction="in"/>
    </method>
    <method name="SetHomeLayout">
      <arg name="profile" type="s" direction="in"/>
      <arg name="layout" type="s" direction="in"/>
    </method>
    <method name="ReportInputCapabilities">
      <arg name="capabilities" type="s" direction="in"/>
    </method>
    <signal name="Changed">
      <arg name="key" type="s"/>
      <arg name="snapshot" type="s"/>
    </signal>
  </interface>
</node>
"""


class ShellStateService:
    def __init__(self) -> None:
        self._connection: Gio.DBusConnection | None = None
        self._registration_id = 0
        self._node = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION_XML)
        self._shell = Gio.Settings.new("org.gnome.shell")
        self._background = Gio.Settings.new("org.gnome.desktop.background")
        self._interface = Gio.Settings.new("org.gnome.desktop.interface")
        self._session = Gio.Settings.new("org.gnome.desktop.session")
        self._a11y = Gio.Settings.new("org.gnome.desktop.a11y.applications")
        self._luma = Gio.Settings.new("org.project_luma.shell-state")
        self._wm = Gio.Settings.new("org.gnome.desktop.wm.preferences")
        self._capabilities = {}
        self._posture_source = 0
        self._profile = read_presentation_profile()
        self._phosh = None
        self._syncing_favorites = False
        schema_source = Gio.SettingsSchemaSource.get_default()
        if schema_source.lookup("sm.puri.phosh", True) is not None:
            self._phosh = Gio.Settings.new("sm.puri.phosh")
            self._phosh.connect("changed::favorites", self._on_phosh_favorites_changed)

        watched = (
            (self._shell, "favorites"),
            (self._background, "wallpaper"),
            (self._interface, "appearance"),
            (self._session, "power"),
            (self._a11y, "input"),
            (self._luma, "luma"),
            (self._wm, "wm"),
        )
        for settings, group in watched:
            settings.connect("changed", self._on_settings_changed, group)
        self._sync_gtk3_theme()
        self._project_favorites_to_phosh()
        self._sync_idle_default()
        self._sync_button_layout()

    def _sync_button_layout(self) -> None:
        if not self._luma.props.settings_schema.has_key("presentation-button-layout"):
            return
        mode = presentation_state(self._luma.get_string("presentation-mode"),
            profile=self._profile, capabilities=self._capabilities)["effective"]
        current = self._wm.get_user_value("button-layout")
        kept = self._luma.get_value("presentation-button-layout").get_maybe()
        saved = kept.get_string() if kept is not None else None
        layout, next_saved = presentation_button_layout(
            mode, current.get_string() if current is not None else None, saved)
        # Record ownership before writing, so the change notification agrees.
        if next_saved != saved:
            self._luma.set_value("presentation-button-layout", GLib.Variant("ms", next_saved))
        if layout == "":
            self._wm.reset("button-layout")
        elif layout is not None:
            self._wm.set_string("button-layout", layout)

    def _sync_idle_default(self) -> None:
        if not self._luma.props.settings_schema.has_key("presentation-idle-default"):
            return
        mode = presentation_state(self._luma.get_string("presentation-mode"),
            profile=self._profile, capabilities=self._capabilities)["effective"]
        current = self._session.get_user_value("idle-delay")
        value = presentation_idle_default(mode, current.get_uint32() if current is not None else None,
            self._luma.get_int("presentation-idle-default"))
        if value is not None:
            self._luma.set_int("presentation-idle-default", value)
            if self._session.get_uint("idle-delay") != value:
                self._session.set_uint("idle-delay", value)

    def _sync_gtk3_theme(self) -> None:
        """Keep supported legacy GTK apps on Luma's selected material."""

        current = self._interface.get_string("gtk-theme")
        if current not in LUMA_GTK3_THEMES:
            return
        selected = self._luma.get_user_value("surface-treatment")
        desired = gtk_theme_for_appearance(
            self._interface.get_string("color-scheme"),
            selected.get_string() if selected is not None else None,
        )
        if current != desired:
            self._interface.set_string("gtk-theme", desired)

    def _arrangement(self) -> list:
        # A shell-state schema older than ADR-044 has no key: the default.
        if not self._luma.props.settings_schema.has_key("shelf-arrangement"):
            return []
        return self._luma.get_value("shelf-arrangement").unpack()

    def _home_layouts(self) -> dict:
        if not self._luma.props.settings_schema.has_key("home-layouts"):
            return {}
        try:
            value = json.loads(self._luma.get_string("home-layouts"))
            if not isinstance(value, dict) or len(value) > 16:
                return {}
            return {profile: normalize_home_layout(profile, layout) for profile, layout in value.items()}
        except (InvalidState, TypeError, ValueError):
            return {}

    def _free_placement(self) -> bool:
        if not self._luma.props.settings_schema.has_key("shelf-free-placement"):
            return False
        return self._luma.get_boolean("shelf-free-placement")

    def _renderer(self) -> str:
        renderer = detect_renderer()
        if renderer != "unknown" or self._connection is None:
            return renderer
        result = self._connection.call_sync(
            "org.freedesktop.DBus",
            "/org/freedesktop/DBus",
            "org.freedesktop.DBus",
            "NameHasOwner",
            GLib.Variant("(s)", ("mobi.phosh.Shell.DebugControl",)),
            GLib.VariantType.new("(b)"),
            Gio.DBusCallFlags.NONE,
            1000,
            None,
        )
        if result is not None and result.unpack()[0]:
            return "phosh"
        return "gnome"

    def _project_favorites_to_phosh(self) -> None:
        if self._phosh is None or self._syncing_favorites:
            return
        canonical = list(self._shell.get_strv("favorite-apps"))
        if canonical == list(self._phosh.get_strv("favorites")):
            return
        self._syncing_favorites = True
        try:
            self._phosh.set_strv("favorites", canonical)
        finally:
            self._syncing_favorites = False

    def _on_phosh_favorites_changed(self, settings: Gio.Settings, _key: str) -> None:
        if self._syncing_favorites:
            return
        try:
            favorites = normalize_app_ids(settings.get_strv("favorites"))
        except InvalidState:
            self._project_favorites_to_phosh()
            return
        if favorites == list(self._shell.get_strv("favorite-apps")):
            return
        self._syncing_favorites = True
        try:
            self._shell.set_strv("favorite-apps", favorites)
        finally:
            self._syncing_favorites = False

    @staticmethod
    def _stored_app_ids(values) -> list[str]:
        # One stored entry the snapshot does not accept (e.g. a phosh launcher
        # folder) must not fail the whole snapshot and with it the presentation.
        valid = []
        for value in values:
            try:
                valid += normalize_app_ids([value])
            except InvalidState:
                pass
        return valid

    def snapshot(self) -> str:
        snapshot = build_snapshot(
            favorites=self._stored_app_ids(self._shell.get_strv("favorite-apps")),
            home_apps=self._stored_app_ids(self._luma.get_strv("home-apps")),
            wallpaper_uri=self._background.get_string("picture-uri"),
            wallpaper_uri_dark=self._background.get_string("picture-uri-dark"),
            wallpaper_style=self._background.get_string("picture-options"),
            appearance=self._interface.get_string("color-scheme"),
            idle_delay=self._session.get_uint("idle-delay"),
            screen_keyboard_enabled=self._a11y.get_boolean("screen-keyboard-enabled"),
            launcher_columns=self._luma.get_uint("mobile-launcher-columns"),
            input_method=self._luma.get_string("input-method"),
            restore_app_state=self._luma.get_boolean("restore-app-state"),
            renderer=self._renderer(),
            presentation=presentation_state(
                self._luma.get_string("presentation-mode"), profile=self._profile,
                capabilities=self._capabilities),
            home_layouts=self._home_layouts(),
            shelf=normalize_shelf(
                layout_version=self._luma.get_uint("shelf-layout-version"),
                edge=self._luma.get_string("shelf-edge"),
                dock_anchor=self._luma.get_string("shelf-dock-anchor"),
                actions_anchor=self._luma.get_string("shelf-actions-anchor"),
                group_layout=self._luma.get_string("shelf-group-layout"),
                surface_mode=self._luma.get_string("shelf-surface-mode"),
                edge_mode=self._luma.get_string("shelf-edge-mode"),
                span_full=self._luma.get_boolean("shelf-span-full"),
                float_ends=self._luma.get_boolean("shelf-float-ends"),
                padding=self._luma.get_int("shelf-padding"),
                status={
                    "frame": self._luma.get_string("status-frame"),
                    "frame_scope": self._luma.get_string("status-frame-scope"),
                    "divider": self._luma.get_boolean("status-divider"),
                    "glyph_tiles": self._luma.get_boolean("status-glyph-tiles"),
                    "controls_right": self._luma.get_boolean("status-controls-right"),
                    "fill_strength": self._luma.get_string("status-fill-strength"),
                    "clock_fill": self._luma.get_string("status-clock-fill"),
                    "controls_fill": self._luma.get_string("status-controls-fill"),
                    "time_size": self._luma.get_int("status-time-size"),
                    "date_size": self._luma.get_int("status-date-size"),
                },
                material=self._luma.get_string("shelf-material"),
                monitor_mode=self._luma.get_string("shelf-monitor-mode"),
                overflow_mode=self._luma.get_string("shelf-overflow-mode"),
                dock_visible=self._luma.get_boolean("shelf-dock-visible"),
                actions_visible=self._luma.get_boolean("shelf-actions-visible"),
                reserve_work_area=self._luma.get_boolean("shelf-reserve-work-area"),
                auto_hide=self._luma.get_boolean("shelf-auto-hide"),
                islands=self._luma.get_strv("shelf-islands"),
                arrangement=self._arrangement(),
                free_placement=self._free_placement(),
            ),
        )
        return encode_snapshot(snapshot)

    def _context_properties(self):
        state = presentation_state(self._luma.get_string("presentation-mode"),
                                   profile=self._profile, capabilities=self._capabilities)
        return {
            "Presentation": GLib.Variant("s", state["effective"]),
            "InputCapabilities": GLib.Variant("a{sb}", {
                key: value for key, value in state["capabilities"].items() if value is not None}),
        }

    def _on_get_property(self, _connection, _sender, _path, _interface, name):
        return self._context_properties().get(name)

    def _on_settings_changed(self, _settings: Gio.Settings, key: str, group: str) -> None:
        if (group == "luma" and key == "presentation-mode") or group == "presentation":
            self._sync_idle_default()
            self._sync_button_layout()
        if group == "wm" and key == "button-layout":
            self._sync_button_layout()
        if group == "power" and key == "idle-delay" and self._luma.props.settings_schema.has_key("presentation-idle-default"):
            if self._session.get_uint("idle-delay") != self._luma.get_int("presentation-idle-default"):
                self._luma.set_int("presentation-idle-default", -1)
        if group == "favorites" and key == "favorite-apps":
            self._project_favorites_to_phosh()
        if (group == "appearance" and key in {"color-scheme", "gtk-theme"}) or (
            group == "luma" and key == "surface-treatment"
        ):
            self._sync_gtk3_theme()
        if self._connection is None:
            return
        self._connection.emit_signal(
            None,
            OBJECT_PATH,
            INTERFACE,
            "Changed",
            GLib.Variant("(ss)", (f"{group}.{key}", self.snapshot())),
        )
        self._connection.emit_signal(None, OBJECT_PATH,
            "org.freedesktop.DBus.Properties", "PropertiesChanged",
            GLib.Variant("(sa{sv}as)", (INTERFACE, self._context_properties(), [])))

    def _return_error(self, invocation: Gio.DBusMethodInvocation, error: Exception) -> None:
        invocation.return_dbus_error(f"{INTERFACE}.InvalidState", str(error))

    def _report_capabilities(self, sender: str, payload: str) -> None:
        # Only the compositor's bus identity can describe native seat posture.
        # Ordinary clients can choose a mode, but cannot impersonate hardware.
        owner = self._connection.call_sync(
            "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
            "GetNameOwner", GLib.Variant("(s)", ("org.gnome.Shell",)),
            GLib.VariantType.new("(s)"), Gio.DBusCallFlags.NONE, 1000, None)
        if owner.unpack()[0] != sender:
            raise InvalidState("only the compositor may report input capabilities")
        if len(payload) > 4096:
            raise InvalidState("capability report is too large")
        capabilities = normalize_capabilities(json.loads(payload))
        if self._posture_source:
            GLib.source_remove(self._posture_source)
        def settled():
            self._posture_source = 0
            self._capabilities = capabilities
            self._on_settings_changed(self._luma, "input-capabilities", "presentation")
            return GLib.SOURCE_REMOVE
        self._posture_source = GLib.timeout_add(400, settled)

    def _on_method_call(
        self,
        _connection: Gio.DBusConnection,
        _sender: str,
        _object_path: str,
        _interface_name: str,
        method_name: str,
        parameters: GLib.Variant,
        invocation: Gio.DBusMethodInvocation,
    ) -> None:
        try:
            values = parameters.unpack()
            if method_name == "GetSnapshot":
                invocation.return_value(GLib.Variant("(s)", (self.snapshot(),)))
            elif method_name == "SetFavorites":
                self._shell.set_strv("favorite-apps", normalize_app_ids(values[0]))
                invocation.return_value(None)
            elif method_name == "SetHomeApps":
                self._luma.set_strv("home-apps", normalize_app_ids(values[0]))
                invocation.return_value(None)
            elif method_name == "SetWallpaper":
                uri = normalize_wallpaper_uri(values[0])
                self._background.set_string("picture-uri", uri)
                self._background.set_string("picture-uri-dark", uri)
                invocation.return_value(None)
            elif method_name == "SetAppearance":
                self._interface.set_string("color-scheme", normalize_appearance(values[0]))
                invocation.return_value(None)
            elif method_name == "SetIdleDelay":
                seconds = normalize_idle_delay(values[0])
                # Explicit choices remain authoritative across mode switches.
                self._luma.set_int("presentation-idle-default", -1)
                self._session.set_uint("idle-delay", seconds)
                invocation.return_value(None)
            elif method_name == "SetPresentation":
                self._luma.set_string("presentation-mode", normalize_presentation(values[0]))
                invocation.return_value(None)
            elif method_name == "SetHomeLayout":
                profile, payload = values
                if len(payload.encode("utf-8")) > 262144:
                    raise InvalidState("Home layout exceeds the size limit")
                layout = normalize_home_layout(profile, json.loads(payload))
                layouts = self._home_layouts()
                layouts.pop(profile, None)
                layouts[profile] = layout
                while len(layouts) > 16:
                    del layouts[next(iter(layouts))]
                self._luma.set_string("home-layouts", json.dumps(layouts, separators=(",", ":")))
                invocation.return_value(None)
            elif method_name == "ReportInputCapabilities":
                self._report_capabilities(_sender, values[0])
                invocation.return_value(None)
            else:
                invocation.return_dbus_error(
                    f"{INTERFACE}.UnknownMethod", f"unknown method: {method_name}"
                )
        except (InvalidState, TypeError, ValueError, GLib.Error) as error:
            self._return_error(invocation, error)

    def on_bus_acquired(self, connection: Gio.DBusConnection, _name: str) -> None:
        self._connection = connection
        self._registration_id = connection.register_object(
            OBJECT_PATH,
            self._node.interfaces[0],
            self._on_method_call,
            self._on_get_property,
            None,
        )

    def close(self) -> None:
        if self._posture_source:
            GLib.source_remove(self._posture_source)
        if self._connection is not None and self._registration_id:
            self._connection.unregister_object(self._registration_id)


def main() -> int:
    loop = GLib.MainLoop()
    service = ShellStateService()
    owner_id = Gio.bus_own_name(
        Gio.BusType.SESSION,
        BUS_NAME,
        Gio.BusNameOwnerFlags.NONE,
        service.on_bus_acquired,
        None,
        lambda *_args: loop.quit(),
    )
    try:
        loop.run()
    finally:
        Gio.bus_unown_name(owner_id)
        service.close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
