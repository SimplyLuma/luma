#!/bin/sh
# SPDX-License-Identifier: MPL-2.0
# X-Luma-Managed: rpm -i / -U / -F of package files on Luma (ADR-038).
#
# Found first on the search path as /usr/local/bin/rpm (a link systemd-tmpfiles
# creates from luma-install-commands). Everything except installing package
# files onto the running Luma system is /usr/bin/rpm itself, unchanged:
# queries, verification, --root, --dbpath, --test, toolbox and containers.
real=/usr/bin/rpm
dnf=/usr/libexec/luma-install-commands/dnf
[ -e /run/ostree-booted ] && [ "${LUMA_RPM_PASSTHROUGH:-}" != 1 ] && [ -x "$dnf" ] || exec "$real" "$@"

install=0 other=0 files=
for argument in "$@"; do
  case $argument in
    --install|--upgrade|--freshen) install=1 ;;
    -[iUF]|-[iUF][vh]|-[iUF][vh][vh]|-[vh][iUF]|-[vh][vh][iUF]|-[vh][iUF][vh]) install=1 ;;
    -v|-vv|-h|--hash|--verbose|--percent|--quiet) ;;
    --root|--root=*|--dbpath|--dbpath=*|--test|--justdb|--initdb|--rebuilddb|-q*|--query|-V*|--verify|-e*|--erase|--import|-K|--checksig|--eval|-E|--showrc|--version|--help|--querytags)
      exec "$real" "$@" ;;
    -*) other=1 ;;
    *.rpm) files="$files $argument" ;;
    *) other=1 ;;
  esac
done
[ "$install" = 1 ] && [ -n "$files" ] || exec "$real" "$@"

if [ "$other" = 1 ]; then
  printf '%s\n' "Luma's system files in /usr are read-only and come from its system image, so rpm can't install" \
    "into them directly, and options such as --nodeps or --force can't be used." \
    "Install the package into the system image with: sudo dnf install$files" \
    "Software that installs itself without a package goes in /opt or /usr/local, which are writable and kept." >&2
  exit 1
fi
printf 'Luma installs package files into its system image; running: dnf install -y%s\n' "$files" >&2
# shellcheck disable=SC2086
exec "$dnf" install -y $files
