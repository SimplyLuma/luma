#!/usr/bin/python3 -sP
# SPDX-License-Identifier: MPL-2.0
"""Remove one package a person added with dnf, for Depot (run through pkexec).

Refuses anything that is not recorded as added to this computer's system
image, so Depot can never remove part of Luma through it.
"""
import re
import sys

from luma_install_commands import dnf, options, system


def main() -> int:
    if len(sys.argv) != 2 or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]*", sys.argv[1]):
        print("Error: name one added package", file=sys.stderr)
        return 2
    name = sys.argv[1]
    status = system.status()
    added = set()
    for deployment in (status.pending, status.booted):
        if deployment is not None:
            added.update(deployment.added)
    if name not in added:
        print(f"Error: {name} was not added to this computer, so Depot can't remove it here.", file=sys.stderr)
        return 1
    return dnf.remove(dnf.Context(), options.parse(["remove", "-y", name]))


if __name__ == "__main__":
    raise SystemExit(main())
