# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Seed Luma's signed offline independent applications
After=local-fs.target systemd-tmpfiles-setup.service
Before=display-manager.service
ConditionPathExists=/usr/share/luma/app-baseline/manifest.json

[Service]
Type=oneshot
ExecStart=/usr/bin/luma-seed-app-baseline
# System Flatpak content must be readable by ordinary application users.
# StateDirectory and completion records retain their explicit private modes.
UMask=0022
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/flatpak /var/lib/luma/app-baseline /run
StateDirectory=luma/app-baseline
StateDirectoryMode=0700
TimeoutStartSec=30min

[Install]
WantedBy=graphical.target
