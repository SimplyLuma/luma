# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Hand off the signed offline Luma application baseline
After=local-fs.target systemd-tmpfiles-setup.service dbus.service
Before=display-manager.service graphical.target
ConditionPathExists=/usr/share/luma/app-baseline/manifest.json

[Service]
# READY comes when the handoff finishes or after a bounded wait, whichever is
# first (app_baseline_progress.LOGIN_WAIT). The display manager only orders
# after it, so login never waits longer than that and never depends on it.
# The import then carries on in the background, and an interrupted one
# resumes with what is missing on the next boot.
Type=notify
ExecStart=/usr/bin/luma-seed-app-baseline
ExecStopPost=/usr/bin/python3 -B -m luma_installer.app_baseline_progress stopped
# Bounds only the time to READY; the import itself has no runtime limit.
TimeoutStartSec=5min
# System Flatpak content must be readable by ordinary application users.
# StateDirectory and completion records retain their explicit private modes.
UMask=0022
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/flatpak /var/lib/luma/app-baseline /run
StateDirectory=luma/app-baseline
StateDirectoryMode=0700
# status.json: progress the signed-in session reads.
RuntimeDirectory=luma/app-baseline
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
