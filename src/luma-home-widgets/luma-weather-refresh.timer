[Unit]
Description=Keep Home weather current without opening Weather
# The login screen and first-boot setup have no saved city.
ConditionUser=!@system

[Timer]
OnStartupSec=5s
OnCalendar=*-*-* *:0/15:00
Persistent=true
RandomizedDelaySec=20s
AccuracySec=20s
Unit=luma-weather-refresh.service

[Install]
WantedBy=default.target
