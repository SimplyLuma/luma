"""Titan eUICC transport inside luma-modemd; private FD API below shared Settings.

The kernel CCCI usage counter grants exclusive native MIPC port ownership.
No daemon is stopped, no port is force-reclaimed, and no AT/APDU payload is logged.
GPIO184 selects the soldered eUICC for SIM2 before the modem starts.
"""
import errno
import fcntl
import os
import pathlib
import re
import select
import socket
import struct
import threading
import time
import uuid

