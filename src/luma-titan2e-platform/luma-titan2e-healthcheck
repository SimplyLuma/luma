#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# greenboot health check for the Titan 2 Elite. greenboot's A/B backend here is
# the FP6 qbootctl one, which needs an OSTree deployment; the Titan marks its
# boot slot with luma-titan2e-boot-ok once this passes. Confirm the boot reached
# the graphical session.
set -u
log() { echo "titan2e-health: $*"; }
fail=0
# The required checks guard OSTree updates (luma-updated runs only there).
if [ -e /run/ostree-booted ]; then
	for d in /usr/lib/greenboot/check/required.d /etc/greenboot/check/required.d; do
		for s in "$d"/*.sh; do
			[ -e "$s" ] || continue
			if bash "$s"; then log "ok: ${s##*/}"; else log "failed: ${s##*/}"; fail=1; fi
		done
	done
else
	log "not an OSTree deployment: update health checks skipped"
fi
# The display manager must be greetd and the phone session (phosh on phoc,
# started by luma-phosh-session) must run;
# luma-titan2e-boot-ok marks the LK slot only after this passes.
dm=$(systemctl show -P Id display-manager.service 2>/dev/null)
if [ "$dm" = greetd.service ]; then log "display manager: greetd"; else log "display manager: ${dm:-none}"; fail=1; fi
# Not graphical.target: this check is wanted by multi-user.target, so neither
# target is reached until it has finished.
for i in $(seq 1 120); do
	systemctl -q is-active greetd.service && pgrep -x phoc >/dev/null && pgrep -x phosh >/dev/null && break
	sleep 1
done
if systemctl -q is-active greetd.service; then log "greetd active"; else log "greetd not active"; fail=1; fi
if pgrep -x phoc >/dev/null; then log "phoc running"; else log "phoc not running"; fail=1; fi
if pgrep -x phosh >/dev/null; then log "phosh running"; else log "phosh not running"; fail=1; fi
exit $fail
