"""Modem speech control for the Titan 2 Elite (MT6878).

Voice runs between the modem and the codec through the AFE PCM 1 interface; the CPU only
turns it on and off. Two parts:

- Speech: used by luma-modemd. Talks to the modem's speech task over /dev/ccci_aud and holds
  the hostless speech PCM open while speech is on. Serves on/off/device requests on
  /run/luma-modem/speech.sock.
- Command line (the UCM "Voice Call" verb runs it): luma-titan2e-speech on|off|device NAME

/dev/ccci_aud messages (one write() each, the kernel fills the channel):
  mailbox: u32 0xffffffff, u16 param16, u16 msg_id, u32 channel, u32 param32
  payload: u32 0, u32 length, u32 channel, u16 data_size + 6, u16 msg_id,
           u16 0xa2a2, u16 data_type, u16 data_size, data
The modem acknowledges a request 0x2fxx with 0xafxx; its notifications 0xafxx that need an
answer get 0x2fxx. Modem payloads carry u16 0x1234, type, size, index, total before the data.
"""
import fcntl, grp, os, socket, struct, sys, threading, time

SOCK = '/run/luma-modem/speech.sock'
CARD = 'Titan2Elite'
PCM_DEVICE = 3                  # Hostless_Speech
RATE = 48000                    # AFE rate for earpiece, speaker and headset calls

MSG_SPH_ON, MSG_SPH_OFF, MSG_DEV_CHANGE = 0x2f20, 0x2f21, 0x2f2b
MSG_UL_MUTE, MSG_DL_MUTE = 0x2f02, 0x2f03
MD_ALIVE, MD_EPOF, MD_NW_CODEC = 0xafa0, 0xaf78, 0xaf90
ACK = 0x8000
SPH_INFO_TYPE = 0x19

RATE_ENUM = {8000: 0, 16000: 1, 32000: 2, 48000: 3}
# ext_dev_info per output device (the modem picks its echo and gain handling from it)
DEVICES = {'earpiece': 0, 'speaker': 0, 'headset': 6, 'headphone': 6}
# Speech "Common" parameters: a 12-value hardware configuration setting observed on
# the device (SpeechGeneral), sent with every call's speech info.
COMMON = (0x0000, 0xdabd, 0x7918, 0x2a00, 0x8001, 0, 0, 0, 0, 0, 0, 0)


def sph_info(device):
    """128-byte speech info for a phone call without a parameter blob (the modem keeps
    its own parameters: param_emi_valid 2)."""
    b = bytearray(0x80)
    struct.pack_into('<BBBBBB', b, 0, 0, 0, RATE_ENUM[RATE], 0, 0, 2)
    struct.pack_into('<H', b, 0x0a, DEVICES.get(device, 0))
    struct.pack_into('<H', b, 0x12, 0x0002)          # enhancement dynamic control
    struct.pack_into('<12H', b, 0x1c, *COMMON)
    b[0x54] = 1                                      # one smart PA
    return bytes(b)


# ---- hostless speech PCM: opened, configured and started, never fed --------------------

def _ioc(d, nr, size):
    return (d << 30) | (size << 16) | (ord('A') << 8) | nr


HW_PARAMS = _ioc(3, 0x11, 608)
PREPARE, START, DROP = _ioc(0, 0x40, 0), _ioc(0, 0x42, 0), _ioc(0, 0x43, 0)


def _hw_params(channels, rate, period, periods):
    b = bytearray(608)
    for i in range(8):                               # masks: access, format, subformat, mres
        struct.pack_into('<8I', b, 4 + 32 * i, *([0xffffffff] * 8))
    struct.pack_into('<8I', b, 4, 1 << 3, 0, 0, 0, 0, 0, 0, 0)   # RW_INTERLEAVED
    struct.pack_into('<8I', b, 36, 1 << 2, 0, 0, 0, 0, 0, 0, 0)  # S16_LE
    struct.pack_into('<8I', b, 68, 1, 0, 0, 0, 0, 0, 0, 0)       # STANDARD
    fixed = {2: channels, 3: rate, 5: period, 7: periods}        # interval index
    for i in range(21):
        lo, hi = (fixed[i], fixed[i]) if i in fixed else (0, 0xffffffff)
        struct.pack_into('<III', b, 260 + 12 * i, lo, hi, 0)
    struct.pack_into('<I', b, 512, 0xffffffff)                   # rmask
    return b


class HostlessPcm:
    def __init__(self):
        self.fds = []

    def open(self):
        card = os.path.basename(os.path.realpath('/proc/asound/' + CARD))[4:]
        for d in 'pc':
            fd = os.open('/dev/snd/pcmC%sD%d%s' % (card, PCM_DEVICE, d), os.O_RDWR)
            try:
                fcntl.ioctl(fd, HW_PARAMS, _hw_params(1, RATE, RATE // 50, 4))
                fcntl.ioctl(fd, PREPARE)
                fcntl.ioctl(fd, START)
            except OSError:
                os.close(fd)
                self.close()
                raise
            self.fds.append(fd)

    def close(self):
        for fd in self.fds:
            try:
                fcntl.ioctl(fd, DROP)
            except OSError:
                pass
            os.close(fd)
        self.fds = []


# ---- modem speech task -----------------------------------------------------------------

class Speech:
    def __init__(self, log, dev='/dev/ccci_aud'):
        self.log, self.dev = log, dev
        self.fd = None
        self.lock = threading.Lock()
        self.acks = {}
        self.cond = threading.Condition()
        self.alive = False
        self.on = False
        self.device = 'earpiece'
        self.pcm = HostlessPcm()

    def send_mailbox(self, msg_id, p16=0, p32=0):
        os.write(self.fd, struct.pack('<IHHII', 0xffffffff, p16, msg_id, 0, p32))

    def send_payload(self, msg_id, dtype, data):
        n = len(data)
        os.write(self.fd, struct.pack('<IIIHHHHH', 0, n + 6, 0, n + 6, msg_id,
                                      0xa2a2, dtype, n) + data)

    def request(self, msg_id, send, timeout=2.0):
        """Send a request that the modem acknowledges; True once the ack arrived."""
        with self.cond:
            self.acks.pop(msg_id | ACK, None)
        send()
        with self.cond:
            self.cond.wait_for(lambda: (msg_id | ACK) in self.acks, timeout)
            ack = self.acks.pop(msg_id | ACK, None)
        self.log('speech', hex(msg_id), 'ack' if ack is not None else 'no ack')
        return ack is not None

    def reader(self):
        self.fd = os.open(self.dev, os.O_RDWR)
        while True:
            try:
                d = os.read(self.fd, 4096)
            except OSError as e:
                self.log('speech read', e)
                time.sleep(1)
                continue
            if len(d) < 16:
                continue
            if struct.unpack_from('<I', d)[0] == 0xffffffff:
                p16, msg = struct.unpack_from('<HH', d, 4)
            else:
                p16, msg = struct.unpack_from('<HH', d, 12)
            if msg == MD_ALIVE:
                self.alive = True
                self.log('speech: modem speech task alive, version 0x%04x' %
                         (struct.unpack_from('<H', d, 28)[0] if len(d) >= 30 else 0))
                self.send_mailbox(MD_ALIVE & ~ACK)
            elif msg == MD_EPOF:
                self.log('speech: modem power-off notice')
                self.send_mailbox(MD_EPOF & ~ACK)
            elif msg == MD_NW_CODEC:
                self.send_mailbox(MD_NW_CODEC & ~ACK)
            elif msg & ACK:
                with self.cond:
                    self.acks[msg] = p16
                    self.cond.notify_all()
            else:
                self.log('speech: modem message', hex(msg))

    def speech_on(self):
        if self.on:
            return True
        try:
            self.pcm.open()
        except OSError as e:
            self.log('speech: hostless PCM', e)
            return False
        if not self.request(MSG_SPH_ON, lambda: self.send_payload(
                MSG_SPH_ON, SPH_INFO_TYPE, sph_info(self.device))):
            self.pcm.close()
            return False
        self.on = True
        return True

    def speech_off(self):
        if not self.on:
            return True
        ok = self.request(MSG_SPH_OFF, lambda: self.send_mailbox(MSG_SPH_OFF))
        self.pcm.close()
        self.on = False
        return ok

    def set_device(self, name):
        self.device = name
        if not self.on:
            return True
        return self.request(MSG_DEV_CHANGE, lambda: self.send_payload(
            MSG_DEV_CHANGE, SPH_INFO_TYPE, sph_info(name)))

    def handle(self, line):
        a = line.split()
        with self.lock:
            if a == ['on']:
                return self.speech_on()
            if a == ['off']:
                return self.speech_off()
            if len(a) == 2 and a[0] == 'device' and a[1] in DEVICES:
                return self.set_device(a[1])
            if len(a) == 2 and a[0] in ('ul-mute', 'dl-mute') and a[1] in '01':
                if not self.on:
                    return False
                m = MSG_UL_MUTE if a[0] == 'ul-mute' else MSG_DL_MUTE
                return self.request(m, lambda: self.send_mailbox(m, int(a[1])), 0.5)
        return False

    def server(self):
        os.makedirs(os.path.dirname(SOCK), exist_ok=True)
        try:
            os.unlink(SOCK)
        except FileNotFoundError:
            pass
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.bind(SOCK)
        # the session's audio server runs the UCM verb; only the audio group may switch speech
        os.chown(SOCK, 0, grp.getgrnam('audio').gr_gid)
        os.chmod(SOCK, 0o660)
        s.listen(4)
        while True:
            c, _ = s.accept()
            with c:
                c.settimeout(5)
                try:
                    line = c.recv(64).decode(errors='replace').strip()
                    c.sendall(b'ok\n' if self.handle(line) else b'fail\n')
                except OSError:
                    pass

    def start(self):
        threading.Thread(target=self.reader, daemon=True).start()
        threading.Thread(target=self.server, daemon=True).start()


def main():
    if len(sys.argv) < 2:
        print('usage: luma-titan2e-speech on|off|device NAME|ul-mute 0|1|dl-mute 0|1',
              file=sys.stderr)
        return 2
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5)
    try:
        s.connect(SOCK)
        s.sendall(' '.join(sys.argv[1:]).encode() + b'\n')
        r = s.recv(16).decode().strip()
    except OSError as e:
        print('luma-titan2e-speech:', e, file=sys.stderr)
        return 1
    # the UCM verb must not fail the profile switch because speech control failed
    if r != 'ok':
        print('luma-titan2e-speech: %s failed' % ' '.join(sys.argv[1:]), file=sys.stderr)
    return 0


if __name__ == '__main__':
    sys.exit(main())
