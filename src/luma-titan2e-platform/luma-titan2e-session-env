#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Run a greetd session command with the device session variables (session.d
# KEY=VALUE lines, as luma-phosh-session reads them), so the presence greeter
# renders like the normal session.
for env_file in /usr/lib/luma/session.d/*.env /etc/luma/session.d/*.env; do
	[ -r "$env_file" ] || continue
	while IFS='=' read -r key value; do
		case "$key" in
		'' | '#'*) continue ;;
		esac
		export "$key=$value"
	done <"$env_file"
done
exec "$@"
