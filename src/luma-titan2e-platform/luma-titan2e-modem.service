# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Titan 2 Elite cellular modem (MediaTek CCCI)
After=systemd-udevd.service local-fs.target dbus.service
Before=ModemManager.service

[Service]
Type=notify
NotifyAccess=main
ExecStartPre=/usr/libexec/luma-titan2e-modem-up
EnvironmentFile=-/etc/default/luma-modem
ExecStart=/usr/libexec/luma-modemd
TimeoutStartSec=120
# ModemManager's initial EPS bearer settings
StateDirectory=luma-titan2e-modem
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
