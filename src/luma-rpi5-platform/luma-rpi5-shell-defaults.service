# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Raspberry Pi 5 Shell defaults
Documentation=file:///usr/share/doc/luma-rpi5-platform/README.md
ConditionFirmware=|device-tree-compatible(raspberrypi,5-model-b)
ConditionFirmware=|device-tree-compatible(raspberrypi,5-model-b-d0)
DefaultDependencies=no
After=local-fs.target
Before=systemd-user-sessions.service display-manager.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/luma-rpi5-shell-defaults

[Install]
WantedBy=sysinit.target
