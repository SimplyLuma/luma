+  // Diagnostic-only raw transport. The normal DMA capture path is unchanged.
+  bool SendSharedFrame(
+      const base::ReadOnlySharedMemoryRegion& region,
+      const media::mojom::VideoFrameInfo& info,
+      const gfx::Rect& content_rect,
+      mojo::Remote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks>* lease) {
+    constexpr size_t kMaxBytes = 64 * 1024 * 1024;
+    const int width = info.coded_size.width();
+    const int height = info.coded_size.height();
+    if (!frame_socket_.is_valid() || pending_frames_.size() >= 3 ||
+        !region.IsValid() || region.GetSize() > kMaxBytes ||
+        width <= 0 || width > 5120 || height <= 0 || height > 3200 ||
+        info.pixel_format != media::PIXEL_FORMAT_ARGB || content_rect.IsEmpty() ||
+        !gfx::Rect(info.coded_size).Contains(content_rect)) return false;
+    const uint32_t stride = info.strides ? info.strides->stride_by_plane[0]
+                                         : static_cast<uint32_t>(width * 4);
+    const uint64_t length = static_cast<uint64_t>(stride) * height;
+    if (stride < static_cast<uint32_t>(width * 4) || length > kMaxBytes ||
+        length > region.GetSize()) return false;
+    // ARGB default capture uses Skia N32, whose byte order is platform-defined.
+    static_assert(kN32_SkColorType == kBGRA_8888_SkColorType ||
+                  kN32_SkColorType == kRGBA_8888_SkColorType);
+    constexpr const char* fourcc = [] {
+      if constexpr (kN32_SkColorType == kBGRA_8888_SkColorType) {
+        return "AR24";
+      } else {
+        return "AB24";
+      }
+    }();
+    // gfx enum values differ from CICP. Map named, supported actual colors;
+    // never relabel unsupported/custom/derived states as sRGB.
+    const gfx::ColorSpace& color = info.color_space;
+    if (!color.IsValid() || color.GetTransferID() != gfx::ColorSpace::TransferID::SRGB ||
+        color.GetMatrixID() != gfx::ColorSpace::MatrixID::RGB ||
+        color.GetRangeID() != gfx::ColorSpace::RangeID::FULL) return false;
+    int primaries = 0;
+    switch (color.GetPrimaryID()) {
+      case gfx::ColorSpace::PrimaryID::BT709: primaries = 1; break;
+      case gfx::ColorSpace::PrimaryID::P3: primaries = 12; break;
+      default: return false;
+    }
+    const int fd = region.GetPlatformHandle().fd;
+    if (fd < 0 || next_frame_id_ == std::numeric_limits<int>::max()) return false;
+    const int id = next_frame_id_++;
+    base::DictValue metadata;
+    metadata.Set("kind", "frame");
+    metadata.Set("version", 2);
+    metadata.Set("transport", "shm");
+    metadata.Set("id", id);
+    metadata.Set("window_id", browser_->session_id().id());
+    metadata.Set("target_id", capture_target_id_);
+    auto* organization = ViolaOrganizationStore::Get(browser_->profile());
+    std::string tab_id = organization && organization->loaded() && web_contents()
+                             ? organization->TabIdFor(web_contents()) : std::string();
+    if (browser_->is_type_devtools() || browser_->profile()->IsOffTheRecord()) {
+      auto* tab = browser_->tab_strip_model()->GetActiveTab();
+      tab_id = tab ? "chromium-tab-" + base::NumberToString(tab->GetHandle().raw_value())
+                   : std::string();
+    }
+    metadata.Set("tab_id", tab_id);
+    metadata.Set("width", width);
+    metadata.Set("height", height);
+    metadata.Set("fourcc", fourcc);
+    metadata.Set("stride", static_cast<int>(stride));
+    metadata.Set("offset", 0);
+    metadata.Set("region_size", static_cast<int>(region.GetSize()));
+    metadata.Set("content_x", content_rect.x());
+    metadata.Set("content_y", content_rect.y());
+    metadata.Set("content_width", content_rect.width());
+    metadata.Set("content_height", content_rect.height());
+    metadata.Set("color_primaries", primaries);
+    metadata.Set("transfer_characteristics", 13);
+    metadata.Set("matrix_coefficients", 0);
+    metadata.Set("full_range", 1);
+    std::string json;
+    if (!base::JSONWriter::Write(metadata, &json)) return false;
+    iovec data{json.data(), json.size()};
+    std::array<int, 1> fds{fd};
+    alignas(cmsghdr) uint8_t control[CMSG_SPACE(sizeof(int))]{};
+    msghdr message{};
+    message.msg_iov = &data;
+    message.msg_iovlen = 1;
+    message.msg_control = control;
+    message.msg_controllen = sizeof(control);
+    cmsghdr* rights = CMSG_FIRSTHDR(&message);
+    rights->cmsg_level = SOL_SOCKET;
+    rights->cmsg_type = SCM_RIGHTS;
+    rights->cmsg_len = CMSG_LEN(sizeof(int));
+    base::span(control).subspan(CMSG_LEN(0), sizeof(int))
+        .copy_from(base::as_byte_span(fds));
+    if (sendmsg(frame_socket_.get(), &message, MSG_DONTWAIT | MSG_NOSIGNAL) !=
+        static_cast<ssize_t>(json.size())) return false;
+    pending_frames_.emplace(id, std::move(*lease));
+    return true;
+  }
