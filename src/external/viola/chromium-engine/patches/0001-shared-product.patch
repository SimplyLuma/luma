+bool MovePersistentTabToSection(base::DictValue &organization,
+                                std::string_view tab_id, bool pinned) {
+  for (base::Value &space_value : *organization.FindList("spaces")) {
+    base::DictValue &space = space_value.GetDict();
+    base::ListValue *source = space.FindList(pinned ? "today" : "pinned");
+    base::ListValue *destination = space.FindList(pinned ? "pinned" : "today");
+    for (auto tab = source->begin(); tab != source->end(); ++tab) {
+      if (StringOr(&tab->GetDict(), "id") != tab_id) {
+        continue;
+      }
+      base::Value moved = std::move(*tab);
+      source->erase(tab);
+      destination->Append(std::move(moved));
+      return true;
+    }
+  }
+  return false;
+}
