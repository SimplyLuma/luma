+IN_PROC_BROWSER_TEST_F(ViolaPersistedOrganizationBrowserTest,
+                       RemoteDormantTabSurvivesApplyReconcileAndExport) {
+  viola::ViolaOrganizationStore *organization_store =
+      viola::ViolaOrganizationStore::Get(browser()->profile());
+  ASSERT_TRUE(organization_store);
+  base::test::TestFuture<void> loaded;
+  organization_store->EnsureLoaded(loaded.GetCallback());
+  ASSERT_TRUE(loaded.Wait());
+  TabStripModel *tab_strip = browser()->tab_strip_model();
+  ASSERT_TRUE(tab_strip);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    content::WebContents *candidate = tab_strip->GetActiveWebContents();
+    return organization_store->loaded() && tab_strip->count() == 1 &&
+           candidate &&
+           organization_store->TabIdFor(candidate) == "restored-tab";
+  }));
+
+  base::DictValue remote = organization_store->ExportOrganizationForSync();
+  ASSERT_TRUE(remote.FindList("spaces"));
+  base::DictValue *later = nullptr;
+  for (base::Value &candidate : *remote.FindList("spaces")) {
+    const std::string *id = candidate.GetDict().FindString("id");
+    if (id && *id == "space-two") {
+      later = &candidate.GetDict();
+      break;
+    }
+  }
+  ASSERT_TRUE(later);
+  base::DictValue canary;
+  canary.Set("id", "android-canary-stable-id");
+  canary.Set("url", "https://example.com/?viola-sync-canary=mac-test");
+  canary.Set("title", "Android canary");
+  canary.Set("favicon", base::Value());
+  later->FindList("today")->Append(std::move(canary));
+
+  ASSERT_TRUE(organization_store->ApplyOrganizationFromSync(remote, browser(),
+                                                            tab_strip));
+  organization_store->ReconcileAndMaterialize(browser(), tab_strip);
+  base::RunLoop().RunUntilIdle();
+
+  auto canary_count = [](const base::DictValue &organization) {
+    int count = 0;
+    for (const base::Value &space : *organization.FindList("spaces")) {
+      for (std::string_view section : {"pinned", "today"}) {
+        for (const base::Value &tab : *space.GetDict().FindList(section)) {
+          const std::string *id = tab.GetDict().FindString("id");
+          if (id && *id == "android-canary-stable-id") {
+            ++count;
+          }
+        }
+      }
+    }
+    return count;
+  };
+  auto canary_digest = [](const base::DictValue &organization) {
+    for (const base::Value &space : *organization.FindList("spaces")) {
+      for (std::string_view section : {"pinned", "today"}) {
+        for (const base::Value &tab : *space.GetDict().FindList(section)) {
+          const std::string *id = tab.GetDict().FindString("id");
+          if (id && *id == "android-canary-stable-id") {
+            return viola::ViolaAccountSyncService::RecordDigestForTesting(
+                tab.Clone());
+          }
+        }
+      }
+    }
+    return std::string();
+  };
+  base::DictValue first_export =
+      organization_store->ExportOrganizationForSync();
+  EXPECT_EQ(1, canary_count(first_export));
+  EXPECT_EQ(TabStripModel::kNoTab, organization_store->FindTabIndex(
+                                       tab_strip, "android-canary-stable-id"));
+
+  const std::string first_digest = canary_digest(first_export);
+  ASSERT_FALSE(first_digest.empty());
+  organization_store->ReconcileAndMaterialize(browser(), tab_strip);
+  base::RunLoop().RunUntilIdle();
+  base::DictValue second_export =
+      organization_store->ExportOrganizationForSync();
+  EXPECT_EQ(1, canary_count(second_export));
+  EXPECT_EQ(first_digest, canary_digest(second_export));
+}
