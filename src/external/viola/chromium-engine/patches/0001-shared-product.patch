+void AppendBookmarkRows(const bookmarks::BookmarkNode *node,
+                        base::ListValue &rows) {
+  if (!node || rows.size() >= 5000) {
+    return;
+  }
+  if (node->is_url() && node->url().SchemeIsHTTPOrHTTPS()) {
+    base::DictValue row;
+    row.Set("id", node->uuid().AsLowercaseString());
+    row.Set("title", base::UTF16ToUTF8(node->GetTitle()));
+    row.Set("url", node->url().spec());
+    row.Set("added", static_cast<double>(
+                         node->date_added().InMillisecondsSinceUnixEpoch()));
+    row.Set("profileId", "");
+    row.Set("profileName", "");
+    row.Set(
+        "favicon",
+        base::StrCat({"chrome://favicon2/?size=32&scaleFactor=1x&"
+                      "showFallbackMonogram=&pageUrl=",
+                      base::EscapeQueryParamValue(node->url().spec(), true)}));
+    rows.Append(std::move(row));
+  }
+  for (const auto &child : node->children()) {
+    AppendBookmarkRows(child.get(), rows);
+  }
+}
