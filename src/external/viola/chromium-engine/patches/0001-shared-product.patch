+void ViolaMessageHandler::HandleTabsMenu(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() < 1 ||
+      payload.GetDict().size() > 2 || !organization_store_ ||
+      !organization_store_->loaded()) {
