+        base::UTF8ToUTF16(ui::ResourceBundle::GetSharedInstance()
+                            .LoadDataResourceString(IDR_VIOLA_BROWSER_TOOLS_LUMA_JS)),
+        base::BindOnce(&ViolaBrowserToolThemeObserver::OnThemeApplied,
+                       weak_factory_.GetWeakPtr()));
+#else
