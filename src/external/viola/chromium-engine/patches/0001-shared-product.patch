+std::optional<std::string>
+ViolaOrganizationStore::CreateSingleTabGroup(std::string_view tab_id,
+                                             std::string_view space_id) {
+  if (!loaded_ || tab_id.empty()) {
+    return std::nullopt;
+  }
+  base::DictValue *space = FindSpace(organization_, space_id);
+  if (!space || !SpaceOwnsPersistentTab(*space, tab_id) ||
+      space->FindList("tabGroups")->size() >= 1000) {
+    return std::nullopt;
+  }
+  for (const base::Value &group : *space->FindList("tabGroups")) {
+    for (const base::Value &id : *group.GetDict().FindList("tabIds")) {
+      if (id.is_string() && id.GetString() == tab_id) {
+        return std::nullopt;
+      }
+    }
+  }
+  const std::string group_id =
+      "group-" + base::Uuid::GenerateRandomV4().AsLowercaseString();
+  base::DictValue group;
+  group.Set("id", group_id);
+  group.Set("title", "Tab Group");
+  base::ListValue ids;
+  ids.Append(tab_id);
+  group.Set("tabIds", std::move(ids));
+  group.Set("section",
+            IsLogicalPinned(organization_, tab_id) ? "pinned" : "today");
+  group.Set("keepExpanded", false);
+  group.Set("collapsed", false);
+  group.Set("saved", false);
+  group.Set("savedTabs", base::ListValue());
+  space->FindList("tabGroups")->Append(std::move(group));
+  ScheduleWrite();
+  return group_id;
+}
+
+bool ViolaOrganizationStore::RemoveTabFromGroup(std::string_view tab_id) {
+  if (!loaded_ || tab_id.empty()) {
+    return false;
+  }
+  bool found = false;
+  for (const base::Value &space : *organization_.FindList("spaces")) {
+    for (const base::Value &group : *space.GetDict().FindList("tabGroups")) {
+      for (const base::Value &id : *group.GetDict().FindList("tabIds")) {
+        found = found || (id.is_string() && id.GetString() == tab_id);
+      }
+    }
+  }
+  if (!found) {
+    return false;
+  }
+  RemoveTabFromOrganizationGroups(organization_, tab_id,
+                                  /*forget_saved_snapshot=*/true);
+  ScheduleWrite();
+  return true;
+}
