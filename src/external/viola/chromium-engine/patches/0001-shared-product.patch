diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index 973a46b2a34bb170e49417f4f76f8b2d899317d8..49d09f150e502d24cbdb0d2ee459bc96b1e7c234 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -129,6 +129,12 @@ group("assert_no_deps") {
   assert_no_deps = [ "//chrome/installer/util:strings" ]
 }
 
+config("viola_linux_link_memory") {
+  if (is_linux) {
+    ldflags = [ "-Wl,--thinlto-jobs=4" ]
+  }
+}
+
 if (!is_android && !is_mac) {
   group("chrome") {
     public_deps = [ ":chrome_initial" ]
@@ -155,6 +161,7 @@ if (!is_android && !is_mac) {
   }
 
   executable("chrome_initial") {
+    configs += [ ":viola_linux_link_memory" ]
     configs -= [ "//build/config/compiler:thinlto_optimize_default" ]
     configs += [ "//build/config/compiler:thinlto_optimize_max" ]
     output_name = _chrome_output_name
