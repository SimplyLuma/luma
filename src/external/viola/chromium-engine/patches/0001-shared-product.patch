+constexpr char kProfileServiceKey[] = "viola-account-sync-service";
+constexpr char kStateType[] = "viola-native-account-sync";
+constexpr int kStateVersion = 1;
+constexpr char kEndpoint[] = "https://api.violabrowser.com";
+constexpr char kKeyWrapAad[] = "viola-sync-key-wrap:1";
+constexpr char kEncryptedSnapshotType[] = "viola-encrypted-sync-queue";
+constexpr char kSyncPayloadType[] = "viola-tab-workspace-sync";
+constexpr char kPayloadAad[] = "viola-encrypted-sync-queue:1";
+constexpr int kClientProtocolVersion = 2;
+constexpr int kKeyWrapIterations = 310000;
+constexpr size_t kMaximumStateBytes = 4 * 1024 * 1024;
+constexpr size_t kMaximumResponseBytes = 4 * 1024 * 1024;
+#if BUILDFLAG(IS_LINUX)
+constexpr int kDefaultSidebarWidth = 252;
+#else
+constexpr int kDefaultSidebarWidth = 264;
+#endif
+// The production manifest can contain up to 32 separately bounded encrypted
+// device snapshots. Keep ordinary account responses small, but allow the
+// aggregate snapshot response to contain the current multi-device account.
+constexpr size_t kMaximumSnapshotResponseBytes = 64 * 1024 * 1024;
+// Workspace/profile records are always retained. History is a best-effort
+// companion to organization sync and must never make tab/workspace transport
+// exceed the four-megabyte encrypted-request boundary. Keep a deterministic
+// frontier of recent history records inside a two-megabyte plaintext budget,
+// leaving ample room for the payload wrapper, AEAD tag, and base64 expansion.
+constexpr size_t kMaximumSyncedHistoryRecords = 6000;
+constexpr size_t kMaximumSyncedRecordBytes = 2 * 1024 * 1024;
+std::string CleanText(const std::string *value, size_t maximum) {
+  if (!value) {
+    return {};
+  }
+  std::string result(*value);
+  base::TrimWhitespaceASCII(result, base::TRIM_ALL, &result);
+  if (result.size() > maximum || !base::IsStringUTF8(result)) {
+    return {};
+  }
+  return result;
+}
+
+bool IsEmail(std::string_view value) {
+  const size_t at = value.find('@');
+  const size_t dot = value.rfind('.');
+  return !value.empty() && value.size() <= 320 && at > 0 &&
+         at != std::string_view::npos && dot != std::string_view::npos &&
+         dot > at + 1 && dot + 1 < value.size() &&
+         value.find_first_of(" \t\r\n") == std::string_view::npos;
+}
+
+bool IsBase64UrlToken(std::string_view value, size_t exact_size) {
+  return value.size() == exact_size &&
+         std::all_of(value.begin(), value.end(), [](char character) {
+           return base::IsAsciiAlpha(character) ||
+                  base::IsAsciiDigit(character) || character == '_' ||
+                  character == '-';
+         });
+}
+
+base::DictValue ErrorResult(std::string message) {
+  base::DictValue result;
+  result.Set("ok", false);
+  result.Set("error", std::move(message));
+  return result;
+}
+
+base::DictValue ProtectedTransportUnavailableConnection(
+    const base::DictValue *stored_connection) {
+  base::DictValue connection =
+      stored_connection ? stored_connection->Clone() : base::DictValue();
+  connection.Set("connected", false);
+  connection.Set("lastError", kProtectedTransportUnavailableError);
+  if (!connection.contains("lastSyncedAt")) {
+    connection.Set("lastSyncedAt", base::Value());
+  }
+  return connection;
+}
+
+base::DictValue LoadStateOnBackgroundSequence(base::FilePath path) {
+  if (!base::CreateDirectory(path.DirName())) {
+    return {};
+  }
+  std::string bytes;
+  if (!base::ReadFileToStringWithMaxSize(path, &bytes, kMaximumStateBytes)) {
+    return {};
+  }
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(bytes, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return {};
+  }
+  base::DictValue state = std::move(*parsed).TakeDict();
+  const std::string *type = state.FindString("type");
+  const std::string *endpoint = state.FindString("endpoint");
+  const bool signed_in = state.FindDict("account") != nullptr;
+  const bool valid_identity =
+      signed_in ? state.FindDict("device") &&
+                      state.FindString("protectedSecrets")
+                : !CleanText(state.FindString("installationDeviceId"), 80)
+                       .empty();
+  if (!type || *type != kStateType ||
+      state.FindInt("version") != kStateVersion || !valid_identity || !endpoint ||
+      *endpoint != kEndpoint) {
+    return {};
+  }
+  return state;
+}
+
+std::optional<std::vector<uint8_t>>
+DecodeBase64Field(const base::DictValue &value, std::string_view key,
+                  size_t expected_size) {
+  const std::string *encoded = value.FindString(key);
+  std::optional<std::vector<uint8_t>> decoded =
+      encoded ? base::Base64Decode(*encoded) : std::nullopt;
+  return decoded && decoded->size() == expected_size ? std::move(decoded)
+                                                     : std::nullopt;
+}
+
+std::optional<std::vector<uint8_t>> Base64UrlDecode(std::string value) {
+  base::ReplaceChars(value, "-", "+", &value);
+  base::ReplaceChars(value, "_", "/", &value);
+  while (value.size() % 4) {
+    value.push_back('=');
+  }
+  return base::Base64Decode(value);
+}
+
+std::string ValueDigest(const base::Value &value) {
+  std::string serialized;
+  if (!base::JSONWriter::WriteWithOptions(
+          value, base::JSONWriter::OPTIONS_OMIT_DOUBLE_TYPE_PRESERVATION,
+          &serialized)) {
+    return {};
+  }
+  const auto digest = crypto::hash::Sha256(base::as_byte_span(serialized));
+  return base::ToLowerASCII(base::HexEncode(digest));
+}
+
+int CompareRecordVersions(const base::DictValue &left,
+                          const base::DictValue &right) {
+  // Revisions are per-record Lamport clocks: a device pulls first and advances
+  // the winning revision before publishing a local mutation. They must be the
+  // primary authority key. Wall time is only a same-revision tie-breaker;
+  // prioritizing it allowed an unchanged peer with a later clock to erase a
+  // just-uploaded tab on the following pull.
+  const int left_revision = left.FindInt("revision").value_or(0);
+  const int right_revision = right.FindInt("revision").value_or(0);
+  if (left_revision != right_revision) {
+    return left_revision < right_revision ? -1 : 1;
+  }
+  const std::string left_time = CleanText(left.FindString("updatedAt"), 40);
+  const std::string right_time = CleanText(right.FindString("updatedAt"), 40);
+  if (left_time != right_time) {
+    base::Time parsed_left;
+    base::Time parsed_right;
+    if (base::Time::FromString(left_time.c_str(), &parsed_left) &&
+        base::Time::FromString(right_time.c_str(), &parsed_right)) {
+      if (parsed_left != parsed_right) {
+        return parsed_left < parsed_right ? -1 : 1;
+      }
+    } else {
+      return left_time < right_time ? -1 : 1;
+    }
+  }
+  const std::string left_device = CleanText(left.FindString("deviceId"), 80);
+  const std::string right_device = CleanText(right.FindString("deviceId"), 80);
+  if (left_device != right_device) {
+    return left_device < right_device ? -1 : 1;
+  }
+  const bool left_deleted = left.FindBool("deleted").value_or(false);
+  const bool right_deleted = right.FindBool("deleted").value_or(false);
+  if (left_deleted != right_deleted) {
+    return left_deleted ? 1 : -1;
+  }
+  const std::string left_hash = CleanText(left.FindString("hash"), 64);
+  const std::string right_hash = CleanText(right.FindString("hash"), 64);
+  return left_hash == right_hash ? 0 : left_hash < right_hash ? -1 : 1;
+}
+
+bool IsRecordKey(std::string_view key) {
+  if (key == "workspace-index") {
+    return true;
+  }
+  const size_t colon = key.find(':');
+  if (colon == std::string_view::npos || colon == 0 || key.size() > 240) {
+    return false;
+  }
+  const std::string_view prefix = key.substr(0, colon);
+  return prefix == "profile" || prefix == "workspace" || prefix == "history";
+}
+
+std::optional<base::DictValue>
+NormalizeAuthenticatedRecord(const base::DictValue &source,
+                             std::string_view fallback_device_id,
+                             std::string_view fallback_updated_at) {
+  const std::string key = CleanText(source.FindString("key"), 240);
+  if (!IsRecordKey(key)) {
+    return std::nullopt;
+  }
+  base::DictValue normalized = source.Clone();
+  normalized.Set("key", key);
+  if (!normalized.FindInt("revision")) {
+    normalized.Set("revision", 0);
+  }
+  if (CleanText(normalized.FindString("updatedAt"), 40).empty()) {
+    const std::string fallback(fallback_updated_at);
+    normalized.Set("updatedAt", CleanText(&fallback, 40));
+  }
+  if (CleanText(normalized.FindString("deviceId"), 80).empty()) {
+    const std::string fallback(fallback_device_id);
+    normalized.Set("deviceId", CleanText(&fallback, 80));
+  }
+  if (CleanText(normalized.FindString("updatedAt"), 40).empty() ||
+      CleanText(normalized.FindString("deviceId"), 80).empty()) {
+    return std::nullopt;
+  }
+  const bool deleted = normalized.FindBool("deleted").value_or(false);
+  normalized.Set("deleted", deleted);
+  if (deleted) {
+    normalized.Set("hash", base::Value());
+    normalized.Set("value", base::Value());
+    return normalized;
+  }
+  const base::DictValue *value = normalized.FindDict("value");
+  if (!value) {
+    return std::nullopt;
+  }
+  // The AES-GCM snapshot already authenticates this value. Recompute its
+  // digest after JSON parsing instead of trusting a language-specific JSON
+  // number serialization from a peer client. The digest remains the stable
+  // local manifest/tie-break value, but `1` versus `1.0` cannot discard an
+  // otherwise valid Android workspace.
+  normalized.Set("hash", ValueDigest(base::Value(value->Clone())));
+  return normalized;
+}
+
+bool WorkspaceRecordHasPortableContent(const base::DictValue &record) {
+  if (record.FindBool("deleted").value_or(false)) {
+    return false;
+  }
+  const base::DictValue *value = record.FindDict("value");
+  if (!value) {
+    return false;
+  }
+  for (std::string_view key : {"pinned", "today", "tabGroups"}) {
+    const base::ListValue *items = value->FindList(key);
+    if (items && !items->empty()) {
+      return true;
+    }
+  }
+  return value->Find("split") && !value->Find("split")->is_none();
+}
+
+bool OrganizationHasPortableContent(const base::DictValue &organization) {
+  if (const base::ListValue *profiles = organization.FindList("profiles")) {
+    for (const base::Value &candidate : *profiles) {
+      const base::DictValue *profile = candidate.GetIfDict();
+      const base::ListValue *favorites =
+          profile ? profile->FindList("favorites") : nullptr;
+      if (favorites && !favorites->empty()) {
+        return true;
+      }
+    }
+  }
+  if (const base::ListValue *spaces = organization.FindList("spaces")) {
+    for (const base::Value &candidate : *spaces) {
+      const base::DictValue *space = candidate.GetIfDict();
+      if (!space) {
+        continue;
+      }
+      base::DictValue record;
+      record.Set("deleted", false);
+      record.Set("value", space->Clone());
+      if (WorkspaceRecordHasPortableContent(record)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+bool SameOptionalValue(const base::Value *left, const base::Value *right) {
+  if (!left || !right) {
+    return left == right;
+  }
+  return ValueDigest(*left) == ValueDigest(*right);
+}
+
+const base::Value *PickThreeWayValue(const base::Value *base_value,
+                                     const base::Value *local_value,
+                                     const base::Value *peer_value,
+                                     bool prefer_local) {
+  if (SameOptionalValue(local_value, peer_value)) {
+    return local_value;
+  }
+  if (SameOptionalValue(local_value, base_value)) {
+    return peer_value;
+  }
+  if (SameOptionalValue(peer_value, base_value)) {
+    return local_value;
+  }
+  return prefer_local ? local_value : peer_value;
+}
+
+struct KeyedValues {
+  std::map<std::string, base::DictValue> values;
+  std::vector<std::string> order;
+};
+
+constexpr size_t kMaximumWorkspaceTabTombstones = 4096;
+
+struct WorkspaceTabCandidate {
+  base::DictValue record;
+  base::DictValue tab;
+  std::string section;
+  size_t index = 0;
+};
+
+using WorkspaceTabCandidates =
+    std::map<std::string, std::map<std::string, WorkspaceTabCandidate>>;
+
+std::set<std::string> ReadWorkspaceTabTombstones(
+    const base::DictValue &workspace) {
+  std::set<std::string> result;
+  const base::ListValue *items = workspace.FindList("syncRemovedTabIds");
+  if (!items) {
+    return result;
+  }
+  for (const base::Value &candidate : *items) {
+    if (result.size() >= kMaximumWorkspaceTabTombstones) {
+      break;
+    }
+    const std::string id =
+        candidate.is_string() ? CleanText(&candidate.GetString(), 160)
+                              : std::string();
+    if (!id.empty()) {
+      result.insert(id);
+    }
+  }
+  return result;
+}
+
+bool SplitContainsAnyTab(const base::Value *node,
+                         const std::set<std::string> &tab_ids, int depth = 0) {
+  const base::DictValue *dict = node ? node->GetIfDict() : nullptr;
+  if (!dict || depth > 24) {
+    return false;
+  }
+  if (CleanText(dict->FindString("t"), 16) == "leaf") {
+    return tab_ids.contains(CleanText(dict->FindString("tabId"), 160));
+  }
+  const base::ListValue *children = dict->FindList("kids");
+  if (!children) {
+    return false;
+  }
+  for (const base::Value &child : *children) {
+    if (SplitContainsAnyTab(&child, tab_ids, depth + 1)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ApplyWorkspaceTabTombstones(base::DictValue &workspace,
+                                 const std::set<std::string> &tab_ids) {
+  if (tab_ids.empty()) {
+    return false;
+  }
+  const base::DictValue before = workspace.Clone();
+  base::ListValue serialized;
+  for (const std::string &id : tab_ids) {
+    if (serialized.size() >= kMaximumWorkspaceTabTombstones) {
+      break;
+    }
+    serialized.Append(id);
+  }
+  workspace.Set("syncRemovedTabIds", std::move(serialized));
+  for (std::string_view section : {"pinned", "today"}) {
+    base::ListValue *tabs = workspace.FindList(section);
+    if (!tabs) {
+      continue;
+    }
+    for (auto tab = tabs->begin(); tab != tabs->end();) {
+      const base::DictValue *dict = tab->GetIfDict();
+      if (dict && tab_ids.contains(CleanText(dict->FindString("id"), 160))) {
+        tab = tabs->erase(tab);
+      } else {
+        ++tab;
+      }
+    }
+  }
+  if (base::ListValue *groups = workspace.FindList("tabGroups")) {
+    for (auto group = groups->begin(); group != groups->end();) {
+      base::DictValue *dict = group->GetIfDict();
+      base::ListValue *members = dict ? dict->FindList("tabIds") : nullptr;
+      if (members) {
+        for (auto member = members->begin(); member != members->end();) {
+          if (member->is_string() &&
+              tab_ids.contains(CleanText(&member->GetString(), 160))) {
+            member = members->erase(member);
+          } else {
+            ++member;
+          }
+        }
+      }
+      const base::ListValue *saved_tabs =
+          dict ? dict->FindList("savedTabs") : nullptr;
+      const bool retain_saved =
+          dict && dict->FindBool("saved").value_or(false) && saved_tabs &&
+          !saved_tabs->empty();
+      if (!dict || (!retain_saved && (!members || members->empty()))) {
+        group = groups->erase(group);
+      } else {
+        ++group;
+      }
+    }
+  }
+  if (SplitContainsAnyTab(workspace.Find("split"), tab_ids)) {
+    workspace.Set("split", base::Value());
+    workspace.Set("splitTitle", base::Value());
+    workspace.Set("splitKeepExpanded", false);
+  }
+  const std::string active =
+      CleanText(workspace.FindString("activeTabId"), 160);
+  if (tab_ids.contains(active)) {
+    workspace.Set("activeTabId", base::Value());
+  }
+  return workspace != before;
+}
+
+void CollectWorkspaceTabCandidates(const base::DictValue &record,
+                                   WorkspaceTabCandidates &candidates) {
+  const std::string key = CleanText(record.FindString("key"), 240);
+  const base::DictValue *workspace = record.FindDict("value");
+  if (!key.starts_with("workspace:") ||
+      record.FindBool("deleted").value_or(false) || !workspace) {
+    return;
+  }
+  for (std::string_view section : {"pinned", "today"}) {
+    const base::ListValue *tabs = workspace->FindList(section);
+    if (!tabs) {
+      continue;
+    }
+    for (size_t index = 0;
+         index < std::min(tabs->size(), kMaximumWorkspaceTabTombstones);
+         ++index) {
+      const base::DictValue *tab = (*tabs)[index].GetIfDict();
+      const std::string id =
+          tab ? CleanText(tab->FindString("id"), 160) : std::string();
+      if (id.empty()) {
+        continue;
+      }
+      auto &workspace_candidates = candidates[key];
+      auto current = workspace_candidates.find(id);
+      if (current != workspace_candidates.end() &&
+          CompareRecordVersions(current->second.record, record) >= 0) {
+        continue;
+      }
+      workspace_candidates.insert_or_assign(
+          id, WorkspaceTabCandidate{record.Clone(), tab->Clone(),
+                                    std::string(section), index});
+    }
+  }
+}
+
+bool ApplyWorkspaceTabCandidates(
+    base::DictValue &workspace,
+    const std::map<std::string, WorkspaceTabCandidate> &candidates,
+    const std::set<std::string> &removed_tabs,
+    int frontier_revision) {
+  std::set<std::string> existing;
+  for (std::string_view section : {"pinned", "today"}) {
+    if (const base::ListValue *tabs = workspace.FindList(section)) {
+      for (const base::Value &candidate : *tabs) {
+        const base::DictValue *tab = candidate.GetIfDict();
+        const std::string id =
+            tab ? CleanText(tab->FindString("id"), 160) : std::string();
+        if (!id.empty()) {
+          existing.insert(id);
+        }
+      }
+    }
+  }
+  std::vector<const WorkspaceTabCandidate *> missing;
+  for (const auto &[id, candidate] : candidates) {
+    // Older retained device envelopes are historical bases, not live add
+    // operations. Only candidates on the current Lamport frontier may augment
+    // the deterministic winner; otherwise a re-login can resurrect every tab
+    // that an obsolete device snapshot still remembers.
+    if (candidate.record.FindInt("revision").value_or(0) ==
+            frontier_revision &&
+        !removed_tabs.contains(id) && !existing.contains(id)) {
+      missing.push_back(&candidate);
+    }
+  }
+  std::ranges::sort(missing, [](const WorkspaceTabCandidate *left,
+                                const WorkspaceTabCandidate *right) {
+    if (left->section != right->section) {
+      return left->section < right->section;
+    }
+    if (left->index != right->index) {
+      return left->index < right->index;
+    }
+    return CleanText(left->tab.FindString("id"), 160) <
+           CleanText(right->tab.FindString("id"), 160);
+  });
+  bool changed = false;
+  for (const WorkspaceTabCandidate *candidate : missing) {
+    base::ListValue *destination = workspace.FindList(candidate->section);
+    if (!destination || destination->size() >= 2000) {
+      continue;
+    }
+    destination->Append(candidate->tab.Clone());
+    changed = true;
+  }
+  return changed;
+}
+
+void CompactHistoryRecords(base::DictValue &records) {
+  struct Candidate {
+    std::string key;
+    base::DictValue record;
+    size_t serialized_size = 0;
+  };
+  std::vector<Candidate> history;
+  size_t retained_bytes = 2;
+  for (const auto [key, candidate] : records) {
+    const base::DictValue &record = candidate.GetDict();
+    std::string serialized;
+    if (!base::JSONWriter::Write(record, &serialized)) {
+      serialized.clear();
+    }
+    if (!key.starts_with("history:")) {
+      retained_bytes += serialized.size() + 1;
+      continue;
+    }
+    history.push_back(
+        Candidate{key, record.Clone(), serialized.size() + 1});
+  }
+  std::ranges::sort(history, [](const Candidate &left,
+                                const Candidate &right) {
+    const int comparison = CompareRecordVersions(left.record, right.record);
+    return comparison != 0 ? comparison > 0 : left.key < right.key;
+  });
+  std::set<std::string> retained;
+  for (const Candidate &candidate : history) {
+    if (retained.size() >= kMaximumSyncedHistoryRecords ||
+        retained_bytes + candidate.serialized_size >
+            kMaximumSyncedRecordBytes) {
+      continue;
+    }
+    retained.insert(candidate.key);
+    retained_bytes += candidate.serialized_size;
+  }
+  std::vector<std::string> discarded;
+  for (const Candidate &candidate : history) {
+    if (!retained.contains(candidate.key)) {
+      discarded.push_back(candidate.key);
+    }
+  }
+  for (const std::string &key : discarded) {
+    records.Remove(key);
+  }
+}
+
+KeyedValues ReadKeyedList(const base::ListValue *items) {
+  KeyedValues result;
+  if (!items) {
+    return result;
+  }
+  for (const base::Value &candidate : *items) {
+    const base::DictValue *item = candidate.GetIfDict();
+    const std::string id =
+        item ? CleanText(item->FindString("id"), 160) : std::string();
+    if (id.empty() || result.values.contains(id)) {
+      continue;
+    }
+    result.values.emplace(id, item->Clone());
+    result.order.push_back(id);
+  }
+  return result;
+}
+
+KeyedValues ReadWorkspaceTabs(const base::DictValue &workspace) {
+  KeyedValues result;
+  for (std::string_view section : {"pinned", "today"}) {
+    const base::ListValue *items = workspace.FindList(section);
+    if (!items) {
+      continue;
+    }
+    for (const base::Value &candidate : *items) {
+      const base::DictValue *tab = candidate.GetIfDict();
+      const std::string id =
+          tab ? CleanText(tab->FindString("id"), 160) : std::string();
+      if (id.empty() || result.values.contains(id)) {
+        continue;
+      }
+      base::DictValue value = tab->Clone();
+      value.Set("__violaSyncSection", section);
+      result.values.emplace(id, std::move(value));
+      result.order.push_back(id);
+    }
+  }
+  return result;
+}
+
+const base::DictValue *FindKeyedValue(const KeyedValues &values,
+                                      const std::string &id) {
+  auto found = values.values.find(id);
+  return found == values.values.end() ? nullptr : &found->second;
+}
+
+KeyedValues MergeKeyedValues(const KeyedValues &base_values,
+                             const KeyedValues &local_values,
+                             const KeyedValues &peer_values,
+                             bool prefer_local) {
+  KeyedValues result;
+  std::set<std::string> ids;
+  for (const auto &[id, value] : base_values.values) {
+    ids.insert(id);
+  }
+  for (const auto &[id, value] : local_values.values) {
+    ids.insert(id);
+  }
+  for (const auto &[id, value] : peer_values.values) {
+    ids.insert(id);
+  }
+  for (const std::string &id : ids) {
+    const base::DictValue *base_value = FindKeyedValue(base_values, id);
+    const base::DictValue *local_value = FindKeyedValue(local_values, id);
+    const base::DictValue *peer_value = FindKeyedValue(peer_values, id);
+    std::optional<base::Value> base_holder =
+        base_value
+            ? std::optional<base::Value>(base::Value(base_value->Clone()))
+            : std::nullopt;
+    std::optional<base::Value> local_holder =
+        local_value
+            ? std::optional<base::Value>(base::Value(local_value->Clone()))
+            : std::nullopt;
+    std::optional<base::Value> peer_holder =
+        peer_value
+            ? std::optional<base::Value>(base::Value(peer_value->Clone()))
+            : std::nullopt;
+    const base::Value *chosen =
+        PickThreeWayValue(base_holder ? &*base_holder : nullptr,
+                          local_holder ? &*local_holder : nullptr,
+                          peer_holder ? &*peer_holder : nullptr, prefer_local);
+    if (chosen && chosen->is_dict()) {
+      result.values.emplace(id, chosen->GetDict().Clone());
+    }
+  }
+  auto append_order = [&result](const std::vector<std::string> &order) {
+    for (const std::string &id : order) {
+      if (result.values.contains(id) &&
+          std::ranges::find(result.order, id) == result.order.end()) {
+        result.order.push_back(id);
+      }
+    }
+  };
+  append_order(prefer_local ? local_values.order : peer_values.order);
+  append_order(prefer_local ? peer_values.order : local_values.order);
+  append_order(base_values.order);
+  return result;
+}
+
+std::optional<base::DictValue>
+MergeWorkspaceValues(const base::DictValue &base_workspace,
+                     const base::DictValue &local_workspace,
+                     const base::DictValue &peer_workspace, bool prefer_local) {
+  const std::string base_id = CleanText(base_workspace.FindString("id"), 160);
+  if (base_id.empty() ||
+      CleanText(local_workspace.FindString("id"), 160) != base_id ||
+      CleanText(peer_workspace.FindString("id"), 160) != base_id) {
+    return std::nullopt;
+  }
+  base::DictValue merged =
+      (prefer_local ? local_workspace : peer_workspace).Clone();
+
+  std::set<std::string> removed_tabs =
+      ReadWorkspaceTabTombstones(base_workspace);
+  for (const std::string &id : ReadWorkspaceTabTombstones(local_workspace)) {
+    removed_tabs.insert(id);
+  }
+  for (const std::string &id : ReadWorkspaceTabTombstones(peer_workspace)) {
+    removed_tabs.insert(id);
+  }
+
+  const KeyedValues tabs = MergeKeyedValues(
+      ReadWorkspaceTabs(base_workspace), ReadWorkspaceTabs(local_workspace),
+      ReadWorkspaceTabs(peer_workspace), prefer_local);
+  base::ListValue pinned;
+  base::ListValue today;
+  for (const std::string &id : tabs.order) {
+    auto found = tabs.values.find(id);
+    if (found == tabs.values.end()) {
+      continue;
+    }
+    base::DictValue tab = found->second.Clone();
+    const std::string section =
+        CleanText(tab.FindString("__violaSyncSection"), 16);
+    tab.Remove("__violaSyncSection");
+    (section == "pinned" ? pinned : today).Append(std::move(tab));
+  }
+  merged.Set("pinned", std::move(pinned));
+  merged.Set("today", std::move(today));
+
+  const KeyedValues groups = MergeKeyedValues(
+      ReadKeyedList(base_workspace.FindList("tabGroups")),
+      ReadKeyedList(local_workspace.FindList("tabGroups")),
+      ReadKeyedList(peer_workspace.FindList("tabGroups")), prefer_local);
+  base::ListValue merged_groups;
+  for (const std::string &id : groups.order) {
+    auto found = groups.values.find(id);
+    if (found != groups.values.end()) {
+      merged_groups.Append(found->second.Clone());
+    }
+  }
+  merged.Set("tabGroups", std::move(merged_groups));
+
+  for (std::string_view key :
+       {"name", "icon", "theme", "profileId", "split", "splitTitle",
+        "splitKeepExpanded", "tabSort"}) {
+    const base::Value *chosen =
+        PickThreeWayValue(base_workspace.Find(key), local_workspace.Find(key),
+                          peer_workspace.Find(key), prefer_local);
+    if (chosen) {
+      merged.Set(key, chosen->Clone());
+    } else {
+      merged.Remove(key);
+    }
+  }
+  merged.Set("id", base_id);
+  merged.Remove("activeTabId");
+  ApplyWorkspaceTabTombstones(merged, removed_tabs);
+  return merged;
+}
+
+bool RecordPayloadChanged(const base::DictValue &base_record,
+                          const base::DictValue &candidate) {
+  if (base_record.FindBool("deleted").value_or(false) !=
+      candidate.FindBool("deleted").value_or(false)) {
+    return true;
+  }
+  return !SameOptionalValue(base_record.Find("value"), candidate.Find("value"));
+}
+
+std::optional<base::DictValue> MergeConcurrentWorkspaceRecord(
+    const base::DictValue &base_record, const base::DictValue &local_record,
+    const base::DictValue &peer_record, std::string_view device_id) {
+  if (base_record.FindBool("deleted").value_or(false) ||
+      local_record.FindBool("deleted").value_or(false) ||
+      peer_record.FindBool("deleted").value_or(false) ||
+      !RecordPayloadChanged(base_record, local_record) ||
+      !RecordPayloadChanged(base_record, peer_record)) {
+    return std::nullopt;
+  }
+  const base::DictValue *base_value = base_record.FindDict("value");
+  const base::DictValue *local_value = local_record.FindDict("value");
+  const base::DictValue *peer_value = peer_record.FindDict("value");
+  if (!base_value || !local_value || !peer_value) {
+    return std::nullopt;
+  }
+  const bool prefer_local =
+      CompareRecordVersions(peer_record, local_record) < 0;
+  std::optional<base::DictValue> merged = MergeWorkspaceValues(
+      *base_value, *local_value, *peer_value, prefer_local);
+  if (!merged) {
+    return std::nullopt;
+  }
+  const base::DictValue &preferred_record =
+      prefer_local ? local_record : peer_record;
+  const base::DictValue *preferred_value = preferred_record.FindDict("value");
+  const base::Value merged_holder(merged->Clone());
+  const base::Value preferred_holder(preferred_value ? preferred_value->Clone()
+                                                     : base::DictValue());
+  if (preferred_value && SameOptionalValue(&merged_holder, &preferred_holder)) {
+    return std::nullopt;
+  }
+  base::DictValue result = preferred_record.Clone();
+  result.Set("revision", std::max(local_record.FindInt("revision").value_or(0),
+                                  peer_record.FindInt("revision").value_or(0)) +
+                             1);
+  result.Set("updatedAt", base::TimeFormatAsIso8601(base::Time::Now()));
+  result.Set("deviceId", std::string(device_id));
+  result.Set("deleted", false);
+  result.Set("hash", ValueDigest(base::Value(merged->Clone())));
+  result.Set("value", std::move(*merged));
+  return result;
+}
+
+std::set<std::string> OrganizationTabIds(
+    const base::DictValue &organization) {
+  std::set<std::string> result;
+  if (const base::ListValue *profiles = organization.FindList("profiles")) {
+    for (const base::Value &candidate : *profiles) {
+      const base::DictValue *profile = candidate.GetIfDict();
+      const base::ListValue *favorites =
+          profile ? profile->FindList("favorites") : nullptr;
+      if (!favorites) {
+        continue;
+      }
+      for (const base::Value &item : *favorites) {
+        const base::DictValue *tab = item.GetIfDict();
+        const std::string tab_id =
+            tab ? CleanText(tab->FindString("id"), 160) : std::string();
+        if (!tab_id.empty()) {
+          result.insert(tab_id);
+        }
+      }
+    }
+  }
+  const base::ListValue *spaces = organization.FindList("spaces");
+  if (!spaces) {
+    return result;
+  }
+  for (const base::Value &candidate : *spaces) {
+    const base::DictValue *workspace = candidate.GetIfDict();
+    if (!workspace) {
+      continue;
+    }
+    for (std::string_view section : {"pinned", "today"}) {
+      const base::ListValue *items = workspace->FindList(section);
+      if (!items) {
+        continue;
+      }
+      for (const base::Value &item : *items) {
+        const base::DictValue *tab = item.GetIfDict();
+        const std::string tab_id =
+            tab ? CleanText(tab->FindString("id"), 160) : std::string();
+        if (!tab_id.empty()) {
+          result.insert(tab_id);
+        }
+      }
+    }
+  }
+  return result;
+}
+
+bool PreservesWorkspaceTabs(const base::DictValue &expected,
+                            const base::DictValue &actual) {
+  const std::set<std::string> expected_ids = OrganizationTabIds(expected);
+  const std::set<std::string> actual_ids = OrganizationTabIds(actual);
+  // The native sanitizer deliberately canonicalizes legacy/native Personal
+  // workspace aliases into one workspace. That sanctioned identity repair can
+  // change a tab's containing workspace without losing its stable identity.
+  // Fence actual tab loss globally; requiring the pre-sanitization workspace
+  // ID as well made a successful canonical import fail and retry forever.
+  return std::ranges::includes(actual_ids, expected_ids);
+}
+
+struct PrivacySafeOrganizationEvidence {
+  base::DictValue value;
+  std::set<std::string> synthetic_canary_ids;
+};
+
+PrivacySafeOrganizationEvidence BuildPrivacySafeOrganizationEvidence(
+    const base::DictValue &organization) {
+  PrivacySafeOrganizationEvidence result;
+  result.value.Set(
+      "organizationDigest",
+      ValueDigest(base::Value(organization.Clone())));
+  const base::ListValue *profiles = organization.FindList("profiles");
+  const base::ListValue *spaces = organization.FindList("spaces");
+  result.value.Set("profileCount", profiles ? static_cast<int>(profiles->size())
+                                            : 0);
+  result.value.Set("workspaceCount", spaces ? static_cast<int>(spaces->size())
+                                             : 0);
+  int tab_count = 0;
+  int group_count = 0;
+  if (spaces) {
+    for (const base::Value &candidate : *spaces) {
+      const base::DictValue *workspace = candidate.GetIfDict();
+      if (!workspace) {
+        continue;
+      }
+      if (const base::ListValue *groups = workspace->FindList("tabGroups")) {
+        group_count += static_cast<int>(groups->size());
+      }
+      for (std::string_view section : {"pinned", "today"}) {
+        const base::ListValue *tabs = workspace->FindList(section);
+        if (!tabs) {
+          continue;
+        }
+        tab_count += static_cast<int>(tabs->size());
+        for (const base::Value &item : *tabs) {
+          const base::DictValue *tab = item.GetIfDict();
+          const std::string url =
+              tab ? CleanText(tab->FindString("url"), 4096) : std::string();
+          const std::string id =
+              tab ? CleanText(tab->FindString("id"), 160) : std::string();
+          if (!id.empty() &&
+              url.find("viola-sync-canary=") != std::string::npos) {
+            result.synthetic_canary_ids.insert(id);
+          }
+        }
+      }
+    }
+  }
+  result.value.Set("tabCount", tab_count);
+  result.value.Set("groupCount", group_count);
+  result.value.Set("syntheticCanaryPresent",
+                   !result.synthetic_canary_ids.empty());
+  result.value.Set("syntheticCanaryStableIdCount",
+                   static_cast<int>(result.synthetic_canary_ids.size()));
+  base::ListValue canary_id_digests;
+  for (const std::string &id : result.synthetic_canary_ids) {
+    canary_id_digests.Append(ValueDigest(base::Value(id)));
+  }
+  result.value.Set("syntheticCanaryStableIdDigests",
+                   std::move(canary_id_digests));
+  return result;
+}
+
+base::DictValue BuildPrivacySafeUploadEvidence(
+    const base::ListValue &records) {
+  base::DictValue evidence;
+  evidence.Set("recordCount", static_cast<int>(records.size()));
+  int workspace_count = 0;
+  int canary_workspace_count = 0;
+  base::ListValue canary_workspace_digests;
+  for (const base::Value &candidate : records) {
+    const base::DictValue *record = candidate.GetIfDict();
+    const std::string key =
+        record ? CleanText(record->FindString("key"), 240) : std::string();
+    if (!record || !key.starts_with("workspace:") ||
+        record->FindBool("deleted").value_or(false)) {
+      continue;
+    }
+    ++workspace_count;
+    const base::DictValue *workspace = record->FindDict("value");
+    if (!workspace) {
+      continue;
+    }
+    base::DictValue wrapper;
+    base::ListValue spaces;
+    spaces.Append(workspace->Clone());
+    wrapper.Set("spaces", std::move(spaces));
+    PrivacySafeOrganizationEvidence summary =
+        BuildPrivacySafeOrganizationEvidence(wrapper);
+    if (!summary.synthetic_canary_ids.empty()) {
+      ++canary_workspace_count;
+      canary_workspace_digests.Append(
+          CleanText(record->FindString("hash"), 64));
+    }
+  }
+  evidence.Set("workspaceRecordCount", workspace_count);
+  evidence.Set("syntheticCanaryPresent", canary_workspace_count > 0);
+  evidence.Set("syntheticCanaryWorkspaceCount", canary_workspace_count);
+  evidence.Set("syntheticCanaryWorkspaceDigests",
+               std::move(canary_workspace_digests));
+  return evidence;
+}
+
+bool OrganizationHasUserState(const base::DictValue &organization) {
+  if (OrganizationHasPortableContent(organization)) {
+    return true;
+  }
+  const base::ListValue *profiles = organization.FindList("profiles");
+  const base::ListValue *spaces = organization.FindList("spaces");
+  if (!profiles || profiles->size() != 1 || !spaces || spaces->size() != 1) {
+    return true;
+  }
+  const base::DictValue &profile = profiles->front().GetDict();
+  const base::DictValue &space = spaces->front().GetDict();
+  if (CleanText(profile.FindString("id"), 160) != "personal" ||
+      CleanText(profile.FindString("name"), 120) != "Personal" ||
+      CleanText(space.FindString("id"), 160) != "personal" ||
+      CleanText(space.FindString("name"), 120) != "Personal" ||
+      CleanText(space.FindString("icon"), 32) != "🌊" ||
+      CleanText(space.FindString("theme"), 40) != "aurora" ||
+      CleanText(space.FindString("profileId"), 160) != "personal" ||
+      CleanText(organization.FindString("activeSpaceId"), 160) !=
+          "personal") {
+    return true;
+  }
+  const base::DictValue *settings = organization.FindDict("settings");
+  if (!settings) {
+    return false;
+  }
+  return CleanText(settings->FindString("sidebarSide"), 16) != "left" ||
+         settings->FindInt("sidebarWidth").value_or(kDefaultSidebarWidth) !=
+             kDefaultSidebarWidth ||
+         settings->FindBool("sidebarCollapsed").value_or(false) ||
+         !settings->FindBool("allWorkspacesGroupByWorkspace").value_or(true) ||
+         CleanText(settings->FindString("otherWindowTabsLayout"), 24) !=
+             "inline" ||
+         CleanText(settings->FindString("allWorkspacesTheme"), 40) !=
+             "aurora" ||
+         settings->FindInt("tabHeight").value_or(34) != 34 ||
+         settings->FindInt("tabSpacing").value_or(3) != 3 ||
+         settings->FindInt("tabRadius").value_or(9) != 9 ||
+         settings->FindInt("workspaceHeaderHeight").value_or(34) != 34 ||
+         settings->FindInt("workspaceHeaderRadius").value_or(9) != 9 ||
+         settings->FindInt("workspaceSectionSpacing").value_or(13) != 13 ||
+         settings->FindInt("workspaceContentInset").value_or(12) != 12 ||
+         settings->FindInt("workspaceContentInsetRight").value_or(12) != 12;
+}
+
+std::string ActiveLogicalProfileId(const base::DictValue &organization) {
+  const std::string active_space_id =
+      CleanText(organization.FindString("activeSpaceId"), 160);
+  if (const base::ListValue *spaces = organization.FindList("spaces")) {
+    for (const base::Value &candidate : *spaces) {
+      const base::DictValue *space = candidate.GetIfDict();
+      if (space && CleanText(space->FindString("id"), 160) == active_space_id) {
+        const std::string id = CleanText(space->FindString("profileId"), 160);
+        if (!id.empty()) {
+          return id;
+        }
+      }
+    }
+  }
+  if (const base::ListValue *profiles = organization.FindList("profiles")) {
+    for (const base::Value &candidate : *profiles) {
+      const base::DictValue *profile = candidate.GetIfDict();
+      const std::string id =
+          profile ? CleanText(profile->FindString("id"), 160) : std::string();
+      if (!id.empty()) {
+        return id;
+      }
+    }
+  }
+  return {};
+}
+
+std::string HistoryRecordKey(std::string_view profile_id,
+                             std::string_view url) {
+  std::string material(profile_id);
+  material.push_back('\0');
+  material.append(url);
+  const auto digest = crypto::hash::Sha256(base::as_byte_span(material));
+  return "history:" + base::ToLowerASCII(base::HexEncode(digest));
+}
+
+std::optional<double> NumericField(const base::DictValue &value,
+                                   std::string_view key) {
+  if (std::optional<double> number = value.FindDouble(key)) {
+    return number;
+  }
+  if (std::optional<int> number = value.FindInt(key)) {
+    return static_cast<double>(*number);
+  }
+  return std::nullopt;
+}
