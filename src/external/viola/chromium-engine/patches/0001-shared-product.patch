+  }
+  const std::string *group_id = payload.GetDict().FindString("groupId");
+  const std::string *space_id = payload.GetDict().FindString("spaceId");
+  if (!group_id || !space_id || group_id->empty() || space_id->empty()) {
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ViolaMessageHandler::ShowTabGroupContextMenu,
+                     weak_factory_.GetWeakPtr(), *group_id, *space_id));
+}
