+
+bool ViolaOrganizationStore::DissolveSplit(std::string_view space_id) {
+  if (!loaded_) {
+    return false;
+  }
+  base::DictValue *space = FindSpace(organization_, space_id);
+  if (!space || SplitLeaves(space->Find("split")).size() < 2) {
+    return false;
+  }
+  space->Set("split", base::Value());
+  space->Set("splitTitle", base::Value());
+  space->Set("splitKeepExpanded", false);
+  ScheduleWrite();
+  return true;
+}
+
+std::optional<std::vector<std::string>>
+ViolaOrganizationStore::OpenSavedTabGroup(std::string_view space_id,
+                                          std::string_view group_id) {
+  if (!loaded_) {
+    return std::nullopt;
+  }
+  base::DictValue *space = FindSpace(organization_, space_id);
+  base::DictValue *group = FindTabGroup(organization_, space_id, group_id);
+  if (!space || !group || !group->FindBool("saved").value_or(false)) {
+    return std::nullopt;
+  }
+  base::ListValue *snapshots = group->FindList("savedTabs");
+  if (!snapshots || snapshots->empty() || snapshots->size() > 2000) {
+    return std::nullopt;
+  }
+  const std::string section =
+      StringOr(group, "section") == "pinned" ? "pinned" : "today";
+  base::ListValue *destination = space->FindList(section);
+  std::set<std::string> reusable_ids;
+  size_t missing = 0;
+  for (const base::Value &snapshot : *snapshots) {
+    const base::DictValue *saved = snapshot.GetIfDict();
+    const std::string url = saved ? SafeTabUrl(saved->Find("url"), false) : "";
+    if (!saved || url.empty()) {
+      return std::nullopt;
+    }
+    const std::string saved_id = StringOr(saved, "tabId");
+    const std::optional<std::string> owner =
+        SpaceIdForTab(organization_, saved_id);
+    if (saved_id.empty() || !owner || *owner != space_id ||
+        !reusable_ids.insert(saved_id).second) {
+      ++missing;
+    }
+  }
+  if (destination->size() + missing > 2000) {
+    return std::nullopt;
+  }
+
+  reusable_ids.clear();
+  std::vector<std::string> restored_ids;
+  restored_ids.reserve(snapshots->size());
+  const double now =
+      static_cast<double>(base::Time::Now().InMillisecondsSinceUnixEpoch());
+  for (base::Value &snapshot : *snapshots) {
+    base::DictValue &saved = snapshot.GetDict();
+    std::string tab_id = StringOr(&saved, "tabId");
+    const std::optional<std::string> owner =
+        SpaceIdForTab(organization_, tab_id);
+    const bool reusable = !tab_id.empty() && owner && *owner == space_id &&
+                          reusable_ids.insert(tab_id).second;
+    if (!reusable) {
+      do {
+        tab_id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+      } while (FindPersistentTab(organization_, tab_id));
+      base::DictValue persistent;
+      persistent.Set("id", tab_id);
+      persistent.Set("url", *saved.FindString("url"));
+      persistent.Set("title",
+                     StringOr(&saved, "title", *saved.FindString("url")));
+      persistent.Set("favicon", base::Value());
+      persistent.Set("createdAt", now);
+      persistent.Set("lastAccessed", now);
+      persistent.Set("keepActive", false);
+      persistent.Set("miniPlayerExcluded", false);
+      persistent.Set("muted", false);
+      persistent.Set("openerTabId", base::Value());
+      destination->Append(std::move(persistent));
+      saved.Set("tabId", tab_id);
+    }
+    restored_ids.push_back(tab_id);
+  }
+  base::ListValue live_ids;
+  for (const std::string &tab_id : restored_ids) {
+    live_ids.Append(tab_id);
+  }
+  group->Set("tabIds", std::move(live_ids));
+  space->Set("activeTabId", restored_ids.front());
+  ScheduleWrite();
+  return restored_ids;
+}
+
+std::optional<std::vector<std::string>> ViolaOrganizationStore::ReorderTabGroup(
+    std::string_view space_id, std::string_view group_id,
+    const std::vector<std::string> &tab_ids, std::string_view section,
+    size_t index) {
+  if (!loaded_ || tab_ids.empty() || index > 4096 ||
+      (section != "pinned" && section != "today")) {
+    return std::nullopt;
+  }
+  base::DictValue *space = FindSpace(organization_, space_id);
+  base::DictValue *group = FindTabGroup(organization_, space_id, group_id);
+  if (!space || !group) {
+    return std::nullopt;
+  }
+  const base::ListValue *persistent_ids = group->FindList("tabIds");
+  if (!persistent_ids || persistent_ids->size() != tab_ids.size()) {
+    return std::nullopt;
+  }
+  for (size_t member = 0; member < tab_ids.size(); ++member) {
+    if (!(*persistent_ids)[member].is_string() ||
+        (*persistent_ids)[member].GetString() != tab_ids[member] ||
+        !SpaceOwnsPersistentTab(*space, tab_ids[member])) {
+      return std::nullopt;
+    }
+  }
+
+  std::vector<base::Value> entries;
+  entries.reserve(tab_ids.size());
+  for (const std::string &tab_id : tab_ids) {
+    std::optional<base::Value> entry =
+        ExtractPersistentTab(organization_, tab_id);
+    if (!entry) {
+      return std::nullopt;
+    }
+    entries.push_back(std::move(*entry));
+  }
+  base::ListValue *destination = space->FindList(section);
+  const size_t insertion = std::min(index, destination->size());
+  for (size_t member = 0; member < entries.size(); ++member) {
+    destination->Insert(destination->begin() + insertion + member,
+                        std::move(entries[member]));
+  }
+  group->Set("section", section);
+  ScheduleWrite();
+  return tab_ids;
+}
+
+std::optional<std::vector<std::string>>
+ViolaOrganizationStore::MoveTabGroup(std::string_view group_id,
+                                     std::string_view source_space_id,
+                                     std::string_view destination_space_id,
+                                     std::string_view section, size_t index) {
+  if (!loaded_ || source_space_id == destination_space_id || index > 4096 ||
+      (section != "pinned" && section != "today")) {
+    return std::nullopt;
+  }
+  base::DictValue *source_space = FindSpace(organization_, source_space_id);
+  base::DictValue *destination_space =
+      FindSpace(organization_, destination_space_id);
+  base::DictValue *group =
+      FindTabGroup(organization_, source_space_id, group_id);
+  if (!source_space || !destination_space || !group ||
+      StringOr(source_space, "profileId") !=
+          StringOr(destination_space, "profileId") ||
+      destination_space->FindList("tabGroups")->size() >= 1000) {
+    return std::nullopt;
+  }
+
+  std::vector<std::string> tab_ids;
+  for (const base::Value &id : *group->FindList("tabIds")) {
+    if (!id.is_string() ||
+        !SpaceOwnsPersistentTab(*source_space, id.GetString())) {
+      return std::nullopt;
+    }
+    tab_ids.push_back(id.GetString());
+  }
+  if (tab_ids.empty()) {
+    return std::nullopt;
+  }
+
+  const std::string source_active = StringOr(source_space, "activeTabId");
+  const bool moving_active =
+      std::ranges::find(tab_ids, source_active) != tab_ids.end();
+  std::vector<base::Value> entries;
+  entries.reserve(tab_ids.size());
+  for (const std::string &tab_id : tab_ids) {
+    std::optional<base::Value> entry =
+        ExtractPersistentTab(organization_, tab_id);
+    if (!entry) {
+      return std::nullopt;
+    }
+    entries.push_back(std::move(*entry));
+  }
+  std::optional<base::Value> moved_group =
+      ExtractTabGroup(*source_space, group_id);
+  if (!moved_group) {
+    return std::nullopt;
+  }
+  moved_group->GetDict().Set("section", section);
+  destination_space->FindList("tabGroups")->Append(std::move(*moved_group));
+  base::ListValue *destination = destination_space->FindList(section);
+  const size_t insertion = std::min(index, destination->size());
+  for (size_t member = 0; member < entries.size(); ++member) {
+    destination->Insert(destination->begin() + insertion + member,
+                        std::move(entries[member]));
+  }
+  if (moving_active) {
+    source_space->Set("activeTabId", base::Value());
+    destination_space->Set("activeTabId", source_active);
+  }
+  ScheduleWrite();
+  return tab_ids;
+}
+
+std::optional<std::vector<std::string>>
+ViolaOrganizationStore::TabGroupIds(std::string_view space_id,
+                                    std::string_view group_id) const {
+  if (!loaded_) {
