+      const grid = node('div','resume-grid');
+      for (const item of open) grid.append(resumeCard(item));
+      sec.append(grid); main.append(sec);
+    }
+
+    const hosts = topDomains(data.history);
+    if (!q && hosts.length) {
+      const chips = node('div','chips');
+      const all = node('button',`chip${domain ? '' : ' on'}`,'All sites');
+      all.addEventListener('click',()=>{domain='';render()}); chips.append(all);
+      for (const host of hosts) {
+        const chip = node('button',`chip${domain === host ? ' on' : ''}`,host);
+        chip.addEventListener('click',()=>{domain=domain===host?'':host;render()}); chips.append(chip);
+      }
+      main.append(chips);
+    }
+
+    let items = data.history.filter((item) => (!domain || item.domain === domain) && matches(item,q));
+    if (q) items.sort((a,b) => searchScore(b,q)-searchScore(a,q));
+    if (!items.length) {
+      main.append(empty(q ? 'No history matches that search.' : 'Your browsing history will become useful here.','◷'));
+      return;
+    }
+
+    if (!q && !domain) {
+      const worthwhile = [...items]
+        .filter((item) => item.visits > 1 && Date.now()-item.last > 2*3600000)
+        .sort((a,b) => b.score-a.score).slice(0,6);
+      if (worthwhile.length) {
+        const sec = sectionBlock('Worth returning to','Based on recency and repeat visits');
+        const list = node('div','card-list');
+        worthwhile.forEach((item)=>list.append(historyRow(item,true)));
+        sec.append(list); main.append(sec);
