+
+  // views::View:
+  void Layout(PassKey) override;
+
+private:
+  void ShowPendingOverlay();
+  void SendDimmerState(bool visible);
+  void SendPaletteState();
+  void SendSplitHint();
+
+  raw_ptr<views::WebView> dimmer_web_view_ = nullptr;
+  raw_ptr<views::WebView> overlay_web_view_ = nullptr;
+  std::unique_ptr<WebUIContentsWrapperT<ViolaUI>> dimmer_contents_wrapper_;
+  std::unique_ptr<WebUIContentsWrapperT<ViolaUI>> overlay_contents_wrapper_;
+  views::UnhandledKeyboardEventHandler unhandled_keyboard_event_handler_;
