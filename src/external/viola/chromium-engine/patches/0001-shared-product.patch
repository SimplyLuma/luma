+                          bool success, base::DictValue response,
+                          std::string error);
+  void OnRecoverySnapshots(ResultCallback callback, std::vector<uint8_t> key,
+                           bool success, base::DictValue response,
+                           std::string error);
+  base::DictValue FinishEnrollment(base::span<const uint8_t> key);
+  void SyncNow();
+  void PollForChanges();
+  void OnChanges(bool success, base::DictValue response, std::string error);
+  void OnLocalHistoryReady(history::QueryResults results);
+  void StartSnapshotPull();
+  void OnSessionIdentity(bool success, base::DictValue response,
+                         std::string error);
+  void OnWriterClaimed(bool success, base::DictValue response,
+                       std::string error);
+  void OnSnapshots(bool success, base::DictValue response, std::string error);
+  void OnSnapshotUploaded(bool success, base::DictValue response,
+                          std::string error);
+  void OnSnapshotEcho(bool success, base::DictValue response,
+                      std::string error);
+  base::ListValue BuildLocalRecords(const base::DictValue &organization,
+                                    bool initial_seed,
+                                    bool allow_local_mutations);
+  bool MergeAndApplyRecords(const base::ListValue &remote_records,
+                            base::ListValue local_records,
+                            bool prefer_populated_local_seed,
+                            base::ListValue *merged_records);
+  void ApplyHistoryRecords(const base::DictValue &winning_records);
+  base::ListValue BuildActiveTabPresence() const;
+  static std::optional<base::DictValue>
+  EncryptPayload(const base::DictValue &payload, base::span<const uint8_t> key);
+  static std::optional<base::DictValue>
+  DecryptEnvelope(const base::DictValue &envelope,
+                  base::span<const uint8_t> key);
+
+  std::optional<std::string> ProtectSecrets(base::span<const uint8_t> key,
+                                            std::string_view token) const;
+  std::optional<base::DictValue> UnprotectSecrets() const;
+  static std::optional<std::vector<uint8_t>>
+  WrapOrUnwrapKey(bool wrap, std::string_view password,
+                  const base::DictValue *envelope,
+                  base::span<const uint8_t> key, base::DictValue *wrapped);
+
+  const raw_ptr<Profile> profile_;
+  base::FilePath state_path_;
