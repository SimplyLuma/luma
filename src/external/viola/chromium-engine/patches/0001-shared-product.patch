@@ -0,0 +1,201 @@
+// Copyright 2026 Viola Browser
+// Use of this source code is governed by the GPL-3.0 license in Viola's
+// repository root.
+
+#include "chrome/browser/ui/webui/viola/viola_update_service.h"
+
+#import <Foundation/Foundation.h>
+#import <objc/message.h>
+
+@interface ViolaSparkleDelegate : NSObject {
+ @private
+  void* owner_;
+}
+- (instancetype)initWithOwner:(void*)owner;
+@end
+
+namespace viola {
+
+namespace {
+
+void ReportSparkleStatus(void* owner,
+                         ViolaUpdateService::InstallStatus status) {
+  if (owner) {
+    static_cast<ViolaUpdateService*>(owner)->ReportPlatformStatus(status);
+  }
+}
+
+}  // namespace
+
+}  // namespace viola
+
+@implementation ViolaSparkleDelegate
+
+- (instancetype)initWithOwner:(void*)owner {
+  self = [super init];
+  if (self) {
+    owner_ = owner;
+  }
+  return self;
+}
+
+- (void)updater:(id)updater didFindValidUpdate:(id)item {
+  viola::ReportSparkleStatus(
+      owner_, viola::ViolaUpdateService::InstallStatus::kAvailable);
+}
+
+- (void)updater:(id)updater willDownloadUpdate:(id)item
+    withRequest:(NSMutableURLRequest*)request {
+  viola::ReportSparkleStatus(
+      owner_, viola::ViolaUpdateService::InstallStatus::kDownloading);
+}
+
+- (void)updater:(id)updater didDownloadUpdate:(id)item {
+  viola::ReportSparkleStatus(
+      owner_, viola::ViolaUpdateService::InstallStatus::kReady);
+}
+
+- (void)updater:(id)updater failedToDownloadUpdate:(id)item
+    error:(NSError*)error {
+  viola::ReportSparkleStatus(
+      owner_, viola::ViolaUpdateService::InstallStatus::kError);
+}
+
+- (void)updater:(id)updater didAbortWithError:(NSError*)error {
+  // Sparkle uses this callback for both failures and benign “no update”
+  // results. The branded manifest remains discovery authority, so only mark a
+  // real failure when the delegate has an NSError to report.
+  if (error) {
+    viola::ReportSparkleStatus(
+        owner_, viola::ViolaUpdateService::InstallStatus::kError);
+  }
+}
+
+@end
+
+namespace viola {
+
+class ViolaUpdateService::Impl {
+ public:
+  explicit Impl(ViolaUpdateService* owner) : owner_(owner) {}
+
+  bool EnsureController() {
+    if (controller_) {
+      return true;
+    }
+    NSBundle* main_bundle = NSBundle.mainBundle;
+    NSString* public_key = [main_bundle objectForInfoDictionaryKey:@"SUPublicEDKey"];
+    NSString* feed_url = [main_bundle objectForInfoDictionaryKey:@"SUFeedURL"];
+    if (public_key.length == 0 || feed_url.length == 0 ||
+        [public_key containsString:@"REPLACE_"] ||
+        [feed_url containsString:@".invalid"]) {
+      return false;
+    }
+    NSURL* framework_url = [main_bundle.privateFrameworksURL
+        URLByAppendingPathComponent:@"Sparkle.framework"];
+    NSBundle* sparkle_bundle = [NSBundle bundleWithURL:framework_url];
+    NSError* error = nil;
+    if (!sparkle_bundle || ![sparkle_bundle loadAndReturnError:&error]) {
+      NSLog(@"Viola could not load its qualified update framework: %@", error);
+      return false;
+    }
+    Class controller_class = NSClassFromString(@"SPUStandardUpdaterController");
+    SEL initializer = NSSelectorFromString(
+        @"initWithStartingUpdater:updaterDelegate:userDriverDelegate:");
+    if (!controller_class || ![controller_class instancesRespondToSelector:initializer]) {
+      return false;
+    }
+    delegate_ = [[ViolaSparkleDelegate alloc] initWithOwner:owner_];
+    id allocated = ((id (*)(id, SEL))objc_msgSend)(controller_class,
+                                                    @selector(alloc));
+    controller_ = ((id (*)(id, SEL, BOOL, id, id))objc_msgSend)(
+        allocated, initializer, YES, delegate_, nil);
+    return controller_ != nil;
+  }
+
+  void StageUpdateInBackground() {
+    if (!EnsureController()) {
+      return;
+    }
+    if (owner_->install_status() ==
+            ViolaUpdateService::InstallStatus::kDownloading ||
+        owner_->install_status() == ViolaUpdateService::InstallStatus::kReady) {
+      return;
+    }
+    SEL updater_selector = NSSelectorFromString(@"updater");
+    id updater = [controller_ respondsToSelector:updater_selector]
+                     ? ((id (*)(id, SEL))objc_msgSend)(controller_,
+                                                       updater_selector)
+                     : nil;
+    if (!updater) {
+      return;
+    }
+    SEL automatic_selector =
+        NSSelectorFromString(@"setAutomaticallyDownloadsUpdates:");
+    if ([updater respondsToSelector:automatic_selector]) {
+      ((void (*)(id, SEL, BOOL))objc_msgSend)(updater, automatic_selector, YES);
+    }
+    SEL background_selector =
+        NSSelectorFromString(@"checkForUpdatesInBackground");
+    if ([updater respondsToSelector:background_selector]) {
+      ((void (*)(id, SEL))objc_msgSend)(updater, background_selector);
+    }
+  }
+
+  void PresentUpdate() {
+    if (!EnsureController()) {
+      return;
+    }
+    SEL action = NSSelectorFromString(@"checkForUpdates:");
+    if ([controller_ respondsToSelector:action]) {
+      ((void (*)(id, SEL, id))objc_msgSend)(controller_, action, nil);
+    }
+  }
+
+ private:
+  ViolaUpdateService* owner_ = nullptr;
+  id delegate_ = nil;
+  id controller_ = nil;
+};
+
+ViolaUpdateService::ViolaUpdateService() : impl_(new Impl(this)) {}
+ViolaUpdateService::~ViolaUpdateService() {
+  delete impl_;
+}
+
+ViolaUpdateService& ViolaUpdateService::Get() {
+  static base::NoDestructor<ViolaUpdateService> service;
+  return *service;
+}
+
+bool ViolaUpdateService::CanInstallInApp() {
+  return impl_->EnsureController();
+}
+
+void ViolaUpdateService::StageUpdateInBackground() {
+  impl_->StageUpdateInBackground();
+}
+
+void ViolaUpdateService::PresentUpdate() {
+  impl_->PresentUpdate();
+}
+
+void ViolaUpdateService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void ViolaUpdateService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void ViolaUpdateService::ReportPlatformStatus(InstallStatus status) {
+  if (install_status_ == status) {
+    return;
+  }
+  install_status_ = status;
+  for (Observer& observer : observers_) {
+    observer.OnViolaUpdateInstallStatusChanged(status);
+  }
+}
+
+}  // namespace viola
