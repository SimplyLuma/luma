+const ThemeData &ThemeFor(std::string_view key) {
+  auto found = std::ranges::find(kThemes, key, &ThemeData::key);
+  return found == std::end(kThemes) ? kThemes[0] : *found;
+}
+
+base::DictValue ThemeValue(std::string_view key) {
+  const ThemeData &data = ThemeFor(key);
+  base::ListValue gradient;
+  gradient.Append(data.first);
+  gradient.Append(data.second);
+  gradient.Append(data.third);
+  base::DictValue theme;
+  theme.Set("key", data.key);
+  theme.Set("name", data.name);
+  theme.Set("gradient", std::move(gradient));
+  theme.Set("accent", data.accent);
+  theme.Set("ink", data.ink);
+  theme.Set("dark", data.dark);
+  return theme;
+}
