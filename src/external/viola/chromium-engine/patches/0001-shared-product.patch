+      <button class="icon-button" data-action="frame" title="Show device frame" aria-label="Toggle device frame">▣</button>
+      <button class="icon-button" data-action="scheme" title="Emulate dark appearance" aria-label="Toggle light or dark appearance">◐</button>
+      <button class="icon-button" data-action="touch" title="Touch and inertial scrolling" aria-label="Toggle touch and inertial scrolling">☝︎</button>
