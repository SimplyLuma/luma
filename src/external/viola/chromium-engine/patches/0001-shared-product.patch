+void ViolaMessageHandler::OnJavascriptAllowed() {
+  const std::string surface = CurrentSurface();
+  Profile *profile = Profile::FromBrowserContext(
+      web_ui()->GetWebContents()->GetBrowserContext());
+  if (viola::ViolaUsageTelemetry *telemetry =
+          viola::ViolaUsageTelemetry::Get(profile)) {
+    telemetry->Start(std::string(kViolaProductVersion));
+  }
+  if (surface == "sidebar.html" || surface == "little.html") {
+    ObserveProductTabStrip();
+  }
+  if (surface == "sidebar.html") {
+    ObserveProfileTabStrips();
+    media_timer_.Start(
+        FROM_HERE, base::Seconds(1),
+        base::BindRepeating(&ViolaMessageHandler::RefreshMediaState,
+                            weak_factory_.GetWeakPtr()));
+    update_start_timer_.Start(
+        FROM_HERE, kUpdateStartupDelay,
+        base::BindOnce(&ViolaMessageHandler::CheckForUpdates,
+                       weak_factory_.GetWeakPtr(), std::nullopt));
+    update_timer_.Start(
+        FROM_HERE, kUpdateInterval,
+        base::BindRepeating(&ViolaMessageHandler::CheckForUpdates,
+                            weak_factory_.GetWeakPtr(), std::nullopt));
+  }
+  if (surface == "sidebar.html" || surface == "overlay.html" ||
+      IsViolaLibrarySurface(surface)) {
+    ObserveDownloads();
+  }
+}
