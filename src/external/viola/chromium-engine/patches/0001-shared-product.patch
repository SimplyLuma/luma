+std::string ViolaAccountSyncService::RemotePlatformForTab(
+    std::string_view tab_id) const {
+  auto found = remote_presence_by_tab_.find(std::string(tab_id));
+  return found == remote_presence_by_tab_.end() ? std::string()
+                                                : found->second;
