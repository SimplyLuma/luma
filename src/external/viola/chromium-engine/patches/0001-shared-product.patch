+  ASSERT_TRUE(shell_contents);
+  ASSERT_TRUE(content::WaitForLoadStop(shell_contents));
+  EXPECT_TRUE(content::EvalJs(shell_contents, R"(
+    new Promise((resolve) => {
+      const deadline = performance.now() + 5000;
+      let switchSent = false;
+      const check = () => {
+        if (typeof S !== 'object' || typeof S.activeSpaceId !== 'string' ||
+            typeof vela !== 'object' || typeof vela.send !== 'function') {
+          if (performance.now() >= deadline) {
+            resolve(false);
+          } else {
+            setTimeout(check, 20);
+          }
+          return;
+        }
+        if (!switchSent) {
+          switchSent = true;
+          vela.send('space:switch', {spaceId: S.activeSpaceId});
+        }
+        if (!S.isAllWorkspaces && document.querySelector('#today-list')) {
+          resolve(true);
+        } else if (performance.now() >= deadline) {
+          resolve(false);
+        } else {
+          setTimeout(check, 20);
+        }
+      };
+      check();
+    })
+  )").ExtractBool());
+
+  const GURL first_url("data:text/html,<title>ViolaSplitFirst</title>first");
+  const GURL second_url("data:text/html,<title>ViolaSplitSecond</title>second");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), first_url));
+  ASSERT_TRUE(AddTabAtIndex(1, second_url, ui::PAGE_TRANSITION_TYPED));
+  EXPECT_TRUE(content::EvalJs(shell_contents, R"(
+    new Promise((resolve) => {
+      const deadline = performance.now() + 5000;
+      const check = () => {
+        const rows = [...document.querySelectorAll('#today-list .tab')];
+        const first = rows.find((row) =>
+          row.querySelector('.title')?.textContent === 'ViolaSplitFirst');
+        const second = rows.find((row) =>
+          row.querySelector('.title')?.textContent === 'ViolaSplitSecond');
+        if (first && second) {
+          window.__violaSplitFirstId = first.dataset.tabId;
+          window.__violaSplitSecondId = second.dataset.tabId;
+          window.__violaSplitSpaceId = S.activeSpaceId;
+          resolve(true);
+        } else if (performance.now() >= deadline) {
+          resolve(false);
+        } else {
+          setTimeout(check, 20);
+        }
+      };
+      check();
+    })
+  )")
+                  .ExtractBool());
+
+  TabStripModel *tab_strip = browser()->tab_strip_model();
+  viola::ViolaOrganizationStore *organization_store =
+      viola::ViolaOrganizationStore::Get(browser()->profile());
+  ASSERT_TRUE(tab_strip);
+  ASSERT_TRUE(organization_store);
+  const std::string first_id =
+      content::EvalJs(shell_contents, "window.__violaSplitFirstId")
+          .ExtractString();
+  const std::string second_id =
+      content::EvalJs(shell_contents, "window.__violaSplitSecondId")
+          .ExtractString();
+  const std::string space_id =
+      content::EvalJs(shell_contents, "window.__violaSplitSpaceId")
+          .ExtractString();
+  ASSERT_TRUE(organization_store->SetSplitPair(space_id, first_id, second_id,
+                                               "v", 0.4));
+  organization_store->ReconcileAndMaterialize(browser(), tab_strip);
+  base::RunLoop().RunUntilIdle();
+
+  ASSERT_EQ(1u, tab_strip->ListSplits().size());
+  const split_tabs::SplitTabId split_id = *tab_strip->ListSplits().begin();
+  split_tabs::SplitTabData *split_data = tab_strip->GetSplitData(split_id);
+  ASSERT_TRUE(split_data);
+  ASSERT_EQ(2u, split_data->ListTabs().size());
+  EXPECT_EQ(first_id, organization_store->TabIdFor(
+                          split_data->ListTabs()[0]->GetContents()));
+  EXPECT_EQ(second_id, organization_store->TabIdFor(
+                           split_data->ListTabs()[1]->GetContents()));
+  EXPECT_EQ(split_tabs::SplitTabLayout::kStacked,
+            split_data->visual_data()->split_layout());
+  EXPECT_DOUBLE_EQ(0.4, split_data->visual_data()->split_ratio());
+  ASSERT_TRUE(organization_store->GetTabContextMenuState(first_id));
+  EXPECT_TRUE(organization_store->GetTabContextMenuState(first_id)->in_split);
+  ASSERT_TRUE(organization_store->GetTabContextMenuState(second_id));
+  EXPECT_TRUE(organization_store->GetTabContextMenuState(second_id)->in_split);
+
+  // Chromium owns the real divider. Its normal split-visual observer must
+  // update Viola's portable tree so a later materialization restores the
+  // user's final orientation and ratio instead of the pre-drag geometry.
+  tab_strip->UpdateSplitLayout(split_id,
+                               split_tabs::SplitTabLayout::kSideBySide);
+  tab_strip->UpdateSplitRatio(split_id, 0.63);
+  base::RunLoop().RunUntilIdle();
+  tab_strip->RemoveSplit(split_id);
+  organization_store->ReconcileAndMaterialize(browser(), tab_strip);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(1u, tab_strip->ListSplits().size());
+  const split_tabs::SplitTabId resized_split_id =
+      *tab_strip->ListSplits().begin();
+  split_data = tab_strip->GetSplitData(resized_split_id);
+  ASSERT_TRUE(split_data);
+  EXPECT_EQ(split_tabs::SplitTabLayout::kSideBySide,
+            split_data->visual_data()->split_layout());
+  EXPECT_DOUBLE_EQ(0.63, split_data->visual_data()->split_ratio());
+
+  content::WebContents *overlay_contents = overlay_host->overlay_web_contents();
+  ASSERT_TRUE(overlay_contents);
+  ASSERT_TRUE(content::WaitForLoadStop(overlay_contents));
+  overlay_host->ShowSplitHint(gfx::Rect(0, 0, 320, 240));
+  EXPECT_TRUE(content::EvalJs(overlay_contents, R"(
+    new Promise((resolve) => {
+      const deadline = performance.now() + 5000;
+      const check = () => {
+        const hint = document.querySelector('#split-hint');
+        if (document.body.classList.contains('mode-split')
+            && hint?.style.width === '320px'
+            && hint?.style.height === '240px') {
+          resolve(true);
+        } else if (performance.now() >= deadline) {
+          resolve(false);
+        } else {
+          setTimeout(check, 20);
+        }
+      };
+      check();
+    })
+  )")
+                  .ExtractBool());
+  EXPECT_TRUE(overlay_host->palette_visible_for_testing());
+  overlay_host->ShowSplitHint(gfx::Rect(320, 0, 321, 240));
+  EXPECT_TRUE(content::EvalJs(overlay_contents, R"(
+    new Promise((resolve) => {
+      const deadline = performance.now() + 5000;
+      const check = () => {
+        const hint = document.querySelector('#split-hint');
+        if (hint?.style.left === '320px' && hint?.style.width === '321px') {
+          resolve(true);
+        } else if (performance.now() >= deadline) {
+          resolve(false);
+        } else {
+          setTimeout(check, 20);
+        }
+      };
+      check();
+    })
+  )")
+                  .ExtractBool());
+  overlay_host->ShowSplitHint(std::nullopt);
+  EXPECT_FALSE(overlay_host->palette_visible_for_testing());
+
+  EXPECT_TRUE(organization_store->RemoveTabFromSplit(space_id, first_id));
+  tab_strip->RemoveSplit(resized_split_id);
+  EXPECT_TRUE(tab_strip->ListSplits().empty());
+  ASSERT_TRUE(organization_store->GetTabContextMenuState(first_id));
+  EXPECT_FALSE(organization_store->GetTabContextMenuState(first_id)->in_split);
+  EXPECT_FALSE(organization_store->DissolveSplit(space_id));
+}
