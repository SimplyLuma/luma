+void ViolaMessageHandler::OnJavascriptDisallowed() {
+#if BUILDFLAG(IS_LINUX)
+  CloseNativeFind();
+#endif
+  CloseNativeMenuProbe();
+  ClearSplitDrag();
+  render_state_timer_.Stop();
+  reconcile_before_render_ = false;
+  media_timer_.Stop();
+  StopMediaPreviewCapture(/*notify_renderer=*/false);
+  media_tab_id_.clear();
+  media_fingerprint_.clear();
+  if (context_menu_runner_) {
+    context_menu_runner_->Cancel();
+  }
+  context_menu_runner_.reset();
+  context_menu_adapter_.reset();
+  context_menu_model_.reset();
+  context_submenu_models_.clear();
+  context_menu_workspace_targets_.clear();
+  tab_context_menu_state_.reset();
+  tab_context_selected_ids_.clear();
+  tab_group_context_menu_state_.reset();
+  workspace_context_menu_id_.clear();
+  tabs_context_menu_ = false;
+  download_attention_timer_.Stop();
+  update_start_timer_.Stop();
+  update_timer_.Stop();
+  update_loader_.reset();
+  download_attention_guid_.clear();
+  download_notifier_.reset();
+  StopObservingProfileTabStrips();
+  if (observed_tab_strip_) {
+    TabStripModel *tab_strip = observed_tab_strip_;
+    observed_tab_strip_ = nullptr;
+    tab_strip->RemoveObserver(this);
+  }
+}
