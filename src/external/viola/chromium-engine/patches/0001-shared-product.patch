+base::DictValue ViolaOrganizationStore::BuildSettingsData() const {
+  base::DictValue result;
+  result.Set("settings", loaded_ && organization_.FindDict("settings")
+                             ? organization_.FindDict("settings")->Clone()
+                             : DefaultSettings());
+
+  base::ListValue themes;
+  for (const ThemeData &theme : kThemes) {
+    themes.Append(ThemeValue(theme.key));
+  }
+  result.Set("themes", std::move(themes));
+
+  base::ListValue profiles;
+  if (loaded_) {
+    for (const base::Value &profile_value :
+         *organization_.FindList("profiles")) {
+      const base::DictValue &profile = profile_value.GetDict();
+      base::DictValue item;
+      item.Set("id", StringOr(&profile, "id"));
+      item.Set("name", StringOr(&profile, "name", "Profile"));
+      profiles.Append(std::move(item));
