diff --git a/chrome/browser/resources/viola/cast-capture.js b/chrome/browser/resources/viola/cast-capture.js
new file mode 100644
index 0000000000000000000000000000000000000000..a315951d1efad8afcdb6b57e95b328f45b0652ca
--- /dev/null
+++ b/chrome/browser/resources/viola/cast-capture.js
@@ -0,0 +1,70 @@
+let stream = null;
+let recorder = null;
+let intentionalStop = false;
+
+function supportedMimeType() {
+  return [
+    'video/webm;codecs=vp8,opus',
+    'video/webm;codecs=vp9,opus',
+    'video/webm',
+  ].find((type) => MediaRecorder.isTypeSupported(type)) || '';
+}
+
+async function stopCapture() {
+  intentionalStop = true;
+  if (recorder && recorder.state !== 'inactive') {
+    try { recorder.stop(); } catch {}
+  }
+  recorder = null;
+  if (stream) {
+    for (const track of stream.getTracks()) track.stop();
+  }
+  stream = null;
+}
+
+window.violaCastCapture.onStart(async (options) => {
+  try {
+    await stopCapture();
+    intentionalStop = false;
+    stream = await navigator.mediaDevices.getDisplayMedia({
+      video: {
+        width: { ideal: options.width || 1920 },
+        height: { ideal: options.height || 1080 },
+        frameRate: { ideal: options.frameRate || 30 },
+      },
+      audio: true,
+    });
+    for (const track of stream.getTracks()) {
+      track.addEventListener('ended', () => {
+        if (!intentionalStop) window.violaCastCapture.sendError('Tab capture ended');
+      }, { once: true });
+    }
+    const mimeType = supportedMimeType();
+    recorder = new MediaRecorder(stream, {
+      ...(mimeType ? { mimeType } : {}),
+      videoBitsPerSecond: options.videoBitsPerSecond || 5_000_000,
+      audioBitsPerSecond: 160_000,
+    });
+    recorder.addEventListener('dataavailable', async (event) => {
+      if (!event.data || !event.data.size) return;
+      const bytes = await event.data.arrayBuffer();
+      window.violaCastCapture.sendChunk(bytes);
+    });
+    recorder.addEventListener('error', (event) => {
+      window.violaCastCapture.sendError(event.error?.message || 'MediaRecorder failed');
+    });
+    recorder.start(250);
+  } catch (error) {
+    window.violaCastCapture.sendError(error?.message || error);
+  }
+});
+
+window.violaCastCapture.onFlow(({ paused }) => {
+  if (!recorder) return;
+  try {
+    if (paused && recorder.state === 'recording') recorder.pause();
+    if (!paused && recorder.state === 'paused') recorder.resume();
+  } catch {}
+});
+
+window.violaCastCapture.onStop(() => stopCapture());
