+          {"☀️", "sun day bright"},
+          {"☕️", "coffee cafe"},
+          {"🌎", "earth world globe"},
+          {"🔐", "lock security private"},
+          {"⚙️", "gear settings"},
+          {"🌈", "rainbow color"},
+          {"💜", "purple heart"},
+      };
+  base::ListValue icons;
+  for (const auto &[emoji, keywords] : kWorkspaceIcons) {
+    base::DictValue icon;
+    icon.Set("emoji", emoji);
+    icon.Set("keywords", keywords);
+    icons.Append(std::move(icon));
+  }
+  result.Set("workspaceIcons", std::move(icons));
+  return result;
+}
+
+base::ListValue ViolaOrganizationStore::BuildPaletteTabSuggestions(
+    TabStripModel *tab_strip, std::string_view query, size_t maximum) const {
+  base::ListValue suggestions;
+  if (!loaded_ || !tab_strip || maximum == 0) {
+    return suggestions;
+  }
+
+  const std::string needle = base::ToLowerASCII(query);
+  const std::string active_space_id = StringOr(&organization_, "activeSpaceId");
+  std::set<std::string> seen;
+  auto append_tab = [&](const base::DictValue &persistent,
+                        std::string detail, bool use_durable_identity) {
+    if (suggestions.size() >= maximum) {
+      return;
+    }
+    const std::string id = StringOr(&persistent, "id");
+    if (id.empty() || !seen.insert(id).second) {
+      return;
+    }
+    const int live_index = FindTabIndex(tab_strip, id);
+    content::WebContents *contents =
+        live_index == TabStripModel::kNoTab
+            ? nullptr
+            : tab_strip->GetWebContentsAt(live_index);
+    const std::string url =
+        !use_durable_identity && contents
+            ? contents->GetVisibleURL().spec()
+            : StringOr(&persistent, "url");
+    if (!GURL(url).SchemeIsHTTPOrHTTPS()) {
+      return;
+    }
+    const std::string title =
+        !use_durable_identity && contents && !contents->GetTitle().empty()
+            ? base::UTF16ToUTF8(contents->GetTitle())
+            : StringOr(&persistent, "title", url);
+    const std::string haystack =
+        base::ToLowerASCII(base::StrCat({title, " ", url}));
+    if (!needle.empty() && !haystack.contains(needle)) {
+      return;
+    }
+    base::DictValue item;
+    item.Set("type", "tab");
+    item.Set("tabId", id);
+    item.Set("title", title.empty() ? url : title);
+    item.Set("detail", std::move(detail));
+    item.Set("url", url);
+    item.Set("favicon",
+             base::StrCat({"chrome://favicon2/?size=32&scaleFactor=1x&"
+                           "showFallbackMonogram=&pageUrl=",
+                           base::EscapeQueryParamValue(url, true)}));
+    suggestions.Append(std::move(item));
+  };
+
+  // Favorites are deliberate, user-ordered destinations. They always outrank
+  // ordinary open tabs and history, and they match against their durable
+  // original URL/title even when the currently materialized page navigated
+  // somewhere else.
+  const base::DictValue *active_space =
+      FindSpace(organization_, active_space_id);
+  const base::DictValue *active_profile =
+      active_space
+          ? FindProfile(organization_, StringOr(active_space, "profileId"))
+          : nullptr;
+  if (active_profile) {
+    for (const base::Value &favorite :
+         *active_profile->FindList("favorites")) {
+      append_tab(favorite.GetDict(), "Favorite — switch to tab",
+                 /*use_durable_identity=*/true);
+    }
+  }
+
+  auto append_space = [&](const base::DictValue &space) {
+    auto append_tabs = [&](const base::ListValue *tabs) {
+      if (!tabs) {
+        return;
+      }
+      for (const base::Value &value : *tabs) {
+        if (suggestions.size() >= maximum) {
+          return;
+        }
+        append_tab(value.GetDict(),
+                   base::StrCat({StringOr(&space, "icon", "✨"), " ",
+                                 StringOr(&space, "name", "Workspace"),
+                                 " — switch to tab"}),
+                   /*use_durable_identity=*/false);
+      }
+    };
+    append_tabs(space.FindList("pinned"));
+    append_tabs(space.FindList("today"));
+  };
+
+  // Recommendations start with the active workspace, then continue through
+  // the rest in their stable user order.
+  for (int pass = 0; pass < 2 && suggestions.size() < maximum; ++pass) {
+    for (const base::Value &value : *organization_.FindList("spaces")) {
+      const base::DictValue &space = value.GetDict();
+      const bool active = StringOr(&space, "id") == active_space_id;
+      if ((pass == 0) == active) {
+        append_space(space);
+      }
+    }
+  }
+  return suggestions;
+}
+
+bool ViolaOrganizationStore::MoveTab(std::string_view tab_id,
+                                     std::string_view space_id,
+                                     std::string_view section, size_t index) {
+  if (!loaded_ || tab_id.empty() || index > 4096) {
+    return false;
+  }
+  base::DictValue *destination_space = FindSpace(organization_, space_id);
+  if (!destination_space ||
+      (section != "favorite" && section != "pinned" && section != "today") ||
+      !FindPersistentTab(organization_, tab_id)) {
+    return false;
+  }
+  std::string source_profile_id;
+  for (const base::Value &profile_value : *organization_.FindList("profiles")) {
+    const base::DictValue &profile = profile_value.GetDict();
+    for (const base::Value &tab : *profile.FindList("favorites")) {
+      if (StringOr(&tab.GetDict(), "id") == tab_id) {
+        source_profile_id = StringOr(&profile, "id");
+        break;
+      }
+    }
+    if (!source_profile_id.empty()) {
+      break;
+    }
+  }
+  if (source_profile_id.empty()) {
+    const std::optional<std::string> source_space_id =
+        SpaceIdForTab(organization_, tab_id);
+    const base::DictValue *source_space =
+        source_space_id ? FindSpace(organization_, *source_space_id) : nullptr;
+    source_profile_id = StringOr(source_space, "profileId");
+  }
+  const std::optional<std::string> source_space_id =
+      SpaceIdForTab(organization_, tab_id);
+  // Desktop Chrome's normal Browser/TabStripModel owns one Profile and one
+  // compatible page-storage boundary. Do not relabel a live tab across Viola
+  // profiles until a browser-owned multi-Profile tab lifecycle exists.
+  if (source_profile_id.empty() ||
+      source_profile_id != StringOr(destination_space, "profileId")) {
+    return false;
+  }
+  base::ListValue *destination = nullptr;
+  if (section == "favorite") {
+    base::DictValue *profile =
+        FindProfile(organization_, StringOr(destination_space, "profileId"));
+    if (!profile) {
+      return false;
+    }
+    destination = profile->FindList("favorites");
+    if (destination->size() >= 12 &&
+        std::ranges::none_of(*destination, [tab_id](const base::Value& row) {
+          return StringOr(&row.GetDict(), "id") == tab_id;
+        })) {
+      return false;
+    }
+  } else {
+    destination = destination_space->FindList(section);
+  }
+
+  RemoveTabFromOrganizationGroups(organization_, tab_id,
+                                  /*forget_saved_snapshot=*/true);
+  std::optional<base::Value> moved =
+      ExtractPersistentTab(organization_, tab_id);
+  if (!moved) {
+    return false;
+  }
+  const size_t insertion = std::min(index, destination->size());
+  destination->Insert(destination->begin() + insertion, std::move(*moved));
+  if (source_space_id && *source_space_id != space_id) {
+    if (base::DictValue *source_space =
+            FindSpace(organization_, *source_space_id)) {
+      RememberRemovedTab(*source_space, tab_id);
+    }
+  }
+  destination_space->Set("activeTabId", tab_id);
+  ScheduleWrite();
+  return true;
+}
+
+bool ViolaOrganizationStore::GroupTab(std::string_view tab_id,
+                                      std::string_view target_tab_id,
+                                      std::string_view group_id,
+                                      std::string_view space_id, size_t index) {
+  if (!loaded_ || tab_id.empty() || index > 4096 ||
+      (target_tab_id.empty() == group_id.empty())) {
+    return false;
+  }
+  base::DictValue *space = FindSpace(organization_, space_id);
+  const std::optional<TabContextMenuState> source =
+      GetTabContextMenuState(tab_id);
+  if (!space || !source || source->profile_id != StringOr(space, "profileId") ||
+      !FindPersistentTab(organization_, tab_id)) {
+    return false;
+  }
+
+  base::DictValue *destination_group = nullptr;
+  std::string section;
+  if (!group_id.empty()) {
+    destination_group = FindTabGroup(organization_, space_id, group_id);
+    if (!destination_group) {
+      return false;
+    }
+    section = StringOr(destination_group, "section", "today");
+  } else {
+    for (std::string_view candidate : {"pinned", "today"}) {
+      for (const base::Value &tab : *space->FindList(candidate)) {
+        if (StringOr(&tab.GetDict(), "id") == target_tab_id) {
+          section = candidate;
+          break;
+        }
+      }
+      if (!section.empty()) {
+        break;
+      }
+    }
+    if (section.empty() || target_tab_id == tab_id) {
+      return false;
+    }
+  }
+
+  if (!MoveTab(tab_id, space_id, section, index)) {
+    return false;
+  }
+  if (!group_id.empty()) {
+    destination_group = FindTabGroup(organization_, space_id, group_id);
+    if (!destination_group) {
+      return false;
+    }
+    base::ListValue *ids = destination_group->FindList("tabIds");
+    const size_t insertion = std::min(index, ids->size());
+    ids->Insert(ids->begin() + insertion, base::Value(tab_id));
+  } else {
+    RemoveTabFromOrganizationGroups(organization_, target_tab_id,
+                                    /*forget_saved_snapshot=*/true);
+    base::DictValue group;
+    group.Set("id",
+              "group-" + base::Uuid::GenerateRandomV4().AsLowercaseString());
+    group.Set("title", "Tab Group");
+    base::ListValue ids;
+    ids.Append(target_tab_id);
+    ids.Append(tab_id);
+    group.Set("tabIds", std::move(ids));
+    group.Set("section", section);
+    group.Set("keepExpanded", false);
+    group.Set("collapsed", false);
+    group.Set("saved", false);
+    group.Set("savedTabs", base::ListValue());
+    space->FindList("tabGroups")->Append(std::move(group));
+  }
+  ScheduleWrite();
+  return true;
+}
+
+bool ViolaOrganizationStore::CreateTabGroup(
+    const std::vector<std::string> &tab_ids,
+    std::string_view space_id) {
+  if (!loaded_ || tab_ids.size() < 2 || tab_ids.size() > 100) {
+    return false;
+  }
+  base::DictValue *space = FindSpace(organization_, space_id);
+  if (!space) {
+    return false;
+  }
+  std::set<std::string> unique(tab_ids.begin(), tab_ids.end());
+  if (unique.size() != tab_ids.size()) {
+    return false;
+  }
+  std::string section;
+  for (const std::string &tab_id : tab_ids) {
+    const std::optional<TabContextMenuState> state =
+        GetTabContextMenuState(tab_id);
+    if (!state || state->space_id != space_id ||
+        (state->section != "pinned" && state->section != "today") ||
+        (!section.empty() && section != state->section)) {
+      return false;
+    }
+    section = state->section;
+  }
+  for (const std::string &tab_id : tab_ids) {
+    RemoveTabFromOrganizationGroups(organization_, tab_id,
+                                    /*forget_saved_snapshot=*/true);
+  }
+  base::DictValue group;
+  group.Set("id", "group-" + base::Uuid::GenerateRandomV4().AsLowercaseString());
+  group.Set("title", "Tab Group");
+  base::ListValue ids;
+  for (const std::string &tab_id : tab_ids) {
+    ids.Append(tab_id);
+  }
+  group.Set("tabIds", std::move(ids));
+  group.Set("section", section);
+  group.Set("keepExpanded", false);
+  group.Set("collapsed", false);
+  group.Set("saved", false);
+  group.Set("savedTabs", base::ListValue());
+  space->FindList("tabGroups")->Append(std::move(group));
+  ScheduleWrite();
+  return true;
+}
