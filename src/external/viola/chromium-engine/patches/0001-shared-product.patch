+.luma-settings .empty-state strong { display:block; margin-bottom:6px; color:var(--ink); font-size:15px; }
+.luma-settings .settings-search { width:100%; margin-bottom:12px; }
+.luma-settings input[type=checkbox] { accent-color:var(--accent); width:18px; height:18px; }
+.luma-settings .range-value { width:130px; max-width:40vw; font-size:11px; line-height:1.4; }
+.luma-settings .range-control { flex-wrap:wrap; justify-content:flex-end; }
+.luma-settings .ext-actions { flex-wrap:wrap; }
+.luma-settings [hidden] { display:none!important; }
+.luma-settings .search-empty { padding:12px; color:var(--muted); }
+@media(max-width:780px) {
