diff --git a/chrome/browser/resources/viola/window-chrome.css b/chrome/browser/resources/viola/window-chrome.css
new file mode 100644
index 0000000000000000000000000000000000000000..b38c7001d23069c13a5bde895b7e3cad4667819a
--- /dev/null
+++ b/chrome/browser/resources/viola/window-chrome.css
@@ -0,0 +1,96 @@
+:root {
+  color-scheme: light dark;
+  --caption-ink: rgba(27, 25, 37, .78);
+  --neutral-hover: rgba(20, 18, 28, .08);
+  --neutral-pressed: rgba(20, 18, 28, .14);
+}
+
+* { box-sizing: border-box; }
+html, body {
+  margin: 0;
+  width: 100%;
+  height: 100%;
+  overflow: hidden;
+  background: transparent;
+  /*
+   * This WebContentsView contains only native-window controls. Mark the whole
+   * surface non-draggable so Chromium never promotes a caption-button press
+   * into a frameless-window drag on Windows or Linux.
+   */
+  -webkit-app-region: no-drag;
+}
+#controls {
+  position: absolute;
+  top: 14.5px;
+  left: 14.5px;
+  display: flex;
+  align-items: center;
+  -webkit-app-region: no-drag;
+}
+.caption {
+  position: relative;
+  width: 23px;
+  height: 23px;
+  padding: 0;
+  border: 0;
+  border-radius: 0;
+  background: transparent;
+  color: var(--caption-ink);
+  display: grid;
+  place-items: center;
+  -webkit-app-region: no-drag;
+}
+.caption svg {
+  width: 14px;
+  height: 14px;
+  overflow: visible;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+.caption:hover { background: var(--neutral-hover); }
+.caption:active { background: var(--neutral-pressed); }
+.caption:focus-visible {
+  outline: 2px solid rgba(91, 91, 214, .88);
+  outline-offset: -2px;
+}
+.restore-mark { display: none; }
+body.maximized .maximize-mark { display: none; }
+body.maximized .restore-mark { display: block; }
+body.inactive #controls { opacity: .38; }
+
+body.platform-win32 .close:hover {
+  color: #fff;
+  background: #c42b1c;
+}
+body.platform-win32 .close:active {
+  color: #fff;
+  background: #a6251a;
+}
+
+body.platform-linux .caption {
+  margin: 1.5px;
+  width: 20px;
+  height: 20px;
+  border-radius: 10px;
+}
+body.platform-linux .caption svg {
+  stroke-width: 1.35;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --caption-ink: rgba(255, 255, 255, .82);
+    --neutral-hover: rgba(255, 255, 255, .11);
+    --neutral-pressed: rgba(255, 255, 255, .17);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: .01ms !important;
+    transition-duration: .01ms !important;
+  }
+}
