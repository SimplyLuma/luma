+      hideTimer = schedule(() => {
+        hideTimer = null;
+        if (token !== generation || !visible || identity(visible) !== visibleKey) return;
+        visible = null;
+        onHide();
+      }, hideDelay);
+    }
+
+    function dismiss() {
+      const hadVisible = !!visible;
+      generation += 1;
+      cancelShow();
+      cancelHide();
+      visible = null;
+      if (hadVisible) onHide();
+    }
+
+    function reconcile(resolve) {
+      if (typeof resolve !== 'function') return;
+      if (pending) {
+        const nextPending = resolve(pending);
+        if (nextPending && identity(nextPending) === identity(pending)) pending = nextPending;
+        else {
+          generation += 1;
+          cancelShow();
+        }
+      }
+      if (visible) {
+        const nextVisible = resolve(visible);
+        if (nextVisible && identity(nextVisible) === identity(visible)) {
+          visible = nextVisible;
+          onRefresh(visible);
+        } else {
+          dismiss();
+        }
+      }
+    }
+
+    return {
+      enter,
+      leave,
+      dismiss,
+      reconcile,
+      state: () => ({ pending, visible }),
+    };
+  }
+
+  return {
+    createHoverController,
+    groupCardModel,
+    identity,
+    relativeAccess,
+    tabCardModel,
+  };
+}));
