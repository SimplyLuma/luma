+  void
+  DidFinishNavigation(content::NavigationHandle *navigation_handle) override {
+    if (navigation_handle->HasCommitted() &&
+        navigation_handle->IsInPrimaryMainFrame() &&
+        !navigation_handle->IsSameDocument() &&
+        navigation_handle->GetURL() == target_url_) {
+      ++committed_navigations_;
+    }
+  }
+
+  int committed_navigations() const { return committed_navigations_; }
+
+private:
+  const GURL target_url_;
+  int committed_navigations_ = 0;
+};
