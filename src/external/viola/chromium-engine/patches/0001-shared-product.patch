+    vela.send('sidebar:dragEnd');
+    new Promise((resolve) => {
+      const deadline = performance.now() + 5000;
+      const check = () => {
+        if (S?.settings?.sidebarWidth === 340) {
+          resolve(getComputedStyle(document.documentElement)
+                    .getPropertyValue('--sw').trim() === '340px');
