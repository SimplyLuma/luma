+      if (phase === 'commit') {
+        indicator.classList.remove('committed');
+        void indicator.offsetWidth;
+        indicator.classList.add('committed');
+        return;
+      }
+      if (phase === 'complete') {
+        indicator.classList.add('committed');
+        hideTimer = setTimeout(() => {
+          indicator.classList.remove('visible', 'committed');
+        }, 80);
+        return;
+      }
+      indicator.classList.remove('committed');
+    });
+  </script>
+</body>
