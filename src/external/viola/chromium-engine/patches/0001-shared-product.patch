+bool UseMiniShell(const Browser& browser) {
+#if BUILDFLAG(IS_LINUX)
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("viola-native-frame-probe"))
+    return false;
+#endif
+  return ViolaMiniWindow::IsMini(browser);
+}
