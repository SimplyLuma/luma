+      <button id="downloads-clear" class="downloads-button danger" type="button">Clear Finished</button>
+      <button id="downloads-close" class="downloads-close" title="Close" aria-label="Close downloads" type="button"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button>
+    </div>
+    <div class="downloads-search-wrap"><div class="downloads-search">
+      <svg viewBox="0 0 20 20"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m12.8 12.8 3.8 3.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
+      <input id="downloads-search" aria-label="Search downloaded files" placeholder="Search downloaded files…" spellcheck="false" />
+    </div></div>
+    <div id="downloads-content"></div>
+  </div>
+
+  <div id="palette" role="dialog" aria-modal="true" aria-label="Address and search">
+    <div id="input-row">
+      <svg viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m10.5 10.5 3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
