+ViolaProductShellView::ViolaProductShellView(Browser *browser)
+    : views::WebView(browser->profile()),
+      contents_wrapper_(std::make_unique<WebUIContentsWrapperT<ViolaUI>>(
+          GURL(UseMiniShell(*browser) ? kViolaMiniUrl : kViolaUrl),
+          browser->profile(), IDS_PRODUCT_NAME,
+          /*esc_closes_ui=*/false,
+          /*supports_draggable_regions=*/true)),
+      browser_(browser),
+      mini_window_(UseMiniShell(*browser)) {
+  CHECK(browser);
+  if (ViolaOrganizationStore *store =
+          ViolaOrganizationStore::Get(browser->profile());
+      !mini_window_ && store && store->loaded()) {
+    // A later window can be constructed after the shared WebUI state already
+    // knows the saved width. Seed the native surface before its first layout
+    // so CSS and the real page frame cannot disagree for one window lifetime.
+    sidebar_width_ = std::clamp(store->sidebar_width(), 200, 420);
+    // Sidebar visibility is window-local presentation state. A newly created
+    // window is always usable and starts expanded even when its source window
+    // is temporarily collapsed.
+    sidebar_collapsed_ = false;
+  }
+  HostContentSettingsMap *content_settings =
+      HostContentSettingsMapFactory::GetForProfile(browser->profile());
+  if (content_settings) {
+    // Viola's embedded sidebar player is the automatic away-from-tab
+    // behavior. Chromium's floating window remains available only from the
+    // explicit Picture-in-Picture control. Clear migrated per-site automatic
+    // PiP grants before setting the default: a YouTube-specific ALLOW outranks
+    // a BLOCK default and can otherwise create a floating window for one
+    // compositor frame before Viola adopts the media into its sidebar.
+    content_settings->ClearSettingsForOneType(
+        ContentSettingsType::AUTO_PICTURE_IN_PICTURE);
+    content_settings->SetDefaultContentSetting(
+        ContentSettingsType::AUTO_PICTURE_IN_PICTURE,
+        CONTENT_SETTING_BLOCK);
+  }
+  // This build does not ship or expose Chromium's Live Caption language
+  // package. Clear a migrated engine preference before media starts so the
+  // unavailable-service toast cannot recur in Viola windows.
+  if (PrefService *prefs = browser->profile()->GetPrefs();
+      prefs && prefs->GetBoolean(prefs::kLiveCaptionEnabled)) {
+    prefs->SetBoolean(prefs::kLiveCaptionEnabled, false);
+  }
+  set_allow_accelerators(true);
+  contents_wrapper_->SetHost(weak_factory_.GetWeakPtr());
+  SetWebContents(contents_wrapper_->web_contents());
+  extension_popup_anchor_view_ = AddChildView(std::make_unique<views::View>());
+  extension_popup_anchor_view_->SetCanProcessEventsWithinSubtree(false);
+  extension_popup_anchor_view_->SetBoundsRect(gfx::Rect(14, 14, 1, 1));
+  webui::SetBrowserWindowInterface(contents_wrapper_->web_contents(), browser);
+  SetVisible(true);
+  NoteMiniActivity();
+#if BUILDFLAG(IS_LINUX)
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("viola-native-frame-probe")) {
+    native_frame_probe_ = std::make_unique<ViolaNativeFrameProbe>(browser_);
+  }
+#endif
+}
