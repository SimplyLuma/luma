+IN_PROC_BROWSER_TEST_F(ViolaPeerRestoreBrowserTest,
+                       WaitsForChromiumRestoreBeforeMaterializing) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("about:blank")));
+  auto* store = viola::ViolaOrganizationStore::Get(browser()->profile());
+  base::test::TestFuture<void> loaded;
+  store->EnsureLoaded(loaded.GetCallback());
+  ASSERT_TRUE(loaded.Wait());
+  ASSERT_FALSE(store->materialized_once());
+  class RestoreObserver final : public TabStripModelObserver {
+   public:
+    RestoreObserver(Browser* browser, viola::ViolaOrganizationStore* store)
+        : browser_(browser), store_(store) {}
+    void OnTabStripModelChanged(TabStripModel* strip,
+                               const TabStripModelChange& change,
+                               const TabStripSelectionChange& selection) override {
+      if (!SessionRestore::IsRestoring(browser_->profile())) return;
+      observed_restore = true;
+      store_->ReconcileAndMaterialize(browser_, strip);
+      stayed_deferred = !store_->materialized_once();
+    }
+    bool observed_restore = false;
+    bool stayed_deferred = false;
+   private:
+    raw_ptr<Browser> browser_;
+    raw_ptr<viola::ViolaOrganizationStore> store_;
+  } observer(browser(), store);
+  auto* strip = browser()->tab_strip_model();
+  strip->AddObserver(&observer);
+  sessions::SessionTab tab;
+  tab.current_navigation_index = 0;
+  tab.navigations.push_back(
+      sessions::ContentSerializedNavigationBuilder::FromNavigationEntry(
+          0, strip->GetActiveWebContents()->GetController().GetLastCommittedEntry()));
+  content::WebContents* restored = SessionRestore::RestoreForeignSessionTab(
+      strip->GetActiveWebContents(), tab,
+      WindowOpenDisposition::NEW_FOREGROUND_TAB);
+  strip->RemoveObserver(&observer);
+  ASSERT_TRUE(restored);
+  EXPECT_TRUE(observer.observed_restore);
+  EXPECT_TRUE(observer.stayed_deferred);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return store->materialized_once(); }));
+  EXPECT_EQ(2, strip->count());
+  std::set<std::string> identities;
+  for (int i = 0; i < strip->count(); ++i)
+    identities.insert(store->TabIdFor(strip->GetWebContentsAt(i)));
+  EXPECT_EQ((std::set<std::string>{"restored-tab", "restored-peer"}), identities);
+}
