+  base::FilePath native_path_;
+  base::FilePath receipt_path_;
+  base::FilePath legacy_path_;
+  base::DictValue organization_;
+  std::unique_ptr<base::ImportantFileWriter> writer_;
+  std::vector<base::OnceClosure> loaded_callbacks_;
+  bool loading_ = false;
+  bool loaded_ = false;
+  bool materialized_once_ = false;
+  bool materializing_ = false;
+  bool applying_sync_ = false;
+  bool restore_materialization_pending_ = false;
+  base::CallbackListSubscription session_restored_subscription_;
+  std::string workspace_lens_id_;
+  base::ObserverList<Observer> observers_;
+
+  base::WeakPtrFactory<ViolaOrganizationStore> weak_factory_{this};
+};
+
