+    <svg viewBox="0 0 20 20" aria-hidden="true">
+      <path d="M11.8 5.2 7 10l4.8 4.8" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
+    </svg>
+  </div>
+  <script>
+    const indicator = document.getElementById('indicator');
+    let hideTimer = null;
+
+    vela.on('history:gesture', ({
+      direction = 'back', phase = 'cancel', progress = 0, available = false, theme = null,
+    } = {}) => {
+      clearTimeout(hideTimer);
+      hideTimer = null;
+
+      if (theme) {
+        document.documentElement.style.setProperty('--accent', theme.accent || '#5b5bd6');
+        document.documentElement.style.setProperty('--ink', theme.dark ? '#f4f2fa' : (theme.ink || '#252238'));
+        document.documentElement.style.setProperty(
+          '--surface',
+          theme.dark ? 'rgba(37, 34, 48, .96)' : 'rgba(255, 255, 255, .94)',
+        );
+      }
+
+      if (!available || phase === 'cancel') {
+        indicator.classList.remove('visible', 'committed');
+        return;
+      }
+
+      indicator.dataset.direction = direction;
+      indicator.style.setProperty(
+        '--history-sweep',
+        `${Math.round(Math.max(0, Math.min(1, progress)) * 360)}deg`,
+      );
