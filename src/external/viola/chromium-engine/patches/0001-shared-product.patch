+IN_PROC_BROWSER_TEST_F(ViolaUIBrowserTest,
+                       ReadsAndWritesCrossPlatformEncryptedSnapshots) {
+  std::vector<uint8_t> key(32);
+  for (size_t index = 0; index < key.size(); ++index) {
+    key[index] = static_cast<uint8_t>(index);
+  }
+  base::DictValue envelope;
+  envelope.Set("type", "viola-encrypted-sync-queue");
+  envelope.Set("version", 1);
+  envelope.Set("payloadType", "viola-tab-workspace-sync");
+  envelope.Set("accountId", "11111111-1111-4111-8111-111111111111");
+  envelope.Set("deviceId", "22222222-2222-4222-8222-222222222222");
+  envelope.Set("revision", 7);
+  envelope.Set("generatedAt", "2026-08-04T12:00:00.000Z");
+  envelope.Set("cipher", "aes-256-gcm");
+  envelope.Set("iv", "QEFCQ0RFRkdISUpL");
+  envelope.Set("tag", "WELmQ9iUx4wHU9q8/hcSRg==");
+  envelope.Set(
+      "ciphertext",
+      "mZvaWlZZpTnvsn5Z9wU+LxikfyvYR2RQByYtgLpglLX7Kt+OqNytJ0ibZU2rPPP4"
+      "qhLJXkaplkDlOO4mFtsZ8dUi5Jsp7xqbZuxXtKdJ0VB/SWPmGlslvkbnFA4qMRV"
+      "kld9Yju12DqMtW/GZjenAPrqNb9yZrV9P5YyHyVyacPGaO1z3NBxLtcFJ6pqObVn"
+      "8gvqRvGCBmcFGJOyS9odAetHqn38Q1nRiXVDOleIAyPD4J7IS6TB+rqnpYtPyxpY"
+      "kcsYIsVwX9fU39DJFJVsCI1HQbnFMcz8=");
+  std::optional<base::DictValue> payload =
+      viola::ViolaAccountSyncService::DecryptEnvelopeForTesting(envelope, key);
+  ASSERT_TRUE(payload);
+  EXPECT_EQ("viola-tab-workspace-sync", *payload->FindString("type"));
+  EXPECT_EQ(7, payload->FindInt("revision"));
+  ASSERT_TRUE(payload->FindList("records"));
+
+  base::DictValue equivalent_timestamp = envelope.Clone();
+  equivalent_timestamp.Set("generatedAt", "2026-08-04T12:00:00Z");
+  EXPECT_TRUE(viola::ViolaAccountSyncService::DecryptEnvelopeForTesting(
+      equivalent_timestamp, key));
+  base::DictValue mismatched_timestamp = envelope.Clone();
+  mismatched_timestamp.Set("generatedAt", "2026-08-04T12:00:01Z");
+  EXPECT_FALSE(viola::ViolaAccountSyncService::DecryptEnvelopeForTesting(
+      mismatched_timestamp, key));
+
+  std::optional<base::DictValue> round_trip =
+      viola::ViolaAccountSyncService::EncryptPayloadForTesting(*payload, key);
+  ASSERT_TRUE(round_trip);
+  EXPECT_EQ("viola-encrypted-sync-queue", *round_trip->FindString("type"));
+  EXPECT_EQ(1, round_trip->FindInt("version"));
+  EXPECT_EQ("viola-tab-workspace-sync", *round_trip->FindString("payloadType"));
+  EXPECT_TRUE(viola::ViolaAccountSyncService::DecryptEnvelopeForTesting(
+      *round_trip, key));
+}
