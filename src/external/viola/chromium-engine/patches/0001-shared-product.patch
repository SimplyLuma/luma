diff --git a/chrome/browser/resources/viola/little.js b/chrome/browser/resources/viola/little.js
new file mode 100644
index 0000000000000000000000000000000000000000..41c2e0573f62bcc611b4abcd31d374679a2814a1
--- /dev/null
+++ b/chrome/browser/resources/viola/little.js
@@ -0,0 +1,52 @@
+(() => {
+  'use strict';
+  const $ = (selector) => document.querySelector(selector);
+  let currentUrl = '';
+
+  const prettyUrl = (url) => {
+    if (!url || url === 'about:blank') return '';
+    try { return new URL(url).host.replace(/^www\./, ''); } catch { return url; }
+  };
+  const startEdit = (prefill) => {
+    document.body.classList.add('editing');
+    const input = $('#url-input');
+    input.value = prefill !== undefined ? prefill : currentUrl;
+    input.focus();
+    input.select();
+  };
+
+  vela.on('little:render', (data) => {
+    document.body.classList.toggle('incognito', !!data.incognito);
+    currentUrl = data.url || '';
+    $('#title').textContent = data.title || prettyUrl(data.url) || 'Mini Viola';
+    $('#back').disabled = !data.canGoBack;
+    $('#fwd').disabled = !data.canGoForward;
+    const favicon = $('#fav');
+    if (data.favicon) { favicon.src = data.favicon; favicon.style.display = 'block'; }
+    else favicon.style.display = 'none';
+    if (data.theme && !data.incognito) {
+      const root = document.documentElement.style;
+      root.setProperty('--g1', data.theme.gradient[0]);
+      root.setProperty('--g2', data.theme.gradient[1]);
+      root.setProperty('--g3', data.theme.gradient[2] || data.theme.gradient[1]);
+      root.setProperty('--ink', data.theme.ink);
+      root.setProperty('--accent', data.theme.accent);
+    }
+  });
+  vela.on('little:focus-input', () => startEdit(''));
+  $('#pill').addEventListener('click', () => startEdit(currentUrl === 'about:blank' ? '' : currentUrl));
+  $('#url-input').addEventListener('keydown', (event) => {
+    if (event.key === 'Enter') {
+      const input = event.target.value.trim();
+      document.body.classList.remove('editing');
+      if (input) vela.send('little:navigate', { input });
+    } else if (event.key === 'Escape') document.body.classList.remove('editing');
+  });
+  $('#url-input').addEventListener('blur', () => document.body.classList.remove('editing'));
+  $('#back').addEventListener('click', () => vela.send('little:back'));
+  $('#fwd').addEventListener('click', () => vela.send('little:forward'));
+  $('#reload').addEventListener('click', () => vela.send('little:reload'));
+  $('#copy').addEventListener('click', () => vela.send('little:copy'));
+  $('#adopt').addEventListener('click', () => vela.send('little:adopt'));
+  vela.send('ui:ready');
+})();
