+bool IsDisposableStartupBlank(const GURL &url, const GURL &homepage) {
+  if (url.spec() == "about:blank") {
+    return true;
+  }
+  // The sidebar host turns Chromium's initial blank contents into Viola's
+  // deliberately plain Google homepage before the organization store has
+  // finished loading. It is still the same unbound startup placeholder; once
+  // the persisted tab has materialized, retaining it would manufacture a
+  // duplicate Google tab on every cold start.
+  if (url == GURL("https://www.google.com/")) {
+    return true;
+  }
+  if (homepage.is_valid() && url == homepage) {
+    return true;
+  }
+  if (url.SchemeIs("chrome")) {
+    return url.host() == "newtab" || url.host() == "new-tab-page" ||
+           url.host() == "new-tab-page-third-party";
+  }
+  return url.SchemeIs("chrome-search") &&
+         (url.host() == "local-ntp" || url.host() == "remote-ntp");
+}
