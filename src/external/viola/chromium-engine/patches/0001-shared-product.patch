--- /dev/null
+++ b/chrome/browser/resources/viola/sidebar.css
@@ -0,0 +1,2116 @@
+/* Viola sidebar — Arc-inspired chrome. Gradient window, floating page. */
+:root {
+  --g1: #b8c6f8;
+  --g2: #dcc7f5;
+  --g3: #f6d4e3;
+  --accent: #5b5bd6;
+  --ink: #2a2550;
+  --tab-h: 34px;
+  --tab-gap: 3px;
+  --tab-radius: 9px;
+  --workspace-header-h: 34px;
+  --workspace-header-radius: 9px;
+  --workspace-section-gap: 13px;
+  --workspace-content-inset-left: 12px;
+  --workspace-content-inset-right: 12px;
+  --sw: 264px;
+  --tint: rgba(255, 255, 255, 0.28);
+  --tint-strong: rgba(255, 255, 255, 0.55);
+  --tint-soft: rgba(255, 255, 255, 0.16);
+  --workspace-menu-surface: color-mix(in srgb, #fcfcfe 92%, var(--g2));
+  --workspace-menu-border: rgba(35, 31, 54, .09);
+}
+
+* { margin: 0; padding: 0; box-sizing: border-box; user-select: none; }
+
+html, body { height: 100%; }
+
+body {
+  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
+  font-size: 13px;
+  color: var(--ink);
+  background: linear-gradient(160deg, var(--g1) 0%, var(--g2) 55%, var(--g3) 100%);
+  overflow: hidden;
+}
+
+body.dark {
+  --tint: rgba(255, 255, 255, 0.12);
+  --tint-strong: rgba(255, 255, 255, 0.22);
+  --tint-soft: rgba(255, 255, 255, 0.07);
+  --workspace-menu-surface: color-mix(in srgb, #171920 82%, var(--g2));
+  --workspace-menu-border: rgba(255, 255, 255, .11);
+}
+
+/* While resizing the sidebar the UI view is raised above the page view;
+   only the sidebar column may paint, the rest must stay transparent. */
+body.overlay-mode { background: transparent; }
+/* Chromium keeps this trusted shell below the real page while its content
+   bounds move, so retain the whole-window gradient during a native drag. */
+body.native-chromium.overlay-mode {
+  background: linear-gradient(160deg, var(--g1) 0%, var(--g2) 55%, var(--g3) 100%);
+}
+body.overlay-mode #sidebar {
+  background: linear-gradient(160deg, var(--g1) 0%, var(--g2) 55%, var(--g3) 100%);
+  background-attachment: fixed;
+}
+body.sidebar-peeking { background: transparent; }
+/* When collapsed, the trusted shell is only the 12px hover hotspot. Its own
+   viewport-sized gradient would be compressed into that strip and meet the
+   full-window native frame at a visibly different color. Let the one native
+   frame gradient paint through until the real sidebar is peeking. */
+body.collapsed:not(.sidebar-peeking) { background: transparent; }
+body.sidebar-peeking #sidebar {
+  background: linear-gradient(160deg, var(--g1) 0%, var(--g2) 55%, var(--g3) 100%);
+  background-attachment: fixed;
+}
+
+#frame { height: 100%; display: flex; }
+
+#sidebar {
+  position: relative;
+  width: var(--sw);
+  height: 100%;
+  display: flex;
+  flex-direction: column;
+  padding: 0 10px 10px;
+}
+body.external-html-drag #sidebar::after {
+  content: 'Open HTML in New Tab';
+  position: absolute;
+  inset: 44px 6px 7px 9px;
+  z-index: 500;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border: 1.5px dashed color-mix(in srgb, var(--accent) 68%, var(--ink));
+  border-radius: 14px;
+  background: color-mix(in srgb, var(--g2) 46%, rgba(250, 249, 255, .84));
+  box-shadow: inset 0 0 28px color-mix(in srgb, var(--accent) 12%, transparent);
+  color: var(--ink);
+  font-size: 12px;
+  font-weight: 720;
+  letter-spacing: .15px;
+  pointer-events: none;
+  backdrop-filter: blur(14px);
+}
+
+body.side-right #frame { justify-content: flex-end; }
+body.side-right #sidebar { padding: 0 10px 10px; }
+body.collapsed #sidebar { display: none; }
+body.collapsed.sidebar-peeking #sidebar { display: flex; }
+
+#sidebar-peek-hotspot {
+  display: none;
+  position: fixed;
+  inset: 0 auto 0 0;
+  width: 12px;
+  z-index: 20;
+}
+body.collapsed:not(.sidebar-peeking) #sidebar-peek-hotspot { display: block; }
+body.side-right #sidebar-peek-hotspot {
+  left: auto;
+  right: 0;
+}
+
+@keyframes sidebar-peek-in-left {
+  from { transform: translateX(calc(-1 * var(--sw))); }
+  to { transform: translateX(0); }
+}
+@keyframes sidebar-peek-out-left {
+  from { transform: translateX(0); }
+  to { transform: translateX(calc(-1 * var(--sw))); }
+}
+@keyframes sidebar-peek-in-right {
+  from { transform: translateX(var(--sw)); }
+  to { transform: translateX(0); }
+}
+@keyframes sidebar-peek-out-right {
+  from { transform: translateX(0); }
+  to { transform: translateX(var(--sw)); }
+}
+body.collapsed.sidebar-peeking:not(.sidebar-peek-closing) #sidebar {
+  animation: sidebar-peek-in-left 150ms cubic-bezier(.2, .78, .2, 1) both;
+}
+body.collapsed.sidebar-peeking.sidebar-peek-closing #sidebar {
+  animation: sidebar-peek-out-left 140ms cubic-bezier(.4, 0, .7, .2) both;
+  pointer-events: none;
+}
+body.side-right.collapsed.sidebar-peeking:not(.sidebar-peek-closing) #sidebar {
+  animation-name: sidebar-peek-in-right;
+}
+body.side-right.collapsed.sidebar-peeking.sidebar-peek-closing #sidebar {
+  animation-name: sidebar-peek-out-right;
+}
+
+/* ---- titlebar ---- */
+#titlebar {
+  position: relative;
+  height: 52px;
+  flex: 0 0 52px;
+  display: flex;
+  align-items: center;
+  -webkit-app-region: drag;
+}
+#desktop-caption-controls {
