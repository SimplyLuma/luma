diff --git a/chrome/browser/resources/viola/pdf-viewer.js b/chrome/browser/resources/viola/pdf-viewer.js
new file mode 100644
index 0000000000000000000000000000000000000000..7c969deda29ee8ba00cbd17721ecf468499e0f06
--- /dev/null
+++ b/chrome/browser/resources/viola/pdf-viewer.js
@@ -0,0 +1,193 @@
+import * as pdfjsLib from '../../node_modules/pdfjs-dist/build/pdf.mjs';
+
+pdfjsLib.GlobalWorkerOptions.workerSrc =
+  '../../node_modules/pdfjs-dist/build/pdf.worker.mjs';
+
+const params = new URLSearchParams(location.search);
+const sourceUrl = params.get('source') || '';
+const displayUrl = params.get('display') || sourceUrl;
+const titleNode = document.querySelector('#document-title');
+const pageCountNode = document.querySelector('#page-count');
+const pageNumberInput = document.querySelector('#page-number');
+const reader = document.querySelector('#reader');
+const pagesNode = document.querySelector('#pages');
+const statusNode = document.querySelector('#status');
+const zoomLabel = document.querySelector('#zoom-label');
+const printButton = document.querySelector('#print');
+const isMac = /Mac/i.test(navigator.userAgentData?.platform || navigator.platform || '');
+printButton.textContent = isMac ? '⌘P' : 'Ctrl+P';
+
+let documentHandle = null;
+let scale = 1.2;
+let pageModels = [];
+let observer = null;
+let renderGeneration = 0;
+
+function labelFor(url) {
+  try {
+    const name = decodeURIComponent(new URL(url).pathname.split('/').pop() || '');
+    return name || 'PDF document';
+  } catch {
+    return 'PDF document';
+  }
+}
+
+function showError(message) {
+  statusNode.classList.remove('hidden');
+  statusNode.classList.add('error');
+  statusNode.innerHTML = '';
+  const copy = document.createElement('span');
+  copy.textContent = message;
+  statusNode.append(copy);
+}
+
+function viewportFor(page, requestedScale = scale) {
+  return page.getViewport({ scale: requestedScale });
+}
+
+async function renderPage(model, generation = renderGeneration) {
+  if (model.renderedScale === scale || model.rendering) return;
+  model.rendering = true;
+  try {
+    const viewport = viewportFor(model.page);
+    const ratio = Math.min(devicePixelRatio || 1, 2);
+    const canvas = model.canvas;
+    canvas.width = Math.floor(viewport.width * ratio);
+    canvas.height = Math.floor(viewport.height * ratio);
+    canvas.style.width = `${viewport.width}px`;
+    canvas.style.height = `${viewport.height}px`;
+    model.element.style.width = `${viewport.width}px`;
+    model.element.style.height = `${viewport.height}px`;
+    const context = canvas.getContext('2d', { alpha: false });
+    await model.page.render({
+      canvasContext: context,
+      viewport,
+      transform: ratio === 1 ? null : [ratio, 0, 0, ratio, 0, 0],
+    }).promise;
+    if (generation === renderGeneration) model.renderedScale = scale;
+  } finally {
+    model.rendering = false;
+  }
+}
+
+function observePages() {
+  observer?.disconnect();
+  observer = new IntersectionObserver((entries) => {
+    for (const entry of entries) {
+      if (entry.isIntersecting) void renderPage(entry.target._pageModel);
+    }
+  }, { root: reader, rootMargin: '800px 0px' });
+  for (const model of pageModels) observer.observe(model.element);
+}
+
+async function buildPages() {
+  const fragment = document.createDocumentFragment();
+  for (let number = 1; number <= documentHandle.numPages; number += 1) {
+    const page = await documentHandle.getPage(number);
+    const viewport = viewportFor(page);
+    const element = document.createElement('section');
+    element.className = 'page';
+    element.dataset.page = String(number);
+    element.style.width = `${viewport.width}px`;
+    element.style.height = `${viewport.height}px`;
+    const canvas = document.createElement('canvas');
+    const badge = document.createElement('span');
+    badge.className = 'page-number';
+    badge.textContent = String(number);
+    element.append(canvas, badge);
+    const model = { number, page, element, canvas, renderedScale: 0, rendering: false };
+    element._pageModel = model;
+    pageModels.push(model);
+    fragment.append(element);
+  }
+  pagesNode.replaceChildren(fragment);
+  pageCountNode.textContent = String(documentHandle.numPages);
+  statusNode.classList.add('hidden');
+  observePages();
+}
+
+async function openDocument() {
+  if (!sourceUrl || !window.violaPdf) {
+    showError('This PDF could not be opened.');
+    return;
+  }
+  const label = labelFor(displayUrl);
+  titleNode.textContent = label;
+  document.title = label;
+  try {
+    const result = await window.violaPdf.load(sourceUrl);
+    if (!result?.ok || !result.bytes) throw new Error(result?.error || 'Download failed');
+    const bytes = result.bytes instanceof Uint8Array
+      ? result.bytes : new Uint8Array(result.bytes);
+    documentHandle = await pdfjsLib.getDocument({
+      data: bytes,
+      cMapUrl: '../../node_modules/pdfjs-dist/cmaps/',
+      cMapPacked: true,
+      standardFontDataUrl: '../../node_modules/pdfjs-dist/standard_fonts/',
+      wasmUrl: '../../node_modules/pdfjs-dist/wasm/',
+    }).promise;
+    await buildPages();
+  } catch (error) {
+    showError(error?.message || 'This PDF could not be opened.');
+  }
+}
+
+function visiblePage() {
+  const readerTop = reader.getBoundingClientRect().top;
+  let best = pageModels[0];
+  let bestDistance = Infinity;
+  for (const model of pageModels) {
+    const distance = Math.abs(model.element.getBoundingClientRect().top - readerTop - 12);
+    if (distance < bestDistance) {
+      best = model;
+      bestDistance = distance;
+    }
+  }
+  return best;
+}
+
+function refreshZoom() {
+  renderGeneration += 1;
+  zoomLabel.textContent = `${Math.round(scale * 100)}%`;
+  for (const model of pageModels) {
+    const viewport = viewportFor(model.page);
+    model.element.style.width = `${viewport.width}px`;
+    model.element.style.height = `${viewport.height}px`;
+    model.renderedScale = 0;
+  }
+  observePages();
+}
+
+reader.addEventListener('scroll', () => {
+  const model = visiblePage();
+  if (model) pageNumberInput.value = String(model.number);
+}, { passive: true });
+
+pageNumberInput.addEventListener('change', () => {
+  const number = Math.max(1, Math.min(documentHandle?.numPages || 1,
+    Number.parseInt(pageNumberInput.value, 10) || 1));
+  pageNumberInput.value = String(number);
+  pageModels[number - 1]?.element.scrollIntoView({ block: 'start', behavior: 'smooth' });
+});
+
+document.querySelector('#zoom-out').addEventListener('click', () => {
+  scale = Math.max(0.4, scale - 0.15);
+  refreshZoom();
+});
+document.querySelector('#zoom-in').addEventListener('click', () => {
+  scale = Math.min(3, scale + 0.15);
+  refreshZoom();
+});
+zoomLabel.addEventListener('click', () => {
+  const first = pageModels[0];
+  if (!first) return;
+  const natural = viewportFor(first.page, 1);
+  scale = Math.max(0.4, Math.min(3, (reader.clientWidth - 48) / natural.width));
+  refreshZoom();
+});
+document.querySelector('#download').addEventListener('click', () => {
+  window.violaPdf?.download(sourceUrl);
+});
+printButton.addEventListener('click', () => window.print());
+
+void openDocument();
