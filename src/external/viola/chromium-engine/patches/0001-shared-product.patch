+    function leave(item) {
+      const key = identity(item);
+      if (!key) return;
+      let leftPendingTarget = false;
+      if (pending && identity(pending) === key) {
+        generation += 1;
+        cancelShow();
+        leftPendingTarget = true;
+      }
+      if (!visible || (identity(visible) !== key && !leftPendingTarget)) return;
+      const visibleKey = identity(visible);
+      cancelHide();
