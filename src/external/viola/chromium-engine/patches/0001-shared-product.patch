+ViolaProductOverlayHostView::ViolaProductOverlayHostView(Browser *browser)
+    : dimmer_contents_wrapper_(std::make_unique<WebUIContentsWrapperT<ViolaUI>>(
+          GURL(kViolaDimmerUrl), browser->profile(), IDS_PRODUCT_NAME,
+          /*esc_closes_ui=*/false,
+          /*supports_draggable_regions=*/false)),
+      overlay_contents_wrapper_(
+          std::make_unique<WebUIContentsWrapperT<ViolaUI>>(
+              GURL(kViolaOverlayUrl), browser->profile(), IDS_PRODUCT_NAME,
+              /*esc_closes_ui=*/false,
+              /*supports_draggable_regions=*/false)) {
+  CHECK(browser);
+
+  auto dimmer = std::make_unique<views::WebView>(browser->profile());
+  dimmer_web_view_ = AddChildView(std::move(dimmer));
+  dimmer_web_view_->SetWebContents(dimmer_contents_wrapper_->web_contents());
+  dimmer_contents_wrapper_->SetHost(weak_factory_.GetWeakPtr());
+  webui::SetBrowserWindowInterface(dimmer_web_contents(), browser);
+  dimmer_web_contents()->SetPageBaseBackgroundColor(SK_ColorTRANSPARENT);
+
+  auto overlay = std::make_unique<views::WebView>(browser->profile());
+  overlay_web_view_ = AddChildView(std::move(overlay));
+  overlay_web_view_->set_allow_accelerators(true);
+  overlay_web_view_->SetWebContents(overlay_contents_wrapper_->web_contents());
+  overlay_contents_wrapper_->SetHost(weak_factory_.GetWeakPtr());
+  webui::SetBrowserWindowInterface(overlay_web_contents(), browser);
+  overlay_web_contents()->SetPageBaseBackgroundColor(SK_ColorTRANSPARENT);
+
+  SetVisible(false);
+}
+
+ViolaProductOverlayHostView::~ViolaProductOverlayHostView() = default;
+
+void ViolaProductOverlayHostView::MarkSurfaceReady(std::string_view surface) {
+  if (surface == "dimmer.html") {
+    dimmer_ready_ = true;
+    if (palette_requested_ && pending_mode_ != "split") {
+      SendDimmerState(true);
+    }
+    return;
+  }
+  if (surface == "overlay.html") {
+    overlay_ready_ = true;
+    if (palette_requested_) {
+      SendPaletteState();
+    }
+  }
+}
+
+void ViolaProductOverlayHostView::ShowAddressPalette(std::string current_url) {
+  pending_mode_ = "edit";
+  pending_current_url_ = std::move(current_url);
+  pending_downloads_.clear();
+  pending_split_hint_.reset();
+  ShowPendingOverlay();
+}
+
+void ViolaProductOverlayHostView::ShowNewTabPalette() {
+  pending_mode_ = "new";
+  pending_current_url_.clear();
+  pending_downloads_.clear();
+  pending_split_hint_.reset();
+  ShowPendingOverlay();
+}
+
+void ViolaProductOverlayHostView::ShowDownloads(base::ListValue downloads) {
+  pending_mode_ = "downloads";
+  pending_current_url_.clear();
+  pending_downloads_ = std::move(downloads);
+  pending_split_hint_.reset();
+  ShowPendingOverlay();
+}
+
+void ViolaProductOverlayHostView::ShowSplitHint(
+    std::optional<gfx::Rect> bounds) {
+  if (!bounds) {
+    if (pending_mode_ == "split") {
+      ClosePalette();
+    }
+    return;
+  }
+  const bool updating_visible_hint =
+      palette_requested_ && pending_mode_ == "split";
+  pending_mode_ = "split";
+  pending_current_url_.clear();
+  pending_downloads_.clear();
+  pending_split_hint_ = *bounds;
+  if (updating_visible_hint) {
+    if (overlay_ready_) {
+      SendSplitHint();
+    }
+    return;
+  }
+  ShowPendingOverlay();
+}
+
+void ViolaProductOverlayHostView::ShowPendingOverlay() {
+  palette_requested_ = true;
+  SetVisible(true);
+  const bool split_hint = pending_mode_ == "split";
+  dimmer_web_view_->SetVisible(!split_hint);
+  overlay_web_view_->SetVisible(true);
+  if (split_hint) {
+    dimmer_web_contents()->WasHidden();
+    if (dimmer_ready_) {
+      SendDimmerState(false);
+    }
+  } else {
+    dimmer_web_contents()->WasShown();
+  }
+  overlay_web_contents()->WasShown();
+  if (dimmer_ready_ && !split_hint) {
+    SendDimmerState(true);
+  }
+  if (overlay_ready_) {
+    SendPaletteState();
+  }
+  if (!split_hint) {
+    overlay_web_view_->RequestFocus();
+  }
+}
+
+void ViolaProductOverlayHostView::ClosePalette() {
+  if (!palette_requested_) {
+    return;
+  }
+  if (dimmer_ready_) {
+    SendDimmerState(false);
+  }
+  palette_requested_ = false;
+  pending_mode_.clear();
+  pending_current_url_.clear();
+  pending_downloads_.clear();
+  pending_split_hint_.reset();
+  overlay_web_contents()->WasHidden();
+  dimmer_web_contents()->WasHidden();
+  SetVisible(false);
+}
+
+content::WebContents *ViolaProductOverlayHostView::dimmer_web_contents() const {
+  return dimmer_contents_wrapper_->web_contents();
+}
+
+content::WebContents *
+ViolaProductOverlayHostView::overlay_web_contents() const {
+  return overlay_contents_wrapper_->web_contents();
+}
+
+void ViolaProductOverlayHostView::ShowUI() {}
+
+void ViolaProductOverlayHostView::CloseUI() { ClosePalette(); }
+
+bool ViolaProductOverlayHostView::HandleKeyboardEvent(
+    content::WebContents *source, const input::NativeWebKeyboardEvent &event) {
+  return unhandled_keyboard_event_handler_.HandleKeyboardEvent(
+      event, GetFocusManager());
+}
+
+void ViolaProductOverlayHostView::Layout(PassKey) {
+  dimmer_web_view_->SetBoundsRect(GetLocalBounds());
+  overlay_web_view_->SetBoundsRect(GetLocalBounds());
+}
+
+void ViolaProductOverlayHostView::SendDimmerState(bool visible) {
+  base::DictValue state;
+  state.Set("visible", visible);
+  dimmer_web_contents()->GetWebUI()->CallJavascriptFunctionUnsafe(
+      "__violaHostReceive", base::Value("dimmer:set"),
+      base::Value(std::move(state)));
+}
+
+void ViolaProductOverlayHostView::SendPaletteState() {
+  base::DictValue state;
+  state.Set("mode", pending_mode_);
+  if (pending_mode_ == "edit") {
+    state.Set("currentUrl", pending_current_url_);
+  } else if (pending_mode_ == "downloads") {
+    state.Set("downloads", pending_downloads_.Clone());
+  }
+  overlay_web_contents()->GetWebUI()->CallJavascriptFunctionUnsafe(
+      "__violaHostReceive", base::Value("overlay:open"),
+      base::Value(std::move(state)));
+  if (pending_mode_ == "split" && pending_split_hint_) {
+    SendSplitHint();
+  }
+}
+
+void ViolaProductOverlayHostView::SendSplitHint() {
+  if (!pending_split_hint_) {
+    return;
+  }
+  base::DictValue state;
+  state.Set("x", pending_split_hint_->x());
+  state.Set("y", pending_split_hint_->y());
+  state.Set("width", pending_split_hint_->width());
+  state.Set("height", pending_split_hint_->height());
+  overlay_web_contents()->GetWebUI()->CallJavascriptFunctionUnsafe(
+      "__violaHostReceive", base::Value("split:hint"),
+      base::Value(std::move(state)));
+}
+
+BEGIN_METADATA(ViolaProductOverlayHostView)
+END_METADATA
