+    return result;
+  }
+  for (std::string_view key : kDeviceLocalBrowserSettingKeys) {
+    if (const base::Value *value = settings->Find(key)) {
+      result.Set(key, value->Clone());
+    }
+  }
+  return result;
+}
+
+void RestoreDeviceLocalBrowserSettings(const base::DictValue &local,
+                                       base::DictValue *organization) {
+  base::DictValue *settings = organization ? organization->FindDict("settings")
+                                           : nullptr;
+  if (!settings) {
+    return;
+  }
+  for (std::string_view key : kDeviceLocalBrowserSettingKeys) {
+    if (const base::Value *value = local.Find(key)) {
+      settings->Set(key, value->Clone());
+    } else {
+      settings->Remove(key);
+    }
+  }
+  *settings = SanitizeSettings(settings);
+}
+
+void RemoveDeviceLocalBrowserSettings(base::DictValue *organization) {
+  base::DictValue *settings = organization ? organization->FindDict("settings")
+                                           : nullptr;
+  if (!settings) {
+    return;
+  }
+  for (std::string_view key : kDeviceLocalBrowserSettingKeys) {
+    settings->Remove(key);
+  }
+}
