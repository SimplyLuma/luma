+WEB_CONTENTS_USER_DATA_KEY_IMPL(ViolaBrowserToolThemeObserver);
+
+// The Chrome Web Store is the upstream extension catalogue Chromium supports.
+// Its install button is server-rendered with Chrome product copy. Keep the
+// trusted origin, install flow, and extension security UI untouched, but
+// replace only exact visible product phrases in an isolated world so the
+// supported catalogue describes the browser the user is actually running.
+class ViolaWebStoreBrandingObserver
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<ViolaWebStoreBrandingObserver> {
+public:
+  ~ViolaWebStoreBrandingObserver() override = default;
+
+private:
+  friend class content::WebContentsUserData<ViolaWebStoreBrandingObserver>;
+
+  explicit ViolaWebStoreBrandingObserver(content::WebContents *contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<ViolaWebStoreBrandingObserver>(*contents) {
+  }
+
+  void DidFinishNavigation(content::NavigationHandle *navigation) override {
+    if (navigation->HasCommitted() && navigation->IsInPrimaryMainFrame()) {
+      ApplyBranding();
+    }
+  }
+
+  void DocumentOnLoadCompletedInPrimaryMainFrame() override { ApplyBranding(); }
+
+  void ApplyBranding() {
+    const GURL &url = web_contents()->GetLastCommittedURL();
+    if (!url.SchemeIsCryptographic() ||
+        url.host() != "chromewebstore.google.com") {
+      return;
+    }
+    content::RenderFrameHost *frame = web_contents()->GetPrimaryMainFrame();
+    if (!frame) {
+      return;
+    }
+    frame->ExecuteJavaScriptInIsolatedWorld(uR"JS((() => {
+          const replacements = new Map([
+            ['Add to Chrome', 'Add to Viola'],
+            ['Remove from Chrome', 'Remove from Viola'],
+            ['Available on Chrome', 'Available on Viola'],
+            ['Open in Chrome', 'Open in Viola'],
+          ]);
+          const clean = (root) => {
+            if (!root) return;
+            const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+            let node;
+            while ((node = walker.nextNode())) {
+              const value = node.nodeValue?.trim();
+              if (replacements.has(value)) {
+                node.nodeValue = node.nodeValue.replace(value,
+                                                        replacements.get(value));
+              }
+            }
+            for (const element of root.querySelectorAll?.('*') || []) {
+              if (element.shadowRoot) clean(element.shadowRoot);
+            }
+          };
+          clean(document);
+          if (!window.__violaStoreBrandObserver) {
+            window.__violaStoreBrandObserver = new MutationObserver(() =>
+              clean(document));
+            window.__violaStoreBrandObserver.observe(document, {
+              childList:true, subtree:true, characterData:true,
+            });
+          }
+          return true;
+        })())JS",
+                                            base::DoNothing(),
+                                            kViolaStoreBrandingWorldId);
+  }
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ViolaWebStoreBrandingObserver);
+
+void AttachViolaWebStoreBranding(TabStripModel *tab_strip) {
+  if (!tab_strip) {
+    return;
+  }
+  for (int index = 0; index < tab_strip->count(); ++index) {
+    content::WebContents *contents = tab_strip->GetWebContentsAt(index);
+    if (contents) {
+      ViolaWebStoreBrandingObserver::CreateForWebContents(contents);
+    }
+  }
+}
