+
+#include "chrome/browser/ui/views/viola/viola_mini_window.h"
+
+#include <memory>
+
+#include "base/command_line.h"
+#include "build/build_config.h"
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
