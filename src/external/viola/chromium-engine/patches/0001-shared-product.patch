+IN_PROC_BROWSER_TEST_F(ViolaPeerRestoreBrowserTest,
+                       RebindsEveryRestoredWindowBeforeMaterializing) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("about:blank")));
+  Browser* peer = CreateBrowser(browser()->profile());
+  ASSERT_EQ(1, peer->tab_strip_model()->count());
+  // An additional unbound bootstrap blank must not become a third saved tab.
+  chrome::AddTabAt(peer, GURL("chrome://newtab/"), -1, true);
+  ASSERT_EQ(2, peer->tab_strip_model()->count());
+  auto* store = viola::ViolaOrganizationStore::Get(browser()->profile());
+  base::test::TestFuture<void> loaded;
+  store->EnsureLoaded(loaded.GetCallback());
+  ASSERT_TRUE(loaded.Wait());
+  ASSERT_FALSE(store->materialized_once());
+  ASSERT_TRUE(store->TabIdFor(peer->tab_strip_model()->GetActiveWebContents()).empty());
+
+  store->ReconcileAndMaterialize(browser(), browser()->tab_strip_model());
+  store->Reconcile(peer->tab_strip_model());
+  EXPECT_EQ(1, browser()->tab_strip_model()->count());
+  EXPECT_EQ(1, peer->tab_strip_model()->count());
+  const std::set<std::string> expected = {"restored-tab", "restored-peer"};
+  EXPECT_EQ(expected, (std::set<std::string>{
+      store->TabIdFor(browser()->tab_strip_model()->GetActiveWebContents()),
+      store->TabIdFor(peer->tab_strip_model()->GetActiveWebContents())}));
+
+  // Later window initialization must remain idempotent in either order.
+  store->ReconcileAndMaterialize(peer, peer->tab_strip_model());
+  store->ReconcileAndMaterialize(browser(), browser()->tab_strip_model());
+  EXPECT_EQ(1, browser()->tab_strip_model()->count());
+  EXPECT_EQ(1, peer->tab_strip_model()->count());
+  auto exported = store->ExportOrganizationForSync();
+  EXPECT_EQ(2u, (*exported.FindList("spaces"))[0]
+                    .GetDict().FindList("today")->size());
+}
