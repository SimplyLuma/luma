+  }
+
+  function renderHistory() {
+    const q = query.trim().toLowerCase();
+    if (!q && !domain && data.openTabs.length) {
+      const open = [...data.openTabs].sort((a,b) => Number(b.active)-Number(a.active) || b.last-a.last).slice(0,8);
