+#include "services/network/public/mojom/content_security_policy.mojom.h"
+#include "ui/webui/webui_util.h"
+
+ViolaUI::ViolaUI(content::WebUI *web_ui)
+    : TopChromeWebUIController(web_ui, /*enable_chrome_send=*/true) {
+  Profile *profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource *source =
+      content::WebUIDataSource::CreateAndAdd(profile, "viola");
+  webui::SetupWebUIDataSource(source, kViolaResources, IDR_VIOLA_SIDEBAR_HTML);
+  // Chromium WebUI supplies the response CSP, so the documents' meta policy
+  // cannot authorize their own audited inline blocks. Carry only the exact
+  // dimmer.html, overlay.html, and settings.html hashes into the trusted
+  // origin policy.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ScriptSrc,
+      "script-src chrome://resources chrome://webui-test 'self' "
+      "'sha256-9h6hsN2svoW3nhhmlT98jEH6WKNEbGiR4HqmculfB1I=' "
+      "'sha256-sUV5WgiFw50jJ8cenNIPndyhVgFY2EYizPmHrH2b6HU=' "
+      "'sha256-BeZmG8VK44nW87FNRug9B6jD+Wsh/LN1N1XBTcuV6d0=';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::TrustedTypes,
+      base::StrCat({webui::kDefaultTrustedTypesPolicies, " viola-static;"}));
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ImgSrc,
+      "img-src chrome://resources chrome://theme chrome://favicon2 "
+      "chrome://extension-icon chrome://image 'self' data: blob:;");
+  content::URLDataSource::Add(
+      profile, std::make_unique<FaviconSource>(
+                   profile, chrome::FaviconUrlFormat::kFavicon2));
+  content::URLDataSource::Add(
+      profile, std::make_unique<extensions::ExtensionIconSource>(profile));
+  content::URLDataSource::Add(profile,
+                              std::make_unique<SanitizedImageSource>(profile));
+  auto handler = std::make_unique<ViolaMessageHandler>();
+  message_handler_ = handler.get();
+  web_ui->AddMessageHandler(std::move(handler));
+}
+
+ViolaUI::~ViolaUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(ViolaUI)
