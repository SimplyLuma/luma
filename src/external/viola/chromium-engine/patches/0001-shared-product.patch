+void ViolaMessageHandler::ShowTabContextMenu(
+    std::string tab_id,
+    std::string section,
+    std::vector<std::string> selected_tab_ids) {
+  if (!organization_store_ || !organization_store_->loaded() ||
+      !IsJavascriptAllowed() || CurrentSurface() != "sidebar.html") {
+    return;
+  }
+  std::optional<viola::TabContextMenuState> state =
+      organization_store_->GetTabContextMenuState(tab_id);
+  if (!state || state->section != section) {
+    return;
+  }
+
+  if (context_menu_runner_) {
+    context_menu_runner_->Cancel();
+  }
+  context_menu_runner_.reset();
+  // Destroy consumers before replacing the model they retain.
+  context_menu_runner_.reset();
+  context_menu_adapter_.reset();
+  context_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  context_submenu_models_.clear();
+  context_menu_workspace_targets_.clear();
+  tab_group_context_menu_state_.reset();
+  workspace_context_menu_id_.clear();
+  tabs_context_menu_ = false;
+  tab_context_menu_state_ = std::move(state);
+  tab_context_selected_ids_.clear();
+  if (section != "favorite" && selected_tab_ids.size() >= 2 &&
+      std::ranges::find(selected_tab_ids, tab_id) != selected_tab_ids.end()) {
+    for (const std::string &selected_id : selected_tab_ids) {
+      const std::optional<viola::TabContextMenuState> selected_state =
+          organization_store_->GetTabContextMenuState(selected_id);
+      if (!selected_state || selected_state->space_id !=
+                                 tab_context_menu_state_->space_id ||
+          selected_state->section != section) {
+        tab_context_selected_ids_.clear();
+        break;
+      }
+      tab_context_selected_ids_.push_back(selected_id);
+    }
+  }
+
+  TabStripModel *tab_strip = GetProductTabStrip();
+  const int live_index = tab_strip ? organization_store_->FindTabIndex(
+                                         tab_strip, tab_context_menu_state_->tab_id)
+                                   : TabStripModel::kNoTab;
+  content::WebContents *contents = live_index == TabStripModel::kNoTab
+                                       ? nullptr
+                                       : tab_strip->GetWebContentsAt(live_index);
+  std::u16string title = contents && !contents->GetTitle().empty()
+                             ? contents->GetTitle()
+                             : base::UTF8ToUTF16(tab_context_menu_state_->url);
+  context_menu_model_->AddTitle(base::ToUpperASCII(title));
+  context_menu_model_->AddItem(kTabReload, u"Reload");
+  context_menu_model_->AddItem(kTabReloadWithoutCache, u"Reload without cache");
+  context_menu_model_->AddItem(kTabCopyLink, u"Copy link");
+  context_menu_model_->AddItem(kTabDuplicate, u"Duplicate");
+  context_menu_model_->AddSeparator(ui::SPACING_SEPARATOR);
+  if (section == "favorite") {
+    context_menu_model_->AddItem(kTabToggleFavorite, u"Remove from Favorites");
+  } else {
+    context_menu_model_->AddItem(
+        kTabTogglePinned, section == "pinned" ? u"Unpin tab" : u"Pin tab");
+    context_menu_model_->AddItem(kTabToggleFavorite, u"Add to Favorites");
+  }
+  context_menu_model_->AddSeparator(ui::SPACING_SEPARATOR);
+  context_menu_model_->AddCheckItem(kTabMute, u"Mute tab");
+  context_menu_model_->AddCheckItem(kTabKeepActive, u"Keep active");
+  context_menu_model_->AddCheckItem(kTabMiniPlayerExcluded,
+                                    u"Never show in mini player");
+  if (section != "favorite") {
+    context_menu_model_->AddSeparator(ui::SPACING_SEPARATOR);
+    if (!tab_context_menu_state_->workspace_targets.empty()) {
+      auto submenu = std::make_unique<ui::SimpleMenuModel>(this);
+      int command = kWorkspaceCommandStart;
+      for (const viola::WorkspaceMenuTarget &target :
+           tab_context_menu_state_->workspace_targets) {
+        submenu->AddItem(command, base::UTF8ToUTF16(target.label));
+        context_menu_workspace_targets_[command] = target.id;
+        ++command;
+      }
+      context_menu_model_->AddSubMenu(kTabMoveWorkspaceSubmenu,
+                                      u"Move to workspace", submenu.get());
+      context_submenu_models_.push_back(std::move(submenu));
+    }
+    if (tab_context_menu_state_->in_split) {
+      context_menu_model_->AddItem(kTabRemoveFromSplit, u"Remove from split");
+      context_menu_model_->AddItem(kTabDissolveSplit, u"Dissolve split");
+    } else if (tab_context_menu_state_->group_id.empty()) {
+      context_menu_model_->AddItem(
+          kTabCreateGroup,
+          tab_context_selected_ids_.size() >= 2
+              ? base::UTF8ToUTF16(base::StringPrintf(
+                    "Create tab group from %zu tabs",
+                    tab_context_selected_ids_.size()))
+              : u"New tab group");
+    } else {
+      context_menu_model_->AddItem(kTabRemoveFromGroup, u"Remove from tab group");
+      context_menu_model_->AddItem(kTabDissolveGroup, u"Dissolve tab group");
+    }
+  }
+  context_menu_model_->AddSeparator(ui::SPACING_SEPARATOR);
+  context_menu_model_->AddItem(kTabClose, u"Close tab");
+  context_menu_model_->AddItem(kTabCloseOther, u"Close other tabs");
+  if (section != "favorite") {
+    context_menu_model_->AddItem(kTabCloseBelow, u"Close tabs below");
+  }
+  RunContextMenu();
+}
