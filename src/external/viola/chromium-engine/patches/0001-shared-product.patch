+IN_PROC_BROWSER_TEST_F(ViolaUIBrowserTest,
+                       UnwrapsCrossPlatformPasswordSyncKey) {
+  base::DictValue envelope;
+  envelope.Set("version", 1);
+  envelope.Set("kdf", "pbkdf2-sha256");
+  envelope.Set("iterations", 310000);
+  envelope.Set("cipher", "aes-256-gcm");
+  envelope.Set("salt", "EBESExQVFhcYGRobHB0eHw==");
+  envelope.Set("iv", "QEFCQ0RFRkdISUpL");
+  envelope.Set("tag", "tM6B1YGAvc+SYR/veEW/Cg==");
+  envelope.Set("ciphertext", "1LBsBWzzfOZDuA/cvY+oPL7mvrL7jRDBW/eUXy2dMSg=");
+  std::optional<std::vector<uint8_t>> key =
+      viola::ViolaAccountSyncService::UnwrapSyncKeyForTesting(
+          "cross-platform sync password", envelope);
