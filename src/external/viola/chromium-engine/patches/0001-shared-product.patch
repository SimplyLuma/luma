+    NSButton* const button = [window standardWindowButton:button_type];
+    if (!button) {
+      continue;
+    }
+    const bool visible = !GetBrowserView()->IsFullscreen() &&
+                         shell->sidebar_effectively_visible();
+    [button setHidden:!visible];
+    NSView* const superview = button.superview;
+    if (!visible || !superview) {
+      continue;
+    }
+    NSRect frame = button.frame;
+    const NSRect superview_bounds = superview.bounds;
+    const CGFloat target_top =
+        kViolaTitlebarCenter - NSHeight(frame) / 2;
+    frame.origin.y = superview.isFlipped
+                         ? target_top
+                         : NSHeight(superview_bounds) - target_top -
+                               NSHeight(frame);
+    [button setFrameOrigin:frame.origin];
+  }
