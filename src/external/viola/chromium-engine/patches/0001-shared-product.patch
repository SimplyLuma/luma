+bool ViolaOrganizationStore::ActivateTab(std::string_view tab_id,
+                                         BrowserWindowInterface *browser,
+                                         TabStripModel *tab_strip) {
+  if (!loaded_ || !browser || !tab_strip || tab_id.empty() ||
+      !FindPersistentTab(organization_, tab_id)) {
+    return false;
+  }
+  int index = FindTabIndex(tab_strip, tab_id);
+  if (index == TabStripModel::kNoTab) {
+    if (std::optional<std::string> owner =
+            SpaceIdForTab(organization_, tab_id)) {
+      const bool preserve_all = workspace_lens_id_ == kAllWorkspacesId;
+      organization_.Set("activeSpaceId", *owner);
+      workspace_lens_id_ = *owner;
+      MaterializeWorkspace(*owner, browser, tab_strip);
+      if (preserve_all) {
+        workspace_lens_id_ = kAllWorkspacesId;
+      }
+      index = FindTabIndex(tab_strip, tab_id);
+    }
+  }
+  if (index == TabStripModel::kNoTab) {
+    return false;
+  }
+  tab_strip->ActivateTabAt(
+      index, TabStripUserGestureDetails(
+                 TabStripUserGestureDetails::GestureType::kMouse));
+  ScheduleWrite();
+  return true;
+}
+
+bool ViolaOrganizationStore::SwitchWorkspace(std::string_view space_id,
+                                             BrowserWindowInterface *browser,
+                                             TabStripModel *tab_strip) {
+  if (!loaded_ || !browser || !tab_strip) {
+    return false;
+  }
+  if (space_id == kAllWorkspacesId) {
+    workspace_lens_id_ = kAllWorkspacesId;
+    return true;
+  }
+  base::DictValue *space = FindSpace(organization_, space_id);
+  if (!space) {
+    return false;
+  }
+  organization_.Set("activeSpaceId", space_id);
+  workspace_lens_id_ = std::string(space_id);
+  MaterializeWorkspace(space_id, browser, tab_strip);
+  const std::string active = StringOr(space, "activeTabId");
+  const int index = FindTabIndex(tab_strip, active);
+  if (index != TabStripModel::kNoTab) {
+    tab_strip->ActivateTabAt(
+        index, TabStripUserGestureDetails(
+                   TabStripUserGestureDetails::GestureType::kMouse));
+  }
+  ScheduleWrite();
+  return true;
+}
