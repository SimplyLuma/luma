+void ViolaMessageHandler::HandleTabMenu(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() < 2 ||
+      payload.GetDict().size() > 3 ||
+      !organization_store_ || !organization_store_->loaded()) {
+    return;
+  }
+  const base::DictValue &request = payload.GetDict();
+  const std::string *tab_id = request.FindString("tabId");
+  const std::string *section = request.FindString("section");
+  if (!tab_id || !section || tab_id->empty() ||
+      (*section != "favorite" && *section != "pinned" && *section != "today")) {
+    return;
+  }
+  std::vector<std::string> selected_tab_ids;
+  if (const base::ListValue *values = request.FindList("selectedTabIds")) {
+    if (values->size() > 100) {
+      return;
+    }
+    std::set<std::string> unique;
+    for (const base::Value &value : *values) {
+      const std::string *selected_id = value.GetIfString();
+      if (!selected_id || selected_id->empty() ||
+          !unique.insert(*selected_id).second) {
+        return;
+      }
+      selected_tab_ids.push_back(*selected_id);
+    }
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ViolaMessageHandler::ShowTabContextMenu,
+                                weak_factory_.GetWeakPtr(), *tab_id, *section,
+                                std::move(selected_tab_ids)));
+}
