+    if(active.length){const sec=sectionBlock('Downloading',`${active.length} active`);const list=node('div','card-list');active.forEach((item)=>list.append(downloadRow(item)));sec.append(list);main.append(sec)}
+    if(finished.length){const sec=sectionBlock(q?'Search results':'Recent',`${finished.length} ${finished.length===1?'file':'files'}`);const list=node('div','card-list');finished.forEach((item)=>list.append(downloadRow(item)));sec.append(list);main.append(sec)}
+  }
+
+  function downloadRow(item) {
+    const row=node('div','row download-row');
