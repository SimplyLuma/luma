+std::optional<std::string>
+ViolaAccountSyncService::ProtectSecrets(base::span<const uint8_t> key,
+                                        std::string_view token) const {
+  if (!encryptor_ || !encryptor_->IsEncryptionAvailable() || key.size() != 32) {
+    return std::nullopt;
+  }
+  base::DictValue secrets;
+  secrets.Set("version", 1);
+  secrets.Set("key", base::Base64Encode(key));
+  secrets.Set("sessionToken", token);
+  std::string plaintext;
+  if (!base::JSONWriter::Write(secrets, &plaintext)) {
+    return std::nullopt;
+  }
+  std::optional<std::vector<uint8_t>> encrypted =
+      encryptor_->EncryptString(plaintext);
+  return encrypted ? std::optional<std::string>(base::Base64Encode(*encrypted))
+                   : std::nullopt;
+}
+
+std::optional<base::DictValue>
+ViolaAccountSyncService::UnprotectSecrets() const {
+  const std::string *protected_value = state_.FindString("protectedSecrets");
+  std::optional<std::vector<uint8_t>> encrypted =
+      protected_value ? base::Base64Decode(*protected_value) : std::nullopt;
+  if (!encryptor_ || !encrypted) {
+    return std::nullopt;
+  }
+  std::optional<std::string> plaintext = encryptor_->DecryptData(*encrypted);
+  std::optional<base::Value> parsed =
+      plaintext ? base::JSONReader::Read(*plaintext, base::JSON_PARSE_RFC)
+                : std::nullopt;
+  if (!parsed || !parsed->is_dict() ||
+      parsed->GetDict().FindInt("version") != 1) {
+    return std::nullopt;
+  }
+  return std::move(*parsed).TakeDict();
+}
