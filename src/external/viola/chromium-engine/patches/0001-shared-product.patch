+body.platform-linux.native-chromium #media-bar { display: flex; }
+body.platform-linux.native-chromium #notification-stack[hidden],
+body.platform-linux.native-chromium #media-bar[hidden] { display: none; }
+@container luma-sidebar (height < 700px) {
+  #media-preview, #media-preview-video { display: none !important; }
+}
+@container luma-sidebar (height < 560px) {
+  .notification-card { display: none !important; }
+}
