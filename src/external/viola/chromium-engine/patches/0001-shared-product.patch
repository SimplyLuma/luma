+// static
+ViolaOrganizationStore *ViolaOrganizationStore::Get(Profile *profile) {
+  if (!profile || profile->IsOffTheRecord()) {
+    return nullptr;
+  }
+  if (!profile->GetUserData(kProfileStoreKey)) {
+    profile->SetUserData(kProfileStoreKey,
+                         std::unique_ptr<ViolaOrganizationStore>(
+                             new ViolaOrganizationStore(profile)));
+  }
+  return static_cast<ViolaOrganizationStore *>(
+      profile->GetUserData(kProfileStoreKey));
+}
+
+ViolaOrganizationStore::ViolaOrganizationStore(Profile *profile)
+    : profile_(profile) {
+  const base::FilePath directory = profile->GetPath().AppendASCII("Viola");
+  native_path_ = directory.AppendASCII("organization-v1.json");
+  receipt_path_ = directory.AppendASCII("migration-receipt-v1.json");
+#if BUILDFLAG(IS_MAC)
+  base::FilePath home;
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "viola-disable-legacy-migration-for-testing") &&
+      base::PathService::Get(base::DIR_HOME, &home)) {
+    legacy_path_ = home.AppendASCII("Library")
+                       .AppendASCII("Application Support")
+                       .AppendASCII("Vela")
+                       .AppendASCII("vela-state.json");
+  }
+#elif BUILDFLAG(IS_LINUX)
+  base::FilePath home;
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "viola-disable-legacy-migration-for-testing") &&
+      base::PathService::Get(base::DIR_HOME, &home)) {
+    // Electron 0.1 used app.getPath("appData")/Vela. The public Linux build
+    // used the conventional ~/.config app-data root, so native Chromium can
+    // import workspaces without sharing Chromium's live profile database.
+    legacy_path_ = home.AppendASCII(".config")
+                       .AppendASCII("Vela")
+                       .AppendASCII("vela-state.json");
+  }
+#elif BUILDFLAG(IS_WIN)
+  base::FilePath roaming_app_data;
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "viola-disable-legacy-migration-for-testing") &&
+      base::PathService::Get(base::DIR_ROAMING_APP_DATA, &roaming_app_data)) {
+    // Electron 0.1 used app.getPath("appData")/Vela on Windows. Import only
+    // the bounded logical organization snapshot; Chromium profile databases,
+    // cookies, credentials, and extensions remain outside this migration.
+    legacy_path_ = roaming_app_data.AppendASCII("Vela")
+                       .AppendASCII("vela-state.json");
+  }
+#endif
+  session_restored_subscription_ =
+      SessionRestore::RegisterOnSessionRestoredCallback(base::BindRepeating(
+          &ViolaOrganizationStore::OnSessionRestored,
+          weak_factory_.GetWeakPtr()));
+  writer_ = std::make_unique<base::ImportantFileWriter>(
+      native_path_,
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE}),
+      base::Seconds(2), "ViolaOrganization");
+}
+
+ViolaOrganizationStore::~ViolaOrganizationStore() {
+  if (writer_ && writer_->HasPendingWrite()) {
+    writer_->DoScheduledWrite();
+  }
+}
