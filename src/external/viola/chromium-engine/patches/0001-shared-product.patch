+  <main id="main"></main>
+<script>
+  let data = { openTabs:[], history:[], bookmarks:[], downloads:[], downloadSummary:{} };
+  let section = 'history';
+  let query = '';
+  let domain = '';
+  let historyLimit = 250;
+
+  const main = document.querySelector('#main');
