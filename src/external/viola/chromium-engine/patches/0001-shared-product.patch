+void ViolaMessageHandler::OnViolaUpdateInstallStatusChanged(
+    viola::ViolaUpdateService::InstallStatus status) {
+  if (update_available_version_.empty()) {
+    return;
+  }
+  if (update_snoozed_version_ == update_available_version_ &&
+      base::Time::Now() < update_snoozed_until_) {
+    update_status_ = "reminding";
+  } else {
+    switch (status) {
+    case viola::ViolaUpdateService::InstallStatus::kDownloading:
+      update_status_ = "downloading";
+      break;
+    case viola::ViolaUpdateService::InstallStatus::kReady:
+      update_status_ = "ready";
+      break;
+    case viola::ViolaUpdateService::InstallStatus::kError:
+      // The platform installer can be retried from the same available card;
+      // discovery remains healthy even if the background transfer failed.
+      update_status_ = "available";
+      break;
+    case viola::ViolaUpdateService::InstallStatus::kAvailable:
+    case viola::ViolaUpdateService::InstallStatus::kUnavailable:
+      update_status_ = "available";
+      break;
+    }
+  }
+  if (CurrentSurface() == "sidebar.html" && IsJavascriptAllowed()) {
+    SendRenderState();
+  }
+}
