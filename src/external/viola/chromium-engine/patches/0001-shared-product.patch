+}
+.hover-card-members {
+  margin-top: 9px;
+  padding-top: 7px;
+  display: grid;
+  gap: 2px;
+  border-top: .5px solid color-mix(in srgb, var(--ink) 12%, transparent);
+}
+.hover-card-members-label {
+  margin-bottom: 2px;
+  font-size: 9.5px;
+  font-weight: 620;
+  opacity: .42;
+}
+.hover-card-member {
+  min-width: 0;
+  height: 22px;
+  padding: 0 4px;
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  border-radius: 6px;
+  font-size: 10.5px;
+  font-weight: 540;
+}
+.hover-card-member-icon {
+  width: 14px;
+  height: 14px;
+  flex: 0 0 14px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  overflow: hidden;
+  border-radius: 4px;
+  background: color-mix(in srgb, var(--accent) 15%, rgba(255, 255, 255, .5));
+  font-size: 8px;
+  font-weight: 700;
+}
+.hover-card-member-icon img { width: 12px; height: 12px; object-fit: contain; }
+.hover-card-member-title {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.hover-card-member-elsewhere {
+  width: 12px;
+  height: 12px;
+  flex: 0 0 12px;
+  display: block;
+  opacity: .4;
+}
+.hover-card-member-elsewhere svg { display: block; width: 12px; height: 12px; }
+.hover-card-more {
+  padding: 2px 4px 0 21px;
+  font-size: 9.5px;
+  font-weight: 600;
+  opacity: .44;
+}
+.hover-card-statuses {
+  margin-top: 9px;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 5px;
+}
+.hover-card-status {
+  min-height: 20px;
+  padding: 4px 7px;
+  display: inline-flex;
+  align-items: center;
+  border-radius: 999px;
+  color: color-mix(in srgb, var(--ink) 78%, var(--accent));
+  background: color-mix(in srgb, var(--accent) 9%, rgba(255, 255, 255, .38));
+  box-shadow: inset 0 0 0 .55px color-mix(in srgb, var(--accent) 14%, transparent);
+  font-size: 9px;
+  font-weight: 670;
+  line-height: 1;
+}
+.hover-card-foot {
+  margin-top: 8px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  font-size: 9.5px;
+  font-weight: 540;
+  line-height: 1.25;
+  opacity: .42;
+}
+.hover-card-foot:empty { display: none; }
+
+@media (prefers-reduced-motion: reduce) {
+  #tab-hover-card { transition: none; }
+  *, *::before, *::after {
+    scroll-behavior: auto !important;
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+  }
+}
+
+:focus-visible {
+  outline: 2px solid color-mix(in srgb, var(--accent) 88%, white);
+  outline-offset: 2px;
+}
+
+/* ---- split view chrome ---- */
+#pane-ring {
+  position: fixed;
+  z-index: 30;
+  border: 2.5px solid color-mix(in srgb, var(--accent) 85%, transparent);
+  border-radius: 12px;
+  pointer-events: none;
+  transition: left 0.18s ease, top 0.18s ease, width 0.18s ease, height 0.18s ease;
+}
+#pane-ring[hidden] { display: none; }
+.divider {
+  position: fixed;
+  z-index: 40;
+  border-radius: 3px;
+  transition: background 0.12s ease;
+}
+.divider.h { cursor: col-resize; }
+.divider.v { cursor: row-resize; }
+.divider:hover,
+.divider.dragging {
+  background: color-mix(in srgb, var(--ink) 28%, transparent);
+}
+
+/* ---- empty space hint ---- */
+#empty-hint {
+  position: fixed;
+  top: 50%;
+  left: calc(var(--sw) + (100vw - var(--sw)) / 2);
+  transform: translate(-50%, -50%);
+  text-align: center;
+  color: var(--ink);
+  opacity: 0.4;
+  font-size: 14px;
+  font-weight: 500;
+  pointer-events: none;
+}
+body.side-right #empty-hint { left: calc((100vw - var(--sw)) / 2); }
+body.collapsed #empty-hint { left: 50vw; }
+#empty-hint .big {
+  font-size: 30px;
+  font-weight: 800;
+  letter-spacing: 1px;
+  margin-bottom: 8px;
+}
+
+/* ---- toast ---- */
+#toast {
+  position: fixed;
+  bottom: 52px;
+  left: calc(var(--sw) / 2);
+  transform: translateX(-50%);
+  background: rgba(20, 20, 30, 0.85);
+  color: #fff;
+  font-size: 12px;
+  font-weight: 500;
+  padding: 7px 14px;
+  border-radius: 999px;
+  z-index: 200;
+  animation: toast-in 0.18s ease;
+}
+body.side-right #toast { left: auto; right: calc(var(--sw) / 2); transform: translateX(50%); }
+@keyframes toast-in { from { opacity: 0; transform: translateX(-50%) translateY(6px); } }
+
+.dragging-tab { opacity: 0.4; }
+.tab-group.dragging-group { opacity: 0.4; }
