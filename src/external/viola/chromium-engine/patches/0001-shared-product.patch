+TabStripModel *ViolaMessageHandler::GetProductTabStrip() {
+  content::WebContents *shell_contents = web_ui()->GetWebContents();
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(shell_contents);
+  if (!browser) {
+    return nullptr;
