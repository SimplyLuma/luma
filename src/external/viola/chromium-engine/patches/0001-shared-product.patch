+#include "chrome/browser/ui/browser_window/public/browser_collection.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
+#include "chrome/browser/ui/webui/viola/viola_platform.h"
+#include "content/public/browser/storage_partition.h"
+#include "net/base/load_flags.h"
+#include "net/http/http_request_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "services/network/public/mojom/url_loader_factory.mojom.h"
+#include "ui/base/idle/idle.h"
+#include "url/gurl.h"
+
+namespace viola {
+namespace {
+
+constexpr char kProfileServiceKey[] = "viola-usage-telemetry";
+constexpr char kStateType[] = "viola-native-usage-telemetry";
+constexpr int kStateVersion = 1;
+constexpr char kEndpoint[] = "https://api.violabrowser.com/v1/telemetry";
+constexpr size_t kMaximumStateBytes = 32 * 1024;
+constexpr size_t kMaximumResponseBytes = 8 * 1024;
+constexpr base::TimeDelta kHeartbeatInterval = base::Minutes(1);
+
+std::string ReportingDay() {
+  base::Time::Exploded exploded;
+  base::Time::Now().UTCExplode(&exploded);
+  return base::StringPrintf("%04d-%02d-%02d", exploded.year, exploded.month,
+                            exploded.day_of_month);
+}
+
+bool IsUuid(const std::string* value) {
+  return value && base::Uuid::ParseLowercase(*value).is_valid();
+}
+
+std::string StringOrEmpty(const base::DictValue& value,
+                          std::string_view key) {
+  const std::string* found = value.FindString(key);
+  return found ? *found : std::string();
+}
+
+base::DictValue DefaultState() {
+  base::DictValue state;
+  state.Set("type", kStateType);
+  state.Set("version", kStateVersion);
+  state.Set("usageAnalyticsEnabled", true);
+  state.Set("installReported", false);
+  state.Set("installEventId", "");
+  state.Set("activeDay", "");
+  state.Set("activeReported", false);
+  state.Set("activeEventId", "");
+  state.Set("detailDay", "");
+  state.Set("reportId", "");
+  return state;
+}
+
+base::DictValue ParseNativeState(const base::FilePath& path) {
+  std::string source;
+  if (base::IsLink(path) ||
+      !base::ReadFileToStringWithMaxSize(path, &source, kMaximumStateBytes)) {
+    return {};
+  }
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(source, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return {};
+  }
+  base::DictValue candidate = std::move(*parsed).TakeDict();
+  if (StringOrEmpty(candidate, "type") != kStateType ||
+      candidate.FindInt("version") != kStateVersion) {
+    return {};
+  }
+  base::DictValue state = DefaultState();
+  state.Set("usageAnalyticsEnabled",
+            candidate.FindBool("usageAnalyticsEnabled").value_or(true));
+  state.Set("installReported",
+            candidate.FindBool("installReported").value_or(false));
+  if (IsUuid(candidate.FindString("installEventId"))) {
+    state.Set("installEventId", *candidate.FindString("installEventId"));
+  }
+  state.Set("activeDay", StringOrEmpty(candidate, "activeDay"));
+  state.Set("activeReported",
+            candidate.FindBool("activeReported").value_or(false));
+  if (IsUuid(candidate.FindString("activeEventId"))) {
+    state.Set("activeEventId", *candidate.FindString("activeEventId"));
+  }
+  state.Set("detailDay", StringOrEmpty(candidate, "detailDay"));
+  if (IsUuid(candidate.FindString("reportId"))) {
+    state.Set("reportId", *candidate.FindString("reportId"));
+  }
+  return state;
+}
+
+void ApplyLegacyState(base::DictValue& state,
+                      const base::FilePath& reporting_path,
+                      const base::FilePath& installation_id_path,
+                      const base::FilePath& organization_path) {
+  std::string source;
+  if (!base::IsLink(reporting_path) &&
+      base::ReadFileToStringWithMaxSize(reporting_path, &source,
+                                        kMaximumStateBytes)) {
+    std::optional<base::Value> parsed =
+        base::JSONReader::Read(source, base::JSON_PARSE_RFC);
+    if (parsed && parsed->is_dict()) {
+      const base::DictValue& legacy = parsed->GetDict();
+      state.Set("installReported",
+                legacy.FindBool("installReported").value_or(false));
+      if (IsUuid(legacy.FindString("installEventId"))) {
+        state.Set("installEventId", *legacy.FindString("installEventId"));
+      }
+      state.Set("activeDay", StringOrEmpty(legacy, "activeDay"));
+      state.Set("activeReported",
+                legacy.FindBool("activeReported").value_or(false));
+      if (IsUuid(legacy.FindString("activeEventId"))) {
+        state.Set("activeEventId", *legacy.FindString("activeEventId"));
+      }
+    }
+  }
+  std::string legacy_installation_id;
+  if (!state.FindBool("installReported").value_or(false) &&
+      !base::IsLink(installation_id_path) &&
+      base::ReadFileToStringWithMaxSize(installation_id_path,
+                                        &legacy_installation_id, 80)) {
+    base::TrimWhitespaceASCII(legacy_installation_id, base::TRIM_ALL,
+                              &legacy_installation_id);
+  }
+  if (!state.FindBool("installReported").value_or(false) &&
+      base::Uuid::ParseLowercase(legacy_installation_id).is_valid()) {
+    state.Set("installReported", true);
+    state.Set("installEventId", "");
+  }
+  source.clear();
+  if (!base::IsLink(organization_path) &&
+      base::ReadFileToStringWithMaxSize(organization_path, &source,
+                                        kMaximumStateBytes * 256)) {
+    std::optional<base::Value> parsed =
+        base::JSONReader::Read(source, base::JSON_PARSE_RFC);
+    const base::DictValue* settings =
+        parsed && parsed->is_dict() ? parsed->GetDict().FindDict("settings")
+                                    : nullptr;
+    if (settings && settings->FindBool("usageAnalyticsEnabled") == false) {
+      state.Set("usageAnalyticsEnabled", false);
+    }
+  }
+}
+
+}  // namespace
+
+struct ViolaUsageTelemetry::LoadResult {
+  base::DictValue state;
+};
+
+// static
+ViolaUsageTelemetry* ViolaUsageTelemetry::Get(Profile* profile) {
+  if (!profile || profile->IsOffTheRecord()) {
+    return nullptr;
+  }
+  if (!profile->GetUserData(kProfileServiceKey)) {
+    profile->SetUserData(
+        kProfileServiceKey,
+        std::unique_ptr<ViolaUsageTelemetry>(new ViolaUsageTelemetry(profile)));
+  }
+  return static_cast<ViolaUsageTelemetry*>(
+      profile->GetUserData(kProfileServiceKey));
+}
+
+ViolaUsageTelemetry::ViolaUsageTelemetry(Profile* profile)
+    : profile_(profile),
+      state_path_(profile->GetPath()
+                      .AppendASCII("Viola")
+                      .AppendASCII("usage-telemetry-v1.json")) {
+  base::FilePath legacy_root;
+#if BUILDFLAG(IS_MAC)
+  base::FilePath home;
+  if (base::PathService::Get(base::DIR_HOME, &home)) {
+    legacy_root = home.AppendASCII("Library")
+                      .AppendASCII("Application Support")
+                      .AppendASCII("Vela");
+  }
+#elif BUILDFLAG(IS_LINUX)
+  base::FilePath home;
+  if (base::PathService::Get(base::DIR_HOME, &home)) {
+    legacy_root = home.AppendASCII(".config").AppendASCII("Vela");
+  }
+#elif BUILDFLAG(IS_WIN)
+  base::PathService::Get(base::DIR_ROAMING_APP_DATA, &legacy_root);
+  if (!legacy_root.empty()) {
+    legacy_root = legacy_root.AppendASCII("Vela");
+  }
+#endif
+  if (!legacy_root.empty()) {
+    legacy_reporting_path_ = legacy_root.AppendASCII("Telemetry")
+                                 .AppendASCII("reporting-state.json");
+    legacy_installation_id_path_ =
+        legacy_root.AppendASCII("Telemetry").AppendASCII("installation-id");
+    legacy_organization_path_ = legacy_root.AppendASCII("vela-state.json");
+  }
+  writer_ = std::make_unique<base::ImportantFileWriter>(
+      state_path_,
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE}),
+      base::Seconds(2), "ViolaUsageTelemetry");
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&ViolaUsageTelemetry::LoadOnBackgroundSequence,
+                     state_path_, legacy_reporting_path_,
+                     legacy_installation_id_path_, legacy_organization_path_),
+      base::BindOnce(&ViolaUsageTelemetry::OnLoaded,
+                     weak_factory_.GetWeakPtr()));
+}
+
+ViolaUsageTelemetry::~ViolaUsageTelemetry() {
+  heartbeat_timer_.Stop();
+  loaders_.clear();
+  if (writer_ && writer_->HasPendingWrite()) {
+    writer_->DoScheduledWrite();
+  }
+}
+
+// static
+ViolaUsageTelemetry::LoadResult
+ViolaUsageTelemetry::LoadOnBackgroundSequence(
+    base::FilePath native_path,
+    base::FilePath legacy_reporting_path,
+    base::FilePath legacy_installation_id_path,
+    base::FilePath legacy_organization_path) {
+  base::DictValue state = ParseNativeState(native_path);
+  if (state.empty()) {
+    state = DefaultState();
+    ApplyLegacyState(state, legacy_reporting_path, legacy_installation_id_path,
+                     legacy_organization_path);
+    std::string serialized;
+    if (base::JSONWriter::WriteWithOptions(
+            state, base::JSONWriter::OPTIONS_PRETTY_PRINT, &serialized) &&
+        base::CreateDirectory(native_path.DirName())) {
+      base::ImportantFileWriter::WriteFileAtomically(
+          native_path, serialized, "ViolaUsageTelemetry");
+    }
+  }
+  return {.state = std::move(state)};
+}
+
+void ViolaUsageTelemetry::OnLoaded(LoadResult result) {
+  state_ = std::move(result.state);
+  loaded_ = true;
+  std::vector<base::OnceClosure> callbacks = std::move(loaded_callbacks_);
+  loaded_callbacks_.clear();
+  for (base::OnceClosure& callback : callbacks) {
+    std::move(callback).Run();
+  }
+  if (start_requested_) {
+    BeginReporting();
+  }
+}
+
+void ViolaUsageTelemetry::Start(std::string app_version) {
+  if (!app_version.empty()) {
+    app_version_ = std::move(app_version);
+  }
+  start_requested_ = true;
+  if (loaded_) {
+    BeginReporting();
+  }
+}
+
+void ViolaUsageTelemetry::EnsureLoaded(base::OnceClosure callback) {
+  if (loaded_) {
+    std::move(callback).Run();
+    return;
+  }
+  loaded_callbacks_.push_back(std::move(callback));
+}
+
+void ViolaUsageTelemetry::BeginReporting() {
+  if (started_ || !loaded_ || app_version_.empty()) {
+    return;
+  }
+  started_ = true;
+  PrepareAndSendBasicEvents();
+  SendDetailed(/*launches=*/1, /*active_seconds=*/0);
+  heartbeat_timer_.Start(FROM_HERE, kHeartbeatInterval, this,
+                         &ViolaUsageTelemetry::Heartbeat);
+}
+
+bool ViolaUsageTelemetry::detailed_enabled() const {
+  return loaded_ ? state_.FindBool("usageAnalyticsEnabled").value_or(true)
+                 : true;
+}
+
+void ViolaUsageTelemetry::SetDetailedEnabled(bool enabled) {
+  if (!loaded_) {
+    EnsureLoaded(base::BindOnce(&ViolaUsageTelemetry::SetDetailedEnabled,
+                                weak_factory_.GetWeakPtr(), enabled));
+    return;
+  }
+  if (detailed_enabled() == enabled) {
+    return;
+  }
+  state_.Set("usageAnalyticsEnabled", enabled);
+  if (!enabled) {
+    state_.Set("detailDay", "");
+    state_.Set("reportId", "");
+  } else {
+    ReconcileDetailedIdentity();
+  }
+  ScheduleWrite();
+}
+
+void ViolaUsageTelemetry::ReconcileDetailedIdentity() {
+  if (!detailed_enabled()) {
+    if (!StringOrEmpty(state_, "detailDay").empty() ||
+        !StringOrEmpty(state_, "reportId").empty()) {
+      state_.Set("detailDay", "");
+      state_.Set("reportId", "");
+      ScheduleWrite();
+    }
+    return;
+  }
+  const std::string day = ReportingDay();
+  if (StringOrEmpty(state_, "detailDay") != day ||
+      !IsUuid(state_.FindString("reportId"))) {
+    state_.Set("detailDay", day);
+    state_.Set("reportId",
+               base::Uuid::GenerateRandomV4().AsLowercaseString());
+    ScheduleWrite();
+  }
+}
+
+void ViolaUsageTelemetry::PrepareAndSendBasicEvents() {
+  if (!loaded_) {
+    return;
+  }
+  bool changed = false;
+  if (!state_.FindBool("installReported").value_or(false) &&
+      !IsUuid(state_.FindString("installEventId"))) {
+    state_.Set("installEventId",
+               base::Uuid::GenerateRandomV4().AsLowercaseString());
+    changed = true;
+  }
+  const std::string day = ReportingDay();
+  if (StringOrEmpty(state_, "activeDay") != day) {
+    state_.Set("activeDay", day);
+    state_.Set("activeReported", false);
+    state_.Set("activeEventId",
+               base::Uuid::GenerateRandomV4().AsLowercaseString());
+    changed = true;
+  } else if (!state_.FindBool("activeReported").value_or(false) &&
+             !IsUuid(state_.FindString("activeEventId"))) {
+    state_.Set("activeEventId",
+               base::Uuid::GenerateRandomV4().AsLowercaseString());
+    changed = true;
+  }
+  if (changed) {
+    ScheduleWrite();
+  }
+  const std::string install_event_id =
+      StringOrEmpty(state_, "installEventId");
+  if (!state_.FindBool("installReported").value_or(false) &&
+      IsUuid(&install_event_id)) {
+    SendBasicEvent("install", install_event_id);
+  }
+  const std::string active_event_id = StringOrEmpty(state_, "activeEventId");
+  if (!state_.FindBool("activeReported").value_or(false) &&
+      IsUuid(&active_event_id)) {
+    SendBasicEvent("daily-active", active_event_id);
+  }
+}
+
+void ViolaUsageTelemetry::SendBasicEvent(std::string event,
+                                         std::string event_id) {
+  if (!basic_events_in_flight_.insert(event_id).second) {
+    return;
+  }
+  base::DictValue payload = Dimensions();
+  payload.Set("kind", "basic");
+  payload.Set("event", event);
+  payload.Set("eventId", event_id);
+  SendPayload(
+      std::move(payload),
+      base::BindOnce(&ViolaUsageTelemetry::OnBasicEventComplete,
+                     weak_factory_.GetWeakPtr(), std::move(event),
+                     std::move(event_id)));
+}
+
+void ViolaUsageTelemetry::SendDetailed(int launches, int active_seconds) {
+  if (!loaded_ || !detailed_enabled()) {
+    ReconcileDetailedIdentity();
+    return;
+  }
+  ReconcileDetailedIdentity();
+  const std::string report_id = StringOrEmpty(state_, "reportId");
+  if (!IsUuid(&report_id)) {
+    return;
+  }
+  base::DictValue payload = Dimensions();
+  payload.Set("kind", "detailed");
+  payload.Set("reportId", report_id);
+  payload.Set("launches", std::clamp(launches, 0, 10));
+  payload.Set("activeSeconds", std::clamp(active_seconds, 0, 300));
+  SendPayload(std::move(payload), base::DoNothing());
+}
+
+void ViolaUsageTelemetry::Heartbeat() {
+  PrepareAndSendBasicEvents();
+  if (HasFocusedActiveWindow() &&
+      ui::CalculateIdleState(60) == ui::IDLE_STATE_ACTIVE) {
+    SendDetailed(/*launches=*/0, /*active_seconds=*/60);
+  }
+}
+
+bool ViolaUsageTelemetry::HasFocusedActiveWindow() const {
+  if (!profile_) {
+    return false;
+  }
+  bool active = false;
+  ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+      [&active](BrowserWindowInterface* browser) {
+        if (browser && browser->IsActive()) {
+          active = true;
+          return false;
+        }
+        return true;
+      });
+  return active;
+}
+
+base::DictValue ViolaUsageTelemetry::Dimensions() const {
+  base::DictValue dimensions;
+  dimensions.Set("platform", kPlatformId);
+  dimensions.Set("osVersion", base::SysInfo::OperatingSystemVersion());
+  dimensions.Set("arch", base::SysInfo::OperatingSystemArchitecture());
+  dimensions.Set("appVersion", app_version_);
+  dimensions.Set("channel", "beta");
+  return dimensions;
+}
+
+void ViolaUsageTelemetry::SendPayload(base::DictValue payload,
+                                      RequestCallback callback) {
+  if (!profile_) {
+    std::move(callback).Run(false);
+    return;
+  }
+  std::string body;
+  if (!base::JSONWriter::Write(payload, &body) || body.size() > 8 * 1024) {
+    std::move(callback).Run(false);
+    return;
+  }
+  static constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+      net::DefineNetworkTrafficAnnotation("viola_usage_telemetry", R"(
+        semantics {
+          sender: "Viola usage telemetry"
+          description:
+            "Reports privacy-bounded first-party installation, daily-active, "
+            "launch, and focused-minute aggregates for Viola Pulse."
+          trigger:
+            "At launch, once per active day, and once per focused active "
+            "minute while optional usage analytics are enabled."
+          data:
+            "Random event or one-day report UUID, Viola version/channel, "
+            "operating-system family/version, architecture, launch count, "
+            "and active seconds. No browsing or account data."
+          destination: WEBSITE
+          internal { contacts { email: "privacy@violabrowser.com" } }
+          user_data { type: OTHER }
+          last_reviewed: "2026-08-10"
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Detailed launch and active-minute reporting can be disabled in "
+            "Viola Settings > Privacy. Event-scoped install and daily-active "
+            "counts contain no persistent identifier."
+          policy_exception_justification: "Not implemented."
+        })");
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(kEndpoint);
+  request->method = "POST";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  request->headers.SetHeader(net::HttpRequestHeaders::kContentType,
+                             "application/json");
+  std::unique_ptr<network::SimpleURLLoader> loader =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader->AttachStringForUpload(body, "application/json");
+  loader->SetAllowHttpErrorResults(true);
+  loader->SetTimeoutDuration(base::Seconds(10));
+  const int request_id = next_request_id_++;
+  network::SimpleURLLoader* loader_ptr = loader.get();
+  loaders_[request_id] = std::move(loader);
+  loader_ptr->DownloadToString(
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(&ViolaUsageTelemetry::OnRequestComplete,
+                     weak_factory_.GetWeakPtr(), request_id,
+                     std::move(callback)),
+      kMaximumResponseBytes);
+}
+
+void ViolaUsageTelemetry::OnRequestComplete(
+    int request_id,
+    RequestCallback callback,
+    std::optional<std::string> response_body) {
+  (void)response_body;
+  auto iterator = loaders_.find(request_id);
+  if (iterator == loaders_.end()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  std::unique_ptr<network::SimpleURLLoader> loader =
+      std::move(iterator->second);
+  loaders_.erase(iterator);
+  int response_code = 0;
+  if (loader->ResponseInfo() && loader->ResponseInfo()->headers) {
+    response_code = loader->ResponseInfo()->headers->response_code();
+  }
+  std::move(callback).Run(response_code >= 200 && response_code < 300);
+}
+
+void ViolaUsageTelemetry::OnBasicEventComplete(std::string event,
+                                               std::string event_id,
+                                               bool success) {
+  basic_events_in_flight_.erase(event_id);
+  if (!success || !loaded_) {
+    return;
+  }
+  if (event == "install" &&
+      StringOrEmpty(state_, "installEventId") == event_id) {
+    state_.Set("installReported", true);
+    state_.Set("installEventId", "");
+    ScheduleWrite();
+  } else if (event == "daily-active" &&
+             StringOrEmpty(state_, "activeEventId") == event_id) {
+    state_.Set("activeReported", true);
+    state_.Set("activeEventId", "");
+    ScheduleWrite();
+  }
+}
+
+void ViolaUsageTelemetry::ScheduleWrite() {
+  if (writer_) {
+    writer_->ScheduleWrite(this);
+  }
+}
+
+std::optional<std::string> ViolaUsageTelemetry::SerializeData() {
+  std::string serialized;
+  return base::JSONWriter::WriteWithOptions(
+             state_, base::JSONWriter::OPTIONS_PRETTY_PRINT, &serialized)
+             ? std::optional<std::string>(std::move(serialized))
+             : std::nullopt;
+}
+
+}  // namespace viola
