+  pointer-events: auto;
+  touch-action: none;
+  -webkit-app-region: no-drag;
+}
+.desktop-caption svg {
+  width: 14px;
+  height: 14px;
+  overflow: visible;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+.desktop-caption:hover {
+  background: rgba(20, 18, 28, .08);
+  opacity: 1;
+}
+.desktop-caption:active { background: rgba(20, 18, 28, .14); }
+.desktop-caption:focus-visible {
+  outline: 2px solid rgba(91, 91, 214, .88);
+  outline-offset: -2px;
+}
+.desktop-caption .restore-mark { display: none; }
+body.window-maximized .desktop-caption .maximize-mark { display: none; }
+body.window-maximized .desktop-caption .restore-mark { display: block; }
+body.platform-win32 .desktop-caption.close:hover {
+  color: #fff;
+  background: #c42b1c;
+}
+body.platform-win32 .desktop-caption.close:active {
+  color: #fff;
+  background: #a6251a;
+}
+body.platform-linux .desktop-caption {
+  margin: 1.5px;
+  width: 20px;
+  height: 20px;
+  border-radius: 10px;
+}
+body.platform-linux .desktop-caption svg { stroke-width: 1.35; }
+body.dark .desktop-caption:hover { background: rgba(255, 255, 255, .11); }
+body.dark .desktop-caption:active { background: rgba(255, 255, 255, .17); }
+body:not(.window-focused) #desktop-caption-controls { opacity: .38; }
+#lights-spacer {
+  width: 68px;
+  -webkit-app-region: drag;
+}
+body.side-right #lights-spacer { width: 0; }
+#nav-buttons {
+  margin-left: auto;
+  display: flex;
+  gap: 2px;
+  -webkit-app-region: drag;
+}
+#nav-buttons .icon-btn {
+  -webkit-app-region: no-drag;
+}
+
+.icon-btn {
+  border: none;
+  background: transparent;
+  color: var(--ink);
+  opacity: 0.62;
+  width: 26px;
+  height: 26px;
+  border-radius: 7px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  cursor: default;
+}
+.icon-btn svg { width: 16px; height: 16px; }
+#btn-settings svg { width: 17px; height: 17px; }
+.icon-btn:hover { background: var(--tint); opacity: 0.95; }
+.icon-btn:active { background: var(--tint-strong); }
+.icon-btn:disabled { opacity: 0.22; background: transparent; }
+
+/* ---- address bar ---- */
+#addressbar {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  height: 34px;
+  padding: 0 6px 0 10px;
+  border-radius: 10px;
+  background: var(--tint);
+  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
+  flex-shrink: 0;
+}
+#addressbar:hover { background: var(--tint-strong); }
+#addr-lock { width: 13px; height: 13px; opacity: 0.55; flex-shrink: 0; }
+#addr-text {
+  flex: 1;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-size: 12.5px;
+  font-weight: 500;
+  opacity: 0.85;
+}
+#addr-copy { display: none; }
+#addressbar:hover #addr-copy { display: inline-flex; }
+#addr-cast {
+  display: none;
+  flex: 0 0 26px;
+  color: var(--ink);
+  opacity: .68;
+}
+#addr-cast.casting { display: inline-flex; }
+#addr-cast.casting { color: var(--accent); opacity: 1; }
+#addr-cast:hover { opacity: .95; }
+#addr-protection {
+  flex: 0 0 26px;
+  color: var(--ink);
+  opacity: .68;
+}
+#addr-protection[hidden] { display: none; }
+#addr-protection:hover { opacity: .95; }
+#addr-protection .connection-warning-mark { display: none; }
+#addr-protection[data-connection="insecure"] {
+  color: #b84f3d;
+  opacity: .95;
+}
+#addr-protection[data-connection="insecure"] .connection-secure-mark { display: none; }
