--- /dev/null
+++ b/chrome/browser/resources/viola/sidebar-reorder.js
@@ -0,0 +1,69 @@
+(function initSidebarReorder(root, factory) {
+  const api = factory();
+  if (typeof module !== 'undefined' && module.exports) module.exports = api;
+  else root.ViolaSidebarReorder = api;
+})(typeof globalThis !== 'undefined' ? globalThis : this, () => {
+  // The unified sidebar is a presentation lens over several independently
+  // persisted workspace arrays. A drag therefore follows the item that began
+  // the gesture, never whichever workspace happens to back the active page.
+  function sourceSpaceIdForDrag({
+    tabId = null,
+    groupId = null,
+    tabs = [],
+    groups = [],
+    fallbackSpaceId = null,
+  } = {}) {
+    if (groupId) {
+      const group = (Array.isArray(groups) ? groups : [])
+        .find((candidate) => candidate && candidate.id === groupId);
+      if (group && (group.spaceId || group.sourceSpaceId)) {
+        return group.spaceId || group.sourceSpaceId;
+      }
+    }
+    if (tabId) {
+      const tab = (Array.isArray(tabs) ? tabs : [])
+        .find((candidate) => candidate && candidate.id === tabId);
+      if (tab && tab.sourceSpaceId) return tab.sourceSpaceId;
+    }
+    return fallbackSpaceId || null;
+  }
+
+  // Translate an aggregate visual anchor back into the dragged workspace's
+  // local backing array. Hidden peer-window entries intentionally remain in
+  // this calculation even though they do not participate in pointer geometry.
+  function storageInsertionIndex(entries, sourceSpaceId, beforeId, removedIds = []) {
+    const removed = new Set(removedIds);
+    const local = (Array.isArray(entries) ? entries : []).filter((entry) => (
+      entry && (!sourceSpaceId || entry.sourceSpaceId === sourceSpaceId)
+        && !removed.has(entry.id)
+    ));
+    if (!beforeId) return local.length;
+    const index = local.findIndex((entry) => entry.id === beforeId);
+    return index < 0 ? local.length : index;
+  }
+
+  // Find the DOM boundary immediately after one workspace's visible cohort.
+  // If that cohort is empty in the destination section, workspace ordering
+  // still gives the insertion marker a stable, non-cross-workspace home.
+  function cohortEndIndex(items, sourceSpaceId, workspaceOrder = []) {
+    const rows = Array.isArray(items) ? items : [];
+    let lastLocal = -1;
+    for (let index = 0; index < rows.length; index += 1) {
+      if (rows[index] && rows[index].sourceSpaceId === sourceSpaceId) {
+        lastLocal = index;
+      }
+    }
+    if (lastLocal >= 0) return lastLocal + 1;
+
+    const order = Array.isArray(workspaceOrder) ? workspaceOrder : [];
+    const sourceRank = order.indexOf(sourceSpaceId);
+    if (sourceRank < 0) return rows.length;
+    for (let index = 0; index < rows.length; index += 1) {
+      const rank = order.indexOf(rows[index] && rows[index].sourceSpaceId);
+      if (rank >= 0 && rank > sourceRank) return index;
+    }
+    return rows.length;
+  }
+
+  return { sourceSpaceIdForDrag, storageInsertionIndex, cohortEndIndex };
+});
diff --git a/chrome/browser/resources/viola/sidebar.css b/chrome/browser/resources/viola/sidebar.css
new file mode 100644
