+// would make this test lose a legitimate tab rather than repair restoration.
+class ViolaPeerRestoreBrowserTest : public ViolaPersistedOrganizationBrowserTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    ViolaPersistedOrganizationBrowserTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitch(viola::kDisableProductShellSwitch);
