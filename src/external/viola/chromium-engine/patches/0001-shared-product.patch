+          resolve(false);
+        } else {
+          setTimeout(check, 20);
+        }
+      };
+      check();
+    })
+  )")
+                  .ExtractBool());
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), second_url));
+  EXPECT_TRUE(content::EvalJs(shell_contents, R"(
+    new Promise((resolve) => {
+      const deadline = performance.now() + 5000;
+      const check = () => {
+        const row = document.querySelector('#today-list .tab.active');
+        if (row === window.__violaTrackedRow
