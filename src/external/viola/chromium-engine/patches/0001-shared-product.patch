index 0000000000000000000000000000000000000000..22585157192360f53a5abe0b806a4139e631f20f
--- /dev/null
+++ b/chrome/browser/resources/viola/settings-luma.css
@@ -0,0 +1,136 @@
+@import url('luma-tokens.css');
+@import url('settings-luma-tokens.css');
+
+/* Browser-owned settings content. Native frame/menu geometry stays in AppKit. */
+body.luma-settings {
+  color-scheme: light;
+  --ink: var(--luma-ink);
+  --muted: var(--luma-muted);
+  --accent: var(--luma-accent);
+  --canvas: var(--luma-content);
+  --card: var(--luma-island);
+  --hairline: var(--luma-border);
+  --soft-shadow: 0 1px 2px var(--luma-island-shadow);
+  --control-shadow: 0 1px 2px var(--luma-island-shadow);
+  font-family: var(--luma-font-family);
+  line-height: 1.45;
+  background: var(--canvas);
+  color: var(--ink);
+}
+body.luma-settings.dark { color-scheme: dark; }
+.luma-settings :is(p,.sub,.label,.page-intro,.library-copy,.recovery-key) { user-select:text; }
+.luma-settings :focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
+.luma-settings nav {
+  width:208px; padding:24px 12px; gap:4px;
+  background:var(--luma-window); border-right:1px solid var(--hairline);
+  overflow-y:auto; -webkit-app-region:no-drag;
+}
+.luma-settings .settings-brand { padding:0 12px 16px; font-size:16px; font-weight:700; }
+.luma-settings .nav-section { margin:18px 12px 4px; font-size:11px; color:var(--muted); font-weight:600; }
+.luma-settings nav .item { height:36px; min-height:36px; padding:8px 12px; opacity:1; color:var(--muted); border-radius:8px; }
+.luma-settings nav .item:hover { background:var(--luma-hover); color:var(--ink); }
+.luma-settings nav .item.active { background:var(--card); color:var(--ink); box-shadow:var(--soft-shadow),inset 0 0 0 1px var(--hairline); font-weight:650; }
+.luma-settings main { min-width:0; padding:32px clamp(20px,4vw,56px) 64px; scrollbar-gutter:stable; }
+.luma-settings main > * { max-width:840px; margin-left:auto; margin-right:auto; }
+.luma-settings h1 { font-size:24px; line-height:1.25; letter-spacing:-.4px; margin-bottom:12px; }
+.luma-settings h2 { margin-top:28px; margin-bottom:10px; font-size:13px; text-transform:none; letter-spacing:0; color:var(--ink); }
+.luma-settings .page-intro { margin-top:0; margin-bottom:24px; line-height:1.5; }
+.luma-settings .card { border-radius:var(--luma-radius-island); padding:0 16px; border:1px solid var(--hairline); background:var(--card); }
+.luma-settings .setting { min-height:64px; padding:14px 0; gap:24px; }
+.luma-settings .setting .label { font-weight:600; line-height:1.4; }
+.luma-settings .setting .sub { font-size:12px; line-height:1.5; margin-top:4px; max-width:480px; color:var(--muted); }
+.luma-settings :is(select,input[type=text],input[type=email],input[type=password],input[type=search]) {
+  min-height:36px; font:inherit; color:var(--ink); background-color:var(--luma-content);
+  border:1px solid var(--hairline); border-radius:8px; padding:7px 12px; box-shadow:none; min-width:0;
+}
+.luma-settings select { padding-right:32px; max-width:100%; }
+.luma-settings input::placeholder { color:var(--muted); }
+.luma-settings :is(input,select):focus { outline:2px solid var(--accent); outline-offset:1px; box-shadow:none; }
+.luma-settings button.action { min-height:36px; font:inherit; font-weight:600; border-radius:8px; padding:7px 13px; box-shadow:none; background:var(--luma-primary); color:var(--luma-primary-ink); }
+.luma-settings button.action:hover { filter:none; background:var(--luma-primary-hover); }
+.luma-settings button.action { border-color:var(--hairline); }
+.luma-settings .swatch { border:1px solid var(--hairline); box-shadow:none; }
+.luma-settings button.action.secondary { background:var(--luma-fill); color:var(--ink); border-color:var(--hairline); }
+.luma-settings button.action.secondary:hover { background:var(--luma-hover); }
+.luma-settings button.action.danger { background:transparent; color:var(--luma-destructive); border-color:var(--hairline); }
+.luma-settings button.action.danger:hover { background:color-mix(in srgb,var(--luma-destructive) 10%,transparent); }
+.luma-settings .seg { padding:3px; background:var(--luma-fill); border:1px solid var(--hairline); }
+.luma-settings .seg button { min-height:30px; color:var(--ink); opacity:1; }
+.luma-settings .seg button.on { background:var(--card); }
+.luma-settings .account-form { grid-template-columns:1fr; max-width:440px; gap:16px; padding:16px 0; }
+.luma-settings .account-form label { opacity:1; font-size:12px; font-weight:600; color:var(--ink); }
+.luma-settings .account-form input { color:var(--ink); }
+.luma-settings .account-form details summary { color:var(--muted); font-size:12px; }
+.luma-settings .account-form details label { margin-top:12px; }
+.luma-settings .account-actions { justify-content:flex-start; flex-wrap:wrap; padding:8px 0 20px; }
