+void ViolaMessageHandler::HandleSend(const base::ListValue &args) {
+  if (args.size() != 3 || !args[0].is_string() || !args[1].is_string() ||
+      !args[2].is_string()) {
+    return;
+  }
+
+  const std::string &declared_surface = args[0].GetString();
+  const std::string current_surface = CurrentSurface();
+  if (current_surface.empty() || declared_surface != current_surface) {
+    return;
+  }
+
+  const std::optional<viola::HostChannel> channel =
+      viola::ParseHostChannel(args[1].GetString());
+  if (!channel || !viola::IsHostChannelAllowed(
+                      current_surface, viola::HostTransport::kSend, *channel)) {
+    return;
+  }
+
+  const std::string &payload_json = args[2].GetString();
+  if (payload_json.size() > kMaximumPayloadBytes) {
+    return;
+  }
+  std::optional<base::Value> payload =
+      base::JSONReader::Read(payload_json, base::JSON_PARSE_RFC);
+  if (!payload) {
+    return;
+  }
+
+  switch (*channel) {
+  case viola::HostChannel::kUiReady:
+    AllowJavascript();
+    if (current_surface == "little.html") {
+      ObserveProductTabStrip();
+      SendMiniState();
+      web_ui()->CallJavascriptFunctionUnsafe(
+          "__violaHostReceive", base::Value("little:focus-input"),
+          base::Value(base::DictValue()));
+      return;
+    }
+    if (current_surface != "sidebar.html") {
+      if (viola::ViolaProductOverlayHostView *overlay_host =
+              GetProductOverlayHost()) {
+        overlay_host->MarkSurfaceReady(current_surface);
+      }
+      if (current_surface == "overlay.html") {
+        ObserveDownloads();
+        SendDownloadState();
+      }
+      return;
+    }
+    ObserveProductTabStrip();
+    ObserveDownloads();
+    SendWindowChromeState();
+    SendDownloadState();
+    EnsureOrganizationLoaded();
+    return;
+  case viola::HostChannel::kNavBack:
+  case viola::HostChannel::kNavForward:
+  case viola::HostChannel::kNavReload:
+    HandleActiveTabNavigation(*channel, *payload);
+    return;
+  case viola::HostChannel::kLittleBack:
+  case viola::HostChannel::kLittleForward:
+  case viola::HostChannel::kLittleReload:
+  case viola::HostChannel::kLittleNavigate:
+  case viola::HostChannel::kLittleCopy:
+  case viola::HostChannel::kLittleAdopt:
+    HandleMiniNavigation(*channel, *payload);
+    return;
+  case viola::HostChannel::kTabActivate:
+    HandleTabActivation(*payload);
+    return;
+  case viola::HostChannel::kTabBookmark: {
+    BrowserWindowInterface *browser =
+        webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+    if (current_surface == "sidebar.html" && payload->is_none() && browser) {
+      content::WebContents *active = GetActiveTabForMutation();
+      bookmarks::BookmarkModel *model =
+          BookmarkModelFactory::GetForBrowserContext(browser->GetProfile());
+      const GURL url = active ? active->GetVisibleURL() : GURL();
+      if (model && model->loaded() && url.is_valid()) {
+        if (const bookmarks::BookmarkNode *node =
+                model->GetMostRecentlyAddedUserNodeForURL(url)) {
+          model->Remove(node, bookmarks::metrics::BookmarkEditSource::kUser,
+                        FROM_HERE);
+        } else {
+          chrome::BookmarkCurrentTab(browser);
+        }
+        SendRenderState();
+      }
+    }
+    return;
+  }
+  case viola::HostChannel::kTabClose:
+    HandleTabClose(*payload);
+    return;
+  case viola::HostChannel::kTabRename:
+    HandleTabRename(*payload);
+    return;
+  case viola::HostChannel::kTabNew:
+    HandleNewTab(*payload);
+    return;
+  case viola::HostChannel::kTabToggleMute:
+    HandleTabToggleMute(*payload);
+    return;
+  case viola::HostChannel::kTabMenu:
+    HandleTabMenu(*payload);
+    return;
+  case viola::HostChannel::kAppMenu:
+    ShowApplicationMenu(*payload);
+    return;
+  case viola::HostChannel::kBrowserMenu:
+    ShowBrowserMenu(*payload);
+    return;
+  case viola::HostChannel::kSplitDragStart:
+    HandleSplitDragStart(*payload);
+    return;
+  case viola::HostChannel::kSplitDragEnd:
+    HandleSplitDragEnd(*payload);
+    return;
+  case viola::HostChannel::kTabDragDropped:
+    HandleTabDragDropped(*payload);
+    return;
+  case viola::HostChannel::kSpaceSwitch:
+    HandleWorkspaceSwitch(*payload);
+    return;
+  case viola::HostChannel::kSpaceCreate:
+    if (current_surface == "settings.html") {
+      // Settings uses the same explicit name/icon payload as the sidebar.
+      // A payload-less request is rejected by HandleWorkspaceCreate so no
+      // anonymous "New Space" can be created accidentally.
+      HandleWorkspaceCreate(*payload);
+      return;
+    }
+    HandleWorkspaceCreate(*payload);
+    return;
+  case viola::HostChannel::kSpaceDelete:
+    if (current_surface == "sidebar.html" ||
+        current_surface == "settings.html") {
+      HandleWorkspaceDelete(*payload);
+    }
+    return;
+  case viola::HostChannel::kSpaceUpdate:
+    if (current_surface == "settings.html") {
+      HandleWorkspaceUpdate(*payload);
+      web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
+                                             base::Value("settings:changed"),
+                                             base::Value(base::DictValue()));
+      return;
+    }
+    HandleWorkspaceUpdate(*payload);
+    return;
+  case viola::HostChannel::kSidebarCollapsedGroups:
+  case viola::HostChannel::kSidebarCollapsedWorkspaceSections:
+    HandleSidebarDisclosure(*channel, *payload);
+    return;
+  case viola::HostChannel::kSidebarDragStart:
+  case viola::HostChannel::kSidebarSetWidth:
+  case viola::HostChannel::kSidebarDragEnd:
+    HandleSidebarWidth(*channel, *payload);
+    return;
+  case viola::HostChannel::kSidebarModal:
+    HandleSidebarModal(*payload);
+    return;
+  case viola::HostChannel::kSidebarPeekStart:
+    HandleSidebarPeek(*payload);
+    return;
+  case viola::HostChannel::kSidebarToggle:
+    if (current_surface == "sidebar.html" && payload->is_none()) {
+      if (viola::ViolaProductShellView *shell = GetProductShellView()) {
+        shell->ToggleSidebarCollapsed();
+      }
+    }
+    return;
+  case viola::HostChannel::kTabMoveToSpace:
+    HandleTabMove(*payload, false);
+    return;
+  case viola::HostChannel::kTabReorder:
+    HandleTabMove(*payload, true);
+    return;
+  case viola::HostChannel::kTabGroupRename:
+    HandleTabGroupRename(*payload);
+    return;
+  case viola::HostChannel::kTabGroupClose:
+    HandleTabGroupClose(*payload);
+    return;
+  case viola::HostChannel::kTabGroupGroupTab:
+    HandleTabGroupGroupTab(*payload);
+    return;
+  case viola::HostChannel::kTabGroupReorder:
+    HandleTabGroupReorder(*payload);
+    return;
+  case viola::HostChannel::kTabGroupMoveToSpace:
+    HandleTabGroupMoveToSpace(*payload);
+    return;
+  case viola::HostChannel::kTabGroupOpenSaved:
+    HandleTabGroupOpenSaved(*payload);
+    return;
+  case viola::HostChannel::kTabGroupMenu:
+    HandleTabGroupMenu(*payload);
+    return;
+  case viola::HostChannel::kTabsMenu:
+    HandleTabsMenu(*payload);
+    return;
+  case viola::HostChannel::kTabsSelectionAction:
+    HandleTabsSelectionAction(*payload);
+    return;
+  case viola::HostChannel::kSpaceMenu:
+    HandleWorkspaceMenu(*payload);
+    return;
+  case viola::HostChannel::kSettingsOpen:
+  case viola::HostChannel::kDownloadManager:
+    HandleBrowserPage(*channel, *payload);
+    return;
+  case viola::HostChannel::kBrowserOpenPage:
+    HandleBoundedBrowserPage(*payload);
+    return;
+  case viola::HostChannel::kExtRemove:
+    HandleExtensionRemove(*payload);
+    return;
+  case viola::HostChannel::kExtOpenControl:
+    HandleExtensionControl(*payload);
+    return;
+  case viola::HostChannel::kDownloadCancel:
+  case viola::HostChannel::kDownloadClear:
+  case viola::HostChannel::kDownloadOpen:
+  case viola::HostChannel::kDownloadPause:
+  case viola::HostChannel::kDownloadRemove:
+  case viola::HostChannel::kDownloadResume:
+  case viola::HostChannel::kDownloadReveal:
+    HandleDownloadAction(*channel, *payload);
+    return;
+  case viola::HostChannel::kLibraryClearHistory:
+  case viola::HostChannel::kLibraryOpen:
+  case viola::HostChannel::kLibraryRemoveBookmark:
+  case viola::HostChannel::kLibraryRemoveHistory:
+  case viola::HostChannel::kLibraryUpdateBookmark:
+    HandleLibraryAction(*channel, *payload);
+    return;
+  case viola::HostChannel::kDownloadDragFile:
+  case viola::HostChannel::kNotificationClear:
+  case viola::HostChannel::kNotificationDismiss:
+  case viola::HostChannel::kNotificationMenu:
+  case viola::HostChannel::kNotificationOpen:
+    HandleNotificationAction(*channel, *payload);
+    return;
+  case viola::HostChannel::kPermissionRespond:
+    HandlePermissionResponse(*payload);
+    return;
+  case viola::HostChannel::kMediaMenu:
+  case viola::HostChannel::kMediaMute:
+  case viola::HostChannel::kMediaNext:
+  case viola::HostChannel::kMediaPip:
+  case viola::HostChannel::kMediaPlaypause:
+  case viola::HostChannel::kMediaPrev:
+  case viola::HostChannel::kMediaSeek:
+    HandleMediaAction(*channel, *payload);
+    return;
+  case viola::HostChannel::kProfileOpenManager:
+    if (current_surface == "settings.html" && payload->is_none()) {
+      ProfilePicker::Show(ProfilePicker::Params::FromEntryPoint(
+          ProfilePicker::EntryPoint::kProfileMenuManageProfiles));
+    }
+    return;
+  case viola::HostChannel::kSettingsSet:
+    HandleSettingsChange(*payload);
+    return;
+  case viola::HostChannel::kUrlCopy:
+    HandleCopyUrl(*payload);
+    return;
+#if BUILDFLAG(IS_LINUX)
+  case viola::HostChannel::kFindQuery:
+    HandleNativeFind(*payload);
+    return;
+  case viola::HostChannel::kFindClose:
+    if (current_surface == "overlay.html" && payload->is_none()) CloseNativeFind();
+    return;
+#endif
+  case viola::HostChannel::kPaletteOpen:
+    HandlePaletteOpen(*payload);
+    return;
+  case viola::HostChannel::kPaletteClose:
+  case viola::HostChannel::kOverlayBlurred:
+    HandlePaletteClose(*payload);
+    return;
+  case viola::HostChannel::kPaletteCommit:
+    HandlePaletteCommit(*payload);
+    return;
+  case viola::HostChannel::kWindowControl:
+    HandleWindowControl(*payload);
+    return;
+  default:
+    return;
+  }
+}
+
+void ViolaMessageHandler::HandleInvoke(const base::ListValue &args) {
+  if (args.size() != 4 || !args[0].is_string() || !args[1].is_string() ||
+      !args[2].is_int() || !args[3].is_string()) {
+    return;
+  }
+  const std::string current_surface = CurrentSurface();
+  if (current_surface.empty() || args[0].GetString() != current_surface) {
+    return;
+  }
+  const int request_id = args[2].GetInt();
+  const std::optional<viola::HostChannel> channel =
+      viola::ParseHostChannel(args[1].GetString());
+  if (request_id <= 0 || !channel ||
+      !viola::IsHostChannelAllowed(current_surface,
+                                   viola::HostTransport::kInvoke, *channel) ||
+      args[3].GetString().size() > kMaximumPayloadBytes) {
+    return;
+  }
+  std::optional<base::Value> payload =
+      base::JSONReader::Read(args[3].GetString(), base::JSON_PARSE_RFC);
+  if (!payload) {
+    ResolveInvoke(request_id, false, base::Value("Invalid request"));
+    return;
+  }
+  AllowJavascript();
+  if (*channel == viola::HostChannel::kPaletteQuery &&
+      current_surface == "overlay.html") {
+    HandlePaletteQuery(request_id, std::move(*payload));
+    return;
+  }
+  if (*channel == viola::HostChannel::kExtList &&
+      current_surface == "settings.html") {
+    HandleExtensionList(request_id, *payload);
+    return;
+  }
+  if (*channel == viola::HostChannel::kExtSetEnabled &&
+      current_surface == "settings.html") {
+    HandleExtensionSetEnabled(request_id, *payload);
+    return;
+  }
+  if (*channel == viola::HostChannel::kLibraryData &&
+      IsViolaLibrarySurface(current_surface)) {
+    HandleLibraryData(request_id, *payload);
+    return;
+  }
+  if (*channel == viola::HostChannel::kUpdatesCheck &&
+      current_surface == "settings.html" && payload->is_none()) {
+    CheckForUpdates(request_id);
+    return;
+  }
+  const bool account_request =
+      *channel == viola::HostChannel::kAccountContinueWithGoogle ||
+      *channel == viola::HostChannel::kAccountEmailComplete ||
+      *channel == viola::HostChannel::kAccountEmailResetLegacy ||
+      *channel == viola::HostChannel::kAccountEmailStart ||
+      *channel == viola::HostChannel::kAccountEmailVerify ||
+      *channel == viola::HostChannel::kAccountRemove ||
+      *channel == viola::HostChannel::kAccountUpdate;
+  if (account_request && current_surface == "settings.html") {
+    Profile *profile = GetActiveSettingsProfile();
+    viola::ViolaAccountSyncService *account_service =
+        viola::ViolaAccountSyncService::Get(profile);
+    if (!account_service) {
+      ResolveInvoke(request_id, false,
+                    base::Value("Viola account sync is unavailable"));
+      return;
+    }
+    account_service->EnsureLoaded(base::BindOnce(
+        &ViolaMessageHandler::OnAccountServiceReady, weak_factory_.GetWeakPtr(),
+        *channel, request_id, std::move(*payload)));
+    return;
+  }
+  if (*channel != viola::HostChannel::kSettingsData ||
+      current_surface != "settings.html" || !payload->is_none()) {
+    ResolveInvoke(request_id, false, base::Value("Unsupported request"));
+    return;
+  }
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  organization_store_ =
+      browser ? viola::ViolaOrganizationStore::Get(browser->GetProfile())
+              : nullptr;
+  if (!organization_store_) {
+    ResolveInvoke(request_id, false,
+                  base::Value("Viola settings are unavailable"));
+    return;
+  }
+  organization_store_->EnsureLoaded(
+      base::BindOnce(&ViolaMessageHandler::OnSettingsDataReady,
+                     weak_factory_.GetWeakPtr(), request_id));
+}
+
+void ViolaMessageHandler::HandleLibraryData(int request_id,
+                                            const base::Value &payload) {
+  if (!IsViolaLibrarySurface(CurrentSurface()) || !payload.is_none()) {
+    ResolveInvoke(request_id, false, base::Value("Invalid library request"));
+    return;
+  }
+  TabStripModel *tab_strip = GetActiveSettingsTabStrip();
+  Profile *profile = GetActiveSettingsProfile();
+  if (!tab_strip || !profile) {
+    ResolveInvoke(request_id, false, base::Value("Viola Library unavailable"));
+    return;
+  }
+
+  base::DictValue data;
+  base::ListValue open_tabs;
+  const double now =
+      static_cast<double>(base::Time::Now().InMillisecondsSinceUnixEpoch());
+  for (int index = 0; index < tab_strip->count(); ++index) {
+    tabs::TabInterface *tab = tab_strip->GetTabAtIndex(index);
+    content::WebContents *contents = tab ? tab->GetContents() : nullptr;
+    if (!tab || !contents) {
+      continue;
+    }
+    const GURL url = contents->GetVisibleURL();
+    base::DictValue row;
+    row.Set("id", StableTabId(*tab));
+    row.Set("title", contents->GetTitle().empty()
+                         ? url.spec()
+                         : base::UTF16ToUTF8(contents->GetTitle()));
+    row.Set("url", url.spec());
+    row.Set("active", index == tab_strip->active_index());
+    row.Set("last", now - static_cast<double>(index));
+    row.Set("favicon",
+            url.SchemeIsHTTPOrHTTPS()
+                ? base::StrCat({"chrome://favicon2/?size=32&scaleFactor=1x&"
+                                "showFallbackMonogram=&pageUrl=",
+                                base::EscapeQueryParamValue(url.spec(), true)})
+                : "");
+    row.Set("spaceIcon", "◇");
+    row.Set("spaceName", "Workspace");
+    open_tabs.Append(std::move(row));
+  }
+  data.Set("openTabs", std::move(open_tabs));
+
+  base::ListValue bookmarks;
+  bookmarks::BookmarkModel *bookmark_model =
+      BookmarkModelFactory::GetForBrowserContext(profile);
+  if (bookmark_model && bookmark_model->loaded()) {
+    AppendBookmarkRows(bookmark_model->root_node(), bookmarks);
+  }
+  data.Set("bookmarks", std::move(bookmarks));
+  base::DictValue download_payload = BuildDownloadPayload();
+  std::optional<base::Value> downloads = download_payload.Extract("downloads");
+  std::optional<base::Value> summary = download_payload.Extract("summary");
+  data.Set("downloads",
+           downloads ? std::move(*downloads) : base::Value(base::ListValue()));
+  data.Set("downloadSummary",
+           summary ? std::move(*summary) : base::Value(base::DictValue()));
+
+  history::HistoryService *history_service =
+      HistoryServiceFactory::GetForProfile(profile,
+                                           ServiceAccessType::EXPLICIT_ACCESS);
+  if (!history_service) {
+    data.Set("history", base::ListValue());
+    ResolveInvoke(request_id, true, base::Value(std::move(data)));
+    return;
+  }
+  history::QueryOptions options;
+  options.max_count = 5000;
+  options.duplicate_policy = history::QueryOptions::REMOVE_ALL_DUPLICATES;
+  options.visit_order = history::QueryOptions::RECENT_FIRST;
+  history_service->QueryHistory(
+      std::u16string(), options,
+      base::BindOnce(&ViolaMessageHandler::OnLibraryHistoryReady,
+                     weak_factory_.GetWeakPtr(), request_id, std::move(data)),
+      &library_history_tasks_);
+}
+
+void ViolaMessageHandler::OnLibraryHistoryReady(int request_id,
+                                                base::DictValue data,
+                                                history::QueryResults results) {
+  if (!IsViolaLibrarySurface(CurrentSurface())) {
+    return;
+  }
+  base::ListValue history_rows;
+  for (const history::URLResult &result : results) {
+    const GURL &url = result.url();
+    if (!url.SchemeIsHTTPOrHTTPS()) {
+      continue;
+    }
+    base::DictValue row;
+    row.Set("url", url.spec());
+    row.Set("title", result.title().empty()
+                         ? url.spec()
+                         : base::UTF16ToUTF8(result.title()));
+    row.Set("domain", url.host());
+    row.Set("visits", result.visit_count());
+    row.Set("last", static_cast<double>(
+                        result.last_visit().InMillisecondsSinceUnixEpoch()));
+    row.Set("score", static_cast<double>(result.visit_count() * 10));
+    row.Set("profileId", "");
+    row.Set("profileName", "");
+    row.Set("favicon",
+            base::StrCat({"chrome://favicon2/?size=32&scaleFactor=1x&"
+                          "showFallbackMonogram=&pageUrl=",
+                          base::EscapeQueryParamValue(url.spec(), true)}));
+    history_rows.Append(std::move(row));
+  }
+  data.Set("history", std::move(history_rows));
+  ResolveInvoke(request_id, true, base::Value(std::move(data)));
+}
+
+void ViolaMessageHandler::HandleLibraryAction(viola::HostChannel channel,
+                                              const base::Value &payload) {
+  if (!IsViolaLibrarySurface(CurrentSurface())) {
+    return;
+  }
+  TabStripModel *tab_strip = GetActiveSettingsTabStrip();
+  Profile *profile = GetActiveSettingsProfile();
+  content::WebContents *library_contents = web_ui()->GetWebContents();
+  if (!tab_strip || !profile ||
+      tab_strip->GetActiveWebContents() != library_contents) {
+    return;
+  }
+  if (channel == viola::HostChannel::kLibraryClearHistory) {
+    if (!payload.is_none()) {
+      return;
+    }
+    history::HistoryService *history_service =
+        HistoryServiceFactory::GetForProfile(
+            profile, ServiceAccessType::EXPLICIT_ACCESS);
+    if (history_service) {
+      history_service->ExpireHistoryBetween(
+          {}, std::nullopt, base::Time(), base::Time::Max(),
+          /*user_initiated=*/true,
+          base::BindOnce(&ViolaMessageHandler::SendLibraryChanged,
+                         weak_factory_.GetWeakPtr()),
+          &library_history_tasks_);
+    }
+    return;
+  }
+  if (!payload.is_dict()) {
+    return;
+  }
+  const base::DictValue &dict = payload.GetDict();
+  if (channel == viola::HostChannel::kLibraryOpen) {
+    if (dict.size() < 1 || dict.size() > 3) {
+      return;
+    }
+    if (const std::string *tab_id = dict.FindString("tabId")) {
+      const int index = FindStableTabIndex(*tab_strip, *tab_id);
+      if (index != TabStripModel::kNoTab) {
+        tab_strip->ActivateTabAt(index);
+      }
+      return;
+    }
+    const std::string *url_value = dict.FindString("url");
+    const GURL url(url_value ? *url_value : "");
+    if (!url.SchemeIsHTTPOrHTTPS()) {
+      return;
+    }
+    content::NavigationController::LoadURLParams params(url);
+    params.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+    library_contents->GetController().LoadURLWithParams(params);
+    return;
+  }
+  if (channel == viola::HostChannel::kLibraryRemoveHistory) {
+    if (dict.size() < 1 || dict.size() > 2) {
+      return;
+    }
+    const std::string *url_value = dict.FindString("url");
+    const GURL url(url_value ? *url_value : "");
+    history::HistoryService *history_service =
+        HistoryServiceFactory::GetForProfile(
+            profile, ServiceAccessType::EXPLICIT_ACCESS);
+    if (history_service && url.SchemeIsHTTPOrHTTPS()) {
+      history_service->DeleteURLs({url});
+      SendLibraryChanged();
+    }
+    return;
+  }
+  bookmarks::BookmarkModel *model =
+      BookmarkModelFactory::GetForBrowserContext(profile);
+  const std::string *id = dict.FindString("id");
+  const bookmarks::BookmarkNode *node =
+      model && model->loaded() && id ? FindBookmarkByStableId(*model, *id)
+                                     : nullptr;
+  if (!node || node->is_permanent_node() || !node->is_url()) {
+    return;
+  }
+  if (channel == viola::HostChannel::kLibraryRemoveBookmark &&
+      dict.size() == 1) {
+    model->Remove(node, bookmarks::metrics::BookmarkEditSource::kUser,
+                  FROM_HERE);
+    SendLibraryChanged();
+    return;
+  }
+  if (channel == viola::HostChannel::kLibraryUpdateBookmark &&
+      dict.size() == 2) {
+    const base::DictValue *patch = dict.FindDict("patch");
+    const std::string *title = patch ? patch->FindString("title") : nullptr;
+    if (patch && patch->size() == 1 && title && !title->empty() &&
+        title->size() <= 512 && base::IsStringUTF8(*title)) {
+      model->SetTitle(node, base::UTF8ToUTF16(*title),
+                      bookmarks::metrics::BookmarkEditSource::kUser);
+      SendLibraryChanged();
+    }
+  }
+}
+
+void ViolaMessageHandler::SendLibraryChanged() {
+  if (IsJavascriptAllowed() && IsViolaLibrarySurface(CurrentSurface())) {
+    web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
+                                           base::Value("library:changed"),
+                                           base::Value(base::DictValue()));
+  }
+}
+
+void ViolaMessageHandler::HandlePaletteQuery(int request_id,
+                                             base::Value payload) {
+  if (CurrentSurface() != "overlay.html" || !payload.is_dict() ||
+      payload.GetDict().size() != 2) {
+    ResolveInvoke(request_id, false, base::Value("Invalid palette query"));
+    return;
+  }
+  const std::string *query_value = payload.GetDict().FindString("q");
+  const std::string *mode = payload.GetDict().FindString("mode");
+  if (!query_value || query_value->size() > 2048 ||
+      !base::IsStringUTF8(*query_value) || !mode ||
+      (*mode != "edit" && *mode != "new")) {
+    ResolveInvoke(request_id, false, base::Value("Invalid palette query"));
+    return;
+  }
+
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  Profile *profile = browser ? browser->GetProfile() : nullptr;
+  TabStripModel *tab_strip = GetProductTabStrip();
+  organization_store_ =
+      profile ? viola::ViolaOrganizationStore::Get(profile) : nullptr;
+  if (!browser || !profile || !tab_strip ||
+      browser->GetTabStripModel() != tab_strip) {
+    ResolveInvoke(request_id, false,
+                  base::Value("Viola suggestions are unavailable"));
+    return;
+  }
+  if (organization_store_ && !organization_store_->loaded()) {
+    organization_store_->EnsureLoaded(base::BindOnce(
+        &ViolaMessageHandler::HandlePaletteQuery, weak_factory_.GetWeakPtr(),
+        request_id, std::move(payload)));
+    return;
+  }
+
+  const std::string query(
+      base::TrimWhitespaceASCII(*query_value, base::TRIM_ALL));
+  base::ListValue suggestions;
+  base::ListValue typed_suggestions;
+  if (!query.empty()) {
+    const GURL destination =
+        ResolveTypedDestination(profile, query, organization_store_);
+    if (destination.is_valid() && destination.SchemeIsFile()) {
+      base::DictValue item;
+      item.Set("type", "url");
+      item.Set("title", query);
+      item.Set("detail", "Open local file");
+      item.Set("url", destination.spec());
+      typed_suggestions.Append(std::move(item));
+    } else {
+      AutocompleteMatch match;
+      AutocompleteClassifierFactory::GetForProfile(profile)->Classify(
+          base::UTF8ToUTF16(query), /*in_keyword_mode=*/false,
+          /*allow_exact_keyword_match=*/true, metrics::OmniboxEventProto::BLANK,
+          &match, /*alternate_nav_url=*/nullptr);
+      if (destination.is_valid() && destination.SchemeIsHTTPOrHTTPS()) {
+        base::DictValue item;
+        const bool search = AutocompleteMatch::IsSearchType(match.type);
+        item.Set("type", search ? "search" : "url");
+        item.Set("title", query);
+        item.Set("detail", search ? "Search the web" : "Open URL");
+        item.Set("url", destination.spec());
+        item.Set("favicon",
+                 base::StrCat({"chrome://favicon2/?size=32&scaleFactor=1x&"
+                               "showFallbackMonogram=&pageUrl=",
+                               base::EscapeQueryParamValue(
+                                   destination.spec(), true)}));
+        typed_suggestions.Append(std::move(item));
+      }
+    }
+  }
+
+  if (organization_store_) {
+    base::ListValue tabs = organization_store_->BuildPaletteTabSuggestions(
+        tab_strip, query, query.empty() ? 4u : 3u);
+    for (base::Value &tab : tabs) {
+      suggestions.Append(std::move(tab));
+    }
+  }
+
+  // A typed query should first offer the user's deliberate Favorites and
+  // already-open tabs. The exact URL/search action follows immediately, so a
+  // single Arrow Down still reaches web search without letting generic
+  // history outrank a live or Favorite destination.
+  for (base::Value &typed : typed_suggestions) {
+    suggestions.Append(std::move(typed));
+  }
+
+  if (!query.empty() && suggestions.size() < 8) {
+    bookmarks::BookmarkModel *bookmark_model =
+        BookmarkModelFactory::GetForBrowserContext(profile);
+    if (bookmark_model && bookmark_model->loaded()) {
+      const auto matches = bookmark_model->GetBookmarksMatching(
+          base::UTF8ToUTF16(query), 2,
+          query_parser::MatchingAlgorithm::DEFAULT);
+      for (const bookmarks::TitledUrlMatch &match : matches) {
+        if (suggestions.size() >= 8 || !match.node) {
+          break;
+        }
+        const GURL &url = match.node->GetTitledUrlNodeUrl();
+        if (!url.SchemeIsHTTPOrHTTPS()) {
+          continue;
+        }
+        base::DictValue item;
+        item.Set("type", "bookmark");
+        item.Set("title",
+                 base::UTF16ToUTF8(match.node->GetTitledUrlNodeTitle()));
+        item.Set("detail", base::StrCat({"Bookmark · ", url.host()}));
+        item.Set("url", url.spec());
+        item.Set("favicon",
+                 base::StrCat({"chrome://favicon2/?size=32&scaleFactor=1x&"
+                               "showFallbackMonogram=&pageUrl=",
+                               base::EscapeQueryParamValue(url.spec(), true)}));
+        suggestions.Append(std::move(item));
+      }
+    }
+  }
+
+  history::HistoryService *history_service =
+      HistoryServiceFactory::GetForProfile(profile,
+                                           ServiceAccessType::EXPLICIT_ACCESS);
+  if (!history_service || suggestions.size() >= 8) {
+    ResolvePaletteQuery(request_id, std::move(suggestions));
+    return;
+  }
+  history::QueryOptions options;
+  options.max_count = 8;
+  options.duplicate_policy = history::QueryOptions::REMOVE_ALL_DUPLICATES;
+  options.visit_order = history::QueryOptions::RECENT_FIRST;
+  history_service->QueryHistory(
+      base::UTF8ToUTF16(query), options,
+      base::BindOnce(&ViolaMessageHandler::OnPaletteHistoryReady,
+                     weak_factory_.GetWeakPtr(), request_id,
+                     std::move(suggestions)),
+      &palette_history_tasks_);
+}
+
+void ViolaMessageHandler::OnPaletteHistoryReady(int request_id,
+                                                base::ListValue suggestions,
+                                                history::QueryResults results) {
+  std::set<std::string> seen_urls;
+  for (const base::Value &suggestion : suggestions) {
+    if (const std::string *url = suggestion.GetDict().FindString("url")) {
+      seen_urls.insert(*url);
+    }
+  }
+  for (const history::URLResult &result : results) {
+    if (suggestions.size() >= 8) {
+      break;
+    }
+    const GURL &url = result.url();
+    if (!url.SchemeIsHTTPOrHTTPS() || !seen_urls.insert(url.spec()).second) {
+      continue;
+    }
+    base::DictValue item;
+    item.Set("type", "history");
+    item.Set("title", result.title().empty()
+                          ? url.spec()
+                          : base::UTF16ToUTF8(result.title()));
+    item.Set("detail", url.host());
+    item.Set("url", url.spec());
+    item.Set("favicon",
+             base::StrCat({"chrome://favicon2/?size=32&scaleFactor=1x&"
+                           "showFallbackMonogram=&pageUrl=",
+                           base::EscapeQueryParamValue(url.spec(), true)}));
+    suggestions.Append(std::move(item));
+  }
+  ResolvePaletteQuery(request_id, std::move(suggestions));
+}
+
+void ViolaMessageHandler::ResolvePaletteQuery(int request_id,
+                                              base::ListValue suggestions) {
+  base::ListValue verified;
+  for (base::Value &value : suggestions) {
+    if (verified.size() >= 8 || !value.is_dict()) {
+      break;
+    }
+    base::DictValue &item = value.GetDict();
+    const std::string *type = item.FindString("type");
+    const std::string *tab_id = item.FindString("tabId");
+    const std::string *url_value = item.FindString("url");
+    base::DictValue action;
+    if (type && *type == "tab" && tab_id && !tab_id->empty()) {
+      action.Set("type", "tab");
+      action.Set("value", *tab_id);
+    } else if (url_value) {
+      const GURL url(*url_value);
+      if (!url.SchemeIsHTTPOrHTTPS() && !url.SchemeIsFile()) {
+        continue;
+      }
+      action.Set("type", "navigate");
+      action.Set("value", url.spec());
+    } else {
+      continue;
+    }
+    const std::string token = base::UnguessableToken::Create().ToString();
+    item.Set("token", token);
+    palette_actions_[token] = std::move(action);
+    verified.Append(std::move(value));
+  }
+  while (palette_actions_.size() > 128) {
+    palette_actions_.erase(palette_actions_.begin());
+  }
+  ResolveInvoke(request_id, true, base::Value(std::move(verified)));
+}
+
+void ViolaMessageHandler::ResolveInvoke(int request_id, bool success,
+                                        base::Value payload) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  web_ui()->CallJavascriptFunctionUnsafe(
+      "__violaHostResolve", base::Value(request_id), base::Value(success),
+      std::move(payload));
+}
+
+void ViolaMessageHandler::OnSettingsDataReady(int request_id) {
+  if (!organization_store_ || !organization_store_->loaded()) {
+    ResolveInvoke(request_id, false,
+                  base::Value("Viola settings could not be loaded"));
+    return;
+  }
+  Profile *profile = GetActiveSettingsProfile();
+  viola::ViolaUsageTelemetry *telemetry =
+      viola::ViolaUsageTelemetry::Get(profile);
+  if (!telemetry) {
+    ResolveInvoke(request_id, false,
+                  base::Value("Viola usage settings are unavailable"));
+    return;
+  }
+  telemetry->EnsureLoaded(
+      base::BindOnce(&ViolaMessageHandler::OnSettingsTelemetryReady,
+                     weak_factory_.GetWeakPtr(), request_id));
+}
+
+void ViolaMessageHandler::OnSettingsTelemetryReady(int request_id) {
+  Profile *profile = GetActiveSettingsProfile();
+  viola::ViolaAccountSyncService *account_service =
+      viola::ViolaAccountSyncService::Get(profile);
+  if (!account_service) {
+    ResolveInvoke(request_id, false,
+                  base::Value("Viola account sync is unavailable"));
+    return;
+  }
+  account_service->EnsureLoaded(
+      base::BindOnce(&ViolaMessageHandler::OnSettingsAccountReady,
+                     weak_factory_.GetWeakPtr(), request_id));
+}
+
+void ViolaMessageHandler::OnSettingsAccountReady(int request_id) {
+  Profile *profile = GetActiveSettingsProfile();
+  viola::ViolaAccountSyncService *account_service =
+      viola::ViolaAccountSyncService::Get(profile);
+  if (!organization_store_ || !organization_store_->loaded() ||
+      !account_service || CurrentSurface() != "settings.html") {
+    ResolveInvoke(request_id, false,
+                  base::Value("Viola settings could not be loaded"));
+    return;
+  }
+  base::DictValue data = organization_store_->BuildSettingsData();
+  viola::ViolaUsageTelemetry *telemetry =
+      viola::ViolaUsageTelemetry::Get(profile);
+  if (base::DictValue *settings = data.FindDict("settings")) {
+    settings->Set("usageAnalyticsEnabled",
+                  telemetry ? telemetry->detailed_enabled() : true);
+  }
+  data.Set("nativeChromium", true);
+  data.Set("releaseLine", "0.2");
+  data.Set("chromiumVersion", version_info::GetVersionNumber());
+  data.Set("sync", account_service->Status());
+  base::DictValue google_oauth;
+  google_oauth.Set("configured", false);
+  google_oauth.Set("inProgress", false);
+  data.Set("googleOAuth", std::move(google_oauth));
+  data.Set("updater", BuildUpdaterState());
+  ResolveInvoke(request_id, true, base::Value(std::move(data)));
+}
+
+base::DictValue ViolaMessageHandler::BuildUpdaterState() const {
+  base::DictValue state;
+  state.Set("configured", true);
+  state.Set("status", update_status_);
+  state.Set("version", std::string(kViolaProductVersion));
+  state.Set("availableVersion", update_available_version_.empty()
+                                    ? base::Value()
+                                    : base::Value(update_available_version_));
+  const bool in_app_install = viola::ViolaUpdateService::Get().CanInstallInApp();
+  state.Set("manualInstall", !in_app_install);
+  state.Set("canAutoDownload", false);
+  state.Set("autoDownload", false);
+  state.Set("progress", base::Value());
+  state.Set("lastCheckedAt", update_last_checked_millis_ > 0
+                                 ? base::Value(static_cast<double>(
+                                       update_last_checked_millis_))
+                                 : base::Value());
+  state.Set("error", update_error_.empty() ? base::Value()
+                                            : base::Value(update_error_));
+  return state;
+}
+
+void ViolaMessageHandler::CheckForUpdates(std::optional<int> request_id) {
+  if (update_loader_) {
+    if (request_id) {
+      ResolveInvoke(*request_id, true, base::Value(BuildUpdaterState()));
+    }
+    return;
+  }
+  Profile *profile = GetActiveSettingsProfile();
+  if (!profile) {
+    profile = Profile::FromBrowserContext(
+        web_ui()->GetWebContents()->GetBrowserContext());
+  }
+  if (!profile) {
+    update_status_ = "error";
+    update_error_ = "Viola could not access its update service.";
+    if (request_id) {
+      ResolveInvoke(*request_id, true, base::Value(BuildUpdaterState()));
+    }
+    return;
+  }
+  constexpr net::NetworkTrafficAnnotationTag kUpdateTrafficAnnotation =
+      net::DefineNetworkTrafficAnnotation("viola_release_update_check", R"(
+        semantics {
+          sender: "Viola Software Update"
+          description:
+            "Checks Viola's signed-origin release manifest for a newer "
+            "application version."
+          trigger:
+            "Shortly after launch, about every 15 minutes, or when the user "
+            "chooses Check Now."
+          data: "Installed platform and version comparison only."
+          destination: WEBSITE
+          internal {
+            contacts { email: "support@violabrowser.com" }
+          }
+          user_data { type: NONE }
+          last_reviewed: "2026-08-09"
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Software-update checks are required to keep Viola secure."
+          policy_exception_justification: "Not implemented."
+        })");
+  auto resource_request = std::make_unique<network::ResourceRequest>();
+  resource_request->url = GURL(std::string(kUpdateManifestUrl));
+  resource_request->method = "GET";
+  resource_request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  resource_request->load_flags = net::LOAD_DISABLE_CACHE;
+  update_status_ = "checking";
+  update_error_.clear();
+  update_loader_ = network::SimpleURLLoader::Create(
+      std::move(resource_request), kUpdateTrafficAnnotation);
+  update_loader_->SetAllowHttpErrorResults(true);
+  update_loader_->DownloadToString(
+      profile->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(&ViolaMessageHandler::OnUpdateCheckComplete,
+                     weak_factory_.GetWeakPtr(), request_id),
+      kMaximumUpdateManifestBytes);
+}
+
+void ViolaMessageHandler::OnUpdateCheckComplete(
+    std::optional<int> request_id, std::optional<std::string> body) {
+  int response_code = 0;
+  if (update_loader_ && update_loader_->ResponseInfo() &&
+      update_loader_->ResponseInfo()->headers) {
+    response_code =
+        update_loader_->ResponseInfo()->headers->response_code();
+  }
+  update_loader_.reset();
+  update_last_checked_millis_ =
+      base::Time::Now().InMillisecondsSinceUnixEpoch();
+  std::optional<base::Value> parsed =
+      body ? base::JSONReader::Read(*body, base::JSON_PARSE_RFC) : std::nullopt;
+  const base::DictValue *root = parsed && parsed->is_dict()
+                                    ? &parsed->GetDict()
+                                    : nullptr;
+  const base::DictValue *versions = root ? root->FindDict("discoveryVersions")
+                                         : nullptr;
+  const std::string update_discovery_key = viola::UpdateDiscoveryKey();
+  const std::string *available =
+      versions ? versions->FindString(update_discovery_key) : nullptr;
+  // During a platform's Electron-to-native handoff, the public manifest may
+  // already carry the existing platform release before its native discovery
+  // pointer is published. Treat that healthy older record as a valid fallback
+  // instead of reporting that the whole update service is unreadable.
+  if (!available && root) {
+    const base::DictValue *platforms = root->FindDict("platforms");
+    const base::DictValue *platform =
+        platforms ? platforms->FindDict(update_discovery_key) : nullptr;
+    available = platform ? platform->FindString("version") : nullptr;
+  }
+  const base::Version current{std::string(kViolaProductVersion)};
+  const base::Version candidate{available ? *available : std::string()};
+  if (response_code < 200 || response_code >= 300 || !current.IsValid() ||
+      !candidate.IsValid()) {
+    update_status_ = "error";
+    update_error_ = "Viola could not read its update manifest.";
+    update_available_version_.clear();
+  } else if (candidate.CompareTo(current) > 0) {
+    update_status_ = "available";
+    update_available_version_ = candidate.GetString();
+    update_error_.clear();
+    if (viola::ViolaUpdateService::Get().CanInstallInApp()) {
+      const auto install_status =
+          viola::ViolaUpdateService::Get().install_status();
+      OnViolaUpdateInstallStatusChanged(install_status);
+      viola::ViolaUpdateService::Get().StageUpdateInBackground();
+    }
+  } else {
+    update_status_ = "idle";
+    update_available_version_.clear();
+    update_error_.clear();
+  }
+  if (CurrentSurface() == "sidebar.html" && IsJavascriptAllowed()) {
+    SendRenderState();
+  }
+  if (request_id) {
+    ResolveInvoke(*request_id, true, base::Value(BuildUpdaterState()));
+  }
+}
+
+void ViolaMessageHandler::OnAccountServiceReady(viola::HostChannel channel,
+                                                int request_id,
+                                                base::Value payload) {
+  Profile *profile = GetActiveSettingsProfile();
+  viola::ViolaAccountSyncService *service =
+      viola::ViolaAccountSyncService::Get(profile);
+  if (!service || CurrentSurface() != "settings.html") {
+    ResolveInvoke(request_id, false,
+                  base::Value("Viola account sync is unavailable"));
+    return;
+  }
+  auto callback = base::BindOnce(&ViolaMessageHandler::OnAccountResult,
+                                 weak_factory_.GetWeakPtr(), request_id);
+  const base::DictValue *request = payload.GetIfDict();
+  switch (channel) {
+  case viola::HostChannel::kAccountEmailStart:
+    if (!request || request->size() != 5) {
+      OnAccountResult(request_id,
+                      AccountErrorResult("Invalid account request"));
+      return;
+    }
+    service->BeginEmailSignIn(*request, std::move(callback));
+    return;
+  case viola::HostChannel::kAccountEmailVerify:
+    if (!request || request->size() != 1) {
+      OnAccountResult(request_id,
+                      AccountErrorResult("Invalid verification request"));
+      return;
+    }
+    service->VerifyEmailSignIn(*request, std::move(callback));
+    return;
+  case viola::HostChannel::kAccountEmailComplete:
+    if (!request || request->size() != 1) {
+      OnAccountResult(request_id,
+                      AccountErrorResult("Invalid recovery request"));
+      return;
+    }
+    service->CompleteEmailSignIn(*request, std::move(callback));
+    return;
+  case viola::HostChannel::kAccountEmailResetLegacy:
+    if (!payload.is_none()) {
+      OnAccountResult(request_id, AccountErrorResult("Invalid reset request"));
+      return;
+    }
+    service->ResetPendingLegacySync(std::move(callback));
+    return;
+  case viola::HostChannel::kAccountUpdate:
+    if (!request || request->size() != 2) {
+      OnAccountResult(request_id,
+                      AccountErrorResult("Invalid identity request"));
+      return;
+    }
+    OnAccountResult(request_id, service->UpdateIdentity(*request));
+    return;
+  case viola::HostChannel::kAccountRemove:
+    if (!payload.is_none()) {
+      OnAccountResult(request_id,
+                      AccountErrorResult("Invalid removal request"));
+      return;
+    }
+    OnAccountResult(request_id, service->RemoveAccount());
+    return;
+  case viola::HostChannel::kAccountContinueWithGoogle:
+    OnAccountResult(
+        request_id,
+        AccountErrorResult(
+            "Google sign-in is not configured in this native build."));
+    return;
+  default:
+    OnAccountResult(request_id,
+                    AccountErrorResult("Unsupported account request"));
+    return;
+  }
+}
+
+void ViolaMessageHandler::OnAccountResult(int request_id,
+                                          base::DictValue result) {
+  if (CurrentSurface() != "settings.html") {
+    return;
+  }
+  ResolveInvoke(request_id, true, base::Value(result.Clone()));
+  if (result.FindBool("ok").value_or(false) && result.FindDict("sync")) {
+    web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
+                                           base::Value("settings:changed"),
+                                           base::Value(base::DictValue()));
+  }
+}
+
+std::string ViolaMessageHandler::CurrentSurface() {
+  const GURL &url = web_ui()->GetWebContents()->GetLastCommittedURL();
+  if (!url.SchemeIs("chrome") || url.host() != "viola") {
+    return {};
+  }
+
+  std::string_view path = url.path();
+  if (path.empty() || path == "/") {
+    return "sidebar.html";
+  }
+  path.remove_prefix(1);
+  if (path.empty() || path.contains('/')) {
+    return {};
+  }
+  return std::string(path);
+}
