+std::string SavedSnapshotUrl(const base::DictValue &persistent) {
+  const std::string value = StringOr(&persistent, "url", "about:blank");
+  const GURL url(value);
+  if (url.SchemeIs("chrome") &&
+      (url.host() == "newtab" || url.host() == "new-tab-page")) {
+    return "about:blank";
+  }
+  return IsSafeTabUrl(url, false) ? value : "about:blank";
+}
+
+void UpdateSavedTabSnapshots(base::DictValue &organization,
+                             std::string_view tab_id,
+                             const base::DictValue &persistent) {
+  for (base::Value &space : *organization.FindList("spaces")) {
+    for (base::Value &group : *space.GetDict().FindList("tabGroups")) {
+      base::DictValue &group_dict = group.GetDict();
+      if (!group_dict.FindBool("saved").value_or(false)) {
+        continue;
+      }
+      for (base::Value &snapshot : *group_dict.FindList("savedTabs")) {
+        base::DictValue &snapshot_dict = snapshot.GetDict();
+        if (StringOr(&snapshot_dict, "tabId") == tab_id) {
+          snapshot_dict.Set("url", SavedSnapshotUrl(persistent));
+          snapshot_dict.Set("title", StringOr(&persistent, "title"));
+        }
+      }
+    }
+  }
+}
+
+void RemoveTabFromOrganizationGroups(base::DictValue &organization,
+                                     std::string_view tab_id,
+                                     bool forget_saved_snapshot) {
+  for (base::Value &space_value : *organization.FindList("spaces")) {
+    base::DictValue &space = space_value.GetDict();
+    base::ListValue *groups = space.FindList("tabGroups");
+    for (auto group = groups->begin(); group != groups->end();) {
+      base::DictValue &dict = group->GetDict();
+      base::ListValue *ids = dict.FindList("tabIds");
+      for (auto id = ids->begin(); id != ids->end();) {
+        if (id->is_string() && id->GetString() == tab_id) {
+          id = ids->erase(id);
+        } else {
+          ++id;
+        }
+      }
+      base::ListValue *snapshots = dict.FindList("savedTabs");
+      if (forget_saved_snapshot && dict.FindBool("saved").value_or(false)) {
+        for (auto snapshot = snapshots->begin();
+             snapshot != snapshots->end();) {
+          if (StringOr(&snapshot->GetDict(), "tabId") == tab_id) {
+            snapshot = snapshots->erase(snapshot);
+          } else {
+            ++snapshot;
+          }
+        }
+      }
+      if (ids->empty() &&
+          (!dict.FindBool("saved").value_or(false) || snapshots->empty())) {
+        group = groups->erase(group);
+      } else {
+        ++group;
+      }
+    }
+    const std::vector<std::string> split_ids = SplitLeaves(space.Find("split"));
+    if (std::ranges::find(split_ids, tab_id) != split_ids.end()) {
+      space.Set("split", base::Value());
+      space.Set("splitTitle", base::Value());
+      space.Set("splitKeepExpanded", false);
+    }
+  }
+}
