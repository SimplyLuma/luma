+// static
+bool ViolaProductShellView::IsEnabledFor(const Browser &browser) {
+  bool native_popup = false;
+#if BUILDFLAG(IS_LINUX)
+  native_popup = (browser.type() == Browser::TYPE_POPUP ||
+                  browser.type() == Browser::TYPE_DEVTOOLS) &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch("viola-native-frame-probe");
+#endif
+  return (browser.type() == Browser::TYPE_NORMAL ||
+          native_popup ||
+          ViolaMiniWindow::IsMini(browser)) &&
+         !base::CommandLine::ForCurrentProcess()->HasSwitch(
+             kDisableProductShellSwitch);
+}
