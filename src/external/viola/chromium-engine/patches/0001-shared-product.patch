diff --git a/chrome/browser/resources/viola/mobile-simulator.js b/chrome/browser/resources/viola/mobile-simulator.js
new file mode 100644
index 0000000000000000000000000000000000000000..7dea915e437f792be9717e1b6bd1e787112a23f3
--- /dev/null
+++ b/chrome/browser/resources/viola/mobile-simulator.js
@@ -0,0 +1,514 @@
+const sim = window.violaSimulator;
+
+const $ = (selector) => document.querySelector(selector);
+const root = $('#simulator');
+const stage = $('#stage');
+const shell = $('#device-shell');
+const screen = $('#device-screen');
+const webview = $('#mobile-page');
+const touchGlass = $('#touch-glass');
+const touchCursor = $('#touch-cursor');
+const widthInput = $('#viewport-width');
+const heightInput = $('#viewport-height');
+
+let init = null;
+let state = null;
+let devices = [];
+let metrics = null;
+let guestReady = false;
+let persistTimer = null;
+let toastTimer = null;
+let pointer = null;
+let resize = null;
+
+function device() {
+  return devices.find((item) => item.id === state.deviceId) || devices[0];
+}
+
+function derivedMetrics() {
+  const selected = device();
+  const posture = selected.foldable
+    ? (state.folded ? selected.folded : selected.unfolded) : null;
+  let width = state.locked
+    ? (posture ? posture.width : selected.width)
+    : (state.customWidth || (posture ? posture.width : selected.width));
+  let height = state.locked
+    ? (posture ? posture.height : selected.height)
+    : (state.customHeight || (posture ? posture.height : selected.height));
+  if (state.orientation === 'landscape') [width, height] = [height, width];
+  let crease = posture && posture.crease;
+  if (crease && state.orientation === 'landscape') {
+    crease = crease === 'vertical' ? 'horizontal' : 'vertical';
+  }
+  const safeArea = state.orientation === 'portrait'
+    ? { ...selected.safeArea }
+    : {
+        top: 0,
+        right: selected.safeArea.top || 0,
+        bottom: selected.os === 'ios' ? 21 : 0,
+        left: selected.safeArea.top || 0,
+      };
+  const viewportInsets = state.frame
+    ? {
+        ...safeArea,
+        bottom: state.orientation === 'portrait'
+          ? Math.min(safeArea.bottom, selected.gestureInset ?? safeArea.bottom)
+          : safeArea.bottom,
+      }
+    : { top: 0, right: 0, bottom: 0, left: 0 };
+  const viewport = {
+    x: viewportInsets.left,
+    y: viewportInsets.top,
+    width: Math.max(1, width - viewportInsets.left - viewportInsets.right),
+    height: Math.max(1, height - viewportInsets.top - viewportInsets.bottom),
+  };
+  return { width, height, dpr: selected.dpr, selected, crease, safeArea, viewport };
+}
+
+function safeText(value) {
+  return String(value == null ? '' : value);
+}
+
+function renderDeviceList(filter = '') {
+  const list = $('#device-list');
+  const needle = filter.trim().toLowerCase();
+  const matches = devices.filter((item) => !needle
+    || `${item.name} ${item.category}`.toLowerCase().includes(needle));
+  list.replaceChildren();
+  let category = null;
+  for (const item of matches) {
+    if (item.category !== category) {
+      category = item.category;
+      const heading = document.createElement('div');
+      heading.className = 'device-category';
+      heading.textContent = category;
+      list.append(heading);
+    }
+    const row = document.createElement('button');
+    row.className = `device-row${item.id === state.deviceId ? ' active' : ''}`;
+    row.dataset.deviceId = item.id;
+    const icon = document.createElement('span');
+    icon.className = 'phone-icon';
+    icon.textContent = item.foldable ? '▱' : '▯';
+    const copy = document.createElement('span');
+    copy.className = 'device-copy';
+    const name = document.createElement('b');
+    name.textContent = item.name;
+    const size = document.createElement('small');
+    const base = item.foldable ? item.folded : item;
+    size.textContent = `${base.width} × ${base.height}`;
+    copy.append(name, size);
+    row.append(icon, copy);
+    if (item.foldable) {
+      const fold = document.createElement('span');
+      fold.className = 'fold-tag';
+      fold.textContent = 'fold';
+      row.append(fold);
+    }
+    list.append(row);
+  }
+}
+
+function setClasses() {
+  root.className = `background-${state.background}`;
+  root.classList.toggle('drawer-open', root.dataset.drawerOpen === 'true');
+  root.classList.toggle('frame-off', !state.frame);
+  root.classList.toggle('dark-scheme', state.colorScheme === 'dark');
+  root.classList.toggle('touch-enabled', state.touch);
+  root.classList.toggle('unlocked', !state.locked);
+  root.classList.toggle('landscape', state.orientation === 'landscape');
+  root.style.setProperty('--surface-color', state.backgroundColor);
+  root.style.setProperty('--surface-accent', state.backgroundAccent);
+}
+
+function setActiveButtons() {
+  for (const [action, active] of [
+    ['frame', state.frame],
+    ['scheme', state.colorScheme === 'dark'],
+    ['touch', state.touch],
+    ['lock', state.locked],
+  ]) {
+    const button = document.querySelector(`[data-action="${action}"]`);
+    if (button) button.classList.toggle('active', active);
+  }
+}
+
+function fitScale() {
+  if (!metrics) return;
+  const rect = stage.getBoundingClientRect();
+  const bezel = state.frame ? metrics.selected.bezel : 0;
+  const naturalWidth = metrics.width + bezel * 2;
+  const naturalHeight = metrics.height + bezel * 2;
+  const fit = Math.min(1, rect.width / naturalWidth, rect.height / naturalHeight);
+  const scale = Math.max(.12, fit * state.zoom);
+  root.style.setProperty('--device-scale', scale.toFixed(4));
+  $('#zoom-value').textContent = Math.abs(state.zoom - 1) < .01
+    ? 'Fit' : `${Math.round(state.zoom * 100)}%`;
+}
+
+function render({ persist = false, apply = false } = {}) {
+  if (!state || !devices.length) return;
+  metrics = derivedMetrics();
+  const selected = metrics.selected;
+  setClasses();
+  setActiveButtons();
+  root.classList.toggle('no-status', !state.frame || metrics.safeArea.top <= 0);
+  root.style.setProperty('--viewport-width', `${metrics.width}px`);
+  root.style.setProperty('--viewport-height', `${metrics.height}px`);
+  root.style.setProperty('--page-left', `${metrics.viewport.x}px`);
+  root.style.setProperty('--page-top', `${metrics.viewport.y}px`);
+  root.style.setProperty('--page-width', `${metrics.viewport.width}px`);
+  root.style.setProperty('--page-height', `${metrics.viewport.height}px`);
+  root.style.setProperty('--device-radius', `${selected.foldable
+    ? (state.folded ? selected.folded.radius : selected.unfolded.radius)
+    : selected.radius}px`);
+  root.style.setProperty('--device-bezel', `${selected.bezel}px`);
+  root.style.setProperty('--status-height', `${metrics.safeArea.top}px`);
+  root.style.setProperty('--cutout-width', `${selected.cutoutWidth || 0}px`);
+  root.style.setProperty('--cutout-height', `${selected.cutoutHeight || 0}px`);
+  shell.className = `os-${selected.os} cutout-${selected.cutout || 'none'}`;
+  if (metrics.crease) shell.classList.add(`crease-${metrics.crease}`);
+  widthInput.value = metrics.width;
+  heightInput.value = metrics.height;
+  widthInput.disabled = state.locked;
+  heightInput.disabled = state.locked;
+  $('#device-name').textContent = selected.name;
+  $('#floating-device-name').textContent = selected.name;
+  $('#floating-device-size').textContent = `${metrics.width} × ${metrics.height} · @${selected.dpr}x`;
+  $('#pixel-ratio').textContent = `@${selected.dpr}x`;
+  $('#fold-button').hidden = !selected.foldable;
+  $('#fold-label').textContent = state.folded ? 'Unfold' : 'Fold';
+  renderDeviceList($('#device-search').value);
+  renderBackgroundOptions();
+  requestAnimationFrame(fitScale);
+  if (apply && guestReady) sim.send('simulator:update', { state });
+  if (persist) schedulePersist();
+}
+
+function schedulePersist() {
+  clearTimeout(persistTimer);
+  persistTimer = setTimeout(() => sim.send('simulator:update', { state }), 90);
+}
+
+function renderBackgroundOptions() {
+  const host = $('#background-options');
+  const names = ['graphite', 'slate', 'concrete', 'walnut', 'solid'];
+  host.replaceChildren(...names.map((name) => {
+    const button = document.createElement('button');
+    button.className = `background-swatch${state.background === name ? ' active' : ''}`;
+    button.dataset.bg = name;
+    button.title = name[0].toUpperCase() + name.slice(1);
+    return button;
+  }));
+}
+
+function showToast(message) {
+  const toast = $('#simulator-toast');
+  toast.textContent = message;
+  toast.classList.add('visible');
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(() => toast.classList.remove('visible'), 2400);
+}
+
+function closePopovers() {
+  $('#capture-menu').hidden = true;
+  $('#background-menu').hidden = true;
+}
+
+function togglePopover(selector) {
+  const target = $(selector);
+  const opening = target.hidden;
+  closePopovers();
+  target.hidden = !opening;
+}
+
+function selectDevice(id) {
+  const selected = devices.find((item) => item.id === id);
+  if (!selected) return;
+  state.deviceId = id;
+  state.folded = !!selected.foldable;
+  state.locked = true;
+  state.customWidth = null;
+  state.customHeight = null;
+  root.dataset.drawerOpen = 'false';
+  render({ persist: true, apply: true });
+}
+
+function setCustomDimension(axis, value) {
+  if (state.locked) return;
+  const parsed = Math.round(Number(value));
+  if (!Number.isFinite(parsed)) return render();
+  const bounded = Math.max(axis === 'width' ? 240 : 320, Math.min(axis === 'width' ? 1600 : 1800, parsed));
+  const portraitAxis = state.orientation === 'portrait' ? axis : (axis === 'width' ? 'height' : 'width');
+  if (portraitAxis === 'width') state.customWidth = bounded;
+  else state.customHeight = bounded;
+  render({ persist: true, apply: true });
+}
+
+function executeAction(action) {
+  if (!state) return;
+  switch (action) {
+    case 'open-drawer': root.dataset.drawerOpen = 'true'; render(); break;
+    case 'close-drawer': root.dataset.drawerOpen = 'false'; render(); break;
+    case 'rotate':
+      state.orientation = state.orientation === 'portrait' ? 'landscape' : 'portrait';
+      render({ persist: true, apply: true });
+      break;
+    case 'frame': state.frame = !state.frame; render({ persist: true, apply: true }); break;
+    case 'scheme':
+      state.colorScheme = state.colorScheme === 'dark' ? 'light' : 'dark';
+      render({ persist: true, apply: true });
+      break;
+    case 'touch': state.touch = !state.touch; render({ persist: true, apply: true }); break;
+    case 'lock':
+      state.locked = !state.locked;
+      if (!state.locked) {
+        const current = derivedMetrics();
+        state.customWidth = state.orientation === 'portrait' ? current.width : current.height;
+        state.customHeight = state.orientation === 'portrait' ? current.height : current.width;
+      }
+      render({ persist: true, apply: true });
+      break;
+    case 'fold': state.folded = !state.folded; render({ persist: true, apply: true }); break;
+    case 'capture-menu': togglePopover('#capture-menu'); break;
+    case 'background-menu': togglePopover('#background-menu'); break;
+    case 'zoom-out': state.zoom = Math.max(.35, state.zoom - .1); render({ persist: true }); break;
+    case 'zoom-in': state.zoom = Math.min(1.75, state.zoom + .1); render({ persist: true }); break;
+    case 'zoom-fit': state.zoom = 1; render({ persist: true }); break;
+  }
+}
+
+function localPoint(event) {
+  const rect = touchGlass.getBoundingClientRect();
+  return {
+    x: Math.max(0, Math.min(metrics.viewport.width,
+      (event.clientX - rect.left) * metrics.viewport.width / rect.width)),
+    y: Math.max(0, Math.min(metrics.viewport.height,
+      (event.clientY - rect.top) * metrics.viewport.height / rect.height)),
+  };
+}
+
+function sendTouch(type, point, extra = {}) {
+  sim.send('simulator:touch', { type, x: point.x, y: point.y, ...extra });
+}
+
+touchGlass.addEventListener('pointerenter', (event) => {
+  root.classList.add('pointer-over');
+  touchCursor.style.left = `${event.clientX}px`;
+  touchCursor.style.top = `${event.clientY}px`;
+});
+touchGlass.addEventListener('pointerleave', () => {
+  if (!pointer) root.classList.remove('pointer-over');
+});
+touchGlass.addEventListener('pointermove', (event) => {
+  touchCursor.style.left = `${event.clientX}px`;
+  touchCursor.style.top = `${event.clientY}px`;
+  if (!pointer || pointer.id !== event.pointerId) return;
+  const point = localPoint(event);
