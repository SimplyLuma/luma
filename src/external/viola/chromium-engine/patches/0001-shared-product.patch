+bool ViolaOrganizationStore::UpdateSplitVisuals(std::string_view space_id,
+                                                std::string_view first_tab_id,
+                                                std::string_view second_tab_id,
+                                                std::string_view direction,
+                                                double ratio) {
+  if (!loaded_ || first_tab_id.empty() || second_tab_id.empty() ||
+      first_tab_id == second_tab_id || (direction != "h" && direction != "v") ||
+      !std::isfinite(ratio) || ratio < 0.1 || ratio > 0.9) {
+    return false;
+  }
+  base::DictValue *space = FindSpace(organization_, space_id);
+  base::DictValue *split = space ? space->FindDict("split") : nullptr;
+  const std::vector<std::string> ids =
+      SplitLeaves(space ? space->Find("split") : nullptr);
+  if (!split || ids.size() != 2 || ids[0] != first_tab_id ||
+      ids[1] != second_tab_id) {
+    return false;
+  }
+  split->Set("dir", direction);
+  base::ListValue sizes;
+  sizes.Append(ratio);
+  sizes.Append(1.0 - ratio);
+  split->Set("sizes", std::move(sizes));
+  ScheduleWrite();
+  return true;
+}
