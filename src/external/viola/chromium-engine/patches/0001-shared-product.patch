+std::optional<base::DictValue> SanitizeTab(const base::Value &value,
+                                           bool native_state) {
+  const base::DictValue *source = value.GetIfDict();
+  if (!source) {
+    return std::nullopt;
+  }
+  const std::string id = Identifier(source->Find("id"));
+  const std::string url = SafeTabUrl(source->Find("url"), native_state);
+  if (id.empty() || url.empty()) {
+    return std::nullopt;
+  }
+  base::DictValue tab;
+  tab.Set("id", id);
+  tab.Set("url", url);
+  std::string title = BoundedText(source->Find("title"), 512, url);
+  tab.Set("title", title.empty() ? url : title);
+  const std::string favicon = SafeFavicon(source->Find("favicon"));
+  tab.Set("favicon", favicon.empty() ? base::Value() : base::Value(favicon));
+  tab.Set("createdAt", NumberOr(source->Find("createdAt")));
+  tab.Set("lastAccessed", NumberOr(source->Find("lastAccessed")));
+  tab.Set("keepActive", BooleanOr(source->Find("keepActive")));
+  tab.Set("miniPlayerExcluded", BooleanOr(source->Find("miniPlayerExcluded")));
+  tab.Set("muted", BooleanOr(source->Find("muted")));
+  const std::string opener = Identifier(source->Find("openerTabId"));
+  tab.Set("openerTabId", opener.empty() ? base::Value() : base::Value(opener));
+  return tab;
+}
+
+base::ListValue SanitizeTabs(const base::ListValue *source, size_t maximum,
+                             bool native_state,
+                             std::set<std::string> *seen_tab_ids,
+                             const std::set<std::string> *excluded_ids =
+                                 nullptr) {
+  base::ListValue tabs;
+  if (!source) {
+    return tabs;
+  }
+  for (size_t index = 0; index < std::min(maximum, source->size()); ++index) {
+    std::optional<base::DictValue> tab =
+        SanitizeTab((*source)[index], native_state);
+    if (!tab) {
+      continue;
+    }
+    const std::string &id = *tab->FindString("id");
+    if (excluded_ids && excluded_ids->contains(id)) {
+      continue;
+    }
+    if (!seen_tab_ids->insert(id).second) {
+      continue;
+    }
+    tabs.Append(std::move(*tab));
+  }
+  return tabs;
+}
+
+base::ListValue SanitizeRemovedTabIds(const base::ListValue *source,
+                                      std::set<std::string> *removed_ids) {
+  base::ListValue result;
+  if (!source || !removed_ids) {
+    return result;
+  }
+  for (const base::Value &candidate : *source) {
+    if (result.size() >= kMaximumRemovedTabIds) {
+      break;
+    }
+    const std::string id = Identifier(&candidate);
+    if (!id.empty() && removed_ids->insert(id).second) {
+      result.Append(id);
+    }
+  }
+  return result;
+}
+
+void RememberRemovedTab(base::DictValue &space, std::string_view tab_id) {
+  if (!IsIdentifier(tab_id)) {
+    return;
+  }
+  base::ListValue *removed = space.FindList("syncRemovedTabIds");
+  if (!removed) {
+    space.Set("syncRemovedTabIds", base::ListValue());
+    removed = space.FindList("syncRemovedTabIds");
+  }
+  for (const base::Value &candidate : *removed) {
+    if (candidate.is_string() && candidate.GetString() == tab_id) {
+      return;
+    }
+  }
+  if (removed->size() < kMaximumRemovedTabIds) {
+    removed->Append(std::string(tab_id));
+  }
+}
+
+std::optional<base::Value> SanitizeSplit(const base::Value *value,
+                                         const std::set<std::string> &allowed,
+                                         int depth) {
+  const base::DictValue *source = value ? value->GetIfDict() : nullptr;
+  if (!source || depth > 24) {
+    return std::nullopt;
+  }
+  const std::string type = StringOr(source, "t");
+  if (type == "leaf") {
+    const std::string tab_id = Identifier(source->Find("tabId"));
+    if (!allowed.contains(tab_id)) {
+      return std::nullopt;
+    }
+    base::DictValue leaf;
+    leaf.Set("t", "leaf");
+    leaf.Set("tabId", tab_id);
+    return base::Value(std::move(leaf));
+  }
+  const base::ListValue *children = source->FindList("kids");
+  const std::string direction = StringOr(source, "dir");
+  if (type != "split" || (direction != "h" && direction != "v") || !children) {
+    return std::nullopt;
+  }
+  base::ListValue sanitized_children;
+  for (size_t index = 0; index < std::min<size_t>(12, children->size());
+       ++index) {
+    std::optional<base::Value> child =
+        SanitizeSplit(&(*children)[index], allowed, depth + 1);
+    if (child) {
+      sanitized_children.Append(std::move(*child));
+    }
+  }
+  if (sanitized_children.size() < 2) {
+    return std::nullopt;
+  }
+  const base::ListValue *raw_sizes = source->FindList("sizes");
+  std::vector<double> sizes;
+  double total = 0;
+  for (size_t index = 0; index < sanitized_children.size(); ++index) {
+    const double size =
+        raw_sizes && index < raw_sizes->size()
+            ? std::max(0.000001, NumberOr(&(*raw_sizes)[index], 1))
+            : 1;
+    sizes.push_back(size);
+    total += size;
+  }
+  base::ListValue normalized_sizes;
+  for (double size : sizes) {
+    normalized_sizes.Append(size / total);
+  }
+  base::DictValue split;
+  split.Set("t", "split");
+  split.Set("dir", direction);
+  split.Set("kids", std::move(sanitized_children));
+  split.Set("sizes", std::move(normalized_sizes));
+  return base::Value(std::move(split));
+}
+
+void CanonicalizePersonalIdentity(base::DictValue *organization) {
+  base::ListValue *spaces = organization ? organization->FindList("spaces")
+                                         : nullptr;
+  base::ListValue *profiles = organization ? organization->FindList("profiles")
+                                           : nullptr;
+  if (!spaces || spaces->empty() || !profiles || profiles->empty()) {
+    return;
+  }
+
+  std::vector<size_t> personal_space_indices;
+  size_t chosen_index = spaces->size();
+  size_t chosen_tab_count = 0;
+  const std::string active_space = StringOr(organization, "activeSpaceId");
+  for (size_t index = 0; index < spaces->size(); ++index) {
+    const base::DictValue &space = (*spaces)[index].GetDict();
+    const std::string id = StringOr(&space, "id");
+    if (id != "personal" && id != "native-personal" &&
+        StringOr(&space, "name") != "Personal") {
+      continue;
+    }
+    personal_space_indices.push_back(index);
+    const size_t tab_count = space.FindList("pinned")->size() +
+                             space.FindList("today")->size();
+    if (chosen_index == spaces->size() || tab_count > chosen_tab_count ||
+        (tab_count == chosen_tab_count && id == active_space)) {
+      chosen_index = index;
+      chosen_tab_count = tab_count;
+    }
+  }
+  if (chosen_index == spaces->size()) {
+    return;
+  }
+
+  std::set<size_t> personal_indices(personal_space_indices.begin(),
+                                    personal_space_indices.end());
+  std::set<std::string> personal_space_ids;
+  std::set<std::string> personal_profile_ids;
+  base::DictValue canonical_space = (*spaces)[chosen_index].GetDict().Clone();
+  std::set<std::string> canonical_tab_ids;
+  for (std::string_view section : {"pinned", "today"}) {
+    for (const base::Value &tab : *canonical_space.FindList(section)) {
+      canonical_tab_ids.insert(StringOr(&tab.GetDict(), "id"));
+    }
+  }
+  std::set<std::string> canonical_group_ids;
+  for (const base::Value &group : *canonical_space.FindList("tabGroups")) {
+    canonical_group_ids.insert(StringOr(&group.GetDict(), "id"));
+  }
+  for (size_t index : personal_space_indices) {
+    const base::DictValue &candidate = (*spaces)[index].GetDict();
+    personal_space_ids.insert(StringOr(&candidate, "id"));
+    personal_profile_ids.insert(StringOr(&candidate, "profileId"));
+    if (index == chosen_index) {
+      continue;
+    }
+    for (std::string_view section : {"pinned", "today"}) {
+      for (const base::Value &tab : *candidate.FindList(section)) {
+        const std::string id = StringOr(&tab.GetDict(), "id");
+        if (!id.empty() && canonical_tab_ids.insert(id).second) {
+          canonical_space.FindList(section)->Append(tab.Clone());
+        }
+      }
+    }
+    for (const base::Value &group : *candidate.FindList("tabGroups")) {
+      const std::string id = StringOr(&group.GetDict(), "id");
+      if (!id.empty() && canonical_group_ids.insert(id).second) {
+        canonical_space.FindList("tabGroups")->Append(group.Clone());
+      }
+    }
+  }
+  canonical_space.Set("id", "personal");
+  canonical_space.Set("name", "Personal");
+  canonical_space.Set("profileId", "personal");
+
+  base::ListValue canonical_spaces;
+  for (size_t index = 0; index < spaces->size(); ++index) {
+    if (index == chosen_index) {
+      canonical_spaces.Append(canonical_space.Clone());
+      continue;
+    }
+    if (personal_indices.contains(index)) {
+      continue;
+    }
+    base::DictValue space = (*spaces)[index].GetDict().Clone();
+    if (personal_profile_ids.contains(StringOr(&space, "profileId"))) {
+      space.Set("profileId", "personal");
+    }
+    canonical_spaces.Append(std::move(space));
+  }
+
+  size_t chosen_profile_index = profiles->size();
+  for (size_t index = 0; index < profiles->size(); ++index) {
+    const std::string id = StringOr(&(*profiles)[index].GetDict(), "id");
+    if (id == "personal" || personal_profile_ids.contains(id)) {
+      if (chosen_profile_index == profiles->size() || id != "personal") {
+        chosen_profile_index = index;
+      }
+    }
+  }
+  if (chosen_profile_index == profiles->size()) {
+    chosen_profile_index = 0;
+  }
+  base::DictValue canonical_profile =
+      (*profiles)[chosen_profile_index].GetDict().Clone();
+  canonical_profile.Set("id", "personal");
+  canonical_profile.Set("name", "Personal");
+  std::set<std::string> favorite_ids;
+  for (const base::Value &tab : *canonical_profile.FindList("favorites")) {
+    favorite_ids.insert(StringOr(&tab.GetDict(), "id"));
+  }
+  base::ListValue canonical_profiles;
+  bool inserted_profile = false;
+  for (size_t index = 0; index < profiles->size(); ++index) {
+    const base::DictValue &candidate = (*profiles)[index].GetDict();
+    const std::string id = StringOr(&candidate, "id");
+    if (id == "personal" || personal_profile_ids.contains(id)) {
+      for (const base::Value &tab : *candidate.FindList("favorites")) {
+        const std::string tab_id = StringOr(&tab.GetDict(), "id");
+        if (!tab_id.empty() && favorite_ids.insert(tab_id).second) {
+          canonical_profile.FindList("favorites")->Append(tab.Clone());
+        }
+      }
+      if (!inserted_profile) {
+        canonical_profiles.Append(canonical_profile.Clone());
+        inserted_profile = true;
+      }
+      continue;
+    }
+    canonical_profiles.Append(candidate.Clone());
+  }
+  if (!inserted_profile) {
+    canonical_profiles.Insert(canonical_profiles.begin(),
+                              base::Value(std::move(canonical_profile)));
+  }
+
+  if (personal_space_ids.contains(active_space)) {
+    organization->Set("activeSpaceId", "personal");
+  }
+  if (base::ListValue *bookmarks = organization->FindList("bookmarks")) {
+    for (base::Value &bookmark : *bookmarks) {
+      base::DictValue &value = bookmark.GetDict();
+      if (personal_profile_ids.contains(StringOr(&value, "profileId"))) {
+        value.Set("profileId", "personal");
+      }
+    }
+  }
+  organization->Set("spaces", std::move(canonical_spaces));
+  organization->Set("profiles", std::move(canonical_profiles));
+}
+
+base::ListValue SanitizeGroups(const base::ListValue *source,
+                               const std::set<std::string> &allowed) {
+  base::ListValue groups;
+  if (!source) {
+    return groups;
+  }
+  std::set<std::string> group_ids;
+  for (size_t index = 0; index < std::min<size_t>(1000, source->size());
+       ++index) {
+    const base::DictValue *raw = (*source)[index].GetIfDict();
+    const std::string id = raw ? Identifier(raw->Find("id")) : std::string();
+    if (!raw || id.empty() || !group_ids.insert(id).second) {
+      continue;
+    }
+    base::ListValue tab_ids;
+    std::set<std::string> group_tabs;
+    if (const base::ListValue *candidates = raw->FindList("tabIds")) {
+      for (const base::Value &candidate : *candidates) {
+        const std::string tab_id = Identifier(&candidate);
+        if (allowed.contains(tab_id) && group_tabs.insert(tab_id).second) {
+          tab_ids.Append(tab_id);
+        }
+      }
+    }
+    base::ListValue saved_tabs;
+    if (const base::ListValue *candidates = raw->FindList("savedTabs")) {
+      for (size_t saved_index = 0;
+           saved_index < std::min<size_t>(2000, candidates->size());
+           ++saved_index) {
+        const base::DictValue *saved = (*candidates)[saved_index].GetIfDict();
+        const std::string url =
+            saved ? SafeTabUrl(saved->Find("url"), false) : std::string();
+        if (!saved || url.empty()) {
+          continue;
+        }
+        base::DictValue clean;
+        const std::string tab_id = Identifier(saved->Find("tabId"));
+        clean.Set("tabId",
+                  tab_id.empty() ? base::Value() : base::Value(tab_id));
+        clean.Set("url", url);
+        std::string title = BoundedText(saved->Find("title"), 512, url);
+        clean.Set("title", title.empty() ? url : title);
+        saved_tabs.Append(std::move(clean));
+      }
+    }
+    const bool saved = BooleanOr(raw->Find("saved"));
+    if ((!saved && tab_ids.empty()) ||
+        (saved && tab_ids.empty() && saved_tabs.empty())) {
+      continue;
+    }
+    base::DictValue group;
+    group.Set("id", id);
+    std::string title = BoundedText(raw->Find("title"), 160, "Tab Group");
+    group.Set("title", title.empty() ? "Tab Group" : title);
+    group.Set("tabIds", std::move(tab_ids));
+    group.Set("section",
+              StringOr(raw, "section") == "pinned" ? "pinned" : "today");
+    group.Set("keepExpanded", BooleanOr(raw->Find("keepExpanded")));
+    group.Set("collapsed", BooleanOr(raw->Find("collapsed")));
+    group.Set("saved", saved);
+    group.Set("savedTabs", std::move(saved_tabs));
+    groups.Append(std::move(group));
+  }
+  return groups;
+}
+
+std::optional<base::DictValue> SanitizeOrganization(const base::DictValue &raw,
+                                                    bool native_state) {
+  const base::ListValue *raw_profiles = raw.FindList("profiles");
+  const base::ListValue *raw_spaces = raw.FindList("spaces");
+  if (!raw_profiles || !raw_spaces) {
+    return std::nullopt;
+  }
+
+  std::set<std::string> profile_ids;
+  std::set<std::string> tab_ids;
+  std::map<std::string, std::set<std::string>> favorites_by_profile;
+  base::ListValue profiles;
+  for (size_t index = 0; index < std::min<size_t>(32, raw_profiles->size());
+       ++index) {
+    const base::DictValue *source = (*raw_profiles)[index].GetIfDict();
+    const std::string id = source ? Identifier(source->Find("id")) : "";
+    if (!source || id.empty() || !profile_ids.insert(id).second) {
+      continue;
+    }
+    base::ListValue favorites = SanitizeTabs(source->FindList("favorites"), 500,
+                                             native_state, &tab_ids);
+    for (const base::Value &favorite : favorites) {
+      favorites_by_profile[id].insert(*favorite.GetDict().FindString("id"));
+    }
+    base::DictValue profile;
+    profile.Set("id", id);
+    std::string name = BoundedText(source->Find("name"), 120, "Profile");
+    profile.Set("name", name.empty() ? "Profile" : name);
+    profile.Set("favorites", std::move(favorites));
+    profile.Set("disabledExtensions", base::ListValue());
+    profiles.Append(std::move(profile));
+  }
+  if (profiles.empty()) {
+    return std::nullopt;
+  }
+  const std::string first_profile_id =
+      *profiles.front().GetDict().FindString("id");
+
+  std::set<std::string> space_ids;
+  base::ListValue spaces;
+  for (size_t index = 0; index < std::min<size_t>(128, raw_spaces->size());
+       ++index) {
+    const base::DictValue *source = (*raw_spaces)[index].GetIfDict();
+    const std::string id = source ? Identifier(source->Find("id")) : "";
+    if (!source || id.empty() || !space_ids.insert(id).second) {
+      continue;
+    }
+    std::string profile_id = Identifier(source->Find("profileId"));
+    if (!profile_ids.contains(profile_id)) {
+      profile_id = first_profile_id;
+    }
+    std::set<std::string> removed_tab_ids;
+    base::ListValue removed_tabs = SanitizeRemovedTabIds(
+        source->FindList("syncRemovedTabIds"), &removed_tab_ids);
+    base::ListValue pinned = SanitizeTabs(source->FindList("pinned"), 2000,
+                                          native_state, &tab_ids,
+                                          &removed_tab_ids);
+    base::ListValue today = SanitizeTabs(source->FindList("today"), 2000,
+                                         native_state, &tab_ids,
+                                         &removed_tab_ids);
+    std::set<std::string> allowed = favorites_by_profile[profile_id];
+    for (const base::Value &tab : pinned) {
+      allowed.insert(*tab.GetDict().FindString("id"));
+    }
+    for (const base::Value &tab : today) {
+      allowed.insert(*tab.GetDict().FindString("id"));
+    }
+
+    base::DictValue space;
+    space.Set("id", id);
+    std::string name = BoundedText(source->Find("name"), 120, "Workspace");
+    space.Set("name", name.empty() ? "Workspace" : name);
+    std::string icon = BoundedText(source->Find("icon"), 32, "🌊");
+    space.Set("icon", icon.empty() ? "🌊" : icon);
+    const std::string theme = StringOr(source, "theme", "aurora");
+    space.Set("theme", IsTheme(theme) ? theme : "aurora");
+    space.Set("profileId", profile_id);
+    space.Set("pinned", std::move(pinned));
+    space.Set("today", std::move(today));
+    space.Set("syncRemovedTabIds", std::move(removed_tabs));
+    space.Set("tabGroups",
+              SanitizeGroups(source->FindList("tabGroups"), allowed));
+    std::optional<base::Value> split =
+        SanitizeSplit(source->Find("split"), allowed, 0);
+    space.Set("split", split ? std::move(*split) : base::Value());
+    const std::string split_title =
+        BoundedText(source->Find("splitTitle"), 160);
+    space.Set("splitTitle",
+              split_title.empty() ? base::Value() : base::Value(split_title));
+    space.Set("splitKeepExpanded",
+              BooleanOr(source->Find("splitKeepExpanded")));
+    base::DictValue sort;
+    const base::DictValue *raw_sort = source->FindDict("tabSort");
+    const std::string criterion = StringOr(raw_sort, "criterion");
+    sort.Set("criterion", criterion == "recent-asc" ||
+                                  criterion == "alphabetical" ||
+                                  criterion == "site"
+                              ? criterion
+                              : "recent-desc");
+    sort.Set("keep", raw_sort && raw_sort->FindBool("keep").value_or(false));
+    space.Set("tabSort", std::move(sort));
+    const std::string active = Identifier(source->Find("activeTabId"));
+    space.Set("activeTabId",
+              allowed.contains(active) ? base::Value(active) : base::Value());
+    spaces.Append(std::move(space));
+  }
+  if (spaces.empty()) {
+    return std::nullopt;
+  }
+
+  // References to filtered tabs cannot survive the allowlist boundary.
+  for (base::Value &profile : profiles) {
+    for (base::Value &tab : *profile.GetDict().FindList("favorites")) {
+      const std::string *opener = tab.GetDict().FindString("openerTabId");
+      if (opener && !tab_ids.contains(*opener)) {
+        tab.GetDict().Set("openerTabId", base::Value());
+      }
+    }
+  }
+  for (base::Value &space : spaces) {
+    for (std::string_view section : {"pinned", "today"}) {
+      for (base::Value &tab : *space.GetDict().FindList(section)) {
+        const std::string *opener = tab.GetDict().FindString("openerTabId");
+        if (opener && !tab_ids.contains(*opener)) {
+          tab.GetDict().Set("openerTabId", base::Value());
+        }
+      }
+    }
+  }
+
+  base::ListValue bookmarks;
+  if (const base::ListValue *raw_bookmarks = raw.FindList("bookmarks")) {
+    std::set<std::string> bookmark_ids;
+    for (size_t index = 0;
+         index < std::min<size_t>(10000, raw_bookmarks->size()); ++index) {
+      const base::DictValue *source = (*raw_bookmarks)[index].GetIfDict();
+      const std::string url =
+          source ? SafeTabUrl(source->Find("url"), false) : std::string();
+      GURL parsed(url);
+      if (!source || !parsed.SchemeIsHTTPOrHTTPS()) {
+        continue;
+      }
+      std::string id = Identifier(source->Find("id"));
+      if (id.empty()) {
+        id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+      }
+      if (!bookmark_ids.insert(id).second) {
+        continue;
+      }
+      base::DictValue bookmark;
+      bookmark.Set("id", id);
+      bookmark.Set("url", url);
+      std::string title = BoundedText(source->Find("title"), 512, url);
+      bookmark.Set("title", title.empty() ? url : title);
+      const std::string favicon = SafeFavicon(source->Find("favicon"));
+      bookmark.Set("favicon",
+                   favicon.empty() ? base::Value() : base::Value(favicon));
+      const std::string profile_id = Identifier(source->Find("profileId"));
+      bookmark.Set("profileId", profile_ids.contains(profile_id)
+                                    ? base::Value(profile_id)
+                                    : base::Value());
+      bookmark.Set("created", NumberOr(source->Find("created")));
+      const base::Value *last_opened = source->Find("lastOpened");
+      bookmark.Set("lastOpened", last_opened && !last_opened->is_none()
+                                     ? base::Value(NumberOr(last_opened))
+                                     : base::Value());
+      bookmarks.Append(std::move(bookmark));
+    }
+  }
+
+  std::string active_space = Identifier(raw.Find("activeSpaceId"));
+  if (!space_ids.contains(active_space)) {
+    active_space = *spaces.front().GetDict().FindString("id");
+  }
+  base::DictValue organization;
+  organization.Set("type", "viola-browser-organization");
+  organization.Set("version", 1);
+  organization.Set("exportedAt",
+                   BoundedText(raw.Find("exportedAt"), 64, "native"));
+  organization.Set("settings", SanitizeSettings(raw.FindDict("settings")));
+  organization.Set("profiles", std::move(profiles));
+  organization.Set("spaces", std::move(spaces));
+  organization.Set("activeSpaceId", active_space);
+  organization.Set("bookmarks", std::move(bookmarks));
+  CanonicalizePersonalIdentity(&organization);
+  return organization;
+}
