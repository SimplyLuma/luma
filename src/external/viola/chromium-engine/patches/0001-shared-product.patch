diff --git a/chrome/browser/resources/viola/mobile-simulator.css b/chrome/browser/resources/viola/mobile-simulator.css
new file mode 100644
index 0000000000000000000000000000000000000000..c6b66d3a5bb9a0a613a26d8cc407cc363d4387bc
--- /dev/null
+++ b/chrome/browser/resources/viola/mobile-simulator.css
@@ -0,0 +1,458 @@
+:root {
+  color-scheme: light dark;
+  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
+  --ink: #24243a;
+  --muted: #858598;
+  --panel: rgba(252, 252, 254, .94);
+  --panel-solid: #fcfcfe;
+  --stroke: rgba(38, 34, 58, .13);
+  --shadow: 0 14px 38px rgba(15, 12, 25, .15), 0 2px 7px rgba(15, 12, 25, .07);
+  --accent: #605de0;
+  --device-scale: 1;
+}
+
+* { box-sizing: border-box; }
+[hidden] { display: none !important; }
+html, body, #simulator { width: 100%; height: 100%; margin: 0; overflow: hidden; }
+body { background: transparent; color: var(--ink); user-select: none; }
+button, input { font: inherit; }
+button { color: inherit; }
+
+#simulator {
+  position: relative;
+  isolation: isolate;
+  background-color: #242936;
+  transition: background .24s ease;
+}
+
+#simulator.background-graphite {
+  background:
+    radial-gradient(circle at 50% 24%, rgba(255,255,255,.075), transparent 34%),
+    linear-gradient(145deg, var(--surface-color, #242936), var(--surface-accent, #111522));
+}
+#simulator.background-slate {
+  background:
+    radial-gradient(circle at 20% 12%, rgba(196,210,255,.22), transparent 28%),
+    linear-gradient(145deg, var(--surface-color, #556174), var(--surface-accent, #202838));
+}
+#simulator.background-concrete {
+  background-color: var(--surface-color, #9c9b9a);
+  background-image:
+    radial-gradient(circle at 20% 30%, rgba(255,255,255,.16) 0 1px, transparent 1.5px),
+    radial-gradient(circle at 70% 65%, rgba(0,0,0,.1) 0 1px, transparent 1.5px),
+    linear-gradient(145deg, rgba(255,255,255,.13), rgba(0,0,0,.11));
+  background-size: 17px 19px, 23px 29px, auto;
+}
+#simulator.background-walnut {
+  background-color: #5a321d;
+  background-image:
+    repeating-radial-gradient(ellipse at 15% 120%, transparent 0 25px, rgba(20,7,1,.16) 27px 29px, transparent 31px 52px),
+    repeating-linear-gradient(4deg, rgba(255,214,156,.025) 0 2px, transparent 2px 11px),
+    linear-gradient(100deg, #6f4126, #402114 48%, #63381f);
+  background-size: 370px 135px, auto, auto;
+}
+#simulator.background-solid { background: var(--surface-color, #242936); }
+
+button {
+  border: 0;
+  background: none;
+  cursor: default;
+}
+button:focus-visible, input:focus-visible { outline: 2px solid color-mix(in srgb, var(--accent) 72%, white); outline-offset: 1px; }
+
+.floating-button, .floating-toolbar, #device-drawer, .popover {
+  background: var(--panel);
+  border: .5px solid var(--stroke);
+  box-shadow: var(--shadow);
+  -webkit-backdrop-filter: blur(28px) saturate(1.18);
+  backdrop-filter: blur(28px) saturate(1.18);
+}
+
+.drawer-toggle {
+  position: absolute;
+  z-index: 20;
+  top: 14px;
+  left: 14px;
+  min-width: 174px;
+  height: 44px;
+  padding: 5px 10px;
+  border-radius: 13px;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  text-align: left;
+}
+.drawer-toggle .icon { font-size: 24px; line-height: 1; transform: rotate(180deg); }
+.drawer-toggle-copy { display: flex; flex-direction: column; min-width: 0; flex: 1; }
+.drawer-toggle-copy strong { font-size: 12px; line-height: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.drawer-toggle-copy small { color: var(--muted); font-size: 10px; line-height: 13px; }
+.drawer-toggle .chevron { color: var(--muted); font-size: 18px; }
+
+#device-drawer {
+  position: absolute;
+  z-index: 30;
+  inset: 12px auto 12px 12px;
+  width: 236px;
+  border-radius: 18px;
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+  transform: translateX(calc(-100% - 18px));
+  opacity: 0;
+  transition: transform .24s cubic-bezier(.2,.85,.25,1), opacity .18s ease;
+}
+#simulator.drawer-open #device-drawer { transform: translateX(0); opacity: 1; }
+
+.drawer-header {
+  min-height: 58px;
+  padding: 11px 10px 8px 14px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+.drawer-header div { display: flex; flex-direction: column; }
+.drawer-header strong { font-size: 13px; line-height: 18px; }
+.drawer-header small { color: var(--muted); font-size: 10px; }
+.device-search {
+  height: 32px;
+  margin: 0 9px 8px;
+  border-radius: 9px;
+  background: rgba(75, 70, 91, .08);
+  box-shadow: inset 0 0 0 .5px rgba(50,45,68,.08);
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 0 9px;
+  color: var(--muted);
+}
+.device-search input {
+  border: 0;
+  outline: 0;
+  background: transparent;
+  color: var(--ink);
+  min-width: 0;
+  width: 100%;
+  font-size: 12px;
+}
+#device-list { overflow: auto; padding: 0 8px 12px; scrollbar-width: thin; }
+.device-category { margin: 8px 5px 4px; color: var(--muted); font-size: 9px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
+.device-row {
+  width: 100%;
+  min-height: 39px;
+  border-radius: 9px;
+  padding: 5px 8px;
+  display: grid;
+  grid-template-columns: 22px minmax(0,1fr) auto;
+  align-items: center;
+  gap: 6px;
+  text-align: left;
+}
+.device-row:hover { background: rgba(91,86,118,.08); }
+.device-row.active { color: white; background: var(--accent); }
+.device-row .phone-icon { font-size: 15px; opacity: .78; }
+.device-row .device-copy { min-width: 0; display: flex; flex-direction: column; }
+.device-row b { font-size: 12px; line-height: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.device-row small { font-size: 9px; line-height: 12px; opacity: .68; }
+.device-row .fold-tag { color: #e44b24; font-size: 9px; font-weight: 700; }
+.device-row.active .fold-tag { color: white; opacity: .75; }
+
+.floating-toolbar {
+  position: absolute;
+  z-index: 18;
+  min-height: 38px;
+  border-radius: 12px;
+  display: flex;
+  align-items: center;
+  gap: 3px;
+  padding: 4px;
+}
+#top-toolbar { top: 14px; left: 50%; transform: translateX(-50%); }
+.bottom-toolbar { right: 14px; bottom: 14px; }
+.toolbar-divider { width: .5px; align-self: stretch; margin: 2px 3px; background: rgba(40,35,55,.12); }
+.icon-button, .toolbar-device, .zoom-value {
+  height: 29px;
+  min-width: 29px;
+  padding: 0 8px;
+  border-radius: 8px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  font-size: 11px;
+  white-space: nowrap;
+}
+.icon-button:hover, .toolbar-device:hover, .zoom-value:hover { background: rgba(74,68,94,.09); }
+.icon-button.active { color: white; background: var(--accent); }
+.icon-button.labeled { padding-inline: 9px; }
+.toolbar-device { max-width: 154px; font-weight: 650; }
+.toolbar-device #device-name { overflow: hidden; text-overflow: ellipsis; }
+.device-glyph { font-size: 17px; }
+.dimension-field {
+  width: 45px;
+  height: 27px;
+  border-radius: 7px;
+  background: rgba(70,65,85,.055);
+  box-shadow: inset 0 0 0 .5px rgba(45,40,60,.1);
+  display: grid;
+  place-items: center;
+}
+.dimension-field input { width: 100%; border: 0; outline: 0; background: transparent; color: inherit; text-align: center; font-size: 11px; }
+.dimension-field input:disabled { opacity: .52; }
+.dimension-x, .pixel-ratio { color: var(--muted); font-size: 10px; }
+.pixel-ratio { padding: 0 3px; }
+.zoom-value { min-width: 42px; color: var(--muted); font-size: 10px; }
+
+#stage {
+  position: absolute;
+  z-index: 1;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  padding: 76px 54px 64px;
+  transition: padding .24s ease;
+}
+#simulator.drawer-open #stage { padding-left: 268px; }
+
+#device-wrap {
+  position: relative;
+  width: max-content;
+  height: max-content;
+  transform: scale(var(--device-scale));
+  transform-origin: center;
+  will-change: transform;
+}
+#device-shell {
+  position: relative;
+  padding: var(--device-bezel, 11px);
+  background: linear-gradient(145deg, #3e424b, #12141a 72%);
+  border: 1px solid rgba(255,255,255,.25);
+  border-radius: calc(var(--device-radius, 48px) + var(--device-bezel, 11px));
+  box-shadow:
+    0 36px 70px rgba(0,0,0,.34),
+    0 8px 20px rgba(0,0,0,.25),
+    inset 0 0 0 1px rgba(0,0,0,.65),
+    inset 0 0 0 2px rgba(255,255,255,.1);
+}
+#device-screen {
+  position: relative;
+  width: var(--viewport-width, 390px);
+  height: var(--viewport-height, 844px);
+  overflow: hidden;
+  border-radius: var(--device-radius, 48px);
+  background: white;
+  isolation: isolate;
+}
+#simulator.dark-scheme #device-screen { background: #111; }
+#mobile-page {
+  position: absolute;
+  display: flex;
+  left: var(--page-left, 0);
+  top: var(--page-top, 0);
+  width: var(--page-width, 100%);
+  height: var(--page-height, 100%);
+  border: 0;
+  background: white;
+}
+#touch-glass {
+  position: absolute;
+  z-index: 8;
+  left: var(--page-left, 0);
+  top: var(--page-top, 0);
+  width: var(--page-width, 100%);
+  height: var(--page-height, 100%);
+  pointer-events: none;
+  touch-action: none;
+}
+#simulator.touch-enabled #touch-glass { pointer-events: auto; cursor: none; }
+
+#device-status {
+  --status-side-inset: 24px;
+  position: absolute;
+  z-index: 10;
+  top: 0;
+  left: 0;
+  right: 0;
+  height: var(--status-height, 47px);
+  padding: 9px var(--status-side-inset) 0;
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-start;
+  color: #111;
+  font-size: 13px;
+  line-height: 15px;
+  pointer-events: none;
+  text-shadow: none;
+}
+#device-time { font-weight: 650; letter-spacing: -.025em; }
+#simulator.dark-scheme #device-status { color: #fff; text-shadow: none; }
+#simulator.no-status #device-status,
+#simulator.landscape #device-status { display: none; }
+.status-icons { height: 15px; display: flex; align-items: center; gap: 5px; }
+.status-icon { display: block; flex: none; overflow: visible; }
+.status-signal { width: 17px; height: 11px; fill: currentColor; }
+.status-wifi { width: 16px; height: 12px; fill: currentColor; }
+.status-wifi path {
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.65;
+  stroke-linecap: round;
+}
+.status-battery { width: 24px; height: 12px; }
+.battery-outline {
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.35;
+}
+.battery-level { fill: currentColor; }
+.battery-cap {
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.8;
+  stroke-linecap: round;
+  opacity: .48;
+}
+
+#device-cutout { position: absolute; z-index: 12; top: 0; left: 50%; transform: translateX(-50%); background: #060708; pointer-events: none; }
+#device-shell.cutout-island #device-cutout { top: 11px; width: var(--cutout-width,125px); height: var(--cutout-height,37px); border-radius: 999px; }
+#device-shell.cutout-notch #device-cutout { width: var(--cutout-width,162px); height: var(--cutout-height,34px); border-radius: 0 0 22px 22px; }
+#device-shell.cutout-camera #device-cutout { top: 10px; width: 14px; height: 14px; border-radius: 50%; box-shadow: inset 0 0 0 4px #111, inset 0 0 0 5px #32435a; }
+#device-shell.cutout-none #device-cutout { display: none; }
+#simulator.landscape #device-shell.os-ios #device-cutout {
+  top: 50%;
+  left: 0;
+  transform: translateY(-50%);
+  border-radius: 0 22px 22px 0;
+}
+#simulator.landscape #device-shell.os-ios.cutout-island #device-cutout {
+  left: 11px;
+  width: var(--cutout-height,37px);
+  height: var(--cutout-width,125px);
+  border-radius: 999px;
+}
+#device-gesture { position: absolute; z-index: 11; left: 50%; bottom: 8px; transform: translateX(-50%); width: 34%; max-width: 134px; height: 5px; border-radius: 999px; background: #151515; pointer-events: none; }
+#simulator.dark-scheme #device-gesture { background: #f5f5f5; }
+#simulator.landscape #device-shell.os-ios #device-gesture {
+  left: auto;
+  right: 8px;
+  bottom: 50%;
+  width: 5px;
+  height: 34%;
+  transform: translateY(50%);
+}
+#device-shell.os-android #device-gesture { width: 29%; height: 4px; bottom: 6px; opacity: .82; }
+#device-crease { display: none; position: absolute; z-index: 9; pointer-events: none; }
+#device-shell.crease-vertical #device-crease { display: block; top: 0; bottom: 0; left: 50%; width: 14px; transform: translateX(-50%); background: linear-gradient(90deg, transparent, rgba(20,20,30,.09), rgba(255,255,255,.13), rgba(20,20,30,.08), transparent); mix-blend-mode: multiply; }
+#device-shell.crease-horizontal #device-crease { display: block; left: 0; right: 0; top: 50%; height: 14px; transform: translateY(-50%); background: linear-gradient(transparent, rgba(20,20,30,.09), rgba(255,255,255,.13), rgba(20,20,30,.08), transparent); mix-blend-mode: multiply; }
+
+#simulator.frame-off #device-shell { padding: 0; border: 0; background: transparent; box-shadow: 0 24px 55px rgba(0,0,0,.25); border-radius: var(--device-radius,48px); }
+#simulator.frame-off #device-status,
+#simulator.frame-off #device-cutout,
+#simulator.frame-off #device-gesture { display: none; }
+
+#resize-handle {
+  display: none;
+  position: absolute;
+  z-index: 20;
+  width: 24px;
+  height: 24px;
+  right: -9px;
+  bottom: -9px;
+  border-radius: 50%;
+  background: var(--accent);
+  box-shadow: 0 3px 12px rgba(20,15,50,.3), inset 0 0 0 3px white;
+  cursor: nwse-resize;
+}
+#simulator.unlocked #resize-handle { display: block; }
+
+#touch-cursor {
+  position: absolute;
+  z-index: 50;
+  display: none;
+  width: 28px;
+  height: 28px;
+  margin: -14px 0 0 -14px;
+  border-radius: 50%;
+  background: rgba(255,255,255,.55);
+  border: 1px solid rgba(15,18,30,.42);
+  box-shadow: 0 2px 10px rgba(0,0,0,.18);
+  pointer-events: none;
+}
+#simulator.touch-enabled.pointer-over #touch-cursor { display: block; }
+#simulator.touch-enabled.pointer-down #touch-cursor { transform: scale(.78); background: rgba(96,93,224,.38); }
+
+.popover-wrap { position: relative; }
+.popover {
+  position: absolute;
+  right: 0;
+  bottom: calc(100% + 8px);
+  width: 236px;
+  border-radius: 13px;
+  padding: 6px;
+  transform-origin: bottom right;
+  animation: pop-in .13s ease-out;
+}
+@keyframes pop-in { from { opacity: 0; transform: translateY(5px) scale(.98); } }
+.popover > strong { display: block; padding: 4px 7px 5px; font-size: 11px; }
+.popover button {
+  width: 100%;
+  min-height: 40px;
+  padding: 4px 7px;
+  border-radius: 9px;
+  display: grid;
+  grid-template-columns: 24px 1fr;
+  align-items: center;
+  gap: 6px;
+  text-align: left;
+}
+.popover button:hover { background: rgba(75,70,95,.08); }
+.popover button > span:last-child { display: flex; min-width: 0; flex-direction: column; }
+.popover b { font-size: 11px; line-height: 15px; }
+.popover small { color: var(--muted); font-size: 9px; line-height: 13px; }
+.background-options { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; padding: 2px 4px 9px; }
+.background-swatch { aspect-ratio: 1; min-height: 0 !important; padding: 0 !important; border-radius: 9px !important; border: 1px solid rgba(20,18,34,.16); }
+.background-swatch.active { box-shadow: 0 0 0 2px var(--panel-solid), 0 0 0 4px var(--accent); }
+.background-swatch[data-bg="graphite"] { background: linear-gradient(145deg,#394052,#111521); }
+.background-swatch[data-bg="slate"] { background: linear-gradient(145deg,#8491aa,#273045); }
+.background-swatch[data-bg="concrete"] { background: linear-gradient(145deg,#b9b8b6,#7d7b79); }
+.background-swatch[data-bg="walnut"] { background: repeating-linear-gradient(4deg,#75462b 0 5px,#492716 6px 9px); }
+.background-swatch[data-bg="solid"] { background: var(--surface-color,#242936); }
+.color-row { height: 34px; padding: 0 6px; border-top: .5px solid var(--stroke); display: flex; align-items: center; justify-content: space-between; font-size: 10px; color: var(--muted); }
+.color-row input { width: 30px; height: 22px; padding: 0; border: 0; border-radius: 6px; background: none; }
+
+#simulator-toast {
+  position: absolute;
+  z-index: 80;
+  left: 50%;
+  bottom: 18px;
+  transform: translate(-50%, 8px);
+  padding: 8px 12px;
+  border-radius: 10px;
+  background: rgba(25,23,36,.88);
+  color: white;
+  box-shadow: 0 7px 24px rgba(0,0,0,.24);
+  font-size: 11px;
+  opacity: 0;
+  pointer-events: none;
+  transition: opacity .16s, transform .16s;
+}
+#simulator-toast.visible { opacity: 1; transform: translate(-50%,0); }
+
+body.capture-transparent #simulator { background: transparent !important; }
+body.capture-transparent .floating-button,
+body.capture-transparent .floating-toolbar,
+body.capture-transparent #device-drawer,
+body.capture-transparent #simulator-toast { display: none !important; }
+body.capture-device .floating-button,
+body.capture-device .floating-toolbar,
+body.capture-device #device-drawer,
+body.capture-device #simulator-toast { display: none !important; }
+
+@media (max-width: 900px) {
+  #top-toolbar { left: auto; right: 12px; transform: none; }
+  .toolbar-device, #pixel-ratio, .dimension-field, .dimension-x { display: none; }
+  .icon-button.labeled span:last-child { display: none; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation-duration: .001ms !important; transition-duration: .001ms !important; }
+}
