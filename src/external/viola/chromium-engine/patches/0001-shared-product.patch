+
+SkColor ParseFrameColor(std::string_view value, SkColor fallback) {
+  uint32_t rgb = 0;
+  return value.size() == 7 && value.front() == '#' &&
+                 base::HexStringToUInt(value.substr(1), &rgb)
+             ? SkColorSetRGB((rgb >> 16) & 0xff, (rgb >> 8) & 0xff, rgb & 0xff)
+             : fallback;
+}
+
+class ViolaFrameBackground final : public views::Background {
+ public:
+  ViolaFrameBackground(SkColor first, SkColor second, SkColor third)
+      : colors_{SkColor4f::FromColor(first), SkColor4f::FromColor(second),
+                SkColor4f::FromColor(third)} {}
+
+  void Paint(gfx::Canvas *canvas, views::View *view) const override {
+    const gfx::Rect bounds = view->GetContentsBounds();
+    const SkPoint points[] = {
+        gfx::PointToSkPoint(bounds.top_right()),
+        gfx::PointToSkPoint(bounds.bottom_left())};
+    constexpr SkScalar positions[] = {0.0f, 0.55f, 1.0f};
+    cc::PaintFlags flags;
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setShader(cc::PaintShader::MakeLinearGradient(
+        points, colors_, positions, 3, SkTileMode::kClamp));
+    canvas->DrawRect(bounds, flags);
+  }
+
+ private:
+  const SkColor4f colors_[3];
+};
