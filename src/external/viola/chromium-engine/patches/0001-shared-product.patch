+  .luma-settings .browser-pref-controls { min-width:0; flex-basis:100%; }
+  .luma-settings .library-tools { top:-24px; }
+}
+@media(max-width:520px) {
+  body.luma-settings { flex-direction:column; }
+  .luma-settings nav { width:100%; max-height:176px; flex-direction:row; flex-wrap:wrap; padding:10px; gap:4px; border-right:0; border-bottom:1px solid var(--hairline); }
+  .luma-settings nav .item { width:auto; }
+  .luma-settings :is(.settings-brand,.nav-section) { display:none; }
+  .luma-settings .settings-search { margin:0; }
+  .luma-settings main { padding:20px 16px 40px; }
+  .luma-settings .metric-grid { grid-template-columns:1fr; }
+}
+
+/* Keep Chromium's real select semantics while rendering its picker in the
+   captured page, rather than a separate window on the private engine display. */
+@supports (appearance: base-select) {
+  .luma-settings select,
+  .luma-settings select::picker(select) { appearance:base-select; }
+  .luma-settings select { padding-right:12px; gap:12px; }
+  .luma-settings select::picker(select) {
+    color:var(--ink); background:var(--luma-menu); border:1px solid var(--luma-menu-border);
+    border-radius:10px; padding:6px; margin-top:4px;
+    box-shadow:0 8px 24px var(--luma-island-shadow);
+    min-width:anchor-size(width); max-height:320px; overflow:auto;
+    font:inherit;
+  }
+  .luma-settings select option { padding:8px 12px; border-radius:6px; gap:8px; }
+  .luma-settings select option:hover,
+  .luma-settings select option:focus-visible { background:var(--luma-hover); outline:none; }
+  .luma-settings select option:checked { font-weight:600; }
+  .luma-settings select option:disabled { opacity:.5; }
+}
diff --git a/chrome/browser/resources/viola/settings-luma.js b/chrome/browser/resources/viola/settings-luma.js
new file mode 100644
index 0000000000000000000000000000000000000000..f5091a4fd060b6d70428a60969e0c012ae76f6dd
--- /dev/null
+++ b/chrome/browser/resources/viola/settings-luma.js
@@ -0,0 +1,114 @@
+'use strict';
+// Presentation and form behavior for the existing trusted Linux settings page.
+// No new transport, account state, or browser data store is introduced here.
+globalThis.LumaSettings = (() => {
+  const enabled = () => globalThis.vela?.platform === 'linux';
+  const groups = [
+    ['Browser', ['General', 'Appearance', 'Workspaces', 'Profiles']],
+    ['Personal', ['Account & Sync', 'Privacy']],
+    ['Library', ['History', 'Bookmarks', 'Downloads']],
+    ['More', ['Extensions', 'Shortcuts', 'About']],
+  ];
+  const keywords = {
+    General:'homepage search import language accessibility default',
+    'Account & Sync':'login sign in password email devices recovery',
+    Appearance:'theme colors sidebar layout dark light',
+    Privacy:'cookies permissions security passwords analytics browsing data',
+    History:'visited pages clear', Bookmarks:'saved pages favorites',
+    Downloads:'files transfers pause resume', Extensions:'addons store plugins',
+    Shortcuts:'keyboard hotkeys', About:'version updates',
+    Workspaces:'tabs spaces groups rename', Profiles:'identity isolation browsing',
+  };
+  function initialize() {
+    if (!enabled()) return;
+    document.body.classList.add('luma-settings');
+    const theme = matchMedia('(prefers-color-scheme: dark)');
+    const update = () => document.body.classList.toggle('dark', theme.matches);
+    theme.addEventListener('change', update);
+    update();
+  }
+  function navigation(nav, sections, current, choose) {
+    if (!enabled()) return false;
+    if (!nav.querySelector('.settings-search')) {
+      nav.replaceChildren();
+      const brand = document.createElement('div');
+      brand.className = 'settings-brand'; brand.textContent = 'Settings';
+      const search = document.createElement('input');
+      search.type = 'search'; search.className = 'settings-search';
+      search.placeholder = 'Find a setting'; search.setAttribute('aria-label','Find a settings section');
+      nav.append(brand,search);
+      search.addEventListener('input', () => filter(nav,search.value));
+      search.addEventListener('keydown', event => {
+        if (event.key === 'Enter') {
+          event.preventDefault(); nav.querySelector('.item:not([hidden])')?.click();
+        } else if (event.key === 'Escape') {
+          search.value = ''; filter(nav,'');
+        }
+      });
+      for (const [name, entries] of groups) {
+        const heading = document.createElement('div');
+        heading.className = 'nav-section'; heading.textContent = name;
+        nav.append(heading);
+        for (const entry of entries.filter(item => sections.includes(item))) {
+          const button = document.createElement('button');
+          button.type = 'button'; button.className = 'item'; button.textContent = entry;
+          button.dataset.section = entry;
+          button.addEventListener('click', () => choose(entry));
+          nav.append(button);
+        }
+      }
+      const empty = document.createElement('div');
+      empty.className = 'search-empty'; empty.textContent = 'No matching settings'; empty.hidden = true;
+      nav.append(empty);
+    }
+    for (const button of nav.querySelectorAll('.item')) {
+      const active = button.dataset.section === current;
+      button.classList.toggle('active',active);
+      button.setAttribute('aria-current',active ? 'page' : 'false');
+    }
+    return true;
+  }
+  function filter(nav, query) {
+    const needle = query.trim().toLowerCase();
+    for (const row of nav.querySelectorAll('.item')) {
+      row.hidden = !(row.dataset.section+' '+keywords[row.dataset.section]).toLowerCase().includes(needle);
+    }
+    for (const heading of nav.querySelectorAll('.nav-section')) heading.hidden = !!needle;
+    nav.querySelector('.search-empty').hidden = !!nav.querySelector('.item:not([hidden])');
+  }
+  function enhance(page) {
+    if (!enabled() || !page.isConnected) return;
+    for (const button of page.querySelectorAll('.seg button')) button.setAttribute('aria-pressed',String(button.classList.contains('on')));
+    for (const row of page.querySelectorAll('.setting')) {
+      const label = row.querySelector('.label');
+      const controls = row.querySelectorAll('input,select');
+      if (label && controls.length === 1 && !controls[0].hasAttribute('aria-label') && !controls[0].closest('label:not(.switch)')) {
+        controls[0].setAttribute('aria-label',label.textContent);
+      }
+    }
+    // An account card has exactly one primary submit action. Secondary mode,
+    // recovery and back buttons never receive implicit Enter submission.
+    for (const card of page.querySelectorAll('.card')) {
+      if (!card.querySelector('.account-form') || card.dataset.enterBound) continue;
+      card.dataset.enterBound = 'true';
+      card.setAttribute('role','form');
+      card.setAttribute('aria-label',card.querySelector('.label')?.textContent || 'Viola account');
+      const device = card.querySelector('[data-field=device]');
+      if (device && card.querySelector('[data-action=create]')) {
+        const details = document.createElement('details');
+        const summary = document.createElement('summary');
+        summary.textContent = 'Device name (optional)';
+        details.append(summary);
+        const label = device.closest('label');
+        label.before(details); details.append(label);
+      }
+      card.addEventListener('keydown', event => {
+        if (event.key !== 'Enter' || event.isComposing || event.target.tagName !== 'INPUT') return;
+        const button = card.querySelector('[data-action=create],[data-action=verify],[data-action=complete],[data-action=google],[data-action=save]');
+        if (button && !button.disabled) { event.preventDefault(); button.click(); }
+      });
+    }
+  }
+  return {enabled,initialize,navigation,enhance};
+})();
+LumaSettings.initialize();
