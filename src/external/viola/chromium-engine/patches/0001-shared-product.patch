+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8" />
+  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: file: http: https: chrome-extension:; font-src 'self' data:; media-src 'self' data: blob: http: https:; worker-src 'self' blob:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; child-src 'none'; frame-src 'none';">
+<title>Viola — Incognito</title>
+<style>
+  * { box-sizing:border-box; }
+  html,body { width:100%; height:100%; margin:0; }
+  body {
+    display:grid; place-items:center; color:#eeeaf8;
+    background:
+      radial-gradient(circle at 22% 12%,rgba(119,92,168,.24),transparent 35%),
+      radial-gradient(circle at 82% 80%,rgba(62,91,128,.18),transparent 38%),
+      #24212f;
+    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text",sans-serif;
+  }
+  main { width:min(520px,calc(100% - 64px)); transform:translateY(-20px); }
+  .mark {
+    width:58px; height:58px; border-radius:18px; margin-bottom:23px;
+    display:grid; place-items:center; background:rgba(255,255,255,.075);
+    box-shadow:inset 0 0 0 1px rgba(255,255,255,.075);
+  }
+  .mark svg { width:31px; height:31px; opacity:.9; }
+  h1 { margin:0 0 9px; font-size:28px; letter-spacing:-.55px; }
+  .lead { margin:0 0 30px; color:rgba(238,234,248,.66); font-size:14px; line-height:1.55; }
+  .facts { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
+  .fact { padding:15px 16px; border-radius:13px; background:rgba(255,255,255,.055); box-shadow:inset 0 0 0 1px rgba(255,255,255,.045); }
+  .fact strong { display:block; margin-bottom:5px; font-size:12.5px; }
+  .fact span { color:rgba(238,234,248,.55); font-size:11.8px; line-height:1.45; }
+  .note { margin-top:18px; color:rgba(238,234,248,.38); font-size:11.5px; line-height:1.5; }
+  @media(max-width:620px){.facts{grid-template-columns:1fr}main{transform:none}}
+</style>
+</head>
+<body>
+  <main>
+    <div class="mark">
+      <svg viewBox="0 0 32 32" fill="none"><path d="M8.5 13.5 11 6h10l2.5 7.5" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M5 15h22" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="10" cy="21" r="3.5" stroke="currentColor" stroke-width="1.8"/><circle cx="22" cy="21" r="3.5" stroke="currentColor" stroke-width="1.8"/><path d="M13.5 21h5" stroke="currentColor" stroke-width="1.8"/></svg>
+    </div>
+    <h1>You’re browsing privately</h1>
+    <p class="lead">This window uses a temporary session that stays separate from every Viola profile.</p>
+    <div class="facts">
+      <div class="fact"><strong>Viola won’t remember</strong><span>History, cookies, site storage, bookmarks, and open tabs from this session.</span></div>
+      <div class="fact"><strong>Your profiles stay separate</strong><span>Normal logins and extensions are not available inside this window.</span></div>
+    </div>
+    <p class="note">Downloads and changes made to external accounts can still remain after you close this window. Your network, employer, and websites may still observe activity.</p>
+  </main>
+</body>
+</html>
