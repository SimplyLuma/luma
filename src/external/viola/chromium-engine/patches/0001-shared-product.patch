+void ViolaMessageHandler::OnSplitTabChanged(const SplitTabChange &change) {
+  if (change.model != observed_tab_strip_ || !organization_store_ ||
+      !organization_store_->loaded() ||
+      change.type != SplitTabChange::Type::kVisualsChanged ||
+      !change.GetVisualsChange() ||
+      !change.model->ContainsSplit(change.split_id)) {
+    return;
+  }
+  split_tabs::SplitTabData *data = change.model->GetSplitData(change.split_id);
+  const std::vector<tabs::TabInterface *> members = data->ListTabs();
+  if (members.size() != 2) {
+    return;
+  }
+  const std::string first_id =
+      organization_store_->TabIdFor(members[0]->GetContents());
+  const std::string second_id =
+      organization_store_->TabIdFor(members[1]->GetContents());
+  const std::optional<viola::TabContextMenuState> first =
+      organization_store_->GetTabContextMenuState(first_id);
+  const std::optional<viola::TabContextMenuState> second =
+      organization_store_->GetTabContextMenuState(second_id);
+  if (!first || !second || first->space_id != second->space_id ||
+      !first->in_split || !second->in_split) {
+    return;
+  }
+  const split_tabs::SplitTabVisualData &visuals =
+      change.GetVisualsChange()->new_visual_data();
+  organization_store_->UpdateSplitVisuals(
+      first->space_id, first_id, second_id,
+      visuals.split_layout() == split_tabs::SplitTabLayout::kStacked ? "v"
+                                                                     : "h",
+      std::clamp(visuals.split_ratio(), 0.1, 0.9));
+}
