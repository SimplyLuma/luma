+// The opt-in GTK host presents this original model. No page action is
+// reimplemented, and delayed selections are tied to both model and owner.
+namespace {
+void SnapshotNativeMenuCommands(ui::MenuModel* model,
+    std::vector<size_t> parent, std::map<std::vector<size_t>, std::pair<int, std::u16string>>* result) {
+  if (!model || parent.size() >= 8) return;
+  for (size_t index = 0; index < model->GetItemCount() && index < 128; ++index) {
+    auto path = parent;
+    path.push_back(index);
+    if (model->GetTypeAt(index) == ui::MenuModel::TYPE_SUBMENU) {
+      SnapshotNativeMenuCommands(model->GetSubmenuModelAt(index), std::move(path), result);
+    } else {
+      result->emplace(std::move(path),
+                      std::make_pair(model->GetCommandIdAt(index), model->GetLabelAt(index)));
+    }
+  }
+}
+}  // namespace
+
+bool RenderViewContextMenuViews::TryShowNativeMenuProbe() {
+#if BUILDFLAG(IS_LINUX)
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("viola-native-menu-probe") ||
+      !GetBrowser() || menu_model_.GetItemCount() == 0) return false;
+  BrowserView* view = BrowserView::GetBrowserViewForBrowser(GetBrowser());
+  auto* shell = view ? view->viola_product_shell_view_for_testing() : nullptr;
+  auto* contents = shell ? shell->shell_web_contents() : nullptr;
+  auto* web_ui = contents ? contents->GetWebUI() : nullptr;
+  auto* controller = web_ui ? web_ui->GetController()->GetAs<ViolaUI>() : nullptr;
+  auto* handler = controller ? controller->message_handler_for_native_probe() : nullptr;
+  if (!handler || !GetRenderFrameHost()) return false;
+  native_menu_document_ = GetRenderFrameHost()->GetWeakDocumentPtr();
+  std::map<std::vector<size_t>, std::pair<int, std::u16string>> expected;
+  SnapshotNativeMenuCommands(&menu_model_, {}, &expected);
+  if (!handler->ShowNativePageMenuProbe(
+          &menu_model_, source_web_contents_,
+          base::BindOnce(&RenderViewContextMenuViews::ActivateNativeMenuProbe,
+                         native_probe_weak_factory_.GetWeakPtr(), std::move(expected)),
+          base::BindOnce(&RenderViewContextMenuViews::CloseNativeMenuProbe,
+                         native_probe_weak_factory_.GetWeakPtr()))) return false;
+  native_menu_probe_open_ = true;
+  OnMenuWillShow(&menu_model_);
+  return true;
+#else
+  return false;
+#endif
+}
+
+void RenderViewContextMenuViews::ActivateNativeMenuProbe(
+    std::map<std::vector<size_t>, std::pair<int, std::u16string>> expected, std::vector<size_t> path) {
+#if BUILDFLAG(IS_LINUX)
+  auto* source_document = native_menu_document_.AsRenderFrameHostIfValid();
+  if (!native_menu_probe_open_ || path.empty() || !GetBrowser() ||
+      !source_document || !source_document->IsActive()) return;
+  Browser* browser = GetBrowser()->GetBrowserForMigrationOnly();
+  if (!browser || browser->tab_strip_model()->GetActiveWebContents() != source_web_contents_) return;
+  auto command = expected.find(path);
+  if (command == expected.end()) return;
+  ui::MenuModel* model = &menu_model_;
+  for (size_t depth = 0; depth < path.size(); ++depth) {
+    size_t index = path[depth];
+    if (!model || index >= model->GetItemCount() || !model->IsVisibleAt(index) ||
+        !model->IsEnabledAt(index)) return;
+    if (depth + 1 < path.size()) {
+      if (model->GetTypeAt(index) != ui::MenuModel::TYPE_SUBMENU) return;
+      model = model->GetSubmenuModelAt(index);
+      continue;
+    }
+    auto type = model->GetTypeAt(index);
+    if ((type != ui::MenuModel::TYPE_COMMAND && type != ui::MenuModel::TYPE_CHECK &&
+         type != ui::MenuModel::TYPE_RADIO) || model->GetCommandIdAt(index) != command->second.first ||
+        model->GetLabelAt(index) != command->second.second) return;
+    model->ActivatedAt(index, 0);
+    return;
+  }
+#endif
+}
+
+void RenderViewContextMenuViews::CloseNativeMenuProbe() {
+  if (!native_menu_probe_open_) return;
+  native_menu_probe_open_ = false;
+  native_menu_document_ = content::WeakDocumentPtr();
+  MenuClosed(&menu_model_);
+}
