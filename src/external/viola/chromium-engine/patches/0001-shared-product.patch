+const bookmarks::BookmarkNode *
+FindBookmarkByStableId(bookmarks::BookmarkModel &model, std::string_view id) {
+  const base::Uuid uuid = base::Uuid::ParseLowercase(std::string(id));
+  if (!uuid.is_valid()) {
+    return nullptr;
+  }
+  const bookmarks::BookmarkNode *node = model.GetNodeByUuid(
+      uuid, bookmarks::BookmarkModel::NodeTypeForUuidLookup::kAccountNodes);
+  return node ? node
+              : model.GetNodeByUuid(
+                    uuid, bookmarks::BookmarkModel::NodeTypeForUuidLookup::
+                              kLocalOrSyncableNodes);
+}
