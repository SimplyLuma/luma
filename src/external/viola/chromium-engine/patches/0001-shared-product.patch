+
+void ViolaOrganizationStore::EnsureLoaded(base::OnceClosure callback) {
+  if (loaded_) {
+    std::move(callback).Run();
+    return;
+  }
+  loaded_callbacks_.push_back(std::move(callback));
+  if (loading_) {
+    return;
+  }
+  loading_ = true;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&ViolaOrganizationStore::LoadOnBackgroundSequence,
+                     native_path_, receipt_path_, legacy_path_),
+      base::BindOnce(&ViolaOrganizationStore::OnLoaded,
+                     weak_factory_.GetWeakPtr()));
+}
+
+// static
+ViolaOrganizationStore::LoadResult
+ViolaOrganizationStore::LoadOnBackgroundSequence(base::FilePath native_path,
+                                                 base::FilePath receipt_path,
+                                                 base::FilePath legacy_path) {
+  std::string native_source;
+  if (base::ReadFileToStringWithMaxSize(native_path, &native_source,
+                                        kMaximumOrganizationBytes)) {
+    std::optional<base::DictValue> existing =
+        ParseOrganization(native_source, true);
+    if (existing) {
+      return {.organization = std::move(*existing)};
+    }
+  }
+
+  std::string source_kind = "native-default";
+  std::string source_sha256;
+  std::string legacy_source;
+  std::optional<base::DictValue> organization;
+  if (!legacy_path.empty() && !base::IsLink(legacy_path) &&
+      base::ReadFileToStringWithMaxSize(legacy_path, &legacy_source,
+                                        kMaximumOrganizationBytes)) {
+    organization = ParseOrganization(legacy_source, false);
+    if (organization) {
+      source_kind = "electron-0.1";
+      source_sha256 = base::HexEncode(crypto::SHA256HashString(legacy_source));
+    }
+  }
+  if (!organization) {
+    organization = DefaultOrganization();
+  }
+
+  const std::string envelope =
+      SerializeEnvelope(*organization, source_kind, source_sha256);
+  if (!envelope.empty() && base::CreateDirectory(native_path.DirName()) &&
+      base::ImportantFileWriter::WriteFileAtomically(native_path, envelope,
+                                                     "ViolaOrganization")) {
+    base::DictValue counts;
+    counts.Set("profiles",
+               static_cast<int>(organization->FindList("profiles")->size()));
+    counts.Set("workspaces",
+               static_cast<int>(organization->FindList("spaces")->size()));
+    int tabs = 0;
+    for (const base::Value &profile : *organization->FindList("profiles")) {
+      tabs += profile.GetDict().FindList("favorites")->size();
+    }
+    int groups = 0;
+    for (const base::Value &space : *organization->FindList("spaces")) {
+      tabs += space.GetDict().FindList("pinned")->size();
+      tabs += space.GetDict().FindList("today")->size();
+      groups += space.GetDict().FindList("tabGroups")->size();
+    }
+    counts.Set("tabs", tabs);
+    counts.Set("tabGroups", groups);
+    counts.Set("bookmarks",
+               static_cast<int>(organization->FindList("bookmarks")->size()));
+    base::DictValue receipt;
+    receipt.Set("type", "viola-native-migration-receipt");
+    receipt.Set("version", 1);
+    receipt.Set(
+        "completedAtMilliseconds",
+        static_cast<double>(base::Time::Now().InMillisecondsSinceUnixEpoch()));
+    receipt.Set("sourceKind", source_kind);
+    receipt.Set("sourceSHA256", source_sha256);
+    receipt.Set("sourceBytes", static_cast<int>(legacy_source.size()));
+    receipt.Set("sourceWasModified", false);
+    receipt.Set("counts", std::move(counts));
+    std::string receipt_json;
+    if (base::JSONWriter::WriteWithOptions(
+            receipt, base::JSONWriter::OPTIONS_PRETTY_PRINT, &receipt_json)) {
+      receipt_json.push_back('\n');
+      base::ImportantFileWriter::WriteFileAtomically(receipt_path, receipt_json,
+                                                     "ViolaMigrationReceipt");
+    }
+  }
+  return {.organization = std::move(*organization)};
+}
+
+void ViolaOrganizationStore::OnLoaded(LoadResult result) {
+  organization_ = std::move(result.organization);
+  loading_ = false;
+  loaded_ = true;
+  // activeSpaceId identifies the real workspace that owns the selected tab;
+  // it is not the window's presentation lens. Native windows do not yet have
+  // a separate persisted window-session record, so start them in the lossless
+  // aggregate instead of silently collapsing the restored organization to the
+  // last real workspace (usually Personal).
+  workspace_lens_id_ = kAllWorkspacesId;
+  // Account sync is profile infrastructure, not a Settings-page side effect.
+  // Start it on every restart once both the canonical organization and the
+  // surrounding profile services have settled. Constructing the service
+  // synchronously here can race macOS secure-storage initialization and leave
+  // an already-linked profile permanently waiting for its encryptor.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&StartAccountSyncAfterProfileStartup,
+                     profile_->GetWeakPtr()),
+      base::Seconds(1));
+  std::vector<base::OnceClosure> callbacks = std::move(loaded_callbacks_);
+  loaded_callbacks_.clear();
+  for (base::OnceClosure &callback : callbacks) {
+    std::move(callback).Run();
+  }
+}
+
+std::string
+ViolaOrganizationStore::SessionTabIdFor(const content::WebContents *contents) {
+  if (!contents) {
+    return {};
+  }
+  const auto *identity =
+      static_cast<const TabIdentity *>(contents->GetUserData(kTabIdentityKey));
+  return identity ? identity->id : std::string();
+}
+
+std::string ViolaOrganizationStore::TabIdFor(
+    const content::WebContents* contents) const {
+  return SessionTabIdFor(contents);
+}
+
+void ViolaOrganizationStore::RestoreSessionTabIdentity(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data,
+    bool from_session_restore) {
+  // Explicit reopen/duplicate operations get a fresh live identity; only
+  // whole-session restore can safely reuse the saved organization identity.
+  if (!from_session_restore) return;
+  auto it = extra_data.find(kSessionTabIdKey);
+  if (contents && it != extra_data.end() && IsIdentifier(it->second))
+    contents->SetUserData(kTabIdentityKey,
+        std::make_unique<TabIdentity>(it->second, from_session_restore));
+}
+
+void ViolaOrganizationStore::PersistTabIdentity(content::WebContents* contents) {
+  auto* identity = contents ? static_cast<TabIdentity*>(
+      contents->GetUserData(kTabIdentityKey)) : nullptr;
+  if (!identity || identity->persisted) return;
+  auto* service = SessionServiceFactory::GetForProfile(profile_);
+  const SessionID window_id =
+      sessions::SessionTabHelper::IdForWindowContainingTab(contents);
+  const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (service && window_id.is_valid() && tab_id.is_valid()) {
+    service->AddTabExtraData(window_id, tab_id, kSessionTabIdKey, identity->id);
+    identity->persisted = true;
+  }
+}
+
+void ViolaOrganizationStore::BindTabIdentity(content::WebContents* contents,
+                                             const std::string& id) {
+  contents->SetUserData(kTabIdentityKey, std::make_unique<TabIdentity>(id));
+  PersistTabIdentity(contents);
+}
+
+void ViolaOrganizationStore::RemoveStaleRestoredTabs(TabStripModel* strip) {
+  if (!strip) return;
+  const std::set<std::string> removed = RemovedTabIds(organization_);
+  materializing_ = true;
+  for (int i = strip->count() - 1; i >= 0; --i) {
+    content::WebContents* contents = strip->GetWebContentsAt(i);
+    auto* identity = static_cast<TabIdentity*>(contents->GetUserData(kTabIdentityKey));
+    if (!identity || !identity->from_session_restore) continue;
+    identity->from_session_restore = false;
+    // An explicit reopen is not a cold restore. Only discard a page whose
+    // exact restored ID has a persisted removal tombstone and no live record.
+    if (!FindPersistentTab(organization_, identity->id) && removed.contains(identity->id)) {
+      if (strip->count() > 1) {
+        strip->CloseWebContentsAt(i, TabCloseTypes::CLOSE_NONE);
+      } else {
+        contents->RemoveUserData(kTabIdentityKey);
+        contents->GetController().LoadURL(GURL("about:blank"), content::Referrer(),
+                                          ui::PAGE_TRANSITION_AUTO_TOPLEVEL, std::string());
+      }
+    }
+  }
+  materializing_ = false;
+}
+
+int ViolaOrganizationStore::FindTabIndex(TabStripModel *tab_strip,
+                                         std::string_view tab_id) const {
+  if (!tab_strip) {
+    return TabStripModel::kNoTab;
+  }
+  for (int index = 0; index < tab_strip->count(); ++index) {
+    if (TabIdFor(tab_strip->GetWebContentsAt(index)) == tab_id) {
+      return index;
+    }
+  }
+  return TabStripModel::kNoTab;
+}
+
+content::WebContents *ViolaOrganizationStore::AddNewTabForActiveWorkspace(
+    BrowserWindowInterface *browser, TabStripModel *tab_strip, const GURL &url,
+    int insertion_index, bool foreground) {
+  base::DictValue *space =
+      loaded_ && browser && tab_strip &&
+              browser->GetTabStripModel() == tab_strip
+          ? FindSpace(organization_, StringOr(&organization_, "activeSpaceId"))
+          : nullptr;
+  if (!space) {
+    return nullptr;
+  }
+  content::WebContents *contents = chrome::AddAndReturnTabAt(
+      browser, ProfileNavigationUrl(url), insertion_index, foreground);
+  AddNewTab(contents, tab_strip);
+  return contents;
+}
+
+void ViolaOrganizationStore::AddNewTab(content::WebContents *contents,
+                                       TabStripModel *tab_strip) {
+  if (!loaded_ || !contents || !TabIdFor(contents).empty()) {
+    return;
+  }
+  base::DictValue *space =
+      FindSpace(organization_, StringOr(&organization_, "activeSpaceId"));
+  if (!space) {
+    return;
+  }
+  const std::string id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  BindTabIdentity(contents, id);
+  const GURL url = contents->GetVisibleURL();
+  base::DictValue tab;
+  tab.Set("id", id);
+  tab.Set("url", IsSafeTabUrl(url, true) ? url.spec() : "about:blank");
+  tab.Set("title", "New Tab");
+  tab.Set("favicon", base::Value());
+  tab.Set("createdAt", static_cast<double>(
+                           base::Time::Now().InMillisecondsSinceUnixEpoch()));
+  tab.Set(
+      "lastAccessed",
+      static_cast<double>(base::Time::Now().InMillisecondsSinceUnixEpoch()));
+  tab.Set("keepActive", false);
+  tab.Set("miniPlayerExcluded", false);
+  tab.Set("muted", false);
+  tab.Set("openerTabId", base::Value());
+  base::ListValue *today = space->FindList("today");
+  size_t insertion = today->size();
+  const int live_index = tab_strip ? tab_strip->GetIndexOfWebContents(contents)
+                                   : TabStripModel::kNoTab;
+  if (live_index > 0) {
+    const std::string predecessor =
+        TabIdFor(tab_strip->GetWebContentsAt(live_index - 1));
+    for (size_t index = 0; index < today->size(); ++index) {
+      if (StringOr(&(*today)[index].GetDict(), "id") == predecessor) {
+        insertion = index + 1;
+        break;
+      }
+    }
+  }
+  today->Insert(today->begin() + insertion, base::Value(std::move(tab)));
+  space->Set("activeTabId", id);
+  ScheduleWrite();
+}
+
+void ViolaOrganizationStore::OnSessionRestored(Profile* profile,
+                                                int restored_tabs) {
+  if (profile != profile_ || !restore_materialization_pending_) return;
+  // The completion notification runs inside SessionRestoreImpl. Wait until
+  // it has unwound and removed its profile's restoring marker.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ViolaOrganizationStore::FinishDeferredRestore,
+                               weak_factory_.GetWeakPtr()));
+}
+
+void ViolaOrganizationStore::FinishDeferredRestore() {
+  if (!loaded_ || !restore_materialization_pending_ ||
+      SessionRestore::IsRestoring(profile_)) return;
+  ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        if (!browser || browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+            !browser->GetTabStripModel() || browser->GetTabStripModel()->empty())
+          return true;
+        restore_materialization_pending_ = false;
+        ReconcileAndMaterialize(browser, browser->GetTabStripModel());
+        return false;
+      });
+}
+
+void ViolaOrganizationStore::ReconcileAndMaterialize(
+    BrowserWindowInterface *browser, TabStripModel *tab_strip) {
+  if (!loaded_ || !browser || !tab_strip || materializing_) {
+    return;
+  }
+  if (SessionRestore::IsRestoring(profile_)) {
+    restore_materialization_pending_ = true;
+    return;
+  }
+  restore_materialization_pending_ = false;
+  ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+      [&](BrowserWindowInterface* peer) {
+        if (peer && (peer->GetType() == BrowserWindowInterface::TYPE_NORMAL ||
+                     peer->GetType() == BrowserWindowInterface::TYPE_POPUP))
+          RemoveStaleRestoredTabs(peer->GetTabStripModel());
+        return true;
+      });
+  // Bind ALL restored peer strips before creating any missing saved tabs.
+  // A peer's WebContents user data is initially empty after session restore;
+  // materializing first would consume its saved identity and manufacture a
+  // second page, after which reconciliation gives the real restored page a
+  // fresh identity. URL matching remains one-to-one, preserving intentional
+  // same-URL tabs instead of collapsing them.
+  ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+      [&](BrowserWindowInterface* peer) {
+        if (peer && peer != browser &&
+            (peer->GetType() == BrowserWindowInterface::TYPE_NORMAL ||
+             peer->GetType() == BrowserWindowInterface::TYPE_POPUP))
+          Reconcile(peer->GetTabStripModel());
+        return true;
+      });
+  Reconcile(tab_strip);
+  const std::string active_space = StringOr(&organization_, "activeSpaceId");
+  MaterializeWorkspace(active_space, browser, tab_strip);
+  // SessionRestore may leave its bootstrap blank in a peer strip. Clean
+  // every cold-start strip before enabling adoption of genuinely new tabs;
+  // otherwise a later peer initialization persists that placeholder as a tab.
+  // Saved blank tabs have already consumed their own identities above.
+  auto remove_startup_blank = [&](TabStripModel* strip) {
+    if (!strip || strip->count() <= 1) return;
+    bool has_bound_tab = false;
+    for (int index = 0; index < strip->count(); ++index) {
+      if (!TabIdFor(strip->GetWebContentsAt(index)).empty()) {
+        has_bound_tab = true;
+        break;
+      }
+    }
+    if (!has_bound_tab) return;
+    materializing_ = true;
+    for (int index = strip->count() - 1; index >= 0; --index) {
+      content::WebContents* contents = strip->GetWebContentsAt(index);
+      if (contents && TabIdFor(contents).empty() &&
+          IsDisposableStartupBlank(contents->GetVisibleURL(), GURL(homepage()))) {
+        strip->CloseWebContentsAt(index, TabCloseTypes::CLOSE_NONE);
+      }
+    }
+    materializing_ = false;
+  };
+  if (!materialized_once_) {
+    ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+        [&](BrowserWindowInterface* peer) {
+          if (peer && peer->GetType() == BrowserWindowInterface::TYPE_NORMAL)
+            remove_startup_blank(peer->GetTabStripModel());
+          return true;
+        });
+  } else {
+    remove_startup_blank(tab_strip);
+  }
+  materialized_once_ = true;
+  Reconcile(tab_strip);
+  // A pristine organization has no desired tab until the first live blank tab
+  // receives its stable identity above. Materialize once more so that tab is
+  // immediately bound into the persistent workspace model.
+  MaterializeWorkspace(active_space, browser, tab_strip);
+  Reconcile(tab_strip);
+}
+
+void ViolaOrganizationStore::MaterializeWorkspace(
+    std::string_view space_id, BrowserWindowInterface *browser,
+    TabStripModel *tab_strip) {
+  base::DictValue *space = FindSpace(organization_, space_id);
+  if (!space || !browser || !tab_strip) {
+    return;
+  }
+  if (SessionRestore::IsRestoring(profile_)) {
+    restore_materialization_pending_ = true;
+    return;
+  }
+  materializing_ = true;
+  std::vector<std::string> desired;
+  const std::string profile_id = StringOr(space, "profileId");
+  if (const base::DictValue *profile = FindProfile(organization_, profile_id)) {
+    for (const base::Value &tab : *profile->FindList("favorites")) {
+      desired.push_back(*tab.GetDict().FindString("id"));
+    }
+  }
+  for (std::string_view section : {"pinned", "today"}) {
+    for (const base::Value &tab : *space->FindList(section)) {
+      desired.push_back(*tab.GetDict().FindString("id"));
+    }
+  }
+
+  // A Viola profile is one logical tab session across every browser window.
+  // Never manufacture a second WebContents for an identity that another
+  // window already owns; the shell renders that owner as a dimmed transferable
+  // row instead.
+  std::set<std::string> bound_elsewhere;
+  ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+      [&](BrowserWindowInterface *candidate) {
+        TabStripModel *candidate_strip =
+            candidate ? candidate->GetTabStripModel() : nullptr;
+        if (!candidate_strip || candidate_strip == tab_strip) {
+          return true;
+        }
+        for (int index = 0; index < candidate_strip->count(); ++index) {
+          const std::string identity =
+              TabIdFor(candidate_strip->GetWebContentsAt(index));
+          if (!identity.empty()) {
+            bound_elsewhere.insert(identity);
+          }
+        }
+        return true;
+      });
+
+  for (const std::string &id : desired) {
+    const base::DictValue *persistent = FindPersistentTab(organization_, id);
+    if (!persistent) {
+      continue;
+    }
+    const GURL url(StringOr(persistent, "url", "about:blank"));
+    content::WebContents *contents = nullptr;
+    int index = FindTabIndex(tab_strip, id);
+    if (index != TabStripModel::kNoTab) {
+      contents = tab_strip->GetWebContentsAt(index);
+    } else if (bound_elsewhere.contains(id)) {
+      continue;
+    } else {
+      // Chromium has already created one unbound startup blank by the time
+      // the asynchronous organization file becomes available. When the
+      // persisted active workspace itself wants a disposable blank, adopt
+      // that existing WebContents instead of creating a second blank and
+      // destroying the first one underneath startup observers.
+      if (IsDisposableStartupBlank(url, GURL(homepage()))) {
+        for (int candidate_index = 0; candidate_index < tab_strip->count();
+             ++candidate_index) {
+          content::WebContents *candidate =
+              tab_strip->GetWebContentsAt(candidate_index);
+          if (candidate && TabIdFor(candidate).empty() &&
+              IsDisposableStartupBlank(candidate->GetVisibleURL(),
+                                       GURL(homepage()))) {
+            contents = candidate;
+            break;
+          }
+        }
+      }
+      if (!contents) {
+        contents = chrome::AddAndReturnTabAt(
+            browser, ProfileNavigationUrl(url), tab_strip->count(),
+            /*foreground=*/false, std::nullopt,
+            IsLogicalPinned(organization_, id));
+      }
+      if (contents) {
+        BindTabIdentity(contents, id);
+      }
+    }
+    if (!contents) {
+      continue;
+    }
+    index = tab_strip->GetIndexOfWebContents(contents);
+    if (index != TabStripModel::kNoTab &&
+        tab_strip->IsTabPinned(index) != IsLogicalPinned(organization_, id)) {
+      tab_strip->SetTabPinned(index, IsLogicalPinned(organization_, id));
+    }
+    if (persistent->FindBool("muted").value_or(false)) {
+      contents->SetAudioMuted(true);
+    }
+  }
+
+  const std::string active_id = StringOr(space, "activeTabId");
+  int active_index = FindTabIndex(tab_strip, active_id);
+  if (active_index == TabStripModel::kNoTab) {
+    for (const std::string &id : desired) {
+      active_index = FindTabIndex(tab_strip, id);
+      if (active_index != TabStripModel::kNoTab) {
+        break;
+      }
+    }
+  }
+  if (active_index != TabStripModel::kNoTab) {
+    tab_strip->ActivateTabAt(
+        active_index, TabStripUserGestureDetails(
+                          TabStripUserGestureDetails::GestureType::kOther));
+  }
+
+  const std::vector<std::string> split_ids = SplitLeaves(space->Find("split"));
+  const bool persistent_split_valid =
+      split_ids.size() == 2 && IsLogicalPinned(organization_, split_ids[0]) ==
+                                   IsLogicalPinned(organization_, split_ids[1]);
+  const base::DictValue *split_root = space->FindDict("split");
+  const bool split_stacked = split_root && StringOr(split_root, "dir") == "v";
+  double split_ratio = 0.5;
+  const base::ListValue *split_sizes =
+      split_root ? split_root->FindList("sizes") : nullptr;
+  if (split_sizes && split_sizes->size() == 2) {
+    if ((*split_sizes)[0].is_double()) {
+      split_ratio = (*split_sizes)[0].GetDouble();
+    } else if ((*split_sizes)[0].is_int()) {
+      split_ratio = (*split_sizes)[0].GetInt();
+    }
+    split_ratio = std::clamp(split_ratio, 0.1, 0.9);
+  }
+  std::optional<split_tabs::SplitTabId> matching_split;
+  for (const split_tabs::SplitTabId split_id : tab_strip->ListSplits()) {
+    split_tabs::SplitTabData *data = tab_strip->GetSplitData(split_id);
+    const std::vector<tabs::TabInterface *> members = data->ListTabs();
+    if (persistent_split_valid && members.size() == 2) {
+      const std::string first = TabIdFor(members[0]->GetContents());
+      const std::string second = TabIdFor(members[1]->GetContents());
+      if ((first == split_ids[0] && second == split_ids[1]) ||
+          (first == split_ids[1] && second == split_ids[0])) {
+        matching_split = split_id;
+        continue;
+      }
+    }
+    tab_strip->RemoveSplit(split_id);
+  }
+  if (persistent_split_valid) {
+    const int first_index = FindTabIndex(tab_strip, split_ids[0]);
+    const int second_index = FindTabIndex(tab_strip, split_ids[1]);
+    if (first_index != TabStripModel::kNoTab &&
+        second_index != TabStripModel::kNoTab) {
+      if (!matching_split) {
+        std::vector<int> indices = {first_index, second_index};
+        std::ranges::sort(indices);
+        const split_tabs::SplitTabId split_id =
+            split_tabs::SplitTabId::GenerateNew();
+        tab_strip->RestoreSplit(
+            split_id, indices,
+            split_tabs::SplitTabVisualData(
+                split_stacked ? split_tabs::SplitTabLayout::kStacked
+                              : split_tabs::SplitTabLayout::kSideBySide,
+                split_ratio));
+        matching_split = split_id;
+      }
+      tab_strip->UpdateSplitLayout(
+          *matching_split, split_stacked
+                               ? split_tabs::SplitTabLayout::kStacked
+                               : split_tabs::SplitTabLayout::kSideBySide);
+      tab_strip->UpdateSplitRatio(*matching_split, split_ratio);
+      split_tabs::SplitTabData *data = tab_strip->GetSplitData(*matching_split);
+      if (data && !data->ListTabs().empty() &&
+          TabIdFor(data->ListTabs().front()->GetContents()) != split_ids[0]) {
+        tab_strip->ReverseTabsInSplit(*matching_split);
+      }
+    }
+  }
+  materializing_ = false;
+}
+
+void ViolaOrganizationStore::Reconcile(TabStripModel *tab_strip) {
+  if (!loaded_ || !tab_strip || materializing_) {
+    return;
+  }
+  if (SessionRestore::IsRestoring(profile_)) {
+    restore_materialization_pending_ = true;
+    return;
+  }
+  const base::DictValue before = organization_.Clone();
+
+  // URL-based session rebinds must consume identities profile-wide, not just
+  // within one strip. Otherwise two restored windows with the same URL can
+  // silently acquire the same persistent tab identity.
+  std::set<std::string> bound;
+  ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+      [&](BrowserWindowInterface *candidate) {
+        TabStripModel *candidate_strip =
+            candidate ? candidate->GetTabStripModel() : nullptr;
+        if (!candidate_strip || candidate_strip == tab_strip) {
+          return true;
+        }
+        for (int index = 0; index < candidate_strip->count(); ++index) {
+          const std::string identity =
+              TabIdFor(candidate_strip->GetWebContentsAt(index));
+          if (!identity.empty()) {
+            bound.insert(identity);
+          }
+        }
+        return true;
+      });
+  for (int index = 0; index < tab_strip->count(); ++index) {
+    const std::string id = TabIdFor(tab_strip->GetWebContentsAt(index));
+    if (!id.empty()) {
+      bound.insert(id);
+    }
+  }
+  // Chromium session restore does not preserve our WebContents user data.
+  // Rebind by the most recently persisted URL, consuming each identity once.
+  for (int index = 0; index < tab_strip->count(); ++index) {
+    content::WebContents *contents = tab_strip->GetWebContentsAt(index);
+    if (!contents || !TabIdFor(contents).empty()) {
+      continue;
+    }
+    const std::string visible = contents->GetVisibleURL().spec();
+    std::string match;
+    const base::ListValue *profiles = organization_.FindList("profiles");
+    for (const base::Value &profile : *profiles) {
+      for (const base::Value &tab : *profile.GetDict().FindList("favorites")) {
+        const base::DictValue &candidate = tab.GetDict();
+        const std::string id = *candidate.FindString("id");
+        bool matches = StringOr(&candidate, "url") == visible;
+        if (!matches && !materialized_once_) {
+          auto& controller = contents->GetController();
+          for (int entry = 0; entry < controller.GetEntryCount(); ++entry) {
+            if (controller.GetEntryAtIndex(entry)->GetVirtualURL().spec() ==
+                StringOr(&candidate, "url")) {
+              matches = true;
+              break;
+            }
+          }
+        }
+        if (!bound.contains(id) && matches) {
+          match = id;
+          break;
+        }
+      }
+      if (!match.empty()) {
+        break;
+      }
+    }
+    if (match.empty()) {
+      for (const base::Value &space : *organization_.FindList("spaces")) {
+        for (std::string_view section : {"pinned", "today"}) {
+          for (const base::Value &tab : *space.GetDict().FindList(section)) {
+            const base::DictValue &candidate = tab.GetDict();
+            const std::string id = *candidate.FindString("id");
+            if (!bound.contains(id) && StringOr(&candidate, "url") == visible) {
+              match = id;
+              break;
+            }
+          }
+          if (!match.empty()) {
+            break;
+          }
+        }
+        if (!match.empty()) {
+          break;
+        }
+      }
+    }
+    if (!match.empty()) {
+      BindTabIdentity(contents, match);
+      bound.insert(match);
+    }
+  }
+
+  for (int index = 0; index < tab_strip->count(); ++index) {
+    content::WebContents *contents = tab_strip->GetWebContentsAt(index);
+    if (materialized_once_ && contents) {
+      const std::string identity = TabIdFor(contents);
+      const auto* restored_identity = static_cast<const TabIdentity*>(
+          contents->GetUserData(kTabIdentityKey));
+      if (restored_identity && restored_identity->from_session_restore &&
+          RemovedTabIds(organization_).contains(identity) &&
+          !FindPersistentTab(organization_, identity)) {
+        // Let the post-restore materialization pass remove this known stale
+        // page; never turn it into a fresh visible record before that pass.
+        continue;
+      }
+      if (!identity.empty() && !FindPersistentTab(organization_, identity)) {
+        // Recover a still-live orphan under a new visible identity. Do not
+        // resurrect a removed identity or silently destroy in-flight content.
+        contents->RemoveUserData(kTabIdentityKey);
+      }
+      if (TabIdFor(contents).empty()) AddNewTab(contents, tab_strip);
+    }
+  }
+
+  content::WebContents *active = tab_strip->GetActiveWebContents();
+  const std::string active_id = TabIdFor(active);
+  if (std::optional<std::string> owner =
+          SpaceIdForTab(organization_, active_id)) {
+    const std::string previous_active_space =
+        StringOr(&organization_, "activeSpaceId");
+    base::DictValue *space = FindSpace(organization_, *owner);
+    const bool active_identity_changed =
+        previous_active_space != *owner ||
+        (space && StringOr(space, "activeTabId") != active_id);
+    organization_.Set("activeSpaceId", *owner);
+    if (workspace_lens_id_ != kAllWorkspacesId) {
+      workspace_lens_id_ = *owner;
+    }
+    if (space) {
+      space->Set("activeTabId", active_id);
+      if (active_identity_changed) {
+        if (base::DictValue *persistent =
+                FindPersistentTab(organization_, active_id)) {
+          persistent->Set(
+              "lastAccessed",
+              static_cast<double>(
+                  base::Time::Now().InMillisecondsSinceUnixEpoch()));
+        }
+      }
+    }
+  }
+
+  for (int index = 0; index < tab_strip->count(); ++index) {
+    content::WebContents *contents = tab_strip->GetWebContentsAt(index);
+    base::DictValue *persistent =
+        FindPersistentTab(organization_, TabIdFor(contents));
+    if (!contents || !persistent) {
+      continue;
+    }
+    // ApplyOrganizationFromSync has already selected the authenticated record
+    // frontier. Its synchronous reconciliation pass must not immediately copy
+    // the older live renderer URL/title back over that imported value. Remote
+    // URL changes are navigated below at the apply boundary; the ordinary
+    // navigation observer will reconcile the settled destination after the
+    // transaction releases applying_sync_.
+    if (applying_sync_) {
+      continue;
+    }
+    PersistTabIdentity(contents);
+    const bool favorite = IsFavorite(TabIdFor(contents));
+    if (!favorite) {
+      const GURL visible = contents->GetVisibleURL();
+      if (IsSafeTabUrl(visible, true)) {
+        persistent->Set("url", visible.spec());
+      }
+      const std::string title =
+          IsNativeNewTab(visible)
+              ? "New Tab"
+              : base::UTF16ToUTF8(contents->GetTitle()).substr(0, 512);
+      if (!title.empty()) {
+        persistent->Set("title", title);
+      }
+      content::NavigationEntry *entry =
+          contents->GetController().GetVisibleEntry();
+      const content::FaviconStatus *favicon =
+          entry ? &entry->GetFavicon() : nullptr;
+      if (favicon && favicon->valid && favicon->url.is_valid() &&
+          favicon->url.SchemeIsHTTPOrHTTPS()) {
+        // Persist the discovered portable URL. A second window and a peer
+        // device can paint it without loading the dormant page or relying on a
+        // window-local NavigationEntry.
+        persistent->Set("favicon", favicon->url.spec());
+      }
+      UpdateSavedTabSnapshots(organization_, TabIdFor(contents), *persistent);
+    }
+    persistent->Set("muted", contents->IsAudioMuted());
+    if (materialized_once_ &&
+        tab_strip->IsTabPinned(index) !=
+            IsLogicalPinned(organization_, TabIdFor(contents))) {
+      MovePersistentTabToSection(organization_, TabIdFor(contents),
+                                 tab_strip->IsTabPinned(index));
+    }
+  }
+  if (organization_ != before) {
+    ScheduleWrite();
+  }
+}
