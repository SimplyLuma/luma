+  std::vector<base::OnceClosure> loaded_callbacks_;
+  std::map<int, std::unique_ptr<network::SimpleURLLoader>> loaders_;
+  base::DictValue local_history_entities_;
+  // Last privacy-safe physical-sync trace. It contains only bounded counts,
+  // content digests, booleans, and categorical outcomes; it never records
+  // credentials, ciphertext, names, titles, or non-synthetic URLs.
+  base::DictValue pending_sync_evidence_;
+  std::set<std::string> local_history_urls_;
+  std::map<std::string, std::string> remote_presence_by_tab_;
+  base::CancelableTaskTracker history_task_tracker_;
+  int next_request_id_ = 1;
+  bool loading_ = true;
+  bool loaded_ = false;
+  bool syncing_ = false;
+  bool sync_again_ = false;
+  bool local_dirty_ = false;
+  int local_mutation_generation_ = 0;
+  int acknowledged_local_mutation_generation_ = 0;
+  int active_sync_local_mutation_generation_ = 0;
+  int pending_upload_local_mutation_generation_ = 0;
+  bool applying_remote_ = false;
+  int remote_presence_generation_ = 0;
+  base::OneShotTimer sync_timer_;
+  const std::string writer_instance_id_;
+  int64_t sync_base_cursor_ = 0;
+  int64_t pending_upload_cursor_ = -1;
+  int pending_upload_revision_ = 0;
+  std::string pending_upload_generated_at_;
+  std::string pending_upload_organization_digest_;
+  bool writer_claimed_ = false;
+  base::WeakPtrFactory<ViolaAccountSyncService> weak_factory_{this};
+};
