+    }
+    row.append(copy);
+    const actions=node('div','row-actions');
+    const action=(label,channel,kind='')=>{const b=node('button',kind,label);b.addEventListener('click',(e)=>{e.stopPropagation();vela.send(channel,{id:item.id})});actions.append(b)};
+    if(item.state==='progressing'){action('Pause','download:pause');action('Cancel','download:cancel','danger')}
+    else if(item.state==='paused'){action('Resume','download:resume');action('Cancel','download:cancel','danger')}
+    else if(item.state==='interrupted'&&item.canResume){action('Resume','download:resume');action('Cancel','download:cancel','danger')}
+    else if(item.state==='done'){action('Open','download:open');action(revealLabel,'download:reveal');action('Remove','download:remove','danger')}
+    else {if(item.path)action(revealLabel,'download:reveal');action('Remove','download:remove','danger')}
+    row.append(actions);
