+
+void ViolaMessageHandler::HandlePaletteCommit(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() < 2 ||
+      payload.GetDict().size() > 3) {
+    return;
+  }
+  const base::DictValue &request = payload.GetDict();
+  const base::DictValue *item = request.FindDict("item");
+  const std::string *mode = request.FindString("mode");
+  const bool meta = request.FindBool("meta").value_or(false);
+  if (!item || !mode || (*mode != "edit" && *mode != "new")) {
+    return;
+  }
+
+  TabStripModel *tab_strip = GetProductTabStrip();
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  content::WebContents *active =
+      tab_strip ? tab_strip->GetActiveWebContents() : nullptr;
+  Profile *profile = browser ? browser->GetProfile() : nullptr;
+  viola::ViolaProductOverlayHostView *overlay_host = GetProductOverlayHost();
+  if (!tab_strip || !browser || browser->GetTabStripModel() != tab_strip ||
+      !active || !profile || !overlay_host ||
+      !overlay_host->palette_visible_for_testing()) {
+    return;
+  }
+
+  // The overlay has its own WebUI handler. A user normally types before
+  // committing, which initializes this pointer through palette:query, but an
+  // immediate Enter or an accessibility action can commit without a query.
+  // Resolve the profile-owned singleton here as well so new-mode never falls
+  // through to navigating the current tab.
+  organization_store_ = viola::ViolaOrganizationStore::Get(profile);
+  if (organization_store_ && !organization_store_->loaded()) {
+    organization_store_->EnsureLoaded(
+        base::BindOnce(&ViolaMessageHandler::HandlePaletteCommit,
+                       weak_factory_.GetWeakPtr(), payload.Clone()));
+    return;
+  }
+
+  if (const std::string *token = item->FindString("token")) {
+    auto action_it = palette_actions_.find(*token);
+    if (action_it == palette_actions_.end()) {
+      return;
+    }
+    base::DictValue action = action_it->second.Clone();
+    palette_actions_.erase(action_it);
+    const std::string *action_type = action.FindString("type");
+    const std::string *action_value = action.FindString("value");
+    if (!action_type || !action_value) {
+      return;
+    }
+    if (*action_type == "tab" && !meta) {
+      if (organization_store_ && organization_store_->loaded() &&
+          organization_store_->ActivateTab(*action_value, browser, tab_strip)) {
+        overlay_host->ClosePalette();
+      }
+      return;
+    }
+    if (*action_type != "navigate") {
+      return;
+    }
+    const GURL destination(*action_value);
+    if (!destination.SchemeIsHTTPOrHTTPS() && !destination.SchemeIsFile()) {
+      return;
+    }
+    if (*mode == "new" || meta) {
+      const int insertion = tab_strip->active_index() + 1;
+      if (organization_store_) {
+        organization_store_->AddNewTabForActiveWorkspace(
+            browser, tab_strip, destination, insertion, /*foreground=*/true);
+      } else {
+        chrome::AddTabAt(browser, destination, insertion,
+                         /*foreground=*/true);
+      }
+    } else {
+      content::NavigationController::LoadURLParams params(destination);
+      params.transition_type = ui::PAGE_TRANSITION_TYPED;
+      active->GetController().LoadURLWithParams(params);
+    }
+    overlay_host->ClosePalette();
+    return;
+  }
+
+  const std::string *type = item->FindString("type");
+  const std::string *input = item->FindString("url");
+  const std::string *title = item->FindString("title");
+  if (meta || item->size() != 3 || !type || *type != "raw" || !input ||
+      input->empty() || input->size() > 2048 || !title || *title != *input) {
+    return;
+  }
+
+  const GURL destination =
+      ResolveTypedDestination(profile, *input, organization_store_);
+  if (!destination.is_valid() ||
+      (!destination.SchemeIsHTTPOrHTTPS() && !destination.SchemeIsFile())) {
+    return;
+  }
+
+  if (*mode == "new") {
+    const int insertion = tab_strip->active_index() + 1;
+    if (organization_store_) {
+      organization_store_->AddNewTabForActiveWorkspace(
+          browser, tab_strip, destination, insertion, /*foreground=*/true);
+    } else {
+      chrome::AddTabAt(browser, destination, insertion,
+                       /*foreground=*/true);
+    }
+  } else {
+    content::NavigationController::LoadURLParams params(destination);
+    params.transition_type = ui::PAGE_TRANSITION_TYPED;
+    active->GetController().LoadURLWithParams(params);
+  }
+  overlay_host->ClosePalette();
+}
+
+void ViolaMessageHandler::SendWindowChromeState() {
+  base::DictValue state;
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  const ui::BaseWindow *window = browser ? browser->GetWindow() : nullptr;
+  state.Set("focused", browser && browser->IsActive());
+  state.Set("visible", window && window->IsVisible());
+  state.Set("maximized", window && window->IsMaximized());
+  state.Set("fullScreen", window && window->IsFullscreen());
+
+  web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
+                                         base::Value("window:chromeState"),
+                                         base::Value(std::move(state)));
+}
+
+void ViolaMessageHandler::CompleteDeferredWindowControl(std::string action) {
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  ui::BaseWindow *window = browser ? browser->GetWindow() : nullptr;
+  if (!window) {
+    return;
+  }
+  if (action == "minimize") {
+    window->Minimize();
+  } else if (action == "maximize") {
+    window->IsMaximized() ? window->Restore() : window->Maximize();
+  } else {
+    return;
+  }
+  if (IsJavascriptAllowed()) {
+    SendWindowChromeState();
+  }
+}
+
+void ViolaMessageHandler::HandleWindowControl(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 1) {
+    return;
+  }
+  const std::string *action = payload.GetDict().FindString("action");
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  ui::BaseWindow *window = browser ? browser->GetWindow() : nullptr;
+  if (!action || !window) {
+    return;
+  }
+  if (*action == "close") {
+    window->Close();
+  } else if (*action == "minimize") {
+#if BUILDFLAG(IS_WIN)
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&ViolaMessageHandler::CompleteDeferredWindowControl,
+                       weak_factory_.GetWeakPtr(), *action),
+        base::Milliseconds(120));
+    return;
+#else
+    window->Minimize();
+#endif
+  } else if (*action == "maximize") {
+#if BUILDFLAG(IS_WIN)
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&ViolaMessageHandler::CompleteDeferredWindowControl,
+                       weak_factory_.GetWeakPtr(), *action),
+        base::Milliseconds(120));
+    return;
+#else
+    window->IsMaximized() ? window->Restore() : window->Maximize();
+#endif
+  } else {
+    return;
+  }
+  if (IsJavascriptAllowed() && *action != "close") {
+    SendWindowChromeState();
+  }
+}
+
+base::DictValue ViolaMessageHandler::BuildDownloadPayload() {
+  download::SimpleDownloadManager::DownloadVector downloads;
+  // Keep using the manager the notifier actually observes while a WebUI tab is
+  // navigating or being adopted. Re-resolving the owning BrowserWindow during
+  // those short transitions can return null and used to publish an empty list
+  // immediately after a real download event.
+  content::DownloadManager *manager = download_notifier_
+                                          ? download_notifier_->GetManager()
+                                          : GetDownloadManager();
+  if (manager) {
+    manager->GetAllDownloads(&downloads);
+  }
+  std::sort(downloads.begin(), downloads.end(),
+            [](download::DownloadItem *left, download::DownloadItem *right) {
+              if (!left || !right) {
+                return left != nullptr;
+              }
+              return left->GetStartTime() > right->GetStartTime();
+            });
+
+  base::ListValue rows;
+  int active_count = 0;
+  int paused_count = 0;
+  int known_count = 0;
+  double total_received = 0;
+  double total_bytes = 0;
+  download::DownloadItem *recent_complete = nullptr;
+  std::vector<download::DownloadItem *> active_downloads;
+  base::Time recent_completion_time;
+  const base::Time now = base::Time::Now();
+
+  for (download::DownloadItem *item : downloads) {
+    if (!item || item->GetGuid().empty()) {
+      continue;
+    }
+    const bool active = item->GetState() == download::DownloadItem::IN_PROGRESS;
+    if (active) {
+      active_downloads.push_back(item);
+      ++active_count;
+      if (item->IsPaused()) {
+        ++paused_count;
+      }
+      const int64_t total = std::max<int64_t>(0, item->GetTotalBytes());
+      if (total > 0) {
+        ++known_count;
+        total_bytes += static_cast<double>(total);
+        total_received += static_cast<double>(
+            std::clamp<int64_t>(item->GetReceivedBytes(), 0, total));
+      }
+    } else if (item->GetState() == download::DownloadItem::COMPLETE &&
+               !item->GetEndTime().is_null() &&
+               item->GetEndTime() > recent_completion_time) {
+      recent_complete = item;
+      recent_completion_time = item->GetEndTime();
+    }
+
+    if (rows.size() >= kMaximumDownloadRows) {
+      continue;
+    }
+    base::DictValue row;
+    row.Set("id", item->GetGuid());
+    row.Set("filename", item->GetFileNameToReportUser().AsUTF8Unsafe());
+    row.Set("path", item->GetTargetFilePath().AsUTF8Unsafe());
+    row.Set("url", item->GetURL().spec());
+    row.Set("sourceUrl", item->GetTabUrl().spec());
+    row.Set("profileId", "");
+    row.Set("received", static_cast<double>(
+                            std::max<int64_t>(0, item->GetReceivedBytes())));
+    row.Set("total",
+            static_cast<double>(std::max<int64_t>(0, item->GetTotalBytes())));
+    row.Set("state", DownloadStateName(*item));
+    row.Set("startedAt",
+            static_cast<double>(
+                item->GetStartTime().InMillisecondsSinceUnixEpoch()));
+    if (item->GetEndTime().is_null()) {
+      row.Set("completedAt", base::Value());
+    } else {
+      row.Set("completedAt",
+              static_cast<double>(
+                  item->GetEndTime().InMillisecondsSinceUnixEpoch()));
+    }
+    row.Set("canResume", item->CanResume());
+    rows.Append(std::move(row));
+  }
+
+  bool completed_attention = false;
+  base::TimeDelta attention_remaining;
+  if (active_count == 0 && recent_complete && recent_completion_time <= now) {
+    const base::TimeDelta age = now - recent_completion_time;
+    if (age < kDownloadAttentionDuration) {
+      completed_attention = true;
+      attention_remaining = kDownloadAttentionDuration - age;
+    }
+  }
+  if (completed_attention) {
+    if (!download_attention_timer_.IsRunning() ||
+        download_attention_guid_ != recent_complete->GetGuid()) {
+      download_attention_timer_.Stop();
+      download_attention_guid_ = recent_complete->GetGuid();
+      download_attention_timer_.Start(
+          FROM_HERE, attention_remaining,
+          base::BindOnce(&ViolaMessageHandler::SendDownloadState,
+                         weak_factory_.GetWeakPtr()));
+    }
+  } else {
+    download_attention_timer_.Stop();
+    download_attention_guid_.clear();
+  }
+
+  const double progress =
+      total_bytes > 0 ? std::clamp(total_received / total_bytes, 0.0, 1.0)
+                      : 0.0;
+  base::DictValue summary;
+  summary.Set("visible", active_count > 0 || completed_attention);
+  summary.Set("active", active_count > 0);
+  summary.Set("activeCount", active_count);
+  summary.Set("progress", completed_attention ? 1.0 : progress);
+  summary.Set("indeterminate", active_count > 0 && known_count != active_count);
+  summary.Set("paused", active_count > 0 && paused_count == active_count);
+  summary.Set("completed", completed_attention);
+  if (completed_attention) {
+    summary.Set("completedId", recent_complete->GetGuid());
+    summary.Set("tooltip",
+                "Download complete — " +
+                    recent_complete->GetFileNameToReportUser().AsUTF8Unsafe() +
+                    ". Click to view downloads.");
+  } else {
+    summary.Set("completedId", base::Value());
+    if (active_count == 1) {
+      download::DownloadItem *active = nullptr;
+      for (download::DownloadItem *item : downloads) {
+        if (item && item->GetState() == download::DownloadItem::IN_PROGRESS) {
+          active = item;
+          break;
+        }
+      }
+      summary.Set(
+          "tooltip",
+          active && active->IsPaused()
+              ? "Paused " + active->GetFileNameToReportUser().AsUTF8Unsafe()
+              : "Downloading " +
+                    (active ? active->GetFileNameToReportUser().AsUTF8Unsafe()
+                            : std::string("file")));
+    } else if (active_count > 1) {
+      summary.Set("tooltip", base::NumberToString(active_count) + " downloads");
+    } else {
+      summary.Set("tooltip", "Downloads");
+    }
+  }
+
+  base::DictValue payload;
+  payload.Set("downloads", std::move(rows));
+  payload.Set("summary", std::move(summary));
+  base::ListValue notifications;
+  if ((update_status_ == "available" || update_status_ == "downloading" ||
+       update_status_ == "ready") &&
+      !update_available_version_.empty()) {
+    base::DictValue notification;
+    notification.Set("id", "update:" + update_available_version_);
+    const bool ready = update_status_ == "ready";
+    const bool downloading = update_status_ == "downloading";
+    notification.Set("title", "Viola " + update_available_version_ +
+                                  (ready ? " is ready" : " is available"));
+    notification.Set(
+        "body", ready
+                    ? "Install the verified update and relaunch when you are ready."
+                    : downloading
+                          ? "Downloading and verifying the update in the background."
+                          : "Download the verified update now, or choose Later.");
+    notification.Set("host", "Software Update");
+    notification.Set("hue", 252);
+    notification.Set("important", true);
+    notification.Set("kept", true);
+    notification.Set("url", "vela://updates");
+    notification.Set("tag", "update:" + update_available_version_);
+    notification.Set("updateStatus", update_status_);
+    notification.Set("manualInstall",
+                     !viola::ViolaUpdateService::Get().CanInstallInApp());
+    notification.Set("icon", "chrome://theme/IDR_PRODUCT_LOGO_32");
+    notifications.Append(std::move(notification));
+  }
+  auto append_notification = [&](download::DownloadItem *item, bool complete) {
+    if (!item || dismissed_download_guids_.contains(item->GetGuid()) ||
+        notifications.size() >= 5) {
+      return;
+    }
+    const int64_t received = std::max<int64_t>(0, item->GetReceivedBytes());
+    const int64_t total = std::max<int64_t>(0, item->GetTotalBytes());
+    std::string body;
+    if (complete) {
+      body = "Download complete · " + HumanDownloadBytes(received);
+    } else if (item->IsPaused()) {
+      body = "Paused · " + HumanDownloadBytes(received);
+      if (total > 0) {
+        body += " of " + HumanDownloadBytes(total);
+      }
+    } else if (total > 0) {
+      const int percent = base::ClampRound<int>(
+          std::clamp(static_cast<double>(received) / total, 0.0, 1.0) * 100);
+      body = base::NumberToString(percent) + "% · " +
+             HumanDownloadBytes(received) + " of " + HumanDownloadBytes(total);
+    } else {
+      body = "Downloading · " + HumanDownloadBytes(received);
+    }
+    const GURL source =
+        item->GetTabUrl().is_valid() ? item->GetTabUrl() : item->GetURL();
+    base::DictValue notification;
+    notification.Set("id", "download:" + item->GetGuid());
+    notification.Set("title", item->GetFileNameToReportUser().AsUTF8Unsafe());
+    notification.Set("body", body);
+    notification.Set("host",
+                     source.host().empty() ? "Download" : source.host());
+    notification.Set("hue", 221);
+    notification.Set("important", complete);
+    notification.Set("kept", false);
+    notification.Set("url", "vela://downloads");
+    notification.Set("downloadId", item->GetGuid());
+    notification.Set("tag", "download:" + item->GetGuid());
+    notification.Set(
+        "icon",
+        source.SchemeIsHTTPOrHTTPS()
+            ? base::StrCat({"chrome://favicon2/?size=32&scaleFactor=1x&"
+                            "showFallbackMonogram=&pageUrl=",
+                            base::EscapeQueryParamValue(source.spec(), true)})
+            : "");
+    notifications.Append(std::move(notification));
+  };
+  for (download::DownloadItem *item : active_downloads) {
+    append_notification(item, false);
+  }
+  if (completed_attention) {
+    append_notification(recent_complete, true);
+  }
+  payload.Set("notifications", std::move(notifications));
+  return payload;
+}
+
+void ViolaMessageHandler::SendDownloadState() {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  const std::string surface = CurrentSurface();
+  if (surface != "sidebar.html" && surface != "overlay.html" &&
+      !IsViolaLibrarySurface(surface)) {
+    return;
+  }
+  web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
+                                         base::Value("download:update"),
+                                         base::Value(BuildDownloadPayload()));
+}
+
+void ViolaMessageHandler::HandlePermissionResponse(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 2) {
+    return;
+  }
+  const std::string *id = payload.GetDict().FindString("id");
+  const std::string *decision = payload.GetDict().FindString("decision");
+  if (!id || !decision || id->empty() || id->size() > 128 ||
+      (*decision != "allow" && *decision != "block" &&
+       *decision != "dismiss")) {
+    return;
+  }
+  if (viola::ViolaProductShellView *shell = GetProductShellView()) {
+    shell->ResolvePermissionPrompt(*id, *decision);
+  }
+}
+
+void ViolaMessageHandler::SendRenderState() {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  if (CurrentSurface() == "little.html") {
+    SendMiniState();
+    return;
+  }
+  TabStripModel *tab_strip = GetProductTabStrip();
+  if (!tab_strip || tab_strip != observed_tab_strip_) {
+    return;
+  }
+
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  const bool incognito = browser && browser->GetProfile() &&
+                         browser->GetProfile()->IsOffTheRecord();
+#if BUILDFLAG(IS_LINUX)
+  const bool system_dark =
+      ui::NativeTheme::GetInstanceForNativeUi()->preferred_color_scheme() ==
+      ui::NativeTheme::PreferredColorScheme::kDark;
+#else
+  const bool system_dark = false;
+#endif
+  const bool shell_dark = incognito || system_dark;
+  content::WebContents *active = tab_strip->GetActiveWebContents();
+  const GURL active_url = active ? active->GetVisibleURL() : GURL();
+
+  base::DictValue settings;
+  settings.Set("tabHeight", 34);
+  settings.Set("tabSpacing", 3);
+  settings.Set("tabRadius", 9);
+  settings.Set("workspaceHeaderHeight", 34);
+  settings.Set("workspaceHeaderRadius", 9);
+  settings.Set("workspaceSectionSpacing", 13);
+  settings.Set("workspaceContentInset", 12);
+  settings.Set("workspaceContentInsetRight", 12);
+#if BUILDFLAG(IS_LINUX)
+  settings.Set("sidebarWidth", 252);
+#else
+  settings.Set("sidebarWidth", 264);
+#endif
+  settings.Set("sidebarSide", "left");
+  settings.Set("sidebarCollapsed", false);
+  settings.Set("otherWindowTabsLayout", "inline");
+  settings.Set("allWorkspacesGroupByWorkspace", true);
+
+  base::ListValue gradient;
+  gradient.Append(incognito ? "#08080a" : shell_dark ? "#21252b" : "#edf0f2");
+  gradient.Append(incognito ? "#0d0d10" : shell_dark ? "#21252b" : "#edf0f2");
+  gradient.Append(incognito ? "#15151a" : shell_dark ? "#21252b" : "#edf0f2");
+  base::DictValue theme;
+  theme.Set("key", incognito ? "incognito-black" : "aurora");
+  theme.Set("name", incognito ? "Incognito Black" : "Aurora");
+  theme.Set("gradient", std::move(gradient));
+  theme.Set("accent", incognito ? "#a78bfa" : shell_dark ? "#7fcfd2" : "#3b7f83");
+  theme.Set("ink", incognito ? "#f4f2fb" : shell_dark ? "#e4e8ea" : "#232c34");
+  theme.Set("dark", shell_dark);
+
+  base::ListValue pinned;
+  base::ListValue today;
+  std::string active_tab_id;
+  for (int index = 0; index < tab_strip->count(); ++index) {
+    tabs::TabInterface *tab = tab_strip->GetTabAtIndex(index);
+    if (!tab) {
+      continue;
+    }
+    base::DictValue tab_state = BuildTabState(*tab);
+    if (tab->GetContents() == active) {
+      const std::string *id = tab_state.FindString("id");
+      active_tab_id = id ? *id : std::string();
+    }
+    if (tab->IsPinned()) {
+      pinned.Append(std::move(tab_state));
+    } else {
+      today.Append(std::move(tab_state));
+    }
+  }
+
+  base::DictValue state;
+  state.Set("incognito", incognito);
+  state.Set("workspacesEnabled", incognito);
+  state.Set("settings", std::move(settings));
+  state.Set("themes", base::ListValue());
+  state.Set("profiles", base::ListValue());
+  base::ListValue spaces;
+  base::ListValue scopes;
+  if (incognito) {
+    base::DictValue space;
+    space.Set("id", "incognito");
+    space.Set("name", "Incognito");
+    space.Set("icon", "◉");
+    space.Set("theme", "incognito-black");
+    space.Set("profileId", base::Value());
+    space.Set("profileName", "Private session");
+    spaces.Append(space.Clone());
+    space.Set("isAll", false);
+    scopes.Append(std::move(space));
+  }
+  state.Set("spaces", std::move(spaces));
+  state.Set("workspaceScopes", std::move(scopes));
+  state.Set("workspaceLensId", incognito ? "incognito" : "");
+  state.Set("isAllWorkspaces", false);
+  state.Set("collapsedWorkspaceSections", base::ListValue());
+  state.Set("activeSpaceId", incognito ? "incognito" : "");
+  state.Set("activeTabId", active_tab_id);
+  state.Set("theme", std::move(theme));
+  state.Set("partition", "");
+  state.Set("favorites", base::ListValue());
+  state.Set("pinned", std::move(pinned));
+  state.Set("today", std::move(today));
+  state.Set("tabGroups", base::ListValue());
+  state.Set("canGoBack", active && active->GetController().CanGoBack());
+  state.Set("canGoForward", active && active->GetController().CanGoForward());
+  state.Set("activeUrl", active_url.spec());
+  bookmarks::BookmarkModel *bookmark_model =
+      browser && browser->GetProfile()
+          ? BookmarkModelFactory::GetForBrowserContext(browser->GetProfile())
+          : nullptr;
+  state.Set("bookmarked", bookmark_model && bookmark_model->loaded() &&
+                              active_url.is_valid() &&
+                              bookmark_model->IsBookmarked(active_url));
+  state.Set("activeConnection", BuildConnectionInfo(active_url));
+  state.Set("siteProtectionCount", 0);
+  base::DictValue download_payload = BuildDownloadPayload();
+  state.Set("downloads", download_payload.FindList("downloads")->Clone());
+  state.Set("downloadSummary", download_payload.FindDict("summary")->Clone());
+  state.Set("notifications",
+            download_payload.FindList("notifications")->Clone());
+  base::Value media = BuildMediaPayload();
+  base::JSONWriter::Write(media, &media_fingerprint_);
+  state.Set("media", std::move(media));
+  state.Set("spaceIndex", -1);
+
+  if (!incognito && organization_store_ && organization_store_->loaded()) {
+    organization_store_->AppendRenderState(state, tab_strip);
+    ApplyLiveWindowOwners(state);
+  }
+
+  base::ListValue extension_controls;
+  extensions::ExtensionRegistry *extension_registry =
+      browser && browser->GetProfile()
+          ? extensions::ExtensionRegistry::Get(browser->GetProfile())
+          : nullptr;
+  if (!incognito && extension_registry) {
+    for (const scoped_refptr<const extensions::Extension> &extension :
+         extension_registry->enabled_extensions()) {
+      if (!extension || !IsUserVisibleExtension(*extension) ||
+          extension_controls.size() >= 6) {
+        continue;
+      }
+      base::DictValue row;
+      row.Set("id", extension->id());
+      row.Set("name", extension->name());
+      row.Set("icon", extensions::ExtensionIconSource::GetIconURL(
+                          extension.get(), 24,
+                          ExtensionIconSet::Match::kBigger,
+                          /*grayscale=*/false)
+                          .spec());
+      extension_controls.Append(std::move(row));
+    }
+  }
+  state.Set("extensions", std::move(extension_controls));
+
+  base::ListValue collapsed_workspace_sections;
+  std::set<std::string> live_space_ids;
+  if (const base::ListValue *state_spaces = state.FindList("spaces")) {
+    for (const base::Value &space : *state_spaces) {
+      if (const std::string *id = space.GetDict().FindString("id")) {
+        live_space_ids.insert(*id);
+      }
+    }
+  }
+  for (auto id = collapsed_workspace_section_ids_.begin();
+       id != collapsed_workspace_section_ids_.end();) {
+    if (!live_space_ids.contains(*id)) {
+      id = collapsed_workspace_section_ids_.erase(id);
+      continue;
+    }
+    collapsed_workspace_sections.Append(*id);
+    ++id;
+  }
+  state.Set("collapsedWorkspaceSections",
+            std::move(collapsed_workspace_sections));
+  if (base::ListValue *groups = state.FindList("tabGroups")) {
+    for (base::Value &group : *groups) {
+      base::DictValue &group_state = group.GetDict();
+      const std::string *id = group_state.FindString("id");
+      const bool keep_expanded =
+          group_state.FindBool("keepExpanded").value_or(false);
+      const bool collapsed =
+          !keep_expanded &&
+          group_state.FindBool("initiallyCollapsed").value_or(false);
+      group_state.Set("initiallyCollapsed", collapsed);
+      if (id) {
+        if (collapsed) {
+          collapsed_group_ids_.insert(*id);
+        } else {
+          collapsed_group_ids_.erase(*id);
+        }
+      }
+    }
+  }
+  if (viola::ViolaProductShellView *shell = GetProductShellView()) {
+    if (base::DictValue *render_settings = state.FindDict("settings")) {
+      render_settings->Set("sidebarCollapsed", shell->sidebar_collapsed());
+    }
+    if (const base::ListValue *colors =
+            state.FindDict("theme")->FindList("gradient");
+        colors && colors->size() >= 3 && (*colors)[0].is_string() &&
+        (*colors)[1].is_string() && (*colors)[2].is_string()) {
+      shell->SetFrameGradient((*colors)[0].GetString(),
+                              (*colors)[1].GetString(),
+                              (*colors)[2].GetString());
+    }
+    state.Set("permissionPrompt", shell->PermissionPromptState());
+  } else {
+    state.Set("permissionPrompt", base::Value());
+  }
+
+  SendHostState("render", base::Value(std::move(state)));
+}
+
+void ViolaMessageHandler::SendHostState(const std::string& channel,
+                                      base::Value payload) {
+  if (!IsJavascriptAllowed()) return;
+  content::RenderFrameHost* frame =
+      web_ui()->GetWebContents()->GetPrimaryMainFrame();
+  if (!frame || !frame->IsRenderFrameLive()) return;
+  base::ListValue arguments;
+  arguments.Append(channel);
+  arguments.Append(std::move(payload));
+  frame->ExecuteJavaScriptMethod(u"window", u"__violaHostReceive",
+                                std::move(arguments), {});
+}
+
+void ViolaMessageHandler::SendMiniState() {
+  if (!IsJavascriptAllowed() || CurrentSurface() != "little.html") return;
+  TabStripModel* tab_strip = GetProductTabStrip();
+  content::WebContents* active =
+      tab_strip ? tab_strip->GetActiveWebContents() : nullptr;
+  if (!active) return;
+  base::DictValue state;
+  state.Set("title", base::UTF16ToUTF8(active->GetTitle()));
+  state.Set("url", active->GetVisibleURL().spec());
+  state.Set("loading", active->IsLoading());
+  state.Set("canGoBack", active->GetController().CanGoBack());
+  state.Set("canGoForward", active->GetController().CanGoForward());
+  content::NavigationEntry* entry =
+      active->GetController().GetVisibleEntry();
+  const content::FaviconStatus* favicon =
+      entry ? &entry->GetFavicon() : nullptr;
+  if (favicon && favicon->valid && !favicon->url.is_empty()) {
+    state.Set("favicon", favicon->url.spec());
+  }
+  base::ListValue gradient;
+  gradient.Append("#b8c6f8");
+  gradient.Append("#dcc7f5");
+  gradient.Append("#f6d4e3");
+  base::DictValue theme;
+  theme.Set("gradient", std::move(gradient));
+  theme.Set("ink", "#2a2550");
+  theme.Set("accent", "#5b5bd6");
+  state.Set("theme", std::move(theme));
+  state.Set("incognito", false);
+  web_ui()->CallJavascriptFunctionUnsafe(
+      "__violaHostReceive", base::Value("little:render"),
+      base::Value(std::move(state)));
+}
+
+void ViolaMessageHandler::ScheduleRenderState(bool reconcile_tab_strip) {
+  if (CurrentSurface() == "little.html") {
+    if (viola::ViolaProductShellView *shell = GetProductShellView()) {
+      shell->NoteMiniActivity();
+    }
+  }
+  reconcile_before_render_ = reconcile_before_render_ || reconcile_tab_strip;
+  if (render_state_timer_.IsRunning()) {
+    return;
+  }
+  // One navigation can emit title, loading, favicon, audible and selection
+  // changes in the same compositor frame. Coalescing them keeps the keyed
+  // sidebar responsive under heavy tab load and prevents hover artwork from
+  // being needlessly refreshed dozens of times per second.
+  render_state_timer_.Start(
+      FROM_HERE, base::Milliseconds(16), this,
+      &ViolaMessageHandler::FlushScheduledRenderState);
+}
+
+void ViolaMessageHandler::FlushScheduledRenderState() {
+  if (CurrentSurface() != "little.html" && reconcile_before_render_ &&
+      observed_tab_strip_) {
+    NormalizeViolaHomepageTabs(observed_tab_strip_, organization_store_);
+    if (organization_store_ && organization_store_->loaded()) {
+      organization_store_->Reconcile(observed_tab_strip_);
+    }
+  }
+  reconcile_before_render_ = false;
+  SendRenderState();
+}
+
+#if BUILDFLAG(IS_LINUX)
+void ViolaMessageHandler::HandleNativeFind(const base::Value& payload) {
+  if (CurrentSurface() != "overlay.html" || !payload.is_dict() ||
+      !base::CommandLine::ForCurrentProcess()->HasSwitch("viola-native-menu-probe")) return;
+  const auto& request = payload.GetDict();
+  const auto* text = request.FindString("text");
+  const auto* target = request.FindString("targetId");
+  const auto forward = request.FindBool("forward");
+  if (!text || text->size() > 4096 || !target || !forward) return;
+  auto* tabs = GetProductTabStrip();
+  auto* contents = tabs ? tabs->GetActiveWebContents() : nullptr;
+  if (!contents || content::DevToolsAgentHost::GetOrCreateFor(contents)->GetId() != *target) return;
+  auto* helper = find_in_page::FindTabHelper::FromWebContents(contents);
+  if (!helper) return;
+  if (find_observation_.GetSource() != helper) {
+    CloseNativeFind();
+    find_observation_.Observe(helper);
+  }
+  if (text->empty()) {
+    helper->StopFinding(find_in_page::SelectionAction::kClear);
+  } else {
+    helper->StartFinding(base::UTF8ToUTF16(*text), *forward, false, true);
+  }
+}
+
+void ViolaMessageHandler::CloseNativeFind() {
+  if (!find_observation_.IsObserving()) return;
+  auto* helper = find_observation_.GetSource();
+  find_observation_.Reset();
+  helper->StopFinding(find_in_page::SelectionAction::kClear);
+}
+
+void ViolaMessageHandler::OnFindTabHelperDestroyed(find_in_page::FindTabHelper*) {
+  find_observation_.Reset();
+}
+
+void ViolaMessageHandler::OnFindResultAvailable(content::WebContents* contents) {
+  auto* tabs = GetProductTabStrip();
+  if (!IsJavascriptAllowed() || !tabs || tabs->GetActiveWebContents() != contents ||
+      !find_observation_.IsObserving()) return;
+  auto* helper = find_observation_.GetSource();
+  const auto& result = helper->find_result();
+  base::DictValue value;
+  value.Set("targetId", content::DevToolsAgentHost::GetOrCreateFor(contents)->GetId());
+  value.Set("text", base::UTF16ToUTF8(helper->find_text()));
+  value.Set("active", result.active_match_ordinal());
+  value.Set("matches", result.number_of_matches());
+  web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
+      base::Value("find:result"), base::Value(std::move(value)));
+}
+#endif
