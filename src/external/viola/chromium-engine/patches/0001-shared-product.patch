+bool ViolaOrganizationStore::SetCollapsedTabGroups(
+    const std::set<std::string> &group_ids) {
+  if (!loaded_) {
+    return false;
+  }
+  bool changed = false;
+  for (base::Value &space_value : *organization_.FindList("spaces")) {
+    base::DictValue &space = space_value.GetDict();
+    for (base::Value &group_value : *space.FindList("tabGroups")) {
+      base::DictValue &group = group_value.GetDict();
+      const std::string *id = group.FindString("id");
+      const bool collapsed = id && group_ids.contains(*id) &&
+                             !group.FindBool("keepExpanded").value_or(false);
+      if (group.FindBool("collapsed").value_or(false) == collapsed) {
+        continue;
+      }
+      group.Set("collapsed", collapsed);
+      changed = true;
+    }
+  }
+  if (changed) {
+    ScheduleWrite();
+  }
+  return changed;
+}
