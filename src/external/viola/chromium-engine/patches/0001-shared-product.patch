+PdfViewerPrivateRecordViolaSaveFunction::
+    PdfViewerPrivateRecordViolaSaveFunction() = default;
+
+PdfViewerPrivateRecordViolaSaveFunction::
+    ~PdfViewerPrivateRecordViolaSaveFunction() = default;
+
+ExtensionFunction::ResponseAction
+PdfViewerPrivateRecordViolaSaveFunction::Run() {
+  std::optional<RecordViolaSave::Params> params =
+      RecordViolaSave::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  target_path_ = base::FilePath::FromUTF8Unsafe(params->path);
+  if (!target_path_.IsAbsolute() || target_path_.ReferencesParent() ||
+      params->byte_length <= 0 ||
+      params->byte_length > 2.0 * 1024 * 1024 * 1024 ||
+      !base::IsValueInRangeForNumericType<int64_t>(params->byte_length)) {
+    return RespondNow(Error("Invalid saved PDF metadata"));
+  }
+  expected_bytes_ = base::checked_cast<int64_t>(params->byte_length);
+
+  base::WeakPtr<StreamContainer> stream =
+      GetStreamContainer(render_frame_host());
+  if (!stream || !stream->original_url().is_valid()) {
+    return RespondNow(Error("Failed to resolve the saved PDF source"));
+  }
+  source_url_ = stream->original_url();
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](base::FilePath path) { return base::GetFileSize(path); },
+          target_path_),
+      base::BindOnce(
+          &PdfViewerPrivateRecordViolaSaveFunction::OnFileInspected, this));
+  return RespondLater();
+}
+
+void PdfViewerPrivateRecordViolaSaveFunction::OnFileInspected(
+    std::optional<int64_t> actual_bytes) {
+  if (!actual_bytes || *actual_bytes != expected_bytes_) {
+    Respond(Error("Saved PDF could not be verified"));
+    return;
+  }
+  Profile* profile = Profile::FromBrowserContext(browser_context());
+  content::DownloadManager* manager =
+      profile ? profile->GetDownloadManager() : nullptr;
+  if (!manager) {
+    Respond(Error("Download history is unavailable"));
+    return;
+  }
+  manager->GetNextId(base::BindOnce(
+      &PdfViewerPrivateRecordViolaSaveFunction::OnGotDownloadId, this));
+}
+
+void PdfViewerPrivateRecordViolaSaveFunction::OnGotDownloadId(uint32_t id) {
+  Profile* profile = Profile::FromBrowserContext(browser_context());
+  content::DownloadManager* manager =
+      profile ? profile->GetDownloadManager() : nullptr;
+  if (!manager) {
+    Respond(Error("Download history is unavailable"));
+    return;
+  }
+
+  const base::Time now = base::Time::Now();
+  download::DownloadItem* item = manager->CreateDownloadItem(
+      base::Uuid::GenerateRandomV4().AsLowercaseString(), id, target_path_,
+      target_path_, std::vector<GURL>{source_url_}, GURL(),
+      manager->GetStoragePartitionConfigForSiteUrl(source_url_), source_url_,
+      GURL(), url::Origin::Create(source_url_), pdf::kPDFMimeType,
+      pdf::kPDFMimeType, now, now, std::string(), std::string(),
+      expected_bytes_, expected_bytes_, std::string(),
+      download::DownloadItem::COMPLETE,
+      download::DOWNLOAD_DANGER_TYPE_NOT_DANGEROUS,
+      download::DOWNLOAD_INTERRUPT_REASON_NONE, false, now, false,
+      std::vector<download::DownloadItem::ReceivedSlice>());
+  if (!item) {
+    Respond(Error("Saved PDF could not be added to download history"));
+    return;
+  }
+  Respond(NoArguments());
+}
