+std::optional<std::string> ViolaOrganizationStore::CreateWorkspace(
+    std::string_view requested_name, std::string_view requested_icon) {
+  if (!loaded_ || organization_.FindList("spaces")->size() >= 128) {
+    return std::nullopt;
+  }
+  base::DictValue *active =
+      FindSpace(organization_, StringOr(&organization_, "activeSpaceId"));
+  const std::string profile_id =
+      active ? StringOr(active, "profileId")
+             : StringOr(&organization_.FindList("profiles")->front().GetDict(),
+                        "id");
+  const std::string id =
+      "space-" + base::Uuid::GenerateRandomV4().AsLowercaseString();
+  base::DictValue sort;
+  sort.Set("criterion", "recent-desc");
+  sort.Set("keep", false);
+  base::DictValue space;
+  space.Set("id", id);
+  std::string name(requested_name);
+  std::string icon(requested_icon);
+  base::TrimWhitespaceASCII(name, base::TRIM_ALL, &name);
+  base::TrimWhitespaceASCII(icon, base::TRIM_ALL, &icon);
+  if (name.empty() || name.size() > 120 || !base::IsStringUTF8(name)) {
+    name = "New Space";
+  }
+  if (icon.empty() || icon.size() > 32 || !base::IsStringUTF8(icon)) {
+    icon = "✨";
+  }
+  space.Set("name", std::move(name));
+  space.Set("icon", std::move(icon));
+  space.Set("theme", active ? StringOr(active, "theme", "aurora") : "aurora");
+  space.Set("profileId", profile_id);
+  space.Set("pinned", base::ListValue());
+  space.Set("today", base::ListValue());
+  space.Set("tabGroups", base::ListValue());
+  space.Set("split", base::Value());
+  space.Set("splitTitle", base::Value());
+  space.Set("splitKeepExpanded", false);
+  space.Set("tabSort", std::move(sort));
+  space.Set("activeTabId", base::Value());
+  organization_.FindList("spaces")->Append(std::move(space));
+  organization_.Set("activeSpaceId", id);
+  workspace_lens_id_ = id;
+  ScheduleWrite();
+  return id;
+}
+
+std::optional<std::vector<std::string>>
+ViolaOrganizationStore::DeleteWorkspace(std::string_view space_id) {
+  if (!CanDeleteWorkspace(space_id)) {
+    return std::nullopt;
+  }
+  base::ListValue *spaces = organization_.FindList("spaces");
+  for (auto iterator = spaces->begin(); iterator != spaces->end(); ++iterator) {
+    base::DictValue &space = iterator->GetDict();
+    if (StringOr(&space, "id") != space_id) {
+      continue;
+    }
+    std::vector<std::string> tab_ids;
+    for (std::string_view section : {"pinned", "today"}) {
+      for (const base::Value &tab : *space.FindList(section)) {
+        tab_ids.push_back(StringOr(&tab.GetDict(), "id"));
+      }
+    }
+    const bool deleting_active =
+        StringOr(&organization_, "activeSpaceId") == space_id;
+    std::string fallback_space_id;
+    if (deleting_active) {
+      for (const base::Value &candidate : *spaces) {
+        const std::string candidate_id = StringOr(&candidate.GetDict(), "id");
+        if (candidate_id != space_id) {
+          fallback_space_id = candidate_id;
+          break;
+        }
+      }
+    }
+    spaces->erase(iterator);
+    if (deleting_active) {
+      organization_.Set("activeSpaceId", fallback_space_id);
+    }
+    if (workspace_lens_id_ == space_id) {
+      workspace_lens_id_ = deleting_active
+                               ? fallback_space_id
+                               : StringOr(&organization_, "activeSpaceId");
+    }
+    ScheduleWrite();
+    return tab_ids;
+  }
+  return std::nullopt;
+}
+
+bool ViolaOrganizationStore::CanDeleteWorkspace(
+    std::string_view space_id) const {
+  const base::ListValue *spaces = organization_.FindList("spaces");
+  return loaded_ && !space_id.empty() && spaces && spaces->size() > 1 &&
+         FindSpace(organization_, space_id);
+}
+
+bool ViolaOrganizationStore::UpdateWorkspace(std::string_view space_id,
+                                             const base::DictValue &patch) {
+  if (!loaded_) {
+    return false;
+  }
+  base::DictValue *space = FindSpace(organization_, space_id);
+  if (!space || patch.empty() || patch.size() > 3) {
+    return false;
+  }
+  if (const std::optional<int> index = patch.FindInt("index")) {
+    base::ListValue* spaces = organization_.FindList("spaces");
+    if (patch.size() != 1 || !spaces || *index < 0 ||
+        static_cast<size_t>(*index) >= spaces->size()) return false;
+    auto found = std::ranges::find_if(*spaces, [space_id](const base::Value& row) {
+      return row.is_dict() && StringOr(&row.GetDict(), "id") == space_id;
+    });
+    if (found == spaces->end()) return false;
+    base::Value moved = std::move(*found);
+    spaces->erase(found);
+    spaces->Insert(spaces->begin() + *index, std::move(moved));
+    ScheduleWrite();
+    return true;
+  }
+  for (const auto [key, value] : patch) {
+    if (!value.is_string()) {
+      return false;
+    }
+    const std::string &text = value.GetString();
+    if (key == "name") {
+      if (text.empty() || text.size() > 80) {
+        return false;
+      }
+    } else if (key == "icon") {
+      if (text.empty() || text.size() > 32) {
+        return false;
+      }
+    } else if (key == "theme") {
+      if (std::ranges::find(kThemes, text, &ThemeData::key) ==
+          std::end(kThemes)) {
+        return false;
+      }
+    } else {
+      return false;
+    }
+  }
+  for (const auto [key, value] : patch) {
+    space->Set(key, value.Clone());
+  }
+  ScheduleWrite();
+  return true;
+}
+
+bool ViolaOrganizationStore::UpdateSetting(std::string_view key,
+                                           const base::Value &value) {
+  if (!loaded_) {
+    return false;
+  }
+  static constexpr std::string_view kBooleanKeys[] = {
+      "allWorkspacesGroupByWorkspace", "sidebarCollapsed",
+      "miniViolaExternalLinks", "miniViolaShortcut",
+      "miniViolaModifierClicks"};
+  static constexpr std::string_view kStringKeys[] = {
+      "otherWindowTabsLayout", "allWorkspacesTheme", "homepage",
+      "searchEngine", "customSearchName", "customSearchTemplate"};
+  static constexpr std::string_view kNumberKeys[] = {
+      "tabHeight",
+      "tabSpacing",
+      "tabRadius",
+      "workspaceHeaderHeight",
+      "workspaceHeaderRadius",
+      "workspaceSectionSpacing",
+      "workspaceContentInset",
+      "workspaceContentInsetRight",
+      "miniViolaAutoCloseHours"};
+  const bool boolean_key =
+      std::ranges::find(kBooleanKeys, key) != std::end(kBooleanKeys);
+  const bool string_key =
+      std::ranges::find(kStringKeys, key) != std::end(kStringKeys);
+  const bool number_key =
+      std::ranges::find(kNumberKeys, key) != std::end(kNumberKeys);
+  if ((!boolean_key && !string_key && !number_key) ||
+      (boolean_key && !value.is_bool()) || (string_key && !value.is_string()) ||
+      (number_key && !value.is_int() && !value.is_double())) {
+    return false;
+  }
+  base::DictValue *settings = organization_.FindDict("settings");
+  if (!settings) {
+    return false;
+  }
+  base::DictValue candidate = settings->Clone();
+  candidate.Set(key, value.Clone());
+  base::DictValue sanitized = SanitizeSettings(&candidate);
+  const base::Value *normalized = sanitized.Find(key);
+  if (!normalized) {
+    return false;
+  }
+  settings->Set(key, normalized->Clone());
+  ScheduleWrite();
+  return true;
+}
