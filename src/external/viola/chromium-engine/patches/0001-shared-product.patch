+std::optional<std::string>
+ViolaOrganizationStore::WorkspaceTheme(std::string_view space_id) const {
+  const base::DictValue *space =
+      loaded_ ? FindSpace(organization_, space_id) : nullptr;
+  const std::string *theme = space ? space->FindString("theme") : nullptr;
