+
+void ViolaMessageHandler::HandleTabDragDropped(const base::Value &payload) {
+  if (!payload.is_dict() ||
+      (payload.GetDict().size() != 1 && payload.GetDict().size() != 3) ||
+      !organization_store_ || !organization_store_->loaded()) {
+    return;
+  }
+  const std::string *tab_id = payload.GetDict().FindString("tabId");
+  const std::optional<int> requested_x = payload.GetDict().FindInt("screenX");
+  const std::optional<int> requested_y = payload.GetDict().FindInt("screenY");
+  if (payload.GetDict().size() == 3 && (!requested_x || !requested_y)) {
+    ClearSplitDrag();
+    return;
+  }
+  if (!tab_id || *tab_id != split_drag_tab_id_) {
+    ClearSplitDrag();
+    return;
+  }
+  TabStripModel *tab_strip = GetProductTabStrip();
+  const int dragged_index =
+      tab_strip ? organization_store_->FindTabIndex(tab_strip, *tab_id)
+                : TabStripModel::kNoTab;
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  if (tab_strip && browser && dragged_index != TabStripModel::kNoTab &&
+      (split_drag_target_id_.empty() || split_drag_zone_.empty())) {
+    display::Screen *screen = display::Screen::Get();
+    const gfx::Point cursor =
+        screen ? screen->GetCursorScreenPoint() : gfx::Point();
+    if (screen && !browser->GetWindow()->GetBounds().Contains(cursor) &&
+        chrome::CanMoveTabsToNewWindow(browser, {dragged_index})) {
+      const gfx::Rect source_bounds = browser->GetWindow()->GetBounds();
+      ClearSplitDrag();
+      chrome::MoveTabsToNewWindow(browser, {dragged_index});
+      BrowserWindowInterface *new_owner = nullptr;
+      TabStripModel *new_strip = nullptr;
+      int new_index = TabStripModel::kNoTab;
+      if (FindLiveTabOwner(*tab_id, &new_owner, &new_strip, &new_index) &&
+          new_owner && new_owner != browser && new_owner->GetWindow()) {
+        const gfx::Point drop_point(
+            requested_x.value_or(cursor.x()), requested_y.value_or(cursor.y()));
+        gfx::Rect placed = source_bounds;
+        placed.set_origin(gfx::Point(drop_point.x() - 48,
+                                    drop_point.y() - 28));
+        const display::Display display =
+            screen->GetDisplayNearestPoint(drop_point);
+        placed.AdjustToFit(display.work_area());
+        new_owner->GetWindow()->SetBounds(placed);
+      }
+      return;
+    }
+    ClearSplitDrag();
+    return;
+  }
+  const int target_index =
+      tab_strip
+          ? organization_store_->FindTabIndex(tab_strip, split_drag_target_id_)
+          : TabStripModel::kNoTab;
+  const std::optional<viola::TabContextMenuState> dragged =
+      organization_store_->GetTabContextMenuState(*tab_id);
+  const std::optional<viola::TabContextMenuState> target =
+      organization_store_->GetTabContextMenuState(split_drag_target_id_);
+  if (!tab_strip || dragged_index == TabStripModel::kNoTab ||
+      target_index == TabStripModel::kNoTab || dragged_index == target_index ||
+      tab_strip->active_index() != target_index ||
+      tab_strip->GetSplitForTab(dragged_index) ||
+      tab_strip->GetSplitForTab(target_index) || !dragged || !target ||
+      dragged->profile_id != target->profile_id ||
+      organization_store_->IsPinned(dragged->tab_id) !=
+          organization_store_->IsPinned(target->tab_id)) {
+    ClearSplitDrag();
+    return;
+  }
+
+  const bool stacked =
+      split_drag_zone_ == "top" || split_drag_zone_ == "bottom";
+  const split_tabs::SplitTabId split_id = tab_strip->AddToNewSplit(
+      {dragged_index},
+      split_tabs::SplitTabVisualData(
+          stacked ? split_tabs::SplitTabLayout::kStacked
+                  : split_tabs::SplitTabLayout::kSideBySide),
+      split_tabs::SplitTabCreatedSource::kDragAndDropTab);
+  split_tabs::SplitTabData *data = tab_strip->GetSplitData(split_id);
+  if (!data || data->ListTabs().size() != 2) {
+    if (data) {
+      tab_strip->RemoveSplit(split_id);
+    }
+    ClearSplitDrag();
+    return;
+  }
+  const std::string desired_first =
+      split_drag_zone_ == "left" || split_drag_zone_ == "top" ? dragged->tab_id
+                                                              : target->tab_id;
+  if (organization_store_->TabIdFor(data->ListTabs().front()->GetContents()) !=
+      desired_first) {
+    tab_strip->ReverseTabsInSplit(split_id);
+  }
+  data = tab_strip->GetSplitData(split_id);
+  const std::vector<tabs::TabInterface *> split_members = data->ListTabs();
+  const std::string first_id =
+      organization_store_->TabIdFor(split_members[0]->GetContents());
+  const std::string second_id =
+      organization_store_->TabIdFor(split_members[1]->GetContents());
+  if (!organization_store_->SetSplitPair(target->space_id, first_id, second_id,
+                                         stacked ? "v" : "h", 0.5)) {
+    tab_strip->RemoveSplit(split_id);
+    ClearSplitDrag();
+    return;
+  }
+  const int activated_index =
+      organization_store_->FindTabIndex(tab_strip, dragged->tab_id);
+  if (activated_index != TabStripModel::kNoTab) {
+    tab_strip->ActivateTabAt(
+        activated_index, TabStripUserGestureDetails(
+                             TabStripUserGestureDetails::GestureType::kMouse));
+  }
+  ClearSplitDrag();
+  SendRenderState();
+}
+
+void ViolaMessageHandler::HandleSplitRemove(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 1 ||
+      !organization_store_ || !organization_store_->loaded()) {
+    return;
+  }
+  const std::string *tab_id = payload.GetDict().FindString("tabId");
+  const std::optional<viola::TabContextMenuState> state =
+      tab_id ? organization_store_->GetTabContextMenuState(*tab_id)
+             : std::nullopt;
+  TabStripModel *tab_strip = GetProductTabStrip();
+  const int index = state && tab_strip
+                        ? organization_store_->FindTabIndex(tab_strip, *tab_id)
+                        : TabStripModel::kNoTab;
+  const std::optional<split_tabs::SplitTabId> split_id =
+      index == TabStripModel::kNoTab ? std::nullopt
+                                     : tab_strip->GetSplitForTab(index);
+  if (!state || !state->in_split || !split_id ||
+      !organization_store_->RemoveTabFromSplit(state->space_id, *tab_id)) {
+    return;
+  }
+  tab_strip->RemoveSplit(*split_id);
+  SendRenderState();
+}
+
+void ViolaMessageHandler::HandleSplitDissolve(const base::Value &payload) {
+  if (!payload.is_none() || !organization_store_ ||
+      !organization_store_->loaded()) {
+    return;
+  }
+  TabStripModel *tab_strip = GetProductTabStrip();
+  content::WebContents *active =
+      tab_strip ? tab_strip->GetActiveWebContents() : nullptr;
+  const std::string tab_id = organization_store_->TabIdFor(active);
+  const std::optional<viola::TabContextMenuState> state =
+      organization_store_->GetTabContextMenuState(tab_id);
+  const int index = tab_strip
+                        ? organization_store_->FindTabIndex(tab_strip, tab_id)
+                        : TabStripModel::kNoTab;
+  const std::optional<split_tabs::SplitTabId> split_id =
+      index == TabStripModel::kNoTab ? std::nullopt
+                                     : tab_strip->GetSplitForTab(index);
+  if (!state || !state->in_split || !split_id ||
+      !organization_store_->DissolveSplit(state->space_id)) {
+    return;
+  }
+  tab_strip->RemoveSplit(*split_id);
+  SendRenderState();
+}
