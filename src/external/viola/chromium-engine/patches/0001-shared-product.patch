+bool ViolaOrganizationStore::SetTabGroupSaved(std::string_view space_id,
+                                              std::string_view group_id,
+                                              bool saved) {
+  if (!loaded_) {
+    return false;
+  }
+  base::DictValue *space = FindSpace(organization_, space_id);
+  base::DictValue *group = FindTabGroup(organization_, space_id, group_id);
+  if (!space || !group) {
+    return false;
+  }
+  group->Set("saved", saved);
+  base::ListValue snapshots;
+  if (saved) {
+    for (const base::Value &id : *group->FindList("tabIds")) {
+      const base::DictValue *persistent =
+          FindPersistentTab(organization_, id.GetString());
+      if (!persistent) {
+        continue;
+      }
+      base::DictValue snapshot;
+      snapshot.Set("tabId", id.GetString());
+      snapshot.Set("url", SavedSnapshotUrl(*persistent));
+      snapshot.Set("title", StringOr(persistent, "title"));
+      snapshots.Append(std::move(snapshot));
+    }
+    group->Set("savedTabs", std::move(snapshots));
+  } else {
+    group->Set("savedTabs", std::move(snapshots));
+    if (group->FindList("tabIds")->size() < 2) {
+      ExtractTabGroup(*space, group_id);
+    }
+  }
+  ScheduleWrite();
+  return true;
+}
