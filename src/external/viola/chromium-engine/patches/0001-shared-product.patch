+IN_PROC_BROWSER_TEST_F(ViolaProductShellBrowserTest,
+                       NativeCloseRemovesPersistentTab) {
+  BrowserView *browser_view = BrowserView::GetBrowserViewForBrowser(browser());
+  ASSERT_TRUE(browser_view);
+  auto *shell_view = browser_view->viola_product_shell_view_for_testing();
+  ASSERT_TRUE(shell_view);
+  content::WebContents *shell_contents = shell_view->shell_web_contents();
+  ASSERT_TRUE(shell_contents);
+  ASSERT_TRUE(content::WaitForLoadStop(shell_contents));
+
+  const GURL closing_url("data:text/html,<title>ViolaNativeClose</title>close");
+  ASSERT_TRUE(AddTabAtIndex(1, closing_url, ui::PAGE_TRANSITION_TYPED));
+  TabStripModel *tab_strip = browser()->tab_strip_model();
+  ASSERT_TRUE(tab_strip);
+  tab_strip->ActivateTabAt(
+      1, TabStripUserGestureDetails(
+             TabStripUserGestureDetails::GestureType::kKeyboard));
+  EXPECT_TRUE(content::EvalJs(shell_contents, R"(
+    new Promise((resolve) => {
+      const deadline = performance.now() + 5000;
+      const check = () => {
+        const row = [...document.querySelectorAll('.tab')].find((candidate) =>
+          candidate.querySelector('.title')?.textContent === 'ViolaNativeClose');
+        if (row) {
+          window.__violaNativeCloseTabId = row.dataset.tabId;
+          resolve(true);
+        } else if (performance.now() >= deadline) {
+          resolve(false);
+        } else {
+          setTimeout(check, 20);
+        }
+      };
+      check();
+    })
+  )")
+                  .ExtractBool());
+  const std::string closing_id =
+      content::EvalJs(shell_contents, "window.__violaNativeCloseTabId")
+          .ExtractString();
+  viola::ViolaOrganizationStore *organization_store =
+      viola::ViolaOrganizationStore::Get(browser()->profile());
+  ASSERT_TRUE(organization_store);
+  ASSERT_TRUE(organization_store->GetTabContextMenuState(closing_id));
+
+  chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(TabStripModel::kNoTab,
+            organization_store->FindTabIndex(tab_strip, closing_id));
+  EXPECT_FALSE(organization_store->GetTabContextMenuState(closing_id));
+  bool tombstone_found = false;
+  const base::DictValue persisted =
+      organization_store->ExportOrganizationForSync();
+  for (const base::Value &space : *persisted.FindList("spaces")) {
+    const base::ListValue *removed =
+        space.GetDict().FindList("syncRemovedTabIds");
+    if (!removed) {
+      continue;
+    }
+    tombstone_found = std::ranges::any_of(
+        *removed, [&](const base::Value &candidate) {
+          return candidate.is_string() && candidate.GetString() == closing_id;
+        });
+    if (tombstone_found) {
+      break;
+    }
+  }
+  EXPECT_TRUE(tombstone_found);
+  EXPECT_TRUE(content::EvalJs(shell_contents, R"(
+    new Promise((resolve) => {
+      const deadline = performance.now() + 5000;
+      const check = () => {
+        const present = [...document.querySelectorAll('.tab')].some(
+          (row) => row.dataset.tabId === window.__violaNativeCloseTabId);
+        if (!present) {
+          resolve(true);
+        } else if (performance.now() >= deadline) {
+          resolve(false);
+        } else {
+          setTimeout(check, 20);
+        }
+      };
+      check();
+    })
+  )")
+                  .ExtractBool());
+}
