+bool ViolaMessageHandler::IsCommandIdChecked(int command_id) const {
+  if (!workspace_context_menu_id_.empty() && command_id >= kThemeCommandStart &&
+      command_id < kThemeCommandStart + kThemeCommandCount &&
+      organization_store_) {
+    const std::optional<std::string> theme =
+        organization_store_->WorkspaceTheme(workspace_context_menu_id_);
+    const size_t theme_index =
+        base::checked_cast<size_t>(command_id - kThemeCommandStart);
+    return theme && *theme == base::span(kThemeMenuItems).at(theme_index).key;
+  }
+  if (tab_context_menu_state_) {
+    if (command_id == kTabMute) {
+      return tab_context_menu_state_->muted;
+    }
+    if (command_id == kTabKeepActive) {
+      return tab_context_menu_state_->keep_active;
+    }
+    if (command_id == kTabMiniPlayerExcluded) {
+      return tab_context_menu_state_->mini_player_excluded;
+    }
+  }
+  if (tab_group_context_menu_state_) {
+    if (command_id == kGroupKeepExpanded) {
+      return tab_group_context_menu_state_->keep_expanded;
+    }
+    if (command_id == kGroupKeepSaved) {
+      return tab_group_context_menu_state_->saved;
+    }
+  }
+  return false;
+}
+
+bool ViolaMessageHandler::IsCommandIdEnabled(int command_id) const {
+  if (command_id >= kBrowserNewTab && command_id <= kBrowserHelp) {
+    return command_id != kBrowserReader && command_id != kBrowserShare;
+  }
+  if (command_id >= kAppAbout && command_id <= kAppQuit) {
+    return true;
+  }
+  if (context_menu_workspace_targets_.contains(command_id)) {
+    return true;
+  }
+  if (tab_context_menu_state_) {
+    if (command_id == kTabMoveWorkspaceSubmenu) {
+      return !tab_context_menu_state_->workspace_targets.empty();
+    }
+    return command_id >= kTabMute && command_id <= kTabDissolveSplit;
+  }
+  if (tab_group_context_menu_state_) {
+    if (command_id == kGroupMoveWorkspaceSubmenu) {
+      return !tab_group_context_menu_state_->workspace_targets.empty();
+    }
+    if (command_id == kGroupOpenSaved) {
+      return tab_group_context_menu_state_->saved &&
+             tab_group_context_menu_state_->tab_ids.size() <
+                 tab_group_context_menu_state_->saved_tab_count;
+    }
+    if (command_id == kGroupKeepSaved && tab_group_context_menu_state_->split) {
+      return false;
+    }
+    if (command_id == kGroupReloadAll || command_id == kGroupClose) {
+      return !tab_group_context_menu_state_->tab_ids.empty();
+    }
+    return command_id >= kGroupRename && command_id <= kGroupClose;
+  }
+  if (!workspace_context_menu_id_.empty()) {
+    if (command_id == kSpaceDelete) {
+      return organization_store_->CanDeleteWorkspace(
+          workspace_context_menu_id_);
+    }
+    if (command_id >= kThemeCommandStart &&
+        command_id < kThemeCommandStart + kThemeCommandCount) {
+      return workspace_context_menu_id_ != "@all";
+    }
+    return tabs_context_menu_
+               ? command_id >= kTabsGoToWorkspace &&
+                     command_id <= kTabsThemeSubmenu
+               : command_id >= kSpaceRename && command_id <= kSpaceDelete;
+  }
+  return false;
+}
+
+bool ViolaMessageHandler::GetAcceleratorForCommandId(
+    int command_id,
+    ui::Accelerator *accelerator) const {
+  if (!accelerator) {
+    return false;
+  }
+  ui::KeyboardCode key = ui::VKEY_UNKNOWN;
+  int modifiers = ui::EF_CONTROL_DOWN;
+  switch (command_id) {
+  case kBrowserNewTab: key = ui::VKEY_T; break;
+  case kBrowserNewWindow:
+  case kAppRestoreTab:
+    key = ui::VKEY_T;
+    modifiers |= ui::EF_SHIFT_DOWN;
+    break;
+  case kAppNewWindow: key = ui::VKEY_N; break;
+  case kBrowserNewPrivateWindow:
+  case kAppNewPrivateWindow:
+    key = ui::VKEY_N;
+    modifiers |= ui::EF_SHIFT_DOWN;
+    break;
+  case kBrowserHistory: key = ui::VKEY_H; break;
+  case kBrowserDownloads: key = ui::VKEY_J; break;
+  case kBrowserBookmarkThisTab: key = ui::VKEY_D; break;
+  case kBrowserShowBookmarks:
+    key = ui::VKEY_O;
+    modifiers |= ui::EF_SHIFT_DOWN;
+    break;
+  case kBrowserFind: key = ui::VKEY_F; break;
+  case kBrowserPrint: key = ui::VKEY_P; break;
+  case kBrowserSave: key = ui::VKEY_S; break;
+  case kBrowserDeveloperTools:
+    key = ui::VKEY_I;
+    modifiers |= ui::EF_SHIFT_DOWN;
+    break;
+  case kBrowserViewSource: key = ui::VKEY_U; break;
+  case kBrowserSettings:
+  case kAppSettings: key = ui::VKEY_OEM_COMMA; break;
+  case kTabReload: key = ui::VKEY_R; break;
+  case kTabReloadWithoutCache:
+    key = ui::VKEY_R;
+    modifiers |= ui::EF_SHIFT_DOWN;
+    break;
+  case kTabCopyLink:
+    key = ui::VKEY_C;
+    modifiers |= ui::EF_SHIFT_DOWN;
+    break;
+  case kTabClose: key = ui::VKEY_W; break;
+  default: return false;
+  }
+  *accelerator = ui::Accelerator(key, modifiers);
+  return true;
+}
+
+void ViolaMessageHandler::ExecuteCommand(int command_id, int) {
+  if ((command_id >= kBrowserNewTab && command_id <= kBrowserHelp) ||
+      (command_id >= kAppAbout && command_id <= kAppQuit)) {
+    BrowserWindowInterface *browser =
+        webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+    if (!browser) {
+      return;
+    }
+    int chromium_command = 0;
+    switch (command_id) {
+    case kBrowserNewTab: chromium_command = IDC_NEW_TAB; break;
+    case kBrowserNewWindow:
+    case kAppNewWindow: chromium_command = IDC_NEW_WINDOW; break;
+    case kBrowserNewPrivateWindow:
+    case kAppNewPrivateWindow: chromium_command = IDC_NEW_INCOGNITO_WINDOW; break;
+    case kBrowserZoomOut: chromium_command = IDC_ZOOM_MINUS; break;
+    case kBrowserZoomReset: chromium_command = IDC_ZOOM_NORMAL; break;
+    case kBrowserZoomIn: chromium_command = IDC_ZOOM_PLUS; break;
+    case kBrowserFullscreen: chromium_command = IDC_FULLSCREEN; break;
+    case kBrowserHistory: chromium_command = IDC_SHOW_HISTORY; break;
+    case kBrowserDownloads: chromium_command = IDC_SHOW_DOWNLOADS; break;
+    case kBrowserBookmarkThisTab:
+      chrome::BookmarkCurrentTab(browser);
+      return;
+    case kBrowserShowBookmarks: chromium_command = IDC_SHOW_BOOKMARK_MANAGER; break;
+    case kBrowserPasswords: chromium_command = IDC_PASSWORDS_AND_AUTOFILL_MENU; break;
+    case kBrowserFind: chromium_command = IDC_FIND; break;
+    case kBrowserTranslate: chromium_command = IDC_SHOW_TRANSLATE; break;
+    case kBrowserPrint: chromium_command = IDC_PRINT; break;
+    case kBrowserSave: chromium_command = IDC_SAVE_PAGE; break;
+    case kBrowserInstallApp: chromium_command = IDC_INSTALL_PWA; break;
+    case kBrowserTaskManager: chromium_command = IDC_TASK_MANAGER; break;
+    case kBrowserExtensions: chromium_command = IDC_MANAGE_EXTENSIONS; break;
+    case kBrowserDeveloperTools: chromium_command = IDC_DEV_TOOLS; break;
+    case kBrowserViewSource: chromium_command = IDC_VIEW_SOURCE; break;
+    case kBrowserSettings:
+    case kAppSettings:
+      HandleBrowserPage(viola::HostChannel::kSettingsOpen, base::Value());
+      return;
+    case kBrowserHelp: chromium_command = IDC_HELP_PAGE_VIA_MENU; break;
+    case kAppAbout: chromium_command = IDC_ABOUT; break;
+    case kAppRestoreTab: chromium_command = IDC_RESTORE_TAB; break;
+    case kAppCloseWindow: chromium_command = IDC_CLOSE_WINDOW; break;
+    case kAppNewMini: chromium_command = IDC_VIOLA_NEW_MINI; break;
+    case kAppAdoptMini:
+      viola::ViolaMiniWindow::AdoptIntoWorkspace(browser->GetBrowserForMigrationOnly());
+      return;
+    case kAppQuit: chromium_command = IDC_EXIT; break;
+    default: return;
+    }
+    chrome::ExecuteCommand(browser, chromium_command);
+    return;
+  }
+  if (!organization_store_ || !organization_store_->loaded()) {
+    return;
+  }
+  if (tab_context_menu_state_) {
+    const std::optional<viola::TabContextMenuState> current =
+        organization_store_->GetTabContextMenuState(
+            tab_context_menu_state_->tab_id);
+    if (!current || current->section != tab_context_menu_state_->section) {
+      return;
+    }
+    TabStripModel *tab_strip = GetProductTabStrip();
+    const int live_index =
+        tab_strip
+            ? organization_store_->FindTabIndex(tab_strip, current->tab_id)
+            : TabStripModel::kNoTab;
+    if (auto target = context_menu_workspace_targets_.find(command_id);
+        target != context_menu_workspace_targets_.end()) {
+      base::DictValue request;
+      request.Set("tabId", current->tab_id);
+      request.Set("spaceId", target->second);
+      HandleTabMove(base::Value(std::move(request)), false);
+      return;
+    }
+    switch (command_id) {
+    case kTabMute: {
+      base::DictValue request;
+      request.Set("tabId", current->tab_id);
+      HandleTabToggleMute(base::Value(std::move(request)));
+      return;
+    }
+    case kTabKeepActive:
+      if (organization_store_->SetTabKeepActive(current->tab_id,
+                                                !current->keep_active)) {
+        SendRenderState();
+      }
+      return;
+    case kTabMiniPlayerExcluded:
+      if (organization_store_->SetTabMiniPlayerExcluded(
+              current->tab_id, !current->mini_player_excluded)) {
+        if (current->tab_id == media_tab_id_) {
+          StopMediaPreviewCapture(/*notify_renderer=*/true);
+          media_tab_id_.clear();
+          media_fingerprint_.clear();
+        }
+        RefreshMediaState();
+        SendRenderState();
+      }
+      return;
+    case kTabTogglePinned: {
+      base::DictValue request;
+      request.Set("tabId", current->tab_id);
+      request.Set("spaceId", current->space_id);
+      request.Set("section", current->section == "pinned" ? "today" : "pinned");
+      request.Set("index", current->section == "pinned" ? 0 : 4096);
+      HandleTabMove(base::Value(std::move(request)), true);
+      return;
+    }
+    case kTabToggleFavorite: {
+      const std::string destination =
+          current->section == "favorite" ? "today" : "favorite";
+      if (organization_store_->MoveTab(current->tab_id, current->space_id,
+                                       destination,
+                                       destination == "today" ? 0 : 4096)) {
+        if (live_index != TabStripModel::kNoTab &&
+            tab_strip->IsTabPinned(live_index)) {
+          tab_strip->SetTabPinned(live_index, false);
+        }
+        SendRenderState();
+      }
+      return;
+    }
+    case kTabReload:
+      if (live_index != TabStripModel::kNoTab) {
+        tab_strip->GetWebContentsAt(live_index)->GetController().Reload(
+            content::ReloadType::NORMAL, true);
+      }
+      return;
+    case kTabReloadWithoutCache:
+      if (live_index != TabStripModel::kNoTab) {
+        tab_strip->GetWebContentsAt(live_index)
+            ->GetController()
+            .Reload(content::ReloadType::BYPASSING_CACHE, true);
+      }
+      return;
+    case kTabDuplicate: {
+      BrowserWindowInterface *browser =
+          webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+      if (browser && live_index != TabStripModel::kNoTab) {
+        chrome::DuplicateTabAt(browser, live_index);
+      }
+      return;
+    }
+    case kTabCreateGroup:
+      if (tab_context_selected_ids_.size() >= 2) {
+        base::DictValue request;
+        request.Set("action", "group");
+        base::ListValue ids;
+        for (const std::string &tab_id : tab_context_selected_ids_) {
+          ids.Append(tab_id);
+        }
+        request.Set("tabIds", std::move(ids));
+        HandleTabsSelectionAction(base::Value(std::move(request)));
+        return;
+      }
+      if (organization_store_->CreateSingleTabGroup(current->tab_id,
+                                                    current->space_id)) {
+        SendRenderState();
+      }
+      return;
+    case kTabRemoveFromGroup:
+      if (organization_store_->RemoveTabFromGroup(current->tab_id)) {
+        SendRenderState();
+      }
+      return;
+    case kTabDissolveGroup:
+      if (!current->group_id.empty() &&
+          organization_store_->DissolveTabGroup(current->space_id,
+                                                current->group_id)) {
+        SendRenderState();
+      }
+      return;
+    case kTabCopyLink: {
+      ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+      writer.WriteText(base::UTF8ToUTF16(current->url));
+      return;
+    }
+    case kTabClose: {
+      base::DictValue request;
+      request.Set("tabId", current->tab_id);
+      HandleTabClose(base::Value(std::move(request)));
+      return;
+    }
+    case kTabCloseOther:
+    case kTabCloseBelow: {
+      if (live_index == TabStripModel::kNoTab) {
+        return;
+      }
+      const int first = command_id == kTabCloseOther ? 0 : live_index + 1;
+      for (int index = tab_strip->count() - 1; index >= first; --index) {
+        if (index == live_index) {
+          continue;
+        }
+        tab_strip->CloseWebContentsAt(
+            index, TabCloseTypes::CLOSE_USER_GESTURE |
+                       TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+      }
+      return;
+    }
+    case kTabRemoveFromSplit: {
+      base::DictValue request;
+      request.Set("tabId", current->tab_id);
+      HandleSplitRemove(base::Value(std::move(request)));
+      return;
+    }
+    case kTabDissolveSplit:
+      HandleSplitDissolve(base::Value());
+      return;
+    default:
+      return;
+    }
+  }
+
+  if (!workspace_context_menu_id_.empty()) {
+    const std::string space_id = workspace_context_menu_id_;
+    if (space_id != "@all" && !organization_store_->HasWorkspace(space_id)) {
+      return;
+    }
+    if (command_id >= kThemeCommandStart &&
+        command_id < kThemeCommandStart + kThemeCommandCount) {
+      if (space_id == "@all") {
+        return;
+      }
+      const size_t theme_index =
+          base::checked_cast<size_t>(command_id - kThemeCommandStart);
+      base::DictValue patch;
+      patch.Set("theme",
+                std::string(base::span(kThemeMenuItems).at(theme_index).key));
+      if (organization_store_->UpdateWorkspace(space_id, patch)) {
+        SendRenderState();
+      }
+      return;
+    }
+    switch (command_id) {
+    case kTabsGoToWorkspace: {
+      if (!tabs_context_menu_ || space_id == "@all") {
+        return;
+      }
+      base::DictValue request;
+      request.Set("spaceId", space_id);
+      HandleWorkspaceSwitch(base::Value(std::move(request)));
+      return;
+    }
+    case kTabsNewTab:
+      if (tabs_context_menu_) {
+        HandleNewTab(base::Value(base::DictValue()));
+      }
+      return;
+    case kTabsSettings:
+    case kSpaceSettings:
+      HandleBrowserPage(viola::HostChannel::kSettingsOpen, base::Value());
+      return;
+    case kTabsNewWorkspace:
+    case kSpaceNew:
+      SendSidebarEvent("space:startCreate", base::DictValue());
+      return;
+    case kSpaceRename: {
+      if (tabs_context_menu_) {
+        return;
+      }
+      base::DictValue request;
+      request.Set("spaceId", space_id);
+      HandleWorkspaceSwitch(base::Value(std::move(request)));
+      SendSidebarEvent("space:startRename", base::DictValue());
+      return;
+    }
+    case kSpaceDelete: {
+      if (!organization_store_->CanDeleteWorkspace(space_id)) {
+        return;
+      }
+      base::DictValue request;
+      request.Set("spaceId", space_id);
+      SendSidebarEvent("space:confirmDelete", std::move(request));
+      return;
+    }
+    default:
+      return;
+    }
+  }
+
+  if (!tab_group_context_menu_state_) {
+    return;
+  }
+  const std::optional<viola::TabGroupContextMenuState> current =
+      organization_store_->GetTabGroupContextMenuState(
+          tab_group_context_menu_state_->space_id,
+          tab_group_context_menu_state_->group_id);
+  if (!current) {
+    return;
+  }
+  if (auto target = context_menu_workspace_targets_.find(command_id);
+      target != context_menu_workspace_targets_.end()) {
+    base::DictValue request;
+    request.Set("groupId", current->group_id);
+    request.Set("sourceSpaceId", current->space_id);
+    request.Set("destinationSpaceId", target->second);
+    request.Set("section", current->section);
+    request.Set("index", 0);
+    HandleTabGroupMoveToSpace(base::Value(std::move(request)));
+    return;
+  }
+  switch (command_id) {
+  case kGroupRename: {
+    base::DictValue event;
+    event.Set("groupId", current->group_id);
+    SendSidebarEvent("tabGroup:startRename", std::move(event));
+    return;
+  }
+  case kGroupKeepExpanded:
+    if ((current->split && organization_store_->SetSplitKeepExpanded(
+                               current->space_id, !current->keep_expanded)) ||
+        (!current->split &&
+         organization_store_->SetTabGroupKeepExpanded(
+             current->space_id, current->group_id, !current->keep_expanded))) {
+      SendRenderState();
+    }
+    return;
+  case kGroupKeepSaved:
+    if (organization_store_->SetTabGroupSaved(
+            current->space_id, current->group_id, !current->saved)) {
+      SendRenderState();
+    }
+    return;
+  case kGroupOpenSaved: {
+    base::DictValue request;
+    request.Set("groupId", current->group_id);
+    request.Set("spaceId", current->space_id);
+    HandleTabGroupOpenSaved(base::Value(std::move(request)));
+    return;
+  }
+  case kGroupReloadAll: {
+    TabStripModel *tab_strip = GetProductTabStrip();
+    if (!tab_strip) {
+      return;
+    }
+    for (const std::string &tab_id : current->tab_ids) {
+      const int index = organization_store_->FindTabIndex(tab_strip, tab_id);
+      if (index != TabStripModel::kNoTab) {
+        tab_strip->GetWebContentsAt(index)->GetController().Reload(
+            content::ReloadType::NORMAL, true);
+      }
+    }
+    return;
+  }
+  case kGroupTogglePinned: {
+    base::DictValue request;
+    request.Set("groupId", current->group_id);
+    request.Set("spaceId", current->space_id);
+    base::ListValue ids;
+    for (const std::string &tab_id : current->tab_ids) {
+      ids.Append(tab_id);
+    }
+    request.Set("tabIds", std::move(ids));
+    request.Set("section", current->section == "pinned" ? "today" : "pinned");
+    request.Set("index", current->section == "pinned" ? 0 : 4096);
+    HandleTabGroupReorder(base::Value(std::move(request)));
+    return;
+  }
+  case kGroupDissolve:
+    if (current->split) {
+      TabStripModel *tab_strip = GetProductTabStrip();
+      const int first_index = tab_strip && !current->tab_ids.empty()
+                                  ? organization_store_->FindTabIndex(
+                                        tab_strip, current->tab_ids.front())
+                                  : TabStripModel::kNoTab;
+      const std::optional<split_tabs::SplitTabId> split_id =
+          first_index == TabStripModel::kNoTab
+              ? std::nullopt
+              : tab_strip->GetSplitForTab(first_index);
+      if (organization_store_->DissolveSplit(current->space_id)) {
+        if (split_id) {
+          tab_strip->RemoveSplit(*split_id);
+        }
+        SendRenderState();
+      }
+    } else if (organization_store_->DissolveTabGroup(current->space_id,
+                                                     current->group_id)) {
+      SendRenderState();
+    }
+    return;
+  case kGroupClose: {
+    base::DictValue request;
+    request.Set("groupId", current->group_id);
+    request.Set("spaceId", current->space_id);
+    base::ListValue ids;
+    for (const std::string &tab_id : current->tab_ids) {
+      ids.Append(tab_id);
+    }
+    request.Set("tabIds", std::move(ids));
+    HandleTabGroupClose(base::Value(std::move(request)));
+    return;
+  }
+  default:
+    return;
+  }
+}
+
+void ViolaMessageHandler::SendSidebarEvent(std::string_view channel,
+                                           base::DictValue payload) {
+  if (!IsJavascriptAllowed() || CurrentSurface() != "sidebar.html") {
+    return;
+  }
+  web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
+                                         base::Value(channel),
+                                         base::Value(std::move(payload)));
+}
+
+void ViolaMessageHandler::HandleBrowserPage(viola::HostChannel channel,
+                                            const base::Value &payload) {
+  if (!payload.is_none()) {
+    return;
+  }
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  if (!browser) {
+    return;
+  }
+  if (channel == viola::HostChannel::kSettingsOpen) {
+    if (CurrentSurface() == "settings.html") {
+      content::WebContents *settings_contents = web_ui()->GetWebContents();
+      ViolaBrowserToolThemeObserver::CreateForWebContents(settings_contents);
+      ViolaBrowserToolThemeObserver::FromWebContents(settings_contents)
+          ->HideUntilThemed();
+      content::NavigationController::LoadURLParams params(
+          chrome::GetSettingsUrl(""));
+      params.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+      settings_contents->GetController().LoadURLWithParams(params);
+      return;
+    }
+    TabStripModel *tab_strip = GetProductTabStrip();
+    if (!tab_strip) {
+      return;
+    }
+    content::WebContents *active = tab_strip->GetActiveWebContents();
+    if (active) {
+      content::NavigationController::LoadURLParams params(
+          GURL("chrome://viola/settings.html"));
+      params.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+      active->GetController().LoadURLWithParams(params);
+    }
+  } else if (channel == viola::HostChannel::kDownloadManager) {
+    TabStripModel *tab_strip = GetProductTabStrip();
+    content::WebContents *active =
+        tab_strip ? tab_strip->GetActiveWebContents() : nullptr;
+    if (!active) {
+      return;
+    }
+    content::NavigationController::LoadURLParams params(
+        GURL("chrome://viola/settings.html#Downloads"));
+    params.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+    active->GetController().LoadURLWithParams(params);
+  }
+}
+
+void ViolaMessageHandler::HandleBoundedBrowserPage(const base::Value &payload) {
+  if (CurrentSurface() != "settings.html" || !payload.is_dict() ||
+      payload.GetDict().size() < 1 || payload.GetDict().size() > 2) {
+    return;
+  }
+  const std::string *page = payload.GetDict().FindString("page");
+  if (!page || !GetActiveSettingsTabStrip()) {
+    return;
+  }
+  if ((*page == "extensionOptions") != (payload.GetDict().size() == 2)) {
+    return;
+  }
+
+  if (*page == "extensions" || *page == "history" || *page == "bookmarks" ||
+      *page == "downloads") {
+    base::DictValue section;
+    section.Set("name", *page == "extensions"  ? "Extensions"
+                        : *page == "history"   ? "History"
+                        : *page == "bookmarks" ? "Bookmarks"
+                                               : "Downloads");
+    web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
+                                           base::Value("settings:section"),
+                                           base::Value(std::move(section)));
+    return;
+  }
+
+  if (*page == "extensionOptions") {
+    const std::string *extension_id = payload.GetDict().FindString("extId");
+    Profile *profile = GetActiveSettingsProfile();
+    extensions::ExtensionRegistry *registry =
+        profile ? extensions::ExtensionRegistry::Get(profile) : nullptr;
+    const extensions::Extension *extension =
+        extension_id && IsBoundedExtensionId(*extension_id) && registry
+            ? registry->GetInstalledExtension(*extension_id)
+            : nullptr;
+    const GURL options_url =
+        extension && IsUserVisibleExtension(*extension)
+            ? extensions::OptionsPageInfo::GetOptionsPage(extension)
+            : GURL();
+    BrowserWindowInterface *browser =
+        webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+    if (!options_url.is_valid() || !options_url.SchemeIs("chrome-extension") ||
+        !browser) {
+      return;
+    }
+    chrome::AddTabAt(browser, options_url, -1, true);
+    return;
+  }
+
+  GURL destination;
+  if (*page == "extensionsAdvanced") {
+    destination = GURL(chrome::kChromeUIExtensionsURL);
+  } else if (*page == "extensionStore") {
+    destination = GURL("https://chromewebstore.google.com/");
+  } else if (*page == "passwords") {
+    destination = GURL(chrome::kChromeUIPasswordManagerURL);
+  } else if (*page == "privacy") {
+    destination = chrome::GetSettingsUrl("privacy");
+  } else if (*page == "sitePermissions") {
+    destination = chrome::GetSettingsUrl("content");
+  } else if (*page == "search") {
+    destination = chrome::GetSettingsUrl("search");
+  } else if (*page == "languages") {
+    destination = chrome::GetSettingsUrl("languages");
+  } else if (*page == "accessibility") {
+    destination = chrome::GetSettingsUrl("accessibility");
+  } else if (*page == "importData") {
+    // Chromium's importer is the security boundary here: it enumerates local
+    // browser profiles, asks the user which data classes to copy, and uses the
+    // platform credential store for password access. Viola never uploads or
+    // manually parses another browser's profile database.
+    destination = chrome::GetSettingsUrl("importData");
+  } else if (*page == "website") {
+    destination = GURL("https://violabrowser.com/");
+  } else if (*page == "update") {
+    destination = GURL(std::string(kUpdateDownloadUrl));
+  } else {
+    return;
+  }
+
+  if (destination.SchemeIs("chrome") && destination.host() != "viola" &&
+      *page != "importData") {
+    ViolaBrowserToolThemeObserver::CreateForWebContents(
+        web_ui()->GetWebContents());
+    ViolaBrowserToolThemeObserver::FromWebContents(web_ui()->GetWebContents())
+        ->HideUntilThemed();
+  }
+  content::NavigationController::LoadURLParams params(destination);
+  params.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+  web_ui()->GetWebContents()->GetController().LoadURLWithParams(params);
+}
+
+void ViolaMessageHandler::HandleExtensionRemove(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 1) {
+    return;
+  }
+  const std::string *extension_id = payload.GetDict().FindString("extId");
+  Profile *profile = GetActiveSettingsProfile();
+  extensions::ExtensionRegistry *registry =
+      profile ? extensions::ExtensionRegistry::Get(profile) : nullptr;
+  extensions::ExtensionRegistrar *registrar =
+      profile ? extensions::ExtensionRegistrar::Get(profile) : nullptr;
+  const extensions::Extension *extension =
+      extension_id && IsBoundedExtensionId(*extension_id) && registry
+          ? registry->GetInstalledExtension(*extension_id)
+          : nullptr;
+  if (!extension || !registrar || !IsUserVisibleExtension(*extension) ||
+      extensions::Manifest::IsPolicyLocation(extension->location())) {
+    return;
+  }
+  std::u16string error;
+  if (registrar->UninstallExtension(
+          *extension_id, extensions::UNINSTALL_REASON_USER_INITIATED, &error)) {
+    web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
+                                           base::Value("settings:changed"),
+                                           base::Value(base::DictValue()));
+  }
+}
+
+void ViolaMessageHandler::HandleExtensionControl(const base::Value &payload) {
+  if (CurrentSurface() != "sidebar.html" || !payload.is_dict() ||
+      payload.GetDict().size() < 1 || payload.GetDict().size() > 3) {
+    return;
+  }
+  const base::Value *value = payload.GetDict().Find("extId");
+  const std::string *requested_action = payload.GetDict().FindString("action");
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  Profile *profile = browser ? browser->GetProfile() : nullptr;
+  extensions::ExtensionRegistry *registry =
+      profile ? extensions::ExtensionRegistry::Get(profile) : nullptr;
+  if (!value || !browser || !registry) {
+    return;
+  }
+  std::string extension_id;
+  if (value->is_string()) {
+    extension_id = value->GetString();
+    const extensions::Extension *extension =
+        IsBoundedExtensionId(extension_id)
+            ? registry->GetInstalledExtension(extension_id)
+            : nullptr;
+    if (!extension || !IsUserVisibleExtension(*extension)) {
+      return;
+    }
+  } else if (!value->is_none()) {
+    return;
+  }
+  const std::string action = requested_action
+                                 ? *requested_action
+                                 : (extension_id.empty() ? "manage" : "execute");
+  if (action != "manage" && action != "execute" && action != "menu") {
+    return;
+  }
+  if (extension_id.empty()) {
+    if (action != "manage") {
+      return;
+    }
+    TabStripModel *tab_strip = GetProductTabStrip();
+    content::WebContents *active =
+        tab_strip ? tab_strip->GetActiveWebContents() : nullptr;
+    if (!active) {
+      return;
+    }
+    content::NavigationController::LoadURLParams params(
+        GURL("chrome://viola/settings.html#Extensions"));
+    params.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+    active->GetController().LoadURLWithParams(params);
+    return;
+  }
+  ExtensionsContainer *container = ExtensionsContainer::From(*browser);
+  ToolbarActionViewModel *action_model =
+      container ? container->GetActionForId(extension_id) : nullptr;
+  if (!action_model) {
+    return;
+  }
+  if (action == "execute") {
+    if (const base::DictValue *anchor = payload.GetDict().FindDict("anchor")) {
+      const std::optional<int> x = anchor->FindInt("x");
+      const std::optional<int> y = anchor->FindInt("y");
+      const std::optional<int> width = anchor->FindInt("width");
+      const std::optional<int> height = anchor->FindInt("height");
+      Browser *browser_model = browser->GetBrowserForMigrationOnly();
+      BrowserView *browser_view = browser_model
+                                      ? BrowserView::GetBrowserViewForBrowser(
+                                            browser_model)
+                                      : nullptr;
+      viola::ViolaProductShellView *shell =
+          browser_view
+              ? browser_view->viola_product_shell_view_for_testing()
+              : nullptr;
+      if (x && y && width && height && *width > 0 && *height > 0 && shell) {
+        shell->SetExtensionPopupAnchor(
+            gfx::Rect(*x, *y, *width, *height));
+      }
+    }
+    action_model->ExecuteUserAction(
+        ToolbarActionViewModel::InvocationSource::kToolbarButton);
+    return;
+  }
+  if (action == "menu") {
+    ui::MenuModel *model = action_model->GetContextMenu(
+        extensions::ExtensionContextMenuModel::ContextMenuSource::
+            kToolbarAction);
+    RunContextMenuModel(model);
+  }
+}
+
+void ViolaMessageHandler::HandleExtensionList(int request_id,
+                                              const base::Value &payload) {
+  Profile *profile = GetActiveSettingsProfile();
+  extensions::ExtensionRegistry *registry =
+      profile ? extensions::ExtensionRegistry::Get(profile) : nullptr;
+  if (!payload.is_none() || !registry) {
+    ResolveInvoke(request_id, false, base::Value("Extensions are unavailable"));
+    return;
+  }
+
+  base::ListValue rows;
+  extensions::ExtensionSet installed =
+      registry->GenerateInstalledExtensionsSet();
+  for (const scoped_refptr<const extensions::Extension> &extension :
+       installed) {
+    if (!extension || !IsUserVisibleExtension(*extension) ||
+        rows.size() >= 500) {
+      continue;
+    }
+    base::DictValue row;
+    row.Set("id", extension->id());
+    row.Set("name", extension->name());
+    row.Set("version", extension->version().GetString());
+    row.Set("description", extension->description());
+    const GURL &options_url =
+        extensions::OptionsPageInfo::GetOptionsPage(extension.get());
+    row.Set("hasOptions", options_url.is_valid() &&
+                              options_url.SchemeIs("chrome-extension"));
+    row.Set("disabled",
+            !registry->enabled_extensions().Contains(extension->id()));
+    row.Set("removable",
+            !extensions::Manifest::IsPolicyLocation(extension->location()));
+    row.Set("icon", extensions::ExtensionIconSource::GetIconURL(
+                        extension.get(), 24, ExtensionIconSet::Match::kBigger,
+                        /*grayscale=*/false)
+                        .spec());
+    rows.Append(std::move(row));
+  }
+  ResolveInvoke(request_id, true, base::Value(std::move(rows)));
+}
+
+void ViolaMessageHandler::HandleExtensionSetEnabled(
+    int request_id, const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 2) {
+    base::DictValue result;
+    result.Set("ok", false);
+    result.Set("error", "Invalid extension request");
+    ResolveInvoke(request_id, true, base::Value(std::move(result)));
+    return;
+  }
+  const std::string *extension_id = payload.GetDict().FindString("extId");
+  std::optional<bool> enabled = payload.GetDict().FindBool("enabled");
+  Profile *profile = GetActiveSettingsProfile();
+  extensions::ExtensionRegistry *registry =
+      profile ? extensions::ExtensionRegistry::Get(profile) : nullptr;
+  extensions::ExtensionRegistrar *registrar =
+      profile ? extensions::ExtensionRegistrar::Get(profile) : nullptr;
+  const extensions::Extension *extension =
+      extension_id && IsBoundedExtensionId(*extension_id) && registry
+          ? registry->GetInstalledExtension(*extension_id)
+          : nullptr;
+  if (!enabled.has_value() || !extension || !registrar ||
+      !IsUserVisibleExtension(*extension)) {
+    base::DictValue result;
+    result.Set("ok", false);
+    result.Set("error", "Extension not found");
+    ResolveInvoke(request_id, true, base::Value(std::move(result)));
+    return;
+  }
+
+  if (*enabled) {
+    registrar->EnableExtension(*extension_id);
+  } else {
+    registrar->DisableExtension(
+        *extension_id, {extensions::disable_reason::DISABLE_USER_ACTION});
+  }
+  const bool applied =
+      registry->enabled_extensions().Contains(*extension_id) == *enabled;
+  base::DictValue result;
+  result.Set("ok", applied);
+  if (!applied) {
+    result.Set("error",
+               *enabled
+                   ? "The browser did not allow this extension to be enabled"
+                   : "The browser did not allow this extension to be disabled");
+  }
+  ResolveInvoke(request_id, true, base::Value(std::move(result)));
+}
+
+void ViolaMessageHandler::HandleDownloadAction(viola::HostChannel channel,
+                                               const base::Value &payload) {
+  content::DownloadManager *manager = GetDownloadManager();
+  if (!manager) {
+    return;
+  }
+  if (channel == viola::HostChannel::kDownloadClear) {
+    if (!payload.is_none()) {
+      return;
+    }
+    download::SimpleDownloadManager::DownloadVector downloads;
+    manager->GetAllDownloads(&downloads);
+    std::vector<std::string> removable;
+    for (download::DownloadItem *item : downloads) {
+      if (item && item->GetState() != download::DownloadItem::IN_PROGRESS) {
+        removable.push_back(item->GetGuid());
+      }
+    }
+    for (const std::string &guid : removable) {
+      if (download::DownloadItem *item = manager->GetDownloadByGuid(guid)) {
+        item->Remove();
+      }
+    }
+    SendDownloadState();
+    return;
+  }
+  if (!payload.is_dict() || payload.GetDict().size() != 1) {
+    return;
+  }
+  const std::string *guid = payload.GetDict().FindString("id");
+  download::DownloadItem *item =
+      guid && !guid->empty() ? manager->GetDownloadByGuid(*guid) : nullptr;
+  if (!item) {
+    return;
+  }
+  switch (channel) {
+  case viola::HostChannel::kDownloadPause:
+    if (item->GetState() == download::DownloadItem::IN_PROGRESS &&
+        !item->IsPaused()) {
+      item->Pause();
+    }
+    break;
+  case viola::HostChannel::kDownloadResume:
+    if (item->CanResume()) {
+      item->Resume(/*user_resume=*/true);
+    }
+    break;
+  case viola::HostChannel::kDownloadCancel:
+    if (item->GetState() == download::DownloadItem::IN_PROGRESS ||
+        item->GetState() == download::DownloadItem::INTERRUPTED) {
+      item->Cancel(/*user_cancel=*/true);
+    }
+    break;
+  case viola::HostChannel::kDownloadRemove:
+    if (item->GetState() != download::DownloadItem::IN_PROGRESS) {
+      item->Remove();
+    }
+    break;
+  case viola::HostChannel::kDownloadOpen:
+    if (item->GetState() == download::DownloadItem::COMPLETE &&
+        item->CanOpenDownload()) {
+      item->OpenDownload();
+    }
+    break;
+  case viola::HostChannel::kDownloadReveal:
+    if (item->GetState() == download::DownloadItem::COMPLETE &&
+        item->CanShowInFolder()) {
+      item->ShowDownloadInShell();
+    }
+    break;
+  default:
+    return;
+  }
+  SendDownloadState();
+}
+
+void ViolaMessageHandler::HandleNotificationAction(viola::HostChannel channel,
+                                                   const base::Value &payload) {
+  if (payload.is_dict() && payload.GetDict().size() == 1) {
+    const std::string *notification_id = payload.GetDict().FindString("id");
+    if (notification_id && notification_id->starts_with("update:")) {
+      if (channel == viola::HostChannel::kNotificationOpen ||
+          channel == viola::HostChannel::kNotificationMenu) {
+        if (viola::ViolaUpdateService::Get().CanInstallInApp()) {
+          viola::ViolaUpdateService::Get().PresentUpdate();
+          return;
+        }
+        TabStripModel *tab_strip = GetProductTabStrip();
+        content::WebContents *active =
+            tab_strip ? tab_strip->GetActiveWebContents() : nullptr;
+        if (active) {
+          content::NavigationController::LoadURLParams params{
+              GURL(std::string(kUpdateDownloadUrl))};
+          params.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+          active->GetController().LoadURLWithParams(params);
+        }
+      }
+      if (channel == viola::HostChannel::kNotificationDismiss) {
+        update_snoozed_version_ = update_available_version_;
+        update_snoozed_until_ =
+            base::Time::Now() + kUpdateRemindLaterDelay;
+        update_status_ = "reminding";
+        update_reminder_timer_.Start(
+            FROM_HERE, kUpdateRemindLaterDelay,
+            base::BindOnce(
+                &ViolaMessageHandler::OnViolaUpdateInstallStatusChanged,
+                weak_factory_.GetWeakPtr(),
+                viola::ViolaUpdateService::Get().install_status()));
+        if (CurrentSurface() == "sidebar.html" && IsJavascriptAllowed()) {
+          SendRenderState();
+        }
+      }
+      // Clear never removes software maintenance. Later snoozes the exact
+      // version for one day; installation or a version change retires it.
+      return;
+    }
+  }
+  content::DownloadManager *manager = GetDownloadManager();
+  if (!manager) {
+    return;
+  }
+  if (channel == viola::HostChannel::kNotificationClear) {
+    if (!payload.is_dict() || payload.GetDict().size() != 1 ||
+        !payload.GetDict().FindBool("includeKept")) {
+      return;
+    }
+    download::SimpleDownloadManager::DownloadVector downloads;
+    manager->GetAllDownloads(&downloads);
+    for (download::DownloadItem *item : downloads) {
+      if (item) {
+        dismissed_download_guids_.insert(item->GetGuid());
+      }
+    }
+    SendDownloadState();
+    return;
+  }
+  if (!payload.is_dict() || payload.GetDict().size() != 1) {
+    return;
+  }
+  const std::string *raw_id = payload.GetDict().FindString("id");
+  if (!raw_id || raw_id->empty()) {
+    return;
+  }
+  const std::string guid = raw_id->starts_with("download:")
+                               ? raw_id->substr(std::string("download:").size())
+                               : *raw_id;
+  download::DownloadItem *item = manager->GetDownloadByGuid(guid);
+  if (!item) {
+    return;
+  }
+  switch (channel) {
+  case viola::HostChannel::kNotificationDismiss:
+    dismissed_download_guids_.insert(guid);
+    SendDownloadState();
+    return;
+  case viola::HostChannel::kNotificationOpen:
+    if (item->GetState() == download::DownloadItem::COMPLETE &&
+        item->CanShowInFolder()) {
+      item->ShowDownloadInShell();
+    } else if (viola::ViolaProductOverlayHostView *overlay_host =
+                   GetProductOverlayHost()) {
+      base::DictValue download_payload = BuildDownloadPayload();
+      if (const base::ListValue *rows =
+              download_payload.FindList("downloads")) {
+        overlay_host->ShowDownloads(rows->Clone());
+      }
+    }
+    return;
+  case viola::HostChannel::kNotificationMenu:
+    if (viola::ViolaProductOverlayHostView *overlay_host =
+            GetProductOverlayHost()) {
+      base::DictValue download_payload = BuildDownloadPayload();
+      if (const base::ListValue *rows =
+              download_payload.FindList("downloads")) {
+        overlay_host->ShowDownloads(rows->Clone());
+      }
+    }
+    return;
+  case viola::HostChannel::kDownloadDragFile:
+    if (item->GetState() == download::DownloadItem::COMPLETE &&
+        !item->GetTargetFilePath().empty()) {
+      base::CurrentThread::ScopedAllowApplicationTasksInNativeNestedLoop
+          allow_nested_tasks;
+      DragDownloadItem(item, nullptr,
+                       web_ui()->GetWebContents()->GetNativeView());
+    }
+    return;
+  default:
+    return;
+  }
+}
+
+content::MediaSession *ViolaMessageHandler::GetCurrentMediaSession(
+    content::WebContents **selected_contents) {
+  *selected_contents = nullptr;
+  TabStripModel *tab_strip = GetProductTabStrip();
+  if (!tab_strip) {
+    media_tab_id_.clear();
+    return nullptr;
+  }
+  const std::string retained_tab_id = media_tab_id_;
+  struct Candidate {
+    content::WebContents *contents = nullptr;
+    content::MediaSession *session = nullptr;
+    bool playing = false;
+    bool active = false;
+  } best;
+  std::string best_tab_id;
+  for (int index = 0; index < tab_strip->count(); ++index) {
+    content::WebContents *contents = tab_strip->GetWebContentsAt(index);
+    content::MediaSession *session =
+        contents ? content::MediaSession::GetIfExists(contents) : nullptr;
+    auto info = session ? session->GetMediaSessionInfoSync() : nullptr;
+    if (!info || !info->is_controllable) {
+      continue;
+    }
+    const bool playing = info->playback_state ==
+                         media_session::mojom::MediaPlaybackState::kPlaying;
+    const bool active = contents == tab_strip->GetActiveWebContents();
+    const std::string tab_id =
+        organization_store_ && organization_store_->loaded()
+            ? organization_store_->TabIdFor(contents)
+            : StableTabId(*tab_strip->GetTabAtIndex(index));
+    if (organization_store_ && organization_store_->loaded()) {
+      const std::optional<viola::TabContextMenuState> state =
+          organization_store_->GetTabContextMenuState(tab_id);
+      if (state && state->mini_player_excluded) {
+        continue;
+      }
+    }
+    const bool retained = !retained_tab_id.empty() && tab_id == retained_tab_id;
+    if (!best.session || (playing && !best.playing) ||
+        (playing == best.playing && active && !best.active) ||
+        (playing == best.playing && active == best.active && retained)) {
+      best = {.contents = contents,
+              .session = session,
+              .playing = playing,
+              .active = active};
+      best_tab_id = tab_id;
+    }
+  }
+  media_tab_id_ = best_tab_id;
+  *selected_contents = best.contents;
+  return best.session;
+}
+
+base::Value ViolaMessageHandler::BuildMediaPayload() {
+  content::WebContents *contents = nullptr;
+  content::MediaSession *session = GetCurrentMediaSession(&contents);
+  if (!session || !contents) {
+    media_tab_id_.clear();
+    return base::Value();
+  }
+  auto info = session->GetMediaSessionInfoSync();
+  if (!info || !info->is_controllable) {
+    return base::Value();
+  }
+  const media_session::MediaMetadata &metadata =
+      session->GetMediaSessionMetadata();
+  base::DictValue media;
+  media.Set("tabId", media_tab_id_);
+  media.Set("title", metadata.title.empty()
+                         ? base::UTF16ToUTF8(contents->GetTitle())
+                         : base::UTF16ToUTF8(metadata.title));
+  media.Set("artist", base::UTF16ToUTF8(metadata.artist));
+  media.Set("album", base::UTF16ToUTF8(metadata.album));
+  media.Set("playing", info->playback_state ==
+                           media_session::mojom::MediaPlaybackState::kPlaying);
+  media.Set("muted", contents->IsAudioMuted() || info->muted);
+  media.Set("artwork", "");
+  const GURL page_url = contents->GetVisibleURL();
+  media.Set(
+      "favicon",
+      page_url.SchemeIsHTTPOrHTTPS()
+          ? base::StrCat({"chrome://favicon2/?size=64&scaleFactor=1x&"
+                          "showFallbackMonogram=&pageUrl=",
+                          base::EscapeQueryParamValue(page_url.spec(), true)})
+          : "");
+  return base::Value(std::move(media));
+}
+
+void ViolaMessageHandler::RefreshMediaState() {
+  if (!IsJavascriptAllowed() || CurrentSurface() != "sidebar.html") {
+    return;
+  }
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  Profile *profile = browser ? browser->GetProfile() : nullptr;
+  if (viola::ViolaAccountSyncService *sync =
+          profile ? viola::ViolaAccountSyncService::Get(profile) : nullptr) {
+    const int generation = sync->remote_presence_generation();
+    if (generation != remote_presence_generation_seen_) {
+      remote_presence_generation_seen_ = generation;
+      SendRenderState();
+    }
+  }
+  base::Value media = BuildMediaPayload();
+  std::string fingerprint;
+  base::JSONWriter::Write(media, &fingerprint);
+  if (fingerprint != media_fingerprint_) {
+    media_fingerprint_ = fingerprint;
+    SendRenderState();
+  }
+  content::WebContents *contents = nullptr;
+  content::MediaSession *session = GetCurrentMediaSession(&contents);
+  const std::optional<media_session::MediaPosition> position =
+      session ? session->GetMediaSessionPosition() : std::nullopt;
+  auto info = session ? session->GetMediaSessionInfoSync() : nullptr;
+  // Automatic PiP is controlled by AUTO_PICTURE_IN_PICTURE permissions.
+  // A context-menu or page-initiated user gesture is just as explicit as our
+  // own media button; never tear its session down on the next polling tick.
+  const bool in_pip = info && info->picture_in_picture_state ==
+      media_session::mojom::MediaPictureInPictureState::kInPictureInPicture;
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("viola-native-media-probe") &&
+      media_native_pip_visible_ != in_pip) {
+    media_native_pip_visible_ = in_pip;
+    base::DictValue pip;
+    pip.Set("nativePip", in_pip);
+    pip.Set("tabId", media_tab_id_);
+    web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
+        base::Value("media:preview"), base::Value(std::move(pip)));
+  }
+  UpdateMediaPreviewCapture(
+      contents, info && info->playback_state ==
+                            media_session::mojom::MediaPlaybackState::kPlaying);
+  base::DictValue progress;
+  const double time = position ? position->GetPosition().InSecondsF() : 0.0;
+  const double duration = position ? position->duration().InSecondsF() : 0.0;
+  progress.Set("t", std::isfinite(time) && time >= 0.0 ? time : 0.0);
+  progress.Set("d", std::isfinite(duration) && duration > 0.0 ? duration : 0.0);
+  SendHostState("media:progress", base::Value(std::move(progress)));
+}
+
+void ViolaMessageHandler::UpdateMediaPreviewCapture(
+    content::WebContents *contents, bool playing) {
+  TabStripModel *tab_strip = GetProductTabStrip();
+  bool foreground = false;
+  if (contents && tab_strip) {
+    for (tabs::TabInterface *tab : tab_strip->GetForegroundTabs()) {
+      if (tab && tab->GetContents() == contents) {
+        foreground = true;
+        break;
+      }
+    }
+  }
+  if (!contents || (foreground && !media_native_pip_visible_) || media_tab_id_.empty()) {
+    StopMediaPreviewCapture(/*notify_renderer=*/true);
+    return;
+  }
+  if (media_capture_tab_id_ != media_tab_id_ ||
+      media_capture_contents_.get() != contents) {
+    StopMediaPreviewCapture(/*notify_renderer=*/true);
+    media_capture_contents_ = contents->GetWeakPtr();
+    media_capture_tab_id_ = media_tab_id_;
+    ++media_preview_generation_;
+    media_preview_retry_at_ = base::TimeTicks::Now();
+    media_preview_failures_ = 0;
+    if (playing) {
+      StartMediaPreviewStream();
+    }
+    return;
+  }
+  if (playing && !media_preview_connecting_ && !media_preview_ready_ &&
+      base::TimeTicks::Now() >= media_preview_retry_at_) {
+    StartMediaPreviewStream();
+  }
+}
+
+void ViolaMessageHandler::StartMediaPreviewStream() {
+  content::WebContents *contents = media_capture_contents_.get();
+  content::MediaSession *session = contents ? content::MediaSession::GetIfExists(contents) : nullptr;
+  content::RenderFrameHost *frame = session ? session->GetRoutedFrame() : nullptr;
+  if (frame && frame->IsActive()) {
+    media_capture_document_ = frame->GetWeakDocumentPtr();
+  } else {
+    frame = nullptr;
+  }
+  if (!frame || media_capture_tab_id_.empty() || media_preview_connecting_ ||
+      media_preview_ready_) {
+    return;
+  }
+  media_preview_connecting_ = true;
+  media_preview_ready_ = false;
+  media_preview_health_in_flight_ = false;
+  const uint64_t generation = ++media_preview_generation_;
+  const std::string script = base::StringPrintf(
+      R"JS((() => {
+        const generation = %llu;
+        const nativePreview = %s;
+        const prior = window.__violaNativePreviewSource;
+        if (prior && prior.pc) { try { prior.pc.close(); } catch {} }
+        const state = window.__violaNativePreviewSource = {
+          generation, status:'starting', offer:'', error:'', pc:null,
+          track:null, video:null
+        };
+        (async () => {
+          try {
+            const videos = [];
+            const visit = (root) => {
+              if (!root || !root.querySelectorAll) return;
+              for (const video of root.querySelectorAll('video')) videos.push(video);
+              for (const node of root.querySelectorAll('*')) {
+                if (node.shadowRoot) visit(node.shadowRoot);
+              }
+            };
+            visit(document);
+            const video = videos
+              .filter((candidate) => candidate.videoWidth > 0 &&
+                  typeof candidate.captureStream === 'function')
+              .sort((a,b) => Number(!b.paused)-Number(!a.paused) ||
+                  b.videoWidth*b.videoHeight-a.videoWidth*a.videoHeight)[0];
+            if (!video) throw new Error('No capturable video');
+            const stream = video.captureStream();
+            const track = stream.getVideoTracks()[0];
+            if (!track) throw new Error('No video track');
+            if (nativePreview) track.contentHint = 'motion';
+            const pc = new RTCPeerConnection();
+            if (window.__violaNativePreviewSource !== state) {
+              pc.close(); track.stop(); return;
+            }
+            state.pc = pc; state.track = track; state.video = video;
+            const sender = pc.addTrack(track, stream);
+            try {
+              const parameters = sender.getParameters();
+              parameters.encodings = parameters.encodings || [{}];
+              Object.assign(parameters.encodings[0], {
+                maxBitrate:nativePreview ? 4000000 : 900000,
+                maxFramerate:nativePreview ? 60 : 30,
+                scaleResolutionDownBy:nativePreview
+                    ? Math.max(1, video.videoWidth / 960, video.videoHeight / 540) : 1
+              });
+              if (nativePreview) parameters.degradationPreference = 'maintain-framerate';
+              await sender.setParameters(parameters);
+            } catch (error) { state.parametersError = String(error); }
+            const offer = await pc.createOffer();
+            await pc.setLocalDescription(offer);
+            await new Promise((resolve) => {
+              if (pc.iceGatheringState === 'complete') return resolve();
+              const done = () => {
+                if (pc.iceGatheringState === 'complete') resolve();
+              };
+              pc.addEventListener('icegatheringstatechange', done);
+              setTimeout(resolve, 1500);
+            });
+            if (window.__violaNativePreviewSource !== state) return;
+            state.offer = JSON.stringify(pc.localDescription);
+            state.status = 'offer';
+          } catch (error) {
+            state.error = String(error && error.message || error);
+            state.status = 'error';
+          }
+        })();
+        return true;
+      })())JS",
+      static_cast<unsigned long long>(generation),
+      base::CommandLine::ForCurrentProcess()->HasSwitch("viola-native-media-probe")
+          ? "true" : "false");
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(script), base::DoNothing(), kViolaMediaPreviewWorldId);
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ViolaMessageHandler::PollMediaPreviewOffer,
+                     weak_factory_.GetWeakPtr(), generation, 0),
+      kMediaPreviewHandshakeInterval);
+}
+
+void ViolaMessageHandler::PollMediaPreviewOffer(uint64_t generation,
+                                                int attempt) {
+  content::RenderFrameHost *frame = media_capture_document_.AsRenderFrameHostIfValid();
+  if (frame && !frame->IsActive()) frame = nullptr;
+  if (!frame || generation != media_preview_generation_ ||
+      !media_preview_connecting_) {
+    return;
+  }
+  const std::string script = base::StringPrintf(
+      R"JS((() => {
+        const state=window.__violaNativePreviewSource;
+        if (!state || state.generation!==%llu) return {status:'stale'};
+        return {status:state.status,offer:state.offer||'',error:state.error||''};
+      })())JS",
+      static_cast<unsigned long long>(generation));
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(script),
+      base::BindOnce(&ViolaMessageHandler::OnMediaPreviewOffer,
+                     weak_factory_.GetWeakPtr(), generation, attempt),
+      kViolaMediaPreviewWorldId);
+}
+
+void ViolaMessageHandler::OnMediaPreviewOffer(uint64_t generation, int attempt,
+                                              base::Value result) {
+  if (generation != media_preview_generation_ || !media_preview_connecting_) {
+    return;
+  }
+  const base::DictValue *state = result.GetIfDict();
+  const std::string *status = state ? state->FindString("status") : nullptr;
+  const std::string *offer = state ? state->FindString("offer") : nullptr;
+  if (!status || *status == "error" || *status == "stale" ||
+      (offer && offer->size() > 256 * 1024)) {
+    FailMediaPreviewStream(generation);
+    return;
+  }
+  if (*status != "offer" || !offer || offer->empty()) {
+    if (attempt + 1 >= kMediaPreviewHandshakeAttempts) {
+      FailMediaPreviewStream(generation);
+      return;
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&ViolaMessageHandler::PollMediaPreviewOffer,
+                       weak_factory_.GetWeakPtr(), generation, attempt + 1),
+        kMediaPreviewHandshakeInterval);
+    return;
+  }
+  std::string quoted_offer;
+  base::JSONWriter::Write(base::Value(*offer), &quoted_offer);
+  const std::string script = base::StringPrintf(
+      R"JS((() => {
+        const generation=%llu;
+        const state=window.__violaNativePreviewReceiver={
+          generation,status:'starting',answer:'',error:''
+        };
+        Promise.resolve(window.__velaPreviewAnswer(%s,generation))
+          .then((answer)=>{
+            if (window.__violaNativePreviewReceiver!==state) return;
+            state.answer=answer||'';
+            state.status=answer?'answer':'error';
+          }).catch((error)=>{
+            state.error=String(error&&error.message||error);
+            state.status='error';
+          });
+        return true;
+      })())JS",
+      static_cast<unsigned long long>(generation), quoted_offer.c_str());
+  content::RenderFrameHost *sidebar =
+      web_ui()->GetWebContents()->GetPrimaryMainFrame();
+  if (!sidebar) {
+    FailMediaPreviewStream(generation);
+    return;
+  }
+  sidebar->ExecuteJavaScript(base::UTF8ToUTF16(script), base::DoNothing());
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ViolaMessageHandler::PollMediaPreviewAnswer,
+                     weak_factory_.GetWeakPtr(), generation, 0),
+      kMediaPreviewHandshakeInterval);
+}
+
+void ViolaMessageHandler::PollMediaPreviewAnswer(uint64_t generation,
+                                                 int attempt) {
+  content::RenderFrameHost *sidebar =
+      web_ui()->GetWebContents()->GetPrimaryMainFrame();
+  if (!sidebar || generation != media_preview_generation_ ||
+      !media_preview_connecting_) {
+    return;
+  }
+  const std::string script = base::StringPrintf(
+      R"JS((() => {
+        const state=window.__violaNativePreviewReceiver;
+        if (!state || state.generation!==%llu) return {status:'stale'};
+        return {status:state.status,answer:state.answer||'',error:state.error||''};
+      })())JS",
+      static_cast<unsigned long long>(generation));
+  sidebar->ExecuteJavaScript(
+      base::UTF8ToUTF16(script),
+      base::BindOnce(&ViolaMessageHandler::OnMediaPreviewAnswer,
+                     weak_factory_.GetWeakPtr(), generation, attempt));
+}
+
+void ViolaMessageHandler::OnMediaPreviewAnswer(uint64_t generation, int attempt,
+                                               base::Value result) {
+  if (generation != media_preview_generation_ || !media_preview_connecting_) {
+    return;
+  }
+  const base::DictValue *state = result.GetIfDict();
+  const std::string *status = state ? state->FindString("status") : nullptr;
+  const std::string *answer = state ? state->FindString("answer") : nullptr;
+  if (!status || *status == "error" || *status == "stale" ||
+      (answer && answer->size() > 256 * 1024)) {
+    FailMediaPreviewStream(generation);
+    return;
+  }
+  if (*status != "answer" || !answer || answer->empty()) {
+    if (attempt + 1 >= kMediaPreviewHandshakeAttempts) {
+      FailMediaPreviewStream(generation);
+      return;
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&ViolaMessageHandler::PollMediaPreviewAnswer,
+                       weak_factory_.GetWeakPtr(), generation, attempt + 1),
+        kMediaPreviewHandshakeInterval);
+    return;
+  }
+  std::string quoted_answer;
+  base::JSONWriter::Write(base::Value(*answer), &quoted_answer);
+  const std::string script = base::StringPrintf(
+      R"JS((() => {
+        const state=window.__violaNativePreviewSource;
+        if (!state || state.generation!==%llu || !state.pc) return false;
+        (async()=>{
+          try {
+            await state.pc.setRemoteDescription(JSON.parse(%s));
+            state.status='connected';
+          } catch(error) {
+            state.error=String(error&&error.message||error);
+            state.status='error';
+          }
+        })();
+        return true;
+      })())JS",
+      static_cast<unsigned long long>(generation), quoted_answer.c_str());
+  content::RenderFrameHost *frame = media_capture_document_.AsRenderFrameHostIfValid();
+  if (frame && !frame->IsActive()) frame = nullptr;
+  if (!frame) {
+    FailMediaPreviewStream(generation);
+    return;
+  }
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(script), base::DoNothing(), kViolaMediaPreviewWorldId);
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ViolaMessageHandler::PollMediaPreviewConnected,
+                     weak_factory_.GetWeakPtr(), generation, 0),
+      kMediaPreviewHandshakeInterval);
+}
+
+void ViolaMessageHandler::PollMediaPreviewConnected(uint64_t generation,
+                                                    int attempt) {
+  content::RenderFrameHost *frame = media_capture_document_.AsRenderFrameHostIfValid();
+  if (frame && !frame->IsActive()) frame = nullptr;
+  if (!frame || generation != media_preview_generation_ ||
+      !media_preview_connecting_) {
+    return;
+  }
+  const std::string script = base::StringPrintf(
+      R"JS((() => {
+        const state=window.__violaNativePreviewSource;
+        if (!state || state.generation!==%llu) return {status:'stale'};
+        return {status:state.status};
+      })())JS",
+      static_cast<unsigned long long>(generation));
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(script),
+      base::BindOnce(&ViolaMessageHandler::OnMediaPreviewConnected,
+                     weak_factory_.GetWeakPtr(), generation, attempt),
+      kViolaMediaPreviewWorldId);
+}
+
+void ViolaMessageHandler::OnMediaPreviewConnected(uint64_t generation,
+                                                  int attempt,
+                                                  base::Value result) {
+  if (generation != media_preview_generation_ || !media_preview_connecting_) {
+    return;
+  }
+  const base::DictValue *state = result.GetIfDict();
+  const std::string *status = state ? state->FindString("status") : nullptr;
+  if (!status || *status == "error" || *status == "stale") {
+    FailMediaPreviewStream(generation);
+    return;
+  }
+  if (*status != "connected") {
+    if (attempt + 1 >= kMediaPreviewHandshakeAttempts) {
+      FailMediaPreviewStream(generation);
+      return;
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&ViolaMessageHandler::PollMediaPreviewConnected,
+                       weak_factory_.GetWeakPtr(), generation, attempt + 1),
+        kMediaPreviewHandshakeInterval);
+    return;
+  }
+  media_preview_connecting_ = false;
+  media_preview_ready_ = true;
+  media_preview_failures_ = 0;
+  media_preview_timer_.Start(
+      FROM_HERE, kMediaPreviewHealthInterval,
+      base::BindRepeating(&ViolaMessageHandler::CheckMediaPreviewHealth,
+                          weak_factory_.GetWeakPtr()));
+  base::DictValue payload;
+  payload.Set("url", "");
+  web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
+                                         base::Value("media:preview"),
+                                         base::Value(std::move(payload)));
+}
+
+void ViolaMessageHandler::CheckMediaPreviewHealth() {
+  if (media_preview_health_in_flight_ || !media_preview_ready_) {
+    return;
+  }
+  content::RenderFrameHost *sidebar =
+      web_ui()->GetWebContents()->GetPrimaryMainFrame();
+  if (!sidebar) {
+    FailMediaPreviewStream(media_preview_generation_);
+    return;
+  }
+  media_preview_health_in_flight_ = true;
+  const uint64_t generation = media_preview_generation_;
+  const std::string script = base::StringPrintf(
+      R"JS((() => {
+        if (%s) return window.__violaNativeMediaHealthy?.(%llu) === true;
+        const health=window.__velaPreviewHealth;
+        const video=document.querySelector('#media-preview-video');
+        const now=Date.now();
+        const prolongedBlack=!!health && !!health.blackSince &&
+          now-health.blackSince>4000 && now-health.lastVisualChangeAt>4000;
+        return !!health && health.generation===%llu && !!video &&
+          !video.hidden && video.readyState>=2 && health.frameCount>0 &&
+          now-health.lastFrameAt<3500 && !prolongedBlack;
+      })())JS",
+      (BUILDFLAG(IS_LINUX) && base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "viola-native-media-probe")) ? "true" : "false",
+      static_cast<unsigned long long>(generation),
+      static_cast<unsigned long long>(generation));
+  sidebar->ExecuteJavaScript(
+      base::UTF8ToUTF16(script),
+      base::BindOnce(&ViolaMessageHandler::OnMediaPreviewHealth,
+                     weak_factory_.GetWeakPtr(), generation));
+}
+
+void ViolaMessageHandler::OnMediaPreviewHealth(uint64_t generation,
+                                               base::Value result) {
+  if (generation != media_preview_generation_) {
+    return;
+  }
+  media_preview_health_in_flight_ = false;
+  if (!result.is_bool() || !result.GetBool()) {
+    FailMediaPreviewStream(generation);
+  }
+}
+
+void ViolaMessageHandler::FailMediaPreviewStream(uint64_t generation) {
+  if (generation != media_preview_generation_) {
+    return;
+  }
+  media_preview_timer_.Stop();
+  media_preview_connecting_ = false;
+  media_preview_ready_ = false;
+  media_preview_health_in_flight_ = false;
+  ++media_preview_failures_;
+  CloseMediaPreviewEndpoints();
+  media_preview_retry_at_ =
+      base::TimeTicks::Now() +
+      (media_preview_failures_ >= 3 ? base::Seconds(8) : base::Seconds(2));
+}
+
+void ViolaMessageHandler::CloseMediaPreviewEndpoints() {
+  if (media_capture_contents_) {
+    if (content::RenderFrameHost *frame = media_capture_document_.AsRenderFrameHostIfValid();
+        frame && frame->IsActive()) {
+      frame->ExecuteJavaScriptInIsolatedWorld(uR"JS((() => {
+            const state=window.__violaNativePreviewSource;
+            if (state) {
+              if (state.pc) { try { state.pc.close(); } catch {} }
+              if (state.track) { try { state.track.stop(); } catch {} }
+            }
+            window.__violaNativePreviewSource=null;
+            return true;
+          })())JS",
+                                              base::DoNothing(),
+                                              kViolaMediaPreviewWorldId);
+    }
+  }
+  if (IsJavascriptAllowed()) {
+    if (content::RenderFrameHost *sidebar =
+            web_ui()->GetWebContents()->GetPrimaryMainFrame()) {
+      sidebar->ExecuteJavaScript(
+          u"window.__velaPreviewStop && window.__velaPreviewStop(); true;",
+          base::DoNothing());
+    }
+  }
+}
+
+void ViolaMessageHandler::StopMediaPreviewCapture(bool notify_renderer) {
+  const bool had_capture = !media_capture_tab_id_.empty();
+  media_preview_timer_.Stop();
+  ++media_preview_generation_;
+  CloseMediaPreviewEndpoints();
+  media_capture_contents_.reset();
+  media_capture_document_ = content::WeakDocumentPtr();
+  media_capture_tab_id_.clear();
+  media_preview_retry_at_ = base::TimeTicks();
+  media_preview_connecting_ = false;
+  media_preview_ready_ = false;
+  media_preview_health_in_flight_ = false;
+  media_preview_failures_ = 0;
+  if (had_capture && notify_renderer && IsJavascriptAllowed() &&
+      CurrentSurface() == "sidebar.html") {
+    base::DictValue payload;
+    payload.Set("url", "");
+    web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
+                                           base::Value("media:preview"),
+                                           base::Value(std::move(payload)));
+  }
+}
+
+void ViolaMessageHandler::HandleMediaAction(viola::HostChannel channel,
+                                            const base::Value &payload) {
+  content::WebContents *contents = nullptr;
+  content::MediaSession *session = GetCurrentMediaSession(&contents);
+  if (!session || !contents) {
+    return;
+  }
+  if (channel == viola::HostChannel::kMediaSeek) {
+    if (!payload.is_dict() || payload.GetDict().size() != 1) {
+      return;
+    }
+    const base::Value *fraction_value = payload.GetDict().Find("fraction");
+    const double fraction = fraction_value && fraction_value->is_int()
+                                ? fraction_value->GetInt()
+                            : fraction_value && fraction_value->is_double()
+                                ? fraction_value->GetDouble()
+                                : -1.0;
+    const std::optional<media_session::MediaPosition> position =
+        session->GetMediaSessionPosition();
+    if (position && std::isfinite(fraction) && fraction >= 0 && fraction <= 1) {
+      session->SeekTo(position->duration() * fraction);
+    }
+    return;
+  }
+  if (!payload.is_none()) {
+    return;
+  }
+  if (channel == viola::HostChannel::kMediaMenu) {
+    if (!organization_store_ || !organization_store_->loaded() ||
+        media_tab_id_.empty()) {
+      return;
+    }
+    std::optional<viola::TabContextMenuState> state =
+        organization_store_->GetTabContextMenuState(media_tab_id_);
+    if (!state) {
+      return;
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ViolaMessageHandler::ShowTabContextMenu,
+                                  weak_factory_.GetWeakPtr(), media_tab_id_,
+                                  state->section,
+                                  std::vector<std::string>()));
+    return;
+  }
+  auto info = session->GetMediaSessionInfoSync();
+  if (!info) {
+    return;
+  }
+  switch (channel) {
+  case viola::HostChannel::kMediaPlaypause:
+    if (info->playback_state ==
+        media_session::mojom::MediaPlaybackState::kPlaying) {
+      session->Suspend(content::MediaSession::SuspendType::kUI);
+    } else {
+      session->Resume(content::MediaSession::SuspendType::kUI);
+    }
+    break;
+  case viola::HostChannel::kMediaNext:
+    session->NextTrack();
+    break;
+  case viola::HostChannel::kMediaPrev:
+    session->PreviousTrack();
+    break;
+  case viola::HostChannel::kMediaMute:
+    contents->SetAudioMuted(!contents->IsAudioMuted());
+    break;
+  case viola::HostChannel::kMediaPip:
+    if (info->picture_in_picture_state ==
+        media_session::mojom::MediaPictureInPictureState::kInPictureInPicture) {
+      session->ExitPictureInPicture();
+      media_pip_authorized_tab_id_.clear();
+      media_pip_authorized_until_ = base::TimeTicks();
+      media_pip_explicit_active_ = false;
+    } else {
+      media_pip_authorized_tab_id_ = media_tab_id_;
+      media_pip_authorized_until_ = base::TimeTicks::Now() + base::Seconds(5);
+      media_pip_explicit_active_ = false;
+      session->EnterPictureInPicture();
+    }
+    break;
+  default:
+    return;
+  }
+  RefreshMediaState();
+}
+
+void ViolaMessageHandler::HandleSettingsChange(const base::Value &payload) {
+  if (CurrentSurface() != "settings.html" || !payload.is_dict() ||
+      payload.GetDict().size() != 2) {
+    return;
+  }
+  const std::string *key = payload.GetDict().FindString("key");
+  const base::Value *value = payload.GetDict().Find("value");
+  if (!key || !value) {
+    return;
+  }
+  if (*key == "usageAnalyticsEnabled") {
+    if (!value->is_bool()) {
+      return;
+    }
+    Profile *profile = GetActiveSettingsProfile();
+    if (viola::ViolaUsageTelemetry *telemetry =
+            viola::ViolaUsageTelemetry::Get(profile)) {
+      telemetry->SetDetailedEnabled(value->GetBool());
+      web_ui()->CallJavascriptFunctionUnsafe(
+          "__violaHostReceive", base::Value("settings:changed"),
+          base::Value(base::DictValue()));
+    }
+    return;
+  }
+  if (!organization_store_ || !organization_store_->loaded() ||
+      !organization_store_->UpdateSetting(*key, *value)) {
+    return;
+  }
+  web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
+                                         base::Value("settings:changed"),
+                                         base::Value(base::DictValue()));
+  // Deleting a dormant workspace may not mutate TabStripModel at all. Paint
+  // the accepted canonical state now instead of waiting for an unrelated tab
+  // selection to make the removed workspace disappear.
+  SendRenderState();
+}
+
+void ViolaMessageHandler::HandleCopyUrl(const base::Value &payload) {
+  if (!payload.is_none()) {
+    return;
+  }
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  content::WebContents *active = GetActiveTabForMutation();
+  if (browser && active) {
+    chrome::CopyURL(browser, active);
+  }
+}
+
+void ViolaMessageHandler::HandleWorkspaceSwitch(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 1) {
+    return;
+  }
+  const std::string *space_id = payload.GetDict().FindString("spaceId");
+  if (!space_id || space_id->empty() || !organization_store_ ||
+      !organization_store_->loaded()) {
+    return;
+  }
+  TabStripModel *tab_strip = GetProductTabStrip();
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  if (!tab_strip || tab_strip != observed_tab_strip_ || !browser ||
+      browser->GetTabStripModel() != tab_strip) {
+    return;
+  }
+  if (organization_store_->SwitchWorkspace(*space_id, browser, tab_strip)) {
+    SendRenderState();
+  }
+}
+
+void ViolaMessageHandler::HandleWorkspaceCreate(const base::Value &payload) {
+  if (!payload.is_dict() || !organization_store_ ||
+      !organization_store_->loaded()) {
+    return;
+  }
+  if (payload.GetDict().size() != 2) {
+    return;
+  }
+  const std::string *requested_name = payload.GetDict().FindString("name");
+  const std::string *requested_icon = payload.GetDict().FindString("icon");
+  if (!requested_name || !requested_icon || requested_name->empty() ||
+      requested_name->size() > 120 || requested_icon->empty() ||
+      requested_icon->size() > 32 || !base::IsStringUTF8(*requested_name) ||
+      !base::IsStringUTF8(*requested_icon)) {
+    return;
+  }
+  const bool from_settings = CurrentSurface() == "settings.html";
+  TabStripModel *tab_strip =
+      from_settings ? GetActiveSettingsTabStrip() : GetProductTabStrip();
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  if (!tab_strip || (!from_settings && tab_strip != observed_tab_strip_) ||
+      !browser ||
+      browser->GetTabStripModel() != tab_strip ||
+      !organization_store_->CreateWorkspace(*requested_name,
+                                            *requested_icon)) {
+    return;
+  }
+  organization_store_->AddNewTabForActiveWorkspace(
+      browser, tab_strip, GURL("about:blank"), tab_strip->count(),
+      /*foreground=*/true);
+  SendRenderState();
+  if (from_settings) {
+    web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
+                                           base::Value("settings:changed"),
+                                           base::Value(base::DictValue()));
+  }
+}
+
+void ViolaMessageHandler::HandleWorkspaceDelete(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 1 ||
+      !organization_store_ || !organization_store_->loaded()) {
+    return;
+  }
+  const std::string *space_id = payload.GetDict().FindString("spaceId");
+  const bool from_settings = CurrentSurface() == "settings.html";
+  TabStripModel *tab_strip =
+      from_settings ? GetActiveSettingsTabStrip() : GetProductTabStrip();
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  if (!space_id || space_id->empty() || !tab_strip ||
+      (!from_settings && tab_strip != observed_tab_strip_) || !browser ||
+      browser->GetTabStripModel() != tab_strip) {
+    return;
+  }
+  std::optional<std::vector<std::string>> tab_ids =
+      organization_store_->DeleteWorkspace(*space_id);
+  if (!tab_ids) {
+    return;
+  }
+  std::vector<int> indices;
+  for (const std::string &tab_id : *tab_ids) {
+    const int index = organization_store_->FindTabIndex(tab_strip, tab_id);
+    if (index != TabStripModel::kNoTab) {
+      indices.push_back(index);
+    }
+  }
+  std::ranges::sort(indices, std::greater<>());
+  for (const int index : indices) {
+    tab_strip->CloseWebContentsAt(
+        index, TabCloseTypes::CLOSE_USER_GESTURE |
+                   TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  }
+  // Closing a materialized tab normally schedules a later observer repaint,
+  // but a metadata-only workspace has no TabStrip mutation to trigger it.
+  // Paint the canonical post-delete organization immediately in both cases.
+  SendRenderState();
+  web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
+                                         base::Value("settings:changed"),
+                                         base::Value(base::DictValue()));
+}
+
+void ViolaMessageHandler::HandleWorkspaceUpdate(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 2 ||
+      !organization_store_ || !organization_store_->loaded()) {
+    return;
+  }
+  const std::string *space_id = payload.GetDict().FindString("spaceId");
+  const base::DictValue *patch = payload.GetDict().FindDict("patch");
+  if (space_id && patch &&
+      organization_store_->UpdateWorkspace(*space_id, *patch)) {
+    SendRenderState();
+  }
+}
+
+void ViolaMessageHandler::HandleSidebarDisclosure(viola::HostChannel channel,
+                                                  const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 1) {
+    return;
+  }
+  const char *key = channel == viola::HostChannel::kSidebarCollapsedGroups
+                        ? "groupIds"
+                        : "spaceIds";
+  const base::ListValue *values = payload.GetDict().FindList(key);
+  if (!values || values->size() > kMaximumDisclosureIds) {
+    return;
+  }
+  std::set<std::string> ids;
+  for (const base::Value &value : *values) {
+    const std::string *id = value.GetIfString();
+    if (!id || id->empty() || id->size() > kMaximumDisclosureIdBytes ||
+        !ids.insert(*id).second) {
+      return;
+    }
+  }
+  if (channel == viola::HostChannel::kSidebarCollapsedGroups) {
+    collapsed_group_ids_ = ids;
+    if (organization_store_ && organization_store_->loaded()) {
+      organization_store_->SetCollapsedTabGroups(ids);
+    }
+  } else if (channel ==
+             viola::HostChannel::kSidebarCollapsedWorkspaceSections) {
+    collapsed_workspace_section_ids_ = std::move(ids);
+  } else {
+    return;
+  }
+  SendRenderState();
+}
+
+void ViolaMessageHandler::HandleSidebarWidth(viola::HostChannel channel,
+                                             const base::Value &payload) {
+  if (channel == viola::HostChannel::kSidebarDragStart) {
+    return;
+  }
+  if (channel == viola::HostChannel::kSidebarDragEnd) {
+    return;
+  }
+  if (channel != viola::HostChannel::kSidebarSetWidth || !payload.is_dict() ||
+      payload.GetDict().size() != 2 || !organization_store_ ||
+      !organization_store_->loaded()) {
+    return;
+  }
+  const std::optional<int> width = payload.GetDict().FindInt("width");
+  const std::optional<bool> final = payload.GetDict().FindBool("final");
+  viola::ViolaProductShellView *shell = GetProductShellView();
+  if (!width || !final || !shell) {
+    return;
+  }
+  shell->SetSidebarWidth(*width);
+  if (!*final) {
+    return;
+  }
+  if (!organization_store_->SetSidebarWidth(*width)) {
+    return;
+  }
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  viola::ViolaProductShellView::SetSidebarWidthForProfile(
+      browser ? browser->GetProfile() : nullptr, *width);
+}
+
+void ViolaMessageHandler::HandleSidebarPeek(const base::Value &payload) {
+  if (!payload.is_none()) {
+    return;
+  }
+  if (viola::ViolaProductShellView *shell = GetProductShellView()) {
+    shell->SetSidebarPeeked(true);
+  }
+}
+
+void ViolaMessageHandler::HandleSidebarModal(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 1) {
+    return;
+  }
+  const std::optional<bool> open = payload.GetDict().FindBool("open");
+  if (!open) {
+    return;
+  }
+  if (viola::ViolaProductShellView *shell = GetProductShellView()) {
+    shell->SetSidebarModalVisible(*open);
+  }
+}
+
+void ViolaMessageHandler::HandleTabMove(const base::Value &payload,
+                                        bool reorder) {
+  const size_t expected_size = reorder ? 4u : 2u;
+  if (!payload.is_dict() || payload.GetDict().size() != expected_size ||
+      !organization_store_ || !organization_store_->loaded()) {
+    return;
+  }
+  const base::DictValue &request = payload.GetDict();
+  const std::string *tab_id = request.FindString("tabId");
+  const std::string *space_id = request.FindString("spaceId");
+  const std::string *section =
+      reorder ? request.FindString("section") : nullptr;
+  const std::optional<int> index = reorder ? request.FindInt("index") : 0;
+  if (!tab_id || !space_id || !index || *index < 0 || (reorder && !section)) {
+    return;
+  }
+  const std::string destination_section = reorder ? *section : "today";
+  TabStripModel *tab_strip = GetProductTabStrip();
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  if (!tab_strip || tab_strip != observed_tab_strip_ || !browser ||
+      !organization_store_->MoveTab(*tab_id, *space_id, destination_section,
+                                    static_cast<size_t>(*index))) {
+    return;
+  }
+  int live_index = organization_store_->FindTabIndex(tab_strip, *tab_id);
+  if (live_index != TabStripModel::kNoTab) {
+    const bool pinned = destination_section == "pinned";
+    if (tab_strip->IsTabPinned(live_index) != pinned) {
+      tab_strip->SetTabPinned(live_index, pinned);
+    }
+    if (tab_strip->GetActiveWebContents() ==
+            tab_strip->GetWebContentsAt(live_index) &&
+        !organization_store_->is_all_workspaces_lens()) {
+      organization_store_->SwitchWorkspace(*space_id, browser, tab_strip);
+    }
+  }
+  SendRenderState();
+}
+
+void ViolaMessageHandler::HandleTabGroupRename(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 3 ||
+      !organization_store_ || !organization_store_->loaded()) {
+    return;
+  }
+  const base::DictValue &request = payload.GetDict();
+  const std::string *space_id = request.FindString("spaceId");
+  const std::string *group_id = request.FindString("groupId");
+  const std::string *title = request.FindString("title");
+  if (space_id && group_id && title &&
+      ((group_id->starts_with("split:") &&
+        organization_store_->RenameSplitGroup(*space_id, *title)) ||
+       (!group_id->starts_with("split:") &&
+        organization_store_->RenameTabGroup(*space_id, *group_id, *title)))) {
+    SendRenderState();
+  }
+}
+
+void ViolaMessageHandler::HandleTabGroupClose(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 3 ||
+      !organization_store_ || !organization_store_->loaded()) {
+    return;
+  }
+  const base::DictValue &request = payload.GetDict();
+  const std::string *space_id = request.FindString("spaceId");
+  const std::string *group_id = request.FindString("groupId");
+  const base::ListValue *requested_ids = request.FindList("tabIds");
+  if (!space_id || !group_id || !requested_ids) {
+    return;
+  }
+  const std::optional<viola::TabGroupContextMenuState> state =
+      organization_store_->GetTabGroupContextMenuState(*space_id, *group_id);
+  if (!state || state->tab_ids.size() != requested_ids->size()) {
+    return;
+  }
+  const std::vector<std::string> &ids = state->tab_ids;
+  for (size_t index = 0; index < ids.size(); ++index) {
+    if (!(*requested_ids)[index].is_string() ||
+        (*requested_ids)[index].GetString() != ids[index]) {
+      return;
+    }
+  }
+  TabStripModel *tab_strip = GetProductTabStrip();
+  if (!tab_strip || tab_strip != observed_tab_strip_) {
+    return;
+  }
+  for (const std::string &id : ids) {
+    base::DictValue close_request;
+    close_request.Set("tabId", id);
+    HandleTabClose(base::Value(std::move(close_request)));
+  }
+  SendRenderState();
+}
+
+void ViolaMessageHandler::HandleTabGroupGroupTab(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 5 ||
+      !organization_store_ || !organization_store_->loaded()) {
+    return;
+  }
+  const base::DictValue &request = payload.GetDict();
+  const std::string *tab_id = request.FindString("tabId");
+  const std::string *space_id = request.FindString("spaceId");
+  const std::optional<int> index = request.FindInt("index");
+  const base::Value *target_value = request.Find("targetTabId");
+  const base::Value *group_value = request.Find("groupId");
+  const std::string target_id = target_value && target_value->is_string()
+                                    ? target_value->GetString()
+                                    : std::string();
+  const std::string group_id = group_value && group_value->is_string()
+                                   ? group_value->GetString()
+                                   : std::string();
+  const bool target_valid =
+      target_value && (target_value->is_none() || target_value->is_string());
+  const bool group_valid =
+      group_value && (group_value->is_none() || group_value->is_string());
+  if (!tab_id || !space_id || !index || *index < 0 || !target_valid ||
+      !group_valid ||
+      !organization_store_->GroupTab(*tab_id, target_id, group_id, *space_id,
+                                     static_cast<size_t>(*index))) {
+    return;
+  }
+  TabStripModel *tab_strip = GetProductTabStrip();
+  const int live_index = organization_store_->FindTabIndex(tab_strip, *tab_id);
+  if (live_index != TabStripModel::kNoTab &&
+      tab_strip->IsTabPinned(live_index) !=
+          organization_store_->IsPinned(*tab_id)) {
+    tab_strip->SetTabPinned(live_index, organization_store_->IsPinned(*tab_id));
+  }
+  SendRenderState();
+}
+
+void ViolaMessageHandler::HandleTabGroupReorder(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 5 ||
+      !organization_store_ || !organization_store_->loaded()) {
+    return;
+  }
+  const base::DictValue &request = payload.GetDict();
+  const std::string *group_id = request.FindString("groupId");
+  const std::string *space_id = request.FindString("spaceId");
+  const std::string *section = request.FindString("section");
+  const base::ListValue *requested_ids = request.FindList("tabIds");
+  const std::optional<int> index = request.FindInt("index");
+  if (!group_id || !space_id || !section || !requested_ids || !index ||
+      *index < 0) {
+    return;
+  }
+  std::vector<std::string> tab_ids;
+  for (const base::Value &id : *requested_ids) {
+    if (!id.is_string()) {
+      return;
+    }
+    tab_ids.push_back(id.GetString());
+  }
+  const std::optional<std::vector<std::string>> moved =
+      organization_store_->ReorderTabGroup(
+          *space_id, *group_id, tab_ids, *section, static_cast<size_t>(*index));
+  TabStripModel *tab_strip = GetProductTabStrip();
+  if (!moved || !tab_strip || tab_strip != observed_tab_strip_) {
+    return;
+  }
+  const bool pinned = *section == "pinned";
+  for (const std::string &tab_id : *moved) {
+    const int live_index = organization_store_->FindTabIndex(tab_strip, tab_id);
+    if (live_index != TabStripModel::kNoTab &&
+        tab_strip->IsTabPinned(live_index) != pinned) {
+      tab_strip->SetTabPinned(live_index, pinned);
+    }
+  }
+  SendRenderState();
+}
+
+void ViolaMessageHandler::HandleTabGroupMoveToSpace(
+    const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 5 ||
+      !organization_store_ || !organization_store_->loaded()) {
+    return;
+  }
+  const base::DictValue &request = payload.GetDict();
+  const std::string *group_id = request.FindString("groupId");
+  const std::string *source_space_id = request.FindString("sourceSpaceId");
+  const std::string *destination_space_id =
+      request.FindString("destinationSpaceId");
+  const std::string *section = request.FindString("section");
+  const std::optional<int> index = request.FindInt("index");
+  if (!group_id || !source_space_id || !destination_space_id || !section ||
+      !index || *index < 0) {
+    return;
+  }
+  const std::optional<std::vector<std::string>> moved =
+      organization_store_->MoveTabGroup(*group_id, *source_space_id,
+                                        *destination_space_id, *section,
+                                        static_cast<size_t>(*index));
+  TabStripModel *tab_strip = GetProductTabStrip();
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  if (!moved || !tab_strip || tab_strip != observed_tab_strip_ || !browser) {
+    return;
+  }
+  const bool pinned = *section == "pinned";
+  bool active_member = false;
+  for (const std::string &tab_id : *moved) {
+    const int live_index = organization_store_->FindTabIndex(tab_strip, tab_id);
+    if (live_index == TabStripModel::kNoTab) {
+      continue;
+    }
+    active_member =
+        active_member || tab_strip->GetActiveWebContents() ==
+                             tab_strip->GetWebContentsAt(live_index);
+    if (tab_strip->IsTabPinned(live_index) != pinned) {
+      tab_strip->SetTabPinned(live_index, pinned);
+    }
+  }
+  if (active_member && !organization_store_->is_all_workspaces_lens()) {
+    organization_store_->SwitchWorkspace(*destination_space_id, browser,
+                                         tab_strip);
+  }
+  SendRenderState();
+}
+
+void ViolaMessageHandler::HandleTabGroupOpenSaved(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 2 ||
+      !organization_store_ || !organization_store_->loaded()) {
+    return;
+  }
+  const base::DictValue &request = payload.GetDict();
+  const std::string *group_id = request.FindString("groupId");
+  const std::string *space_id = request.FindString("spaceId");
+  TabStripModel *tab_strip = GetProductTabStrip();
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  if (!group_id || !space_id || !tab_strip ||
+      tab_strip != observed_tab_strip_ || !browser ||
+      !organization_store_->OpenSavedTabGroup(*space_id, *group_id)) {
+    return;
+  }
+  organization_store_->SwitchWorkspace(*space_id, browser, tab_strip);
+  SendRenderState();
+}
