+      e.preventDefault();
+      // Plain Enter always commits the exact current text. Async suggestions
+      // may arrive between the final keystroke and keydown; they must not turn
+      // an otherwise reliable commit into a stale or expired token action.
+      const item = selectionExplicit ? items[sel] : fallbackItem();
+      if (item) commitItem(item, e.metaKey);
+    }
+  });
+
+  function fallbackItem() {
+    const text = qEl.value.trim();
+    if (!text) return null;
+    return { type: 'raw', url: text, title: text };
+  }
+
+  async function refresh() {
+    const token = ++queryToken;
+    const text = qEl.value;
+    let res;
+    try { res = await vela.invoke('palette:query', { q: text, mode }); }
+    catch { res = []; }
+    if (token !== queryToken) return;
+    items = res || [];
+    sel = 0;
+    renderResults();
+  }
+
+  function move(d) {
+    if (!items.length) return;
+    selectionExplicit = true;
+    sel = (sel + d + items.length) % items.length;
+    paintSelection();
+  }
+
+  function commitItem(item, meta = false) {
+    if (!item || committing) return;
+    committing = true;
+    // History/bookmark/search rows are navigation suggestions, not privileged
+    // mutations. Commit their displayed destination as the same strictly
+    // validated raw shape as typed input so a newer async query cannot make a
+    // perfectly visible row's short-lived capability token stale. Open-tab
+    // switching retains its opaque token because that is an identity action.
+    const committedItem = !meta && item.type !== 'tab' && typeof item.url === 'string'
+      ? { type: 'raw', url: item.url, title: item.url }
+      : item;
+    vela.send('palette:commit', { item: committedItem, mode, meta });
+    // Navigation closes the native overlay. If the tab/profile changed during
+    // an async suggestion query, the host may safely reject that capability;
+    // never leave the palette permanently inert after that bounded rejection.
+    setTimeout(() => { committing = false; }, 450);
+  }
+
+  function paintSelection() {
+    const rows = $('#results').querySelectorAll('.row');
+    rows.forEach((row, index) => {
+      const selected = index === sel;
+      row.classList.toggle('sel', selected);
+      row.setAttribute('aria-selected', String(selected));
+    });
+    $('#q').setAttribute(
+      'aria-activedescendant',
+      rows.length ? `palette-option-${sel}` : '',
+    );
+  }
+
+  const ICONS = {
+    search: '<svg viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m10.5 10.5 3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
+    url: '<svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M2.5 8h11M8 2.2c-3.5 3.5-3.5 8.1 0 11.6M8 2.2c3.5 3.5 3.5 8.1 0 11.6" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>',
+    history: '<svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 4.5V8l2.5 1.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>',
+    tab: '<svg viewBox="0 0 16 16"><rect x="2" y="3" width="12" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M2 6h12" stroke="currentColor" stroke-width="1.4"/></svg>',
+  };
+
+  function renderResults() {
+    const wrap = $('#results');
+    wrap.replaceChildren();
+    items.forEach((item, i) => {
+      const row = document.createElement('div');
+      row.className = 'row' + (i === sel ? ' sel' : '');
+      row.id = `palette-option-${i}`;
+      row.setAttribute('role', 'option');
+      row.setAttribute('aria-selected', String(i === sel));
+      const ric = document.createElement('div');
+      ric.className = 'ric';
+      if (item.favicon) {
+        const img = document.createElement('img');
+        img.src = item.favicon;
+        img.addEventListener('error', () => {
+          ric.innerHTML = staticHTML(ICONS[item.type] || ICONS.url);
+        }, { once: true });
+        ric.appendChild(img);
+      } else {
+        ric.innerHTML = staticHTML(ICONS[item.type] || ICONS.url);
+      }
+      row.appendChild(ric);
+      const t = document.createElement('span');
+      t.className = 'rtitle';
+      t.textContent = item.title;
+      row.appendChild(t);
+      const d = document.createElement('span');
+      d.className = 'rdetail';
+      d.textContent = item.detail || '';
+      row.appendChild(d);
+      row.addEventListener('mousemove', () => {
+        selectionExplicit = true;
+        if (sel !== i) { sel = i; paintSelection(); }
+      });
+      // Commit on pointer-down so selecting a result cannot be lost when focus
+      // or hover styling changes before the later click event is dispatched.
+      row.addEventListener('pointerdown', (event) => {
+        if (event.button !== 0) return;
+        event.preventDefault();
+        selectionExplicit = true;
+        sel = i;
+        paintSelection();
+        commitItem(item);
+      });
+      wrap.appendChild(row);
+    });
+    $('#q').setAttribute(
+      'aria-activedescendant',
+      items.length ? `palette-option-${sel}` : '',
+    );
+  }
+
+  // ---------- find ----------
+  const fqEl = $('#fq');
+  let findTimer = null;
+  fqEl.addEventListener('input', () => {
+    clearTimeout(findTimer);
+    findTimer = setTimeout(() => doFind(true, false), 120);
+  });
+  fqEl.addEventListener('keydown', (e) => {
+    if (e.key === 'Enter') { e.preventDefault(); doFind(!e.shiftKey, true); }
+  });
+  $('#fnext').addEventListener('click', () => doFind(true, true));
+  $('#fprev').addEventListener('click', () => doFind(false, true));
+  $('#fclose').addEventListener('click', () => vela.send('find:close'));
+
+  function doFind(forward, findNext) {
+    const text = fqEl.value;
+    if (!text) { $('#fcount').textContent = ''; return; }
+    vela.send('find:query', { text, forward, findNext });
+  }
+
+  vela.on('find:result', ({ active, matches }) => {
+    $('#fcount').textContent = matches ? `${active}/${matches}` : 'No matches';
+  });
+
+  // ---------- downloads ----------
+  $('#downloads-search').addEventListener('input', (e) => {
+    downloadQuery = e.target.value;
+    renderDownloads();
+  });
+  $('#downloads-clear').addEventListener('click', () => vela.send('download:clear'));
+  $('#downloads-close').addEventListener('click', () => vela.send('palette:close'));
+  vela.on('download:update', ({ downloads }) => {
+    downloadData = downloads || [];
+    if (mode === 'downloads') renderDownloads();
+  });
+
+  function renderDownloads() {
+    const content = $('#downloads-content');
+    content.replaceChildren();
+    const q = downloadQuery.trim().toLowerCase();
+    const items = downloadData.filter((item) => `${item.filename || ''} ${item.path || ''} ${item.sourceUrl || ''}`.toLowerCase().includes(q));
+    const finished = downloadData.some((item) => !['progressing', 'paused'].includes(item.state));
+    $('#downloads-clear').hidden = !finished;
+    if (!items.length) {
+      const empty = makeNode('div', 'downloads-empty');
+      empty.append(makeNode('div', 'downloads-empty-mark', '↓'), makeNode('div', '', q ? 'No downloads match that search.' : 'Files you download will appear here.'));
+      content.append(empty);
+      return;
+    }
+    const active = items.filter((item) => ['progressing', 'paused'].includes(item.state));
+    const recent = items.filter((item) => !['progressing', 'paused'].includes(item.state));
+    if (active.length) appendDownloadSection(content, 'Downloading', `${active.length} active`, active);
+    if (recent.length) appendDownloadSection(content, q ? 'Search results' : 'Recent', `${recent.length} ${recent.length === 1 ? 'file' : 'files'}`, recent);
+  }
+
+  function appendDownloadSection(content, label, note, items) {
+    const section = makeNode('section', 'downloads-section');
+    const head = makeNode('div', 'downloads-section-head');
+    head.append(makeNode('h2', '', label), makeNode('span', 'downloads-section-note', note));
+    const list = makeNode('div', 'downloads-card-list');
+    items.forEach((item) => list.append(downloadRow(item)));
+    section.append(head, list); content.append(section);
+  }
+
+  function downloadRow(item) {
+    const row = makeNode('div', 'download-row');
+    const revealLabel = vela.platform === 'darwin'
+      ? 'Show in Finder'
+      : vela.platform === 'win32' ? 'Show in File Explorer' : 'Show in Folder';
+    if (item.state === 'done' && item.path) {
+      row.classList.add('download-file-drag');
+      row.draggable = true;
+      row.title = `Drag this download into ${vela.platform === 'darwin' ? 'Finder' : 'another folder'} or another app`;
+      row.addEventListener('dragstart', (event) => {
+        event.preventDefault();
+        vela.send('download:dragFile', { id: item.id });
+      });
+    }
+    const icon = makeNode('div', 'download-file');
+    icon.innerHTML = staticHTML('<svg viewBox="0 0 20 20"><path d="M10 3.5v8m-3-3 3 3 3-3M5 15h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>');
+    const copy = makeNode('div', 'download-copy');
+    copy.append(makeNode('div', 'download-title', item.filename || 'Download'));
+    const pct = item.total > 0 ? Math.max(0, Math.min(100, Math.round(item.received / item.total * 100))) : null;
+    const status = item.state === 'done' ? 'Completed' : item.state;
+    const detail = `${status}${pct !== null && ['progressing', 'paused'].includes(item.state) ? ` · ${pct}%` : ''} · ${formatBytes(item.received)}${item.total > 0 ? ` of ${formatBytes(item.total)}` : ''}`;
+    copy.append(makeNode('div', `download-meta download-status ${item.state}`, detail));
+    if (['progressing', 'paused'].includes(item.state)) {
+      const progress = makeNode('div', `download-progress${item.total > 0 ? '' : ' indeterminate'}`);
+      const fill = makeNode('div'); fill.style.width = `${pct || 0}%`; progress.append(fill); copy.append(progress);
+    }
+    const actions = makeNode('div', 'download-actions');
+    const action = (label, channel, kind = '') => {
+      const button = makeNode('button', `downloads-button ${kind}`.trim(), label);
+      button.addEventListener('click', (e) => { e.stopPropagation(); vela.send(channel, { id: item.id }); });
+      actions.append(button);
+    };
+    if (item.state === 'progressing') { action('Pause', 'download:pause'); action('Cancel', 'download:cancel', 'danger'); }
+    else if (item.state === 'paused') { action('Resume', 'download:resume'); action('Cancel', 'download:cancel', 'danger'); }
+    else if (item.state === 'interrupted' && item.canResume) { action('Resume', 'download:resume'); action('Cancel', 'download:cancel', 'danger'); }
+    else if (item.state === 'done') { action('Open', 'download:open'); action(revealLabel, 'download:reveal'); action('Remove', 'download:remove', 'danger'); }
+    else { if (item.path) action(revealLabel, 'download:reveal'); action('Remove', 'download:remove', 'danger'); }
+    row.append(icon, copy, actions);
+    if (item.state === 'done') row.addEventListener('dblclick', () => vela.send('download:open', { id: item.id }));
+    return row;
+  }
+
+  function makeNode(tag, className = '', text) {
+    const el = document.createElement(tag);
+    if (className) el.className = className;
+    if (text !== undefined) el.textContent = text;
+    return el;
+  }
+
+  function formatBytes(bytes) {
+    const n = Number(bytes) || 0;
+    if (n < 1024) return `${n} B`;
+    const units = ['KB', 'MB', 'GB', 'TB']; let value = n / 1024; let index = 0;
+    while (value >= 1024 && index < units.length - 1) { value /= 1024; index++; }
+    return `${value >= 100 ? Math.round(value) : value.toFixed(value >= 10 ? 1 : 2)} ${units[index]}`;
+  }
+
+  // ---------- notification history ----------
+  $('#notifications-search').addEventListener('input', (e) => {
+    notificationQuery = e.target.value;
+    renderNotificationHistory();
+  });
+  $('#notifications-clear').addEventListener('click', () => vela.send('notification:historyClear'));
+  $('#notifications-close').addEventListener('click', () => vela.send('palette:close'));
+  vela.on('notification:historyUpdate', ({ history }) => {
+    notificationData = history || [];
+    if (mode === 'notifications') renderNotificationHistory();
+  });
+
+  function renderNotificationHistory() {
+    const content = $('#notifications-content');
+    content.replaceChildren();
+    const q = notificationQuery.trim().toLowerCase();
+    const items = notificationData.filter((item) => `${item.title || ''} ${item.body || ''} ${item.host || ''}`.toLowerCase().includes(q));
+    $('#notifications-clear').hidden = notificationData.length === 0;
+    if (!items.length) {
+      const empty = makeNode('div', 'downloads-empty');
+      empty.append(makeNode('div', 'downloads-empty-mark', '◇'), makeNode('div', '', q ? 'No notifications match that search.' : 'Notification history will appear here.'));
+      content.append(empty);
+      return;
+    }
+    if (q) {
+      appendNotificationSection(content, 'Search results', `${items.length} ${items.length === 1 ? 'notification' : 'notifications'}`, items);
+      return;
+    }
+    const todayStart = new Date(); todayStart.setHours(0, 0, 0, 0);
+    const today = items.filter((item) => item.createdAt >= todayStart.getTime());
+    const earlier = items.filter((item) => item.createdAt < todayStart.getTime());
+    if (today.length) appendNotificationSection(content, 'Today', `${today.length}`, today);
+    if (earlier.length) appendNotificationSection(content, 'Earlier', `${earlier.length}`, earlier);
+  }
+
+  function appendNotificationSection(content, label, note, items) {
+    const section = makeNode('section', 'downloads-section');
+    const head = makeNode('div', 'downloads-section-head');
+    head.append(makeNode('h2', '', label), makeNode('span', 'downloads-section-note', note));
+    const list = makeNode('div', 'downloads-card-list');
+    items.forEach((item) => list.append(notificationHistoryRow(item)));
+    section.append(head, list); content.append(section);
+  }
+
+  function notificationHistoryRow(item) {
+    const row = makeNode('div', `notification-history-row${item.important ? ' important' : ''}`);
+    row.style.setProperty('--nh', String(Number(item.hue) || 0));
+    const logo = makeNode('div', 'notification-history-logo');
+    if (item.icon) {
+      const img = makeNode('img'); img.src = item.icon;
+      img.onerror = () => { logo.textContent = (item.host || '?')[0].toUpperCase(); };
+      logo.append(img);
+    } else {
+      logo.textContent = item.url === 'vela://downloads' ? '↓' : (item.host || '?')[0].toUpperCase();
+    }
+    const copy = makeNode('div', 'notification-history-copy');
+    copy.append(makeNode('div', 'notification-history-title', item.title || item.host));
+    if (item.body) copy.append(makeNode('div', 'notification-history-body', item.body));
+    copy.append(makeNode('div', 'notification-history-meta', `${item.host} · ${relativeTime(item.createdAt)}`));
+    const open = makeNode('button', 'downloads-button', 'Open');
+    open.addEventListener('click', (e) => { e.stopPropagation(); vela.send('notification:historyOpen', { id: item.id }); });
+    row.append(logo, copy, open);
+    row.addEventListener('dblclick', () => vela.send('notification:historyOpen', { id: item.id }));
+    return row;
+  }
+
+  function relativeTime(timestamp) {
+    const age = Math.max(0, Date.now() - (Number(timestamp) || 0));
+    if (age < 60000) return 'just now';
+    if (age < 3600000) return `${Math.floor(age / 60000)}m ago`;
+    if (age < 86400000) return `${Math.floor(age / 3600000)}h ago`;
+    if (age < 604800000) return `${Math.floor(age / 86400000)}d ago`;
+    return new Date(timestamp).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
+  }
+
+  // ---------- split hint ----------
+  vela.on('split:hint', ({ x, y, width, height }) => {
+    const el = $('#split-hint');
+    el.style.left = x + 'px';
+    el.style.top = y + 'px';
+    el.style.width = width + 'px';
+    el.style.height = height + 'px';
+  });
+</script>
+</body>
+</html>
