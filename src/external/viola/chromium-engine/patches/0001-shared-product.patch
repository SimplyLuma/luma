+  ASSERT_TRUE(web_contents->GetWebUI());
+
+  EXPECT_TRUE(content::EvalJs(web_contents, R"(
+    document.readyState === 'complete' &&
+    !!document.querySelector('#titlebar') &&
+    !!document.querySelector('#new-tab-row') &&
+    document.body.classList.contains(`platform-${vela.platform}`) &&
+    document.querySelector('#new-tab-row .hint')?.textContent ===
+      (vela.platform === 'darwin' ? '⌘T' : 'Ctrl+T') &&
+    typeof vela === 'object' && Object.isFrozen(vela)
+  )")
+                  .ExtractBool());
+  EXPECT_TRUE(content::EvalJs(web_contents, R"(
+    new Promise((resolve) => {
+      const unsubscribe = vela.on('window:chromeState', (state) => {
+        unsubscribe();
+        resolve(
+          typeof state?.visible === 'boolean' &&
+          typeof state?.maximized === 'boolean' &&
+          typeof state?.fullScreen === 'boolean'
+        );
+      });
+      vela.send('ui:ready');
+    })
+  )")
+                  .ExtractBool());
+  const int direct_tab_count = browser()->tab_strip_model()->count();
+  EXPECT_TRUE(content::EvalJs(web_contents, "vela.send('tab:new', {}); true")
+                  .ExtractBool());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(direct_tab_count, browser()->tab_strip_model()->count());
+  const GURL direct_origin_url = web_contents->GetLastCommittedURL();
+  EXPECT_TRUE(content::EvalJs(web_contents, "vela.send('nav:back'); true")
+                  .ExtractBool());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(direct_origin_url, web_contents->GetLastCommittedURL());
+  // Prove the generated capability bridge forwards the narrow caption channel
+  // into Chromium. An unknown action is intentionally inert after dispatch, so
+  // this assertion cannot minimize or close the browser-test owner.
+  EXPECT_TRUE(content::EvalJs(web_contents, R"(
+    (() => {
+      try {
+        vela.send('window:control', {action: 'invalid-test-action'});
+        return true;
+      } catch {
+        return false;
+      }
+    })()
+  )")
+                  .ExtractBool());
+  EXPECT_TRUE(content::EvalJs(web_contents, R"(
+    (() => { try { vela.send('account:remove'); return false; } catch { return true; } })()
+  )")
+                  .ExtractBool());
+
+  EXPECT_TRUE(viola::IsHostChannelAllowed("sidebar.html",
+                                          viola::HostTransport::kSend,
+                                          viola::HostChannel::kUiReady));
+  EXPECT_EQ(viola::ParseHostChannel("ui:ready"), viola::HostChannel::kUiReady);
+  EXPECT_FALSE(viola::ParseHostChannel("ui:*"));
+  EXPECT_FALSE(viola::IsHostChannelAllowed("sidebar.html",
+                                           viola::HostTransport::kSend,
+                                           viola::HostChannel::kAccountRemove));
+  EXPECT_FALSE(viola::IsHostChannelAllowed("unknown.html",
+                                           viola::HostTransport::kReceive,
+                                           viola::HostChannel::kRender));
+}
