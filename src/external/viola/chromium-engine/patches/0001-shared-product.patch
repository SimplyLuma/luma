+  pointer-events: auto;
+  touch-action: none;
+  -webkit-app-region: no-drag;
+}
+body.platform-win32 #desktop-caption-controls,
+body.platform-linux #desktop-caption-controls {
+  display: flex;
+}
+body.window-caption-hidden #desktop-caption-controls,
+body.window-full-screen #desktop-caption-controls { display: none; }
+.desktop-caption {
+  position: relative;
+  width: 23px;
+  height: 23px;
+  padding: 0;
+  border: 0;
+  border-radius: 0;
+  background: transparent;
+  color: currentColor;
+  opacity: .78;
