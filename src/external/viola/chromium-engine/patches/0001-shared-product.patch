+
+class ViolaProductShellView;
+
+// A top-chrome permission prompt for the gated Viola product window. Chromium
+// remains the permission owner; this object only projects its notification
+// request into the trusted sidebar and forwards an exact user decision.
+class ViolaPermissionPrompt final : public permissions::PermissionPrompt {
+ public:
+  static bool CanHandle(content::WebContents *web_contents,
+                        Delegate *delegate);
+
+  ViolaPermissionPrompt(content::WebContents *web_contents,
+                        Delegate *delegate);
+  ViolaPermissionPrompt(const ViolaPermissionPrompt &) = delete;
+  ViolaPermissionPrompt &operator=(const ViolaPermissionPrompt &) = delete;
+  ~ViolaPermissionPrompt() override;
+
+  bool Resolve(std::string_view decision, ViolaProductShellView *shell);
+  void DetachFromShell(ViolaProductShellView *shell);
+
+  // permissions::PermissionPrompt:
+  bool UpdateAnchor() override;
+  TabSwitchingBehavior GetTabSwitchingBehavior() override;
+  permissions::PermissionPromptDisposition GetPromptDisposition()
+      const override;
+  bool IsAskPrompt() const override;
+  std::optional<gfx::Rect> GetViewBoundsInScreen() const override;
+  bool ShouldFinalizeRequestAfterDecided() const override;
+  std::vector<permissions::ElementAnchoredBubbleVariant>
+  GetPromptVariants() const override;
+  std::optional<permissions::feature_params::PermissionElementPromptPosition>
+  GetPromptPosition() const override;
+
+ private:
+  void AttachToProductShell(content::WebContents *web_contents);
+
+  raw_ptr<Delegate> delegate_ = nullptr;
+  raw_ptr<ViolaProductShellView> shell_ = nullptr;
+  std::string id_;
+};
