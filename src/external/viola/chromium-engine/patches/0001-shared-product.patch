+std::set<std::string> RemovedTabIds(const base::DictValue &organization) {
+  std::set<std::string> result;
+  const base::ListValue *spaces = organization.FindList("spaces");
+  if (!spaces) {
+    return result;
+  }
+  for (const base::Value &space : *spaces) {
+    const base::ListValue *removed =
+        space.GetDict().FindList("syncRemovedTabIds");
+    if (!removed) {
+      continue;
+    }
+    for (const base::Value &candidate : *removed) {
+      if (candidate.is_string()) {
+        result.insert(candidate.GetString());
+      }
+    }
+  }
+  return result;
+}
+
+std::vector<std::string> SplitLeaves(const base::Value *node) {
+  std::vector<std::string> result;
+  const base::DictValue *dict = node ? node->GetIfDict() : nullptr;
+  if (!dict) {
+    return result;
+  }
+  if (StringOr(dict, "t") == "leaf") {
+    if (const std::string *id = dict->FindString("tabId")) {
+      result.push_back(*id);
+    }
+    return result;
+  }
+  if (const base::ListValue *children = dict->FindList("kids")) {
+    for (const base::Value &child : *children) {
+      std::vector<std::string> leaves = SplitLeaves(&child);
+      result.insert(result.end(), leaves.begin(), leaves.end());
+    }
+  }
+  return result;
+}
