+  .luma-settings main { padding:24px 20px 48px; }
+  .luma-settings .setting { flex-wrap:wrap; gap:12px; }
+  .luma-settings .setting > :first-child { flex:1 1 100%; }
+  .luma-settings .setting > .library-copy { flex:1 1 180px; }
+  .luma-settings .setting > .library-favicon { flex:none; }
