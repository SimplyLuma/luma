+void NormalizeViolaHomepageTabs(
+    TabStripModel *tab_strip,
+    const viola::ViolaOrganizationStore *organization_store) {
+#if BUILDFLAG(IS_LINUX)
+  // Native New Tab owns a visible blank identity while the user composes.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "viola-native-frame-probe")) {
+    return;
+  }
+#endif
+  if (!tab_strip) {
+    return;
+  }
+  for (int index = 0; index < tab_strip->count(); ++index) {
+    content::WebContents *contents = tab_strip->GetWebContentsAt(index);
+    if (!contents || !IsViolaHomepagePlaceholder(contents->GetVisibleURL())) {
+      continue;
+    }
+    // TabStripModelObserver callbacks may run while Chromium is committing a
+    // navigation (including organization-sync adoption). Starting another
+    // LoadURLWithParams while any pending entry exists re-enters the
+    // NavigationController and trips its pending-entry invariant. A later tab
+    // change will normalize a still-placeholder tab after the commit finishes.
+    if (contents->GetController().GetPendingEntry()) {
+      continue;
+    }
+    const GURL homepage(organization_store && organization_store->loaded()
+                            ? organization_store->homepage()
+                            : "https://www.google.com/");
+    content::NavigationController::LoadURLParams params(homepage);
+    params.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+    contents->GetController().LoadURLWithParams(params);
+  }
+}
