+struct ViolaAccountSyncService::PendingEnrollment {
+  std::string challenge_id;
+  std::string display_name;
+  std::string email;
+  std::string password;
+  std::string intent;
+  std::string device_id;
+  std::string device_name;
+  bool legacy_account = false;
+  bool has_snapshots = false;
+  base::DictValue verified_session;
+};
+
+// static
+ViolaAccountSyncService *ViolaAccountSyncService::Get(Profile *profile) {
+  if (!profile || profile->IsOffTheRecord()) {
+    return nullptr;
+  }
+  if (!profile->GetUserData(kProfileServiceKey)) {
+    profile->SetUserData(kProfileServiceKey,
+                         std::unique_ptr<ViolaAccountSyncService>(
+                             new ViolaAccountSyncService(profile)));
+  }
+  return static_cast<ViolaAccountSyncService *>(
+      profile->GetUserData(kProfileServiceKey));
+}
+
+// static
+bool ViolaAccountSyncService::HasInstanceForTesting(Profile *profile) {
+  return profile && profile->GetUserData(kProfileServiceKey);
+}
+
+// static
+bool ViolaAccountSyncService::IsLoadedForTesting(Profile *profile) {
+  if (!profile) {
+    return false;
+  }
+  auto *service = static_cast<ViolaAccountSyncService *>(
+      profile->GetUserData(kProfileServiceKey));
+  return service && service->loaded_;
+}
+
+ViolaAccountSyncService::ViolaAccountSyncService(Profile *profile)
+    : profile_(profile),
+      state_path_(profile->GetPath().AppendASCII("Viola").AppendASCII(
+          "account-sync-v1.json")),
+      writer_instance_id_(base::Uuid::GenerateRandomV4().AsLowercaseString()) {
+  writer_ = std::make_unique<base::ImportantFileWriter>(
+      state_path_,
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE}),
+      base::Seconds(2), "ViolaAccountSync");
+  if (g_browser_process && g_browser_process->os_crypt_async()) {
+    g_browser_process->os_crypt_async()->GetInstance(
+        base::BindOnce(&ViolaAccountSyncService::OnEncryptorReady,
+                       weak_factory_.GetWeakPtr()));
+  } else {
+    FinishLoading();
+  }
+}
+
+ViolaAccountSyncService::~ViolaAccountSyncService() {
+  loaders_.clear();
+  if (writer_ && writer_->HasPendingWrite()) {
+    writer_->DoScheduledWrite();
+  }
+}
+
+void ViolaAccountSyncService::EnsureLoaded(base::OnceClosure callback) {
+  if (loaded_) {
+    std::move(callback).Run();
+    return;
+  }
+  loaded_callbacks_.push_back(std::move(callback));
+}
+
+void ViolaAccountSyncService::OnEncryptorReady(
+    scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  encryptor_ = std::move(encryptor);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&LoadStateOnBackgroundSequence, state_path_),
+      base::BindOnce(&ViolaAccountSyncService::OnStateLoaded,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void ViolaAccountSyncService::OnStateLoaded(base::DictValue state) {
+  state_ = std::move(state);
+  FinishLoading();
+}
+
+void ViolaAccountSyncService::FinishLoading() {
+  loading_ = false;
+  loaded_ = true;
+  local_mutation_generation_ =
+      std::max(0, state_.FindInt("localMutationGeneration").value_or(0));
+  acknowledged_local_mutation_generation_ = std::clamp(
+      state_.FindInt("acknowledgedLocalMutationGeneration").value_or(0), 0,
+      local_mutation_generation_);
+  local_dirty_ =
+      local_mutation_generation_ > acknowledged_local_mutation_generation_;
+  std::vector<base::OnceClosure> callbacks = std::move(loaded_callbacks_);
+  loaded_callbacks_.clear();
+  for (base::OnceClosure &callback : callbacks) {
+    std::move(callback).Run();
+  }
+  if (state_.FindDict("account")) {
+    if (UnprotectSecrets()) {
+      sync_timer_.Start(FROM_HERE, base::Milliseconds(250), this,
+                        &ViolaAccountSyncService::SyncNow);
+    } else {
+      state_.Set("connection", ProtectedTransportUnavailableConnection(
+                                   state_.FindDict("connection")));
+      ScheduleWrite();
+    }
+  }
+}
+
+base::DictValue ViolaAccountSyncService::Status() const {
+  base::DictValue status;
+  status.Set("available",
+             loaded_ && encryptor_ && encryptor_->IsEncryptionAvailable());
+  const base::DictValue *account = state_.FindDict("account");
+  const base::DictValue *device = state_.FindDict("device");
+  status.Set("account",
+             account ? base::Value(account->Clone()) : base::Value());
+  status.Set("device", device ? base::Value(device->Clone()) : base::Value());
+  status.Set("enabled", account != nullptr);
+  const bool transport_configured =
+      account != nullptr && UnprotectSecrets().has_value();
+  status.Set("transportConfigured", transport_configured);
+  const base::DictValue *stored_connection = state_.FindDict("connection");
+  base::DictValue connection =
+      stored_connection ? stored_connection->Clone() : base::DictValue();
+  if (!connection.contains("connected")) {
+    connection.Set("connected", false);
+  }
+  if (!connection.contains("lastError")) {
+    connection.Set("lastError", base::Value());
+  }
+  if (!connection.contains("lastSyncedAt")) {
+    connection.Set("lastSyncedAt", base::Value());
+  }
+  if (account && !transport_configured) {
+    connection = ProtectedTransportUnavailableConnection(&connection);
+  }
+  status.Set("connection", std::move(connection));
+  status.Set("pending", syncing_ || sync_timer_.IsRunning());
+  status.Set("pendingRevision", 0);
+  status.Set("pendingGeneratedAt", base::Value());
+  status.Set("pendingBytes", 0);
+  base::DictValue scope;
+  base::ListValue included;
+  for (std::string_view item :
+       {"workspaces", "web tabs", "tab groups", "split layouts",
+        "workspace profiles", "browser history"}) {
+    included.Append(item);
+  }
+  base::ListValue excluded;
+  for (std::string_view item :
+       {"passwords", "cookies", "passkeys", "downloads", "permissions", "cache",
+        "Incognito data", "page contents"}) {
+    excluded.Append(item);
+  }
+  scope.Set("included", std::move(included));
+  scope.Set("excluded", std::move(excluded));
+  status.Set("scope", std::move(scope));
+  return status;
+}
+
+void ViolaAccountSyncService::BeginEmailSignIn(const base::DictValue &request,
+                                               ResultCallback callback) {
+  if (!loaded_ || !encryptor_ || !encryptor_->IsEncryptionAvailable()) {
+    std::move(callback).Run(
+        ErrorResult("Secure operating-system storage is required for sync."));
+    return;
+  }
+  if (state_.FindDict("account")) {
+    std::move(callback).Run(
+        ErrorResult("A Viola account already exists on this profile."));
+    return;
+  }
+  const std::string intent = CleanText(request.FindString("intent"), 12);
+  const std::string display_name =
+      CleanText(request.FindString("displayName"), 120);
+  std::string email = CleanText(request.FindString("email"), 320);
+  const std::string *password_value = request.FindString("password");
+  const std::string password = password_value ? *password_value : std::string();
+  const std::string device_name =
+      CleanText(request.FindString("deviceName"), 120);
+  email = base::ToLowerASCII(email);
+  if (intent != "signup" && intent != "signin" && intent != "reset") {
+    std::move(callback).Run(ErrorResult("Choose Create account or Sign in."));
+    return;
+  }
+  if (intent == "signup" && display_name.empty()) {
+    std::move(callback).Run(ErrorResult("Enter your name."));
+    return;
+  }
+  if (!IsEmail(email)) {
+    std::move(callback).Run(ErrorResult("Enter a valid email address."));
+    return;
+  }
+  if (password.size() < 10 || password.size() > 200) {
+    std::move(callback).Run(
+        ErrorResult("Use a password with at least 10 characters."));
+    return;
+  }
+  pending_ = std::make_unique<PendingEnrollment>();
+  pending_->display_name = display_name;
+  pending_->email = email;
+  pending_->password = password;
+  pending_->intent = intent;
+  std::string installation_device_id =
+      CleanText(state_.FindString("installationDeviceId"), 80);
+  if (installation_device_id.empty()) {
+    if (const base::DictValue *existing_device = state_.FindDict("device")) {
+      installation_device_id =
+          CleanText(existing_device->FindString("id"), 80);
+    }
+  }
+  if (installation_device_id.empty()) {
+    installation_device_id =
+        base::Uuid::GenerateRandomV4().AsLowercaseString();
+  }
+  state_.Set("installationDeviceId", installation_device_id);
+  pending_->device_id = installation_device_id;
+  pending_->device_name = device_name.empty() ? "This device" : device_name;
+  ScheduleWrite();
+  base::DictValue body;
+  body.Set("displayName", display_name);
+  body.Set("email", email);
+  body.Set("intent", intent);
+  StartJsonRequest("POST", "/v1/sessions/email/start", "", std::move(body),
+                   base::BindOnce(&ViolaAccountSyncService::OnEmailStart,
+                                  weak_factory_.GetWeakPtr(),
+                                  std::move(callback)));
+}
+
+void ViolaAccountSyncService::OnEmailStart(ResultCallback callback,
+                                           bool success,
+                                           base::DictValue response,
+                                           std::string error) {
+  if (!success || !pending_) {
+    pending_.reset();
+    std::move(callback).Run(ErrorResult(
+        error.empty() ? "Could not send a verification code." : error));
+    return;
+  }
+  pending_->challenge_id = CleanText(response.FindString("id"), 80);
+  pending_->legacy_account = response.FindBool("legacyAccount").value_or(false);
+  pending_->has_snapshots = response.FindBool("hasSnapshots").value_or(false);
+  if (pending_->challenge_id.empty()) {
+    pending_.reset();
+    std::move(callback).Run(ErrorResult(
+        "The Viola account service returned an invalid challenge."));
+    return;
+  }
+  base::DictValue result;
+  result.Set("ok", true);
+  result.Set("challengeId", pending_->challenge_id);
+  result.Set("email", pending_->email);
+  result.Set("expiresAt", CleanText(response.FindString("expiresAt"), 40));
+  std::move(callback).Run(std::move(result));
+}
+
+void ViolaAccountSyncService::VerifyEmailSignIn(const base::DictValue &request,
+                                                ResultCallback callback) {
+  const std::string code = CleanText(request.FindString("code"), 12);
+  if (!pending_ || pending_->challenge_id.empty()) {
+    std::move(callback).Run(ErrorResult("Start email sign-in again."));
+    return;
+  }
+  if (code.size() != 6 ||
+      !std::all_of(code.begin(), code.end(), [](char character) {
+        return character >= '0' && character <= '9';
+      })) {
+    std::move(callback).Run(
+        ErrorResult("Enter the six-digit code from your email."));
+    return;
+  }
+  std::optional<std::vector<uint8_t>> generated_key;
+  base::DictValue wrapped;
+  if (pending_->intent == "signup" || pending_->intent == "reset" ||
+      (pending_->legacy_account && !pending_->has_snapshots)) {
+    generated_key = base::RandBytesAsVector(32);
+    if (!WrapOrUnwrapKey(true, pending_->password, nullptr, *generated_key,
+                         &wrapped)) {
+      std::move(callback).Run(
+          ErrorResult("Viola could not protect the encrypted sync key."));
+      return;
+    }
+  }
+  base::DictValue device;
+  device.Set("id", pending_->device_id);
+  device.Set("name", pending_->device_name);
+  device.Set("platform", kPlatformId);
+  device.Set("arch", kArchitectureId);
+  base::DictValue body;
+  body.Set("challengeId", pending_->challenge_id);
+  body.Set("code", code);
+  body.Set("password", pending_->password);
+  body.Set("device", std::move(device));
+  if (!wrapped.empty()) {
+    body.Set("syncKeyEnvelope", std::move(wrapped));
+  }
+  StartJsonRequest("POST", "/v1/sessions/email/verify", "", std::move(body),
+                   base::BindOnce(&ViolaAccountSyncService::OnEmailVerify,
+                                  weak_factory_.GetWeakPtr(),
+                                  std::move(callback),
+                                  std::move(generated_key)));
+}
+
+void ViolaAccountSyncService::OnEmailVerify(
+    ResultCallback callback, std::optional<std::vector<uint8_t>> generated_key,
+    bool success, base::DictValue response, std::string error) {
+  if (!success || !pending_) {
+    std::move(callback).Run(
+        ErrorResult(error.empty() ? "Verification failed." : error));
+    return;
+  }
+  if (!IsBase64UrlToken(CleanText(response.FindString("token"), 100), 43)) {
+    std::move(callback).Run(
+        ErrorResult("The Viola account service returned an invalid session."));
+    return;
+  }
+  pending_->verified_session = response.Clone();
+  if (response.FindBool("needsKeyMigration").value_or(false)) {
+    base::DictValue result;
+    result.Set("ok", true);
+    result.Set("needsRecoveryKey", true);
+    result.Set("legacyMigration", true);
+    if (const base::DictValue *account = response.FindDict("account")) {
+      result.Set("account", account->Clone());
+    }
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+
+  std::optional<std::vector<uint8_t>> key = std::move(generated_key);
+  if (!key) {
+    const base::DictValue *envelope = response.FindDict("syncKeyEnvelope");
+    key = WrapOrUnwrapKey(false, pending_->password, envelope, {}, nullptr);
+  }
+  if (!key || key->size() != 32) {
+    std::move(callback).Run(
+        ErrorResult("This account password could not unlock sync."));
+    return;
+  }
+  base::DictValue result = FinishEnrollment(*key);
+  std::move(callback).Run(std::move(result));
+}
+
+void ViolaAccountSyncService::CompleteEmailSignIn(
+    const base::DictValue &request, ResultCallback callback) {
+  const std::string recovery_key =
+      CleanText(request.FindString("recoveryKey"), 80);
+  std::optional<std::vector<uint8_t>> key = IsBase64UrlToken(recovery_key, 43)
+                                                ? Base64UrlDecode(recovery_key)
+                                                : std::nullopt;
+  if (!pending_ || pending_->verified_session.empty() || !key ||
+      key->size() != 32) {
+    std::move(callback).Run(ErrorResult(
+        "Enter the 43-character Viola recovery key from another device."));
+    return;
+  }
+  const std::string token =
+      CleanText(pending_->verified_session.FindString("token"), 100);
+  StartJsonRequest("GET", "/v1/sync/snapshots", token, {},
+                   base::BindOnce(&ViolaAccountSyncService::OnRecoverySnapshots,
+                                  weak_factory_.GetWeakPtr(),
+                                  std::move(callback), std::move(*key)));
+}
+
+void ViolaAccountSyncService::OnRecoverySnapshots(ResultCallback callback,
+                                                  std::vector<uint8_t> key,
+                                                  bool success,
+                                                  base::DictValue response,
+                                                  std::string error) {
+  if (!success || !pending_ || pending_->verified_session.empty()) {
+    std::move(callback).Run(ErrorResult(
+        error.empty() ? "Viola could not verify that recovery key." : error));
+    return;
+  }
+  const base::DictValue *account =
+      pending_->verified_session.FindDict("account");
+  const std::string account_id =
+      account ? CleanText(account->FindString("id"), 80) : std::string();
+  bool verified = false;
+  if (const base::ListValue *snapshots = response.FindList("snapshots")) {
+    size_t count = 0;
+    for (const base::Value &candidate : *snapshots) {
+      const base::DictValue *envelope = candidate.GetIfDict();
+      if (!envelope || count++ >= 100 ||
+          CleanText(envelope->FindString("accountId"), 80) != account_id) {
+        continue;
+      }
+      std::optional<base::DictValue> payload = DecryptEnvelope(*envelope, key);
+      if (payload &&
+          CleanText(payload->FindString("accountId"), 80) == account_id) {
+        verified = true;
+        break;
+      }
+    }
+  }
+  if (!verified) {
+    std::move(callback).Run(
+        ErrorResult("That recovery key does not match this Viola account."));
+    return;
+  }
+  base::DictValue envelope;
+  if (!WrapOrUnwrapKey(true, pending_->password, nullptr, key, &envelope)) {
+    std::move(callback).Run(ErrorResult("Viola could not protect that key."));
+    return;
+  }
+  const std::string token =
+      CleanText(pending_->verified_session.FindString("token"), 100);
+  base::DictValue body;
+  body.Set("syncKeyEnvelope", std::move(envelope));
+  StartJsonRequest("PUT", "/v1/account/sync-key-envelope", token,
+                   std::move(body),
+                   base::BindOnce(&ViolaAccountSyncService::OnLegacyKeyUpdated,
+                                  weak_factory_.GetWeakPtr(),
+                                  std::move(callback), std::move(key)));
+}
+
+void ViolaAccountSyncService::ResetPendingLegacySync(ResultCallback callback) {
+  if (!pending_ || pending_->verified_session.empty()) {
+    std::move(callback).Run(
+        ErrorResult("Verify your account again before resetting sync."));
+    return;
+  }
+  std::vector<uint8_t> key = base::RandBytesAsVector(32);
+  base::DictValue envelope;
+  if (!WrapOrUnwrapKey(true, pending_->password, nullptr, key, &envelope)) {
+    std::move(callback).Run(
+        ErrorResult("Viola could not create a fresh encrypted sync key."));
+    return;
+  }
+  const std::string token =
+      CleanText(pending_->verified_session.FindString("token"), 100);
+  base::DictValue body;
+  body.Set("syncKeyEnvelope", std::move(envelope));
+  StartJsonRequest("POST", "/v1/account/sync-key-reset", token, std::move(body),
+                   base::BindOnce(&ViolaAccountSyncService::OnLegacyKeyUpdated,
+                                  weak_factory_.GetWeakPtr(),
+                                  std::move(callback), std::move(key)));
+}
+
+void ViolaAccountSyncService::OnLegacyKeyUpdated(ResultCallback callback,
+                                                 std::vector<uint8_t> key,
+                                                 bool success,
+                                                 base::DictValue response,
+                                                 std::string error) {
+  if (!success) {
+    std::move(callback).Run(ErrorResult(
+        error.empty() ? "Could not update encrypted sync." : error));
+    return;
+  }
+  std::move(callback).Run(FinishEnrollment(key));
+}
+
+base::DictValue
+ViolaAccountSyncService::FinishEnrollment(base::span<const uint8_t> key) {
+  if (!pending_) {
+    return ErrorResult("Email enrollment is no longer available.");
+  }
+  const base::DictValue &session = pending_->verified_session;
+  const base::DictValue *account = session.FindDict("account");
+  const base::DictValue *session_device = session.FindDict("device");
+  const std::string token = CleanText(session.FindString("token"), 100);
+  const std::string account_id =
+      account ? CleanText(account->FindString("id"), 80) : std::string();
+  const std::string display_name =
+      account ? CleanText(account->FindString("displayName"), 120)
+              : std::string();
+  const std::string email =
+      account ? base::ToLowerASCII(CleanText(account->FindString("email"), 320))
+              : std::string();
+  const std::string device_id =
+      session_device ? CleanText(session_device->FindString("id"), 80)
+                     : pending_->device_id;
+  if (key.size() != 32 || !IsBase64UrlToken(token, 43) || account_id.empty() ||
+      display_name.empty() || !IsEmail(email) || device_id.empty()) {
+    return ErrorResult("The remote enrollment is incomplete or invalid.");
+  }
+  std::optional<std::string> protected_secrets = ProtectSecrets(key, token);
+  if (!protected_secrets) {
+    return ErrorResult("Secure operating-system storage is unavailable.");
+  }
+  const std::string now = base::TimeFormatAsIso8601(base::Time::Now());
+  base::DictValue stored_account;
+  stored_account.Set("id", account_id);
+  stored_account.Set("displayName", display_name);
+  stored_account.Set("email", email);
+  const std::string created_at =
+      account ? CleanText(account->FindString("createdAt"), 40) : std::string();
+  stored_account.Set("createdAt", created_at.empty() ? now : created_at);
+  stored_account.Set("status", "connected");
+  stored_account.Set("provider", "email");
+  stored_account.Set("emailVerified", true);
+  const std::string avatar =
+      account ? CleanText(account->FindString("avatarUrl"), 2048)
+              : std::string();
+  stored_account.Set("avatarUrl",
+                     avatar.empty() ? base::Value() : base::Value(avatar));
+  base::DictValue stored_device;
+  stored_device.Set("id", device_id);
+  const std::string service_device_name =
+      session_device ? CleanText(session_device->FindString("name"), 120)
+                     : std::string();
+  stored_device.Set("name", service_device_name.empty() ? pending_->device_name
+                                                        : service_device_name);
+  stored_device.Set("platform", kPlatformId);
+  stored_device.Set("arch", kArchitectureId);
+  stored_device.Set("createdAt", now);
+  stored_device.Set("lastSeenAt", now);
+  state_.clear();
+  state_.Set("type", kStateType);
+  state_.Set("version", kStateVersion);
+  state_.Set("endpoint", kEndpoint);
+  state_.Set("account", std::move(stored_account));
+  state_.Set("device", std::move(stored_device));
+  state_.Set("installationDeviceId", device_id);
+  state_.Set("protectedSecrets", std::move(*protected_secrets));
+  state_.Set("localMutationGeneration", 0);
+  state_.Set("acknowledgedLocalMutationGeneration", 0);
+  state_.Set("updatedAt", now);
+  local_mutation_generation_ = 0;
+  acknowledged_local_mutation_generation_ = 0;
+  active_sync_local_mutation_generation_ = 0;
+  pending_upload_local_mutation_generation_ = 0;
+  local_dirty_ = false;
+  writer_claimed_ = false;
+  pending_upload_cursor_ = -1;
+  pending_.reset();
+  ScheduleWrite();
+  sync_timer_.Start(FROM_HERE, base::Milliseconds(10), this,
+                    &ViolaAccountSyncService::SyncNow);
+  base::DictValue result;
+  result.Set("ok", true);
+  result.Set("sync", Status());
+  return result;
+}
+
+base::DictValue
+ViolaAccountSyncService::UpdateIdentity(const base::DictValue &request) {
+  base::DictValue *account = state_.FindDict("account");
+  base::DictValue *device = state_.FindDict("device");
+  if (!loaded_ || !account || !device) {
+    return ErrorResult("No Viola account is connected.");
+  }
+  const std::string display_name =
+      CleanText(request.FindString("displayName"), 120);
+  const std::string device_name =
+      CleanText(request.FindString("deviceName"), 120);
+  if (display_name.empty() || device_name.empty()) {
+    return ErrorResult("Enter a name for you and this device.");
+  }
+  account->Set("displayName", display_name);
+  device->Set("name", device_name);
+  device->Set("lastSeenAt", base::TimeFormatAsIso8601(base::Time::Now()));
+  ScheduleWrite();
+  base::DictValue result;
+  result.Set("ok", true);
+  result.Set("sync", Status());
+  return result;
+}
+
+base::DictValue ViolaAccountSyncService::RemoveAccount() {
+  sync_timer_.Stop();
+  syncing_ = false;
+  sync_again_ = false;
+  writer_claimed_ = false;
+  pending_upload_cursor_ = -1;
+  local_dirty_ = false;
+  local_mutation_generation_ = 0;
+  acknowledged_local_mutation_generation_ = 0;
+  active_sync_local_mutation_generation_ = 0;
+  pending_upload_local_mutation_generation_ = 0;
+  std::string installation_device_id =
+      CleanText(state_.FindString("installationDeviceId"), 80);
+  if (installation_device_id.empty()) {
+    if (const base::DictValue *device = state_.FindDict("device")) {
+      installation_device_id = CleanText(device->FindString("id"), 80);
+    }
+  }
+  state_.clear();
+  state_.Set("type", kStateType);
+  state_.Set("version", kStateVersion);
+  state_.Set("endpoint", kEndpoint);
+  state_.Set("installationDeviceId",
+             installation_device_id.empty()
+                 ? base::Uuid::GenerateRandomV4().AsLowercaseString()
+                 : installation_device_id);
+  state_.Set("updatedAt", base::TimeFormatAsIso8601(base::Time::Now()));
+  pending_.reset();
+  loaders_.clear();
+  remote_presence_by_tab_.clear();
+  ++remote_presence_generation_;
+  ScheduleWrite();
+  base::DictValue result;
+  result.Set("ok", true);
+  result.Set("sync", Status());
+  return result;
+}
+
+void ViolaAccountSyncService::NotifyOrganizationChanged() {
+  if (!loaded_ || !state_.FindDict("account")) {
+    return;
+  }
+  ++local_mutation_generation_;
+  state_.Set("localMutationGeneration", local_mutation_generation_);
+  local_dirty_ = true;
+  ScheduleWrite();
+  if (!UnprotectSecrets()) {
+    state_.Set("connection", ProtectedTransportUnavailableConnection(
+                                 state_.FindDict("connection")));
+    ScheduleWrite();
+    return;
+  }
+  if (syncing_) {
+    sync_again_ = true;
+    return;
+  }
+  sync_timer_.Start(FROM_HERE, base::Milliseconds(100), this,
+                    &ViolaAccountSyncService::SyncNow);
+}
