+  ASSERT_EQ(GURL("chrome://viola/settings.html"),
+            active->GetLastCommittedURL());
+
+  {
+    content::TestNavigationObserver accessibility_observer(active);
+    EXPECT_TRUE(content::EvalJs(active, R"(
+      vela.send('browser:openPage', {page: 'accessibility'});
+      true;
+    )")
+                    .ExtractBool());
+    accessibility_observer.Wait();
+  }
+  ASSERT_EQ(chrome::GetSettingsUrl("accessibility"),
+            active->GetLastCommittedURL());
+  EXPECT_TRUE(content::EvalJs(active, R"(
+    new Promise((resolve) => {
+      const deadline = performance.now() + 5000;
+      const check = () => {
+        const roots = [document];
+        for (let i = 0; i < roots.length; ++i) {
+          for (const node of roots[i].querySelectorAll('*')) {
+            if (node.shadowRoot && !roots.includes(node.shadowRoot)) {
+              roots.push(node.shadowRoot);
+            }
+          }
+        }
+        const section = roots.map((root) =>
+          root.querySelector('settings-section')).find(Boolean);
+        const card = section?.shadowRoot?.querySelector('#card');
+        const title = section?.shadowRoot?.querySelector('#title');
+        const cardStyle = card ? getComputedStyle(card) : null;
+        const titleStyle = title ? getComputedStyle(title) : null;
+        const hiddenVendorRows = roots
+          .map((root) => root.host)
+          .filter((host) => ['Live Translate', 'Add accessibility features']
+            .includes(host?.getAttribute?.('label')));
+        if (document.documentElement.dataset.violaThemed === 'true' &&
+            document.querySelector('#viola-engine-settings-rail') &&
+            cardStyle?.borderRadius === '12px' &&
+            cardStyle?.backgroundColor === 'rgb(255, 255, 255)' &&
+            cardStyle?.boxShadow.includes('rgba(17, 15, 29') &&
+            cardStyle?.boxShadow.includes('16px') &&
+            titleStyle?.fontSize === '21px' &&
+            hiddenVendorRows.length === 2 &&
+            hiddenVendorRows.every((row) =>
+              getComputedStyle(row).display === 'none')) {
+          resolve(true);
+        } else if (performance.now() >= deadline) {
+          resolve(false);
+        } else {
+          setTimeout(check, 20);
+        }
+      };
+      check();
+    })
+  )")
+                  .ExtractBool());
+
+  // A new component root created during an internal SPA transition must get
+  // the Viola primitive sheet in the microtask checkpoint before rAF paints.
+  EXPECT_TRUE(content::EvalJs(active, R"(
+    (async () => {
+      const probe = document.createElement('div');
+      const root = probe.attachShadow({mode: 'open'});
+      const card = document.createElement('div');
+      card.className = 'card';
+      root.appendChild(card);
+      document.body.appendChild(probe);
+      await new Promise((resolve) => requestAnimationFrame(resolve));
+      const style = getComputedStyle(card);
+      const passed = root.querySelector('#viola-browser-tool-theme') !== null &&
+        style.borderRadius === '12px' &&
+        style.backgroundColor === 'rgb(255, 255, 255)';
+      probe.remove();
+      return passed;
+    })()
+  )")
+                  .ExtractBool());
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                           chrome::GetSettingsUrl("content")));
+  EXPECT_TRUE(content::EvalJs(active, R"(
+    new Promise((resolve) => {
+      const deadline = performance.now() + 5000;
+      const check = () => {
+        const roots = [document];
+        for (let i = 0; i < roots.length; ++i) {
+          for (const node of roots[i].querySelectorAll('*')) {
+            if (node.shadowRoot && !roots.includes(node.shadowRoot)) {
+              roots.push(node.shadowRoot);
+            }
+          }
+        }
+        const subpage = roots.map((root) =>
+          root.querySelector('settings-subpage')).find(Boolean);
+        const hostStyle = subpage ? getComputedStyle(subpage) : null;
+        const titleStyle = subpage?.shadowRoot?.querySelector('h1') ?
+          getComputedStyle(subpage.shadowRoot.querySelector('h1')) : null;
+        if (document.documentElement.dataset.violaThemed === 'true' &&
+            document.querySelector('#viola-engine-settings-rail') &&
+            hostStyle?.backgroundColor === 'rgba(0, 0, 0, 0)' &&
+            hostStyle?.boxShadow === 'none' &&
+            titleStyle?.fontSize === '21px') {
+          resolve(true);
+        } else if (performance.now() >= deadline) {
+          resolve(false);
+        } else {
+          setTimeout(check, 20);
+        }
+      };
+      check();
+    })
+  )")
+                  .ExtractBool());
+
+  // Every engine-owned route that Viola exposes must satisfy the same exact
+  // primitive contract. A themed outer frame is insufficient: recurse into
+  // every open component root and reject stock chrome, vendor copy, or a
+  // visible card that does not use the Viola canvas/radius/shadow tokens.
+  const auto expect_exact_viola_surface = [&]() {
+    EXPECT_TRUE(content::EvalJs(active, R"(
+      new Promise((resolve) => {
+        const deadline = performance.now() + 5000;
+        const check = () => {
+          const roots = [document];
+          for (let i = 0; i < roots.length; ++i) {
+            for (const node of roots[i].querySelectorAll('*')) {
+              if (node.shadowRoot && !roots.includes(node.shadowRoot)) {
+                roots.push(node.shadowRoot);
+              }
+            }
+          }
+          const visible = (element) => {
+            if (!element) return false;
+            const style = getComputedStyle(element);
+            const bounds = element.getBoundingClientRect();
+            return style.display !== 'none' && style.visibility !== 'hidden' &&
+              Number(style.opacity || 1) !== 0 && bounds.width > 0 && bounds.height > 0;
+          };
+          const queryAll = (selector) => roots.flatMap((root) =>
+            [...root.querySelectorAll(selector)]);
+          const stockChrome = queryAll(
+            'cr-toolbar, settings-menu, cr-drawer, extensions-toolbar, ' +
+            'password-manager-toolbar, password-manager-side-bar, #toolbar, #sidebar')
+              .some(visible);
+          const cards = queryAll(
+            'settings-section #card, cr-card, .card, password-manager-card, ' +
+            'extensions-item, settings-radio-group, settings-site-settings-list, site-list')
+              .filter(visible);
+          const invalidCard = cards.some((card) => {
+            const style = getComputedStyle(card);
+            return style.backgroundColor !== 'rgb(255, 255, 255)' ||
+              style.borderRadius !== '12px' || style.boxShadow === 'none' ||
+              !style.boxShadow.includes('rgba(17, 15, 29');
+          });
+          const copy = [];
+          for (const root of roots) {
+            const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+            while (walker.nextNode()) {
+              const value = (walker.currentNode.nodeValue || '')
+                .replace(/\s+/g, ' ').trim();
+              const owner = walker.currentNode.parentElement;
+              if (value && owner && visible(owner)) copy.push(value);
+            }
+          }
+          const text = copy.join(' ');
+          const forbidden = [
+            'Google Chrome', 'Chromium', 'AI in Chrome', 'You and Google',
+            'Google Translate', 'Google Safe Browsing', 'Google uses less data',
+            'Google uses more data', 'Add accessibility features',
+          ].some((phrase) => text.includes(phrase));
+          const rail = document.querySelector('#viola-engine-settings-rail');
+          const railStyle = rail ? getComputedStyle(rail) : null;
+          const exactRail = rail && rail.parentElement === document.body &&
+            rail === document.body.lastElementChild && railStyle.width === '188px' &&
+            railStyle.padding === '20px 10px 12px' &&
+            ['0.5px', '1px'].includes(railStyle.borderRightWidth) &&
+            railStyle.backgroundImage.includes('linear-gradient');
+          if (document.documentElement.dataset.violaThemed === 'true' &&
+              getComputedStyle(document.body).backgroundColor === 'rgb(245, 245, 247)' &&
+              getComputedStyle(document.body).paddingLeft === '188px' && exactRail &&
+              !stockChrome && !invalidCard && !forbidden) {
+            resolve(true);
+          } else if (performance.now() >= deadline) {
+            resolve(false);
+          } else {
+            setTimeout(check, 20);
+          }
+        };
+        check();
+      })
+    )")
+                    .ExtractBool());
+  };
+
+  const GURL settings_routes[] = {
+      chrome::GetSettingsUrl("accessibility"),
+      chrome::GetSettingsUrl("privacy"),
+      chrome::GetSettingsUrl("security"),
+      chrome::GetSettingsUrl("content"),
+      chrome::GetSettingsUrl("content/notifications"),
+      chrome::GetSettingsUrl("cookies"),
+      chrome::GetSettingsUrl("clearBrowserData"),
+      chrome::GetSettingsUrl("search"),
+      chrome::GetSettingsUrl("languages"),
+  };
+  for (const GURL &route : settings_routes) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), route));
+    expect_exact_viola_surface();
+  }
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("chrome://viola/settings.html")));
+  {
+    content::TestNavigationObserver password_observer(active);
+    EXPECT_TRUE(content::EvalJs(active, R"(
+      vela.send('browser:openPage', {page: 'passwords'}); true;
+    )")
+                    .ExtractBool());
+    password_observer.Wait();
+  }
+  expect_exact_viola_surface();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("chrome://password-manager/checkup")));
+  expect_exact_viola_surface();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("chrome://password-manager/settings")));
+  expect_exact_viola_surface();
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("chrome://viola/settings.html")));
+  {
+    content::TestNavigationObserver extensions_observer(active);
+    EXPECT_TRUE(content::EvalJs(active, R"(
+      vela.send('browser:openPage', {page: 'extensionsAdvanced'}); true;
+    )")
+                    .ExtractBool());
+    extensions_observer.Wait();
+  }
+  expect_exact_viola_surface();
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return browser_view->contents_web_view()->GetVisible(); }));
+}
