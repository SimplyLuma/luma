+std::optional<gfx::Rect> ParseMenuAnchor(const base::Value &payload) {
+  if (!payload.is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue *value = payload.GetDict().FindDict("anchorRect");
+  if (!value || value->size() != 4) {
+    return std::nullopt;
+  }
+  const std::optional<double> x = value->FindDouble("x");
+  const std::optional<double> y = value->FindDouble("y");
+  const std::optional<double> width = value->FindDouble("width");
+  const std::optional<double> height = value->FindDouble("height");
+  if (!x || !y || !width || !height || *width < 1 || *height < 1 ||
+      *width > 1000 || *height > 1000) {
+    return std::nullopt;
+  }
+  return gfx::Rect(base::ClampRound<int>(*x), base::ClampRound<int>(*y),
+                   base::ClampRound<int>(*width),
+                   base::ClampRound<int>(*height));
+}
