+
+    const shown = items.slice(0, q ? 200 : historyLimit);
+    const groups = groupHistory(shown, !!q || !!domain);
+    for (const group of groups) {
+      const sec = sectionBlock(group.label, `${group.items.length} ${group.items.length === 1 ? 'page' : 'pages'}`);
+      const list = node('div','card-list');
+      group.items.forEach((item)=>list.append(historyRow(item,false)));
+      sec.append(list); main.append(sec);
+    }
+    if (!q && items.length > historyLimit) {
+      const more = node('button','load-more',`Show more history (${items.length-historyLimit} remaining)`);
+      more.addEventListener('click',()=>{historyLimit+=250;render()}); main.append(more);
+    }
+  }
+
+  function renderBookmarks() {
+    const q = query.trim().toLowerCase();
+    const items = data.bookmarks.filter((item)=>matches(item,q));
+    if (!items.length) {
+      const saveKey=vela.platform==='darwin'?'⌘D':'Ctrl+D';
