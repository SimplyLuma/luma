+void ViolaMessageHandler::UpdateSplitDragHint() {
+  split_drag_target_id_.clear();
+  split_drag_zone_.clear();
+  split_drag_hint_bounds_ = gfx::Rect();
+  viola::ViolaProductOverlayHostView *overlay = GetProductOverlayHost();
+  TabStripModel *tab_strip = GetProductTabStrip();
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  BrowserView *browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  display::Screen *screen = display::Screen::Get();
+  if (split_drag_tab_id_.empty() || !overlay || !tab_strip || !browser_view ||
+      !screen || tab_strip->active_index() == TabStripModel::kNoTab) {
+    if (overlay) {
+      overlay->ShowSplitHint(std::nullopt);
+    }
+    return;
+  }
+  const int dragged_index =
+      organization_store_->FindTabIndex(tab_strip, split_drag_tab_id_);
+  const int target_index = tab_strip->active_index();
+  if (dragged_index == TabStripModel::kNoTab || dragged_index == target_index ||
+      tab_strip->GetSplitForTab(dragged_index) ||
+      tab_strip->GetSplitForTab(target_index)) {
+    overlay->ShowSplitHint(std::nullopt);
+    return;
+  }
+  gfx::Point point = screen->GetCursorScreenPoint();
+  views::View::ConvertPointFromScreen(browser_view, &point);
+  const viola::ViolaProductShellView *shell = GetProductShellView();
+  const gfx::Rect content_bounds =
+      viola::ViolaProductShellView::GetContentBounds(
+          browser_view->GetLocalBounds(),
+          shell ? shell->sidebar_width() : viola::kSidebarWidth,
+          shell ? shell->content_top_inset() : viola::kContentInset);
+  if (!content_bounds.Contains(point)) {
+    overlay->ShowSplitHint(std::nullopt);
+    return;
+  }
+  const double x = static_cast<double>(point.x() - content_bounds.x()) /
+                   content_bounds.width();
+  const double y = static_cast<double>(point.y() - content_bounds.y()) /
+                   content_bounds.height();
+  const double nearest = std::min({x, 1.0 - x, y, 1.0 - y});
+  if (nearest > 0.3) {
+    overlay->ShowSplitHint(std::nullopt);
+    return;
+  }
+  if (nearest == x) {
+    split_drag_zone_ = "left";
+    split_drag_hint_bounds_ =
+        gfx::Rect(0, 0, content_bounds.width() / 2, content_bounds.height());
+  } else if (nearest == 1.0 - x) {
+    split_drag_zone_ = "right";
+    split_drag_hint_bounds_ =
+        gfx::Rect(content_bounds.width() / 2, 0,
+                  content_bounds.width() - content_bounds.width() / 2,
+                  content_bounds.height());
+  } else if (nearest == y) {
+    split_drag_zone_ = "top";
+    split_drag_hint_bounds_ =
+        gfx::Rect(0, 0, content_bounds.width(), content_bounds.height() / 2);
+  } else {
+    split_drag_zone_ = "bottom";
+    split_drag_hint_bounds_ =
+        gfx::Rect(0, content_bounds.height() / 2, content_bounds.width(),
+                  content_bounds.height() - content_bounds.height() / 2);
+  }
+  split_drag_target_id_ =
+      organization_store_->TabIdFor(tab_strip->GetWebContentsAt(target_index));
+  if (split_drag_target_id_.empty()) {
+    overlay->ShowSplitHint(std::nullopt);
+    return;
+  }
+  overlay->ShowSplitHint(split_drag_hint_bounds_);
+}
+
+void ViolaMessageHandler::ClearSplitDrag() {
+  split_drag_timer_.Stop();
+  split_drag_tab_id_.clear();
+  split_drag_target_id_.clear();
+  split_drag_zone_.clear();
+  split_drag_hint_bounds_ = gfx::Rect();
+  if (viola::ViolaProductOverlayHostView *overlay = GetProductOverlayHost()) {
+    overlay->ShowSplitHint(std::nullopt);
+  }
+}
