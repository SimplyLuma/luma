+
+base::ListValue ViolaAccountSyncService::BuildActiveTabPresence() const {
+  base::ListValue active_ids;
+  std::set<std::string> included;
+  ViolaOrganizationStore *store = ViolaOrganizationStore::Get(profile_);
+  if (!store || !store->loaded()) {
+    return active_ids;
+  }
+  ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+      [&](BrowserWindowInterface *candidate) {
+        TabStripModel *strip = candidate ? candidate->GetTabStripModel() : nullptr;
+        content::WebContents *contents = strip ? strip->GetActiveWebContents() : nullptr;
+        const std::string tab_id = store->TabIdFor(contents);
+        if (!tab_id.empty() && tab_id.size() <= 160 &&
+            included.insert(tab_id).second && included.size() <= 32) {
+          active_ids.Append(tab_id);
+        }
+        return included.size() < 32;
+      });
+  return active_ids;
+}
