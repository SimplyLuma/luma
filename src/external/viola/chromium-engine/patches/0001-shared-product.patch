+    actions.append(remove); row.append(actions);
+    row.addEventListener('click',()=>vela.send('library:open',{url:item.url,profileId:item.profileId}));
+    return row;
+  }
+
+  function bookmarkRow(item) {
+    const row = node('div','row bookmark-row'); row.append(favicon(item));
+    const copy = node('div','row-copy');
+    const title = node('div','title',item.title || item.url);
+    copy.append(title,node('div','meta',`${shortUrl(item.url)}${item.profileName ? ` · ${item.profileName}` : ''}`));
+    row.append(copy);
+    const actions = node('div','row-actions');
+    const rename = node('button','','Rename');
+    rename.addEventListener('click',(e)=>{e.stopPropagation();startRename(title,item)});
+    const remove = node('button','danger','Remove');
+    remove.addEventListener('click',(e)=>{e.stopPropagation();vela.send('library:removeBookmark',{id:item.id})});
+    actions.append(rename,remove); row.append(actions);
+    row.addEventListener('click',()=>vela.send('library:open',{url:item.url,profileId:item.profileId,bookmarkId:item.id}));
