+#include "chrome/browser/ui/tabs/public/tab_features.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/viola/viola_product_shell_view.h"
+#include "components/permissions/permission_request.h"
+#include "components/permissions/request_type.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+
+namespace viola {
+
+// static
+bool ViolaPermissionPrompt::CanHandle(content::WebContents *web_contents,
+                                      Delegate *delegate) {
+  if (!delegate || delegate->Requests().empty()) {
+    return false;
+  }
+  // Binary site decisions share one host-owned decision contract. Requests
+  // with a chooser, embedded element, or richer options retain upstream UI.
+  for (const auto &request : delegate->Requests()) {
+    if (!request) {
+      return false;
+    }
+    const permissions::RequestType type = request->request_type();
+    if (type != permissions::RequestType::kNotifications &&
+        type != permissions::RequestType::kGeolocation &&
+        type != permissions::RequestType::kMicStream &&
+        type != permissions::RequestType::kCameraStream) {
+      return false;
+    }
+  }
+  tabs::TabInterface *tab =
+      tabs::TabInterface::MaybeGetFromContents(web_contents);
+  BrowserWindowInterface *browser =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  BrowserView *browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  return browser_view &&
+         browser_view->viola_product_shell_view_for_testing();
+}
+
+ViolaPermissionPrompt::ViolaPermissionPrompt(
+    content::WebContents *web_contents, Delegate *delegate)
+    : delegate_(delegate),
+      id_(base::UnguessableToken::Create().ToString()) {
+  CHECK(CanHandle(web_contents, delegate));
+  AttachToProductShell(web_contents);
+}
+
+ViolaPermissionPrompt::~ViolaPermissionPrompt() {
+  if (shell_) {
+    ViolaProductShellView *shell = shell_;
+    shell_ = nullptr;
+    shell->ClearPermissionPrompt(this);
+  }
+}
+
+void ViolaPermissionPrompt::AttachToProductShell(
+    content::WebContents *web_contents) {
+  tabs::TabInterface *tab =
+      tabs::TabInterface::MaybeGetFromContents(web_contents);
+  BrowserWindowInterface *browser =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  BrowserView *browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  shell_ = browser_view
+               ? browser_view->viola_product_shell_view_for_testing()
+               : nullptr;
+  if (!shell_) {
+    return;
+  }
+
+  std::vector<std::string> fragments;
+  for (const auto &request : delegate_->Requests()) {
+    fragments.push_back(base::UTF16ToUTF8(request->GetMessageTextFragment()));
+  }
+  const std::string host(delegate_->GetRequestingOrigin().host());
+  base::DictValue state;
+  state.Set("id", id_);
+  state.Set("type", "permission");
+  state.Set("title", base::StrCat({host, " wants to"}));
+  state.Set("body", base::JoinString(fragments, " · "));
+  state.Set("host", host);
+  state.Set("icon", base::StrCat({
+                        "chrome://favicon2/?size=32&scaleFactor=1x&"
+                        "showFallbackMonogram=&pageUrl=",
+                        base::EscapeQueryParamValue(
+                            delegate_->GetRequestingOrigin().spec(),
+                            true)}));
+  state.Set("hue", 250);
+  state.Set("important", true);
+  state.Set("kept", true);
+  shell_->ShowPermissionPrompt(this, std::move(state));
+}
+
+bool ViolaPermissionPrompt::Resolve(std::string_view decision,
+                                    ViolaProductShellView *shell) {
+  if (shell_ != shell || !delegate_) {
+    return false;
+  }
+  shell_ = nullptr;
+  Delegate *delegate = delegate_;
+  if (decision == "allow") {
+    delegate->Accept(/*prompt_options=*/std::monostate());
+    return true;
+  }
+  if (decision == "block") {
+    delegate->Deny(/*prompt_options=*/std::monostate());
+    return true;
+  }
+  if (decision == "dismiss") {
+    delegate->Dismiss(/*prompt_options=*/std::monostate());
+    return true;
+  }
+  shell_ = shell;
+  return false;
+}
+
+void ViolaPermissionPrompt::DetachFromShell(ViolaProductShellView *shell) {
+  if (shell_ == shell) {
+    shell_ = nullptr;
+  }
+}
+
+bool ViolaPermissionPrompt::UpdateAnchor() {
+  return true;
+}
+
+permissions::PermissionPrompt::TabSwitchingBehavior
+ViolaPermissionPrompt::GetTabSwitchingBehavior() {
+  return TabSwitchingBehavior::kDestroyPromptButKeepRequestPending;
+}
+
+permissions::PermissionPromptDisposition
+ViolaPermissionPrompt::GetPromptDisposition() const {
+  return permissions::PermissionPromptDisposition::ANCHORED_BUBBLE;
+}
+
+bool ViolaPermissionPrompt::IsAskPrompt() const {
+  return true;
+}
+
+std::optional<gfx::Rect>
+ViolaPermissionPrompt::GetViewBoundsInScreen() const {
+  return std::nullopt;
+}
+
+bool ViolaPermissionPrompt::ShouldFinalizeRequestAfterDecided() const {
+  return true;
+}
+
+std::vector<permissions::ElementAnchoredBubbleVariant>
+ViolaPermissionPrompt::GetPromptVariants() const {
+  return {};
+}
+
+std::optional<permissions::feature_params::PermissionElementPromptPosition>
+ViolaPermissionPrompt::GetPromptPosition() const {
+  return std::nullopt;
+}
+
+}  // namespace viola
