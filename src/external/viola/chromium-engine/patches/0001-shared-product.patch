+// Profile-owned Viola account transport. Chromium's OS crypt provider protects
+// the account key and bearer token at rest; the network sees only encrypted
+// organization snapshots and the public account/session protocol.
+class ViolaAccountSyncService final
+    : public base::SupportsUserData::Data,
+      public base::ImportantFileWriter::DataSerializer {
+public:
+  using ResultCallback = base::OnceCallback<void(base::DictValue)>;
+
+  static ViolaAccountSyncService *Get(Profile *profile);
+  static bool HasInstanceForTesting(Profile *profile);
+  static bool IsLoadedForTesting(Profile *profile);
