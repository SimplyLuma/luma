+  ViolaAccountSyncService &operator=(const ViolaAccountSyncService &) = delete;
+  ~ViolaAccountSyncService() override;
+
+  void EnsureLoaded(base::OnceClosure callback);
+  base::DictValue Status() const;
+
+  void BeginEmailSignIn(const base::DictValue &request,
+                        ResultCallback callback);
+  void VerifyEmailSignIn(const base::DictValue &request,
+                         ResultCallback callback);
+  void CompleteEmailSignIn(const base::DictValue &request,
+                           ResultCallback callback);
+  void ResetPendingLegacySync(ResultCallback callback);
+  base::DictValue UpdateIdentity(const base::DictValue &request);
+  base::DictValue RemoveAccount();
+  void NotifyOrganizationChanged();
+  std::string RemotePlatformForTab(std::string_view tab_id) const;
+  int remote_presence_generation() const {
+    return remote_presence_generation_;
+  }
+
+  // base::ImportantFileWriter::DataSerializer:
+  std::optional<std::string> SerializeData() override;
+
+  // Cross-platform known-answer seam: the production codec remains private,
+  // while browser_tests prove byte compatibility with Electron and Android.
+  static std::optional<std::vector<uint8_t>>
+  UnwrapSyncKeyForTesting(std::string_view password,
+                          const base::DictValue &envelope);
+  static std::string RecordDigestForTesting(const base::Value &value);
+  static std::optional<base::DictValue>
+  EncryptPayloadForTesting(const base::DictValue &payload,
+                           base::span<const uint8_t> key);
+  static std::optional<base::DictValue>
+  DecryptEnvelopeForTesting(const base::DictValue &envelope,
+                            base::span<const uint8_t> key);
+  static std::optional<base::DictValue>
+  NormalizeAuthenticatedRecordForTesting(const base::DictValue &record,
+                                         std::string_view fallback_device_id,
+                                         std::string_view fallback_updated_at);
+  static int CompareRecordVersionsForTesting(const base::DictValue &left,
+                                             const base::DictValue &right);
+  static base::DictValue ReconcileWorkspaceTabsForTesting(
+      const base::DictValue &winner,
+      const base::ListValue &candidate_records);
+  static base::ListValue CompactRecordsForTesting(
+      const base::ListValue &records);
+  static bool
+  OrganizationHasUserStateForTesting(const base::DictValue &organization);
+  static bool ShouldPreferLocalFirstLinkSeedForTesting(
+      bool first_link,
+      bool authenticated_server_empty,
+      bool local_has_user_state);
+  static bool PreservesOrganizationTabsForTesting(
+      const base::DictValue &expected,
+      const base::DictValue &actual);
+  static std::optional<base::DictValue>
+  MergeWorkspaceValuesForTesting(const base::DictValue &base_workspace,
+                                 const base::DictValue &local_workspace,
+                                 const base::DictValue &peer_workspace,
+                                 bool prefer_local);
+
+private:
+  struct PendingEnrollment;
+  using JsonRequestCallback =
+      base::OnceCallback<void(bool, base::DictValue, std::string)>;
+
+  explicit ViolaAccountSyncService(Profile *profile);
+  void OnEncryptorReady(scoped_refptr<os_crypt_async::Encryptor> encryptor);
+  void OnStateLoaded(base::DictValue state);
+  void FinishLoading();
+  void ScheduleWrite();
+
+  void StartJsonRequest(std::string method, std::string path, std::string token,
