+}
+
+std::optional<TabGroupContextMenuState>
+ViolaOrganizationStore::GetTabGroupContextMenuState(
+    std::string_view space_id, std::string_view group_id) const {
+  if (!loaded_) {
+    return std::nullopt;
+  }
+  const base::DictValue *group =
+      FindTabGroup(organization_, space_id, group_id);
+  if (!group) {
+    const base::DictValue *space = FindSpace(organization_, space_id);
+    const std::vector<std::string> split_ids =
+        space ? SplitLeaves(space->Find("split")) : std::vector<std::string>();
+    if (!space || group_id != "split:" + std::string(space_id) ||
+        split_ids.size() < 2) {
+      return std::nullopt;
+    }
+    TabGroupContextMenuState result;
+    result.group_id = std::string(group_id);
+    result.space_id = std::string(space_id);
+    result.section =
+        IsLogicalPinned(organization_, split_ids.front()) ? "pinned" : "today";
+    result.tab_ids = split_ids;
+    result.keep_expanded = space->FindBool("splitKeepExpanded").value_or(false);
+    result.saved = true;
+    result.split = true;
+    result.saved_tab_count = split_ids.size();
+    return result;
+  }
+  TabGroupContextMenuState result;
+  result.group_id = std::string(group_id);
+  result.space_id = std::string(space_id);
+  result.section = StringOr(group, "section") == "pinned" ? "pinned" : "today";
+  result.keep_expanded = group->FindBool("keepExpanded").value_or(false);
+  result.saved = group->FindBool("saved").value_or(false);
+  result.split = false;
+  result.saved_tab_count = group->FindList("savedTabs")->size();
+  for (const base::Value &id : *group->FindList("tabIds")) {
+    if (!id.is_string()) {
+      return std::nullopt;
+    }
+    result.tab_ids.push_back(id.GetString());
+  }
+
+  std::string profile_id;
+  for (const base::Value &space_value : *organization_.FindList("spaces")) {
+    const base::DictValue &space = space_value.GetDict();
+    if (StringOr(&space, "id") == space_id) {
+      profile_id = StringOr(&space, "profileId");
+      break;
+    }
+  }
+  if (profile_id.empty()) {
+    return std::nullopt;
+  }
+  for (const base::Value &space_value : *organization_.FindList("spaces")) {
+    const base::DictValue &space = space_value.GetDict();
+    const std::string candidate_id = StringOr(&space, "id");
+    if (StringOr(&space, "profileId") != profile_id ||
+        candidate_id == space_id) {
+      continue;
+    }
+    result.workspace_targets.push_back(
+        {.id = candidate_id,
+         .label = StringOr(&space, "icon") + " " + StringOr(&space, "name")});
+  }
+  return result;
+}
+
+void ViolaOrganizationStore::AppendRenderState(base::DictValue &state,
+                                               TabStripModel *tab_strip) {
+  if (!loaded_ || !tab_strip) {
+    return;
+  }
+  Reconcile(tab_strip);
+  const std::string active_space_id = StringOr(&organization_, "activeSpaceId");
+  const bool all = workspace_lens_id_ == kAllWorkspacesId;
+  const base::DictValue *active_space =
+      FindSpace(organization_, active_space_id);
+  if (!active_space) {
+    return;
+  }
+
+  base::DictValue settings = organization_.FindDict("settings")->Clone();
+  state.Set("settings", std::move(settings));
+
+  base::ListValue themes;
+  for (const ThemeData &theme : kThemes) {
+    themes.Append(ThemeValue(theme.key));
+  }
+  state.Set("themes", std::move(themes));
+
+  base::ListValue profiles;
+  std::map<std::string, std::string> profile_names;
+  for (const base::Value &profile_value : *organization_.FindList("profiles")) {
+    const base::DictValue &profile = profile_value.GetDict();
+    base::DictValue item;
+    item.Set("id", *profile.FindString("id"));
+    item.Set("name", *profile.FindString("name"));
+    profile_names[*profile.FindString("id")] = *profile.FindString("name");
+    profiles.Append(std::move(item));
+  }
+  state.Set("profiles", std::move(profiles));
+
+  base::ListValue spaces;
+  base::ListValue scopes;
+  base::DictValue all_scope;
+  all_scope.Set("id", kAllWorkspacesId);
+  all_scope.Set("name", "All Workspaces");
+  all_scope.Set("icon", "🌐");
+  all_scope.Set("theme", StringOr(organization_.FindDict("settings"),
+                                  "allWorkspacesTheme", "aurora"));
+  all_scope.Set("profileId", base::Value());
+  all_scope.Set("profileName", "Every workspace");
+  all_scope.Set("isAll", true);
+  scopes.Append(std::move(all_scope));
+  for (const base::Value &space_value : *organization_.FindList("spaces")) {
+    const base::DictValue &space = space_value.GetDict();
+    base::DictValue item;
+    item.Set("id", *space.FindString("id"));
+    item.Set("name", *space.FindString("name"));
+    item.Set("icon", *space.FindString("icon"));
+    item.Set("theme", *space.FindString("theme"));
+    item.Set("profileId", *space.FindString("profileId"));
+    item.Set("profileName", profile_names[*space.FindString("profileId")]);
+    spaces.Append(item.Clone());
+    item.Set("isAll", false);
+    scopes.Append(std::move(item));
+  }
+  state.Set("spaces", std::move(spaces));
+  state.Set("workspaceScopes", std::move(scopes));
+  state.Set("workspaceLensId", workspace_lens_id_);
+  state.Set("isAllWorkspaces", all);
+  state.Set("collapsedWorkspaceSections", base::ListValue());
+  state.Set("activeSpaceId", active_space_id);
+  state.Set("workspacesEnabled", true);
+
+  content::WebContents *active_contents = tab_strip->GetActiveWebContents();
+  state.Set("activeTabId", TabIdFor(active_contents));
+
+  const std::string theme_key =
+      all ? StringOr(organization_.FindDict("settings"), "allWorkspacesTheme",
+                     "aurora")
+          : StringOr(active_space, "theme", "aurora");
+  state.Set("theme", ThemeValue(theme_key));
+  state.Set("partition", "");
+
+  base::ListValue favorites;
+  base::ListValue pinned;
+  base::ListValue today;
+  base::ListValue groups;
+  std::set<std::string> included_profiles;
+  int space_index = all ? 0 : 1;
+  int cursor = 1;
+
+  auto runtime_tab = [&](const base::DictValue &persistent,
+                         std::string_view section,
+                         const base::DictValue *source_space,
+                         const base::DictValue *source_profile) {
+    const std::string id = *persistent.FindString("id");
+    const int live_index = FindTabIndex(tab_strip, id);
+    content::WebContents *contents =
+        live_index == TabStripModel::kNoTab
+            ? nullptr
+            : tab_strip->GetWebContentsAt(live_index);
+    base::DictValue tab = persistent.Clone();
+    const std::string page_url = contents ? contents->GetVisibleURL().spec()
+                                          : StringOr(&persistent, "url");
+    tab.Set("url", page_url);
+    const GURL validated_page_url(page_url);
+    if (validated_page_url.SchemeIsHTTPOrHTTPS()) {
+      content::NavigationEntry *entry =
+          contents ? contents->GetController().GetVisibleEntry() : nullptr;
+      const content::FaviconStatus *favicon =
+          entry ? &entry->GetFavicon() : nullptr;
+      const bool has_live_favicon = favicon && favicon->valid &&
+                                    favicon->url.is_valid() &&
+                                    favicon->url.SchemeIsHTTPOrHTTPS();
+      const std::string persistent_favicon =
+          SafeFavicon(persistent.Find("favicon"));
+      // Restored metadata-only tabs may not have a Chromium favicon database
+      // row in a brand-new window. Use the synchronized icon when available,
+      // then the live NavigationEntry icon, and finally the conventional
+      // origin favicon. The latter is fetched lazily by the image element and
+      // benefits from Chromium's HTTP cache without waking the tab.
+      tab.Set("favicon",
+              !persistent_favicon.empty()
+                  ? persistent_favicon
+                  : has_live_favicon
+                        ? favicon->url.spec()
+                        : validated_page_url.DeprecatedGetOriginAsURL()
+                              .Resolve("/favicon.ico")
+                              .spec());
+    } else {
+      tab.Set("favicon", base::Value());
+    }
+    tab.Set("title", contents && IsNativeNewTab(contents->GetVisibleURL())
+                         ? "New Tab"
+                         : contents && !contents->GetTitle().empty()
+                         ? base::UTF16ToUTF8(contents->GetTitle())
+                         : StringOr(&persistent, "title"));
+    tab.Set("loading", contents && contents->IsLoading());
+    tab.Set("audible", contents && contents->IsCurrentlyAudible());
+    tab.Set("muted", contents ? contents->IsAudioMuted()
+                              : persistent.FindBool("muted").value_or(false));
+    tab.Set("tabMuted", contents && contents->IsAudioMuted());
+    tab.Set("siteMuted", "");
+    tab.Set("alive", contents != nullptr);
+    tab.Set("viewedElsewhere", false);
+    tab.Set("viewedElsewhereKind", "");
+    if (ViolaAccountSyncService *sync =
+            ViolaAccountSyncService::Get(profile_)) {
+      const std::string remote_kind = sync->RemotePlatformForTab(id);
+      if (!remote_kind.empty()) {
+        tab.Set("viewedElsewhere", true);
+        tab.Set("viewedElsewhereKind", remote_kind);
+      }
+    }
+    tab.Set("attentionDelta", 0);
+    tab.Set("attentionActivity", false);
+    tab.Set("sourceSpaceId", source_space ? StringOr(source_space, "id") : "");
+    tab.Set("sourceSpaceName",
+            source_space ? StringOr(source_space, "name") : "");
+    tab.Set("sourceSpaceIcon",
+            source_space ? StringOr(source_space, "icon") : "");
+    tab.Set("sourceProfileId",
+            source_profile ? StringOr(source_profile, "id") : "");
+    tab.Set("sourceProfileName",
+            source_profile ? StringOr(source_profile, "name") : "");
+    tab.Set(
+        "simulator",
+        StringOr(&persistent, "url").starts_with("vela://mobile-simulator"));
+    return tab;
+  };
+
+  auto append_space = [&](const base::DictValue &space) {
+    const std::string profile_id = StringOr(&space, "profileId");
+    const base::DictValue *profile = FindProfile(organization_, profile_id);
+    if (profile && included_profiles.insert(profile_id).second) {
+      for (const base::Value &tab : *profile->FindList("favorites")) {
+        favorites.Append(
+            runtime_tab(tab.GetDict(), "favorite", &space, profile));
+      }
+    }
+    for (const base::Value &tab : *space.FindList("pinned")) {
+      pinned.Append(runtime_tab(tab.GetDict(), "pinned", &space, profile));
+    }
+    for (const base::Value &tab : *space.FindList("today")) {
+      today.Append(runtime_tab(tab.GetDict(), "today", &space, profile));
+    }
+    for (const base::Value &group_value : *space.FindList("tabGroups")) {
+      const base::DictValue &persistent = group_value.GetDict();
+      base::DictValue group;
+      group.Set("id", *persistent.FindString("id"));
+      group.Set("spaceId", *space.FindString("id"));
+      group.Set("sourceSpaceName", *space.FindString("name"));
+      group.Set("sourceSpaceIcon", *space.FindString("icon"));
+      group.Set("sourceProfileId", profile_id);
+      group.Set("sourceProfileName", profile ? StringOr(profile, "name") : "");
+      group.Set("type", "tabs");
+      group.Set("title", *persistent.FindString("title"));
+      group.Set("tabIds", persistent.FindList("tabIds")->Clone());
+      group.Set("section", *persistent.FindString("section"));
+      const base::ListValue &tab_ids = *persistent.FindList("tabIds");
+      group.Set("anchorTabId",
+                tab_ids.empty() ? base::Value() : tab_ids.front().Clone());
+      group.Set("saved", persistent.FindBool("saved").value_or(false));
+      group.Set("keepExpanded",
+                persistent.FindBool("keepExpanded").value_or(false));
+      group.Set("initiallyCollapsed",
+                persistent.FindBool("collapsed").value_or(false) &&
+                    !persistent.FindBool("keepExpanded").value_or(false));
+      group.Set("savedTabCount",
+                static_cast<int>(persistent.FindList("savedTabs")->size()));
+      groups.Append(std::move(group));
+    }
+    std::vector<std::string> split_ids = SplitLeaves(space.Find("split"));
+    if (split_ids.size() > 1) {
+      base::ListValue tab_ids;
+      for (const std::string &id : split_ids) {
+        tab_ids.Append(id);
+      }
+      base::DictValue split;
+      split.Set("id", "split:" + *space.FindString("id"));
+      split.Set("spaceId", *space.FindString("id"));
+      split.Set("sourceSpaceName", *space.FindString("name"));
+      split.Set("sourceSpaceIcon", *space.FindString("icon"));
+      split.Set("sourceProfileId", profile_id);
+      split.Set("sourceProfileName", profile ? StringOr(profile, "name") : "");
+      split.Set("type", "split");
+      split.Set("title", StringOr(&space, "splitTitle", "Split Group"));
+      split.Set("tabIds", std::move(tab_ids));
+      split.Set("section", "today");
+      split.Set("anchorTabId", split_ids.front());
+      split.Set("saved", false);
+      split.Set("keepExpanded",
+                space.FindBool("splitKeepExpanded").value_or(false));
+      split.Set("initiallyCollapsed", false);
+      split.Set("savedTabCount", static_cast<int>(split_ids.size()));
+      groups.Append(std::move(split));
+    }
+  };
+
+  for (const base::Value &space_value : *organization_.FindList("spaces")) {
+    const base::DictValue &space = space_value.GetDict();
+    if (all || StringOr(&space, "id") == workspace_lens_id_) {
+      append_space(space);
+    }
+    if (!all && StringOr(&space, "id") == workspace_lens_id_) {
+      space_index = cursor;
+    }
+    ++cursor;
+  }
+  state.Set("favorites", std::move(favorites));
+  state.Set("pinned", std::move(pinned));
+  state.Set("today", std::move(today));
+  state.Set("tabGroups", std::move(groups));
+  state.Set("spaceIndex", space_index);
+}
+
+void ViolaOrganizationStore::ScheduleWrite() {
+  if (loaded_ && writer_) {
+    writer_->ScheduleWrite(this);
+    // Other native windows can display metadata-only tabs and workspace lists;
+    // those edits do not necessarily emit a TabStripModel notification. Each
+    // observer coalesces this into a read-only organization repaint.
+    if (!applying_sync_) {
+      observers_.Notify(&Observer::OnViolaOrganizationChanged);
+    }
+    if (!applying_sync_) {
+      if (ViolaAccountSyncService *sync =
+            ViolaAccountSyncService::Get(profile_)) {
+        sync->NotifyOrganizationChanged();
+      }
+    }
+  }
+}
+
+base::DictValue ViolaOrganizationStore::ExportOrganizationForSync() const {
+  if (!loaded_) {
+    return base::DictValue();
+  }
+  base::DictValue exported = organization_.Clone();
+  RemoveDeviceLocalBrowserSettings(&exported);
+  return exported;
+}
+
+// static
+std::optional<base::DictValue>
+ViolaOrganizationStore::NormalizeOrganizationForSync(
+    const base::DictValue &organization) {
+  return SanitizeOrganization(organization, true);
+}
+
+bool ViolaOrganizationStore::ApplyOrganizationFromSync(
+    const base::DictValue &organization, BrowserWindowInterface *browser,
+    TabStripModel *tab_strip) {
+  if (!loaded_ || !browser || !tab_strip ||
+      browser->GetTabStripModel() != tab_strip) {
+    return false;
+  }
+  std::optional<base::DictValue> sanitized =
+      NormalizeOrganizationForSync(organization);
+  if (!sanitized) {
+    return false;
+  }
+  base::DictValue previous_organization = organization_.Clone();
+  const base::DictValue local_browser_settings =
+      DeviceLocalBrowserSettings(organization_);
+  const std::string previous_active_tab_id =
+      TabIdFor(tab_strip->GetActiveWebContents());
+  const std::string previous_lens = workspace_lens_id_;
+  const std::string previous_active_space =
+      StringOr(&organization_, "activeSpaceId");
+  applying_sync_ = true;
+  organization_ = std::move(*sanitized);
+  RestoreDeviceLocalBrowserSettings(local_browser_settings, &organization_);
+  // Workspace selection is local presentation state, not synced structure. In
+  // particular, an authenticated pull must never throw an All Workspaces window
+  // back into Personal merely because Personal is the sender's active space.
+  workspace_lens_id_ = previous_lens == kAllWorkspacesId ||
+                               FindSpace(organization_, previous_lens)
+                           ? previous_lens
+                           : StringOr(&organization_, "activeSpaceId");
+  // The peer's active space is presentation state too. Preserve the local
+  // owner whenever that workspace survived the canonical merge so a pull
+  // cannot redirect the next local New Tab into Personal.
+  if (FindSpace(organization_, previous_active_space)) {
+    organization_.Set("activeSpaceId", previous_active_space);
+  }
+  // Remove live Chromium contents whose stable identity was explicitly closed
+  // by a peer. A tombstoned identity that still exists in another canonical
+  // workspace is a concurrent move and remains live; only identities absent
+  // from the complete merged organization are closed.
+  const std::set<std::string> removed_tab_ids = RemovedTabIds(organization_);
+  std::set<std::string> live_canonical_ids;
+  for (const base::Value &space : *organization_.FindList("spaces")) {
+    for (std::string_view section : {"pinned", "today"}) {
+      for (const base::Value &tab : *space.GetDict().FindList(section)) {
+        live_canonical_ids.insert(StringOr(&tab.GetDict(), "id"));
+      }
+    }
+  }
+  // A stable tab identity represents one logical navigation across devices.
+  // Navigate an already materialized WebContents only when the authenticated
+  // organization changed that identity's persisted URL relative to the prior
+  // local organization. Comparing the two durable values is important: an
+  // ordinary passive poll must not fight an in-flight local redirect whose
+  // observer has not committed yet. Inactive metadata-only tabs remain lazy.
+  ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+      [&](BrowserWindowInterface *candidate) {
+        TabStripModel *candidate_strip =
+            candidate ? candidate->GetTabStripModel() : nullptr;
+        if (!candidate_strip) {
+          return true;
+        }
+        for (int index = 0; index < candidate_strip->count(); ++index) {
+          content::WebContents *contents =
+              candidate_strip->GetWebContentsAt(index);
+          const std::string id = TabIdFor(contents);
+          const base::DictValue *desired =
+              FindPersistentTab(organization_, id);
+          const base::DictValue *previous =
+              FindPersistentTab(previous_organization, id);
+          if (!contents || !desired || !previous) {
+            continue;
+          }
+          const GURL desired_url(StringOr(desired, "url", "about:blank"));
+          const GURL previous_url(
+              StringOr(previous, "url", "about:blank"));
+          if (!IsSafeTabUrl(desired_url, true) ||
+              desired_url == previous_url ||
+              contents->GetVisibleURL() == desired_url) {
+            continue;
+          }
+          content::NavigationController::LoadURLParams params(
+              ProfileNavigationUrl(desired_url));
+          params.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+          contents->GetController().LoadURLWithParams(params);
+        }
+        return true;
+      });
+  if (!removed_tab_ids.empty()) {
+    materializing_ = true;
+    ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+        [&](BrowserWindowInterface *candidate) {
+          TabStripModel *candidate_strip =
+              candidate ? candidate->GetTabStripModel() : nullptr;
+          if (!candidate_strip) {
+            return true;
+          }
+          bool closed_active_tab = false;
+          for (int index = candidate_strip->count() - 1; index >= 0; --index) {
+            const std::string id =
+                TabIdFor(candidate_strip->GetWebContentsAt(index));
+            if (removed_tab_ids.contains(id) &&
+                !live_canonical_ids.contains(id)) {
+              closed_active_tab =
+                  closed_active_tab || index == candidate_strip->active_index();
+              candidate_strip->CloseWebContentsAt(index,
+                                                   TabCloseTypes::CLOSE_NONE);
+            }
+          }
+          if (closed_active_tab) {
+            AddNewTabForActiveWorkspace(candidate, candidate_strip,
+                                        GURL("about:blank"),
+                                        candidate_strip->count(),
+                                        /*foreground=*/true);
+          }
+          return true;
+        });
+    materializing_ = false;
+  }
+  ScheduleWrite();
+  ReconcileAndMaterialize(browser, tab_strip);
+  // A passive authenticated pull may materialize or reorder tabs, but it must
+  // never undo a local user activation (most visibly, a Favorite briefly
+  // opening and then snapping back). Restore the window's active identity
+  // after structural convergence when that identity still exists.
+  const int previous_active_index =
+      FindTabIndex(tab_strip, previous_active_tab_id);
+  if (previous_active_index != TabStripModel::kNoTab &&
+      previous_active_index != tab_strip->active_index()) {
+    tab_strip->ActivateTabAt(
+        previous_active_index,
+        TabStripUserGestureDetails(
+            TabStripUserGestureDetails::GestureType::kOther));
+  }
+  applying_sync_ = false;
+  // Dormant remote tabs have no WebContents and produce no tab-strip event.
+  // Invalidate every trusted Viola surface explicitly so the sidebar cannot
+  // keep rendering a pre-merge URL/order until an unrelated local action.
+  observers_.Notify(&Observer::OnViolaOrganizationChanged);
+  return true;
+}
+
+std::optional<std::string> ViolaOrganizationStore::SerializeData() {
+  const std::string serialized =
+      SerializeEnvelope(organization_, "native-runtime", "");
+  return serialized.empty() ? std::nullopt
+                            : std::optional<std::string>(serialized);
+}
+
+// static
+std::optional<base::DictValue>
+ViolaOrganizationStore::SanitizeLegacyStateForTesting(std::string_view source) {
+  if (source.size() > kMaximumOrganizationBytes) {
+    return std::nullopt;
+  }
+  return ParseOrganization(source, false);
+}
+
+} // namespace viola
