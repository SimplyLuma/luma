+
+void ApplyLumaMenuGeometry(views::MenuItemView *menu, bool root) {
+  if (!menu || !menu->HasSubmenu()) {
+    return;
+  }
+#if !BUILDFLAG(IS_LINUX)
+  return;
+#endif
+  menu->GetSubmenu()->set_minimum_preferred_width(root ? 268 : 224);
+  for (views::View *child : menu->GetSubmenu()->children()) {
+    if (!views::IsViewClass<views::MenuItemView>(child)) {
+      continue;
+    }
+    views::MenuItemView *item = views::AsViewClass<views::MenuItemView>(child);
+    item->SetMenuItemBackground(views::MenuItemView::MenuItemBackground(
+        ui::kColorMenuBackground, 10));
+    item->SetSelectedColorId(ui::kColorMenuItemBackgroundSelected);
+    ApplyLumaMenuGeometry(item, false);
+  }
+}
