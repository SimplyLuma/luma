+  transform: translateY(-4px) scale(.985);
+  transform-origin: top center;
+  transition:
+    opacity .16s ease,
+    transform .18s cubic-bezier(.22, 1, .36, 1);
+}
+#tab-hover-card[hidden] { display: none; }
+#tab-hover-card.hover-card-visible {
+  opacity: 1;
+  transform: translateY(0) scale(1);
+}
+body.dark #tab-hover-card {
+  background: color-mix(in srgb, var(--g2) 48%, rgba(24, 25, 34, .96));
+  box-shadow:
+    0 16px 36px rgba(0, 0, 0, .34),
+    0 2px 9px rgba(0, 0, 0, .2),
+    inset 0 0 0 .75px rgba(255, 255, 255, .12);
+}
+.hover-card-heading {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-width: 0;
+}
+.hover-card-art {
+  width: 34px;
+  height: 34px;
+  flex: 0 0 34px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  overflow: hidden;
+  border-radius: 9px;
+  background: color-mix(in srgb, var(--accent) 12%, rgba(255, 255, 255, .64));
+  box-shadow:
+    inset 0 0 0 .75px color-mix(in srgb, var(--ink) 10%, rgba(255, 255, 255, .5)),
+    0 1px 3px rgba(24, 17, 48, .08);
+}
+.hover-card-art img {
+  width: 21px;
+  height: 21px;
+  object-fit: contain;
+  border-radius: 5px;
+}
+.hover-card-art svg { width: 19px; height: 19px; opacity: .72; }
+.hover-card-art-letter {
+  width: 21px;
+  height: 21px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 6px;
+  color: #fff;
+  background: color-mix(in srgb, var(--accent) 82%, var(--ink));
+  font-size: 11px;
+  font-weight: 760;
+}
+.hover-card-heading-copy { flex: 1; min-width: 0; }
+.hover-card-kicker {
+  margin-bottom: 3px;
+  color: color-mix(in srgb, var(--ink) 58%, transparent);
+  font-size: 8.5px;
+  font-weight: 760;
+  letter-spacing: .72px;
+  line-height: 1;
+}
+.hover-card-title {
+  display: -webkit-box;
+  overflow: hidden;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 2;
+  font-size: 12.75px;
+  font-weight: 690;
+  line-height: 1.26;
+  letter-spacing: -.05px;
+  overflow-wrap: anywhere;
+}
+.hover-card-summary {
+  margin-top: 3px;
+  font-size: 10.5px;
+  font-weight: 560;
+  opacity: .5;
+}
+.hover-card-url {
+  margin-top: 9px;
+  padding: 7px 8px;
+  display: flex;
+  align-items: flex-start;
+  gap: 6px;
+  border-radius: 8px;
+  background: color-mix(in srgb, var(--ink) 5%, rgba(255, 255, 255, .22));
+  box-shadow: inset 0 0 0 .6px color-mix(in srgb, var(--ink) 7%, transparent);
+}
+.hover-card-url svg { width: 13px; height: 13px; flex: 0 0 13px; margin-top: 1px; opacity: .5; }
+.hover-card-url span {
+  display: -webkit-box;
+  overflow: hidden;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 2;
+  font-size: 10.5px;
+  font-weight: 500;
+  line-height: 1.3;
+  opacity: .67;
+  overflow-wrap: anywhere;
+  user-select: text;
+  -webkit-user-select: text;
+}
+.hover-card-meta {
+  margin-top: 9px;
+  padding-top: 8px;
+  display: grid;
+  gap: 6px;
+  border-top: .5px solid color-mix(in srgb, var(--ink) 12%, transparent);
+}
+.hover-card-meta-row {
+  min-width: 0;
+  display: grid;
+  grid-template-columns: 62px minmax(0, 1fr);
+  align-items: center;
+  gap: 7px;
+}
+.hover-card-meta-label {
+  font-size: 9.5px;
+  font-weight: 620;
+  opacity: .42;
+}
+.hover-card-meta-value {
+  min-width: 0;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 10.75px;
+  font-weight: 620;
+}
+.hover-card-meta-value span:last-child {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.hover-card-workspace-icon {
+  width: 18px;
+  height: 18px;
+  flex: 0 0 18px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 5px;
+  background: color-mix(in srgb, rgba(255, 255, 255, .5) 78%, var(--accent));
