+void ViolaMessageHandler::OnTabStripModelChanged(
+    TabStripModel *tab_strip_model, const TabStripModelChange &change,
+    const TabStripSelectionChange &) {
+  AttachViolaWebStoreBranding(tab_strip_model);
+  if (tab_strip_model == observed_tab_strip_) {
+    if (CurrentSurface() == "little.html") {
+      ScheduleRenderState(/*reconcile_tab_strip=*/false);
+      return;
+    }
+    NormalizeViolaHomepageTabs(tab_strip_model, organization_store_);
+    if (organization_store_ && organization_store_->loaded()) {
+      BrowserWindowInterface *browser =
+          webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+      // Browser.close / ExitIgnoreUnloadHandlers can remove tabs without
+      // setting each window's attempted-close flag. Application shutdown
+      // must preserve the shared organization for the next restore.
+      const bool closing_window =
+          browser_shutdown::IsTryingToQuit() ||
+          browser_shutdown::HasShutdownStarted() ||
+          !browser || !browser->capabilities() ||
+          browser->capabilities()->IsAttemptingToCloseBrowser();
+      if (!closing_window && change.type() == TabStripModelChange::kRemoved) {
+        for (const TabStripModelChange::RemovedTab &removed :
+             change.GetRemove()->contents) {
+          if (TabRemoveReasonUtils::WillDeleteTab(removed.remove_reason)) {
+            const std::string tab_id =
+                organization_store_->TabIdFor(removed.contents);
+            // Favorites are durable launch points. Closing their live
+            // WebContents only dematerializes the page; the ordered Favorite
+            // and its original URL remain available for the next activation.
+            if (!organization_store_->IsFavorite(tab_id)) {
+              organization_store_->RemoveTab(tab_id);
+            }
+          }
+        }
+      }
+    }
+    ScheduleRenderState(/*reconcile_tab_strip=*/true);
+    return;
+  }
+  if (std::ranges::find(peer_tab_strips_, tab_strip_model) !=
+      peer_tab_strips_.end()) {
+    ScheduleRenderState(/*reconcile_tab_strip=*/false);
+  }
+}
