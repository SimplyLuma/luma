+    }
+    const sec = sectionBlock(q ? 'Search results' : 'Saved pages',`${items.length} ${items.length === 1 ? 'bookmark' : 'bookmarks'}`);
+    const list = node('div','card-list');
+    items.forEach((item)=>list.append(bookmarkRow(item)));
