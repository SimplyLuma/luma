@@ -0,0 +1,40 @@
+(function initFavoriteGrid(root, factory) {
+  const api = factory();
+  if (typeof module !== 'undefined' && module.exports) module.exports = api;
+  else root.ViolaFavoriteGrid = api;
+})(typeof globalThis !== 'undefined' ? globalThis : this, () => {
+  // Convert the pointer's two-dimensional grid position into the insertion
+  // boundary used by the profile's one-dimensional Favorites array.
+  function insertionIndex(rects, clientX, clientY) {
+    const boxes = Array.isArray(rects) ? rects : [];
+    for (let index = 0; index < boxes.length; index += 1) {
+      const rect = boxes[index];
+      if (!rect) continue;
+      const left = Number(rect.left) || 0;
+      const top = Number(rect.top) || 0;
+      const width = Number(rect.width) || 0;
+      const height = Number(rect.height) || 0;
+      const bottom = Number.isFinite(Number(rect.bottom))
+        ? Number(rect.bottom) : top + height;
+      if (clientY < top) return index;
+      if (clientY <= bottom && clientX < left + width / 2) return index;
+    }
+    return boxes.length;
+  }
+
+  // Favorites are persisted per profile even when All Workspaces renders
+  // several profiles into one grid. Translate a visible same-profile boundary
+  // back into that profile's local array without moving a tile across an
+  // identity/session boundary.
+  function storageInsertionIndex(entries, profileId, beforeId, removedIds = []) {
+    const removed = new Set(removedIds);
+    const local = (Array.isArray(entries) ? entries : []).filter((entry) => (
+      entry && entry.sourceProfileId === profileId && !removed.has(entry.id)
+    ));
+    if (!beforeId) return local.length;
+    const index = local.findIndex((entry) => entry.id === beforeId);
+    return index < 0 ? local.length : index;
+  }
+
+  return { insertionIndex, storageInsertionIndex };
+});
