+void ViolaMessageHandler::ShowApplicationMenu(const base::Value &payload) {
+  const std::optional<gfx::Rect> anchor = ParseMenuAnchor(payload);
+  if (!anchor || CurrentSurface() != "sidebar.html") {
+    return;
+  }
+  // Destroy consumers before replacing the model they retain.
+  context_menu_runner_.reset();
+  context_menu_adapter_.reset();
+  context_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  context_submenu_models_.clear();
+  context_menu_workspace_targets_.clear();
+  tab_context_menu_state_.reset();
+  tab_group_context_menu_state_.reset();
+  workspace_context_menu_id_.clear();
+  tabs_context_menu_ = false;
+  context_menu_model_->AddTitle(u"VIOLA");
+  context_menu_model_->AddItem(kAppAbout, u"About Viola");
+  context_menu_model_->AddItem(kAppSettings, u"Settings…");
+  context_menu_model_->AddSeparator(ui::SPACING_SEPARATOR);
+  context_menu_model_->AddItem(kAppNewWindow, u"New window");
+#if BUILDFLAG(IS_LINUX)
+  context_menu_model_->AddItem(kAppNewMini, u"New Mini Viola");
+  if (auto* owner = webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+      owner && owner->GetBrowserForMigrationOnly() &&
+      viola::ViolaMiniWindow::IsCompact(*owner->GetBrowserForMigrationOnly())) {
+    context_menu_model_->AddItem(kAppAdoptMini, u"Open in Viola");
+  }
+#endif
+  context_menu_model_->AddItem(kAppNewPrivateWindow, u"New private window");
+  context_menu_model_->AddSeparator(ui::SPACING_SEPARATOR);
+  context_menu_model_->AddItem(kAppRestoreTab, u"Reopen closed tab");
+  context_menu_model_->AddItem(kAppCloseWindow, u"Close window");
+  context_menu_model_->AddItem(kAppQuit, u"Quit Viola");
+  RunContextMenuModel(context_menu_model_.get(), anchor);
+}
