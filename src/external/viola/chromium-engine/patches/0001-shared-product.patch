+  }
+  function letter(item){try{return new URL(item.url).hostname.replace(/^www\./,'')[0].toUpperCase()}catch{return '•'}}
+  function sectionBlock(label,note){const sec=node('section');const head=node('div','section-head');head.append(node('h2','',label));if(note)head.append(node('span','section-note',note));sec.append(head);return sec}
