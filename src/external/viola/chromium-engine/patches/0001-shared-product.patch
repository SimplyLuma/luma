+  --luma-font-meta-size: 11px;
+  --luma-font-meta-weight: 550;
+  --luma-motion-fast: 120ms;
+  --luma-motion-normal: 200ms;
+  --luma-window: #f1f2f3;
+  --luma-content: #fbfbfa;
+  --luma-island: #ffffff;
+  --luma-menu: #f6f7f8;
+  --luma-menu-raised: #ffffff;
+  --luma-ink: #1f2937;
+  --luma-application-ink: #283038;
+  --luma-muted: #757e87;
+  --luma-faint: #9da5ad;
+  --luma-border: rgba(39, 48, 56, 0.095);
+  --luma-border-faint: rgba(42, 48, 56, 0.08);
+  --luma-shadow: rgba(25, 27, 31, 0.07);
+  --luma-passive: rgba(39, 48, 56, 0.04);
+  --luma-hover: rgba(39, 48, 56, 0.06);
+  --luma-pressed: rgba(39, 48, 56, 0.105);
+  --luma-accent: #4878b8;
+  --luma-green: #3b8967;
+  --luma-destructive: #b75048;
+  /* Viola's renderer uses the same semantic names as the accepted UI pass. */
+  --f-window: var(--luma-window);
+  --f-surface: var(--luma-content);
+  --f-island: var(--luma-island);
+  --f-menu: var(--luma-menu);
+  --f-menu-raised: var(--luma-menu-raised);
+  --f-ink: var(--luma-application-ink);
+  --f-muted: var(--luma-muted);
+  --f-line: var(--luma-border);
+  --f-fill: var(--luma-passive);
+  --f-hover: var(--luma-hover);
+  --f-sel: var(--luma-pressed);
+  --f-focus: #6989af;
+  --f-green: var(--luma-green);
+  --f-destructive: var(--luma-destructive);
+}
+
+body.dark {
