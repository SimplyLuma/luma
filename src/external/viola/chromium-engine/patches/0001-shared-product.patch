+bool ViolaOrganizationStore::SetSplitPair(std::string_view space_id,
+                                          std::string_view first_tab_id,
+                                          std::string_view second_tab_id,
+                                          std::string_view direction,
+                                          double ratio) {
+  if (!loaded_ || first_tab_id.empty() || second_tab_id.empty() ||
+      first_tab_id == second_tab_id || (direction != "h" && direction != "v") ||
+      !std::isfinite(ratio) || ratio < 0.1 || ratio > 0.9) {
+    return false;
+  }
+  base::DictValue *space = FindSpace(organization_, space_id);
+  if (!space) {
+    return false;
+  }
+  const std::string profile_id = StringOr(space, "profileId");
+  const base::DictValue *profile = FindProfile(organization_, profile_id);
+  auto belongs = [&](std::string_view tab_id) {
+    if (SpaceOwnsPersistentTab(*space, tab_id)) {
+      return true;
+    }
+    if (!profile) {
+      return false;
+    }
+    for (const base::Value &favorite : *profile->FindList("favorites")) {
+      if (StringOr(&favorite.GetDict(), "id") == tab_id) {
+        return true;
+      }
+    }
+    return false;
+  };
+  if (!belongs(first_tab_id) || !belongs(second_tab_id) ||
+      IsLogicalPinned(organization_, first_tab_id) !=
+          IsLogicalPinned(organization_, second_tab_id)) {
+    return false;
+  }
+  RemoveTabFromOrganizationGroups(organization_, first_tab_id,
+                                  /*forget_saved_snapshot=*/true);
+  RemoveTabFromOrganizationGroups(organization_, second_tab_id,
+                                  /*forget_saved_snapshot=*/true);
+  base::DictValue root;
+  root.Set("t", "split");
+  root.Set("dir", direction);
+  base::ListValue children;
+  for (std::string_view tab_id : {first_tab_id, second_tab_id}) {
+    base::DictValue leaf;
+    leaf.Set("t", "leaf");
+    leaf.Set("tabId", tab_id);
+    children.Append(std::move(leaf));
+  }
+  root.Set("kids", std::move(children));
+  base::ListValue sizes;
+  sizes.Append(ratio);
+  sizes.Append(1.0 - ratio);
+  root.Set("sizes", std::move(sizes));
+  space->Set("split", std::move(root));
+  space->Set("splitTitle", "Split Group");
+  space->Set("splitKeepExpanded", false);
+  ScheduleWrite();
+  return true;
+}
