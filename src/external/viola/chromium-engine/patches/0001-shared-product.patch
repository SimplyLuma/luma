+#if BUILDFLAG(IS_LINUX)
+void ViolaMessageHandler::ShowNativeSelectMenuProbe(
+    content::RenderFrameHost* frame,
+    mojo::PendingRemote<blink::mojom::PopupMenuClient> pending_client,
+    const gfx::Rect& bounds, int selected_item,
+    std::vector<blink::mojom::MenuItemPtr> items, bool multiple) {
+  auto client = std::make_shared<mojo::Remote<blink::mojom::PopupMenuClient>>(
+      std::move(pending_client));
+  auto* source = content::WebContents::FromRenderFrameHost(frame);
+  auto* strip = GetProductTabStrip();
+  if (!frame->IsActive() || !strip || strip->GetActiveWebContents() != source ||
+      !IsJavascriptAllowed() || CurrentSurface() != "sidebar.html" ||
+      multiple || items.empty() || items.size() > 4096) {
+    (*client)->DidCancel();
+    return;
+  }
+  CloseNativeMenuProbe();
+  native_menu_probe_nonce_ = base::UnguessableToken::Create().ToString();
+  const std::string nonce = native_menu_probe_nonce_;
+  base::ListValue rows;
+  std::vector<bool> enabled;
+  for (size_t index = 0; index < items.size(); ++index) {
+    const auto& entry = items[index];
+    const bool option = entry->type == blink::mojom::MenuItem::Type::kOption ||
+                        entry->type == blink::mojom::MenuItem::Type::kCheckableOption;
+    enabled.push_back(option && entry->enabled);
+    base::DictValue row;
+    row.Set("index", static_cast<int>(index));
+    // NativeMenu consumes Chromium mnemonic escaping. HTML option text has
+    // no mnemonics, so preserve every literal ampersand.
+    std::string label;
+    for (char c : entry->label.value_or(std::string())) {
+      label += c;
+      if (c == '&') label += '&';
+    }
+    row.Set("label", label);
+    row.Set("visible", true);
+    row.Set("enabled", static_cast<bool>(enabled.back()));
+    row.Set("checked", static_cast<int>(index) == selected_item);
+    row.Set("kind", option ? "radio" :
+        entry->type == blink::mojom::MenuItem::Type::kSeparator ? "separator" : "title");
+    rows.Append(std::move(row));
+  }
+  native_page_menu_activate_ = base::BindOnce(
+      [](base::WeakPtr<ViolaMessageHandler> owner, content::WeakDocumentPtr document,
+         std::shared_ptr<mojo::Remote<blink::mojom::PopupMenuClient>> client,
+         std::vector<bool> enabled, std::vector<size_t> path) {
+        auto* frame = document.AsRenderFrameHostIfValid();
+        auto* strip = owner ? owner->GetProductTabStrip() : nullptr;
+        if (!frame || !frame->IsActive() || !strip || path.size() != 1 ||
+            path[0] >= enabled.size() || !enabled[path[0]] ||
+            strip->GetActiveWebContents() != content::WebContents::FromRenderFrameHost(frame) ||
+            !client->is_bound()) return;
+        (*client)->DidAcceptIndices({static_cast<int32_t>(path[0])});
+        client->reset();
+      }, weak_factory_.GetWeakPtr(), frame->GetWeakDocumentPtr(), client,
+      std::move(enabled));
+  native_page_menu_close_ = base::BindOnce(
+      [](std::shared_ptr<mojo::Remote<blink::mojom::PopupMenuClient>> client) {
+        if (client->is_bound()) (*client)->DidCancel();
+        client->reset();
+      }, client);
+  client->set_disconnect_handler(base::BindOnce(
+      [](base::WeakPtr<ViolaMessageHandler> owner, std::string nonce) {
+        if (!owner || owner->native_menu_probe_nonce_ != nonce) return;
+        base::DictValue dismissed;
+        dismissed.Set("surface", "page");
+        dismissed.Set("nonce", nonce);
+        dismissed.Set("dismissed", true);
+        if (owner->IsJavascriptAllowed())
+          owner->web_ui()->CallJavascriptFunctionUnsafe("__violaNativeMenuProbe",
+              base::Value(std::move(dismissed)));
+        owner->CloseNativeMenuProbe();
+      }, weak_factory_.GetWeakPtr(), nonce));
+  base::DictValue anchor;
+  anchor.Set("x", bounds.x());
+  anchor.Set("y", bounds.bottom());
+  base::DictValue description;
+  description.Set("nonce", nonce);
+  description.Set("surface", "page");
+  description.Set("role", "select");
+  description.Set("anchor", std::move(anchor));
+  description.Set("target_id", content::DevToolsAgentHost::GetOrCreateFor(source)->GetId());
+  description.Set("items", std::move(rows));
+  web_ui()->CallJavascriptFunctionUnsafe("__violaNativeMenuProbe",
+      base::Value(std::move(description)));
+}
+#endif
+
+bool ViolaMessageHandler::ShowNativePageMenuProbe(
+    ui::MenuModel* model, content::WebContents* source,
+    base::OnceCallback<void(std::vector<size_t>)> activate,
+    base::OnceClosure close) {
+#if BUILDFLAG(IS_LINUX)
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("viola-native-menu-probe") ||
+      CurrentSurface() != "sidebar.html" || !model || !source ||
+      !IsJavascriptAllowed()) return false;
+  CloseNativeMenuProbe();
+  native_menu_probe_nonce_ = base::UnguessableToken::Create().ToString();
+  native_page_menu_activate_ = std::move(activate);
+  native_page_menu_close_ = std::move(close);
+  base::DictValue description;
+  description.Set("nonce", native_menu_probe_nonce_);
+  description.Set("surface", "page");
+  description.Set("target_id", content::DevToolsAgentHost::GetOrCreateFor(source)->GetId());
+  description.Set("items", DescribeNativeMenuProbe(model));
+  web_ui()->CallJavascriptFunctionUnsafe("__violaNativeMenuProbe", base::Value(std::move(description)));
+  return true;
+#else
+  return false;
+#endif
+}
