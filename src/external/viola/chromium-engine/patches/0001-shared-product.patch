+  EXPECT_TRUE(content::EvalJs(shell_contents, R"(
+    new Promise((resolve) => {
+      const deadline = performance.now() + 5000;
+      const check = () => {
+        const row = document.querySelector('#today-list .tab.active');
+        if (row?.querySelector('.title')?.textContent === 'ViolaStateFirst') {
+          window.__violaTrackedRow = row;
+          window.__violaTrackedId = row.dataset.tabId;
+          resolve(true);
