+
+#ifndef CHROME_BROWSER_UI_WEBUI_VIOLA_VIOLA_USAGE_TELEMETRY_H_
+#define CHROME_BROWSER_UI_WEBUI_VIOLA_VIOLA_USAGE_TELEMETRY_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/important_file_writer.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/supports_user_data.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+
+class Profile;
+
+namespace network {
+class SimpleURLLoader;
+}
+
+namespace viola {
+
+// Profile-owned, privacy-bounded first-party usage reporting. This service has
+// no dependency on tabs, URLs, titles, organization, accounts, or sync state.
+class ViolaUsageTelemetry final
+    : public base::SupportsUserData::Data,
+      public base::ImportantFileWriter::DataSerializer {
+ public:
+  static ViolaUsageTelemetry* Get(Profile* profile);
+
+  ViolaUsageTelemetry(const ViolaUsageTelemetry&) = delete;
+  ViolaUsageTelemetry& operator=(const ViolaUsageTelemetry&) = delete;
+  ~ViolaUsageTelemetry() override;
+
+  // Starts one process-lifetime launch report and the focused-minute timer.
+  // Calling Start() from additional Viola windows is deliberately idempotent.
+  void Start(std::string app_version);
+  void EnsureLoaded(base::OnceClosure callback);
+
+  bool detailed_enabled() const;
+  void SetDetailedEnabled(bool enabled);
+
+  // base::ImportantFileWriter::DataSerializer:
+  std::optional<std::string> SerializeData() override;
+
+ private:
+  struct LoadResult;
+  using RequestCallback = base::OnceCallback<void(bool)>;
+
+  explicit ViolaUsageTelemetry(Profile* profile);
+  static LoadResult LoadOnBackgroundSequence(
+      base::FilePath native_path,
+      base::FilePath legacy_reporting_path,
+      base::FilePath legacy_installation_id_path,
+      base::FilePath legacy_organization_path);
+  void OnLoaded(LoadResult result);
+  void BeginReporting();
+  void ScheduleWrite();
+  void ReconcileDetailedIdentity();
+  void PrepareAndSendBasicEvents();
+  void SendBasicEvent(std::string event, std::string event_id);
+  void SendDetailed(int launches, int active_seconds);
+  void Heartbeat();
+  bool HasFocusedActiveWindow() const;
+  base::DictValue Dimensions() const;
+  void SendPayload(base::DictValue payload, RequestCallback callback);
+  void OnRequestComplete(int request_id,
+                         RequestCallback callback,
+                         std::optional<std::string> response_body);
+  void OnBasicEventComplete(std::string event,
+                            std::string event_id,
+                            bool success);
+
+  raw_ptr<Profile> profile_;
+  base::FilePath state_path_;
+  base::FilePath legacy_reporting_path_;
+  base::FilePath legacy_installation_id_path_;
+  base::FilePath legacy_organization_path_;
+  std::unique_ptr<base::ImportantFileWriter> writer_;
+  base::DictValue state_;
+  std::vector<base::OnceClosure> loaded_callbacks_;
+  std::map<int, std::unique_ptr<network::SimpleURLLoader>> loaders_;
+  std::set<std::string> basic_events_in_flight_;
+  base::RepeatingTimer heartbeat_timer_;
+  std::string app_version_;
+  int next_request_id_ = 1;
+  bool loaded_ = false;
+  bool start_requested_ = false;
+  bool started_ = false;
+  base::WeakPtrFactory<ViolaUsageTelemetry> weak_factory_{this};
+};
+
+}  // namespace viola
+
+#endif  // CHROME_BROWSER_UI_WEBUI_VIOLA_VIOLA_USAGE_TELEMETRY_H_
