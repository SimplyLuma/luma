+namespace viola {
+class ViolaNativeFrameProbe final : public content::WebContentsObserver,
+                                   public viz::mojom::FrameSinkVideoConsumer {
+ public:
+  explicit ViolaNativeFrameProbe(Browser* browser) : browser_(browser) {
+    ConnectParentSocket();
+    Instances().push_back(this);
+    if (auto* clipboard = ui::OzonePlatform::GetInstance()->GetPlatformClipboard()) {
+      clipboard->SetDataOfferCallback(base::BindRepeating(
+          &ViolaNativeFrameProbe::SendSharedClipboard));
+    }
+    LOG(WARNING) << "VIOLA_NATIVE_FRAME_PROBE initialized (not a browser release)";
+    timer_.Start(FROM_HERE, base::Milliseconds(100), this,
+                 &ViolaNativeFrameProbe::FindActivePage);
+    cursor_timer_.Start(FROM_HERE, base::Milliseconds(16), this,
+                        &ViolaNativeFrameProbe::SendCursor);
+  }
+  ~ViolaNativeFrameProbe() override {
+    std::erase(Instances(), this);
+    if (Instances().empty()) {
+      if (auto* clipboard = ui::OzonePlatform::GetInstance()->GetPlatformClipboard())
+        clipboard->SetDataOfferCallback({});
+    }
+    Stop();
+    CloseParentSocket();
+  }
+
+ private:
+  static std::vector<ViolaNativeFrameProbe*>& Instances() {
+    static base::NoDestructor<std::vector<ViolaNativeFrameProbe*>> instances;
+    return *instances;
+  }
+  static void SendSharedClipboard(ui::ClipboardBuffer buffer,
+                                  const ui::PlatformClipboard::DataMap& data) {
+    for (auto* instance : Instances()) {
+      if (instance->frame_socket_.is_valid()) {
+        instance->SendNativeClipboard(buffer, data);
+        return;
+      }
+    }
+  }
+  bool AnnounceWindow() {
+    if (announced_) return true;
+    auto* view = BrowserView::GetBrowserViewForBrowser(browser_);
+    auto* shell = view ? view->viola_product_shell_view_for_testing() : nullptr;
+    auto* overlay = view ? view->viola_product_overlay_host_for_testing() : nullptr;
+    if (!shell || !overlay || !shell->shell_web_contents() ||
+        !overlay->overlay_web_contents() || !frame_socket_.is_valid()) return false;
+    base::DictValue metadata;
+    metadata.Set("version", 1);
+    metadata.Set("kind", "window");
+    metadata.Set("visibility_control", true);
+    metadata.Set("presentation", browser_->is_type_devtools() ? "devtools" :
+        ViolaMiniWindow::IsCompact(*browser_) ? "mini" : "browser");
+    metadata.Set("window_id", browser_->session_id().id());
+    metadata.Set("sidebar_target_id", content::DevToolsAgentHost::GetOrCreateFor(
+        shell->shell_web_contents())->GetId());
+    metadata.Set("overlay_target_id", content::DevToolsAgentHost::GetOrCreateFor(
+        overlay->overlay_web_contents())->GetId());
+    std::string json;
+    if (!base::JSONWriter::Write(metadata, &json)) return false;
+    announced_ = send(frame_socket_.get(), json.data(), json.size(),
+                      MSG_DONTWAIT | MSG_NOSIGNAL) == static_cast<ssize_t>(json.size());
+    return announced_;
+  }
+  void SendNativeClipboard(ui::ClipboardBuffer buffer,
+                           const ui::PlatformClipboard::DataMap& data_map) {
+    if (buffer != ui::ClipboardBuffer::kCopyPaste || !frame_socket_.is_valid())
+      return;
+    // Publish Chromium's completed copy payload, including page copy handlers,
+    // through GTK's real clipboard. Primary selection and clipboard reads never
+    // enter this bridge. A sealed descriptor keeps the frame socket bounded.
+    constexpr size_t kMaxClipboardBytes = 16 * 1024 * 1024;
+    constexpr std::array<std::string_view, 6> kMimeTypes = {
+        "text/plain", "text/plain;charset=utf-8", "text/html",
+        "text/rtf", "image/png", "image/svg+xml"};
+    size_t total = 0;
+    base::ListValue formats;
+    for (auto mime : kMimeTypes) {
+      auto found = data_map.find(std::string(mime));
+      if (found == data_map.end() || !found->second)
+        continue;
+      const size_t size = found->second->size();
+      if (size > kMaxClipboardBytes - total)
+        return;
+      base::DictValue format;
+      format.Set("mime", mime);
+      format.Set("offset", static_cast<int>(total));
+      format.Set("size", static_cast<int>(size));
+      formats.Append(std::move(format));
+      total += size;
+    }
+    if (formats.empty())
+      return;
+    base::ScopedFD descriptor(memfd_create(
+        "viola-clipboard", MFD_CLOEXEC | MFD_ALLOW_SEALING));
+    if (!descriptor.is_valid())
+      return;
+    for (auto mime : kMimeTypes) {
+      auto found = data_map.find(std::string(mime));
+      if (found == data_map.end() || !found->second)
+        continue;
+      auto bytes = base::span(found->second->as_vector());
+      while (!bytes.empty()) {
+        ssize_t count = write(descriptor.get(), bytes.data(), bytes.size());
+        if (count < 0 && errno == EINTR)
+          continue;
+        if (count <= 0)
+          return;
+        bytes = bytes.subspan(static_cast<size_t>(count));
+      }
+    }
+    if (fcntl(descriptor.get(), F_ADD_SEALS,
+              F_SEAL_WRITE | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL) != 0)
+      return;
+    base::DictValue metadata;
+    metadata.Set("version", 1);
+    metadata.Set("kind", "clipboard");
+    metadata.Set("size", static_cast<int>(total));
+    metadata.Set("formats", std::move(formats));
+    std::string json;
+    if (!base::JSONWriter::Write(metadata, &json) || json.size() > 4096)
+      return;
+    iovec data{json.data(), json.size()};
+    alignas(cmsghdr) uint8_t control[CMSG_SPACE(sizeof(int))]{};
+    msghdr message{};
+    message.msg_iov = &data;
+    message.msg_iovlen = 1;
+    message.msg_control = control;
+    message.msg_controllen = sizeof(control);
+    cmsghdr* rights = CMSG_FIRSTHDR(&message);
+    rights->cmsg_level = SOL_SOCKET;
+    rights->cmsg_type = SCM_RIGHTS;
+    rights->cmsg_len = CMSG_LEN(sizeof(int));
+    const int fd = descriptor.get();
+    base::span(control).subspan(CMSG_LEN(0), sizeof(int))
+        .copy_from(base::byte_span_from_ref(fd));
+    if (sendmsg(frame_socket_.get(), &message, MSG_DONTWAIT | MSG_NOSIGNAL) !=
+        static_cast<ssize_t>(json.size()))
+      LOG(WARNING) << "VIOLA native clipboard offer could not be delivered";
+  }
+
+  void ConnectParentSocket() {
+    const std::string path = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+        "viola-native-frame-socket");
+    if (path.empty()) return;
+    sockaddr_un address{};
+    if (path.size() >= sizeof(address.sun_path)) return;
+    address.sun_family = AF_UNIX;
+    std::copy(path.begin(), path.end(), address.sun_path);
+    base::ScopedFD candidate(socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC |
+                                             SOCK_NONBLOCK, 0));
+    if (!candidate.is_valid() || connect(candidate.get(),
+          reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0) return;
+    ucred peer{};
+    socklen_t length = sizeof(peer);
+    if (getsockopt(candidate.get(), SOL_SOCKET, SO_PEERCRED, &peer, &length) != 0 ||
+        peer.uid != geteuid() || peer.pid != getppid()) {
+      LOG(ERROR) << "VIOLA_NATIVE_FRAME_PROBE rejected non-parent peer";
+      return;
+    }
+    frame_socket_ = std::move(candidate);
+  }
+  void CloseParentSocket() {
+    frame_socket_.reset();
+    for (auto& [id, lease] : pending_frames_) lease->Done();
+    pending_frames_.clear();
+  }
+  void DrainFrameReleases() {
+    if (!frame_socket_.is_valid()) return;
+    for (int i = 0; i < 16; ++i) {
+      uint32_t wire_id = 0;
+      const ssize_t size = recv(frame_socket_.get(), &wire_id, sizeof(wire_id),
+                                MSG_DONTWAIT | MSG_TRUNC);
+      if (size < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return;
+      if (size < 0 && errno == EINTR) continue;
+      if (size != static_cast<ssize_t>(sizeof(wire_id))) { CloseParentSocket(); return; }
+      const uint32_t id = ntohl(wire_id);
+      // Frame IDs are positive signed ints. Reserve the top two values for
+      // visibility from the authenticated native host, never page content.
+      if (id == 0xfffffffeu || id == 0xffffffffu) {
+        host_visible_ = id == 0xffffffffu;
+        if (!host_visible_) {
+          auto* contents = web_contents();
+          Stop();
+          if (contents) contents->WasHidden();
+          cursor_timer_.Stop();
+        } else if (!cursor_timer_.IsRunning()) {
+          cursor_timer_.Start(FROM_HERE, base::Milliseconds(16), this,
+                             &ViolaNativeFrameProbe::SendCursor);
+        }
+        continue;
+      }
+      auto found = pending_frames_.find(id);
+      if (found == pending_frames_.end()) { CloseParentSocket(); return; }
+      found->second->Done();
+      pending_frames_.erase(found);
+    }
+  }
+  bool SendNativeFrame(
+      const gfx::GpuMemoryBufferHandle& handle,
+      const media::mojom::VideoFrameInfo& info,
+      const gfx::Rect& content_rect,
+      mojo::Remote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks>* lease) {
+    if (!frame_socket_.is_valid() || pending_frames_.size() >= 3) return false;
+    const auto& pixmap = handle.native_pixmap_handle();
+    if (pixmap.planes.empty() || pixmap.planes.size() > 4 ||
+        (info.pixel_format != media::PIXEL_FORMAT_ARGB &&
+         info.pixel_format != media::PIXEL_FORMAT_ABGR)) return false;
+    std::array<int, 4> fds{};
+    base::ListValue planes;
+    size_t index = 0;
+    for (const auto& plane : pixmap.planes) {
+      if (!plane.fd.is_valid()) return false;
+      fds[index++] = plane.fd.get();
+      base::DictValue metadata;
+      metadata.Set("stride", static_cast<int>(plane.stride));
+      metadata.Set("offset", base::NumberToString(plane.offset));
+      metadata.Set("size", base::NumberToString(plane.size));
+      planes.Append(std::move(metadata));
+    }
+    if (next_frame_id_ == std::numeric_limits<int>::max()) return false;
+    const int id = next_frame_id_++;
+    base::DictValue metadata;
+    metadata.Set("version", 1);
+    metadata.Set("id", id);
+    metadata.Set("window_id", browser_->session_id().id());
+    metadata.Set("target_id", capture_target_id_);
+    auto* organization = ViolaOrganizationStore::Get(browser_->profile());
+    std::string tab_id = organization && organization->loaded() && web_contents()
+                             ? organization->TabIdFor(web_contents()) : std::string();
+    if (browser_->is_type_devtools() || browser_->profile()->IsOffTheRecord()) {
+      auto* tab = browser_->tab_strip_model()->GetActiveTab();
+      tab_id = tab ? "chromium-tab-" + base::NumberToString(tab->GetHandle().raw_value())
+                   : std::string();
+    }
+    metadata.Set("tab_id", tab_id);
+    metadata.Set("width", info.coded_size.width());
+    metadata.Set("height", info.coded_size.height());
+    metadata.Set("fourcc", info.pixel_format == media::PIXEL_FORMAT_ARGB
+                               ? "AR24" : "AB24");
+    metadata.Set("modifier", base::NumberToString(pixmap.modifier));
+    metadata.Set("planes", std::move(planes));
+    metadata.Set("content_x", content_rect.x());
+    metadata.Set("content_y", content_rect.y());
+    metadata.Set("content_width", content_rect.width());
+    metadata.Set("content_height", content_rect.height());
+    std::string json;
+    if (!base::JSONWriter::Write(metadata, &json)) return false;
+    iovec data{json.data(), json.size()};
+    alignas(cmsghdr) uint8_t control[CMSG_SPACE(sizeof(int) * 4)]{};
+    msghdr message{};
+    message.msg_iov = &data;
+    message.msg_iovlen = 1;
+    message.msg_control = control;
+    message.msg_controllen = CMSG_SPACE(sizeof(int) * index);
+    cmsghdr* rights = CMSG_FIRSTHDR(&message);
+    rights->cmsg_level = SOL_SOCKET;
+    rights->cmsg_type = SCM_RIGHTS;
+    rights->cmsg_len = CMSG_LEN(sizeof(int) * index);
+    base::span(control).subspan(CMSG_LEN(0), sizeof(int) * index)
+        .copy_from(base::as_byte_span(fds).first(sizeof(int) * index));
+    if (sendmsg(frame_socket_.get(), &message, MSG_DONTWAIT | MSG_NOSIGNAL) !=
+        static_cast<ssize_t>(json.size())) return false;
+    pending_frames_.emplace(id, std::move(*lease));
+    return true;
+  }
+  void Stop() {
+    capturer_.reset();
+    capture_lease_.RunAndReset();
+    Observe(nullptr);
+  }
+  void SendCursor() {
+    auto* contents = browser_->tab_strip_model()->GetActiveWebContents();
+    auto* view = contents ? contents->GetRenderWidgetHostView() : nullptr;
+    if (!view || !frame_socket_.is_valid() || !announced_) return;
+    const int cursor = static_cast<int>(
+        static_cast<content::RenderWidgetHostViewAura*>(view)->GetCursor(gfx::Point()).type());
+    const std::string target = content::DevToolsAgentHost::GetOrCreateFor(contents)->GetId();
+    if (cursor == last_cursor_ && target == last_cursor_target_) return;
+    base::DictValue metadata;
+    metadata.Set("version", 1);
+    metadata.Set("kind", "cursor");
+    metadata.Set("window_id", browser_->session_id().id());
+    metadata.Set("target_id", target);
+    metadata.Set("cursor", cursor);
+    std::string json;
+    if (!base::JSONWriter::Write(metadata, &json)) return;
+    if (send(frame_socket_.get(), json.data(), json.size(), MSG_DONTWAIT | MSG_NOSIGNAL) ==
+        static_cast<ssize_t>(json.size())) {
+      last_cursor_ = cursor;
+      last_cursor_target_ = target;
+    }
+  }
+  void FindActivePage() {
+    DrainFrameReleases();
+    if (!AnnounceWindow()) return;
+    auto* contents = browser_->tab_strip_model()->GetActiveWebContents();
+    if (!contents || !contents->GetRenderWidgetHostView()) return;
+    if (!host_visible_) {
+      if (contents->GetVisibility() != content::Visibility::HIDDEN)
+        contents->WasHidden();
+      return;
+    }
+    if (contents == web_contents() && capturer_) return;
+    Stop();
+    Observe(contents);
+    contents->WasShown();
+    auto* view = contents->GetRenderWidgetHostView();
+    capture_target_id_ = content::DevToolsAgentHost::GetOrCreateFor(contents)->GetId();
+    capture_lease_ = contents->IncrementCapturerCount(
+        gfx::Size(), false, false, false);
+    capturer_ = view->CreateVideoCapturer();
+    if (!capturer_) {
+      LOG(ERROR) << "VIOLA_NATIVE_FRAME_PROBE no capturer";
+      Stop();
+      return;
+    }
+    capturer_->SetAutoThrottlingEnabled(false);
+    capturer_->SetFormat(media::PIXEL_FORMAT_ARGB);
+    // The private display runs at 60 Hz, but its capture timestamps can jitter
+    // around a refresh boundary. A 16 ms gate can discard a valid adjacent
+    // frame. Allow every display frame; the three-lease budget stays bounded.
+    capturer_->SetMinCapturePeriod(base::Milliseconds(8));
+    capturer_->SetMinSizeChangePeriod(base::TimeDelta());
+    capturer_->SetResolutionConstraints(gfx::Size(1, 1),
+                                        gfx::Size(5120, 3200), false);
+    capturer_->Start(
+        this, viz::mojom::BufferFormatPreference::kPreferMappableSharedImage);
+    capturer_->RequestRefreshFrame();
+    LOG(WARNING) << "VIOLA_NATIVE_FRAME_PROBE started shared-image capture";
+  }
+  void WebContentsDestroyed() override { Stop(); }
+  void PrimaryPageChanged(content::Page&) override {
+    // Follow committed primary pages, including history-cache restoration and
+    // prerender activation. Frame-host swaps alone do not cover that lifetime
+    // boundary; embedded frames must never reset this root-page capture.
+    capturer_.reset();
+    capture_lease_.RunAndReset();
+  }
+  void OnFrameCaptured(
+      media::mojom::VideoBufferHandlePtr data,
+      media::mojom::VideoFrameInfoPtr info,
+      const gfx::Rect& content_rect,
+      mojo::PendingRemote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks>
+          callbacks) override {
+    mojo::Remote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks> done(
+        std::move(callbacks));
+    if (frames_++ < 12) {
+      if (data->is_gpu_memory_buffer_handle()) {
+        const auto& handle = data->get_gpu_memory_buffer_handle();
+        const auto& pixmap = handle.native_pixmap_handle();
+        LOG(WARNING) << "VIOLA_NATIVE_FRAME_PROBE dmabuf planes="
+                     << pixmap.planes.size() << " modifier=" << pixmap.modifier
+                     << " size=" << info->coded_size.ToString()
+                     << " content=" << content_rect.ToString()
+                     << " format=" << info->pixel_format;
+      } else {
+        LOG(ERROR) << "VIOLA_NATIVE_FRAME_PROBE no native buffer; tag="
+                   << static_cast<int>(data->which());
+      }
+    }
+    DrainFrameReleases();
+    if (host_visible_ && data->is_gpu_memory_buffer_handle() &&
+        SendNativeFrame(data->get_gpu_memory_buffer_handle(), *info,
+                        content_rect, &done)) return;
+    done->Done();
+  }
+  void OnNewCaptureVersion(const media::CaptureVersion&) override {}
+  void OnFrameWithEmptyRegionCapture() override {}
+  void OnStopped() override {
+    LOG(WARNING) << "VIOLA_NATIVE_FRAME_PROBE stopped";
+  }
+  void OnLog(const std::string& message) override {
+    LOG(WARNING) << "VIOLA_NATIVE_FRAME_PROBE " << message;
+  }
+  const raw_ptr<Browser> browser_;
+  base::RepeatingTimer timer_;
+  base::RepeatingTimer cursor_timer_;
+  bool host_visible_ = true;
+  bool announced_ = false;
+  int last_cursor_ = -99;
+  std::string last_cursor_target_;
+  base::ScopedClosureRunner capture_lease_;
+  std::unique_ptr<viz::ClientFrameSinkVideoCapturer> capturer_;
+  int frames_ = 0;
+  int next_frame_id_ = 1;
+  std::string capture_target_id_;
+  base::ScopedFD frame_socket_;
+  std::map<int, mojo::Remote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks>>
+      pending_frames_;
+};
+}  // namespace viola
