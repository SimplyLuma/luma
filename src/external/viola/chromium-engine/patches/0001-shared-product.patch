diff --git a/chrome/browser/resources/viola/window-chrome.js b/chrome/browser/resources/viola/window-chrome.js
new file mode 100644
index 0000000000000000000000000000000000000000..e58128061a906b349463a7f101ec5d0a60387dff
--- /dev/null
+++ b/chrome/browser/resources/viola/window-chrome.js
@@ -0,0 +1,29 @@
+document.body.classList.add(`platform-${vela.platform}`);
+
+const send = (action) => vela.send('window:control', { action });
+const bindCaptionAction = (selector, action) => {
+  document.querySelector(selector).addEventListener('pointerdown', (event) => {
+    if (event.button !== 0) return;
+    // Frameless Windows/Linux compositors can move or retire this small child
+    // surface before mouseup. Commit the native action on the initial press so
+    // the command never depends on a later synthetic click reaching the view.
+    event.preventDefault();
+    event.stopPropagation();
+    send(action);
+  });
+};
+bindCaptionAction('#close', 'close');
+bindCaptionAction('#minimize', 'minimize');
+bindCaptionAction('#maximize', 'maximize');
+
+vela.on('window:chromeState', (state = {}) => {
+  if (typeof state.ink === 'string' && state.ink) {
+    document.documentElement.style.setProperty('--caption-ink', state.ink);
+  }
+  document.body.classList.toggle('inactive', !state.focused);
+  document.body.classList.toggle('maximized', !!state.maximized);
+  const maximize = document.querySelector('#maximize');
+  const restoring = !!state.maximized;
+  maximize.title = restoring ? 'Restore' : 'Maximize';
+  maximize.setAttribute('aria-label', maximize.title);
+});
