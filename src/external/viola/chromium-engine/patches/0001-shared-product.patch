+std::optional<base::DictValue> ParseOrganization(std::string_view source,
+                                                 bool native_state) {
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(source, base::JSON_PARSE_RFC);
+  const base::DictValue *root = parsed ? parsed->GetIfDict() : nullptr;
+  if (!root) {
+    return std::nullopt;
+  }
+  if (native_state) {
+    if (StringOr(root, "type") != "viola-native-organization" ||
+        root->FindInt("version").value_or(0) != 1) {
+      return std::nullopt;
+    }
+    const base::DictValue *organization = root->FindDict("organization");
+    return organization ? SanitizeOrganization(*organization, true)
+                        : std::nullopt;
+  }
+  return SanitizeOrganization(*root, false);
+}
+
+std::string SerializeEnvelope(const base::DictValue &organization,
+                              std::string_view source_kind,
+                              std::string_view source_sha256) {
+  base::DictValue source;
+  source.Set("kind", source_kind);
+  source.Set("sha256", source_sha256);
+  base::DictValue envelope;
+  envelope.Set("type", "viola-native-organization");
+  envelope.Set("version", 1);
+  envelope.Set(
+      "updatedAtMilliseconds",
+      static_cast<double>(base::Time::Now().InMillisecondsSinceUnixEpoch()));
+  envelope.Set("source", std::move(source));
+  envelope.Set("organization", organization.Clone());
+  std::string json;
+  if (!base::JSONWriter::WriteWithOptions(
+          envelope, base::JSONWriter::OPTIONS_PRETTY_PRINT, &json)) {
+    return {};
+  }
+  json.push_back('\n');
+  return json;
+}
