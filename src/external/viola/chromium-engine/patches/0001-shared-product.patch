+                                weak_factory_.GetWeakPtr(), *space_id,
+                                workspace_header.value_or(false)));
+}
+
+void ViolaMessageHandler::HandleTabsSelectionAction(
+    const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 2 ||
+      !organization_store_ || !organization_store_->loaded()) {
+    return;
+  }
+  const std::string *action = payload.GetDict().FindString("action");
+  const base::ListValue *requested_ids =
+      payload.GetDict().FindList("tabIds");
+  if (!action || !requested_ids || requested_ids->empty() ||
+      requested_ids->size() > 100 ||
+      (*action != "close" && *action != "group" && *action != "split")) {
+    return;
+  }
+  std::vector<std::string> tab_ids;
+  std::set<std::string> unique;
+  std::string space_id;
+  std::string section;
+  for (const base::Value &value : *requested_ids) {
+    const std::string *tab_id = value.GetIfString();
+    const std::optional<viola::TabContextMenuState> state =
+        tab_id ? organization_store_->GetTabContextMenuState(*tab_id)
+               : std::nullopt;
+    if (!tab_id || tab_id->empty() || !unique.insert(*tab_id).second ||
+        !state) {
+      return;
+    }
+    if (space_id.empty()) {
+      space_id = state->space_id;
+      section = state->section;
+    } else if (*action != "close" &&
+               (space_id != state->space_id || section != state->section)) {
+      return;
+    }
+    tab_ids.push_back(*tab_id);
+  }
+  TabStripModel *tab_strip = GetProductTabStrip();
+  if (!tab_strip || tab_strip != observed_tab_strip_) {
+    return;
+  }
+  if (*action == "close") {
+    for (const std::string &tab_id : tab_ids) {
+      base::DictValue request;
+      request.Set("tabId", tab_id);
+      HandleTabClose(base::Value(std::move(request)));
+    }
+    SendRenderState();
+    return;
+  }
+  if (tab_ids.size() < 2 || section == "favorite") {
+    return;
+  }
+  if (*action == "group") {
+    if (organization_store_->CreateTabGroup(tab_ids, space_id)) {
+      SendRenderState();
+    }
+    return;
+  }
+  if (tab_ids.size() != 2) {
+    return;
+  }
+  const int second_index =
+      organization_store_->FindTabIndex(tab_strip, tab_ids[1]);
+  if (second_index == TabStripModel::kNoTab) {
+    return;
+  }
+  tab_strip->ActivateTabAt(
+      second_index, TabStripUserGestureDetails(
+                        TabStripUserGestureDetails::GestureType::kMouse));
+  const int first_index =
+      organization_store_->FindTabIndex(tab_strip, tab_ids[0]);
+  if (first_index == TabStripModel::kNoTab ||
+      tab_strip->GetSplitForTab(first_index) ||
+      tab_strip->GetSplitForTab(second_index)) {
+    return;
+  }
+  const split_tabs::SplitTabId split_id = tab_strip->AddToNewSplit(
+      {first_index},
+      split_tabs::SplitTabVisualData(
+          split_tabs::SplitTabLayout::kSideBySide),
+      split_tabs::SplitTabCreatedSource::kDragAndDropTab);
+  split_tabs::SplitTabData *data = tab_strip->GetSplitData(split_id);
+  if (!data || data->ListTabs().size() != 2 ||
+      !organization_store_->SetSplitPair(space_id, tab_ids[0], tab_ids[1],
+                                         "h", 0.5)) {
+    if (data) {
+      tab_strip->RemoveSplit(split_id);
+    }
+    return;
+  }
+  SendRenderState();
+}
