+base::DictValue BuildConnectionInfo(const GURL &url) {
+  base::DictValue connection;
+  const std::string_view scheme = url.scheme();
+  const bool local = url.SchemeIsFile() || url.SchemeIs("about") ||
+                     url.SchemeIs("data") || url.SchemeIs("chrome");
+  const bool local_http =
+      url.SchemeIs("http") &&
+      (url.host() == "localhost" || url.host() == "127.0.0.1" ||
+       url.host() == "[::1]" || url.host() == "::1");
+  if (url.SchemeIsCryptographic()) {
+    connection.Set("kind", "secure");
+    connection.Set("title", "Connection is secure");
+    connection.Set(
+        "detail", "Viola loaded this page over an encrypted HTTPS connection.");
+  } else if (url.SchemeIs("http") && !local_http) {
+    connection.Set("kind", "insecure");
+    connection.Set("title", "Connection is not secure");
+    connection.Set(
+        "detail",
+        "Do not enter passwords or sensitive information on this page.");
+  } else if (local || local_http) {
+    connection.Set("kind", "local");
+    connection.Set("title", "Local or browser page");
+    connection.Set("detail",
+                   "This page is local to your device or generated by Viola.");
+  } else if (!url.is_valid() || scheme.empty()) {
+    connection.Set("kind", "none");
+    connection.Set("title", "No site information");
+    connection.Set("detail",
+                   "Open a website to view its connection information.");
+  } else {
+    connection.Set("kind", "unknown");
+    connection.Set("title", "Connection information unavailable");
+    connection.Set("detail",
+                   "Viola cannot describe the connection used by this page.");
+  }
+  connection.Set("host", url.host());
+  connection.Set("origin", url.DeprecatedGetOriginAsURL().spec());
+  return connection;
+}
