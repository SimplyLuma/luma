+// static
+gfx::Rect
+ViolaProductShellView::GetContentBounds(const gfx::Rect &client_bounds,
+                                        int sidebar_width,
+                                        int top_inset,
+                                        bool fullscreen) {
+  const int bounded_width = sidebar_width <= 0
+                                ? 0
+                                : std::clamp(sidebar_width, 200, 420);
+  const int outer_inset = fullscreen ? 0 : kContentInset;
+  // Collapsing removes the sidebar column, not Viola's outer frame. Preserve
+  // the same generated 10 px gradient gutter on the newly exposed left edge,
+  // except in real fullscreen where no decorative frame may remain.
+  const int content_x = client_bounds.x() +
+#if BUILDFLAG(IS_LINUX)
+                        (bounded_width == 0 ? outer_inset
+                                            : bounded_width + outer_inset);
+#else
+                        (bounded_width == 0 ? outer_inset : bounded_width);
+#endif
+  const int content_y = client_bounds.y() +
+                        (fullscreen ? 0 : std::max(0, top_inset));
+  return gfx::Rect(
+      content_x, content_y,
+      std::max(0, client_bounds.right() - outer_inset - content_x),
+      std::max(0, client_bounds.bottom() - outer_inset - content_y));
+}
+
+bool ViolaProductShellView::browser_fullscreen() const {
+  return browser_ && browser_->window() && browser_->window()->IsFullscreen();
+}
+
+// static
+void ViolaProductShellView::SetSidebarWidthForProfile(Profile *profile,
+                                                      int sidebar_width) {
+  if (!profile) {
+    return;
+  }
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [sidebar_width](BrowserWindowInterface *browser_window) {
+        Browser *browser =
+            browser_window ? browser_window->GetBrowserForMigrationOnly()
+                           : nullptr;
+        if (!browser || browser_window->GetType() !=
+                            BrowserWindowInterface::TYPE_NORMAL ||
+            !IsEnabledFor(*browser)) {
+          return true;
+        }
+        BrowserView *browser_view =
+            BrowserView::GetBrowserViewForBrowser(browser);
+        ViolaProductShellView *shell =
+            browser_view
+                ? browser_view->viola_product_shell_view_for_testing()
+                : nullptr;
+        if (shell) {
+          shell->SetSidebarWidth(sidebar_width);
+        }
+        return true;
+      });
+}
+
+content::WebContents *ViolaProductShellView::shell_web_contents() const {
+  return contents_wrapper_->web_contents();
+}
+
+int ViolaProductShellView::sidebar_width() const {
+  if (mini_window_ || sidebar_collapsed_) {
+    return 0;
+  }
+#if BUILDFLAG(IS_LINUX)
+  // Luma's narrow-window contract is window-local. Keeping the persisted
+  // 252px preference while the renderer alone switched to 210px caused the
+  // page WebContents and trusted toolbar to overlap in snapped tiles.
+  const int window_width = GetWidget() ? GetWidget()->GetClientAreaBoundsInScreen().width()
+                                       : width();
+  if (window_width > 0 && window_width <= 720) {
+    return std::min(sidebar_width_, 210);
+  }
+#endif
+  return sidebar_width_;
+}
+
+gfx::Rect ViolaProductShellView::GetShellBounds(
+    const gfx::Rect &client_bounds) const {
+#if BUILDFLAG(IS_LINUX)
+  // The Linux shell owns the persistent titlebar and page toolbar too.
+  // Never reduce their WebContents viewport to the sidebar hover strip.
+  return client_bounds;
+#else
+  if (mini_window_ || sidebar_modal_visible_ || !sidebar_collapsed_) {
+    return client_bounds;
+  }
+  const int overlay_width = sidebar_peeked_ ? sidebar_width_ : 12;
+  return gfx::Rect(client_bounds.x(), client_bounds.y(),
+                   std::min(client_bounds.width(), overlay_width),
+                   client_bounds.height());
+#endif
+}
+
+void ViolaProductShellView::SetSidebarWidth(int sidebar_width) {
+#if BUILDFLAG(IS_LINUX)
+  // The native GTK host owns the page allocation through the viewport bridge.
+  // Persisted sidebar widths still flow through the organization store, but
+  // relaying them into the hidden Views shell resets RenderWidgetHostView bounds
+  // after the final drag and leaves capture producing the wrong-sized surface.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "viola-native-frame-probe")) {
+    return;
+  }
+#endif
+  const int bounded_width = std::clamp(sidebar_width, 200, 420);
+  if (sidebar_width_ == bounded_width) {
+    return;
+  }
+  sidebar_width_ = bounded_width;
+  if (parent()) {
+    parent()->InvalidateLayout();
+    parent()->DeprecatedLayoutImmediately();
+  }
+}
+
+void ViolaProductShellView::SetSidebarCollapsed(bool collapsed) {
+  if (sidebar_collapsed_ == collapsed) {
+    return;
+  }
+  sidebar_peek_pointer_timer_.Stop();
+  sidebar_peek_close_timer_.Stop();
+  sidebar_peeked_ = false;
+  sidebar_peek_closing_ = false;
+  sidebar_collapsed_ = collapsed;
+  if (content::WebUI *web_ui = shell_web_contents()->GetWebUI()) {
+    base::DictValue state;
+    state.Set("collapsed", collapsed);
+    web_ui->CallJavascriptFunctionUnsafe(
+        "__violaHostReceive", base::Value("sidebar:collapsed"),
+        base::Value(std::move(state)));
+  }
+  SendSidebarPeekState(false, false);
+  ApplySidebarPresentation();
+}
+
+void ViolaProductShellView::SetSidebarModalVisible(bool visible) {
+  if (sidebar_modal_visible_ == visible) {
+    return;
+  }
+  sidebar_modal_visible_ = visible;
+  ApplySidebarPresentation();
+}
+
+void ViolaProductShellView::SetSidebarPeeked(bool peeked) {
+  if (!sidebar_collapsed_) {
+    return;
+  }
+  if (!peeked) {
+    BeginSidebarPeekClose();
+    return;
+  }
+  sidebar_peek_close_timer_.Stop();
+  sidebar_peek_closing_ = false;
+  sidebar_peeked_ = true;
+  SendSidebarPeekState(true, false);
+  ApplySidebarPresentation();
+  sidebar_peek_pointer_timer_.Start(
+      FROM_HERE, base::Milliseconds(75), this,
+      &ViolaProductShellView::PollSidebarPeekPointer);
+}
+
+void ViolaProductShellView::SetFrameGradient(std::string_view first,
+                                             std::string_view second,
+                                             std::string_view third) {
+  if (!parent()) {
+    return;
+  }
+#if BUILDFLAG(IS_LINUX)
+  // Organization themes must not repaint the native frame pink when the
+  // renderer is hidden or a window is being resized.
+  const bool dark = ui::NativeTheme::GetInstanceForNativeUi()->preferred_color_scheme() ==
+      ui::NativeTheme::PreferredColorScheme::kDark;
+  first = second = third = dark ? "#21252b" : "#f1f2f3";
+#endif
+  parent()->SetBackground(std::make_unique<ViolaFrameBackground>(
+      ParseFrameColor(first, SK_ColorBLACK),
+      ParseFrameColor(second, SK_ColorBLACK),
+      ParseFrameColor(third, SK_ColorBLACK)));
+  parent()->SchedulePaint();
+}
+
+void ViolaProductShellView::ToggleSidebarCollapsed() {
+  const bool collapsed = !sidebar_collapsed_;
+  SetSidebarCollapsed(collapsed);
+}
+
+void ViolaProductShellView::CycleWorkspace(int direction) {
+  if (!shell_web_contents() || !shell_web_contents()->GetWebUI() ||
+      direction == 0) {
+    return;
+  }
+  base::DictValue payload;
+  payload.Set("direction", direction < 0 ? -1 : 1);
+  shell_web_contents()->GetWebUI()->CallJavascriptFunctionUnsafe(
+      "__violaHostReceive", base::Value("workspace:cycle"),
+      base::Value(std::move(payload)));
+}
+
+void ViolaProductShellView::ActivateFavorite(int index) {
+  if (!shell_web_contents() || !shell_web_contents()->GetWebUI() || index < 0 ||
+      index > 8) {
+    return;
+  }
+  base::DictValue payload;
+  payload.Set("index", index);
+  shell_web_contents()->GetWebUI()->CallJavascriptFunctionUnsafe(
+      "__violaHostReceive", base::Value("favorite:activateIndex"),
+      base::Value(std::move(payload)));
+}
+
+void ViolaProductShellView::ApplySidebarPresentation() {
+  BrowserView *browser_view =
+      browser_ ? BrowserView::GetBrowserViewForBrowser(browser_) : nullptr;
+  if (!browser_view || !parent()) {
+    return;
+  }
+  if (sidebar_modal_visible_) {
+    if (auto *overlay = browser_view->viola_product_overlay_host_for_testing()) {
+      parent()->ReorderChildView(overlay, parent()->children().size());
+    }
+    parent()->ReorderChildView(this, parent()->children().size());
+  } else if (sidebar_collapsed_
+#if BUILDFLAG(IS_LINUX)
+             && sidebar_peeked_
+#endif
+  ) {
+    parent()->ReorderChildView(this, parent()->children().size());
+    if (auto *overlay = browser_view->viola_product_overlay_host_for_testing()) {
+      parent()->ReorderChildView(overlay, parent()->children().size());
+    }
+  } else {
+    parent()->ReorderChildView(this, 0);
+  }
+  parent()->InvalidateLayout();
+  parent()->DeprecatedLayoutImmediately();
+  if (views::Widget *widget = GetWidget()) {
+    widget->GetRootView()->InvalidateLayout();
+    widget->LayoutRootViewIfNecessary();
+  }
+}
+
+void ViolaProductShellView::PollSidebarPeekPointer() {
+  display::Screen *screen = display::Screen::Get();
+  if (!screen || !sidebar_collapsed_ || !sidebar_peeked_ ||
+      sidebar_peek_closing_) {
+    return;
+  }
+  if (!GetBoundsInScreen().Contains(screen->GetCursorScreenPoint())) {
+    BeginSidebarPeekClose();
+  }
+}
+
+void ViolaProductShellView::BeginSidebarPeekClose() {
+  if (!sidebar_peeked_ || sidebar_peek_closing_) {
+    return;
+  }
+  sidebar_peek_pointer_timer_.Stop();
+  sidebar_peek_closing_ = true;
+  SendSidebarPeekState(true, true);
+  sidebar_peek_close_timer_.Start(
+      FROM_HERE, base::Milliseconds(150), this,
+      &ViolaProductShellView::FinishSidebarPeekClose);
+}
+
+void ViolaProductShellView::FinishSidebarPeekClose() {
+  sidebar_peeked_ = false;
+  sidebar_peek_closing_ = false;
+  SendSidebarPeekState(false, false);
+  ApplySidebarPresentation();
+}
+
+void ViolaProductShellView::SendSidebarPeekState(bool visible, bool closing) {
+  if (content::WebUI *web_ui = shell_web_contents()->GetWebUI()) {
+    base::DictValue state;
+    state.Set("visible", visible);
+    state.Set("closing", closing);
+    web_ui->CallJavascriptFunctionUnsafe(
+        "__violaHostReceive", base::Value("sidebar:peek"),
+        base::Value(std::move(state)));
+  }
+}
+
+content::WebContents *ViolaProductShellView::OpenNewTabAndShowPalette() {
+  if (!browser_) {
+    return nullptr;
+  }
+  TabStripModel *tab_strip = browser_->tab_strip_model();
+  if (!tab_strip) {
+    return nullptr;
+  }
+#if BUILDFLAG(IS_LINUX)
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "viola-native-frame-probe")) {
+    // Private tabs have no persistent organization store. Keep both their
+    // WebContents and handle-based sidebar identity in the private browser.
+    if (browser_->profile()->IsOffTheRecord()) {
+      return chrome::AddAndReturnTabAt(browser_, GURL("about:blank"),
+                                      tab_strip->active_index() + 1, true);
+    }
+    // The native address entry edits a real, immediately visible new tab.
+    // Use the shared organization store so all windows see the same identity.
+    auto* organization = ViolaOrganizationStore::Get(browser_->profile());
+    if (!organization || !organization->loaded()) {
+      return nullptr;
+    }
+    return organization->AddNewTabForActiveWorkspace(
+        browser_, tab_strip, GURL("about:blank"),
+        tab_strip->active_index() + 1, /*foreground=*/true);
+  }
+#endif
+  // Command-T is a request to compose a destination, not permission to leave
+  // an abandoned about:blank tab behind when the user presses Escape. Keep the
+  // active page in place and create the tab only after a bounded palette
+  // commit supplies a browser-classified HTTP(S) destination.
+  content::WebContents *contents = tab_strip->GetActiveWebContents();
+  BrowserView *browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  ViolaProductOverlayHostView *overlay =
+      browser_view
+          ? browser_view->viola_product_overlay_host_for_testing()
+          : nullptr;
+  if (contents && overlay) {
+    overlay->ShowNewTabPalette();
+  }
+  return contents;
+}
+
+void ViolaProductShellView::ShowSessionRestorePrompt(
+    base::OnceCallback<void(bool)> callback) {
+  session_restore_callback_ = std::move(callback);
+  session_restore_state_.clear();
+  session_restore_state_.Set(
+      "id", base::UnguessableToken::Create().ToString());
+  session_restore_state_.Set("type", "session-restore");
+  session_restore_state_.Set("title", "Restore pages?");
+  session_restore_state_.Set("body", "Viola didn't shut down correctly.");
+  session_restore_state_.Set("host", "Viola");
+  session_restore_state_.Set("hue", 250);
+  session_restore_state_.Set("important", true);
+  session_restore_state_.Set("kept", true);
+  SendAttentionPrompt();
+}
+
+gfx::Rect ViolaProductShellView::GetNoticeAnchorBoundsInScreen() const {
+  const gfx::Rect bounds = GetBoundsInScreen();
+  return gfx::Rect(bounds.x() + 14, bounds.bottom() - 14, 1, 1);
+}
+
+void ViolaProductShellView::SetExtensionPopupAnchor(const gfx::Rect &bounds) {
+  if (!extension_popup_anchor_view_) {
+    return;
+  }
+  gfx::Rect bounded = bounds;
+  bounded.Intersect(GetLocalBounds());
+  if (bounded.IsEmpty()) {
+    bounded = gfx::Rect(14, std::max(14, height() - 44), 1, 1);
+  }
+  extension_popup_anchor_view_->SetBoundsRect(bounded);
+}
+
+void ViolaProductShellView::SendAttentionPrompt() {
+  base::Value state;
+  if (permission_prompt_) {
+    state = base::Value(permission_prompt_state_.Clone());
+  } else if (session_restore_callback_) {
+    state = base::Value(session_restore_state_.Clone());
+  }
+  shell_web_contents()->GetWebUI()->CallJavascriptFunctionUnsafe(
+      "__violaHostReceive", base::Value("permission:prompt"),
+      std::move(state));
+}
+
+void ViolaProductShellView::ShowPermissionPrompt(
+    ViolaPermissionPrompt *prompt, base::DictValue state) {
+  if (!prompt) {
+    return;
+  }
+  if (permission_prompt_ && permission_prompt_ != prompt) {
+    permission_prompt_->DetachFromShell(this);
+  }
+  permission_prompt_ = prompt;
+  permission_prompt_state_ = std::move(state);
+  SendAttentionPrompt();
+}
+
+void ViolaProductShellView::ClearPermissionPrompt(
+    ViolaPermissionPrompt *prompt) {
+  if (permission_prompt_ != prompt) {
+    return;
+  }
+  permission_prompt_ = nullptr;
+  permission_prompt_state_.clear();
+  SendAttentionPrompt();
+}
+
+bool ViolaProductShellView::ResolvePermissionPrompt(
+    std::string_view id, std::string_view decision) {
+  const std::string *restore_id = session_restore_state_.FindString("id");
+  if (!permission_prompt_ && session_restore_callback_ && restore_id &&
+      id == *restore_id &&
+      (decision == "allow" || decision == "block" ||
+       decision == "dismiss")) {
+    base::OnceCallback<void(bool)> callback =
+        std::move(session_restore_callback_);
+    session_restore_state_.clear();
+    SendAttentionPrompt();
+    std::move(callback).Run(decision == "allow");
+    return true;
+  }
+  const std::string *current_id = permission_prompt_state_.FindString("id");
+  if (!permission_prompt_ || !current_id || id != *current_id) {
+    return false;
+  }
+  ViolaPermissionPrompt *prompt = permission_prompt_;
+  permission_prompt_ = nullptr;
+  permission_prompt_state_.clear();
+  SendAttentionPrompt();
+  return prompt->Resolve(decision, this);
+}
+
+base::Value ViolaProductShellView::PermissionPromptState() const {
+  if (permission_prompt_) {
+    return base::Value(permission_prompt_state_.Clone());
+  }
+  return session_restore_callback_
+             ? base::Value(session_restore_state_.Clone())
+             : base::Value();
+}
+
+bool ViolaProductShellView::IsPointInDraggableRegion(
+    const gfx::Point &point) const {
+  const gfx::Rect bounds = GetLocalBounds();
+  const bool in_outer_frame =
+      bounds.Contains(point) &&
+      (point.x() < kContentInset || point.y() < kContentInset ||
+       point.x() >= bounds.width() - kContentInset ||
+       point.y() >= bounds.height() - kContentInset);
+  return in_outer_frame || draggable_region_.contains(point.x(), point.y());
+}
+
+void ViolaProductShellView::NoteMiniActivity() {
+  if (!mini_window_) {
+    return;
+  }
+  mini_idle_timer_.Stop();
+  ViolaOrganizationStore *store =
+      ViolaOrganizationStore::Get(browser_->profile());
+  const int hours = store ? store->mini_viola_auto_close_hours() : 6;
+  if (hours <= 0) {
+    return;
+  }
+  mini_idle_timer_.Start(
+      FROM_HERE, base::Hours(hours), this,
+      &ViolaProductShellView::CloseIdleMiniWindow);
+}
+
+void ViolaProductShellView::CloseIdleMiniWindow() {
+  if (mini_window_ && browser_ && browser_->window()) {
+    browser_->window()->Close();
+  }
+}
+
+void ViolaProductShellView::ShowUI() {
+  SetVisible(true);
+  shell_web_contents()->WasShown();
+}
+
+void ViolaProductShellView::CloseUI() {
+  SetVisible(false);
+  shell_web_contents()->WasHidden();
+}
+
+bool ViolaProductShellView::HandleKeyboardEvent(
+    content::WebContents *source, const input::NativeWebKeyboardEvent &event) {
+  return unhandled_keyboard_event_handler_.HandleKeyboardEvent(
+      event, GetFocusManager());
+}
+
+void ViolaProductShellView::DraggableRegionsChanged(
+    const std::vector<blink::mojom::DraggableRegionPtr> &regions,
+    content::WebContents *contents) {
+  if (contents != shell_web_contents()) {
+    return;
+  }
+  draggable_region_.setEmpty();
+  for (const blink::mojom::DraggableRegionPtr &region : regions) {
+    draggable_region_.op(
+        SkIRect::MakeXYWH(region->bounds.x(), region->bounds.y(),
+                          region->bounds.width(), region->bounds.height()),
+        region->draggable ? SkRegion::kUnion_Op : SkRegion::kDifference_Op);
+  }
+}
+
+void ViolaProductShellView::ViewHierarchyChanged(
+    const views::ViewHierarchyChangedDetails &details) {
+  views::WebView::ViewHierarchyChanged(details);
+  if (details.is_add && details.child == this) {
+    if (browser_ && browser_->profile()->IsOffTheRecord()) {
+      SetFrameGradient("#08080a", "#0d0d10", "#15151a");
+    } else {
+      SetFrameGradient("#b8c6f8", "#dcc7f5", "#f6d4e3");
+    }
+    shell_web_contents()->WasShown();
+    ApplySidebarPresentation();
+    if (browser_ && browser_->profile()->IsOffTheRecord() &&
+        !initial_incognito_palette_requested_) {
+      initial_incognito_palette_requested_ = true;
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              &ViolaProductShellView::ShowInitialIncognitoPalette,
+              weak_factory_.GetWeakPtr()));
+    }
+  }
+}
+
+void ViolaProductShellView::ShowInitialIncognitoPalette() {
+  if (!browser_ || !browser_->profile()->IsOffTheRecord()) {
+    return;
+  }
+  OpenNewTabAndShowPalette();
+}
