+// static
+base::ListValue ViolaAccountSyncService::CompactRecordsForTesting(
+    const base::ListValue &records) {
+  base::DictValue keyed;
+  for (const base::Value &candidate : records) {
+    const base::DictValue *record = candidate.GetIfDict();
+    const std::string key =
+        record ? CleanText(record->FindString("key"), 240) : std::string();
+    if (!key.empty()) {
+      keyed.Set(key, record->Clone());
+    }
+  }
+  CompactHistoryRecords(keyed);
+  base::ListValue compacted;
+  for (const auto [key, value] : keyed) {
+    compacted.Append(value.Clone());
+  }
+  return compacted;
+}
