+#if BUILDFLAG(IS_LINUX)
+// Native DMA-BUF capture combines a copy-result completion with GPU cleanup.
+// Reproduce the foreign callback that was present at the native26 CHECK trap.
+TEST(ViolaSkiaFlushCleanupTest, PreservesReadbackCallbackAndAppendedCleanup) {
+  std::vector<int> calls;
+  GrFlushInfo info;
+  info.fFinishedProc = [](void* context) {
+    static_cast<std::vector<int>*>(context)->push_back(1);
+  };
+  info.fFinishedContext = &calls;
+  gpu::AddCleanupTaskForSkiaFlush(
+      base::BindOnce([](std::vector<int>* calls) { calls->push_back(2); },
+                     base::Unretained(&calls)), &info);
+  gpu::AddCleanupTaskForSkiaFlush(
+      base::BindOnce([](std::vector<int>* calls) { calls->push_back(3); },
+                     base::Unretained(&calls)), &info);
+  EXPECT_TRUE(calls.empty());
+  ASSERT_TRUE(info.fFinishedProc);
+  info.fFinishedProc(info.fFinishedContext);
+  EXPECT_EQ(calls, (std::vector<int>{1, 2, 3}));
+}
+
+TEST(ViolaSkiaFlushCleanupTest, CleanupWithoutReadbackCallback) {
+  int calls = 0;
+  GrFlushInfo info;
+  gpu::AddCleanupTaskForSkiaFlush(
+      base::BindOnce([](int* calls) { ++*calls; }, base::Unretained(&calls)),
+      &info);
+  EXPECT_EQ(calls, 0);
+  info.fFinishedProc(info.fFinishedContext);
+  EXPECT_EQ(calls, 1);
+}
+#endif
