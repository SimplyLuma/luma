+  -webkit-app-region: no-drag;
+}
+body.platform-win32 #desktop-caption-controls,
+body.platform-linux #desktop-caption-controls {
+  display: flex;
+}
+body.window-caption-hidden #desktop-caption-controls,
+body.window-full-screen #desktop-caption-controls {
+  display: none;
+}
+.desktop-caption {
+  position: relative;
+  width: 23px;
+  height: 23px;
+  padding: 0;
+  border: 0;
+  border-radius: 0;
+  background: transparent;
+  color: currentColor;
+  opacity: .78;
+  display: grid;
+  place-items: center;
+  cursor: default;
+  pointer-events: auto;
+  touch-action: none;
+  -webkit-app-region: no-drag;
+}
+.desktop-caption svg {
+  width: 14px;
+  height: 14px;
+  overflow: visible;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+.desktop-caption:hover {
+  background: rgba(20, 18, 28, .08);
+  opacity: 1;
+}
+.desktop-caption:active { background: rgba(20, 18, 28, .14); }
