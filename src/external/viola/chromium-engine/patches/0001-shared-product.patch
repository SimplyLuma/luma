+
+std::optional<TabContextMenuState>
+ViolaOrganizationStore::GetTabContextMenuState(std::string_view tab_id) const {
+  if (!loaded_ || tab_id.empty()) {
+    return std::nullopt;
+  }
+  TabContextMenuState result;
+  result.tab_id = tab_id;
+  std::string profile_id;
+  const base::DictValue *persistent = nullptr;
+
+  for (const base::Value &profile_value : *organization_.FindList("profiles")) {
+    const base::DictValue &profile = profile_value.GetDict();
+    for (const base::Value &tab : *profile.FindList("favorites")) {
+      if (StringOr(&tab.GetDict(), "id") != tab_id) {
+        continue;
+      }
+      persistent = &tab.GetDict();
+      result.section = "favorite";
+      profile_id = StringOr(&profile, "id");
+      break;
+    }
+    if (persistent) {
+      break;
+    }
+  }
+  for (const base::Value &space_value : *organization_.FindList("spaces")) {
+    const base::DictValue &space = space_value.GetDict();
+    const std::string candidate_space_id = StringOr(&space, "id");
+    const std::string candidate_profile_id = StringOr(&space, "profileId");
+    if (result.section == "favorite" && result.space_id.empty() &&
+        candidate_profile_id == profile_id) {
+      result.space_id = candidate_space_id;
+    }
+    for (std::string_view section : {"pinned", "today"}) {
+      for (const base::Value &tab : *space.FindList(section)) {
+        if (StringOr(&tab.GetDict(), "id") != tab_id) {
+          continue;
+        }
+        persistent = &tab.GetDict();
+        result.space_id = candidate_space_id;
+        result.section = std::string(section);
+        profile_id = candidate_profile_id;
+      }
+    }
+  }
+  if (!persistent || result.space_id.empty() || profile_id.empty()) {
+    return std::nullopt;
+  }
+  result.profile_id = profile_id;
+  result.url = StringOr(persistent, "url");
+  result.keep_active = persistent->FindBool("keepActive").value_or(false);
+  result.mini_player_excluded =
+      persistent->FindBool("miniPlayerExcluded").value_or(false);
+  result.muted = persistent->FindBool("muted").value_or(false);
+
+  for (const base::Value &space_value : *organization_.FindList("spaces")) {
+    const base::DictValue &space = space_value.GetDict();
+    const std::string candidate_id = StringOr(&space, "id");
+    if (StringOr(&space, "profileId") != profile_id ||
+        candidate_id == result.space_id) {
+      continue;
+    }
+    result.workspace_targets.push_back(
+        {.id = candidate_id,
+         .label = StringOr(&space, "icon") + " " + StringOr(&space, "name")});
+  }
+  for (const base::Value &space_value : *organization_.FindList("spaces")) {
+    const base::DictValue &space = space_value.GetDict();
+    for (const base::Value &group : *space.FindList("tabGroups")) {
+      for (const base::Value &id : *group.GetDict().FindList("tabIds")) {
+        if (id.is_string() && id.GetString() == tab_id) {
+          result.group_id = StringOr(&group.GetDict(), "id");
+        }
+      }
+    }
+    const std::vector<std::string> split_ids = SplitLeaves(space.Find("split"));
+    result.in_split = result.in_split ||
+                      std::ranges::find(split_ids, tab_id) != split_ids.end();
+  }
+  return result;
+}
