+bool ViolaOrganizationStore::IsFavorite(std::string_view tab_id) const {
+  if (!loaded_ || tab_id.empty()) {
+    return false;
+  }
+  for (const base::Value &profile : *organization_.FindList("profiles")) {
+    for (const base::Value &favorite :
+         *profile.GetDict().FindList("favorites")) {
+      if (StringOr(&favorite.GetDict(), "id") == tab_id) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+bool ViolaOrganizationStore::RenameTab(std::string_view tab_id,
+                                       std::string_view requested_title) {
+  if (!loaded_ || tab_id.empty()) {
+    return false;
+  }
+  std::string title(requested_title);
+  base::TrimWhitespaceASCII(title, base::TRIM_ALL, &title);
+  if (title.empty() || title.size() > 512 || !base::IsStringUTF8(title)) {
+    return false;
+  }
+  base::DictValue *persistent = FindPersistentTab(organization_, tab_id);
+  if (!persistent) {
+    return false;
+  }
+  persistent->Set("title", std::move(title));
+  ScheduleWrite();
+  return true;
+}
+
+void ViolaOrganizationStore::RemoveTab(std::string_view tab_id) {
+  if (!loaded_ || tab_id.empty()) {
+    return;
+  }
+  if (std::optional<std::string> owner =
+          SpaceIdForTab(organization_, tab_id)) {
+    if (base::DictValue *space = FindSpace(organization_, *owner)) {
+      RememberRemovedTab(*space, tab_id);
+    }
+  }
+  RemoveTabFromOrganizationGroups(organization_, tab_id,
+                                  /*forget_saved_snapshot=*/false);
+  if (base::ListValue *profiles = organization_.FindList("profiles")) {
+    for (base::Value &profile : *profiles) {
+      base::ListValue *favorites = profile.GetDict().FindList("favorites");
+      for (auto tab = favorites->begin(); tab != favorites->end();) {
+        if (StringOr(&tab->GetDict(), "id") == tab_id) {
+          tab = favorites->erase(tab);
+        } else {
+          ++tab;
+        }
+      }
+    }
+  }
+  for (base::Value &space_value : *organization_.FindList("spaces")) {
+    base::DictValue &space = space_value.GetDict();
+    for (std::string_view section : {"pinned", "today"}) {
+      base::ListValue *tabs = space.FindList(section);
+      for (auto tab = tabs->begin(); tab != tabs->end();) {
+        if (StringOr(&tab->GetDict(), "id") == tab_id) {
+          tab = tabs->erase(tab);
+        } else {
+          ++tab;
+        }
+      }
+    }
+    if (StringOr(&space, "activeTabId") == tab_id) {
+      space.Set("activeTabId", base::Value());
+    }
+  }
+  ScheduleWrite();
+}
