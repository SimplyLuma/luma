+std::string BoundedText(const base::Value *value, size_t maximum_bytes,
+                        std::string fallback = {}) {
+  if (!value || !value->is_string()) {
+    return fallback;
+  }
+  std::string result = value->GetString();
+  if (result.size() > maximum_bytes) {
+    result.resize(maximum_bytes);
+  }
+  return result;
+}
+
+std::string StringOr(const base::DictValue *source, std::string_view key,
+                     std::string fallback = {}) {
+  const std::string *value = source ? source->FindString(key) : nullptr;
+  return value ? *value : std::move(fallback);
+}
+
+bool IsIdentifier(std::string_view value) {
+  if (value.empty() || value.size() > 160) {
+    return false;
+  }
+  return std::ranges::all_of(value, [](unsigned char character) {
+    return std::isalnum(character) || character == '.' || character == '_' ||
+           character == ':' || character == '-';
+  });
+}
+
+std::string Identifier(const base::Value *value) {
+  std::string result = BoundedText(value, 160);
+  return IsIdentifier(result) ? result : std::string();
+}
+
+double NumberOr(const base::Value *value, double fallback = 0) {
+  if (!value) {
+    return fallback;
+  }
+  if (value->is_int()) {
+    return value->GetInt();
+  }
+  if (value->is_double() && std::isfinite(value->GetDouble())) {
+    return value->GetDouble();
+  }
+  return fallback;
+}
+
+bool BooleanOr(const base::Value *value, bool fallback = false) {
+  return value && value->is_bool() ? value->GetBool() : fallback;
+}
+
+bool IsSafeTabUrl(const GURL &url, bool native_state) {
+  if (!url.is_valid() || url.spec().size() > 8192) {
+    return false;
+  }
+  if (url.SchemeIsHTTPOrHTTPS() || url.SchemeIsFile() ||
+      url.spec() == "about:blank" ||
+      url.spec().starts_with("vela://mobile-simulator")) {
+    return true;
+  }
+  if (native_state && url.SchemeIs("chrome") && url.host() == "viola" &&
+      url.path() == "/settings.html") {
+    return true;
+  }
+  return native_state && url.SchemeIs("chrome") &&
+         (url.host() == "newtab" || url.host() == "new-tab-page");
+}
+
+GURL ProfileNavigationUrl(const GURL &url) {
+  // Viola supplies its own browser chrome, so its standard Browser-owned blank
+  // tabs use a neutral document instead of exposing stock chrome://newtab.
+  return IsSafeTabUrl(url, true) &&
+                 (!url.SchemeIs("chrome") || url.host() == "viola")
+             ? url
+             : GURL(url::kAboutBlankURL);
+}
+
+std::string SafeTabUrl(const base::Value *value, bool native_state) {
+  std::string candidate = BoundedText(value, 8192);
+  GURL url(candidate);
+  return IsSafeTabUrl(url, native_state) ? candidate : std::string();
+}
+
+std::string SafeFavicon(const base::Value *value) {
+  std::string candidate = BoundedText(value, 64 * 1024);
+  if (candidate.starts_with("data:image/")) {
+    return candidate;
+  }
+  GURL url(candidate);
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() ? candidate
+                                                     : std::string();
+}
+
+bool IsTheme(std::string_view key) {
+  static constexpr std::string_view kThemes[] = {
+      "aurora",   "sky",  "mint",  "peach",    "rose",
+      "lavender", "sand", "slate", "midnight", "graphite"};
+  return std::ranges::find(kThemes, key) != std::end(kThemes);
+}
+
+std::string SafeHomepage(const base::Value *value) {
+  std::string candidate = BoundedText(value, 2048, "https://www.google.com/");
+  GURL url(candidate);
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.has_username() ||
+      url.has_password() || url.host().empty()) {
+    return "https://www.google.com/";
+  }
+  return url.spec();
+}
+
+bool IsSafeCustomSearchTemplate(std::string_view value) {
+  if (value.empty() || value.size() > 2048 || !base::IsStringUTF8(value)) {
+    return false;
+  }
+  const size_t placeholder = value.find("%s");
+  if (placeholder == std::string_view::npos ||
+      value.find("%s", placeholder + 2) != std::string_view::npos) {
+    return false;
+  }
+  std::string probe(value);
+  probe.replace(placeholder, 2, "viola");
+  const GURL url(probe);
+  return url.is_valid() && url.SchemeIs(url::kHttpsScheme) &&
+         !url.has_username() && !url.has_password() && !url.host().empty();
+}
