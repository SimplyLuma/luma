+bool IsViolaThemedBrowserTool(const GURL &url) {
+  if (!url.SchemeIs("chrome")) {
+    return false;
+  }
+  // The import route is a browser-owned consent dialog whose visibility is
+  // delayed until Chromium finishes enumerating local browser profiles. Do
+  // not reshape or gate that transient dialog as a full settings document;
+  // doing so can leave only the empty Settings frame visible on Windows.
+  if (url.host() == "settings" && url.path() == "/importData") {
+    return false;
+  }
+  constexpr std::string_view kHosts[] = {"bookmarks",        "downloads",
+                                         "extensions",       "history",
+                                         "password-manager", "settings"};
+  return std::ranges::any_of(
+      kHosts, [&url](std::string_view host) { return host == url.host(); });
+}
