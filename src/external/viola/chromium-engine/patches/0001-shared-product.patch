+#ifndef CHROME_BROWSER_UI_WEBUI_VIOLA_VIOLA_UPDATE_SERVICE_H_
+#define CHROME_BROWSER_UI_WEBUI_VIOLA_VIOLA_UPDATE_SERVICE_H_
+
+#include "base/no_destructor.h"
+#include "base/observer_list.h"
+
+namespace viola {
+
+// Platform-owned installation boundary for desktop updates. Discovery and the
+// Viola notice rail stay in the product shell; this service delegates bundle
+// replacement to the platform's qualified installer implementation.
+class ViolaUpdateService {
+ public:
+  enum class InstallStatus {
+    kUnavailable,
+    kAvailable,
+    kDownloading,
+    kReady,
+    kError,
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnViolaUpdateInstallStatusChanged(InstallStatus status) = 0;
+  };
+
+  static ViolaUpdateService& Get();
+
+  ViolaUpdateService(const ViolaUpdateService&) = delete;
+  ViolaUpdateService& operator=(const ViolaUpdateService&) = delete;
+
+  bool CanInstallInApp();
+  InstallStatus install_status() const { return install_status_; }
+  void StageUpdateInBackground();
+  void PresentUpdate();
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // Called only by the platform bridge. Public so the Objective-C delegate can
+  // remain decoupled from Sparkle's headers at Chromium compile time.
+  void ReportPlatformStatus(InstallStatus status);
+
+ private:
+  friend class base::NoDestructor<ViolaUpdateService>;
+
+  ViolaUpdateService();
+  ~ViolaUpdateService();
+
+  class Impl;
+  Impl* impl_ = nullptr;
+  InstallStatus install_status_ = InstallStatus::kUnavailable;
+  base::ObserverList<Observer> observers_;
+};
+
+}  // namespace viola
+
+#endif  // CHROME_BROWSER_UI_WEBUI_VIOLA_VIOLA_UPDATE_SERVICE_H_
