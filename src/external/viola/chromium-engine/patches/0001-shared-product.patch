+(() => {
+  if (vela.platform !== 'win32' && vela.platform !== 'linux') return;
+
+  document.body.classList.add(`platform-${vela.platform}`);
+  document.body.classList.add('has-desktop-caption-controls');
+
+  const controls = document.createElement('div');
+  controls.id = 'desktop-caption-controls';
+  controls.setAttribute('role', 'group');
+  controls.setAttribute('aria-label', 'Window controls');
+  const markup = `
+    <button class="desktop-caption close" data-action="close" title="Close" aria-label="Close">
+      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4.5 4.5 7 7m0-7-7 7"/></svg>
+    </button>
+    <button class="desktop-caption minimize" data-action="minimize" title="Minimize" aria-label="Minimize">
+      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 8.5h8"/></svg>
+    </button>
+    <button class="desktop-caption maximize" data-action="maximize" title="Maximize" aria-label="Maximize">
+      <svg class="maximize-mark" viewBox="0 0 16 16" aria-hidden="true"><rect x="4" y="4" width="8" height="8" rx=".5"/></svg>
+      <svg class="restore-mark" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 5h6v6M4 7h6v6H4z"/></svg>
+    </button>`;
+  controls.innerHTML = globalThis.__violaStaticHTML
+    ? globalThis.__violaStaticHTML(markup) : markup;
+  document.body.appendChild(controls);
+
+  controls.querySelectorAll('[data-action]').forEach((button) => {
+    button.addEventListener('pointerdown', (event) => {
+      if (event.button !== 0) return;
+      event.preventDefault();
+      event.stopPropagation();
+      vela.send('window:control', { action: button.dataset.action });
+    });
+  });
+
+  vela.on('window:chromeState', (state = {}) => {
+    document.body.classList.toggle('window-focused', !!state.focused);
+    document.body.classList.toggle('window-maximized', !!state.maximized);
+    document.body.classList.toggle('window-full-screen', !!state.fullScreen);
+    document.body.classList.toggle('window-caption-hidden', state.visible === false);
+    const maximize = controls.querySelector('[data-action="maximize"]');
+    const restoring = !!state.maximized;
+    maximize.title = restoring ? 'Restore' : 'Maximize';
+    maximize.setAttribute('aria-label', maximize.title);
+    if (typeof state.ink === 'string') controls.style.color = state.ink;
+  });
+})();
