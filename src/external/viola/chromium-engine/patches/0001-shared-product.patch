+IN_PROC_BROWSER_TEST_F(ViolaUIBrowserTest,
+                       ThreeWayWorkspaceMergeRetainsIndependentPeerTab) {
+  auto tab = [](std::string id, std::string url, double last_accessed) {
+    base::DictValue value;
+    value.Set("id", std::move(id));
+    value.Set("url", std::move(url));
+    value.Set("title", "Sync regression tab");
+    value.Set("favicon", base::Value());
+    value.Set("createdAt", 1.0);
+    value.Set("lastAccessed", last_accessed);
+    value.Set("keepActive", false);
+    value.Set("miniPlayerExcluded", false);
+    value.Set("muted", false);
+    value.Set("openerTabId", base::Value());
+    return value;
+  };
+  base::DictValue base_workspace;
+  base_workspace.Set("id", "workspace-one");
+  base_workspace.Set("name", "Personal");
+  base_workspace.Set("icon", "🌊");
+  base_workspace.Set("theme", "aurora");
+  base_workspace.Set("profileId", "profile-one");
+  base_workspace.Set("pinned", base::ListValue());
+  base::ListValue base_today;
+  base_today.Append(tab("existing-tab", "https://example.test/base", 1.0));
+  base_workspace.Set("today", std::move(base_today));
+  base_workspace.Set("tabGroups", base::ListValue());
+  base_workspace.Set("split", base::Value());
+  base_workspace.Set("splitTitle", base::Value());
+  base_workspace.Set("splitKeepExpanded", false);
+  base::DictValue sort;
+  sort.Set("criterion", "recent-desc");
+  sort.Set("keep", false);
+  base_workspace.Set("tabSort", std::move(sort));
+  base_workspace.Set("activeTabId", "existing-tab");
+
+  base::DictValue local_workspace = base_workspace.Clone();
+  local_workspace.FindList("today")->front().GetDict().Set("lastAccessed", 2.0);
+  local_workspace.FindList("today")->Append(
+      tab("mac-only-tab", "https://example.test/mac", 2.0));
+  base::DictValue peer_workspace = base_workspace.Clone();
+  peer_workspace.FindList("today")->Append(tab(
+      "android-canary", "https://example.com/?viola-sync-canary=test", 3.0));
+
+  std::optional<base::DictValue> merged =
+      viola::ViolaAccountSyncService::MergeWorkspaceValuesForTesting(
+          base_workspace, local_workspace, peer_workspace,
+          /*prefer_local=*/true);
+  ASSERT_TRUE(merged);
+  const base::ListValue *today = merged->FindList("today");
+  ASSERT_TRUE(today);
+  ASSERT_EQ(3u, today->size());
+  std::set<std::string> ids;
+  for (const base::Value &candidate : *today) {
+    ids.insert(*candidate.GetDict().FindString("id"));
+  }
+  EXPECT_EQ(
+      (std::set<std::string>{"existing-tab", "mac-only-tab", "android-canary"}),
+      ids);
+  EXPECT_FALSE(merged->contains("activeTabId"));
+  EXPECT_EQ(2.0,
+            today->front().GetDict().FindDouble("lastAccessed").value_or(0));
+
+  // A real local removal relative to the common Mac server value remains a
+  // removal while the independent Android addition is still retained.
+  local_workspace.Set("today", base::ListValue());
+  merged = viola::ViolaAccountSyncService::MergeWorkspaceValuesForTesting(
+      base_workspace, local_workspace, peer_workspace,
+      /*prefer_local=*/true);
+  ASSERT_TRUE(merged);
+  today = merged->FindList("today");
+  ASSERT_TRUE(today);
+  ASSERT_EQ(1u, today->size());
+  EXPECT_EQ("android-canary", *today->front().GetDict().FindString("id"));
+
+  // Explicit removal identities dominate a later coarse workspace winner.
+  // This is the cross-device close contract: once one peer records a stable
+  // identity as removed, another peer cannot resurrect it by editing the same
+  // workspace from a stale copy.
+  base::ListValue removed;
+  removed.Append("existing-tab");
+  local_workspace = base_workspace.Clone();
+  local_workspace.Set("syncRemovedTabIds", std::move(removed));
+  local_workspace.Set("today", base::ListValue());
+  peer_workspace = base_workspace.Clone();
+  peer_workspace.FindList("today")->Append(
+      tab("peer-new-tab", "https://example.test/peer-new", 4.0));
+  merged = viola::ViolaAccountSyncService::MergeWorkspaceValuesForTesting(
+      base_workspace, local_workspace, peer_workspace,
+      /*prefer_local=*/false);
+  ASSERT_TRUE(merged);
+  today = merged->FindList("today");
+  ASSERT_TRUE(today);
+  ASSERT_EQ(1u, today->size());
+  EXPECT_EQ("peer-new-tab", *today->front().GetDict().FindString("id"));
+  const base::ListValue *merged_removed =
+      merged->FindList("syncRemovedTabIds");
+  ASSERT_TRUE(merged_removed);
+  ASSERT_EQ(1u, merged_removed->size());
+  EXPECT_EQ("existing-tab", merged_removed->front().GetString());
+}
