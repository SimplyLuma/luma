+void ViolaMessageHandler::HandlePaletteOpen(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 1) {
+    return;
+  }
+  const std::string *mode = payload.GetDict().FindString("mode");
+  if (!mode || *mode != "edit") {
