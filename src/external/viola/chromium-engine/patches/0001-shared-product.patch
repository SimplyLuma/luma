+  </div>
+
+<script src="host-bootstrap.js"></script>
+<script>
+  const $ = (s) => document.querySelector(s);
+  const staticHTML = (markup) => globalThis.__violaStaticHTML
+    ? globalThis.__violaStaticHTML(markup)
+    : markup;
+  let mode = 'new';
+  let items = [];
+  let sel = 0;
+  let selectionExplicit = false;
+  let committing = false;
+  let queryToken = 0;
+  let downloadData = [];
+  let downloadQuery = '';
+  let notificationData = [];
+  let notificationQuery = '';
+
+  vela.on('overlay:open', ({ mode: m, currentUrl, theme, downloads, notificationHistory }) => {
+    mode = m;
+    if (theme) document.documentElement.style.setProperty('--accent', theme.accent);
+    if (m === 'split') {
+      // Drop-hint mode: purely visual, must never grab focus mid-drag.
+      document.body.className = 'mode-split';
+      return;
+    }
+    if (m === 'downloads') {
+      document.body.className = 'mode-downloads';
+      downloadData = downloads || [];
+      downloadQuery = '';
+      $('#downloads-search').value = '';
+      renderDownloads();
+      requestAnimationFrame(() => $('#downloads-search').focus());
+      return;
+    }
+    if (m === 'notifications') {
+      document.body.className = 'mode-notifications';
+      notificationData = notificationHistory || [];
+      notificationQuery = '';
+      $('#notifications-search').value = '';
+      renderNotificationHistory();
+      requestAnimationFrame(() => $('#notifications-search').focus());
+      return;
+    }
+    document.body.className = m === 'find' ? 'mode-find' : 'mode-palette';
+    if (m === 'find') {
+      const fq = $('#fq');
+      fq.focus();
+      fq.select();
+      if (fq.value) doFind(true, false);
+    } else {
+      const q = $('#q');
+      q.value = m === 'edit' && currentUrl ? currentUrl : '';
+      q.placeholder = m === 'edit' ? 'Enter URL…' : 'Search or Enter URL…';
+      items = []; sel = 0; selectionExplicit = false; committing = false;
+      renderResults();
+      q.focus();
+      q.select();
+      if (q.value) refresh();
+    }
+  });
+
+  window.addEventListener('blur', () => vela.send('overlay:blurred'));
+  document.addEventListener('keydown', (e) => {
+    if (e.key === 'Escape') { e.preventDefault(); vela.send('palette:close'); }
+  });
+  document.addEventListener('pointerdown', (e) => {
+    // The full native overlay is intentionally a transparent shadow canvas.
+    // Both address-palette modes treat that blank canvas as a modal barrier;
+    // the palette and every result remain interactive because they are excluded.
+    if ((mode === 'new' || mode === 'edit') && !e.target.closest('#palette')) {
+      vela.send('palette:close');
+    }
+  });
+
+  // ---------- palette ----------
+  const qEl = $('#q');
+  qEl.addEventListener('input', () => {
+    selectionExplicit = false;
+    refresh();
+  });
+  qEl.addEventListener('keydown', (e) => {
+    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
+    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
