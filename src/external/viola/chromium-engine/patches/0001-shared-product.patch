+:root {
+  color-scheme: light dark;
+  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", sans-serif;
+  --toolbar: rgba(247, 247, 250, 0.96);
+  --ink: #242237;
+  --muted: rgba(36, 34, 55, 0.56);
+  --hairline: rgba(36, 34, 55, 0.10);
+  --control: rgba(255, 255, 255, 0.82);
+  --canvas: #d7d7db;
+}
+
+* { box-sizing: border-box; }
+html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
+body { color: var(--ink); background: var(--canvas); }
+
+.toolbar {
+  position: relative;
+  z-index: 4;
+  height: 48px;
+  display: grid;
+  grid-template-columns: minmax(120px, 1fr) auto minmax(120px, 1fr);
+  align-items: center;
+  gap: 14px;
+  padding: 0 12px;
+  background: var(--toolbar);
+  border-bottom: 0.5px solid var(--hairline);
+  box-shadow: 0 1px 5px rgba(20, 19, 28, 0.08);
+  backdrop-filter: blur(18px) saturate(1.25);
+}
+
+.document-copy, .page-status, .actions { display: flex; align-items: center; }
+.document-copy { min-width: 0; gap: 8px; }
+.document-icon {
+  width: 26px; height: 26px; display: grid; place-items: center;
+  border: 0.5px solid var(--hairline); border-radius: 8px;
+  background: var(--control); color: #655cdb;
+}
+#document-title {
+  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
+  font-size: 12.5px; font-weight: 600; letter-spacing: -0.08px;
+}
+.page-status { justify-content: center; gap: 6px; color: var(--muted); font-size: 11.5px; }
+#page-number {
+  width: 38px; height: 27px; padding: 0 6px; text-align: center;
+  font: inherit; color: var(--ink); background: var(--control);
+  border: 0.5px solid var(--hairline); border-radius: 7px; outline: none;
+}
+#page-number:focus { border-color: rgba(101, 92, 219, 0.55); box-shadow: 0 0 0 2px rgba(101, 92, 219, 0.12); }
+.actions { justify-content: flex-end; gap: 3px; }
+button {
+  height: 28px; min-width: 28px; padding: 0 8px; border-radius: 8px;
+  border: 0.5px solid transparent; color: var(--ink); background: transparent;
+  font: 500 12px/1 -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", sans-serif;
+}
+button:hover { background: var(--control); border-color: var(--hairline); }
+button:active { transform: translateY(0.5px); }
+.separator { width: 0.5px; height: 18px; margin: 0 3px; background: var(--hairline); }
+
+#reader {
+  height: calc(100% - 48px);
+  overflow: auto;
+  overscroll-behavior: contain;
+  outline: none;
+}
+.pages {
+  width: max-content;
+  min-width: 100%;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 18px;
+  padding: 24px;
+}
+.page {
+  position: relative;
+  flex: 0 0 auto;
+  background: #fff;
+  box-shadow: 0 2px 12px rgba(21, 20, 29, 0.22), 0 0 0 0.5px rgba(21, 20, 29, 0.14);
+}
+.page canvas { display: block; width: 100%; height: 100%; }
+.page-number {
+  position: absolute; right: 7px; bottom: 5px;
+  padding: 2px 5px; border-radius: 5px;
+  color: rgba(0, 0, 0, 0.48); background: rgba(255, 255, 255, 0.74);
+  font-size: 9px; opacity: 0; transition: opacity 100ms ease;
+}
+.page:hover .page-number { opacity: 1; }
+.status {
+  position: absolute; inset: 48px 0 0; display: flex; align-items: center;
+  justify-content: center; gap: 9px; color: var(--muted); font-size: 12px;
+}
+.status.hidden { display: none; }
+.status.error { color: #9f332c; }
+.spinner {
+  width: 14px; height: 14px; border: 1.5px solid rgba(101, 92, 219, 0.22);
+  border-top-color: #655cdb; border-radius: 50%; animation: spin 700ms linear infinite;
+}
+@keyframes spin { to { transform: rotate(360deg); } }
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --toolbar: rgba(37, 38, 45, 0.96);
+    --ink: #f2eff9;
+    --muted: rgba(242, 239, 249, 0.58);
+    --hairline: rgba(255, 255, 255, 0.11);
+    --control: rgba(255, 255, 255, 0.08);
+    --canvas: #17181d;
+  }
+}
