+IN_PROC_BROWSER_TEST_F(ViolaProductShellBrowserTest,
+                       RendersLiveChromiumTabsWithStableKeys) {
+  BrowserView *browser_view = BrowserView::GetBrowserViewForBrowser(browser());
+  ASSERT_TRUE(browser_view);
+  auto *shell_view = browser_view->viola_product_shell_view_for_testing();
+  ASSERT_TRUE(shell_view);
+
+  content::WebContents *shell_contents = shell_view->shell_web_contents();
+  ASSERT_TRUE(shell_contents);
+  ASSERT_TRUE(content::WaitForLoadStop(shell_contents));
+  EXPECT_TRUE(content::EvalJs(shell_contents, R"(
+    new Promise((resolve) => {
+      const deadline = performance.now() + 5000;
+      let switchSent = false;
+      const check = () => {
+        if (typeof S !== 'object' || typeof S.activeSpaceId !== 'string' ||
+            typeof vela !== 'object' || typeof vela.send !== 'function') {
+          if (performance.now() >= deadline) {
+            resolve(false);
+          } else {
+            setTimeout(check, 20);
+          }
+          return;
+        }
+        if (!switchSent) {
+          switchSent = true;
+          vela.send('space:switch', {spaceId: S.activeSpaceId});
+        }
+        if (!S.isAllWorkspaces && document.querySelector('#today-list')) {
+          resolve(true);
+        } else if (performance.now() >= deadline) {
+          resolve(false);
+        } else {
+          setTimeout(check, 20);
+        }
+      };
+      check();
+    })
+  )").ExtractBool());
+  EXPECT_TRUE(content::EvalJs(shell_contents, R"(
+    typeof trustedTypes === 'object'
+      && typeof __violaStaticHTML === 'function'
+      && trustedTypes.isHTML(__violaStaticHTML('<span></span>'))
+      && (() => {
+        const probe = document.createElement('div');
+        try { probe.innerHTML = '<span></span>'; return false; }
+        catch { return true; }
+      })()
