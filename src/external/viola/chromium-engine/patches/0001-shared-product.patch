+// static
+std::optional<std::vector<uint8_t>> ViolaAccountSyncService::WrapOrUnwrapKey(
+    bool wrap, std::string_view password, const base::DictValue *envelope,
+    base::span<const uint8_t> key, base::DictValue *wrapped) {
+  std::vector<uint8_t> salt;
+  std::vector<uint8_t> nonce;
+  int iterations = kKeyWrapIterations;
+  if (wrap) {
+    if (!wrapped || key.size() != 32) {
+      return std::nullopt;
+    }
+    salt = base::RandBytesAsVector(16);
+    nonce = base::RandBytesAsVector(12);
+  } else {
+    const std::string *kdf = envelope ? envelope->FindString("kdf") : nullptr;
+    const std::string *cipher =
+        envelope ? envelope->FindString("cipher") : nullptr;
+    if (!kdf || *kdf != "pbkdf2-sha256" || !cipher ||
+        *cipher != "aes-256-gcm") {
+      return std::nullopt;
+    }
+    std::optional<int> requested_iterations = envelope->FindInt("iterations");
+    if (!requested_iterations || *requested_iterations < 200000 ||
+        *requested_iterations > 1000000) {
+      return std::nullopt;
+    }
+    iterations = *requested_iterations;
+    std::optional<std::vector<uint8_t>> decoded_salt =
+        DecodeBase64Field(*envelope, "salt", 16);
+    std::optional<std::vector<uint8_t>> decoded_nonce =
+        DecodeBase64Field(*envelope, "iv", 12);
+    if (!decoded_salt || !decoded_nonce) {
+      return std::nullopt;
+    }
+    salt = std::move(*decoded_salt);
+    nonce = std::move(*decoded_nonce);
+  }
+  std::array<uint8_t, 32> wrapping_key{};
+  if (!PKCS5_PBKDF2_HMAC(password.data(), static_cast<int>(password.size()),
+                         salt.data(), salt.size(), iterations, EVP_sha256(),
+                         wrapping_key.size(), wrapping_key.data())) {
+    return std::nullopt;
+  }
+  // Match the Node and Dart wire format exactly. Passing the char array
+  // directly would authenticate its trailing NUL as an extra AAD byte.
+  const base::span<const uint8_t> aad =
+      base::as_byte_span(std::string_view(kKeyWrapAad));
+  if (wrap) {
+    std::vector<uint8_t> ciphertext = crypto::aead::Seal(
+        crypto::aead::AES_256_GCM, wrapping_key, key, nonce, aad);
+    if (ciphertext.size() != 48) {
+      return std::nullopt;
+    }
+    wrapped->Set("version", 1);
+    wrapped->Set("kdf", "pbkdf2-sha256");
+    wrapped->Set("iterations", iterations);
+    wrapped->Set("cipher", "aes-256-gcm");
+    wrapped->Set("salt", base::Base64Encode(salt));
+    wrapped->Set("iv", base::Base64Encode(nonce));
+    wrapped->Set("tag", base::Base64Encode(base::span(ciphertext).last<16>()));
+    wrapped->Set("ciphertext",
+                 base::Base64Encode(base::span(ciphertext).first<32>()));
+    return std::vector<uint8_t>(key.begin(), key.end());
+  }
+  std::optional<std::vector<uint8_t>> tag =
+      DecodeBase64Field(*envelope, "tag", 16);
+  std::optional<std::vector<uint8_t>> ciphertext =
+      DecodeBase64Field(*envelope, "ciphertext", 32);
+  if (!tag || !ciphertext) {
+    return std::nullopt;
+  }
+  ciphertext->insert(ciphertext->end(), tag->begin(), tag->end());
+  return crypto::aead::Open(crypto::aead::AES_256_GCM, wrapping_key,
+                            *ciphertext, nonce, aad);
+}
+
+base::ListValue
+ViolaAccountSyncService::BuildLocalRecords(const base::DictValue &organization,
+                                           bool initial_seed,
+                                           bool allow_local_mutations) {
+  base::DictValue entities;
+  if (const base::ListValue *profiles = organization.FindList("profiles")) {
+    for (const base::Value &candidate : *profiles) {
+      const base::DictValue *profile = candidate.GetIfDict();
+      const std::string id =
+          profile ? CleanText(profile->FindString("id"), 160) : std::string();
+      if (id.empty()) {
+        continue;
+      }
+      base::DictValue portable;
+      portable.Set("id", id);
+      portable.Set("name", CleanText(profile->FindString("name"), 120));
+      portable.Set("favorites", profile->FindList("favorites")
+                                    ? profile->FindList("favorites")->Clone()
+                                    : base::ListValue());
+      portable.Set("extensions", base::ListValue());
+      entities.Set("profile:" + id, std::move(portable));
+    }
+  }
+  if (const base::ListValue *spaces = organization.FindList("spaces")) {
+    for (const base::Value &candidate : *spaces) {
+      const base::DictValue *space = candidate.GetIfDict();
+      const std::string id =
+          space ? CleanText(space->FindString("id"), 160) : std::string();
+      if (!id.empty()) {
+        base::DictValue portable = space->Clone();
+        portable.Remove("activeTabId");
+        entities.Set("workspace:" + id, std::move(portable));
+      }
+    }
+  }
+  base::DictValue index;
+  base::ListValue profile_ids;
+  for (const auto [key, value] : entities) {
+    if (key.starts_with("profile:")) {
+      profile_ids.Append(key.substr(std::string_view("profile:").size()));
+    }
+  }
+  base::ListValue workspace_ids;
+  for (const auto [key, value] : entities) {
+    if (key.starts_with("workspace:")) {
+      workspace_ids.Append(key.substr(std::string_view("workspace:").size()));
+    }
+  }
+  index.Set("profileIds", std::move(profile_ids));
+  index.Set("workspaceIds", std::move(workspace_ids));
+  entities.Set("workspace-index", std::move(index));
+  for (const auto [key, value] : local_history_entities_) {
+    entities.Set(key, value.Clone());
+  }
+
+  const base::DictValue *old_manifest = state_.FindDict("manifest");
+  const base::DictValue *old_entities =
+      old_manifest ? old_manifest->FindDict("entities") : nullptr;
+  std::set<std::string> keys;
+  for (const auto [key, value] : entities) {
+    keys.insert(key);
+  }
+  if (old_entities) {
+    for (const auto [key, value] : *old_entities) {
+      keys.insert(key);
+    }
+  }
+  const std::string now = initial_seed
+                              ? "1970-01-01T00:00:00.000Z"
+                              : base::TimeFormatAsIso8601(base::Time::Now());
+  const base::DictValue *device = state_.FindDict("device");
+  const std::string device_id =
+      device ? CleanText(device->FindString("id"), 80) : std::string();
+  base::DictValue next_metadata;
+  base::ListValue records;
+  int passive_candidates_withheld = 0;
+  for (const std::string &key : keys) {
+    const base::Value *current = entities.Find(key);
+    const base::DictValue *old =
+        old_entities ? old_entities->FindDict(key) : nullptr;
+    const bool deleted = current == nullptr;
+    const std::string hash = current ? ValueDigest(*current) : std::string();
+    base::DictValue metadata;
+    if (!allow_local_mutations) {
+      // A passive peer pull is not evidence that this Mac authored a newer
+      // structural value, including when the visible value still matches the
+      // cached manifest exactly. Returning those unchanged cached records let
+      // a locally retained winner survive even after the authenticated server
+      // bundle had moved on. Preserve metadata only as recovery context and
+      // contribute no local candidate: the server envelopes are the complete
+      // read-only convergence base. A real organization edit sets local_dirty_
+      // and follows the ordinary advance path below.
+      if (old) {
+        next_metadata.Set(key, old->Clone());
+      }
+      ++passive_candidates_withheld;
+      continue;
+    } else if (old && old->FindBool("deleted").value_or(false) == deleted &&
+               CleanText(old->FindString("hash"), 64) == hash) {
+      metadata = old->Clone();
+    } else {
+      metadata.Set("hash", hash.empty() ? base::Value() : base::Value(hash));
+      metadata.Set("revision",
+                   old ? old->FindInt("revision").value_or(0) + 1 : 1);
+      metadata.Set("updatedAt", now);
+      metadata.Set("deviceId", device_id);
+      metadata.Set("deleted", deleted);
+    }
+    next_metadata.Set(key, metadata.Clone());
+    base::DictValue record = metadata.Clone();
+    record.Set("key", key);
+    record.Set("value", current ? current->Clone() : base::Value());
+    records.Append(std::move(record));
+  }
+  base::DictValue manifest;
+  manifest.Set("version", 1);
+  manifest.Set("entities", std::move(next_metadata));
+  state_.Set("manifest", std::move(manifest));
+  pending_sync_evidence_.Set("passiveLocalCandidatesWithheld",
+                             passive_candidates_withheld);
+  return records;
+}
+
+bool ViolaAccountSyncService::MergeAndApplyRecords(
+    const base::ListValue &remote_records, base::ListValue local_records,
+    bool prefer_populated_local_seed, base::ListValue *merged_records) {
+  ViolaOrganizationStore *store = ViolaOrganizationStore::Get(profile_);
+  if (!store || !store->loaded()) {
+    pending_sync_evidence_.Set("mergeFailureStage", "store-not-ready");
+    return false;
+  }
+  base::DictValue organization = store->ExportOrganizationForSync();
+  const bool recover_empty_local =
+      !OrganizationHasPortableContent(organization);
+  const base::DictValue *device = state_.FindDict("device");
+  const std::string current_device_id =
+      device ? CleanText(device->FindString("id"), 80) : std::string();
+
+  base::DictValue winners;
+  base::DictValue server_self_workspaces;
+  base::DictValue peer_workspaces;
+  base::DictValue current_local_workspaces;
+  std::map<std::string, std::set<std::string>> workspace_tab_tombstones;
+  WorkspaceTabCandidates workspace_tab_candidates;
+  std::map<std::string, int> workspace_max_revisions;
+  int peer_comparator_wins = 0;
+  int local_comparator_wins = 0;
+  int comparator_ties = 0;
+  int concurrent_workspace_merges = 0;
+  int tombstone_reconciliations = 0;
+  int tab_addition_reconciliations = 0;
+  auto retain_workspace_record = [](base::DictValue &records,
+                                    const base::DictValue &record) {
+    const std::string key = CleanText(record.FindString("key"), 240);
+    if (!key.starts_with("workspace:")) {
+      return;
+    }
+    const base::DictValue *current = records.FindDict(key);
+    if (!current || CompareRecordVersions(*current, record) < 0) {
+      records.Set(key, record.Clone());
+    }
+  };
+  auto consider = [&winners, recover_empty_local, prefer_populated_local_seed,
+                   &current_device_id](const base::Value &candidate) {
+    const base::DictValue *record = candidate.GetIfDict();
+    const std::string key =
+        record ? CleanText(record->FindString("key"), 240) : std::string();
+    if (!record || !IsRecordKey(key) ||
+        !record->FindInt("revision").has_value() ||
+        CleanText(record->FindString("updatedAt"), 40).empty() ||
+        CleanText(record->FindString("deviceId"), 80).empty() ||
+        !record->FindBool("deleted").has_value()) {
+      return;
+    }
+    const bool deleted = record->FindBool("deleted").value_or(false);
+    const base::DictValue *value = record->FindDict("value");
+    const std::string hash = CleanText(record->FindString("hash"), 64);
+    if ((!deleted && (!value || hash.size() != 64 ||
+                      ValueDigest(base::Value(value->Clone())) != hash)) ||
+        (deleted && record->Find("value") &&
+         !record->Find("value")->is_none())) {
+      return;
+    }
+    const base::DictValue *current = winners.FindDict(key);
+    if (current && prefer_populated_local_seed &&
+        (key == "workspace-index" || key.starts_with("workspace:") ||
+         key.starts_with("profile:"))) {
+      const bool candidate_is_local =
+          CleanText(record->FindString("deviceId"), 80) == current_device_id;
+      const bool current_is_local =
+          CleanText(current->FindString("deviceId"), 80) == current_device_id;
+      if (candidate_is_local != current_is_local) {
+        if (candidate_is_local) {
+          winners.Set(key, record->Clone());
+        }
+        return;
+      }
+    }
+    if (current && recover_empty_local && key.starts_with("workspace:")) {
+      const bool candidate_is_peer =
+          CleanText(record->FindString("deviceId"), 80) != current_device_id;
+      const bool current_is_peer =
+          CleanText(current->FindString("deviceId"), 80) != current_device_id;
+      const bool candidate_has_content =
+          WorkspaceRecordHasPortableContent(*record);
+      const bool current_has_content =
+          WorkspaceRecordHasPortableContent(*current);
+      if (candidate_is_peer && candidate_has_content && !current_is_peer &&
+          !current_has_content) {
+        winners.Set(key, record->Clone());
+        return;
+      }
+      if (current_is_peer && current_has_content && !candidate_is_peer &&
+          !candidate_has_content) {
+        return;
+      }
+    }
+    if (!current || CompareRecordVersions(*current, *record) < 0) {
+      winners.Set(key, record->Clone());
+    }
+  };
+  auto collect_tab_tombstones =
+      [&workspace_tab_tombstones,
+       &workspace_tab_candidates,
+       &workspace_max_revisions](const base::DictValue &record) {
+        const std::string key = CleanText(record.FindString("key"), 240);
+        const base::DictValue *value = record.FindDict("value");
+        if (!key.starts_with("workspace:") ||
+            record.FindBool("deleted").value_or(false) || !value) {
+          return;
+        }
+        const std::string hash = CleanText(record.FindString("hash"), 64);
+        if (hash.size() != 64 ||
+            ValueDigest(base::Value(value->Clone())) != hash) {
+          return;
+        }
+        workspace_max_revisions[key] =
+            std::max(workspace_max_revisions[key],
+                     record.FindInt("revision").value_or(0));
+        std::set<std::string> &collected = workspace_tab_tombstones[key];
+        for (const std::string &id : ReadWorkspaceTabTombstones(*value)) {
+          if (collected.size() >= kMaximumWorkspaceTabTombstones) {
+            break;
+          }
+          collected.insert(id);
+        }
+        CollectWorkspaceTabCandidates(record, workspace_tab_candidates);
+      };
+  for (const base::Value &record : remote_records) {
+    if (winners.size() >= 20000) {
+      break;
+    }
+    if (const base::DictValue *value = record.GetIfDict()) {
+      collect_tab_tombstones(*value);
+      if (CleanText(value->FindString("deviceId"), 80) == current_device_id) {
+        retain_workspace_record(server_self_workspaces, *value);
+      } else {
+        retain_workspace_record(peer_workspaces, *value);
+      }
+    }
+    consider(record);
+  }
+  for (const base::Value &record : local_records) {
+    if (const base::DictValue *value = record.GetIfDict()) {
+      collect_tab_tombstones(*value);
+      retain_workspace_record(current_local_workspaces, *value);
+    }
+    consider(record);
+  }
+  for (const auto [key, candidate] : current_local_workspaces) {
+    const base::DictValue *local_record = candidate.GetIfDict();
+    const base::DictValue *peer_record = peer_workspaces.FindDict(key);
+    if (!local_record || !peer_record) {
+      continue;
+    }
+    const int comparison = CompareRecordVersions(*local_record, *peer_record);
+    if (comparison < 0) {
+      ++peer_comparator_wins;
+    } else if (comparison > 0) {
+      ++local_comparator_wins;
+    } else {
+      ++comparator_ties;
+    }
+  }
+
+  // Workspace records are deliberately coarse so the encrypted contract stays
+  // bounded, but ordinary browser activity can change a Mac workspace while a
+  // peer independently adds a tab to that same record. Reconcile those two
+  // descendants against the last Mac value accepted by the server. Distinct
+  // stable tab/group identities are retained, explicit removals relative to
+  // that common base remain removals, and true same-field conflicts continue
+  // to use the existing deterministic record order.
+  if (!prefer_populated_local_seed && !recover_empty_local) {
+    for (const auto [key, candidate] : current_local_workspaces) {
+      const base::DictValue *base_record = server_self_workspaces.FindDict(key);
+      const base::DictValue *local_record = candidate.GetIfDict();
+      const base::DictValue *peer_record = peer_workspaces.FindDict(key);
+      if (!base_record || !local_record || !peer_record ||
+          CompareRecordVersions(*base_record, *peer_record) >= 0) {
+        continue;
+      }
+      std::optional<base::DictValue> reconciled =
+          MergeConcurrentWorkspaceRecord(*base_record, *local_record,
+                                         *peer_record, current_device_id);
+      if (reconciled) {
+        ++concurrent_workspace_merges;
+        winners.Set(key, std::move(*reconciled));
+      }
+    }
+  }
+
+  // A tab close is a durable identity-level event, not merely an omission from
+  // a coarse workspace snapshot. Union every authenticated device's bounded
+  // removal set before accepting the deterministic whole-record winner. If a
+  // stale but later workspace still contains a closed identity, emit a fresh
+  // corrected record so every peer converges and the tab cannot resurrect on
+  // a later pass.
+  std::set<std::string> workspace_reconciliation_keys;
+  for (const auto &[key, ignored] : workspace_tab_tombstones) {
+    workspace_reconciliation_keys.insert(key);
+  }
+  for (const auto &[key, ignored] : workspace_tab_candidates) {
+    workspace_reconciliation_keys.insert(key);
+  }
+  for (const std::string &key : workspace_reconciliation_keys) {
+    const std::set<std::string> &removed_tabs = workspace_tab_tombstones[key];
+    base::DictValue *winner = winners.FindDict(key);
+    base::DictValue *value = winner ? winner->FindDict("value") : nullptr;
+    if (!winner || winner->FindBool("deleted").value_or(false) || !value) {
+      continue;
+    }
+    base::DictValue corrected = value->Clone();
+    const bool removed_changed =
+        ApplyWorkspaceTabTombstones(corrected, removed_tabs);
+    const bool additions_changed = ApplyWorkspaceTabCandidates(
+        corrected, workspace_tab_candidates[key], removed_tabs,
+        workspace_max_revisions[key]);
+    if (!removed_changed && !additions_changed) {
+      continue;
+    }
+    base::DictValue reconciled = winner->Clone();
+    reconciled.Set(
+        "revision",
+        std::max(winner->FindInt("revision").value_or(0),
+                 workspace_max_revisions[key]) +
+            1);
+    reconciled.Set("updatedAt",
+                   base::TimeFormatAsIso8601(base::Time::Now()));
+    reconciled.Set("deviceId", current_device_id);
+    reconciled.Set("deleted", false);
+    reconciled.Set("hash", ValueDigest(base::Value(corrected.Clone())));
+    reconciled.Set("value", std::move(corrected));
+    winners.Set(key, std::move(reconciled));
+    if (removed_changed) {
+      ++tombstone_reconciliations;
+    }
+    if (additions_changed) {
+      ++tab_addition_reconciliations;
+    }
+  }
+  base::DictValue comparison_evidence;
+  comparison_evidence.Set("peerWholeRecordWins", peer_comparator_wins);
+  comparison_evidence.Set("localWholeRecordWins", local_comparator_wins);
+  comparison_evidence.Set("wholeRecordTies", comparator_ties);
+  comparison_evidence.Set("threeWayCommonBaseMerges",
+                          concurrent_workspace_merges);
+  comparison_evidence.Set("tabTombstoneReconciliations",
+                          tombstone_reconciliations);
+  comparison_evidence.Set("tabAdditionReconciliations",
+                          tab_addition_reconciliations);
+  comparison_evidence.Set(
+      "winningReason",
+      tombstone_reconciliations > 0 || tab_addition_reconciliations > 0
+          ? tombstone_reconciliations > 0
+                ? "durable-tab-removal"
+                : "durable-tab-addition"
+          : concurrent_workspace_merges > 0 ? "three-way-common-base"
+                                             : "deterministic-record-order");
+  pending_sync_evidence_.Set("workspaceComparison",
+                             std::move(comparison_evidence));
+
+  const base::DictValue *index_record = winners.FindDict("workspace-index");
+  const base::DictValue *index =
+      index_record && !index_record->FindBool("deleted").value_or(false)
+          ? index_record->FindDict("value")
+          : nullptr;
+  const base::ListValue *profile_ids =
+      index ? index->FindList("profileIds") : nullptr;
+  const base::ListValue *workspace_ids =
+      index ? index->FindList("workspaceIds") : nullptr;
+  // The index is an advisory projection, not authority over authenticated
+  // workspace records. Android rebuilds it from the complete record set after
+  // every merge; treating one winning (possibly stale) index as authoritative
+  // made valid Android/legacy workspaces invisible on desktop.
+  std::vector<std::string> ordered_workspace_ids;
+  std::set<std::string> seen_workspace_ids;
+  auto append_workspace_id = [&](std::string id) {
+    if (!id.empty() && seen_workspace_ids.insert(id).second) {
+      ordered_workspace_ids.push_back(std::move(id));
+    }
+  };
+  if (workspace_ids) {
+    for (const base::Value &candidate : *workspace_ids) {
+      if (!candidate.is_string()) {
+        continue;
+      }
+      const std::string id = CleanText(&candidate.GetString(), 160);
+      const base::DictValue *record = winners.FindDict("workspace:" + id);
+      if (record && !record->FindBool("deleted").value_or(false) &&
+          record->FindDict("value")) {
+        append_workspace_id(id);
+      }
+    }
+  }
+  for (const auto [key, candidate] : winners) {
+    if (!key.starts_with("workspace:")) {
+      continue;
+    }
+    const base::DictValue &record = candidate.GetDict();
+    if (!record.FindBool("deleted").value_or(false) &&
+        record.FindDict("value")) {
+      std::string id(key.substr(std::string_view("workspace:").size()));
+      append_workspace_id(CleanText(&id, 160));
+    }
+  }
+  if (ordered_workspace_ids.empty()) {
+    pending_sync_evidence_.Set("mergeFailureStage", "no-live-workspace");
+    return false;
+  }
+
+  std::vector<std::string> ordered_profile_ids;
+  std::set<std::string> seen_profile_ids;
+  auto append_profile_id = [&](std::string id) {
+    if (!id.empty() && seen_profile_ids.insert(id).second) {
+      ordered_profile_ids.push_back(std::move(id));
+    }
+  };
+  if (profile_ids) {
+    for (const base::Value &candidate : *profile_ids) {
+      if (candidate.is_string()) {
+        append_profile_id(CleanText(&candidate.GetString(), 160));
+      }
+    }
+  }
+
+  std::map<std::string, std::string> local_active_tabs;
+  if (const base::ListValue *existing_spaces = organization.FindList("spaces")) {
+    for (const base::Value &candidate : *existing_spaces) {
+      const base::DictValue *space = candidate.GetIfDict();
+      const std::string id =
+          space ? CleanText(space->FindString("id"), 160) : std::string();
+      const std::string active =
+          space ? CleanText(space->FindString("activeTabId"), 160)
+                : std::string();
+      if (!id.empty() && !active.empty()) {
+        local_active_tabs.insert_or_assign(id, active);
+      }
+    }
+  }
+  base::ListValue spaces;
+  for (const std::string &id : ordered_workspace_ids) {
+    const base::DictValue *record = winners.FindDict("workspace:" + id);
+    const base::DictValue *value = record ? record->FindDict("value") : nullptr;
+    if (!value || record->FindBool("deleted").value_or(false)) {
+      continue;
+    }
+    base::DictValue workspace = value->Clone();
+    workspace.Remove("activeTabId");
+    if (auto local_active = local_active_tabs.find(id);
+        local_active != local_active_tabs.end()) {
+      bool survives = false;
+      for (std::string_view section : {"pinned", "today"}) {
+        if (const base::ListValue *tabs = workspace.FindList(section)) {
+          for (const base::Value &tab : *tabs) {
+            if (CleanText(tab.GetDict().FindString("id"), 160) ==
+                local_active->second) {
+              survives = true;
+              break;
+            }
+          }
+        }
+        if (survives) {
+          break;
+        }
+      }
+      if (survives) {
+        workspace.Set("activeTabId", local_active->second);
+      }
+    }
+    const std::string profile_id =
+        CleanText(workspace.FindString("profileId"), 160);
+    append_profile_id(profile_id.empty() ? "personal" : profile_id);
+    spaces.Append(std::move(workspace));
+  }
+  for (const auto [key, candidate] : winners) {
+    if (!key.starts_with("profile:")) {
+      continue;
+    }
+    const base::DictValue &record = candidate.GetDict();
+    if (!record.FindBool("deleted").value_or(false) &&
+        record.FindDict("value")) {
+      std::string id(key.substr(std::string_view("profile:").size()));
+      append_profile_id(CleanText(&id, 160));
+    }
+  }
+  append_profile_id("personal");
+
+  std::map<std::string, base::DictValue> current_profiles;
+  if (const base::ListValue *existing = organization.FindList("profiles")) {
+    for (const base::Value &candidate : *existing) {
+      const base::DictValue *profile = candidate.GetIfDict();
+      const std::string id =
+          profile ? CleanText(profile->FindString("id"), 160) : std::string();
+      if (!id.empty()) {
+        current_profiles.insert_or_assign(id, profile->Clone());
+      }
+    }
+  }
+  base::ListValue profiles;
+  for (const std::string &id : ordered_profile_ids) {
+    const base::DictValue *record = winners.FindDict("profile:" + id);
+    const base::DictValue *value =
+        record && !record->FindBool("deleted").value_or(false)
+            ? record->FindDict("value")
+            : nullptr;
+    base::DictValue profile;
+    if (value) {
+      profile = value->Clone();
+    } else if (auto current = current_profiles.find(id);
+               current != current_profiles.end()) {
+      profile = current->second.Clone();
+    } else {
+      profile.Set("id", id);
+      profile.Set("name", id == "personal" ? "Personal" : "Profile");
+      profile.Set("favorites", base::ListValue());
+    }
+    profile.Set("disabledExtensions", base::ListValue());
+    profiles.Append(std::move(profile));
+  }
+
+  // Which workspace is selected is device-local UI state. Importing a peer's
+  // last selection made ordinary Android activity throw a Mac window back to
+  // Personal and let a selection-only update republish stale workspace tabs.
+  std::string active_space_id =
+      CleanText(organization.FindString("activeSpaceId"), 160);
+  if (!seen_workspace_ids.contains(active_space_id)) {
+    active_space_id = ordered_workspace_ids.front();
+  }
+  organization.Set("profiles", std::move(profiles));
+  organization.Set("spaces", std::move(spaces));
+  organization.Set("activeSpaceId", active_space_id);
+  PrivacySafeOrganizationEvidence before_apply =
+      BuildPrivacySafeOrganizationEvidence(organization);
+  pending_sync_evidence_.Set("winningOrganizationBeforeApply",
+                             before_apply.value.Clone());
+
+  base::DictValue normalized_index;
+  base::ListValue normalized_profile_ids;
+  for (const std::string &id : ordered_profile_ids) {
+    normalized_profile_ids.Append(id);
+  }
+  base::ListValue normalized_workspace_ids;
+  for (const std::string &id : ordered_workspace_ids) {
+    normalized_workspace_ids.Append(id);
+  }
+  normalized_index.Set("profileIds", std::move(normalized_profile_ids));
+  normalized_index.Set("workspaceIds", std::move(normalized_workspace_ids));
+  const std::string normalized_hash =
+      ValueDigest(base::Value(normalized_index.Clone()));
+  const std::string existing_index_hash =
+      index_record ? CleanText(index_record->FindString("hash"), 64)
+                   : std::string();
+  if (normalized_hash != existing_index_hash) {
+    base::DictValue normalized_record;
+    normalized_record.Set("key", "workspace-index");
+    normalized_record.Set(
+        "revision",
+        index_record ? index_record->FindInt("revision").value_or(0) + 1 : 1);
+    normalized_record.Set("updatedAt",
+                          base::TimeFormatAsIso8601(base::Time::Now()));
+    normalized_record.Set("deviceId",
+                          device ? CleanText(device->FindString("id"), 80)
+                                 : std::string());
+    normalized_record.Set("deleted", false);
+    normalized_record.Set("hash", normalized_hash);
+    normalized_record.Set("value", std::move(normalized_index));
+    winners.Set("workspace-index", std::move(normalized_record));
+  }
+
+  BrowserWindowInterface *target_browser =
+      ProfileBrowserCollection::GetForProfile(profile_)->FindTabbedBrowser();
+  if (!target_browser) {
+    pending_sync_evidence_.Set("mergeFailureStage", "no-browser-window");
+    return false;
+  }
+  applying_remote_ = true;
+  const bool applied = store->ApplyOrganizationFromSync(
+      organization, target_browser, target_browser->GetTabStripModel());
+  applying_remote_ = false;
+  if (!applied) {
+    pending_sync_evidence_.Set("mergeFailureStage", "native-apply-rejected");
+    return false;
+  }
+  const base::DictValue exported_after_apply =
+      store->ExportOrganizationForSync();
+  PrivacySafeOrganizationEvidence after_apply =
+      BuildPrivacySafeOrganizationEvidence(exported_after_apply);
+  pending_sync_evidence_.Set("organizationAfterApply",
+                             after_apply.value.Clone());
+  // ApplyOrganizationFromSync owns ReconcileAndMaterialize synchronously, so
+  // the post-apply and post-reconcile snapshots intentionally share a digest.
+  // Recording both phase names makes that ownership explicit in physical
+  // evidence without adding a second mutation pass.
+  pending_sync_evidence_.Set("organizationAfterReconcile",
+                             after_apply.value.Clone());
+  pending_sync_evidence_.Set("nextOrganizationExport",
+                             after_apply.value.Clone());
+  pending_sync_evidence_.Set("applyIncludesReconcile", true);
+  pending_sync_evidence_.Set(
+      "syntheticCanaryStableIdRetained",
+      std::ranges::includes(after_apply.synthetic_canary_ids,
+                            before_apply.synthetic_canary_ids));
+  int synthetic_canary_renderer_count = 0;
+  for (int tab_index = 0;
+       tab_index < target_browser->GetTabStripModel()->count(); ++tab_index) {
+    const std::string tab_id = store->TabIdFor(
+        target_browser->GetTabStripModel()->GetWebContentsAt(tab_index));
+    if (before_apply.synthetic_canary_ids.contains(tab_id)) {
+      ++synthetic_canary_renderer_count;
+    }
+  }
+  pending_sync_evidence_.Set("syntheticCanaryRendererCount",
+                             synthetic_canary_renderer_count);
+  pending_sync_evidence_.Set(
+      "syntheticCanaryRendererDisposition",
+      synthetic_canary_renderer_count == 0
+          ? "intentionally-deferred"
+          : synthetic_canary_renderer_count == 1 ? "single"
+                                                  : "duplicate-error");
+  // Never acknowledge and republish a peer workspace that the native
+  // organization boundary failed to retain. Compare the canonical input to
+  // the canonical output: raw duplicate, invalid, and explicitly tombstoned
+  // rows are intentionally removed by the boundary and are not live tabs.
+  // Requiring those raw rows to survive falsely blocked every Mac upload.
+  std::optional<base::DictValue> canonical_expected =
+      ViolaOrganizationStore::NormalizeOrganizationForSync(organization);
+  if (!canonical_expected ||
+      !PreservesWorkspaceTabs(*canonical_expected, exported_after_apply)) {
+    pending_sync_evidence_.Set("retentionFencePassed", false);
+    pending_sync_evidence_.Set("mergeFailureStage", "stable-tab-retention");
+    return false;
+  }
+  pending_sync_evidence_.Set("retentionFencePassed", true);
+  pending_sync_evidence_.Set("mergeFailureStage", base::Value());
+  CompactHistoryRecords(winners);
+  ApplyHistoryRecords(winners);
+
+  base::DictValue metadata;
+  merged_records->clear();
+  for (const auto [key, value] : winners) {
+    const base::DictValue &record = value.GetDict();
+    base::DictValue record_metadata = record.Clone();
+    record_metadata.Remove("key");
+    record_metadata.Remove("value");
+    metadata.Set(key, std::move(record_metadata));
+    merged_records->Append(record.Clone());
+  }
+  base::DictValue manifest;
+  manifest.Set("version", 1);
+  manifest.Set("entities", std::move(metadata));
+  state_.Set("manifest", std::move(manifest));
+  pending_sync_evidence_.Set(
+      "nextUploadCandidate",
+      BuildPrivacySafeUploadEvidence(*merged_records));
+  return true;
+}
+
+void ViolaAccountSyncService::ApplyHistoryRecords(
+    const base::DictValue &winning_records) {
+  history::HistoryService *history_service =
+      HistoryServiceFactory::GetForProfile(profile_,
+                                           ServiceAccessType::EXPLICIT_ACCESS);
+  if (!history_service) {
+    return;
+  }
+  std::map<std::string, base::DictValue> newest_by_url;
+  for (const auto [key, candidate] : winning_records) {
+    if (!key.starts_with("history:")) {
+      continue;
+    }
+    const base::DictValue &record = candidate.GetDict();
+    const base::DictValue *value = !record.FindBool("deleted").value_or(false)
+                                       ? record.FindDict("value")
+                                       : nullptr;
+    const std::string url_text =
+        value ? CleanText(value->FindString("url"), 8192) : std::string();
+    const GURL url(url_text);
+    const std::optional<double> last =
+        value ? NumericField(*value, "last") : std::nullopt;
+    if (!value || !url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || !last ||
+        *last <= 0 || local_history_urls_.contains(url.spec())) {
+      continue;
+    }
+    auto existing = newest_by_url.find(url.spec());
+    if (existing == newest_by_url.end() ||
+        NumericField(existing->second, "last").value_or(0) < *last) {
+      newest_by_url.insert_or_assign(url.spec(), value->Clone());
+    }
+  }
+  history::URLRows rows;
+  rows.reserve(newest_by_url.size());
+  for (const auto &[url_text, value] : newest_by_url) {
+    history::URLRow row{GURL(url_text)};
+    std::string title = CleanText(value.FindString("title"), 4096);
+    row.set_title(base::UTF8ToUTF16(title.empty() ? url_text : title));
+    row.set_visit_count(
+        std::clamp(value.FindInt("visits").value_or(1), 1, 1000000));
+    row.set_typed_count(0);
+    row.set_last_visit(base::Time::FromMillisecondsSinceUnixEpoch(
+        NumericField(value, "last").value_or(0)));
+    row.set_hidden(false);
+    rows.push_back(std::move(row));
+  }
+  if (!rows.empty()) {
+    history_service->AddPagesWithDetails(
+        rows, history::VisitSource::SOURCE_OS_MIGRATION_IMPORTED);
+  }
+}
+
+std::optional<base::DictValue>
+ViolaAccountSyncService::EncryptPayload(const base::DictValue &payload,
+                                        base::span<const uint8_t> key) {
+  std::string plaintext;
+  if (key.size() != 32 || !base::JSONWriter::Write(payload, &plaintext)) {
+    return std::nullopt;
+  }
+  std::vector<uint8_t> nonce = base::RandBytesAsVector(12);
+  std::vector<uint8_t> ciphertext = crypto::aead::Seal(
+      crypto::aead::AES_256_GCM, key, base::as_byte_span(plaintext), nonce,
+      base::as_byte_span(std::string_view(kPayloadAad)));
+  if (ciphertext.size() < 16) {
+    return std::nullopt;
+  }
+  const size_t content_size = ciphertext.size() - 16;
+  base::DictValue envelope;
+  envelope.Set("type", kEncryptedSnapshotType);
+  envelope.Set("version", 1);
+  envelope.Set("payloadType", kSyncPayloadType);
+  envelope.Set("accountId", CleanText(payload.FindString("accountId"), 80));
+  envelope.Set("deviceId", CleanText(payload.FindString("deviceId"), 80));
+  envelope.Set("revision", payload.FindInt("revision").value_or(0));
+  envelope.Set("generatedAt", CleanText(payload.FindString("generatedAt"), 40));
+  envelope.Set("cipher", "aes-256-gcm");
+  envelope.Set("iv", base::Base64Encode(nonce));
+  envelope.Set(
+      "tag", base::Base64Encode(base::span(ciphertext).subspan(content_size)));
+  envelope.Set("ciphertext",
+               base::Base64Encode(base::span(ciphertext).first(content_size)));
+  return envelope;
+}
+
+std::optional<base::DictValue>
+ViolaAccountSyncService::DecryptEnvelope(const base::DictValue &envelope,
+                                         base::span<const uint8_t> key) {
+  const std::string *type = envelope.FindString("type");
+  const std::string *payload_type = envelope.FindString("payloadType");
+  const std::string *cipher = envelope.FindString("cipher");
+  std::optional<std::vector<uint8_t>> nonce =
+      DecodeBase64Field(envelope, "iv", 12);
+  std::optional<std::vector<uint8_t>> tag =
+      DecodeBase64Field(envelope, "tag", 16);
+  const std::string *encoded_ciphertext = envelope.FindString("ciphertext");
+  std::optional<std::vector<uint8_t>> ciphertext =
+      encoded_ciphertext ? base::Base64Decode(*encoded_ciphertext)
+                         : std::nullopt;
+  if (!type || *type != kEncryptedSnapshotType ||
+      envelope.FindInt("version") != 1 || !payload_type ||
+      *payload_type != kSyncPayloadType || !cipher ||
+      *cipher != "aes-256-gcm" || key.size() != 32 || !nonce || !tag ||
+      !ciphertext || ciphertext->size() > kMaximumStateBytes) {
+    return std::nullopt;
+  }
+  ciphertext->insert(ciphertext->end(), tag->begin(), tag->end());
+  std::optional<std::vector<uint8_t>> plaintext =
+      crypto::aead::Open(crypto::aead::AES_256_GCM, key, *ciphertext, *nonce,
+                         base::as_byte_span(std::string_view(kPayloadAad)));
+  std::optional<base::Value> parsed =
+      plaintext ? base::JSONReader::Read(base::as_string_view(*plaintext),
+                                         base::JSON_PARSE_RFC)
+                : std::nullopt;
+  if (!parsed || !parsed->is_dict()) {
+    return std::nullopt;
+  }
+  base::DictValue payload = std::move(*parsed).TakeDict();
+  const std::string *inner_type = payload.FindString("type");
+  const std::string inner_generated_at =
+      CleanText(payload.FindString("generatedAt"), 40);
+  const std::string outer_generated_at =
+      CleanText(envelope.FindString("generatedAt"), 40);
+  base::Time inner_generated_time;
+  base::Time outer_generated_time;
+  const bool generated_times_match =
+      (!inner_generated_at.empty() && !outer_generated_at.empty() &&
+       inner_generated_at == outer_generated_at) ||
+      (base::Time::FromString(inner_generated_at.c_str(),
+                              &inner_generated_time) &&
+       base::Time::FromString(outer_generated_at.c_str(),
+                              &outer_generated_time) &&
+       inner_generated_time == outer_generated_time);
+  if (!inner_type || *inner_type != kSyncPayloadType ||
+      payload.FindInt("version") != 1 || !payload.FindList("records") ||
+      CleanText(payload.FindString("accountId"), 80) !=
+          CleanText(envelope.FindString("accountId"), 80) ||
+      CleanText(payload.FindString("deviceId"), 80) !=
+          CleanText(envelope.FindString("deviceId"), 80) ||
+      payload.FindInt("revision") != envelope.FindInt("revision") ||
+      !generated_times_match) {
+    return std::nullopt;
+  }
+  // The service normalizes RFC3339 timestamps at its opaque storage edge.
+  // Preserve exact outer/inner binding by accepting only equal instants, then
+  // use the server-returned representation for record metadata fallbacks.
+  payload.Set("generatedAt", outer_generated_at);
+  return payload;
+}
+
+void ViolaAccountSyncService::SyncNow() {
+  if (syncing_) {
+    sync_again_ = true;
+    return;
+  }
+  if (!loaded_ || !state_.FindDict("account")) {
+    return;
+  }
+  std::optional<base::DictValue> secrets = UnprotectSecrets();
+  if (!secrets) {
+    state_.Set("connection", ProtectedTransportUnavailableConnection(
+                                 state_.FindDict("connection")));
+    ScheduleWrite();
+    return;
+  }
+  syncing_ = true;
+  // This generation is the highest mutation the forthcoming projection may
+  // acknowledge. A tab can finish navigating while history, pull, encryption,
+  // upload, or echo verification is in flight; acknowledging the live Boolean
+  // at the end could erase that newer edit before it is ever serialized.
+  active_sync_local_mutation_generation_ = local_mutation_generation_;
+  local_history_entities_.clear();
+  local_history_urls_.clear();
+  history::HistoryService *history_service =
+      HistoryServiceFactory::GetForProfile(profile_,
+                                           ServiceAccessType::EXPLICIT_ACCESS);
+  if (history_service) {
+    history::QueryOptions options;
+    options.max_count = 8000;
+    options.duplicate_policy = history::QueryOptions::REMOVE_ALL_DUPLICATES;
+    options.visit_order = history::QueryOptions::RECENT_FIRST;
+    options.policy_for_404_visits = history::VisitQuery404sPolicy::kExclude404s;
+    history_service->QueryHistory(
+        std::u16string(), std::move(options),
+        base::BindOnce(&ViolaAccountSyncService::OnLocalHistoryReady,
+                       weak_factory_.GetWeakPtr()),
+        &history_task_tracker_);
+    return;
+  }
+  StartSnapshotPull();
+}
+
+void ViolaAccountSyncService::PollForChanges() {
+  if (syncing_) {
+    return;
+  }
+  if (!loaded_ || !state_.FindDict("account")) {
+    return;
+  }
+  std::optional<base::DictValue> secrets = UnprotectSecrets();
+  if (!secrets) {
+    state_.Set("connection", ProtectedTransportUnavailableConnection(
+                                 state_.FindDict("connection")));
+    ScheduleWrite();
+    return;
+  }
+  if (local_dirty_) {
+    SyncNow();
+    return;
+  }
+  syncing_ = true;
+  StartJsonRequest(
+      "GET", "/v1/sync/changes?after=" + base::NumberToString(sync_base_cursor_) +
+                 "&wait=0",
+      CleanText(secrets->FindString("sessionToken"), 100), {},
+      base::BindOnce(&ViolaAccountSyncService::OnChanges,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void ViolaAccountSyncService::OnChanges(bool success,
+                                        base::DictValue response,
+                                        std::string error) {
+  const std::optional<double> cursor = NumericField(response, "cursor");
+  const base::DictValue *device = state_.FindDict("device");
+  const std::string device_id =
+      device ? CleanText(device->FindString("id"), 80) : std::string();
+  bool peer_changed = false;
+  if (success && cursor && *cursor >= 0 && *cursor <= 9007199254740991.0 &&
+      std::floor(*cursor) == *cursor) {
+    if (const base::ListValue *events = response.FindList("events")) {
+      for (const base::Value &candidate : *events) {
+        const base::DictValue *event = candidate.GetIfDict();
+        if (event && CleanText(event->FindString("deviceId"), 80) != device_id) {
+          peer_changed = true;
+          break;
+        }
+      }
+    }
+    sync_base_cursor_ = std::max(sync_base_cursor_, static_cast<int64_t>(*cursor));
+  }
+  syncing_ = false;
+  if (local_dirty_ || peer_changed) {
+    SyncNow();
+    return;
+  }
+  if (!success) {
+    base::DictValue connection;
+    connection.Set("connected", false);
+    connection.Set("lastError", error.empty() ? "Viola could not check for peer changes."
+                                               : error);
+    connection.Set("lastSyncedAt", base::Value());
+    state_.Set("connection", std::move(connection));
+    ScheduleWrite();
+  }
+  if (state_.FindDict("account")) {
+    sync_timer_.Start(FROM_HERE, base::Seconds(2), this,
+                      success ? &ViolaAccountSyncService::PollForChanges
+                              : &ViolaAccountSyncService::SyncNow);
+  }
+}
+
+void ViolaAccountSyncService::OnLocalHistoryReady(
+    history::QueryResults results) {
+  ViolaOrganizationStore *store = ViolaOrganizationStore::Get(profile_);
+  const std::string profile_id =
+      store && store->loaded()
+          ? ActiveLogicalProfileId(store->ExportOrganizationForSync())
+          : std::string();
+  if (!profile_id.empty()) {
+    for (const history::URLResult &row : results) {
+      if (!row.url().is_valid() || !row.url().SchemeIsHTTPOrHTTPS() ||
+          row.last_visit().is_null()) {
+        continue;
+      }
+      const std::string url = row.url().spec();
+      local_history_urls_.insert(url);
+      const double last =
+          static_cast<double>(row.last_visit().InMillisecondsSinceUnixEpoch());
+      base::DictValue value;
+      value.Set("url", url);
+      const std::string raw_title = base::UTF16ToUTF8(row.title());
+      const std::string title = CleanText(&raw_title, 4096);
+      value.Set("title", title.empty() ? url : title);
+      value.Set("favicon", base::Value());
+      value.Set("profileId", profile_id);
+      value.Set("visits", std::clamp(row.visit_count(), 1, 1000000));
+      value.Set("first", last);
+      value.Set("last", last);
+      base::ListValue recent;
+      recent.Append(last);
+      value.Set("recent", std::move(recent));
+      local_history_entities_.Set(HistoryRecordKey(profile_id, url),
+                                  std::move(value));
+    }
+  }
+  StartSnapshotPull();
+}
+
+void ViolaAccountSyncService::StartSnapshotPull() {
+  std::optional<base::DictValue> secrets = UnprotectSecrets();
+  if (!secrets) {
+    syncing_ = false;
+    return;
+  }
+  StartJsonRequest("GET", "/v1/account",
+                   CleanText(secrets->FindString("sessionToken"), 100), {},
+                   base::BindOnce(&ViolaAccountSyncService::OnSessionIdentity,
+                                  weak_factory_.GetWeakPtr()));
+}
+
+void ViolaAccountSyncService::OnSessionIdentity(bool success,
+                                                base::DictValue response,
+                                                std::string error) {
+  std::optional<base::DictValue> secrets = UnprotectSecrets();
+  const base::DictValue *local_account = state_.FindDict("account");
+  const base::DictValue *local_device = state_.FindDict("device");
+  const base::DictValue *remote_account = response.FindDict("account");
+  const bool account_matches =
+      local_account && remote_account &&
+      CleanText(local_account->FindString("id"), 80) ==
+          CleanText(remote_account->FindString("id"), 80);
+  const bool device_matches =
+      local_device &&
+      CleanText(local_device->FindString("id"), 80) ==
+          CleanText(response.FindString("deviceId"), 80);
+  if (!success || !secrets || !account_matches || !device_matches) {
+    base::DictValue evidence;
+    evidence.Set("schemaVersion", 1);
+    evidence.Set("capturedAt",
+                 base::TimeFormatAsIso8601(base::Time::Now()));
+    evidence.Set("sessionIdentityValidated", false);
+    evidence.Set("accountIdentityMatched", account_matches);
+    evidence.Set("deviceIdentityMatched", device_matches);
+    evidence.Set("uploadAccepted", false);
+    base::DictValue connection;
+    connection.Set("connected", false);
+    connection.Set(
+        "lastError",
+        success ? "Viola's saved sync identity no longer matches this "
+                  "session. Sign in again; local browser data was not changed."
+                : (error.empty() ? "Viola could not validate this sync session."
+                                 : error));
+    connection.Set("lastSyncedAt", base::Value());
+    connection.Set("privacySafeEvidence", std::move(evidence));
+    state_.Set("connection", std::move(connection));
+    syncing_ = false;
+    ScheduleWrite();
+    if (state_.FindDict("account")) {
+      sync_timer_.Start(FROM_HERE, base::Seconds(2), this,
+                        &ViolaAccountSyncService::SyncNow);
+    }
+    return;
+  }
+  const std::string token =
+      CleanText(secrets->FindString("sessionToken"), 100);
+  if (writer_claimed_) {
+    StartJsonRequest("GET", "/v1/sync/snapshots", token, {},
+                     base::BindOnce(&ViolaAccountSyncService::OnSnapshots,
+                                    weak_factory_.GetWeakPtr()));
+    return;
+  }
+  base::DictValue writer;
+  writer.Set("writerInstanceId", writer_instance_id_);
+  StartJsonRequest("POST", "/v1/sync/writer", token, std::move(writer),
+                   base::BindOnce(&ViolaAccountSyncService::OnWriterClaimed,
+                                  weak_factory_.GetWeakPtr()));
+}
+
+void ViolaAccountSyncService::OnWriterClaimed(bool success,
+                                              base::DictValue response,
+                                              std::string error) {
+  std::optional<base::DictValue> secrets = UnprotectSecrets();
+  if (!success || !secrets ||
+      CleanText(response.FindString("writerInstanceId"), 80) !=
+          writer_instance_id_) {
+    base::DictValue connection;
+    connection.Set("connected", false);
+    connection.Set("lastError",
+                   error.empty() ? "Viola could not claim this device's sync writer."
+                                 : error);
+    connection.Set("lastSyncedAt", base::Value());
+    state_.Set("connection", std::move(connection));
+    syncing_ = false;
+    ScheduleWrite();
+    sync_timer_.Start(FROM_HERE, base::Seconds(2), this,
+                      &ViolaAccountSyncService::SyncNow);
+    return;
+  }
+  writer_claimed_ = true;
+  StartJsonRequest("GET", "/v1/sync/snapshots",
+                   CleanText(secrets->FindString("sessionToken"), 100), {},
+                   base::BindOnce(&ViolaAccountSyncService::OnSnapshots,
+                                  weak_factory_.GetWeakPtr()));
+}
+
+void ViolaAccountSyncService::OnSnapshots(bool success,
+                                          base::DictValue response,
+                                          std::string error) {
+  std::optional<base::DictValue> secrets = UnprotectSecrets();
+  const base::DictValue *account = state_.FindDict("account");
+  const base::DictValue *device = state_.FindDict("device");
+  std::optional<std::vector<uint8_t>> key =
+      secrets ? base::Base64Decode(CleanText(secrets->FindString("key"), 100))
+              : std::nullopt;
+  if (!success || !secrets || !account || !device || !key ||
+      key->size() != 32) {
+    base::DictValue connection;
+    connection.Set("connected", false);
+    connection.Set("lastError",
+                   error.empty() ? "Encrypted sync failed." : error);
+    connection.Set("lastSyncedAt", base::Value());
+    state_.Set("connection", std::move(connection));
+    syncing_ = false;
+    ScheduleWrite();
+    if (state_.FindDict("account")) {
+      sync_timer_.Start(FROM_HERE, base::Seconds(2), this,
+                        &ViolaAccountSyncService::SyncNow);
+    }
+    return;
+  }
+  const std::string account_id = CleanText(account->FindString("id"), 80);
+  const std::string current_device_id = CleanText(device->FindString("id"), 80);
+  const std::optional<double> cursor = NumericField(response, "cursor");
+  if (!cursor || *cursor < 0 || *cursor > 9007199254740991.0 ||
+      std::floor(*cursor) != *cursor) {
+    base::DictValue connection;
+    connection.Set("connected", false);
+    connection.Set("lastError",
+                   "Viola received an invalid sync generation and did not upload.");
+    connection.Set("lastSyncedAt", base::Value());
+    state_.Set("connection", std::move(connection));
+    syncing_ = false;
+    ScheduleWrite();
+    sync_timer_.Start(FROM_HERE, base::Seconds(2), this,
+                      &ViolaAccountSyncService::SyncNow);
+    return;
+  }
+  sync_base_cursor_ = static_cast<int64_t>(*cursor);
+  base::ListValue remote_records;
+  std::map<std::string, std::string> next_remote_presence;
+  const base::ListValue *snapshots = response.FindList("snapshots");
+  size_t peer_snapshots = 0;
+  size_t decrypted_peer_snapshots = 0;
+  size_t peer_workspace_candidates = 0;
+  size_t accepted_peer_workspace_records = 0;
+  int max_seen_own_envelope_revision =
+      state_.FindInt("syncRevision").value_or(0);
+  if (snapshots) {
+    size_t count = 0;
+    for (const base::Value &candidate : *snapshots) {
+      const base::DictValue *envelope = candidate.GetIfDict();
+      if (!envelope || count++ >= 100 ||
+          CleanText(envelope->FindString("accountId"), 80) != account_id) {
+        continue;
+      }
+      const bool peer_snapshot =
+          CleanText(envelope->FindString("deviceId"), 80) != current_device_id;
+      if (peer_snapshot) {
+        ++peer_snapshots;
+      }
+      std::optional<base::DictValue> payload = DecryptEnvelope(*envelope, *key);
+      if (!payload ||
+          CleanText(payload->FindString("accountId"), 80) != account_id) {
+        continue;
+      }
+      if (!peer_snapshot) {
+        max_seen_own_envelope_revision =
+            std::max(max_seen_own_envelope_revision,
+                     payload->FindInt("revision").value_or(0));
+      }
+      if (peer_snapshot) {
+        ++decrypted_peer_snapshots;
+        const base::DictValue *presence = payload->FindDict("presence");
+        const std::string platform =
+            CleanText(presence ? presence->FindString("platform") : nullptr, 32);
+        const base::ListValue *active_ids =
+            presence ? presence->FindList("activeTabIds") : nullptr;
+        if (active_ids) {
+          size_t presence_count = 0;
+          for (const base::Value &candidate_id : *active_ids) {
+            if (presence_count++ >= 32 || !candidate_id.is_string()) {
+              break;
+            }
+            const std::string tab_id = CleanText(&candidate_id.GetString(), 160);
+            if (!tab_id.empty()) {
+              next_remote_presence.insert_or_assign(
+                  tab_id, platform == "android" ? "mobile" : "desktop");
+            }
+          }
+        }
+      }
+      if (const base::ListValue *records = payload->FindList("records")) {
+        size_t snapshot_record_count = 0;
+        for (const base::Value &record : *records) {
+          // The endpoint returns one independently bounded envelope per
+          // device. Applying this ceiling to the aggregate made the result
+          // depend on server ordering once several devices each carried a
+          // large history manifest: later Android workspace records were
+          // never considered. Keep the abuse bound per authenticated device.
+          if (snapshot_record_count++ >= 20000) {
+            break;
+          }
+          const base::DictValue *raw = record.GetIfDict();
+          if (!raw) {
+            continue;
+          }
+          const std::string raw_key = CleanText(raw->FindString("key"), 240);
+          if (peer_snapshot && raw_key.starts_with("workspace:")) {
+            ++peer_workspace_candidates;
+          }
+          std::optional<base::DictValue> normalized =
+              NormalizeAuthenticatedRecord(
+                  *raw, CleanText(payload->FindString("deviceId"), 80),
+                  CleanText(payload->FindString("generatedAt"), 40));
+          if (!normalized) {
+            continue;
+          }
+          if (peer_snapshot && raw_key.starts_with("workspace:")) {
+            ++accepted_peer_workspace_records;
+          }
+          remote_records.Append(std::move(*normalized));
+        }
+      }
+    }
+  }
+  if (next_remote_presence != remote_presence_by_tab_) {
+    remote_presence_by_tab_ = std::move(next_remote_presence);
+    ++remote_presence_generation_;
+  }
+  pending_sync_evidence_.clear();
+  pending_sync_evidence_.Set("schemaVersion", 1);
+  pending_sync_evidence_.Set("sessionIdentityValidated", true);
+  pending_sync_evidence_.Set("capturedAt",
+                             base::TimeFormatAsIso8601(base::Time::Now()));
+  pending_sync_evidence_.Set("peerSnapshotsSeen",
+                             static_cast<int>(peer_snapshots));
+  pending_sync_evidence_.Set("peerSnapshotsAuthenticated",
+                             static_cast<int>(decrypted_peer_snapshots));
+  pending_sync_evidence_.Set("peerWorkspaceRecordsEncountered",
+                             static_cast<int>(peer_workspace_candidates));
+  pending_sync_evidence_.Set(
+      "peerWorkspaceRecordsAccepted",
+      static_cast<int>(accepted_peer_workspace_records));
+  if ((peer_snapshots > 0 && decrypted_peer_snapshots == 0) ||
+      (peer_workspace_candidates > 0 && accepted_peer_workspace_records == 0)) {
+    base::DictValue connection;
+    connection.Set("connected", false);
+    connection.Set(
+        "lastError",
+        "Viola received peer workspace state but could not authenticate it. "
+        "Local state was not uploaded.");
+    connection.Set("lastSyncedAt", base::Value());
+    connection.Set("peerSnapshotsSeen", static_cast<int>(peer_snapshots));
+    connection.Set("peerSnapshotsDecrypted",
+                   static_cast<int>(decrypted_peer_snapshots));
+    connection.Set("peerWorkspaceRecordsAccepted",
+                   static_cast<int>(accepted_peer_workspace_records));
+    state_.Set("connection", std::move(connection));
+    syncing_ = false;
+    ScheduleWrite();
+    sync_timer_.Start(FROM_HERE, base::Seconds(2), this,
+                      &ViolaAccountSyncService::SyncNow);
+    return;
+  }
+  ViolaOrganizationStore *store = ViolaOrganizationStore::Get(profile_);
+  const bool first_link = !state_.FindDict("manifest");
+  base::DictValue local_organization = store && store->loaded()
+                                           ? store->ExportOrganizationForSync()
+                                           : base::DictValue();
+  // Re-linking an existing account is a restore boundary, not a fresh local
+  // enrollment. If authenticated server records exist, serialize this Mac's
+  // cache as an initial seed (revision 1 at the epoch) so those records or
+  // tombstones win every overlapping key. Local-only keys still survive the
+  // ordinary record union. Local preference is permitted only for a genuinely
+  // empty account.
+  const bool prefer_populated_local_seed =
+      ShouldPreferLocalFirstLinkSeedForTesting(
+          first_link, remote_records.empty(),
+          OrganizationHasUserState(local_organization));
+  const bool defer_authenticated_local_seed =
+      first_link && !remote_records.empty();
+  base::ListValue local_records =
+      store && store->loaded()
+          ? BuildLocalRecords(local_organization, defer_authenticated_local_seed,
+                              first_link || local_dirty_)
+          : base::ListValue();
+  base::ListValue merged_records;
+  if (local_records.empty() && remote_records.empty()) {
+    pending_sync_evidence_.Set("mergeFailureStage", "no-records");
+  }
+  const bool merged =
+      (!local_records.empty() || !remote_records.empty()) &&
+      MergeAndApplyRecords(remote_records, std::move(local_records),
+                           prefer_populated_local_seed, &merged_records);
+  if (!merged) {
+    base::DictValue connection;
+    connection.Set("connected", false);
+    connection.Set("lastError",
+                   "Viola could not merge encrypted workspace state.");
+    connection.Set("lastSyncedAt", base::Value());
+    connection.Set("privacySafeEvidence", pending_sync_evidence_.Clone());
+    state_.Set("connection", std::move(connection));
+    syncing_ = false;
+    ScheduleWrite();
+    if (state_.FindDict("account")) {
+      sync_timer_.Start(FROM_HERE, base::Seconds(2), this,
+                        &ViolaAccountSyncService::SyncNow);
+    }
+    return;
+  }
+  // A peer pull is not a local edit. Echoing the merged remote union from every
+  // device advances otherwise-identical envelopes forever and turns the
+  // two-second change feed into a full-snapshot ping-pong. Only first-link
+  // enrollment or an organization mutation authored on this Mac may publish.
+  const bool upload_required = first_link || local_dirty_;
+  if (!upload_required) {
+    pending_sync_evidence_.Set("uploadAccepted", true);
+    pending_sync_evidence_.Set("uploadSkippedNoChanges", true);
+    pending_sync_evidence_.Set("serverEchoVerified", true);
+    pending_sync_evidence_.Set("completedAt",
+                               base::TimeFormatAsIso8601(base::Time::Now()));
+    base::DictValue connection;
+    connection.Set("connected", true);
+    connection.Set("lastError", base::Value());
+    connection.Set("lastSyncedAt",
+                   base::TimeFormatAsIso8601(base::Time::Now()));
+    connection.Set("privacySafeEvidence", pending_sync_evidence_.Clone());
+    state_.Set("connection", std::move(connection));
+    syncing_ = false;
+    ScheduleWrite();
+    const bool replay_local = sync_again_ || local_dirty_;
+    sync_again_ = false;
+    sync_timer_.Start(
+        FROM_HERE,
+        replay_local ? base::Milliseconds(100) : base::Seconds(2), this,
+        replay_local ? &ViolaAccountSyncService::SyncNow
+                     : &ViolaAccountSyncService::PollForChanges);
+    return;
+  }
+  const int revision = max_seen_own_envelope_revision + 1;
+  const std::string generated_at = base::TimeFormatAsIso8601(base::Time::Now());
+  base::DictValue payload;
+  payload.Set("type", kSyncPayloadType);
+  payload.Set("version", 1);
+  payload.Set("accountId", account_id);
+  payload.Set("deviceId", CleanText(device->FindString("id"), 80));
+  payload.Set("revision", revision);
+  payload.Set("generatedAt", generated_at);
+  base::DictValue presence;
+  presence.Set("platform", kPlatformId);
+  presence.Set("activeTabIds", BuildActiveTabPresence());
+  payload.Set("presence", std::move(presence));
+  payload.Set("records", std::move(merged_records));
+  std::optional<base::DictValue> envelope = EncryptPayload(payload, *key);
+  if (!envelope) {
+    syncing_ = false;
+    return;
+  }
+  state_.Set("syncRevision", revision);
+  envelope->Set("writerInstanceId", writer_instance_id_);
+  envelope->Set("baseCursor", static_cast<double>(sync_base_cursor_));
+  // The server rejects protocol-less native clients that predate the
+  // pull-authoritative relink fence. This capability is deliberately outside
+  // the ciphertext so the zero-knowledge service can reject an unsafe writer
+  // without inspecting workspace data.
+  envelope->Set("clientProtocolVersion", kClientProtocolVersion);
+  pending_upload_revision_ = revision;
+  pending_upload_local_mutation_generation_ =
+      active_sync_local_mutation_generation_;
+  pending_upload_generated_at_ = generated_at;
+  pending_upload_organization_digest_.clear();
+  if (const base::DictValue *next =
+          pending_sync_evidence_.FindDict("nextOrganizationExport")) {
+    pending_upload_organization_digest_ =
+        CleanText(next->FindString("organizationDigest"), 64);
+  }
+  StartJsonRequest(
+      "PUT", "/v1/sync/snapshots/" + CleanText(device->FindString("id"), 80),
+      CleanText(secrets->FindString("sessionToken"), 100), std::move(*envelope),
+      base::BindOnce(&ViolaAccountSyncService::OnSnapshotUploaded,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void ViolaAccountSyncService::OnSnapshotUploaded(bool success,
+                                                 base::DictValue response,
+                                                 std::string error) {
+  const std::string conflict_code =
+      CleanText(response.FindString("code"), 80);
+  const bool writer_ownership_lost =
+      !success && (conflict_code == "writer-fenced" ||
+                   conflict_code == "writer-unclaimed");
+  if (writer_ownership_lost) {
+    // A newer legitimate Viola process can claim this device after an app
+    // restart or update. Do not leave this still-running process permanently
+    // fenced by its process-local claim cache: the next cycle must validate
+    // the session, claim again, pull the current same-device envelope, and
+    // publish only against that fresh generation witness.
+    writer_claimed_ = false;
+  }
+  pending_sync_evidence_.Set("uploadAccepted", success);
+  if (success) {
+    const std::optional<double> cursor = NumericField(response, "generation");
+    if (!cursor || *cursor < 0 || *cursor > 9007199254740991.0 ||
+        std::floor(*cursor) != *cursor) {
+      success = false;
+      error = "Viola could not verify the accepted sync generation.";
+    } else {
+      pending_upload_cursor_ = static_cast<int64_t>(*cursor);
+    }
+    std::optional<base::DictValue> secrets = UnprotectSecrets();
+    if (success && secrets) {
+      const base::DictValue *device = state_.FindDict("device");
+      const std::string device_id =
+          device ? CleanText(device->FindString("id"), 80) : std::string();
+      StartJsonRequest("GET", "/v1/sync/snapshots/" + device_id,
+                       CleanText(secrets->FindString("sessionToken"), 100), {},
+                       base::BindOnce(&ViolaAccountSyncService::OnSnapshotEcho,
+                                      weak_factory_.GetWeakPtr()));
+      return;
+    }
+    success = false;
+    error = "Viola could not verify its protected sync upload.";
+  }
+  pending_sync_evidence_.Set("serverEchoVerified", false);
+  pending_sync_evidence_.Set("visibleOrganizationDigestMatched", false);
+  pending_sync_evidence_.Set("completedAt",
+                             base::TimeFormatAsIso8601(base::Time::Now()));
+  base::DictValue connection;
+  connection.Set("connected", success);
+  connection.Set("lastError",
+                 success ? base::Value()
+                         : base::Value(error.empty()
+                                           ? "Encrypted snapshot upload failed."
+                                           : error));
+  connection.Set("lastSyncedAt",
+                 success
+                     ? base::Value(base::TimeFormatAsIso8601(base::Time::Now()))
+                     : base::Value());
+  connection.Set("privacySafeEvidence", pending_sync_evidence_.Clone());
+  state_.Set("connection", std::move(connection));
+  syncing_ = false;
+  ScheduleWrite();
+  if (sync_again_) {
+    sync_again_ = false;
+    sync_timer_.Start(FROM_HERE, base::Milliseconds(100), this,
+                      &ViolaAccountSyncService::SyncNow);
+  } else if (state_.FindDict("account")) {
+    sync_timer_.Start(
+        FROM_HERE,
+        writer_ownership_lost ? base::Milliseconds(100) : base::Seconds(2),
+        this, &ViolaAccountSyncService::SyncNow);
+  }
+}
+
+void ViolaAccountSyncService::OnSnapshotEcho(bool success,
+                                             base::DictValue response,
+                                             std::string error) {
+  const base::DictValue *device = state_.FindDict("device");
+  const std::string device_id =
+      device ? CleanText(device->FindString("id"), 80) : std::string();
+  bool echoed = false;
+  bool generation_current = false;
+  if (success) {
+    const std::optional<double> cursor = NumericField(response, "cursor");
+    generation_current = cursor && *cursor >= 0 &&
+                         *cursor <= 9007199254740991.0 &&
+                         std::floor(*cursor) == *cursor &&
+                         pending_upload_cursor_ >= 0 &&
+                         static_cast<int64_t>(*cursor) >= pending_upload_cursor_;
+    if (generation_current) {
+      sync_base_cursor_ =
+          std::max(sync_base_cursor_, static_cast<int64_t>(*cursor));
+    }
+    if (const base::DictValue *envelope = response.FindDict("snapshot")) {
+      if (CleanText(envelope->FindString("deviceId"), 80) == device_id &&
+          envelope->FindInt("revision").value_or(-1) ==
+              pending_upload_revision_ &&
+          CleanText(envelope->FindString("generatedAt"), 40) ==
+              pending_upload_generated_at_) {
+        echoed = true;
+      }
+    }
+    if (const base::ListValue *snapshots = response.FindList("snapshots")) {
+      for (const base::Value &candidate : *snapshots) {
+        const base::DictValue *envelope = candidate.GetIfDict();
+        if (envelope &&
+            CleanText(envelope->FindString("deviceId"), 80) == device_id &&
+            envelope->FindInt("revision").value_or(-1) ==
+                pending_upload_revision_ &&
+            CleanText(envelope->FindString("generatedAt"), 40) ==
+                pending_upload_generated_at_) {
+          echoed = true;
+          break;
+        }
+      }
+    }
+  }
+  ViolaOrganizationStore *store = ViolaOrganizationStore::Get(profile_);
+  const std::string visible_digest =
+      store && store->loaded()
+          ? ValueDigest(base::Value(store->ExportOrganizationForSync()))
+          : std::string();
+  const bool visible_matches =
+      !pending_upload_organization_digest_.empty() &&
+      visible_digest == pending_upload_organization_digest_;
+  pending_sync_evidence_.Set("serverEchoVerified", echoed);
+  pending_sync_evidence_.Set("serverGenerationCurrent", generation_current);
+  pending_sync_evidence_.Set("visibleOrganizationDigestMatched",
+                             visible_matches);
+  pending_sync_evidence_.Set("completedAt",
+                             base::TimeFormatAsIso8601(base::Time::Now()));
+  const bool upload_verified = success && echoed && generation_current;
+  if (upload_verified) {
+    acknowledged_local_mutation_generation_ = std::max(
+        acknowledged_local_mutation_generation_,
+        pending_upload_local_mutation_generation_);
+    state_.Set("acknowledgedLocalMutationGeneration",
+               acknowledged_local_mutation_generation_);
+    local_dirty_ =
+        local_mutation_generation_ > acknowledged_local_mutation_generation_;
+  }
+  base::DictValue connection;
+  connection.Set("connected", upload_verified);
+  connection.Set(
+      "lastError",
+      upload_verified
+          ? base::Value()
+          : base::Value(!success
+                            ? (error.empty() ? "Viola could not read back its sync upload."
+                                             : error)
+                            : !echoed
+                                  ? "Viola's uploaded snapshot was not visible on read-back."
+                                  : "A peer changed workspace state during verification; retrying."));
+  connection.Set("lastSyncedAt",
+                 upload_verified
+                     ? base::Value(base::TimeFormatAsIso8601(base::Time::Now()))
+                     : base::Value());
+  connection.Set("privacySafeEvidence", pending_sync_evidence_.Clone());
+  state_.Set("connection", std::move(connection));
+  pending_upload_revision_ = 0;
+  pending_upload_cursor_ = -1;
+  pending_upload_local_mutation_generation_ = 0;
+  pending_upload_generated_at_.clear();
+  pending_upload_organization_digest_.clear();
+  syncing_ = false;
+  ScheduleWrite();
+  const bool replay_local = sync_again_ || local_dirty_;
+  sync_again_ = false;
+  if (replay_local) {
+    sync_timer_.Start(FROM_HERE, base::Milliseconds(100), this,
+                      &ViolaAccountSyncService::SyncNow);
+  } else if (state_.FindDict("account")) {
+    // Local organization changes already request an immediate pass. Poll healthy peers on
+    // the same short convergence cadence so remote creates, closes, and ordering mutations
+    // do not remain stale for a full 30-second interval.
+    sync_timer_.Start(FROM_HERE, base::Seconds(2), this,
+                      &ViolaAccountSyncService::PollForChanges);
+  }
+}
+
+void ViolaAccountSyncService::StartJsonRequest(std::string method,
+                                               std::string path,
+                                               std::string token,
+                                               base::DictValue body,
+                                               JsonRequestCallback callback) {
+  static constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+      net::DefineNetworkTrafficAnnotation("viola_encrypted_account_sync", R"(
+        semantics {
+          sender: "Viola encrypted account sync"
+          description:
+            "Creates a user-requested Viola account session and transports "
+            "end-to-end encrypted workspace snapshots."
+          trigger: "The user signs in or local browser organization changes."
+          data: "Account email for authentication, an opaque session token, "
+            "and ciphertext. Passwords are used only for explicit sign-in."
+          destination: WEBSITE
+          internal { contacts { email: "privacy@violabrowser.com" } }
+          user_data {
+            type: EMAIL
+            type: CREDENTIALS
+            type: ACCESS_TOKEN
+            type: USER_CONTENT
+          }
+          last_reviewed: "2026-08-03"
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Disabled by removing the Viola account in Account & Sync."
+          policy_exception_justification: "Not implemented."
+        })");
+  if (!profile_ || !path.starts_with('/')) {
+    std::move(callback).Run(false, {}, "Account request is unavailable.");
+    return;
+  }
+  const size_t maximum_response_bytes =
+      path.starts_with("/v1/sync/snapshots") ? kMaximumSnapshotResponseBytes
+                                              : kMaximumResponseBytes;
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(std::string(kEndpoint) + path);
+  const bool has_upload = method != "GET";
+  request->method = std::move(method);
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  request->headers.SetHeader(net::HttpRequestHeaders::kContentType,
+                             "application/json");
+  if (!token.empty()) {
+    request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
+                               "Bearer " + token);
+  }
+  std::string body_json;
+  if (has_upload && (!base::JSONWriter::Write(body, &body_json) ||
+                     body_json.size() > kMaximumStateBytes)) {
+    std::move(callback).Run(false, {}, "Account request is too large.");
+    return;
+  }
+  std::unique_ptr<network::SimpleURLLoader> loader =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  if (has_upload) {
+    loader->AttachStringForUpload(body_json, "application/json");
+  }
+  loader->SetAllowHttpErrorResults(true);
+  const int request_id = next_request_id_++;
+  network::SimpleURLLoader *loader_ptr = loader.get();
+  loaders_[request_id] = std::move(loader);
+  loader_ptr->DownloadToString(
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(&ViolaAccountSyncService::OnJsonRequestComplete,
+                     weak_factory_.GetWeakPtr(), request_id,
+                     std::move(callback)),
+      maximum_response_bytes);
+}
+
+void ViolaAccountSyncService::OnJsonRequestComplete(
+    int request_id, JsonRequestCallback callback,
+    std::optional<std::string> body) {
+  auto iterator = loaders_.find(request_id);
+  if (iterator == loaders_.end()) {
+    return;
+  }
+  std::unique_ptr<network::SimpleURLLoader> loader =
+      std::move(iterator->second);
+  loaders_.erase(iterator);
+  int response_code = 0;
+  if (loader->ResponseInfo() && loader->ResponseInfo()->headers) {
+    response_code = loader->ResponseInfo()->headers->response_code();
+  }
+  std::optional<base::Value> parsed =
+      body ? base::JSONReader::Read(*body, base::JSON_PARSE_RFC) : std::nullopt;
+  base::DictValue response = parsed && parsed->is_dict()
+                                 ? std::move(*parsed).TakeDict()
+                                 : base::DictValue();
+  const bool http_success = response_code >= 200 && response_code < 300;
+  const bool valid_response = parsed && parsed->is_dict();
+  const bool success = http_success && valid_response;
+  std::string error;
+  if (!success) {
+    if (http_success && !body) {
+      error = "The encrypted sync response exceeded Viola's safety limit.";
+    } else if (http_success && !valid_response) {
+      error = "The account service returned an invalid response.";
+    } else {
+      error = CleanText(response.FindString("error"), 500);
+    }
+    if (error.empty()) {
+      error = response_code ? "Account request failed (" +
+                                  base::NumberToString(response_code) + ")."
+                            : "Viola could not reach the account service.";
+    }
+  }
+  std::move(callback).Run(success, std::move(response), std::move(error));
+}
+
+void ViolaAccountSyncService::ScheduleWrite() {
+  if (writer_) {
+    writer_->ScheduleWrite(this);
+  }
+}
+
+std::optional<std::string> ViolaAccountSyncService::SerializeData() {
+  std::string serialized;
+  return base::JSONWriter::WriteWithOptions(
+             state_, base::JSONWriter::OPTIONS_PRETTY_PRINT, &serialized)
+             ? std::optional<std::string>(std::move(serialized))
+             : std::nullopt;
+}
+
+} // namespace viola
