+// Engine-owned settings implementations remain the authority for sensitive
+// browser preferences, but Viola owns their navigation and presentation. The
+// observer belongs to the real tab, so it survives the chrome://viola handler
+// that initiated navigation and reapplies after internal SPA routes.
+class ViolaBrowserToolThemeObserver
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<ViolaBrowserToolThemeObserver> {
+public:
+  ~ViolaBrowserToolThemeObserver() override = default;
+
+  void HideUntilThemed() {
+    BrowserWindowInterface *browser =
+        webui::GetBrowserWindowInterface(web_contents());
+    BrowserView *browser_view = browser
+                                    ? BrowserView::GetBrowserViewForBrowser(
+                                          browser->GetBrowserForMigrationOnly())
+                                    : nullptr;
+    if (!browser_view ||
+        browser_view->contents_web_view()->GetWebContents() != web_contents()) {
+      return;
+    }
+    hidden_until_themed_ = true;
+    browser_view->contents_web_view()->SetVisible(false);
+    reveal_fallback_.Start(
+        FROM_HERE, base::Seconds(2),
+        base::BindOnce(&ViolaBrowserToolThemeObserver::Reveal,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+private:
+  friend class content::WebContentsUserData<ViolaBrowserToolThemeObserver>;
+
+  explicit ViolaBrowserToolThemeObserver(content::WebContents *contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<ViolaBrowserToolThemeObserver>(*contents) {
+  }
+
+  void DidStartNavigation(content::NavigationHandle *navigation) override {
+    if (!navigation->IsInPrimaryMainFrame() ||
+        !IsViolaThemedBrowserTool(navigation->GetURL())) {
+      return;
+    }
+    // Chromium Settings is a single-page application. Its internal route
+    // changes can replace nested shadow roots before DidFinishNavigation(),
+    // which used to expose the stock toolbar and page chrome for one paint.
+    // Gate every audited engine route, not only the initial link from Viola.
+    HideUntilThemed();
+  }
+
+  void DidFinishNavigation(content::NavigationHandle *navigation) override {
+    if (!navigation->HasCommitted() || !navigation->IsInPrimaryMainFrame()) {
+      return;
+    }
+    if (!IsViolaThemedBrowserTool(navigation->GetURL())) {
+      Reveal();
+      return;
+    }
+    ApplyTheme();
+  }
+
+  void DocumentOnLoadCompletedInPrimaryMainFrame() override {
+    if (!IsViolaThemedBrowserTool(web_contents()->GetLastCommittedURL())) {
+      return;
+    }
+    // Extensions replaces its initial document after navigation commit. A
+    // load-complete pass binds the same primitive sheet and observers to that
+    // final document while the native content gate is still closed.
+    HideUntilThemed();
+    ApplyTheme();
+  }
+
+  void ApplyTheme() {
+    content::RenderFrameHost *frame = web_contents()->GetPrimaryMainFrame();
+    if (!frame) {
+      Reveal();
+      return;
