+    icon.innerHTML='<svg viewBox="0 0 20 20"><path d="M10 3.5v8m-3-3 3 3 3-3M5 15h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>';
