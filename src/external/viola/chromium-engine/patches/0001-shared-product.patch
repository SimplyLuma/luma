+std::optional<base::Value> ExtractPersistentTab(base::DictValue &organization,
+                                                std::string_view tab_id) {
+  for (base::Value &profile : *organization.FindList("profiles")) {
+    base::ListValue *favorites = profile.GetDict().FindList("favorites");
+    for (auto tab = favorites->begin(); tab != favorites->end(); ++tab) {
+      if (StringOr(&tab->GetDict(), "id") == tab_id) {
+        base::Value moved = std::move(*tab);
+        favorites->erase(tab);
+        return moved;
+      }
+    }
+  }
+  for (base::Value &space : *organization.FindList("spaces")) {
+    for (std::string_view section : {"pinned", "today"}) {
+      base::ListValue *tabs = space.GetDict().FindList(section);
+      for (auto tab = tabs->begin(); tab != tabs->end(); ++tab) {
+        if (StringOr(&tab->GetDict(), "id") == tab_id) {
+          base::Value moved = std::move(*tab);
+          tabs->erase(tab);
+          return moved;
+        }
+      }
+    }
+  }
+  return std::nullopt;
+}
