+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace viola {
+namespace {
+
+constexpr char kMiniViolaAppName[] = "viola-mini";
+constexpr int kMiniWidth = 1000;
+constexpr int kMiniHeight = 720;
+
+Browser* FindWorkspaceBrowser(Profile* profile, const Browser* excluding) {
+  Browser* destination = nullptr;
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&](BrowserWindowInterface* candidate) {
+        Browser* browser =
+            candidate ? candidate->GetBrowserForMigrationOnly() : nullptr;
+        if (!browser || browser == excluding ||
+            candidate->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+          return true;
+        }
+        destination = browser;
+        return false;
+      });
+  return destination;
+}
+
+}  // namespace
+
+// static
+bool ViolaMiniWindow::IsMini(const Browser& browser) {
+  return browser.type() == Browser::TYPE_APP_POPUP &&
+         browser.app_name() == kMiniViolaAppName;
+}
+
+// static
+bool ViolaMiniWindow::IsCompact(const Browser& browser) {
+#if BUILDFLAG(IS_LINUX)
+  if (browser.type() == Browser::TYPE_POPUP &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch("viola-native-frame-probe")) {
+    return true;
+  }
+#endif
+  return IsMini(browser);
+}
+
+// static
+Browser* ViolaMiniWindow::Open(Profile* profile, const GURL& url) {
+  if (!profile || profile->IsOffTheRecord()) {
+    return nullptr;
+  }
+  Browser::CreateParams params = Browser::CreateParams::CreateForAppPopup(
+      kMiniViolaAppName, /*trusted_source=*/true,
+      gfx::Rect(0, 0, kMiniWidth, kMiniHeight), profile,
+      /*user_gesture=*/true);
+  Browser* mini = Browser::Create(params);
+  if (!mini) {
+    return nullptr;
+  }
+  chrome::AddTabAt(mini, url, /*index=*/-1, /*foreground=*/true);
+  if (mini->window()) {
+    mini->window()->Show();
+  }
+  return mini;
+}
+
+// static
+bool ViolaMiniWindow::AdoptIntoWorkspace(Browser* mini_browser) {
+  if (!mini_browser || !IsCompact(*mini_browser) ||
+      !mini_browser->tab_strip_model() ||
+      mini_browser->tab_strip_model()->empty()) {
+    return false;
+  }
+  Browser* destination =
+      FindWorkspaceBrowser(mini_browser->profile(), mini_browser);
+  if (!destination) {
+    Browser::CreateParams params(mini_browser->profile(),
+                                 /*user_gesture=*/true);
+    destination = Browser::Create(params);
+  }
+  if (!destination || !destination->tab_strip_model()) {
+    return false;
+  }
+  const int source_index = mini_browser->tab_strip_model()->active_index();
+  std::unique_ptr<content::WebContents> contents =
+      mini_browser->tab_strip_model()->DetachWebContentsAtForInsertion(
+          source_index);
+  if (!contents) {
+    return false;
+  }
+  destination->tab_strip_model()->InsertWebContentsAt(
+      destination->tab_strip_model()->count(), std::move(contents),
+      AddTabTypes::ADD_ACTIVE);
+  if (destination->window()) {
+    destination->window()->Show();
+    destination->window()->Activate();
+  }
+  if (mini_browser->window()) {
+    mini_browser->window()->Close();
+  }
+  return true;
+}
+
+}  // namespace viola
