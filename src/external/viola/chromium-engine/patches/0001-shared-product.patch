+void ViolaMessageHandler::ObserveProductTabStrip() {
+  TabStripModel *tab_strip = GetProductTabStrip();
+  if (tab_strip == observed_tab_strip_) {
+    return;
+  }
+  if (observed_tab_strip_) {
+    observed_tab_strip_->RemoveObserver(this);
+  }
+  observed_tab_strip_ = tab_strip;
+  if (observed_tab_strip_) {
+    observed_tab_strip_->AddObserver(this);
+    NormalizeViolaHomepageTabs(observed_tab_strip_, organization_store_);
+  }
+}
+
+void ViolaMessageHandler::ObserveProfileTabStrips() {
+  for (TabStripModel *peer : peer_tab_strips_) {
+    peer->RemoveObserver(this);
+  }
+  peer_tab_strips_.clear();
+
+  BrowserWindowInterface *current =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  Profile *profile = current ? current->GetProfile() : nullptr;
+  if (!profile || !observed_tab_strip_) {
+    browser_collection_observation_.Reset();
+    return;
+  }
+  AttachViolaWebStoreBranding(observed_tab_strip_);
+  ProfileBrowserCollection *collection =
+      ProfileBrowserCollection::GetForProfile(profile);
+  if (!browser_collection_observation_.IsObserving()) {
+    browser_collection_observation_.Observe(collection);
+  }
+  collection->ForEach([&](BrowserWindowInterface *browser) {
+    Browser *candidate =
+        browser ? browser->GetBrowserForMigrationOnly() : nullptr;
+    TabStripModel *tab_strip = browser ? browser->GetTabStripModel() : nullptr;
+    if (!candidate || !tab_strip || tab_strip == observed_tab_strip_ ||
+        browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+        !viola::ViolaProductShellView::IsEnabledFor(*candidate)) {
+      return true;
+    }
+    peer_tab_strips_.push_back(tab_strip);
+    AttachViolaWebStoreBranding(tab_strip);
+    tab_strip->AddObserver(this);
+    return true;
+  });
+}
+
+void ViolaMessageHandler::StopObservingProfileTabStrips() {
+  browser_collection_observation_.Reset();
+  for (TabStripModel *peer : peer_tab_strips_) {
+    peer->RemoveObserver(this);
+  }
+  peer_tab_strips_.clear();
+}
+
+bool ViolaMessageHandler::FindLiveTabOwner(std::string_view tab_id,
+                                           BrowserWindowInterface **owner,
+                                           TabStripModel **owner_tab_strip,
+                                           int *owner_index) {
+  if (owner) {
+    *owner = nullptr;
+  }
+  if (owner_tab_strip) {
+    *owner_tab_strip = nullptr;
+  }
+  if (owner_index) {
+    *owner_index = TabStripModel::kNoTab;
+  }
+  BrowserWindowInterface *current =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  Profile *profile = current ? current->GetProfile() : nullptr;
+  if (!profile || !organization_store_ || !organization_store_->loaded()) {
+    return false;
+  }
+
+  BrowserWindowInterface *match_browser = nullptr;
+  TabStripModel *match_strip = nullptr;
+  int match_index = TabStripModel::kNoTab;
+  bool duplicate = false;
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&](BrowserWindowInterface *browser) {
+        Browser *candidate =
+            browser ? browser->GetBrowserForMigrationOnly() : nullptr;
+        TabStripModel *tab_strip =
+            browser ? browser->GetTabStripModel() : nullptr;
+        if (!candidate || !tab_strip ||
+            (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL &&
+             !(browser->GetType() == BrowserWindowInterface::TYPE_POPUP &&
+               base::CommandLine::ForCurrentProcess()->HasSwitch("viola-native-frame-probe"))) ||
+            !viola::ViolaProductShellView::IsEnabledFor(*candidate)) {
+          return true;
+        }
+        const int index = organization_store_->FindTabIndex(tab_strip, tab_id);
+        if (index == TabStripModel::kNoTab) {
+          return true;
+        }
+        if (match_strip) {
+          duplicate = true;
+          return false;
+        }
+        match_browser = browser;
+        match_strip = tab_strip;
+        match_index = index;
+        return true;
+      });
+  if (duplicate || !match_strip) {
+    return false;
+  }
+  if (owner) {
+    *owner = match_browser;
+  }
+  if (owner_tab_strip) {
+    *owner_tab_strip = match_strip;
+  }
+  if (owner_index) {
+    *owner_index = match_index;
+  }
+  return true;
+}
+
+void ViolaMessageHandler::ApplyLiveWindowOwners(base::DictValue &state) {
+  auto apply_list = [&](base::ListValue *tabs) {
+    if (!tabs) {
+      return;
+    }
+    for (base::Value &value : *tabs) {
+      base::DictValue &tab = value.GetDict();
+      const std::string *tab_id = tab.FindString("id");
+      BrowserWindowInterface *owner = nullptr;
+      TabStripModel *owner_strip = nullptr;
+      int index = TabStripModel::kNoTab;
+      if (!tab_id || !FindLiveTabOwner(*tab_id, &owner, &owner_strip, &index) ||
+          owner_strip == observed_tab_strip_) {
+        continue;
+      }
+      content::WebContents *contents = owner_strip->GetWebContentsAt(index);
+      if (!contents) {
+        continue;
+      }
+      const std::string page_url = contents->GetVisibleURL().spec();
+      tab.Set("url", page_url);
+      const std::string *existing_title = tab.FindString("title");
+      tab.Set("title", contents->GetTitle().empty()
+                           ? existing_title ? *existing_title : std::string()
+                           : base::UTF16ToUTF8(contents->GetTitle()));
+      const GURL validated_page_url(page_url);
+      if (validated_page_url.SchemeIsHTTPOrHTTPS()) {
+        content::NavigationEntry *entry =
+            contents->GetController().GetVisibleEntry();
+        const content::FaviconStatus *favicon =
+            entry ? &entry->GetFavicon() : nullptr;
+        const bool has_live_favicon = favicon && favicon->valid &&
+                                      favicon->url.is_valid() &&
+                                      favicon->url.SchemeIsHTTPOrHTTPS();
+        // A live icon is a stronger portable hint, but a dormant peer tab has
+        // no NavigationEntry artwork to contribute. Preserve the state
+        // builder's chrome://favicon2 page-URL fallback in that case so a new
+        // Mac window can inherit Chromium's favicon database without waking
+        // or reloading every background tab.
+        if (has_live_favicon) {
+          tab.Set("favicon", favicon->url.spec());
+        }
+      }
+      tab.Set("loading", contents->IsLoading());
+      tab.Set("audible", contents->IsCurrentlyAudible());
+      tab.Set("muted", contents->IsAudioMuted());
+      tab.Set("tabMuted", contents->IsAudioMuted());
+      tab.Set("alive", true);
+      bool visible_in_owner = index == owner_strip->active_index();
+      if (!visible_in_owner &&
+          owner_strip->active_index() != TabStripModel::kNoTab) {
+        const std::optional<split_tabs::SplitTabId> active_split =
+            owner_strip->GetSplitForTab(owner_strip->active_index());
+        const std::optional<split_tabs::SplitTabId> candidate_split =
+            owner_strip->GetSplitForTab(index);
+        visible_in_owner = active_split && candidate_split &&
+                           *active_split == *candidate_split;
+      }
+      // A peer strip is shared session storage, not proof that the page is
+      // being viewed. Only its selected page (and the other visible leaf of
+      // an active Chromium split) receives the inactive/window treatment.
+      tab.Set("viewedElsewhere", visible_in_owner);
+      tab.Set("viewedElsewhereKind",
+              visible_in_owner ? "window" : std::string());
+    }
+  };
+
+  apply_list(state.FindList("favorites"));
+  apply_list(state.FindList("pinned"));
+  apply_list(state.FindList("today"));
+  if (base::ListValue *groups = state.FindList("tabGroups")) {
+    for (base::Value &group : *groups) {
+      apply_list(group.GetDict().FindList("tabs"));
+    }
+  }
+}
+
+void ViolaMessageHandler::EnsureOrganizationLoaded() {
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  TabStripModel *tab_strip = GetProductTabStrip();
+  if (!browser || !tab_strip || browser->GetTabStripModel() != tab_strip) {
+    SendRenderState();
+    return;
+  }
+  // Developer tools belong to their inspected page, never the workspace store.
+  if (browser->GetType() == BrowserWindowInterface::TYPE_DEVTOOLS) {
+    SendRenderState();
+    return;
+  }
+  organization_store_ =
+      viola::ViolaOrganizationStore::Get(browser->GetProfile());
+  if (!organization_store_) {
+    SendRenderState();
+    return;
+  }
+  organization_store_->EnsureLoaded(base::BindOnce(
+      &ViolaMessageHandler::OnOrganizationLoaded, weak_factory_.GetWeakPtr()));
+}
+
+void ViolaMessageHandler::OnOrganizationLoaded() {
+  TabStripModel *tab_strip = GetProductTabStrip();
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  if (!IsJavascriptAllowed() || !organization_store_ || !browser ||
+      !tab_strip || browser->GetTabStripModel() != tab_strip) {
+    return;
+  }
+  if (!observing_organization_store_) {
+    organization_store_->AddObserver(this);
+    observing_organization_store_ = true;
+  }
+  // The first Viola window owns cold-start materialization. Later windows
+  // join the same logical session and render already-live tabs as transferable
+  // peer rows instead of cloning their WebContents.
+  if (!organization_store_->materialized_once()) {
+    organization_store_->ReconcileAndMaterialize(browser, tab_strip);
+  } else {
+    organization_store_->Reconcile(tab_strip);
+  }
+  if (GetProductShellView()) {
+    viola::ViolaProductShellView::SetSidebarWidthForProfile(
+        browser->GetProfile(), organization_store_->sidebar_width());
+  }
+  SendRenderState();
+}
+
+void ViolaMessageHandler::HandleActiveTabNavigation(
+    viola::HostChannel channel, const base::Value &payload) {
+  // These commands intentionally take no data. Rejecting even structurally
+  // valid non-null JSON prevents future payload authority from arriving by
+  // accident through this narrow first mutation slice.
+  if (!payload.is_none()) {
+    return;
+  }
+
+  content::WebContents *active_tab = GetActiveTabForMutation();
+  if (!active_tab) {
+    return;
+  }
+
+  content::NavigationController &controller = active_tab->GetController();
+  switch (channel) {
+  case viola::HostChannel::kNavBack:
+    if (controller.CanGoBack()) {
+      controller.GoBack();
+    }
+    return;
+  case viola::HostChannel::kNavForward:
+    if (controller.CanGoForward()) {
+      controller.GoForward();
+    }
+    return;
+  case viola::HostChannel::kNavReload:
+    controller.Reload(content::ReloadType::NORMAL,
+                      /*check_for_repost=*/true);
+    return;
+  default:
+    return;
+  }
+}
+
+void ViolaMessageHandler::HandleMiniNavigation(
+    viola::HostChannel channel, const base::Value &payload) {
+  if (CurrentSurface() != "little.html") {
+    return;
+  }
+  BrowserWindowInterface* browser_window =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  Browser* browser =
+      browser_window ? browser_window->GetBrowserForMigrationOnly() : nullptr;
+  TabStripModel* tab_strip = GetProductTabStrip();
+  content::WebContents* active =
+      tab_strip ? tab_strip->GetActiveWebContents() : nullptr;
+  if (!browser || !viola::ViolaMiniWindow::IsMini(*browser) || !active) {
+    return;
+  }
+  content::NavigationController& controller = active->GetController();
+  switch (channel) {
+    case viola::HostChannel::kLittleBack:
+      if (payload.is_none() && controller.CanGoBack()) controller.GoBack();
+      return;
+    case viola::HostChannel::kLittleForward:
+      if (payload.is_none() && controller.CanGoForward()) controller.GoForward();
+      return;
+    case viola::HostChannel::kLittleReload:
+      if (payload.is_none()) {
+        controller.Reload(content::ReloadType::NORMAL,
+                          /*check_for_repost=*/true);
+      }
+      return;
+    case viola::HostChannel::kLittleCopy:
+      if (payload.is_none()) {
+        ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+        writer.WriteText(base::UTF8ToUTF16(active->GetVisibleURL().spec()));
+      }
+      return;
+    case viola::HostChannel::kLittleNavigate: {
+      if (!payload.is_dict() || payload.GetDict().size() != 1) return;
+      const std::string* input = payload.GetDict().FindString("input");
+      if (!input || input->empty() || input->size() > 2048) return;
+      const GURL destination = ResolveTypedDestination(
+          browser->profile(), *input, organization_store_);
+      if (!destination.is_valid() ||
+          (!destination.SchemeIsHTTPOrHTTPS() && !destination.SchemeIsFile())) {
+        return;
+      }
+      content::NavigationController::LoadURLParams params(destination);
+      params.transition_type = ui::PAGE_TRANSITION_TYPED;
+      controller.LoadURLWithParams(params);
+      return;
+    }
+    case viola::HostChannel::kLittleAdopt:
+      if (payload.is_none()) {
+        viola::ViolaMiniWindow::AdoptIntoWorkspace(browser);
+      }
+      return;
+    default:
+      return;
+  }
+}
+
+void ViolaMessageHandler::HandleTabActivation(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 1) {
+    return;
+  }
+  const std::string *tab_id = payload.GetDict().FindString("tabId");
+  if (!tab_id || tab_id->empty()) {
+    return;
+  }
+
+  TabStripModel *tab_strip = GetProductTabStrip();
+  if (!tab_strip || tab_strip != observed_tab_strip_) {
+    return;
+  }
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  BrowserWindowInterface *live_owner = nullptr;
+  TabStripModel *live_strip = nullptr;
+  int live_index = TabStripModel::kNoTab;
+  if (browser &&
+      FindLiveTabOwner(*tab_id, &live_owner, &live_strip, &live_index) &&
+      live_strip != tab_strip) {
+    // A native window survives losing its final tab to another window.
+    // Existing background tabs remain Chromium's normal activation fallback.
+    if (live_strip->count() == 1 &&
+        base::CommandLine::ForCurrentProcess()->HasSwitch("viola-native-frame-probe")) {
+      organization_store_->AddNewTabForActiveWorkspace(
+          live_owner, live_strip, GURL("about:blank"), live_strip->count(), false);
+      if (live_strip->count() < 2) return;
+      live_index = organization_store_->FindTabIndex(live_strip, *tab_id);
+      if (live_index == TabStripModel::kNoTab) return;
+    }
+    chrome::MoveTabsToExistingWindow(live_owner, browser, {live_index});
+    const int adopted_index =
+        organization_store_->FindTabIndex(tab_strip, *tab_id);
+    if (adopted_index != TabStripModel::kNoTab) {
+      tab_strip->ActivateTabAt(
+          adopted_index, TabStripUserGestureDetails(
+                             TabStripUserGestureDetails::GestureType::kMouse));
+    }
+    return;
+  }
+  if (organization_store_ && organization_store_->loaded() && browser &&
+      organization_store_->ActivateTab(*tab_id, browser, tab_strip)) {
+    return;
+  }
+  const int index = FindStableTabIndex(*tab_strip, *tab_id);
+  if (index != TabStripModel::kNoTab) {
+    tab_strip->ActivateTabAt(
+        index, TabStripUserGestureDetails(
+                   TabStripUserGestureDetails::GestureType::kMouse));
+  }
+}
+
+void ViolaMessageHandler::HandleTabClose(const base::Value &payload) {
+  if (!payload.is_dict() || payload.GetDict().size() != 1) {
+    return;
+  }
+  const std::string *tab_id = payload.GetDict().FindString("tabId");
+  if (!tab_id || tab_id->empty()) {
+    return;
+  }
+
+  TabStripModel *tab_strip = GetProductTabStrip();
+  if (!tab_strip || tab_strip != observed_tab_strip_) {
+    return;
+  }
+  BrowserWindowInterface* owner = webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  TabStripModel* owning_strip = nullptr;
+  int owning_index = TabStripModel::kNoTab;
+  if (FindLiveTabOwner(*tab_id, &owner, &owning_strip, &owning_index)) {
+    tab_strip = owning_strip;
+  } else {
+    owner = webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  }
+  const int index = organization_store_ && organization_store_->loaded()
+                        ? organization_store_->FindTabIndex(tab_strip, *tab_id)
+                        : FindStableTabIndex(*tab_strip, *tab_id);
+  if (index != TabStripModel::kNoTab && tab_strip->count() == 1 &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch("viola-native-frame-probe")) {
+    auto* browser = owner;
+    if (!browser || browser->GetTabStripModel() != tab_strip) return;
+    if (organization_store_ && organization_store_->loaded()) {
+      organization_store_->AddNewTabForActiveWorkspace(
+          browser, tab_strip, GURL("about:blank"), tab_strip->count(), true);
+    } else {
+      chrome::AddTabAt(browser, GURL("about:blank"), tab_strip->count(), true);
+    }
+    if (tab_strip->count() < 2) return;
+  }
+  const bool favorite = organization_store_ && organization_store_->loaded() &&
+                        organization_store_->IsFavorite(*tab_id);
+  if (index != TabStripModel::kNoTab) {
+    tab_strip->CloseWebContentsAt(
+        index, TabCloseTypes::CLOSE_USER_GESTURE |
+                   TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  } else {
+    if (organization_store_ && organization_store_->loaded() && !favorite) {
+      organization_store_->RemoveTab(*tab_id);
+    }
+    // A restored workspace can contain a legitimate dormant tab with no
+    // materialized WebContents. Removing it changes only the organization
+    // store, so no TabStripModel callback exists to refresh the sidebar. Paint
+    // that accepted removal immediately instead of leaving a ghost row until
+    // an unrelated tab selection happens to produce another render.
+    SendRenderState();
+  }
+}
