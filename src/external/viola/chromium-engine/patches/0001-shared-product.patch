+#if BUILDFLAG(IS_LINUX)
+base::ListValue DescribeNativeMenuProbe(ui::MenuModel* model, int depth = 0,
+                                       std::optional<int> zoom_percent = std::nullopt) {
+  base::ListValue result;
+  if (!model || depth >= 8) return result;
+  for (size_t index = 0; index < model->GetItemCount() && index < 128; ++index) {
+    base::DictValue item;
+    item.Set("index", static_cast<int>(index));
+    item.Set("label", base::UTF16ToUTF8(model->GetLabelAt(index)));
+    item.Set("visible", model->IsVisibleAt(index));
+    item.Set("enabled", model->IsEnabledAt(index));
+    const auto type = model->GetTypeAt(index);
+    const char* kind = "item";
+    switch (type) {
+      case ui::MenuModel::TYPE_SEPARATOR: kind = "separator"; break;
+      case ui::MenuModel::TYPE_TITLE: kind = "title"; break;
+      case ui::MenuModel::TYPE_CHECK: kind = "check"; break;
+      case ui::MenuModel::TYPE_RADIO: kind = "radio"; break;
+      case ui::MenuModel::TYPE_SUBMENU: kind = "submenu"; break;
+      default: break;
+    }
+    item.Set("kind", kind);
+    if (zoom_percent && model->GetCommandIdAt(index) == kBrowserZoomMenu) {
+      item.Set("role", "zoom");
+      item.Set("value", *zoom_percent);
+    }
+    if (type == ui::MenuModel::TYPE_CHECK || type == ui::MenuModel::TYPE_RADIO)
+      item.Set("checked", model->IsItemCheckedAt(index));
+    ui::Accelerator accelerator;
+    if (model->GetAcceleratorAt(index, &accelerator))
+      item.Set("accelerator", base::UTF16ToUTF8(accelerator.GetShortcutText()));
+    if (type == ui::MenuModel::TYPE_SUBMENU)
+      item.Set("children", DescribeNativeMenuProbe(model->GetSubmenuModelAt(index), depth + 1, zoom_percent));
+    result.Append(std::move(item));
+  }
+  return result;
+}
+#endif
+
+}  // namespace
+
+void ViolaMessageHandler::RunContextMenuModel(
+    ui::MenuModel *model,
+    std::optional<gfx::Rect> anchor) {
+#if BUILDFLAG(IS_LINUX)
+  CloseNativeMenuProbe();
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("viola-native-menu-probe") &&
+      CurrentSurface() == "sidebar.html" && model && model == context_menu_model_.get()) {
+    native_menu_probe_nonce_ = base::UnguessableToken::Create().ToString();
+    base::DictValue description;
+    description.Set("nonce", native_menu_probe_nonce_);
+    content::WebContents* active = GetProductTabStrip()
+        ? GetProductTabStrip()->GetActiveWebContents() : nullptr;
+    auto* zoom_controller = active ? zoom::ZoomController::FromWebContents(active) : nullptr;
+    description.Set("items", DescribeNativeMenuProbe(model, 0,
+        zoom_controller ? std::optional<int>(zoom_controller->GetZoomPercent()) : std::nullopt));
+    web_ui()->CallJavascriptFunctionUnsafe("__violaNativeMenuProbe",
+                                           base::Value(std::move(description)));
+    return;
+  }
+#endif
+  BrowserWindowInterface *browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  BrowserView *browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  display::Screen *screen = display::Screen::Get();
+  if (!browser_view || !browser_view->GetWidget() || !screen || !model) {
+    return;
+  }
+  if (context_menu_runner_) {
+    context_menu_runner_->Cancel();
+  }
+  context_menu_runner_.reset();
+  context_menu_adapter_.reset();
+  gfx::Rect screen_anchor;
+  if (anchor) {
+    screen_anchor = *anchor;
+    screen_anchor.Offset(browser_view->GetBoundsInScreen().OffsetFromOrigin());
+  } else {
+    screen_anchor = gfx::Rect(screen->GetCursorScreenPoint(), gfx::Size());
+  }
+  context_menu_adapter_ = std::make_unique<LumaMenuModelAdapter>(model);
+  std::unique_ptr<views::MenuItemView> menu = context_menu_adapter_->CreateMenu();
+  ApplyLumaMenuGeometry(menu.get(), true);
+  context_menu_runner_ = std::make_unique<views::MenuRunner>(
+      std::move(menu),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+  const bool anchor_on_right =
+      anchor && screen_anchor.CenterPoint().x() >=
+                    browser_view->GetBoundsInScreen().CenterPoint().x();
+  context_menu_runner_->RunMenuAt(
+      browser_view->GetWidget(), nullptr, screen_anchor,
+      anchor_on_right ? views::MenuAnchorPosition::kTopRight
+                      : views::MenuAnchorPosition::kTopLeft,
+      ui::mojom::MenuSourceType::kMouse,
+      web_ui()->GetWebContents()->GetContentNativeView());
+}
+
+void ViolaMessageHandler::HandleNativeMenuProbeAction(const base::ListValue& args) {
+#if BUILDFLAG(IS_LINUX)
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("viola-native-menu-probe") ||
+      CurrentSurface() != "sidebar.html" || args.size() != 2 ||
+      !args[0].is_string() || args[0].GetString() != native_menu_probe_nonce_ ||
+      native_menu_probe_nonce_.empty() || !args[1].is_list()) return;
+  const auto& path = args[1].GetList();
+  if (path.empty() || path.size() > 8) return;
+  if (native_page_menu_activate_) {
+    std::vector<size_t> indices;
+    for (const auto& component : path) {
+      if (!component.is_int() || component.GetInt() < 0 || component.GetInt() >= 4096) return;
+      indices.push_back(static_cast<size_t>(component.GetInt()));
+    }
+    native_menu_probe_nonce_.clear();
+    auto activate = std::move(native_page_menu_activate_);
+    auto close = std::move(native_page_menu_close_);
+    std::move(activate).Run(std::move(indices));
+    if (close) std::move(close).Run();
+    return;
+  }
+  if (!context_menu_model_) return;
+  ui::MenuModel* model = context_menu_model_.get();
+  for (size_t depth = 0; depth < path.size(); ++depth) {
+    if (!path[depth].is_int() || path[depth].GetInt() < 0) return;
+    const size_t index = static_cast<size_t>(path[depth].GetInt());
+    if (index >= model->GetItemCount() || !model->IsVisibleAt(index) ||
+        !model->IsEnabledAt(index)) return;
+    if (depth + 1 < path.size()) {
+      if (model->GetTypeAt(index) != ui::MenuModel::TYPE_SUBMENU) return;
+      model = model->GetSubmenuModelAt(index);
+      if (!model) return;
+      continue;
+    }
+    const auto type = model->GetTypeAt(index);
+    if (type != ui::MenuModel::TYPE_COMMAND && type != ui::MenuModel::TYPE_CHECK &&
+        type != ui::MenuModel::TYPE_RADIO) return;
+    native_menu_probe_nonce_.clear();
+    // Reuse the original delegate: its enabled/ownership checks and command
+    // implementation remain the authority for this native presentation.
+    model->ActivatedAt(index, 0);
+  }
+#endif
+}
+
+void ViolaMessageHandler::CloseNativeMenuProbe() {
+  native_menu_probe_nonce_.clear();
+  native_page_menu_activate_.Reset();
+  auto close = std::move(native_page_menu_close_);
+  if (close) std::move(close).Run();
+}
+
+void ViolaMessageHandler::HandleNativeMenuProbeDismiss(const base::ListValue& args) {
+#if BUILDFLAG(IS_LINUX)
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("viola-native-menu-probe") ||
+      CurrentSurface() != "sidebar.html" || args.size() != 1 ||
+      !args[0].is_string() || args[0].GetString() != native_menu_probe_nonce_ ||
+      native_menu_probe_nonce_.empty()) return;
+  CloseNativeMenuProbe();
+#endif
+}
