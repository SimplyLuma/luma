+  bool SetUpUserDataDirectory() override {
+    if (!ViolaPersistedOrganizationBrowserTest::SetUpUserDataDirectory())
+      return false;
+    base::FilePath directory;
+    if (!base::PathService::Get(chrome::DIR_USER_DATA, &directory)) return false;
+    const base::FilePath path =
+        directory.AppendASCII(TestingProfile::kTestUserProfileDir)
+            .AppendASCII("Viola").AppendASCII("organization-v1.json");
+    std::string text;
+    if (!base::ReadFileToString(path, &text)) return false;
+    auto value = base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+    if (!value) return false;
+    auto* today = (*value->FindDict("organization")->FindList("spaces"))[0]
+                      .GetDict().FindList("today");
+    base::DictValue peer = today->front().GetDict().Clone();
+    peer.Set("id", "restored-peer");
+    today->Append(std::move(peer));
+    return base::JSONWriter::Write(*value, &text) && base::WriteFile(path, text);
+  }
+};
