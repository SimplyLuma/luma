+  function searchScore(item,q){const title=(item.title||'').toLowerCase(),url=item.url.toLowerCase(),host=item.domain||'';let s=item.score||0;if(title.startsWith(q))s+=150;if(host.startsWith(q))s+=120;if(title.includes(q))s+=70;if(url.includes(q))s+=35;for(const word of q.split(/\s+/))if(title.includes(word))s+=15;return s}
