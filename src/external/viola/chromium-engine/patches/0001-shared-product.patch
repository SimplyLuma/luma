+inline constexpr char kArchitectureId[] = "x86";
+#else
+#error Unsupported Viola desktop architecture.
+#endif
+
+inline std::string UpdateDiscoveryKey() {
+  return std::string(kPlatformId) + "-" + kArchitectureId;
+}
