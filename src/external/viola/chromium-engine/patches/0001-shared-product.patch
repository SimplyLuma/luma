+std::string HumanDownloadBytes(int64_t bytes) {
+  const double value = static_cast<double>(std::max<int64_t>(0, bytes));
+  if (value >= 1024.0 * 1024.0 * 1024.0) {
+    return base::StringPrintf("%.1f GB", value / (1024.0 * 1024.0 * 1024.0));
+  }
+  if (value >= 1024.0 * 1024.0) {
+    return base::StringPrintf("%.1f MB", value / (1024.0 * 1024.0));
+  }
+  if (value >= 1024.0) {
+    return base::StringPrintf("%.1f KB", value / 1024.0);
+  }
+  return base::NumberToString(static_cast<int64_t>(value)) + " B";
+}
