+#ifndef CHROME_BROWSER_UI_VIEWS_VIOLA_VIOLA_MINI_WINDOW_H_
+#define CHROME_BROWSER_UI_VIEWS_VIOLA_VIOLA_MINI_WINDOW_H_
+
+class Browser;
+class Profile;
+class GURL;
+
+namespace viola {
+
+// Browser-owned compact triage window. It intentionally uses a real Chromium
+// Browser/TabStripModel so site isolation, profiles, downloads, permissions,
+// extensions and media remain identical to an ordinary Viola page.
+class ViolaMiniWindow {
+ public:
+  static bool IsMini(const Browser& browser);
+  static bool IsCompact(const Browser& browser);
+  static Browser* Open(Profile* profile, const GURL& url);
+  static bool AdoptIntoWorkspace(Browser* mini_browser);
+};
