+// static
+base::DictValue ViolaAccountSyncService::ReconcileWorkspaceTabsForTesting(
+    const base::DictValue &winner,
+    const base::ListValue &candidate_records) {
+  WorkspaceTabCandidates candidates;
+  std::set<std::string> removed;
+  for (const base::Value &candidate : candidate_records) {
+    const base::DictValue *record = candidate.GetIfDict();
+    const base::DictValue *workspace = record ? record->FindDict("value") : nullptr;
+    if (!record || !workspace) {
+      continue;
+    }
+    CollectWorkspaceTabCandidates(*record, candidates);
+    for (const std::string &id : ReadWorkspaceTabTombstones(*workspace)) {
+      removed.insert(id);
+    }
+  }
+  base::DictValue corrected = winner.Clone();
+  ApplyWorkspaceTabTombstones(corrected, removed);
+  int frontier_revision = 0;
+  for (const base::Value &candidate : candidate_records) {
+    const base::DictValue *record = candidate.GetIfDict();
+    if (record) {
+      frontier_revision = std::max(
+          frontier_revision, record->FindInt("revision").value_or(0));
+    }
+  }
+  ApplyWorkspaceTabCandidates(corrected, candidates["workspace:test"], removed,
+                              frontier_revision);
+  return corrected;
+}
