+double BoundedSetting(const base::DictValue *source, std::string_view key,
+                      double minimum, double maximum, double fallback) {
+  return std::clamp(NumberOr(source ? source->Find(key) : nullptr, fallback),
+                    minimum, maximum);
+}
+
+base::DictValue SanitizeSettings(const base::DictValue *source) {
+  base::DictValue settings = DefaultSettings();
+  if (!source) {
+    return settings;
+  }
+  settings.Set("sidebarSide", StringOr(source, "sidebarSide", "left") == "right"
+                                  ? "right"
+                                  : "left");
+  settings.Set("sidebarWidth", static_cast<int>(std::lround(BoundedSetting(
+                                   source, "sidebarWidth", 200, 420,
+                                   kDefaultSidebarWidth))));
+  settings.Set("sidebarCollapsed",
+               source->FindBool("sidebarCollapsed").value_or(false));
+  settings.Set(
+      "allWorkspacesGroupByWorkspace",
+      source->FindBool("allWorkspacesGroupByWorkspace").value_or(true));
+  settings.Set("otherWindowTabsLayout",
+               StringOr(source, "otherWindowTabsLayout") == "nested"
+                   ? "nested"
+                   : "inline");
+  const std::string all_theme =
+      StringOr(source, "allWorkspacesTheme", "aurora");
+  settings.Set("allWorkspacesTheme", IsTheme(all_theme) ? all_theme : "aurora");
+  settings.Set("tabHeight", BoundedSetting(source, "tabHeight", 28, 48, 34));
+  settings.Set("tabSpacing", BoundedSetting(source, "tabSpacing", 0, 10, 3));
+  settings.Set("tabRadius", BoundedSetting(source, "tabRadius", 4, 16, 9));
+  settings.Set("workspaceHeaderHeight",
+               BoundedSetting(source, "workspaceHeaderHeight", 28, 48,
+                              settings.FindDouble("tabHeight").value_or(34)));
+  settings.Set("workspaceHeaderRadius",
+               BoundedSetting(source, "workspaceHeaderRadius", 0, 16,
+                              settings.FindDouble("tabRadius").value_or(9)));
+  settings.Set("workspaceSectionSpacing",
+               BoundedSetting(source, "workspaceSectionSpacing", 0, 30, 13));
+  settings.Set("workspaceContentInset",
+               BoundedSetting(source, "workspaceContentInset", 0, 24, 12));
+  settings.Set("workspaceContentInsetRight",
+               BoundedSetting(
+                   source, "workspaceContentInsetRight", 0, 24,
+                   settings.FindDouble("workspaceContentInset").value_or(12)));
+  settings.Set("miniViolaExternalLinks",
+               source->FindBool("miniViolaExternalLinks").value_or(true));
+  settings.Set("miniViolaShortcut",
+               source->FindBool("miniViolaShortcut").value_or(true));
+  settings.Set("miniViolaModifierClicks",
+               source->FindBool("miniViolaModifierClicks").value_or(true));
+  settings.Set("miniViolaAutoCloseHours",
+               BoundedSetting(source, "miniViolaAutoCloseHours", 0, 168, 6));
+
+  settings.Set("homepage", SafeHomepage(source->Find("homepage")));
+  const std::string custom_name =
+      BoundedText(source->Find("customSearchName"), 64);
+  const std::string custom_template =
+      BoundedText(source->Find("customSearchTemplate"), 2048);
+  settings.Set("customSearchName", custom_name);
+  settings.Set("customSearchTemplate",
+               IsSafeCustomSearchTemplate(custom_template)
+                   ? custom_template
+                   : std::string());
+  const std::string search = StringOr(source, "searchEngine", "google");
+  settings.Set("searchEngine",
+               search == "duckduckgo" || search == "bing" ||
+                       search == "yahoo" ||
+                       (search == "custom" && !custom_name.empty() &&
+                        IsSafeCustomSearchTemplate(custom_template))
+                   ? search : "google");
+  const std::string saver = StringOr(source, "memorySaverMode", "balanced");
+  settings.Set("memorySaverMode",
+               saver == "standard" || saver == "maximum" ? saver : "balanced");
+  return settings;
+}
