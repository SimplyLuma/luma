+GURL ResolveTypedDestination(
+    Profile *profile,
+    std::string_view input,
+    const viola::ViolaOrganizationStore *organization_store) {
+  std::string text(base::TrimWhitespaceASCII(input, base::TRIM_ALL));
+  if (text.empty()) {
+    return GURL();
+  }
+  const GURL explicit_url(text);
+  if (explicit_url.is_valid() && explicit_url.SchemeIsFile()) {
+    return explicit_url;
+  }
+  const base::FilePath path = base::FilePath::FromUTF8Unsafe(text);
+  if (path.IsAbsolute()) {
+    return net::FilePathToFileURL(path);
+  }
+  if (!profile) {
+    return GURL();
+  }
+  AutocompleteMatch match;
+  AutocompleteClassifierFactory::GetForProfile(profile)->Classify(
+      base::UTF8ToUTF16(text), /*in_keyword_mode=*/false,
+      /*allow_exact_keyword_match=*/true, metrics::OmniboxEventProto::BLANK,
+      &match, /*alternate_nav_url=*/nullptr);
+  if (AutocompleteMatch::IsSearchType(match.type) && organization_store &&
+      organization_store->loaded()) {
+    std::string search_template;
+    const std::string engine = organization_store->search_engine();
+    if (engine == "duckduckgo") {
+      search_template = "https://duckduckgo.com/?q=%s";
+    } else if (engine == "bing") {
+      search_template = "https://www.bing.com/search?q=%s";
+    } else if (engine == "yahoo") {
+      search_template = "https://search.yahoo.com/search?p=%s";
+    } else if (engine == "custom") {
+      search_template = organization_store->custom_search_template();
+    } else {
+      search_template = "https://www.google.com/search?q=%s";
+    }
+    const size_t placeholder = search_template.find("%s");
+    if (placeholder != std::string::npos) {
+      search_template.replace(
+          placeholder, 2,
+          base::EscapeQueryParamValue(text, /*use_plus=*/false));
+      const GURL configured(search_template);
+      if (configured.is_valid() && configured.SchemeIsHTTPOrHTTPS()) {
+        return configured;
+      }
+    }
+  }
+  return match.destination_url;
+}
