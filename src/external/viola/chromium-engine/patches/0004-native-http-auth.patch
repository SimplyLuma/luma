+void ViolaProductShellView::ShowLoginPrompt(base::DictValue state,
+                                            LoginAnswer answer) {
+  if (!state.FindString("id") || !answer) {
+    return;
+  }
+  login_prompts_.emplace_back(std::move(state), std::move(answer));
+  if (login_prompts_.size() == 1) {
+    SendAttentionPrompt();
+  }
+}
+
+void ViolaProductShellView::ClearLoginPrompt(std::string_view id) {
+  for (auto it = login_prompts_.begin(); it != login_prompts_.end(); ++it) {
+    const std::string *current = it->first.FindString("id");
+    if (current && id == *current) {
+      const bool shown = it == login_prompts_.begin();
+      login_prompts_.erase(it);
+      if (shown) {
+        SendAttentionPrompt();
+      }
+      return;
+    }
+  }
+}
+
+bool ViolaProductShellView::ResolveLoginPrompt(
+    std::string_view id, bool supplied, const std::u16string &username,
+    const std::u16string &password) {
+  if (login_prompts_.empty()) {
+    return false;
+  }
+  const std::string *current = login_prompts_.front().first.FindString("id");
+  if (!current || id != *current) {
+    return false;
+  }
+  LoginAnswer answer = std::move(login_prompts_.front().second);
+  login_prompts_.pop_front();
+  SendAttentionPrompt();
+  std::move(answer).Run(supplied, username, password);
+  return true;
+}
+
 base::Value ViolaProductShellView::PermissionPromptState() const {
   if (permission_prompt_) {
     return base::Value(permission_prompt_state_.Clone());
   }
+  if (!login_prompts_.empty()) {
+    return base::Value(login_prompts_.front().first.Clone());
+  }
   return session_restore_callback_
              ? base::Value(session_restore_state_.Clone())
              : base::Value();
