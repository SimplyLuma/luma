+bool LoginHandlerViews::ShowInViolaShell(const std::u16string& authority,
+                                         const std::u16string& explanation) {
+  viola::ViolaProductShellView* shell = ViolaShellFor(web_contents());
+  if (!shell) {
+    return false;
+  }
+  const url::SchemeHostPort& challenger = auth_info().challenger;
+  const std::string host = challenger.host();
+  viola_prompt_id_ = base::UnguessableToken::Create().ToString();
+  base::DictValue state;
+  state.Set("id", viola_prompt_id_);
+  state.Set("type", "login");
+  state.Set("title", auth_info().is_proxy
+                         ? base::StrCat({"Sign in to the proxy ", host})
+                         : base::StrCat({"Sign in to ", host}));
+  state.Set("body", explanation.empty() ? authority : explanation);
+  state.Set("host", host);
+  state.Set("proxy", auth_info().is_proxy);
+  state.Set("icon", base::StrCat({
+                        "chrome://favicon2/?size=32&scaleFactor=1x&"
+                        "showFallbackMonogram=&pageUrl=",
+                        base::EscapeQueryParamValue(
+                            challenger.GetURL().spec(), true)}));
+  state.Set("hue", 250);
+  state.Set("important", true);
+  state.Set("kept", true);
+  shell->ShowLoginPrompt(
+      std::move(state),
+      base::BindOnce(&LoginHandlerViews::OnViolaAnswer,
+                     viola_weak_factory_.GetWeakPtr()));
+  return true;
+}
+
+void LoginHandlerViews::OnViolaAnswer(bool supplied,
+                                      const std::u16string& username,
+                                      const std::u16string& password) {
+  viola_prompt_id_.clear();
+  if (supplied) {
+    SetAuth(username, password);
+  } else {
+    CancelAuth(/*notify_others=*/true);
+  }
+}
+#endif
