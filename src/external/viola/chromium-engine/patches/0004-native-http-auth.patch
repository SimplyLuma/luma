+  viola::ViolaProductShellView *shell = GetProductShellView();
+  // A sign-in answer: {id, decision: "signin", username, password}.
+  if (*decision == "signin") {
+    const std::string *username = dict.FindString("username");
+    const std::string *password = dict.FindString("password");
+    if (dict.size() != 4 || !username || !password ||
+        username->size() > 1024 || password->size() > 1024 || !shell) {
+      return;
+    }
+    shell->ResolveLoginPrompt(*id, /*supplied=*/true,
+                              base::UTF8ToUTF16(*username),
+                              base::UTF8ToUTF16(*password));
+    return;
   }
+  if (dict.size() != 2 || (*decision != "allow" && *decision != "block" &&
+                            *decision != "dismiss")) {
+    return;
+  }
+  if (!shell) {
+    return;
+  }
+  // Block or dismiss on a sign-in cancels it.
+  if (*decision != "allow" &&
+      shell->ResolveLoginPrompt(*id, /*supplied=*/false, std::u16string(),
+                                std::u16string())) {
+    return;
+  }
+  shell->ResolvePermissionPrompt(*id, *decision);
 }
 
