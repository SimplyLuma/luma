+void ViolaProductShellView::ShowExtensionPrompt(base::DictValue state,
+                                                ExtensionAnswer answer) {
+  if (!state.FindString("id") || !answer) {
+    return;
+  }
+  extension_prompts_.emplace_back(std::move(state), std::move(answer));
+  if (extension_prompts_.size() == 1) {
+    SendAttentionPrompt();
+  }
+}
+
+void ViolaProductShellView::ClearExtensionPrompt(std::string_view id) {
+  for (auto it = extension_prompts_.begin(); it != extension_prompts_.end();
+       ++it) {
+    const std::string *current = it->first.FindString("id");
+    if (current && id == *current) {
+      const bool shown = it == extension_prompts_.begin();
+      extension_prompts_.erase(it);
+      if (shown) {
+        SendAttentionPrompt();
+      }
+      return;
+    }
+  }
+}
+
+bool ViolaProductShellView::ResolveExtensionPrompt(std::string_view id,
+                                                   bool accepted) {
+  if (extension_prompts_.empty()) {
+    return false;
+  }
+  const std::string *current =
+      extension_prompts_.front().first.FindString("id");
+  if (!current || id != *current) {
+    return false;
+  }
+  ExtensionAnswer answer = std::move(extension_prompts_.front().second);
+  extension_prompts_.pop_front();
+  SendAttentionPrompt();
+  std::move(answer).Run(accepted);
+  return true;
+}
+
+// static
+ViolaProductShellView *
+ViolaProductShellView::ForWebContents(content::WebContents *contents) {
+  tabs::TabInterface *tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  BrowserWindowInterface *browser =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  BrowserView *browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  return browser_view ? browser_view->viola_product_shell_view_for_testing()
+                      : nullptr;
+}
+
+// static
+ViolaProductShellView *ViolaProductShellView::ForProfile(Profile *profile) {
+  if (!profile) {
+    return nullptr;
+  }
+  ProfileBrowserCollection *browsers =
+      ProfileBrowserCollection::GetForProfile(profile);
+  if (!browsers) {
+    return nullptr;
+  }
+  auto shell_of = [](BrowserWindowInterface *browser) -> ViolaProductShellView * {
+    BrowserView *browser_view =
+        browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+    return browser_view ? browser_view->viola_product_shell_view_for_testing()
+                        : nullptr;
+  };
+  ViolaProductShellView *shell = shell_of(browsers->GetLastActiveBrowser());
+  if (!shell) {
+    browsers->ForEach([&shell, &shell_of](BrowserWindowInterface *browser) {
+      shell = shell_of(browser);
+      return !shell;
+    });
+  }
+  return shell;
+}
