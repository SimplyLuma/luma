+#if BUILDFLAG(IS_LINUX)
+// Viola draws its browser window off screen, so a browser-modal dialog there
+// is never seen. The host shows the prompt in its bar instead and answers
+// accept or cancel; the prompt stays alive until then.
+void AnswerViolaInstallPrompt(
+    std::unique_ptr<ExtensionInstallPrompt::Prompt> prompt,
+    ExtensionInstallPrompt::DoneCallback done_callback,
+    bool accepted) {
+  if (accepted) {
+    prompt->OnDialogAccepted();
+  } else {
+    prompt->OnDialogCanceled();
+  }
+  std::move(done_callback)
+      .Run(ExtensionInstallPrompt::DoneCallbackPayload(
+          accepted ? ExtensionInstallPrompt::Result::ACCEPTED
+                   : ExtensionInstallPrompt::Result::USER_CANCELED));
+}
+
+bool ShowInViolaShell(
+    content::WebContents* web_contents,
+    Profile* profile,
+    ExtensionInstallPrompt::DoneCallback& done_callback,
+    std::unique_ptr<ExtensionInstallPrompt::Prompt>& prompt) {
+  switch (prompt->type()) {
+    case ExtensionInstallPrompt::INSTALL_PROMPT:
+    case ExtensionInstallPrompt::RE_ENABLE_PROMPT:
+    case ExtensionInstallPrompt::PERMISSIONS_PROMPT:
+    case ExtensionInstallPrompt::EXTERNAL_INSTALL_PROMPT:
+    case ExtensionInstallPrompt::REMOTE_INSTALL_PROMPT:
+    case ExtensionInstallPrompt::REPAIR_PROMPT:
+      break;
+    default:
+      // Requests with a justification and parent approval keep Chromium's
+      // dialog.
+      return false;
+  }
+  if (prompt->requires_parent_permission() ||
+      prompt->GetAcceptButtonLabel().empty()) {
+    return false;
+  }
+  // A tab's own window, else (an extension's popup or background page, a
+  // re-enable from settings) the profile's most recent Viola window.
+  viola::ViolaProductShellView* shell =
+      viola::ViolaProductShellView::ForWebContents(web_contents);
+  if (!shell) {
+    shell = viola::ViolaProductShellView::ForProfile(profile);
+  }
+  if (!shell) {
+    return false;
+  }
+  base::DictValue state;
+  state.Set("id", base::UnguessableToken::Create().ToString());
+  state.Set("type", "extension");
+  state.Set("title", prompt->GetDialogTitle());
+  if (const extensions::Extension* extension = prompt->extension()) {
+    state.Set("name", extensions::ui_util::GetFixupExtensionNameForUIDisplay(
+                          extension->name()));
+    state.Set("extensionId", extension->id());
+  }
+  base::ListValue details;
+  const size_t count = std::min<size_t>(prompt->GetPermissionCount(), 24);
+  for (size_t i = 0; i < count; ++i) {
+    details.Append(prompt->GetPermission(i));
+  }
+  state.Set("body", count ? prompt->GetPermissionsHeading() : std::u16string());
+  state.Set("details", std::move(details));
+  state.Set("accept", prompt->GetAcceptButtonLabel());
+  state.Set("cancel", prompt->GetAbortButtonLabel());
+  state.Set("host", "Extensions");
+  state.Set("hue", 250);
+  state.Set("important", true);
+  state.Set("kept", true);
+  shell->ShowExtensionPrompt(
+      std::move(state),
+      base::BindOnce(&AnswerViolaInstallPrompt, std::move(prompt),
+                     std::move(done_callback)));
+  return true;
+}
+#endif
