+#if BUILDFLAG(IS_LINUX)
+bool ExtensionUninstallDialogImpl::ShowInViola() {
+  viola::ViolaProductShellView* shell =
+      viola::ViolaProductShellView::ForProfile(profile_);
+  if (!shell || !viola_prompt_id_.empty()) {
+    return false;
+  }
+  viola_prompt_id_ = base::UnguessableToken::Create().ToString();
+  const std::u16string name =
+      extensions::ui_util::GetFixupExtensionNameForUIDisplay(
+          extension()->name());
+  base::DictValue state;
+  state.Set("id", viola_prompt_id_);
+  state.Set("type", "extension");
+  state.Set("title", l10n_util::GetStringFUTF16(
+                         IDS_EXTENSION_PROMPT_UNINSTALL_TITLE, name));
+  state.Set("body",
+            triggering_extension()
+                ? l10n_util::GetStringFUTF16(
+                      IDS_EXTENSION_PROMPT_UNINSTALL_TRIGGERED_BY_EXTENSION,
+                      extensions::ui_util::GetFixupExtensionNameForUIDisplay(
+                          triggering_extension()->name()))
+                : std::u16string());
+  state.Set("details", base::ListValue());
+  state.Set("name", name);
+  state.Set("extensionId", extension()->id());
+  state.Set("accept",
+            l10n_util::GetStringUTF16(IDS_EXTENSION_PROMPT_UNINSTALL_BUTTON));
+  state.Set("cancel", u"Cancel");
+  state.Set("host", "Extensions");
+  state.Set("hue", 250);
+  state.Set("important", true);
+  state.Set("kept", true);
+  state.Set("danger", true);
+  shell->ShowExtensionPrompt(
+      std::move(state),
+      base::BindOnce(&ExtensionUninstallDialogImpl::OnViolaAnswer,
+                     weak_ptr_factory_.GetWeakPtr()));
+  return true;
+}
+
+void ExtensionUninstallDialogImpl::OnViolaAnswer(bool accepted) {
+  if (viola_prompt_id_.empty()) {
+    return;
+  }
+  viola_prompt_id_.clear();
+  // May destroy `this` through the delegate: nothing runs after it.
+  OnDialogClosed(accepted ? CLOSE_ACTION_UNINSTALL : CLOSE_ACTION_CANCELED);
+}
+
+void ExtensionUninstallDialogImpl::ClearViolaPrompt() {
+  if (viola_prompt_id_.empty()) {
+    return;
+  }
+  ProfileManager* profiles =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  if (profiles && profiles->IsValidProfile(profile_.get())) {
+    if (viola::ViolaProductShellView* shell =
+            viola::ViolaProductShellView::ForProfile(profile_)) {
+      shell->ClearExtensionPrompt(viola_prompt_id_);
+    }
+  }
+  viola_prompt_id_.clear();
+}
+#endif
