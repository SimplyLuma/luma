<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- SPDX-License-Identifier: MPL-2.0 -->
<node>
  <!--
    org.projectluma.AudioDevices1: Luma's sound output devices service.

    Session bus name org.projectluma.AudioDevices, object
    /org/projectluma/AudioDevices. Used by the Shell's sound menu and by
    Settings. Receivers and devices are dictionaries so fields can be added
    without a new interface version; clients ignore keys they do not know.
  -->
  <interface name="org.projectluma.AudioDevices1">
    <!--
      Version: 3 for this interface. Version 2 adds the per-app mixer, level
      meters and capture sessions; version 3 adds what each app is playing and
      its transport, the other sounds, and output labels. Clients check it
      before using them.
    -->
    <property name="Version" type="u" access="read"/>

    <!--
      AirPlayAvailable: false when there is no Avahi daemon, so no receiver can
      be found. The picker says so instead of looking forever.
    -->
    <property name="AirPlayAvailable" type="b" access="read"/>

    <!--
      AirPlayBrowsing: true while at least one client keeps the picker open.
    -->
    <property name="AirPlayBrowsing" type="b" access="read"/>

    <!--
      HiddenOutputs: node names of network outputs nobody chose (created by
      PipeWire discovery modules a person turned back on). Sound menus leave
      them out unless one is the current output.
    -->
    <property name="HiddenOutputs" type="as" access="read"/>

    <!--
      StartAirPlayBrowsing: the caller opened the picker. Browsing continues
      until StopAirPlayBrowsing, until the caller leaves the bus, or for at most
      three minutes; call again to keep a long-open picker current.
    -->
    <method name="StartAirPlayBrowsing"/>
    <method name="StopAirPlayBrowsing"/>

    <!--
      GetAirPlayReceivers: remembered receivers, plus every receiver on the
      network while browsing. Keys:
        id (s)                stable device id, never an address
        name (s)              the receiver's own name
        model (s)             model identifier, may be empty
        kind (s)              "computer", "speaker" or "tv"
        state (s)             "available", "connecting", "connected", "unavailable"
        remembered (b)
        requires_password (b) the receiver announces a password
        supported (b)         false when it cannot play PCM or ALAC
        node_name (s)         the PipeWire sink node name while connected
        error (s)             last failure: "password-required",
                              "password-incorrect", "denied", "unreachable",
                              "unsupported", "not-found", "failed" or ""
    -->
    <method name="GetAirPlayReceivers">
      <arg name="receivers" type="aa{sv}" direction="out"/>
    </method>

    <!--
      ConnectAirPlayReceiver: check that the receiver accepts a stream, create
      its output, make it the default and remember it. Pass an empty password
      unless the person just typed one. Fails with
      org.projectluma.AudioDevices1.Error.PasswordRequired, .PasswordIncorrect,
      .Denied, .Unreachable, .Unsupported, .NotFound, .Busy or .Failed; the
      message is a sentence fit to show.
    -->
    <method name="ConnectAirPlayReceiver">
      <arg name="id" type="s" direction="in"/>
      <arg name="password" type="s" direction="in"/>
    </method>

    <!--
      ForgetAirPlayReceiver: remove the output, the memory and any stored
      password.
    -->
    <method name="ForgetAirPlayReceiver">
      <arg name="id" type="s" direction="in"/>
    </method>

    <!--
      GetOutputDevices: local output devices this account has used. Keys:
        key (s)     stable device key (bluez:, usb:, display:, card:)
        name (s)    display name
        icon (s)    symbolic icon name
        auto_switch (b) false when the person moved the sound away from it the
                    last time it was connected, so it no longer takes the
                    sound when it connects (headphones and Bluetooth audio)
        present (b)
        last_seen (x) seconds since the epoch
    -->
    <method name="GetOutputDevices">
      <arg name="devices" type="aa{sv}" direction="out"/>
    </method>

    <method name="ForgetOutputDevice">
      <arg name="key" type="s" direction="in"/>
    </method>

    <signal name="AirPlayReceiversChanged"/>
    <signal name="OutputDevicesChanged"/>

    <!--
      GetOutputs (version 2): the outputs a person can send sound to right
      now, for per-app output pickers. Keys:
        name (s)         PipeWire node name, the value SetApplicationOutput takes
        description (s)  display name
        icon (s)         symbolic icon name
        default (b)      the current default output
      Version 3:
        label (s)        what a person calls it: "Speakers", the headphones'
                         or display's own name, the AirPlay receiver's name;
                         never a card, port or profile name
        detail (s)       how it connects: "Built in", "Wired", "USB",
                         "Bluetooth · 80%", "Display", "AirPlay"; followed by
                         the card's name only when two outputs share a label
        kind (s)         "speakers", "headphones", "usb", "airplay", "display"
        battery (x)      percent, or -1
        last_used (x)    seconds since the epoch it was last the output, or 0
    -->
    <method name="GetOutputs">
      <arg name="outputs" type="aa{sv}" direction="out"/>
    </method>
    <signal name="OutputsChanged"/>

    <!--
      GetApplications (version 2): the mixer. One entry per app with a sound
      stream, running or corked, however many streams it has; it stays for 10
      seconds after the app's last stream closes. The other sounds (System
      sounds, Messages, Phone) are always present, with their remembered
      volume. Other sounds first, then apps in the order they started.
      Keys:
        id (s)          the app key: Flatpak app id, application.id, name or
                        binary, in that order; "@system" for System sounds
        name (s)        the app's name from its desktop entry
        icon (s)        a GIcon string (icon name or file)
        desktop_id (s)  the desktop entry, or ""
        kind (s)        "system" or "app"
        volume (d)      0..1.5 on the cubic scale GNOME sliders use
        muted (b)
        output (s)      node name of the output the app was sent to and plays
                        on; "" when it follows the default
        playing_on (s)  node name of the output it plays on now, or ""
        playing (b)     a stream of the app is running now
        streams (au)    PipeWire node ids of the app's streams
        pid (x)         process id of one stream's client, or 0
      Version 3:
        listed (b)      belongs in the playing list (false for a silent
                        other sound)
        other (b)       one of the other sounds
        player (s)      bus name of the app's MPRIS player, or ""
        title (s)       what is playing, or "": show the app's name
        artist (s)      the artist; for a browser without one, the site
                        ("simplyluma.com"); or ""
        art (s)         artwork URL, or "": show the app's icon
        status (s)      "playing", "paused", "stopped", or "" without a player
        position (x)    microseconds into the track while paused, or -1
        can_play, can_pause, can_go_next, can_go_previous (b)
      playing is false while the player says it is paused.
      Volume, mute and output are remembered per app across restarts. The
      Set methods accept any app id, playing or not; a value set for an app
      that is not playing applies to its next stream.
    -->
    <method name="GetApplications">
      <arg name="applications" type="aa{sv}" direction="out"/>
    </method>
    <signal name="ApplicationsChanged">
      <arg name="applications" type="aa{sv}"/>
    </signal>
    <method name="SetApplicationVolume">
      <arg name="id" type="s" direction="in"/>
      <arg name="volume" type="d" direction="in"/>
    </method>
    <method name="SetApplicationMute">
      <arg name="id" type="s" direction="in"/>
      <arg name="muted" type="b" direction="in"/>
    </method>
    <!--
      SetApplicationOutput: send an app to one output (a name from GetOutputs)
      or back to the default ("").
    -->
    <method name="SetApplicationOutput">
      <arg name="id" type="s" direction="in"/>
      <arg name="output" type="s" direction="in"/>
    </method>

    <!--
      Transport (version 3): the app's MPRIS player. Fails with .NotFound for
      an app without one.
    -->
    <method name="ApplicationPlayPause">
      <arg name="id" type="s" direction="in"/>
    </method>
    <method name="ApplicationNext">
      <arg name="id" type="s" direction="in"/>
    </method>
    <method name="ApplicationPrevious">
      <arg name="id" type="s" direction="in"/>
    </method>
    <!--
      RaiseApplication (version 3): bring the app's window forward.
    -->
    <method name="RaiseApplication">
      <arg name="id" type="s" direction="in"/>
    </method>

    <!--
      WatchLevels (version 2): live meters for app ids, "@system",
      "output:<node name>" or "output:" (the default output). Levels is sent to
      the caller only, about 20 times a second, with meter positions from 0
      (-60 dB) to 1 (0 dBFS), until UnwatchLevels or until the caller leaves
      the bus. Nothing is metered while nobody watches; watch only while the
      meters are on screen. Call again with a new list when the rows change.
    -->
    <method name="WatchLevels">
      <arg name="targets" type="as" direction="in"/>
      <arg name="watch" type="u" direction="out"/>
    </method>
    <method name="UnwatchLevels">
      <arg name="watch" type="u" direction="in"/>
    </method>
    <signal name="Levels">
      <arg name="watch" type="u"/>
      <arg name="levels" type="a{sd}"/>
    </signal>

    <!--
      CreateCapture (version 2): for the audio capture portal backend. Creates
      one PipeWire node carrying the audio of the chosen apps (mode "apps",
      app ids from GetApplications, "@system" allowed) or of every app but the
      requester (mode "system"; include_self keeps the requester's own). New
      streams of those apps join it while it lives. The node is tagged with
      the requester's app id; a portal-restricted PipeWire remote of that app
      may link to it and to nothing else. Returns the capture id, node id and
      object serial. The capture ends with CloseCapture or when the caller
      leaves the bus.
    -->
    <method name="CreateCapture">
      <arg name="requester" type="s" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
      <arg name="apps" type="as" direction="in"/>
      <arg name="include_self" type="b" direction="in"/>
      <arg name="label" type="s" direction="in"/>
      <arg name="id" type="s" direction="out"/>
      <arg name="node" type="u" direction="out"/>
      <arg name="serial" type="t" direction="out"/>
    </method>
    <method name="CloseCapture">
      <arg name="id" type="s" direction="in"/>
    </method>
  </interface>
</node>
