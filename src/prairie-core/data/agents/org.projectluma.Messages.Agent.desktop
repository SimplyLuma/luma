[Desktop Entry]
Type=Application
Name=Messages
Comment=Gets new messages while Messages is closed
Exec=prairie-messages --agent --autostart
Icon=org.projectluma.Messages
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-AutoRestart=false
# Before luma-background is installed. With it, this start exits at once and the
# service starts the agent under its limits.
X-Luma-Background-Agent=org.projectluma.Messages.Agent
