# Exact upstream inputs for Atlas (luma-installer-atlas).
#
# Anaconda Web UI release whose D-Bus API clients, storage-plan model and
# runtime scripts Atlas reuses. Fedora 44 pairs anaconda-webui-68-1.fc44 with
# anaconda-core-44.30-2.fc44 in its GA repository.
ATLAS_ANACONDA_WEBUI_VERSION=68
ATLAS_ANACONDA_WEBUI_COMMIT=a8745f07a18f303375351f3ba577d73108f5163d
ATLAS_ANACONDA_CORE_EVR=44.30-2.fc44
# Cockpit pkg/lib commit anaconda-webui 68 pins (its Makefile COCKPIT_REPO_COMMIT, "358 + 2 commits").
ATLAS_COCKPIT_LIB_COMMIT=92e0108df1034207bcf7852c7747707d7da044ac
