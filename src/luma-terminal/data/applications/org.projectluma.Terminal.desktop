[Desktop Entry]
Type=Application
Name=Terminal
Comment=Run commands and work in a shell
Exec=python3 -m luma_terminal %U
Icon=org.projectluma.Terminal
Terminal=false
Categories=System;TerminalEmulator;
StartupNotify=true
DBusActivatable=true
# TV home opt-in (docs/developer-platform/tv-mode.md): its TV presentation is luma_terminal/ui_tv.py.
X-Luma-TV=true
X-Luma-TV-Tile=org.projectluma.Terminal-tv
X-Luma-TV-Presentation=tv
