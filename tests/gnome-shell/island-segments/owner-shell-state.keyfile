[org/project-luma/shell-state]
home-apps=@as []
input-method='luma-latin'
mobile-launcher-columns=4
reduce-transparency=false
restore-app-state=true
schema-version=2
shelf-actions-anchor='center'
shelf-actions-visible=true
shelf-auto-hide=false
shelf-dock-anchor='center'
shelf-dock-visible=true
shelf-edge='bottom'
shelf-edge-mode='floating'
shelf-float-ends=true
shelf-group-layout='centered-combined'
shelf-islands=['dock', 'actions']
shelf-layout-version=1
shelf-material='dark'
shelf-monitor-mode='primary'
shelf-overflow-mode='scroll'
shelf-padding=10
shelf-reserve-work-area=true
shelf-span-full=true
shelf-surface-mode='separate'
status-clock-fill='#7f8892'
status-controls-fill='#7f8892'
status-controls-right=true
status-date-size=9
status-divider=true
status-fill-strength='14'
status-frame='none'
status-frame-scope='all'
status-glyph-tiles=true
status-time-size=13
surface-treatment='dark'
