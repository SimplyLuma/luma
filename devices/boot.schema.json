{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SimplyLuma/luma/devices/boot.schema.json",
  "title": "Luma device boot policy (devices/<vendor>/<codename>/boot.toml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cmdline"],
  "properties": {
    "schema": {"const": 1},
    "partition": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "partition_size": {"type": "integer", "minimum": 1},
    "os_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "os_patch_level": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "format": {"enum": ["android-boot-v2", "android-boot-v3", "android-boot-v4", "uefi"]},
    "page_size": {"enum": [2048, 4096, 16384]},
    "uefi": {
      "type": "object", "additionalProperties": false, "required": ["loader", "dtb", "secure_boot"],
      "properties": {
        "loader": {"const": "BOOTAA64.EFI"},
        "dtb": {"type": "string", "pattern": "^[a-z0-9_-]+/[A-Za-z0-9_.,+-]+\\.dtb$"},
        "secure_boot": {"enum": ["signed", "development-disabled"]}
      }
    },
    "cmdline": {
      "type": "object", "additionalProperties": false, "required": ["args", "generated", "forbidden"],
      "properties": {
        "args": {"type": "array", "items": {"$ref": "#/$defs/arg"}},
        "generated": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_.]+$"}},
        "forbidden": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/arg"}}
      }
    },
    "avb": {
      "type": "object", "additionalProperties": false, "required": ["footer", "vbmeta"],
      "properties": {
        "footer": {"enum": ["none", "hash"]},
        "algorithm": {"enum": ["NONE", "SHA256_RSA2048", "SHA256_RSA4096", "SHA256_RSA8192", "SHA512_RSA2048", "SHA512_RSA4096", "SHA512_RSA8192"]},
        "hash_algorithm": {"enum": ["sha256", "sha512"]},
        "rollback_index": {"type": "integer", "minimum": 0},
        "vbmeta": {"enum": ["untouched", "disabled-verification", "luma-signed"]}
      }
    },
    "dtbo": {
      "type": "object", "additionalProperties": false, "required": ["policy"],
      "properties": {
        "policy": {"enum": ["blank", "stock", "luma", "none"]},
        "size": {"type": "integer", "minimum": 1},
        "partitions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^dtbo(_[ab])?$"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["format"], "properties": {"format": {"const": "uefi"}}},
      "then": {
        "required": ["uefi"],
        "not": {"anyOf": [
          {"required": ["partition"]}, {"required": ["avb"]}, {"required": ["dtbo"]},
          {"required": ["page_size"]}, {"required": ["partition_size"]},
          {"required": ["os_version"]}, {"required": ["os_patch_level"]}
        ]}
      },
      "else": {"required": ["partition", "avb", "dtbo"], "not": {"required": ["uefi"]}}
    }
  ],
  "$defs": {
    "arg": {"type": "string", "pattern": "^[A-Za-z0-9_.,:/=+-]+$"}
  }
}
