--- a/drivers/tee/qcomtee/core.c
+++ b/drivers/tee/qcomtee/core.c
@@ -842,6 +842,7 @@ int qcomtee_object_do_invoke_internal(struct qcomtee_object_invoke_ctx *oic,
 	qcomtee_fetch_async_reqs(oic);
 out:
-	qcomtee_msg_buffers_free(oic);
+	if (!(oic->flags & QCOMTEE_OIC_FLAG_RETAIN_SHM))
