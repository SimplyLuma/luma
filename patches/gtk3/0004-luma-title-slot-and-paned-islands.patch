From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <devnull@projectluma.local>
Date: Wed, 2 Sep 2026 11:30:00 -0500
Subject: [PATCH] headerbar: host custom-title controls on the command row; paned surfaces become islands

A custom title that is not text (GtkLabel or a box of labels) is a control
and is hosted at the center of the Luma command row while the header owns
the automatic identity; gtk_header_bar_get_custom_title() keeps returning it
and the title row no longer measures, allocates or enumerates it. A GtkPaned
placed on the native work surface marks the surface transparent and itself as
a split so the installed theme presents both panes as islands.
---

diff --git a/gtk/gtkheaderbar.c b/gtk/gtkheaderbar.c
index c85072d..3f71c53 100644
--- a/gtk/gtkheaderbar.c
+++ b/gtk/gtkheaderbar.c
@@ -100,6 +100,7 @@ struct _GtkHeaderBarPrivate
   GtkWidget *luma_command_start;
   GtkWidget *luma_command_end;
   GList *luma_command_children;
+  GtkWidget *luma_hosted_title;
 
   GtkCssGadget *gadget;
 };
@@ -139,6 +140,12 @@ static void luma_leave_command_row (GtkHeaderBar *bar);
 static gboolean luma_command_row_active (GtkHeaderBar *bar);
 static void luma_command_row_measure (GtkHeaderBar *bar, GtkOrientation orientation, gint for_size, gint *minimum, gint *natural);
 static gint luma_command_row_height (GtkHeaderBar *bar, gint width);
+static void luma_host_title (GtkHeaderBar *bar);
+static void luma_unhost_title (GtkHeaderBar *bar);
+static void notify_child_cb (GObject *child, GParamSpec *pspec, GtkHeaderBar *bar);
+/* The custom title stays the application's widget, but while it is hosted on
+ * the command row the title row must not measure, allocate or enumerate it. */
+#define LUMA_TITLE_ROW_CUSTOM(priv) ((priv)->luma_hosted_title ? NULL : (priv)->custom_title)
 
 static void gtk_header_bar_buildable_init (GtkBuildableIface *iface);
 static void remove_automatic_luma_identity (GtkHeaderBar *bar);
@@ -698,7 +705,7 @@ gtk_header_bar_get_size (GtkWidget      *widget,
         nvis_children += 1;
     }
 
-  if (priv->custom_title != NULL)
+  if (LUMA_TITLE_ROW_CUSTOM (priv) != NULL)
     {
       if (add_child_size (priv->custom_title, orientation, &center_min, &center_nat))
         nvis_children += 1;
@@ -778,7 +785,7 @@ gtk_header_bar_compute_size_for_orientation (GtkWidget *widget,
       required_natural += child_natural;
     }
 
-  if (priv->custom_title != NULL &&
+  if (LUMA_TITLE_ROW_CUSTOM (priv) != NULL &&
       gtk_widget_get_visible (priv->custom_title))
     {
       gtk_widget_get_preferred_width (priv->custom_title,
@@ -903,7 +910,7 @@ gtk_header_bar_compute_size_for_opposing_orientation (GtkWidget *widget,
                                        &center_min, &center_nat);
     }
 
-  if (priv->custom_title != NULL &&
+  if (LUMA_TITLE_ROW_CUSTOM (priv) != NULL &&
       gtk_widget_get_visible (priv->custom_title))
     {
       gtk_widget_get_preferred_height (priv->custom_title,
@@ -1109,7 +1116,7 @@ gtk_header_bar_allocate_contents (GtkCssGadget        *gadget,
   title_minimum_size = 0;
   title_natural_size = 0;
 
-  if (priv->custom_title != NULL &&
+  if (LUMA_TITLE_ROW_CUSTOM (priv) != NULL &&
       gtk_widget_get_visible (priv->custom_title))
     title_widget = priv->custom_title;
   else if (priv->label_box != NULL)
@@ -1476,7 +1483,15 @@ gtk_header_bar_set_custom_title (GtkHeaderBar *bar,
       GtkWidget *custom = priv->custom_title;
 
       priv->custom_title = NULL;
-      gtk_widget_unparent (custom);
+      if (priv->luma_hosted_title == custom)
+        {
+          g_signal_handlers_disconnect_by_func (custom, notify_child_cb, bar);
+          gtk_style_context_remove_class (gtk_widget_get_style_context (custom), "luma-command-title");
+          priv->luma_hosted_title = NULL;
+          gtk_container_remove (GTK_CONTAINER (priv->luma_command_bar), custom);
+        }
+      else
+        gtk_widget_unparent (custom);
     }
 
   if (title_widget != NULL)
@@ -1486,6 +1501,7 @@ gtk_header_bar_set_custom_title (GtkHeaderBar *bar,
       gtk_header_bar_reorder_css_node (bar, GTK_PACK_START, priv->custom_title);
       gtk_widget_set_parent (priv->custom_title, GTK_WIDGET (bar));
       gtk_widget_set_valign (priv->custom_title, GTK_ALIGN_CENTER);
+      luma_host_title (bar);
 
       if (priv->label_box != NULL)
         {
@@ -1834,7 +1850,7 @@ gtk_header_bar_forall (GtkContainer *container,
         (* callback) (child->widget, callback_data);
     }
 
-  if (priv->custom_title != NULL)
+  if (LUMA_TITLE_ROW_CUSTOM (priv) != NULL)
     (* callback) (priv->custom_title, callback_data);
 
   if (include_internals && priv->label_box != NULL)
@@ -2349,10 +2365,102 @@ luma_update_command_bar_visibility (GtkHeaderBar *bar)
         }
     }
 
+  if (priv->luma_hosted_title && gtk_widget_get_visible (priv->luma_hosted_title))
+    visible = TRUE;
+
+  /* An empty group must not paint its material as a sliver. */
+  {
+    GtkWidget *groups[2] = { priv->luma_command_start, priv->luma_command_end };
+    guint i;
+
+    for (i = 0; i < 2; i++)
+      {
+        GList *children = gtk_container_get_children (GTK_CONTAINER (groups[i]));
+        gboolean any = FALSE;
+
+        for (l = children; l; l = l->next)
+          if (gtk_widget_get_visible (l->data))
+            any = TRUE;
+        g_list_free (children);
+        gtk_widget_set_visible (groups[i], any);
+      }
+  }
+
   gtk_widget_set_visible (priv->luma_command_bar, visible);
   gtk_widget_queue_resize (GTK_WIDGET (bar));
 }
 
+/* Luma title slot: only text stays centered on the title row.  A GtkLabel, or
+ * a box made only of labels, is a title; anything else (stack switchers,
+ * buttons, entries) is a control and is hosted at the center of the command
+ * row.  gtk_header_bar_get_custom_title() keeps returning the widget. */
+static gboolean
+luma_custom_title_is_text (GtkWidget *widget)
+{
+  gboolean text = TRUE;
+
+  if (widget == NULL || GTK_IS_LABEL (widget))
+    return TRUE;
+
+  if (!GTK_IS_BOX (widget))
+    return FALSE;
+
+  {
+    GList *children = gtk_container_get_children (GTK_CONTAINER (widget));
+    GList *l;
+
+    for (l = children; l; l = l->next)
+      if (!GTK_IS_LABEL (l->data))
+        text = FALSE;
+    g_list_free (children);
+  }
+
+  return text;
+}
+
+static void
+luma_host_title (GtkHeaderBar *bar)
+{
+  GtkHeaderBarPrivate *priv = gtk_header_bar_get_instance_private (bar);
+  GtkWidget *title = priv->custom_title;
+
+  if (!priv->luma_command_bar || priv->luma_hosted_title || !title ||
+      luma_custom_title_is_text (title))
+    return;
+
+  g_object_ref (title);
+  gtk_widget_unparent (title);
+  gtk_style_context_add_class (gtk_widget_get_style_context (title), "luma-command-title");
+  gtk_box_set_center_widget (GTK_BOX (priv->luma_command_bar), title);
+  g_signal_connect (title, "notify::visible", G_CALLBACK (notify_child_cb), bar);
+  g_object_unref (title);
+  priv->luma_hosted_title = title;
+  luma_update_command_bar_visibility (bar);
+}
+
+static void
+luma_unhost_title (GtkHeaderBar *bar)
+{
+  GtkHeaderBarPrivate *priv = gtk_header_bar_get_instance_private (bar);
+  GtkWidget *title = priv->luma_hosted_title;
+
+  if (!title)
+    return;
+
+  g_object_ref (title);
+  g_signal_handlers_disconnect_by_func (title, notify_child_cb, bar);
+  gtk_container_remove (GTK_CONTAINER (priv->luma_command_bar), title);
+  gtk_style_context_remove_class (gtk_widget_get_style_context (title), "luma-command-title");
+  priv->luma_hosted_title = NULL;
+  if (priv->custom_title == title)
+    {
+      gtk_header_bar_reorder_css_node (bar, GTK_PACK_START, title);
+      gtk_widget_set_parent (title, GTK_WIDGET (bar));
+    }
+  g_object_unref (title);
+  gtk_widget_queue_resize (GTK_WIDGET (bar));
+}
+
 static void
 luma_command_child_visibility (GObject      *child,
                                GParamSpec   *pspec,
@@ -2423,6 +2531,7 @@ luma_enter_command_row (GtkHeaderBar *bar)
       priv->luma_command_children = g_list_append (priv->luma_command_children, child);
     }
 
+  luma_host_title (bar);
   luma_update_command_bar_visibility (bar);
   _gtk_header_bar_update_separator_visibility (bar);
 }
@@ -2437,6 +2546,8 @@ luma_leave_command_row (GtkHeaderBar *bar)
   if (!priv->luma_command_bar)
     return;
 
+  luma_unhost_title (bar);
+
   /* Return the hosted actions to the header's own child list. */
   for (l = priv->luma_command_children; l; l = next)
     {
diff --git a/gtk/gtkpaned.c b/gtk/gtkpaned.c
index 4d44a07..a160d89 100644
--- a/gtk/gtkpaned.c
+++ b/gtk/gtkpaned.c
@@ -1662,6 +1662,36 @@ gtk_paned_create_child_window (GtkPaned  *paned,
   return window;
 }
 
+/* Luma: a paned placed on the native work surface presents its panes as
+ * sibling islands; the surface itself turns transparent.  The marking happens
+ * at realize, when the widget's place in the application window is known. */
+static void
+luma_mark_split_paned (GtkWidget *widget)
+{
+  GtkWidget *ancestor = gtk_widget_get_parent (widget);
+  GtkStyleContext *own = gtk_widget_get_style_context (widget);
+
+  if (gtk_style_context_has_class (own, "luma-native-work-surface"))
+    {
+      gtk_style_context_add_class (own, "luma-split-surface");
+      gtk_style_context_add_class (own, "luma-split-paned");
+      return;
+    }
+
+  while (ancestor && !GTK_IS_WINDOW (ancestor))
+    {
+      GtkStyleContext *context = gtk_widget_get_style_context (ancestor);
+
+      if (gtk_style_context_has_class (context, "luma-native-work-surface"))
+        {
+          gtk_style_context_add_class (context, "luma-split-surface");
+          gtk_style_context_add_class (gtk_widget_get_style_context (widget), "luma-split-paned");
+          return;
+        }
+      ancestor = gtk_widget_get_parent (ancestor);
+    }
+}
+
 static void
 gtk_paned_realize (GtkWidget *widget)
 {
@@ -1671,6 +1701,8 @@ gtk_paned_realize (GtkWidget *widget)
   GdkWindowAttr attributes;
   gint attributes_mask;
 
+  luma_mark_split_paned (widget);
+
   gtk_widget_set_realized (widget, TRUE);
 
   window = gtk_widget_get_parent_window (widget);
