From 3b28fe584e1c2a1fe7811b2e2e2c9932afeab3fe Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Dawid=20Wr=C3=B3bel?= <me@dawidwrobel.com>
Date: Mon, 3 Aug 2026 02:27:59 +0200
Subject: [PATCH 08/41] tee: qseecom: replace a stale registry entry instead of
 shadowing it

The driver remembers applications it loaded because TZ will not look them up by
name afterwards. Entries were appended unconditionally and lookups take the
first match, so loading an application whose previous instance had gone left two
entries under one name and every command went to the dead id -- EINVAL from TZ,
permanently, with no way back short of reloading the module.

Reachable whenever an application is unloaded outside the driver's knowledge,
and observed exactly that way: unload out of band, load again, and the session
opens against the old id.

A name identifies one application, so an existing entry under that name is stale
by definition. Replace it.

Assisted-by: Claude:claude-opus-5
---
 drivers/tee/qseecom/core.c | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/drivers/tee/qseecom/core.c b/drivers/tee/qseecom/core.c
index 9cbb9f201..28066577e 100644
--- a/drivers/tee/qseecom/core.c
+++ b/drivers/tee/qseecom/core.c
@@ -430,7 +430,7 @@ static void qseecom_tee_app_forget(struct qseecom_tee *qtee, u32 app_id)
 static int qseecom_tee_app_remember(struct qseecom_tee *qtee, const char *name,
 				    u32 app_id)
 {
-	struct qseecom_tee_app *app;
+	struct qseecom_tee_app *app, *old;
 
 	app = kzalloc_obj(*app);
 	if (!app)
@@ -440,6 +440,23 @@ static int qseecom_tee_app_remember(struct qseecom_tee *qtee, const char *name,
 	strscpy(app->name, name, sizeof(app->name));
 
 	mutex_lock(&qtee->apps_lock);
+
+	/*
+	 * A name identifies one application, so an existing entry under this
+	 * name is stale -- the application it referred to is gone, whether we
+	 * unloaded it or something else did. Replace it rather than appending,
+	 * because lookups take the first match and a stale entry would
+	 * otherwise shadow the live one for good, failing every command with
+	 * an id TZ no longer knows.
+	 */
+	list_for_each_entry(old, &qtee->apps, node) {
+		if (!strcmp(old->name, name)) {
+			list_del(&old->node);
+			kfree(old);
+			break;
+		}
+	}
+
 	list_add_tail(&app->node, &qtee->apps);
 	mutex_unlock(&qtee->apps_lock);
 
