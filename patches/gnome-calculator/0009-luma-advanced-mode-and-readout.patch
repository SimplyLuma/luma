+    /* The two window widths the design gives Calculator. Basic is the
+     * default; Advanced adds the scientific keypad and the width it needs. */
+    private const int BASIC_WIDTH = 360;
+    private const int ADVANCED_WIDTH = 620;
+    private const int WINDOW_HEIGHT = 470;
+
+    [GtkChild]
+    private unowned Gtk.Label identity_subtitle;
+
     private const ActionEntry[] window_entries =
     {
         { "copy", copy_cb, null, null, null },
@@ -52,6 +61,10 @@
 
         var settings = new Settings ("org.gnome.calculator");
         add_action (settings.create_action ("number-format"));
