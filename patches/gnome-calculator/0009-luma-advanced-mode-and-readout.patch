         if (DEVELOPMENT_BUILD)
             add_css_class ("devel");
@@ -75,6 +88,23 @@
         _display.grab_focus ();
     }
 
+    /* Basic and Advanced are the same calculation seen at two widths. The
+     * equation is never touched here, so switching mode mid-sum keeps the
+     * sum; only the keypad and the window width change. */
+    private void apply_button_mode (string name)
+    {
+        var advanced = name == "advanced";
+        _buttons.mode = advanced ? ButtonMode.ADVANCED : ButtonMode.BASIC;
+        identity_subtitle.label = advanced ? _("Advanced") : _("Basic");
+
+        if (maximized || fullscreened)
+            return;
+
+        var width = advanced ? ADVANCED_WIDTH : BASIC_WIDTH;
+        if (default_width != width)
+            set_default_size (width, int.max (default_height, WINDOW_HEIGHT));
+    }
+
     private void copy_cb ()
     {
         equation.copy ();
