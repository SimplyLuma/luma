diff -ruN before/src/buttons-basic.vala gnome-calculator-50.0/src/buttons-basic.vala
--- a/src/buttons-basic.vala
+++ b/src/buttons-basic.vala
@@ -14,11 +14,33 @@
     [GtkChild]
     private unowned Gtk.Widget basic;
     [GtkChild]
+    private unowned Gtk.Widget scientific;
+    [GtkChild]
     private unowned Gtk.Button calc_numeric_point_button;
+    [GtkChild]
+    private unowned Gtk.Button calc_clear_button;
+
+    /* Advanced adds the scientific keypad to the left of the basic one. The
+     * basic keypad itself never changes, so a calculation in progress keeps
+     * both its state and its position under the pointer. */
+    public bool advanced
+    {
+        get { return scientific.visible; }
+        set { scientific.visible = value; }
+    }
 
     public BasicButtonPanel (MathButtons buttons)
     {
         basic.set_direction (Gtk.TextDirection.LTR);
+        scientific.set_direction (Gtk.TextDirection.LTR);
         calc_numeric_point_button.set_label (buttons.equation.serializer.get_radix ().to_string ());
+
+        /* AC clears the whole calculation, C clears the entry being typed. The
+         * key says which one it is, and keeps its width either way. */
+        var equation = buttons.equation;
+        equation.notify["display"].connect (() => {
+            calc_clear_button.label = equation.is_empty ? "AC" : "C";
+        });
+        calc_clear_button.label = equation.is_empty ? "AC" : "C";
     }
 }
