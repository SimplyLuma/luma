diff -ruN a/data/theme/luma-shelf.css b/data/theme/luma-shelf.css
--- a/data/theme/luma-shelf.css	2026-09-03 15:41:41.296645651 -0400
+++ b/data/theme/luma-shelf.css	2026-09-03 15:41:41.441325750 -0400
@@ -133,3 +133,56 @@
 
 .luma-shelf-dock-scroll:overflowing {
   box-shadow: inset 8px 0 8px -8px rgba(231, 233, 232, 0.18); }
+
+/* Dock: the Apps tile is hidden by the Shelf itself, and its separator goes
+   with it, otherwise the separator and the empty container read as dead space
+   at both ends of the dock. */
+.luma-shelf-dock-island #dash .dash-separator {
+  width: 0;
+  min-width: 0;
+  margin: 0;
+  padding: 0;
+  background-color: transparent; }
+
+/* Actions island: the clock is one left-aligned block with a real inset.
+ *
+ * The two labels take the same minimum width on purpose. St centres a label's
+ * text inside whatever width the label has, so without matching widths the
+ * narrower date reads as indented under the time no matter how it is aligned.
+ * 52px is the time's own width — wider leaves slack that shows up as a gap
+ * before the quick options. */
+.luma-shelf-actions-island .luma-shelf-material {
+  padding: 7px 9px 7px 12px; }
+
+.luma-shelf-actions-box {
+  spacing: 6px; }
+  .luma-shelf-actions-box .clock-display {
+    min-width: 0;
+    padding: 0; }
+  .luma-shelf-actions-box .luma-clock-content {
+    min-width: 0;
+    padding-top: 3px;
+    padding-left: 0; }
+  .luma-shelf-actions-box .luma-clock-time,
+  .luma-shelf-actions-box .luma-clock-date {
+    min-width: 52px;
+    text-align: left; }
+
+/* Dock tooltip: the pill naming a tile on hover.
+ *
+ * The dash already owns one shared label actor and places it, which is the
+ * shared element the design calls for, so this styles that rather than adding
+ * a second tooltip. The inset ring is a 1px border with the padding reduced to
+ * match, because St has no inset box-shadow and the box must stay its measured
+ * size. There is no backdrop blur: a virtual display has no 3D, and an opaque
+ * fill reads better than a flat translucent pill. */
+.dash-label {
+  padding: 4px 10px;
+  border: 1px solid rgba(255, 255, 255, 0.09);
+  border-radius: 999px;
+  background-color: rgba(42, 46, 52, 0.94);
+  color: #e6eaec;
+  font-family: 'Figtree', system-ui, sans-serif;
+  font-size: 11px;
+  font-weight: 700;
+  text-align: center; }
