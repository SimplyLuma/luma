+++ b/js/ui/lumaCapture.js
@@ -0,0 +1,1240 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Capture: Luma's screenshot and screen recording tool.
+//
+// GNOME's screenshot UI (screenshot.js) still freezes the screen, selects
+// areas, windows and monitors, and drives the recorder. This module draws
+// what a person sees and touches instead of GNOME's OSD panel: one bar above
+// the shelf, the Options menu, the countdown, the flash, the recording pill
+// and the floating thumbnail, all on Luma's surface material and placed by
+// the shared shelf placement rule (lumaShelfSurface.js).
+//
+// What Capture leaves on screen while it works stays out of what it records.
+// A screenshot or a recording paints the stage into its own framebuffer; the
+// screen paints into its stage views' framebuffers. CaptureHidden skips the
+// first kind, so the recording pill, its outline, the countdown, the flash and
+// the thumbnail are never in a screenshot or video. (The bar and its menu need
+// not be: a screenshot is taken of the screen as it was before they opened,
+// and they are gone before a timed capture.)
+
+import Atk from 'gi://Atk';
+import Clutter from 'gi://Clutter';
+import GdkPixbuf from 'gi://GdkPixbuf';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import Meta from 'gi://Meta';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import * as Main from './main.js';
+import * as SurfaceMaterials from './lumaSurfaceMaterials.js';
+import {placeFromShelfBar, placeShelfBar} from './lumaShelfSurface.js';
+
+const STYLESHEET_URI = 'resource:///org/gnome/shell/theme/luma-capture.css';
+const SETTINGS_SCHEMA = 'org.project_luma.capture';
+
+export const Mode = {
+    SCREEN: 'screen',
+    WINDOW: 'window',
+    SELECTION: 'selection',
+    RECORD_SCREEN: 'record-screen',
+    RECORD_SELECTION: 'record-selection',
+};
+
+export const MODES = [Mode.SCREEN, Mode.WINDOW, Mode.SELECTION,
+    Mode.RECORD_SCREEN, Mode.RECORD_SELECTION];
+
+export const isRecordingMode = mode => mode === Mode.RECORD_SCREEN || mode === Mode.RECORD_SELECTION;
+
+// The selector a mode uses: the whole monitor, a window or a selection.
+export function modeTarget(mode) {
+    switch (mode) {
+    case Mode.SCREEN:
+    case Mode.RECORD_SCREEN:
+        return Mode.SCREEN;
+    case Mode.WINDOW:
+        return Mode.WINDOW;
+    default:
+        return Mode.SELECTION;
+    }
+}
+
+export const TIMERS = [0, 5, 10];
+export const MIN_SELECTION = 24;
+const THUMBNAIL_SECONDS = 5;
+const BAR_DISTANCE = 8;
+const THUMBNAIL_DISTANCE = 18;
+
+export const reduceMotion = () => !St.Settings.get().enable_animations;
+const stageScale = () => St.ThemeContext.get_for_stage(global.stage).scale_factor;
+const log = (message, data) => console.log(`Luma Capture: ${message}${data ? ` ${JSON.stringify(data)}` : ''}`);
+
+let stylesheetLoaded = false;
+export function loadStylesheet() {
+    if (stylesheetLoaded)
+        return;
+    stylesheetLoaded = true;
+    const theme = St.ThemeContext.get_for_stage(global.stage).get_theme();
+    theme.load_stylesheet(Gio.File.new_for_uri(STYLESHEET_URI));
+}
+
+// ── Staying out of captures ────────────────────────────────────────────────
+
+let paintInCaptures = false;
+
+// Test harnesses photograph the stage with the same offscreen paint a
+// screenshot uses; they turn this on to see what a person sees.
+export function setPaintInCaptures(paint) {
+    paintInCaptures = paint;
+}
+
+// Whether this paint is the screen itself rather than a screenshot or
+// recording of it (see the comment at the top). Only for actors with no
+// offscreen-redirected ancestor, whose paint goes straight to a view.
+export function paintsOnScreen(paintContext) {
+    if (paintInCaptures)
+        return true;
+    const framebuffer = paintContext.get_framebuffer();
+    return global.stage.peek_stage_views().some(view =>
+        view.get_framebuffer() === framebuffer || view.get_onscreen() === framebuffer);
+}
+
+export const CaptureHidden = GObject.registerClass(
+class CaptureHidden extends St.Widget {
+    vfunc_paint(paintContext) {
+        if (paintsOnScreen(paintContext))
+            super.vfunc_paint(paintContext);
+    }
+});
+
+// ── Options ────────────────────────────────────────────────────────────────
+
+const DEFAULTS = {
+    'save-to': 'pictures',
+    'other-location': '',
+    'timer': 0,
+    'show-thumbnail': true,
+    'remember-selection': true,
+    'show-pointer': false,
+    'last-mode': Mode.SELECTION,
+    'last-selection': [],
+};
+
+// Every choice in the Options menu, kept in GSettings.
+export class CaptureOptions {
+    constructor() {
+        const source = Gio.SettingsSchemaSource.get_default();
+        const schema = source?.lookup(SETTINGS_SCHEMA, true);
+        this._settings = schema ? new Gio.Settings({settings_schema: schema}) : null;
+        this._memory = new Map(Object.entries(DEFAULTS));
+        if (!this._settings)
+            log('settings schema is not installed; choices last until the Shell restarts');
+    }
+
+    get settings() {
+        return this._settings;
+    }
+
+    _get(key) {
+        if (!this._settings)
+            return this._memory.get(key);
+        switch (key) {
+        case 'timer':
+            return this._settings.get_uint(key);
+        case 'show-thumbnail':
+        case 'remember-selection':
+        case 'show-pointer':
+            return this._settings.get_boolean(key);
+        case 'last-selection':
+            return this._settings.get_value(key).deepUnpack();
+        default:
+            return this._settings.get_string(key);
+        }
+    }
+
+    _set(key, value) {
+        if (!this._settings) {
+            this._memory.set(key, value);
+            return;
+        }
+        switch (key) {
+        case 'timer':
+            this._settings.set_uint(key, value);
+            break;
+        case 'show-thumbnail':
+        case 'remember-selection':
+        case 'show-pointer':
+            this._settings.set_boolean(key, value);
+            break;
+        case 'last-selection':
