+// ── Countdown and flash ────────────────────────────────────────────────────
+
+export const Countdown = GObject.registerClass(
+class Countdown extends CaptureHidden {
+    _init() {
+        super._init({
+            style_class: 'luma-capture-countdown',
+            layout_manager: new Clutter.BinLayout(),
+            visible: false,
+            accessible_role: Atk.Role.NOTIFICATION,
+        });
+        Shell.util_set_hidden_from_pick(this, true);
+        this._blur = new Shell.BlurEffect({mode: Shell.BlurMode.BACKGROUND, radius: 16, brightness: 1});
+        this.add_effect_with_name('luma-capture-countdown-blur', this._blur);
+        this._label = new St.Label({
+            style_class: 'luma-capture-countdown-label',
+            x_align: Clutter.ActorAlign.CENTER,
+            y_align: Clutter.ActorAlign.CENTER,
+        });
+        this.add_child(this._label);
+        this._timeoutId = 0;
+        this._resolve = null;
+    }
+
+    get seconds() {
+        return Number(this._label.text);
+    }
+
+    // Counts down from `seconds` centred on `monitor` at 44% of its height.
+    // Resolves true when it reaches zero, false when cancelled.
+    run(seconds, monitor) {
+        this.cancel();
+        return new Promise(resolve => {
+            this._resolve = resolve;
+            let remaining = seconds;
+            const scale = stageScale();
+            const size = 112 * scale;
+            this._blur.set({
+                corner_radius_top_left: size / 2,
+                corner_radius_top_right: size / 2,
+                corner_radius_bottom_left: size / 2,
+                corner_radius_bottom_right: size / 2,
+            });
+            this.set_position(Math.round(monitor.x + (monitor.width - size) / 2),
+                Math.round(monitor.y + monitor.height * 0.44 - size / 2));
+            this._label.text = `${remaining}`;
+            this.show();
+            this.get_accessible()?.emit('notification', this._label.text, Atk.Live.ASSERTIVE);
+            this._timeoutId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 1000, () => {
+                remaining--;
+                if (remaining <= 0) {
+                    this._timeoutId = 0;
+                    this._finish(true);
+                    return GLib.SOURCE_REMOVE;
+                }
+                this._label.text = `${remaining}`;
+                return GLib.SOURCE_CONTINUE;
+            });
+            GLib.Source.set_name_by_id(this._timeoutId, '[gnome-shell] Capture countdown');
+        });
+    }
+
+    cancel() {
+        this._finish(false);
+    }
+
+    _finish(completed) {
+        if (this._timeoutId)
+            GLib.source_remove(this._timeoutId);
+        this._timeoutId = 0;
+        this.hide();
+        const resolve = this._resolve;
+        this._resolve = null;
+        resolve?.(completed);
+    }
+
+    get running() {
+        return this._resolve !== null;
+    }
+});
