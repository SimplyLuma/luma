+function specialDir(directory) {
+    return GLib.get_user_special_dir(directory) || GLib.get_home_dir();
+}
+
+// The folder a capture is saved in, or null for the clipboard. Pictures and
+// Videos keep GNOME's Screenshots and Screencasts folders inside them.
+export function destinationDirectory(destination, kind, otherLocation = '') {
+    const recording = kind === 'recording';
+    switch (destination) {
+    case 'clipboard':
+        return recording ? destinationDirectory('pictures', kind) : null;
+    case 'desktop':
+        return specialDir(GLib.UserDirectory.DIRECTORY_DESKTOP);
+    case 'other':
+        if (otherLocation && GLib.file_test(otherLocation, GLib.FileTest.IS_DIR))
+            return otherLocation;
+        return destinationDirectory('pictures', kind);
+    default:
+        return recording
+            // Translators: name of the folder under ~/Videos for screen recordings.
+            ? GLib.build_filenamev([specialDir(GLib.UserDirectory.DIRECTORY_VIDEOS), _('Screencasts')])
+            // Translators: name of the folder under ~/Pictures for screenshots.
+            : GLib.build_filenamev([specialDir(GLib.UserDirectory.DIRECTORY_PICTURES), _('Screenshots')]);
+    }
+}
+
+// What the thumbnail and the screen reader say about where a capture went.
+export function destinationLabel(destination, kind, otherLocation = '') {
+    const recording = kind === 'recording';
+    if (destination === 'clipboard' && !recording)
+        return _('Copied to the clipboard');
+    if (destination === 'desktop')
+        return _('Saved to Desktop');
+    if (destination === 'other' && otherLocation && GLib.file_test(otherLocation, GLib.FileTest.IS_DIR))
+        return _('Saved to %s').format(GLib.path_get_basename(otherLocation));
+    return recording ? _('Saved to Videos') : _('Saved to Pictures');
+}
+
+// What the screen reader says when a capture is saved.
+export function resultAnnouncement(kind, destination, otherLocation = '') {
+    const recording = kind === 'recording';
+    if (destination === 'clipboard' && !recording)
+        return _('Screenshot copied to the clipboard');
+    let place;
+    if (destination === 'desktop')
+        place = _('Desktop');
+    else if (destination === 'other' && otherLocation && GLib.file_test(otherLocation, GLib.FileTest.IS_DIR))
+        place = GLib.path_get_basename(otherLocation);
+    else
+        place = recording ? _('Videos') : _('Pictures');
+    return recording
+        ? _('Recording saved to %s').format(place)
+        : _('Screenshot saved to %s').format(place);
+}
+
+// "Screenshot 2026-09-16 at 10.22.03", without an extension.
+export function fileStem(kind, time = GLib.DateTime.new_now_local()) {
+    const date = time.format('%Y-%m-%d');
+    const clock = time.format('%H.%M.%S');
+    return kind === 'recording'
+        /* Translators: file name of a screen recording; the first placeholder
+           is the date (2026-09-16), the second the time (10.22.03). */
+        ? _('Recording %s at %s').format(date, clock)
+        /* Translators: file name of a screenshot; the first placeholder is
+           the date (2026-09-16), the second the time (10.22.03). */
+        : _('Screenshot %s at %s').format(date, clock);
+}
+
+// A small PNG of a capture for the thumbnail, kept in the runtime directory.
+let previewSerial = 0;
+const previews = [];
+export function writePreview(pixbuf, scale) {
+    const width = 200 * scale, height = 118 * scale;
+    const factor = Math.min(1, Math.max(width / pixbuf.width, height / pixbuf.height) * 1.5);
+    const scaled = factor < 1
+        ? pixbuf.scale_simple(Math.max(1, Math.round(pixbuf.width * factor)),
+            Math.max(1, Math.round(pixbuf.height * factor)), GdkPixbuf.InterpType.BILINEAR)
+        : pixbuf;
+    const dir = GLib.build_filenamev([GLib.get_user_runtime_dir(), 'luma-capture']);
+    GLib.mkdir_with_parents(dir, 0o700);
+    const path = GLib.build_filenamev([dir, `preview-${Date.now()}-${++previewSerial}.png`]);
+    scaled.savev(path, 'png', [], []);
+    // Only the newest few are kept.
+    previews.push(path);
+    while (previews.length > 4)
+        GLib.unlink(previews.shift());
+    return path;
+}
+
+// A folder chosen through the desktop portal's file chooser.
+export function chooseFolder() {
+    return new Promise(resolve => {
+        const bus = Gio.DBus.session;
+        const token = `luma_capture_${GLib.random_int()}`;
+        const sender = bus.get_unique_name().slice(1).replaceAll('.', '_');
+        const requestPath = `/org/freedesktop/portal/desktop/request/${sender}/${token}`;
+        let done = false;
+        const finish = path => {
+            if (done)
+                return;
+            done = true;
+            bus.signal_unsubscribe(subscription);
+            resolve(path);
+        };
+        const subscription = bus.signal_subscribe('org.freedesktop.portal.Desktop',
+            'org.freedesktop.portal.Request', 'Response', requestPath, null,
+            Gio.DBusSignalFlags.NONE,
+            (_c, _s, _p, _i, _n, params) => {
+                const [response, results] = params.deepUnpack();
+                const uris = results?.uris?.deepUnpack?.() ?? [];
+                finish(response === 0 && uris.length ? Gio.File.new_for_uri(uris[0]).get_path() : null);
+            });
+        bus.call('org.freedesktop.portal.Desktop', '/org/freedesktop/portal/desktop',
+            'org.freedesktop.portal.FileChooser', 'OpenFile',
+            new GLib.Variant('(ssa{sv})', ['', _('Choose where captures are saved'), {
+                'handle_token': new GLib.Variant('s', token),
+                'directory': new GLib.Variant('b', true),
+                'modal': new GLib.Variant('b', true),
+                'accept_label': new GLib.Variant('s', _('Choose')),
+            }]), null, Gio.DBusCallFlags.NONE, -1, null, (connection, result) => {
+                try {
+                    connection.call_finish(result);
+                } catch (e) {
+                    logError(e, 'Luma Capture: the folder chooser is unavailable');
+                    finish(null);
+                }
+            });
+    });
+}
