diff --git a/data/org.project_luma.capture.gschema.xml b/data/org.project_luma.capture.gschema.xml
new file mode 100644
index 0000000..c420943
--- /dev/null
+++ b/data/org.project_luma.capture.gschema.xml
@@ -0,0 +1,57 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- SPDX-License-Identifier: GPL-2.0-or-later -->
+<!-- Luma Capture, the screenshot and screen recording tool: every choice in
+     its Options menu and what it remembers between uses. -->
+<schemalist gettext-domain="gnome-shell">
+  <schema id="org.project_luma.capture" path="/org/project-luma/capture/">
+    <key name="save-to" type="s">
+      <choices>
+        <choice value="pictures"/>
+        <choice value="desktop"/>
+        <choice value="clipboard"/>
+        <choice value="messages"/>
+        <choice value="other"/>
+      </choices>
+      <default>"pictures"</default>
+      <summary>Where captures are saved</summary>
+      <description>Pictures and Videos save into their Screenshots and Screencasts folders. Clipboard copies a screenshot without saving it; recordings then go to Videos. Messages is not offered yet and saves to Pictures.</description>
+    </key>
+    <key name="other-location" type="s">
+      <default>""</default>
+      <summary>The folder chosen with Other Location</summary>
+    </key>
+    <key name="timer" type="u">
+      <range min="0" max="10"/>
+      <default>0</default>
+      <summary>Seconds before a capture is taken</summary>
+      <description>0, 5 or 10; any other value is treated as 0.</description>
+    </key>
+    <key name="show-thumbnail" type="b">
+      <default>true</default>
+      <summary>Show a floating thumbnail after each capture</summary>
+    </key>
+    <key name="remember-selection" type="b">
+      <default>true</default>
+      <summary>Choosing a selection mode draws the last selection again</summary>
+    </key>
+    <key name="show-pointer" type="b">
+      <default>false</default>
+      <summary>Include the pointer in screenshots and recordings</summary>
+    </key>
+    <key name="last-mode" type="s">
+      <choices>
+        <choice value="screen"/>
+        <choice value="window"/>
+        <choice value="selection"/>
+        <choice value="record-screen"/>
+        <choice value="record-selection"/>
+      </choices>
+      <default>"selection"</default>
+      <summary>The capture mode last used</summary>
+    </key>
+    <key name="last-selection" type="ai">
+      <default>[]</default>
+      <summary>The last selection, as x, y, width and height in logical pixels</summary>
+    </key>
+  </schema>
+</schemalist>
diff --git a/data/theme/luma-capture.css b/data/theme/luma-capture.css
new file mode 100644
index 0000000..9501616
--- /dev/null
+++ b/data/theme/luma-capture.css
@@ -0,0 +1,306 @@
+/* Luma Capture: the screenshot and screen recording tool (lumaCapture.js).
+ *
+ * Surfaces use Quick Options' tokens in every appearance mode. The material
+ * classes (luma-surface-light, -dark, -frost, -glass) come from
+ * lumaSurfaceMaterials.js, which also adds the backdrop blur.
+ *
+ *            fill                     ink      muted                   line                     control
+ * light      #f1f2f3                  #30343a  #767b81                 rgba(35,39,45,.09)       rgba(35,44,52,.072)
+ * dark       #21252b                  #e9ebec  #969da4                 rgba(255,255,255,.075)   rgba(255,255,255,.072)
+ * frost      rgba(244,245,246,.80)    #30343a  #767b81                 rgba(35,39,45,.09)       rgba(35,44,52,.072)
+ * glass      rgba(22,29,40,.38)       #ffffff  rgba(255,255,255,.70)   rgba(255,255,255,.15)    rgba(10,20,33,.20)
+ *
+ * The only colour of its own is the record red, #e5484d. Where Capture sits
+ * is the shelf surface rule (lumaShelfSurface.js), never an offset here. */
+
+/* ── Surface ─────────────────────────────────────────────────────────────── */
+.luma-capture-surface {
+  font-family: 'Figtree', system-ui, sans-serif;
+  background-color: #f1f2f3;
+  color: #30343a;
+  box-shadow: 0 5px 16px rgba(0, 0, 0, 0.26); }
+.luma-capture-surface.luma-surface-dark {
+  background-color: #21252b;
+  color: #e9ebec; }
+.luma-capture-surface.luma-surface-frost { background-color: rgba(244, 245, 246, 0.80); }
+.luma-capture-surface.luma-surface-glass {
