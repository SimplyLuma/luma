+        track.add_child(foreground);
+
+        this._muteIcon = new St.Icon({style_class: 'luma-quick-disclosure-icon'});
+        this._mute = new St.Button({
+            style_class: 'luma-options-level-key luma-app-mixer-mute',
+            child: this._muteIcon,
+            can_focus: true,
+            y_align: Clutter.ActorAlign.CENTER,
