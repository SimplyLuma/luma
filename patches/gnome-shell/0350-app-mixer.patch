+// The per-app mixer needs interface version 2.
+const MIXER_VERSION = 2;
+const SYSTEM_SOUNDS_ID = '@system';
+const SYSTEM_SOUNDS_ICON = 'lumaui-bell-symbolic';
+const MIXER_MAX_VOLUME = 1.5;
+
+// Recording streams that only measure levels. They are not an app using the
+// microphone: GNOME's and PulseAudio's mixers, and the meters of Luma's own
+// sound service, which the mixer below opens.
+const LEVEL_METER_APPLICATION_IDS = [
+    'org.gnome.VolumeControl',
+    'org.PulseAudio.pavucontrol',
+    AUDIO_DEVICES_BUS_NAME,
+];
+
+/**
+ * @param {Gvc.MixerStream} output - a recording stream (source output)
+ * @returns {boolean} whether it is an app recording, not a level meter
+ */
+export function isRecordingApplication(output) {
+    return !LEVEL_METER_APPLICATION_IDS.includes(output.get_application_id());
+}
+
+/**
+ * @param {object[]} entries - an aa{sv} as unpacked by the proxy
+ * @returns {object[]} plain objects
+ */
+function unpackEntries(entries) {
+    return entries.map(entry => {
+        const result = {};
+        for (const [key, value] of Object.entries(entry))
+            result[key] = value instanceof GLib.Variant ? value.deepUnpack() : value;
+        return result;
+    });
+}
+
+/**
+ * The Lucide glyph for an output: the service's icon names are freedesktop
+ * names, the sheet draws Lucide roles as the device list does.
+ *
+ * @param {object} output - an entry from GetOutputs
+ * @returns {string}
+ */
+export function outputIconName(output) {
+    const hint = `${output?.icon ?? ''} ${output?.name ?? ''}`.toLowerCase();
+    if (/headphone|headset|earbud/.test(hint))
+        return 'lumaui-headphones-symbolic';
+    if (/display|hdmi|video|monitor|\btv\b/.test(hint))
+        return 'lumaui-monitor-symbolic';
+    if (hint.includes(AIRPLAY_OUTPUT_PREFIX) || /network|raop|tunnel/.test(hint))
+        return NETWORK_SPEAKER_ICON;
+    return 'lumaui-speaker-symbolic';
+}
+
+/**
+ * The per-app mixer's model, shared by every view of it (the Sound output
+ * page, the TV quick panel): System sounds first, then every app with a
+ * sound stream, with the name and icon the Shell knows the app by.
+ *
+ * Views hold() it while they are on screen; nothing is fetched or tracked
+ * for a view that is not. Views that draw meters also watchLevels(), and
+ * levels are measured only while one does.
+ *
+ * Each application: {id, kind, name, gicon, volume, muted, output, playing}.
+ */
+export const AppMixer = GObject.registerClass({
+    Signals: {
+        'availability-changed': {},
+        'changed': {},
+        'levels-changed': {},
+    },
+}, class AppMixer extends GObject.Object {
+    constructor(proxy) {
+        super();
+        this._proxy = proxy;
+        this.applications = [];
+        this.outputs = [];
+        this.levels = {};
+        this._holds = 0;
+        this._meterHolds = 0;
+        this._appsDirty = this._outputsDirty = true;
+        this._watch = 0;
+        this._watchedTargets = '';
+        this._watchSerial = 0;
+        this._pendingVolume = new Map();
+        this._volumeInFlight = new Set();
+        this._windowTracker = Shell.WindowTracker.get_default();
+        this._appSystem = Shell.AppSystem.get_default();
+
+        this._proxy.connectObject(
+            'notify::g-name-owner', () => this._sync(),
+            'g-properties-changed', () => this._sync(),
+            this);
+        this._proxy.connectSignal('ApplicationsChanged', (p, sender, [apps]) => {
+            if (!this._holds) {
+                this._appsDirty = true;
+                return;
+            }
+            this._setApplications(apps);
+            this._syncLevelWatch();
+        });
+        this._proxy.connectSignal('OutputsChanged', () => {
+            this._outputsDirty = true;
+            if (this._holds)
+                this._refresh();
+        });
+        this._proxy.connectSignal('Levels', (p, sender, [watch, levels]) => {
+            if (watch !== this._watch || !watch)
+                return;
+            this.levels = levels;
+            this.emit('levels-changed');
+        });
+        this._available = this.available;
+    }
+
+    get available() {
+        return this._proxy.g_name_owner !== null &&
+            (this._proxy.Version ?? 0) >= MIXER_VERSION;
+    }
+
+    _sync() {
+        const available = this.available;
+        if (available === this._available)
+            return;
+        this._available = available;
+        this._appsDirty = this._outputsDirty = true;
+        this._watch = 0;
+        this._watchedTargets = '';
+        if (available && this._holds) {
+            this._refresh();
+        } else if (!available) {
+            this.applications = [];
+            this.outputs = [];
+            this.levels = {};
+            this.emit('changed');
+        }
+        this.emit('availability-changed');
+    }
+
+    hold() {
+        if (this._holds++ === 0) {
+            this._appsDirty = this._outputsDirty = true;
+            this._refresh();
+        }
+    }
+
+    release() {
+        this._holds = Math.max(0, this._holds - 1);
+    }
+
+    // Meters on screen: measured until the matching unwatchLevels().
+    watchLevels() {
+        this._meterHolds++;
+        this._syncLevelWatch();
+    }
+
+    unwatchLevels() {
+        this._meterHolds = Math.max(0, this._meterHolds - 1);
+        this._syncLevelWatch();
+    }
+
+    async _refresh() {
+        if (!this.available)
+            return;
+        try {
+            if (this._appsDirty) {
+                this._appsDirty = false;
+                const [apps] = await this._proxy.GetApplicationsAsync();
+                this._setApplications(apps, false);
+            }
+            if (this._outputsDirty) {
+                this._outputsDirty = false;
+                const [outputs] = await this._proxy.GetOutputsAsync();
+                this.outputs = unpackEntries(outputs);
+            }
+        } catch (error) {
+            console.warn(`Luma mixer: ${error.message}`);
+        }
+        this.emit('changed');
+        this._syncLevelWatch();
+    }
+
+    _setApplications(apps, emit = true) {
+        this.applications = unpackEntries(apps).map(app => this._resolve(app));
+        if (emit)
+            this.emit('changed');
+    }
+
+    // Name and icon from the Shell's own record of the app when it has one:
+    // the window that owns the stream's process, else the desktop entry,
+    // else what the service read.
+    _resolve(app) {
+        const entry = {...app, gicon: null};
+        if (app.kind === 'system' || app.id === SYSTEM_SOUNDS_ID) {
+            entry.name = _('System sounds');
+            entry.gicon = new Gio.ThemedIcon({name: SYSTEM_SOUNDS_ICON});
+            return entry;
+        }
+        let shellApp = null;
+        if (app.pid > 0)
+            shellApp = this._windowTracker.get_app_from_pid(app.pid);
+        // A window with no desktop entry knows less than the service does.
+        if (shellApp?.is_window_backed())
+            shellApp = null;
+        if (!shellApp && app.desktop_id)
+            shellApp = this._appSystem.lookup_app(app.desktop_id);
+        if (shellApp) {
+            entry.name = shellApp.get_name() || app.name;
+            entry.gicon = shellApp.get_icon();
+        }
+        if (!entry.gicon && app.icon) {
+            try {
+                entry.gicon = Gio.Icon.new_for_string(app.icon);
+            } catch {}
+        }
+        entry.gicon ??= new Gio.ThemedIcon({name: 'application-x-executable-symbolic'});
+        entry.name ||= app.id;
+        return entry;
+    }
+
+    // An output as the device list above it names it: the port ("Line Out")
+    // and where it lives ("Built-in Audio"); else the service's description.
+    describeOutput(output) {
+        const control = getMixerControl();
+        const stream = output
+            ? control.get_sinks().find(sink => sink.get_name() === output.name) : null;
+        const device = stream ? control.lookup_device_from_stream(stream) : null;
+        return {
+            title: device?.description || output?.description || output?.name || '',
+            origin: device?.origin ?? '',
+        };
+    }
+
+    isSettingVolume(id) {
+        return this._volumeInFlight.has(id) || this._pendingVolume.has(id);
+    }
+
+    // One call in flight per app; the newest value goes when it returns.
+    setVolume(id, volume) {
+        this._pendingVolume.set(id, volume);
+        this._sendVolume(id);
+    }
+
+    async _sendVolume(id) {
+        if (this._volumeInFlight.has(id) || !this._pendingVolume.has(id))
+            return;
+        const volume = this._pendingVolume.get(id);
+        this._pendingVolume.delete(id);
+        this._volumeInFlight.add(id);
+        try {
+            await this._proxy.SetApplicationVolumeAsync(id, volume);
+        } catch (error) {
+            console.warn(`Luma mixer volume: ${error.message}`);
+        } finally {
+            this._volumeInFlight.delete(id);
+        }
+        this._sendVolume(id);
+    }
+
+    setMuted(id, muted) {
+        this._proxy.SetApplicationMuteAsync(id, muted).catch(
+            error => console.warn(`Luma mixer mute: ${error.message}`));
+    }
+
+    setOutput(id, name) {
+        this._proxy.SetApplicationOutputAsync(id, name).catch(
+            error => console.warn(`Luma mixer output: ${error.message}`));
+    }
+
+    // The service's watch follows the rows: one list, renewed when it changes.
+    async _syncLevelWatch() {
+        const targets = this._meterHolds > 0 && this.available
+            ? this.applications.map(app => app.id) : [];
+        const key = targets.join('\n');
+        if (key === this._watchedTargets)
+            return;
+        const serial = ++this._watchSerial;
+        if (this._watch && this._proxy.g_name_owner !== null)
+            this._proxy.UnwatchLevelsAsync(this._watch).catch(() => {});
+        this._watch = 0;
+        this._watchedTargets = key;
+        this.levels = {};
+        this.emit('levels-changed');
+        if (!targets.length)
+            return;
+        try {
+            const [watch] = await this._proxy.WatchLevelsAsync(targets);
+            // Closed, or watching another list, while the call was out.
+            if (serial !== this._watchSerial) {
+                this._proxy.UnwatchLevelsAsync(watch).catch(() => {});
+                return;
+            }
+            this._watch = watch;
+        } catch (error) {
+            if (serial === this._watchSerial)
+                this._watchedTargets = '';
+            console.warn(`Luma mixer levels: ${error.message}`);
+        }
+    }
+});
+
+let _appMixer;
+
+/**
+ * @returns {AppMixer} - the per-app mixer model singleton
+ */
+export function getAppMixer() {
+    _appMixer ??= new AppMixer(getAudioDevices());
+    return _appMixer;
+}
+
+/**
+ * One app in the mixer: its level as the shared filled slider (the app's
+ * icon and name on the track, the level at its end, the live meter along its
+ * foot), a mute key and an output key. The output key opens the outputs
+ * under the row, in place.
+ */
+const AppMixerRow = GObject.registerClass({
+    Signals: {'outputs-toggled': {param_types: [GObject.TYPE_BOOLEAN]}},
+}, class AppMixerRow extends St.BoxLayout {
