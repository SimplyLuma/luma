-            this._grid.layout_manager.addSheet(sheet, item);
+            this._pageHost.add_child(sheet);
+            sheet.hide();
+            item.menu._titleRow.hide();
+            item.menu.connect('open-state-changed', (_m, open) => this._showStudioPage(item, open));
             item.connect('destroy', () => {
