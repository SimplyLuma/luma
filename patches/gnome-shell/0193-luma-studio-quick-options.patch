+// BlueZ's public Agent1 contract, registered only for a user-initiated pairing.
+// Never become the default agent or automatically authorize another device.
+const PairingAgentXML = `<node><interface name="org.bluez.Agent1">
+<method name="Release"/><method name="Cancel"/>
+<method name="RequestPinCode"><arg type="o" direction="in"/><arg type="s" direction="out"/></method>
+<method name="DisplayPinCode"><arg type="o" direction="in"/><arg type="s" direction="in"/></method>
+<method name="RequestPasskey"><arg type="o" direction="in"/><arg type="u" direction="out"/></method>
+<method name="DisplayPasskey"><arg type="o" direction="in"/><arg type="u" direction="in"/><arg type="q" direction="in"/></method>
+<method name="RequestConfirmation"><arg type="o" direction="in"/><arg type="u" direction="in"/></method>
+<method name="RequestAuthorization"><arg type="o" direction="in"/></method>
+<method name="AuthorizeService"><arg type="o" direction="in"/><arg type="s" direction="in"/></method>
+</interface></node>`;
+const AGENT_PATH = '/org/gnome/Shell/LumaBluetoothAgent';
+
+class PairingAgent {
+    constructor(toggle) {
+        this._toggle = toggle;
+        this._ownerProxy = Gio.DBusProxy.new_sync(Gio.DBus.system,
+            Gio.DBusProxyFlags.DO_NOT_AUTO_START, null, 'org.bluez', '/org/bluez', 'org.bluez.AgentManager1', null);
+        this._object = Gio.DBusExportedObject.wrapJSObject(PairingAgentXML, this);
+    }
+    async pair(device) {
+        if (this._device) return;
+        this._device = device;
+        this._path = device.get_object_path();
+        this._cancellable = new Gio.Cancellable();
+        this._object.export(Gio.DBus.system, AGENT_PATH);
+        let registered = false;
+        try {
+            await Gio.DBus.system.call('org.bluez', '/org/bluez', 'org.bluez.AgentManager1', 'RegisterAgent',
+                new GLib.Variant('(os)', [AGENT_PATH, 'KeyboardDisplay']), null, Gio.DBusCallFlags.NONE, 10000, this._cancellable);
+            registered = true;
