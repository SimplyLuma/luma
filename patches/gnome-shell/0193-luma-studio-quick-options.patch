+
+    // The Studio page arrangement reuses GNOME's live indicator actors. No
+    // second NetworkManager, audio, brightness or UPower model is created.
+    configureStudio(indicators) {
+        this.box.add_style_class_name('luma-studio-options');
+        this._materialBinding.setCornerRadii(22);
+        this._materialBinding.setTranslucentRecipe({radius: 40, saturation: 1.4});
+        this._lumaHeader.hide();
+        this._grid.hide();
+        this._mainPage = new St.BoxLayout({style_class: 'luma-options-main',
+            orientation: Clutter.Orientation.VERTICAL, x_expand: true});
+        this.box.insert_child_below(this._mainPage, this._pageHost);
+        const move = (item, parent, cls) => {
+            if (!item) return;
+            item.get_parent()?.remove_child(item);
+            item.add_style_class_name(cls);
+            parent.add_child(item);
+        };
+        const row = cls => new St.BoxLayout({style_class: cls, x_expand: true});
+        const levels = new St.BoxLayout({style_class: 'luma-options-levels', orientation: Clutter.Orientation.VERTICAL});
+        this._mainPage.add_child(levels);
+        const volume = indicators._volumeOutput.quickSettingsItems[0];
+        const brightness = indicators._brightness.quickSettingsItems[0];
+        for (const item of [volume, brightness]) {
+            move(item, levels, 'luma-options-slider');
+            // Value sits after the live Slider, not in a second line before it.
+            item._levelHeader.hide();
+            const box = item.child;
+            item._levelHeader.remove_child(item._valueLabel);
+            box.insert_child_below(item._valueLabel, item._menuSlot);
+            item._valueLabel.y_align = Clutter.ActorAlign.CENTER;
+            item._menuButton.add_style_class_name('luma-options-level-key');
+        }
+        volume._menuButton.child.child.icon_name = 'luma-headphones-symbolic';
+        const output = volume._control;
+        const syncOutput = () => {
+            const stream = output?.get_default_sink?.();
+            const icon = stream?.get_form_factor?.() ?? 'speaker';
+            volume._menuButton.child.child.icon_name = /headphone|headset/.test(icon)
+                ? 'luma-headphones-symbolic' : /display|hdmi/.test(icon)
+                    ? 'luma-monitor-symbolic' : 'luma-speaker-symbolic';
+        };
+        output?.connectObject('default-sink-changed', syncOutput, this.actor);
+        syncOutput();
+        const powerSettings = new Gio.Settings({schema_id: 'org.gnome.settings-daemon.plugins.power'});
+        const auto = new St.Button({style_class: 'luma-options-level-key', label: _('Auto'),
+            can_focus: true, toggle_mode: true, accessible_name: _('Automatic brightness')});
+        powerSettings.bind('ambient-enabled', auto, 'checked', Gio.SettingsBindFlags.DEFAULT);
+        brightness._menuSlot.child = auto;
+        brightness._menuButton.hide();
+        auto.connect('destroy', () => powerSettings.run_dispose());
+        // GNOME can still expose per-monitor brightness from the keyboard.
+        const radios = row('luma-options-radios'); this._mainPage.add_child(radios);
+        for (const item of [indicators._network?._wirelessToggle, indicators._bluetooth?.quickSettingsItems[0]]) {
+            move(item, radios, 'luma-options-radio');
+            if (!item) continue;
+            item.x_expand = true;
+            item.setPill(false);
+            item._menuButton.child.child.icon_name = 'luma-chevron-right-symbolic';
+            item.menu._studioTitle = item === indicators._network?._wirelessToggle ? _('Wi-Fi') : _('Bluetooth');
+            item.menu._studioRadio = item;
+
+        }
+        const toggles = new St.BoxLayout({style_class: 'luma-options-toggles', orientation: Clutter.Orientation.VERTICAL});
+        this._mainPage.add_child(toggles);
+        const utilities = [indicators._doNotDisturb, indicators._nightLight,
+            indicators._powerProfiles, indicators._darkMode].map(i => i.quickSettingsItems[0]);
+        for (let i = 0; i < utilities.length; i += 2) {
+            const group = row('luma-options-toggle-row'); toggles.add_child(group);
+            for (const item of utilities.slice(i, i + 2)) {
+                move(item, group, 'luma-options-utility'); item.x_expand = true;
+                item.setPill?.(true);
+                if (item._menuButton) item._menuButton.hide();
+            }
+        }
+        const night = utilities[1], dark = utilities[3];
+        night.title = _('Night Light'); night.iconName = 'luma-sunset-symbolic';
+        dark.title = _('Dark Style'); dark.iconName = 'luma-sun-moon-symbolic';
+        // Reuse the input stream's live mute operation. The strip is present
+        // only while GNOME's recording indicator says an app is using it.
+        const input = indicators._volumeInput.quickSettingsItems[0];
+        const mic = row('luma-options-mic'); this._mainPage.add_child(mic);
+        const micIcon = new St.Icon({icon_name: 'luma-mic-symbolic', icon_size: 16}); mic.add_child(micIcon);
+        const micCopy = new St.BoxLayout({orientation: Clutter.Orientation.VERTICAL, x_expand: true});
+        const micTitle = new St.Label({style_class: 'luma-options-mic-title'});
+        const micApp = new St.Label({style_class: 'luma-options-mic-app'});
+        micCopy.add_child(micTitle); micCopy.add_child(micApp); mic.add_child(micCopy);
+        const mute = new St.Button({style_class: 'luma-options-mute', can_focus: true}); mic.add_child(mute);
+        mute.connect('clicked', () => input.emit('icon-clicked'));
+        const syncMic = () => {
+            mic.visible = input.visible;
+            const stream = input._stream;
+            const muted = stream?.is_muted ?? false;
+            micIcon.icon_name = muted ? 'luma-mic-off-symbolic' : 'luma-mic-symbolic';
+            micTitle.text = muted ? _('Microphone muted') : _('Microphone in use');
+            mute.label = muted ? _('Unmute') : _('Mute');
+            const apps = input._control?.get_source_outputs?.() ?? [];
+            micApp.text = apps.map(s => s.get_name()).filter(Boolean).join(', ');
+            micApp.visible = !!micApp.text;
+        };
+        input.connectObject('notify::visible', syncMic, 'stream-updated', syncMic, this.actor);
+        input.slider.connectObject('notify::value', syncMic, this.actor);
+        input._control?.connectObject('stream-added', syncMic, 'stream-removed', syncMic, this.actor);
+        // The hidden input slider continues tracking the stream and drives
+        // its existing mute operation; it is not duplicated in the page.
+        syncMic();
+        const system = indicators._system.quickSettingsItems[0];
+        move(system, this._mainPage, 'luma-options-system');
+        system.menu._studioTitle = _('Power');
+        const wifi = indicators._network?._wirelessToggle;
+        if (wifi) {
+            const air = indicators._rfkill.quickSettingsItems[0];
+            move(air, wifi.menu.box, 'luma-options-switch-row');
+            air.setPill?.(true); air.title = _('Airplane mode');
+            const settingsLink = wifi.menu.box.get_children().find(a => a.has_style_class_name?.('luma-sheet-link'));
+            if (settingsLink) wifi.menu.box.set_child_below_sibling(air, settingsLink);
+        }
+        this.actor.connect('key-press-event', (_a, e) => {
+            if (e.get_key_symbol() === Clutter.KEY_Escape && this._activeMenu) {
+                this.close(); return Clutter.EVENT_STOP;
+            }
+            return Clutter.EVENT_PROPAGATE;
+        });
+    }
+
+    _showStudioPage(item, open) {
+        const menu = item.menu;
+        if (open) {
+            if (this._activeMenu !== menu) this._activeMenu?.close(PopupAnimation.NONE);
+            this._activeMenu = menu;
+            this._mainPage?.hide(); this._pageHost.show();
+            this._pageHeading.text = menu._studioTitle ?? item.title ?? menu._titleLabel.text;
+            const radio = menu._studioRadio;
+            this._pageSwitch.visible = !!radio;
+            this._pageSwitch.checked = radio?.checked ?? false;
+            this._pageRadioBinding?.unbind();
+            this._pageRadioBinding = radio?.bind_property('checked', this._pageSwitch, 'checked', GObject.BindingFlags.SYNC_CREATE);
+            this._pageHost.translation_x = 6 * St.ThemeContext.get_for_stage(global.stage).scale_factor;
+            this._pageHost.opacity = 0;
+            this._pageHost.ease({translation_x: 0, opacity: 255,
+                duration: St.Settings.get().enable_animations ? 220 : 0, mode: Clutter.AnimationMode.EASE_OUT_QUART});
+            this._back.grab_key_focus();
+        } else if (this._activeMenu === menu) {
+            this._activeMenu = null;
+            this._pageRadioBinding?.unbind(); this._pageRadioBinding = null;
+            this._pageHost.hide(); this._mainPage?.show();
+            if (this._mainPage) {
+                this._mainPage.translation_x = -6 * St.ThemeContext.get_for_stage(global.stage).scale_factor;
+                this._mainPage.opacity = 0;
+                this._mainPage.ease({translation_x: 0, opacity: 255,
+                    duration: St.Settings.get().enable_animations ? 220 : 0, mode: Clutter.AnimationMode.EASE_OUT_QUART});
+            }
+            item.getSheetAnchor?.()?.grab_key_focus();
+        }
     }
 
     _updateLumaHeader() {
@@ -1343,32 +1525,17 @@
             this._grid, item, 'column-span', colSpan);
 
         if (item.menu) {
-            item.menu.box.add_style_class_name('luma-quick-detail');
-            // A detail sheet is a pane inside Quick Options, not another
