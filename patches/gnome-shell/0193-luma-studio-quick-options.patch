+        this._back.connect('clicked', () => this._activeMenu?.close());
+        header.add_child(this._back);
+        this._pageHeading = new St.Label({style_class: 'luma-options-page-title', x_expand: true,
+            y_align: Clutter.ActorAlign.CENTER}); header.add_child(this._pageHeading);
+        this._pageSwitch = new St.Button({style_class: 'luma-options-page-switch', can_focus: true,
+            child: new St.Widget({style_class: 'toggle-switch'})});
+        this._pageSwitch.connect('clicked', () => this._activeMenu?._studioRadio?.emit('clicked', 1));
+        this._pageSwitch.connect('notify::checked', () => {
+            if (this._pageSwitch.checked) this._pageSwitch.child.add_style_pseudo_class('checked');
+            else this._pageSwitch.child.remove_style_pseudo_class('checked');
