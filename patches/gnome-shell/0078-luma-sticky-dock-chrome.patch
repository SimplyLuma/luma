diff --git a/data/theme/luma-shelf.css b/data/theme/luma-shelf.css
--- a/data/theme/luma-shelf.css
+++ b/data/theme/luma-shelf.css
@@ -654,3 +654,40 @@
 .luma-media-control:hover, .luma-media-control:focus { background-color: rgba(127,127,127,0.2); }
 .luma-media-module.vertical { min-width: 0; height: 138px; width: 36px; padding: 0; }
 
+
+/* ── The sticky note stack ─────────────────────────────────────────────── */
+/* Paper colours are the application's document data, repeated here because the
+ * shell draws the tabs; they are not system tokens and do not belong in the
+ * palette. */
+.luma-sticky-dock { spacing: 8px; }
+.luma-sticky-stack { spacing: 3px; }
+.luma-sticky-tab {
+  border-radius: 10px 0 0 10px;
+  border: 0;
+  padding: 0;
+  color: #2c2a24;
+  box-shadow: -6px 4px 16px rgba(0, 0, 0, 0.28);
+  transition-duration: 160ms;
+}
+.luma-sticky-tab:hover { margin-right: -3px; }
+.luma-sticky-tab:focus { outline: 2px solid #6ea8fe; outline-offset: 2px; }
+.luma-sticky-tab.completed { opacity: 0.55; }
+.luma-sticky-tab-label {
+  font-size: 9px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  padding: 0 4px;
+}
+.luma-sticky-yellow { background-color: #f3e3a3; }
+.luma-sticky-coral  { background-color: #f4c3b4; }
+.luma-sticky-green  { background-color: #c3ddbf; }
+.luma-sticky-blue   { background-color: #bcd4e9; }
+.luma-sticky-purple { background-color: #d5c6e7; }
+.luma-sticky-new {
+  width: 30px; height: 30px;
+  border-radius: 99px;
+  background-color: rgba(32, 36, 42, 0.92);
+  color: #e7e9e8;
+  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.34);
+}
+.luma-sticky-new:hover { background-color: rgba(48, 54, 62, 0.96); }
