From: Project Luma <builds@project-luma.local>
Subject: [PATCH] keyboard: the first touch arms a tap-focused field too

0342 records the window under the last touch from the keyboard. The
keyboard manager creates the keyboard only once the last input device is
a touchscreen, which it learns after that touch went down, so the first
touch after startup, or after a mouse or touchpad was used, was never
recorded. A field that takes the focus after the finger lifts (Notes'
search opens its field from the release) then got a bare focus and no
keyboard on that first tap.

The keyboard manager, which lives for the whole session, records the
touch; the keyboard reads it when a field takes the focus.

--- a/js/ui/keyboard.js
+++ b/js/ui/keyboard.js
@@ -1567,6 +1567,12 @@
         this._seat.connect('device-added', this._syncEnabled.bind(this));
         this._seat.connect('device-removed', this._syncEnabled.bind(this));
 
+        // The keyboard is created once a touch has been seen, after that
+        // touch went down, so the touch record lives here, where it sees
+        // every touch, the first one included.
+        this.fieldTap = null;
+        global.stage.connect('captured-event', this._onStageTouch.bind(this));
+
         this._lastDevice = null;
         global.backend.connect('last-device-changed', (backend, device) => {
             if (device.device_type === Clutter.InputDeviceType.KEYBOARD_DEVICE)
@@ -1597,6 +1603,28 @@
         this._bottomDragGesture = bottomDragGesture;
 
         this._syncEnabled();
+    }
+
+    // Which window the last finger went down on (the focused window, or
+    // none), and when it lifted. Only touchscreens send touch events.
+    _onStageTouch(stage, event) {
+        const type = event.type();
+        if (type === Clutter.EventType.TOUCH_BEGIN) {
+            let actor = stage.get_event_actor(event);
+            while (actor && !(actor instanceof Meta.WindowActor))
+                actor = actor.get_parent();
+            const window = actor?.get_meta_window() ?? null;
+            this.fieldTap = {
+                window: window && window === global.display.focus_window ? window : null,
+                down: true,
+                upMs: 0,
+            };
+        } else if (this.fieldTap?.down &&
+                   (type === Clutter.EventType.TOUCH_END || type === Clutter.EventType.TOUCH_CANCEL)) {
+            this.fieldTap.down = false;
+            this.fieldTap.upMs = monotonicMs();
+        }
+        return Clutter.EVENT_PROPAGATE;
     }
 
     _lastDeviceIsTouchscreen() {
@@ -2351,8 +2379,7 @@
             'content-hints-changed', this._onContentHintsChanged.bind(this),
             this);
