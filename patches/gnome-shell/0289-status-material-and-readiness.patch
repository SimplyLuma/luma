From: Project Luma <builds@project-luma.local>
Subject: [PATCH] shell: align status slots and share island materials

--- a/js/ui/shelf.js
+++ b/js/ui/shelf.js
@@ -8,6 +8,7 @@
 import St from 'gi://St';
 
