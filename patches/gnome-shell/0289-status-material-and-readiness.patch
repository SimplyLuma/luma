+import * as AppFavorites from './appFavorites.js';
 import * as PanelMenu from './panelMenu.js';
 import {ShelfMedia} from './shelfMedia.js';
 import {MediaIslandGuard} from './lumaMediaIslandGuard.js';
@@ -519,7 +520,7 @@
         // artwork is not clipped at its resting tile bounds.
         const insets = this._content.has_style_class_name('luma-shelf-clock-button')
             ? (this._vertical ? [padding,6,padding,6] : [0,padding,0,padding])
-            : this._content._statusActive ? (this._vertical ? [8.5,6,8.5,6] : [8.5,10.5,8.5,9])
+            : this._content._statusActive ? (this._vertical ? [8.5,6,8.5,6] : [8.5,9,8.5,9])
