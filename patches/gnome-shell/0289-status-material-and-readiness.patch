             ? (this._vertical ? [padding, 0, padding, 0] : [0, padding, 0, padding])
             : [padding, padding, padding, padding];
@@ -1006,8 +1007,7 @@
         this._initialPresentationId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 16, () => {
             const groups = this._groups.filter(group => group.visible &&
                 group.row.get_children().some(actor => actor.visible && actor.width > 0));
-            const expected = this._shellSettings.get_strv('favorite-apps')
-                .filter(id => Shell.AppSystem.get_default().lookup_app(id)).length;
+            const expected = AppFavorites.getAppFavorites().getFavorites().length;
             const ready = !Main.layoutManager._startingUp && groups.length > 0 &&
                 this._dash._box.get_children().length >= expected && !this._widthLaterId &&
                 groups.every(group => group.has_allocation() && group.width > 0 && group.height > 0);
