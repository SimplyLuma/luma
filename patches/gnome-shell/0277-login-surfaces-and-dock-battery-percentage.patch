diff --git a/data/theme/gnome-shell-sass/widgets/_login-lock.scss b/data/theme/gnome-shell-sass/widgets/_login-lock.scss
--- a/data/theme/gnome-shell-sass/widgets/_login-lock.scss
+++ b/data/theme/gnome-shell-sass/widgets/_login-lock.scss
@@ -750,3 +750,33 @@
 .poster-card.compact .prairie-password-field { width: 220px; }
 
 .poster-battery, .poster-card.wide .poster-battery { icon-size: 24px; }
+
+/* The login card is a single, solid surface. */
+.poster-card, .poster-card.poster-card-opaque {
+  background-image: none;
+  background-color: #26282e;
+  border: 1px solid rgba(255, 255, 255, 0.12);
+  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.24);
+}
+/* BoxPointer owns the rounded outline; do not stack a second square surface. */
+.prairie-login-power-menu {
+  -arrow-border-radius: 16px;
+  -arrow-background-color: #2c2c32;
+  -arrow-border-color: rgba(255, 255, 255, 0.12);
+  -arrow-border-width: 1px;
+}
+.prairie-login-power-menu .popup-menu-content {
+  padding: 6px;
+  border: 0;
+  border-radius: 16px;
+  background-color: transparent;
+  box-shadow: none;
+}
+.prairie-login-power-menu .popup-menu-item {
+  min-height: 32px;
+  margin: 0;
+  padding: 0 10px;
+  border: 0;
+  box-shadow: none;
+  border-radius: 10px;
+}
