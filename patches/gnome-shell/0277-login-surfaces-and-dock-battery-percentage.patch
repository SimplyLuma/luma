+    // Text such as a battery percentage must participate in measurement.
+    // Keep columns shared down a side dock and mirror the complete cells in RTL.
+    _cellSizes(container) {
+        const columns = this._columns(container);
+        const widths = Array(columns).fill(STATUS_GLYPH * this._scale());
+        const heights = Array(this._rows(container)).fill(STATUS_GLYPH * this._scale());
+        this._visibleChildren(container).forEach((child, index) => {
+            const [, width] = child.get_preferred_width(-1);
+            const [, height] = child.get_preferred_height(width);
+            widths[index % columns] = Math.max(widths[index % columns], width);
+            heights[Math.floor(index / columns)] = Math.max(heights[Math.floor(index / columns)], height);
+        });
+        return {widths, heights};
+    }
