 export const BaselineClockRow = GObject.registerClass(
 class BaselineClockRow extends St.Widget {
+    _init(params = {}) {
+        super._init(params);
+        // Text can finish shaping after the first theme/allocation pass.
+        // Re-measure baselines when the native font, text or paint attributes
+        // settle, not only when a parent's fixed box changes size.
+        this.connect('child-added', (_row, actor) => {
+            actor.connectObject('style-changed', () => this.queue_relayout(),
+                'notify::visible', () => this.queue_relayout(), this);
+            actor.clutter_text?.connectObject('notify::font-name', () => this.queue_relayout(),
+                'notify::attributes', () => this.queue_relayout(),
+                'notify::text', () => this.queue_relayout(), this);
+        });
+        this.connect('child-removed', (_row, actor) => {
+            actor.disconnectObject(this);
+            actor.clutter_text?.disconnectObject(this);
+        });
+    }
