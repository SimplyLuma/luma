+// SPDX-License-Identifier: GPL-2.0-or-later
+// Windows that flash: every window that closes within a few seconds of
+// appearing, and every window in the first moments of a session, go to the
+// journal with who made it. A black window flashing at login is otherwise
+// gone before anyone can see what it was (ADR-026: account for everything).
+//
+//   journalctl --user -b -g luma-windows
+
+import GLib from 'gi://GLib';
+import Meta from 'gi://Meta';
+
+const SHORT_LIVED_MS = 3000;
+const STARTUP_WINDOW_MS = 90000;
+
+function describe(window) {
+    const rect = window.get_frame_rect();
+    const type = Object.keys(Meta.WindowType).find(key => Meta.WindowType[key] === window.get_window_type()) ?? '?';
+    return `app=${window.get_gtk_application_id() ?? window.get_sandboxed_app_id() ?? '-'} ` +
+        `class=${window.get_wm_class() ?? '-'} title=${JSON.stringify(window.get_title() ?? '')} ` +
+        `type=${type} client=${window.get_client_type() === Meta.WindowClientType.X11 ? 'x11' : 'wayland'} ` +
+        `pid=${window.get_pid()} size=${rect.width}x${rect.height}+${rect.x}+${rect.y}`;
+}
+
+export class WindowWatch {
+    constructor() {
+        this._started = GLib.get_monotonic_time();
+        global.display.connectObject('window-created', (_display, window) => this._created(window), this);
+    }
+
+    _created(window) {
+        const born = GLib.get_monotonic_time();
+        const sinceStart = (born - this._started) / 1000;
+        if (sinceStart < STARTUP_WINDOW_MS)
+            console.log(`[luma-windows] +${Math.round(sinceStart)}ms opened ${describe(window)}`);
+        window.connectObject('unmanaged', () => {
+            const lived = (GLib.get_monotonic_time() - born) / 1000;
+            if (lived < SHORT_LIVED_MS)
+                console.log(`[luma-windows] short-lived window (${Math.round(lived)}ms) ${describe(window)}`);
+        }, this);
+    }
+}
