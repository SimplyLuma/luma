diff --git a/js/ui/lumaSurfaceMaterials.js b/js/ui/lumaSurfaceMaterials.js
new file mode 100644
index 0000000..06f0e31
--- /dev/null
+++ b/js/ui/lumaSurfaceMaterials.js
@@ -0,0 +1,200 @@
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import Shell from 'gi://Shell';
+
+const EFFECT_NAME = 'luma-surface-backdrop';
+const TREATMENTS = ['light', 'dark', 'frost', 'glass'];
+const TRANSLUCENT = new Set(['frost', 'glass']);
+
+const RECIPES = {
+    light: {radius: 0, saturation: 1},
+    dark: {radius: 0, saturation: 1},
+    frost: {radius: 38, saturation: 1.45},
+    glass: {radius: 24, saturation: 1.65},
+};
+
+function optionalSettings(schemaId, key) {
+    const source = Gio.SettingsSchemaSource.get_default();
+    const schema = source?.lookup(schemaId, true);
+    if (!schema?.has_key(key))
+        return null;
+    return new Gio.Settings({settings_schema: schema});
+}
+
+function isDark(settings) {
+    return settings?.get_string('color-scheme') === 'prefer-dark';
+}
+
+export function resolveTreatment({
+    requested,
+    dark = false,
+    highContrast = false,
+    reduceTransparency = false,
+    hardwareAccelerated = true,
+}) {
+    const chosen = TREATMENTS.includes(requested)
+        ? requested
+        : dark ? 'dark' : 'light';
+    if (highContrast)
+        return dark ? 'dark' : 'light';
+    if (TRANSLUCENT.has(chosen) &&
+        (reduceTransparency || !hardwareAccelerated))
+        return 'light';
+    return chosen;
+}
+
+class SurfaceMaterialController {
+    constructor() {
+        this._bindings = new Set();
+        this._surfaceSettings = optionalSettings(
+            'org.project_luma.shell-state', 'surface-treatment');
+        this._interfaceSettings = optionalSettings(
+            'org.gnome.desktop.interface', 'color-scheme');
+        this._a11ySettings = optionalSettings(
+            'org.gnome.desktop.a11y.interface', 'high-contrast');
+
+        for (const settings of [this._surfaceSettings,
+            this._interfaceSettings, this._a11ySettings]) {
+            settings?.connect('changed', () => this._sync());
+        }
+        this._sync();
+    }
+
+    _hardwareAccelerated() {
+        // Mutter keeps software blur unavailable by default. The emulator
+        // may opt into the same real compositor effect for measured visual
+        // previews; production sessions never set this variable.
+        if (GLib.getenv('LUMA_MUTTER_ALLOW_SOFTWARE_BLUR') === '1')
+            return true;
+        try {
+            return global.backend.is_rendering_hardware_accelerated();
+        } catch (error) {
+            logError(error, 'Unable to determine Luma surface renderer capability');
+            return false;
+        }
+    }
+
+    _requestedTreatment() {
+        if (!this._surfaceSettings)
+            return isDark(this._interfaceSettings) ? 'dark' : 'light';
+
+        const selected = this._surfaceSettings.get_user_value('surface-treatment');
+        if (!selected)
+            return isDark(this._interfaceSettings) ? 'dark' : 'light';
+        const treatment = selected.deep_unpack();
+        return TREATMENTS.includes(treatment) ? treatment : 'light';
+    }
+
+    _effectiveTreatment() {
+        return resolveTreatment({
+            requested: this._requestedTreatment(),
+            dark: isDark(this._interfaceSettings),
+            highContrast: this._a11ySettings?.get_boolean('high-contrast') ?? false,
+            reduceTransparency:
+                this._surfaceSettings?.get_boolean('reduce-transparency') ?? false,
+            hardwareAccelerated: this._hardwareAccelerated(),
+        });
+    }
+
+    _sync() {
+        this._effective = this._effectiveTreatment();
+        const recipe = RECIPES[this._effective];
+
+        // This is the compositor-owned parameter source for Wayland client
+        // background effects. Older Mutter builds intentionally expose no
+        // protocol; Luma applications then remain opaque.
+        try {
+            global.compositor.set_background_blur_params(
+                recipe.radius, recipe.saturation, 0);
+        } catch (error) {
+            if (TRANSLUCENT.has(this._effective))
+                logError(error, 'Luma client backdrop protocol is unavailable');
+        }
+
+        for (const binding of this._bindings)
+            binding._sync(this._effective, recipe);
+    }
+
+    bind(actor, options = {}) {
+        const binding = new SurfaceMaterialBinding(this, actor, options);
+        this._bindings.add(binding);
+        binding._sync(this._effective, RECIPES[this._effective]);
+        return binding;
+    }
+
+    _remove(binding) {
+        this._bindings.delete(binding);
+    }
+}
+
+class SurfaceMaterialBinding {
+    constructor(controller, actor, {
+        enabled = true,
+        cornerRadii = 15,
+        classActors = [],
+    } = {}) {
+        this._controller = controller;
+        this._actor = actor;
+        this._enabled = enabled;
+        this._classActors = [actor, ...classActors];
+        this._cornerRadii = Array.isArray(cornerRadii)
+            ? [...cornerRadii]
+            : [cornerRadii, cornerRadii, cornerRadii, cornerRadii];
+        this._effect = new Shell.BlurEffect({
+            mode: Shell.BlurMode.BACKGROUND,
+            brightness: 1,
+        });
+        actor.add_effect_with_name(EFFECT_NAME, this._effect);
+        actor.connect('destroy', () => {
+            this._controller._remove(this);
+            this._actor = null;
+            this._effect = null;
+        });
+    }
+
+    setEnabled(enabled) {
+        this._enabled = enabled;
+        this._sync(this._controller._effective,
+            RECIPES[this._controller._effective]);
+    }
+
+    setCornerRadii(radii) {
+        this._cornerRadii = Array.isArray(radii)
+            ? [...radii]
+            : [radii, radii, radii, radii];
+        this._setEffectGeometry();
+    }
+
+    _setEffectGeometry() {
+        if (!this._effect)
+            return;
+        const [topLeft, topRight, bottomRight, bottomLeft] = this._cornerRadii;
+        this._effect.corner_radius_top_left = topLeft;
+        this._effect.corner_radius_top_right = topRight;
+        this._effect.corner_radius_bottom_right = bottomRight;
+        this._effect.corner_radius_bottom_left = bottomLeft;
+    }
+
+    _sync(treatment, recipe) {
+        if (!this._actor || !this._effect)
+            return;
+        for (const actor of this._classActors) {
+            for (const name of TREATMENTS)
+                actor.remove_style_class_name(`luma-surface-${name}`);
+            actor.add_style_class_name(`luma-surface-${treatment}`);
+        }
+
+        const active = this._enabled && TRANSLUCENT.has(treatment);
+        this._effect.radius = recipe.radius;
+        this._effect.saturation = recipe.saturation;
+        this._effect.enabled = active;
+        this._setEffectGeometry();
+    }
+}
+
+let controller;
+
+export function bindSurface(actor, options = {}) {
+    controller ??= new SurfaceMaterialController();
+    return controller.bind(actor, options);
+}
