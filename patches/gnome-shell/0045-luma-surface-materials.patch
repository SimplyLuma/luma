+import {resolveTreatment} from
+    'resource:///org/gnome/shell/ui/lumaSurfaceMaterials.js';
+
+describe('Luma surface treatment policy', () => {
+    it('preserves all four supported treatments on accelerated rendering', () => {
+        for (const treatment of ['light', 'dark', 'frost', 'glass']) {
+            expect(resolveTreatment({requested: treatment}))
+                .toEqual(treatment);
+        }
+    });
+
+    it('uses an opaque light fallback for translucent inaccessible paths', () => {
+        for (const requested of ['frost', 'glass']) {
+            expect(resolveTreatment({requested, reduceTransparency: true}))
+                .toEqual('light');
+            expect(resolveTreatment({requested, hardwareAccelerated: false}))
+                .toEqual('light');
+        }
+    });
+
+    it('honors the active opaque contrast theme', () => {
+        expect(resolveTreatment({requested: 'glass', highContrast: true}))
+            .toEqual('light');
+        expect(resolveTreatment({
+            requested: 'frost',
+            highContrast: true,
+            dark: true,
+        })).toEqual('dark');
+    });
+});
