From: Project Luma <maintainers@projectluma.org>
Subject: [PATCH] shell: converge surface chrome on the Design Center contract

The global treatment, rather than the retired Shelf material preference, owns
all Shelf ink. Give every painted layer the effective treatment class, restore
the simulator's mode-specific depth stack and icon elevation, and keep Quick
Options' nested detail menus inside the one root backdrop effect.

---
 data/theme/luma-shelf.css     | 184 ++++++++++++++++++++++++++++++++++++
 js/ui/lumaSurfaceMaterials.js |  11 +++
 js/ui/panel.js                |   3 +-
 js/ui/quickSettings.js        |   4 +
 js/ui/shelf.js                |  19 +++-
 5 files changed, 218 insertions(+), 3 deletions(-)

diff --git a/js/ui/lumaSurfaceMaterials.js b/js/ui/lumaSurfaceMaterials.js
--- a/js/ui/lumaSurfaceMaterials.js
+++ b/js/ui/lumaSurfaceMaterials.js
@@ -111,6 +111,8 @@ class SurfaceMaterialBinding {
         enabled = true,
         cornerRadii = 15,
         classActors = [],
+        backdrop = true,
+        onTreatmentChanged = null,
     } = {}) {
         this._controller = controller;
         this._actor = actor;
@@ -118,12 +120,17 @@ class SurfaceMaterialBinding {
         this._classActors = [actor, ...classActors];
         this._cornerRadii = Array.isArray(cornerRadii)
             ? [...cornerRadii]
             : [cornerRadii, cornerRadii, cornerRadii, cornerRadii];
+        this._onTreatmentChanged = onTreatmentChanged;
+        this._treatment = null;
-        this._effect = new Shell.BlurEffect({
-            mode: Shell.BlurMode.BACKGROUND,
-            brightness: 1,
-        });
-        actor.add_effect_with_name(EFFECT_NAME, this._effect);
+        this._effect = backdrop
+            ? new Shell.BlurEffect({
+                mode: Shell.BlurMode.BACKGROUND,
+                brightness: 1,
+            })
+            : null;
+        if (this._effect)
+            actor.add_effect_with_name(EFFECT_NAME, this._effect);
         actor.connect('destroy', () => {
             this._controller._remove(this);
             this._actor = null;
@@ -159,17 +166,28 @@ class SurfaceMaterialBinding {
     }
 
     _sync(treatment, recipe) {
-        if (!this._actor || !this._effect)
+        if (!this._actor)
             return;
         for (const actor of this._classActors) {
             for (const name of TREATMENTS)
                 actor.remove_style_class_name(`luma-surface-${name}`);
             actor.add_style_class_name(`luma-surface-${treatment}`);
         }
 
+        if (this._treatment !== treatment) {
+            this._treatment = treatment;
+            try {
+                this._onTreatmentChanged?.(treatment);
+            } catch (error) {
+                logError(error, 'Unable to apply Luma surface treatment');
+            }
+        }
+
-        const active = this._enabled && TRANSLUCENT.has(treatment);
-        this._effect.radius = recipe.radius;
-        this._effect.saturation = recipe.saturation;
-        this._effect.enabled = active;
-        this._setEffectGeometry();
+        if (this._effect) {
+            const active = this._enabled && TRANSLUCENT.has(treatment);
+            this._effect.radius = recipe.radius;
+            this._effect.saturation = recipe.saturation;
+            this._effect.enabled = active;
+            this._setEffectGeometry();
+        }
     }
diff --git a/js/ui/panel.js b/js/ui/panel.js
--- a/js/ui/panel.js
+++ b/js/ui/panel.js
@@ -827,7 +827,8 @@ class QuickSettings extends PanelMenu.Button {
         const filled = ['fill', 'both'].includes(frame) || flush;
         const stroked = ['stroke', 'both'].includes(frame) && !flush;
         const strength = Number(s.get_string('status-fill-strength')) / 100;
-        const light = ['light', 'frost'].includes(s.get_string('shelf-material'));
+        const treatment = this._lumaSurfaceTreatment ?? s.get_string('surface-treatment');
+        const light = ['light', 'frost'].includes(treatment);
         const line = light ? 'rgba(25,27,31,0.14)' : 'rgba(255,255,255,0.16)';
         const rgba = key => {
             const raw = s.get_string(key);
diff --git a/js/ui/quickSettings.js b/js/ui/quickSettings.js
--- a/js/ui/quickSettings.js
+++ b/js/ui/quickSettings.js
@@ -1014,6 +1014,10 @@ export const QuickSettingsMenu = class extends PopupMenu.PopupMenu {
 
         if (item.menu) {
             item.menu.box.add_style_class_name('luma-quick-detail');
+            // A detail sheet is a pane inside Quick Options, not another
+            // physical sheet over the desktop. The root panel alone owns the
+            // compositor backdrop; the detail retains only its pane fill.
+            item.menu._materialBinding?.setEnabled(false);
             this._overlay.add_child(item.menu.actor);
 
             item.menu.connect('open-state-changed', (m, isOpen) => {
diff --git a/js/ui/shelf.js b/js/ui/shelf.js
--- a/js/ui/shelf.js
+++ b/js/ui/shelf.js
@@ -223,10 +223,6 @@ class ShelfIsland extends St.Widget {
 
         child.add_style_class_name('luma-shelf-material');
         this.add_child(child);
-        this._materialBinding = SurfaceMaterials.bindSurface(child, {
-            enabled: false,
-            cornerRadii: 15,
-        });
 
         const stroke = new St.Widget({
             style_class: 'luma-shelf-stroke',
@@ -241,6 +237,16 @@ class ShelfIsland extends St.Widget {
         // These painted layers must never intercept the real tile delegate.
         Shell.util_set_hidden_from_pick(stroke, true);
         this._stroke = stroke;
+        this._materialBinding = SurfaceMaterials.bindSurface(child, {
+            enabled: false,
+            cornerRadii: 15,
+            classActors: [this, stroke, ...this._shadows],
+            onTreatmentChanged: treatment => {
+                this._content._lumaSurfaceTreatment = treatment;
+                if (this._content._statusActive)
+                    this._content._styleStatusCluster();
+            },
+        });
     }
 
     setOrientation(vertical, padding, outer = false) {
@@ -746,6 +752,10 @@ export const Shelf = GObject.registerClass(
                 item.connectObject('destroy', () => bar.destroy(), bar);
                 this._dockIndicators.add_child(bar);
             }
+            if (delegate?.label && !delegate.label._lumaSurfaceBinding) {
+                delegate.label._lumaSurfaceBinding = SurfaceMaterials.bindSurface(
+                    delegate.label, {backdrop: false, cornerRadii: 999});
+            }
             const icon = delegate?.icon?.icon;
             if (!icon || icon.get_effect('luma-icon-mask'))
                 continue;
diff --git a/data/theme/luma-shelf.css b/data/theme/luma-shelf.css
--- a/data/theme/luma-shelf.css
