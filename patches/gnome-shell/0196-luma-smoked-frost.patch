@@ -2787,7 +2787,7 @@ StBoxLayout.luma-notification-tray.luma-surface-dark .luma-notification-tray-cou
   background-color: #262a31; color: #f2f3f5; border-radius: 22px;
   border: 1px solid rgba(255,255,255,.075); font-family: Figtree; }
 .quick-settings.luma-studio-options.luma-surface-light { background-color: #eceef1; color: #1d1f23; border-color: rgba(255,255,255,.9); }
-.quick-settings.luma-studio-options.luma-surface-frost {
