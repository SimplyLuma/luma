-        ink: '#1f262d', ink2: '#394047',
-        accent: '#7a4a0c', line: 'rgba(37,46,54,0.10)',
+        // The gradient's denser end: islands rgba(26,26,30,.84), pop-overs
+        // rgba(32,32,36,.86). The painted gradient is in luma-shelf.css.
+        veil: 'rgba(26,26,30,0.84)', veilRaised: 'rgba(32,32,36,0.86)',
+        veilCard: 'rgba(30,30,34,0.86)',
+        recess: 'rgba(0,0,0,0.22)',
+        ink: '#f1f2f4', ink2: '#dcdfe1',
+        accent: '#f5c26b', line: 'rgba(255,255,255,0.10)',
         // The rule between the parts of one island or bar (DIVIDER_WIDTH;
         // ShelfIsland.setDivider draws it between the parts of a bar).
-        divider: 'rgba(37,46,54,0.28)',
-        hover: 'rgba(37,46,54,0.06)', press: 'rgba(37,46,54,0.10)',
-        rim: 'rgba(255,255,255,0.55)',
+        divider: 'rgba(255,255,255,0.22)',
+        hover: 'rgba(255,255,255,0.06)', press: 'rgba(255,255,255,0.09)',
+        rim: 'rgba(255,255,255,0.06)',
         shadow: null,
     },
     glass: {
@@ -103,7 +126,8 @@ export const SURFACE_INK = {
 };
 
 // The modes whose surfaces are paper-coloured and carry dark ink.
-export const LIGHT_FAMILY = new Set(['light', 'frost', 'glass']);
+// Smoked Frost carries dark ink, so it is not one of them.
+export const LIGHT_FAMILY = new Set(['light', 'glass']);
 
 // Body text must clear this; a glyph or large text clears LARGE_MINIMUM.
 export const INK_MINIMUM = 4.5;
@@ -217,7 +241,7 @@ class SurfaceMaterialController {
         }
 
         for (const binding of this._bindings)
-            binding._sync(this._effective, recipe);
