@@ -3001,3 +3001,46 @@ StBoxLayout.luma-notification-tray.luma-surface-dark .luma-notification-tray-cou
 .quick-settings.luma-studio-options.luma-surface-light .luma-options-detail .luma-sheet-link { color: #16191d; }
 .luma-notification-lip .notification-banner.luma-lip-card .message-action-bin .luma-inline-reply-entry .hint-text { color: rgba(231,233,232,.42); }
 .luma-notification-lip.luma-surface-light .notification-banner.luma-lip-card .message-action-bin .luma-inline-reply-entry .hint-text { color: rgba(22,25,29,.56); }
+/* Smoked Frost (Studio Desktop, approved 25 Sep). In Frost the Shell's
+ * surfaces wear the dark family's classes, so their ink, wells, hover and
+ * marks are the dark ones, plus luma-surface-smoke, which trades the opaque
+ * charcoal for the smoked glass over the blurred wallpaper (blur 40,
+ * saturation 1.4, lumaSurfaceMaterials.js). Light and Dark alike: Frost always
+ * carries dark ink. Pop-overs take the denser pop glass. */
+.luma-shelf-material.luma-surface-smoke,
+.luma-shelf-root.luma-shelf-separate > .luma-shelf-group >
+.luma-shelf-actions-island >
+.luma-shelf-material.luma-status-cluster.luma-surface-smoke,
+.dash-label.luma-surface-smoke,
+.luma-dock-preview.luma-surface-smoke,
+.luma-dockf-surface.luma-surface-smoke {
+  background-color: rgba(40,40,45,0.74);
+  background-gradient-direction: vertical;
+  background-gradient-start: rgba(40,40,45,0.74);
+  background-gradient-end: rgba(26,26,30,0.84);
+  color: #e7e9e8;
+  text-shadow: none; }
+.luma-shelf-root.luma-shelf-separate > .luma-shelf-group.luma-shelf-material.luma-surface-smoke {
+  background-color: transparent;
+  background-gradient-direction: none; }
+.popup-menu.luma-surface-smoke .popup-menu-content,
+.popup-menu.luma-surface-smoke .popup-menu-content.luma-quick-options {
+  background-color: rgba(50,50,56,0.80);
+  background-gradient-direction: vertical;
+  background-gradient-start: rgba(50,50,56,0.80);
+  background-gradient-end: rgba(32,32,36,0.86);
+  color: #e7e9e8;
+  text-shadow: none; }
+.luma-shelf-stroke.luma-surface-smoke {
+  border-color: rgba(255,255,255,0.06);
+  border-top-color: rgba(255,255,255,0.12); }
+/* Inside the glass the kit is glass: wells a translucent inset, chips a
+ * translucent lift, never an opaque tile. */
+.luma-shelf-live-island .luma-shelf-material.luma-surface-smoke .luma-live-extension-action,
+.luma-surface-smoke .luma-media-control {
+  background-color: rgba(255,255,255,0.10); }
+.luma-shelf-live-island .luma-shelf-material.luma-surface-smoke .luma-live-extension-action:hover,
+.luma-surface-smoke .luma-media-control:hover {
+  background-color: rgba(255,255,255,0.16); }
+.luma-surface-smoke .luma-media-control.luma-media-primary {
+  background-color: rgba(255,255,255,0.20); }
diff --git a/js/ui/lumaSurfaceMaterials.js b/js/ui/lumaSurfaceMaterials.js
index 21b4f5c..9161fe5 100644
--- a/js/ui/lumaSurfaceMaterials.js
+++ b/js/ui/lumaSurfaceMaterials.js
@@ -16,6 +16,23 @@ const RECIPES = {
     frost: {radius: 38, saturation: 1.6},
     glass: {radius: 18, saturation: 1.35},
 };
+// The Shell's own Frost is the approved smoked glass (Studio Desktop, 25
+// Sep): the shelf, its pop-overs and the notification lip blur 40 with
+// saturation 1.4 under a dark smoke, with dark-mode ink in Light and Dark.
+// Application windows keep the platform's Frost recipe above (the
+// compositor's client parameters); only Shell surfaces take this one.
+const SHELL_RECIPES = {...RECIPES, frost: {radius: 40, saturation: 1.4}};
+// The classes a treatment puts on a surface. Smoked Frost wears the dark
+// family's classes, so every dark rule (ink, hover, wells, marks) applies,
+// plus luma-surface-smoke, which paints the translucent smoke instead of
+// the opaque charcoal.
+const SURFACE_CLASSES = {
+    light: ['luma-surface-light'],
+    dark: ['luma-surface-dark'],
+    frost: ['luma-surface-dark', 'luma-surface-smoke'],
+    glass: ['luma-surface-glass'],
+};
+const ALL_SURFACE_CLASSES = [...TREATMENTS.map(name => `luma-surface-${name}`), 'luma-surface-smoke'];
 
 // One ink ledger for every surface Luma draws over the wallpaper: the Shelf
 // islands, the Well, the clock, Quick Options, notifications, the beacon, the
@@ -74,17 +91,23 @@ export const SURFACE_INK = {
         rim: 'rgba(255,255,255,0.045)',
         shadow: null,
     },
+    // Smoked Frost (Studio Desktop): the glass gradient rgba(40,40,45,.74)
+    // to rgba(26,26,30,.84) over the blurred wallpaper, carrying the dark
+    // family's ink. Its worst case is the brightest wallpaper, pure white,
+    // where the smoke alone darkens the ground under light ink.
     frost: {
-        veil: 'rgba(248,249,250,0.90)', veilRaised: 'rgba(248,249,250,0.90)',
-        veilCard: 'rgba(250,250,251,0.88)',
