         if (previous !== undefined && previous !== this._effective) {
             for (const listener of this._listeners) {
@@ -240,7 +264,7 @@ class SurfaceMaterialController {
             this._sync();
         const binding = new SurfaceMaterialBinding(this, actor, options);
         this._bindings.add(binding);
-        binding._sync(this._effective, RECIPES[this._effective]);
+        binding._sync(this._effective, SHELL_RECIPES[this._effective]);
         return binding;
     }
 
@@ -286,7 +310,7 @@ class SurfaceMaterialBinding {
     setEnabled(enabled) {
         this._enabled = enabled;
         this._sync(this._controller._effective,
-            RECIPES[this._controller._effective]);
+            SHELL_RECIPES[this._controller._effective]);
     }
 
     setTranslucentRecipe(recipe) {
@@ -315,9 +339,10 @@ class SurfaceMaterialBinding {
         if (!this._actor)
             return;
         for (const actor of this._classActors) {
-            for (const name of TREATMENTS)
-                actor.remove_style_class_name(`luma-surface-${name}`);
-            actor.add_style_class_name(`luma-surface-${treatment}`);
+            for (const name of ALL_SURFACE_CLASSES)
