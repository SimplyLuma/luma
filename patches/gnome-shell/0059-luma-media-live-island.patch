diff --git a/js/ui/iconMask.js b/js/ui/iconMask.js
new file mode 100644
--- /dev/null
+++ b/js/ui/iconMask.js
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Shared shelf artwork mask, extracted unchanged from the existing dock.
+import Cogl from 'gi://Cogl';
+import GObject from 'gi://GObject';
+import Shell from 'gi://Shell';
+
+const ICON_MASK_DECLARATIONS = `
+uniform float radius;
+`;
+
+// Runs after the default fragment stage, so cogl_color_out already holds the
+// sampled texel and the mask only has to attenuate it. Colour is premultiplied,
+// so scaling the whole vector is the correct way to fade a corner out.
+const ICON_MASK_CODE = `
+vec2 uv = cogl_tex_coord_in[0].st;
+vec2 edge = min(uv, vec2(1.0) - uv);
+float corner = length(max(vec2(radius) - edge, vec2(0.0)));
+cogl_color_out *= 1.0 - smoothstep(radius - 0.02, radius + 0.02, corner);
+`;
+
+export const LumaIconMask = GObject.registerClass(
+class LumaIconMask extends Shell.GLSLEffect {
+    vfunc_build_pipeline() {
+        this.add_glsl_snippet(
+            Cogl.SnippetHook.FRAGMENT,
+            ICON_MASK_DECLARATIONS, ICON_MASK_CODE, false);
+    }
+});
+
diff --git a/js/ui/mediaArtwork.js b/js/ui/mediaArtwork.js
new file mode 100644
--- /dev/null
+++ b/js/ui/mediaArtwork.js
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import GdkPixbuf from 'gi://GdkPixbuf';
+import Soup from 'gi://Soup';
+
+const MAX_BYTES = 2 * 1024 * 1024;
+const cache = new Map();
+const session = new Soup.Session({timeout: 10, max_conns: 2, max_conns_per_host: 1});
+
+function readChunk(stream, cancellable) {
+    return new Promise((resolve, reject) => {
+        stream.read_bytes_async(65536, GLib.PRIORITY_DEFAULT, cancellable, (object, result) => {
+            try { resolve(object.read_bytes_finish(result)); } catch (error) { reject(error); }
+        });
+    });
+}
+
+async function boundedBytes(stream, cancellable) {
+    const parts = [];
+    let total = 0;
+    try {
+        while (true) {
+            const chunk = await readChunk(stream, cancellable);
+            if (!chunk.get_size()) break;
+            total += chunk.get_size();
+            if (total > MAX_BYTES) throw new Error('Artwork exceeds size limit');
+            parts.push(chunk.get_data());
+        }
+    } finally {
+        stream.close_async(GLib.PRIORITY_DEFAULT, null, (object, result) => {
+            try { object.close_finish(result); } catch { /* Already closed. */ }
+        });
+    }
+    const data = new Uint8Array(total);
+    let offset = 0;
+    for (const part of parts) { data.set(part, offset); offset += part.length; }
+    return GLib.Bytes.new(data);
+}
+
+async function decode(bytes, cancellable) {
+    const input = Gio.MemoryInputStream.new_from_bytes(bytes);
+    const pixbuf = await new Promise((resolve, reject) => {
+        GdkPixbuf.Pixbuf.new_from_stream_at_scale_async(input, 56, 56, true, cancellable,
+            (_object, result) => {
+                try { resolve(GdkPixbuf.Pixbuf.new_from_stream_finish(result)); }
+                catch (error) { reject(error); }
+            });
+    });
+    const [ok, png] = pixbuf.save_to_bufferv('png', [], []);
+    return ok ? new Gio.BytesIcon({bytes: GLib.Bytes.new(png)}) : null;
+}
+
+export async function loadShelfArtwork(url, cancellable) {
+    if (!url || url.length > MAX_BYTES * 2) return null;
+    if (cache.has(url)) {
+        const icon = cache.get(url);
+        cache.delete(url); cache.set(url, icon);
+        return icon;
+    }
+    let bytes;
+    if (/^data:image\/(png|jpeg|webp|gif);base64,/i.test(url)) {
+        const data = GLib.base64_decode(url.slice(url.indexOf(',') + 1));
+        if (data.length > MAX_BYTES) return null;
+        bytes = GLib.Bytes.new(data);
+    } else {
+        const uri = GLib.Uri.parse(url, GLib.UriFlags.NONE);
+        if (uri.get_userinfo()) return null;
+        let stream;
+        if (uri.get_scheme() === 'file' && (!uri.get_host() || uri.get_host() === 'localhost')) {
+            const file = Gio.File.new_for_uri(url);
+            const info = await new Promise((resolve, reject) => {
+                file.query_info_async('standard::type,standard::size', Gio.FileQueryInfoFlags.NONE,
+                    GLib.PRIORITY_DEFAULT, cancellable, (object, result) => {
+                        try { resolve(object.query_info_finish(result)); } catch (error) { reject(error); }
+                    });
+            });
+            if (info.get_file_type() !== Gio.FileType.REGULAR || info.get_size() > MAX_BYTES)
+                return null;
+            stream = await new Promise((resolve, reject) => {
+                file.read_async(GLib.PRIORITY_DEFAULT, cancellable, (object, result) => {
+                    try { resolve(object.read_finish(result)); } catch (error) { reject(error); }
+                });
+            });
+        } else if (uri.get_scheme() === 'https') {
+            const message = Soup.Message.new('GET', url);
+            // No credentials, cookies or insecure redirect fallback.
+            message.connect('restarted', () => {
+                if (message.get_uri().get_scheme() !== 'https' || message.get_uri().get_userinfo())
+                    cancellable.cancel();
+            });
+            stream = await new Promise((resolve, reject) => {
+                session.send_async(message, GLib.PRIORITY_DEFAULT, cancellable, (object, result) => {
+                    try { resolve(object.send_finish(result)); } catch (error) { reject(error); }
+                });
+            });
+            if (message.status_code !== 200) {
+                stream.close(null);
+                return null;
+            }
+        } else {
+            return null;
+        }
+        bytes = await boundedBytes(stream, cancellable);
+    }
+    const icon = await decode(bytes, cancellable);
+    if (icon) {
+        cache.set(url, icon);
+        while (cache.size > 24) cache.delete(cache.keys().next().value);
+    }
+    return icon;
+}
diff --git a/js/ui/mediaSelection.js b/js/ui/mediaSelection.js
new file mode 100644
--- /dev/null
+++ b/js/ui/mediaSelection.js
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// MPRIS is authoritative. Do not infer eligibility from metadata or status.
+export function isEligible(player) {
+    return Boolean(player?.canPlay);
+}
+
+export function pickPlayer(players) {
+    return [...players].filter(entry => isEligible(entry.player)).sort((a, b) =>
+        Number(b.player.status === 'Playing') - Number(a.player.status === 'Playing') ||
+        b.played - a.played || b.appeared - a.appeared)[0]?.player ?? null;
+}
+
+export class MediaSelection {
+    constructor() {
+        this.entries = new Map();
+        this.serial = 0;
+        this.selected = null;
+    }
+
+    update(player) {
+        let entry = this.entries.get(player);
+        if (!entry) {
+            entry = {player, appeared: ++this.serial, played: 0, status: null};
+            this.entries.set(player, entry);
+        }
+        const started = player.status === 'Playing' && entry.status !== 'Playing';
+        if (started)
+            entry.played = ++this.serial;
+        entry.status = player.status;
+        if (started && isEligible(player))
+            this.selected = player;
+        else if (!isEligible(this.selected))
+            this.selected = pickPlayer(this.entries.values());
+        return this.selected;
+    }
+
+    remove(player) {
+        this.entries.delete(player);
+        if (this.selected === player)
+            this.selected = pickPlayer(this.entries.values());
+        return this.selected;
+    }
+}
+
+// Media's boundary with status is fixed; spare space belongs to other gaps.
+export function shelfGaps(children, media, status, gap, spare = 0) {
+    const pinned = children.findIndex((child, index) => child === media && children[index + 1] === status);
+    const flexible = Math.max(0, children.length - 1 - Number(pinned >= 0));
+    return children.slice(0, -1).map((_child, index) => index === pinned
+        ? gap : gap + (flexible ? spare / flexible : 0));
+}
