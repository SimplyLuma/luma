+// SPDX-License-Identifier: GPL-2.0-or-later
+import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import Pango from 'gi://Pango';
+import St from 'gi://St';
+import * as Mpris from './mpris.js';
+import {MediaSelection} from './mediaSelection.js';
+import {LumaIconMask} from './iconMask.js';
+
+export const ShelfMedia = GObject.registerClass({
+    Signals: {'eligibility-changed': {}},
+}, class ShelfMedia extends St.BoxLayout {
+    _init() {
+        super._init({style_class: 'luma-media-module', y_align: Clutter.ActorAlign.CENTER});
+        this.selection = new MediaSelection();
+        this._source = Mpris.getDefaultSource();
+        this._players = new Set();
+        this._pending = 0;
+        this._artGeneration = 0;
+        this._identity = new St.Button({style_class: 'luma-media-identity', can_focus: true});
+        const identity = new St.BoxLayout({style_class: 'luma-media-identity-box'});
+        this._art = new St.Icon({style_class: 'luma-media-art', icon_size: 28});
+        try {
+            const mask = new LumaIconMask();
+            mask.set_uniform_float(mask.get_uniform_location('radius'), 1, [8 / 28]);
+            this._art.add_effect_with_name('luma-icon-mask', mask);
+        } catch (error) {
+            logError(error, 'Media artwork rounding unavailable');
+        }
+        this._copy = new St.BoxLayout({orientation: Clutter.Orientation.VERTICAL,
+            style_class: 'luma-media-copy', y_align: Clutter.ActorAlign.CENTER});
+        this._title = new St.Label({style_class: 'luma-media-title'});
+        this._artist = new St.Label({style_class: 'luma-media-artist'});
+        for (const label of [this._title, this._artist]) {
+            label.clutter_text.ellipsize = Pango.EllipsizeMode.END;
+            this._copy.add_child(label);
+        }
+        identity.add_child(this._art);
+        this._copyStack = new St.Widget({layout_manager: new Clutter.BinLayout(),
+            style_class: 'luma-media-copy', y_align: Clutter.ActorAlign.CENTER});
+        this._copyStack.add_child(this._copy);
+        identity.add_child(this._copyStack);
+        this._identity.set_child(identity);
+        this._identity.connect('clicked', () => this.selection.selected?.raiseSource());
+        this.add_child(this._identity);
+        this._controls = new St.BoxLayout({style_class: 'luma-media-controls',
+            x_align: Clutter.ActorAlign.CENTER, y_align: Clutter.ActorAlign.CENTER});
+        this._previous = this._button('media-skip-backward-symbolic', () => this.selection.selected?.previous());
+        this._toggle = this._button('media-playback-start-symbolic', () => this.selection.selected?.playPause());
+        this._next = this._button('media-skip-forward-symbolic', () => this.selection.selected?.next());
+        this.add_child(this._controls);
+        this._source.connectObject('player-added', (_source, player) => this._add(player),
+            'player-removed', (_source, player) => this._remove(player), this);
+        St.Settings.get().connectObject('notify::enable-animations', () => this._render(), this);
+        this.connect('destroy', () => {
+            this._disposed = true;
+            if (this._pending) GLib.source_remove(this._pending);
+            this._cancellable?.cancel();
+            for (const player of this._players) player.disconnectObject(this);
+            this._players.clear();
+        });
+        this._source.players.forEach(player => this._add(player));
+        this._render();
+    }
+
+    setVertical(vertical) {
+        this.orientation = vertical ? Clutter.Orientation.VERTICAL : Clutter.Orientation.HORIZONTAL;
+        this._identity.child.orientation = this.orientation;
+        this._controls.orientation = this.orientation;
+        this._copy.visible = true;
+        this._copy.set_style(vertical ? "width: 36px;" : null);
+        this._copyStack.set_style(vertical ? "width: 36px;" : null);
+        if (vertical) this.add_style_class_name('vertical');
+        else this.remove_style_class_name('vertical');
+    }
+
+    _button(icon, action) {
+        const button = new St.Button({style_class: 'luma-media-control', can_focus: true,
+            child: new St.Icon({icon_name: icon, icon_size: 14})});
+        button.connect('clicked', action);
+        this._controls.add_child(button);
+        return button;
+    }
+
+    _add(player) {
+        if (!this._players.has(player)) {
+            this._players.add(player);
+            player.connectObject('changed', () => {
+                this.selection.update(player);
+                this._queue();
+            }, this);
+        }
+        this.selection.update(player);
+        this._queue();
+    }
+
+    _remove(player) {
+        player.disconnectObject(this);
+        this._players.delete(player);
+        this.selection.remove(player);
+        this._queue();
+    }
+
+    _queue() {
+        if (this._pending) return;
+        this._pending = GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
+            this._pending = 0;
+            this._render();
+            return GLib.SOURCE_REMOVE;
+        });
+    }
+
+    _render() {
+        if (this._disposed) return;
+        const player = this.selection.selected;
+        const eligible = Boolean(player);
+        if (this.eligible !== eligible) {
+            this.eligible = eligible;
+            this.emit('eligibility-changed');
+        }
+        if (!player) {
+            this._artKey = null;
+            this._artGeneration++;
+            this._cancellable?.cancel();
+            this._playing = false;
+            return;
+        }
+        const appName = player.source.title || _('Media player');
+        const title = player.shelfTitle || appName;
+        const artist = player.shelfArtists.join(', ') || appName;
+        const changed = this._title.text !== title || this._artist.text !== artist;
+        this._oldCopy?.destroy();
+        this._oldCopy = null;
+        if (changed && this._title.text && St.Settings.get().enable_animations) {
+            const old = new St.BoxLayout({orientation: Clutter.Orientation.VERTICAL,
+                style_class: 'luma-media-copy'});
+            old.set_style(this._copy.get_style());
+            for (const [value, style] of [[this._title.text, 'luma-media-title'],
+                [this._artist.text, 'luma-media-artist']]) {
+                const label = new St.Label({text: value, style_class: style});
+                label.clutter_text.ellipsize = Pango.EllipsizeMode.END;
+                old.add_child(label);
+            }
+            this._oldCopy = old;
+            this._copyStack.add_child(old);
+            old.ease({opacity: 0, duration: 160, onComplete: () => {
+                if (this._oldCopy === old) this._oldCopy = null;
+                old.destroy();
+            }});
+        }
+        this._title.text = title;
+        this._artist.text = artist;
+        this._identity.accessible_name = _('Now playing: %s by %s, in %s').format(title, artist, appName);
+        this._playing = player.status === 'Playing';
+        this._toggle.child.icon_name = this._playing
+            ? 'media-playback-pause-symbolic' : 'media-playback-start-symbolic';
+        this._toggle.accessible_name = (this._playing ? _('Pause %s') : _('Play %s')).format(title);
+        this._previous.accessible_name = _('Previous track');
+        this._next.accessible_name = _('Next track');
+        for (const [button, enabled] of [[this._previous, player.canGoPrevious],
+            [this._next, player.canGoNext], [this._toggle, player.canControl &&
+                (this._playing ? player.canPause : player.canPlay)]]) {
+            button.reactive = Boolean(enabled);
+            button.can_focus = Boolean(enabled);
+            button.opacity = enabled ? 255 : 85;
+        }
+        if (changed && St.Settings.get().enable_animations) {
+            this._copy.remove_all_transitions();
+            this._copy.opacity = 0;
+            this._copy.ease({opacity: 255, duration: 160});
+        }
+        this._updateArt(player);
+    }
+
+    _updateArt(player) {
+        const fallback = player.app?.get_icon() ?? new Gio.ThemedIcon({name: 'audio-x-generic-symbolic'});
+        const url = player.trackCoverUrl || '';
+        const key = `${player.source.title}\n${url}`;
+        if (this._artKey === key) return;
+        this._artKey = key;
+        const generation = ++this._artGeneration;
+        this._cancellable?.cancel();
+        this._cancellable = new Gio.Cancellable();
+        this._art.gicon = fallback;
+        // Local artwork is handed to the existing async St icon loader. Remote
+        // artwork is supplied by the bounded shared loader, never fetched here.
+        Mpris.loadShelfArtwork(url, this._cancellable).then(icon => {
+            if (this._disposed || this._artGeneration !== generation || !icon) return;
+            this._art.gicon = icon;
+            if (St.Settings.get().enable_animations) {
+                this._art.opacity = 0;
+                this._art.ease({opacity: 255, duration: 160});
+            }
+        }).catch(() => {}); // Keep the source icon when artwork is unavailable.
+    }
+
+});
