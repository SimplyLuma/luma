From: Project Luma <builds@project-luma.local>
Subject: [PATCH] luma: the login wallpaper fills every display

The login screen drew its wallpaper as a stylesheet background inside
the dialog on the primary display only. It did not fill a wide or scaled
display, and every other display stayed black. Each display now gets its
own wallpaper from Mutter's background renderer, zoomed to that display
at its own scale, on the login and lock screens alike. If the renderer
cannot be created the stylesheet picture is kept, so the screen always
draws.

--- a/js/gdm/loginDialog.js
+++ b/js/gdm/loginDialog.js
@@ -584,8 +584,13 @@
         this._textureCache.connectObject('texture-file-changed',
             this._updateLogoTexture.bind(this), this);
 
-        this._prairieBackground = new PrairieLogin.Background();
-        this.add_child(this._prairieBackground);
+        // One wallpaper per display, not only behind the dialog on the
+        // primary one: every other display was left black.
+        this._prairieBackgrounds = new Clutter.Actor();
+        this.add_child(this._prairieBackgrounds);
+        this._updatePrairieBackgrounds();
+        Main.layoutManager.connectObject('monitors-changed',
+            () => this._updatePrairieBackgrounds(), this);
 
         this._userSelectionBox = new St.BoxLayout({
             style_class: 'login-dialog-user-selection-box',
@@ -780,6 +785,22 @@
         return Clutter.EVENT_PROPAGATE;
     }
 
+    _updatePrairieBackgrounds() {
+        this._prairieBackgrounds.destroy_all_children();
+        const primary = Main.layoutManager.primaryMonitor;
+        if (!primary)
+            return;
+        // The dialog covers the primary monitor, so each wallpaper is placed
+        // relative to it; the others extend past the dialog onto their own
+        // displays.
+        Main.layoutManager.monitors.forEach((monitor, index) => {
+            const background = new PrairieLogin.Background({monitorIndex: index});
+            background.set_position(monitor.x - primary.x, monitor.y - primary.y);
+            background.set_size(monitor.width, monitor.height);
+            this._prairieBackgrounds.add_child(background);
+        });
+    }
+
     vfunc_allocate(dialogBox) {
         this.set_allocation(dialogBox);
 
@@ -788,7 +809,7 @@
         backgroundAllocation.y1 = dialogBox.y1;
         backgroundAllocation.x2 = dialogBox.x2;
         backgroundAllocation.y2 = dialogBox.y2;
-        this._prairieBackground.allocate(backgroundAllocation);
+        this._prairieBackgrounds.allocate(backgroundAllocation);
 
         const themeNode = this.get_theme_node();
         dialogBox = themeNode.get_content_box(dialogBox);
