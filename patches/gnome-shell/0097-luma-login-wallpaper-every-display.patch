+const LOGIN_WALLPAPER = '/usr/share/backgrounds/luma/prism.png';
+let loginWallpaper = null;
+
+function getLoginWallpaper() {
+    if (!loginWallpaper) {
+        loginWallpaper = new Meta.Background({meta_display: global.display});
+        loginWallpaper.set_file(Gio.File.new_for_path(LOGIN_WALLPAPER),
+            GDesktopEnums.BackgroundStyle.ZOOM);
+    }
+    return loginWallpaper;
+}
+
 export const Background = GObject.registerClass(
 class PrairieLoginBackground extends St.Widget {
     _init(params = {}) {
+        const {monitorIndex, ...widgetParams} = params;
