             style_class: 'prairie-login-background',
             layout_manager: new Clutter.BinLayout(),
         });
 
-        this._wallpaper = new St.Widget({
+        // For a monitor, the wallpaper is drawn by Mutter's own background
+        // renderer, which zooms it to that monitor at its own scale -- a CSS
+        // background did not fill a wide or scaled display. Without a monitor
+        // (a preview, a test) the stylesheet's picture remains.
+        this._wallpaper = null;
+        if (Number.isInteger(monitorIndex)) {
+            try {
+                this._wallpaper = new Meta.BackgroundActor({
+                    meta_display: global.display,
+                    monitor: monitorIndex,
+                    x_expand: true,
+                    y_expand: true,
+                    x_align: Clutter.ActorAlign.FILL,
+                    y_align: Clutter.ActorAlign.FILL,
+                });
+                this._wallpaper.content.set({background: getLoginWallpaper()});
+            } catch (error) {
+                // The login screen must always draw; the stylesheet picture
+                // is a correct, if less exact, wallpaper.
+                logError(error, 'Luma login wallpaper renderer unavailable');
+                this._wallpaper?.destroy();
+                this._wallpaper = null;
+            }
+        }
+        this._wallpaper ??= new St.Widget({
             style_class: 'prairie-login-wallpaper',
             x_expand: true,
             y_expand: true,
