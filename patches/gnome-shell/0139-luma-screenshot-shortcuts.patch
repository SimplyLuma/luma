diff --git a/data/luma-screenshot-shortcuts-migrate.js b/data/luma-screenshot-shortcuts-migrate.js
new file mode 100644
index 0000000..94b537d
--- /dev/null
+++ b/data/luma-screenshot-shortcuts-migrate.js
@@ -0,0 +1,85 @@
+#!/usr/bin/gjs -m
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Luma's screenshot shortcuts moved to Ctrl+Shift+1 to 4 as image defaults.
+// A person who still carries GNOME's old defaults, or the values Luma set on
+// early machines by hand, as their own setting would never see them. Once per
+// person, each of those keys is reset to the image default, but only while its
+// value is still one of those known values: a shortcut someone chose is kept.
+
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+
+const SCHEMA = 'org.gnome.shell.keybindings';
+const MARKER = 'screenshot-shortcuts-1';
+
+// Values that are not a person's choice: GNOME's defaults before Luma changed
+// them, and what was set on staging machines before these defaults shipped.
+const STALE = {
+    'show-screenshot-ui': [['Print'], ['<Control><Shift>1']],
+    'screenshot-window': [['<Alt>Print'], ['<Control><Shift>2']],
+    'show-screen-recording-ui': [['<Ctrl><Shift><Alt>R'], ['<Control><Shift>4']],
+    'screenshot': [['<Shift>Print'], []],
+};
+
+const MODIFIERS = new Map([
+    ['ctrl', 'control'], ['control', 'control'], ['primary', 'control'],
+    ['shift', 'shift'], ['alt', 'alt'], ['mod1', 'alt'], ['super', 'super'],
+    ['mod4', 'super'], ['meta', 'meta'], ['hyper', 'hyper'],
+]);
+
+// One spelling per accelerator: modifiers named one way and sorted, key lower-cased.
+export function normalize(accel) {
+    const modifiers = [];
+    let rest = accel.trim();
+    for (let match = rest.match(/^<([^>]+)>/); match; match = rest.match(/^<([^>]+)>/)) {
+        const name = match[1].toLowerCase();
+        modifiers.push(MODIFIERS.get(name) ?? name);
+        rest = rest.slice(match[0].length);
+    }
+    return [...new Set(modifiers)].sort().map(m => `<${m}>`).join('') + rest.toLowerCase();
+}
+
+export const sameList = (a, b) => a.length === b.length &&
+    a.map(normalize).every((value, index) => value === b.map(normalize)[index]);
+
+export function migrate(settings) {
+    const reset = [];
+    for (const [key, stale] of Object.entries(STALE)) {
+        if (!settings.settings_schema.has_key(key))
+            continue;
+        const user = settings.get_user_value(key);
+        if (!user)
+            continue;
+        const value = user.deepUnpack();
+        if (stale.some(list => sameList(value, list))) {
+            settings.reset(key);
+            reset.push(key);
+        }
+    }
+    return reset;
+}
+
+function main() {
+    const stateDir = GLib.build_filenamev([GLib.get_user_state_dir(), 'luma', 'migrations']);
+    const marker = GLib.build_filenamev([stateDir, MARKER]);
+    if (GLib.file_test(marker, GLib.FileTest.EXISTS))
+        return 0;
+    const source = Gio.SettingsSchemaSource.get_default();
+    const schema = source?.lookup(SCHEMA, true);
+    if (!schema)
+        return 0;
+    const settings = new Gio.Settings({settings_schema: schema});
+    const reset = migrate(settings);
+    Gio.Settings.sync();
+    GLib.mkdir_with_parents(stateDir, 0o700);
+    GLib.file_set_contents(marker, `${reset.join('\n')}\n`);
+    print(reset.length
+        ? `Luma screenshot shortcuts: reset ${reset.join(', ')} to the image defaults`
+        : 'Luma screenshot shortcuts: every shortcut is already the image default or a personal choice');
+    return 0;
+}
+
+// Imported by its test without running.
+if (!GLib.getenv('LUMA_MIGRATE_TEST'))
+    main();
diff --git a/data/luma-screenshot-shortcuts-migrate.service b/data/luma-screenshot-shortcuts-migrate.service
new file mode 100644
index 0000000..7f961b0
--- /dev/null
+++ b/data/luma-screenshot-shortcuts-migrate.service
@@ -0,0 +1,9 @@
+[Unit]
+Description=Move screenshot shortcuts to Luma's defaults, once
+After=graphical-session-pre.target
+PartOf=graphical-session.target
+ConditionPathExists=!%S/luma/migrations/screenshot-shortcuts-1
+
+[Service]
+Type=oneshot
+ExecStart=/usr/bin/gjs -m @pkglibdir@/luma-screenshot-shortcuts-migrate.js
diff --git a/data/meson.build b/data/meson.build
index bc1c6ab..48cc85d 100644
--- a/data/meson.build
+++ b/data/meson.build
@@ -125,6 +125,20 @@ if have_systemd
     'org.gnome.Shell-disable-extensions.service',
     install_dir: systemduserunitdir,
   )
+
+  # Luma: moves a person's stale screenshot shortcuts to the image defaults, once.
+  migrateconf = configuration_data()
+  migrateconf.set('pkglibdir', pkglibdir)
+  configure_file(
+    input: 'luma-screenshot-shortcuts-migrate.service',
+    output: 'luma-screenshot-shortcuts-migrate.service',
+    configuration: migrateconf,
+    install_dir: systemduserunitdir
+  )
+  install_symlink('luma-screenshot-shortcuts-migrate.service',
+    pointing_to: '../luma-screenshot-shortcuts-migrate.service',
+    install_dir: systemduserunitdir / 'graphical-session.target.wants')
+  install_data('luma-screenshot-shortcuts-migrate.js', install_dir: pkglibdir)
 endif
 
 # for unit tests - gnome.compile_schemas() only looks in srcdir
