 }
 
+/**
+ * Shows the screenshot UI in its Selection mode.
+ */
+export function showScreenshotUIArea() {
+    Main.screenshotUI.openArea().catch(err => {
+        logError(err, 'Error opening the screenshot UI');
+    });
+}
