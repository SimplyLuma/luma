 # Luma: Super+Tab opens the workspace overview (org.gnome.shell.keybindings
 # toggle-workspace-overview), so the app switcher, Grid, keeps Alt+Tab only.
+# Luma: Ctrl+Shift+1 to 4 take screenshots and recordings (the tool, a
+# window, a selected area, a recording) and nothing else does: the whole-screen
+# capture has no shortcut. Ctrl+Shift+3 is show-screenshot-ui-area's default.
+[org.gnome.shell.keybindings]
+show-screenshot-ui=['<Ctrl><Shift>1']
+screenshot-window=['<Ctrl><Shift>2']
+show-screen-recording-ui=['<Ctrl><Shift>4']
+screenshot=@as []
+
 [org.gnome.desktop.wm.keybindings]
 switch-applications=['<Alt>Tab']
 switch-applications-backward=['<Shift><Alt>Tab']
