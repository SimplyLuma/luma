+    async GetMonitorApplicationsAsync(params, invocation) {
+        try {
+            await this._monitorSenderChecker.checkInvocation(invocation);
+        } catch (e) {
+            invocation.return_gerror(e);
+            return;
+        }
+        const apps = {};
+        for (const app of this._appSystem.get_running()) {
+            if (this._isStandaloneApp(app))
+                apps[app.get_id()] = app.get_pids().filter(pid => pid > 0);
+        }
+        invocation.return_value(new GLib.Variant('(a{sau})', [apps]));
+    }
+
+    async RequestMonitorQuitAsync(params, invocation) {
+        try {
+            await this._monitorSenderChecker.checkInvocation(invocation);
+        } catch (e) {
+            invocation.return_gerror(e);
+            return;
+        }
+        const [appId, expectedPids] = params;
+        const app = this._appSystem.get_running().find(a => a.get_id() === appId);
+        // Refuse stale selections or a different instance of the same app.
+        const currentPids = app?.get_pids() ?? [];
+        const matches = expectedPids.length > 0 && currentPids.length > 0 &&
+            currentPids.every(pid => expectedPids.includes(pid));
+        // ShellApp requests app.quit or normal window deletion. It never kills
+        // the process, so application save/cancel prompts retain their meaning.
+        let requested = false;
+        if (matches && this._isStandaloneApp(app)) {
+            // Activate the existing window before asking it to close, so an
+            // application-owned save/cancel prompt is visible above Monitor.
+            app.activate_full(-1, global.display.get_current_time_roundtrip());
+            requested = app.request_quit();
+        }
+        invocation.return_value(new GLib.Variant('(b)', [Boolean(requested)]));
     }
 
