From: Luma Developers
Subject: [PATCH] Keycap: draw every layer into its cache after each show

On the Fold the first switch from Shift to lowercase after each keyboard
show (the release of the first capital) still drew a whole layer: about 60
journal flushes in one frame, up to 33 ms of dispatch. Clutter queues a
relayout and redraw of every actor it maps, so each show invalidated every
layer's cached texture, and the warm-up that draws them ran once per layout,
not once per show. Headless, every session's first capital cost 42 flushes.

The layers are now marked cold whenever the keyboard is mapped, its stage
views change or its layout is rebuilt, and drawn again one per frame, nearly
transparent, while the keyboard slides in or sits idle. A frame that handles
a touch, or one that does not draw the keyboard, does not carry a layer.

---
diff --git a/js/ui/keyboard.js b/js/ui/keyboard.js
--- a/js/ui/keyboard.js
+++ b/js/ui/keyboard.js
@@ -1684,6 +1684,7 @@
             global.stage.disconnect(this._hapticPaintId);
         if (this._warmTimeoutId)
             GLib.source_remove(this._warmTimeoutId);
+        this._stopLayerWarm();
         if (this._priorsIdleId)
             GLib.source_remove(this._priorsIdleId);
         Main.inputMethod.disconnectObject(this);
@@ -1754,7 +1755,12 @@
         this.connect('notify::mapped', () => {
             if (!this.mapped)
                 this._cancelPointers();
+            else
+                this._coolLayers();
         });
+        // A new stage view (a panel lit again, a monitor change) draws every
+        // cached texture anew too.
+        this.connect('stage-views-changed', () => this._coolLayers());
     }
 
     _pointerId(event) {
@@ -1777,6 +1783,7 @@
         const id = this._pointerId(event);
