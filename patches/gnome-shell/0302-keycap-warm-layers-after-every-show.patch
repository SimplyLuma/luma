             return Clutter.EVENT_PROPAGATE;
+        this._inputSincePaint = true;
         switch (event.type()) {
         case Clutter.EventType.TOUCH_BEGIN:
         case Clutter.EventType.BUTTON_PRESS:
@@ -2410,9 +2417,11 @@
         });
 
         this._aspectContainer.add_child(layout);
+        this._stopLayerWarm();
         this._currentLayout?.destroy();
         this._currentLayout = layout;
         this._layers = layers;
+        this._coolLayers();
     }
 
     // Keycap rows: hide lives in the tool strip and the language key appears
@@ -3672,19 +3681,15 @@
