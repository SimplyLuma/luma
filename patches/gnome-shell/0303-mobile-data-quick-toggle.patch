diff --git a/js/ui/status/mobileMode.js b/js/ui/status/mobileMode.js
new file mode 100644
--- /dev/null
+++ b/js/ui/status/mobileMode.js
@@ -0,0 +1,77 @@
+// Mobile data on phones whose modem carries either calls and texts (IMS) or
+// mobile data at a time: a view of the system's mobile mode service
+// (org.projectluma.MobileMode1), which owns the switch and its authorization.
+// Hidden where no such service runs.
+import Gio from 'gi://Gio';
+import GObject from 'gi://GObject';
+
+import {QuickToggle, SystemIndicator} from '../quickSettings.js';
+
+const BUS_NAME = 'org.projectluma.MobileMode1';
+const OBJECT_PATH = '/org/projectluma/MobileMode1';
+
+const MobileModeIface = `<node>
+  <interface name="org.projectluma.MobileMode1">
+    <method name="SetMode"><arg type="s" name="mode" direction="in"/></method>
+    <property name="Mode" type="s" access="read"/>
+    <property name="State" type="s" access="read"/>
+    <property name="DataAvailable" type="b" access="read"/>
+  </interface>
+</node>`;
+const MobileModeProxy = Gio.DBusProxy.makeProxyWrapper(MobileModeIface);
+
+const MobileDataToggle = GObject.registerClass(
+class MobileDataToggle extends QuickToggle {
+    _init() {
+        super._init({
+            title: _('Mobile Data'),
+            iconName: 'network-cellular-symbolic',
+            visible: false,
+        });
+
+        this._proxy = new MobileModeProxy(Gio.DBus.system, BUS_NAME, OBJECT_PATH,
+            (proxy, error) => {
+                if (error) {
+                    console.warn(`Mobile mode: ${error.message}`);
+                    return;
+                }
+                proxy.connectObject(
+                    'g-properties-changed', () => this._sync(),
+                    'notify::g-name-owner', () => this._sync(), this);
+                this._sync();
+            }, null, Gio.DBusProxyFlags.DO_NOT_AUTO_START);
+
+        this.connect('clicked', () => this._toggle());
+    }
+
+    _toggle() {
+        if (!this._proxy?.g_name_owner || this._proxy.State === 'switching')
+            return;
+        const mode = this._proxy.Mode === 'data' ? 'calls' : 'data';
+        this._proxy.SetModeAsync(mode).catch(error =>
+            console.warn(`Mobile mode: ${error.message}`));
+    }
+
+    _sync() {
+        const proxy = this._proxy;
+        this.visible = !!proxy?.g_name_owner && !!proxy.DataAvailable;
+        if (!this.visible)
+            return;
+        this.checked = proxy.Mode === 'data';
+        if (proxy.State === 'switching')
+            this.subtitle = _('Switching…');
+        else if (this.checked)
+            this.subtitle = _('Calls and texts off');
+        else
+            this.subtitle = null;
+    }
+});
+
+export const Indicator = GObject.registerClass(
+class Indicator extends SystemIndicator {
+    _init() {
+        super._init();
+
+        this.quickSettingsItems.push(new MobileDataToggle());
+    }
+});
