From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <engineering@projectluma.org>
Date: Tue, 3 Nov 2026 02:00:00 -0600
Subject: [PATCH] blur: bound the pass after a backdrop copy; downscale thin
 surfaces

A background blur copies the framebuffer under its actor, which ends the
GPU's pass over the frame at that point: a tiling GPU stores what was
drawn and loads it back to go on. The pass that follows covers everything
drawn until the next copy, and with no scissor that is the whole
framebuffer however little is drawn. On a Raspberry Pi 5 at 3840x2160
each blurred dock island cost a full-screen store and load (about 15 ms),
five of them per frame. Draw the blurred backdrop and the actor inside a
clip of the actor's paint box (when it is axis aligned), so the driver
can bound that pass; the compositor's per-draw scissors (mutter 0027)
bound the rest.

The downscale followed Firefox and stopped once either side of the copy
was 256 pixels or less, so a dock island 67 pixels tall was blurred at
full size with the full radius (two passes of about 1.3 ms for 1300x67).
Keep halving while the radius is above the threshold and the copy keeps
16 pixels per side, as larger surfaces already did. Screenshots of the
dock, Quick Options and the notification lip at 3840x2160 and 1080x2340
match the previous blur (SSIM 0.9996 or more).
---
 src/shell-blur-effect.c |   67 ++++++++++++++++++++++++++++++++++++++++-------
 1 file changed, 60 insertions(+), 7 deletions(-)

diff --git a/src/shell-blur-effect.c b/src/shell-blur-effect.c
index b83db53..9bb7ae0 100644
--- a/src/shell-blur-effect.c
+++ b/src/shell-blur-effect.c
@@ -68,7 +68,7 @@ static const gchar *brightness_glsl =
 "    cogl_color_out *= 1.0 - smoothstep(-0.5, 0.5, d);                       \n"
 "  }                                                                      \n";
 
-#define MIN_DOWNSCALE_SIZE 256.f
+#define MIN_DOWNSCALED_SIZE 16.f
 #define MAX_RADIUS 12.f
 
 typedef enum
@@ -338,13 +338,18 @@ calculate_downscale_factor (float width,
   float scaled_height = height;
   float scaled_radius = radius;
 
-  /* This is the algorithm used by Firefox; keep downscaling until either the
-   * blur radius is lower than the threshold, or the downscaled texture is too
-   * small.
+  /* Keep downscaling until the blur radius is below the threshold, as long
+   * as the downscaled texture keeps a few pixels per side.
+   *
+   * Luma: this followed Firefox and stopped once either side was 256 pixels
+   * or less, so a dock island 67 pixels tall was blurred at full size with
+   * the whole radius: two passes of about 1.3 ms each for 1300x67 pixels on a
+   * Raspberry Pi 5. Halving the copy and the radius blurs the same way (it is
+   * what every larger surface already got), for a quarter of the work.
    */
   while (scaled_radius > MAX_RADIUS &&
-         scaled_width > MIN_DOWNSCALE_SIZE &&
-         scaled_height > MIN_DOWNSCALE_SIZE)
+         scaled_width / 2.f >= MIN_DOWNSCALED_SIZE &&
+         scaled_height / 2.f >= MIN_DOWNSCALED_SIZE)
     {
       downscale_factor *= 2.f;
 
@@ -673,6 +678,52 @@ paint_actor_offscreen (ShellBlurEffect         *self,
     }
 }
 
+/* Luma: copying the framebuffer under the actor ends the GPU's pass over the
+ * frame there; a tiling GPU stores the frame drawn so far and loads it back to
+ * go on. The pass that follows covers everything drawn until the next copy or
+ * the end of the frame, and without a scissor that is the whole framebuffer
+ * however little is drawn: at 3840x2160 on a Raspberry Pi 5 each blurred dock
+ * island cost a full-screen store and load (about 15 ms) for a few pixels of
+ * blur. Drawing the blurred backdrop and the actor inside a clip of the
+ * actor's paint box lets the driver bound that pass to the box. Only an
+ * axis-aligned box becomes a scissor, so a rotated or skewed actor gets no
+ * clip (a stencil clip would cost more than it saves).
+ */
+static ClutterPaintNode *
+add_paint_box_clip (ShellBlurEffect  *self,
+                    ClutterPaintNode *node)
+{
+  g_autoptr (ClutterPaintNode) clip_node = NULL;
+  const ClutterPaintVolume *volume;
+  graphene_point3d_t origin;
+  graphene_point3d_t v[4];
+
+  volume = clutter_actor_get_paint_volume (self->actor);
+  if (!volume)
+    return node;
+
+  clutter_actor_get_abs_allocation_vertices (self->actor, v);
+  if (fabsf (v[0].y - v[1].y) > 0.01f || fabsf (v[2].y - v[3].y) > 0.01f ||
+      fabsf (v[0].x - v[2].x) > 0.01f || fabsf (v[1].x - v[3].x) > 0.01f)
+    return node;
+
+  clutter_paint_volume_get_origin (volume, &origin);
+
+  clip_node = clutter_clip_node_new ();
+  clutter_paint_node_set_static_name (clip_node, "ShellBlurEffect (paint box)");
+  clutter_paint_node_add_child (node, clip_node);
+  clutter_paint_node_add_rectangle (clip_node,
+                                    &(ClutterActorBox) {
+                                      origin.x,
+                                      origin.y,
+                                      origin.x + clutter_paint_volume_get_width (volume),
+                                      origin.y + clutter_paint_volume_get_height (volume),
+                                    });
+
+  /* The parent node holds a reference for the rest of the paint. */
+  return clip_node;
+}
+
 /* Luma: after this many frames in a row, take the blit rather than the cache,
  * so a surface whose redraw clip never covers it still follows the screen
  * instead of freezing on its last blur.
@@ -850,6 +901,9 @@ shell_blur_effect_paint_node (ClutterEffect           *effect,
         {
           ClutterActorBox source_actor_box;
 
+          if (self->mode == SHELL_BLUR_MODE_BACKGROUND)
+            node = add_paint_box_clip (self, node);
+
           update_actor_box (self, paint_context, &source_actor_box);
 
           /* Failing to create or update the offscreen framebuffers prevents
-- 
