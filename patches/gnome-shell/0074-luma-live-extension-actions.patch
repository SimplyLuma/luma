@@ -321,6 +321,59 @@ $panel_transition_duration: 250ms; // same as the overview transition duration
     font-weight: 500;
     color: #6b7280;
   }
+
+  // Actions are compact, icon-only, and square. The application names an
+  // action; the Shell owns the glyph and the geometry.
+  .luma-live-extension-actions {
+    spacing: 4px;
+  }
+
+  .luma-live-extension-action {
+    min-width: 22px;
+    min-height: 22px;
+    padding: 0;
+    border: 1px solid rgba(17, 24, 39, 0.10);
+    border-radius: 7px;
+    background-color: rgba(255, 255, 255, 0.55);
+    color: #1f2937;
+
+    &:hover, &:focus {
+      background-color: rgba(255, 255, 255, 0.95);
+    }
+
+    &:active {
+      background-color: rgba(72, 120, 184, 0.18);
+    }
+  }
+
+  .luma-live-extension-action-icon {
+    icon-size: 13px;
+  }
+
+  // An action that cannot work for this application stays visible and reads
+  // as unavailable. It is never hidden, and it never looks pressable.
+  .luma-live-extension-action-unavailable,
+  .luma-live-extension-action-unavailable:hover,
+  .luma-live-extension-action-unavailable:focus,
+  .luma-live-extension-action-unavailable:active {
+    border-color: rgba(17, 24, 39, 0.06);
+    background-color: rgba(17, 24, 39, 0.04);
+    color: rgba(31, 41, 55, 0.38);
+  }
+}
+
+// The tooltip lives in the UI group, not in the island, because it is
+// positioned against the stage. It carries the provider's own explanation for
+// a control that cannot work.
+.luma-live-extension-tooltip {
+  padding: 4px 10px;
+  border: 1px solid rgba(255, 255, 255, 0.09);
+  border-radius: 999px;
+  background-color: rgba(42, 46, 52, 0.94);
+  color: #e6eaec;
+  font-size: 11px;
+  font-weight: 600;
+  text-align: center;
 }
 
