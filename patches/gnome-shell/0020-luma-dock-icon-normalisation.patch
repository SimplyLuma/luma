+// Every application on the dock is drawn to the same silhouette, whatever
+// artwork it ships. Linux has spent a decade letting applications put whatever
+// they like on a dock — square screenshots, bare glyphs floating on nothing —
+// and the result never looks like one system.
+//
+// The rounding is a fragment shader rather than a stylesheet because St clips
+// a widget's own background to its border radius but not a child icon, so no
+// amount of CSS rounds the artwork itself. The shader masks the icon's alpha
+// to a rounded square; the tile behind it, which the stylesheet draws, is what
+// stops artwork with transparency floating.
+//
+// ICON_CORNER_RATIO is a fraction of the icon's width so it holds at every
+// icon size. 0.25 is the radius every Prairie application icon is drawn at,
+// so the mask agrees with the artwork instead of cutting into it.
+const ICON_CORNER_RATIO = 0.25;
+const ICON_MASK_DECLARATIONS = `
+uniform float radius;
+`;
+
+// Runs after the default fragment stage, so cogl_color_out already holds the
+// sampled texel and the mask only has to attenuate it. Colour is premultiplied,
+// so scaling the whole vector is the correct way to fade a corner out.
+const ICON_MASK_CODE = `
+vec2 uv = cogl_tex_coord_in[0].st;
+vec2 edge = min(uv, vec2(1.0) - uv);
+float corner = length(max(vec2(radius) - edge, vec2(0.0)));
+cogl_color_out *= 1.0 - smoothstep(radius - 0.02, radius + 0.02, corner);
+`;
+
+const LumaIconMask = GObject.registerClass(
+class LumaIconMask extends Shell.GLSLEffect {
+    vfunc_build_pipeline() {
+        this.add_glsl_snippet(
+            Cogl.SnippetHook.FRAGMENT,
+            ICON_MASK_DECLARATIONS, ICON_MASK_CODE, false);
+    }
+});
+
