From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <engineering@projectluma.org>
Date: Tue, 3 Nov 2026 14:00:00 -0600
Subject: [PATCH] Luma setup: the first session opens under the setup's cover

Luma's first-boot setup asks everything in GDM's initial-setup session and
signs the person in once, at the end. Their first session's first frame is
the setup's softened wallpaper instead of the desktop, and the cover lifts
off the desktop once the session has started: the setup's last motion, with
the desk choices already applied (luma-setup-first-session, before the Shell).
---
--- a/js/ui/layout.js	2026-11-03 13:09:31
+++ b/js/ui/layout.js	2026-11-03 13:33:22
@@ -787,6 +787,9 @@
 
             await this._updateBackgrounds();
         }
+
+        if (!Main.sessionMode.isGreeter)
+            this._lumaWelcomeCover();
 
         // Hack: Work around grab issue when testing greeter UI in nested
         if (GLib.getenv('GDM_GREETER_TEST') === '1')
@@ -843,6 +846,51 @@
         this._queueUpdateRegions();
 
         this.emit('startup-complete');
+    }
+
+    // A person's first session after Luma's first-boot setup: the session's first
+    // frame is the setup's softened wallpaper, not the desktop, and the cover
+    // lifts off the desktop once the session is up, as the setup's last motion.
+    _lumaWelcomeCover() {
+        if (Main.sessionMode.currentMode !== 'user')
+            return;
+        const pending = GLib.build_filenamev(['/var/lib/luma-setup/welcome', GLib.get_user_name()]);
+        const done = GLib.build_filenamev([GLib.get_user_state_dir(), 'luma-setup', 'welcome-done']);
+        if (!GLib.file_test(pending, GLib.FileTest.EXISTS) || GLib.file_test(done, GLib.FileTest.EXISTS))
+            return;
+
+        const {width, height} = global.stage;
+        const cover = new St.Widget({
+            name: 'lumaWelcomeCover',
+            style: 'background-color: #0b0d14;',
+            reactive: true,
+            width,
+            height,
+        });
+        const background = this._bgManagers[this.primaryIndex]?.backgroundActor;
+        if (background) {
+            const wall = new Clutter.Clone({source: background, width, height});
+            const scale = Math.max(1, Math.min(width / 1600, height / 1000));
+            wall.add_effect(new Shell.BlurEffect({
+                radius: Math.round(34 * scale),
+                brightness: 0.62,
+                mode: Shell.BlurMode.ACTOR,
+            }));
+            cover.add_child(wall);
+        }
+        this.addTopChrome(cover);
+
+        // The setup's choices were applied before the Shell started; once the session
+        // is up, the cover lifts to show the desktop, the setup's last motion.
+        this.connectObject('startup-complete', () => {
+            cover.ease({
+                opacity: 0,
+                delay: 150,
+                duration: 1100,
+                mode: Clutter.AnimationMode.EASE_OUT_QUAD,
+                onComplete: () => cover.destroy(),
+            });
+        }, cover);
     }
 
