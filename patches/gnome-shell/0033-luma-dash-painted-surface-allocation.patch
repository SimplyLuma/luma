From: Project Luma
Subject: [PATCH] Dash: allocate painted layers to actual island bounds

--- a/js/ui/shelf.js
+++ b/js/ui/shelf.js
@@ -140,12 +140,25 @@
     }
 });
 
+// Allocate every painted layer from the island's actual bounds. Natural
+// child sizes are used only for measuring the island's content-driven length.
+const ShelfIslandLayout = GObject.registerClass(
+class ShelfIslandLayout extends Clutter.LayoutManager {
+    vfunc_allocate(container, box) {
+        container._content.allocate(box);
+        for (const actor of [container._stroke, ...container._shadows]) {
+            if (actor.visible)
+                actor.allocate(box);
+        }
+    }
+});
+
 const ShelfIsland = GObject.registerClass(
 class ShelfIsland extends St.Widget {
     _init(styleClass, child) {
         super._init({
             style_class: `luma-shelf-island ${styleClass}`,
-            layout_manager: new Clutter.BinLayout(),
+            layout_manager: new ShelfIslandLayout(),
         });
         // The painted material, stroke and shadows must share the complete
         // island allocation, not the natural height of its clock/buttons.
