     async reload() {
+        if (this.isApplications) {
+            this.name = _('Applications');
+            this.gicon = new Gio.ThemedIcon({name: 'view-app-grid-symbolic'});
+            const apps = Shell.AppSystem.get_default();
+            const items = [];
+            for (const info of apps.get_installed()) {
+                try {
+                    if (!info.should_show() || !this._parentalControls.shouldShowApp(info)) continue;
+                    const app = apps.lookup_app(info.get_id());
