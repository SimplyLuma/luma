+
+/* Application folders use the same drawer, with space for app artwork. */
+.luma-dockf-search { margin: 0 16px 12px; padding: 8px 12px; font-size: 14px; }
+.luma-dockf-search { color: #e7e9e8; background-color: rgba(255,255,255,.08); border-color: rgba(255,255,255,.18); }
+.luma-surface-light .luma-dockf-search { color: #16191d; background-color: rgba(22,25,29,.05); border-color: rgba(22,25,29,.18); }
+.luma-surface-light .luma-dockf-search .hint-text { color: rgba(22,25,29,.56); }
+.luma-dockf-search:focus { border-color: #72a7ed; }
+.luma-dockf-applications .luma-dockf-thumb-large { background-color: transparent; border-width: 0; }
+.luma-dockf-applications .luma-dockf-cell-meta { height: 0; padding: 0; margin: 0; }
+.luma-dockf-empty { padding: 32px 16px; text-align: center; }
