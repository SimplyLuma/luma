+        if (device.direct)
+            parts.push(_('Connects directly'));
+        if (device.latency === 'buffered')
+            parts.push(_('Slight delay'));
+        else if (device.latency === 'high' || device.higherDelay)
+            parts.push(_('Higher delay'));
