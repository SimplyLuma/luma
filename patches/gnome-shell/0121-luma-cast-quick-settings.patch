+// Luma Cast: the device menu, the sharing sheet and the controls while casting.
+//
+// One pane, three faces, drawn from the CastManager model:
+//   devices  — every screen in the room, recent first, as they're found;
+//   sheet    — what to share with the chosen screen, and how; Start;
+//   session  — what is being shared, sound, and Stop.
+// The same pane is the Quick Settings Cast detail and the shelf indicator's
+// menu, so the controls never differ between the two.
+import Atk from 'gi://Atk';
+import Clutter from 'gi://Clutter';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import Graphene from 'gi://Graphene';
+import Pango from 'gi://Pango';
+import Shell from 'gi://Shell';
