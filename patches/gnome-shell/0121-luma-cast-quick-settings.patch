+        const box = new St.BoxLayout({style_class: 'luma-cast-row-box', x_expand: true});
+        box.add_child(chip(kindIcon(device.kind)));
+        const text = new St.BoxLayout({
+            orientation: Clutter.Orientation.VERTICAL,
+            style_class: 'luma-cast-row-text',
+            x_expand: true,
+            y_align: Clutter.ActorAlign.CENTER,
+        });
+        text.add_child(label(device.name, 'luma-cast-row-title'));
+        const detail = DeviceRow.detail(device);
+        if (detail)
+            text.add_child(label(detail, 'luma-cast-row-subtitle'));
+        box.add_child(text);
+        box.add_child(new St.Icon({
+            icon_name: 'luma-cast-go-symbolic',
