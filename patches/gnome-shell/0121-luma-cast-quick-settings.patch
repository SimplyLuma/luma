+            const button = new St.Button({
+                style_class: 'luma-cast-segment',
+                can_focus: true,
+                x_expand: true,
+                accessible_role: Atk.Role.RADIO_BUTTON,
+                accessible_name: `${title}: ${text}`,
+            });
+            button.set_child(label(text, 'luma-cast-segment-label', {x_align: Clutter.ActorAlign.CENTER}));
+            button.connect('clicked', () => {
