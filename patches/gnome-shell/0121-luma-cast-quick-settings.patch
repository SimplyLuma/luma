diff --git a/data/theme/luma-cast.css b/data/theme/luma-cast.css
new file mode 100644
index 0000000..f3b0ced
--- /dev/null
+++ b/data/theme/luma-cast.css
@@ -0,0 +1,745 @@
+/* Luma Cast (ADR-034): Quick Settings detail, shelf indicator and its menu,
+ * app picker and pairing dialog.
+ *
+ * Checked in and loaded by lumaCast.js, the way luma-shelf.css is by the
+ * Shelf. Values are Quick Options' own: Figtree 13/11, island radius 10,
+ * window radius 15, 28/36 controls, 18/16 glyphs, spacing 8/12. Dark is the
+ * base; the light and frost treatments follow the Luma surface classes that
+ * lumaSurfaceMaterials.js puts on each Cast surface.
+ *
+ * Tokens, dark / light:
+ *   ink            #e9ebec / #30343a
+ *   muted          #969da4 / #767b81
+ *   fill           rgba(255,255,255,0.072) / rgba(35,44,52,0.072)
+ *   hover          rgba(255,255,255,0.12)  / rgba(35,44,52,0.115)
+ *   line           rgba(255,255,255,0.075) / rgba(35,39,45,0.09)
+ *   selected       rgba(255,255,255,0.115) + rgba(255,255,255,0.17) line
+ *                / rgba(35,44,52,0.105)   + rgba(35,44,52,0.18) line
+ *   primary        #e6e9eb on #242a30 ink / #31373e on #ffffff ink
+ *   stop           #a64d52 / #b4474d
+ *   sharing amber  #f5c26b / #b7791f
+ */
+
+/* ── The pane ──────────────────────────────────────────────────────────── */
+.luma-cast-pane {
+  font-family: Figtree, sans-serif;
+  color: #e9ebec; }
+.luma-cast-view {
+  spacing: 0; }
+.quick-toggle-menu.luma-quick-detail.luma-cast-detail {
+  padding: 10px; }
+.luma-cast-menu.popup-menu-content {
+  padding: 10px; }
+.luma-cast-indicator .luma-cast-pane {
+  width: 344px; }
+
+/* Header: the tile's own 36 chip, title 13/700 over 11 muted. */
+.luma-cast-header {
+  spacing: 10px;
+  padding: 0 0 10px; }
+.luma-cast-header-compact {
+  min-height: 20px;
+  padding: 2px 6px 4px; }
+.luma-cast-header-chip {
+  width: 36px;
+  height: 36px;
+  border-radius: 10px;
+  background-color: rgba(255, 255, 255, 0.072);
+  color: #e9ebec; }
+.luma-cast-header-chip .luma-cast-chip-icon {
+  icon-size: 18px; }
+.luma-cast-header-title {
+  font-size: 13px;
+  font-weight: 700;
+  color: #e9ebec; }
+.luma-cast-header-subtitle {
+  font-size: 11px;
+  font-weight: 500;
+  padding-top: 1px;
+  color: #969da4; }
+.luma-cast-spinner {
+  width: 16px;
+  height: 16px;
+  color: #969da4; }
+.luma-cast-live-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 99px;
+  background-color: #f5c26b;
+  border: 2px solid #2a2f36; }
+
+.luma-cast-back {
+  width: 28px;
+  height: 28px;
+  min-width: 0;
+  min-height: 0;
+  padding: 0;
+  border-radius: 10px;
+  border: 1px solid rgba(255, 255, 255, 0.075);
+  background-color: rgba(255, 255, 255, 0.072);
+  color: #e9ebec;
+  transition-duration: 100ms; }
+.luma-cast-back StIcon {
+  icon-size: 14px; }
+.luma-cast-back:hover {
+  background-color: rgba(255, 255, 255, 0.12); }
+
+/* Section headings: "Recent", "Nearby", "Share", "Optimize for", "Sound". */
+.luma-cast-heading,
+.luma-cast-field-label {
+  font-size: 11px;
+  font-weight: 650;
+  color: #969da4;
+  padding: 8px 6px 5px; }
+.luma-cast-list > .luma-cast-heading:first-child {
+  padding-top: 2px; }
+.luma-cast-options > .luma-cast-field-label {
+  padding-top: 2px; }
+.luma-cast-field-heading {
+  spacing: 6px; }
+
+.luma-cast-scroll {
+  max-height: 336px; }
+.luma-cast-list,
+.luma-cast-options {
+  spacing: 2px; }
+
+/* Rows: a screen, or something to share. 10 radius, fill on hover only. */
+.luma-cast-device,
+.luma-cast-option {
+  min-height: 0;
+  padding: 5px 8px 5px 5px;
+  border: 1px solid transparent;
+  border-radius: 10px;
+  background-color: transparent;
+  color: #e9ebec;
+  transition-duration: 100ms; }
+.luma-cast-device:hover,
+.luma-cast-option:hover {
+  background-color: rgba(255, 255, 255, 0.07); }
+.luma-cast-device:active,
+.luma-cast-option:active {
+  background-color: rgba(255, 255, 255, 0.12); }
+.luma-cast-option:checked {
+  background-color: rgba(255, 255, 255, 0.115);
+  border-color: rgba(255, 255, 255, 0.17); }
+.luma-cast-option:checked:hover {
+  background-color: rgba(255, 255, 255, 0.14); }
+.luma-cast-row-box {
+  spacing: 10px; }
+.luma-cast-device > .luma-cast-row-box {
+  min-height: 34px; }
+.luma-cast-option > .luma-cast-row-box {
+  min-height: 28px; }
+.luma-cast-row-text {
+  spacing: 1px; }
+
+.luma-cast-chip {
+  width: 32px;
+  height: 32px;
+  border-radius: 9px;
+  background-color: rgba(255, 255, 255, 0.072);
+  color: #e9ebec; }
+.luma-cast-chip .luma-cast-chip-icon {
+  icon-size: 16px; }
+.luma-cast-row-title,
+.luma-cast-option-title {
+  font-size: 13px;
+  font-weight: 650;
+  color: #e9ebec; }
+.luma-cast-row-subtitle {
+  font-size: 11px;
+  font-weight: 500;
+  color: #969da4; }
+.luma-cast-row-go {
+  icon-size: 14px;
+  color: #969da4; }
+
+.luma-cast-option-chip {
+  width: 28px;
+  height: 28px;
+  border-radius: 8px;
+  background-color: rgba(255, 255, 255, 0.072);
+  color: #e9ebec; }
+.luma-cast-option:checked .luma-cast-option-chip {
+  background-color: rgba(255, 255, 255, 0.88);
+  color: #242a30; }
+.luma-cast-option-icon {
+  icon-size: 16px; }
+.luma-cast-option-app-icon {
+  icon-size: 22px; }
+.luma-cast-option:checked .luma-cast-option-chip.luma-cast-option-app {
+  background-color: transparent; }
+.luma-cast-option-check {
+  icon-size: 14px;
+  color: #e9ebec; }
+
+/* Two-way choices: a track holding two segments, the chosen one raised. */
+.luma-cast-field {
+  spacing: 0; }
+.luma-cast-segmented {
+  height: 30px;
+  padding: 2px;
+  spacing: 2px;
+  border: 1px solid rgba(255, 255, 255, 0.075);
+  border-radius: 10px;
+  background-color: rgba(255, 255, 255, 0.072); }
+.luma-cast-segment {
+  min-height: 0;
+  padding: 0 8px;
+  border-radius: 8px;
+  background-color: transparent;
+  color: #969da4;
+  transition-duration: 100ms; }
+.luma-cast-segment:hover {
+  color: #e9ebec;
+  background-color: rgba(255, 255, 255, 0.05); }
+.luma-cast-segment:checked {
+  color: #e9ebec;
+  background-color: rgba(255, 255, 255, 0.15);
+  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.28); }
+.luma-cast-segment-label {
+  font-size: 12px;
+  font-weight: 650; }
+
+/* Start and Stop: full-width, 36 tall, the panel's strongest control. */
+.luma-cast-primary,
+.luma-cast-stop,
+.luma-cast-secondary {
+  height: 36px;
+  min-height: 0;
+  padding: 0 14px;
+  margin-top: 12px;
+  border-radius: 10px;
+  font-size: 13px;
+  font-weight: 700;
+  transition-duration: 100ms; }
+.luma-cast-primary {
+  background-color: #e6e9eb;
+  color: #242a30; }
+.luma-cast-primary:hover {
+  background-color: #ffffff; }
+.luma-cast-primary:active {
+  background-color: #cfd3d7; }
+.luma-cast-stop {
+  background-color: #a64d52;
+  color: #ffffff; }
+.luma-cast-stop:hover {
+  background-color: #b5575c; }
+.luma-cast-stop:active {
+  background-color: #934247; }
+.luma-cast-secondary {
+  border: 1px solid rgba(255, 255, 255, 0.075);
+  background-color: rgba(255, 255, 255, 0.072);
+  color: #e9ebec; }
+.luma-cast-secondary:hover {
+  background-color: rgba(255, 255, 255, 0.12); }
+.luma-cast-button-box {
+  spacing: 7px; }
+.luma-cast-button-icon {
+  icon-size: 14px; }
+
+/* Focus: a 2px ring. Inside for translucent controls (St fills an outer
+ * shadow under a transparent background); outside for the solid buttons. */
+.luma-cast-pane StButton:focus,
+.luma-cast-dialog StButton:focus {
+  box-shadow: inset 0 0 0 2px #e6e9eb; }
+.luma-cast-pane .luma-cast-primary:focus,
+.luma-cast-pane .luma-cast-stop:focus,
+.luma-cast-dialog .modal-dialog-button:default:focus {
+  box-shadow: 0 0 0 2px #e6e9eb; }
+
+/* Searching and empty: centred, quiet, and it says what to do. */
+.luma-cast-placeholder {
+  padding: 14px 18px 6px;
+  spacing: 4px; }
+.luma-cast-beacon {
+  width: 56px;
+  height: 56px;
+  margin-bottom: 6px; }
+.luma-cast-beacon-ring {
+  border-radius: 99px;
+  background-color: rgba(255, 255, 255, 0.06);
+  border: 1px solid rgba(255, 255, 255, 0.08); }
+.luma-cast-placeholder-chip {
+  width: 44px;
+  height: 44px;
+  border-radius: 12px;
+  background-color: rgba(255, 255, 255, 0.072);
+  border: 1px solid rgba(255, 255, 255, 0.075);
+  color: #e9ebec; }
+.luma-cast-placeholder-chip .luma-cast-chip-icon {
+  icon-size: 20px; }
+.luma-cast-placeholder-chip-quiet {
+  color: #969da4;
+  margin-bottom: 6px; }
+.luma-cast-placeholder-title {
+  font-size: 13px;
+  font-weight: 700;
+  color: #e9ebec; }
+.luma-cast-placeholder-body {
+  font-size: 11px;
+  font-weight: 500;
+  color: #969da4;
+  text-align: center; }
+.luma-cast-search-again {
+  height: 30px;
+  margin-top: 10px;
+  padding: 0 12px;
+  font-size: 12px; }
+
+/* Footer: Cast Settings, under a rule, the way every detail ends. */
+.luma-cast-footer {
+  margin-top: 10px;
+  padding-top: 6px;
+  border-top: 1px solid rgba(255, 255, 255, 0.075); }
+.luma-cast-footer-button {
+  min-height: 0;
+  height: 32px;
+  padding: 0 11px;
+  border-radius: 10px;
+  font-size: 13px;
+  font-weight: 600;
+  color: #e9ebec;
+  background-color: transparent; }
+.luma-cast-footer-button:hover {
+  background-color: rgba(255, 255, 255, 0.07); }
+.luma-cast-footer-icon {
+  icon-size: 16px;
+  color: #969da4; }
+
+/* While casting: what's private, said once, quietly. */
+.luma-cast-note {
+  spacing: 8px;
+  padding: 10px 6px 0; }
+.luma-cast-note-icon {
+  icon-size: 14px;
+  color: #969da4; }
+.luma-cast-note-label {
+  font-size: 11px;
+  font-weight: 500;
