+// Luma Cast: choosing one app, and pairing with a screen.
+//
+// Both are Shell modal dialogs in the Luma window material. The app picker
+// shows every app window as a live thumbnail, drawn the way the Grid and the
+// dock previews draw windows, so "One app…" chooses from what the person
+// already recognises.
+import Atk from 'gi://Atk';
+import Clutter from 'gi://Clutter';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import Meta from 'gi://Meta';
+import Pango from 'gi://Pango';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import * as Animation from './animation.js';
+import * as ModalDialog from './modalDialog.js';
+import * as SurfaceMaterials from './lumaSurfaceMaterials.js';
+import {RoundedPreview} from './lumaGrid.js';
+import {getCast, kindIcon, reduceMotion} from './lumaCast.js';
+
+const THUMB_WIDTH = 216;
+const THUMB_HEIGHT = 136;
+const THUMB_RADIUS = 8;
+const COLUMNS = 3;
+
+function scaleFactor() {
+    return St.ThemeContext.get_for_stage(global.stage).scale_factor;
+}
+
+function bindMaterial(dialog) {
+    // Treatment classes only; a modal dialog sits over a lightbox, not the
+    // wallpaper, so it takes no compositor backdrop.
+    SurfaceMaterials.bindSurface(dialog.dialogLayout._dialog, {backdrop: false, enabled: false});
+}
+
+// The windows a person would call "an app": normal, on this session's
+// workspaces, not skip-taskbar, most recently used first. One card per app.
+function appWindows() {
+    const tracker = Shell.WindowTracker.get_default();
+    const seen = new Map();
+    const windows = global.display.get_tab_list(Meta.TabList.NORMAL_ALL, null);
+    for (const window of windows) {
+        if (window.skip_taskbar || !window.get_compositor_private())
+            continue;
+        const app = tracker.get_window_app(window);
+        if (!app || seen.has(app.get_id()))
+            continue;
+        seen.set(app.get_id(), {app, window});
+    }
+    return [...seen.values()];
+}
+
+const WindowCard = GObject.registerClass(
+class WindowCard extends St.Button {
+    constructor({app, window}) {
+        super({
+            style_class: 'luma-cast-window',
+            can_focus: true,
+            reactive: true,
+            accessible_role: Atk.Role.RADIO_BUTTON,
+            accessible_name: window.title && window.title !== app.get_name()
+                ? `${app.get_name()}, ${window.title}` : app.get_name(),
+        });
+        this.app = app;
+        this.window = window;
+        const box = new St.BoxLayout({orientation: Clutter.Orientation.VERTICAL, style_class: 'luma-cast-window-box'});
+        const header = new St.BoxLayout({style_class: 'luma-cast-window-header'});
+        const icon = app.create_icon_texture(16);
+        icon.y_align = Clutter.ActorAlign.CENTER;
+        header.add_child(icon);
+        const title = new St.Label({
+            text: app.get_name(),
+            style_class: 'luma-cast-window-title',
+            x_expand: true,
+            y_align: Clutter.ActorAlign.CENTER,
+        });
+        title.clutter_text.ellipsize = Pango.EllipsizeMode.END;
+        header.add_child(title);
+        box.add_child(header);
+
+        this._thumb = new St.Widget({
+            style_class: 'luma-cast-window-thumb',
+        });
+        this._body = new Clutter.Actor({layout_manager: new Shell.WindowPreviewLayout()});
+        this._body.layout_manager.add_window(window);
+        window.foreach_transient(transient => {
+            if (transient.is_attached_dialog() && transient.get_compositor_private())
+                this._body.layout_manager.add_window(transient);
+            return true;
+        });
+        this._rounded = new RoundedPreview();
+        this._body.add_effect(this._rounded);
+        this._thumb.add_child(this._body);
+        this._thumb.connect('notify::allocation', () => this._placeBody());
+        this._body.layout_manager.connectObject('notify::bounding-box', () => this._placeBody(), this);
+        box.add_child(this._thumb);
+        this.set_child(box);
+        this._syncSize();
+    }
+
+    _syncSize() {
+        const scale = scaleFactor();
+        this._thumb.set_size(THUMB_WIDTH * scale, THUMB_HEIGHT * scale);
+    }
+
+    // Fit the window inside the thumbnail, centred, rounded at 8 on screen.
+    _placeBody() {
+        const bounds = this._body.layout_manager.bounding_box;
+        const width = Math.max(1, bounds.get_width());
+        const height = Math.max(1, bounds.get_height());
+        const scale = scaleFactor();
+        const fit = Math.min(THUMB_WIDTH * scale / width, THUMB_HEIGHT * scale / height);
+        this._body.set_size(width, height);
+        this._body.set_scale(fit, fit);
+        this._body.set_position(
+            Math.round((THUMB_WIDTH * scale - width * fit) / 2),
+            Math.round((THUMB_HEIGHT * scale - height * fit) / 2));
+        this._rounded.setShape(width, height, THUMB_RADIUS * scale / fit);
+    }
+
+    setSelected(selected) {
+        this.checked = selected;
+        if (selected)
+            this.add_accessible_state(Atk.StateType.CHECKED);
+        else
+            this.remove_accessible_state(Atk.StateType.CHECKED);
+    }
+});
+
+export const AppPickerDialog = GObject.registerClass({
+    Signals: {'picked': {param_types: [GObject.TYPE_STRING]}},
+}, class AppPickerDialog extends ModalDialog.ModalDialog {
+    constructor({deviceName, selectedAppId = null, actionLabel = _('Start Casting')}) {
+        super({styleClass: 'luma-cast-dialog luma-cast-app-picker', destroyOnClose: true});
+        bindMaterial(this);
+
+        const heading = new St.BoxLayout({
+            orientation: Clutter.Orientation.VERTICAL,
+            style_class: 'luma-cast-dialog-heading',
+        });
+        const title = new St.Label({text: _('Choose an app to share'), style_class: 'luma-cast-dialog-title'});
+        heading.add_child(title);
+        const body = new St.Label({
+            text: deviceName
+                ? _('Only this app appears on %s. Everything else on your screen stays private.').format(deviceName)
+                : _('Only this app appears on the screen. Everything else stays private.'),
+            style_class: 'luma-cast-dialog-body',
+        });
+        body.clutter_text.line_wrap = true;
+        heading.add_child(body);
+        this.contentLayout.add_child(heading);
+
+        const entries = appWindows();
+        this._cards = [];
+        const layout = new Clutter.GridLayout({orientation: Clutter.Orientation.HORIZONTAL});
+        const grid = new St.Widget({
+            style_class: 'luma-cast-window-grid',
+            layout_manager: layout,
+            x_align: Clutter.ActorAlign.CENTER,
+            accessible_role: Atk.Role.LIST,
+            accessible_name: _('Apps'),
+        });
+        layout.hookup_style(grid);
+        entries.forEach((entry, i) => {
+            const card = new WindowCard(entry);
+            card.connect('clicked', () => this._select(card));
+            card.connect('key-focus-in', () => this._select(card));
+            const click = new Clutter.ClickGesture({n_clicks_required: 2});
+            click.connect('recognize', () => this._confirm());
+            card.add_action(click);
+            layout.attach(card, i % COLUMNS, Math.floor(i / COLUMNS), 1, 1);
+            this._cards.push(card);
+        });
+
+        if (entries.length) {
+            const scrollable = new St.BoxLayout({orientation: Clutter.Orientation.VERTICAL});
+            scrollable.add_child(grid);
+            const scroll = new St.ScrollView({
+                style_class: 'luma-cast-window-scroll',
+                hscrollbar_policy: St.PolicyType.NEVER,
+                vscrollbar_policy: St.PolicyType.AUTOMATIC,
+                overlay_scrollbars: true,
+                child: scrollable,
+            });
+            this.contentLayout.add_child(scroll);
+        } else {
+            const empty = new St.BoxLayout({orientation: Clutter.Orientation.VERTICAL, style_class: 'luma-cast-placeholder'});
+            empty.add_child(new St.Bin({
+                style_class: 'luma-cast-placeholder-chip luma-cast-placeholder-chip-quiet',
+                x_align: Clutter.ActorAlign.CENTER,
+                child: new St.Icon({icon_name: 'luma-cast-app-symbolic', style_class: 'luma-cast-chip-icon'}),
+            }));
+            empty.add_child(new St.Label({text: _('No apps are open'), style_class: 'luma-cast-placeholder-title',
+                x_align: Clutter.ActorAlign.CENTER}));
+            empty.add_child(new St.Label({text: _('Open the app you want to share, then choose One app again.'),
+                style_class: 'luma-cast-placeholder-body', x_align: Clutter.ActorAlign.CENTER}));
+            this.contentLayout.add_child(empty);
+        }
+
+        this.addButton({label: _('Cancel'), action: () => this.close(), key: Clutter.KEY_Escape});
+        this._action = this.addButton({label: actionLabel, action: () => this._confirm(), default: true});
+
+        const initial = this._cards.find(c => c.app.get_id() === selectedAppId) ?? this._cards[0] ?? null;
+        this._select(initial);
+        if (initial)
+            this.setInitialKeyFocus(initial);
+    }
+
+    _select(card) {
+        this._selected = card;
+        for (const c of this._cards)
+            c.setSelected(c === card);
+        this._action.reactive = Boolean(card);
+        this._action.can_focus = Boolean(card);
+    }
+
+    _confirm() {
+        if (!this._selected)
+            return;
+        const appId = this._selected.app.get_id();
+        // Emit first: closing disposes the dialog, and a signal on a disposed
+        // object never reaches the sheet.
+        this.emit('picked', appId);
+        this.close();
+    }
+});
+
+/**
+ * The pairing prompt. Modes follow CodeRequested:
+ *   enter   — "Enter the code shown on <device>", digits typed here;
+ *   show    — "Enter this code on <device>", digits shown here;
+ *   confirm — "Accept on <device>", nothing to type.
+ */
+export const CodeDialog = GObject.registerClass(
+class CodeDialog extends ModalDialog.ModalDialog {
+    constructor({mode, code = '', digits = 4, deviceName, deviceKind, rejected = false}) {
+        super({styleClass: 'luma-cast-dialog luma-cast-code-dialog', destroyOnClose: true});
+        bindMaterial(this);
+        this._cast = getCast();
+        this._mode = mode;
+        this._digits = Math.max(1, digits || code.length || 4);
+
+        const box = new St.BoxLayout({orientation: Clutter.Orientation.VERTICAL, style_class: 'luma-cast-code-box'});
+        box.add_child(new St.Bin({
+            style_class: 'luma-cast-code-chip',
+            x_align: Clutter.ActorAlign.CENTER,
+            child: new St.Icon({icon_name: kindIcon(deviceKind), style_class: 'luma-cast-chip-icon'}),
+        }));
+        const titles = {
+            enter: _('Enter the code shown on %s'),
+            show: _('Enter this code on %s'),
+            confirm: _('Accept on %s'),
+        };
+        const bodies = {
+            enter: _('The screen is showing a code to make sure you’re casting to the right place.'),
+            show: _('Type these numbers using the screen’s remote.'),
+            confirm: _('Choose Allow on the screen to start casting.'),
+        };
+        this._title = new St.Label({
+            text: (titles[mode] ?? titles.enter).format(deviceName),
+            style_class: 'luma-cast-dialog-title luma-cast-code-title',
+            x_align: Clutter.ActorAlign.CENTER,
+        });
+        this._title.clutter_text.line_wrap = true;
+        this._title.clutter_text.line_alignment = Pango.Alignment.CENTER;
+        box.add_child(this._title);
+        const body = new St.Label({
+            text: bodies[mode] ?? bodies.enter,
+            style_class: 'luma-cast-dialog-body luma-cast-code-body',
+            x_align: Clutter.ActorAlign.CENTER,
+        });
+        body.clutter_text.line_wrap = true;
+        body.clutter_text.line_alignment = Pango.Alignment.CENTER;
+        box.add_child(body);
+
+        if (mode !== 'confirm') {
+            this._cells = new St.BoxLayout({style_class: 'luma-cast-code-cells', x_align: Clutter.ActorAlign.CENTER});
+            this._cellLabels = [];
+            for (let i = 0; i < this._digits; i++) {
+                const cell = new St.Bin({style_class: 'luma-cast-code-cell'});
+                const digit = new St.Label({style_class: 'luma-cast-code-digit',
+                    x_align: Clutter.ActorAlign.CENTER, y_align: Clutter.ActorAlign.CENTER});
+                cell.child = digit;
+                this._cells.add_child(cell);
+                this._cellLabels.push({cell, digit});
+            }
+            box.add_child(this._cells);
+        }
+
+        if (mode === 'enter') {
+            // One real entry takes the input, so paste, IME and the screen
+            // reader all work; the cells only draw it.
+            this._entry = new St.Entry({
+                style_class: 'luma-cast-code-entry',
+                can_focus: true,
+                x_expand: true,
+                input_purpose: Clutter.InputContentPurpose.DIGITS,
+            });
+            this._entry.clutter_text.max_length = this._digits;
+            this._entry.accessible_name = this._title.text;
+            this._entry.clutter_text.connect('text-changed', () => this._syncCells());
+            this._entry.clutter_text.connect('activate', () => this._submit());
+            this._entry.connect('key-focus-in', () => this._syncCells());
+            this._entry.opacity = 0;
+            box.add_child(this._entry);
+            this._cells.reactive = true;
+            this._cells.connect('button-press-event', () => {
+                this._entry.grab_key_focus();
+                return Clutter.EVENT_STOP;
+            });
+            this.setInitialKeyFocus(this._entry);
+        } else if (mode === 'show') {
+            [...code].slice(0, this._digits).forEach((ch, i) => (this._cellLabels[i].digit.text = ch));
+            this._cells.accessible_name = [...code].join(' ');
+        }
+
+        if (mode !== 'enter') {
+            const waiting = new St.BoxLayout({style_class: 'luma-cast-code-waiting', x_align: Clutter.ActorAlign.CENTER});
+            const spinner = new Animation.Spinner(16, {animate: true});
+            waiting.add_child(spinner);
+            waiting.add_child(new St.Label({text: _('Waiting for %s…').format(deviceName),
+                y_align: Clutter.ActorAlign.CENTER}));
+            spinner.play();
+            box.add_child(waiting);
+        }
+
+        this._error = new St.Label({
+            text: _('That code didn’t match. Try again.'),
+            style_class: 'luma-cast-code-error',
+            x_align: Clutter.ActorAlign.CENTER,
+            opacity: rejected ? 255 : 0,
+            accessible_role: Atk.Role.ALERT,
+        });
+        box.add_child(this._error);
+        this.contentLayout.add_child(box);
+
+        this.addButton({
+            label: _('Cancel'),
+            action: () => {
+                this._cancelled = true;
+                this._cast.cancelPairing();
+                this.close();
+            },
+            key: Clutter.KEY_Escape,
+        });
+        if (mode === 'enter')
+            this._connect = this.addButton({label: _('Connect'), action: () => this._submit(), default: true});
+
+        // The prompt belongs to its session: it goes when pairing is over.
+        this._sawPairing = this._cast.session?.state === 'pairing';
+        this._cast.connectObject('session-changed', () => {
+            const state = this._cast.session?.state;
+            if (state === 'pairing')
+                this._sawPairing = true;
+            else if (!state || state === 'ended' || this._sawPairing)
+                this.close();
+        }, this);
+        this.connect('destroy', () => this._cast.disconnectObject(this));
+        this._syncCells();
+        if (rejected)
+            this._shake();
+    }
+
+    _syncCells() {
+        if (this._mode !== 'enter')
+            return;
+        const text = this._entry.text.replace(/\D/g, '');
+        if (text !== this._entry.text)
+            this._entry.text = text;
+        this._cellLabels.forEach(({cell, digit}, i) => {
+            digit.text = text[i] ?? '';
+            const active = this._entry.has_key_focus() && i === Math.min(text.length, this._digits - 1);
+            if (active)
+                cell.add_style_pseudo_class('focus');
+            else
+                cell.remove_style_pseudo_class('focus');
+        });
+        const complete = text.length === this._digits;
+        this._connect.reactive = complete;
+        this._connect.can_focus = complete;
+        if (text.length)
+            this._error.opacity = 0;
+    }
+
+    _submit() {
+        const text = this._entry?.text ?? '';
+        if (text.length !== this._digits)
+            return;
+        this._cast.submitCode(text).catch(e => logError(e, 'Luma Cast: SubmitCode'));
+        this._connect.reactive = false;
+        this._entry.clutter_text.editable = false;
+    }
+
+    // A wrong code: the service asks again. Clear, say so, and nudge.
+    reject() {
+        this._entry.clutter_text.editable = true;
+        this._entry.text = '';
+        this._error.opacity = 255;
+        this._entry.grab_key_focus();
+        this._shake();
+    }
+
+    _shake() {
+        if (reduceMotion() || !this._cells)
+            return;
+        const cells = this._cells;
+        cells.remove_transition('translation-x');
