+// Luma Cast: the Shell's side of ADR-034.
+//
+// One client for the org.projectluma.Cast1 session service. The Quick
+// Settings tile, the shelf indicator, the app picker and the pairing dialog
+// all read this model; none of them talks to D-Bus on its own. The service
+// owns discovery, protocols, capture and encoding. The Shell owns what people
+// see, and the privacy rules that only the Shell can enforce: no notification
+// banner on a monitor whose pixels reach a receiver, notifications silenced
+// while casting, and a privacy curtain while a password prompt is up.
+import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import Meta from 'gi://Meta';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import * as Main from './main.js';
+import * as Signals from '../misc/signals.js';
+
+const BUS_NAME = 'org.projectluma.Cast1';
+const MANAGER_PATH = '/org/projectluma/Cast1';
