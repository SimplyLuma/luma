+
+export function sourceSummary(choices, device = null) {
+    const cast = getCast();
+    switch (choices.source) {
+    case Source.EXTEND:
+        return _('Separate screen');
+    case Source.DISPLAY:
+        return cast.displays.find(d => d.connector === choices.connector)?.name ?? _('One display');
+    case Source.APP:
+        return cast.runningApp(choices.appId)?.get_name() ?? _('One app');
+    default:
+        return device ? _('Entire screen') : _('Entire screen');
+    }
+}
+
+/** A screen in the device menu. */
+const DeviceRow = GObject.registerClass(
+class DeviceRow extends St.Button {
