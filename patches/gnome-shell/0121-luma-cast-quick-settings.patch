+                .sort((a, b) => Number(b.builtin) - Number(a.builtin) || a.index - b.index);
+            // Two identical monitors get numbers, the way Displays shows them.
+            const counts = new Map();
+            for (const d of this.displays)
+                counts.set(d.name, (counts.get(d.name) ?? 0) + 1);
+            const seen = new Map();
+            for (const d of this.displays) {
+                if (counts.get(d.name) > 1) {
+                    seen.set(d.name, (seen.get(d.name) ?? 0) + 1);
+                    d.name = `${d.name} ${seen.get(d.name)}`;
+                }
+            }
+        } catch (e) {
+            // A session without DisplayConfig can't name its monitors; one
+            // entry per monitor is the honest fallback.
+            logError(e, 'Luma Cast: reading displays');
+            this.displays = Main.layoutManager.monitors.map((m, index) => ({
+                connector: `monitor-${index}`, builtin: index === Main.layoutManager.primaryIndex,
+                name: index === Main.layoutManager.primaryIndex ? _('Built-in display') : _('Display %d').format(index + 1),
+                index,
+            }));
+        }
+        this.emit('displays-changed');
+        this._syncPrivacy();
+    }
+
+    // The privacy model. A monitor is captured when its pixels reach the
+    // receiver: mirroring it, or the virtual monitor that extends onto it.
+    isMonitorCaptured(index) {
+        if (!this.casting || index < 0)
+            return false;
+        const manager = global.backend.get_monitor_manager();
+        return (this.session.capturedConnectors ?? [])
+            .some(connector => manager.get_monitor_for_connector(connector) === index);
+    }
+
+    // Where a notification banner may be placed: the preferred monitor if it
+    // isn't captured, else another that isn't. When every monitor is
+    // captured the preferred one is returned, and the tray's captured rule
+    // keeps every banner off it.
+    bannerMonitor(preferred) {
+        if (!this.isMonitorCaptured(preferred))
+            return preferred;
+        const monitors = Main.layoutManager.monitors;
+        const primary = Main.layoutManager.primaryIndex;
+        const order = [primary, ...monitors.map((_m, i) => i).filter(i => i !== primary)];
+        return order.find(i => !this.isMonitorCaptured(i)) ?? preferred;
+    }
+
+    // Silenced: ordinary notifications are collected quietly, as they are
+    // under a full-screen presentation, and never replayed afterwards.
+    get silencing() {
+        return this.casting && this.silenceNotifications;
+    }
+
+    _syncPrivacy() {
+        const key = JSON.stringify([this.silencing,
+            this.casting ? this.session.capturedConnectors ?? [] : []]);
+        if (this._privacyKey === key)
+            return;
+        this._privacyKey = key;
+        Main.messageTray?.castPrivacyChanged?.();
+        this.emit('privacy-changed');
+    }
+
+    // A Shell password prompt over a captured screen raises the service's
+    // privacy curtain first. system-modal-opened fires inside pushModal,
+    // before the dialog is shown; its painting is held until the service
+    // replies that the curtain is in the compositor, so no frame carrying
+    // the prompt can be captured. A service that doesn't answer in time
+    // has its cast stopped rather than the prompt withheld.
+    _onSystemModalOpened() {
+        if (!this.casting || !(this.session.capturedConnectors ?? []).length || !this.session.path)
+            return;
+        const top = Main.modalActorFocusStack.at(-1)?.actor;
+        if (!top || this._curtains.has(top) || !containsSecretEntry(top))
+            return;
+        this._raiseCurtain(top);
+    }
+
+    // The reason is journal-only; the service documents these four.
+    _curtainReason(dialog) {
+        const name = dialog.constructor?.name ?? '';
+        if (name.includes('Authentication'))
+            return 'polkit';
+        if (name.includes('Keyring'))
+            return 'keyring';
+        if (name.includes('NetworkSecret'))
+            return 'network-secrets';
+        return 'unlock';
+    }
+
+    _raiseCurtain(dialog) {
+        const path = this.session.path;
+        const reason = this._curtainReason(dialog);
+        const hold = new PaintHold();
+        dialog.add_effect_with_name('luma-cast-curtain-hold', hold);
+        const entry = {path, released: false};
+        this._curtains.set(dialog, entry);
+        const release = () => {
+            if (dialog.get_effect('luma-cast-curtain-hold'))
+                dialog.remove_effect(hold);
+        };
+        const timeout = GLib.timeout_add(GLib.PRIORITY_DEFAULT, CURTAIN_TIMEOUT_MS, () => {
+            console.warn('Luma Cast: no privacy curtain in time; stopping the cast');
+            this.stop();
+            release();
+            return GLib.SOURCE_REMOVE;
+        });
+        this._call(path, SESSION_IFACE, 'SetPrivacyCurtain',
+            new GLib.Variant('(bs)', [true, reason]))
+            .then(() => {
+                GLib.source_remove(timeout);
+                release();
+            })
+            .catch(e => {
+                logError(e, 'Luma Cast: SetPrivacyCurtain');
+                GLib.source_remove(timeout);
+                this.stop();
+                release();
+            });
+        const lower = () => {
+            if (entry.released)
+                return;
+            entry.released = true;
+            dialog.disconnectObject(this);
+            this._curtains.delete(dialog);
+            this._call(entry.path, SESSION_IFACE, 'SetPrivacyCurtain',
+                new GLib.Variant('(bs)', [false, reason])).catch(() => {});
+            this.emit('curtain-changed');
+        };
+        dialog.connectObject('closed', lower, 'destroy', lower, this);
+        this.emit('curtain-changed');
+    }
+
+    get curtainActive() {
+        return this._curtains.size > 0;
+    }
+
+    openSettings() {
+        const app = Shell.AppSystem.get_default().lookup_app('gnome-display-panel.desktop');
+        if (app) {
+            Main.overview.hide();
+            Main.panel.closeQuickSettings();
+            // The Displays panel opens straight onto its Cast page.
+            Shell.util_spawn_async(null, ['gnome-control-center', 'display', 'cast'], null, GLib.SpawnFlags.SEARCH_PATH);
+        }
+    }
+
+    destroy() {
+        this.releaseDiscovery();
+        this._bus.unwatch_name(this._watchId);
+        Main.layoutManager.disconnectObject(this);
+    }
+}
+
+let _manager = null;
+
+/** @returns {CastManager} */
+export function getCast() {
+    _manager ??= new CastManager();
+    return _manager;
+}
+
+/** Null until something in the session has asked for Cast. */
+export function peekCast() {
+    return _manager;
+}
+
+export function reduceMotion() {
+    return !St.Settings.get().enable_animations;
+}
+
+// Seconds for Meta window ids exposed to the service.
+export function windowId(window) {
+    return window instanceof Meta.Window ? window.get_id() : 0;
+}
