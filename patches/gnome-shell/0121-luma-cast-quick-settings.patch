+                repeatCount: -1,
+                autoReverse: true,
+            });
+        }
+        return block;
+    }
+
+    _emptyBlock() {
+        const block = new St.BoxLayout({
+            orientation: Clutter.Orientation.VERTICAL,
+            style_class: 'luma-cast-placeholder',
+            x_expand: true,
+        });
+        const quiet = chip('luma-cast-tv-symbolic', 'luma-cast-placeholder-chip luma-cast-placeholder-chip-quiet');
+        quiet.x_align = Clutter.ActorAlign.CENTER;
+        block.add_child(quiet);
+        block.add_child(label(_('No screens found'), 'luma-cast-placeholder-title', {x_align: Clutter.ActorAlign.CENTER}));
+        const help = [_('Make sure the TV or display is on and connected to the same network as this computer.')];
+        if (!this._cast.allowWifiDirect)
+            help.push(_('Screens that connect directly are turned off in Settings.'));
+        else if (!this._cast.wifiDirectAvailable)
+            help.push(_('Screens that connect directly need Wi-Fi to be on.'));
+        block.add_child(wrapLabel(help.join(' '), 'luma-cast-placeholder-body', {x_align: Clutter.ActorAlign.CENTER}));
+        const again = new St.Button({
+            style_class: 'luma-cast-secondary luma-cast-search-again',
+            can_focus: true,
+            x_align: Clutter.ActorAlign.CENTER,
+            child: (() => {
+                const b = new St.BoxLayout({style_class: 'luma-cast-button-box'});
+                b.add_child(new St.Icon({icon_name: 'luma-cast-refresh-symbolic', style_class: 'luma-cast-button-icon'}));
+                b.add_child(new St.Label({text: _('Search Again'), y_align: Clutter.ActorAlign.CENTER}));
+                return b;
+            })(),
+        });
+        again.connect('clicked', () => {
+            this._cast.restartDiscovery();
+            this._armSearchTimer();
+            this._render(true);
+        });
+        block.add_child(again);
+        return block;
+    }
+
+    _footer() {
+        const footer = new St.BoxLayout({style_class: 'luma-cast-footer', x_expand: true});
+        const settings = new St.Button({
+            style_class: 'luma-cast-footer-button',
+            can_focus: true,
+            x_expand: true,
+            x_align: Clutter.ActorAlign.FILL,
+            child: (() => {
+                const b = new St.BoxLayout({style_class: 'luma-cast-row-box', x_expand: true});
+                b.add_child(new St.Icon({icon_name: 'luma-cast-settings-symbolic', style_class: 'luma-cast-footer-icon'}));
+                b.add_child(new St.Label({text: _('Cast Settings'), y_align: Clutter.ActorAlign.CENTER}));
+                return b;
+            })(),
+        });
+        settings.connect('clicked', () => {
+            this._requestClose();
+            this._cast.openSettings();
+        });
+        footer.add_child(settings);
+        return footer;
+    }
+
+    // ── sheet ───────────────────────────────────────────────────────────
+    _choose(device) {
+        this._device = device;
+        this._choices = this._cast.choicesFor(device);
+        this._render(true);
+    }
+
+    _back() {
+        this._device = null;
+        this._choices = null;
+        this._render(true);
+    }
+
+    _shareOptions(device, choices, onPick) {
+        const cast = this._cast;
+        const box = new St.BoxLayout({
+            orientation: Clutter.Orientation.VERTICAL,
+            style_class: 'luma-cast-options',
+            x_expand: true,
+            accessible_role: Atk.Role.PANEL,
+        });
+        const heading = label(_('Share'), 'luma-cast-field-label');
+        box.add_child(heading);
+        const rows = [];
+        const can = source => !device || device.capabilities.has(source);
+        const add = (key, params, apply) => {
+            const row = new OptionRow(params);
+            row._key = key;
+            row.connect('clicked', () => onPick(apply()));
+            rows.push(row);
+            box.add_child(row);
+            return row;
+        };
+        if (cast.displays.length > 1) {
+            // Several monitors: each is its own thing to share, so "entire
+            // screen" is never ambiguous.
+            for (const display of cast.displays) {
+                if (!can(Source.DISPLAY) && !can(Source.SCREEN))
+                    break;
+                add(`display:${display.connector}`, {
+                    iconName: display.builtin ? 'luma-cast-laptop-symbolic' : 'luma-cast-screen-symbolic',
+                    title: display.name,
+                    subtitle: _('Mirror this display'),
+                }, () => ({source: Source.DISPLAY, connector: display.connector}));
+            }
+        } else if (can(Source.SCREEN)) {
+            add('screen', {iconName: 'luma-cast-screen-symbolic', title: _('Entire screen')},
+                () => ({source: Source.SCREEN, connector: null}));
+        }
+        if (can(Source.EXTEND)) {
+            add('extend', {iconName: 'luma-cast-extend-symbolic', title: _('Use as a separate screen')},
+                () => ({source: Source.EXTEND}));
+        }
+        if (can(Source.APP)) {
+            const appRow = add('app', {iconName: 'luma-cast-app-symbolic', title: _('One app…')},
+                () => ({source: Source.APP, pick: true}));
+            appRow._isApp = true;
+        }
+        box._rows = rows;
+        box._heading = heading;
+        return box;
+    }
+
+    _syncOptions(box, choices) {
+        const key = choices.source === Source.DISPLAY ? `display:${choices.connector}` : choices.source;
+        for (const row of box._rows) {
+            row.setSelected(row._key === key);
+            if (row._isApp) {
+                const app = choices.source === Source.APP ? this._cast.runningApp(choices.appId) : null;
+                if (app) {
+                    row.setIcon(null, app.get_icon());
+                    row.setText(app.get_name(), _('One app · Change…'));
+                } else {
+                    row.setIcon('luma-cast-app-symbolic');
+                    row.setText(_('One app…'));
+                }
+            }
+        }
+    }
+
+    _buildSheet(content) {
+        const device = this._device;
+        const choices = this._choices ??= this._cast.choicesFor(device);
+        const detail = DeviceRow.detail(device);
+        content.add_child(this._header({
+            iconName: kindIcon(device.kind),
+            title: device.name,
+            subtitle: detail,
+            back: true,
+        }));
+
+        const options = this._shareOptions(device, choices, pick => {
+            if (pick.pick) {
+                this._pickApp(device, choices);
+                return;
+            }
+            Object.assign(choices, pick);
+            this._syncSheet();
+        });
+        content.add_child(options);
+
+        const optimize = new Segmented(_('Optimize for'), {
+            iconName: null,
+            items: [
+                {value: 'receiver', text: receiverNoun(device.kind)},
+                {value: 'local', text: _('This computer')},
+            ],
+        });
+        optimize.connect('changed', (_s, value) => (choices.optimize = value));
+        content.add_child(optimize);
+
+        let sound = null;
+        if (device.capabilities.has('audio')) {
+            sound = new Segmented(_('Sound'), {
+                iconName: null,
+                items: [
+                    {value: 'receiver', text: receiverNoun(device.kind)},
+                    {value: 'local', text: _('This computer')},
+                ],
+            });
+            sound.connect('changed', (_s, value) => (choices.audio = value));
+            content.add_child(sound);
+        }
+
+        const start = primaryButton(_('Start'));
+        start.accessible_name = _('Start casting to %s').format(device.name);
+        start.connect('clicked', () => {
+            if (choices.source === Source.APP && !this._cast.runningApp(choices.appId)) {
+                this._pickApp(device, choices);
+                return;
+            }
+            // The menu steps aside; the shelf shows the connection from here.
+            this._requestClose();
+            this._cast.connectDevice(device, {...choices});
+        });
+        content.add_child(start);
+
+        this._sheet = {options, optimize, sound, start, choices};
+        this._syncSheet();
+    }
+
+    _syncSheet() {
+        const {options, optimize, sound, start, choices} = this._sheet ?? {};
+        if (!options)
+            return;
+        this._syncOptions(options, choices);
+        optimize.value = choices.optimize;
+        // Optimizing is a mirroring choice; nothing to optimize otherwise.
+        optimize.visible = [Source.SCREEN, Source.DISPLAY].includes(choices.source);
+        if (sound)
+            sound.value = choices.audio;
+        start.reactive = true;
+    }
+
+    _pickApp(device, choices, {live = false} = {}) {
+        import('./lumaCastDialogs.js').then(({AppPickerDialog}) => {
+            this._requestClose();
+            const dialog = new AppPickerDialog({
+                deviceName: device?.name ?? this._cast.session?.deviceName ?? '',
+                selectedAppId: choices.appId,
+                actionLabel: live ? _('Share This App') : _('Start Casting'),
+            });
+            dialog.connect('picked', (_d, appId) => {
+                if (live) {
+                    this._cast.change({source: Source.APP, appId});
+                } else {
+                    Object.assign(choices, {source: Source.APP, appId});
+                    this._cast.connectDevice(device, {...choices});
+                }
+            });
+            dialog.open();
+        }).catch(e => logError(e, 'Luma Cast: app picker'));
+    }
+
+    // ── session ─────────────────────────────────────────────────────────
+    _sessionSubtitle(session) {
+        switch (session.state) {
+        case 'connecting':
+        case 'pairing':
+            return _('Connecting…');
+        case 'reconnecting':
+            return _('Reconnecting…');
+        default: {
+            const what = sourceSummary(session);
+            return session.audio === 'receiver'
+                ? _('%s · Sound on screen').format(what) : what;
+        }
+        }
+    }
+
+    _buildSession(content) {
+        const session = this._cast.session;
+        const connecting = ['connecting', 'pairing', 'reconnecting'].includes(session.state);
+        const header = this._header({
+            iconName: kindIcon(session.deviceKind),
+            title: connecting && session.state !== 'reconnecting'
+                ? _('Connecting to %s').format(session.deviceName)
+                : _('Casting to %s').format(session.deviceName),
+            subtitle: this._sessionSubtitle(session),
+            spinner: connecting,
+            live: !connecting,
+        });
+        content.add_child(header);
+
+        const device = this._cast.devices.get(session.deviceId) ?? null;
+        const options = this._shareOptions(device, session, pick => {
+            if (pick.pick) {
+                this._pickApp(device, session, {live: true});
+                return;
+            }
+            this._cast.change(pick);
+        });
+        content.add_child(options);
+
+        const sound = new Segmented(_('Sound'), {
+            iconName: null,
+            items: [
+                {value: 'receiver', text: receiverNoun(session.deviceKind)},
+                {value: 'local', text: _('This computer')},
+            ],
+        });
+        sound.connect('changed', (_s, value) => this._cast.change({audio: value}));
+        content.add_child(sound);
+
+        const quiet = new St.BoxLayout({style_class: 'luma-cast-note', x_expand: true});
+        quiet.add_child(new St.Icon({icon_name: 'luma-cast-quiet-symbolic', style_class: 'luma-cast-note-icon',
+            y_align: Clutter.ActorAlign.CENTER}));
+        quiet.add_child(wrapLabel(_('Notifications are silenced while you cast.'), 'luma-cast-note-label',
+            {x_expand: true, y_align: Clutter.ActorAlign.CENTER}));
+        content.add_child(quiet);
+
+        const stop = primaryButton(connecting && session.state !== 'reconnecting' ? _('Cancel') : _('Stop Casting'), 'luma-cast-stop');
+        stop.connect('clicked', () => {
+            this._requestClose();
+            this._cast.stop();
+        });
+        content.add_child(stop);
+
+        this._session = {header, options, sound, quiet, stop, connecting};
+        this._syncSession();
+    }
+
+    _syncSession() {
+        const session = this._cast.session;
+        const parts = this._session;
+        if (!session || !parts)
+            return;
+        const connecting = ['connecting', 'pairing', 'reconnecting'].includes(session.state);
+        if (connecting !== parts.connecting) {
+            // Connected: the header gains its live mark and loses the spinner.
+            this._view = null;
+            this._render(true);
+            return;
+        }
+        parts.header._subtitle.text = this._sessionSubtitle(session);
+        parts.header._subtitle.visible = true;
+        this._syncOptions(parts.options, session);
+        parts.sound.value = session.audio;
+        parts.quiet.visible = this._cast.silenceNotifications;
+        parts.options.visible = !connecting;
+        parts.sound.visible = !connecting;
+        parts.quiet.visible = !connecting && this._cast.silenceNotifications;
+    }
+
+    // ── error ───────────────────────────────────────────────────────────
+    _buildError(content) {
+        const ended = this._cast.lastEnded;
+        const {title, body} = describeError(ended.code, ended.deviceName, ended.message);
+        content.add_child(this._header({title: _('Choose a screen'), compact: true}));
+        const card = new St.BoxLayout({
+            orientation: Clutter.Orientation.VERTICAL,
+            style_class: 'luma-cast-error',
+            x_expand: true,
+            accessible_role: Atk.Role.ALERT,
+        });
+        const top = new St.BoxLayout({style_class: 'luma-cast-error-top', x_expand: true});
+        top.add_child(chip('luma-cast-alert-symbolic', 'luma-cast-error-chip'));
+        const text = new St.BoxLayout({orientation: Clutter.Orientation.VERTICAL, x_expand: true});
+        text.add_child(wrapLabel(title, 'luma-cast-error-title'));
+        text.add_child(wrapLabel(body, 'luma-cast-error-body'));
+        top.add_child(text);
+        card.add_child(top);
+        card.accessible_name = `${title}. ${body}`;
+        const buttons = new St.BoxLayout({
+            style_class: 'luma-cast-error-buttons',
+            x_expand: true,
+            layout_manager: new Clutter.BoxLayout({homogeneous: true}),
+        });
+        const device = this._cast.devices.get(ended.deviceId);
+        const retry = primaryButton(_('Try Again'), 'luma-cast-secondary');
+        retry.visible = Boolean(device) && ended.code !== 'wifi-direct-disabled';
+        retry.connect('clicked', () => {
+            this._cast.dismissError();
+            if (device)
+                this._choose(device);
+        });
+        const other = primaryButton(_('Other Screens'), 'luma-cast-secondary');
+        other.connect('clicked', () => {
+            this._device = null;
+            this._cast.dismissError();
+        });
+        buttons.add_child(retry);
+        buttons.add_child(other);
+        card.add_child(buttons);
+        content.add_child(card);
+        content.add_child(this._footer());
+    }
+});
+
