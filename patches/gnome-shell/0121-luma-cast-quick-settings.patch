+});
+
+// The receiver side of a two-way choice: a short noun, because the header
+// already carries the full name and long room names would truncate here.
+function receiverNoun(kind) {
+    switch (kind) {
+    case 'tv':
+        return _('TV');
+    case 'projector':
+        return _('Projector');
+    case 'computer':
+        return _('Other Computer');
+    case 'speaker-display':
+    case 'conference-room':
+        return _('Display');
+    default:
+        return _('Screen');
+    }
+}
+
+/** Two choices side by side: "TV" | "This computer". */
+const Segmented = GObject.registerClass({
+    Signals: {'changed': {param_types: [GObject.TYPE_STRING]}},
+}, class Segmented extends St.BoxLayout {
+    constructor(title, segments) {
+        super({
+            orientation: Clutter.Orientation.VERTICAL,
+            style_class: 'luma-cast-field',
+            x_expand: true,
+        });
+        const heading = new St.BoxLayout({style_class: 'luma-cast-field-heading'});
+        if (segments.iconName) {
+            heading.add_child(new St.Icon({
+                icon_name: segments.iconName,
+                style_class: 'luma-cast-field-icon',
+                y_align: Clutter.ActorAlign.CENTER,
+            }));
+        }
