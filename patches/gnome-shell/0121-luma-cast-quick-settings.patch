diff --git a/js/ui/status/cast.js b/js/ui/status/cast.js
new file mode 100644
index 0000000..60e1f81
--- /dev/null
+++ b/js/ui/status/cast.js
@@ -0,0 +1,275 @@
+// Luma Cast in Quick Settings and on the shelf (ADR-034, "What people see").
+import Atk from 'gi://Atk';
+import Clutter from 'gi://Clutter';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import Pango from 'gi://Pango';
+import St from 'gi://St';
+
+import * as Main from '../main.js';
+import * as PanelMenu from '../panelMenu.js';
+import * as SurfaceMaterials from '../lumaSurfaceMaterials.js';
+
+import {QuickMenuToggle, SystemIndicator} from '../quickSettings.js';
+import {getCast, describeError, reduceMotion} from '../lumaCast.js';
+import {CastPane} from '../lumaCastSheet.js';
+
+// A failure stays on the shelf this long, then the indicator leaves.
+const ENDED_LINGER_SECONDS = 8;
+
+const CastToggle = GObject.registerClass(
+class CastToggle extends QuickMenuToggle {
+    constructor() {
+        super({
+            title: _('Cast'),
+            iconName: 'luma-cast-symbolic',
+            toggleMode: false,
+            menuButtonAccessibleName: _('Choose a screen'),
+        });
+        this.add_style_class_name('luma-cast-toggle');
+        this._cast = getCast();
+
+        this.menu.box.add_style_class_name('luma-cast-detail');
+        this._pane = new CastPane({
+            context: 'quick-settings',
+            onRequestClose: () => Main.panel.closeQuickSettings(),
+        });
+        SurfaceMaterials.bindSurface(this._pane, {backdrop: false});
+        this.menu.box.add_child(this._pane);
+        this.menu.connect('open-state-changed', (_menu, open) => {
+            if (open) {
+                this._pane.activate();
+                // Keyboard users land on the first control of the detail.
+                const focus = global.stage.key_focus;
+                if (focus && this.contains(focus))
+                    GLib.idle_add_once(GLib.PRIORITY_DEFAULT, () => this._pane.focusFirst());
+            } else {
+                this._pane.deactivate();
+            }
+        });
+
+        // Pressing the tile itself opens the screens; there is nothing to
+        // switch on without choosing one.
+        this.connect('clicked', () => {
+            if (this.menu.isOpen)
+                this.menu.close();
+            else
+                this.menu.open();
+        });
+
+        this._cast.connectObject(
+            'available-changed', () => this._sync(),
+            'session-changed', () => this._sync(),
+            this);
+        this._sync();
+    }
+
+    _sync() {
+        const cast = this._cast;
+        const session = cast.session;
+        this.visible = cast.available;
+        this.checked = cast.casting && session.state === 'streaming';
+        this.icon_name = cast.casting ? 'luma-cast-on-symbolic' : 'luma-cast-symbolic';
+        if (!cast.casting) {
+            this.title = _('Cast');
+            this.subtitle = null;
+            this.accessible_name = _('Cast');
+        } else if (session.state === 'streaming') {
+            // Title over subtitle reads "Casting / Conference Room B"; the
+            // accessible name is the sentence.
+            this.title = _('Casting');
+            this.subtitle = session.deviceName;
+            this.accessible_name = _('Casting to %s').format(session.deviceName);
+        } else {
+            this.title = session.state === 'reconnecting' ? _('Reconnecting') : _('Connecting');
+            this.subtitle = session.deviceName;
+            this.accessible_name = _('Connecting to %s').format(session.deviceName);
+        }
+    }
+});
+
+export const Indicator = GObject.registerClass(
+class Indicator extends SystemIndicator {
+    constructor() {
+        super();
+        this.quickSettingsItems.push(new CastToggle());
+        CodePrompter.get();
+    }
+});
+
+/**
+ * The shelf indicator while casting: the device's name beside the cast mark,
+ * and a menu with what's shared, sound and Stop.
+ */
+export const CastingIndicator = GObject.registerClass(
+class CastingIndicator extends PanelMenu.Button {
+    constructor() {
+        super(0.5, _('Casting'), false);
+        this.add_style_class_name('luma-cast-indicator');
+        this.accessible_role = Atk.Role.PUSH_BUTTON;
+        this._cast = getCast();
+
+        this._box = new St.BoxLayout({style_class: 'luma-cast-indicator-box'});
+        this._icon = new St.Icon({
+            icon_name: 'luma-cast-on-symbolic',
+            style_class: 'system-status-icon luma-cast-indicator-icon',
+            y_align: Clutter.ActorAlign.CENTER,
+        });
+        this._label = new St.Label({
+            style_class: 'luma-cast-indicator-label',
+            y_align: Clutter.ActorAlign.CENTER,
+        });
+        this._label.clutter_text.ellipsize = Pango.EllipsizeMode.END;
+        this._box.add_child(this._icon);
+        this._box.add_child(this._label);
+        this.add_child(this._box);
+
+        this.menu.box.add_style_class_name('luma-cast-menu');
+        this._pane = new CastPane({
+            context: 'indicator',
+            onRequestClose: () => this.menu.close(),
+        });
+        SurfaceMaterials.bindSurface(this._pane, {backdrop: false});
+        this.menu.box.add_child(this._pane);
+        this.menu.connect('open-state-changed', (_menu, open) => {
+            if (open)
+                this._pane.activate();
+            else
+                this._pane.deactivate();
+        });
+
+        this._cast.connectObject('session-changed', () => this._sync(), this);
+        this.connect('destroy', () => {
+            if (this._lingerId)
+                GLib.source_remove(this._lingerId);
+        });
+        this._sync();
+    }
+
+    _sync() {
+        const cast = this._cast;
+        const session = cast.session;
+        this.remove_style_class_name('luma-cast-indicator-connecting');
+        this.remove_style_class_name('luma-cast-indicator-failed');
+        this._stopPulse();
+        if (this._lingerId && (cast.casting || !cast.lastEnded)) {
+            GLib.source_remove(this._lingerId);
+            this._lingerId = 0;
+        }
+
+        if (cast.casting) {
+            const streaming = session.state === 'streaming';
+            this._icon.icon_name = streaming ? 'luma-cast-on-symbolic' : 'luma-cast-symbolic';
+            this._label.text = streaming ? session.deviceName
+                : session.state === 'reconnecting' ? _('Reconnecting…') : _('Connecting…');
+            this.accessible_name = streaming
+                ? _('Casting to %s').format(session.deviceName)
+                : _('Connecting to %s').format(session.deviceName);
+            if (!streaming) {
+                this.add_style_class_name('luma-cast-indicator-connecting');
+                this._startPulse();
+            }
+            this._show();
+        } else if (cast.lastEnded && !Main.panel.statusArea.quickSettings?.menu.isOpen) {
+            // A failure seen in Quick Settings is explained there; the shelf
+            // only carries one that happened out of sight.
+            const {title} = describeError(cast.lastEnded.code, cast.lastEnded.deviceName, cast.lastEnded.message);
+            this._icon.icon_name = 'luma-cast-alert-symbolic';
+            this._label.text = _('Casting stopped');
+            this.accessible_name = title;
+            this.add_style_class_name('luma-cast-indicator-failed');
+            this._show();
+            if (!this._lingerId) {
+                this._lingerId = GLib.timeout_add_seconds(GLib.PRIORITY_DEFAULT, ENDED_LINGER_SECONDS, () => {
+                    this._lingerId = 0;
+                    if (!this.menu.isOpen && !Main.panel.statusArea.quickSettings?.menu.isOpen)
+                        cast.dismissError();
+                    return GLib.SOURCE_REMOVE;
+                });
+            }
+        } else {
+            this._hide();
+        }
+    }
+
+    _show() {
+        if (this.visible)
+            return;
+        this.visible = true;
+        if (reduceMotion())
+            return;
+        this.opacity = 0;
+        this.ease({opacity: 255, duration: 180, mode: Clutter.AnimationMode.EASE_OUT_QUAD});
+    }
+
+    _hide() {
+        if (!this.visible)
+            return;
+        this.menu.close();
+        this.visible = false;
+    }
+
+    _startPulse() {
+        if (reduceMotion() || this._pulsing)
+            return;
+        this._pulsing = true;
+        this._icon.ease({
+            opacity: 110,
+            duration: 700,
+            mode: Clutter.AnimationMode.EASE_IN_OUT_SINE,
+            repeatCount: -1,
+            autoReverse: true,
+        });
+    }
+
+    _stopPulse() {
+        if (!this._pulsing)
+            return;
+        this._pulsing = false;
+        this._icon.remove_all_transitions();
+        this._icon.opacity = 255;
+    }
+
+    setShelfPresentation(_enabled) {
+    }
+});
+
+/** One owner for pairing prompts, whichever surface started the cast. */
+class CodePrompter {
+    static get() {
+        CodePrompter._instance ??= new CodePrompter();
+        return CodePrompter._instance;
+    }
+
+    constructor() {
+        this._cast = getCast();
+        this._dialog = null;
+        this._cast.connectObject('code-requested', (_c, request) => this._onCode(request), this);
+    }
+
+    async _onCode({mode, code, digits}) {
+        const session = this._cast.session;
+        if (!session)
+            return;
+        // A second "enter" while the prompt is up means the code was wrong.
+        if (this._dialog && this._dialog.mode === 'enter' && mode === 'enter') {
+            this._dialog.reject();
+            return;
+        }
+        this._dialog?.close();
+        const {CodeDialog} = await import('../lumaCastDialogs.js');
+        Main.panel.closeQuickSettings();
+        const dialog = new CodeDialog({
+            mode, code, digits,
+            deviceName: session.deviceName,
+            deviceKind: session.deviceKind,
+        });
+        dialog.mode = mode;
+        dialog.connect('destroy', () => {
+            if (this._dialog === dialog)
+                this._dialog = null;
+        });
+        this._dialog = dialog;
+        dialog.open();
+    }
+}
