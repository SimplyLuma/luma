@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Native Dash and status geometry share one logical tile size. Display scale
+// multiplies these logical measurements; it is not a second size policy.
+export const DASH_TILE_SIZE = 36;
+export const DASH_TILE_GAP = 5;
+
+export function runningIndicatorGeometry(edge, width, height, center, scale = 1) {
+    const length = 18 * scale;
+    const depth = 3 * scale;
+    const vertical = edge === 'left' || edge === 'right';
+    const radii = {bottom: [2, 2, 0, 0], top: [0, 0, 2, 2],
+        left: [0, 2, 2, 0], right: [2, 0, 0, 2]}[edge];
+    return {
+        x: vertical ? (edge === 'left' ? 0 : width - depth) : center - length / 2,
+        y: vertical ? center - length / 2 : (edge === 'top' ? 0 : height - depth),
+        width: vertical ? depth : length,
+        height: vertical ? length : depth,
+        radii,
+    };
+}
