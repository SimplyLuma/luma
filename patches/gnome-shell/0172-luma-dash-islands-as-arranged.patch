diff --git a/js/ui/messageTray.js b/js/ui/messageTray.js
index db0d66d..c1288e5 100644
--- a/js/ui/messageTray.js
+++ b/js/ui/messageTray.js
@@ -37,6 +37,22 @@ export const NOTIFICATIONS_LIVE_IN_SHELF = true;
 function shelfHoldsNotifications() {
     return NOTIFICATIONS_LIVE_IN_SHELF && !!Main.shelf?._beaconIsland && !!Main.shelf.get_stage();
 }
+// Where the notifications island is placed (ADR-044): its edge, its
+// monitor and its centre, hidden or not (a hidden island's group still
+// stands at its slot).
+function notificationIslandPlace() {
+    const shelf = Main.shelf;
+    const group = shelf?._groups?.find(g => g.placement?.islands.includes('notifications') && !g.placement.drag);
+    if (!group)
+        return null;
+    const placed = group.placement;
+    const monitor = Main.layoutManager.monitors[placed.monitor] ?? Main.layoutManager.primaryMonitor;
+    const island = shelf.getIsland('notifications');
+    const actor = island?.visible && island.get_stage() ? island : group;
+    const [x, y] = actor.get_transformed_position();
+    const [w, h] = actor.get_transformed_size();
+    return {edge: placed.edge, monitor, index: monitor.index, cx: x + w / 2, cy: y + h / 2};
+}
 const MAX_NOTIFICATIONS_PER_SOURCE = 10;
 
 // Desktop arrival geometry (logical px): clamp(268px, 26vw, 352px) wide,
@@ -1014,10 +1030,22 @@ export const MessageTray = GObject.registerClass({
     }
 
     _corner() {
-        // The few cards still shown (urgent ones, calls) sit above the
-        // notification island at the end of the shelf.
-        if (shelfHoldsNotifications())
-            return {bottom: true, right: true, center: false};
+        // The few cards still shown (urgent ones, calls) come from the
+        // notifications island, wherever it is placed: beside it along its
+        // edge, arriving from that edge.
+        if (shelfHoldsNotifications()) {
+            const place = notificationIslandPlace();
+            if (!place)
+                return {bottom: true, right: true, center: false, edge: 'bottom'};
+            const m = place.monitor;
+            if (place.edge === 'left' || place.edge === 'right') {
+                return {bottom: (place.cy - m.y) / m.height > 0.5, right: place.edge === 'right',
+                    center: false, edge: place.edge};
+            }
+            const along = (place.cx - m.x) / m.width;
+            return {bottom: place.edge === 'bottom', right: along > 2 / 3,
+                center: along >= 1 / 3 && along <= 2 / 3, edge: place.edge};
+        }
         // Top centre is where a banner is noticed without covering the Shelf
         // or the corner the pointer lives in; a corner is still a choice.
         const corner = this._shellSettings.get_string('notification-corner');
@@ -1036,6 +1064,10 @@ export const MessageTray = GObject.registerClass({
         if (this._cards.length + this._leavingCards.size > 0 &&
             this._monitorIndex >= 0 && this._monitorIndex < monitors.length)
             return this._monitorIndex;
+        // Cards from the notifications island come on its monitor.
+        const place = shelfHoldsNotifications() ? notificationIslandPlace() : null;
+        if (place && place.index >= 0 && place.index < monitors.length)
+            return peekCast()?.bannerMonitor(place.index) ?? place.index;
         const focusWindow = global.display.get_focus_window();
         let index = focusWindow?.get_monitor() ?? -1;
         if (index < 0 || index >= monitors.length)
@@ -1167,6 +1199,12 @@ export const MessageTray = GObject.registerClass({
         const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
         const corner = this._corner();
         const travel = ARRIVAL_TRAVEL * scale;
+        // From the notifications island's edge: up from the bottom, down
+        // from the top, inward from a side.
+        if (corner.edge === 'bottom' || corner.edge === 'top')
+            return {x: 0, y: (corner.edge === 'bottom' ? 1 : -1) * travel};
+        if (corner.edge === 'left' || corner.edge === 'right')
+            return {x: (corner.edge === 'right' ? 1 : -1) * travel, y: 0};
         if (corner.center)
             return {x: 0, y: (corner.bottom ? 1 : -1) * travel};
         return {x: (corner.right ? 1 : -1) * travel, y: 0};
