+let blurSettings;
+
+/**
+ * Whether the device renders live backdrop blur behind Shell surfaces.
+ *
+ * This is a device capability, not an accessibility choice. Where sampling
+ * the framebuffer behind every blurred surface on each repaint is costly
+ * (for example linear scanout with CPU tile conversion), the device turns it
+ * off: surfaces keep their translucent fill and only lose the blur.
+ * Reduce transparency still decides whether surfaces are opaque.
+ *
+ * @returns {boolean}
+ */
+export function backdropBlurEnabled() {
+    blurSettings ??= optionalSettings(
+        'org.project_luma.shell-state', 'backdrop-blur') ?? false;
+    return blurSettings ? blurSettings.get_boolean('backdrop-blur') : true;
+}
+
 function isDark(settings) {
     return settings?.get_string('color-scheme') === 'prefer-dark';
 }
