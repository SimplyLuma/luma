+static BlurTarget *
+blur_target_new (ShellBlurEffect *self,
+                 gconstpointer    key)
+{
+  BlurTarget *target = g_new0 (BlurTarget, 1);
+
+  target->key = key;
+  target->actor_fb.pipeline = cogl_pipeline_copy (self->base_pipeline);
+  target->background_fb.pipeline = cogl_pipeline_copy (self->base_pipeline);
+  target->vblur_fb.pipeline = cogl_pipeline_copy (self->vblur_pipeline);
+  target->hblur_fb.pipeline = cogl_pipeline_copy (self->hblur_pipeline);
+  target->brightness_pipeline = cogl_pipeline_copy (self->brightness_pipeline);
+
+  return target;
+}
