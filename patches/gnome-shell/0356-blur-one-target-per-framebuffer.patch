+/* Forget every cached blur (radius, brightness, corners or mode changed). */
+static void
+invalidate_blur (ShellBlurEffect *self)
+{
+  unsigned int i;
+
+  for (i = 0; i < self->targets->len; i++)
+    {
+      BlurTarget *target = g_ptr_array_index (self->targets, i);
+
+      target->cache_flags &= ~BLUR_APPLIED;
+    }
+}
+
+/*
+ * Luma: the target for the framebuffer being painted. An actor blur paints
+ * into its own offscreen at the actor's size whatever the view, so it keeps
+ * one target; a background blur keeps one per framebuffer. Targets that went
+ * unpainted for TARGET_IDLE_US (the actor left that monitor, or the monitor
+ * went away) are dropped, and beyond MAX_TARGETS the least recently painted
+ * one is reused.
+ */
+static BlurTarget *
+get_target (ShellBlurEffect     *self,
+            ClutterPaintContext *paint_context)
+{
+  gconstpointer key = NULL;
+  BlurTarget *found = NULL;
+  BlurTarget *oldest = NULL;
+  int64_t now = g_get_monotonic_time ();
+  unsigned int i;
+
+  if (self->mode == SHELL_BLUR_MODE_BACKGROUND)
+    key = clutter_paint_context_get_stage_view (paint_context);
+
+  for (i = 0; i < self->targets->len; )
+    {
+      BlurTarget *target = g_ptr_array_index (self->targets, i);
+
+      if (target->key == key)
+        {
+          found = target;
+          i++;
+          continue;
+        }
+
+      if (now - target->last_used_us > TARGET_IDLE_US)
+        {
+          g_ptr_array_remove_index_fast (self->targets, i);
+          continue;
+        }
+
+      if (!oldest || target->last_used_us < oldest->last_used_us)
+        oldest = target;
+      i++;
+    }
+
+  if (!found)
+    {
+      if (self->targets->len >= MAX_TARGETS && oldest)
+        {
+          blur_target_clear (oldest);
+          oldest->key = key;
+          found = oldest;
+        }
+      else
+        {
+          found = blur_target_new (self, key);
+          g_ptr_array_add (self->targets, found);
+        }
+    }
+
+  found->last_used_us = now;
+  return found;
+}
