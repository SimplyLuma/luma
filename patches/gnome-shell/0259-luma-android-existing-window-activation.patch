@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+// Restore only an existing window belonging to a generated Android launcher.
+// Neither this helper nor its broker method starts an arbitrary desktop app.
+export function replyAndroidRequestError(invocation, error) {
+    // D-Bus invocations require GLib.Error, including native app/window throws.
+    const reply = error instanceof GLib.Error ? error :
+        new GLib.Error(Gio.DBusError, Gio.DBusError.FAILED,
+            'The Android window request failed.');
+    invocation.return_gerror(reply);
+}
+
+export function androidPackageFromDesktopId(id) {
+    if (typeof id !== 'string' || !id.startsWith('waydroid.') || !id.endsWith('.desktop'))
+        return null;
+    const packageName = id.slice(9, -8);
+    return validAndroidPackage(packageName) ? packageName : null;
+}
+
+export function validAndroidPackage(packageName) {
+    return typeof packageName === 'string' && packageName.length <= 255 &&
+        /^[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z][A-Za-z0-9_]*)+$/.test(packageName);
+}
+
+export function sameAndroidOwner(sender, before, after, liveOwner) {
+    return typeof sender === 'string' && sender.startsWith(':') &&
+        before.owner === sender && after.owner === sender && liveOwner === sender &&
+        before.generation === after.generation;
+}
+
+function matchingAndroidWindows(packageName, appSystem) {
+    if (!validAndroidPackage(packageName))
+        return false;
+    const appId = `waydroid.${packageName}.desktop`;
+    const app = appSystem.lookup_app(appId);
+    const info = app?.get_app_info();
+    if (app?.get_id() !== appId || info?.get_id() !== appId ||
+        !info.get_boolean('X-Luma-Android'))
+        return false;
+    const wmClass = `waydroid.${packageName}`;
+    const windows = app.get_windows().filter(window =>
+        !window.skip_taskbar && !window.is_attached_dialog());
+    if (!windows.length || !windows.every(window => window.get_wm_class() === wmClass))
+        return false;
+    return {app, windows};
+}
+
+export function activateAndroidApplication(packageName, appSystem, timestamp) {
+    const matched = matchingAndroidWindows(packageName, appSystem);
+    if (!matched) return false;
+    matched.app.activate_full(-1, timestamp);
+    return true;
+}
+
+export function closeAndroidApplication(packageName, appSystem, timestamp) {
+    const matched = matchingAndroidWindows(packageName, appSystem);
+    if (!matched) return false;
+    for (const window of matched.windows)
+        window.delete(timestamp);
+    return true;
+}
