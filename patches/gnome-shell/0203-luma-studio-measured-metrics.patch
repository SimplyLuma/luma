+// Add Studio's leading glyph and status copy to an existing native switch
+// row; its state, gesture handling and service callbacks remain intact.
+export function decorateStudioSwitchRow(item, iconName, subtitle = '') {
+    item.add_style_class_name('luma-sheet-row');
+    item.label.add_style_class_name('luma-sheet-row-title');
+    item.remove_child(item.label);
+    const copy = new St.BoxLayout({style_class: 'luma-sheet-row-copy',
+        orientation: Clutter.Orientation.VERTICAL, x_expand: true,
+        y_align: Clutter.ActorAlign.CENTER});
+    copy.add_child(item.label);
+    const note = new St.Label({text: subtitle, visible: !!subtitle,
+        style_class: 'luma-sheet-row-state'});
+    copy.add_child(note);
+    item.insert_child_at_index(new St.Icon({icon_name: iconName,
+        style_class: 'luma-sheet-row-icon', y_align: Clutter.ActorAlign.CENTER}), 0);
+    item.insert_child_at_index(copy, 1);
+    item._statusBin.x_expand = false;
+    // A radio change leaves its Studio page open for the resulting state.
+    item.activate = () => item.toggle();
+    return note;
+}
+
+export function bindStudioSwitchRow(control, row) {
+    let syncing = false;
+    const sync = () => {
+        syncing = true;
+        try { row.setToggleState(control.checked); }
+        finally { syncing = false; }
+        row.reactive = control.reactive;
+    };
+    row.connect('toggled', (_row, enabled) => {
+        if (syncing || enabled === control.checked || !control.reactive) return;
+        control.emit('clicked', 1); sync();
+    });
+    control.connectObject('notify::checked', sync, 'notify::reactive', sync, row);
+    sync();
+}
