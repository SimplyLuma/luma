new file mode 100644
index 0000000..20b1f4f
--- /dev/null
+++ b/js/ui/lumaWellModel.js
@@ -0,0 +1,231 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// What the Well shows and who each item is, without a Shell: which status
+// items stay in view and which wait behind the overflow, and which installed
+// app a status item or a notification really belongs to. No gi imports, so
+// %check runs it under plain gjs.
+
+export const PIN_LIMIT = 4;
+export const ATTENTION_LIMIT = 2;
+export const ATTENTION_LINGER_MS = 3000;
+
+// How many status items the Well shows before it folds the rest away, by the
+// form of the screen it is on (lumaPresentation/layout.js formOf). A desktop
+// or a tablet has room for four; a narrower screen holds fewer.
+export const CAPACITY = {pocket: 1, phone: 2, fold: 3, tablet: 4};
+
+export function capacityFor(form) {
+    return CAPACITY[form] ?? CAPACITY.tablet;
+}
+
+// Which items the Well shows, in order, and which wait behind the overflow.
+// Kept apps, apps asking for attention and apps recording are always in
+// view. The others fill the Well up to its capacity. The overflow exists only
+// when it hides two or more apps: one app behind a button costs as much room
+// as the app itself, so a single extra app is shown instead.
+export function arrange(items, {pins, hiddenWhenIdle, pinLimit = PIN_LIMIT,
+    capacity = CAPACITY.tablet, now = Date.now()}) {
+    const idleHidden = item => item.status === 'Passive' && hiddenWhenIdle.includes(item.key);
+    const byKey = new Map(items.map(item => [item.key, item]));
+    const fixed = [];
+    for (const key of pins.slice(0, pinLimit)) {
+        const item = byKey.get(key);
+        if (item && !fixed.includes(item) && !idleHidden(item))
+            fixed.push(item);
+    }
+    const asking = items.filter(item => !fixed.includes(item) &&
+        (item.status === 'NeedsAttention' || (item.attentionUntil ?? 0) > now));
+    fixed.push(...asking.slice(0, ATTENTION_LIMIT));
+    fixed.push(...items.filter(item => !fixed.includes(item) && item.recording));
+    const others = items.filter(item => !fixed.includes(item) && !idleHidden(item));
+    const free = Math.max(0, capacity - fixed.length);
+    if (others.length <= Math.max(free, 1))
+        return {shown: [...fixed, ...others], rest: []};
+    // The overflow takes one place of its own.
+    const inline = Math.max(0, free - 1);
+    return {shown: [...fixed, ...others.slice(0, inline)], rest: others.slice(inline)};
+}
+
+// ── Identity ────────────────────────────────────────────────────────────
+// A Chromium-family browser runs every web app it installed in its own
+// process. Its status icon is named chrome_status_icon_<n> whoever it is
+// for, its notifications name the browser's desktop entry, and the window
+// tracker places its process under whichever of its windows it finds
+// first. None of those says which app is speaking; the web app's own
+// desktop entry (<browser>-<32 letters a-p>-<profile>.desktop, StartupWMClass
+// crx_<id>) and the item's own words do.
+
+const WEB_APP_ID = /(?:^|\.)([a-z][a-z0-9_]*(?:-[a-z][a-z0-9_]*)*)-([a-p]{32})-[^.]+\.desktop$/i;
+const WEB_APP_CLASS = /^crx_([a-p]{32})$/i;
+const CHROMIUM_STATUS_ID = /^chrom(?:e|ium)_status_icon_\d+$/i;
+
+// Desktop entries of the browsers that install web apps, by the prefix their
+// web apps' desktop entries carry. Viola is Chromium inside.
+export const BROWSERS = {
+    'chrome': ['google-chrome.desktop', 'com.google.Chrome.desktop',
+        'google-chrome-beta.desktop', 'google-chrome-unstable.desktop'],
+    'chromium': ['chromium-browser.desktop', 'chromium.desktop', 'org.chromium.Chromium.desktop'],
+    'msedge': ['microsoft-edge.desktop', 'com.microsoft.Edge.desktop'],
+    'brave': ['brave-browser.desktop', 'com.brave.Browser.desktop'],
+    'vivaldi': ['vivaldi-stable.desktop', 'com.vivaldi.Vivaldi.desktop'],
+    'viola': ['com.rhyme.viola.desktop', 'viola-browser.desktop'],
+};
+const BROWSER_IDS = new Set(Object.values(BROWSERS).flat().map(id => id.toLowerCase()));
+
+const words = text => (text ?? '').toLowerCase().normalize('NFKC')
+    .replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
+const compact = text => words(text).replace(/ /g, '');
+
+// The web app a desktop entry launches, or null: {browser, appId}.
+export function webAppOf(desc) {
+    if (!desc)
+        return null;
+    const byId = WEB_APP_ID.exec(desc.id ?? '');
+    const byClass = WEB_APP_CLASS.exec(desc.wmClass ?? '');
+    if (!byId && !byClass)
+        return null;
+    return {browser: byId ? byId[1].toLowerCase() : null,
+        appId: (byId?.[2] ?? byClass[1]).toLowerCase()};
+}
+
+export function isBrowser(desc) {
+    if (!desc || webAppOf(desc))
+        return false;
+    const id = (desc.id ?? '').toLowerCase();
+    return BROWSER_IDS.has(id) || [...BROWSER_IDS].some(known => id.endsWith(`.${known}`)) ||
+        (desc.categories ?? '').split(';').includes('WebBrowser');
+}
+
+export function isChromiumStatusId(id) {
+    return CHROMIUM_STATUS_ID.test(id ?? '');
+}
+
+// The browser that installed a web app: by its desktop entry's prefix, and
+// otherwise by the program its Exec line runs.
+export function browserOf(webApp, catalog) {
+    const prefix = webAppOf(webApp)?.browser;
+    for (const id of BROWSERS[prefix] ?? []) {
+        const desc = catalog.lookup(id);
+        if (desc)
+            return desc;
+    }
+    const program = (webApp.exec ?? '').split('/').pop();
+    const byProgram = program ? catalog.lookup(`${program}.desktop`) : null;
+    return byProgram && isBrowser(byProgram) ? byProgram : null;
+}
+
+export function webAppsOf(browser, catalog) {
+    return catalog.installed().filter(desc => {
+        if (!webAppOf(desc) || desc.hidden)
+            return false;
+        return !browser || browserOf(desc, catalog)?.id === browser.id;
+    });
+}
+
+// The one web app whose name the text gives, whole: "ChatGPT" names ChatGPT,
+// "Google Chrome" names no web app. Two answers are no answer.
+export function webAppNamedIn(text, webApps) {
+    const said = words(text);
+    if (!said)
+        return null;
+    const exact = webApps.filter(desc => words(desc.name) === said);
+    if (exact.length)
+        return exact.length === 1 ? exact[0] : null;
+    const inside = webApps.filter(desc => {
+        const name = words(desc.name);
+        return name.length >= 3 && ` ${said} `.includes(` ${name} `);
+    });
+    return inside.length === 1 ? inside[0] : null;
+}
+
+// The one web app a site belongs to, from the origin a browser puts first in
+// its notification ("chatgpt.com" -> ChatGPT, "app.slack.com" -> Slack).
+export function webAppForOrigin(host, webApps) {
+    const labels = (host ?? '').toLowerCase().split('.').filter(Boolean);
+    if (labels.length < 2)
+        return null;
+    const site = labels.slice(labels[0] === 'www' ? 1 : 0, -1);
+    const keys = new Set([...site, site.join('')].filter(key => key.length >= 3));
+    const found = webApps.filter(desc => keys.has(compact(desc.name)));
+    return found.length === 1 ? found[0] : null;
+}
+
+// The origin line a Chromium-family browser starts a notification body with.
+export function originOfBody(body) {
+    const [first, ...rest] = (body ?? '').split('\n\n');
+    const host = first.replace(/<[^>]*>/g, '').trim();
+    return rest.length && /^[a-z0-9-]+(\.[a-z0-9-]+)+$/i.test(host) ? host : null;
+}
+
+// The browser family a running program belongs to, from its path
+// (/opt/google/chrome/chrome, /usr/lib64/chromium-browser/chromium-browser,
+// .../viola/viola): the longest family name the file name starts with.
+export function familyOfProgram(program) {
+    const file = (program ?? '').split('/').pop().toLowerCase();
+    const known = Object.keys(BROWSERS).filter(family => file.startsWith(family));
+    return known.sort((a, b) => b.length - a.length)[0] ?? null;
+}
+
+function installedBrowsers(catalog, family = null) {
+    const families = family ? [family] : Object.keys(BROWSERS);
+    return families.flatMap(name => BROWSERS[name]).map(id => catalog.lookup(id)).filter(Boolean);
+}
+
+// Which installed app a status item belongs to, or null. hint is the app the
+// item's process was placed under and program the file it runs, when known.
+// Returns {id, via}: 'entry' when the item named its own desktop entry,
+// 'web-app' or 'browser' when it came from a browser.
+export function statusItemApp({id, title, tooltip, desktopEntry, hint, program}, catalog) {
+    if (desktopEntry) {
+        const own = catalog.lookup(desktopEntry.endsWith('.desktop') ? desktopEntry : `${desktopEntry}.desktop`);
+        if (own)
+            return {id: own.id, via: 'entry'};
+    }
+    const hinted = hint ? catalog.lookup(hint) : null;
+    const fromBrowser = isChromiumStatusId(id) || isBrowser(hinted) || Boolean(webAppOf(hinted));
+    if (!fromBrowser)
+        return null;
+    let browser = webAppOf(hinted) ? browserOf(hinted, catalog) : isBrowser(hinted) ? hinted : null;
+    const family = familyOfProgram(program);
+    browser ??= family ? installedBrowsers(catalog, family)[0] ?? null : null;
+    const candidates = installedBrowsers(catalog);
+    if (!browser && candidates.length === 1)
+        browser = candidates[0];
+    // A browser we cannot tell apart from another: the web app named, from
+    // any of them, still says whose the item is.
+    const webApps = browser ? webAppsOf(browser, catalog) : webAppsOf(null, catalog);
+    const webApp = webAppNamedIn(tooltip, webApps) ?? webAppNamedIn(title, webApps);
+    if (webApp)
+        return {id: webApp.id, via: 'web-app'};
+    browser ??= candidates[0] ?? null;
+    return browser ? {id: browser.id, via: 'browser'} : null;
+}
+
+// Which installed app a notification belongs to, once the daemon has placed
+// it under an app: a browser's notification from a site with an installed
+// web app belongs to that web app. Returns a desktop id or null (no change).
+export function notificationApp(appDesc, body, catalog) {
+    if (!isBrowser(appDesc))
+        return null;
+    const host = originOfBody(body);
+    if (!host)
+        return null;
+    return webAppForOrigin(host, webAppsOf(appDesc, catalog))?.id ?? null;
+}
+
+// The catalogue the identity rules read, from Shell.AppSystem (or anything
+// with lookup_app and get_installed).
+export function catalogFrom(appSystem) {
+    const describe = info => info ? {
+        id: info.get_id?.() ?? '',
+        name: info.get_name?.() ?? '',
+        wmClass: info.get_startup_wm_class?.() ?? '',
+        exec: (info.get_executable?.() ?? '').split(/\s+/)[0],
+        categories: info.get_categories?.() ?? '',
+        hidden: info.get_nodisplay?.() ?? false,
+    } : null;
+    let installed = null;
+    return {
+        lookup: id => describe(appSystem.lookup_app(id)?.get_app_info?.() ?? null),
+        installed: () => (installed ??= appSystem.get_installed().map(describe).filter(Boolean)),
+    };
+}
