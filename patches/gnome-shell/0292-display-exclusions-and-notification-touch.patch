         this._targetHeight = height;
         this._targetWidth = width;
@@ -441,15 +459,23 @@
         const monitor = Main.layoutManager.primaryMonitor;
         if (!monitor) return;
         const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
-        this.set_position(this._rightAligned
-            ? monitor.x + monitor.width - 30 * scale - this.width
-            : monitor.x + (monitor.width - this.width) / 2, this._bottomAnchored ? monitor.y + monitor.height - this.height : (this._targetTop ?? monitor.y));
+        if (this._fullPage) {
+            this.set_position(monitor.x + (monitor.width - this.width) / 2, monitor.y);
