         this._scroll.set_child(this._list); column.add_child(this._scroll);
         this._empty = new St.Label({text: _("You're all caught up."), style_class: 'luma-lip-empty'});
         column.add_child(this._empty);
+        if (Main.layoutManager.primaryMonitor.width / St.ThemeContext.get_for_stage(global.stage).scale_factor <= 700 && Main.presentation?.mode !== 'desktop') {
+            column.add_child(new St.Widget({y_expand: true}));
+            const close = new St.Button({label: _('Close'), accessible_name: _('Close Notifications'),
+                reactive: true, can_focus: true, style: 'min-height: 44px; margin: 8px 16px; padding: 0; border-radius: 16px; background-color: rgba(128,128,128,0.14);'});
+            close.connect('clicked', () => this.close());
+            const dismiss = new Clutter.PanGesture({min_n_points: 1, max_n_points: 1, pan_axis: Clutter.PanAxis.Y});
+            dismiss.set_begin_threshold(8);
+            dismiss.connect('pan-update', gesture => { if (gesture.get_accumulated_delta().get_y() < -24) this.close(); });
+            dismiss.connect('may-recognize', gesture => {
+                const event = gesture.get_point_event(0);
+                const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+                const delta = gesture.get_accumulated_delta().get_y();
+                return !!event && this._fullPage && delta < 0 &&
+                    event.get_coords()[1] - delta >= this.y + this.height - 64 * scale;
+            });
+            if (this._dismissGesture) this.remove_action(this._dismissGesture);
+            this._dismissGesture = dismiss;
+            this.add_action_full('LumaNotificationsDismiss', Clutter.EventPhase.CAPTURE, dismiss);
+            column.add_child(close);
+        }
         this._setContent(column);
         this._cards.clear();
         this._syncTray(); this._render();
