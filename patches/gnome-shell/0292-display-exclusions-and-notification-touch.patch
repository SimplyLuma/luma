+        }
+        const box = avoidDisplayExclusions(Main.presentation?._displayGeometry, monitor, {
+            x: this._rightAligned ? monitor.width - 30 * scale - this.width : (monitor.width - this.width) / 2,
+            y: this._bottomAnchored ? monitor.height - this.height : (this._targetTop ?? monitor.y) - monitor.y,
+            width: this.width, height: Math.max(this.height, 44 * scale),
+        });
+        this.set_position(monitor.x + box.x, monitor.y + box.y);
     }
