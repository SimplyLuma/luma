diff --git a/js/ui/lumaMediaIslandGuard.js b/js/ui/lumaMediaIslandGuard.js
new file mode 100644
index 0000000..a58f52f
--- /dev/null
+++ b/js/ui/lumaMediaIslandGuard.js
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Keeps the now-playing island whole. Its show and hide animations, and the
+// module's title and artwork crossfades, end in one known state: the island
+// opaque, at its natural size, with its controls inside it. If about a second
+// after the last animation should have ended the island is still translucent,
+// narrower than its content, missing its controls or carrying an insensitive
+// state, the guard writes one line to the journal saying what it found and
+// which animation was last and what stopped it, then puts the island back.
+import GLib from 'gi://GLib';
+
+const GRACE_MS = 1000;
+const CHECK_MS = 500;
+const LOG_INTERVAL_MS = 60 * 1000;
+
+const now = () => GLib.get_monotonic_time() / 1000;
+const EASED = ['opacity', 'width', 'height'];
+
+export class MediaIslandGuard {
+    constructor(island, media, {vertical, sync}) {
+        this._island = island;
+        this._media = media;
+        this._vertical = vertical;
+        this._sync = sync;
+        this._timer = 0;
+        this._seen = 0;
+        this._cause = null;
+        this._last = null;
+        this._lastLog = -Infinity;
+        this._suppressed = 0;
+        this.snaps = 0;
+        const queue = () => this.queue();
+        island.connectObject('notify::opacity', queue, 'notify::width', queue,
+            'notify::height', queue, 'notify::visible', queue, 'notify::mapped', queue,
+            'notify::allocation', queue, this);
+        island._content?.connectObject('notify::opacity', queue, this);
+        media._copy.connectObject('notify::opacity', queue, this);
+        media._controls.connectObject('notify::visible', queue, 'notify::allocation', queue, this);
+        media.connectObject('notify::opacity', queue, 'eligibility-changed', queue, this);
+        this.queue();
+    }
+
+    // The island is about to animate: whatever animation is still running is
+    // being interrupted by this one. Returns the record the animation reports
+    // its end to.
+    begin(kind, duration) {
+        this._cause = kind;
+        const motion = {kind, started: Math.round(now()), duration, finished: null, interruptedBy: null};
+        this._next = motion;
+        return motion;
+    }
+
+    started(motion) {
+        this._cause = null;
+        this._last = motion;
+        this.queue(motion.duration + GRACE_MS);
+    }
+
+    // Returns what stopped the animation: another island animation, the guard,
+    // or something outside the island ("external").
+    stopped(motion, finished) {
+        const by = finished ? null : this._cause && motion !== this._next ? this._cause : 'external';
+        motion.finished = finished;
+        motion.interruptedBy = by;
+        motion.endedAfter = Math.round(now() - motion.started);
+        this.queue();
+        return by;
+    }
+
+    queue(delay = CHECK_MS) {
+        if (this._timer || this._destroyed)
+            return;
+        this._timer = GLib.timeout_add(GLib.PRIORITY_DEFAULT_IDLE, Math.max(250, delay), () => {
+            this._timer = 0;
+            this._check();
+            return GLib.SOURCE_REMOVE;
+        });
+    }
+
+    _actors() {
+        const media = this._media;
+        return {island: this._island, material: this._island._content, module: media,
+            identity: media._identity, copy: media._copy, art: media._art, controls: media._controls};
+    }
+
+    _check() {
+        const island = this._island, media = this._media;
+        if (this._destroyed || !media.eligible || !island.visible || !island.mapped)
+            return;
+        const actors = this._actors();
+        const moving = Object.values(actors).some(actor =>
+            actor && EASED.some(property => actor.get_transition(property)));
+        const settleAt = this._last ? this._last.started + this._last.duration + GRACE_MS : 0;
+        if (moving || now() < settleAt) {
+            this._seen = 0;
+            this.queue(moving ? GRACE_MS : settleAt - now());
+            return;
+        }
+        const problems = this._problems(actors);
+        if (!problems.length) {
+            this._seen = 0;
+            return;
+        }
+        // Act only on a state that has lasted: a second after it was first
+        // seen with nothing animating.
+        this._seen ||= now();
+        if (now() - this._seen < GRACE_MS) {
+            this.queue(GRACE_MS - (now() - this._seen));
+            return;
+        }
+        this._seen = 0;
+        this._restore(problems, actors);
+    }
+
+    _problems(actors) {
+        const problems = [];
+        const island = this._island, media = this._media;
+        for (const [name, actor] of Object.entries(actors)) {
+            if (actor && actor.opacity < 255)
+                problems.push(`${name} opacity ${actor.opacity}`);
+        }
+        for (const button of [media._previous, media._toggle, media._next]) {
+            const expected = button.reactive ? 255 : 89;
+            if (button.opacity !== expected)
+                problems.push(`control opacity ${button.opacity}, not ${expected}`);
+        }
+        const vertical = this._vertical();
+        const [, natural] = vertical
+            ? island.get_preferred_height(island.width)
+            : island.get_preferred_width(island.height);
+        const size = vertical ? island.height : island.width;
+        if (vertical ? island.natural_height_set : island.natural_width_set)
+            problems.push(`${vertical ? 'height' : 'width'} held at ${Math.round(size)}`);
+        if (size < natural - 1)
+            problems.push(`${Math.round(size)}px of ${Math.round(natural)}px`);
+        const controls = media._controls;
+        if (controls.get_parent() !== media || !controls.visible || controls.get_n_children() < 3) {
+            problems.push('controls missing');
+        } else if (!vertical && controls.has_allocation()) {
+            // Squeezed out: the island gives the title its room first, so a
+            // short island draws the artwork and title and no controls.
+            const [, wanted] = controls.get_preferred_width(-1);
+            const given = controls.get_allocation_box().get_width();
+            if (given < wanted - 1)
+                problems.push(`controls given ${Math.round(given)}px of ${Math.round(wanted)}px`);
+        }
+        for (const [name, actor] of Object.entries(actors)) {
+            if (/insensitive|transition/.test(actor?.style_class ?? ''))
+                problems.push(`${name} class "${actor.style_class}"`);
+        }
+        // St marks every non-reactive widget insensitive; only the island's
+        // buttons are meant to be reactive.
+        if (media._identity.has_style_pseudo_class('insensitive'))
+            problems.push('identity insensitive');
+        return problems;
+    }
+
+    _describe(actors) {
+        const vertical = this._vertical();
+        const island = this._island;
+        const [, natural] = vertical
+            ? island.get_preferred_height(island.width)
+            : island.get_preferred_width(island.height);
+        const out = {size: Math.round(vertical ? island.height : island.width), natural: Math.round(natural)};
+        out.opacity = Object.fromEntries(Object.entries(actors).map(([name, actor]) => [name, actor?.opacity]));
+        out.classes = Object.fromEntries(Object.entries(actors).map(([name, actor]) => [name, actor?.style_class ?? '']));
+        out.pseudo = Object.fromEntries(Object.entries(actors).map(([name, actor]) => [name, actor?.pseudo_class ?? '']));
+        try {
+            out.font = this._media._title.get_theme_node().get_font().to_string();
+        } catch {
+            out.font = null;
+        }
+        out.lastAnimation = this._last;
+        out.lastCrossfade = this._media._lastMotion ?? null;
+        return out;
+    }
+
+    _restore(problems, actors) {
+        const at = now();
+        const details = this._describe(actors);
+        if (at - this._lastLog >= LOG_INTERVAL_MS) {
+            const suppressed = this._suppressed ? ` (${this._suppressed} more since the last report)` : '';
+            console.warn(`Luma shelf: the now-playing island was left ${problems.join('; ')}; restored it${suppressed}. ${JSON.stringify(details)}`);
+            this._lastLog = at;
+            this._suppressed = 0;
+        } else {
+            this._suppressed++;
+        }
+        this.snaps++;
+        const media = this._media;
+        this._cause = 'guard';
+        this._next = null;
+        for (const actor of Object.values(actors)) {
+            actor?.remove_all_transitions();
+            if (actor)
+                actor.opacity = 255;
+        }
+        this._cause = null;
+        media._oldCopy?.destroy();
+        media._oldCopy = null;
+        if (media._controls.get_parent() !== media)
+            media.add_child(media._controls);
+        media._controls.show();
+        media._identity.reactive = true;
+        this._island.set_size(-1, -1);
+        media._render();
+        this._sync();
+        this.queue(GRACE_MS);
+    }
+
+    destroy() {
+        this._destroyed = true;
+        if (this._timer)
+            GLib.source_remove(this._timer);
+        this._timer = 0;
+        for (const actor of [this._island, this._island._content, this._media, this._media._copy, this._media._controls])
+            actor?.disconnectObject(this);
+    }
+}
