+    // What this Beam controls, written through the same objects Quick Options
+    // uses, so both always show one value: the output stream's slider for
+    // volume (its maximum is the over-amplification limit), the brightness
+    // manager's scale for this monitor. Nothing for other requests.
+    _control() {
+        const kind = beamKind(iconName(this._gicon));
+        if (kind === 'volume') {
+            const output = Main.panel?.statusArea?.quickSettings?._volumeOutput?._output;
+            if (!output?.stream)
+                return null;
+            return {
+                kind,
+                max: output.slider.maximum_value,
+                level: () => output.slider.value,
+                set: value => (output.slider.value = Math.clamp(value, 0, output.slider.maximum_value)),
+                // From the value it shows now: Slider.step() carries a private
+                // unsnapped value that a value set elsewhere leaves stale.
+                step: steps => (output.slider.value = Math.clamp(
+                    output.slider.value + steps * SCROLL_STEP, 0, output.slider.maximum_value)),
+                toggleMute: () => output.emit('icon-clicked'),
+                icon: () => new Gio.ThemedIcon({name: output.getIcon() ?? 'audio-volume-muted-symbolic'}),
+            };
+        }
+        if (kind === 'brightness') {
+            const manager = Main.brightnessManager;
+            const scale = manager?.scales?.find(item => item.monitor?.get_number?.() === this._monitorIndex) ??
+                manager?.globalScale;
+            if (!scale)
+                return null;
+            return {
+                kind,
+                max: 1,
+                level: () => scale.value,
+                set: value => (scale.value = Math.clamp(value, 0, 1)),
+                step: steps => (scale.value = Math.clamp(scale.value + steps * SCROLL_STEP, 0, 1)),
+                toggleMute: null,
+                icon: () => this._gicon,
+            };
+        }
+        return null;
+    }
+
+    _syncFromControl(control) {
+        this._level = control.level();
+        this._maxLevel = control.max;
+        this._gicon = control.icon();
+        this._present(false);
+    }
+
+    _setLevel(level) {
+        const control = this._control();
+        if (!control)
+            return false;
+        control.set(level);
+        this._syncFromControl(control);
+        return true;
+    }
+
+    _levelAt(event) {
+        const [x, y] = event.get_coords();
+        const [ok, localX] = this._capsule.transform_stage_point(x, y);
+        if (!ok || this._capsule.width <= 0)
+            return null;
+        let fraction = Math.clamp(localX / this._capsule.width, 0, 1);
+        if (this._capsule.get_text_direction() === Clutter.TextDirection.RTL)
+            fraction = 1 - fraction;
+        return fraction;
+    }
+
+    _onPress(event) {
+        if (event.get_button() !== Clutter.BUTTON_PRIMARY || !this._control())
+            return Clutter.EVENT_PROPAGATE;
+        const source = global.stage.get_actor_at_pos(Clutter.PickMode.REACTIVE, ...event.get_coords());
+        if (source === this._glyph) {
+            this._pressOnGlyph = true;
+            return Clutter.EVENT_STOP;
+        }
+        this._dragging = true;
+        this._grab = global.stage.grab(this._capsule);
+        this._syncHold();
+        const level = this._levelAt(event);
+        if (level !== null)
+            this._setLevel(level);
+        return Clutter.EVENT_STOP;
+    }
+
+    _onMotion(event) {
+        if (!this._dragging)
+            return Clutter.EVENT_PROPAGATE;
+        const level = this._levelAt(event);
+        if (level !== null)
+            this._setLevel(level);
+        return Clutter.EVENT_STOP;
+    }
+
+    _onRelease(event) {
+        if (this._pressOnGlyph) {
+            this._pressOnGlyph = false;
+            const control = this._control();
+            const source = global.stage.get_actor_at_pos(Clutter.PickMode.REACTIVE, ...event.get_coords());
+            if (control?.toggleMute && source === this._glyph) {
+                control.toggleMute();
+                this._syncFromControl(control);
+            }
+            return Clutter.EVENT_STOP;
+        }
+        if (!this._dragging)
+            return Clutter.EVENT_PROPAGATE;
+        this._endDrag();
+        return Clutter.EVENT_STOP;
+    }
+
+    _endDrag() {
+        this._dragging = false;
+        this._grab?.dismiss();
+        this._grab = null;
+        this._syncHold();
+    }
+
+    _onScroll(event) {
+        const control = this._control();
+        if (!control || event.get_flags() & Clutter.EventFlags.FLAG_POINTER_EMULATED)
+            return Clutter.EVENT_PROPAGATE;
+        const direction = event.get_scroll_direction();
+        let steps = 0;
+        if (direction === Clutter.ScrollDirection.UP || direction === Clutter.ScrollDirection.RIGHT)
+            steps = 1;
+        else if (direction === Clutter.ScrollDirection.DOWN || direction === Clutter.ScrollDirection.LEFT)
+            steps = -1;
+        else if (direction === Clutter.ScrollDirection.SMOOTH) {
+            const [dx, dy] = event.get_scroll_delta();
+            steps = Math.abs(dy) >= Math.abs(dx) ? -dy : dx;
+            if (event.get_scroll_flags() & Clutter.ScrollFlags.INVERTED)
+                steps *= -1;
+        }
+        if (steps) {
+            control.step(steps);
+            this._syncFromControl(control);
+        }
+        return Clutter.EVENT_STOP;
+    }
+
+    // While the pointer is on Beam or dragging it, it stays; it leaves
+    // HIDE_TIMEOUT after the pointer does or the drag ends.
+    get held() {
+        return this.visible && (this._capsule.hover || this._dragging);
+    }
+
+    _syncHold() {
+        if (!this.visible)
+            return;
+        if (this._hideTimeoutId)
+            GLib.source_remove(this._hideTimeoutId);
+        this._hideTimeoutId = 0;
+        if (this.held) {
+            if (this._leaving) {
+                this._leaving = false;
+                this.remove_transition('opacity');
+                this.opacity = 255;
+            }
+            return;
+        }
+        this._scheduleHide();
+    }
+
+    _scheduleHide() {
+        if (this._hideTimeoutId)
+            GLib.source_remove(this._hideTimeoutId);
+        this._hideTimeoutId = GLib.timeout_add_once(
+            GLib.PRIORITY_DEFAULT, HIDE_TIMEOUT, this._hide.bind(this));
+        GLib.Source.set_name_by_id(this._hideTimeoutId, '[gnome-shell] this._hide');
+    }
