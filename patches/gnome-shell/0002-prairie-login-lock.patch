new file mode 100644
index 0000000..fd9bc24
--- /dev/null
+++ b/js/ui/prairieLogin.js
@@ -0,0 +1,75 @@
+import Clutter from 'gi://Clutter';
+import GnomeDesktop from 'gi://GnomeDesktop';
+import GObject from 'gi://GObject';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import {formatDateWithCFormatString} from '../misc/dateUtils.js';
+import * as SystemActions from '../misc/systemActions.js';
+
+export const Clock = GObject.registerClass(
+class PrairieLoginClock extends St.BoxLayout {
+    _init() {
+        super._init({
+            style_class: 'prairie-login-clock',
+            orientation: Clutter.Orientation.VERTICAL,
+            x_align: Clutter.ActorAlign.CENTER,
+        });
+
+        this._time = new St.Label({
+            style_class: 'prairie-login-clock-time',
+            x_align: Clutter.ActorAlign.CENTER,
+        });
+        this._date = new St.Label({
+            style_class: 'prairie-login-clock-date',
+            x_align: Clutter.ActorAlign.CENTER,
+        });
+        this.add_child(this._time);
+        this.add_child(this._date);
+
+        this._wallClock = new GnomeDesktop.WallClock({time_only: true});
+        this._wallClock.connectObject(
+            'notify::clock', this._updateClock.bind(this), this);
+        this._updateClock();
+        this.connect('destroy', () => this._wallClock.run_dispose());
+    }
+
+    _updateClock() {
+        this._time.text = this._wallClock.clock.trim();
+        const dateFormat = Shell.util_translate_time_string(
+            N_('%A, %B %-d'));
+        this._date.text = formatDateWithCFormatString(new Date(), dateFormat);
+    }
+});
+
+export const PowerButton = GObject.registerClass(
+class PrairieLoginPowerButton extends St.Button {
+    _init() {
+        super._init({
+            style_class: 'prairie-login-power-button',
+            accessible_name: _('Power Off'),
+            can_focus: true,
+            reactive: true,
+            child: new St.Icon({
+                icon_name: 'system-shutdown-symbolic',
+                style_class: 'prairie-login-power-icon',
+            }),
+        });
+
+        this._systemActions = SystemActions.getDefault();
+        this._systemActions.bind_property(
+            'can-power-off', this, 'reactive',
+            GObject.BindingFlags.SYNC_CREATE);
+        this.connect('clicked', () => this._systemActions.activatePowerOff());
+    }
+});
+
+export const Background = GObject.registerClass(
+class PrairieLoginBackground extends St.Widget {
+    _init(params = {}) {
+        super._init({
+            ...params,
+            style_class: 'prairie-login-background',
+        });
+    }
+});
