--- a/data/theme/gnome-shell-sass/widgets/_quick-options.scss
+++ b/data/theme/gnome-shell-sass/widgets/_quick-options.scss
@@ -140,11 +140,28 @@
 .luma-quick-options .slider-bin:focus { box-shadow: 0 0 0 2px $q-active; }
 .luma-quick-options StButton:insensitive { color: $q-muted; }
 .quick-toggle-menu.luma-quick-detail {
-  margin: 0; padding: 9px; border: 1px solid $q-line; border-radius: 10px;
+  margin: 0 0 10px; padding: 9px; border: 1px solid $q-line; border-radius: 10px;
   background-color: $q-raised; color: $q-ink;
   .header { padding-bottom: 0; spacing-columns: 8px; }
   .header .icon { icon-size: 18px; padding: 0; background-color: transparent; }
   .header .title { font-size: 13px; font-weight: 700; }
   .header .subtitle { font-size: 11px; color: $q-muted; }
-  .popup-menu-item { min-height: 0; height: 30px; padding: 6px 10px; border-radius: 10px; font-size: 13px; }
+  // Rows are as tall as what they hold. A fixed row height clipped anything
+  // richer than one line -- Tiling's layout grid painted over the actions
+  // below it, and device rows put the icon below its name.
+  .popup-menu-item { min-height: 0; padding: 10px; spacing: 10px; border-radius: 10px; font-size: 13px; }
+  .popup-separator-menu-item { padding: 4px 10px; }
+  .nm-network-item .wireless-secure-icon { width: 7px; }
+  .device-subtitle { color: $q-muted; }
+  .keyboard-brightness-level {
+    spacing: 6px;
+    .button {
+      height: 36px; min-height: 0; padding: 0; border-radius: 10px;
+      background-color: $q-control; color: $q-ink;
+      StIcon { icon-size: 16px; }
+      &:hover { background-color: $q-hover; }
+      &:checked { background-color: $q-active; color: $q-active-ink; }
+    }
+    StLabel { font-size: 12px; color: $q-muted; }
+  }
 }
