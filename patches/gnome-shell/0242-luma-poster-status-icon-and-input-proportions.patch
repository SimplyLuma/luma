diff --git a/js/ui/prairieLogin.js b/js/ui/prairieLogin.js
index 11b582e..f00a6e2 100644
--- a/js/ui/prairieLogin.js
+++ b/js/ui/prairieLogin.js
@@ -322,11 +322,11 @@ class PosterCard extends St.BoxLayout {
         this._wifi = new St.Icon({icon_name: 'network-wireless-offline-symbolic',
             style_class: 'poster-wifi-icon', visible: false});
         status.add_child(this._wifi);
-        this._battery = new St.Widget({style_class: 'poster-battery',
-            layout_manager: new Clutter.FixedLayout()});
-        this._batteryFill = new St.Widget({style_class: 'poster-battery-fill',
-            x: 3.5, y: 3.5, height: 7});
-        this._battery.add_child(this._batteryFill);
+        // UPower owns the percentage and charging-state glyph. Use the same
+        // symbolic icon path as the other status controls instead of painting
+        // a fill actor over an SVG background at a different scale.
+        this._battery = new St.Icon({icon_name: 'battery-full-symbolic',
+            style_class: 'poster-battery', visible: false});
         status.add_child(this._battery);
         status.add_child(new St.Widget({style_class: 'poster-status-divider'}));
         status.add_child(powerButton);
@@ -476,11 +476,12 @@ class PosterCard extends St.BoxLayout {
 
     _syncBattery() {
         const proxy = this._powerProxy;
-        this._battery.visible = !!proxy?.IsPresent;
-        if (!this._battery.visible)
+        if (!proxy?.IsPresent) {
+            this._battery.visible = false;
             return;
-        const percentage = Math.max(0, Math.min(100, proxy.Percentage));
-        this._batteryFill.width = Math.round(21 * percentage / 100);
+        }
+        this._battery.icon_name = proxy.IconName || 'battery-full-symbolic';
+        this._battery.visible = true;
     }
 });
 
