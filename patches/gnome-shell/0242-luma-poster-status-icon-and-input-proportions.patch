+.poster-card.wide .prairie-login-submit-button { width: 48px; height: 48px; min-width: 48px; min-height: 48px; border-radius: 12px; }
+.poster-card.wide .prairie-login-submit-icon { icon-size: 18px; }
 .poster-card.compact { padding: 18px 16px; }
 .poster-card.compact .prairie-auth-card,
 .poster-card.compact .prairie-login-input-well { width: 276px; }
