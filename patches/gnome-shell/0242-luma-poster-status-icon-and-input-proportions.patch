-.poster-card.wide .prairie-login-submit-icon { icon-size: 22px; }
+.poster-card.wide .prairie-login-input-well { width: 460px; }
+.poster-card.wide .prairie-password-field { width: 400px; height: 48px; border-radius: 13px; }
