--- a/js/ui/mpris.js
+++ b/js/ui/mpris.js
@@ -91,7 +91,12 @@
     get canPause() { return Boolean(this._playerProxy?.CanPause); }
 
     raiseSource() {
-        if (this._mprisProxy?.CanRaise)
+        // A player with a window is brought forward by the compositor itself.
+        // Asking it over D-Bus to raise itself carries no activation token, so
+        // on Wayland the Shell announced "is ready" instead of showing it.
+        if (this._app?.get_windows().length > 0)
+            this._app.activate();
+        else if (this._mprisProxy?.CanRaise)
             this._mprisProxy.RaiseAsync().catch(logError);
         else
             this._app?.activate();
--- a/js/ui/panel.js
+++ b/js/ui/panel.js
@@ -472,13 +472,29 @@
     _openApplication() {
         if (!this._current)
             return;
-        const application = Gio.DesktopAppInfo.new(
+        // The Shell activates the application itself: a launch without an
+        // activation token only told a running application to raise, which
+        // Wayland turns into an "is ready" notification. Then the
+        // publication's own passive open action, when it has one, asks the
+        // application to show the thing described -- the event, not just the
+        // calendar.
+        const app = Shell.AppSystem.get_default().lookup_app(
             `${this._current.application_id}.desktop`);
-        try {
-            application?.launch([], null);
-        } catch (error) {
-            console.error(`Unable to open Live Extension application: ${error.message}`);
+        if (app) {
+            app.activate();
+        } else {
+            try {
+                Gio.DesktopAppInfo.new(`${this._current.application_id}.desktop`)
+                    ?.launch([], global.create_app_launch_context(0, -1));
+            } catch (error) {
+                console.error(`Unable to open Live Extension application: ${error.message}`);
+            }
         }
+        const open = (this._current.extension?.actions ?? []).find(action =>
+            action?.enabled && action.risk === 'passive' &&
+            typeof action.id === 'string' && action.id.endsWith('.open'));
+        if (open)
+            this._invokeAction(open);
     }
 });
 
