@@ -811,6 +823,17 @@
             });
         }
         this._workAreaTracked = enabled;
+        this._syncWorkAreaInset(St.ThemeContext.get_for_stage(global.stage).scale_factor);
+    }
+
+    // The floating shelf keeps a margin on its monitor's edges through struts.
+    // Mutter ignores struts on an edge shared with another monitor, and other
+    // monitors have none, so maximized and tiled windows there touched the
+    // screen edges. The same margin now applies to every monitor edge that no
+    // strut pads.
+    _syncWorkAreaInset(scale) {
+        const inset = this._workAreaTracked && !this._protrude ? Math.round(this._padding * scale) : 0;
+        global.display.set_work_area_inset?.(inset);
     }
 
