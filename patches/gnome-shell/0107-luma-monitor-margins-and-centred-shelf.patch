         this._protrude = this._settings.get_string('shelf-edge-mode') === 'protruding';
         this._span = this._settings.get_boolean('shelf-span-full');
+        this._group._fitsContent = !this._span;
+        this._group._lengthChanged ??= () => this._queueDockWidth();
         this._floatEnds = this._settings.get_boolean('shelf-float-ends');
         this._group._vertical = this._vertical;
