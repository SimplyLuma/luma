+/* Luma Quick Options. GNOME Shell/St presenter of the shared OS controls.
+ * Design Center dark/mosaic final cascade, measured at zoom 1: 420 x 372.
+ * Shared tokens: Figtree 14/13/11, window radius 15, island 10,
+ * compact/standard controls 28/36, standard icon 18, spacing 8/12.
+ * St adds padding and border to CSS sizes; values below are CONTENT sizes.
+ * Native runtime geometry and compositor comparison remain release gates.
+ */
+$q-bg: if($variant == 'light', #f1f2f3, #21252b);
+$q-raised: if($variant == 'light', #fff, #2a2f36);
+$q-ink: if($variant == 'light', #30343a, #e9ebec);
+$q-muted: if($variant == 'light', #767b81, #969da4);
+$q-line: if($variant == 'light', rgba(35,39,45,.09), rgba(255,255,255,.075));
+$q-control: if($variant == 'light', rgba(35,44,52,.072), rgba(255,255,255,.072));
+$q-hover: if($variant == 'light', rgba(35,44,52,.115), rgba(255,255,255,.12));
+$q-active: if($variant == 'light', #31373e, #e6e9eb);
+$q-active-ink: if($variant == 'light', #fff, #242a30);
+$q-state: if($variant == 'light', rgba(35,44,52,.105), rgba(255,255,255,.115));
+$q-state-line: if($variant == 'light', rgba(35,44,52,.18), rgba(255,255,255,.17));
+@if $contrast == 'high' {
+  $q-line: $q-ink;
+  $q-state-line: $q-ink;
+  $q-muted: $q-ink;
+}
+
+.luma-quick-options {
+  width: 384px;
+  padding: 17px;
+  spacing: 0;
+  border-radius: 15px;
+  border: 1px solid if($variant == 'light', rgba(255,255,255,.72), rgba(255,255,255,.055));
+  background-color: $q-bg;
+  color: $q-ink;
+  font-family: Figtree;
+  box-shadow: 0 5px 16px rgba(0,0,0,if($variant == 'light', .2, .38));
+}
+// Wide native BoxPointer layer supplied by the scoped menu patch.
+.luma-quick-options-popup .luma-popup-shadow {
+  border-radius: 15px; background-color: $q-bg;
+  box-shadow: if($variant == 'light', 0 34px 84px -24px rgba(14,18,24,.62), 0 38px 94px -26px rgba(0,0,0,.88));
+}
+.luma-quick-header {
+  height: 25px;
+  padding: 0 2px 13px;
+  border: 0 solid $q-line; border-bottom-width: 1px;
+}
+.luma-quick-when { spacing: 9px; }
+.luma-quick-time { font-size: 14px; font-weight: 750; color: $q-ink; }
+.luma-quick-date { font-size: 13px; font-weight: 400; color: $q-muted; }
+.luma-quick-battery { padding: 0 2px; spacing: 5px; }
+.luma-quick-battery-icon { icon-size: 19px; color: $q-ink; }
+.luma-quick-battery-label { font-size: 13px; font-weight: 700; color: $q-ink; }
+.luma-quick-options .quick-settings-grid { padding-top: 16px; spacing-rows: 0; spacing-columns: 8px; }
+
+.luma-quick-options .quick-toggle,
+.luma-quick-options .quick-toggle-has-menu {
+  min-width: 0; max-width: auto; min-height: 0;
+  height: 62px; padding: 0; margin: 0 0 10px;
+  border: 1px solid $q-line; border-radius: 10px;
+  background-color: $q-control; color: $q-ink;
+  box-shadow: none;
+  &:hover { background-color: $q-hover; }
+}
+.luma-quick-options .quick-toggle > StBoxLayout {
+  padding: 0 7px; spacing: 10px;
+}
+.luma-quick-options .quick-toggle .quick-toggle-icon {
+  width: 36px; height: 36px; icon-size: 18px;
+  border-radius: 10px; background-color: $q-raised; color: $q-muted;
+}
+.luma-quick-options .quick-toggle:checked .quick-toggle-icon {
+  background-color: if($variant == 'light', #343a40, rgba(255,255,255,.88));
+  color: $q-active-ink;
+}
+.luma-quick-options .quick-toggle-title { font-size: 13px; font-weight: 700; color: inherit; }
+.luma-quick-options .quick-toggle-subtitle { font-size: 11px; font-weight: 500; color: $q-muted; padding-top: 2px; }
+.luma-quick-options .quick-toggle-has-menu .quick-toggle {
+  height: 62px; margin: 0; border: 0; border-radius: 10px;
+  background-color: transparent; box-shadow: none;
+  > StBoxLayout { padding: 0 7px; spacing: 10px; }
+}
+.luma-quick-options .quick-toggle-has-menu .quick-toggle-separator { width: 0; background-color: transparent; }
+.luma-quick-options .quick-toggle-has-menu .quick-toggle-menu-button {
+  width: 28px; height: 28px; min-width: 0; min-height: 0;
+  padding: 0; margin: 0 7px 0 0;
+  border: 1px solid $q-line; border-radius: 10px;
+  background-color: $q-raised; color: $q-ink; icon-size: 14px;
+  box-shadow: 0 2px 5px rgba(20,27,34,.11);
+  &:hover { background-color: $q-hover; }
+  &:rtl { margin: 0 0 0 7px; }
+}
+.luma-quick-utility-row { padding: 0 0 10px; border: 0 solid $q-line; border-bottom-width: 1px; }
+.luma-quick-utility-box { spacing: 8px; }
+.luma-quick-options .quick-toggle.luma-quick-pill {
+  height: 42px; margin: 0; padding: 0;
+  color: $q-muted;
+  > StBoxLayout { padding: 0 11px; spacing: 9px; }
+  .quick-toggle-icon { width: 18px; height: 18px; icon-size: 18px; border-radius: 0; background-color: transparent; color: inherit; }
+  &:checked { background-color: $q-state; border-color: $q-state-line; color: if($variant == 'light', #303840, #f1f3f4); }
+  &:checked .quick-toggle-icon { background-color: transparent; color: inherit; }
+}
+.luma-quick-options .quick-slider {
+  height: 38px; min-height: 0; padding: 6px 2px; border: 0;
+  border-radius: 0; background-color: transparent;
+  > StBoxLayout { spacing: 12px; }
+  .icon-button { width: 28px; height: 28px; min-width: 0; min-height: 0; padding: 0; border: 0; border-radius: 99px; background-color: $q-control; color: $q-muted; icon-size: 14px; }
+  .slider-bin { padding: 0; }
+}
+.luma-quick-options .quick-slider.luma-quick-volume { height: 37px; border-top: 1px solid $q-line; }
+.luma-quick-level-copy { width: 82px; spacing: 0; }
+.luma-quick-level-title { font-size: 13px; font-weight: 700; color: $q-ink; }
+.luma-quick-level-value { font-size: 11px; font-weight: 400; color: $q-muted; }
+.luma-quick-options .slider {
+  height: 20px; color: $q-active;
+  -barlevel-height: 5px;
+  -barlevel-background-color: $q-control;
+  -barlevel-active-background-color: $q-active;
+  -slider-handle-radius: 8px;
+  -slider-handle-border-width: 2px;
+  -slider-handle-border-color: $q-bg;
+}
+.luma-quick-options .quick-settings-system-item { padding: 0; margin-top: 14px; }
+.luma-quick-options .quick-settings-system-item > StBoxLayout { spacing: 8px; }
+.luma-quick-footer { height: 38px; spacing: 8px; padding: 0; }
+.luma-quick-identity { height: 36px; padding: 0 11px 0 3px; border: 1px solid $q-line; border-radius: 99px; background-color: $q-control; color: $q-ink; }
+.luma-quick-identity-box { spacing: 9px; }
+.luma-quick-avatar { width: 30px; height: 30px; border-radius: 99px; background-color: $q-active; color: $q-active-ink; }
+.luma-quick-avatar .prairie-login-avatar-initial { font-size: 13px; font-weight: 700; }
+.luma-quick-identity-name { font-size: 13px; font-weight: 650; color: $q-ink; }
+.luma-quick-identity-role { font-size: 11px; font-weight: 550; color: $q-muted; }
+.luma-quick-actions { spacing: 8px; }
+.luma-quick-options .luma-quick-action {
+  width: 34px; height: 34px; min-width: 0; min-height: 0; padding: 0;
+  border: 1px solid $q-line; border-radius: 99px; background-color: $q-control;
+  color: $q-ink; icon-size: 18px;
+  &:hover { background-color: $q-hover; }
+}
+.luma-quick-options .luma-quick-action StIcon { icon-size: 18px; }
+.luma-quick-options .luma-quick-actions > StButton:last-child:hover { background-color: #a64d52; color: #fff; }
+.luma-quick-options StButton:focus,
+.luma-quick-options .slider-bin:focus { box-shadow: 0 0 0 2px $q-active; }
+.luma-quick-options StButton:insensitive { color: $q-muted; }
+.quick-toggle-menu.luma-quick-detail {
+  margin: 0; padding: 9px; border: 1px solid $q-line; border-radius: 10px;
+  background-color: $q-raised; color: $q-ink;
+  .header { padding-bottom: 0; spacing-columns: 8px; }
+  .header .icon { icon-size: 18px; padding: 0; background-color: transparent; }
+  .header .title { font-size: 13px; font-weight: 700; }
+  .header .subtitle { font-size: 11px; color: $q-muted; }
+  .popup-menu-item { min-height: 0; height: 30px; padding: 6px 10px; border-radius: 10px; font-size: 13px; }
+}
