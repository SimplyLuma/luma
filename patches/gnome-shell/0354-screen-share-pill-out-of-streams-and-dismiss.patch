+.luma-share-pill-dismiss:focus { box-shadow: inset 0 0 0 2px rgba(48, 52, 58, 0.6) !important; }
+.luma-surface-dark .luma-share-pill-dismiss { background-color: rgba(255, 255, 255, 0.072); color: #e9ebec; }
+.luma-surface-dark .luma-share-pill-dismiss:hover { background-color: rgba(255, 255, 255, 0.12); }
