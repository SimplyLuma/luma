diff --git a/js/ui/lumaCapture.js b/js/ui/lumaCapture.js
index ae8e12e..5a71d7e 100644
--- a/js/ui/lumaCapture.js
+++ b/js/ui/lumaCapture.js
@@ -100,11 +100,21 @@ export function setPaintInCaptures(paint) {
 }
 
 // Whether this paint is the screen itself rather than a screenshot or
-// recording of it (see the comment at the top). Only for actors with no
-// offscreen-redirected ancestor, whose paint goes straight to a view.
+// recording of it (see the comment at the top). A capture marks its own
+// paint (CLUTTER_PAINT_FLAG_CAPTURE: Mutter's screen casts and
+// Shell.Screenshot), so the answer no longer depends on which framebuffer a
+// paint lands in: the screen's paint went to an offscreen whenever an
+// ancestor was redirected (an effect, an animation), and the actor vanished
+// from the screen for those frames.
+const CAPTURE_FLAG = Clutter.PaintFlag.CAPTURE;
+
 export function paintsOnScreen(paintContext) {
     if (paintInCaptures)
         return true;
+    if (CAPTURE_FLAG !== undefined)
+        return !(paintContext.get_paint_flags() & CAPTURE_FLAG);
+    // A Mutter without the flag: only actors with no offscreen-redirected
+    // ancestor, whose paint goes straight to a view, can tell.
     const framebuffer = paintContext.get_framebuffer();
     return global.stage.peek_stage_views().some(view =>
         view.get_framebuffer() === framebuffer || view.get_onscreen() === framebuffer);
@@ -113,8 +123,34 @@ export function paintsOnScreen(paintContext) {
 // Only an actor's children and content are held back: its own background,
 // border and effects are painted around paint(), so everything a
 // CaptureHidden shows is drawn by a child, never styled on itself.
+//
+// A monitor stream normally copies what is on the screen (a blit of the
+// view, or of the scanout buffer), which would carry these actors with it.
+// While one of them is on the screen, captures paint the stage themselves
+// instead (clutter_stage_inhibit_capture_copy, Mutter 0036), and the paint
+// carries the capture flag they skip.
+function holdCaptureCopies(actor, hold) {
+    if (!global.stage.inhibit_capture_copy || actor._lumaHoldsCaptureCopies === hold)
+        return;
+    actor._lumaHoldsCaptureCopies = hold;
+    if (hold)
+        global.stage.inhibit_capture_copy();
+    else
+        global.stage.uninhibit_capture_copy();
+}
+
 export const CaptureHidden = GObject.registerClass(
 class CaptureHidden extends St.Widget {
+    vfunc_map() {
+        super.vfunc_map();
+        holdCaptureCopies(this, true);
+    }
+
+    vfunc_unmap() {
+        holdCaptureCopies(this, false);
+        super.vfunc_unmap();
+    }
+
     vfunc_paint(paintContext) {
         if (paintsOnScreen(paintContext))
             super.vfunc_paint(paintContext);
@@ -433,6 +469,17 @@ class ShelfSurface extends St.Widget {
         });
     }
 
+    vfunc_map() {
+        super.vfunc_map();
+        if (this._onScreenOnly)
+            holdCaptureCopies(this, true);
+    }
+
+    vfunc_unmap() {
+        holdCaptureCopies(this, false);
+        super.vfunc_unmap();
+    }
+
     vfunc_paint(paintContext) {
         if (!this._onScreenOnly || paintsOnScreen(paintContext))
             super.vfunc_paint(paintContext);
