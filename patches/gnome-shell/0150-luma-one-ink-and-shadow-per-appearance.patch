+// The ink ledger is the one place Luma says what colour its chrome writes in,
+// so it is the one place worth gating. Every veil the ledger paints, with
+// every ink role it offers, has to clear WCAG AA over the two extremes a
+// wallpaper can present: pure white and pure black. Any real wallpaper pixel
+// lies between those, so clearing both clears every wallpaper.
+//
+// The shadow is discounted here. It measurably helps -- the probe that
+// produced these tokens reads the shadow as painted -- but a test that leans
+// on it would pass a token pair that only works where the shadow lands.
+
+import {
+    SURFACE_INK, INK_MINIMUM, LARGE_MINIMUM,
+} from 'resource:///org/gnome/shell/ui/lumaSurfaceMaterials.js';
+
+function parse(colour) {
+    const hex = /^#([0-9a-f]{6})$/i.exec(colour);
+    if (hex) {
+        const n = parseInt(hex[1], 16);
+        return [(n >> 16) & 255, (n >> 8) & 255, n & 255, 1];
+    }
+    const rgba =
+        /^rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*(?:,\s*([\d.]+)\s*)?\)$/
+        .exec(colour);
+    if (!rgba)
+        throw new Error(`Unparsable ledger colour ${colour}`);
+    return [
+        Number(rgba[1]), Number(rgba[2]), Number(rgba[3]),
+        rgba[4] === undefined ? 1 : Number(rgba[4]),
+    ];
+}
+
+function over(top, bottom) {
+    const [r, g, b, a] = top;
+    return [
+        r * a + bottom[0] * (1 - a),
+        g * a + bottom[1] * (1 - a),
+        b * a + bottom[2] * (1 - a),
+        1,
+    ];
+}
+
+function luminance([r, g, b]) {
+    const lin = v => {
+        v /= 255;
+        return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
+    };
+    return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
+}
+
+function contrast(a, b) {
+    const la = luminance(a), lb = luminance(b);
+    return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
+}
+
+const WHITE = [255, 255, 255, 1];
+const BLACK = [0, 0, 0, 1];
+const BACKDROPS = {'plain white': WHITE, 'plain black': BLACK};
+const VEILS = ['veil', 'veilRaised', 'veilCard'];
+const MODES = ['light', 'dark', 'frost', 'glass'];
+
+// The ratio of one ink role on one veil over one backdrop, rounded the way the
+// report rounds it so a failure message reads like the measured table.
+// `stack` is the state fills painted on top of the veil, innermost first: the
+// Well's recess, then hover or press. They matter because on a translucent
+// veil a lifting state fill costs white-ink contrast, so the budget has to
+// hold for the worst stack a target can present, not for the resting surface.
+function ratio(mode, veilRole, inkRole, backdrop, stack = []) {
+    const tokens = SURFACE_INK[mode];
+    let surface = over(parse(tokens[veilRole]), backdrop);
+    for (const role of stack)
+        surface = over(parse(tokens[role]), surface);
+    const ink = over(parse(tokens[inkRole]), surface);
+    return Math.round(contrast(ink, surface) * 100) / 100;
+}
+
+// Every stack a shelf target can actually present.
+const STACKS = [
+    [],
+    ['hover'],
+    ['press'],
+    ['recess'],
+    ['recess', 'hover'],
+    ['recess', 'press'],
+];
+
+describe('Luma surface ink ledger', () => {
+    it('offers every role for every appearance mode', () => {
+        for (const mode of MODES) {
+            const tokens = SURFACE_INK[mode];
+            expect(tokens).toBeDefined();
+            for (const role of [...VEILS, 'recess', 'ink', 'ink2', 'accent',
+                'line', 'hover', 'press'])
+                expect(typeof tokens[role]).toEqual('string');
+            expect('shadow' in tokens).toBeTrue();
+        }
+    });
+
+    it('keeps body text at or above AA in every state over both extremes', () => {
+        for (const mode of MODES) {
+            for (const veil of VEILS) {
+                for (const stack of STACKS) {
+                    for (const [name, backdrop] of Object.entries(BACKDROPS)) {
+                        for (const ink of ['ink', 'ink2']) {
+                            const got =
+                                ratio(mode, veil, ink, backdrop, stack);
+                            if (got < INK_MINIMUM) {
+                                throw new Error(
+                                    `${mode}.${ink} on ${mode}.${veil}` +
+                                    `${stack.map(s => `+${s}`).join('')} over ` +
+                                    `${name} is ${got}:1, below ` +
+                                    `${INK_MINIMUM}:1`);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    });
+
+    it('keeps the accent glyph at or above the large-text minimum', () => {
+        for (const mode of MODES) {
+            for (const veil of VEILS) {
+                for (const stack of STACKS) {
+                    for (const [name, backdrop] of Object.entries(BACKDROPS)) {
+                        const got =
+                            ratio(mode, veil, 'accent', backdrop, stack);
+                        if (got < LARGE_MINIMUM) {
+                            throw new Error(
+                                `${mode}.accent on ${mode}.${veil}` +
+                                `${stack.map(s => `+${s}`).join('')} over ` +
+                                `${name} is ${got}:1, below ` +
+                                `${LARGE_MINIMUM}:1`);
+                        }
+                    }
+                }
+            }
+        }
+    });
+
+    it('keeps a lifting state fill within the veil\'s budget', () => {
+        // This is the failure mode worth naming: a hover or pressed fill that
+        // lifts a translucent veil spends white-ink contrast, so a veil sized
+        // only for its resting state fails the moment it is touched. Pressed
+        // must stay at or above AA, not merely close to it.
+        for (const mode of ['frost', 'glass']) {
+            const rest = ratio(mode, 'veil', 'ink2', WHITE);
+            const pressed =
+                ratio(mode, 'veil', 'ink2', WHITE, ['recess', 'press']);
+            expect(rest).toBeGreaterThanOrEqual(INK_MINIMUM);
+            expect(pressed).toBeGreaterThanOrEqual(INK_MINIMUM);
+        }
+    });
+
+    it('shadows the translucent modes and only those', () => {
+        // There is no wallpaper behind an opaque veil, so a shadow there is
+        // decoration that smears the ink.
+        expect(SURFACE_INK.light.shadow).toBeNull();
+        expect(SURFACE_INK.dark.shadow).toBeNull();
+        for (const mode of ['frost', 'glass']) {
+            expect(SURFACE_INK[mode].shadow)
+                .toMatch(/^\d+ \d+px \d+px rgba\(/);
+        }
+    });
+
+    it('refuses white ink where the veil cannot carry it', () => {
+        // The owner asked for white ink in every mode. It measures 1.12:1 on
+        // opaque paper and does not reach AA under any shadow, so paper keeps
+        // dark ink; this pins that decision to its number.
+        const paper = over(parse(SURFACE_INK.light.veil), WHITE);
+        expect(contrast([255, 255, 255], paper)).toBeLessThan(INK_MINIMUM);
+        expect(contrast(parse(SURFACE_INK.light.ink), paper))
+            .toBeGreaterThan(INK_MINIMUM);
+    });
+
+    it('carries white ink on both smoked veils', () => {
+        for (const mode of ['frost', 'glass'])
+            expect(SURFACE_INK[mode].ink).toEqual('#ffffff');
+    });
+});
