--- /dev/null
+++ b/data/theme/verify-treatment-ink.py
@@ -0,0 +1,265 @@
+#!/usr/bin/python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check that no stylesheet writes a treatment's ink in the wrong direction.
+
+The ink ledger in js/ui/lumaSurfaceMaterials.js is gated by
+tests/unit/lumaSurfaceInk.js, but that gate only covers the ledger's own
+values. It does not cover the stylesheets that spend them, and those are where
+the mistake actually happens: the light and dark treatments were authored
+grouped with frost and glass, so a value edited for the smoked family lands on
+the opaque one too. That shipped once -- white ink leaked onto the opaque light
+shelf through a selector list it shared with frost, which is the exact failure
+the ledger exists to prevent, and no test saw it. The same edit dissolved the
+light plate under the Stop pill and left its dark ink on the veil.
+
+The invariant here is the one that would have caught both, and it needs no
+knowledge of the design: an opaque light surface must never be given near-white
+ink, and a smoked surface must never be left with near-black ink unless the
+rule lays down a light plate of its own for that ink to sit on. Anything
+between those bounds is a judgement call and is left alone.
+"""
+
+import re
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+# Every Luma stylesheet that styles a smoked treatment, found rather than
+# listed. A hand-kept list left luma-capture.css unchecked after 0150 began
+# re-tinting it, and made it easy to believe a sheet was covered when it was
+# not. A sheet that appears later in the series (the sharing picker's, from
+# 0149) is checked whenever it is present.
+SHEETS = sorted(
+    p.name for p in HERE.glob("luma-*.css")
+    if "luma-surface-frost" in p.read_text(encoding="utf-8")
+    or "luma-surface-glass" in p.read_text(encoding="utf-8"))
+
+# A direction check, not a contrast check, so both bounds are loose.
+TOO_LIGHT_FOR_PAPER = 0.55
+TOO_DARK_FOR_SMOKED = 0.12
+# Below this a fill is a wash over the veil, not a plate of its own.
+PLATE_ALPHA = 0.35
+
+LIGHT = "luma-surface-light"
+SMOKED = ("luma-surface-frost", "luma-surface-glass")
+
+HEX = re.compile(r"#([0-9a-fA-F]{6})\Z")
+RGBA = re.compile(
+    r"rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*(?:,\s*([\d.]+)\s*)?\)\Z")
+
+
+def parse(colour):
+    """(luminance, alpha) for a hex or rgb/rgba literal, or (None, None)."""
+    text = colour.strip()
+    hexen = HEX.match(text)
+    if hexen:
+        raw = int(hexen.group(1), 16)
+        rgb, alpha = ((raw >> 16) & 255, (raw >> 8) & 255, raw & 255), 1.0
+    else:
+        m = RGBA.match(text)
+        if not m:
+            return None, None
+        rgb = tuple(int(m.group(i)) for i in (1, 2, 3))
+        alpha = float(m.group(4)) if m.group(4) else 1.0
+
+    def lin(v):
+        v /= 255.0
+        return v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4
+
+    lum = 0.2126 * lin(rgb[0]) + 0.7152 * lin(rgb[1]) + 0.0722 * lin(rgb[2])
+    return lum, alpha
+
+
+def rules(css):
+    out, i = [], 0
+    while True:
+        start = css.find("{", i)
+        if start < 0:
+            return out
+        end = css.find("}", start)
+        if end < 0:
+            return out
+        out.append((css[i:start], css[start + 1:end]))
+        i = end + 1
+
+
+def declared(body, wanted):
+    for prop, value in re.findall(r"([-a-z]+)\s*:\s*([^;}]+)", body):
+        if prop == wanted:
+            yield value.strip()
+
+
+def paints_its_own_dark_plate(body):
+    """True if the rule lays down a dark fill for its own light ink.
+
+    The mirror of paints_its_own_plate: a primary button on opaque paper
+    (Cast's Start, a dialog's default button) carries white ink on a dark
+    plate it paints itself, which is correct, not a leak.
+    """
+    for value in declared(body, "background-color"):
+        lum, alpha = parse(value)
+        if lum is None:
+            continue
+        if lum < TOO_DARK_FOR_SMOKED and alpha >= PLATE_ALPHA:
+            return True
+    return False
+
+
+# A rule can carry ink that sits on a plate a *parent* element paints -- a
+# label inside a filled button -- which no single-rule check can see. Such a
+# rule is waived only by saying so in a comment directly above it, naming
+# the plate, so every waiver is visible in review and greppable:
+#   /* ink-guard: on-plate .luma-capture-go */
+WAIVER = "ink-guard: on-plate"
+
+
+def paints_its_own_plate(body):
+    """True if the rule lays down a light fill for its own ink to sit on.
+
+    A filled primary control -- Allow, Share, the Stop pill, a checked toggle
+    -- keeps a light plate on a smoked veil, and its dark ink belongs to that
+    plate, not to the veil. The alpha floor is what separates a real plate from
+    the wash a careless re-tint once dissolved one into.
+    """
+    for value in declared(body, "background-color"):
+        lum, alpha = parse(value)
+        if lum is None:
+            continue
+        if lum > TOO_LIGHT_FOR_PAPER and alpha >= PLATE_ALPHA:
+            return True
+    return False
+
+
+CLASS_STATE = re.compile(
+    r"^(\.[a-z0-9-]+)((?::[a-z-]+)+)?$", re.I)
+
+
+def class_and_state(simple_selector):
+    """The last compound selector's base class and its pseudo-class suffix.
+
+    ".luma-surface-frost .luma-seal-allow:hover" -> (".luma-seal-allow",
+    ":hover"). Anything not shaped like class + optional pseudo-classes
+    (an id, a descendant combinator inside the compound, a type selector)
+    returns (None, None) and is skipped -- this check only needs to catch
+    the pattern that actually shipped, not model all of CSS.
+    """
+    last = simple_selector.strip().split()[-1] if simple_selector.strip() \
+        else ""
+    m = CLASS_STATE.match(last)
+    if not m:
+        return None, None
+    return m.group(1), m.group(2) or ""
+
+
+def find_state_leaks(sheets_text):
+    """A filled control's dark label survives into a state its dark fill
+    was never re-tinted for.
+
+    The shape: a base rule paints dark ink on a light plate (the button is
+    "on"); a state rule for the same class -- :hover, :checked, :active --
+    sets a near-black background with no frost or glass override, so on a
+    smoked treatment the state fill goes dark under ink that is still dark,
+    and the label disappears. This is a cross-rule check that `main`'s
+    per-rule pass cannot make: the light plate and the dark state fill are
+    two different rules, and neither one is wrong on its own.
+    """
+    problems = []
+    for name, text in sheets_text:
+        by_class = {}
+        for head, body in rules(text):
+            for sel in [s.strip() for s in head.split(",") if s.strip()]:
+                cls, state = class_and_state(sel)
+                if cls is None:
+                    continue
+                treatment = next((t for t in (LIGHT,) + SMOKED if t in sel),
+                                 None)
+                by_class.setdefault(cls, []).append(
+                    (state, treatment, body, sel))
+
+        for cls, entries in by_class.items():
+            base_inks = [b for st, tr, b, _ in entries
+                        if st == "" and tr is None]
+            dark_label = any(
+                (parse(v)[0] or 1) < TOO_DARK_FOR_SMOKED
+                and (parse(v)[1] or 0) >= 0.5
+                for b in base_inks for v in declared(b, "color"))
+            if not dark_label:
+                continue
+
+            for st, tr, body, sel in entries:
+                if not st or tr is not None:
+                    continue                     # only unqualified states
+                for value in declared(body, "background-color"):
+                    lum, alpha = parse(value)
+                    if lum is None or alpha < PLATE_ALPHA:
+                        continue
+                    if lum >= TOO_DARK_FOR_SMOKED:
+                        continue
+                    has_override = any(
+                        st2 == st and tr2 in SMOKED
+                        for st2, tr2, _, _ in entries)
+                    if not has_override:
+                        problems.append(
+                            f"{name}: {sel}\n    {cls} carries dark ink at "
+                            f"rest, and this state ({st}) fills near-black "
+                            f"with no frost/glass override -- the label "
+                            f"disappears on a smoked veil in this state: "
+                            f"background-color: {value}")
+    return problems
+
+
+def main():
+    problems = []
+    sheets_text = []
+    for name in SHEETS:
+        path = HERE / name
+        if not path.exists():
+            continue
+        text = path.read_text(encoding="utf-8")
+        sheets_text.append((name, text))
+        for head, body in rules(text):
+            selectors = [s.strip() for s in head.split(",") if s.strip()]
+            if not selectors:
+                continue
+            has_light = any(LIGHT in s for s in selectors)
+            has_smoked = any(t in s for s in selectors for t in SMOKED)
+            if not (has_light or has_smoked):
+                continue
+            plated = paints_its_own_plate(body)
+            dark_plated = paints_its_own_dark_plate(body)
+            waived = WAIVER in head
+            # WCAG 1.4.3 exempts inactive controls from contrast minimums, so
+            # a disabled state is not held to the direction check either.
+            if all(":insensitive" in sel or ":disabled" in sel
+                   for sel in selectors):
+                continue
+            for value in declared(body, "color"):
+                lum, alpha = parse(value)
+                # A mostly transparent ink says nothing about its direction.
+                if lum is None or alpha < 0.5:
+                    continue
+                where = f"{name}: {selectors[-1][:70]}"
+                if has_light and lum > TOO_LIGHT_FOR_PAPER and not dark_plated:
+                    problems.append(
+                        f"{where}\n    {LIGHT} is opaque paper and cannot "
+                        f"carry near-white ink: color: {value}")
+                if (has_smoked and not has_light and not plated
+                        and not waived and lum < TOO_DARK_FOR_SMOKED):
+                    problems.append(
+                        f"{where}\n    a smoked veil cannot carry near-black "
+                        f"ink, and this rule lays down no light plate for it "
+                        f"to sit on: color: {value}")
+
+    problems.extend(find_state_leaks(sheets_text))
+
+    if problems:
+        print("FAIL: ink written against its treatment's direction")
+        for p in problems:
+            print("  " + p)
+        return 1
+    print("PASS: every treatment's ink runs in its own direction")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
