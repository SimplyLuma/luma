diff --git a/js/ui/mediaSelection.js b/js/ui/mediaSelection.js
--- a/js/ui/mediaSelection.js
+++ b/js/ui/mediaSelection.js
@@ -44,8 +44,17 @@
 
 // Media's boundary with status is fixed; spare space belongs to other gaps.
 export function shelfGaps(children, media, status, gap, spare = 0) {
-    const pinned = children.findIndex((child, index) => child === media && children[index + 1] === status);
-    const flexible = Math.max(0, children.length - 1 - Number(pinned >= 0));
-    return children.slice(0, -1).map((_child, index) => index === pinned
+    // The status cluster is anchored at the end of the shelf, so whatever sits
+    // immediately before it belongs against it: one padding away, with the
+    // slack spent on the gaps further back. Only the media island used to be
+    // treated that way, by name. A live extension island landing in that same
+    // position was handed an even share of the leftover space on both sides
+    // instead, which is why it read as floating loose between the dock and the
+    // clock rather than belonging to the clock. Pinning by position covers the
+    // media island exactly as before and anything else that lands there.
+    const beforeStatus = children.indexOf(status) - 1;
+    const gaps = children.slice(0, -1);
+    const flexible = gaps.length - (beforeStatus >= 0 ? 1 : 0);
+    return gaps.map((_child, index) => index === beforeStatus
         ? gap : gap + (flexible ? spare / flexible : 0));
 }
