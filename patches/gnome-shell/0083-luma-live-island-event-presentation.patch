+    // A start is stated in ISO 8601 or not at all. An unparseable one leaves
+    // the badge and the time hidden rather than guessed at, because a badge
+    // showing the wrong day is worse than an island without one.
+    _setSchedule(startsAt) {
+        const parsed = typeof startsAt === 'string'
+            ? GLib.DateTime.new_from_iso8601(startsAt, null) : null;
+        const local = parsed?.to_local() ?? null;
+        if (local) {
+            this._badgeMonth.text = local.format('%b').toLocaleUpperCase();
+            this._badgeDay.text = `${local.get_day_of_month()}`;
+            this._time.text = DateUtils.formatTime(local, {timeOnly: true});
+        }
+        this._badge.visible = local !== null;
+        this._time.visible = local !== null;
+        this._icon.visible = local === null;
+    }
+
+    // A lone passive action is the island's own gesture spelled a second time:
+    // clicking the island already opens the application, so a button that does
+    // no more than that is noise -- and with no icon mapped for it, it drew as
+    // an unexplained three-dot glyph. The controls the row exists for, the
+    // consequential and destructive ones, are untouched.
+    _shownActions(item) {
+        const actions = this._validActions(item);
+        if (actions.length === 1 && actions[0].risk === 'passive')
+            return [];
+        return actions;
+    }
+
     // An action is only renderable when the broker gave us everything needed
     // to invoke it later: the publication that owns it and a well formed
     // action record. Anything else is dropped rather than drawn as a control
