From: Project Luma <builds@project-luma.local>
Subject: [PATCH] status: the accessibility indicator ignores the screen keyboard and draws Lucide

The screen keyboard is how a touch device types, so it alone no longer puts
the accessibility figure in the top bar; any other accessibility setting
still does. The indicator draws LumaUI's Lucide accessibility glyph.

--- a/js/ui/status/accessibility.js
+++ b/js/ui/status/accessibility.js
@@ -36,7 +36,7 @@
 
         this.add_child(new St.Icon({
             style_class: 'system-status-icon',
-            icon_name: 'accessibility-menu-symbolic',
+            icon_name: 'lumaui-accessibility-symbolic',
         }));
 
         this._a11ySettings = new Gio.Settings({schema_id: A11Y_SCHEMA});
@@ -59,6 +59,7 @@
         const screenKeyboard = this._buildItem(_('Screen Keyboard'),
             APPLICATIONS_SCHEMA, 'screen-keyboard-enabled');
         this.menu.addMenuItem(screenKeyboard);
+        this._screenKeyboard = screenKeyboard;
 
         const visualBell = this._buildItem(_('Visual Alerts'),
             WM_SCHEMA, KEY_VISUAL_BELL);
@@ -93,7 +94,7 @@
         const alwaysShow = this._a11ySettings.get_boolean(KEY_ALWAYS_SHOW);
         const items = this.menu._getMenuItems();
 
-        this.visible = alwaysShow || items.some(f => !!f.state);
+        this.visible = alwaysShow || items.some(f => !!f.state && f !== this._screenKeyboard);
     }
 
     _queueSyncMenuVisibility() {
