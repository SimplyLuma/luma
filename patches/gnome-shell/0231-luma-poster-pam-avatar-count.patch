+// St.Label can allocate the verifier line at its natural width inside this
+// fixed-width card even when Pango wrapping is enabled. Add visual line breaks
+// without changing the verifier's words or the original accessibility notice.
+function wrapPosterVerifierMessage(message) {
+    return message.split('\n').map(line => {
+        const maxChars = /[\u1100-\u11ff\u2e80-\u9fff\uac00-\ud7af]/u.test(line)
+            ? 22 : /[\u0590-\u08ff]/u.test(line) ? 30 : 40;
+        const chars = Array.from(line);
+        const rows = [];
+        while (chars.length > maxChars) {
+            let breakAt = maxChars;
+            while (breakAt > 0 && !/\s/u.test(chars[breakAt]))
+                breakAt--;
+            if (breakAt === 0)
+                breakAt = maxChars;
+            rows.push(chars.splice(0, breakAt).join('').trimEnd());
+            while (chars[0] === ' ')
+                chars.shift();
+        }
+        rows.push(chars.join(''));
+        return rows.join('\n');
+    }).join('\n');
+}
