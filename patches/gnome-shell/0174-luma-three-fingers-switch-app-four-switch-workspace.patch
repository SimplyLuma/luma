+// Luma: how many fingers switch workspace, from the Luma settings, with
+// the Shell's own default if the schema is not installed.
+function lumaWorkspaceFingers() {
+    try {
+        const settings = new Gio.Settings({schema_id: 'org.project_luma.shell-state'});
+        const fingers = settings.get_int('touchpad-workspace-fingers');
+        if (fingers === 3 || fingers === 4)
+            return fingers;
+    } catch (e) {
+        // No Luma settings here: the Shell's own gesture, unchanged.
+    }
+    return 3;
+}
