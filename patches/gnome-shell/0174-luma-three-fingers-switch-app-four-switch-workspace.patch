+// Luma: the touchpad gesture defaults, written once. After that they are
+// the person's, and a later change of mind here does not overrule theirs.
+function lumaGestureSettings() {
+    let settings;
+    try {
+        settings = new Gio.Settings({schema_id: 'org.project_luma.shell-state'});
+    } catch (e) {
+        return null;
+    }
+
+    try {
+        if (settings.get_uint('touchpad-gesture-migration') < 1) {
+            settings.set_int('touchpad-workspace-fingers', 4);
+            settings.set_boolean('touchpad-app-switch', true);
+            settings.set_uint('touchpad-gesture-migration', 1);
+            log('[luma-gestures] four fingers switch workspace, three switch app');
+        }
+    } catch (e) {
+        logError(e, '[luma-gestures] the gesture defaults could not be written');
+    }
+
+    return settings;
+}
