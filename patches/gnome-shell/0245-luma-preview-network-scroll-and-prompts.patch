+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Shared native system prompts: the existing Luma material and Cast control
+ * geometry, applied by Dialog.Dialog. No authentication protocol lives here. */
+.modal-dialog.prompt-dialog.luma-system-prompt {
+  padding: 22px 22px 18px;
+  spacing: 18px;
+  border-radius: 15px;
+  border: 1px solid rgba(255,255,255,.10);
+  background-color: #21252b;
+  color: #e7e9e8;
+  font-family: Figtree, sans-serif;
+  box-shadow: 0 12px 28px rgba(0,0,0,.32); }
+.modal-dialog.prompt-dialog.luma-system-prompt .modal-dialog-content-box {
+  padding-top: 0; spacing: 16px; }
+.modal-dialog.prompt-dialog.luma-system-prompt .message-dialog-content {
+  spacing: 12px; }
+.modal-dialog.prompt-dialog.luma-system-prompt .message-dialog-title {
+  color: #e7e9e8; font-size: 20px; font-weight: 700; }
+.modal-dialog.prompt-dialog.luma-system-prompt .message-dialog-description {
+  color: #b8bec4; font-size: 13px; }
+.modal-dialog.prompt-dialog.luma-system-prompt .prompt-dialog-password-entry {
+  min-height: 22px; padding: 10px 12px; border-radius: 10px;
+  border: 1px solid rgba(255,255,255,.16);
+  background-color: #191d22; color: #e7e9e8;
+  font-size: 13px; box-shadow: inset 0 1px 2px rgba(0,0,0,.25); }
+.modal-dialog.prompt-dialog.luma-system-prompt .prompt-dialog-password-entry:focus {
+  border-color: #8a99a8;
+  box-shadow: inset 0 0 2px #8a99a8; }
+.modal-dialog.prompt-dialog.luma-system-prompt .prompt-dialog-password-entry StLabel.hint-text {
+  color: #b8bec4; }
+.modal-dialog.prompt-dialog.luma-system-prompt .modal-dialog-button-box {
+  padding-top: 0; spacing: 8px; }
+.modal-dialog.prompt-dialog.luma-system-prompt .modal-dialog-button {
+  min-height: 36px; padding: 0 18px; border-radius: 10px;
+  border: 1px solid rgba(255,255,255,.16);
+  background-color: #343a42; color: #e7e9e8;
+  font-size: 13px; font-weight: 700;
+  border-top-color: rgba(255,255,255,.24);
+  box-shadow: 0 2px 3px rgba(0,0,0,.18); }
+.modal-dialog.prompt-dialog.luma-system-prompt .modal-dialog-button:hover {
+  background-color: #424a54; }
+.modal-dialog.prompt-dialog.luma-system-prompt .modal-dialog-button:default {
+  border-color: rgba(255,255,255,.32);
+  background-color: #e6e9eb; color: #242a30; }
+.modal-dialog.prompt-dialog.luma-system-prompt .modal-dialog-button:default:hover {
+  background-color: #ffffff; }
+.modal-dialog.prompt-dialog.luma-system-prompt .modal-dialog-button:active {
+  box-shadow: inset 0 1px 2px rgba(0,0,0,.20); }
+.modal-dialog.prompt-dialog.luma-system-prompt .modal-dialog-button:focus {
+  border-color: #8a99a8; box-shadow: inset 0 0 2px #8a99a8; }
+.modal-dialog.prompt-dialog.luma-system-prompt .modal-dialog-button:insensitive {
+  background-color: #343a42; color: #b8bec4; box-shadow: none; }
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-light,
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-glass {
+  border-color: rgba(25,27,31,.16);
+  background-color: #f1f2f3; color: #34383d;
+  box-shadow: 0 12px 28px rgba(10,14,19,.26); }
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-light .message-dialog-title,
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-glass .message-dialog-title {
+  color: #34383d; }
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-light .message-dialog-description,
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-glass .message-dialog-description,
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-light .prompt-dialog-password-entry StLabel.hint-text,
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-glass .prompt-dialog-password-entry StLabel.hint-text {
+  color: #525b65; }
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-light .prompt-dialog-password-entry,
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-glass .prompt-dialog-password-entry {
+  border-color: rgba(25,27,31,.20);
+  background-color: #ffffff; color: #34383d;
+  box-shadow: inset 0 1px 2px rgba(25,27,31,.10); }
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-light .prompt-dialog-password-entry:focus,
