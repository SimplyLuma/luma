+  border-top-color: rgba(255,255,255,.80);
+  box-shadow: 0 2px 3px rgba(25,27,31,.12); }
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-light .modal-dialog-button:hover,
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-glass .modal-dialog-button:hover {
+  background-color: #f7f8f9; }
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-light .modal-dialog-button:default,
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-glass .modal-dialog-button:default {
+  border-color: rgba(25,27,31,.20);
+  background-color: #31373e; color: #ffffff; }
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-light .modal-dialog-button:default:hover,
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-glass .modal-dialog-button:default:hover {
+  background-color: #242a30; }
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-light .modal-dialog-button:focus,
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-glass .modal-dialog-button:focus {
+  border-color: #61728a; box-shadow: inset 0 0 2px #61728a; }
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-light .modal-dialog-button:insensitive,
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-surface-glass .modal-dialog-button:insensitive {
+  background-color: #e0e3e6; color: #525b65; box-shadow: none; }
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-prompt-high-contrast,
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-prompt-high-contrast .prompt-dialog-password-entry,
+.modal-dialog.prompt-dialog.luma-system-prompt.luma-prompt-high-contrast .modal-dialog-button {
