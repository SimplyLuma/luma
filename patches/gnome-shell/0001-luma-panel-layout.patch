+
+// Project Luma light chrome. This is compiled into the native Shell theme;
+// it is not a user-theme or runtime stylesheet override.
+@if $variant == 'light' {
+  #panel, #panel:overview {
+    background-color: #f2f3f5;
+    border: 0;
+    border-bottom: 1px solid rgba(17, 24, 39, 0.10);
+    box-shadow: none;
+    color: #374151;
+    font-weight: normal;
+
+    .panel-button {
+      -natural-hpadding: 0;
+      -minimum-hpadding: 0;
+      background-color: transparent;
+      border: 0;
+      border-radius: 8px;
+      box-shadow: none;
+      color: #374151;
+      font-weight: normal;
+
+      .system-status-icon {
+        -st-icon-style: symbolic;
+        icon-size: 16px;
+        margin: 0;
+        padding: 0;
+      }
+
+      .panel-status-indicators-box {
+        spacing: 12px;
+      }
+    }
+
+    #panelRight .panel-button {
+      -natural-hpadding: 8px;
+      -minimum-hpadding: 6px;
+      margin: 3px 1px;
+      padding: 0;
+      transition-duration: 120ms;
+
+      &:focus, &:hover {
+        background-color: rgba(120, 130, 145, 0.14);
+      }
+
+      &:active, &:checked {
+        background-color: rgba(120, 130, 145, 0.22);
+      }
+    }
+
+    .panel-button.clock-display {
+      background: none;
+      border: 0;
+      box-shadow: none;
+
+      .clock {
+        background-color: transparent;
+        border: 0;
+        border-radius: 8px;
+        box-shadow: none;
+        padding: 0 10px;
+      }
+
+      &:focus .clock, &:hover .clock {
+        background-color: rgba(15, 23, 42, 0.06);
+      }
+
+      &:active .clock, &:checked .clock {
+        background-color: rgba(72, 120, 184, 0.14);
+      }
+    }
+  }
+
+  .clock-display-box {
+    spacing: 0;
+  }
+
+  .luma-clock-content {
+    // The explicit 9px spacer actor owns the time/date gap.
+    spacing: 0;
+  }
+
+  .luma-clock-time {
+    color: #1f2937;
+    font-size: 12.5px;
+    font-weight: 600;
+    font-feature-settings: "tnum";
+    letter-spacing: -0.005em;
+  }
+
+  .luma-secondary-status-text {
+    color: #6b7280;
+    font-size: 11.5px;
+    font-weight: 500;
+  }
+
+  .messages-indicator {
+    min-width: 16px;
+    height: 16px;
+    padding: 0 2px;
+    border-radius: 5px;
+    background-color: #c2984e;
+    color: white;
+    font-size: 10px;
+    font-weight: 700;
+    font-feature-settings: "tnum";
+    text-align: center;
+  }
+}
