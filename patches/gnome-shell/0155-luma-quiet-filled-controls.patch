+# --------------------------------------------------------------------------
+# Filled controls (ADR-043) and the notification island, measured.
+#
+# The passes above check direction only. These two measure contrast, from the
+# ledgers themselves, over pure white and pure black for the smoked modes --
+# the two ends any wallpaper composites to -- with the text shadow discounted.
+
+JS = HERE.parent.parent / "js" / "ui"
+MODES = ("light", "dark", "frost", "glass")
+WHITE = (255, 255, 255, 1.0)
+BLACK = (0, 0, 0, 1.0)
+BODY_MINIMUM = 4.5
+GLYPH_MINIMUM = 3.0
+
+
+def js_ledger(path, name):
+    """{mode: {role: colour}} from `export const NAME = {...}` in a module."""
+    text = path.read_text(encoding="utf-8")
+    start = text.index(f"export const {name} = {{")
+    end = text.index("\n};", start)
+    body = text[start:end]
+    ledger = {}
+    for mode in MODES:
+        m = re.search(rf"\n    {mode}: {{(.*?)\n    }},", body, re.S)
+        if m:
+            ledger[mode] = dict(re.findall(r"(\w+): '([^']+)'", m.group(1)))
+    return ledger
+
+
+def grounds(mode, *fills):
+    """Each backdrop a mode can sit on, with `fills` stacked over it."""
+    for backdrop in ((WHITE, BLACK) if mode in ("frost", "glass") else (WHITE,)):
+        colour = backdrop
+        for fill in fills:
+            colour = over(rgba(fill), colour)
+        yield colour
+
+
+def check_filled_controls():
+    problems = []
+    control = js_ledger(JS / "lumaControlInk.js", "CONTROL_INK")
+    surface = js_ledger(JS / "lumaSurfaceMaterials.js", "SURFACE_INK")
+    sheet = HERE / "luma-controls.css"
+    text = re.sub(r"/\*.*?\*/", "", sheet.read_text(encoding="utf-8"),
+                  flags=re.S)
+
+    def need(label, value, minimum):
+        if value < minimum:
+            problems.append(f"luma-controls: {label}: {value:.2f} < {minimum}")
+
+    for mode in MODES:
+        c, s = control[mode], surface[mode]
+        state = over(rgba(c["state"]), WHITE)
+        need(f"{mode} state glyph on state",
+             ratio(over(rgba(c["stateInk"]), state), state), BODY_MINIMUM)
+        for veil in ("veil", "veilRaised"):
+            for ground in grounds(mode, s[veil]):
+                need(f"{mode} state vs {veil}", ratio(state, ground),
+                     GLYPH_MINIMUM)
+                need(f"{mode} knob ring vs {veil}",
+                     ratio(over(rgba(c["knobRing"]), WHITE), ground),
+                     GLYPH_MINIMUM)
+            # A tile is the control wash over the panel; its off plate sits
+            # on the tile. On must stand 3:1 from both.
+            for tile in grounds(mode, s[veil], c["control"]):
+                need(f"{mode} state vs tile on {veil}", ratio(state, tile),
+                     GLYPH_MINIMUM)
+                off = over(rgba(c["offPlate"]), tile)
+                need(f"{mode} state vs off plate on {veil}",
+                     ratio(state, off), GLYPH_MINIMUM)
+                for fill in (None, c["hover"]):
+                    ground = over(rgba(fill), tile) if fill else tile
+                    need(f"{mode} chevron and button ink on tile"
+                         f"{' hovered' if fill else ''} ({veil})",
+                         ratio(over(rgba(c["ink"]), ground), ground),
+                         BODY_MINIMUM)
+
+        # The sheet may spend only this mode's ledger values.
+        allowed = {rgba(v) for v in c.values()} | {(0, 0, 0, 0.0)}
+        for head, body in rules(text):
+            if f"luma-surface-{mode}" not in head:
+                continue
+            for value in re.findall(r"#[0-9a-fA-F]{6}|rgba?\([^)]*\)", body):
+                if rgba(value) not in allowed:
+                    problems.append(
+                        f"luma-controls.css: {head.strip()[:60]}\n    "
+                        f"{value} is not in CONTROL_INK.{mode}")
+    return problems
