+++ b/data/theme/verify-treatment-ink.py
@@ -113,6 +113,64 @@ def paints_its_own_dark_plate(body):
 WAIVER = "ink-guard: on-plate"
 
 
+# A St slider paints its handle in the rule's `color`, which is a fill, not
+# ink. Such a rule says so directly above itself and is measured instead by
+# the filled-control pass below:
+#   /* ink-guard: handle */
+HANDLE_WAIVER = "ink-guard: handle"
+
+# A fill its own ink clears at this ratio is a plate, whatever its lightness:
+# a filled control's state fill (ADR-043) is a mid slate on every treatment,
+# neither near-white nor near-black, and carries its own glyph colour.
+PLATE_INK_MINIMUM = 4.5
+
+
+def rgba(colour):
+    """(r, g, b, a) for a hex or rgb/rgba literal, or None."""
+    text = colour.strip()
+    hexen = HEX.match(text)
+    if hexen:
+        raw = int(hexen.group(1), 16)
+        return ((raw >> 16) & 255, (raw >> 8) & 255, raw & 255, 1.0)
+    m = RGBA.match(text)
+    if not m:
+        return None
+    return (int(m.group(1)), int(m.group(2)), int(m.group(3)),
+            float(m.group(4)) if m.group(4) else 1.0)
+
+
+def over(top, bottom):
+    r, g, b, a = top
+    return (r * a + bottom[0] * (1 - a), g * a + bottom[1] * (1 - a),
+            b * a + bottom[2] * (1 - a), 1.0)
+
+
+def luminance(c):
+    def lin(v):
+        v /= 255.0
+        return v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4
+    return 0.2126 * lin(c[0]) + 0.7152 * lin(c[1]) + 0.0722 * lin(c[2])
+
+
+def ratio(a, b):
+    la, lb = luminance(a), luminance(b)
+    return (max(la, lb) + 0.05) / (min(la, lb) + 0.05)
+
+
+def plate_carries_ink(body, ink):
+    """True if the rule's own opaque-enough fill carries its ink at 4.5:1."""
+    ink = rgba(ink)
+    if ink is None:
+        return False
+    for value in declared(body, "background-color"):
+        fill = rgba(value)
+        if fill is None or fill[3] < 0.95:
+            continue
+        if ratio(over(ink, fill), fill) >= PLATE_INK_MINIMUM:
+            return True
+    return False
+
+
