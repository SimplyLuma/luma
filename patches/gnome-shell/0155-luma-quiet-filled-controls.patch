+// Filled controls in the Shell (ADR-043), the companion to SURFACE_INK in
+// lumaSurfaceMaterials.js.
+//
+// Ink used as a fill is symmetric by design -- white on dark, near-black on
+// paper -- so every on tile, checked pill and slider handle in Quick Options
+// became a heavy block in light mode, several to a panel. A view keeps at most
+// one ink fill, its emphasis. Every on state takes `state` with `stateInk` on
+// it, a slider runs its value in `state` and draws its handle as a `knob` disc
+// ringed in `knobRing`, and a tile's chevron takes no plate, only `line`.
+//
+// The values are the app kit's (config/shared/design-tokens.json `controls`),
+// so a toggle in Quick Options and a segment in an app window are the same
+// colour. data/theme/luma-controls.css spends them and
+// data/theme/verify-treatment-ink.py fails the build if it spends anything
+// else, or if `state` stands less than 3:1 from the surface and the off plate
+// it replaces, or its glyph less than 4.5:1 on it.
+export const CONTROL_INK = {
+    light: {
+        state: '#61728a', stateInk: '#ffffff',
+        knob: '#ffffff', knobRing: '#61728a',
+        ink: '#34383d', line: 'rgba(25,27,31,0.12)',
+        control: 'rgba(35,39,45,0.06)', hover: 'rgba(25,27,31,0.06)',
+        offPlate: '#ffffff',
+    },
