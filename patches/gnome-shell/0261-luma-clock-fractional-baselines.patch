From: Project Luma
Subject: [PATCH] Shell: align clock text in logical coordinates on fractional displays

Pango returns baselines in text resource pixels, while Clutter allocates
labels in logical pixels. Normalize each baseline by that label's resource
scale so the login clock, period, date and shelf remain aligned at 125%.
Keep the existing natural line metrics, text settings and direction.

--- a/js/ui/lumaClockLayout.js
+++ b/js/ui/lumaClockLayout.js
@@ -30,7 +30,11 @@
             actor.ensure_style();
             const [, width] = actor.get_preferred_width(-1);
             const [, height] = actor.get_preferred_height(width);
-            const baseline = actor.clutter_text.get_layout().get_baseline() / Pango.SCALE;
+            // Pango shapes in resource pixels; allocations use logical pixels.
+            // Fractional monitors render text at an integer backing scale.
+            const text = actor.clutter_text;
+            const resourceScale = Math.max(1, text.get_resource_scale());
+            const baseline = text.get_layout().get_baseline() / (Pango.SCALE * resourceScale);
             return {actor, width, height, baseline};
         });
     }
--- a/js/ui/prairieLogin.js
+++ b/js/ui/prairieLogin.js
@@ -150,7 +150,9 @@
         const dateX = stacked ? 0 : dividerX + 17 * scale;
         const dateWidth = Math.max(0, Math.min(naturalDateWidth, width - dateX));
         const [, dateHeight] = this._date.get_preferred_height(dateWidth);
-        const dateBaseline = this._date.clutter_text.get_layout().get_baseline() / Pango.SCALE;
+        const dateText = this._date.clutter_text;
+        const dateBaseline = dateText.get_layout().get_baseline() /
+            (Pango.SCALE * Math.max(1, dateText.get_resource_scale()));
         place(this._date, dateX, stacked ? rowY + rowHeight + 8 * scale
             : rowY + commonBaseline - dateBaseline, dateWidth, dateHeight);
     }
