diff --git a/js/ui/status/keyboard.js b/js/ui/status/keyboard.js
index 4f7471e..1e7bef2 100644
--- a/js/ui/status/keyboard.js
+++ b/js/ui/status/keyboard.js
@@ -369,6 +369,15 @@ export class InputSourceManager extends Signals.EventEmitter {
         this._xkbInfo = KeyboardManager.getXkbInfo();
         this._keyboardManager = KeyboardManager.getKeyboardManager();
         this._keyboardManager.connect('keymap-changed', this._keymapChanged.bind(this));
+        // The first keymap is built as soon as the settings report input
+        // sources. Seeding options and model used to be left to reload(),
+        // which only the panel's keyboard indicator calls; the login and
+        // unlock screens show no such indicator, so every keymap the greeter
+        // built failed with "this._xkbOptions is undefined". The system
+        // settings do not report options or a model that equal their
+        // initial empty values either, so nothing else would ever set them.
+        this._keyboardManager.setKeyboardOptions(this._settings.keyboardOptions);
+        this._keyboardManager.setKeyboardModel(this._settings.keyboardModel);
 
         this._ibusReady = false;
         this._ibusManager = IBusManager.getIBusManager();
