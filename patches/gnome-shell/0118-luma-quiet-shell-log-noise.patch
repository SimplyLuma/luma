--- a/js/ui/windowManager.js
+++ b/js/ui/windowManager.js
@@ -513,6 +513,9 @@ export class WindowManager {
         this._mapping = new Set();
         this._resizing = new Set();
         this._resizePending = new Set();
+        // Actors for which Mutter started a size change and still waits for
+        // completed_size_change(). See _completeSizeChange().
+        this._sizeChangesInProgress = new Set();
         this._destroying = new Set();
 
         this._skippedActors = new Set();
@@ -1312,10 +1315,23 @@ export class WindowManager {
             oldFrameRect.width > 0 &&
             oldFrameRect.height > 0;
 
-        if (shouldAnimate)
+        if (shouldAnimate) {
             this._prepareAnimationInfo(shellwm, actor, oldFrameRect, whichChange);
-        else
+            this._sizeChangesInProgress.add(actor);
+        } else {
             shellwm.completed_size_change(actor);
+        }
+    }
+
+    // Tell Mutter a size change is finished, but only one it started.
+    // _prepareAnimationInfo() is also called directly, without any size-change
+    // event, to animate a window between two rectangles: Tiling Shell does
+    // that for every tile it moves. Completing those told Mutter about size
+    // changes it never began, and each one logged "Error in size change
+    // accounting." and left the window actor's effect bookkeeping reset.
+    _completeSizeChange(actor) {
+        if (this._sizeChangesInProgress.delete(actor))
+            this._shellwm.completed_size_change(actor);
     }
 
