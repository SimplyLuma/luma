diff --git a/js/ui/shelf.js b/js/ui/shelf.js
new file mode 100644
index 0000000000000000000000000000000000000000..34970d41fd0d3c5545f56118f4eb6180166def7a
--- /dev/null
+++ b/js/ui/shelf.js
@@ -0,0 +1,341 @@
+import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import St from 'gi://St';
+
+import * as Dash from './dash.js';
+import * as Main from './main.js';
+
+const SHELF_HEIGHT = 50;
+const SHELF_EDGE_INSET = 14;
+const SHELF_ISLAND_GAP = 8;
+const SHELF_ICON_SIZE = 36;
+const LEGACY_DESKTOP_DOCK_UUID = 'dash-to-dock@micxgx.gmail.com';
+const SHELF_STYLESHEET_URI = 'resource:///org/gnome/shell/theme/luma-shelf.css';
+
+const ShelfLayout = GObject.registerClass(
+class ShelfLayout extends Clutter.LayoutManager {
+    vfunc_get_preferred_width(container, forHeight) {
+        const child = container.get_first_child();
+        return child?.get_preferred_width(forHeight) ?? [0, 0];
+    }
+
+    vfunc_get_preferred_height(container, forWidth) {
+        const child = container.get_first_child();
+        return child?.get_preferred_height(forWidth) ?? [0, 0];
+    }
+
+    vfunc_allocate(container, box) {
+        const child = container.get_first_child();
+        if (!child)
+            return;
+
+        const width = box.get_width();
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        const [, naturalWidth] = child.get_preferred_width(SHELF_HEIGHT * scale);
+        const childWidth = Math.min(width, naturalWidth);
+        const x = Math.floor((width - childWidth) / 2);
+        const childBox = new Clutter.ActorBox({
+            x1: x,
+            y1: 0,
+            x2: x + childWidth,
+            y2: SHELF_HEIGHT * scale,
+        });
+        child.allocate(childBox);
+    }
+});
+
+const ShelfIsland = GObject.registerClass(
+class ShelfIsland extends St.Widget {
+    _init(styleClass, child) {
+        super._init({
+            style_class: `luma-shelf-island ${styleClass}`,
+            layout_manager: new Clutter.BinLayout(),
+        });
+        this._content = child;
+
+        for (const shadowClass of ['far', 'middle', 'near']) {
+            const shadow = new St.Widget({
+                style_class: `luma-shelf-shadow luma-shelf-shadow-${shadowClass}`,
+            });
+            shadow.add_constraint(new Clutter.BindConstraint({
+                source: child,
+                coordinate: Clutter.BindCoordinate.ALL,
+            }));
+            this.add_child(shadow);
+        }
+
+        child.add_style_class_name('luma-shelf-material');
+        this.add_child(child);
+
+        const stroke = new St.Widget({
+            style_class: 'luma-shelf-stroke',
+            reactive: false,
+        });
+        stroke.add_constraint(new Clutter.BindConstraint({
+            source: child,
+            coordinate: Clutter.BindCoordinate.ALL,
+        }));
+        this.add_child(stroke);
+    }
+
+    // Constraint-backed shadow actors deliberately do not participate in
+    // measurement. Forward preferred size from the one material actor so
+    // panel buttons that paint outside a zero-width allocation cannot leak
+    // through without their surface.
+    vfunc_get_preferred_width(forHeight) {
+        return this._content.get_preferred_width(forHeight);
+    }
+
+    vfunc_get_preferred_height(_forWidth) {
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        const height = SHELF_HEIGHT * scale;
+        return [height, height];
+    }
+});
+
+/**
+ * Shelf
+ *
+ * First-party desktop chrome. The settings schema is deliberately renderer-
+ * independent: a future trusted mod may provide another implementation by
+ * claiming the same Shelf capability, without monkey-patching this actor.
+ */
+export const Shelf = GObject.registerClass(
+class Shelf extends St.Widget {
+    _init() {
+        super._init({
+            name: 'lumaShelf',
+            style_class: 'luma-shelf',
+            reactive: false,
+            // The actor is 64 px high so Mutter reserves both the 50 px
+            // material and its 14 px screen-edge breathing room. Allocate the
+            // material at the actor's top rather than centering it in that
+            // reserve, which would incorrectly halve the visible inset.
+            layout_manager: new ShelfLayout(),
+        });
+
+        this._settings = new Gio.Settings({
+            schema_id: 'org.project_luma.shell-state',
+        });
+        this._shellSettings = new Gio.Settings({
+            schema_id: 'org.gnome.shell',
+        });
+        this._stylesheet = Gio.File.new_for_uri(SHELF_STYLESHEET_URI);
+        St.ThemeContext.get_for_stage(global.stage)
+            .get_theme()
+            .load_stylesheet(this._stylesheet);
+        this._settings.connectObject('changed', () => this._sync(), this);
+        Main.sessionMode.connectObject('updated', () => {
+            GLib.idle_add_once(GLib.PRIORITY_DEFAULT, () => this._sync());
+        }, this);
+        Main.layoutManager.connectObject('monitors-changed', () => this._sync(), this);
+        Main.overview.connectObject(
+            'showing', () => this.hide(),
+            'hiding', () => {
+                if (this._isDesktopSession())
+                    this.show();
+            },
+            this);
+
+        this._group = new St.BoxLayout({
+            style_class: 'luma-shelf-group',
+            x_align: Clutter.ActorAlign.CENTER,
+            y_align: Clutter.ActorAlign.START,
+        });
+        this.add_child(this._group);
+
+        this._dash = new Dash.Dash();
+        this._dash.setFixedIconSize(SHELF_ICON_SIZE);
+        this._dash.setShowAppsAtStart(true);
+        this._dockScroll = new St.ScrollView({
+            style_class: 'luma-shelf-dock-scroll',
+            hscrollbar_policy: St.PolicyType.EXTERNAL,
+            vscrollbar_policy: St.PolicyType.NEVER,
+            enable_mouse_scrolling: true,
+            overlay_scrollbars: true,
+        });
+        // St.ScrollView requires an StScrollable child. GNOME's native Dash
+        // intentionally remains a plain St.Widget, so keep it unmodified and
+        // place it inside Shell's scrollable BoxLayout boundary.
+        this._dockContent = new St.BoxLayout({
+            orientation: Clutter.Orientation.HORIZONTAL,
+        });
+        this._dockContent.add_child(this._dash);
+        this._dockScroll.set_child(this._dockContent);
+        this._dockMaterial = new St.Bin({child: this._dockScroll});
+        this._dockIsland = new ShelfIsland('luma-shelf-dock-island', this._dockMaterial);
+
+        this._actionsBox = new St.BoxLayout({
+            style_class: 'luma-shelf-actions-box',
+            y_align: Clutter.ActorAlign.CENTER,
+        });
+        this._actionsMaterial = new St.Bin({child: this._actionsBox});
+        this._actionsIsland = new ShelfIsland(
+            'luma-shelf-actions-island', this._actionsMaterial);
+
+        Main.layoutManager.addChrome(this, {
+            affectsStruts: true,
+            trackFullscreen: true,
+        });
+        Main.ctrlAltTabManager.addGroup(
+            this, _('Shelf'), 'shell-focus-dash-symbolic');
+
+        this._dash.connectObject('notify::width', () => this._queueDockWidth(), this);
+        this._actionsBox.connectObject('notify::width', () => this._queueDockWidth(), this);
+        this._sync();
+    }
+
+    _isDesktopSession() {
+        return !Main.sessionMode.isGreeter &&
+            Main.sessionMode.currentMode !== 'unlock-dialog' &&
+            GLib.getenv('LUMA_DEVICE_CLASS') !== 'handheld';
+    }
+
+    _retireLegacyDesktopDock() {
+        const enabled = this._shellSettings.get_strv('enabled-extensions');
+        if (!enabled.includes(LEGACY_DESKTOP_DOCK_UUID))
+            return;
+        this._shellSettings.set_strv('enabled-extensions',
+            enabled.filter(uuid => uuid !== LEGACY_DESKTOP_DOCK_UUID));
+    }
+
+    _setMenuSide(indicator, side) {
+        indicator?.menu?.setArrowSide(side);
+    }
+
+    _adoptPanelActors() {
+        const indicators = Main.panel.statusArea;
+        const actionRoles = [
+            'dateMenu',
+            'screenRecording',
+            'screenSharing',
+            'dwellClick',
+            'a11y',
+            'keyboard',
+            'quickSettings',
+        ];
+        const arrowSide = St.Side.BOTTOM;
+
+        for (const role of actionRoles) {
+            const indicator = indicators[role];
+            if (!indicator)
+                continue;
+            const container = indicator.container;
+            const parent = container.get_parent();
+            if (parent !== this._actionsBox) {
+                parent?.remove_child(container);
+                this._actionsBox.add_child(container);
+            }
+            if (!indicator._lumaShelfVisibilityBound) {
+                indicator.connectObject('notify::visible', () => {
+                    container.visible = indicator.visible;
+                    this._queueDockWidth();
+                }, this);
+                indicator._lumaShelfVisibilityBound = true;
+            }
+            container.visible = indicator.visible;
+            indicator.setShelfPresentation?.(true);
+            this._setMenuSide(indicator, arrowSide);
+        }
+
+        const liveIndicator = indicators.liveExtensions;
+        const live = liveIndicator?.container;
+        if (live) {
+            if (!this._liveIsland) {
+                live.get_parent()?.remove_child(live);
+                this._liveMaterial = new St.Bin({child: live});
+                this._liveIsland = new ShelfIsland(
+                    'luma-shelf-live-island', this._liveMaterial);
+                liveIndicator.connectObject('notify::visible', () => {
+                    this._liveIsland.visible = liveIndicator.visible;
+                    this._queueDockWidth();
+                }, this);
+            }
+            if (this._liveIsland.get_parent() !== this._group) {
+                this._liveIsland.get_parent()?.remove_child(this._liveIsland);
+                this._group.insert_child_at_index(this._liveIsland, 1);
+            }
+            this._liveIsland.visible = liveIndicator.visible;
+        }
+    }
+
+    _restorePanelActors() {
+        const indicators = Main.panel.statusArea;
+        indicators.quickSettings?.setShelfPresentation?.(false);
+        indicators.dateMenu?.setShelfPresentation?.(false);
+        Main.panel._updatePanel();
+        Main.panel.show();
+        Main.layoutManager.panelBox.show();
+    }
+
+    _sync() {
+        if (!this._isDesktopSession()) {
+            this.hide();
+            this._restorePanelActors();
+            return;
+        }
+
+        this._retireLegacyDesktopDock();
+        Main.panel.hide();
+        Main.layoutManager.panelBox.hide();
+        this.show();
+
+        const dockVisible = this._settings.get_boolean('shelf-dock-visible');
+        const actionsVisible = this._settings.get_boolean('shelf-actions-visible');
+        const surfaceMode = this._settings.get_string('shelf-surface-mode');
+        const material = this._settings.get_string('shelf-material');
+
+        this._group.remove_all_children();
+        if (dockVisible)
+            this._group.add_child(this._dockIsland);
+        if (actionsVisible)
+            this._group.add_child(this._actionsIsland);
+        this._group.set_style_class_name(
+            `luma-shelf-group luma-shelf-${surfaceMode} luma-shelf-material-${material}`);
+
+        this._adoptPanelActors();
+        this._syncGeometry();
+        this._queueDockWidth();
+    }
+
+    _syncGeometry() {
+        const monitor = Main.layoutManager.primaryMonitor;
+        if (!monitor)
+            return;
+
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        const reserve = (SHELF_HEIGHT + SHELF_EDGE_INSET) * scale;
+        this.set_position(monitor.x, monitor.y + monitor.height - reserve);
+        this.set_size(monitor.width, reserve);
+    }
+
+    _queueDockWidth() {
+        if (this._widthLaterId)
+            return;
+        this._widthLaterId = GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
+            this._widthLaterId = 0;
+            this._syncDockWidth();
+            return GLib.SOURCE_REMOVE;
+        });
+    }
+
+    _syncDockWidth() {
+        const monitor = Main.layoutManager.primaryMonitor;
+        if (!monitor || !this._dockIsland.visible)
+            return;
+
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        const [, naturalDockWidth] = this._dash.get_preferred_width(-1);
+        const [, actionsWidth] = this._actionsIsland.get_preferred_width(-1);
+        const maxWidth = Math.max(1,
+            monitor.width - 2 * SHELF_EDGE_INSET * scale -
+            actionsWidth - SHELF_ISLAND_GAP * scale);
+        this._dockScroll.width = Math.min(naturalDockWidth, maxWidth);
+        if (naturalDockWidth > maxWidth)
+            this._dockScroll.add_style_pseudo_class('overflowing');
+        else
+            this._dockScroll.remove_style_pseudo_class('overflowing');
+    }
+});
