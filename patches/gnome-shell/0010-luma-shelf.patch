+/* Project Luma Shelf
+ *
+ * This is native Shell chrome. Keep model/layout ownership in shelf.js and
+ * material ownership here so a trusted replacement can claim the Shelf
+ * capability without inheriting private implementation details.
+ */
+
+.luma-shelf-group {
+  spacing: 8px;
+}
+
+.luma-shelf-group.luma-shelf-connected {
+  spacing: 0;
+}
+
+.luma-shelf-island {
+  min-height: 50px;
+}
+
+.luma-shelf-material,
+.luma-shelf-shadow,
+.luma-shelf-stroke {
+  border-radius: 15px;
+}
+
+.luma-shelf-material {
+  background-color: #21252b;
+  color: #e7e9e8;
+}
+
+.luma-shelf-stroke {
+  border: 1px solid rgba(255, 255, 255, 0.045);
+}
+
+.luma-shelf-shadow {
+  background-color: rgba(33, 37, 43, 0.01);
+}
+
+.luma-shelf-shadow-near {
+  box-shadow: 0 3px 8px 0 rgba(9, 11, 14, 0.38);
+}
+
+.luma-shelf-shadow-middle {
+  box-shadow: 0 22px 52px -15px rgba(9, 11, 14, 0.72);
+}
+
+.luma-shelf-shadow-far {
+  box-shadow: 0 64px 120px -30px rgba(9, 11, 14, 0.82);
+}
+
+.luma-shelf-dock-scroll {
+  min-height: 36px;
+  padding: 0;
+}
+
+.luma-shelf-dock-island .luma-shelf-material {
+  padding: 7px;
+}
+
+.luma-shelf-dock-island #dash {
+  padding: 0;
+
+  .dash-background {
+    background-color: transparent;
+    border-radius: 0;
+    margin: 0;
+    padding: 0;
+  }
+
+  .dash-item-container {
+    .show-apps,
+    .overview-tile {
+      margin: 0 2.5px;
+      padding: 0;
+
+      .overview-icon {
+        border-radius: 9px;
+        padding: 0;
+      }
+    }
+
+    .app-grid-running-dot {
+      offset-y: 0;
+    }
+  }
+
+  .dash-separator {
+    height: 30px;
+    margin: 3px 5px;
+    background-color: rgba(255, 255, 255, 0.12);
+  }
+}
+
+.luma-shelf-actions-island .luma-shelf-material {
+  padding: 7px 9px 7px 10px;
+}
+
+.luma-shelf-actions-box {
+  spacing: 10px;
+
+  .panel-button {
+    -natural-hpadding: 0;
+    -minimum-hpadding: 0;
+    min-height: 34px;
+    margin: 0;
+    padding: 0;
+    border: 0;
+    border-radius: 9px;
+    background-color: transparent;
+    box-shadow: none;
+    color: #e7e9e8;
+    font-weight: 500;
+    transition-duration: 120ms;
+
+    &:hover,
+    &:focus {
+      background-color: rgba(231, 233, 232, 0.10);
+    }
+
+    &:active,
+    &:checked {
+      background-color: rgba(231, 233, 232, 0.16);
+    }
+
+    .system-status-icon {
+      -st-icon-style: symbolic;
+      icon-size: 11px;
+      margin: 0;
+      padding: 0;
+    }
+  }
+
+  .luma-shelf-status-button {
+    min-width: 34px;
+    min-height: 34px;
+    border-radius: 9px;
+    background-color: rgba(255, 255, 255, 0.085);
+    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.055);
+
+    &:hover,
+    &:focus {
+      background-color: rgba(255, 255, 255, 0.13);
+    }
+
+    &:active,
+    &:checked {
+      background-color: rgba(255, 255, 255, 0.18);
+    }
+  }
+
+  .luma-shelf-status-grid {
+    min-width: 34px;
+    min-height: 34px;
+  }
+
+  .clock-display {
+    min-width: 42px;
+    min-height: 34px;
+  }
+
+  .clock-display-box {
+    spacing: 0;
+  }
+
+  .luma-clock-content {
+    min-width: 42px;
+    spacing: 4px;
+  }
+
+  .luma-clock-time {
+    color: #e7e9e8;
+    font-size: 11px;
+    font-weight: 700;
+  }
+
+  .luma-clock-date {
+    color: rgba(231, 233, 232, 0.60);
+    font-size: 8px;
+    font-weight: 600;
+  }
+}
+
+.luma-shelf-live-island .luma-shelf-material {
+  padding: 7px 10px;
+}
+
+.luma-shelf-dock-scroll:overflowing {
+  box-shadow: inset 8px 0 8px -8px rgba(231, 233, 232, 0.18);
+}
