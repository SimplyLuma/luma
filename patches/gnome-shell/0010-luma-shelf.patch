+class ShelfStatusLayout extends Clutter.LayoutManager {
+    _init() {
+        super._init();
+        this._shelfPresentation = false;
+    }
+
+    setShelfPresentation(enabled) {
+        if (this._shelfPresentation === enabled)
+            return;
+        this._shelfPresentation = enabled;
+        this.layout_changed();
+    }
+
+    _visibleChildren(container) {
+        return container.get_children().filter(child => child.visible);
+    }
+
+    _columns(container) {
+        return Math.max(2,
+            Math.ceil(this._visibleChildren(container).length / 2));
+    }
+
+    _scale() {
+        return St.ThemeContext.get_for_stage(global.stage).scale_factor;
+    }
+
+    vfunc_get_preferred_width(container, forHeight) {
+        if (!this._shelfPresentation) {
+            let minWidth = 0;
+            let natWidth = 0;
+            const spacing = container.get_theme_node().get_length('spacing');
+            const children = this._visibleChildren(container);
+
+            for (const child of children) {
+                const [childMin, childNat] = child.get_preferred_width(forHeight);
+                minWidth += childMin;
+                natWidth += childNat;
+            }
+            const totalSpacing = Math.max(0, children.length - 1) * spacing;
+            return [minWidth + totalSpacing, natWidth + totalSpacing];
+        }
+
+        const scale = this._scale();
+        const columns = this._columns(container);
+        const width = Math.max(34,
+            8 + columns * 11 + (columns - 1) * 3) * scale;
+        return [width, width];
+    }
+
+    vfunc_get_preferred_height(container, forWidth) {
+        if (!this._shelfPresentation) {
+            let minHeight = 0;
+            let natHeight = 0;
+            for (const child of this._visibleChildren(container)) {
+                const [childMin, childNat] = child.get_preferred_height(forWidth);
+                minHeight = Math.max(minHeight, childMin);
+                natHeight = Math.max(natHeight, childNat);
+            }
+            return [minHeight, natHeight];
+        }
+
+        const height = 34 * this._scale();
+        return [height, height];
+    }
+
+    vfunc_allocate(container, box) {
+        const children = this._visibleChildren(container);
+        if (!this._shelfPresentation) {
+            const spacing = container.get_theme_node().get_length('spacing');
+            const width = box.get_width();
+            const height = box.get_height();
+            const ltr = container.get_text_direction() !== Clutter.TextDirection.RTL;
+            let x = 0;
+
+            for (const child of children) {
+                const [, childWidth] = child.get_preferred_width(height);
+                const [, childHeight] = child.get_preferred_height(childWidth);
+                const childBox = new Clutter.ActorBox();
+                const childX = ltr ? x : width - x - childWidth;
+                childBox.set_origin(childX, Math.floor((height - childHeight) / 2));
+                childBox.set_size(childWidth, childHeight);
+                child.allocate(childBox);
+                x += childWidth + spacing;
+            }
+            return;
+        }
+
+        const scale = this._scale();
+        const columns = Math.max(2, Math.ceil(children.length / 2));
+        const cell = 11 * scale;
+        const gap = 3 * scale;
+        const contentWidth = columns * cell + (columns - 1) * gap;
+        const width = box.x2 - box.x1;
+        const height = box.y2 - box.y1;
+        const startX = Math.floor((width - contentWidth) / 2);
+        const startY = Math.floor((height - (2 * cell + gap)) / 2);
+
+        children.forEach((child, index) => {
+            const column = index % columns;
+            const row = Math.floor(index / columns);
+            const childBox = new Clutter.ActorBox({
+                x1: startX + column * (cell + gap),
+                y1: startY + row * (cell + gap),
+                x2: startX + column * (cell + gap) + cell,
+                y2: startY + row * (cell + gap) + cell,
+            });
+            child.allocate(childBox);
+        });
+    }
+});
