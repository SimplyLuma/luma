+// ── Dragging the thumbnail into apps ───────────────────────────────────────
+
+const DRAG_HELPER = 'luma-capture-drag';
+
+// The Shell cannot start a Wayland drag itself, so a small helper client
+// (data/luma-capture-drag.js) puts a transparent window exactly over the
+// thumbnail and does the drag. It is the Shell's own Wayland client, hidden
+// from the window list, kept above other windows and on every workspace,
+// and never given the keyboard. The Shell keeps drawing the thumbnail.
+export class ThumbnailDragBridge {
+    constructor(handlers) {
+        this._handlers = handlers;
+        this._client = null;
+        this._stdin = null;
+        this._window = null;
+        this._rect = null;
+        this._serial = 0;
+        this._mappedSerial = -1;
+        this._previousFocus = null;
+    }
+
+    get available() {
+        return GLib.file_test(this._helperPath(), GLib.FileTest.EXISTS);
+    }
+
+    // Whether the helper's window is over the thumbnail now.
+    get active() {
+        return this._window !== null && this._mappedSerial === this._serial;
+    }
+
+    _helperPath() {
+        return GLib.getenv('LUMA_CAPTURE_DRAG_HELPER') ??
+            GLib.build_filenamev([Config.LIBEXECDIR, DRAG_HELPER]);
+    }
+
+    _ensure() {
+        if (this._client)
+            return true;
+        try {
+            const launcher = new Gio.SubprocessLauncher({
+                flags: Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE,
+            });
+            if (GLib.getenv('LUMA_CAPTURE_DEBUG') === 'wayland')
+                launcher.setenv('WAYLAND_DEBUG', '1', true);
+            this._client = Meta.WaylandClient.new_subprocess(global.context, launcher,
+                ['gjs', '-m', this._helperPath()]);
+        } catch (e) {
+            logError(e, 'Luma Capture: the thumbnail drag helper did not start');
+            this._client = null;
+            return false;
+        }
+        const subprocess = this._client.get_subprocess();
+        this._stdin = subprocess.get_stdin_pipe();
+        this._stdout = new Gio.DataInputStream({base_stream: subprocess.get_stdout_pipe()});
+        this._readEvent(this._stdout);
+        subprocess.wait_async(null, () => this._onExited(subprocess));
+        this._windowCreatedId = global.display.connect('window-created',
+            (_display, window) => this._onWindowCreated(window));
+        log('drag helper started', {pid: subprocess.get_identifier()});
+        return true;
+    }
+
+    _onExited(subprocess) {
+        if (this._client?.get_subprocess() !== subprocess)
+            return;
+        log('drag helper exited', {status: subprocess.get_if_exited() ? subprocess.get_exit_status() : 'signal'});
+        global.display.disconnect(this._windowCreatedId);
+        this._client = null;
+        this._stdin = null;
+        this._stdout = null;
+        this._window = null;
+        this._mappedSerial = -1;
+        this._handlers.inactive?.();
+    }
+
+    _readEvent(stream) {
+        stream.read_line_async(GLib.PRIORITY_DEFAULT, null, (_stream, result) => {
+            let line = null;
+            try {
+                [line] = stream.read_line_finish_utf8(result);
+            } catch (e) {
+                logError(e, 'Luma Capture: drag helper output');
+            }
+            if (line === null || stream !== this._stdout)
+                return;
+            try {
+                this._onEvent(JSON.parse(line));
+            } catch (e) {
+                logError(e, `Luma Capture: drag helper said ${line}`);
+            }
+            this._readEvent(stream);
+        });
+    }
+
+    _onEvent(event) {
+        if (GLib.getenv('LUMA_CAPTURE_DEBUG'))
+            log('drag helper event', event);
+        switch (event.event) {
+        case 'mapped':
+            this._mappedSerial = event.serial;
+            this._place();
+            if (this.active)
+                this._handlers.active?.();
+            break;
+        case 'hover':
+            this._handlers.hover?.(event.value);
+            break;
+        case 'click':
+            if (event.serial === this._serial)
+                this._handlers.click?.();
+            break;
+        case 'drag-begin':
+            log('drag begin', {serial: event.serial});
+            this._handlers.dragBegin?.();
+            break;
+        case 'drag-end':
+            log('drag end', {serial: event.serial, dropped: event.dropped, reason: event.reason});
+            this._handlers.dragEnd?.(event.dropped);
+            break;
+        }
+    }
+
+    _onWindowCreated(window) {
+        if (!this._client?.owns_window(window))
+            return;
+        this._window = window;
+        window.hide_from_window_list();
+        const actor = window.get_compositor_private();
+        if (actor)
+            Main.wm.skipNextEffect(actor);
+        window.connect('unmanaged', () => {
+            if (this._window === window)
+                this._window = null;
+        });
+        window.connect('focus', () => this._giveBackFocus(window));
+        // Placed once it has a size of its own: moving a window that has not
+        // drawn yet leaves it without one.
+        window.connect('shown', () => {
+            if (!window.is_above())
+                window.make_above();
+            if (!window.is_on_all_workspaces())
+                window.stick();
+            this._place();
+        });
+        window.connect('size-changed', () => this._placeIfMoved());
+    }
+
+    _placeIfMoved() {
+        const window = this._window;
+        const rect = this._rect;
+        if (!window || !rect)
+            return;
+        const frame = window.get_frame_rect();
+        if (frame.width > 0 && (Math.abs(frame.x - rect.x) > 1 || Math.abs(frame.y - rect.y) > 1 ||
+            Math.abs(frame.width - rect.width) > 1 || Math.abs(frame.height - rect.height) > 1))
+            this._place();
+    }
+
+    // The helper never keeps the keyboard: whoever had it gets it back.
+    _giveBackFocus(window) {
+        const previous = this._previousFocus;
+        if (previous && previous !== window && !previous.minimized &&
+            previous.get_compositor_private())
+            previous.focus(global.get_current_time());
+    }
+
+    _place() {
+        const window = this._window;
+        const rect = this._rect;
+        if (!window || !rect)
+            return;
+        if (window.get_frame_rect().width <= 0)
+            return;
+        window.move_resize_frame(false, Math.round(rect.x), Math.round(rect.y),
+            Math.round(rect.width), Math.round(rect.height));
+        window.raise();
+    }
+
+    _send(command) {
+        if (!this._stdin)
+            return;
+        try {
+            this._stdin.write_all(new TextEncoder().encode(`${JSON.stringify(command)}\n`), null);
+        } catch (e) {
+            logError(e, 'Luma Capture: drag helper input');
+        }
+    }
+
+    // rect: the thumbnail's stage rectangle at rest.
+    show({file, preview, mime, rect}) {
+        if (!this.available || !this._ensure())
+            return;
+        const focus = global.display.focus_window;
+        if (focus && !this._client.owns_window(focus))
+            this._previousFocus = focus;
+        this._serial++;
+        this._rect = rect;
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        this._send({cmd: 'show', serial: this._serial, file: file.get_path(), preview, mime,
+            width: Math.round(rect.width / scale), height: Math.round(rect.height / scale)});
+        this._place();
+    }
+
+    hide() {
+        this._rect = null;
+        this._mappedSerial = -1;
+        this._send({cmd: 'hide'});
+    }
+}
+
