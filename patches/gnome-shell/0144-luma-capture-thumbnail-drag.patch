diff --git a/data/luma-capture-drag.js b/data/luma-capture-drag.js
new file mode 100644
index 0000000..fa52888
--- /dev/null
+++ b/data/luma-capture-drag.js
@@ -0,0 +1,263 @@
+#!/usr/bin/gjs -m
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Luma Capture's thumbnail, as something that can be dragged into apps.
+//
+// The Shell draws the floating thumbnail, but a Wayland drag can only start
+// from a client surface. The Shell starts this helper as its own Wayland
+// client (Meta.WaylandClient: hidden from the dock, the app switcher and the
+// overviews) and lays its window, transparent and undecorated, exactly over
+// the thumbnail. The window takes the pointer: a click opens the capture, a
+// drag carries it into another app as a file (text/uri-list and the portal's
+// file transfer) and as GNOME's copied-files target.
+//
+// Commands arrive on stdin, one JSON object per line:
+//   {"cmd": "show", "serial": n, "file": path, "preview": path|null,
+//    "mime": type, "width": px, "height": px}
+//   {"cmd": "hide"}   {"cmd": "quit"}
+// Events leave on stdout, one JSON object per line:
+//   {"event": "ready"}  {"event": "mapped", "serial": n}
+//   {"event": "hover", "value": bool}  {"event": "click", "serial": n}
+//   {"event": "drag-begin", "serial": n}
+//   {"event": "drag-end", "serial": n, "dropped": bool, "reason": string|null}
+// With no thumbnail for a while the helper exits; the Shell starts it again.
+
+import Gdk from 'gi://Gdk?version=4.0';
+import GdkPixbuf from 'gi://GdkPixbuf';
+import Gio from 'gi://Gio';
+import GioUnix from 'gi://GioUnix';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import Gtk from 'gi://Gtk?version=4.0';
+
+const APP_ID = 'org.project_luma.CaptureDrag';
+const IDLE_EXIT_SECONDS = 120;
+const ICON_WIDTH = 120;
+
+const emit = event => {
+    print(JSON.stringify(event));
+};
+
+// A window that draws nothing never gets a buffer and is never shown, so it
+// is filled with an alpha too faint to see; the Shell's thumbnail is drawn over
+// it anyway.
+const CSS = `
+window.luma-capture-drag {
+    background-color: rgba(0, 0, 0, 0.004);
+    box-shadow: none;
+    border: none;
+}
+window.luma-capture-drag > * {
+    background: none;
+}
+`;
+
+class DragHelper {
+    constructor() {
+        this._app = new Gtk.Application({
+            application_id: APP_ID,
+            flags: Gio.ApplicationFlags.NON_UNIQUE,
+        });
+        this._app.connect('startup', () => this._startup());
+        this._app.connect('activate', () => {});
+        this._current = null;
+        this._idleId = 0;
+        this._mappedId = 0;
+    }
+
+    run() {
+        return this._app.run([]);
+    }
+
+    _startup() {
+        this._app.hold();
+        const provider = new Gtk.CssProvider();
+        provider.load_from_string(CSS);
+        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
+            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION);
+
+        this._window = new Gtk.Window({
+            application: this._app,
+            decorated: false,
+            resizable: false,
+            title: 'Capture',
+            css_classes: ['luma-capture-drag'],
+        });
+        this._area = new Gtk.Box({hexpand: true, vexpand: true});
+        this._window.set_child(this._area);
+        this._window.connect('close-request', () => true);
+
+        const motion = new Gtk.EventControllerMotion();
+        motion.connect('enter', () => emit({event: 'hover', value: true}));
+        motion.connect('leave', () => emit({event: 'hover', value: false}));
+        this._area.add_controller(motion);
+
+        const click = new Gtk.GestureClick({button: Gdk.BUTTON_PRIMARY});
+        click.connect('released', (gesture, nPress) => {
+            if (this._dragging || !this._current)
+                return;
+            if (nPress === 1)
+                emit({event: 'click', serial: this._current.serial});
+        });
+        this._area.add_controller(click);
+
+        const drag = new Gtk.DragSource({actions: Gdk.DragAction.COPY});
+        drag.connect('prepare', (source, x, y) => this._prepare(source, x, y));
+        drag.connect('drag-begin', () => {
+            this._dragging = true;
+            click.set_state(Gtk.EventSequenceState.DENIED);
+            emit({event: 'drag-begin', serial: this._current?.serial ?? 0});
+        });
+        drag.connect('drag-cancel', (_source, _drag, reason) => {
+            this._cancelReason = Object.keys(Gdk.DragCancelReason)
+                .find(key => Gdk.DragCancelReason[key] === reason) ?? `${reason}`;
+            return false;
+        });
+        drag.connect('drag-end', () => {
+            const dropped = this._cancelReason === null;
+            emit({event: 'drag-end', serial: this._current?.serial ?? 0, dropped,
+                reason: this._cancelReason});
+            this._dragging = false;
+            this._cancelReason = null;
+        });
+        this._area.add_controller(drag);
+        this._dragging = false;
+        this._cancelReason = null;
+
+        this._stdin = new Gio.DataInputStream({
+            base_stream: new GioUnix.InputStream({fd: 0, close_fd: false}),
+        });
+        this._readLine();
+        this._scheduleIdleExit();
+        emit({event: 'ready'});
+    }
+
+    _readLine() {
+        this._stdin.read_line_async(GLib.PRIORITY_DEFAULT, null, (stream, result) => {
+            let line;
+            try {
+                [line] = stream.read_line_finish_utf8(result);
+            } catch (e) {
+                logError(e, 'Luma Capture drag: stdin');
+                line = null;
+            }
+            if (line === null) {
+                this._app.quit();
+                return;
+            }
+            try {
+                this._command(JSON.parse(line));
+            } catch (e) {
+                logError(e, `Luma Capture drag: bad command ${line}`);
+            }
+            this._readLine();
+        });
+    }
+
+    _command(command) {
+        switch (command.cmd) {
+        case 'show':
+            this._show(command);
+            break;
+        case 'hide':
+            this._hide();
+            break;
+        case 'quit':
+            this._app.quit();
+            break;
+        }
+    }
+
+    _show(command) {
+        this._current = {
+            serial: command.serial,
+            file: Gio.File.new_for_path(command.file),
+            preview: command.preview ?? null,
+            mime: command.mime ?? 'image/png',
+        };
+        this._icon = null;
+        this._clearIdleExit();
+        this._window.set_default_size(Math.max(1, command.width), Math.max(1, command.height));
+        this._window.set_size_request(Math.max(1, command.width), Math.max(1, command.height));
+        this._window.present();
+        const surface = this._window.get_surface();
+        if (this._mappedId) {
+            surface?.disconnect(this._mappedId);
+            this._mappedId = 0;
+        }
+        if (surface?.get_mapped()) {
+            emit({event: 'mapped', serial: command.serial});
+            return;
+        }
+        this._mappedId = surface?.connect('notify::mapped', s => {
+            if (!s.get_mapped())
+                return;
+            s.disconnect(this._mappedId);
+            this._mappedId = 0;
+            emit({event: 'mapped', serial: this._current?.serial ?? command.serial});
+        }) ?? 0;
+    }
+
+    _hide() {
+        if (this._dragging)
+            return;
+        this._current = null;
+        this._window.set_visible(false);
+        this._scheduleIdleExit();
+    }
+
+    _prepare(source, x, y) {
+        const current = this._current;
+        if (!current || !current.file.query_exists(null))
+            return null;
+        const providers = [
+            Gdk.ContentProvider.new_for_value(Gdk.FileList.new_from_array([current.file])),
+            Gdk.ContentProvider.new_for_bytes('x-special/gnome-copied-files',
+                new GLib.Bytes(new TextEncoder().encode(`copy\n${current.file.get_uri()}`))),
+        ];
+        // No image/png here, though the clipboard has one: GTK apps that take
+        // both, Files among them, prefer the image data and would save
+        // "Dropped Image.png" instead of the screenshot's own file.
+        const icon = this._dragIcon(current);
+        if (icon) {
+            const scale = icon.get_width() / Math.max(1, this._window.get_width());
+            source.set_icon(icon, Math.round(x * scale), Math.round(y * scale));
+        }
+        return Gdk.ContentProvider.new_union(providers);
+    }
+
+    _dragIcon(current) {
+        if (this._icon !== null)
+            return this._icon || null;
+        this._icon = false;
+        const path = current.preview ?? (current.mime === 'image/png' ? current.file.get_path() : null);
+        if (!path)
+            return null;
+        try {
+            const pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, ICON_WIDTH, ICON_WIDTH * 4, true);
+            this._icon = Gdk.Texture.new_for_pixbuf(pixbuf);
+        } catch (e) {
+            logError(e, 'Luma Capture drag: no drag icon');
+        }
+        return this._icon || null;
+    }
+
+    _scheduleIdleExit() {
+        this._clearIdleExit();
+        this._idleId = GLib.timeout_add_seconds(GLib.PRIORITY_DEFAULT, IDLE_EXIT_SECONDS, () => {
+            this._idleId = 0;
+            if (!this._current)
+                this._app.quit();
+            return GLib.SOURCE_REMOVE;
+        });
+    }
+
+    _clearIdleExit() {
+        if (this._idleId)
+            GLib.source_remove(this._idleId);
+        this._idleId = 0;
+    }
+}
+
+GObject.type_ensure(Gdk.FileList.$gtype);
+new DragHelper().run();
