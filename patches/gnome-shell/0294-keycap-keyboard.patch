+const KEYCAP_PREFERENCES = [
+    ['key-preview', N_('Key preview')],
+    ['haptics', N_('Haptics')],
+    ['sound', N_('Sound')],
+    ['auto-capitalise', N_('Auto-capitalise')],
+    ['double-space-period', N_('Double-space period')],
+    ['suggestions', N_('Suggestions')],
+];
+
+// The Keycap variant being painted ('light' or 'dark'), or null under High
+// Contrast, which keeps the platform keyboard's look. Keys and popups read it.
+let keycapVariant = null;
+
+function keycapIcon(name) {
+    return KEYCAP_ICONS[name] ?? name;
+}
+
+function setKeycapVariantClass(actor) {
+    for (const variant of ['light', 'dark'])
+        actor.remove_style_class_name(`luma-keycap-${variant}`);
+    if (keycapVariant)
+        actor.add_style_class_name(`luma-keycap-${keycapVariant}`);
+}
+
+function monotonicMs() {
+    return GLib.get_monotonic_time() / 1000;
+}
 
