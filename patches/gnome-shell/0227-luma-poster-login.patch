diff --git a/data/theme/gnome-shell-dark.css b/data/theme/gnome-shell-dark.css
index 081a098..e1d14e9 100644
--- a/data/theme/gnome-shell-dark.css
+++ b/data/theme/gnome-shell-dark.css
@@ -5362,3 +5362,271 @@ StScrollBar {
 
 .luma-surface-glass .luma-notification-beacon:active, .luma-surface-glass .luma-notification-beacon:checked {
   background-color: rgba(37, 46, 54, 0.08); }
+
+/* Poster: the same native GDM and unlock actors share this composition. */
+.login-dialog, .unlock-dialog, #lockDialogGroup,
+.prairie-login-background {
+  background-color: #0d0d0f;
+  color: #eceeed; }
+
+.prairie-login-wallpaper {
+  background-image: url("file:///usr/share/backgrounds/luma/prism.png");
+  background-position: 30% center;
+  background-size: cover; }
+
+.prairie-login-wallpaper-overlay {
+  background-image: url("resource:///org/gnome/shell/theme/poster-photo-overlay.svg");
+  background-size: 100% 100%; }
+
+.poster-day {
+  spacing: 22px;
+  color: white;
+  text-shadow: 0 2px 30px rgba(0, 0, 0, 0.25); }
+
+.poster-weekday {
+  font-family: "Figtree";
+  font-size: 148px;
+  font-weight: 700;
+  letter-spacing: -0.055em;
+  line-height: 0.84; }
+
+.poster-time-row {
+  spacing: 14px; }
+
+.poster-time {
+  font-family: "Figtree";
+  font-size: 64px;
+  font-weight: 250;
+  letter-spacing: -0.04em;
+  font-feature-settings: "tnum"; }
+
+.poster-ampm {
+  font-family: "Figtree";
+  font-size: 18px;
+  font-weight: 600;
+  letter-spacing: 0.02em;
+  color: rgba(255, 255, 255, 0.75);
+  margin-left: -6px; }
+
+.poster-time-divider {
+  width: 1px;
+  height: 36px;
+  margin: 0 6px;
+  background-color: rgba(255, 255, 255, 0.35); }
+
+.poster-date {
+  font-family: "Figtree";
+  font-size: 22px;
+  font-weight: 500;
+  color: rgba(255, 255, 255, 0.9); }
+
+.poster-day.compact .poster-weekday {
+  font-size: 104px; }
+
+.poster-day.compact .poster-time {
+  font-size: 48px; }
+
+.poster-card {
+  padding: 26px 30px 22px;
+  border-radius: 24px;
+  background-image: url("resource:///org/gnome/shell/theme/poster-card-glass.svg");
+  background-size: 100% 100%;
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), inset 0 0 0 1px rgba(255, 255, 255, 0.06), -30px 0 80px -30px rgba(0, 0, 0, 0.6), 0 40px 80px -30px rgba(0, 0, 0, 0.6);
+  color: #eceeed; }
+
+.poster-card.poster-card-opaque {
+  background-image: none;
+  background-color: #26262a; }
+
+.poster-status-row {
+  spacing: 14px; }
+
+.poster-wifi-icon {
+  icon-size: 15px;
+  color: #eceeed; }
+
+.poster-battery {
+  width: 23px;
+  height: 10px;
+  background-image: url("resource:///org/gnome/shell/theme/poster-battery.svg");
+  background-size: 23px 10px; }
+
+.poster-battery-fill {
+  height: 5px;
+  background-color: #eceeed;
+  border-radius: 1px; }
+
+.poster-status-divider {
+  width: 1px;
+  height: 18px;
+  background-color: rgba(255, 255, 255, 0.1); }
+
+.poster-card .prairie-login-power-button {
+  width: 32px;
+  height: 32px;
+  min-width: 32px;
+  min-height: 32px;
+  padding: 0;
+  border: 0;
+  background-color: transparent;
+  box-shadow: none; }
+
+.poster-card .prairie-login-power-button .prairie-login-power-icon {
+  icon-size: 15px; }
+
+.poster-card .prairie-login-power-button:hover, .poster-card .prairie-login-power-button:focus {
+  background-color: rgba(255, 255, 255, 0.08); }
+
+.prairie-login-power-menu .popup-menu-content {
+  min-width: 200px;
+  padding: 5px;
+  border-radius: 16px;
+  background-color: #2c2c32; }
+
+.prairie-login-power-menu .popup-menu-item {
+  min-height: 36px;
+  border-radius: 10px; }
+
+.poster-power-progress {
+  background-color: rgba(0, 0, 0, 0.82); }
+
+.poster-power-progress-label {
+  font-family: "Figtree";
+  font-size: 18px;
+  font-weight: 500;
+  color: white; }
+
+.login-dialog-prompt-layout.prairie-auth-card {
+  width: 320px;
+  padding: 0;
+  spacing: 0;
+  border: 0;
+  background-color: transparent;
+  box-shadow: none; }
+
+.poster-identity {
+  spacing: 0; }
+
+.poster-avatar {
+  icon-size: 76px;
+  border-radius: 99px;
+  border: 0;
+  background-color: #627eae;
+  background-image: none;
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 0 0 5px rgba(255, 255, 255, 0.06), 0 16px 32px -12px rgba(55, 85, 145, 0.8); }
+
+.poster-avatar .prairie-login-avatar-initial {
+  font-family: "Figtree";
+  font-size: 30px;
+  font-weight: 650;
+  color: white; }
+
+.poster-greeting {
+  margin-top: 20px;
+  margin-bottom: 22px;
+  font-family: "Figtree";
+  font-size: 26px;
+  font-weight: 650;
+  letter-spacing: -0.025em;
+  color: #eceeed;
+  text-align: center; }
+
+.login-dialog-prompt-layout.prairie-login-input-well {
+  width: 320px;
+  spacing: 0; }
+
+.login-dialog-button-box.prairie-password-field {
+  width: 320px;
+  height: 44px;
+  padding: 0 5px 0 14px;
+  spacing: 0;
+  border: 0;
+  border-radius: 13px;
+  background-color: rgba(0, 0, 0, 0.28);
+  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.32), inset 0 1px 2px rgba(0, 0, 0, 0.3); }
+
+.login-dialog-button-box.prairie-password-field:focus-within {
+  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.32), inset 0 1px 2px rgba(0, 0, 0, 0.3), 0 0 0 1.5px rgba(92, 164, 220, 0.7); }
+
+.login-dialog .login-dialog-prompt-entry.prairie-login-entry, .unlock-dialog .login-dialog-prompt-entry.prairie-login-entry {
+  min-height: 34px;
+  font-size: 14px; }
+
+.prairie-login-submit-button {
+  width: 34px;
+  height: 34px;
+  min-width: 34px;
+  min-height: 34px;
+  border-radius: 9px;
+  background-gradient-direction: vertical;
+  background-gradient-start: #edeef0;
+  background-gradient-end: #d8d9dc;
+  color: #29292d; }
+
+.prairie-login-submit-button:hover, .prairie-login-submit-button:focus {
+  background-color: #f4f5f7; }
+
+.prairie-login-submit-button .prairie-login-submit-icon {
+  icon-size: 16px;
+  color: #29292d; }
+
+.poster-fingerprint-hint {
+  spacing: 7px;
+  margin-top: 14px;
+  color: rgba(236, 238, 237, 0.42);
+  font-family: "Figtree";
+  font-size: 12.5px; }
+
+.poster-fingerprint-icon {
+  icon-size: 15px;
+  color: rgba(236, 238, 237, 0.42); }
+
+.prairie-login-error, .login-dialog-message-warning.prairie-login-error {
+  margin-top: 8px;
+  font-size: 12.5px;
+  text-align: center; }
+
+.poster-away {
+  spacing: 8px; }
+
+.poster-away-heading {
+  font-family: "Figtree";
+  font-size: 11.5px;
+  font-weight: 600;
+  color: rgba(236, 238, 237, 0.42); }
+
+.poster-away-well {
+  padding: 4px;
+  border-radius: 16px;
+  background-color: rgba(0, 0, 0, 0.28);
+  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.32), inset 0 1px 2px rgba(0, 0, 0, 0.3); }
+
+.poster-away-row {
+  spacing: 12px;
+  padding: 10px; }
+
+.poster-away-row + .poster-away-row {
+  border-top: 1px solid rgba(255, 255, 255, 0.1); }
+
+.poster-away-icon {
+  icon-size: 32px; }
+
+.poster-away-copy {
+  spacing: 1px; }
+
+.poster-away-title {
+  font-family: "Figtree";
+  font-size: 13px;
+  font-weight: 650;
+  color: #eceeed; }
+
+.poster-away-summary {
+  font-family: "Figtree";
+  font-size: 12px;
+  color: rgba(236, 238, 237, 0.64); }
+
+.poster-away-time {
+  font-family: "Figtree";
+  font-size: 11.5px;
+  color: rgba(236, 238, 237, 0.42);
+  font-feature-settings: "tnum"; }
