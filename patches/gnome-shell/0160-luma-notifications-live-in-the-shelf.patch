+    _syncHover() {
+        const newest = this._newest;
+        const engaged = this.hover || this.has_key_focus() ||
+            this._dismiss.has_key_focus() || this._count.has_key_focus();
+        this._dismiss.opacity = engaged && newest ? 255 : 0;
+        this._dismiss.reactive = engaged && !!newest;
+        const actions = engaged && !this._lumaColumn && newest
+            ? newest.actions.slice(0, MAX_ISLAND_ACTIONS) : [];
+        if (this._shownActionsFor !== (actions.length ? newest : null)) {
+            this._actions.destroy_all_children();
+            for (const action of actions) {
+                const button = new St.Button({
+                    style_class: 'luma-notification-beacon-action',
+                    label: action.label,
+                    can_focus: true,
+                });
+                button.connect('clicked', () => {
+                    console.log('[luma-notifications] island ran an action');
+                    action.activate();
+                    if (!newest.resident)
+                        newest.destroy(NotificationDestroyedReason.DISMISSED);
+                });
+                this._actions.add_child(button);
+            }
+            this._shownActionsFor = actions.length ? newest : null;
+        }
+        this._actions.visible = actions.length > 0;
+        this._summary.visible = actions.length === 0;
+    }
+
+    _dismissNewest(how) {
+        const newest = this._newest;
+        if (!newest)
+            return;
+        console.log(`[luma-notifications] island dismissed the newest notification (${how})`);
+        newest.destroy(NotificationDestroyedReason.DISMISSED);
+    }
+
+    // The island follows a horizontal drag; let go far enough, or fast
+    // enough, towards the end of the shelf and the newest notification is
+    // dismissed. Anything shorter springs back.
+    _swipeTarget() {
+        let actor = this;
+        while (actor && !actor.has_style_class_name?.('luma-shelf-beacon-island'))
+            actor = actor.get_parent();
+        return actor ?? this;
+    }
+
+    _onSwipeEvent(event) {
+        const type = event.type();
+        const [x] = event.get_coords();
+        const time = event.get_time();
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        if (type === Clutter.EventType.BUTTON_PRESS && event.get_button() === Clutter.BUTTON_PRIMARY) {
+            this._swipe = {x0: x, samples: [[x, time]], dragging: false};
+            this._swiped = false;
+            return Clutter.EVENT_PROPAGATE;
+        }
+        const swipe = this._swipe;
+        if (!swipe)
+            return Clutter.EVENT_PROPAGATE;
+        if (type === Clutter.EventType.MOTION) {
+            const dx = (x - swipe.x0) / scale;
+            swipe.samples.push([x, time]);
+            if (swipe.samples.length > 4)
+                swipe.samples.shift();
+            if (!swipe.dragging && Math.abs(dx) > SWIPE_START)
+                swipe.dragging = true;
+            if (swipe.dragging) {
+                const target = this._swipeTarget();
+                target.remove_all_transitions();
+                target.translation_x = Math.max(0, dx) * scale;
+                target.opacity = Math.round(255 * Math.max(0.25, 1 - Math.max(0, dx) / 160));
+            }
+            return Clutter.EVENT_PROPAGATE;
+        }
+        if (type !== Clutter.EventType.BUTTON_RELEASE)
+            return Clutter.EVENT_PROPAGATE;
+        this._swipe = null;
+        if (!swipe.dragging)
+            return Clutter.EVENT_PROPAGATE;
+        this._swiped = true;
+        const dx = (x - swipe.x0) / scale;
+        const [[x1, t1]] = swipe.samples;
+        const velocity = time > t1 ? (x - x1) / scale / (time - t1) : 0;
+        const target = this._swipeTarget();
+        const dismiss = dx > SWIPE_DISMISS || (dx > FLING_MIN && velocity > FLING_VELOCITY);
+        console.log(`[luma-notifications] swipe ${Math.round(dx)} px at ${velocity.toFixed(2)} px/ms: ${dismiss ? 'dismiss' : 'spring back'}`);
+        if (dismiss) {
+            target.ease({
+                translation_x: target.translation_x + 120 * scale,
+                opacity: 0,
+                duration: St.Settings.get().enable_animations ? SWIPE_OUT_TIME : 1,
+                mode: Clutter.AnimationMode.EASE_OUT_QUAD,
+                onStopped: () => {
+                    this._dismissNewest('swipe');
+                    target.translation_x = 0;
+                    target.opacity = 255;
+                },
+            });
+        } else {
+            target.ease({
+                translation_x: 0,
+                opacity: 255,
+                duration: St.Settings.get().enable_animations ? SWIPE_BACK_TIME : 1,
+                mode: Clutter.AnimationMode.EASE_OUT_BACK,
+            });
+        }
+        return Clutter.EVENT_PROPAGATE;
+    }
