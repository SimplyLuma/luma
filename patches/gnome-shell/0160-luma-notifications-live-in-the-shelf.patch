     _syncMark() {
         // Real application artwork is shown whole; a glyph sits on a quiet
         // tile, as on a notification card.
-        const glyph = this._markIcon.is_symbolic || !this._markIcon.gicon;
+        // Until the island is first shown its icon has not loaded, so a
