 import Cogl from 'gi://Cogl';
 import GObject from 'gi://GObject';
 import Shell from 'gi://Shell';
+import St from 'gi://St';
 
 const ICON_MASK_DECLARATIONS = `
 uniform float radius;
@@ -45,3 +46,48 @@
     }
 });
 
+
+// Pixel-radius clipping for nonsquare native scroll containers. The mask is
+// applied to the complete actor output, including all children and the rail.
+export const LumaRoundedClip = GObject.registerClass(
+class LumaRoundedClip extends Shell.GLSLEffect {
+    _init(radius = 16) {
+        super._init();
+        this._radius = radius;
+    }
+
+    vfunc_build_pipeline() {
+        this.add_glsl_snippet(Cogl.SnippetHook.FRAGMENT,
+            `uniform vec2 clip_extent;
+             uniform vec2 clip_size;
+             uniform vec2 clip_origin;
+             uniform float clip_radius;`,
+            `vec2 point = cogl_tex_coord_in[0].st * clip_extent + clip_origin;
+             float radius = min(clip_radius, min(clip_size.x, clip_size.y) * 0.5);
+             vec2 half_size = clip_size * 0.5;
+             vec2 q = abs(point - half_size) - (half_size - vec2(radius));
+             float distance = length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - radius;
+             cogl_color_out *= 1.0 - smoothstep(-0.5, 0.5, distance);`, false);
+    }
+
+    vfunc_paint_target(node, paintContext) {
+        const actor = this.actor;
+        const texture = this.get_texture();
+        if (actor && texture) {
+            const scale = Math.max(1, Math.ceil(actor.get_resource_scale()));
+            const volume = actor.get_paint_volume();
+            const origin = volume?.get_origin() ?? {x: 0, y: 0};
+            // Same offscreen enlargement rule as the native window mask.
+            const enlarge = (start, size) => Math.trunc(Math.ceil(start + size + 0.75) - Math.round(size) - 3);
+            const width = volume?.get_width() ?? actor.width;
+            const height = volume?.get_height() ?? actor.height;
+            const set = (name, values) => this.set_uniform_float(this.get_uniform_location(name), values.length, values);
+            set('clip_extent', [texture.get_width() / scale, texture.get_height() / scale]);
+            set('clip_size', [actor.width, actor.height]);
+            set('clip_origin', [enlarge(origin.x, width), enlarge(origin.y, height)]);
+            set('clip_radius', [this._radius * St.ThemeContext.get_for_stage(actor.get_stage()).scale_factor]);
+        }
+        smoothOffscreenSampling(this);
+        super.vfunc_paint_target(node, paintContext);
+    }
+});
