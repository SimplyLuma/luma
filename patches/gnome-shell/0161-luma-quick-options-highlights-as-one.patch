                 } else {
                     // Ink either way: a colour a third party chose is outside
                     // the ink contract and can land on the surface's own
diff --git a/js/ui/panel.js b/js/ui/panel.js
index 786fefd..4c59da8 100644
--- a/js/ui/panel.js
+++ b/js/ui/panel.js
@@ -1444,11 +1444,11 @@ class QuickSettings extends PanelMenu.Button {
         // and stays pressed while Quick Settings is open. The island-wide
         // overlay is no longer drawn.
         this._statusHover.opacity = 0;
