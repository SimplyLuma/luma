     _watchStatus(child) {
diff --git a/js/ui/shelf.js b/js/ui/shelf.js
index 3ff074b..23b5a5b 100644
--- a/js/ui/shelf.js
+++ b/js/ui/shelf.js
@@ -503,6 +503,7 @@ class Shelf extends St.Widget {
         // island of their own.
         // Focus rings on the shelf are for keyboard navigation only.
         this._focusVisible = new FocusVisible(this);
+        this._syncActionsWash();
         this._well = new Well();
         this._actionsMaterial.setStatusWell?.(this._well);
         this._well.connectObject('changed', () => this._queueDockWidth(), this);
@@ -1001,6 +1002,40 @@ class Shelf extends St.Widget {
         }
     }
 
+    // The Quick Options island is one surface (owner, 2026-09-18): the Well's
+    // items, the status icons and the clock never highlight on their own.
+    // Hovered anywhere, the whole island washes once at its own radius;
+    // pressed while a menu of the island is open; and keyboard focus anywhere
+    // in it is one ring round the whole island. The wash is the material's
+    // inset shadow, as for an island that is one action (ShelfIsland.setBody).
+    _syncActionsWash() {
+        const quick = this._actionsMaterial;
+        if (!quick)
+            return;
+        const sync = () => {
+            const focus = global.stage.get_key_focus();
+            const inside = !!focus && (focus === quick || quick.contains(focus));
+            const menuOpen = quick.menu?.isOpen ||
+                (this._well?.get_children?.() ?? []).some(child =>
+                    [child, ...(child.get_children?.() ?? [])].some(a => a.has_style_pseudo_class?.('checked')));
+            const pressed = menuOpen || quick.has_style_pseudo_class('active');
+            const hovered = quick.hover && !pressed;
+            const focused = inside && (this._focusVisible?.keyboard ?? true) && !pressed && !hovered;
+            for (const [name, on] of [['luma-island-press', pressed],
+                ['luma-island-hover', hovered], ['luma-island-focus', focused]]) {
+                if (on)
+                    quick.add_style_class_name(name);
+                else
+                    quick.remove_style_class_name(name);
+            }
+        };
+        quick.connectObject('notify::hover', sync, 'notify::pseudo-class', sync, this);
+        quick.menu?.connectObject('open-state-changed', sync, this);
+        global.stage.connectObject('notify::key-focus', sync, this);
+        this._syncActionsWashNow = sync;
+        sync();
+    }
+
     _restorePanelActors() {
         const indicators = Main.panel.statusArea;
         const quick = indicators.quickSettings;
