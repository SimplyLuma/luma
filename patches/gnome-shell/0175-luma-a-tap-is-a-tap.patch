+    // Whether the finger that started this hold is still down. The island's
+    // press watcher knows even when the touch end went straight to a button
+    // and never passed the shelf at all.
+    _holdStillPressed(hold) {
+        // Only positive evidence cancels: a watcher that saw this press
+        // begin and now says it has ended. A watcher that never saw it
+        // knows nothing, and a hold is not cancelled on ignorance.
+        if (!hold.watched)
+            return true;
+        try {
+            return !!hold.actor?._lumaHoldGesture?.pressed;
+        } catch (e) {
+            return true;
+        }
+    }
+
+    // One press gesture per island, beside whatever gestures the island's
+    // own buttons have. It holds for HOLD_TIME_TOUCH and then this is an
+    // arrangement; released before that, it is whatever the button under
+    // the finger says it is.
+    _watchPresses() {
+        if (!Clutter.LongPressGesture)
+            return;
+        const targets = [];
+        for (const [id, actor] of this._shelf._islands ?? [])
+            targets.push([id, actor]);
+        // The parts inside an island -- the clock, Quick Options, the tray --
+        // have buttons of their own, and a finger on one of those never
+        // reaches the island: the gesture goes where the touch goes.
+        for (const id of ['clock', 'quick-options', 'well', 'live', 'media', 'folders']) {
+            const part = this._shelf.partActorFor?.(id);
+            if (part)
+                targets.push([id, part]);
+        }
+        for (const [id, actor] of targets) {
+            if (!actor || actor._lumaHoldGesture)
+                continue;
+            const gesture = new Clutter.LongPressGesture();
+            if (gesture.set_long_press_duration_ms)
+                gesture.set_long_press_duration_ms(Arrangement.HOLD_TIME_TOUCH);
+            if (gesture.set_cancel_threshold)
+                gesture.set_cancel_threshold(Arrangement.DRAG_THRESHOLD);
+            gesture.connect('may-recognize', () => {
+                if (this._active || !this._shelf.canArrange || !this._shelf._isDesktopSession())
+                    return false;
+                // A long press on a dock icon belongs to the icon's own menu,
+                // whose last item is Arrange Islands.
+                if (id === 'dock') {
+                    const [px, py] = global.get_pointer();
+                    const under = global.stage.get_actor_at_pos(Clutter.PickMode.REACTIVE, px, py);
+                    if (under && this._isDockIcon(under))
+                        return false;
+                }
+                return true;
+            });
+            gesture.connect('recognize', () => {
+                const [x, y] = this._gestureCoords(gesture);
+                this._resetHoldScale(actor);
+                this.begin({grab: id, x, y, pressed: true});
+            });
+            gesture.connect('notify::pressed', () => {
+                if (gesture.pressed)
+                    this._growForHold(actor);
+                else
+                    this._resetHoldScale(actor);
+            });
+            actor.reactive = true;
+            actor.add_action(gesture);
+            actor._lumaHoldGesture = gesture;
+        }
+    }
+
+    _gestureCoords(gesture) {
+        try {
+            const point = gesture.get_coords_abs ? gesture.get_coords_abs() : null;
+            if (point && typeof point.x === 'number')
+                return [point.x, point.y];
+        } catch (e) {
+            // The seat knows where the pointer is, at least.
+        }
+        const [x, y] = global.get_pointer();
+        return [x, y];
+    }
+
+    // The island grows a little under the press from the start, so that a
+    // long press is something the person watches happen rather than
+    // something that happens to them.
+    _growForHold(actor) {
+        if (!St.Settings.get().enable_animations || !actor)
+            return;
+        actor.set_pivot_point(0.5, 0.5);
+        actor.ease({scale_x: HOLD_SCALE, scale_y: HOLD_SCALE,
+            duration: Arrangement.HOLD_TIME_TOUCH,
+            mode: Clutter.AnimationMode.LINEAR});
+    }
+
     _startHold(id, x, y, sequence) {
         this._cancelHold();
         const actor = this._shelf.islandActorFor(id);
