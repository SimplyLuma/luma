+// TV posture: the keyboard's contract with applications. Applications use
+// ordinary text fields; LumaUI asks for the action key's label (Search, Add)
+// and reads the keyboard's height to lift its action bar and toast above it.
+// docs/developer-platform/tv-mode.md ("Typing").
+const TV_KEYBOARD_BUS_NAME = 'org.projectluma.Shell.Keyboard';
+const TV_KEYBOARD_PATH = '/org/projectluma/Shell/Keyboard';
+const TV_KEYBOARD_IFACE = `<node>
+  <interface name="org.projectluma.Shell.Keyboard1">
+    <method name="SetActionLabel">
+      <arg type="s" direction="in" name="label"/>
+    </method>
+    <property name="Visible" type="b" access="read"/>
+    <property name="Height" type="u" access="read"/>
+  </interface>
+</node>`;
+
+class TvKeyboardService {
+    constructor(onLabel) {
+        this._onLabel = onLabel;
+        this._labels = new WeakMap();
+        this._visible = false;
+        this._height = 0;
+        this._dbus = Gio.DBusExportedObject.wrapJSObject(TV_KEYBOARD_IFACE, this);
+        this._dbus.export(Gio.DBus.session, TV_KEYBOARD_PATH);
+        this._nameId = Gio.bus_own_name_on_connection(Gio.DBus.session, TV_KEYBOARD_BUS_NAME,
+            Gio.BusNameOwnerFlags.REPLACE, null, null);
+    }
+
+    get Visible() {
+        return this._visible;
+    }
+
+    get Height() {
+        return this._height;
+    }
+
+    // The label is the focused window's: an application asks as one of its
+    // fields takes the focus, and an empty label gives the field's own back.
+    SetActionLabel(label) {
+        const window = global.display.focus_window;
+        if (!window)
+            return;
+        if (label)
+            this._labels.set(window, String(label));
+        else
+            this._labels.delete(window);
+        this._onLabel();
+    }
+
+    labelFor(window) {
+        return window ? this._labels.get(window) ?? '' : '';
+    }
+
+    // Shown in TV units (one pixel of a 1920x1080 layout), 0 while hidden.
+    setShown(visible, height) {
+        height = visible ? Math.round(height) : 0;
+        if (visible === this._visible && height === this._height)
+            return;
+        this._visible = visible;
+        this._height = height;
+        this._dbus.emit_property_changed('Visible', new GLib.Variant('b', visible));
+        this._dbus.emit_property_changed('Height', new GLib.Variant('u', height));
+    }
