+// SPDX-License-Identifier: GPL-2.0-or-later
+// The Well: the status icons applications publish, given a quiet home at the
+// start of the status island.
+//
+// Applications still speak StatusNotifierItem to the AppIndicator host, which
+// keeps owning the protocol: activation, scrolling and every menu go through
+// it unchanged. Only the presentation is Luma's. Each icon becomes a 16px glyph
+// in the island's ink, a few chosen ones stay in view, and the rest wait behind
+// a count.
+import Atk from 'gi://Atk';
+import Clutter from 'gi://Clutter';
+import Cogl from 'gi://Cogl';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import * as DND from './dnd.js';
+import * as Main from './main.js';
+import * as PopupMenu from './popupMenu.js';
+
+export const PIN_LIMIT = 4;
+export const ATTENTION_LIMIT = 2;
+export const ATTENTION_LINGER_MS = 3000;
+export const READOUT_MAX_CHARS = 6;
+const GLYPH_SIZE = 16;
+const STORE_PATH = GLib.build_filenamev([GLib.get_user_data_dir(), 'luma', 'well.json']);
+
+// What the Well keeps across restarts: the pinned apps in their order, the
+// apps hidden while idle, and every app it has ever seen, so a new one can
+// announce itself once.
+export class WellStore {
+    constructor(path = STORE_PATH) {
+        this._path = path;
+        this.pins = [];
+        this.hiddenWhenIdle = [];
+        this.seen = [];
+        try {
+            const [, bytes] = GLib.file_get_contents(path);
+            const value = JSON.parse(new TextDecoder().decode(bytes));
+            const strings = list => Array.isArray(list) ? list.filter(item => typeof item === 'string').slice(0, 256) : [];
+            this.pins = strings(value.pins);
+            this.hiddenWhenIdle = strings(value.hiddenWhenIdle);
+            this.seen = strings(value.seen);
+        } catch {
+        }
+    }
+
+    save() {
+        try {
+            GLib.mkdir_with_parents(GLib.path_get_dirname(this._path), 0o700);
+            GLib.file_set_contents(this._path, JSON.stringify({
+                pins: this.pins, hiddenWhenIdle: this.hiddenWhenIdle, seen: this.seen}));
+        } catch (e) {
+            console.warn(`[luma-well] could not save: ${e.message}`);
+        }
+    }
+}
+
+// Which items the Well shows, in order, and how many wait behind the count.
+// Pure, so every rule in the handoff is testable without a Shell.
+export function arrange(items, {pins, hiddenWhenIdle, pinLimit = PIN_LIMIT, now = Date.now()}) {
+    const shown = [];
+    const byKey = new Map(items.map(item => [item.key, item]));
+    for (const key of pins.slice(0, pinLimit)) {
+        const item = byKey.get(key);
+        if (item && !(item.status === 'Passive' && hiddenWhenIdle.includes(key)))
+            shown.push(item);
+    }
+    const asking = items.filter(item => !shown.includes(item) &&
+        (item.status === 'NeedsAttention' || (item.attentionUntil ?? 0) > now));
+    shown.push(...asking.slice(0, ATTENTION_LIMIT));
+    shown.push(...items.filter(item => !shown.includes(item) && item.recording));
+    const rest = items.filter(item => !shown.includes(item) &&
+        !(item.status === 'Passive' && hiddenWhenIdle.includes(item.key)));
+    return {shown, rest};
+}
+
+export function readoutText(label) {
+    const text = (label ?? '').trim();
+    return text.length > 0 && text.length <= READOUT_MAX_CHARS ? text : '';
+}
+
+// Paints anything, whatever its colours, as its own shape in one ink.
+const Silhouette = GObject.registerClass(
+class LumaWellSilhouette extends Shell.GLSLEffect {
+    vfunc_build_pipeline() {
+        this.add_glsl_snippet(Cogl.SnippetHook.FRAGMENT,
+            'uniform vec4 well_ink;',
+            'cogl_color_out = vec4(well_ink.rgb, 1.0) * (cogl_color_out.a * well_ink.a);',
+            false);
+    }
+
+    setInk(color) {
+        this.set_uniform_float(this.get_uniform_location('well_ink'), 4,
+            [color.red / 255, color.green / 255, color.blue / 255, color.alpha / 255]);
+    }
+});
+
+const iconTheme = new St.IconTheme();
+
+// One application's status icon, as the AppIndicator host holds it.
+class WellSource {
+    constructor(indicator) {
+        this.indicator = indicator;
+        this.sni = indicator._indicator ?? null;
+        this.tray = this.sni ? null : indicator;
+        this.attentionUntil = 0;
+        this.recording = false;
+    }
+
+    get key() {
+        if (this.sni)
+            return (this.sni.id || this.sni.title || this.sni.uniqueId || '').toLowerCase();
+        return (this.tray?._icon?.wm_class || this.tray?.uniqueId || 'tray').toLowerCase();
+    }
+
+    get name() {
+        if (this.sni)
+            return this.sni.title || this.sni.id || _('Application');
+        return this.tray?._icon?.title || this.tray?._icon?.wm_class || _('Application');
+    }
+
+    get status() {
+        return this.sni?.status ?? 'Active';
+    }
+
+    get label() {
+        return this.sni?.label ?? '';
+    }
+
+    get detail() {
+        let tooltip = this.sni?._proxy?.ToolTip;
+        if (tooltip instanceof GLib.Variant)
+            tooltip = tooltip.deepUnpack();
+        const title = Array.isArray(tooltip) ? `${tooltip[2] ?? ''}` : '';
+        return title || (this.label && !readoutText(this.label) ? this.label : '');
+    }
+
+    get menu() {
+        return this.indicator.menu?.numMenuItems ? this.indicator.menu : null;
+    }
+
+    // The 16px glyph: the theme's symbolic variant, else a glyph Luma ships
+    // for the app, else the host's own rendering of the icon, drawn as its
+    // shape in ink. Colours never show.
+    makeGlyph() {
+        const box = new St.Bin({style_class: 'luma-well-glyph', y_align: Clutter.ActorAlign.CENTER});
+        const effect = new Silhouette();
+        const applyInk = () => {
+            if (box.get_stage())
+                effect.setInk(box.get_theme_node().get_foreground_color());
+        };
+        const host = this.indicator._icon;
+        const sync = () => {
+            const name = this.sni?.icon?.name;
+            const candidates = [name ? `${name}-symbolic` : null, `luma-tray-${this.key}-symbolic`].filter(Boolean);
+            const symbolic = candidates.find(candidate => iconTheme.has_icon(candidate));
+            let glyph;
+            if (symbolic) {
+                glyph = new St.Icon({icon_name: symbolic, icon_size: GLYPH_SIZE});
+            } else if (host?.content && !host.gicon) {
+                // A pixmap the application sent: the host has already turned it into image content.
+                glyph = new Clutter.Actor({content: host.content, width: GLYPH_SIZE, height: GLYPH_SIZE,
+                    content_gravity: Clutter.ContentGravity.RESIZE_ASPECT});
+                glyph.add_effect_with_name('luma-well-silhouette', effect);
+            } else if (host?.gicon || (name && iconTheme.has_icon(name))) {
+                glyph = new St.Icon({gicon: host?.gicon ?? null, icon_name: host?.gicon ? null : name, icon_size: GLYPH_SIZE});
+                glyph.add_effect_with_name('luma-well-silhouette', effect);
+            } else if (this.tray) {
+                glyph = new Clutter.Clone({source: host, width: GLYPH_SIZE, height: GLYPH_SIZE});
+                glyph.add_effect_with_name('luma-well-silhouette', effect);
+            } else {
+                glyph = new St.Icon({icon_name: 'application-x-executable-symbolic', icon_size: GLYPH_SIZE});
+            }
+            glyph.get_parent()?.remove_child(glyph);
+            box.child?.remove_effect?.(effect);
+            box.child = glyph;
+            applyInk();
+        };
+        box.connect('style-changed', applyInk);
+        host?.connectObject('notify::gicon', sync, 'notify::content', sync, box);
+        if (this.sni) {
+            const id = this.sni.connect('icon', () => GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
+                if (box.get_stage())
+                    sync();
+                return GLib.SOURCE_REMOVE;
+            }));
+            box.connect('destroy', () => this.sni.disconnect(id));
+        }
+        sync();
+        return box;
+    }
+
+    activate(event) {
+        if (!this.sni) {
+            this.tray?._icon?.click?.(event);
+            return;
+        }
+        const [x, y] = event.get_coords();
+        // An app whose icon is only a menu opens that menu on a click too.
+        if (this.sni.supportsActivation === false && this.menu)
+            return false;
+        this.sni.open(x, y, event.get_time());
+        return true;
+    }
+
+    secondaryActivate(event) {
+        if (this.sni)
+            this.sni.secondaryActivate(event.get_time(), ...event.get_coords());
+        else
+            this.tray?._icon?.click?.(event);
+    }
+
+    scroll(dx, dy) {
+        this.sni?.scroll(dx, dy);
+    }
+}
+
+// The app's own menu, verbatim, with the Well's section after it.
+function openItemMenu(well, source, anchor) {
+    const menu = source.indicator.menu;
+    if (!menu)
+        return;
+    well.closeMenus();
+    const added = [];
+    const heading = new PopupMenu.PopupMenuItem(source.name.toUpperCase(), {reactive: false, can_focus: false});
+    heading.add_style_class_name('luma-well-menu-heading');
+    if (source.detail) {
+        const status = new St.Label({text: source.detail, style_class: 'luma-well-menu-status',
+            x_expand: true, x_align: Clutter.ActorAlign.END, y_align: Clutter.ActorAlign.CENTER});
+        heading.add_child(status);
+    }
+    menu.addMenuItem(heading, 0);
+    added.push(heading);
+    if (menu.numMenuItems > 1) {
+        const separator = new PopupMenu.PopupSeparatorMenuItem();
+        menu.addMenuItem(separator);
+        added.push(separator);
+    }
+    const section = new PopupMenu.PopupMenuItem(_('In the Bar').toUpperCase(), {reactive: false, can_focus: false});
+    section.add_style_class_name('luma-well-menu-heading');
+    menu.addMenuItem(section);
+    added.push(section);
+    const keep = new PopupMenu.PopupMenuItem(_('Keep in the bar'));
+    keep.setOrnament(well.isPinned(source.key) ? PopupMenu.Ornament.CHECK : PopupMenu.Ornament.NO_DOT);
+    keep.connect('activate', () => well.setPinned(source.key, !well.isPinned(source.key)));
+    menu.addMenuItem(keep);
+    added.push(keep);
+    const idle = new PopupMenu.PopupMenuItem(_('Hide when idle'));
+    idle.setOrnament(well.isHiddenWhenIdle(source.key) ? PopupMenu.Ornament.CHECK : PopupMenu.Ornament.NO_DOT);
+    idle.connect('activate', () => well.setHiddenWhenIdle(source.key, !well.isHiddenWhenIdle(source.key)));
+    menu.addMenuItem(idle);
+    added.push(idle);
+    menu.sourceActor = anchor;
+    menu.setArrowSide(well.arrowSide);
+    const id = menu.connect('open-state-changed', (_menu, open) => {
+        if (open)
+            return;
+        menu.disconnect(id);
+        // After the close animation, so the menu never visibly loses rows.
+        GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
+            for (const item of added)
+                item.destroy();
+            return GLib.SOURCE_REMOVE;
+        });
+    });
+    menu.open(true);
