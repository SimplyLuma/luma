new file mode 100644
index 0000000..2948845
--- /dev/null
+++ b/js/ui/lumaSettingsSearch.js
@@ -0,0 +1,145 @@
+// Settings pages and options for Beam (Luma Search).
+//
+// Settings' own search provider finds whole panels. This provider adds the
+// pages and options inside them ("Dark Style", "Night Light", "Automatic
+// Suspend", "Default Apps", Luma's Background Activity and Cast, Depot's
+// Updates) and the everyday words people type for them. The table ships with
+// luma-search as settings-pages.json and is ranked with the same model as
+// apps and files.
+
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import St from 'gi://St';
+
+import * as Ranking from './lumaSearchRanking.js';
+
+const SETTINGS_DESKTOP_ID = 'org.gnome.Settings.desktop';
+const PAGES_FILE = ['luma-search', 'settings-pages.json'];
+const LUMA_SEARCH_SCHEMA = 'org.projectluma.search';
+
+Gio._promisify(Gio.File.prototype, 'load_contents_async');
+Gio._promisify(Gio.DBusConnection.prototype, 'call');
+
+function panelInfo(panel) {
+    return Gio.DesktopAppInfo.new(`gnome-${panel}-panel.desktop`);
+}
+
+export class LumaSettingsSearchProvider {
+    constructor() {
+        this.id = 'luma-settings';
+        this.isRemoteProvider = false;
+        this.canLaunchSearch = false;
+        this.lumaKind = 'setting';
+        this.maxResults = 5;
+        // No appInfo: the provider belongs to the Shell (see lumaFileSearch.js).
+        this.appInfo = null;
+        this._settingsApp = Gio.DesktopAppInfo.new(SETTINGS_DESKTOP_ID);
+
+        this._pages = [];
+        this._byId = new Map();
+        this._loading = null;
+        const source = Gio.SettingsSchemaSource.get_default();
+        this._lumaSettings = source?.lookup(LUMA_SEARCH_SCHEMA, true)
+            ? new Gio.Settings({schema_id: LUMA_SEARCH_SCHEMA}) : null;
+    }
+
+    get enabled() {
+        return !this._lumaSettings ||
+            this._lumaSettings.get_strv('enabled-kinds').includes('setting');
+    }
+
+    warmUp() {
+        this._load().catch(e => console.warn(`Luma Search settings: ${e.message}`));
+    }
+
+    _load() {
+        this._loading ??= (async () => {
+            for (const dir of GLib.get_system_data_dirs()) {
+                const file = Gio.File.new_for_path(GLib.build_filenamev([dir, ...PAGES_FILE]));
+                let contents;
+                try {
+                    // eslint-disable-next-line no-await-in-loop
+                    [contents] = await file.load_contents_async(null);
+                } catch {
+                    continue;
+                }
+                const data = JSON.parse(new TextDecoder().decode(contents));
+                // Only pages whose panel or app is installed on this machine.
+                this._pages = (data.pages ?? []).filter(page =>
+                    page.id && page.title &&
+                    (page.panel ? panelInfo(page.panel) : Gio.DesktopAppInfo.new(page.desktop ?? '')));
+                this._byId = new Map(this._pages.map(page => [page.id, page]));
+                return;
+            }
+        })();
+        return this._loading;
+    }
+
+    async getInitialResultSet(terms, cancellable) {
+        if (!this.enabled)
+            return [];
+        await this._load();
+        if (cancellable?.is_cancelled())
+            throw new GLib.Error(Gio.IOErrorEnum, Gio.IOErrorEnum.CANCELLED, 'Operation was cancelled');
+        const folded = Ranking.splitTerms(terms.join(' '));
+        this._scores = new Map();
+        return Ranking.rankSettingPages(this._pages, folded, this.maxResults).map(item => {
+            this._scores.set(item.page.id, item.score);
+            return item.page.id;
+        });
+    }
+
+    getSubsearchResultSet(_previousResults, terms, cancellable) {
+        return this.getInitialResultSet(terms, cancellable);
+    }
+
+    filterResults(results, maxNumber) {
+        return results.slice(0, maxNumber);
+    }
+
+    getResultMetas(ids) {
+        return Promise.resolve(ids.map(id => {
+            const page = this._byId.get(id);
+            const info = page.panel ? panelInfo(page.panel) : Gio.DesktopAppInfo.new(page.desktop);
+            const gicon = info?.get_icon() ?? Gio.ThemedIcon.new('preferences-system-symbolic');
+            return {
+                id,
+                name: page.title,
+                description: page.panel ? `${_('Settings')} › ${page.path}` : page.path,
+                createIcon: size => new St.Icon({gicon, icon_size: size}),
+                lumaScore: this._scores?.get(id) ?? 0,
+                lumaKindLabel: page.panel ? _('Setting') : _('App'),
+                lumaPanel: page.panel ?? null,
+            };
+        }));
+    }
+
+    activateResult(id) {
+        const page = this._byId.get(id);
+        if (!page)
+            return;
+        const context = global.create_app_launch_context(0, -1);
+        if (!page.panel) {
+            const app = Gio.DesktopAppInfo.new(page.desktop);
+            if (page.action)
+                app?.launch_action(page.action, context);
+            else
+                app?.launch([], context);
+            return;
+        }
+        // Settings is D-Bus activatable; launch-panel opens the exact panel
+        // and passes any parameters the panel understands.
+        const params = (page.params ?? []).map(value => new GLib.Variant('s', value));
+        Gio.DBus.session.call(
+            'org.gnome.Settings', '/org/gnome/Settings', 'org.gtk.Actions', 'Activate',
+            new GLib.Variant('(sava{sv})', [
+                'launch-panel',
+                [new GLib.Variant('(sav)', [page.panel, params])],
+                {'desktop-startup-id': new GLib.Variant('s', `_TIME${global.get_current_time()}`)},
+            ]),
+            null, Gio.DBusCallFlags.NONE, -1, null).catch(e => {
+            console.warn(`Luma Search settings: could not open ${page.panel}: ${e.message}`);
+            this._settingsApp?.launch([], context);
+        });
+    }
+}
