new file mode 100644
index 0000000..5c3391d
--- /dev/null
+++ b/js/ui/lumaFileIndex.js
@@ -0,0 +1,433 @@
+// Files and folders for Luma Search, from the LocalSearch index.
+//
+// LocalSearch (tinysparql) already crawls the places chosen in Settings →
+// Search and skips hidden files and excluded folders, so Search keeps no
+// index of its own. This module asks it for names that start with the typed
+// words, adds recently used files and the top of the home folder, and ranks
+// everything with lumaSearchRanking.js. Nothing here blocks the main loop.
+//
+// No St or Shell imports: the ranking and query tests run it under gjs.
+
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+
+import * as Ranking from './lumaSearchRanking.js';
+
+const LOCALSEARCH_BUS_NAME = 'org.freedesktop.LocalSearch3';
+const CANDIDATE_LIMIT = 200;
+const SHALLOW_LIMIT = 100;
+const RESULT_LIMIT = 24;
+const PICKS_LIMIT = 300;
+const PRIVACY_SCHEMA = 'org.gnome.desktop.privacy';
+
+// Folder contents that are never worth offering, filtered in the index.
+const HIDDEN_URL_PARTS = ['/node_modules/', '/__pycache__/', '/site-packages/', '/.git/'];
+
+// Two orderings of the same matches: the shortest names (exact and prefix
+// matches) and the shortest paths (shallow places), so neither thousands of
+// short names deep in an archive nor long names near home crowd out the other.
+const sparql = (order, limit) => `
+SELECT ?url ?name ?modified WHERE {
+  GRAPH tracker:FileSystem {
+    ?file fts:match ~match ;
+          nfo:fileName ?name ;
+          nie:url ?url ;
+          nfo:fileLastModified ?modified .
+    ${HIDDEN_URL_PARTS.map(part => `FILTER (!CONTAINS(?url, "${part}"))`).join('\n    ')}
+  }
+}
+ORDER BY ${order}
+LIMIT ${limit}`;
+const QUERIES = [
+    sparql('STRLEN(?name)', CANDIDATE_LIMIT),
+    sparql('STRLEN(?url)', SHALLOW_LIMIT),
+];
+
+Gio._promisify(Gio.File.prototype, 'load_contents_async');
+Gio._promisify(Gio.File.prototype, 'query_info_async');
+Gio._promisify(Gio.File.prototype, 'enumerate_children_async');
+Gio._promisify(Gio.File.prototype, 'replace_contents_bytes_async', 'replace_contents_finish');
+Gio._promisify(Gio.FileEnumerator.prototype, 'next_files_async');
+
+function cancelledError() {
+    return new GLib.Error(Gio.IOErrorEnum, Gio.IOErrorEnum.CANCELLED, 'Operation was cancelled');
+}
+
+function throwIfCancelled(cancellable) {
+    if (cancellable?.is_cancelled())
+        throw cancelledError();
+}
+
+function isoToSeconds(value) {
+    if (!value)
+        return 0;
+    const date = GLib.DateTime.new_from_iso8601(value, GLib.TimeZone.new_utc());
+    return date ? date.to_unix() : 0;
+}
+
+function logWarning(message) {
+    console.warn(`Luma Search files: ${message}`);
+}
+
+export class LumaFileIndex {
+    constructor(params = {}) {
+        this._home = params.home ?? GLib.get_home_dir();
+        this._busName = params.busName ?? LOCALSEARCH_BUS_NAME;
+        this._connectionFactory = params.connectionFactory ?? null;
+        this._recentPath = params.recentPath ??
+            GLib.build_filenamev([GLib.get_user_data_dir(), 'recently-used.xbel']);
+        this._picksPath = params.picksPath ??
+            GLib.build_filenamev([GLib.get_user_state_dir(), 'luma', 'search-picks.json']);
+        this._now = params.now ?? (() => GLib.get_real_time() / 1000000);
+        this._privacy = params.privacySettings ?? this._loadPrivacySettings();
+
+        this._connection = null;
+        this._connectionPromise = null;
+        this._statements = null;
+        this._tsparql = null;
+        this._unavailableUntil = 0;
+
+        this._recent = new Map();
+        this._recentStamp = -1;
+        this._homeEntries = [];
+        this._homeStamp = -1;
+        this._picks = new Map();
+        this._picksLoaded = false;
+        this._picksSaveId = 0;
+
+        this._xdgFolders = new Set();
+        for (const key of Ranking.XDG_FOLDER_KEYS) {
+            const path = GLib.get_user_special_dir(GLib.UserDirectory[`DIRECTORY_${key}`]);
+            if (path && path !== this._home)
+                this._xdgFolders.add(path);
+        }
+        for (const path of params.xdgFolders ?? [])
+            this._xdgFolders.add(path);
+    }
+
+    _loadPrivacySettings() {
+        const source = Gio.SettingsSchemaSource.get_default();
+        return source?.lookup(PRIVACY_SCHEMA, true)
+            ? new Gio.Settings({schema_id: PRIVACY_SCHEMA})
+            : null;
+    }
+
+    get _rememberRecent() {
+        return this._privacy?.get_boolean('remember-recent-files') ?? true;
+    }
+
+    get _recentMaxAgeSeconds() {
+        const days = this._privacy?.get_int('recent-files-max-age') ?? -1;
+        return days < 0 ? Infinity : days * 86400;
+    }
+
+    // Prepare the connection and the cached lists before the first keystroke.
+    warmUp() {
+        this._ensureStatements(null).catch(() => {});
+        this._refreshRecent(null).catch(() => {});
+        this._refreshHome(null).catch(() => {});
+        this._loadPicks().catch(() => {});
+    }
+
+    async _ensureStatements(cancellable) {
+        if (this._statements)
+            return this._statements;
+        if (this._now() < this._unavailableUntil)
+            return null;
+        if (!this._connectionPromise) {
+            this._connectionPromise = (async () => {
+                if (this._connectionFactory)
+                    return this._connectionFactory();
+                // Load the typelib lazily: without tinysparql Search keeps
+                // working, it just has no files.
+                const {default: Tsparql} = await import('gi://Tsparql?version=3.0');
+                this._tsparql = Tsparql;
+                return new Promise((resolve, reject) => {
+                    Tsparql.SparqlConnection.bus_new_async(
+                        this._busName, null, null, null, (_source, result) => {
+                            try {
+                                resolve(Tsparql.SparqlConnection.bus_new_finish(result));
+                            } catch (e) {
+                                reject(e);
+                            }
+                        });
+                });
+            })();
+        }
+        try {
+            this._connection = await this._connectionPromise;
+            throwIfCancelled(cancellable);
+            this._statements = QUERIES.map(query => this._connection.query_statement(query, null));
+            return this._statements;
+        } catch (e) {
+            if (e.matches?.(Gio.IOErrorEnum, Gio.IOErrorEnum.CANCELLED))
+                throw e;
+            // LocalSearch is missing or failed to start. Try again later
+            // rather than on every keystroke.
+            logWarning(`index unavailable: ${e.message}`);
+            this._connectionPromise = null;
+            this._unavailableUntil = this._now() + 30;
+            return null;
+        }
+    }
+
+    async _runQuery(match, cancellable) {
+        const statements = await this._ensureStatements(cancellable);
+        if (!statements || !match)
+            return [];
+        const results = await Promise.all(
+            statements.map(statement => this._runStatement(statement, match, cancellable)));
+        return results.flat();
+    }
+
+    async _runStatement(statement, match, cancellable) {
+        statement.bind_string('match', match);
+        const cursor = await new Promise((resolve, reject) => {
+            statement.execute_async(cancellable, (_source, result) => {
+                try {
+                    resolve(statement.execute_finish(result));
+                } catch (e) {
+                    reject(e);
+                }
+            });
+        });
+        const rows = [];
+        try {
+            for (;;) {
+                // eslint-disable-next-line no-await-in-loop
+                const more = await new Promise((resolve, reject) => {
+                    cursor.next_async(cancellable, (_source, result) => {
+                        try {
+                            resolve(cursor.next_finish(result));
+                        } catch (e) {
+                            reject(e);
+                        }
+                    });
+                });
+                if (!more)
+                    break;
+                const [url] = cursor.get_string(0);
+                const [name] = cursor.get_string(1);
+                const [modified] = cursor.get_string(2);
+                if (!url?.startsWith('file://') || !name)
+                    continue;
+                const path = Gio.File.new_for_uri(url).get_path();
+                if (path)
+                    rows.push({path, name, uri: url, modified: isoToSeconds(modified)});
+            }
+        } finally {
+            cursor.close();
+        }
+        return rows;
+    }
+
+    async _refreshRecent(cancellable) {
+        if (!this._rememberRecent) {
+            this._recent.clear();
+            this._recentStamp = -1;
+            return;
+        }
+        const file = Gio.File.new_for_path(this._recentPath);
+        let stamp;
+        try {
+            const info = await file.query_info_async('time::modified,time::modified-usec',
+                Gio.FileQueryInfoFlags.NONE, GLib.PRIORITY_DEFAULT, cancellable);
+            stamp = info.get_attribute_uint64('time::modified') * 1e6 +
+                info.get_attribute_uint32('time::modified-usec');
+        } catch {
+            this._recent.clear();
+            return;
+        }
+        if (stamp === this._recentStamp)
+            return;
+        const [contents] = await file.load_contents_async(cancellable);
+        const bookmarks = new GLib.BookmarkFile();
+        bookmarks.load_from_data(contents);
+        const recent = new Map();
+        const now = this._now();
+        const maxAge = this._recentMaxAgeSeconds;
+        for (const uri of bookmarks.get_uris()) {
+            if (!uri.startsWith('file://'))
+                continue;
+            try {
+                const stampOf = read => {
+                    try {
+                        return read()?.to_unix() ?? 0;
+                    } catch {
+                        return 0;
+                    }
+                };
+                const visited = Math.max(
+                    stampOf(() => bookmarks.get_visited_date_time(uri)),
+                    stampOf(() => bookmarks.get_modified_date_time(uri)));
+                if (now - visited > maxAge)
+                    continue;
+                let visits = 0;
+                for (const app of bookmarks.get_applications(uri) ?? []) {
+                    const info = bookmarks.get_application_info(uri, app);
+                    visits += Number(info?.[2] ?? 0);
+                }
+                const gfile = Gio.File.new_for_uri(uri);
+                const path = gfile.get_path();
+                if (path)
+                    recent.set(path, {path, uri, name: gfile.get_basename(), visited, visits});
+            } catch {
+            }
+        }
+        this._recent = recent;
+        this._recentStamp = stamp;
+    }
+
+    async _refreshHome(cancellable) {
+        const home = Gio.File.new_for_path(this._home);
+        try {
+            const info = await home.query_info_async('time::modified',
+                Gio.FileQueryInfoFlags.NONE, GLib.PRIORITY_DEFAULT, cancellable);
+            const stamp = info.get_attribute_uint64('time::modified');
+            if (stamp === this._homeStamp)
+                return;
+            const enumerator = await home.enumerate_children_async(
+                'standard::name,standard::is-hidden,standard::is-backup',
+                Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS, GLib.PRIORITY_LOW, cancellable);
+            const entries = [];
+            for (;;) {
+                // eslint-disable-next-line no-await-in-loop
+                const infos = await enumerator.next_files_async(200, GLib.PRIORITY_LOW, cancellable);
+                if (!infos.length)
+                    break;
+                for (const child of infos) {
+                    if (child.get_is_hidden() || child.get_is_backup())
+                        continue;
+                    const name = child.get_name();
+                    entries.push({path: GLib.build_filenamev([this._home, name]), name});
+                }
+                if (entries.length > 2000)
+                    break;
+            }
+            enumerator.close(null);
+            this._homeEntries = entries;
+            this._homeStamp = stamp;
+        } catch (e) {
+            if (e.matches?.(Gio.IOErrorEnum, Gio.IOErrorEnum.CANCELLED))
+                throw e;
+        }
+    }
+
+    async _loadPicks() {
+        if (this._picksLoaded)
+            return;
+        this._picksLoaded = true;
+        try {
+            const [contents] = await Gio.File.new_for_path(this._picksPath).load_contents_async(null);
+            const data = JSON.parse(new TextDecoder().decode(contents));
+            for (const [path, value] of Object.entries(data?.picks ?? {})) {
+                if (typeof value?.count === 'number' && typeof value?.last === 'number')
+                    this._picks.set(path, value);
+            }
+        } catch {
+        }
+    }
+
+    // Remember a result the person opened, so it ranks higher next time.
+    recordPick(path) {
+        if (!this._rememberRecent || !path)
+            return;
+        const existing = this._picks.get(path);
+        this._picks.delete(path);
+        this._picks.set(path, {count: (existing?.count ?? 0) + 1, last: Math.round(this._now())});
+        while (this._picks.size > PICKS_LIMIT)
+            this._picks.delete(this._picks.keys().next().value);
+        if (this._picksSaveId)
+            return;
+        this._picksSaveId = GLib.timeout_add_seconds(GLib.PRIORITY_LOW, 2, () => {
+            this._picksSaveId = 0;
+            this._savePicks().catch(e => logWarning(`could not save picks: ${e.message}`));
+            return GLib.SOURCE_REMOVE;
+        });
+    }
+
+    async _savePicks() {
+        const file = Gio.File.new_for_path(this._picksPath);
+        GLib.mkdir_with_parents(GLib.path_get_dirname(this._picksPath), 0o700);
+        const data = JSON.stringify({version: 1, picks: Object.fromEntries(this._picks)});
+        await file.replace_contents_bytes_async(new GLib.Bytes(new TextEncoder().encode(data)),
+            null, false, Gio.FileCreateFlags.PRIVATE, null);
+    }
+
+    destroy() {
+        if (this._picksSaveId) {
+            GLib.source_remove(this._picksSaveId);
+            this._picksSaveId = 0;
+            this._savePicks().catch(() => {});
+        }
+        this._connection?.close_async?.(null, null);
+        this._statements = null;
+        this._connection = null;
+    }
+
+    _withUsage(candidate) {
+        const recent = this._rememberRecent ? this._recent.get(candidate.path) : null;
+        const pick = this._rememberRecent ? this._picks.get(candidate.path) : null;
+        return {
+            ...candidate,
+            visited: recent?.visited ?? 0,
+            visits: recent?.visits ?? 0,
+            picked: pick?.last ?? 0,
+            picks: pick?.count ?? 0,
+        };
+    }
+
+    // Returns ranked candidates: {path, uri, name, score, tier, evidence}.
+    async search(terms, cancellable = null) {
+        terms = terms.map(term => Ranking.foldText(term)).filter(Boolean);
+        if (!terms.length)
+            return [];
+        const context = {home: this._home, now: this._now(), xdgFolders: this._xdgFolders};
+        const local = () => [
+            ...this._homeEntries,
+            ...[...this._xdgFolders].map(path => ({path, name: GLib.path_get_basename(path)})),
+            ...(this._rememberRecent ? this._recent.values() : []),
+            ...(this._rememberRecent ? [...this._picks.keys()].map(path => ({path, name: GLib.path_get_basename(path)})) : []),
+        ];
+
+        // One letter matches a large share of any home folder; start asking
+        // the index from the second letter. Home, recent files and picks
+        // still answer the first.
+        const typed = terms.join('').length;
+        const [hits] = await Promise.all([
+            typed >= 2 ? this._runQuery(Ranking.ftsQuery(terms), cancellable) : [],
+            this._refreshRecent(cancellable).catch(e => {
+                if (e.matches?.(Gio.IOErrorEnum, Gio.IOErrorEnum.CANCELLED))
+                    throw e;
+            }),
+        ]);
+        throwIfCancelled(cancellable);
+        let ranked = Ranking.rankFiles([...local(), ...hits].map(c => this._withUsage(c)),
+            terms, context, RESULT_LIMIT);
+
+        // A typo in a longer word: look again with the first half of it.
+        const typoPossible = terms.some(term => term.length >= 5);
+        if (typoPossible && !ranked.some(item => item.tier >= Ranking.TIER_WORD)) {
+            const more = await this._runQuery(Ranking.ftsQuery(terms, {shorten: true}), cancellable);
+            throwIfCancelled(cancellable);
+            ranked = Ranking.rankFiles([...local(), ...hits, ...more].map(c => this._withUsage(c)),
+                terms, context, RESULT_LIMIT);
+        }
+        for (const item of ranked)
+            item.uri ??= Gio.File.new_for_path(item.path).get_uri();
+        return ranked;
+    }
+
+    shortParent(path) {
+        const parent = GLib.path_get_dirname(path);
+        if (parent === this._home)
+            return _('Home');
+        let display = parent.startsWith(`${this._home}/`)
+            ? `~/${parent.slice(this._home.length + 1)}`
+            : parent;
+        const parts = display.split('/');
+        if (parts.length > 4)
+            display = `${parts[0]}/…/${parts.slice(-2).join('/')}`;
+        return display;
+    }
+}
diff --git a/js/ui/lumaFileSearch.js b/js/ui/lumaFileSearch.js
new file mode 100644
index 0000000..30e7d63
--- /dev/null
+++ b/js/ui/lumaFileSearch.js
@@ -0,0 +1,156 @@
+// The Files and Folders provider for Beam (Luma Search).
+//
+// It replaces the Filer (Nautilus) D-Bus search provider inside Beam so that
+// files and folders share one ranked list with apps and settings. Opening a
+// result uses the default app; Ctrl+Enter or the row's folder button shows
+// it in Filer.
+
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import St from 'gi://St';
+
+import * as Main from './main.js';
+import {LumaFileIndex} from './lumaFileIndex.js';
+
+const FILER_DESKTOP_ID = 'org.gnome.Nautilus.desktop';
+const SEARCH_PROVIDERS_SCHEMA = 'org.gnome.desktop.search-providers';
+const LUMA_SEARCH_SCHEMA = 'org.projectluma.search';
+const INFO_ATTRIBUTES = [
+    'standard::type', 'standard::content-type', 'standard::icon',
+    'standard::symbolic-icon', 'standard::display-name', 'standard::is-hidden',
+].join(',');
+
+Gio._promisify(Gio.File.prototype, 'query_info_async');
+Gio._promisify(Gio.AppInfo, 'launch_default_for_uri_async');
+Gio._promisify(Gio.DBusConnection.prototype, 'call');
+
+function optionalSettings(schemaId) {
+    const source = Gio.SettingsSchemaSource.get_default();
+    return source?.lookup(schemaId, true) ? new Gio.Settings({schema_id: schemaId}) : null;
+}
+
+export class LumaFileSearchProvider {
+    constructor(params = {}) {
+        this.id = 'luma-files';
+        this.isRemoteProvider = false;
+        this.canLaunchSearch = false;
+        this.replacesProviderIds = [FILER_DESKTOP_ID];
+        this.lumaKind = 'file';
+        this.maxResults = 8;
+        // No appInfo: the provider belongs to the Shell, so the results view
+        // must not hide it when Filer's launcher is hidden in this session.
+        this.appInfo = null;
+
+        this._index = params.index ?? new LumaFileIndex();
+        this._found = new Map();
+        this._providerSettings = optionalSettings(SEARCH_PROVIDERS_SCHEMA);
+        this._lumaSettings = optionalSettings(LUMA_SEARCH_SCHEMA);
+    }
+
+    // Settings → Search can switch Files off, and Luma Search can hide the
+    // file kind; both are honoured before any lookup happens.
+    get enabled() {
+        if (this._lumaSettings &&
+            !this._lumaSettings.get_strv('enabled-kinds').includes('file'))
+            return false;
+        if (this._providerSettings?.get_strv('disabled').includes(FILER_DESKTOP_ID))
+            return false;
+        return true;
+    }
+
+    warmUp() {
+        if (this.enabled)
+            this._index.warmUp();
+    }
+
+    async _info(item, cancellable) {
+        try {
+            item.info = await Gio.File.new_for_uri(item.uri).query_info_async(INFO_ATTRIBUTES,
+                Gio.FileQueryInfoFlags.NONE, GLib.PRIORITY_DEFAULT, cancellable);
+        } catch (e) {
+            if (e.matches?.(Gio.IOErrorEnum, Gio.IOErrorEnum.CANCELLED))
+                throw e;
+            item.info = null;
+        }
+        return item;
+    }
+
+    async getInitialResultSet(terms, cancellable) {
+        if (!this.enabled)
+            return [];
+        const started = GLib.get_monotonic_time();
+        const ranked = await this._index.search(terms, cancellable);
+        // Check the best few still exist before showing them: the index can
+        // lag behind a delete or an unplugged drive.
+        const checked = await Promise.all(
+            ranked.slice(0, this.maxResults + 4).map(item => this._info(item, cancellable)));
+        const present = checked.filter(item => item.info && !item.info.get_is_hidden());
+        this._found = new Map(present.map(item => [item.uri, item]));
+        const elapsed = (GLib.get_monotonic_time() - started) / 1000;
+        if (elapsed > 50)
+            console.warn(`Luma Search files: slow lookup, ${present.length} results in ${elapsed.toFixed(1)} ms`);
+        return present.map(item => item.uri);
+    }
+
+    getSubsearchResultSet(_previousResults, terms, cancellable) {
+        // The index is fast enough to ask again, and a narrower query can
+        // surface names the broader one cut off.
+        return this.getInitialResultSet(terms, cancellable);
+    }
+
+    filterResults(results, maxNumber) {
+        return results.slice(0, maxNumber);
+    }
+
+    async getResultMetas(ids, cancellable) {
+        return Promise.all(ids.map(async uri => {
+            let item = this._found.get(uri);
+            if (!item?.info) {
+                const path = Gio.File.new_for_uri(uri).get_path() ?? '';
+                item = await this._info({uri, path, name: GLib.path_get_basename(path)}, cancellable);
+            }
+            const info = item.info;
+            const isFolder = info?.get_file_type() === Gio.FileType.DIRECTORY;
+            const gicon = info?.get_icon() ??
+                Gio.ThemedIcon.new(isFolder ? 'folder' : 'text-x-generic');
+            return {
+                id: uri,
+                name: info?.get_display_name() ?? item.name,
+                description: this._index.shortParent(item.path),
+                createIcon: size => new St.Icon({gicon, icon_size: size}),
+                lumaScore: item.score ?? 0,
+                lumaKindLabel: isFolder ? _('Folder') : _('File'),
+                lumaCanReveal: true,
+            };
+        }));
+    }
+
+    activateResult(uri, _terms) {
+        const item = this._found.get(uri);
+        this._index.recordPick(item?.path ?? Gio.File.new_for_uri(uri).get_path());
+        const context = global.create_app_launch_context(0, -1);
+        Gio.AppInfo.launch_default_for_uri_async(uri, context, null).catch(e => {
+            console.warn(`Luma Search files: could not open ${uri}: ${e.message}`);
+            this.revealResult(uri);
+        });
+    }
+
+    revealResult(uri) {
+        const item = this._found.get(uri);
+        this._index.recordPick(item?.path ?? Gio.File.new_for_uri(uri).get_path());
+        Gio.DBus.session.call(
+            'org.freedesktop.FileManager1',
+            '/org/freedesktop/FileManager1',
+            'org.freedesktop.FileManager1',
+            'ShowItems',
+            new GLib.Variant('(ass)', [[uri], '']),
+            null, Gio.DBusCallFlags.NONE, -1, null).catch(e => {
+            console.warn(`Luma Search files: could not show ${uri} in Filer: ${e.message}`);
+            Main.notifyError(_('Could not show the item in Filer'), e.message);
+        });
+    }
+
+    destroy() {
+        this._index.destroy();
+    }
+}
