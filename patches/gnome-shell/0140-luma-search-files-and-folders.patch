diff --git a/js/ui/lumaSearchRanking.js b/js/ui/lumaSearchRanking.js
new file mode 100644
index 0000000..77a1860
--- /dev/null
+++ b/js/ui/lumaSearchRanking.js
@@ -0,0 +1,414 @@
+// Luma Search ranking: one score for apps, settings, files and folders so
+// Beam can show a single list ordered by how well each result fits the query.
+//
+// This module has no imports so the same code runs in the Shell, under gjs
+// and under node for the ranking tests. luma-search (Python) implements the
+// same model; tests/search/ranking-vectors.json keeps the two in step.
+
+export const TIER_EXACT = 1000;
+export const TIER_PREFIX = 800;
+export const TIER_WORD = 600;
+export const TIER_SUBSTRING = 350;
+export const TIER_FUZZY = 150;
+
+const COMPLETION_BONUS = 100;
+const APP_NAME_BONUS = 150;
+const APP_EXACT_BONUS = 300;
+const SETTING_BONUS = 60;
+const XDG_BOOST = 200;
+const USAGE_BOOST_CAP = 180;
+const JUNK_PENALTY_CAP = 400;
+const JUNK_PATH_PENALTY = 450;
+const DEPTH_STEP = 30;
+const DEPTH_CAP = 180;
+const OUTSIDE_HOME_PENALTY = 120;
+const DAY = 86400;
+
+export const XDG_FOLDER_KEYS = ['DESKTOP', 'DOCUMENTS', 'DOWNLOAD', 'MUSIC', 'PICTURES', 'VIDEOS'];
+
+// Directories whose contents are build output, caches or tool state.
+export const JUNK_DIRECTORIES = new Set([
+    '.git', '.hg', '.svn', 'node_modules', '__pycache__', '.cache', 'cache',
+    'build', 'builddir', '_build', 'dist', 'target', 'obj', '.venv', 'venv',
+    'site-packages', '.tox', '.mypy_cache', '.pytest_cache', '.gradle',
+    '.flatpak-builder', 'buildroot', 'rpmbuild', 'cmakefiles', 'tmp', 'temp',
+    '.tmp', 'vendor', '.npm', '.cargo', '.rustup', 'deps',
+]);
+
+const JUNK_WORDS = new Map([
+    ['backup', 220], ['backups', 220], ['bak', 220], ['bck', 220], ['bkp', 220],
+    ['copy', 220], ['old', 200], ['orig', 180], ['tmp', 220], ['temp', 200],
+    ['autosave', 220], ['conflicted', 200], ['stale', 160], ['archived', 120],
+]);
+const JUNK_EXTENSIONS = new Set(['bak', 'old', 'orig', 'tmp', 'swp', 'swo', 'part', 'crdownload', 'rej']);
+
+export function foldText(value) {
+    return String(value ?? '')
+        .normalize('NFKD')
+        .replace(/[\u0300-\u036f]/g, '')
+        .toLowerCase();
+}
+
+export function splitTerms(query) {
+    return foldText(query).trim().split(/\s+/).filter(Boolean);
+}
+
+// Break a display name into lower-case words: separators, camelCase and
+// letter/digit changes all start a new word.
+export function nameWords(name) {
+    const spaced = String(name ?? '')
+        .replace(/([a-z\u00e0-\u024f])([A-Z])/g, '$1 $2')
+        .replace(/([A-Za-z])(\d)/g, '$1 $2')
+        .replace(/(\d)([A-Za-z])/g, '$1 $2');
+    return foldText(spaced).split(/[^\p{L}\p{N}]+/u).filter(Boolean);
+}
+
+export function splitExtension(name) {
+    const text = String(name ?? '');
+    const dot = text.lastIndexOf('.');
+    // ".bashrc" has no extension; "archive.tar.gz" keeps "archive.tar".
+    if (dot <= 0 || dot === text.length - 1 || text.length - dot > 12)
+        return [text, ''];
+    return [text.slice(0, dot), text.slice(dot + 1)];
+}
+
+function editDistance(a, b, limit) {
+    // Optimal string alignment distance, stopping early past the limit.
+    if (Math.abs(a.length - b.length) > limit)
+        return limit + 1;
+    let before = null;
+    let previous = Array.from({length: b.length + 1}, (_, i) => i);
+    for (let i = 1; i <= a.length; i++) {
+        const current = [i];
+        let best = i;
+        for (let j = 1; j <= b.length; j++) {
+            const cost = a[i - 1] === b[j - 1] ? 0 : 1;
+            let value = Math.min(current[j - 1] + 1, previous[j] + 1, previous[j - 1] + cost);
+            if (before && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1])
+                value = Math.min(value, before[j - 2] + 1);
+            current.push(value);
+            best = Math.min(best, value);
+        }
+        if (best > limit)
+            return limit + 1;
+        before = previous;
+        previous = current;
+    }
+    return previous[b.length];
+}
+
+function typoLimit(term) {
+    if (term.length >= 8)
+        return 2;
+    if (term.length >= 5)
+        return 1;
+    return 0;
+}
+
+function termTier(term, folded, words) {
+    if (folded === term)
+        return TIER_EXACT;
+    if (folded.startsWith(term))
+        return TIER_PREFIX;
+    if (words.some(word => word.startsWith(term)))
+        return TIER_WORD;
+    // One or two letters inside a word are noise, not a match.
+    if (term.length >= 3 && folded.includes(term))
+        return TIER_SUBSTRING;
+    const limit = typoLimit(term);
+    if (limit > 0) {
+        const candidates = [folded, ...words];
+        for (const candidate of candidates) {
+            // Compare with the same-length prefix too, so "documnts" still
+            // finds "Documents" and a typo while typing finds "Documents".
+            const head = candidate.slice(0, term.length);
+            if (editDistance(term, candidate, limit) <= limit ||
+                (candidate.length > term.length && editDistance(term, head, limit) <= limit))
+                return TIER_FUZZY;
+        }
+    }
+    return -1;
+}
+
+// How well a name matches the query terms. Returns {tier, score} or null.
+// The file extension is ignored for exact matches: "report" is an exact
+// match for "report.pdf".
+export function matchName(name, terms, {ignoreExtension = false} = {}) {
+    if (!terms.length || !name)
+        return null;
+    const [stem] = ignoreExtension ? splitExtension(name) : [name];
+    const foldedName = foldText(name);
+    const foldedStem = foldText(stem);
+    const words = nameWords(name);
+    const phrase = terms.join(' ');
+
+    // "wifi" is "Wi-Fi" and "nightlight" is "Night Light".
+    const compactName = foldedName.replace(/[^\p{L}\p{N}]+/gu, '');
+    const compactPhrase = phrase.replace(/[^\p{L}\p{N}]+/gu, '');
+
+    let tier;
+    if (foldedStem === phrase || foldedName === phrase ||
+        (compactPhrase.length >= 3 && compactName === compactPhrase)) {
+        tier = TIER_EXACT;
+    } else if ((terms.length > 1 && foldedName.startsWith(phrase)) ||
+        (compactPhrase.length >= 3 && compactName.startsWith(compactPhrase) &&
+         !foldedName.startsWith(phrase))) {
+        tier = TIER_PREFIX;
+    } else {
+        // Every term has to match. The weakest term decides the tier.
+        tier = TIER_EXACT;
+        for (const term of terms) {
+            const t = termTier(term, foldedStem === term ? term : foldedName, words);
+            if (t < 0)
+                return null;
+            tier = Math.min(tier, t);
+        }
+        if (terms.length > 1 && tier === TIER_EXACT)
+            tier = TIER_PREFIX;
+    }
+
+    let score = tier;
+    if (tier >= TIER_WORD) {
+        const matched = Math.min(phrase.replace(/\s+/g, '').length, foldedStem.length || 1);
+        score += Math.round(COMPLETION_BONUS * matched / Math.max(foldedStem.length, 1));
+    }
+    return {tier, score};
+}
+
+function termsTouch(word, terms) {
+    return terms.some(term => word.startsWith(term) || term.startsWith(word) ||
+        (term.length >= 3 && word.includes(term)));
+}
+
+// Names that look like backups, copies, versions or generated output.
+// Parts of the name the person actually typed are never held against it.
+export function junkPenalty(name, terms = []) {
+    const text = String(name ?? '');
+    const [stem, extension] = splitExtension(text);
+    const reasons = [];
+    let penalty = 0;
+    const add = (reason, value) => {
+        reasons.push(reason);
+        penalty += value;
+    };
+
+    if (text.endsWith('~') || /^#.*#$/.test(text))
+        add('editor-backup', 260);
+    if (extension && JUNK_EXTENSIONS.has(foldText(extension)) && !termsTouch(foldText(extension), terms))
+        add('backup-extension', 260);
+    if (/\(\d{1,3}\)\s*$/.test(stem) || /[\s_-]\(?copy(\s*\d+)?\)?$/i.test(stem))
+        add('duplicate', 200);
+
+    const words = nameWords(stem);
+    for (const word of words) {
+        const weight = JUNK_WORDS.get(word);
+        if (weight && !termsTouch(word, terms)) {
+            add(`word:${word}`, weight);
+            break;
+        }
+    }
+
+    const folded = foldText(stem);
+    const tokens = folded.split(/[^\p{L}\p{N}]+/u).filter(Boolean);
+    const typedDigits = terms.some(term => /\d/.test(term));
+    if (!typedDigits) {
+        if (/(?:^|[^\d])(?:19|20)\d{2}[-_.]?(?:0[1-9]|1[0-2])[-_.]?(?:[0-2]\d|3[01])(?:[t_-]?\d{4,6})?(?:[^\d]|$)/.test(folded))
+            add('date', 120);
+        else if (/\d{5,}/.test(folded))
+            add('long-number', 160);
+        if (/(?:^|[^\d.])v?\d+\.\d+(?:\.\d+){0,2}(?:[^\d]|$)/.test(folded))
+            add('version', 80);
+    }
+    if (tokens.some(token => token.length >= 7 && token.length <= 40 &&
+        /^[0-9a-f]+$/.test(token) && /\d/.test(token) && /[a-f]/.test(token) &&
+        !termsTouch(token, terms)))
+        add('hash', 160);
+
+    return {penalty: Math.min(penalty, JUNK_PENALTY_CAP), reasons};
+}
+
+function pathParts(path) {
+    return String(path ?? '').split('/').filter(Boolean);
+}
+
+// Where the item lives: shallow places under home beat deep ones, and
+// hidden, cache and build directories count against it.
+export function locationAdjustment(path, home) {
+    const parts = pathParts(path);
+    const homeParts = pathParts(home);
+    const inHome = homeParts.length > 0 &&
+        homeParts.every((part, index) => parts[index] === part) &&
+        parts.length > homeParts.length;
+    const relative = inHome ? parts.slice(homeParts.length) : parts;
+    let adjustment = 0;
+    const reasons = [];
+    if (inHome) {
+        const depth = relative.length;
+        const depthPenalty = Math.min(DEPTH_CAP, DEPTH_STEP * Math.max(0, depth - 1));
+        if (depthPenalty) {
+            adjustment -= depthPenalty;
+            reasons.push(`depth:${depth}`);
+        }
+    } else {
+        adjustment -= OUTSIDE_HOME_PENALTY;
+        reasons.push('outside-home');
+    }
+    if (relative.some(part => part.startsWith('.') || JUNK_DIRECTORIES.has(foldText(part)))) {
+        adjustment -= JUNK_PATH_PENALTY;
+        reasons.push('generated-path');
+    }
+    return {adjustment, reasons, hidden: relative.some(part => part.startsWith('.'))};
+}
+
+function decay(ageSeconds, halfLifeDays) {
+    if (!Number.isFinite(ageSeconds) || ageSeconds < 0)
+        return ageSeconds < 0 ? 1 : 0;
+    return Math.pow(0.5, ageSeconds / (halfLifeDays * DAY));
+}
+
+// Recency and frequency: files people open, and results they pick in
+// Search, rise. The file's own modification time is a weak hint.
+export function usageBoost({visited = 0, visits = 0, picked = 0, picks = 0, modified = 0} = {}, now) {
+    let boost = 0;
+    if (visited)
+        boost += 120 * decay(now - visited, 10);
+    if (visits)
+        boost += Math.min(60, 15 * Math.log2(1 + visits));
+    if (picks)
+        boost += Math.min(120, 45 * picks) * Math.max(0.25, decay(now - picked, 30));
+    if (modified)
+        boost += 40 * decay(now - modified, 5);
+    return Math.min(USAGE_BOOST_CAP, Math.round(boost));
+}
+
+// candidate: {path, name, modified, visited, visits, picked, picks}
+// context: {home, now, xdgFolders: Set of paths}
+export function scoreFile(candidate, terms, context) {
+    const match = matchName(candidate.name, terms, {ignoreExtension: true});
+    if (!match)
+        return null;
+    const location = locationAdjustment(candidate.path, context.home);
+    const junk = junkPenalty(candidate.name, terms);
+    const xdg = context.xdgFolders?.has(candidate.path) ? XDG_BOOST : 0;
+    const usage = usageBoost(candidate, context.now ?? Date.now() / 1000);
+    const score = match.score + location.adjustment - junk.penalty + xdg + usage;
+    return {
+        score,
+        tier: match.tier,
+        evidence: [
+            `tier:${match.tier}`, ...location.reasons, ...junk.reasons,
+            ...(xdg ? ['xdg'] : []), ...(usage ? [`usage:${usage}`] : []),
+        ],
+    };
+}
+
+// app: {name, genericName, keywords: [], matchedElsewhere}
+export function scoreApp(app, terms) {
+    const byName = matchName(app.name, terms);
+    const candidates = [];
+    if (byName)
+        candidates.push(byName.score + (byName.tier === TIER_EXACT ? APP_EXACT_BONUS
+            : byName.tier >= TIER_WORD ? APP_NAME_BONUS : 0));
+    const generic = matchName(app.genericName, terms);
+    if (generic)
+        candidates.push(Math.round(generic.score * 0.75));
+    for (const keyword of app.keywords ?? []) {
+        const k = matchName(keyword, terms);
+        if (k)
+            candidates.push(Math.round(k.score * 0.7));
+    }
+    if (!candidates.length)
+        candidates.push(app.matchedElsewhere ? 250 : -1);
+    const best = Math.max(...candidates);
+    return best < 0 ? null : best;
+}
+
+// A Settings page or option from the Luma table: its title counts most,
+// then the words people use for it, then where it lives.
+// page: {title, path, keywords: []}
+export function scoreSettingPage(page, terms) {
+    const scores = [];
+    const title = matchName(page.title, terms);
+    if (title)
+        scores.push(title.score + SETTING_BONUS);
+    for (const keyword of page.keywords ?? []) {
+        const k = matchName(keyword, terms);
+        if (k && k.tier >= TIER_WORD)
+            scores.push(Math.round(k.score * 0.8));
+    }
+    const path = matchName(page.path, terms);
+    if (path && path.tier >= TIER_WORD)
+        scores.push(Math.round(path.score * 0.5));
+    return scores.length ? Math.max(...scores) : null;
+}
+
+export function rankSettingPages(pages, terms, limit = 5) {
+    return pages
+        .map((page, index) => ({page, index, score: scoreSettingPage(page, terms)}))
+        .filter(item => item.score !== null)
+        .sort((a, b) => (b.score - a.score) || (a.index - b.index))
+        .slice(0, limit);
+}
+
+// Results from other providers (Settings, Calculator, Characters, …). The
+// provider already decided they match; the name decides how well.
+export function scoreProviderResult(kind, name, terms, index = 0, providerId = '') {
+    const id = String(providerId).toLowerCase();
+    if (id.includes('calculator'))
+        return 1400 - index;
+    const match = matchName(name, terms);
+    const order = Math.min(index, 20) * 8;
+    if (kind === 'setting')
+        return (match ? match.score + SETTING_BONUS : 520) - order;
+    if (id.includes('software'))
+        return (match ? match.score - 250 : 150) - order;
+    return (match ? match.score : 300) - order;
+}
+
+const KIND_ORDER = ['app', 'setting', 'file', 'mail', 'contact', 'calendar', 'message', 'photo', 'music', 'place'];
+
+// entries: {score, kind, providerOrder, index}
+export function compareRanked(a, b) {
+    return (b.score - a.score) ||
+        (KIND_ORDER.indexOf(a.kind) - KIND_ORDER.indexOf(b.kind)) ||
+        ((a.providerOrder ?? 0) - (b.providerOrder ?? 0)) ||
+        ((a.index ?? 0) - (b.index ?? 0));
+}
+
+// Build the query for the file index: every word of the query as a prefix.
+export function ftsQuery(terms, {shorten = false} = {}) {
+    const tokens = [];
+    for (const term of terms) {
+        for (const token of term.split(/[^\p{L}\p{N}]+/u).filter(Boolean)) {
+            const cut = shorten && token.length >= 5
+                ? token.slice(0, Math.max(3, Math.floor(token.length / 2)))
+                : token;
+            tokens.push(`${cut}*`);
+        }
+    }
+    return tokens.join(' ');
+}
+
+// Rank file candidates. Duplicates (same path) keep their strongest usage
+// data; hidden items never appear.
+export function rankFiles(candidates, terms, context, limit = 20) {
+    const byPath = new Map();
+    for (const candidate of candidates) {
+        if (!candidate?.path || !candidate.name)
+            continue;
+        const existing = byPath.get(candidate.path);
+        byPath.set(candidate.path, existing ? {...existing, ...Object.fromEntries(
+            Object.entries(candidate).filter(([, v]) => v !== undefined && v !== 0 && v !== ''))} : candidate);
+    }
+    const ranked = [];
+    for (const candidate of byPath.values()) {
+        if (locationAdjustment(candidate.path, context.home).hidden)
+            continue;
+        const result = scoreFile(candidate, terms, context);
+        if (result)
+            ranked.push({...candidate, ...result});
+    }
+    ranked.sort((a, b) => (b.score - a.score) ||
+        (a.path.length - b.path.length) || (a.path < b.path ? -1 : a.path > b.path ? 1 : 0));
+    return ranked.slice(0, limit);
+}
