diff -ruN a/js/ui/lumaSearch.js b/js/ui/lumaSearch.js
--- a/js/ui/lumaSearch.js	1969-12-31 19:00:00.000000000 -0500
+++ b/js/ui/lumaSearch.js	2026-09-03 02:36:26.426065563 -0400
@@ -0,0 +1,307 @@
+import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
+import GioUnix from 'gi://GioUnix';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import St from 'gi://St';
+
+import * as Main from './main.js';
+import * as ModalDialog from './modalDialog.js';
+import * as Search from './search.js';
+import * as ShellEntry from './shellEntry.js';
+
+const SearchProxy = Gio.DBusProxy.makeProxyWrapper(`
+<node>
+  <interface name="org.projectluma.Search1">
+    <method name="Query">
+      <arg name="query" type="s" direction="in"/>
+      <arg name="generation" type="u" direction="in"/>
+      <arg name="limit" type="u" direction="in"/>
+      <arg name="results" type="aa{sv}" direction="out"/>
+    </method>
+    <method name="Activate">
+      <arg name="provider_id" type="s" direction="in"/>
+      <arg name="result_id" type="s" direction="in"/>
+      <arg name="terms" type="as" direction="in"/>
+      <arg name="timestamp" type="u" direction="in"/>
+    </method>
+  </interface>
+</node>`);
+
+const KIND_LABELS = {
+    app: _('App'),
+    setting: _('Setting'),
+    file: _('File'),
+    mail: _('Mail'),
+    contact: _('Contact'),
+    calendar: _('Calendar'),
+    message: _('Message'),
+    photo: _('Photo'),
+    music: _('Music'),
+    place: _('Place'),
+};
+
+class LumaSearchProvider {
+    constructor() {
+        this.id = 'org.projectluma.Search';
+        this.canLaunchSearch = false;
+        this.isRemoteProvider = false;
+        // SearchResultsView passes provider appInfo through GNOME's parental
+        // controls and provider-display paths. Use a real DesktopAppInfo so
+        // the complete Gio.AppInfo contract (including should_show()) is
+        // available instead of an incomplete lookalike object.
+        this.appInfo = GioUnix.DesktopAppInfo.new(
+            'org.projectluma.SearchSettings.desktop');
+        if (!this.appInfo)
+            throw new Error('Luma Search desktop application is not installed');
+        this._metas = new Map();
+        this._generation = 0;
+        this._proxy = null;
+    }
+
+    async getInitialResultSet(terms, cancellable) {
+        this._proxy ??= new SearchProxy(
+            Gio.DBus.session,
+            'org.projectluma.Search',
+            '/org/projectluma/Search');
+        const generation = ++this._generation;
+        const [results] = await this._proxy.QueryAsync(
+            terms.join(' '), generation, 40, cancellable);
+        this._metas.clear();
+        return results.map(result => {
+            const unpack = key => result[key]?.deepUnpack?.() ?? result[key] ?? '';
+            const providerId = unpack('provider-id');
+            const resultId = unpack('result-id');
+            const id = JSON.stringify([providerId, resultId]);
+            const kind = unpack('kind');
+            const subtitle = unpack('subtitle');
+            const snippet = unpack('snippet');
+            const typeLabel = KIND_LABELS[kind] ?? _('Result');
+            const context = [typeLabel, subtitle, snippet].filter(Boolean).join(' · ');
+            this._metas.set(id, {
+                id,
+                name: unpack('title'),
+                description: context,
+                createIcon: size => new St.Icon({
+                    icon_name: unpack('icon-name') || 'edit-find-symbolic',
+                    icon_size: size,
+                }),
+                providerId,
+                resultId,
+            });
+            return id;
+        });
+    }
+
+    getSubsearchResultSet(_previousResults, terms, cancellable) {
+        return this.getInitialResultSet(terms, cancellable);
+    }
+
+    async getResultMetas(ids, _cancellable) {
+        return ids.map(id => this._metas.get(id));
+    }
+
+    filterResults(results, maxNumber) {
+        return results.slice(0, maxNumber);
+    }
+
+    activateResult(id, terms) {
+        const meta = this._metas.get(id);
+        if (!meta)
+            return;
+        this._proxy.ActivateAsync(
+            meta.providerId,
+            meta.resultId,
+            terms,
+            global.get_current_time()).catch(logError);
+    }
+
+    launchSearch() {
+    }
+}
+
+const LumaSearchDialog = GObject.registerClass(
+class LumaSearchDialog extends ModalDialog.ModalDialog {
+    _init() {
+        super._init({
+            styleClass: 'luma-search-dialog',
+            destroyOnClose: false,
+        });
+        this.accessible_name = _('Search this machine');
+        this._lightbox._radialEffect = false;
+        this._lightbox.remove_effect_by_name('radial');
+        this._lightbox._fadeFactor = 0.34;
+        this._lightbox.set({
+            opacity: 0,
+            style: 'background-color: rgb(12, 16, 21);',
+        });
+        this._eventBlocker.connect('button-press-event', () => {
+            this.close();
+            return Clutter.EVENT_STOP;
+        });
+
+        const stage = new St.BoxLayout({
+            style_class: 'luma-search-stage',
+            orientation: Clutter.Orientation.VERTICAL,
+            x_expand: true,
+            y_expand: true,
+        });
+        this.contentLayout.add_child(stage);
+
+        this._entry = new St.Entry({
+            style_class: 'search-entry luma-search-entry',
+            hint_text: _('Search this machine'),
+            can_focus: true,
+            track_hover: true,
+            x_expand: true,
+        });
+        this._entry.set_primary_icon(new St.Icon({
+            style_class: 'search-entry-icon',
+            icon_name: 'edit-find-symbolic',
+        }));
+        ShellEntry.addContextMenu(this._entry);
+        stage.add_child(this._entry);
+
+        this._intro = new St.BoxLayout({
+            style_class: 'luma-search-intro',
+            orientation: Clutter.Orientation.VERTICAL,
+            x_expand: true,
+        });
+        this._intro.add_child(new St.Label({
+            style_class: 'luma-search-intro-title',
+            text: _('Everything on this machine, in one place.'),
+        }));
+        this._intro.add_child(new St.Label({
+            style_class: 'luma-search-intro-subtitle',
+            text: _('Applications and settings first, then your files, mail, people, days and music.'),
+        }));
+        const suggestions = new St.BoxLayout({style_class: 'luma-search-suggestions'});
+        for (const suggestion of [_('Reel'), _('dark'), _('cursor size'), _('Nora'), _('wallpaper'), _('Retro')]) {
+            const button = new St.Button({
+                style_class: 'luma-search-suggestion',
+                label: suggestion,
+                can_focus: true,
+            });
+            button.connect('clicked', () => {
+                this._entry.text = suggestion;
+                this._entry.clutter_text.set_cursor_position(-1);
+            });
+            suggestions.add_child(button);
+        }
+        this._intro.add_child(suggestions);
+        stage.add_child(this._intro);
+
+        this._results = new Search.SearchResultsView({brokerOnly: true});
+        this._results.addProvider(new LumaSearchProvider());
+        this._results.connect('result-activated', () => this.close());
+        this._results.hide();
+        stage.add_child(this._results);
+
+        this._text = this._entry.clutter_text;
+        this._text.connect('text-changed', this._onTextChanged.bind(this));
+        this._text.connect('key-press-event', this._onEntryKeyPress.bind(this));
+        this._text.connect('key-focus-in', () => this._results.highlightDefault(true));
+        this._text.connect('key-focus-out', () => this._results.highlightDefault(false));
+        this.setInitialKeyFocus(this._entry);
+    }
+
+    open() {
+        if (Main.overview.visible)
+            Main.overview.hide();
+        const monitor = global.display.get_current_monitor();
+        const workArea = Main.layoutManager.getWorkAreaForMonitor(monitor);
+        const island = this.dialogLayout._dialog;
+        island.width = Math.min(620, workArea.width - 48);
+        island.y_align = Clutter.ActorAlign.START;
+        island.margin_top = Math.round(workArea.height * 0.13);
+        const animate = St.Settings.get().enable_animations;
+        island.translation_y = animate ? 10 : 0;
+        island.scale_x = animate ? 0.985 : 1;
+        island.scale_y = animate ? 0.985 : 1;
+        this._entry.text = '';
+        const opened = super.open();
+        if (opened) {
+            this._entry.grab_key_focus();
+            island.ease({
+                translation_y: 0,
+                scale_x: 1,
+                scale_y: 1,
+                duration: animate ? 180 : 0,
+                mode: Clutter.AnimationMode.EASE_OUT_QUAD,
+            });
+        }
+        return opened;
+    }
+
+    toggle() {
+        if (this.state === ModalDialog.State.OPENED ||
+            this.state === ModalDialog.State.OPENING)
+            this.close();
+        else
+            this.open();
+    }
+
+    vfunc_key_press_event(event) {
+        if (event.get_key_symbol() === Clutter.KEY_Escape) {
+            this.close();
+            return Clutter.EVENT_STOP;
+        }
+        return super.vfunc_key_press_event(event);
+    }
+
+    _onTextChanged() {
+        const terms = this._entry.get_text().trim().split(/\s+/).filter(Boolean);
+        this._intro.visible = terms.length === 0;
+        this._results.visible = terms.length > 0;
+        this._results.setTerms(terms);
+    }
+
+    _onEntryKeyPress(_entry, event) {
+        switch (event.get_key_symbol()) {
+        case Clutter.KEY_Down:
+            this._results.navigateFocus(St.DirectionType.DOWN);
+            return Clutter.EVENT_STOP;
+        case Clutter.KEY_Tab:
+            this._results.navigateFocus(St.DirectionType.TAB_FORWARD);
+            return Clutter.EVENT_STOP;
+        case Clutter.KEY_ISO_Left_Tab:
+            this._results.navigateFocus(St.DirectionType.TAB_BACKWARD);
+            return Clutter.EVENT_STOP;
+        case Clutter.KEY_Return:
+        case Clutter.KEY_KP_Enter:
+            this._results.activateDefault();
+            return Clutter.EVENT_STOP;
+        case Clutter.KEY_Escape:
+            this.close();
+            return Clutter.EVENT_STOP;
+        default:
+            return Clutter.EVENT_PROPAGATE;
+        }
+    }
+});
+
+export class LumaSearch {
+    constructor() {
+        this._dialog = new LumaSearchDialog();
+        this._a11ySettings = new Gio.Settings({
+            schema_id: 'org.gnome.desktop.a11y.keyboard',
+        });
+        global.display.connect('overlay-key', () => {
+            if (this._a11ySettings.get_boolean('stickykeys-enable'))
+                return;
+            this._dialog.toggle();
+        });
+    }
+
+    open() {
+        return this._dialog.open();
+    }
+
+    close() {
+        this._dialog.close();
+    }
+
+    toggle() {
+        this._dialog.toggle();
+    }
+}
