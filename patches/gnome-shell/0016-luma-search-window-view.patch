+// Luma Search is a shell-owned modal Beam, separate from Window View.
+.luma-search-dialog {
+  width: 620px;
+  max-height: 44em;
+  padding: $base_padding * 3;
+  border-radius: 22px;
+  background-color: if($variant == 'light', rgba(246, 247, 248, 0.98), rgba(37, 40, 45, 0.98));
+  color: $fg_color;
+  border: if($contrast == 'high', 2px solid $fg_color, 1px solid transparentize($fg_color, .88));
+  box-shadow: 0 24px 64px rgba(12, 16, 21, 0.34);
+
+  .modal-dialog-content-box {
+    max-width: 50em;
+    padding: 0;
+  }
+
+  .luma-search-stage { spacing: $base_padding * 2; }
+
+  .luma-search-entry {
+    width: auto;
+    margin: 0;
+    padding: $base_padding * 2;
+    border-radius: 14px;
+    background-color: if($variant == 'light', rgba(255, 255, 255, 0.94), rgba(54, 58, 64, 0.96));
+    color: $fg_color;
+    border: if($contrast == 'high', 2px solid $fg_color, 1px solid transparentize($fg_color, .89));
+    font-size: 1.18em;
+  }
+
+  .luma-search-intro {
+    spacing: $base_padding * 2;
+    padding: $base_padding * 5 $base_padding * 3;
+    color: $fg_color;
+    text-align: center;
+  }
+
+  .luma-search-intro-title { font-size: 1.22em; font-weight: 700; }
+  .luma-search-intro-subtitle { color: transparentize($fg_color, .35); }
+  .luma-search-suggestions { spacing: $base_padding; }
+
+  .luma-search-suggestion {
+    padding: $base_padding $base_padding * 2;
+    border-radius: 999px;
+    background-color: transparentize($fg_color, .945);
+    color: $fg_color;
+    border: if($contrast == 'high', 2px solid $fg_color, 1px solid transparentize($fg_color, .90));
+
+    &:hover, &:focus { background-color: transparentize($fg_color, .90); }
+    &:active { background-color: transparentize($fg_color, .85); }
+  }
+
+  #searchResults { min-height: 16em; max-height: 34em; }
+  #searchResultsContent { max-width: 50em; }
+  .search-section-content {
+    margin: 0;
+    background-color: transparentize($card_bg_color, .22);
+    color: $fg_color;
+    border: if($contrast == 'high', 2px solid $fg_color, 1px solid transparentize($fg_color, .91));
+  }
+  .list-search-result-description { color: transparentize($fg_color, .35); }
+}
+
 // lists in dialogs
 .dialog-list {
   spacing: $base_padding * 3;
