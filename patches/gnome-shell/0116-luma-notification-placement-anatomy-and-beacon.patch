+// ── Resting cards and the tray ───────────────────────────────────────────
+// Resting cards are quieter than arriving ones: an opaque card fill, a near
+// shadow and a short soft one, no backdrop.
+@each $name, $roles in if($note-high-contrast, $note-high-contrast-treatments, $note-treatments) {
+  #{$note-card}.luma-notification-resting.luma-surface-#{$name} {
+    background-color: map-get($roles, card);
+    box-shadow: if($note-high-contrast, none, $note-resting-near);
+  }
+}
+.luma-notification-shadow.luma-notification-resting {
+  box-shadow: if($note-high-contrast, none, 0 5px 14px -7px rgba(10, 14, 19, .30));
+}
+
+.luma-notification-tray {
+  padding: 7px;
+  spacing: 8px;
+  border: 1px solid transparent;
+  border-radius: 15px;
+  box-shadow: if($note-high-contrast, none, $note-tray-far);
+  font-family: "Figtree";
+
+  // The Clear all pill carries its own 3 x 8 padding; the header gives back
+  // those pixels so the words align with the title.
+  .luma-notification-tray-header {
+    padding: 0 0 1px 4px;
+    spacing: 8px;
+  }
+  .luma-notification-tray-title { font-size: 13px; font-weight: 700; }
+  .luma-notification-tray-count {
+    font-size: 11px;
+    font-weight: 650;
+    font-feature-settings: "tnum";
+  }
+  .luma-notification-tray-clear {
+    min-height: 0;
+    padding: 3px 8px;
+    border: none;
+    border-radius: 999px;
+    background-color: transparent;
+    box-shadow: none;
+    font-size: 11px;
+    font-weight: 650;
+    &:focus { box-shadow: inset 0 0 0 2px st-transparentize(-st-accent-color, 0.3) !important; }
+  }
+  // Room for the last card's hairline and near shadow inside the viewport.
+  .luma-notification-tray-list { spacing: 8px; padding: 0 0 2px 0; }
+  .luma-notification-tray-empty {
+    padding: 16px 0;
+    spacing: 4px;
+  }
+  .luma-notification-tray-empty-title { font-size: 13px; font-weight: 650; }
+  .luma-notification-tray-empty-body { font-size: 11px; font-weight: 550; }
+
+  @each $name, $roles in if($note-high-contrast, $note-high-contrast-treatments, $note-treatments) {
+    &.luma-surface-#{$name} {
+      color: map-get($roles, ink);
+      background-color: map-get($roles, tray);
+      border-color: map-get($roles, line);
+      &.luma-notification-opaque { background-color: map-get($roles, tray-opaque); }
+      .luma-notification-tray-title,
+      .luma-notification-tray-empty-title { color: map-get($roles, ink); }
+      .luma-notification-tray-count,
+      .luma-notification-tray-empty-body { color: map-get($roles, muted); }
+      .luma-notification-tray-clear {
+        color: map-get($roles, muted);
+        &:hover { color: map-get($roles, ink); background-color: map-get($roles, hover); }
+        &:active { color: map-get($roles, ink); background-color: map-get($roles, pressed); }
+      }
+    }
+  }
+  @if $note-high-contrast { border-width: 2px; padding: 6px; }
+}
+
+// ── The Shelf beacon ─────────────────────────────────────────────────────
+// A live-extension peer: 36 px mark, 10 px gap, 13/11 copy at a fixed width
+// so a new arrival never moves the Shelf, and a tabular count.
+.luma-notification-beacon {
+  padding: 0 4px 0 0;
+  border-radius: 10px;
+  background-color: transparent;
+  font-family: "Figtree";
+  transition-duration: 120ms;
+
+  .luma-notification-beacon-content { spacing: 10px; }
+  .luma-notification-beacon-mark {
+    width: 36px;
+    height: 36px;
+    border-radius: 10px;
+    .luma-notification-beacon-mark-icon { icon-size: 36px; -st-icon-style: requested; }
+  }
+  .luma-notification-beacon-mark.luma-notification-beacon-mark-art {
+    box-shadow: 0 1px 2px rgba(12, 17, 24, .22);
+  }
+  .luma-notification-beacon-mark.luma-notification-beacon-mark-glyph {
+    width: 34px;
+    height: 34px;
+    border: 1px solid rgba(255, 255, 255, .12);
+    background-gradient-direction: vertical;
+    background-gradient-start: mix(map-get($note-tones, neutral), #ffffff, 72%);
+    background-gradient-end: mix(map-get($note-tones, neutral), #0c1118, 84%);
+    .luma-notification-beacon-mark-icon { icon-size: 16px; color: #ffffff; -st-icon-style: symbolic; }
+  }
+  .luma-notification-beacon-copy { width: 132px; spacing: 2px; }
+  .luma-notification-beacon-title { font-size: 13px; font-weight: 650; }
+  .luma-notification-beacon-summary { font-size: 11px; font-weight: 550; }
+  .luma-notification-beacon-count {
+    min-width: 8px;
+    height: 20px;
+    padding: 0 6px;
+    border-radius: 999px;
+    color: #ffffff;
+    font-size: 11px;
+    font-weight: 750;
+    font-feature-settings: "tnum";
+    text-align: center;
+  }
+  &:focus { box-shadow: inset 0 0 0 2px st-transparentize(-st-accent-color, 0.3); }
+
+  @each $tone, $accent in $note-accents {
+    &.luma-notification-tone-#{$tone} .luma-notification-beacon-count {
+      background-color: if($note-high-contrast, #ffffff, $accent);
+      color: if($note-high-contrast, #000000, #ffffff);
+    }
+  }
+}
+@each $name, $ink in $note-shelf-ink {
+  .luma-surface-#{$name} .luma-notification-beacon {
+    .luma-notification-beacon-title { color: map-get($ink, ink); }
+    .luma-notification-beacon-summary { color: map-get($ink, ink2); }
+    &:hover { background-color: map-get($ink, hover); }
+    &:active, &:checked { background-color: map-get($ink, pressed); }
+  }
+}
