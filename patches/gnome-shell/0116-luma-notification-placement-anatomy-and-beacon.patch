-// Standalone Luma notification material. These defaults are overridden only by
-// the three entry points in this directory; no GNOME-wide theme state is read.
-$note-ink: #e6eaec !default;
-$note-surface: rgba(38, 42, 48, .90) !default;
-$note-border: rgba(255, 255, 255, .085) !default;
+// Luma notification material ledger. One set of semantic roles per surface
+// treatment; the effective treatment class (luma-surface-*) is applied by the
+// shell's surface-material controller, so a notification always matches the
+// Shelf it sits above. Values are the design contract's desktop tokens.
+//
+//   surface  arriving card fill (blurred where the compositor can)
+//   opaque   the same card without a real backdrop (no blur, reduced
+//            transparency)
+//   card     resting card fill in the tray; tray: the tray itself
+//   ink      primary text; muted: source, body, idle glyphs
+//   line     one hairline; fill/hover: quiet controls
+$note-treatments: (
+  light: (
+    surface: rgba(252, 252, 251, .92), opaque: #fcfcfb,
+    card: #ffffff, tray: rgba(243, 244, 244, .94), tray-opaque: #f3f4f4,
+    ink: #282f36, muted: #767e86,
+    line: rgba(35, 44, 52, .10), fill: rgba(35, 44, 52, .055), hover: rgba(35, 44, 52, .09),
+    pressed: rgba(35, 44, 52, .13),
+  ),
+  dark: (
+    surface: rgba(38, 42, 48, .90), opaque: #262a30,
+    card: #32373e, tray: rgba(30, 34, 39, .94), tray-opaque: #1e2227,
+    ink: #e6eaec, muted: #8d959c,
+    line: rgba(255, 255, 255, .085), fill: rgba(255, 255, 255, .06), hover: rgba(255, 255, 255, .10),
+    pressed: rgba(255, 255, 255, .14),
+  ),
+  // Frost and glass are the light roles over a sampled backdrop.
+  frost: (
+    surface: rgba(248, 249, 251, .82), opaque: #f8f9fb,
+    card: rgba(255, 255, 255, .86), tray: rgba(243, 244, 244, .80), tray-opaque: #f3f4f4,
+    ink: #282f36, muted: #6f777f,
+    line: rgba(35, 44, 52, .10), fill: rgba(35, 44, 52, .06), hover: rgba(35, 44, 52, .10),
+    pressed: rgba(35, 44, 52, .14),
+  ),
+  glass: (
+    surface: rgba(255, 255, 255, .58), opaque: #fcfcfb,
+    card: rgba(255, 255, 255, .72), tray: rgba(255, 255, 255, .52), tray-opaque: #f3f4f4,
+    ink: #282f36, muted: #5f676f,
+    line: rgba(255, 255, 255, .50), fill: rgba(35, 44, 52, .07), hover: rgba(35, 44, 52, .11),
+    pressed: rgba(35, 44, 52, .15),
+  ),
+) !default;
+
+// High contrast keeps the same geometry on solid, fully stroked surfaces.
+$note-high-contrast: false !default;
+$note-high-contrast-treatments: (
+  light: (
+    surface: #ffffff, opaque: #ffffff, card: #ffffff, tray: #ffffff, tray-opaque: #ffffff,
+    ink: #000000, muted: #000000, line: #000000,
+    fill: rgba(0, 0, 0, .10), hover: rgba(0, 0, 0, .20), pressed: rgba(0, 0, 0, .30),
+  ),
+  dark: (
+    surface: #1a1a1a, opaque: #1a1a1a, card: #1a1a1a, tray: #1a1a1a, tray-opaque: #1a1a1a,
+    ink: #ffffff, muted: #ffffff, line: #ffffff,
+    fill: rgba(255, 255, 255, .16), hover: rgba(255, 255, 255, .28), pressed: rgba(255, 255, 255, .38),
+  ),
+);
+
+// Elevation: an arriving card is lifted; a resting card is quiet.
+$note-arriving-near: 0 3px 10px rgba(10, 14, 19, .16);
+$note-arriving-far: 0 20px 44px -20px rgba(10, 14, 19, .50);
+$note-resting-near: 0 1px 2px rgba(10, 14, 19, .09);
+$note-tray-far: 0 20px 52px -20px rgba(10, 14, 19, .60);
+
+// App tiles for glyph-only sources, and the call-answer weights.
+$note-tones: (
+  messages: #3f9463, phone: #43946b, mail: #3d6fae, files: #3f76b0,
+  calendar: #b8544f, depot: #6f8f3f, neutral: #4d5a68,
+);
+$note-affirmative: #3f8f6c;
+$note-destructive: #b4534f;
+
+// Legacy panel indicator (outside the Shelf only).
 $note-summary-ink: #aeb5bb !default;
 $note-beacon-surface: rgba(38, 42, 48, .88) !default;
 $note-beacon-border: rgba(255, 255, 255, .10) !default;
 $note-beacon-ink: #eef1f3 !default;
 $note-count-surface: #b57f3f !default;
 $note-count-ink: #ffffff !default;
-$note-mark-messages: #5ea66f !default;
-$note-mark-calendar: #8b79c6 !default;
-$note-mark-mail: #648db7 !default;
-$note-mark-depot: #c98b42 !default;
-$note-mark-neutral: #69737d !default;
-$note-ring-messages: rgb(94, 166, 111) !default;
-$note-ring-calendar: rgb(139, 121, 198) !default;
-$note-ring-mail: rgb(100, 141, 183) !default;
-$note-ring-depot: rgb(201, 139, 66) !default;
-$note-ring-neutral: rgb(105, 115, 125) !default;
-$note-high-contrast: false !default;
