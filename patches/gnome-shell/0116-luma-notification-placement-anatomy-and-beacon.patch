+++ b/js/ui/lumaNotificationBeacon.js
@@ -0,0 +1,539 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// The desktop resting collection: the Shelf beacon and the tray it opens.
+//
+// A notification whose heads-up card faded has not been handled. It waits
+// here -- counted by the beacon beside the status island, listed in the tray
+// above the Shelf -- until it is acted on, dismissed, or withdrawn. Both read
+// the same records as the heads-up presenter; there is no second inbox.
+import Atk from 'gi://Atk';
+import Clutter from 'gi://Clutter';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import Meta from 'gi://Meta';
+import Pango from 'gi://Pango';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import * as Main from './main.js';
+import * as MessageList from './messageList.js';
+import * as MessageTray from './messageTray.js';
+import * as SurfaceMaterials from './lumaSurfaceMaterials.js';
+import {LumaIconMask} from './iconMask.js';
+
+const {NotificationLifecycleState, NotificationDestroyedReason, Urgency} = MessageTray;
+
+const RESTING_STATES = new Set([
+    NotificationLifecycleState.WAITING,
+    NotificationLifecycleState.SEEN,
+]);
+
+// Tray geometry (logical px): clamp(280px, 26vw, 344px) wide, at most 64% of
+// the usable monitor height, 14 from the screen edge and the Shelf.
+const TRAY_MIN_WIDTH = 280;
+const TRAY_MAX_WIDTH = 344;
+const TRAY_MAX_HEIGHT = 0.64;
+const EDGE_INSET = 14;
+const TRAY_RADIUS = 15;
+const TRAY_OPEN_TIME = 170;
+const TRAY_RISE = 4;
+const MARK_SIZE = 36;
+const MARK_RADIUS = 10;
+const COUNT_LIMIT = 99;
+
+function restingNotifications() {
+    return Main.messageTray.getSources()
+        .flatMap(source => source.notifications)
+        .filter(notification => RESTING_STATES.has(notification.lifecycleState))
+        .sort((a, b) => (b.datetime && a.datetime ? b.datetime.compare(a.datetime) : 0) ||
+            b.sortSequence - a.sortSequence);
+}
+
+function maskIcon(icon, radiusRatio) {
+    try {
+        const mask = new LumaIconMask();
+        mask.set_uniform_float(mask.get_uniform_location('radius'), 1, [radiusRatio]);
+        icon.add_effect_with_name('luma-tile-mask', mask);
+    } catch (error) {
+        logError(error, 'Luma notification mark mask unavailable');
+    }
+}
+
+// Watches every source the tray knows and coalesces their changes into one
+// idle update, so a burst of arrivals or a replacement repaints once.
+class RestingModel {
+    constructor(callback) {
+        this._callback = callback;
+        this._sources = new Map();
+        Main.messageTray.connectObject(
+            'source-added', (_tray, source) => this._watch(source),
+            'source-removed', (_tray, source) => this._unwatch(source),
+            'queue-changed', () => this.queue(), this);
+        Main.messageTray.getSources().forEach(source => this._watch(source));
+    }
+
+    _watch(source) {
+        if (this._sources.has(source))
+            return;
+        source.connectObject(
+            'notify::count', () => this.queue(),
+            'notification-added', () => this.queue(),
+            'notification-removed', () => this.queue(), this);
+        this._sources.set(source, true);
