+// The beacon is a Shelf island: its type follows the Shelf's ink, and its
+// one accent says which kind of thing is waiting.
+$note-shelf-ink: (
+  light: (ink: #34383d, ink2: rgba(52, 56, 61, .62), hover: rgba(25, 27, 31, .07), pressed: rgba(25, 27, 31, .12)),
+  dark: (ink: #e7e9e8, ink2: rgba(231, 233, 232, .60), hover: rgba(255, 255, 255, .08), pressed: rgba(255, 255, 255, .14)),
+  frost: (ink: #21252b, ink2: rgba(33, 37, 43, .62), hover: rgba(25, 27, 31, .08), pressed: rgba(25, 27, 31, .13)),
+  glass: (ink: #ffffff, ink2: rgba(255, 255, 255, .72), hover: rgba(255, 255, 255, .14), pressed: rgba(255, 255, 255, .22)),
+);
+$note-accents: (
+  messages: #3f8f6c, phone: #3f8f6c, mail: #5585b8, files: #5585b8,
+  calendar: #8a63a4, depot: #b57f3f, neutral: #b57f3f,
+);
