 // How far a three-finger swipe must travel downward to dismiss Grid.
 const DISMISS_TRAVEL = 64;
+// Windows travel between where they sit and where Grid shows them, so a person
+// can follow each one in and back out. Leaving is a little quicker than
+// arriving. The curve is Luma's ease-out; reduced motion makes both instant.
+const ENTER_DURATION = 320;
+const LEAVE_DURATION = 260;
+const TRAVEL_MODE = Clutter.AnimationMode.EASE_OUT_QUART;
 // Breathing room outside the row, applied identically on both sides.
