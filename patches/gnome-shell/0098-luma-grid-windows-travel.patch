+    get travelling() {
+        return this._travel > 0;
+    }
+
+    get leaving() {
+        return this._leaving === true;
+    }
+
+    // Where a window sits on the desktop, if it is there to travel from or to.
+    _desktopRect(window) {
+        const workspace = global.workspace_manager.get_active_workspace();
+        if (window.minimized || !window.located_on_workspace(workspace))
+            return null;
+        const rect = window.get_frame_rect();
+        return rect.width > 0 && rect.height > 0 ? rect : null;
+    }
+
+    // The transform that puts a card's preview exactly over |rect|, given
+    // where the card is allocated on the stage.
+    _transformOnto(card, rect) {
+        const home = card.home;
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        const label = 28 * scale;
+        const sx = rect.width / Math.max(1, home.width);
+        const sy = rect.height / Math.max(1, home.height - label);
+        return {translation_x: rect.x - home.x, translation_y: rect.y - home.y - label * sy,
+            scale_x: sx, scale_y: sy};
+    }
+
+    _stackLikeTheDesktop(last = null) {
+        const windows = global.display.sort_windows_by_stacking(this._cards.map(c => c.window));
+        windows.forEach(window => {
+            const card = this._cards.find(c => c.window === window);
+            if (card)
+                this._stage.set_child_above_sibling(card, null);
         });
+        if (last)
+            this._stage.set_child_above_sibling(last, null);
     }
 
+    _travelStarted() {
+        this._travel = (this._travel ?? 0) + 1;
+        this._stage.clip_to_allocation = false;
+    }
+
+    _travelEnded() {
+        this._travel = Math.max(0, (this._travel ?? 0) - 1);
+        if (this._travel === 0 && !this._leaving) {
+            this._stage.clip_to_allocation = true;
+            this._cards.forEach(card => {
+                card.opacity = 255;
+                card._syncSelection();
+            });
+        }
+    }
+
+    // Bring every card from its window's place on the desktop into the grid.
+    _enter() {
+        this._entered = true;
+        this._stackLikeTheDesktop();
+        const monitor = Main.layoutManager.primaryMonitor;
+        this._cards.forEach(card => {
+            const rect = this._desktopRect(card.window);
+            const home = card.home;
+            // A card that settles outside the visible row fades rather than
+            // flying to a place the clip is about to hide.
+            const shown = !monitor ||
+                (home.x + home.width > monitor.x && home.x < monitor.x + monitor.width);
+            card.remove_all_transitions();
+            card.set_pivot_point(0, 0);
+            card._header.opacity = 0;
+            if (rect) {
+                card.set(this._transformOnto(card, rect));
+            } else {
+                card.set({opacity: 0, scale_x: 0.94, scale_y: 0.94,
+                    translation_x: home.width * 0.03, translation_y: home.height * 0.03});
+            }
+            this._travelStarted();
+            card.ease({translation_x: 0, translation_y: card.lift, scale_x: 1, scale_y: 1,
+                opacity: shown || !rect ? 255 : 0,
+                duration: ENTER_DURATION, mode: TRAVEL_MODE,
+                onStopped: () => this._travelEnded()});
+            card._header.ease({opacity: 255, delay: ENTER_DURATION / 3,
+                duration: ENTER_DURATION * 2 / 3, mode: Clutter.AnimationMode.EASE_OUT_QUAD});
+        });
+    }
+
+    // Send every card back to its window, the chosen one last and on top,
+    // then hand the desktop back.
+    dismiss(chosen = null) {
+        if (this._leaving)
+            return;
+        this._leaving = true;
+        this.reactive = false;
+        this._dismissSwipe?.destroy();
+        this._dismissSwipe = null;
+        if (chosen)
+            Main.activateWindow(chosen);
+        const chosenCard = this._cards.find(c => c.window === chosen) ?? null;
+        this._stackLikeTheDesktop(chosenCard);
+        let remaining = this._cards.length;
+        const finished = () => {
+            if (--remaining <= 0)
+                this.destroy();
+        };
+        if (remaining === 0 || !this._entered) {
+            this.destroy();
+            return;
+        }
+        this._travelStarted();
+        this._cards.forEach(card => {
+            const rect = this._desktopRect(card.window);
+            card.remove_all_transitions();
+            card.set_pivot_point(0, 0);
+            card._close.visible = false;
+            card._header.ease({opacity: 0, duration: LEAVE_DURATION / 2,
+                mode: Clutter.AnimationMode.EASE_OUT_QUAD});
+            const target = rect ? this._transformOnto(card, rect)
+                : {opacity: 0, scale_x: 0.94, scale_y: 0.94};
+            card.ease({...target, duration: LEAVE_DURATION, mode: TRAVEL_MODE,
+                onStopped: finished});
+        });
+    }
+
