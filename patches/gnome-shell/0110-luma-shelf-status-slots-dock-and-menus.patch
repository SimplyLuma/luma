+
+    // The shelf's status grid: six slots that never move or disappear, so the
+    // grid is read at a glance. A slot whose thing is off draws at 35%. A red
+    // dot on the microphone says something is recording that the Well
+    // couldn't put a name to.
+    _ensureStatusSlots() {
+        if (this._statusSlots)
+            return;
+        const layout = new ShelfStatusLayout();
+        layout.setShelfPresentation(true);
+        this._statusSlots = new St.Widget({style_class: 'panel-status-indicators-box luma-status-slots',
+            layout_manager: layout});
+        this._slots = {};
+        for (const name of ['mic', 'wifi', 'bluetooth', 'volume', 'power', 'battery']) {
+            const slot = new St.Widget({layout_manager: new Clutter.BinLayout(), style_class: 'luma-status-slot'});
+            slot.icon = new St.Icon({style_class: 'system-status-icon', icon_size: STATUS_GLYPH,
+                x_align: Clutter.ActorAlign.CENTER, y_align: Clutter.ActorAlign.CENTER});
+            slot.add_child(slot.icon);
+            if (name === 'mic') {
+                slot.dot = new St.Widget({style_class: 'luma-status-recording', visible: false,
+                    x_align: Clutter.ActorAlign.END, y_align: Clutter.ActorAlign.START});
+                slot.add_child(slot.dot);
+            }
+            this._slots[name] = slot;
+            this._statusSlots.add_child(slot);
+        }
+        this._syncStatusSlots();
+    }
+
+    _watchSlotSources() {
+        if (this._slotSourcesWatched || !this._system)
+            return;
+        this._slotSourcesWatched = true;
+        const sync = () => this._syncStatusSlots();
+        const actors = [this._network?._primaryIndicator, this._bluetooth?._indicator, this._volumeOutput?._indicator,
+            this._volumeInput?._indicator, this._powerProfiles?._indicator, this._system?._indicator];
+        for (const actor of actors.filter(Boolean))
+            actor.connectObject('notify::icon-name', sync, 'notify::visible', sync, this);
+        this._volumeInput?._input?.connectObject('stream-updated', sync, this);
+        this._volumeInput?._control?.connectObject('stream-added', sync, 'stream-removed', sync, this);
+    }
+
+    _recordingApplications() {
+        const control = this._volumeInput?._control;
+        const names = new Set();
+        try {
+            for (const output of control?.get_source_outputs?.() ?? []) {
+                for (const value of [output.get_application_id?.(), output.get_name?.()])
+                    if (value)
+                        names.add(`${value}`.toLowerCase());
+            }
+        } catch {
+        }
+        return names;
+    }
+
+    _syncStatusSlots() {
+        if (!this._slots)
+            return;
+        this._watchSlotSources();
+        const set = (name, iconName, on) => {
+            const slot = this._slots[name];
+            slot.icon.icon_name = iconName;
