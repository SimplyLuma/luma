diff --git a/js/ui/lumaFocusVisible.js b/js/ui/lumaFocusVisible.js
new file mode 100644
--- /dev/null
+++ b/js/ui/lumaFocusVisible.js
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Focus on the shelf is shown only while someone is driving it with the
+// keyboard, the way :focus-visible works on the web.
+//
+// St marks a widget :focus whenever it holds key focus, however it got it,
+// and a menu hands key focus back to the button it came from when it closes.
+// After a click on Quick Options, the calendar or a menu, that left the whole
+// status island ringed as if it were selected, and a dock icon glowing, with
+// nothing to say why. Now the shelf keeps key focus exactly as before (so the
+// keyboard path is unchanged), but inside the shelf the :focus pseudo-class
+// is only drawn after a navigation key, until the next click or touch.
+import Clutter from 'gi://Clutter';
+import St from 'gi://St';
+
+const NAVIGATION_KEYS = new Set([
+    Clutter.KEY_Tab, Clutter.KEY_ISO_Left_Tab,
+    Clutter.KEY_Left, Clutter.KEY_Right, Clutter.KEY_Up, Clutter.KEY_Down,
+    Clutter.KEY_Home, Clutter.KEY_End, Clutter.KEY_Page_Up, Clutter.KEY_Page_Down,
+    Clutter.KEY_F10,
+]);
+
+export class FocusVisible {
+    constructor(root) {
+        this._root = root;
+        this._keyboard = false;
+        this._eventId = global.stage.connect('captured-event', (_stage, event) => {
+            switch (event.type()) {
+            case Clutter.EventType.KEY_PRESS:
+                if (NAVIGATION_KEYS.has(event.get_key_symbol()))
+                    this._setKeyboard(true);
+                break;
+            case Clutter.EventType.BUTTON_PRESS:
+            case Clutter.EventType.TOUCH_BEGIN:
+                this._setKeyboard(false);
+                break;
+            }
+            return Clutter.EVENT_PROPAGATE;
+        });
+        this._focusId = global.stage.connect('notify::key-focus', () => this._sync());
+    }
+
+    get keyboard() {
+        return this._keyboard;
+    }
+
+    _setKeyboard(keyboard) {
+        if (this._keyboard === keyboard)
+            return;
+        this._keyboard = keyboard;
+        this._sync();
+    }
+
+    _sync() {
+        const focus = global.stage.get_key_focus();
+        if (!(focus instanceof St.Widget) || !this._root.contains(focus))
+            return;
+        if (this._keyboard)
+            focus.add_style_pseudo_class('focus');
+        else
+            focus.remove_style_pseudo_class('focus');
+    }
+
+    destroy() {
+        if (this._eventId)
+            global.stage.disconnect(this._eventId);
+        if (this._focusId)
+            global.stage.disconnect(this._focusId);
+        this._eventId = this._focusId = 0;
+    }
+}
