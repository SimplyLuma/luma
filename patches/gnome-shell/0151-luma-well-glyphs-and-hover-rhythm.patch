+
+/* One optical size, and one highlight box, for the whole status island (0151).
+ *
+ * The system indicators draw at 14px, so an application's or an extension's
+ * glyph in the Well draws at 14px too, in the surface's ink. A tray icon that
+ * exists only in colour keeps its colours in that same 14px box instead of its
+ * native size, so one row of icons reads as one row.
+ *
+ * Hover and pressed are the 28px hit target, inset from the surface they sit
+ * on: 3px inside the Well's 34px recess and 4px inside the island's 36. Radius
+ * 8 everywhere, 7px of air around a lone glyph and 8px beside text. The hit
+ * target keeps its full height; only the highlight is inset.
+ *
+ * The fills are the hover and pressed entries of the ink ledger in
+ * js/ui/lumaSurfaceMaterials.js, per appearance mode. Ink, shadow and veil
+ * values belong to 0150 and are untouched. */
+.luma-well { padding: 0 3px; spacing: 3px; }
+.luma-well-item { min-width: 28px; height: 28px; padding: 0 7px; border-radius: 8px; }
+.luma-well-glyph { width: 14px; height: 14px; }
+.luma-well-item-row { spacing: 5px; }
+
+.luma-well .luma-well-extension { height: 28px; }
+.luma-well .luma-well-extension .panel-button {
+  min-width: 28px;
+  height: 28px;
+  padding: 0 7px;
+  border-radius: 8px;
+  -natural-hpadding: 7px;
+  -minimum-hpadding: 7px; }
+.luma-well .luma-well-extension .panel-button StIcon { icon-size: 14px; }
+
+/* The clock and Quick Options are hover targets of the same height and radius
+ * as a Well item, with their own air around the text. */
+.luma-status-cluster .luma-status-controls,
+.luma-status-cluster .luma-status-clock {
+  height: 28px;
+  border-radius: 8px; }
+.luma-status-cluster .luma-status-controls { padding: 0 7px; }
+.luma-status-cluster .luma-status-clock { padding: 0 8px; min-width: 56px; }
+.luma-status-slot .system-status-icon { icon-size: 14px; }
+
+/* Hover and pressed, per appearance mode, from the ledger. One pair per mode
+ * for the Well, the clock and Quick Options; the recess needs no pair of its
+ * own because the veil under it carries the headroom. A dock tile has no fill
+ * in any state: its artwork lifts instead, which is its own language. */
+.luma-well-item:hover,
+.luma-well-item:focus { background-color: rgba(255, 255, 255, 0.06); }
+.luma-well-item:active { background-color: rgba(255, 255, 255, 0.09); }
+.luma-status-light .luma-well-item:hover,
+.luma-status-light .luma-well-item:focus { background-color: rgba(25, 27, 31, 0.06); }
+.luma-status-light .luma-well-item:active { background-color: rgba(25, 27, 31, 0.09); }
+.luma-surface-frost .luma-well-item:hover,
+.luma-surface-frost .luma-well-item:focus,
+.luma-surface-glass .luma-well-item:hover,
+.luma-surface-glass .luma-well-item:focus { background-color: rgba(255, 255, 255, 0.07); }
+.luma-surface-frost .luma-well-item:active,
+.luma-surface-glass .luma-well-item:active { background-color: rgba(255, 255, 255, 0.11); }
+.luma-well .luma-well-extension .panel-button:active { background-color: rgba(255, 255, 255, 0.09); }
+.luma-status-light .luma-well .luma-well-extension .panel-button:active { background-color: rgba(25, 27, 31, 0.09); }
+.luma-surface-frost .luma-well .luma-well-extension .panel-button:hover,
+.luma-surface-frost .luma-well .luma-well-extension .panel-button:focus,
+.luma-surface-glass .luma-well .luma-well-extension .panel-button:hover,
+.luma-surface-glass .luma-well .luma-well-extension .panel-button:focus { background-color: rgba(255, 255, 255, 0.07); }
+.luma-surface-frost .luma-well .luma-well-extension .panel-button:active,
+.luma-surface-glass .luma-well .luma-well-extension .panel-button:active { background-color: rgba(255, 255, 255, 0.11); }
+.luma-status-cluster .luma-status-clock:active,
+.luma-status-cluster .luma-status-controls:active { background-color: rgba(255, 255, 255, 0.09); }
+.luma-status-cluster.luma-surface-light .luma-status-clock:active,
+.luma-status-cluster.luma-surface-light .luma-status-controls:active { background-color: rgba(25, 27, 31, 0.09); }
+.luma-status-cluster.luma-surface-frost .luma-status-clock:active,
+.luma-status-cluster.luma-surface-frost .luma-status-controls:active,
+.luma-status-cluster.luma-surface-glass .luma-status-clock:active,
+.luma-status-cluster.luma-surface-glass .luma-status-controls:active { background-color: rgba(255, 255, 255, 0.11); }
+
+/* Keyboard focus (0151). lumaFocusVisible.js lets St draw :focus inside the
+ * shelf only while someone navigates by keyboard, so a button that keeps key
+ * focus after a click closed its menu looks like every other button. What is
+ * drawn then is a 2px ring in the treatment's ink from the ledger, which
+ * clears 3:1 for a glyph on every veil; it replaces the pale blue ring around
+ * the status island (#91b6d2, 1.9:1 on light paper) and the dock's blue glow
+ * around the artwork, which a person could also see after a click. */
+.luma-shelf-actions-island.luma-surface-dark .luma-status-cluster:focus { box-shadow: 0 0 0 2px #e7e9e8; }
+.luma-shelf-actions-island.luma-surface-light .luma-status-cluster:focus { box-shadow: 0 0 0 2px #34383d; }
+.luma-shelf-actions-island.luma-surface-frost .luma-status-cluster:focus { box-shadow: 0 0 0 2px #ffffff; }
+.luma-shelf-actions-island.luma-surface-glass .luma-status-cluster:focus { box-shadow: 0 0 0 2px #ffffff; }
+.luma-well-item:focus,
+.luma-well .luma-well-extension .panel-button:focus { box-shadow: inset 0 0 0 2px #e7e9e8; }
+.luma-status-light .luma-well-item:focus,
+.luma-status-light .luma-well .luma-well-extension .panel-button:focus { box-shadow: inset 0 0 0 2px #34383d; }
+.luma-surface-frost .luma-well-item:focus,
+.luma-surface-frost .luma-well .luma-well-extension .panel-button:focus { box-shadow: inset 0 0 0 2px #ffffff; }
+.luma-surface-glass .luma-well-item:focus,
+.luma-surface-glass .luma-well .luma-well-extension .panel-button:focus { box-shadow: inset 0 0 0 2px #ffffff; }
+/* A dock icon keeps its artwork's own language: no fill, a lift on hover, and
