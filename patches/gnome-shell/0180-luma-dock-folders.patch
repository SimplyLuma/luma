+export class FolderModel extends Signals.EventEmitter {
+    constructor(uri) {
+        super();
+        this.uri = uri;
+        this.file = Gio.File.new_for_uri(uri);
+        this.name = this.file.get_basename() ?? uri;
+        this.gicon = null;
+        this.items = [];
+        this.count = 0;
+        this.loaded = false;
+        // The stamp the badge counts against: when this folder was last
+        // opened. Set by the controller from its settings.
+        this.seen = 0;
+        this._monitor = null;
+        this._queuedId = 0;
+        this._cancellable = null;
+    }
+
+    // The folder's own display name, which is Filer's: a localised Downloads
+    // stays Downloads here.
+    async _readDisplayName() {
+        try {
+            const info = await this.file.query_info_async(
+                FOLDER_ATTRIBUTES, Gio.FileQueryInfoFlags.NONE,
+                GLib.PRIORITY_DEFAULT, null);
+            this.name = info.get_display_name() ?? this.name;
+            // standard::icon carries the special-folder icons and any icon
+            // the person set on the folder, which is what Filer shows.
+            this.gicon = info.get_icon() ?? this.gicon;
+        } catch (error) {
+            // A folder that has gone is still named by its path.
+        }
+    }
+
+    start() {
+        if (this._monitor)
+            return;
+        try {
+            this._monitor = this.file.monitor_directory(
+                Gio.FileMonitorFlags.WATCH_MOVES, null);
+            // The tile art, the count and the open surface all follow a folder
+            // that changes underneath them. Coalesced, because a copy of many
+            // files is many events.
+            this._monitor.connect('changed', () => this._queueReload());
+        } catch (error) {
+            logError(error, 'Luma dock folders: cannot watch a folder');
+        }
+        this.reload();
+    }
+
+    _queueReload() {
+        if (this._queuedId)
+            return;
+        this._queuedId = GLib.timeout_add(GLib.PRIORITY_DEFAULT_IDLE, 250, () => {
+            this._queuedId = 0;
+            this.reload();
+            return GLib.SOURCE_REMOVE;
+        });
+    }
