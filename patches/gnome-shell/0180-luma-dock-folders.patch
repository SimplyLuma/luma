+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Dock folders: a Stack and a Grid.
+//
+// A folder pinned to the dock. The folders sit after the applications, behind
+// the same divider token the Dash already draws between the parts of a bar, so
+// the dock reads as three things and not one long strip: what you run, what
+// you keep, what is happening.
+//
+// A tile shows the folder's own contents, not a folder glyph: the three newest
+// fanned for a Stack, the four newest laid down for a Grid, in the pocket of a
+// folder lip. A count appears only when something arrived that has not been
+// looked at, and it clears when the folder is opened.
+//
+// Clicking a tile opens one surface with two arrangements, both Filer's: a
+// Stack, which is Filer's list, and a Grid, which is Filer's icon view. The
+// arrangement is a segmented control in the header and is remembered per
+// folder. The surface can break out of the dock and park anywhere until it is
+// closed.
+//
+// Married or separated is the shelf's own arrangement model (ADR-044): married
+// the rail is a part of the dock island, separated it is the 'folders' island,
+// placed and dragged like any other. One rail, one setting, no second copy.
+
+import Atk from 'gi://Atk';
+import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import GnomeDesktop from 'gi://GnomeDesktop';
+import GObject from 'gi://GObject';
+import Pango from 'gi://Pango';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import * as Signals from '../misc/signals.js';
+import * as Main from './main.js';
+import * as PopupMenu from './popupMenu.js';
+import * as SurfaceMaterials from './lumaSurfaceMaterials.js';
+import * as Placement from './lumaPopoverPlacement.js';
+import * as BadgeModel from './lumaDockBadgeModel.js';
+import {formatTimeSpan} from '../misc/dateUtils.js';
+import {DASH_TILE_SIZE, DASH_TILE_GAP, DIVIDER_WIDTH, SHELF_DIVIDER_LENGTH,
+    SHELF_ISLAND_RADIUS} from './shelfMetrics.js';
+
+// The tile. The dock's own 36px slot and 32px mark at radius 9, so a folder is
+// a peer of the applications beside it.
+const MARK_SIZE = 32;
+// The art: three chips fanned for a Stack, four laid down for a Grid. Capped,
+
+// The surface.
+// Filer's icon view and list view, from src/resources/style.css and
+// nautilus-grid-cell.blp in the same tree. These are not chosen here; they
+// are copied, and they are the reason the two cannot look different.
+const FILER_GRID_PADDING = 12;   // gridview padding
+const FILER_GRID_SPACING = 8;    // gridview border-spacing
+const FILER_CELL_RADIUS = 10;    // gridview > child border-radius
+const FILER_GRID_ICON = 64;      // NAUTILUS_GRID_ICON_SIZE_SMALL_PLUS
+const FILER_NAME_LINES = 3;      // grid cell name: lines 3, ellipsize middle
+const FILER_CAPTION_LINES = 2;   // grid cell caption: lines 2, ellipsize end
+const FILER_ROW_HEIGHT = 30;     // columnview > listview > row min-height
+const SURFACE_GAP = 12;          // from the dock to the surface
+const SURFACE_INSET = 8;         // the closest it comes to a monitor edge
+const STACK_WIDTH = 300;
+const GRID_WIDTH = 412;
+const HEADER_HEIGHT = 46;
+const ROW_HEIGHT = FILER_ROW_HEIGHT;
+const STACK_BODY_MAX = 288;      // eight rows
+const GRID_BODY_MAX = 352;       // eight cells, so switching does not move it
+const GRID_COLUMNS = 4;
+const ISLAND_PADDING = 8;        // the island's own padding around a tile
+const BAR_LENGTH = 18;           // the dock's own open indicator
+const BAR_THICKNESS = 3;
+const DRAG_START = 8;            // before this, a press is still a click
+const BREAK_OUT_DISTANCE = 26;   // the drag that commits to breaking out
+const SHOW_TIME = 200;
+const FADE_TIME = 160;
+
+// How much of a folder we read. Enough for the Grid's eight, its count and its
+// new items; a folder of ten thousand things must not stall the Shell.
+const READ_LIMIT = 512;
+const BODY_ITEMS = 8;
+
+const FOLDER_ATTRIBUTES = [
+    'standard::display-name', 'standard::icon', 'standard::symbolic-icon',
+    'metadata::custom-icon', 'metadata::custom-icon-name',
+].join(',');
+
+const INFO_ATTRIBUTES = [
+    'standard::name', 'standard::display-name', 'standard::type',
+    'standard::content-type', 'standard::icon', 'standard::is-hidden',
+    'standard::is-backup', 'standard::size',
+    'time::modified', 'time::created',
+].join(',');
+
+Gio._promisify(Gio.File.prototype, 'enumerate_children_async');
+Gio._promisify(Gio.FileEnumerator.prototype, 'next_files_async');
+Gio._promisify(Gio.File.prototype, 'query_info_async');
+
+function scaleFactor() {
+    return St.ThemeContext.get_for_stage(global.stage).scale_factor;
+}
+
+function clamp(value, low, high) {
+    return Math.max(low, Math.min(value, Math.max(low, high)));
