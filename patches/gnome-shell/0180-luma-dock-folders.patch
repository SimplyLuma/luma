+// Filer's thumbnails, from Filer's cache: the same thumbnailer, the same
+// files on disk, and Filer's own preferences about when to show one.
+//
+// This reads that cache; it never fills it. Generating a thumbnail is the
+// thumbnailer's job, and doing it here would put arbitrary decoders on the
+// compositor's main loop for the sake of a popover. A file Filer has not
+// thumbnailed yet keeps its kind's icon and gains the picture the next time
+// the folder is opened after Filer has been there.
+const FILER_PREFS = 'org.gnome.nautilus.preferences';
+const THUMBNAIL_MINIMUM_ICON = 32;   // NAUTILUS_THUMBNAIL_MINIMUM_ICON_SIZE
+
+let filerPrefs;
+function filerThumbnailPrefs() {
+    if (filerPrefs === undefined) {
+        const source = Gio.SettingsSchemaSource.get_default();
+        filerPrefs = source?.lookup(FILER_PREFS, true)
+            ? new Gio.Settings({schema_id: FILER_PREFS}) : null;
+    }
+    return filerPrefs;
+}
+
+// Filer's rule, not one of our own: the "show thumbnails" setting and the
+// size limit it applies.
+function thumbnailAllowed(item, iconSize) {
+    if (iconSize < THUMBNAIL_MINIMUM_ICON || item.isDirectory)
+        return false;
+    const prefs = filerThumbnailPrefs();
+    if (!prefs)
+        return true;
+    const show = prefs.get_string('show-image-thumbnails');
+    if (show === 'never')
+        return false;
+    const limit = prefs.get_uint64('thumbnail-limit');
+    return !(limit > 0 && item.size > limit);
+}
+
+let thumbnailFactory = null;
+function thumbnailFor(file, info) {
+    try {
+        // A gnome-desktop without the thumbnail factory means no thumbnails,
+        // not a broken folder: every item still has its kind's own icon.
+        thumbnailFactory ??= GnomeDesktop.DesktopThumbnailFactory?.new(
+            GnomeDesktop.DesktopThumbnailSize.LARGE) ?? null;
+        if (!thumbnailFactory)
+            return null;
+        const mtime = info.modifiedUnix ?? info.get_modification_date_time?.()?.to_unix();
+        if (!mtime)
+            return null;
+        return thumbnailFactory.lookup(file.get_uri(), mtime);
+    } catch (error) {
+        return null;
+    }
+}
+
+// The right side of a Stack row, and the line under a Grid cell: the size and
+// the age, in Filer's words and the platform's own relative time.
+function metaFor(item) {
+    if (item.isDirectory) {
+        const count = item.childCount;
+        if (count === undefined || count < 0)
+            return '';
+        return ngettext('%d item', '%d items', count).format(count);
+    }
+    const size = GLib.format_size(Math.max(0, item.size));
+    if (!item.modified)
+        return size;
+    const age = formatTimeSpan(item.modified);
+    return age ? `${size} · ${age}` : size;
+}
+
+// ── The tile ────────────────────────────────────────────────────────────────
+
+// The mark: the folder's own icon, exactly as Filer draws it.
+//
+// Not art derived from the contents. A folder's icon is already a thing the
+// person recognises -- Downloads, Pictures, a folder they gave an icon of
