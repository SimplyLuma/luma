diff --git a/data/theme/luma-shelf.css b/data/theme/luma-shelf.css
index 47a9bae..ab01030 100644
--- a/data/theme/luma-shelf.css
+++ b/data/theme/luma-shelf.css
@@ -2404,3 +2404,252 @@ StBoxLayout.luma-notification-tray.luma-surface-dark .luma-notification-tray-cou
 .luma-shelf-vertical .luma-shelf-clock-island .luma-status-clock-text { spacing: 2px; }
 .luma-live-extension-short { font-family: Figtree, sans-serif; font-size: 11px; font-weight: 700; font-feature-settings: "tnum"; }
 .luma-shelf-vertical .luma-live-extension-content { spacing: 6px; }
+
+/* ── Dock folders: a Stack and a Grid (lumaDockFolders.js) ─────────────────
+ *
+ * A folder pinned to the dock, behind the same divider token the Dash draws
+ * between the parts of a bar. The tile is the dock's own 36px slot and 32px
+ * mark, with a lip across the foot; the tint, the gradient, the lip and the
+ * chips are set from the folder itself, so only the shape and the type are
+ * here. The surface borrows Filer's rhythm and the shelf's four treatments.
+ */
+.luma-dockf-rail { spacing: 6px; }
+.luma-dockf-divider { margin: 0 7px; }
+.luma-shelf-vertical .luma-dockf-divider { margin: 7px 0; }
+.luma-shelf-folders-box { padding: 0; }
+
+.luma-dockf-tile { padding: 0; border: none; background: none; }
+.luma-dockf-tile:focus {
+  outline: 2px solid rgba(92, 133, 183, 0.72);
+  outline-offset: 2px; }
+/* The mark is the folder's own icon; it carries its own shape. */
+/* The open indicator is the dock's own bar, on the island's inside edge. */
+.luma-dockf-bar { margin: 0; }
+/* The unread count: the dock's badge, so one count never reads as two
+ * systems. Fill, ring and geometry come from lumaDockBadgeModel.js. */
+.luma-dockf-badge { padding: 0; }
+
+/* The surface. One island, Filer's rhythm, the shelf's radius. */
+.luma-dockf-surface {
+  padding: 0;
+  spacing: 0;
+  border-radius: 15px;
+  border: 1px solid rgba(255, 255, 255, 0.075);
+  background-color: #2a2e34;
+  color: #e7e9e8;
+  box-shadow: 0 4px 12px rgba(14, 18, 24, 0.2); }
+.luma-dockf-shadow {
+  border-radius: 15px;
+  background-color: rgba(37, 42, 48, 0.01);
+  box-shadow: 0 34px 84px -24px rgba(14, 18, 24, 0.62); }
+/* Detached it is a thing sitting on the desktop rather than a thing hanging
+ * off the dock, so the shadow deepens to the desktop's window shadow. */
+.luma-dockf-detached .luma-dockf-shadow {
+  box-shadow: 0 18px 42px -14px rgba(25, 27, 31, 0.42),
+              0 54px 110px -28px rgba(25, 27, 31, 0.56); }
+.luma-dockf-surface.luma-surface-light {
+  border-color: rgba(255, 255, 255, 0.82); background-color: #fbfbfa; color: #283038; }
+.luma-dockf-surface.luma-surface-frost {
+  border-color: rgba(255, 255, 255, 0.82);
+  background-color: rgba(251, 251, 250, 0.88);
+  color: #1f262d; }
+.luma-dockf-surface.luma-surface-glass {
+  border-color: rgba(255, 255, 255, 0.82);
+  background-color: rgba(250, 250, 251, 0.80);
+  color: #161b20; }
+
+/* Header: the mark, the name and a true count, the arrangement, and the ways
+ * out of the dock. */
+.luma-dockf-head {
+  height: 46px;
+  padding: 0 6px 0 12px;
+  spacing: 8px;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
+.luma-surface-light .luma-dockf-head,
+.luma-surface-frost .luma-dockf-head,
+.luma-surface-glass .luma-dockf-head { border-bottom-color: rgba(39, 48, 56, 0.095); }
+.luma-dockf-head-copy { spacing: 1px; }
+.luma-dockf-head-name { font-family: Figtree, sans-serif; font-size: 14px; font-weight: 700; }
+.luma-dockf-head-meta {
+  font-family: Figtree, sans-serif;
+  font-size: 11px;
+  font-weight: 550;
+  color: rgba(231, 233, 232, 0.55); }
+.luma-surface-light .luma-dockf-head-meta,
+.luma-surface-frost .luma-dockf-head-meta,
+.luma-surface-glass .luma-dockf-head-meta { color: rgba(40, 48, 56, 0.55); }
+
+/* The arrangement, the kit's segmented control at its smallest. */
+.luma-dockf-views {
+  padding: 2px;
+  spacing: 1px;
+  border-radius: 8px;
+  background-color: rgba(255, 255, 255, 0.038); }
+.luma-surface-light .luma-dockf-views,
+.luma-surface-frost .luma-dockf-views,
+.luma-surface-glass .luma-dockf-views { background-color: rgba(39, 48, 56, 0.04); }
+.luma-dockf-view {
+  width: 26px; height: 22px;
+  padding: 0;
+  border: none;
+  border-radius: 6px;
+  background: none;
+  color: rgba(231, 233, 232, 0.55); }
+.luma-surface-light .luma-dockf-view,
+.luma-surface-frost .luma-dockf-view,
+.luma-surface-glass .luma-dockf-view { color: rgba(40, 48, 56, 0.55); }
+.luma-dockf-view:hover { color: inherit; }
+.luma-dockf-view:focus { outline: 2px solid rgba(92, 133, 183, 0.72); outline-offset: -2px; }
+.luma-dockf-view:checked {
+  background-color: rgba(255, 255, 255, 0.11);
+  color: #e7e9e8; }
+.luma-surface-light .luma-dockf-view:checked,
+.luma-surface-frost .luma-dockf-view:checked,
+.luma-surface-glass .luma-dockf-view:checked {
+  background-color: #ffffff;
+  color: #283038;
+  box-shadow: 0 1px 2px rgba(12, 17, 24, 0.16); }
+.luma-dockf-view-icon { icon-size: 14px; }
+
+.luma-dockf-act {
+  width: 26px; height: 26px;
+  padding: 0;
+  border: none;
+  border-radius: 8px;
+  background: none;
+  color: rgba(231, 233, 232, 0.55); }
+.luma-surface-light .luma-dockf-act,
+.luma-surface-frost .luma-dockf-act,
+.luma-surface-glass .luma-dockf-act { color: rgba(40, 48, 56, 0.55); }
+.luma-dockf-act:hover { background-color: rgba(255, 255, 255, 0.06); color: #e7e9e8; }
+.luma-surface-light .luma-dockf-act:hover,
+.luma-surface-frost .luma-dockf-act:hover,
+.luma-surface-glass .luma-dockf-act:hover {
+  background-color: rgba(39, 48, 56, 0.06); color: #283038; }
+.luma-dockf-act:focus { outline: 2px solid rgba(92, 133, 183, 0.72); outline-offset: -2px; }
+.luma-dockf-act-icon { icon-size: 15px; }
+
+/* Body. Stack is Filer's list, Grid is Filer's icon view; both cap at eight,
+ * so switching the arrangement does not move the surface. */
+.luma-dockf-scroll { padding: 0; }
+.luma-dockf-scroll StScrollBar { padding: 0; }
+.luma-dockf-scroll > StBoxLayout { padding: 6px; spacing: 0; }
+.luma-dockf-scroll > StBoxLayout.luma-dockf-grid { padding: 12px; spacing: 8px; }
+.luma-dockf-grid-row { spacing: 8px; }
+
+/* Filer: row min-height 30 with a 4px 8px cell inside it. St adds padding
+ * to height, so the content box is 22 and the row measures Filer 30. */
+.luma-dockf-row {
+  height: 22px;
+  padding: 4px 8px;
+  border: none;
+  border-radius: 8px;
+  background: none;
+  color: inherit; }
+.luma-dockf-row > StBoxLayout { spacing: 8px; }
+.luma-dockf-row:hover { background-color: rgba(255, 255, 255, 0.06); }
+.luma-surface-light .luma-dockf-row:hover,
+.luma-surface-frost .luma-dockf-row:hover,
+.luma-surface-glass .luma-dockf-row:hover { background-color: rgba(39, 48, 56, 0.06); }
+/* Keyboard focus only: nothing wears a ring until an arrow key puts it
+ * there. An outline drew as one left edge here, which read as a selection. */
+.luma-dockf-row:focus { box-shadow: inset 0 0 0 2px #80a8d2; }
+.luma-dockf-row-name { font-family: Figtree, sans-serif; font-size: 13px; font-weight: 525; }
+.luma-dockf-row-meta {
+  font-family: Figtree, sans-serif;
+  font-size: 11px;
+  font-weight: 550;
+  font-feature-settings: "tnum";
+  color: rgba(231, 233, 232, 0.55); }
+.luma-surface-light .luma-dockf-row-meta,
+.luma-surface-frost .luma-dockf-row-meta,
+.luma-surface-glass .luma-dockf-row-meta { color: rgba(40, 48, 56, 0.55); }
+/* An item that arrived since the last opening. */
+.luma-dockf-new {
+  width: 5px; height: 5px;
+  border-radius: 3px;
+  background-color: #80a8d2; }
+.luma-surface-light .luma-dockf-new,
+.luma-surface-frost .luma-dockf-new,
+.luma-surface-glass .luma-dockf-new { background-color: #527fae; }
+
+.luma-dockf-cell {
+  padding: 6px;
+  border: none;
+  border-radius: 10px;
+  background: none;
+  color: inherit; }
+.luma-dockf-cell > StBoxLayout { spacing: 6px; }
+.luma-dockf-cell:hover { background-color: rgba(255, 255, 255, 0.06); }
+.luma-surface-light .luma-dockf-cell:hover,
+.luma-surface-frost .luma-dockf-cell:hover,
+.luma-surface-glass .luma-dockf-cell:hover { background-color: rgba(39, 48, 56, 0.06); }
+.luma-dockf-cell:focus { box-shadow: inset 0 0 0 2px #80a8d2; }
+.luma-dockf-cell-name {
+  font-family: Figtree, sans-serif;
+  font-size: 13px;
+  font-weight: 625;
+  text-align: center;
+  /* Filer wraps a name over three lines before it ellipsises. */
+  max-height: 51px; }
+.luma-dockf-cell-meta {
+  font-family: Figtree, sans-serif;
+  font-size: 11px;
+  font-weight: 500;
+  text-align: center;
+  max-height: 30px;
+  font-feature-settings: "tnum";
+  color: rgba(231, 233, 232, 0.55); }
+.luma-surface-light .luma-dockf-cell-meta,
+.luma-surface-frost .luma-dockf-cell-meta,
+.luma-surface-glass .luma-dockf-cell-meta { color: rgba(40, 48, 56, 0.55); }
+
+/* Thumbnails are Filer's: the cached thumbnail where one exists, the kind's
+ * own glyph on the standard fill where it does not. */
+.luma-dockf-thumb {
+  border-radius: 6px;
+  background-color: rgba(255, 255, 255, 0.038);
+  border: 1px solid rgba(255, 255, 255, 0.08); }
+.luma-surface-light .luma-dockf-thumb,
+.luma-surface-frost .luma-dockf-thumb,
+.luma-surface-glass .luma-dockf-thumb {
+  background-color: rgba(39, 48, 56, 0.04);
+  border-color: rgba(39, 48, 56, 0.095); }
+.luma-dockf-thumb-large { border-radius: 10px; height: 76px; }
+.luma-dockf-thumb-photo { border: none; }
+.luma-dockf-photo { border-radius: 6px; }
+.luma-dockf-thumb-large .luma-dockf-photo { border-radius: 10px; }
+.luma-dockf-glyph { color: rgba(231, 233, 232, 0.55); }
+.luma-surface-light .luma-dockf-glyph,
+.luma-surface-frost .luma-dockf-glyph,
+.luma-surface-glass .luma-dockf-glyph { color: rgba(40, 48, 56, 0.55); }
+.luma-dockf-glyph-folder { color: #80a8d2; }
+.luma-surface-light .luma-dockf-glyph-folder,
+.luma-surface-frost .luma-dockf-glyph-folder,
+.luma-surface-glass .luma-dockf-glyph-folder { color: #527fae; }
+
+/* Dragging an attached surface says what letting go will do. */
+.luma-dockf-breakout {
+  padding: 5px 10px;
+  border-radius: 99px;
+  background-color: rgba(20, 25, 31, 0.86);
+  color: #f4f6f7;
+  font-family: Figtree, sans-serif;
+  font-size: 11px;
+  font-weight: 650; }
+
+/* The slot a dragged folder lands in, and the rail lighting up to take it.
+   The dock already shows a drop with :drop; this is the same cue, at the
+   tile footprint so the row does not move when the folder arrives. */
+.luma-dockf-placeholder {
+  border-radius: 9px;
+  border: 2px dashed rgba(255, 255, 255, 0.34);
+  background-color: rgba(255, 255, 255, 0.06); }
+.luma-surface-light .luma-dockf-placeholder,
+.luma-surface-frost .luma-dockf-placeholder,
+.luma-surface-glass .luma-dockf-placeholder {
+  border-color: rgba(39, 48, 56, 0.30);
+  background-color: rgba(39, 48, 56, 0.05); }
+.luma-dockf-rail:drop .luma-dockf-placeholder {
+  border-color: rgba(128, 168, 210, 0.85);
+  background-color: rgba(128, 168, 210, 0.16); }
