+    async reload() {
+        this._cancellable?.cancel();
+        const cancellable = this._cancellable = new Gio.Cancellable();
+        await this._readDisplayName();
+        let items = [];
+        try {
+            const enumerator = await this.file.enumerate_children_async(
+                INFO_ATTRIBUTES, Gio.FileQueryInfoFlags.NONE,
+                GLib.PRIORITY_DEFAULT, cancellable);
+            for (;;) {
+                const batch = await enumerator.next_files_async(
+                    64, GLib.PRIORITY_DEFAULT, cancellable);
+                if (!batch?.length)
+                    break;
+                for (const info of batch) {
+                    // Filer's rules: hidden and backup files are not shown.
+                    if (info.get_is_hidden() || info.get_is_backup())
+                        continue;
+                    items.push(this._item(info));
+                }
+                if (items.length >= READ_LIMIT)
+                    break;
+            }
+            enumerator.close(null);
+        } catch (error) {
+            if (error.matches?.(Gio.IOErrorEnum, Gio.IOErrorEnum.CANCELLED))
+                return;
+            // A folder that cannot be read has no contents, not stale ones.
+            items = [];
+        }
+        if (cancellable.is_cancelled())
+            return;
+        // Newest first, which is what a dock folder is for.
+        items.sort((a, b) => b.sortTime - a.sortTime);
+        this.items = items;
+        this.count = items.length;
+        this.loaded = true;
+        this.emit('changed');
+    }
+
+    _item(info) {
+        const child = this.file.get_child(info.get_name());
+        const modified = info.get_modification_date_time?.() ?? null;
+        const created = info.get_creation_date_time?.() ?? null;
+        const isDirectory = info.get_file_type() === Gio.FileType.DIRECTORY;
+        return {
+            name: info.get_display_name() ?? info.get_name(),
+            uri: child.get_uri(),
+            file: child,
+            gicon: info.get_icon(),
+            contentType: info.get_content_type() ?? '',
+            isDirectory,
+            size: isDirectory ? -1 : info.get_size(),
+            modified,
+            // What the badge counts against. A file system that cannot say
+            // when a file was created says nothing, and the badge stays away.
+            created,
+            sortTime: (created ?? modified)?.to_unix() ?? 0,
+            // Looked up when the item is about to be seen, not now: a folder
+            // of a thousand must not be a thousand cache lookups to open.
+            thumbnail: undefined,
+            modifiedUnix: modified?.to_unix() ?? 0,
+        };
+    }
+
+    // Files added since the folder was last opened.
+    //
+    // Creation time, never modification time: "2 new" has to mean two things
+    // arrived, and a file edited in place did not arrive. Where the file
+    // system cannot report a creation time -- some network and FUSE mounts --
+    // there is no honest number, so there is no badge.
+    get newCount() {
+        if (!this.seen)
+            return 0;
+        let count = 0;
+        for (const item of this.items) {
+            if (!item.created)
+                return 0;
+            if (item.created.to_unix() > this.seen)
+                count++;
+        }
+        return count;
+    }
+
+    isNew(item) {
+        return !!(this.seen && item.created && item.created.to_unix() > this.seen);
+    }
+
+    destroy() {
+        this._cancellable?.cancel();
+        this._cancellable = null;
+        if (this._queuedId)
+            GLib.source_remove(this._queuedId);
