From: Project Luma <devnull@projectluma.local>
Subject: [PATCH] st: agree on box-shadow texture support and paint bounds

Keep the box-shadow GPU padding, sliced/unsliced mapping and theme paint
bounds under one private contract. Preserve the legacy helper, icon, text,
background-image and Cairo inset paths and the CSS blur-to-sigma conversion.
This source candidate requires native rendering/scale regression evidence.

GNOME Shell 50.3 St sources retain LGPL-2.1 terms and upstream attribution.
No public St struct, installed header, GIR or exported legacy signature changes.

diff --git a/src/st/st-private.c b/src/st/st-private.c
--- a/src/st/st-private.c
+++ b/src/st/st-private.c
@@ -377,11 +377,53 @@
   return pixels_out;
 }
 
-CoglPipeline *
-_st_create_shadow_pipeline (StShadow            *shadow_spec,
+/* Box shadows use the same three-sigma support in their texture, sliced
+ * mapping and paint bounds. Other shadow consumers keep their historical
+ * texture/rectangle contract. Clutter converts the CSS blur radius to sigma. */
+float
+_st_box_shadow_get_padding (StShadow *shadow)
+{
+  return shadow->blur > 0 ? ceilf (0.75f * shadow->blur) * 2.f : 0.f;
+}
+
+gboolean
+_st_box_shadow_get_box (StShadow              *shadow,
+                        const ClutterActorBox *box,
+                        ClutterActorBox       *shadow_box)
+{
+  float extent = _st_box_shadow_get_padding (shadow) + shadow->spread;
+
+  if (shadow->inset)
+    {
+      *shadow_box = *box;
+      return TRUE;
+    }
+
+  if (box->x2 - box->x1 + 2 * shadow->spread <= 0 ||
+      box->y2 - box->y1 + 2 * shadow->spread <= 0)
+    return FALSE;
+
+  *shadow_box = (ClutterActorBox) {
+    box->x1 + shadow->xoffset - extent,
+    box->y1 + shadow->yoffset - extent,
+    box->x2 + shadow->xoffset + extent,
+    box->y2 + shadow->yoffset + extent,
+  };
+  return TRUE;
+}
+
+const StBoxShadowTextureCoords *
+_st_box_shadow_get_texture_coords (CoglPipeline *pipeline)
+{
+  return g_object_get_data (G_OBJECT (pipeline), "st-box-shadow-texture-coords");
+}
+
+static CoglPipeline *
+create_shadow_pipeline (StShadow            *shadow_spec,
                             ClutterPaintContext *paint_context,
                             CoglTexture         *src_texture,
-                            float                resource_scale)
+                            float                resource_scale,
+                         gboolean             box_shadow)
 {
   g_autoptr (ClutterPaintNode) texture_node = NULL;
   g_autoptr (ClutterPaintNode) blur_node = NULL;
@@ -407,13 +449,15 @@
   g_return_val_if_fail (src_texture != NULL, NULL);
 
   radius = resource_scale * shadow_spec->blur;
-  sampling_radius = ceilf (radius);
+  sampling_radius = box_shadow
+    ? resource_scale * _st_box_shadow_get_padding (shadow_spec)
+    : ceilf (radius);
 
   src_width = cogl_texture_get_width (src_texture);
   src_height = cogl_texture_get_height (src_texture);
   cogl_context = cogl_texture_get_context (src_texture);
-  dst_width = src_width + 2 * sampling_radius;
-  dst_height = src_height + 2 * sampling_radius;
+  dst_width = ceilf (src_width + 2 * sampling_radius);
+  dst_height = ceilf (src_height + 2 * sampling_radius);
 
   texture = cogl_texture_2d_new_with_size (cogl_context, dst_width, dst_height);
   if (!texture)
@@ -500,9 +544,45 @@
   pipeline = cogl_pipeline_copy (shadow_pipeline_template);
   cogl_pipeline_set_layer_texture (pipeline, 0, texture);
 
+  if (box_shadow)
+    {
+      StBoxShadowTextureCoords *coords = g_new (StBoxShadowTextureCoords, 1);
+
+      /* Device-pixel rounding belongs to storage, not the CSS rectangle.
+       * Crop the extra final pixel instead of stretching it over the shadow. */
+      *coords = (StBoxShadowTextureCoords) {
+        .x_scale = resource_scale / dst_width,
+        .y_scale = resource_scale / dst_height,
+        .x_end = (src_width + 2 * sampling_radius) / dst_width,
+        .y_end = (src_height + 2 * sampling_radius) / dst_height,
+      };
+      g_object_set_data_full (G_OBJECT (pipeline), "st-box-shadow-texture-coords",
+                              coords, g_free);
+    }
+
   g_clear_object (&texture);
 
   return pipeline;
+}
+
+CoglPipeline *
+_st_create_shadow_pipeline (StShadow            *shadow_spec,
+                            ClutterPaintContext *paint_context,
+                            CoglTexture         *src_texture,
+                            float                resource_scale)
+{
+  return create_shadow_pipeline (shadow_spec, paint_context, src_texture,
+                                  resource_scale, FALSE);
+}
+
+CoglPipeline *
+_st_create_box_shadow_pipeline (StShadow            *shadow_spec,
+                                ClutterPaintContext *paint_context,
+                                CoglTexture         *src_texture,
+                                float                resource_scale)
+{
+  return create_shadow_pipeline (shadow_spec, paint_context, src_texture,
+                                  resource_scale, TRUE);
 }
 
 CoglPipeline *
@@ -823,3 +903,37 @@
   clutter_paint_node_add_child (node, pipeline_node);
   clutter_paint_node_add_rectangle (pipeline_node, &shadow_box);
 }
+
+/* The unsliced box path shares the new box texture coordinates. Keep the
+ * legacy helper above unchanged: text, icons and background images use it. */
+void
+_st_paint_box_shadow_with_opacity (StShadow         *shadow_spec,
+                                   ClutterPaintNode *node,
+                                   CoglPipeline     *shadow_pipeline,
+                                   ClutterActorBox  *box,
+                                   guint8            paint_opacity)
+{
+  g_autoptr (ClutterPaintNode) pipeline_node = NULL;
+  const StBoxShadowTextureCoords *coords;
+  ClutterActorBox shadow_box;
+  CoglColor color;
+
+  if (!_st_box_shadow_get_box (shadow_spec, box, &shadow_box))
+    return;
+
+  coords = _st_box_shadow_get_texture_coords (shadow_pipeline);
+  g_assert (coords != NULL);
+
+  cogl_color_init_from_4f (&color,
+                           shadow_spec->color.red / 255.0 * paint_opacity / 255.0,
+                           shadow_spec->color.green / 255.0 * paint_opacity / 255.0,
+                           shadow_spec->color.blue / 255.0 * paint_opacity / 255.0,
+                           shadow_spec->color.alpha / 255.0 * paint_opacity / 255.0);
+  cogl_color_premultiply (&color);
+  cogl_pipeline_set_layer_combine_constant (shadow_pipeline, 0, &color);
+
+  pipeline_node = clutter_pipeline_node_new (shadow_pipeline);
+  clutter_paint_node_add_child (node, pipeline_node);
+  clutter_paint_node_add_texture_rectangle (pipeline_node, &shadow_box,
+                                            0, 0, coords->x_end, coords->y_end);
+}
