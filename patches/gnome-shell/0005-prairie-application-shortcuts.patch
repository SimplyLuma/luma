+class DesktopApplicationShortcuts {
+    constructor() {
+        const desktopPath = GLib.get_user_special_dir(
+            GLib.UserDirectory.DIRECTORY_DESKTOP) ??
+            GLib.build_filenamev([GLib.get_home_dir(), 'Desktop']);
+
+        this._directory = Gio.File.new_for_path(desktopPath);
+        this._views = new Set();
+        this._reloadId = 0;
+
+        try {
+            this._directory.make_directory_with_parents(null);
+        } catch (e) {
+            if (!e.matches(Gio.IOErrorEnum, Gio.IOErrorEnum.EXISTS))
+                logError(e, 'Failed to prepare the desktop directory');
+        }
+
+        try {
+            this._monitor = this._directory.monitor_directory(
+                Gio.FileMonitorFlags.WATCH_MOVES, null);
+            this._monitor.connect('changed', () => this._queueReload());
+        } catch (e) {
+            logError(e, 'Failed to monitor desktop application shortcuts');
+            this._monitor = null;
+        }
+    }
+
+    attach(backgroundActor, layoutManager) {
+        const monitor = layoutManager.primaryMonitor;
+        if (!monitor || backgroundActor.x !== monitor.x ||
+            backgroundActor.y !== monitor.y)
+            return;
+
+        const view = new St.Widget({
+            style_class: 'prairie-desktop-shortcuts',
+            reactive: false,
+            layout_manager: new Clutter.FixedLayout(),
+        });
+        view.set_position(0, 0);
+        view.set_size(monitor.width, monitor.height);
+        backgroundActor.add_child(view);
+        this._views.add(view);
+
+        backgroundActor.connect('destroy', () => this._views.delete(view));
+        this._reloadView(view);
+    }
+
+    createShortcut(app) {
+        const appInfo = app?.get_app_info();
+        const appId = app?.get_id();
+        const sourcePath = appInfo?.get_filename?.();
+        if (!appId || !sourcePath)
+            return false;
+
+        const shortcut = this._directory.get_child(appId);
+        if (shortcut.query_exists(null))
+            return true;
+
+        try {
+            shortcut.make_symbolic_link(sourcePath, null);
+            return true;
+        } catch (e) {
+            logError(e, `Failed to create desktop shortcut for ${appId}`);
+            Main.notifyError(
+                _('Could Not Add Application to Desktop'), e.message);
+            return false;
+        }
+    }
+
+    _queueReload() {
+        if (this._reloadId)
+            return;
+
+        this._reloadId = GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
+            this._reloadId = 0;
+            for (const view of this._views)
+                this._reloadView(view);
+            return GLib.SOURCE_REMOVE;
+        });
+    }
+
+    _loadApplications() {
+        const applications = [];
+        let enumerator;
+
+        try {
+            enumerator = this._directory.enumerate_children(
+                'standard::name,standard::type',
+                Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS, null);
+
+            let info;
+            while ((info = enumerator.next_file(null))) {
+                const name = info.get_name();
+                if (!name.endsWith('.desktop'))
+                    continue;
+
+                const file = this._directory.get_child(name);
+                const appInfo = GioUnix.DesktopAppInfo.new_from_filename(
+                    file.get_path());
+                if (!appInfo)
+                    continue;
+
+                const app = Shell.AppSystem.get_default().lookup_app(
+                    appInfo.get_id());
+                if (app)
+                    applications.push(app);
+            }
+        } catch (e) {
+            logError(e, 'Failed to enumerate desktop application shortcuts');
+        } finally {
+            enumerator?.close(null);
+        }
+
+        applications.sort((a, b) =>
+            a.get_name().localeCompare(b.get_name()));
+        return applications;
+    }
+
+    _reloadView(view) {
+        view.destroy_all_children();
+
+        const applications = this._loadApplications();
+        const columnWidth = 92;
+        const rowHeight = 94;
+        const topInset = (Main.panel?.height ?? 34) + 18;
+        const rows = Math.max(1,
+            Math.floor((view.height - topInset - 24) / rowHeight));
+
+        applications.forEach((app, index) => {
+            const column = Math.floor(index / rows);
+            const row = index % rows;
+            const button = new St.Button({
+                style_class: 'prairie-desktop-shortcut',
+                can_focus: true,
+                x: view.width - (column + 1) * columnWidth - 12,
+                y: topInset + row * rowHeight,
+                width: 84,
+                height: 86,
+            });
+            const content = new St.BoxLayout({
+                style_class: 'prairie-desktop-shortcut-content',
+                vertical: true,
+                x_align: Clutter.ActorAlign.CENTER,
+            });
+            const label = new St.Label({
+                style_class: 'prairie-desktop-shortcut-label',
+                text: app.get_name(),
+                x_align: Clutter.ActorAlign.CENTER,
+            });
+
+            content.add_child(app.create_icon_texture(48));
+            content.add_child(label);
+            button.set_child(content);
+            button.connect('clicked', () => app.activate());
+            view.add_child(button);
+        });
+    }
+}
+
+let desktopApplicationShortcuts = null;
+
+function getDesktopApplicationShortcuts() {
+    desktopApplicationShortcuts ??= new DesktopApplicationShortcuts();
+    return desktopApplicationShortcuts;
+}
