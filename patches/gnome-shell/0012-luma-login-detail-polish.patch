 5 files changed, 36 insertions(+), 36 deletions(-)

diff --git a/data/theme/gnome-shell-dark.css b/data/theme/gnome-shell-dark.css
index cf22ce9..c8cb10d 100644
--- a/data/theme/gnome-shell-dark.css
+++ b/data/theme/gnome-shell-dark.css
@@ -3073,7 +3073,7 @@ StScrollBar {
   background-gradient-end: rgba(4, 13, 13, 0.27); }
 
 .prairie-login-clock {
-  spacing: 16px;
+  spacing: 4px;
   color: white;
   font-family: "Figtree";
   text-shadow: 0 3px 22px rgba(0, 0, 0, 0.34); }
@@ -3124,7 +3124,7 @@ StScrollBar {
       background-color: #4c6078;
       background-image: url("resource:///org/gnome/shell/theme/prairie-login-avatar.svg");
       background-size: cover;
-      box-shadow: 0 12px 28px -14px rgba(0, 0, 0, 0.6);
+      box-shadow: 0 8px 18px -10px rgba(0, 0, 0, 0.42);
       color: white; }
     .login-dialog-prompt-layout.prairie-auth-card .user-widget.vertical .prairie-login-avatar-initial {
       color: white;
@@ -3148,7 +3148,7 @@ StScrollBar {
   border: 1px solid rgba(255, 255, 255, 0.045);
   border-radius: 10px;
   background-color: #21252b;
-  box-shadow: 0 22px 52px -15px rgba(9, 11, 14, 0.4); }
+  box-shadow: 0 12px 28px -12px rgba(9, 11, 14, 0.3); }
   .login-dialog-button-box.prairie-password-field:focus-within {
     border-color: rgba(255, 255, 255, 0.25); }
 
@@ -3183,14 +3183,14 @@ StScrollBar {
   .login-dialog .login-dialog-prompt-entry StIcon.peek-password,
   .unlock-dialog .login-dialog-prompt-entry.prairie-login-entry StIcon.peek-password,
   .unlock-dialog .login-dialog-prompt-entry StIcon.peek-password {
-    icon-size: 19px;
+    icon-size: 15px;
     padding: 0;
-    color: #969da4; }
+    color: rgba(150, 157, 164, 0.72); }
   .login-dialog .login-dialog-prompt-entry.prairie-login-entry StIcon.peek-password:hover,
   .login-dialog .login-dialog-prompt-entry StIcon.peek-password:hover,
   .unlock-dialog .login-dialog-prompt-entry.prairie-login-entry StIcon.peek-password:hover,
   .unlock-dialog .login-dialog-prompt-entry StIcon.peek-password:hover {
-    color: #e7e9e8; }
+    color: rgba(231, 233, 232, 0.82); }
   .login-dialog .login-dialog-prompt-entry.prairie-login-entry:focus,
   .login-dialog .login-dialog-prompt-entry:focus,
   .unlock-dialog .login-dialog-prompt-entry.prairie-login-entry:focus,
@@ -3215,14 +3215,14 @@ StScrollBar {
   border: 0;
   border-radius: 10px;
   background-color: rgba(255, 255, 255, 0.88);
-  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
+  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.14);
   color: #242a30; }
   .prairie-login-submit-button:hover, .prairie-login-submit-button:focus {
     background-color: white; }
   .prairie-login-submit-button:active {
     background-color: rgba(255, 255, 255, 0.8); }
   .prairie-login-submit-button .prairie-login-submit-icon {
-    icon-size: 18px;
+    icon-size: 15px;
     color: #242a30; }
   .prairie-login-submit-button .spinner {
     color: #242a30; }
