+++ b/data/theme/test-treatment-ink.py
@@ -0,0 +1,43 @@
+#!/usr/bin/python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Measured utility glyph plates must never waive the general ink gate."""
+import importlib.util
+from pathlib import Path
+import unittest
+
+spec = importlib.util.spec_from_file_location(
+    "ink_guard", Path(__file__).with_name("verify-treatment-ink.py"))
+guard = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(guard)
+SELECTOR = ".quick-settings.luma-studio-options.luma-surface-light .luma-options-utility:checked .quick-toggle-icon"
+BLUE = "color: #ffffff; background-color: #3a84ca;"
+
+class UtilityGlyphPlateTests(unittest.TestCase):
+    def test_existing_blue_plate_meets_glyph_not_body_threshold(self):
+        self.assertFalse(guard.plate_carries_ink(BLUE, "#ffffff"))
+        self.assertTrue(guard.utility_glyph_plate([SELECTOR], BLUE, "#ffffff"))
+
+    def test_white_icon_without_fill_fails(self):
+        self.assertFalse(guard.utility_glyph_plate([SELECTOR], "color: #ffffff;", "#ffffff"))
+
+    def test_transparent_plate_fails(self):
+        self.assertFalse(guard.utility_glyph_plate([SELECTOR], "background-color: rgba(58,132,202,.5);", "#ffffff"))
+
+    def test_low_contrast_plate_fails(self):
+        self.assertFalse(guard.utility_glyph_plate([SELECTOR], "background-color: #aaaaaa;", "#ffffff"))
+
+    def test_label_and_icon_mixed_selector_list_fails(self):
+        self.assertFalse(guard.utility_glyph_plate([SELECTOR, SELECTOR.replace("quick-toggle-icon", "quick-toggle-label")], BLUE, "#ffffff"))
+
+    def test_ordinary_paper_text_remains_forbidden(self):
+        self.assertFalse(guard.utility_glyph_plate([".luma-surface-light .label"], BLUE, "#ffffff"))
+        self.assertFalse(guard.plate_carries_ink(BLUE, "#ffffff"))
+
+    def test_descendant_label_of_icon_is_not_an_icon(self):
+        self.assertFalse(guard.utility_glyph_plate([SELECTOR + " .label"], BLUE, "#ffffff"))
+
+    def test_unchecked_icon_retains_body_gate(self):
+        self.assertFalse(guard.utility_glyph_plate([SELECTOR.replace(":checked", "")], BLUE, "#ffffff"))
+
+if __name__ == "__main__":
+    unittest.main()
