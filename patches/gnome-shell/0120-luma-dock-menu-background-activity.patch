+
         this.addMenuItem(new PopupMenu.PopupSeparatorMenuItem());
 
         this._toggleFavoriteItem = this.addAction('', () => {
@@ -138,6 +237,81 @@ export class AppMenu extends PopupMenu.PopupMenu {
         this._updateGpuItem();
     }
 
+    _backgroundAppId() {
+        const id = this._app?.get_id() ?? '';
+        return id.endsWith('.desktop') ? id.slice(0, -'.desktop'.length) : '';
+    }
+
+    _updateBackgroundItem() {
+        const agent = this._backgroundAgent;
+        const show = agent !== null;
+        this._backgroundItem.visible = show;
+        this._backgroundSeparator.visible = show;
+        if (show)
+            this._backgroundItem.update(agent);
+    }
+
+    async _queryBackground() {
+        const appId = this._backgroundAppId();
+        const request = ++this._backgroundRequest;
+        if (!appId) {
+            this._backgroundAgent = null;
+            this._updateBackgroundItem();
+            return;
+        }
+        this._watchBackground();
+        let agent = null;
+        try {
+            const reply = await Gio.DBus.session.call(
+                BACKGROUND_BUS_NAME, BACKGROUND_OBJECT_PATH, BACKGROUND_INTERFACE,
+                'GetAgent', new GLib.Variant('(s)', [appId]),
+                new GLib.VariantType('(a{sv})'),
+                Gio.DBusCallFlags.NO_AUTO_START, 2000, null);
+            agent = reply.recursiveUnpack()[0];
+        } catch (error) {
+            // No agent for this app, or no background service: no row.
+            agent = null;
+        }
+        if (request !== this._backgroundRequest || appId !== this._backgroundAppId())
+            return;
+        this._backgroundAgent = agent;
+        this._updateBackgroundItem();
+    }
+
+    _watchBackground() {
+        if (this._backgroundSignalId)
+            return;
+        this._backgroundSignalId = Gio.DBus.session.signal_subscribe(
+            BACKGROUND_BUS_NAME, BACKGROUND_INTERFACE, 'AgentChanged',
+            BACKGROUND_OBJECT_PATH, null, Gio.DBusSignalFlags.NONE,
+            (connection, sender, path, iface, signal, parameters) => {
+                const [appId, agent] = parameters.recursiveUnpack();
+                if (appId !== this._backgroundAppId())
+                    return;
+                this._backgroundAgent = agent;
+                this._updateBackgroundItem();
+            });
+    }
+
+    async _setBackgroundAllowed(allowed) {
+        const appId = this._backgroundAppId();
+        if (!appId)
+            return;
+        this._backgroundItem.reactive = false;
+        try {
+            await Gio.DBus.session.call(
+                BACKGROUND_BUS_NAME, BACKGROUND_OBJECT_PATH, BACKGROUND_INTERFACE,
+                'SetAllowed', new GLib.Variant('(sb)', [appId, allowed]),
+                null, Gio.DBusCallFlags.NONE, 10000, null);
+        } catch (error) {
+            logError(error, `Could not change background activity for ${appId}`);
+        } finally {
+            this._backgroundItem.reactive = true;
+            // The service's answer is the truth, whether or not the call worked.
+            await this._queryBackground();
+        }
+    }
+
     _updateQuitItem() {
         this._quitItem.visible = Boolean(this._app) &&
             this._sessionApplications.isRunning(this._app);
