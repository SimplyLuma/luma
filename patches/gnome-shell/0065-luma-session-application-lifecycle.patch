+++ b/js/ui/sessionApplications.js
@@ -0,0 +1,190 @@
+import Gio from 'gi://Gio';
+import GObject from 'gi://GObject';
+import Shell from 'gi://Shell';
+
+import {loadInterfaceXML} from '../misc/fileUtils.js';
+import * as Mpris from './mpris.js';
+
+const DBusIface = loadInterfaceXML('org.freedesktop.DBus');
+const DBusProxy = Gio.DBusProxy.makeProxyWrapper(DBusIface);
+const MPRIS_PREFIX = 'org.mpris.MediaPlayer2.';
+
+function appId(app) {
+    return app?.get_id() ?? null;
+}
+
+export function mergePids(...groups) {
+    return [...new Set(groups.flat().filter(pid => Number.isInteger(pid) && pid > 0))]
+        .sort((a, b) => a - b);
+}
+
+export const SessionApplicationTracker = GObject.registerClass({
+    Signals: {
+        'changed': {param_types: [GObject.TYPE_STRING]},
+    },
+}, class SessionApplicationTracker extends GObject.Object {
+    _init() {
+        super._init();
+
+        this._appSystem = Shell.AppSystem.get_default();
+        this._registrations = new Map();
+        this._mpris = Mpris.getDefaultSource();
+        this._mpris.connectObject(
+            'player-added', (_source, player) => this._addMprisPlayer(player),
+            'player-removed', (_source, player) => this._removeMprisPlayer(player),
+            this);
+        for (const player of this._mpris.players)
+            this._addMprisPlayer(player);
+
+        this._proxy = new DBusProxy(Gio.DBus.session,
+            'org.freedesktop.DBus', '/org/freedesktop/DBus',
+            this._onProxyReady.bind(this));
+    }
+
+    isRegistered(app) {
+        const id = appId(app);
+        return id !== null && [...this._registrations.values()]
+            .some(registration => appId(registration.app) === id);
+    }
+
+    isRunning(app) {
+        return Boolean(app) &&
+            (app.state !== Shell.AppState.STOPPED || this.isRegistered(app));
+    }
+
+    getRunning() {
+        const apps = new Map(this._appSystem.get_running()
+            .map(app => [appId(app), app]));
+        for (const {app} of this._registrations.values())
+            apps.set(appId(app), app);
+        apps.delete(null);
+        return [...apps.values()];
+    }
+
+    getPids(app) {
+        const id = appId(app);
+        const registered = [...this._registrations.values()]
+            .filter(registration => appId(registration.app) === id)
+            .map(registration => registration.pid);
+        return mergePids(app?.get_pids() ?? [], registered);
+    }
+
+    async requestQuit(app) {
+        if (!this.isRunning(app))
+            return false;
+
+        if (app.state !== Shell.AppState.STOPPED)
+            return Boolean(app.request_quit());
+
+        if (!this.isRegistered(app))
+            return false;
+
+        try {
+            await app.activate_action('quit', null, 0, -1, null);
+            return true;
+        } catch (error) {
+            logError(error, `Failed to request quit for ${appId(app)}`);
+            return false;
+        }
+    }
+
+    async _onProxyReady(_proxy, error) {
+        if (error) {
+            logError(error, 'Failed to connect session application tracker');
+            return;
+        }
+
+        // Subscribe before taking the snapshot so ownership changes cannot be
+        // lost between ListNames and signal hookup.
+        this._proxy.connectSignal('NameOwnerChanged',
+            this._onNameOwnerChanged.bind(this));
+        try {
+            const [names] = await this._proxy.ListNamesAsync();
+            await Promise.all(names.map(name => this._addBusName(name)));
+        } catch (listError) {
+            logError(listError, 'Failed to list session application names');
+        }
+    }
+
+    _appForBusName(name) {
+        if (name.startsWith(':') || name.startsWith(MPRIS_PREFIX))
+            return null;
+        const app = this._appSystem.lookup_app(`${name}.desktop`);
+        if (!app?.app_info?.get_boolean?.('DBusActivatable'))
+            return null;
+        return app;
+    }
+
+    async _addBusName(name, knownOwner = null) {
+        const app = this._appForBusName(name);
+        if (!app)
+            return;
+        try {
+            const owner = knownOwner ?? (await this._proxy.GetNameOwnerAsync(name))[0];
+            this._setRegistration(`dbus:${name}`, app, owner);
+        } catch (error) {
+            // The owner can disappear after ListNames; NameOwnerChanged has
+            // already been subscribed and supplies the authoritative state.
+            if (knownOwner)
+                logError(error, `Failed to inspect D-Bus app ${name}`);
+        }
+    }
+
+    _onNameOwnerChanged(_proxy, _sender, [name, _oldOwner, newOwner]) {
+        const key = `dbus:${name}`;
+        if (!newOwner) {
+            this._removeRegistration(key);
+            return;
+        }
+        this._addBusName(name, newOwner);
+    }
+
+    _addMprisPlayer(player) {
+        if (!player.app || !player.busName || !player.nameOwner)
+            return;
+        this._setRegistration(`mpris:${player.busName}`,
+            player.app, player.nameOwner);
+    }
+
+    _removeMprisPlayer(player) {
+        if (player.busName)
+            this._removeRegistration(`mpris:${player.busName}`);
+    }
+
+    _setRegistration(key, app, owner) {
+        const old = this._registrations.get(key);
+        if (old?.owner === owner && old.app === app)
+            return;
+        if (old)
+            this.emit('changed', appId(old.app));
+        this._registrations.set(key, {app, owner, pid: 0});
+        this.emit('changed', appId(app));
+        this._resolvePid(key, owner);
+    }
+
+    async _resolvePid(key, owner) {
+        try {
+            const [pid] = await this._proxy.GetConnectionUnixProcessIDAsync(owner);
+            const registration = this._registrations.get(key);
+            if (!registration || registration.owner !== owner)
+                return;
+            registration.pid = pid;
+            this.emit('changed', appId(registration.app));
+        } catch (error) {
+            // A disappearing owner is handled by NameOwnerChanged/MPRIS.
+        }
+    }
+
+    _removeRegistration(key) {
+        const registration = this._registrations.get(key);
+        if (!registration)
+            return;
+        this._registrations.delete(key);
+        this.emit('changed', appId(registration.app));
+    }
+});
+
+let defaultTracker;
+export function getDefault() {
+    return defaultTracker ??= new SessionApplicationTracker();
+}
