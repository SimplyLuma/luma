diff --git a/js/ui/lumaWorkspaceOverview.js b/js/ui/lumaWorkspaceOverview.js
new file mode 100644
index 0000000..5b418c8
--- /dev/null
+++ b/js/ui/lumaWorkspaceOverview.js
@@ -0,0 +1,1047 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Luma's workspace overview (Super+A, Super+Tab): every desktop as a card in
+// Grid's visual language on a plain surface. Mutter owns the workspaces, their
+// windows and switching; this only draws them and asks Mutter to switch.
+import Atk from 'gi://Atk';
+import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import Meta from 'gi://Meta';
+import Pango from 'gi://Pango';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import {adjustAnimationTime} from '../misc/animationUtils.js';
+import * as Background from './background.js';
+import * as Main from './main.js';
+import * as SwipeTracker from './swipeTracker.js';
+import {GRID_LABEL, gridCardHeight} from './gridLayout.js';
+import {RoundedPreview} from './lumaGrid.js';
+
+let activeOverview = null;
+
+// Space between desktops. Wider than Grid's 42px: a desktop card is a whole
+// screen in miniature and reads as cramped at a window card's spacing.
+export const WORKSPACE_GAP = 64;
+// Breathing room outside the row, on both sides, as in Grid.
+export const WORKSPACE_EDGE = 56;
+// Up to this many desktops always fit side by side without scrolling.
+export const WORKSPACE_FIT = 3;
+// A card is never shorter than this; past it a long row scrolls instead.
+export const WORKSPACE_MIN_HEIGHT = 150;
+// How much of the next card shows at the edge of a row that scrolls.
+export const WORKSPACE_PEEK = 0.4;
+// Corner radius of a resting card, in logical pixels.
+export const WORKSPACE_RADIUS = 14;
+// Selection ring: its width and its gap from the card, in logical pixels.
+const RING_WIDTH = 2;
+const RING_GAP = 4;
+
+// Grid's curve and durations, so both surfaces move alike. Reduced motion
+// makes every transition a single frame.
+const ENTER_DURATION = 320;
+const LEAVE_DURATION = 260;
+const TRAVEL_MODE = Clutter.AnimationMode.EASE_OUT_QUART;
+const FLING_DECAY = 325;
+const REVEAL_DURATION = 240;
+const DISMISS_TRAVEL = 64;
+
+const PREVIEW_TYPES = [
+    Meta.WindowType.NORMAL,
+    Meta.WindowType.DIALOG,
+    Meta.WindowType.MODAL_DIALOG,
+    Meta.WindowType.UTILITY,
+];
+
+const HOLD_MODIFIERS = Clutter.ModifierType.SUPER_MASK | Clutter.ModifierType.MOD4_MASK |
+    Clutter.ModifierType.META_MASK | Clutter.ModifierType.HYPER_MASK |
+    Clutter.ModifierType.MOD1_MASK | Clutter.ModifierType.CONTROL_MASK;
+
+const lerp = (from, to, progress) => from + (to - from) * progress;
+const duration = msecs => Math.max(1, adjustAnimationTime(msecs));
+
+// Geometry for a row of `count` desktops of one aspect ratio, in logical
+// pixels, inside a viewport of width x height. Cards are Grid's card height
+// for the display, which fits one or two desktops side by side, shrunk only
+// as far as needed to fit up to WORKSPACE_FIT across. With more desktops than
+// that the row scrolls, and the next card peeks in at the edge so there is
+// visibly more. Pure, so the oracle can check it directly.
+export function workspaceLayout(count, aspect, width, height) {
+    if (!(width > 0 && height > 0 && aspect > 0))
+        throw new RangeError('Workspace overview requires a positive viewport and aspect');
+    const shown = Math.min(Math.max(1, count), WORKSPACE_FIT);
+    const peek = count > WORKSPACE_FIT ? WORKSPACE_PEEK : 0;
+    const gaps = shown - 1 + (peek ? 1 : 0);
+    const fitAcross = (width - gaps * WORKSPACE_GAP) / ((shown + peek) * aspect);
+    let cardHeight = Math.max(WORKSPACE_MIN_HEIGHT,
+        Math.min(gridCardHeight(width, height), fitAcross));
+    cardHeight = Math.max(1, Math.min(cardHeight, height - GRID_LABEL, width / aspect));
+    const cardWidth = cardHeight * aspect;
+    const rowWidth = count * cardWidth + Math.max(0, count - 1) * WORKSPACE_GAP;
+    const blockHeight = GRID_LABEL + cardHeight;
+    const labelY = Math.max(0, (height - blockHeight) / 2);
+    let x = (width - rowWidth) / 2;
+    const items = [];
+    for (let index = 0; index < count; index++) {
+        items.push({index, x, y: labelY + GRID_LABEL, width: cardWidth, height: cardHeight, labelY});
+        x += cardWidth + WORKSPACE_GAP;
+    }
+    return {items, cardWidth, cardHeight, rowWidth, overflow: rowWidth > width + 0.5};
+}
+
+export function isOpen() {
+    return activeOverview !== null;
+}
+
+export function toggle() {
+    if (activeOverview && !activeOverview.leaving)
+        activeOverview.dismiss();
+    else
+        show();
+}
+
+export function show(backward = false, modifierMask = 0) {
+    if (activeOverview?.leaving)
+        activeOverview.destroy();
+    if (activeOverview) {
+        activeOverview.step(backward ? 'Left' : 'Right');
+        return;
+    }
+    if (!Main.sessionMode.hasOverview || !Main.sessionMode.hasWorkspaces || Main.sessionMode.isLocked)
+        return;
+    if (Main.overview.visible)
+        Main.overview.hide();
+    activeOverview = new WorkspaceOverview(modifierMask);
+    activeOverview.open();
+}
+
+const ManualLayout = GObject.registerClass(
+class ManualLayout extends Clutter.LayoutManager {
+    vfunc_get_preferred_width() {
+        return [0, 0];
+    }
+
+    vfunc_get_preferred_height() {
+        return [0, 0];
+    }
+
+    vfunc_allocate() {
+    }
+});
+
+function allocate(actor, x, y, width, height) {
+    const box = new Clutter.ActorBox();
+    const x1 = Math.round(x);
+    const y1 = Math.round(y);
+    box.set_origin(x1, y1);
+    box.set_size(Math.max(0, Math.round(x + width) - x1), Math.max(0, Math.round(y + height) - y1));
+    actor.allocate(box);
+}
+
+function uiScale() {
+    return St.ThemeContext.get_for_stage(global.stage).scale_factor;
+}
+
+// Window actors that make up a desktop on one display, bottom to top.
+function desktopWindows(workspace, monitor) {
+    return global.get_window_actors().filter(actor => {
+        const window = actor.meta_window;
+        if (!window || window.minimized || window.is_override_redirect() ||
+            !PREVIEW_TYPES.includes(window.get_window_type()) ||
+            !window.located_on_workspace(workspace))
+            return false;
+        const rect = window.get_frame_rect();
+        return rect.x < monitor.x + monitor.width && rect.x + rect.width > monitor.x &&
+            rect.y < monitor.y + monitor.height && rect.y + rect.height > monitor.y;
+    });
+}
+
+// Windows a person would count as "on" a desktop.
+function countedWindows(workspace) {
+    return workspace.list_windows().filter(window =>
+        window.get_window_type() === Meta.WindowType.NORMAL && !window.skip_taskbar &&
+        !window.is_on_all_workspaces()).length;
+}
+
+const WorkspaceCard = GObject.registerClass(
+class WorkspaceCard extends St.Widget {
+    _init(workspace, overview) {
+        super._init({reactive: true, can_focus: true, track_hover: true,
+            accessible_role: Atk.Role.PUSH_BUTTON});
+        this.workspace = workspace;
+        this._overview = overview;
+        this._selected = false;
+        this._shapeRadius = null;
+        this._monitorRect = null;
+
+        this._ring = new St.Widget({style_class: 'luma-workspace-card-ring', opacity: 0});
+        this._frame = new St.Widget({style_class: 'luma-workspace-card-frame'});
+        // The desktop at the primary display's own size, scaled onto the card
+        // as a whole: its wallpaper and live window clones render at full
+        // resolution and RoundedPreview averages them down, as Grid draws a
+        // window. The same RoundedPreview also corrects a texture cached at
+        // another display's scale.
+        this._body = new Clutter.Actor({clip_to_allocation: true});
+        this._wallpaper = new Meta.BackgroundGroup();
+        this._body.add_child(this._wallpaper);
+        this._windows = new Clutter.Actor();
+        this._body.add_child(this._windows);
+        this._rounded = new RoundedPreview();
+        this._body.add_effect(this._rounded);
+
+        this._header = new St.BoxLayout({style_class: 'luma-workspace-card-header',
+            clip_to_allocation: true});
+        this._title = new St.Label({style_class: 'luma-workspace-card-title',
+            x_expand: true, y_align: Clutter.ActorAlign.CENTER});
+        this._title.clutter_text.ellipsize = Pango.EllipsizeMode.END;
+        this._meta = new St.Label({style_class: 'luma-workspace-card-meta',
+            y_align: Clutter.ActorAlign.CENTER});
+        this._header.add_child(this._title);
+        this._header.add_child(this._meta);
+
+        this.add_child(this._ring);
+        this.add_child(this._frame);
+        this.add_child(this._body);
+        this.add_child(this._header);
+
+        const click = new Clutter.ClickGesture();
+        click.connect('recognize', () => overview.activate(this));
+        this.add_action(click);
+        this.connect('notify::hover', () => this._syncSelection());
+        this.connect('key-focus-in', () => overview.selectCard(this));
+
+        workspace.connectObject(
+            'window-added', () => this.queueRebuild(),
+            'window-removed', () => this.queueRebuild(), this);
+        this.connect('destroy', () => {
+            this._destroyed = true;
+            this._wallpaperManager?.destroy();
+            this._wallpaperManager = null;
+            if (this._rebuildLater)
+                global.compositor.get_laters().remove(this._rebuildLater);
+            this._rebuildLater = 0;
+        });
+        this.rebuild();
+    }
+
+    get index() {
+        return this.workspace.index();
+    }
+
+    // Build the desktop for the current primary display.
+    rebuild() {
+        const monitor = Main.layoutManager.primaryMonitor;
+        if (!monitor || this._destroyed)
+            return;
+        const monitorIndex = Main.layoutManager.primaryIndex;
+        if (this._wallpaperMonitor !== monitorIndex || !this._wallpaperManager) {
+            this._wallpaperManager?.destroy();
+            this._wallpaperManager = new Background.BackgroundManager({
+                container: this._wallpaper, monitorIndex, controlPosition: false});
+            this._wallpaperMonitor = monitorIndex;
+        }
+        this._monitorRect = {x: monitor.x, y: monitor.y, width: monitor.width, height: monitor.height};
+        this._windows.destroy_all_children();
+        for (const actor of desktopWindows(this.workspace, monitor)) {
+            const clone = new Clutter.Clone({source: actor});
+            clone.set_position(actor.x - monitor.x, actor.y - monitor.y);
+            this._windows.add_child(clone);
+            actor.meta_window.connectObject('notify::minimized', () => this.queueRebuild(),
+                'position-changed', () => this.queueRebuild(),
+                'size-changed', () => this.queueRebuild(), clone);
+        }
+        this.syncLabels();
+        this.queue_relayout();
+    }
+
+    queueRebuild() {
+        // Leaving has already chosen what is drawn; switching restacks and
+        // refocuses windows, and rebuilding then would re-render mid-zoom.
+        if (this._rebuildLater || this._destroyed || this._overview.leaving)
+            return;
+        this._rebuildLater = global.compositor.get_laters().add(Meta.LaterType.BEFORE_REDRAW, () => {
+            this._rebuildLater = 0;
+            this.rebuild();
+            return GLib.SOURCE_REMOVE;
+        });
+    }
+
+    get windowCount() {
+        return this._windows.get_n_children();
+    }
+
+    syncLabels() {
+        const manager = global.workspace_manager;
+        const index = this.index;
+        if (index < 0)
+            return;
+        const count = countedWindows(this.workspace);
+        const trailing = Meta.prefs_get_dynamic_workspaces() &&
+            index === manager.n_workspaces - 1 && count === 0 && index > 0;
+        const current = manager.get_active_workspace() === this.workspace;
+        const named = this._overview.workspaceName(index);
+        this._title.text = named ?? (trailing ? _('New Desktop') : _('Desktop %d').format(index + 1));
+        let meta;
+        if (current)
+            meta = _('Current');
+        else if (trailing)
+            meta = '';
+        else if (count === 0)
+            meta = _('Empty');
+        else
+            meta = count === 1 ? _('1 window') : _('%d windows').format(count);
+        this._meta.text = meta;
+        if (current)
+            this._meta.add_style_class_name('current');
+        else
+            this._meta.remove_style_class_name('current');
+        this.accessible_name = meta ? `${this._title.text}, ${meta}` : this._title.text;
+    }
+
+    setSelected(selected) {
+        this._selected = selected;
+        this._syncSelection();
+    }
+
+    _syncSelection() {
+        const travelling = this._overview.travelling || this._overview.leaving;
