+    // One tap on an output's chip: the sound goes there.
+    setDefaultOutput(name) {
+        const control = getMixerControl();
+        const stream = control.get_sinks().find(sink => sink.get_name() === name);
+        if (stream)
+            control.set_default_sink(stream);
+        // Drawn at once; the service's next OutputsChanged confirms it.
+        for (const output of this.outputs)
+            output.default = output.name === name;
+        this.emit('changed');
+    }
