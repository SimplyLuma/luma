From: Project Luma <builds@project-luma.local>
Subject: [PATCH] luma: a password typed on waking is never held behind a message

Locking starts password and fingerprint verification together. When the
fingerprint check timed out with the display asleep, its error message was
presented with a wiggle, and animations do not advance while the display is
off. The verifier waited on that animation without a bound, its message queue
never drained, and answerQuery waits for the queue before sending anything to
PAM: the password typed on waking sat behind it, the spinner turned, and only
Escape -- which throws the queue away -- let a second attempt through.

Presenting a message and sending an answer now wait a bounded time, and a
hidden prompt does not wiggle at all.

--- a/js/gdm/util.js
+++ b/js/gdm/util.js
@@ -47,6 +47,25 @@
 const USER_READ_TIME = 48;
 const USER_READ_TIME_MIN = 2000;
 
+//: Longest the verifier waits for the prompt to finish presenting a message,
+//: and longest an answer waits behind the message queue. Presenting a message
+//: can be an animation, and animations do not advance while the display is
+//: asleep: a fingerprint timeout that arrived with the screen off left its
+//: wiggle unfinished, the queue never drained, and the password typed on
+//: waking waited behind it forever.
+const SHOW_MESSAGE_TIMEOUT = 1000;
+const ANSWER_MESSAGE_QUEUE_TIMEOUT = 2000;
+
+function bounded(promise, milliseconds, name) {
+    return Promise.race([
+        promise,
+        new Promise(resolve => {
+            const id = GLib.timeout_add_once(GLib.PRIORITY_DEFAULT, milliseconds, resolve);
+            GLib.Source.set_name_by_id(id, `[gnome-shell] ${name}`);
+        }),
+    ]);
+}
+
 const FINGERPRINT_SERVICE_PROXY_TIMEOUT = 5000;
 const FINGERPRINT_ERROR_TIMEOUT_WAIT = 15;
 
@@ -239,8 +258,11 @@
 
     async answerQuery(serviceName, answer) {
         try {
-            await this._handlePendingMessages();
-            this._userVerifier.call_answer_query(serviceName, answer, this._cancellable, null);
+            // An answer never waits on the screen: it goes to PAM once the
+            // queue drains, or after a bounded wait if it cannot.
+            await bounded(this._handlePendingMessages(), ANSWER_MESSAGE_QUEUE_TIMEOUT,
+                'answerQuery message queue');
+            this._userVerifier?.call_answer_query(serviceName, answer, this._cancellable, null);
         } catch (e) {
             logErrorUnlessCancelled(e);
         }
@@ -285,7 +307,7 @@
 
         this.emit('show-message', message.serviceName, message.text, message.type, this._showMessageResolver);
 
-        await promise.catch(logError);
+        await bounded(promise.catch(logError), SHOW_MESSAGE_TIMEOUT, 'show-message');
         if (!this._showMessageResolver)
             return;
         this._showMessageResolver = null;
--- a/js/gdm/authPrompt.js
+++ b/js/gdm/authPrompt.js
@@ -499,8 +499,11 @@
         this.setMessage(message, type);
         this.emit('prompted');
 
+        // Nobody sees a wiggle on a hidden prompt or a sleeping display, and
+        // a wiggle that cannot run must not hold the message queue.
         const shouldWiggle = type === GdmUtil.MessageType.ERROR &&
-            this._userVerifier.serviceIsFingerprint(serviceName);
+            this._userVerifier.serviceIsFingerprint(serviceName) &&
+            this._message.mapped;
 
         const wigglePromise = shouldWiggle
             ? wiggle(this._message, {duration: 65, wiggleCount: 3})
