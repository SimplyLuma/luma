diff --git a/js/ui/lumaPopoverPlacement.js b/js/ui/lumaPopoverPlacement.js
new file mode 100644
index 0000000..deb2080
--- /dev/null
+++ b/js/ui/lumaPopoverPlacement.js
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Where a Shelf popover opens: beside the item that opened it, on the side
+// facing away from the Shelf, centred on that item and kept wholly on the
+// item's monitor. Pure, so it can be tested without a Shell. All values are in
+// stage pixels.
+
+// Which side of its monitor the Shelf is on, from how much of each edge it
+// reserves. No reservation (a hidden Shelf) reads as the bottom, Luma's
+// default edge.
+export function shelfEdge(reserve) {
+    const edges = ['bottom', 'top', 'left', 'right'];
+    let best = 'bottom';
+    for (const edge of edges) {
+        if ((reserve?.[edge] ?? 0) > (reserve?.[best] ?? 0))
+            best = edge;
+    }
+    return best;
+}
+
+const clamp = (value, low, high) => Math.max(low, Math.min(value, Math.max(low, high)));
+
+// anchor: {x, y, width, height} of the item; monitor: {x, y, width, height};
+// reserve: the Shelf's {top, bottom, left, right}; size: {width, height} of
+// the popover; gap: from the item's island to the popover; lift: from the
+// item to its island's edge; inset: the closest the popover may come to a
+// monitor edge. Returns {x, y, maxHeight}; height is clamped by the caller.
+export function placePopover({anchor, monitor, reserve, size, gap, lift = 0, inset}) {
+    const edge = shelfEdge(reserve);
+    const left = monitor.x + inset;
+    const right = monitor.x + monitor.width - inset;
+    const top = monitor.y + inset;
+    const bottom = monitor.y + monitor.height - inset;
+    const centreX = anchor.x + anchor.width / 2;
+    const centreY = anchor.y + anchor.height / 2;
+
+    if (edge === 'bottom' || edge === 'top') {
+        const x = clamp(Math.round(centreX - size.width / 2), left, right - size.width);
+        if (edge === 'bottom') {
+            const limit = anchor.y - lift - gap;
+            const maxHeight = Math.max(0, limit - top);
+            const height = Math.min(size.height, maxHeight);
+            return {x, y: Math.round(limit - height), maxHeight};
+        }
+        const start = anchor.y + anchor.height + lift + gap;
+        return {x, y: Math.round(start), maxHeight: Math.max(0, bottom - start)};
+    }
+
+    const maxHeight = Math.max(0, bottom - top);
+    const height = Math.min(size.height, maxHeight);
+    const y = clamp(Math.round(centreY - height / 2), top, bottom - height);
+    const x = edge === 'left'
+        ? anchor.x + anchor.width + lift + gap
+        : anchor.x - lift - gap - size.width;
+    return {x: Math.round(clamp(x, left, right - size.width)), y, maxHeight};
+}
