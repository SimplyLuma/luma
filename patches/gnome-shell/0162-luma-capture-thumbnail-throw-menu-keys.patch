 // ── Floating thumbnail ─────────────────────────────────────────────────────
 
+// Throwing the thumbnail toward the screen's right edge puts it away, as a
+// flick does on a phone. A throw is a drag that ends moving right, fast and
+// mostly level, far enough from where it started, and that no app took; any
+// other drag that ends over nothing springs back. Distances are logical
+// pixels, speeds logical pixels per millisecond.
+export const FLING_MIN_DISTANCE = 40;
+export const FLING_MIN_SPEED = 0.6;
+const FLING_MAX_SLOPE = 0.8;
+// The throw's speed is its fastest stretch of at least FLING_SPAN_US in the
+// last FLING_WINDOW_US of movement: the thumbnail sits near the right edge,
+// so a real throw is short and the pointer stops at the edge.
+const FLING_SPAN_US = 24000;
+const FLING_WINDOW_US = 150000;
+// How long the pointer may rest before the release and still be throwing: a
+// pointer thrown at the edge stops there, so it may rest longer.
+const FLING_REST_US = 100000;
+const FLING_EDGE_REST_US = 250000;
+const FLING_SAMPLE_MS = 8;
+const FLING_SAMPLES = 64;
+
+// samples: [{t (µs), x, y}] in stage pixels, oldest first; start: {x, y}
+// where the drag was pressed. Returns the verdict and what it saw.
+export function flingVerdict(samples, start, {scale = 1, rightEdge = Infinity, endTime = null} = {}) {
+    if (!start || samples.length < 2)
+        return {fling: false, reason: 'too few samples'};
+    const last = samples.at(-1);
+    const dx = (last.x - start.x) / scale;
+    const dy = (last.y - start.y) / scale;
+    // The last sample at which the pointer was still moving.
+    let moved = samples.length - 1;
+    while (moved > 0 && Math.abs(samples[moved].x - samples[moved - 1].x) < 0.5 &&
+        Math.abs(samples[moved].y - samples[moved - 1].y) < 0.5)
+        moved--;
+    let speed = 0;
+    for (let i = moved; i > 0 && samples[moved].t - samples[i].t <= FLING_WINDOW_US; i--) {
+        let j = i - 1;
+        while (j > 0 && samples[i].t - samples[j].t < FLING_SPAN_US)
+            j--;
+        const dt = (samples[i].t - samples[j].t) / 1000;
+        if (dt > 0)
+            speed = Math.max(speed, (samples[i].x - samples[j].x) / scale / dt);
+    }
+    const atEdge = last.x >= rightEdge - 2;
+    const rest = (endTime ?? last.t) - samples[moved].t;
+    const verdict = {
+        dx: Math.round(dx),
+        dy: Math.round(dy),
+        speed: Math.round(speed * 100) / 100,
+        restMs: Math.round(rest / 1000),
+        atEdge,
+    };
+    let reason = null;
+    if (dx < FLING_MIN_DISTANCE)
+        reason = 'short';
+    else if (Math.abs(dy) > dx * FLING_MAX_SLOPE)
+        reason = 'not level';
+    else if (speed < FLING_MIN_SPEED)
+        reason = 'slow';
+    else if (rest > (atEdge ? FLING_EDGE_REST_US : FLING_REST_US))
+        reason = 'stopped';
+    return {fling: reason === null, reason, ...verdict};
+}
+
+const trashAsync = file => new Promise((resolve, reject) =>
+    file.trash_async(GLib.PRIORITY_DEFAULT, null, (f, res) => {
+        try {
+            resolve(f.trash_finish(res));
+        } catch (e) {
+            reject(e);
+        }
+    }));
+
+// The newest item in the trash that was `path`, through GVfs's trash:///
+// (its trash::orig-path), put back where it was. Without GVfs, the home
+// trash as the freedesktop.org Trash specification lays it out.
+export async function restoreFromTrash(path) {
+    const target = Gio.File.new_for_path(path);
+    if (Gio.Vfs.get_default().get_supported_uri_schemes().includes('trash')) {
+        try {
+            const trash = Gio.File.new_for_uri('trash:///');
+            const children = await new Promise((resolve, reject) =>
+                trash.enumerate_children_async('standard::name,trash::orig-path,trash::deletion-date',
+                    Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS, GLib.PRIORITY_DEFAULT, null, (f, res) => {
+                        try {
+                            resolve(f.enumerate_children_finish(res));
+                        } catch (e) {
+                            reject(e);
+                        }
+                    }));
+            let best = null;
+            for (let info = children.next_file(null); info; info = children.next_file(null)) {
+                if (info.get_attribute_byte_string('trash::orig-path') !== path)
+                    continue;
+                const date = info.get_deletion_date()?.to_unix() ?? 0;
+                if (!best || date >= best.date)
+                    best = {file: children.get_child(info), date};
+            }
+            children.close(null);
+            if (best) {
+                best.file.move(target, Gio.FileCopyFlags.NONE, null, null);
+                return 'trash:///';
+            }
+        } catch (e) {
+            logError(e, 'Luma Capture: trash:/// restore');
+        }
+    }
+    const home = GLib.build_filenamev([GLib.get_user_data_dir(), 'Trash']);
+    const infoDir = Gio.File.new_for_path(GLib.build_filenamev([home, 'info']));
+    if (!infoDir.query_exists(null))
+        return null;
+    let best = null;
+    const children = infoDir.enumerate_children('standard::name', Gio.FileQueryInfoFlags.NONE, null);
+    for (let info = children.next_file(null); info; info = children.next_file(null)) {
+        const name = info.get_name();
+        if (!name.endsWith('.trashinfo'))
+            continue;
+        const keyFile = new GLib.KeyFile();
+        try {
+            keyFile.load_from_file(GLib.build_filenamev([infoDir.get_path(), name]), GLib.KeyFileFlags.NONE);
+            const where = GLib.uri_unescape_string(keyFile.get_string('Trash Info', 'Path'), null);
+            const date = keyFile.get_string('Trash Info', 'DeletionDate');
+            if (where === path && (!best || date >= best.date))
+                best = {name: name.slice(0, -'.trashinfo'.length), date};
+        } catch {
+            continue;
+        }
+    }
+    children.close(null);
+    if (!best)
+        return null;
+    Gio.File.new_for_path(GLib.build_filenamev([home, 'files', best.name]))
+        .move(target, Gio.FileCopyFlags.NONE, null, null);
+    infoDir.get_child(`${best.name}.trashinfo`).delete(null);
+    return 'trash info';
+}
