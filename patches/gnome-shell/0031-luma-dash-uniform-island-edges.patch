From: Project Luma
Subject: [PATCH] Dash: equal material bounds and physical edge corners

--- a/js/ui/shelf.js
+++ b/js/ui/shelf.js
@@ -73,6 +73,25 @@
     return {x, y, width, height, vertical, available, reserve: protrude && span};
 }
 
+// Corner order is CSS top-left, top-right, bottom-right, bottom-left.
+// Square the union of physical edges touched by this material. Island order
+// is supplied in physical coordinates, so RTL cannot reverse screen contact.
+export function dashCornerRadii(edge, protrude, touchesStart, touchesEnd) {
+    const radius = [15, 15, 15, 15];
+    const square = side => {
+        const corners = {top: [0, 1], right: [1, 2], bottom: [2, 3], left: [3, 0]};
+        corners[side].forEach(index => radius[index] = 0);
+    };
+    if (protrude)
+        square(edge);
+    const vertical = edge === 'left' || edge === 'right';
+    if (touchesStart)
+        square(vertical ? 'top' : 'left');
+    if (touchesEnd)
+        square(vertical ? 'bottom' : 'right');
+    return radius;
+}
