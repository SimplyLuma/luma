+    const start = angle(1, 0, (x1 - cx1) / rx, (y1 - cy1) / ry);
+    let delta = angle((x1 - cx1) / rx, (y1 - cy1) / ry, (-x1 - cx1) / rx, (-y1 - cy1) / ry);
+    if (!sweep && delta > 0)
+        delta -= 2 * Math.PI;
+    else if (sweep && delta < 0)
+        delta += 2 * Math.PI;
+
+    cr.save();
+    cr.translate(cx, cy);
+    cr.rotate(phi);
+    cr.scale(rx, ry);
+    if (sweep)
+        cr.arc(0, 0, 1, start, start + delta);
+    else
+        cr.arcNegative(0, 0, 1, start, start + delta);
+    cr.restore();
+}
