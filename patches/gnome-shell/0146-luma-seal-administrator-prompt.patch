+            control = [ox + a[0], oy + a[1]];
+            x = ox + a[2];
+            y = oy + a[3];
+            break;
+        }
+        case 'A': {
+            const endX = ox + a[5];
+            const endY = oy + a[6];
+            arcTo(cr, x, y, a[0], a[1], a[2], a[3] !== 0, a[4] !== 0, endX, endY);
+            x = endX;
+            y = endY;
+            break;
+        }
+        case 'Z':
+            cr.closePath();
+            x = startX;
+            y = startY;
+            break;
+        default:
+            throw new Error(`unsupported path command ${command}`);
+        }
+        lastControl = control;
+    }
+}
+
+function roundedRect(cr, x, y, w, h, r) {
+    cr.newSubPath();
