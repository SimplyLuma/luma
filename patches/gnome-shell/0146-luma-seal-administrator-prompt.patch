@@ -0,0 +1,237 @@
+/* Luma Seal: the administrator prompt (components/polkitAgent.js).
+ *
+ * A centred, symmetrical card over a blurred scrim. Surface, ink and line
+ * are Quick Options' tokens in every appearance mode; the material classes
+ * (luma-surface-light, -dark, -frost, -glass) come from lumaSurfaceMaterials.js.
+ *
+ *            fill                     ink      muted                   line                     control                 active
+ * light      #f1f2f3                  #30343a  #767b81                 rgba(35,39,45,.09)       rgba(35,44,52,.072)     #31373e
+ * dark       #21252b                  #e9ebec  #969da4                 rgba(255,255,255,.075)   rgba(255,255,255,.072)  #e6e9eb
+ * frost      rgba(244,245,246,.80)    #30343a  #767b81                 rgba(35,39,45,.09)       rgba(35,44,52,.072)     #31373e
+ * glass      rgba(22,29,40,.38)       #ffffff  rgba(255,255,255,.70)   rgba(255,255,255,.15)    rgba(10,20,33,.20)      #ffffff
+ *
+ * Its own colours are the error red #d4595c and the success green #3b9a6b. */
+
+/* ── Scrim and card ──────────────────────────────────────────────────────── */
+.luma-seal-scrim { background-color: rgba(8, 10, 14, 0.46); }
+
+.luma-seal-shadow {
+  border-radius: 24px;
+  background-color: rgba(0, 0, 0, 0.01);
+  box-shadow: 0 5px 16px rgba(0, 0, 0, 0.28); }
+
+.luma-seal-card {
+  font-family: 'Figtree', system-ui, sans-serif;
+  padding: 27px 23px 17px;
+  border-radius: 24px;
+  border: 1px solid rgba(35, 39, 45, 0.09);
+  background-color: #f1f2f3;
+  color: #30343a;
+  box-shadow: 0 40px 90px -24px rgba(0, 0, 0, 0.6); }
+.luma-seal-card.luma-surface-dark { background-color: #21252b; color: #e9ebec; border-color: rgba(255, 255, 255, 0.075); }
+.luma-seal-card.luma-surface-frost { background-color: rgba(244, 245, 246, 0.80); }
+.luma-seal-card.luma-surface-glass { background-color: rgba(22, 29, 40, 0.38); color: #ffffff; border-color: rgba(255, 255, 255, 0.15); }
+
+/* ── Who is asking ───────────────────────────────────────────────────────── */
+.luma-seal-who { width: 60px; height: 60px; }
+.luma-seal-app-icon { icon-shadow: 0 8px 18px -6px rgba(12, 17, 24, 0.45); }
+
+/* A 26 circle in ink, ringed 3 in the card's fill so it reads as cut out. */
+.luma-seal-badge {
+  width: 26px;
+  height: 26px;
+  border-radius: 16px;
+  border: 3px solid #f1f2f3;
+  background-color: #30343a;
+  color: #f1f2f3; }
+.luma-seal-badge-glyph { width: 13px; height: 13px; }
+.luma-surface-dark .luma-seal-badge { border-color: #21252b; background-color: #e9ebec; color: #21252b; }
+.luma-surface-frost .luma-seal-badge { border-color: #f4f5f6; }
+.luma-surface-glass .luma-seal-badge { border-color: #2a313c; background-color: #ffffff; color: #2a313c; }
+
+/* The system itself is asking: a neutral lock, never an app placeholder. */
+.luma-seal-system {
+  width: 54px;
+  height: 54px;
+  border-radius: 28px;
+  border: 1px solid rgba(35, 39, 45, 0.09);
+  background-color: rgba(35, 44, 52, 0.072);
+  color: #30343a; }
+.luma-seal-system-glyph { width: 24px; height: 24px; }
+.luma-surface-dark .luma-seal-system { border-color: rgba(255, 255, 255, 0.075); background-color: rgba(255, 255, 255, 0.072); color: #e9ebec; }
+.luma-surface-glass .luma-seal-system { border-color: rgba(255, 255, 255, 0.15); background-color: rgba(10, 20, 33, 0.20); color: #ffffff; }
+
+/* ── Words ───────────────────────────────────────────────────────────────── */
+.luma-seal-title {
+  margin-top: 16px;
+  font-size: 17px;
+  font-weight: 750;
+  letter-spacing: -0.31px;
+  text-align: center;
+  color: #30343a; }
+.luma-seal-body {
+  margin-top: 7px;
+  padding: 0 4px;
+  font-size: 13.5px;
+  text-align: center;
+  color: #767b81; }
+.luma-surface-dark .luma-seal-title { color: #e9ebec; }
+.luma-surface-dark .luma-seal-body { color: #969da4; }
+.luma-surface-glass .luma-seal-title { color: #ffffff; }
+.luma-surface-glass .luma-seal-body { color: rgba(255, 255, 255, 0.70); }
+
+/* ── Field ───────────────────────────────────────────────────────────────── */
+.luma-seal-field {
+  margin-top: 20px;
+  height: 44px;
+  border-radius: 12px;
+  background-color: rgba(35, 44, 52, 0.072);
+  box-shadow: inset 0 0 0 1px rgba(35, 39, 45, 0.09);
+  transition-duration: 140ms; }
+.luma-seal-field:focus { box-shadow: inset 0 0 0 1.5px #31373e; }
+.luma-seal-field:error { box-shadow: inset 0 0 0 1.5px #d4595c; }
+.luma-surface-dark .luma-seal-field { background-color: rgba(255, 255, 255, 0.072); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.075); }
+.luma-surface-dark .luma-seal-field:focus { box-shadow: inset 0 0 0 1.5px #e6e9eb; }
+.luma-surface-glass .luma-seal-field { background-color: rgba(10, 20, 33, 0.20); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15); }
+.luma-surface-glass .luma-seal-field:focus { box-shadow: inset 0 0 0 1.5px #ffffff; }
+.luma-surface-dark .luma-seal-field:error, .luma-surface-glass .luma-seal-field:error { box-shadow: inset 0 0 0 1.5px #d4595c; }
+
+.luma-seal-entry,
+.luma-seal-entry:focus,
+.luma-seal-entry:hover,
+.luma-seal-entry:insensitive {
+  min-height: 0;
+  height: 44px;
+  padding: 0 6px 0 12px;
+  border: none !important;
+  border-radius: 12px;
+  background-color: transparent !important;
+  box-shadow: none !important;
+  font-size: 14px;
+  font-weight: 600;
+  letter-spacing: 0.84px;
+  color: #30343a;
+  caret-color: #30343a;
+  selection-background-color: rgba(48, 52, 58, 0.22);
+  selected-color: #30343a; }
+.luma-seal-entry StLabel.hint-text {
+  margin-left: 0;
+  font-weight: 500;
+  letter-spacing: 0;
+  color: #767b81; }
+.luma-seal-field:insensitive .luma-seal-entry { color: rgba(48, 52, 58, 0.5); }
+.luma-surface-dark .luma-seal-entry { color: #e9ebec; caret-color: #e9ebec; selection-background-color: rgba(233, 235, 236, 0.22); selected-color: #e9ebec; }
+.luma-surface-dark .luma-seal-entry StLabel.hint-text { color: #969da4; }
+.luma-surface-dark .luma-seal-field:insensitive .luma-seal-entry { color: rgba(233, 235, 236, 0.5); }
+.luma-surface-glass .luma-seal-entry { color: #ffffff; caret-color: #ffffff; selection-background-color: rgba(255, 255, 255, 0.25); selected-color: #ffffff; }
+.luma-surface-glass .luma-seal-entry StLabel.hint-text { color: rgba(255, 255, 255, 0.70); }
+
+.luma-seal-icon-button {
+  width: 32px;
+  height: 32px;
+  margin-right: 4px;
+  border-radius: 8px;
+  color: #767b81;
+  transition-duration: 140ms; }
+.luma-seal-icon-button .luma-seal-glyph { width: 17px; height: 17px; }
+.luma-seal-icon-button:hover { background-color: rgba(35, 44, 52, 0.072); color: #30343a; }
+.luma-seal-icon-button:focus { box-shadow: inset 0 0 0 2px rgba(48, 52, 58, 0.75) !important; }
+.luma-surface-dark .luma-seal-icon-button { color: #969da4; }
+.luma-surface-dark .luma-seal-icon-button:hover { background-color: rgba(255, 255, 255, 0.072); color: #e9ebec; }
+.luma-surface-glass .luma-seal-icon-button { color: rgba(255, 255, 255, 0.70); }
+.luma-surface-glass .luma-seal-icon-button:hover { background-color: rgba(10, 20, 33, 0.20); color: #ffffff; }
+.luma-surface-dark .luma-seal-icon-button:focus,
+.luma-surface-glass .luma-seal-icon-button:focus { box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.75) !important; }
+
+.luma-seal-divider { width: 1px; height: 20px; margin: 0 2px; background-color: rgba(35, 39, 45, 0.09); }
+.luma-surface-dark .luma-seal-divider { background-color: rgba(255, 255, 255, 0.075); }
+.luma-surface-glass .luma-seal-divider { background-color: rgba(255, 255, 255, 0.15); }
+
+/* The reader is listening: the print breathes in the active ink. */
+.luma-seal-finger, .luma-seal-finger:hover { color: #31373e; }
+.luma-surface-dark .luma-seal-finger, .luma-surface-dark .luma-seal-finger:hover { color: #e6e9eb; }
+.luma-surface-glass .luma-seal-finger, .luma-surface-glass .luma-seal-finger:hover { color: #ffffff; }
+.luma-seal-finger.luma-seal-finger-matched { color: #3b9a6b !important; }
+.luma-seal-finger.luma-seal-finger-miss,
+.luma-seal-finger.luma-seal-finger-exhausted { color: #d4595c !important; }
+
+/* ── Status ──────────────────────────────────────────────────────────────── */
+.luma-seal-status {
+  margin-top: 9px;
+  min-height: 18px;
+  spacing: 6px;
+  font-size: 12.5px;
+  color: #767b81; }
+.luma-seal-status-label { text-align: center; }
+.luma-seal-status-glyph { width: 13px; height: 13px; }
+.luma-surface-dark .luma-seal-status { color: #969da4; }
+.luma-surface-glass .luma-seal-status { color: rgba(255, 255, 255, 0.70); }
+.luma-seal-status.luma-seal-status-error { color: #d4595c; }
+.luma-seal-status.luma-seal-status-success { color: #3b9a6b; }
+
+/* ── Buttons ─────────────────────────────────────────────────────────────── */
+.luma-seal-actions { margin-top: 16px; spacing: 10px; }
+.luma-seal-button {
+  height: 42px;
+  border-radius: 12px;
+  font-size: 13.5px;
+  font-weight: 700;
+  transition-duration: 140ms; }
+.luma-seal-cancel { background-color: rgba(35, 44, 52, 0.072); color: #30343a; }
+.luma-seal-cancel:hover { background-color: rgba(35, 44, 52, 0.115); }
+.luma-seal-cancel:focus { box-shadow: inset 0 0 0 2px rgba(48, 52, 58, 0.75) !important; }
+.luma-seal-allow { background-color: #30343a; color: #f1f2f3; }
+.luma-seal-allow:hover { background-color: #3d4249; }
+.luma-seal-allow:focus { box-shadow: inset 0 0 0 2px rgba(241, 242, 243, 0.8) !important; }
+.luma-seal-allow:insensitive { background-color: rgba(48, 52, 58, 0.40); color: #f1f2f3; }
+.luma-seal-cancel:insensitive { color: rgba(48, 52, 58, 0.45); }
+
+.luma-surface-dark .luma-seal-cancel { background-color: rgba(255, 255, 255, 0.072); color: #e9ebec; }
+.luma-surface-dark .luma-seal-cancel:hover { background-color: rgba(255, 255, 255, 0.12); }
+.luma-surface-dark .luma-seal-cancel:focus { box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.75) !important; }
+.luma-surface-dark .luma-seal-cancel:insensitive { color: rgba(233, 235, 236, 0.45); }
+.luma-surface-dark .luma-seal-allow { background-color: #e9ebec; color: #21252b; }
+.luma-surface-dark .luma-seal-allow:hover { background-color: #ffffff; }
+.luma-surface-dark .luma-seal-allow:focus { box-shadow: inset 0 0 0 2px rgba(33, 37, 43, 0.8) !important; }
+.luma-surface-dark .luma-seal-allow:insensitive { background-color: rgba(233, 235, 236, 0.40); color: #21252b; }
+
+.luma-surface-glass .luma-seal-cancel { background-color: rgba(10, 20, 33, 0.20); color: #ffffff; }
+.luma-surface-glass .luma-seal-cancel:hover { background-color: rgba(10, 20, 33, 0.30); }
+.luma-surface-glass .luma-seal-cancel:focus { box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.75) !important; }
+.luma-surface-glass .luma-seal-allow { background-color: #ffffff; color: #1b2230; }
+.luma-surface-glass .luma-seal-allow:focus { box-shadow: inset 0 0 0 2px rgba(27, 34, 48, 0.8) !important; }
+.luma-surface-glass .luma-seal-allow:insensitive { background-color: rgba(255, 255, 255, 0.40); color: #1b2230; }
+
+/* ── Details ─────────────────────────────────────────────────────────────── */
+.luma-seal-details-toggle {
+  margin-top: 14px;
+  padding: 2px 6px;
+  border-radius: 6px;
+  color: #767b81; }
+.luma-seal-details-toggle:hover { color: #30343a; }
+.luma-seal-details-toggle:focus { box-shadow: inset 0 0 0 2px rgba(48, 52, 58, 0.75) !important; }
+.luma-seal-details-box { spacing: 5px; }
+.luma-seal-details-label { font-size: 12.5px; font-weight: 650; }
