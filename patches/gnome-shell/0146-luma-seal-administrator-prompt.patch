+    let i = 0;
+    let command = null;
+    while (i < tokens.length) {
+        if (/[a-zA-Z]/.test(tokens[i]))
+            command = tokens[i++];
+        if (!command)
+            throw new Error(`path data starts without a command: ${data}`);
+        const count = ARGS[command.toUpperCase()];
+        if (count === undefined)
+            throw new Error(`unsupported path command ${command}`);
+        const args = tokens.slice(i, i + count).map(Number);
+        if (args.length < count)
