+    submit(text) {
+        if (this._settled || !text || this.checking)
+            return false;
+
+        const asking = this._sessions.find(s => s.phase === Phase.ASKING);
+        if (asking) {
+            this._respond(asking, text);
+            return true;
+        }
+
+        this._pending = text;
+        this._emit('checking', {});
+        // A session that has not said anything yet may still turn out to ask
+        // for the password itself; only sessions holding the reader need a
+        // second conversation beside them.
+        if (!this._sessions.some(s => s.phase === Phase.STARTING))
+            this._spawn('password beside the reader');
+        return true;
+    }
+
+    cancel() {
+        this._pending = null;
+        this._settled = true;
+        this._dropAll();
+    }
+
+    _emit(name, data) {
+        try {
+            this._onEvent(name, data);
+        } catch (e) {
+            logError(e, `Luma Seal: handling ${name}`);
+        }
+    }
+
+    _spawn(reason) {
+        let session;
+        try {
+            session = this._createSession();
+        } catch (e) {
+            this._log(`could not create a polkit session (${reason}): ${e.message}`);
+            this._settleFailed('session');
+            return;
+        }
+        const entry = {id: this._nextId++, session, phase: Phase.STARTING, signals: [], lastFingerprint: null, misses: 0};
+        entry.signals = [
+            session.connect('request', (_s, prompt, echoOn) => this._onRequest(entry, prompt, echoOn)),
+            session.connect('show-info', (_s, text) => this._onInfo(entry, text)),
+            session.connect('show-error', (_s, text) => this._onError(entry, text)),
+            session.connect('completed', (_s, gained) => this._onCompleted(entry, gained)),
+        ];
+        this._sessions.push(entry);
+        this._log(`session ${entry.id} started: ${reason}`);
+        session.initiate();
+    }
+
+    _drop(entry) {
+        const index = this._sessions.indexOf(entry);
+        if (index >= 0)
+            this._sessions.splice(index, 1);
+        // Disconnect before cancelling: cancel() itself emits completed, and
+        // nothing a dropped session says may reach the prompt.
+        for (const id of entry.signals)
+            entry.session.disconnect(id);
+        entry.signals = [];
+        if (entry.phase !== 'done') {
+            entry.phase = 'done';
+            try {
+                entry.session.cancel();
+            } catch (e) {
+                this._log(`cancelling session ${entry.id}: ${e.message}`);
+            }
+        }
+    }
+
+    _dropAll() {
+        for (const entry of [...this._sessions])
+            this._drop(entry);
+    }
+
+    _respond(entry, text) {
+        entry.phase = Phase.CHECKING;
+        this._pending = null;
+        this._log(`session ${entry.id}: password handed over`);
+        this._emit('checking', {});
+        entry.session.response(text);
+    }
+
+    _onRequest(entry, prompt, echoOn) {
+        if (this._settled)
+            return;
+        this._log(`session ${entry.id} asks (${echoOn ? 'visible' : 'secret'}): ${JSON.stringify(prompt)}`);
+
+        const wasListening = entry.phase === Phase.LISTENING;
+        entry.phase = Phase.ASKING;
+
+        if (wasListening) {
+            // pam_fprintd returned and pam_unix asks this session instead:
+            // the reader stopped listening for this conversation.
+            if (entry.lastFingerprint === 'timeout' && this._rearms < MAX_REARMS) {
+                // A fresh conversation claims the reader again (below, once
+                // this one has taken any pending password).
+                this._rearms++;
+                this._fingerprint = 'unknown';
+            } else if (entry.lastFingerprint === 'timeout') {
+                this._fingerprint = 'stopped';
+                this._emit('fingerprint-stopped', {});
+            } else if (entry.misses > 0) {
+                this._fingerprint = 'exhausted';
+                this._emit('fingerprint-exhausted', {});
+            } else {
+                this._fingerprint = 'unavailable';
+                this._emit('fingerprint-unavailable', {});
+            }
+        }
+
+        // Only one session waits for a password at a time.
+        const other = this._sessions.find(s => s !== entry &&
+            (s.phase === Phase.ASKING || s.phase === Phase.CHECKING));
+        if (other) {
+            this._log(`session ${entry.id} is not needed: session ${other.id} already takes the password`);
+            this._drop(entry);
+            return;
+        }
+
+        if (this._pending !== null)
+            this._respond(entry, this._pending);
+
+        if (wasListening && this._fingerprint === 'unknown' &&
+            !this._sessions.some(s => s.phase === Phase.LISTENING || s.phase === Phase.STARTING))
+            this._spawn('reader again after a timeout');
+    }
+
+    _onInfo(entry, text) {
+        if (this._settled)
+            return;
+        if (entry.phase === Phase.STARTING || entry.phase === Phase.LISTENING) {
+            if (TIMED_OUT.has(text)) {
+                entry.lastFingerprint = 'timeout';
+                this._log(`session ${entry.id}: reader timed out`);
+                return;
+            }
+            // Before pam_unix, the only module in the stack that talks is
+            // pam_fprintd, and it only does once it holds the reader.
+            entry.phase = Phase.LISTENING;
+            entry.lastFingerprint = 'listening';
+            this._fingerprint = 'listening';
+            this._log(`session ${entry.id} listens: ${JSON.stringify(text)}`);
+            this._emit('fingerprint-listening', {text});
+
+            if (this._pending !== null &&
+                !this._sessions.some(s => s !== entry &&
+                    [Phase.STARTING, Phase.ASKING, Phase.CHECKING].includes(s.phase)))
+                this._spawn('password beside the reader');
+            return;
+        }
+        this._log(`session ${entry.id} info: ${JSON.stringify(text)}`);
+        this._emit('message', {kind: 'info', text});
+    }
+
+    _onError(entry, text) {
+        if (this._settled)
+            return;
+        if (entry.phase === Phase.LISTENING) {
+            if (NO_MATCH.has(text)) {
+                entry.misses++;
+                entry.lastFingerprint = 'miss';
+                this._log(`session ${entry.id}: fingerprint not recognized (${entry.misses})`);
+                this._emit('fingerprint-miss', {misses: entry.misses});
+            } else if (UNKNOWN_ERROR.has(text)) {
+                entry.lastFingerprint = 'error';
+                this._log(`session ${entry.id}: reader error ${JSON.stringify(text)}`);
+            } else {
+                entry.lastFingerprint = 'retry';
+                this._log(`session ${entry.id}: reader asks to retry ${JSON.stringify(text)}`);
+                this._emit('fingerprint-retry', {text});
+            }
+            return;
+        }
+        this._log(`session ${entry.id} error: ${JSON.stringify(text)}`);
+        if (entry.phase === Phase.CHECKING)
+            this._lastRejection = text;
+        this._emit('message', {kind: 'error', text});
+    }
+
+    _onCompleted(entry, gained) {
+        if (this._settled)
+            return;
+        const phase = entry.phase;
+        this._log(`session ${entry.id} completed in ${phase}: ${gained ? 'authorized' : 'not authorized'}`);
+
+        if (gained) {
+            this._settled = true;
+            this._pending = null;
+            entry.phase = 'done';
+            const method = phase === Phase.LISTENING ? 'fingerprint' : 'password';
+            // Success first; nothing the other sessions still have queued is
+            // allowed to reach the prompt.
+            this._drop(entry);
+            this._dropAll();
+            this._fingerprint = method === 'fingerprint' ? 'matched' : this._fingerprint;
+            this._emit('success', {method});
+            return;
+        }
+
+        entry.phase = 'done';
+        this._drop(entry);
+
+        if (phase === Phase.CHECKING) {
+            const text = this._lastRejection;
+            this._lastRejection = null;
+            this._emit('password-rejected', {text});
+        } else if (phase === Phase.LISTENING && this._pending === null) {
+            this._fingerprint = 'unavailable';
+            this._emit('fingerprint-unavailable', {});
+        }
+
+        // A rejected password is an ordinary answer; a conversation that
+        // ended any other way is restarted, but never in a tight loop.
+        if (phase !== Phase.CHECKING && !this._mayRestart()) {
+            this._settleFailed('restarts');
+            return;
+        }
+        // Keep one conversation that can take the password.
+        if (!this._sessions.some(s => s.phase === Phase.STARTING || s.phase === Phase.ASKING))
+            this._spawn(phase === Phase.CHECKING ? 'after a rejected password' : `after a session ended in ${phase}`);
+    }
+
+    _mayRestart() {
+        const now = this._now();
+        this._restarts = this._restarts.filter(t => now - t < RESTART_WINDOW_MS);
+        this._restarts.push(now);
+        return this._restarts.length <= MAX_RESTARTS;
+    }
+
+    _settleFailed(reason) {
+        this._log(`giving up: ${reason}`);
+        this._settled = true;
+        this._pending = null;
+        this._dropAll();
+        this._emit('failed', {reason});
+    }
+}
diff --git a/js/ui/lumaSealCopy.js b/js/ui/lumaSealCopy.js
new file mode 100644
index 0000000..a3b3eec
--- /dev/null
+++ b/js/ui/lumaSealCopy.js
@@ -0,0 +1,359 @@
+// Luma Seal: what the administrator prompt says, and who it says is asking.
+//
+// The title and body are written by Luma, never passed through from polkit.
+// polkitd gives an agent only the action id, the mechanism's message (already
+// translated, with its $(details) filled in) and the pids of the subject and
+// the caller; it deliberately withholds the mechanism's other details. So a
+// template only says what can be read from those: the action, the message the
+// mechanism itself wrote, the kernel's view of the requesting process and
+// the system's own view of a device. Nothing the requesting app sends can
+// choose the words or the icon. Anything not in the table falls back to
+// "App wants administrator access" with polkit's message as the body.
+
+import Gettext from 'gettext';
+import GLib from 'gi://GLib';
+
+const _ = s => Gettext.dgettext('gnome-shell', s);
+
+// Fills %s placeholders in one pass, so a name containing %s stays as it is.
+function fmt(template, ...args) {
+    let i = 0;
+    return template.replace(/%s/g, () => String(args[i++] ?? ''));
+}
+
+// ── Parsing a mechanism's message ──────────────────────────────────────────
+
+function escapeRegExp(text) {
+    return text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+}
+
+/**
+ * A matcher for a mechanism's message template, in English and in the
+ * mechanism's translation (polkitd translates with the agent's locale, which
+ * is the Shell's).
+ *
+ * @param {string} domain the mechanism's gettext domain
+ * @param {string} template with $(name) placeholders
+ * @returns {(message: string) => object|null}
+ */
+export function messageMatcher(domain, template) {
+    const variants = new Set([template]);
+    try {
+        const translated = Gettext.dgettext(domain, template);
+        if (translated)
+            variants.add(translated);
+    } catch {}
+
+    const patterns = [...variants].map(variant => {
+        const names = [];
+        const source = escapeRegExp(variant).replace(/\\\$\\\(([a-z_.]+)\\\)/g, (_m, name) => {
+            names.push(name);
+            return '([\\s\\S]*)';
+        });
+        return {regexp: new RegExp(`^${source}$`), names};
+    });
+
+    return message => {
+        for (const {regexp, names} of patterns) {
+            const match = regexp.exec(message ?? '');
+            if (!match)
+                continue;
+            const values = {};
+            names.forEach((name, i) => (values[name] = match[i + 1]));
+            return values;
+        }
+        return null;
+    };
+}
+
+const UDISKS_WRITE = messageMatcher('udisks2', 'Authentication is required to open $(drive) for writing');
+const UDISKS_READ = messageMatcher('udisks2', 'Authentication is required to open $(drive) for reading');
+const PKEXEC_ROOT = messageMatcher('polkit-1', 'Authentication is needed to run `$(cmdline_short)\' as the super user');
+
+// udisks writes $(drive) as "Vendor Model (/dev/sdX)".
+export function splitDrive(drive) {
+    const match = /^(.*) \((\/dev\/[^()\s]+)\)$/.exec(drive ?? '');
+    if (!match)
+        return {name: drive?.trim() || null, device: null};
+    return {name: match[1].trim() || null, device: match[2]};
+}
+
+// ── Sizes ──────────────────────────────────────────────────────────────────
+
+export function formatSize(bytes) {
+    if (!Number.isFinite(bytes) || bytes <= 0)
+        return null;
+    const units = [[1e12, 'TB'], [1e9, 'GB'], [1e6, 'MB']];
+    for (const [factor, unit] of units) {
+        if (bytes < factor)
+            continue;
+        const value = bytes / factor;
+        const shown = value >= 10 ? Math.round(value) : Math.round(value * 10) / 10;
+        return `${shown} ${unit}`;
+    }
+    return null;
+}
+
+function readText(path) {
+    try {
+        const [ok, bytes] = GLib.file_get_contents(path);
+        return ok ? new TextDecoder().decode(bytes) : null;
+    } catch {
+        return null;
+    }
+}
+
+/**
+ * The kernel's view of a block device: its size, and whether it is a
+ * partition rather than a whole drive.
+ *
+ * @param {string} device a /dev path
+ * @param {string} sysfs root of /sys/class/block
+ */
+export function blockDevice(device, sysfs = '/sys/class/block') {
+    let path = device;
+    try {
+        // /dev/disk/by-*/… and /dev/mapper/… are links to the kernel name.
+        for (let i = 0; i < 8; i++) {
+            const target = GLib.file_read_link(path);
+            path = GLib.canonicalize_filename(target, GLib.path_get_dirname(path));
+        }
+    } catch {}
+    const name = GLib.path_get_basename(path);
+    if (!/^[A-Za-z0-9_.!-]+$/.test(name))
+        return {size: null, partition: false};
+    const sectors = Number.parseInt(readText(`${sysfs}/${name}/size`) ?? '', 10);
+    return {
+        size: Number.isFinite(sectors) ? sectors * 512 : null,
+        partition: GLib.file_test(`${sysfs}/${name}/partition`, GLib.FileTest.EXISTS),
+    };
+}
+
+// ── Who is asking ──────────────────────────────────────────────────────────
+
+function unescapeUnit(text) {
+    return text.replace(/\\x([0-9a-fA-F]{2})/g, (_m, hex) => String.fromCharCode(parseInt(hex, 16)));
+}
+
+/**
+ * The application id systemd records for a process, from /proc/PID/cgroup:
+ * app-flatpak-ID-N.scope, app-LAUNCHER-ID-N.scope, app-LAUNCHER-ID@X.service,
+ * app-ID@X.service or dbus-:1.N-ID@X.service.
+ *
+ * @param {string} cgroup contents of /proc/PID/cgroup
+ * @returns {{id: string, flatpak: boolean}|null}
+ */
+export function appFromCgroup(cgroup) {
+    const line = (cgroup ?? '').split('\n').find(l => l.startsWith('0::'));
+    if (!line)
+        return null;
+    const unit = line.slice(3).split('/').filter(Boolean).pop() ?? '';
+
+    let match = /^app-flatpak-(.+)-\d+\.scope$/.exec(unit);
+    if (match)
+        return {id: unescapeUnit(match[1]), flatpak: true};
+
+    match = /^dbus-:[0-9.]+-(.+)@[^@]*\.service$/.exec(unit);
+    if (match)
+        return {id: unescapeUnit(match[1]), flatpak: false};
+
+    match = /^app-(.+?)(?:-[0-9a-f]+\.scope|@[^@]*\.service|\.service)$/.exec(unit);
+    if (!match)
+        return null;
+    // Only the launcher is separated by an unescaped dash; dashes inside an
+    // id are escaped as \x2d.
+    const parts = match[1].split('-');
+    const id = parts.length > 1 ? parts.slice(1).join('-') : parts[0];
+    return id ? {id: unescapeUnit(id), flatpak: false} : null;
+}
+
+function flatpakId(pid) {
+    const keyFile = new GLib.KeyFile();
+    try {
+        keyFile.load_from_file(`/proc/${pid}/root/.flatpak-info`, GLib.KeyFileFlags.NONE);
+        return keyFile.get_string('Application', 'name') || null;
+    } catch {
+        return null;
+    }
+}
+
+function parentPid(pid) {
+    const stat = readText(`/proc/${pid}/stat`);
+    // The command name may itself contain spaces and parentheses.
+    const tail = stat?.slice(stat.lastIndexOf(')') + 2).split(' ');
+    const ppid = Number.parseInt(tail?.[1] ?? '', 10);
+    return Number.isFinite(ppid) ? ppid : 0;
+}
+
+export function commandLine(pid) {
+    const raw = readText(`/proc/${pid}/cmdline`);
+    if (!raw)
+        return [];
+    return raw.split('\0').filter((arg, i, all) => arg !== '' || i < all.length - 1);
+}
+
+export function executable(pid) {
+    try {
+        return GLib.file_read_link(`/proc/${pid}/exe`);
+    } catch {
+        const argv0 = commandLine(pid)[0];
+        return argv0 || null;
+    }
+}
+
+/**
+ * Resolve polkit's subject to an app the person recognizes: its Flatpak id,
+ * the application id of its systemd unit, or the app whose window belongs to
+ * it, checked for the subject and then for its parents (a terminal runs each
+ * shell in a scope of its own, so pkexec's parent is found through the
+ * terminal that started it). Returns {app, name, icon, executable, how, id};
+ * app, name and icon are null when nothing matched.
+ *
+ * @param {number} pid polkit.subject-pid
+ * @param {object} shell {appSystem, windowTracker}
+ */
+export function resolveRequester(pid, {appSystem, windowTracker} = {}) {
+    const result = {app: null, name: null, icon: null, executable: null, how: 'unresolved', id: null};
+    if (!Number.isInteger(pid) || pid <= 1)
+        return result;
+    result.executable = executable(pid);
+
+    const lookup = id => (id && appSystem ? appSystem.lookup_app(`${id}.desktop`) ?? null : null);
+
+    let current = pid;
+    for (let depth = 0; depth < 8 && current > 1 && !result.app; depth++) {
+        const where = depth === 0 ? '' : ` of parent ${depth}`;
+        const flatpak = flatpakId(current);
+        const unit = appFromCgroup(readText(`/proc/${current}/cgroup`));
+        const candidates = [
+            [flatpak, `flatpak${where}`],
+            [unit?.id, `${unit?.flatpak ? 'flatpak scope' : 'systemd unit'}${where}`],
+        ];
+        for (const [id, how] of candidates) {
+            const app = lookup(id);
+            if (app) {
+                Object.assign(result, {app, how, id});
+                break;
+            }
+        }
+        if (!result.app && windowTracker) {
+            const app = windowTracker.get_app_from_pid(current);
+            if (app)
+                Object.assign(result, {app, how: `window${where}`, id: app.get_id()});
+        }
+        current = parentPid(current);
+    }
+
+    if (result.app) {
+        result.name = result.app.get_name();
+        result.icon = result.app.get_icon();
+    }
+    return result;
+}
+
+// ── The table ──────────────────────────────────────────────────────────────
+
+function wants(requester, rest) {
+    return requester
+        ? fmt(_('%s wants %s'), requester, rest)
+        : fmt(_('An app wants %s'), rest);
+}
+
+/**
+ * Title, body and Details for a request.
+ *
+ * @param {object} request
+ * @param {string} request.actionId
+ * @param {string} request.message polkit's translated message
+ * @param {string|null} request.appName the resolved requester's name
+ * @param {string|null} request.executable the requester's executable
+ * @param {string|null} request.command full command line for pkexec
+ * @param {Function} request.device (path) => {size, partition}
+ * @returns {{title: string, body: string, facts: string[][], template: string}}
+ */
+export function describe({actionId, message, appName = null, executable: exe = null, command = null,
+    device: deviceInfo = blockDevice}) {
+    const requestedBy = [exe, appName].filter(Boolean).join(' · ') || _('Unknown');
+    const facts = [[_('Action'), actionId]];
+    const finish = (template, title, body, extra = []) => ({
+        template, title, body,
+        facts: [...facts, ...extra, [_('Requested by'), requestedBy]],
+    });
+
+    switch (actionId) {
+    case 'org.freedesktop.udisks2.open-device':
+    case 'org.freedesktop.udisks2.open-device-system': {
+        const writing = UDISKS_WRITE(message);
+        const reading = writing ? null : UDISKS_READ(message);
+        const parsed = writing ?? reading;
+        if (!parsed)
+            break;
+        const {name, device} = splitDrive(parsed.drive);
+        const label = name ?? device;
+        if (!label)
+            break;
+        const {size, partition} = device ? deviceInfo(device) : {size: null, partition: false};
+        const sized = formatSize(size);
+        const what = partition ? _('partition') : _('drive');
+        const deviceFact = [[_('Device'), [device, name].filter(Boolean).join(' · ')]];
+        if (writing) {
+            return finish('udisks-write',
+                wants(appName, fmt(_('to write to “%s”'), label)),
+                (sized
+                    ? fmt(_('Everything on this %s %s will be erased and replaced.'), sized, what)
+                    : fmt(_('Everything on this %s will be erased and replaced.'), what)) +
+                    ' ' + _('Writing to a disk needs an administrator.'),
+                deviceFact);
+        }
+        return finish('udisks-read',
+            wants(appName, fmt(_('to read everything on “%s”'), label)),
+            (sized
+                ? fmt(_('It will be able to read all data on this %s %s.'), sized, what)
+                : fmt(_('It will be able to read all data on this %s.'), what)) +
+                ' ' + _('Reading a disk directly needs an administrator.'),
+            deviceFact);
+    }
+    case 'org.freedesktop.Flatpak.app-install':
+        // polkitd does not pass the ref on to agents, so the app being
+        // installed cannot be named without trusting the requester.
+        return finish('flatpak-app-install',
+            wants(appName, _('to install an app for everyone on this computer')),
+            _('The app and its updates will be available to every account. Installing for everyone needs an administrator.'));
+    case 'org.freedesktop.timedate1.set-time':
+        return finish('timedate-set-time',
+            wants(appName, _('to change the date and time')),
+            _('The clock affects every account, and the certificates apps use to connect securely.'));
+    case 'org.freedesktop.policykit.exec': {
+        const parsed = PKEXEC_ROOT(message);
+        if (!parsed)
+            break;
+        return finish('pkexec-root',
+            wants(appName, _('to run a command as administrator')),
+            _('The command below will have full control of this computer while it runs.'),
+            [[_('Command'), command || parsed.cmdline_short]]);
+    }
+    }
+
+    return finish('fallback',
+        wants(appName, _('administrator access')),
+        message?.trim() || _('This needs an administrator.'));
+}
+
+/**
+ * The command pkexec was asked to run, from pkexec's own argument vector.
+ *
+ * @param {string[]} argv
+ */
+export function pkexecCommand(argv) {
+    if (!argv.length || GLib.path_get_basename(argv[0]) !== 'pkexec')
+        return null;
+    let i = 1;
+    while (i < argv.length && argv[i].startsWith('--')) {
+        if (argv[i] === '--user' || argv[i] === '-u')
+            i++;
+        i++;
+    }
+    const rest = argv.slice(i);
+    return rest.length ? rest.map(arg => (/[\s'"\\]/.test(arg) ? GLib.shell_quote(arg) : arg)).join(' ') : null;
+}
+
diff --git a/js/ui/lumaSealGlyph.js b/js/ui/lumaSealGlyph.js
new file mode 100644
index 0000000..db4b7ca
--- /dev/null
+++ b/js/ui/lumaSealGlyph.js
@@ -0,0 +1,241 @@
+// Luma Seal: stroked glyphs drawn in the widget's own ink.
+//
+// The prompt's glyphs are line drawings with round caps. They are stroked
+// with Cairo in the theme node's foreground colour, so CSS alone decides
+// their colour in every appearance mode and state (listening, matched,
+// missed), at any scale.
+
+import Cairo from 'cairo';
+import GObject from 'gi://GObject';
+import St from 'gi://St';
+
