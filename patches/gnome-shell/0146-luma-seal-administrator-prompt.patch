+// Luma Seal: the administrator prompt.
+//
+// Replaces GNOME's "Authentication Required" dialog. A centred card over a
+// blurred scrim that covers every monitor, shelf included: the requesting
+// app's icon with a lock, what will happen in Luma's words, one field that is
+// visible and focused from the first frame, a status line, two equal buttons
+// and a Details disclosure.
+//
+// A password is always offered. The fingerprint reader listens beside the
+// field when one is enrolled; the conversations that make both work at once
+// are in lumaSealAuth.js. The shell never decides anything: PAM and polkit do.
+
 import AccountsService from 'gi://AccountsService';
+import Atk from 'gi://Atk';
 import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
 import GLib from 'gi://GLib';
 import GObject from 'gi://GObject';
+import Graphene from 'gi://Graphene';
 import Pango from 'gi://Pango';
 import PolkitAgent from 'gi://PolkitAgent';
 import Polkit from 'gi://Polkit';
 import Shell from 'gi://Shell';
 import St from 'gi://St';
 
-import * as Dialog from '../dialog.js';
 import * as Main from '../main.js';
 import * as ModalDialog from '../modalDialog.js';
 import * as ShellEntry from '../shellEntry.js';
-import * as UserWidget from '../userWidget.js';
-import {wiggle} from '../../misc/animationUtils.js';
+import * as SurfaceMaterials from '../lumaSurfaceMaterials.js';
+import {Conversations} from '../lumaSealAuth.js';
+import * as SealCopy from '../lumaSealCopy.js';
+import {Glyph} from '../lumaSealGlyph.js';
+
+const STYLESHEET_URI = 'resource:///org/gnome/shell/theme/luma-seal.css';
+
+const CARD_WIDTH = 356;
+const SCREEN_INSET = 16;
+const APP_ICON_SIZE = 60;
+const OPEN_TIME = 240;
+const SCRIM_TIME = 200;
+const CLOSE_TIME = 180;
+const SUCCESS_HOLD = 420;
+const MISS_RECOVER = 1100;
+const SCRIM_BLUR = 14;
+
+const log = message => console.log(`Luma Seal: ${message}`);
+const reduceMotion = () => !St.Settings.get().enable_animations;
+const stageScale = () => St.ThemeContext.get_for_stage(global.stage).scale_factor;
+
+let stylesheetLoaded = false;
+function loadStylesheet() {
+    if (stylesheetLoaded)
+        return;
+    stylesheetLoaded = true;
+    St.ThemeContext.get_for_stage(global.stage).get_theme()
+        .load_stylesheet(Gio.File.new_for_uri(STYLESHEET_URI));
+}
+
+function blurAllowed() {
+    const source = Gio.SettingsSchemaSource.get_default();
+    const lookup = (id, key) => {
+        const schema = source?.lookup(id, true);
+        return schema?.has_key(key) ? new Gio.Settings({settings_schema: schema}).get_boolean(key) : false;
+    };
+    if (lookup('org.project_luma.shell-state', 'reduce-transparency') ||
+        lookup('org.gnome.desktop.a11y.interface', 'high-contrast'))
+        return false;
+    if (GLib.getenv('LUMA_MUTTER_ALLOW_SOFTWARE_BLUR') === '1')
+        return true;
+    try {
+        return global.backend.is_rendering_hardware_accelerated();
+    } catch {
+        return false;
+    }
+}
