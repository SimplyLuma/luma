+            y = oy + a[1];
+            cr.moveTo(x, y);
+            startX = x;
+            startY = y;
+            break;
+        case 'L':
+            x = ox + a[0];
+            y = oy + a[1];
+            cr.lineTo(x, y);
+            break;
+        case 'H':
+            x = ox + a[0];
+            cr.lineTo(x, y);
+            break;
+        case 'V':
+            y = oy + a[0];
+            cr.lineTo(x, y);
+            break;
+        case 'C':
