@@ -0,0 +1,369 @@
+// Luma Seal: the conversations behind the administrator prompt.
+//
+// A password is always offered; a fingerprint is an addition. The PAM stack
+// Luma ships (authselect with-fingerprint) runs pam_fprintd before pam_unix
+// in one conversation, so a single polkit session asks for nothing but a
+// finger until the reader times out. Seal never changes that stack and never
+// decides anything itself. It runs more than one polkit session for the same
+// request, the way GDM runs a fingerprint conversation beside the password
+// one:
+//
+// - The first session claims the reader and listens (pam_fprintd).
+// - When a password is submitted while that session holds the reader, a
+//   second session starts. Its pam_fprintd cannot claim the reader, which it
+//   treats as "no reader" (PAM_AUTHINFO_UNAVAIL, ignored by `sufficient`), so
+//   pam_unix asks it for the password straight away and the typed text is
+//   handed over. Nobody waits for the reader to time out, and nothing is
+//   retyped.
+// - Whichever session first asks for a secret receives the submitted text,
+//   exactly once. The text is never kept after it has been handed over.
+// - The first session to complete with authorization wins. Every other
+//   session is disconnected before it is cancelled, so a fingerprint message
+//   still on its way (the failure mode fixed for the unlock screen in 0085)
+//   can never hold or undo the success.
+// - Without a reader, or without an enrolled finger, pam_fprintd returns at
+//   once and the first session simply asks for the password.
+//
+// polkitd accepts an authorization only from its own agent helper, only for
+// the cookie of this request and only for an identity it offered, so a second
+// session cannot widen who may authenticate.
+
+import GLib from 'gi://GLib';
+import Gettext from 'gettext';
+
+const FPRINTD_DOMAIN = 'fprintd';
+
+// How many times the reader is armed again after it timed out while the
+// prompt stays open. Misses are never retried here: pam_fprintd's own
+// max-tries is the limit.
+const MAX_REARMS = 4;
+
+// A helper that exits without asking anything is restarted, but never in a
+// tight loop.
+const RESTART_WINDOW_MS = 10000;
+const MAX_RESTARTS = 4;
+
+function translations(message) {
+    const out = new Set([message]);
+    try {
+        const translated = Gettext.dgettext(FPRINTD_DOMAIN, message);
+        if (translated)
+            out.add(translated);
+    } catch {}
+    return out;
+}
+
+const TIMED_OUT = translations('Verification timed out');
+const NO_MATCH = translations('Failed to match fingerprint');
+const UNKNOWN_ERROR = translations('An unknown error occurred');
+
+export const Phase = {
+    STARTING: 'starting',
+    LISTENING: 'listening',
+    ASKING: 'asking',
+    CHECKING: 'checking',
+};
+
+/**
+ * Coordinates polkit sessions for one request.
+ *
+ * `createSession()` returns an object with PolkitAgent.Session's surface:
+ * initiate(), response(text), cancel(), connect(signal, handler) and
+ * disconnect(id), emitting request(prompt, echoOn), show-info(text),
+ * show-error(text) and completed(gainedAuthorization).
+ *
+ * `onEvent(name, data)` receives:
+ *   fingerprint-listening, fingerprint-retry, fingerprint-miss,
+ *   fingerprint-exhausted, fingerprint-stopped, fingerprint-unavailable,
+ *   checking,
+ *   password-rejected ({text}), message ({kind, text}), success ({method}),
+ *   failed ({reason})
+ */
+export class Conversations {
+    constructor({createSession, onEvent, log = () => {}, now = () => GLib.get_monotonic_time() / 1000}) {
+        this._createSession = createSession;
+        this._onEvent = onEvent;
+        this._log = log;
+        this._now = now;
+        this._sessions = [];
+        this._nextId = 1;
+        this._pending = null;
+        this._settled = false;
+        this._rearms = 0;
+        this._restarts = [];
+        this._fingerprint = 'unknown';
+        this._lastRejection = null;
+    }
+
+    get settled() {
+        return this._settled;
+    }
+
+    get checking() {
+        return this._sessions.some(s => s.phase === Phase.CHECKING);
+    }
+
+    get sessionCount() {
+        return this._sessions.length;
+    }
+
+    // What the reader is doing, for the prompt: unknown, listening, matched,
+    // exhausted, stopped or unavailable.
+    get fingerprint() {
+        return this._fingerprint;
+    }
+
+    start() {
+        if (this._settled || this._sessions.length > 0)
+            return;
+        this._spawn('open');
+    }
+
+    /**
+     * Hand a typed secret to PAM. Returns false when it cannot be taken now
+     * (already settled, or a previous attempt is still being checked).
+     *
+     * @param {string} text
