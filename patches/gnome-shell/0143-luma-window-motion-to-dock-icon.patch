diff --git a/js/ui/lumaWindowMotion.js b/js/ui/lumaWindowMotion.js
new file mode 100644
index 0000000..19f1209
--- /dev/null
+++ b/js/ui/lumaWindowMotion.js
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// How a window travels to and from its place in the dock: minimizing draws it
+// into the dock icon, restoring draws it back out, and opening an app from an
+// icon grows the window out of that icon. Closing never travels; it settles
+// away where it is.
+//
+// The motion is a transform of the window actor alone -- scale and
+// translation on one timeline, no offscreen buffer or shader -- so its cost
+// does not grow with the window's size. The path is lumaWindowPath.js.
+
+import Clutter from 'gi://Clutter';
+import GLib from 'gi://GLib';
+import St from 'gi://St';
+
+import {mix, travelFrame} from './lumaWindowPath.js';
+export {edgeOf, travelFrame} from './lumaWindowPath.js';
+
+export const MINIMIZE_TIME = 320;
+export const OPEN_TIME = 280;
+export const CLOSE_TIME = 180;
+// An open with no icon behind it grows from this fraction of its size.
+export const OPEN_SCALE = 0.94;
+export const CLOSE_SCALE = 0.95;
+// How long a launch from an icon stays attached to the next window its app opens.
+export const LAUNCH_WINDOW_MS = 8000;
+
+// -- Launches ----------------------------------------------------------------
+
+const launches = new Map();
+
+// An app was opened from an icon at `rect` (stage pixels): its next window
+// grows out of it.
+export function noteLaunch(app, rect) {
+    if (!app || !rect || rect.width <= 0 || rect.height <= 0)
+        return;
+    launches.set(app, {rect, time: GLib.get_monotonic_time()});
+}
+
+// The icon a newly mapped window of `app` should grow from, once.
+export function takeLaunch(app) {
+    const launch = app ? launches.get(app) : null;
+    if (!launch)
+        return null;
+    launches.delete(app);
+    if ((GLib.get_monotonic_time() - launch.time) / 1000 > LAUNCH_WINDOW_MS)
+        return null;
+    return launch.rect;
+}
+
+export function actorRect(actor) {
+    const [x, y] = actor.get_transformed_position();
+    const [width, height] = actor.get_transformed_size();
+    return {x, y, width, height};
+}
+
+// -- Playing it --------------------------------------------------------------
+
+// Draw `actor` at frame rectangle `frame`, relative to its own allocation.
+function applyFrame(actor, frame) {
+    const width = Math.max(1, actor.width), height = Math.max(1, actor.height);
+    actor.set_pivot_point(0, 0);
+    actor.scale_x = Math.max(0.0001, frame.width / width);
+    actor.scale_y = Math.max(0.0001, frame.height / height);
+    actor.translation_x = frame.x - actor.x;
+    actor.translation_y = frame.y - actor.y;
+    actor.opacity = frame.opacity;
+}
+
+export function resetActor(actor) {
+    actor.set_pivot_point(0, 0);
+    actor.scale_x = 1;
+    actor.scale_y = 1;
+    actor.translation_x = 0;
+    actor.translation_y = 0;
+    actor.opacity = 255;
+}
+
+// Travel between the window (`progress` 0) and the icon (1) from `start` to
+// `end`, over the share of `duration` that distance is. Returns a handle whose
+// progress can be read if the motion is cut short.
+export function travel(actor, {from, to, edge, start, end, duration, onDone}) {
+    const span = Math.abs(end - start);
+    const motion = {progress: start, timeline: null};
+    const finish = () => {
+        motion.timeline = null;
+        onDone?.();
+    };
+    const settings = St.Settings.get();
+    if (!settings.enable_animations || span === 0) {
+        motion.progress = end;
+        finish();
+        return motion;
+    }
+    const timeline = new Clutter.Timeline({
+        actor,
+        // GNOME's slow-down setting applies, as it does to every ease().
+        duration: Math.max(1, Math.round(duration * span * settings.slow_down_factor)),
+        progress_mode: Clutter.AnimationMode.LINEAR,
+    });
+    // The window's own rectangle is read each frame: a window that is still
+    // settling its size as it opens is followed, not drawn at a stale size.
+    const fromRect = typeof from === 'function' ? from : () => from;
+    const step = () => {
+        motion.progress = mix(start, end, timeline.get_progress());
+        applyFrame(actor, travelFrame(motion.progress, fromRect(), to, edge));
+    };
+    step();
+    timeline.connect('new-frame', step);
+    timeline.connect('stopped', (_timeline, finished) => {
+        if (finished)
+            motion.progress = end;
+        finish();
+    });
+    motion.timeline = timeline;
+    timeline.start();
+    return motion;
+}
diff --git a/js/ui/lumaWindowPath.js b/js/ui/lumaWindowPath.js
new file mode 100644
index 0000000..70461e1
--- /dev/null
+++ b/js/ui/lumaWindowPath.js
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// The path a window takes to and from its dock icon, as plain geometry with no
+// Shell objects, so it can be tested on its own (tests/gnome-shell/window-motion.js).
+// The path is shaped like a lamp's light going back into it: along the shelf
+// the window gathers early, toward the shelf it follows later, so it narrows
+// as it leaves and pours into the icon rather than sliding over in a line.
+
+const clamp01 = value => Math.min(1, Math.max(0, value));
+
+export function easeInOutCubic(t) {
+    t = clamp01(t);
+    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
+}
+
+// The progress of the axis along the shelf, which leads, and of the axis
+// toward it, which follows. Both start at 0 and end at 1.
+export function leadingProgress(t) {
+    return easeInOutCubic(clamp01(t / 0.7));
+}
+
+export function followingProgress(t) {
+    return easeInOutCubic(clamp01((t - 0.15) / 0.85));
+}
+
+export const mix = (a, b, t) => a + (b - a) * t;
+
+// One frame of the travel between the window's rectangle (`from`, t = 0) and
+// the icon's (`to`, t = 1), for a shelf on `edge`. Rectangles are
+// {x, y, width, height} in stage pixels. Returns the rectangle to draw the
+// window in and its opacity (0-255).
+export function travelFrame(t, from, to, edge = 'bottom') {
+    t = clamp01(t);
+    const vertical = edge === 'left' || edge === 'right';
+    const lead = leadingProgress(t);
+    const follow = followingProgress(t);
+    // Along the shelf (x for a bottom or top shelf) the window gathers first.
+    const along = vertical ? follow : lead;
+    const across = vertical ? lead : follow;
+    const width = mix(from.width, to.width, along);
+    const height = mix(from.height, to.height, across);
+    const centreX = mix(from.x + from.width / 2, to.x + to.width / 2, along);
+    const centreY = mix(from.y + from.height / 2, to.y + to.height / 2, across);
+    // Nearly opaque until late, then gone into the icon. It is never fully
+    // opaque once it moves: the windows behind are drawn from the first frame,
+    // so a renderer that stalls to draw them does it before the motion is
+    // under way rather than in its last, most visible frames.
+    const opacity = t <= 0 ? 255
+        : Math.round((t < 0.72 ? mix(254, 235, t / 0.72) : 235 * (1 - (t - 0.72) / 0.28)));
+    return {x: centreX - width / 2, y: centreY - height / 2, width, height, opacity};
+}
+
+// The shelf edge a rectangle lies on, from where it sits on its monitor.
+export function edgeOf(icon, monitor) {
+    const distances = {
+        bottom: monitor.y + monitor.height - (icon.y + icon.height),
+        top: icon.y - monitor.y,
+        left: icon.x - monitor.x,
+        right: monitor.x + monitor.width - (icon.x + icon.width),
+    };
+    return Object.keys(distances).reduce((a, b) => distances[b] < distances[a] ? b : a);
+}
