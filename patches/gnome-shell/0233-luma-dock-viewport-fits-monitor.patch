+
+// The app strip gives folders and system controls room on a short edge.
+// More icons remain reachable by scrolling inside the dock island.
+export function dockViewportBudget(contentLength, bandLength, tileLength) {
+    const band = Math.max(1, bandLength);
+    const cap = Math.min(band, Math.max(tileLength, Math.floor(band * 0.7)));
+    return Math.max(0, Math.min(contentLength, cap));
 }
 
