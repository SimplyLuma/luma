index 0000000..26a453d
--- /dev/null
+++ b/js/ui/liveActivity.js
@@ -0,0 +1,230 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// How the live island dresses a Live Extension. Pure, so it can be tested
+// without a Shell.
+//
+// The broker validates a `category` on every publication and the island used
+// to ignore it: whatever carried a `starts_at` was drawn as a calendar entry,
+// month over day in a date tile with a clock time beside it. A call carries a
+// start too -- when it was answered -- so a voice call was drawn as an event
+// dated today. The category now decides the dress, and the calendar dress is
+// only ever given to an event that states a start.
+
+// The dresses the island knows. Anything else is `generic`: the publisher's
+// icon, its title and its subtitle, and no date and no clock, because a date
+// the provider never meant as a date is exactly how a call became a meeting.
+export const Style = Object.freeze({
+    CALL: 'call',
+    EVENT: 'event',
+    GENERIC: 'generic',
+});
+
+// Which publication owns the island when several are live at once. What the
+// person is doing right now outranks what is merely running, which outranks
+// what is coming up: a call beats a recording, a recording beats a timer, and
+// an upcoming meeting only shows when nothing is in progress. Media has its
+// own island; a media Live Extension only fills this one when nothing else is
+// live.
+const PRIORITY = Object.freeze({
+    call: 0,
+    recording: 1,
+    navigation: 2,
+    timer: 3,
+    transfer: 4,
+    installation: 5,
+    media: 6,
+    event: 7,
+    generic: 8,
+});
+const UNKNOWN_PRIORITY = 9;
+
+// The glyph for a category when the publisher has no icon the Shell can find.
+const CATEGORY_ICONS = Object.freeze({
+    call: 'call-start-symbolic',
+    recording: 'media-record-symbolic',
+    navigation: 'mark-location-symbolic',
+    timer: 'alarm-symbolic',
+    transfer: 'folder-download-symbolic',
+    installation: 'system-software-install-symbolic',
+    media: 'audio-x-generic-symbolic',
+    event: 'x-office-calendar-symbolic',
+});
+export const GENERIC_ICON = 'emblem-synchronizing-symbolic';
+
+// Glyphs for the action vocabulary. Providers namespace their actions
+// ("call.mute"), so the last segment is what is looked up. The Shell draws
+// nothing it has no glyph for.
+const ACTION_ICONS = new Map([
+    ['mute', 'audio-input-microphone-symbolic'],
+    ['mute-microphone', 'audio-input-microphone-symbolic'],
+    ['microphone-mute', 'audio-input-microphone-symbolic'],
+    ['unmute', 'microphone-disabled-symbolic'],
+    ['microphone', 'audio-input-microphone-symbolic'],
+    ['mic', 'audio-input-microphone-symbolic'],
+    ['camera', 'camera-web-symbolic'],
