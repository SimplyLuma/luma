+        const request = ++this._loginRequest;
+        if (!desktopId) {
+            this._login = null;
+            this._updateLoginItem();
+            return;
+        }
+        this._watchLogin();
+        let login = null;
+        try {
+            const reply = await Gio.DBus.session.call(
+                BACKGROUND_BUS_NAME, BACKGROUND_OBJECT_PATH, BACKGROUND_INTERFACE,
+                'GetLoginItem', new GLib.Variant('(s)', [desktopId]),
+                new GLib.VariantType('(a{sv})'),
+                Gio.DBusCallFlags.NONE, 3000, null);
+            login = reply.recursiveUnpack()[0];
+        } catch (error) {
+            // No service to ask: no row, rather than a switch that does nothing.
+            login = null;
