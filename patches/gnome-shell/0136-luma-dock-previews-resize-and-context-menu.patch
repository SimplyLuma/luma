+    _updateLoginItem() {
+        const login = this._login;
+        const show = Boolean(login) && (login['available'] || login['enabled']);
+        this._loginItem.visible = show;
+        if (show) {
+            // A portal autostart entry runs as the app's background agent: that
+            // agent's decision is this switch, so its own row is not shown too.
+            const viaAgent = login['controlled-by'] === 'background';
+            this._loginItem.setState(login['enabled'],
+                viaAgent ? _('Starts in the background') : '');
+        }
