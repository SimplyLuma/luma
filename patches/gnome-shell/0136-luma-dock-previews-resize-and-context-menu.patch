+        // The heading needs no rule under it; each later group gets one.
+        let before = false;
+        this._groups.forEach((group, index) => {
+            const visible = shows(group);
+            group.actor.visible = visible;
+            this._groupRules[index].visible = visible && before;
+            before ||= visible;
