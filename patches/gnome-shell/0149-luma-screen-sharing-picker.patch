new file mode 100644
index 0000000..f877726
--- /dev/null
+++ b/js/ui/lumaShare.js
@@ -0,0 +1,1534 @@
+// Luma Share: the screen sharing picker, the sharing edge and the Stop pill.
+//
+// When an application asks the ScreenCast portal to share the screen,
+// luma-portal (the portal backend) asks this module, over
+// org.projectluma.Shell.ScreenShare, to show the picker and hand back what
+// the person chose. The stream itself is still created by the backend through
+// Mutter's ScreenCast API, exactly as xdg-desktop-portal-gnome does it; see
+// ADR-041 for why the picker is drawn here and not in a GTK portal process.
+//
+// Nothing here starts, stops or reads a stream. It shows what could be
+// shared, returns what was chosen, and while sharing draws the violet edge
+// and the pill. The edge and the pill are CaptureHidden actors (lumaCapture),
+// so they paint on the screen and never into a recording or a cast.
+//
+// Previews are the dock's live window previews (patch 0117): a Clutter clone
+// of the window actor already in the scene graph, painted at thumbnail size.
+// A screen preview clones global.window_group — the wallpaper and every
+// window, and no shell chrome, so a preview can never contain the picker.
+
+import Atk from 'gi://Atk';
+import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import Graphene from 'gi://Graphene';
+import Meta from 'gi://Meta';
+import Pango from 'gi://Pango';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import * as Main from './main.js';
+import * as ModalDialog from './modalDialog.js';
+import * as SurfaceMaterials from './lumaSurfaceMaterials.js';
+import {CaptureHidden, ShelfSurface} from './lumaCapture.js';
+import {Glyph} from './lumaSealGlyph.js';
+import {PreviewThumbnail} from './lumaDockWindows.js';
+import {listDisplays} from './lumaCast.js';
+import {placeShelfBar} from './lumaShelfSurface.js';
+
+const STYLESHEET_URI = 'resource:///org/gnome/shell/theme/luma-share.css';
+
+const BUS_NAME = 'org.freedesktop.impl.portal.desktop.luma';
+const OBJECT_PATH = '/org/projectluma/Shell/ScreenShare';
+
+// ── The three interim answers ──────────────────────────────────────────────
+//
+// The owner has not answered the open questions yet (handoff, "Open questions
+// for the owner: screen sharing"). Each interim answer is one constant, so
+// changing it is a one-line change and nothing else moves.
+
+// 1. While screen sharing, the Stop pill is the indicator and the Well's
+//    sharing mark is hidden for that session. Other remote-access kinds keep
+//    their mark. Set to true to keep both.
+export const KEEP_WELL_MARK_WHILE_SHARING = false;
+
+// 2. The pill stays visible for as long as sharing lasts. A positive number
+//    of milliseconds would hide it after that long instead, macOS style.
+export const PILL_VISIBLE_MS = 0;
+
+// 3. No "Choose on screen" mode. Set to true to offer picking a real window
+//    on the desktop.
+export const OFFER_CHOOSE_ON_SCREEN = false;
+
+// ── Measurements ───────────────────────────────────────────────────────────
+
+const CARD_WIDTH = 600;
+const SCREEN_INSET = 16;
+const CARD_MARGIN = 56;
+const APP_ICON_SIZE = 56;
+const REQUESTER_BADGE = 26;
+const BADGE_OVERLAP = 7;
+const SCRIM_BLUR = 14;
+const OPEN_TIME = 240;
+const SCRIM_TIME = 200;
+const CLOSE_TIME = 180;
+
+const WINDOW_COLUMNS = 3;
+const SCREEN_COLUMNS = 2;
+const COLUMN_GAP = 12;
+const ROW_GAP = 14;
+const TILE_ASPECT = 10 / 16;
+// The window sits at 92% of its tile, so its own corners and shadow show.
+const TILE_FILL = 0.92;
+const CAPTION_GAP = 8;
+
+// The portal's own vocabulary.
+const PORTAL_SUCCESS = 0;
+const PORTAL_CANCELLED = 1;
+
+// org.freedesktop.portal.ScreenCast source types and cursor modes.
+const SourceType = {MONITOR: 1, WINDOW: 2, VIRTUAL: 4};
+const CursorMode = {HIDDEN: 1, EMBEDDED: 2, METADATA: 4};
+
+const INTERFACE = `
+<node>
+  <interface name="org.projectluma.Shell.ScreenShare">
+    <method name="Choose">
+      <arg type="a{sv}" name="options" direction="in"/>
+      <arg type="u" name="response" direction="out"/>
+      <arg type="a{sv}" name="results" direction="out"/>
+    </method>
+    <method name="Cancel"/>
+    <method name="SessionStarted">
+      <arg type="s" name="session_handle" direction="in"/>
+      <arg type="a{sv}" name="info" direction="in"/>
+    </method>
+    <method name="SessionClosed">
+      <arg type="s" name="session_handle" direction="in"/>
+    </method>
+    <signal name="StopRequested">
+      <arg type="s" name="session_handle"/>
+    </signal>
+  </interface>
+</node>`;
+
+const log = message => console.log(`Luma Share: ${message}`);
+const reduceMotion = () => !St.Settings.get().enable_animations;
+const stageScale = () => St.ThemeContext.get_for_stage(global.stage).scale_factor;
+
+let stylesheetLoaded = false;
+function loadStylesheet() {
+    if (stylesheetLoaded)
+        return;
+    stylesheetLoaded = true;
+    St.ThemeContext.get_for_stage(global.stage).get_theme()
+        .load_stylesheet(Gio.File.new_for_uri(STYLESHEET_URI));
+}
+
+// The same test the authentication prompt makes: no blur when transparency
+// is reduced, in high contrast, or without hardware acceleration.
+function blurAllowed() {
+    const source = Gio.SettingsSchemaSource.get_default();
+    const lookup = (id, key) => {
+        const schema = source?.lookup(id, true);
+        return schema?.has_key(key) ? new Gio.Settings({settings_schema: schema}).get_boolean(key) : false;
+    };
+    if (lookup('org.project_luma.shell-state', 'reduce-transparency') ||
+        lookup('org.gnome.desktop.a11y.interface', 'high-contrast'))
+        return false;
+    if (GLib.getenv('LUMA_MUTTER_ALLOW_SOFTWARE_BLUR') === '1')
+        return true;
+    try {
+        return global.backend.is_rendering_hardware_accelerated();
+    } catch {
+        return false;
+    }
+}
+
+function unpackDict(dict) {
+    const out = {};
+    for (const [key, value] of Object.entries(dict ?? {}))
+        out[key] = value instanceof GLib.Variant ? value.deepUnpack() : value;
+    return out;
+}
+
+// Every window a person could reasonably share: the ordinary windows of
+// ordinary applications, in the order the window list shows them. Attached
+// dialogs ride their parent's preview, as they do in the dock.
+export function shareableWindows() {
+    return global.display.get_tab_list(Meta.TabList.NORMAL_ALL, null)
+        .filter(window =>
+            window.window_type === Meta.WindowType.NORMAL &&
+            !window.is_skip_taskbar() &&
+            !window.is_override_redirect() &&
+            window.get_compositor_private() !== null);
+}
+
+// ── One preview tile ───────────────────────────────────────────────────────
+
+const PreviewTile = GObject.registerClass({
+    Signals: {'chosen': {}},
+}, class PreviewTile extends St.Button {
+    _init(source, multiple) {
+        const app = source.kind === 'window'
+            ? Shell.WindowTracker.get_default().get_window_app(source.window)
+            : null;
+        super._init({
+            style_class: 'luma-share-tile',
+            can_focus: true,
+            x_expand: false,
+            accessible_role: multiple ? Atk.Role.CHECK_BOX : Atk.Role.RADIO_BUTTON,
+        });
+        this.source = source;
+        this._multiple = multiple;
+        this.chosen = false;
+
+        const column = new St.BoxLayout({
+            orientation: Clutter.Orientation.VERTICAL,
+            x_expand: true,
+            reactive: false,
+        });
+        this.set_child(column);
+
+        this._frame = new St.Widget({
+            style_class: 'luma-share-tile-frame',
+            layout_manager: new Clutter.FixedLayout(),
+            x_expand: true,
+        });
+        column.add_child(this._frame);
+
+        this._content = source.kind === 'window'
+            ? new PreviewThumbnail(source.window)
+            : new ScreenPreview(source.monitor);
+        this._content.add_style_class_name('luma-share-preview');
+        this._frame.add_child(this._content);
+
+        this._check = new St.Bin({
+            style_class: 'luma-share-check',
+            visible: false,
+            child: new Glyph('check', {style_class: 'luma-share-check-glyph'}),
+        });
+        this._frame.add_child(this._check);
+
+        const caption = new St.BoxLayout({
+            style_class: 'luma-share-caption',
+            x_expand: true,
+            reactive: false,
+        });
+        column.add_child(caption);
+
+        if (app) {
+            caption.add_child(new St.Icon({
+                style_class: 'luma-share-caption-icon',
+                gicon: app.get_icon(),
+                icon_size: 18,
+                y_align: Clutter.ActorAlign.CENTER,
+            }));
+        } else {
+            caption.add_child(new St.Bin({
+                style_class: 'luma-share-caption-screen',
+                y_align: Clutter.ActorAlign.CENTER,
+                child: new Glyph('screen', {style_class: 'luma-share-caption-screen-glyph'}),
+            }));
+        }
+
+        this._title = new St.Label({
+            style_class: 'luma-share-caption-title',
+            text: source.title,
+            x_expand: true,
+            y_align: Clutter.ActorAlign.CENTER,
+        });
+        this._title.clutter_text.ellipsize = Pango.EllipsizeMode.END;
+        caption.add_child(this._title);
+
+        this._detail = new St.Label({
+            style_class: 'luma-share-caption-detail',
+            text: source.detail,
+            y_align: Clutter.ActorAlign.CENTER,
+        });
+        caption.add_child(this._detail);
+
+        // "Tide, Library" — the application, then what of it is shared.
+        this.accessible_name = source.detail
+            ? `${source.detail}, ${source.title}`
+            : source.title;
+
+        this.connect('clicked', () => this.emit('chosen'));
+        this.connect('notify::hover', () => this._syncStyle());
+        this.connect('key-focus-in', () => this._syncStyle());
+        this.connect('key-focus-out', () => this._syncStyle());
+        this._syncStyle();
