+// ── The manager ────────────────────────────────────────────────────────────
+
+let theShare = null;
+
+/** @returns {ShareManager} the session's screen sharing manager. */
+export function getShare() {
+    theShare ??= new ShareManager();
+    return theShare;
+}
+
+// For messageTray, which must not construct one.
+/** @returns {?ShareManager} the manager, if one exists. */
+export function peekShare() {
+    return theShare;
