+    _follow() {
+        const rect = this._window.get_frame_rect();
+        const scale = stageScale();
+        const halo = 7 * scale;
+        this.set_position(rect.x - halo, rect.y - halo);
+        this.set_size(rect.width + 2 * halo, rect.height + 2 * halo);
