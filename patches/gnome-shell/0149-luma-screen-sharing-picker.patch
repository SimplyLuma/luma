diff --git a/data/gnome-shell-theme.gresource.xml b/data/gnome-shell-theme.gresource.xml
index 86c0f25..b9475f8 100644
--- a/data/gnome-shell-theme.gresource.xml
+++ b/data/gnome-shell-theme.gresource.xml
@@ -8,6 +8,7 @@
     <file>gnome-shell-high-contrast.css</file>
     <file>luma-capture.css</file>
     <file>luma-seal.css</file>
+    <file>luma-share.css</file>
     <file>luma-cast.css</file>
     <file>luma-shelf.css</file>
     <file>gnome-shell-start.svg</file>
diff --git a/data/theme/luma-share.css b/data/theme/luma-share.css
new file mode 100644
index 0000000..136f331
--- /dev/null
+++ b/data/theme/luma-share.css
@@ -0,0 +1,393 @@
+/* Luma Share: the screen sharing picker, the sharing edge and the Stop pill
+ * (lumaShare.js).
+ *
+ * The card is the authentication prompt's card (luma-seal.css): the same
+ * scrim, radius, tokens, title and body, and the same equal button pair. Only
+ * the sharing colour is Share's own.
+ *
+ *            fill                     ink      muted                   line                     control                 active
+ * light      #f1f2f3                  #30343a  #767b81                 rgba(35,39,45,.09)       rgba(35,44,52,.072)     #31373e
+ * dark       #21252b                  #e9ebec  #969da4                 rgba(255,255,255,.075)   rgba(255,255,255,.072)  #e6e9eb
+ * frost      rgba(244,245,246,.80)    #30343a  #767b81                 rgba(35,39,45,.09)       rgba(35,44,52,.072)     #31373e
+ * glass      rgba(22,29,40,.38)       #ffffff  rgba(255,255,255,.70)   rgba(255,255,255,.15)    rgba(10,20,33,.20)      #ffffff
+ *
+ * Violet #7d5cf0 is sharing. Red means recording (Capture) and the
+ * authentication prompt is neutral, so sharing needed its own colour. */
+
+/* ── Scrim and card ──────────────────────────────────────────────────────── */
+.luma-share-scrim { background-color: rgba(8, 10, 14, 0.46); }
+
+.luma-share-card-shadow {
+  border-radius: 24px;
+  background-color: rgba(0, 0, 0, 0.01);
+  box-shadow: 0 5px 16px rgba(0, 0, 0, 0.28); }
+
+.luma-share-card {
+  font-family: 'Figtree', system-ui, sans-serif;
+  padding: 26px 24px 20px;
+  border-radius: 24px;
+  border: 1px solid rgba(35, 39, 45, 0.09);
+  background-color: #f1f2f3;
+  color: #30343a;
+  box-shadow: 0 40px 90px -24px rgba(0, 0, 0, 0.6); }
+.luma-share-card.luma-surface-dark { background-color: #21252b; color: #e9ebec; border-color: rgba(255, 255, 255, 0.075); }
+.luma-share-card.luma-surface-frost { background-color: rgba(28, 33, 40, 0.88); color: #ffffff;
+  border-color: rgba(255, 255, 255, 0.15); }
+.luma-share-card.luma-surface-glass { background-color: rgba(14, 19, 26, 0.82); color: #ffffff; border-color: rgba(255, 255, 255, 0.15); }
+
+/* ── Who is asking ───────────────────────────────────────────────────────── */
+.luma-share-who { width: 56px; height: 56px; }
+.luma-share-app-icon { icon-shadow: 0 8px 18px -6px rgba(12, 17, 24, 0.45); }
+
+/* A 26 violet circle with the screen glyph, ringed 3 in the card's fill. */
+.luma-share-badge {
+  width: 26px;
+  height: 26px;
+  border-radius: 16px;
+  border: 3px solid #f1f2f3;
+  background-color: #7d5cf0;
+  color: #ffffff; }
+.luma-share-badge-glyph { width: 13px; height: 13px; }
+.luma-surface-dark .luma-share-badge { border-color: #21252b; }
+.luma-surface-frost .luma-share-badge { border-color: rgba(255, 255, 255, 0.22); }
+.luma-surface-glass .luma-share-badge { border-color: #141a22; }
+
+/* The requester could not be resolved: a neutral system screen. */
+.luma-share-system {
+  width: 56px;
+  height: 56px;
+  border-radius: 28px;
+  border: 1px solid rgba(35, 39, 45, 0.09);
+  background-color: rgba(35, 44, 52, 0.072);
+  color: #30343a; }
+.luma-share-system-glyph { width: 24px; height: 24px; }
+.luma-surface-dark .luma-share-system { border-color: rgba(255, 255, 255, 0.075); background-color: rgba(255, 255, 255, 0.072); color: #e9ebec; }
+.luma-surface-glass .luma-share-system,
+.luma-surface-frost .luma-share-system { border-color: rgba(255, 255, 255, 0.15); background-color: rgba(10, 20, 33, 0.20); color: #ffffff; }
+
+/* ── Words ───────────────────────────────────────────────────────────────── */
+.luma-share-title {
+  margin-top: 14px;
+  font-size: 17px;
+  font-weight: 750;
+  letter-spacing: -0.31px;
+  text-align: center;
+  color: #30343a; }
+.luma-share-body {
+  margin-top: 6px;
+  padding: 0 40px;
+  font-size: 13.5px;
+  text-align: center;
+  color: #767b81; }
+.luma-surface-dark .luma-share-title { color: #e9ebec; }
+.luma-surface-dark .luma-share-body { color: #969da4; }
+.luma-surface-glass .luma-share-title,
+.luma-surface-frost .luma-share-title { color: #ffffff; }
+.luma-surface-glass .luma-share-body,
+.luma-surface-frost .luma-share-body { color: rgba(255, 255, 255, 0.90); }
+
+/* ── Windows / Screens ───────────────────────────────────────────────────── */
+.luma-share-tabs {
+  margin-top: 18px;
+  padding: 3px;
+  border-radius: 12px;
+  spacing: 0;
+  background-color: rgba(35, 44, 52, 0.072); }
+.luma-surface-dark .luma-share-tabs { background-color: rgba(255, 255, 255, 0.072); }
+.luma-surface-glass .luma-share-tabs,
+.luma-surface-frost .luma-share-tabs { background-color: rgba(10, 20, 33, 0.20); }
+
+.luma-share-tab {
+  height: 32px;
+  padding: 0 16px;
+  border-radius: 10px;
+  font-size: 13px;
+  font-weight: 650;
+  color: #767b81;
+  transition-duration: 140ms; }
+.luma-share-tab:hover { color: #30343a; }
+.luma-share-tab:checked {
+  background-color: #f1f2f3;
+  box-shadow: 0 1px 2px rgba(12, 17, 24, 0.14);
+  border: 1px solid rgba(35, 39, 45, 0.09);
+  color: #30343a; }
+.luma-share-tab:focus { box-shadow: inset 0 0 0 2px rgba(48, 52, 58, 0.75) !important; }
+.luma-surface-dark .luma-share-tab { color: #969da4; }
+.luma-surface-dark .luma-share-tab:hover { color: #e9ebec; }
+.luma-surface-dark .luma-share-tab:checked { background-color: #21252b; border-color: rgba(255, 255, 255, 0.075); color: #e9ebec; }
+.luma-surface-frost .luma-share-tab:checked { background-color: rgba(28, 33, 40, 0.88); border-color: rgba(255, 255, 255, 0.15); color: #ffffff; }
+.luma-surface-glass .luma-share-tab,
+.luma-surface-frost .luma-share-tab { color: rgba(255, 255, 255, 0.90); }
+.luma-surface-glass .luma-share-tab:hover,
+.luma-surface-frost .luma-share-tab:hover { color: #ffffff; }
+.luma-surface-glass .luma-share-tab:checked { background-color: rgba(14, 19, 26, 0.82); border-color: rgba(255, 255, 255, 0.15); color: #ffffff; }
+.luma-surface-dark .luma-share-tab:focus,
+.luma-surface-glass .luma-share-tab:focus,
+.luma-surface-frost .luma-share-tab:focus { box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.75) !important; }
+
+/* ── Previews ────────────────────────────────────────────────────────────── */
+.luma-share-grid-scroll { margin-top: 16px; }
+.luma-share-grid { spacing: 14px; }
+.luma-share-row { spacing: 12px; }
+
+.luma-share-tile {
+  padding: 0;
+  border-radius: 12px;
+  background-color: transparent; }
+.luma-share-tile:focus { box-shadow: none !important; }
+
+/* The 16:10 preview: a hairline frame the window sits inside at 92%, so its
+ * own corners and shadow show. Hover, focus and chosen are drawn on it. */
+.luma-share-tile-frame {
+  border-radius: 12px;
+  box-shadow: inset 0 0 0 1px rgba(35, 39, 45, 0.09); }
+.luma-surface-dark .luma-share-tile-frame { box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.075); }
+.luma-surface-glass .luma-share-tile-frame,
+.luma-surface-frost .luma-share-tile-frame { box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15); }
+
+.luma-share-tile-frame.luma-share-tile-hover { box-shadow: inset 0 0 0 2px rgba(48, 52, 58, 0.22); }
+.luma-surface-dark .luma-share-tile-frame.luma-share-tile-hover,
+.luma-surface-glass .luma-share-tile-frame.luma-share-tile-hover,
+.luma-surface-frost .luma-share-tile-frame.luma-share-tile-hover { box-shadow: inset 0 0 0 2px rgba(233, 235, 236, 0.22); }
+
+.luma-share-tile:focus .luma-share-tile-frame { box-shadow: inset 0 0 0 2px #31373e; }
+.luma-surface-dark .luma-share-tile:focus .luma-share-tile-frame { box-shadow: inset 0 0 0 2px #e6e9eb; }
+.luma-surface-glass .luma-share-tile:focus .luma-share-tile-frame,
+.luma-surface-frost .luma-share-tile:focus .luma-share-tile-frame { box-shadow: inset 0 0 0 2px #ffffff; }
+
+.luma-share-tile-frame.luma-share-tile-chosen,
+.luma-share-tile:focus .luma-share-tile-frame.luma-share-tile-chosen { box-shadow: inset 0 0 0 2.5px #7d5cf0; }
+
+.luma-share-screen-preview { border-radius: 12px; }
+
+/* The 22 violet check in the preview's top right, ringed 2 in the card. */
+.luma-share-check {
+  width: 22px;
+  height: 22px;
+  border-radius: 13px;
+  border: 2px solid #f1f2f3;
+  background-color: #7d5cf0;
+  color: #ffffff; }
+.luma-share-check-glyph { width: 11px; height: 11px; }
+.luma-surface-dark .luma-share-check { border-color: #21252b; }
+.luma-surface-frost .luma-share-check { border-color: rgba(255, 255, 255, 0.22); }
+.luma-surface-glass .luma-share-check { border-color: #141a22; }
+
+.luma-share-caption {
+  margin-top: 8px;
+  spacing: 6px; }
+.luma-share-caption-icon { width: 18px; height: 18px; }
+.luma-share-caption-screen {
+  width: 18px;
+  height: 18px;
+  border-radius: 5px;
+  background-color: rgba(35, 44, 52, 0.072);
+  color: #767b81; }
+.luma-share-caption-screen-glyph { width: 11px; height: 11px; }
+.luma-surface-dark .luma-share-caption-screen { background-color: rgba(255, 255, 255, 0.072); color: #969da4; }
+.luma-surface-glass .luma-share-caption-screen,
+.luma-surface-frost .luma-share-caption-screen { background-color: rgba(10, 20, 33, 0.20); color: rgba(255, 255, 255, 0.90); }
+
+.luma-share-caption-title {
+  font-size: 12.5px;
+  font-weight: 650;
+  color: #30343a; }
+.luma-share-caption-detail {
+  font-size: 11.5px;
+  text-align: right;
+  color: #767b81; }
+.luma-surface-dark .luma-share-caption-title { color: #e9ebec; }
+.luma-surface-dark .luma-share-caption-detail { color: #969da4; }
+.luma-surface-glass .luma-share-caption-title,
+.luma-surface-frost .luma-share-caption-title { color: #ffffff; }
+.luma-surface-glass .luma-share-caption-detail,
+.luma-surface-frost .luma-share-caption-detail { color: rgba(255, 255, 255, 0.90); }
+
+.luma-share-empty {
+  margin: 22px 0;
+  font-size: 13px;
+  text-align: center;
+  color: #767b81; }
+.luma-surface-dark .luma-share-empty { color: #969da4; }
+.luma-surface-glass .luma-share-empty,
+.luma-surface-frost .luma-share-empty { color: rgba(255, 255, 255, 0.90); }
+
+/* ── Options ─────────────────────────────────────────────────────────────── */
+.luma-share-options {
+  margin-top: 18px;
+  padding: 4px;
+  border-radius: 14px;
+  background-color: rgba(35, 44, 52, 0.072); }
+.luma-surface-dark .luma-share-options { background-color: rgba(255, 255, 255, 0.072); }
+.luma-surface-glass .luma-share-options,
+.luma-surface-frost .luma-share-options { background-color: rgba(10, 20, 33, 0.20); }
+
+.luma-share-option {
+  min-height: 40px;
+  padding: 7px 10px;
+  border-radius: 10px;
+  background-color: transparent; }
+.luma-share-option:hover { background-color: rgba(35, 44, 52, 0.05); }
+.luma-share-option:focus { box-shadow: inset 0 0 0 2px rgba(48, 52, 58, 0.75) !important; }
+.luma-surface-dark .luma-share-option:hover { background-color: rgba(255, 255, 255, 0.05); }
+.luma-surface-dark .luma-share-option:focus,
+.luma-surface-glass .luma-share-option:focus,
+.luma-surface-frost .luma-share-option:focus { box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.75) !important; }
+.luma-surface-glass .luma-share-option:hover,
+.luma-surface-frost .luma-share-option:hover { background-color: rgba(10, 20, 33, 0.14); }
+
+.luma-share-option-title {
+  font-size: 13px;
+  font-weight: 650;
+  color: #30343a; }
+.luma-share-option-line {
+  margin-top: 1px;
+  font-size: 11.5px;
+  color: #767b81; }
+.luma-surface-dark .luma-share-option-title { color: #e9ebec; }
+.luma-surface-dark .luma-share-option-line { color: #969da4; }
+.luma-surface-glass .luma-share-option-title,
+.luma-surface-frost .luma-share-option-title { color: #ffffff; }
+.luma-surface-glass .luma-share-option-line,
+.luma-surface-frost .luma-share-option-line { color: rgba(255, 255, 255, 0.90); }
+
+.luma-share-switch {
+  width: 36px;
+  height: 22px;
+  border-radius: 11px;
+  background-color: rgba(35, 44, 52, 0.16);
+  transition-duration: 140ms; }
+.luma-share-switch.luma-share-switch-on { background-color: #7d5cf0; }
+.luma-share-switch-knob {
+  border-radius: 9px;
+  background-color: #ffffff;
+  box-shadow: 0 1px 2px rgba(12, 17, 24, 0.28); }
+.luma-surface-dark .luma-share-switch { background-color: rgba(255, 255, 255, 0.18); }
+.luma-surface-glass .luma-share-switch,
+.luma-surface-frost .luma-share-switch { background-color: rgba(255, 255, 255, 0.22); }
+.luma-surface-dark .luma-share-switch.luma-share-switch-on,
+.luma-surface-glass .luma-share-switch.luma-share-switch-on,
+.luma-surface-frost .luma-share-switch.luma-share-switch-on { background-color: #7d5cf0; }
+
+/* ── Buttons ─────────────────────────────────────────────────────────────── */
+.luma-share-actions { margin-top: 16px; }
+.luma-share-button {
+  height: 42px;
+  border-radius: 12px;
+  font-size: 13.5px;
+  font-weight: 700;
+  transition-duration: 140ms; }
+.luma-share-cancel { background-color: rgba(35, 44, 52, 0.072); color: #30343a; }
+.luma-share-cancel:hover { background-color: rgba(35, 44, 52, 0.115); }
+.luma-share-cancel:focus { box-shadow: inset 0 0 0 2px rgba(48, 52, 58, 0.75) !important; }
+.luma-share-share { background-color: #30343a; color: #f1f2f3; }
+.luma-share-share:hover { background-color: #3d4249; }
+.luma-share-share:focus { box-shadow: inset 0 0 0 2px rgba(241, 242, 243, 0.8) !important; }
+.luma-share-share:insensitive { background-color: rgba(48, 52, 58, 0.40); color: #f1f2f3; }
+
+.luma-surface-dark .luma-share-cancel { background-color: rgba(255, 255, 255, 0.072); color: #e9ebec; }
+.luma-surface-dark .luma-share-cancel:hover { background-color: rgba(255, 255, 255, 0.12); }
+.luma-surface-dark .luma-share-cancel:focus { box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.75) !important; }
+.luma-surface-dark .luma-share-share { background-color: #e9ebec; color: #21252b; }
+.luma-surface-dark .luma-share-share:hover { background-color: #ffffff; }
+/* The smoked cards keep the light plate on hover too; without this the
+ * unqualified hover laid #3d4249 under the plate's dark label. */
+.luma-surface-frost .luma-share-share:hover,
+.luma-surface-glass .luma-share-share:hover { background-color: #ffffff; }
+.luma-surface-dark .luma-share-share:focus { box-shadow: inset 0 0 0 2px rgba(33, 37, 43, 0.8) !important; }
+.luma-surface-dark .luma-share-share:insensitive { background-color: rgba(233, 235, 236, 0.40); color: #21252b; }
+
+.luma-surface-glass .luma-share-cancel,
+.luma-surface-frost .luma-share-cancel { background-color: rgba(10, 20, 33, 0.20); color: #ffffff; }
+.luma-surface-glass .luma-share-cancel:hover,
+.luma-surface-frost .luma-share-cancel:hover { background-color: rgba(10, 20, 33, 0.30); }
+.luma-surface-glass .luma-share-cancel:focus,
+.luma-surface-frost .luma-share-cancel:focus { box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.75) !important; }
+.luma-surface-glass .luma-share-share,
+.luma-surface-frost .luma-share-share { background-color: #ffffff; color: #1b2230; }
+.luma-surface-glass .luma-share-share:focus,
+.luma-surface-frost .luma-share-share:focus { box-shadow: inset 0 0 0 2px rgba(27, 34, 48, 0.8) !important; }
+.luma-surface-glass .luma-share-share:insensitive,
+.luma-surface-frost .luma-share-share:insensitive { background-color: rgba(255, 255, 255, 0.40); color: #1b2230; }
+
+/* ── While sharing ───────────────────────────────────────────────────────── */
+
+/* A shared window's ring, with its halo, drawn 7 outside the frame. */
+.luma-share-window-edge {
+  border-radius: 16px;
+  border: 7px solid rgba(125, 92, 240, 0.22);
+  box-shadow: inset 0 0 0 2.5px #7d5cf0; }
+
+/* A shared monitor's edge, 3 inside that monitor. A border rather than an
+ * inset shadow: St paints an inset shadow only into a background it renders
+ * itself, and this actor has none, so the shadow alone drew nothing. */
+.luma-share-screen-edge { border: 3px solid #7d5cf0; }
+
+/* ── The Stop pill ───────────────────────────────────────────────────────── */
