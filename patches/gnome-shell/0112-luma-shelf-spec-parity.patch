diff --git a/data/theme/luma-shelf.css b/data/theme/luma-shelf.css
index f7b81fc..5e9e122 100644
--- a/data/theme/luma-shelf.css
+++ b/data/theme/luma-shelf.css
@@ -937,3 +937,136 @@
 .luma-shelf-menu .popup-menu-item { min-height: 32px; padding: 0 8px; border-radius: 10px; font-size: 11px; font-weight: 550; }
 .luma-shelf-menu .popup-separator-menu-item { padding: 5px 7px; }
 .luma-shelf-menu .luma-well-menu-heading { min-height: 22px; font-size: 9px; font-weight: 700; }
+
+/* ── Shelf spec: parity pass ──────────────────────────────────────────── */
+/* The shelf is set in Figtree whatever the interface font is. */
+.luma-shelf-island,
+.luma-well-popover,
+.luma-shelf-menu { font-family: Figtree, sans-serif; }
+
+/* The running dot (55%) and the focused pill (100%) are the island's ink. */
+.luma-shelf-running-indicator,
+.luma-surface-dark .luma-shelf-running-indicator { background-color: #e7e9e8; }
+.luma-surface-light .luma-shelf-running-indicator { background-color: #34383d; }
+.luma-surface-frost .luma-shelf-running-indicator { background-color: #21252b; }
+.luma-surface-glass .luma-shelf-running-indicator { background-color: #ffffff; }
+
+/* Pinned | running: a 1 x 24 rule in `line`; the dock's 6 gap either side. */
+.luma-shelf-dock-island #dash .dash-separator {
+  width: 1px;
+  height: 24px;
+  margin: 0;
+  padding: 0;
+  background-color: rgba(255, 255, 255, 0.10); }
+.luma-shelf-dock-island.luma-surface-light #dash .dash-separator { background-color: rgba(25, 27, 31, 0.12); }
+.luma-shelf-dock-island.luma-surface-frost #dash .dash-separator { background-color: rgba(25, 27, 31, 0.13); }
+.luma-shelf-dock-island.luma-surface-glass #dash .dash-separator { background-color: rgba(255, 255, 255, 0.24); }
+
+/* The Well is 36 high with its 1px line inside that height, not around it:
+ * St has one box-shadow (the inner shade), so the line is a border and the
+ * height and padding give back its pixel. */
+.luma-well { height: 34px; padding: 0 3px; }
+
+/* Quick settings and the clock are the hover targets, not the island. */
+.luma-status-cluster .luma-status-controls,
+.luma-status-cluster .luma-status-clock { transition-duration: 120ms; }
+/* Min width 64 is the clock button's, its 0 4 padding included. */
+.luma-status-cluster .luma-status-clock { min-width: 56px; }
+.luma-status-cluster .luma-status-controls:hover,
+.luma-status-cluster .luma-status-controls:focus,
+.luma-status-cluster .luma-status-clock:hover { background-color: rgba(255, 255, 255, 0.08); }
+.luma-status-cluster .luma-status-controls:checked { background-color: rgba(255, 255, 255, 0.14); }
+.luma-status-cluster.luma-surface-light .luma-status-controls:hover,
+.luma-status-cluster.luma-surface-light .luma-status-controls:focus,
+.luma-status-cluster.luma-surface-light .luma-status-clock:hover { background-color: rgba(25, 27, 31, 0.07); }
+.luma-status-cluster.luma-surface-light .luma-status-controls:checked { background-color: rgba(25, 27, 31, 0.12); }
+.luma-status-cluster.luma-surface-frost .luma-status-controls:hover,
+.luma-status-cluster.luma-surface-frost .luma-status-controls:focus,
+.luma-status-cluster.luma-surface-frost .luma-status-clock:hover { background-color: rgba(25, 27, 31, 0.08); }
+.luma-status-cluster.luma-surface-frost .luma-status-controls:checked { background-color: rgba(25, 27, 31, 0.13); }
+.luma-status-cluster.luma-surface-glass .luma-status-controls:hover,
+.luma-status-cluster.luma-surface-glass .luma-status-controls:focus,
+.luma-status-cluster.luma-surface-glass .luma-status-clock:hover { background-color: rgba(255, 255, 255, 0.14); }
+.luma-status-cluster.luma-surface-glass .luma-status-controls:checked { background-color: rgba(255, 255, 255, 0.22); }
+
+/* An extension's own indicator in the Well: a Well item, 28 high, padding
+ * 0 6, radius 8, a 16px glyph in ink. */
+.luma-well .luma-well-extension { height: 28px; }
+/* PanelMenu.ButtonBox measures itself from its child and these paddings. */
+.luma-well .luma-well-extension .panel-button {
+  -natural-hpadding: 6px;
+  -minimum-hpadding: 6px;
+  margin: 0;
+  padding: 0;
+  border: 0;
+  border-radius: 8px;
+  background-color: transparent;
+  box-shadow: none;
+  color: #e7e9e8;
+  transition-duration: 120ms; }
+.luma-well .luma-well-extension .panel-button:hover,
+.luma-well .luma-well-extension .panel-button:focus { background-color: rgba(255, 255, 255, 0.08); }
+.luma-well .luma-well-extension .panel-button:active,
+.luma-well .luma-well-extension .panel-button:checked { background-color: rgba(255, 255, 255, 0.14); }
+.luma-status-light .luma-well .luma-well-extension .panel-button { color: #34383d; }
+.luma-status-light .luma-well .luma-well-extension .panel-button:hover,
+.luma-status-light .luma-well .luma-well-extension .panel-button:focus { background-color: rgba(25, 27, 31, 0.07); }
+.luma-status-light .luma-well .luma-well-extension .panel-button:active,
+.luma-status-light .luma-well .luma-well-extension .panel-button:checked { background-color: rgba(25, 27, 31, 0.12); }
+.luma-well .luma-well-extension .panel-button StIcon {
+  -st-icon-style: symbolic;
+  icon-size: 16px; }
+.luma-well .luma-well-extension .panel-button StLabel {
+  font-size: 13px;
+  font-weight: 650;
+  font-feature-settings: "tnum"; }
+.luma-well .luma-well-extension .panel-button StBoxLayout { spacing: 5px; }
+
+/* Media controls: 28 square, radius 8, no fill at rest; idle glyphs in ink-2,
+ * play/pause in ink; hover fills with `hover` and inks the glyph. */
+.luma-shelf-media-island .luma-media-control { color: rgba(231, 233, 232, 0.60); transition-duration: 120ms; }
+.luma-shelf-media-island .luma-media-control.luma-media-primary,
+.luma-shelf-media-island .luma-media-control:hover,
+.luma-shelf-media-island .luma-media-control:focus { color: #e7e9e8; }
+.luma-shelf-media-island .luma-media-control:hover,
+.luma-shelf-media-island .luma-media-control:focus { background-color: rgba(255, 255, 255, 0.08); }
+.luma-shelf-media-island.luma-surface-light .luma-media-control { color: rgba(52, 56, 61, 0.62); }
+.luma-shelf-media-island.luma-surface-light .luma-media-control.luma-media-primary,
+.luma-shelf-media-island.luma-surface-light .luma-media-control:hover,
+.luma-shelf-media-island.luma-surface-light .luma-media-control:focus { color: #34383d; }
+.luma-shelf-media-island.luma-surface-light .luma-media-control:hover,
+.luma-shelf-media-island.luma-surface-light .luma-media-control:focus { background-color: rgba(25, 27, 31, 0.07); }
+.luma-shelf-media-island.luma-surface-frost .luma-media-control { color: rgba(33, 37, 43, 0.62); }
+.luma-shelf-media-island.luma-surface-frost .luma-media-control.luma-media-primary,
+.luma-shelf-media-island.luma-surface-frost .luma-media-control:hover,
+.luma-shelf-media-island.luma-surface-frost .luma-media-control:focus { color: #21252b; }
+.luma-shelf-media-island.luma-surface-frost .luma-media-control:hover,
+.luma-shelf-media-island.luma-surface-frost .luma-media-control:focus { background-color: rgba(25, 27, 31, 0.08); }
+.luma-shelf-media-island.luma-surface-glass .luma-media-control { color: rgba(255, 255, 255, 0.72); }
+.luma-shelf-media-island.luma-surface-glass .luma-media-control.luma-media-primary,
+.luma-shelf-media-island.luma-surface-glass .luma-media-control:hover,
+.luma-shelf-media-island.luma-surface-glass .luma-media-control:focus { color: #ffffff; }
+.luma-shelf-media-island.luma-surface-glass .luma-media-control:hover,
+.luma-shelf-media-island.luma-surface-glass .luma-media-control:focus { background-color: rgba(255, 255, 255, 0.14); }
+
+/* Well dots: the attention dot's 6 (recording: 7) sit 4 (3) in from the
+ * item's top-right corner; the 2px ring in `bg` lies outside that. Frost and
+ * Glass drop the ring. */
+/* The item's 0 6 padding lives on its row, so the dot measures from the
+ * item's own corner. */
+.luma-well-item { padding: 0; }
+.luma-well-item-row { padding: 0 6px; }
+.luma-well-dot { margin: 2px; }
+.luma-well-dot.recording { margin: 1px; }
+.luma-status-light .luma-well-dot { background-color: #34383d; border-color: #f1f2f3; }
+.luma-status-light .luma-well-dot.recording { background-color: #b9544f; }
+.luma-surface-frost .luma-well-dot,
+.luma-surface-glass .luma-well-dot { border-width: 0; margin: 4px; }
+.luma-surface-frost .luma-well-dot.recording,
+.luma-surface-glass .luma-well-dot.recording { margin: 3px; }
+.luma-surface-frost .luma-well-dot { background-color: #21252b; }
+.luma-surface-glass .luma-well-dot { background-color: #ffffff; }
+.luma-surface-glass .luma-well-dot.recording { background-color: #ff8f87; }
+
+/* A left or right shelf: the Well is a 36-wide column. */
+.luma-shelf-vertical .luma-well { width: 34px; height: auto; padding: 3px 0; }
