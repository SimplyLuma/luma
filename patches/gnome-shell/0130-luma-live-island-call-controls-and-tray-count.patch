+ * the surface's quiet fill -- set 8 after the title. */
+StBoxLayout.luma-notification-tray .luma-notification-tray-count {
+  min-width: 8px;
+  height: 24px;
+  padding: 0 8px;
+  margin-left: 8px;
+  border-radius: 12px;
+  font-size: 11px;
+  font-weight: 750;
+  font-feature-settings: "tnum";
+  background-color: rgba(255, 255, 255, 0.08);
+  color: #e7e9e8;
