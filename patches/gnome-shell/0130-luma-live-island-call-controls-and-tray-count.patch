index 26a453d..162841a 100644
--- a/js/ui/liveActivity.js
+++ b/js/ui/liveActivity.js
@@ -55,12 +55,6 @@ export const GENERIC_ICON = 'emblem-synchronizing-symbolic';
 // ("call.mute"), so the last segment is what is looked up. The Shell draws
 // nothing it has no glyph for.
 const ACTION_ICONS = new Map([
-    ['mute', 'audio-input-microphone-symbolic'],
-    ['mute-microphone', 'audio-input-microphone-symbolic'],
-    ['microphone-mute', 'audio-input-microphone-symbolic'],
-    ['unmute', 'microphone-disabled-symbolic'],
-    ['microphone', 'audio-input-microphone-symbolic'],
-    ['mic', 'audio-input-microphone-symbolic'],
     ['camera', 'camera-web-symbolic'],
     ['video', 'camera-web-symbolic'],
     ['camera-off', 'camera-disabled-symbolic'],
@@ -78,6 +72,14 @@ const ACTION_ICONS = new Map([
 ]);
 
 const MICROPHONE_ACTIONS = new Set(['mute', 'mute-microphone', 'microphone-mute', 'unmute', 'microphone', 'mic']);
+// Deafen, as in Discord: the call is silenced both ways.
+const DEAFEN_ACTIONS = new Set(['deafen', 'undeafen']);
+// The call's own glyphs are the shelf's Lucide set, as the status grid's
+// microphone is.
+const MIC_ICON = 'luma-mic-symbolic';
+const MIC_OFF_ICON = 'luma-mic-off-symbolic';
+const DEAFEN_ICON = 'luma-headphones-symbolic';
+const DEAFENED_ICON = 'luma-headphones-off-symbolic';
 const CAMERA_ACTIONS = new Set(['camera', 'video', 'camera-off', 'mute-camera', 'camera-mute']);
 const HANGUP_ACTIONS = new Set(['end-call', 'hang-up', 'hangup']);
 
@@ -144,23 +146,30 @@ export function actionVerb(id) {
 export function actionIcon(action) {
     const verb = actionVerb(action?.id);
     if (MICROPHONE_ACTIONS.has(verb))
-        return isMuted(action) ? 'microphone-disabled-symbolic' : 'audio-input-microphone-symbolic';
+        return isMuted(action) ? MIC_OFF_ICON : MIC_ICON;
+    if (DEAFEN_ACTIONS.has(verb))
+        return isMuted(action) ? DEAFENED_ICON : DEAFEN_ICON;
     return ACTION_ICONS.get(verb) ?? null;
 }
 
-// A microphone action states the mute it would undo: an "unmute" verb, or a
-// label that offers to unmute ("Unmute microphone"). Anything else is live.
+// A microphone or deafen action states the state it would undo: an "unmute"
+// or "undeafen" verb, or a label that offers to ("Unmute microphone").
+// Anything else is live.
 export function isMuted(action) {
     const verb = actionVerb(action?.id);
-    if (!MICROPHONE_ACTIONS.has(verb))
-        return false;
-    return verb === 'unmute' || /^\s*unmute\b/i.test(action?.label ?? '');
+    if (MICROPHONE_ACTIONS.has(verb))
+        return verb === 'unmute' || /^\s*unmute\b/i.test(action?.label ?? '');
+    if (DEAFEN_ACTIONS.has(verb))
+        return verb === 'undeafen' || /^\s*undeafen\b/i.test(action?.label ?? '');
+    return false;
 }
 
 export function actionRole(action) {
     const verb = actionVerb(action?.id);
     if (MICROPHONE_ACTIONS.has(verb))
         return 'microphone';
+    if (DEAFEN_ACTIONS.has(verb))
+        return 'deafen';
     if (CAMERA_ACTIONS.has(verb))
         return 'camera';
     if (HANGUP_ACTIONS.has(verb))
@@ -173,7 +182,7 @@ export function actionRole(action) {
 // each only when it works. A control the provider marks unavailable is not
 // drawn on a call; it stays in the right-click menu with its reason, because a
 // dead hang-up in the middle of a call reads as a broken one. Microphone
-// first, end-call last, as in the kit.
+// first, then deafen, end-call last, as in the kit.
 export function shownActions(item, actions) {
     const drawable = actions.filter(action => actionIcon(action) !== null);
     if (styleOf(item) !== Style.CALL) {
@@ -182,7 +191,7 @@ export function shownActions(item, actions) {
             return [];
         return drawable;
     }
-    const order = {microphone: 0, camera: 1, other: 2, hangup: 3};
+    const order = {microphone: 0, deafen: 1, camera: 2, other: 3, hangup: 4};
     return drawable.filter(action => action.enabled === true)
         .sort((a, b) => order[actionRole(a)] - order[actionRole(b)]);
 }
@@ -228,3 +237,12 @@ export function microphoneMuted(actions) {
     const mic = actions.find(action => actionRole(action) === 'microphone');
     return mic ? isMuted(mic) : null;
 }
+
+// What a call is doing to the person, most severe first: deafened (nothing in
+// or out), muted (nothing out), or live.
+export function callState(actions) {
+    const deafen = actions.find(action => actionRole(action) === 'deafen');
+    if (deafen && isMuted(deafen))
+        return 'deafened';
+    return microphoneMuted(actions) ? 'muted' : 'live';
+}
