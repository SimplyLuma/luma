+
+export function validNativeAndroidSender(sender) {
+    return typeof sender === 'string' && sender.length <= 255 &&
+        /^:[0-9]+\.[0-9]+$/.test(sender);
+}
+
+function refusedNativeCaller() {
+    return new GLib.Error(Gio.DBusError, Gio.DBusError.ACCESS_DENIED,
+        'Only this user\'s native desktop session may restore Android windows.');
+}
+
+function procText(path) {
+    const [ok, bytes] = GLib.file_get_contents(path);
+    if (!ok) throw refusedNativeCaller();
+    return new TextDecoder().decode(bytes);
+}
+
+function fileIdentity(path) {
+    const info = Gio.File.new_for_path(path).query_info('standard::type,unix::device,unix::inode',
+        Gio.FileQueryInfoFlags.NONE, null);
+    return `${info.get_attribute_uint32('unix::device')}:${info.get_attribute_uint64('unix::inode')}`;
+}
+
+export function nativeAndroidProcess(pid, uid) {
+    if (!Number.isInteger(pid) || pid <= 0 || uid === 0 ||
+        uid !== new Gio.Credentials().get_unix_user())
+        throw refusedNativeCaller();
+    const before = procText(`/proc/${pid}/stat`).split(')').slice(-1)[0].trim().split(/\s+/);
+    const status = procText(`/proc/${pid}/status`);
+    const ids = status.match(/^Uid:\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)$/m);
+    if (!ids || ids.slice(1).some(id => Number(id) !== uid) ||
+        !before[19] || before[0] === 'Z')
+        throw refusedNativeCaller();
+    // Genuine ENOENT is the only accepted absence. Proxy metadata is present
+    // at its process root too; permission/inspection errors remain refusals.
+    try {
+        Gio.File.new_for_path(`/proc/${pid}/root/.flatpak-info`).query_info(
+            'standard::type', Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS, null);
+        throw refusedNativeCaller();
+    } catch (error) {
+        if (!(error instanceof GLib.Error) || !error.matches(Gio.IOErrorEnum, Gio.IOErrorEnum.NOT_FOUND))
+            throw error;
+    }
+    if (fileIdentity(`/proc/${pid}/ns/user`) !== fileIdentity('/proc/self/ns/user') ||
+        fileIdentity(`/proc/${pid}/ns/mnt`) !== fileIdentity('/proc/self/ns/mnt'))
+        throw refusedNativeCaller();
+    const after = procText(`/proc/${pid}/stat`).split(')').slice(-1)[0].trim().split(/\s+/);
+    if (after[19] !== before[19] || after[0] === 'Z')
+        throw refusedNativeCaller();
+    return before[19];
+}
+
+export async function authenticateNativeAndroidCaller(connection, sender,
+    inspect = nativeAndroidProcess) {
+    if (!validNativeAndroidSender(sender)) throw refusedNativeCaller();
+    async function credential(method) {
+        const value = await connection.call('org.freedesktop.DBus',
+            '/org/freedesktop/DBus', 'org.freedesktop.DBus', method,
+            new GLib.Variant('(s)', [sender]), new GLib.VariantType('(u)'),
+            Gio.DBusCallFlags.NONE, 1000, null);
+        return value.deepUnpack()[0];
+    }
+    const uid = await credential('GetConnectionUnixUser');
+    const pid = await credential('GetConnectionUnixProcessID');
+    const start = inspect(pid, uid);
+    if (await credential('GetConnectionUnixUser') !== uid ||
+        await credential('GetConnectionUnixProcessID') !== pid ||
+        inspect(pid, uid) !== start)
+        throw refusedNativeCaller();
+    return {pid, uid, start};
+}
