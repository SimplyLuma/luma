diff --git a/js/ui/lumaClockLayout.js b/js/ui/lumaClockLayout.js
new file mode 100644
--- /dev/null
+++ b/js/ui/lumaClockLayout.js
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Align differently sized clock labels by their real Pango baseline.
+import Clutter from 'gi://Clutter';
+import GObject from 'gi://GObject';
+import Pango from 'gi://Pango';
+import St from 'gi://St';
+
+export const BaselineClockRow = GObject.registerClass(
+class BaselineClockRow extends St.Widget {
+    _metrics() {
+        return this.get_children().filter(actor => actor.visible).map(actor => {
+            actor.ensure_style();
+            const [, width] = actor.get_preferred_width(-1);
+            const [, height] = actor.get_preferred_height(width);
+            const baseline = actor.clutter_text.get_layout().get_baseline() / Pango.SCALE;
+            return {actor, width, height, baseline};
+        });
+    }
+
+    vfunc_get_preferred_width() {
+        const items = this._metrics();
+        const gap = 3 * St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        const width = items.reduce((sum, item) => sum + item.width, 0) + Math.max(0, items.length - 1) * gap;
+        return [width, width];
+    }
+
+    vfunc_get_preferred_height() {
+        const items = this._metrics();
+        const baseline = Math.max(0, ...items.map(item => item.baseline));
+        const descent = Math.max(0, ...items.map(item => item.height - item.baseline));
+        return [baseline + descent, baseline + descent];
+    }
+
+    vfunc_allocate(box) {
+        this.set_allocation(box);
+        const items = this._metrics();
+        const baseline = Math.max(0, ...items.map(item => item.baseline));
+        const gap = 3 * St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        const rtl = this.get_text_direction() === Clutter.TextDirection.RTL;
+        let x = rtl ? box.get_width() : 0;
+        for (const {actor, width, height, baseline: textBaseline} of items) {
+            if (rtl) x -= width;
+            const y = baseline - textBaseline;
+            actor.allocate(new Clutter.ActorBox({x1: x, x2: x + width, y1: y, y2: y + height}));
+            x += rtl ? -gap : width + gap;
+        }
+    }
+});
