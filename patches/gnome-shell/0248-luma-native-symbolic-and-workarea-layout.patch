diff --git a/src/st/test-symbolic-strokes.c b/src/st/test-symbolic-strokes.c
new file mode 100644
--- /dev/null
+++ b/src/st/test-symbolic-strokes.c
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "st-icon-theme.h"
+#include "st-icon-colors.h"
+#include <glib/gstdio.h>
+
+static GdkPixbuf *
+load_symbolic (const char *path, StIconColors *colors)
+{
+  StIconTheme *theme = st_icon_theme_new ();
+  GFile *file = g_file_new_for_path (path);
+  GIcon *icon = g_file_icon_new (file);
+  StIconInfo *info = st_icon_theme_lookup_by_gicon (theme, icon, 24, 0);
+  GError *error = NULL;
+  gboolean symbolic = FALSE;
+  g_assert_nonnull (info);
+  GdkPixbuf *pixbuf = st_icon_info_load_symbolic (info, colors, &symbolic, &error);
+  g_assert_no_error (error);
+  g_assert_true (symbolic);
+  g_assert_nonnull (pixbuf);
+  g_object_unref (info);
+  g_object_unref (icon);
+  g_object_unref (file);
+  g_object_unref (theme);
+  return pixbuf;
+}
+
+static void
+check_stroke_and_legacy (void)
+{
+  GError *error = NULL;
+  char *dir = g_dir_make_tmp ("luma-st-symbolic-XXXXXX", &error);
+  g_assert_no_error (error);
+  char *path = g_build_filename (dir, "stroke-symbolic.svg", NULL);
+  const char *svg = "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'>"
+    "<circle cx='12' cy='12' r='8' fill='none' stroke='currentColor' stroke-width='2' class='transparent-fill foreground-stroke'/>"
+    "<rect x='1' y='1' width='3' height='3' class='warning-fill'/>"
+    "<path d='M2 22h20' stroke-width='2' class='transparent-fill success-stroke'/></svg>";
+  g_assert_true (g_file_set_contents (path, svg, -1, &error));
+  g_assert_no_error (error);
+  StIconColors *colors = st_icon_colors_new ();
+  cogl_color_init_from_4f (&colors->foreground, 30.f/255, 60.f/255, 120.f/255, 1.f);
+  cogl_color_init_from_4f (&colors->warning, 200.f/255, 50.f/255, 20.f/255, 1.f);
+  cogl_color_init_from_4f (&colors->success, 10.f/255, 180.f/255, 60.f/255, 1.f);
+  cogl_color_init_from_4f (&colors->error, 220.f/255, 10.f/255, 10.f/255, 1.f);
+  GdkPixbuf *pixbuf = load_symbolic (path, colors);
+  int stride = gdk_pixbuf_get_rowstride (pixbuf);
+  int channels = gdk_pixbuf_get_n_channels (pixbuf);
+  g_assert_cmpint (channels, ==, 4);
+  const guchar *pixels = gdk_pixbuf_read_pixels (pixbuf);
+  /* A cog centre must remain hollow, and its stroke receives the palette. */
+  g_assert_cmpint (pixels[12 * stride + 12 * channels + 3], ==, 0);
+  const guchar *edge = pixels + 4 * stride + 12 * channels;
+  g_assert_cmpint (edge[3], >, 100);
+  g_assert_cmpint (edge[0], ==, 30);
+  g_assert_cmpint (edge[2], ==, 120);
+  const guchar *warning = pixels + 2 * stride + 2 * channels;
+  g_assert_cmpint (warning[0], ==, 200);
+  const guchar *success = pixels + 22 * stride + 12 * channels;
+  g_assert_cmpint (success[1], ==, 180);
+  g_object_unref (pixbuf);
+  /* Ordinary legacy filled symbolic icons retain their existing recolour. */
+  svg = "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24'><rect width='24' height='24'/></svg>";
+  g_assert_true (g_file_set_contents (path, svg, -1, &error));
+  g_assert_no_error (error);
+  pixbuf = load_symbolic (path, colors);
+  pixels = gdk_pixbuf_read_pixels (pixbuf);
+  g_assert_cmpint (pixels[0], ==, 30);
+  g_assert_cmpint (pixels[1], ==, 60);
+  g_assert_cmpint (pixels[2], ==, 120);
+  g_assert_cmpint (pixels[3], ==, 255);
+  g_object_unref (pixbuf);
+  st_icon_colors_unref (colors);
+  g_unlink (path);
+  g_rmdir (dir);
+  g_free (path);
+  g_free (dir);
+}
+
+int main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/st/symbolic/stroke-and-legacy", check_stroke_and_legacy);
+  return g_test_run ();
+}
