From: Project Luma <builds@project-luma.local>
Subject: [PATCH] luma: typing on the lock and login screens goes to the password

Keys were only forwarded to the prompt while the clock was showing. Once the
password field was up, any loss of focus -- closing the power menu, clicking
the background -- sent every later keystroke nowhere. The dialogs now route
printable keys, Backspace and Enter to the password entry from their
captured-event handler unless another text field or a menu holds focus.

--- a/js/ui/prairieLogin.js
+++ b/js/ui/prairieLogin.js
@@ -1,4 +1,5 @@
 import Clutter from 'gi://Clutter';
+import GLib from 'gi://GLib';
 import GnomeDesktop from 'gi://GnomeDesktop';
 import GObject from 'gi://GObject';
 import Shell from 'gi://Shell';
@@ -159,3 +160,61 @@
         this.add_child(this._overlay);
     }
 });
+
+const MODIFIERS = Clutter.ModifierType.CONTROL_MASK | Clutter.ModifierType.MOD1_MASK |
+    Clutter.ModifierType.SUPER_MASK | Clutter.ModifierType.HYPER_MASK | Clutter.ModifierType.META_MASK;
+
+/**
+ * Typing on the lock and login screens belongs to the password field,
+ * wherever keyboard focus happens to be.
+ *
+ * Focus leaves the entry easily: closing the power menu hands it to the power
+ * button, and a click on the background takes it away entirely. The dialog
+ * only forwarded keys while the clock was showing, so once the prompt was up
+ * every keystroke after that went nowhere. Call this from the dialog's
+ * captured-event handler; it leaves alone another text field (a user name),
+ * shortcuts with modifiers, and anything inside `keepFocusWithin`.
+ *
+ * @param {Clutter.Event} event
+ * @param {object} authPrompt - an AuthPrompt whose entry is showing
+ * @param {Clutter.Actor[]} keepFocusWithin - actors that keep their own keys
+ * @param {Clutter.Actor} [focus] - the current key focus, for tests
+ * @returns {boolean} Clutter.EVENT_STOP when the key was delivered
+ */
+export function routeTypingToPassword(event, authPrompt, keepFocusWithin = [], focus = global.stage.get_key_focus()) {
+    if (!authPrompt || event.type() !== Clutter.EventType.KEY_PRESS)
+        return Clutter.EVENT_PROPAGATE;
+    const entry = authPrompt._entry;
+    if (!entry || !entry.visible || !entry.reactive || !entry.mapped)
+        return Clutter.EVENT_PROPAGATE;
+    if (focus && (focus === entry || focus === entry.clutter_text || entry.contains(focus)))
+        return Clutter.EVENT_PROPAGATE;
+    if (focus instanceof Clutter.Text && focus.editable)
+        return Clutter.EVENT_PROPAGATE;
+    if (focus && keepFocusWithin.some(actor => actor && actor.contains(focus)))
+        return Clutter.EVENT_PROPAGATE;
+    if (event.get_state() & MODIFIERS)
+        return Clutter.EVENT_PROPAGATE;
+
+    const keyval = event.get_key_symbol();
+    const unichar = event.get_key_unicode();
+    if (unichar && (GLib.unichar_isgraph(unichar) || unichar === ' ')) {
+        authPrompt.addCharacter(unichar);
+        return Clutter.EVENT_STOP;
+    }
+    const text = entry.clutter_text;
+    if (keyval === Clutter.KEY_BackSpace) {
+        entry.grab_key_focus();
+        if (text.text.length > 0) {
+            text.set_cursor_position(-1);
+            text.delete_chars(1);
+        }
+        return Clutter.EVENT_STOP;
+    }
+    if ((keyval === Clutter.KEY_Return || keyval === Clutter.KEY_KP_Enter) && text.text.length > 0) {
+        entry.grab_key_focus();
+        text.activate();
+        return Clutter.EVENT_STOP;
+    }
+    return Clutter.EVENT_PROPAGATE;
+}
