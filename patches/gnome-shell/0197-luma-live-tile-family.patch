From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <builds@project-luma.local>
Date: Sat, 26 Sep 2026 00:00:00 +0000
Subject: [PATCH] luma: the live tiles are one family
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Studio Desktop builds every live tile from five parts: a 40px picture, the
copy (13/650 over 11.5/500, up to 170px), a hero, round 32px wells and one
34px key a step brighter; red only ends a call. An upcoming event leads with
its calendar's icon and reads "7:30 – 8:15 · 8 min" with a Join key, a
recording is a red dot, its running time and a waveform with pause and
stop, a call counts up in green, and music names only the artist.

diff --git a/data/theme/luma-shelf.css b/data/theme/luma-shelf.css
index 773d6cf..6f5806a 100644
--- a/data/theme/luma-shelf.css
+++ b/data/theme/luma-shelf.css
@@ -3044,3 +3044,59 @@ StBoxLayout.luma-notification-tray.luma-surface-dark .luma-notification-tray-cou
   background-color: rgba(255,255,255,0.16); }
 .luma-surface-smoke .luma-media-control.luma-media-primary {
   background-color: rgba(255,255,255,0.20); }
+
+/* Studio Desktop live tiles: one family of five parts. A 40px picture
+ * (radius 11), copy (13/650 over 11.5/500, up to 170px), a hero (21/600),
+ * round 32px wells with a 15px glyph and one 34px key with a 14px glyph, a
+ * step brighter. Red only ends a call. A tile sits the island padding in
+ * from the left and 10px in from the right. */
+.luma-shelf-live-island .luma-shelf-material,
+.luma-shelf-media-island .luma-shelf-material { padding-right: 10px; }
+.luma-shelf-live-island .luma-live-extension-content { spacing: 10px; }
+.luma-shelf-live-island .luma-live-extension-text {
+  min-width: 0; max-width: 170px; spacing: 1px; padding-right: 10px; }
+.luma-shelf-live-island .luma-live-extension-title {
+  font-size: 13px; font-weight: 650; }
+.luma-shelf-live-island .luma-live-extension-subtitle {
+  font-size: 11.5px; font-weight: 500; font-feature-settings: "tnum"; }
+.luma-shelf-live-island .luma-live-extension-call .luma-live-extension-text { max-width: 104px; }
+.luma-shelf-live-island .luma-live-extension-call .luma-live-extension-subtitle { color: #65b58c; }
+.luma-shelf-live-island .luma-shelf-material.luma-surface-light .luma-live-extension-call .luma-live-extension-subtitle { color: #3b8967; }
+.luma-shelf-live-island .luma-live-extension-muted .luma-live-extension-subtitle,
+.luma-shelf-live-island .luma-live-extension-deafened .luma-live-extension-subtitle { color: #e0716b; }
+.luma-shelf-live-island .luma-live-extension-actions { spacing: 2px; }
+.luma-shelf-live-island .luma-live-extension-action {
+  min-width: 32px; min-height: 32px; border-radius: 16px;
+  background-color: rgba(255,255,255,0.10); color: rgba(255,255,255,0.92); }
+.luma-shelf-live-island .luma-live-extension-action:hover { background-color: rgba(255,255,255,0.16); }
+.luma-shelf-live-island .luma-live-extension-action .luma-live-extension-action-icon { icon-size: 15px; }
+.luma-shelf-live-island .luma-live-extension-action.luma-live-extension-key {
+  min-width: 34px; min-height: 34px; border-radius: 17px;
+  background-color: rgba(255,255,255,0.20); }
+.luma-shelf-live-island .luma-live-extension-action.luma-live-extension-key:hover { background-color: rgba(255,255,255,0.27); }
+.luma-shelf-live-island .luma-live-extension-action.luma-live-extension-key .luma-live-extension-action-icon { icon-size: 14px; }
+.luma-shelf-live-island .luma-live-extension-action.luma-live-extension-action-end {
+  background-color: #d24c49; color: #ffffff; }
+.luma-shelf-live-island .luma-live-extension-action.luma-live-extension-action-end:hover { background-color: #db5a56; }
+.luma-shelf-live-island .luma-live-extension-action.luma-live-extension-action-stop { color: #e23439; }
+.luma-shelf-live-island .luma-shelf-material.luma-surface-light .luma-live-extension-action {
+  background-color: rgba(20,22,26,0.06); color: #1d1f23; }
+.luma-shelf-live-island .luma-shelf-material.luma-surface-light .luma-live-extension-action:hover { background-color: rgba(20,22,26,0.10); }
+.luma-shelf-live-island .luma-shelf-material.luma-surface-light .luma-live-extension-action.luma-live-extension-key { background-color: rgba(20,22,26,0.11); }
+.luma-shelf-live-island .luma-shelf-material.luma-surface-light .luma-live-extension-action.luma-live-extension-key:hover { background-color: rgba(20,22,26,0.16); }
+.luma-shelf-live-island .luma-shelf-material.luma-surface-light .luma-live-extension-action.luma-live-extension-action-end { background-color: #d24c49; color: #ffffff; }
+.luma-shelf-live-island .luma-shelf-material.luma-surface-light .luma-live-extension-action.luma-live-extension-action-stop { color: #e23439; }
+/* A recording: the red dot, its time as the hero, the waveform. */
+.luma-shelf-live-island .luma-live-extension-recording .luma-live-extension-content { padding-left: 4px; }
+.luma-live-extension-recdot {
+  width: 9px; height: 9px; border-radius: 5px; background-color: #f14445;
+  box-shadow: 0 0 0 4px rgba(241,68,69,0.2); }
+.luma-live-extension-paused .luma-live-extension-recdot {
+  background-color: rgba(231,233,232,0.42); box-shadow: none; }
+.luma-live-extension-hero {
+  font-size: 21px; font-weight: 600; letter-spacing: -0.3px;
+  font-feature-settings: "tnum"; min-width: 52px; }
+.luma-live-extension-wave { spacing: 2px; height: 26px; }
+.luma-live-extension-wave-bar { width: 3px; border-radius: 2px; background-color: #ff645f; }
+.luma-live-extension-paused .luma-live-extension-wave-bar { background-color: rgba(231,233,232,0.42); }
+.luma-shelf-live-island .luma-live-extension-recording .luma-live-extension-actions { spacing: 4px; }
