+    // Write the tile's running text for now; false when nothing runs. A
+    // call counts up in its line, a recording in its hero, and an event
+    // counts down to its start.
+    _tickText() {
+        const now = Date.now();
+        const extension = this._current?.extension;
+        if (this._style === LiveActivity.Style.CALL) {
+            const elapsed = LiveActivity.clockText(this._callStart, now);
+            if (elapsed === null)
+                return false;
+            this._subtitle.text = LiveActivity.callSubtitle(this._callLabel, elapsed);
+            return true;
+        }
+        if (this._style === LiveActivity.Style.RECORDING) {
+            const elapsed = LiveActivity.clockText(this._callStart, now) ?? '0:00';
+            this._hero.text = elapsed;
+            this.accessible_name = `${extension?.title ?? _('Recording')}, ${elapsed}`;
+            return !this.has_style_class_name('luma-live-extension-paused') && this._callStart !== null;
+        }
+        if (this._style === LiveActivity.Style.EVENT && extension) {
+            const start = LiveActivity.parseInstant(extension.starts_at);
+            const end = LiveActivity.parseInstant(extension.expires_at);
+            const format = ms => GLib.DateTime.new_from_unix_local(Math.floor(ms / 1000))
+                ?.format(this._twelveHour() ? '%-l:%M' : '%H:%M') ?? '';
+            this._subtitle.text = LiveActivity.eventLine(format(start),
+                end !== null ? format(end) : '', start, now);
+            this._subtitle.visible = true;
+            return true;
+        }
+        return false;
+    }
+
+    _twelveHour() {
+        this._clockSettings ??= new Gio.Settings({schema_id: 'org.gnome.desktop.interface'});
+        return this._clockSettings.get_string('clock-format') === '12h';
+    }
+
     _stopTicking() {
         if (this._tickId)
             GLib.source_remove(this._tickId);
@@ -564,8 +640,16 @@ export const LiveExtensionsIndicator = GObject.registerClass({
         this._actionsKey = key;
         this._hideTooltip();
         this._actions.destroy_all_children();
-        for (const action of actions)
-            this._actions.add_child(this._createActionButton(action));
+        for (const action of actions) {
+            const button = this._createActionButton(action);
+            // The tile's one main control is a step brighter (the key);
+            // the rest are wells.
+            if (LiveActivity.isKey(actions, action))
