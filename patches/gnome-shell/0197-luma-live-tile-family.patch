index 68e9173..777c07c 100644
--- a/js/ui/liveActivity.js
+++ b/js/ui/liveActivity.js
@@ -16,6 +16,7 @@
 export const Style = Object.freeze({
     CALL: 'call',
     EVENT: 'event',
+    RECORDING: 'recording',
     GENERIC: 'generic',
 });
 
@@ -69,6 +70,11 @@ const ACTION_ICONS = new Map([
     ['speaker', 'audio-volume-high-symbolic'],
     ['share-screen', 'screen-shared-symbolic'],
     ['screen-share', 'screen-shared-symbolic'],
+    // An upcoming event's one key, and a recording's well and key.
+    ['join', 'camera-web-symbolic'],
+    ['pause', 'luma-pause-symbolic'],
+    ['resume', 'luma-mic-symbolic'],
+    ['stop', 'media-playback-stop-symbolic'],
 ]);
 
 const MICROPHONE_ACTIONS = new Set(['mute', 'mute-microphone', 'microphone-mute', 'unmute', 'microphone', 'mic']);
@@ -102,6 +108,8 @@ export function styleOf(item) {
     const category = categoryOf(item);
     if (category === 'call')
         return Style.CALL;
+    if (category === 'recording')
+        return Style.RECORDING;
     if (category === 'event' && parseInstant(item.extension.starts_at) !== null)
         return Style.EVENT;
     return Style.GENERIC;
@@ -240,9 +248,36 @@ export function shownActions(item, actions) {
         .sort((a, b) => order[actionRole(a)] - order[actionRole(b)]);
 }
 
-// The kit's call subtitle: "Call · 00:42".
+// A call's line: the running time alone ("0:42"), or what is wrong with
+// the call first ("Muted · 0:42").
 export function callSubtitle(label, elapsed) {
-    return `${label} · ${elapsed}`;
+    return label ? `${label} · ${elapsed}` : elapsed;
+}
+
+// A tile's running time as Studio writes it: "0:14", "12:05", "1:02:05".
+// Null before the start, so no clock is invented.
+export function clockText(startMs, nowMs) {
+    if (startMs === null || !Number.isFinite(startMs) || nowMs < startMs)
+        return null;
+    const total = Math.floor((nowMs - startMs) / 1000);
+    const hours = Math.floor(total / 3600);
+    const minutes = Math.floor(total / 60) % 60;
+    const seconds = String(total % 60).padStart(2, '0');
+    return hours ? `${hours}:${String(minutes).padStart(2, '0')}:${seconds}`
+        : `${minutes}:${seconds}`;
+}
+
+// An upcoming event's line: "7:30 – 8:15 · 8 min", then "now" from its start.
+export function eventLine(startText, endText, startMs, nowMs) {
+    const minutes = Math.max(0, Math.round((startMs - nowMs) / 60_000));
+    const when = endText ? `${startText} – ${endText}` : startText;
+    return `${when} · ${minutes ? `${minutes} min` : 'now'}`;
+}
+
+// The tile's one main control is its last: Join, Stop, End call. Every
+// other control is a well.
+export function isKey(actions, action) {
+    return actions.length > 0 && actions[actions.length - 1] === action;
 }
 
 // Up to two initials for a caller with no application icon to show: the first
