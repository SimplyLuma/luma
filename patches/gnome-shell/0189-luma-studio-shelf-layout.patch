From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <builds@project-luma.local>
Date: Sat, 26 Sep 2026 00:00:00 +0000
Subject: [PATCH] luma: size and place the default shelf like Studio Desktop

Use forty pixel dock and live pictures with fourteen pixel island padding,
sixteen pixel screen inset, ten pixel island gaps and sixteen pixel corners.
The luma arrangement holds the dock and live islands in the centre while the
status parts hug the right edge. Preserve the older arrangements for people
who selected them explicitly.
diff --git a/data/theme/luma-shelf.css b/data/theme/luma-shelf.css
index ab20d61..956a21f 100644
--- a/data/theme/luma-shelf.css
+++ b/data/theme/luma-shelf.css
@@ -2655,3 +2655,37 @@ StBoxLayout.luma-notification-tray.luma-surface-dark .luma-notification-tray-cou
 .luma-dockf-rail:drop .luma-dockf-placeholder {
   border-color: rgba(128, 168, 210, 0.85);
   background-color: rgba(128, 168, 210, 0.16); }
+
+/* Studio Desktop, luma preset: forty pixel artwork in sixty-eight pixel islands. */
+.luma-shelf-material, .luma-shelf-shadow, .luma-shelf-stroke { border-radius: 16px; }
+.luma-shelf-dock-island .luma-shelf-material { padding: 14px; }
+.luma-shelf-live-island .luma-shelf-material { padding: 14px; }
+.luma-shelf-actions-island .luma-shelf-material { padding: 14px; }
+.luma-status-cluster .luma-status-clock, .luma-status-cluster .luma-status-controls { height: 40px; }
+.luma-status-cluster .luma-status-clock-text { spacing: 2px; }
+.luma-status-cluster .luma-status-clock { min-width: 78px; }
+.luma-status-cluster .luma-status-date { color: rgba(231,233,232,0.62); font-weight: 500; }
+.luma-status-cluster.luma-surface-light .luma-status-date { color: rgba(43,48,54,0.62); }
+.luma-status-slot .system-status-icon { icon-size: 15px; }
+.luma-shelf-root.luma-shelf-separate > .luma-shelf-group > .luma-shelf-actions-island >
+.luma-shelf-material.luma-status-cluster.luma-surface-light { background-color: #eceef1; }
+.luma-shelf-dock-scroll { min-height: 40px; }
+.luma-shelf-apps-divider { background-color: rgba(255,255,255,0.22); margin: 0 8px; }
+.luma-surface-light .luma-shelf-apps-divider { background-color: rgba(30,34,39,0.22); }
+.luma-shelf-dock-island #dash .show-apps:hover { background-color: rgba(255,255,255,0.10) !important; }
+.luma-shelf-dock-island #dash .show-apps:active { background-color: rgba(255,255,255,0.16) !important; }
+.luma-media-module { height: 40px; }
+.luma-media-art { icon-size: 40px; border-radius: 11px; }
+.luma-shelf-live-island .luma-live-extension-leading,
+.luma-shelf-live-island .luma-live-extension-badge { width: 40px; height: 40px; border-radius: 11px; }
+.luma-shelf-live-island .luma-live-extension-text { max-width: 170px; }
+.luma-shelf-live-island .luma-live-extension-action,
+.luma-media-control { min-width: 32px; min-height: 32px; border-radius: 99px; }
+.luma-media-control { background-color: rgba(255,255,255,0.10); }
+.luma-media-control.luma-media-primary { min-width: 34px; min-height: 34px; background-color: rgba(255,255,255,0.20); }
+.luma-shelf-live-island .luma-live-extension-action { background-color: rgba(255,255,255,0.10); }
+.luma-shelf-live-island .luma-live-extension-action.luma-live-extension-action-end {
+  min-width: 34px; min-height: 34px; background-color: rgba(255,255,255,0.20); color: #d9534f; }
+.luma-shelf-material.luma-surface-light { background-color: #eceef1; }
+.luma-shelf-shadow-near.luma-surface-light { box-shadow: 0 3px 8px rgba(20,22,26,0.14); }
+.luma-shelf-shadow-middle.luma-surface-light { box-shadow: 0 22px 52px -15px rgba(20,22,26,0.40); }
