@@ -34,7 +34,7 @@ export const ANCHORS = Object.freeze(['start', 'center', 'end', 'free']);
 export const ZONE_ANCHORS = Object.freeze(['start', 'center', 'end']);
 
 // Logical pixels; the caller multiplies by the display scale.
-export const ISLAND_GAP = 9;          // the kit's island_gap: attached islands
+export const ISLAND_GAP = 10;          // the kit's island_gap: attached islands
 export const GROUP_SEPARATION = 24;   // separate groups on one band, at least
 export const ATTACH_DISTANCE = 40;    // along a group's run, to attach to it
 // Beside any group, measured from its end along the band: the pointer in
@@ -130,6 +130,20 @@ export function defaultArrangement(v1 = {}, order = DEFAULT_ORDER) {
             {display: '', edge, anchor: 'end', position: 0.5, islands: away},
         ];
     }
+    if (v1.groupLayout === 'luma') {
+        const middle = order.filter(id => ['dock', 'folders', 'live', 'media'].includes(id));
+        const status = order.filter(id => ['well', 'quick-options', 'clock'].includes(id));
+        const other = order.filter(id => !middle.includes(id) && !status.includes(id) && id !== 'notifications');
+        return [
+            {display: '', edge, anchor: 'center', position: 0.5, islands: middle},
+            {display: '', edge, anchor: 'end', position: 0.5, islands: status},
+            // Incoming notifications drop from a separate top-centre lip.
+            ...(order.includes('notifications')
+                ? [{display: '', edge: 'top', anchor: 'center', position: 0.5, islands: ['notifications']}]
+                : []),
+            ...other.map(id => ({display: '', edge, anchor: 'end', position: 0.5, islands: [id]})),
+        ].filter(group => group.islands.length);
+    }
     if (v1.groupLayout === 'split-ends') {
         return [
             {display: '', edge, anchor: anchor(v1.dockAnchor ?? 'start'), position: 0.5, islands: withDock},
