diff --git a/js/ui/osdWindow.js b/js/ui/osdWindow.js
index 47c840a..1939430 100644
--- a/js/ui/osdWindow.js
+++ b/js/ui/osdWindow.js
@@ -1,107 +1,431 @@
+import Atk from 'gi://Atk';
 import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
 import GLib from 'gi://GLib';
 import GObject from 'gi://GObject';
+import Shell from 'gi://Shell';
 import St from 'gi://St';
 
-import * as BarLevel from './barLevel.js';
-import * as Layout from './layout.js';
 import * as Main from './main.js';
+import * as SurfaceMaterials from './lumaSurfaceMaterials.js';
+import {SHELF_SURFACE_GAP, placeShelfSurface, shelfEdge} from './lumaShelfSurface.js';
 
 const HIDE_TIMEOUT = 1500;
 const FADE_TIME = 100;
 export const LEVEL_ANIMATION_TIME = 100;
 
+// Beam: Luma's presentation of the on-screen display. A capsule whose own
+// body fills to the level, the icon at the leading end and the number at the
+// trailing end, on the Quick Options surface of the current appearance mode.
+// It is placed by the shelf surface rule against the island holding Quick
+// Options, and keeps GNOME's OsdWindowManager API so every caller -- the
+// volume indicator, brightness, gnome-settings-daemon's ShowOSD and Mutter's
+// show-osd -- reaches it unchanged.
+
+// Lift toward the desktop on the way in, in logical pixels.
+const ENTRANCE_DISTANCE = 6;
+
+const reduceMotion = () => !St.Settings.get().enable_animations;
+
+function iconName(gicon) {
+    if (gicon instanceof Gio.ThemedIcon)
+        return gicon.get_names()[0] ?? '';
+    return gicon?.to_string?.() ?? '';
+}
+
+// What an OSD request is about, from the icon its caller chose: the icon is
+// the one thing every caller (Shell, gnome-settings-daemon, Mutter) sends.
+export function beamKind(name) {
+    if (name.startsWith('audio-volume'))
+        return 'volume';
+    if (name.startsWith('display-brightness'))
+        return 'brightness';
+    if (name.startsWith('keyboard-brightness'))
+        return 'keyboard-brightness';
+    if (name.startsWith('microphone-sensitivity'))
+        return 'microphone';
+    return 'other';
+}
+
+// The Beam's glyph, number and spoken text for a request. level and maxLevel
+// are GNOME's: 1 is 100%, and maxLevel above 1 allows over-amplification.
+export function beamPresentation({name, level = null, label = null}) {
+    const kind = beamKind(name);
+    if (level === null || level === undefined || level < 0) {
+        return {kind, glyph: null, fill: 0, value: label ?? '',
+            spoken: label ?? ''};
+    }
+    const muted = kind === 'volume' && (name.includes('muted') || level <= 0);
+    const percent = muted ? 0 : Math.round(level * 100);
+    const fill = Math.clamp(muted ? 0 : level, 0, 1);
+    let glyph = null;
+    if (kind === 'volume')
+        glyph = muted ? 'muted' : percent < 50 ? 'low' : 'high';
+    else if (kind === 'brightness')
+        glyph = 'sun';
+    const value = `${percent}%`;
+    let spoken;
+    switch (kind) {
+    case 'volume':
+        spoken = muted ? _('Volume muted') : _('Volume %d percent').format(percent);
+        break;
+    case 'brightness':
+        spoken = _('Brightness %d percent').format(percent);
+        break;
+    case 'keyboard-brightness':
+        spoken = _('Keyboard brightness %d percent').format(percent);
+        break;
+    case 'microphone':
+        spoken = _('Microphone %d percent').format(percent);
+        break;
+    default:
+        spoken = label ? `${label} ${_('%d percent').format(percent)}`
+            : _('%d percent').format(percent);
+    }
+    return {kind, glyph, fill, value, spoken};
+}
+
+// The volume and brightness glyphs, drawn at 19px with a 1.8 stroke on a 24
+// unit grid. Geometry from Lucide (volume-x, volume-1, volume-2, sun),
+// ISC licensed; see LUCIDE-ICONS in docs/research/source-register.md.
+const BeamGlyph = GObject.registerClass(
+class BeamGlyph extends St.DrawingArea {
+    _init() {
+        super._init({style_class: 'luma-beam-glyph', y_align: Clutter.ActorAlign.CENTER});
+        this._glyph = null;
+    }
+
+    set glyph(glyph) {
+        if (this._glyph === glyph)
+            return;
+        this._glyph = glyph;
+        this.queue_repaint();
+    }
+
+    vfunc_repaint() {
+        const cr = this.get_context();
+        const [width, height] = this.get_surface_size();
+        const node = this.get_theme_node();
+        const size = Math.min(width, height);
+        cr.translate((width - size) / 2, (height - size) / 2);
+        cr.scale(size / 24, size / 24);
+        cr.setSourceColor(node.get_foreground_color());
+        cr.setLineWidth(1.8);
+        cr.setLineCap(1);   // Cairo.LineCap.ROUND
+        cr.setLineJoin(1);  // Cairo.LineJoin.ROUND
+        const line = (x1, y1, x2, y2) => {
+            cr.moveTo(x1, y1);
+            cr.lineTo(x2, y2);
+        };
+        const wave = (x, top, bottom, radius) => {
+            const half = (bottom - top) / 2;
+            const cx = x - Math.sqrt(radius * radius - half * half);
+            const angle = Math.atan2(half, x - cx);
+            cr.newSubPath();
+            cr.arc(cx, top + half, radius, -angle, angle);
+        };
+        if (this._glyph === 'sun') {
+            cr.newSubPath();
+            cr.arc(12, 12, 4, 0, 2 * Math.PI);
+            line(12, 2, 12, 4);
+            line(12, 20, 12, 22);
+            line(4.9, 4.9, 6.3, 6.3);
+            line(17.7, 17.7, 19.1, 19.1);
+            line(2, 12, 4, 12);
+            line(20, 12, 22, 12);
+            line(6.3, 17.7, 4.9, 19.1);
+            line(19.1, 4.9, 17.7, 6.3);
+        } else if (this._glyph) {
+            cr.moveTo(11, 5);
+            cr.lineTo(6, 9);
+            cr.lineTo(2, 9);
+            cr.lineTo(2, 15);
+            cr.lineTo(6, 15);
+            cr.lineTo(11, 19);
+            cr.closePath();
+            if (this._glyph === 'muted') {
+                line(22, 9, 16, 15);
+                line(16, 9, 22, 15);
+            } else {
+                wave(15.5, 8.5, 15.5, 5);
+                if (this._glyph === 'high')
+                    wave(19, 5, 19, 10);
+            }
+        }
+        cr.stroke();
+        cr.$dispose();
+    }
+});
+
+// The level: from the leading edge to the amount, the active control colour
+// over the surface, ending in a 2px marker; clipped to the capsule.
+const BeamFill = GObject.registerClass({
+    Properties: {
+        'value': GObject.ParamSpec.double(
+            'value', null, null,
+            GObject.ParamFlags.READWRITE,
+            0, 1, 0),
+    },
+}, class BeamFill extends St.DrawingArea {
+    _init() {
+        super._init({style_class: 'luma-beam-fill', x_expand: true, y_expand: true});
+        this._value = 0;
+    }
+
+    get value() {
+        return this._value;
+    }
+
+    set value(value) {
+        value = Math.clamp(value, 0, 1);
+        if (this._value === value)
+            return;
+        this._value = value;
+        this.notify('value');
+        this.queue_repaint();
+    }
+
+    vfunc_repaint() {
+        const cr = this.get_context();
+        const [width, height] = this.get_surface_size();
+        const node = this.get_theme_node();
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        const radius = height / 2;
+        cr.newSubPath();
+        cr.arc(radius, radius, radius, Math.PI / 2, 3 * Math.PI / 2);
+        cr.arc(width - radius, radius, radius, -Math.PI / 2, Math.PI / 2);
+        cr.closePath();
+        cr.clip();
+
+        const filled = Math.round(width * this._value);
+        if (filled > 0) {
+            const rtl = this.get_text_direction() === Clutter.TextDirection.RTL;
+            const start = rtl ? width - filled : 0;
+            const [, fill] = node.lookup_color('-luma-beam-fill-color', true);
+            cr.setSourceColor(fill);
+            cr.rectangle(start, 0, filled, height);
+            cr.fill();
+            const marker = Math.min(2 * scale, filled);
+            const [, end] = node.lookup_color('-luma-beam-marker-color', true);
+            cr.setSourceColor(end);
+            cr.rectangle(rtl ? start : filled - marker, 0, marker, height);
+            cr.fill();
+        }
+        cr.$dispose();
+    }
+});
+
 export const OsdWindow = GObject.registerClass(
-class OsdWindow extends Clutter.Actor {
+class OsdWindow extends St.Widget {
     _init(monitorIndex) {
         super._init({
-            x_expand: true,
-            y_expand: true,
-            x_align: Clutter.ActorAlign.CENTER,
-            y_align: Clutter.ActorAlign.END,
+            style_class: 'luma-beam-window',
+            layout_manager: new Clutter.BinLayout(),
+            reactive: false,
+            can_focus: false,
         });
+        // Never takes pointer input: it is not even a pick target.
+        Shell.util_set_hidden_from_pick(this, true);
 
         this._monitorIndex = monitorIndex;
-        const constraint = new Layout.MonitorConstraint({index: monitorIndex});
-        this.add_constraint(constraint);
 
-        this._hbox = new St.BoxLayout({
-            style_class: 'osd-window',
