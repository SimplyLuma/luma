+/* Beam: Luma's level indicator (osdWindow.js). A 236 x 48 capsule on the
+ * Quick Options surface of the current appearance mode: the same fill, 1px
+ * line and shadows, and the same compositor blur on Frost and Glass. The fill
+ * is the active control colour at 24% over the surface, ending in a 2px
+ * marker at 55%. Where it sits is the shelf surface rule, not a margin. */
+.luma-beam {
+  width: 236px;
+  height: 48px;
+  border-radius: 24px;
+  font-family: Figtree, sans-serif;
+  background-color: #f1f2f3;
+  color: #30343a;
+  box-shadow: 0 4px 12px rgba(14, 18, 24, 0.20);
+  -luma-beam-fill-color: rgba(61, 68, 76, 0.24);
+  -luma-beam-marker-color: rgba(61, 68, 76, 0.55); }
+.luma-beam-shadow {
+  border-radius: 24px;
+  background-color: rgba(241, 242, 243, 0.01);
+  box-shadow: 0 34px 84px -24px rgba(14, 18, 24, 0.62); }
+.luma-beam-line {
+  border-radius: 24px;
+  border: 1px solid rgba(255, 255, 255, 0.72); }
+.luma-beam-row {
+  spacing: 10px;
+  padding: 0 16px 0 14px; }
+.luma-beam-row:rtl { padding: 0 14px 0 16px; }
+.luma-beam-glyph { width: 19px; height: 19px; }
+.luma-beam-icon { icon-size: 19px; }
+.luma-beam-value {
+  font-size: 15px;
+  font-weight: 750;
+  font-feature-settings: "tnum";
+  letter-spacing: -0.15px; }
+.luma-beam.luma-surface-dark {
+  background-color: #21252b;
+  color: #e9ebec;
+  box-shadow: 0 5px 16px rgba(0, 0, 0, 0.38);
+  -luma-beam-fill-color: rgba(230, 233, 235, 0.24);
+  -luma-beam-marker-color: rgba(230, 233, 235, 0.55); }
+.luma-beam.luma-surface-dark .luma-beam-line { border-color: rgba(255, 255, 255, 0.055); }
+.luma-beam-shadow.luma-surface-dark {
+  background-color: rgba(33, 37, 43, 0.01);
+  box-shadow: 0 38px 94px -26px rgba(0, 0, 0, 0.88); }
+.luma-beam.luma-surface-frost {
+  background-color: rgba(244, 245, 246, 0.80);
+  color: #30343a;
+  box-shadow: 0 5px 16px rgba(14, 18, 24, 0.20);
+  -luma-beam-fill-color: rgba(49, 55, 62, 0.24);
+  -luma-beam-marker-color: rgba(49, 55, 62, 0.55); }
+.luma-beam.luma-surface-frost .luma-beam-line { border-color: rgba(255, 255, 255, 0.62); }
+.luma-beam-shadow.luma-surface-frost {
+  background-color: rgba(241, 242, 243, 0.01);
+  box-shadow: 0 38px 94px -26px rgba(14, 18, 24, 0.62); }
+.luma-beam.luma-surface-glass {
+  background-color: rgba(22, 29, 40, 0.38);
+  color: #ffffff;
+  box-shadow: 0 5px 16px rgba(9, 15, 25, 0.24);
+  -luma-beam-fill-color: rgba(242, 245, 247, 0.24);
+  -luma-beam-marker-color: rgba(242, 245, 247, 0.55); }
+.luma-beam.luma-surface-glass .luma-beam-line { border-color: rgba(255, 255, 255, 0.34); }
+.luma-beam-shadow.luma-surface-glass {
+  background-color: rgba(22, 29, 40, 0.01);
+  box-shadow: 0 42px 100px -26px rgba(9, 15, 25, 0.76); }
+
 /* Luma notification-owned rules; safe to compile without the global Shell SCSS. */
 .notification-banner.luma-notification-card {
   min-height: 0;
