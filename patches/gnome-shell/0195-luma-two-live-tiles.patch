From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <builds@project-luma.local>
Date: Sat, 26 Sep 2026 00:00:00 +0000
Subject: [PATCH] luma: the shelf shows two live tiles at once

Studio Desktop holds up to two live tiles, the most urgent first: a call, a
recording, an event about to start, then music. A second live island shows
the second publication, music takes a place only while the budget has room,
and when the row would be wider than its edge the least urgent tile steps
aside until what is available changes.

diff --git a/js/ui/liveActivity.js b/js/ui/liveActivity.js
index 5dac991..68e9173 100644
--- a/js/ui/liveActivity.js
+++ b/js/ui/liveActivity.js
@@ -117,23 +117,57 @@ export function categoryIcon(item) {
     return CATEGORY_ICONS[categoryOf(item)] ?? GENERIC_ICON;
 }
 
-// The one publication the island shows: highest priority first, then the one
-// that started (or starts) soonest, then the one that expires soonest.
-export function pickActivity(items, nowMs = Date.now()) {
+// Calendar publishes the day's next event for its own purposes. The shelf
+// only joins that event from fifteen minutes before until ten minutes after
+// its start; the daemon's thirty-second updates wake the selectors below.
+export const EVENT_LEAD_MS = 15 * 60_000;
+export const EVENT_TAIL_MS = 10 * 60_000;
+export function isShown(item, nowMs = Date.now()) {
+    if (categoryOf(item) !== 'event')
+        return true;
+    const start = parseInstant(item.extension.starts_at);
+    return start !== null && nowMs >= start - EVENT_LEAD_MS &&
+        nowMs <= start + EVENT_TAIL_MS;
+}
+
+// The publications the shelf may show, most urgent first: highest priority,
+// then the one that started (or starts) soonest, then the one that expires
+// soonest.
+export function orderActivities(items, nowMs = Date.now()) {
     const when = item => parseInstant(item.extension.starts_at) ??
         parseInstant(item.extension.expires_at) ?? Number.MAX_SAFE_INTEGER;
-    // Calendar publishes the day's next event for its own purposes. The shelf
-    // only joins that event from fifteen minutes before until ten minutes
-    // after its start; the daemon's thirty-second updates wake this selector.
-    const visible = items.filter(item => {
-        if (categoryOf(item) !== 'event')
-            return true;
-        const start = parseInstant(item.extension.starts_at);
-        return start !== null && nowMs >= start - 15 * 60_000 &&
-            nowMs <= start + 10 * 60_000;
+    return items.filter(item => isShown(item, nowMs)).sort((a, b) =>
+        priorityOf(a) - priorityOf(b) || when(a) - when(b));
+}
+
+// The one publication an island shows on its own.
+export function pickActivity(items, nowMs = Date.now()) {
+    return orderActivities(items, nowMs)[0] ?? null;
+}
+
+// Studio Desktop: the shelf holds two live tiles at most, the most urgent
+// first -- a call, a recording, an event about to start, then music, then
+// weather, then the toggles. Music, weather and the toggles are not
+// publications; they rank among them by these values.
+export const LIVE_TILE_LIMIT = 2;
+export const TILE_PRIORITY = Object.freeze({music: PRIORITY.media, weather: 9.5, toggles: 10});
+
+// Which tiles show: `publications` in orderActivities order, `others` the
+// tiles that are available now ({music: true, weather: false, ...}). Returns
+// the publications to show, in order, and each other tile's verdict.
+export function chooseLiveTiles(publications, others = {}, limit = LIVE_TILE_LIMIT) {
+    const candidates = publications.map((item, index) =>
+        ({item, rank: priorityOf(item), index}));
+    Object.entries(TILE_PRIORITY).forEach(([name, rank], index) => {
+        if (others[name])
+            candidates.push({name, rank, index: publications.length + index});
     });
-    return visible.sort((a, b) =>
-        priorityOf(a) - priorityOf(b) || when(a) - when(b))[0] ?? null;
+    candidates.sort((a, b) => a.rank - b.rank || a.index - b.index);
+    const shown = candidates.slice(0, Math.max(0, limit));
+    const result = {publications: shown.filter(c => c.item).map(c => c.item)};
+    for (const name of Object.keys(TILE_PRIORITY))
+        result[name] = shown.some(c => c.name === name);
+    return result;
 }
 
