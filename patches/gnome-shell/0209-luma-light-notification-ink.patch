+++ b/js/ui/lumaNotificationBeacon.js
@@ -290,9 +290,10 @@
         const box = new St.BoxLayout({style_class: `luma-lip-pill${big ? ' big' : ''}`});
         if (this.dnd) box.add_child(glyph('moon', 13));
         const iconSize = big ? 18 : 14;
-        const iconStep = big ? 12 : 9;
+        const iconStep = big ? 13 : 9;
         const stack = new St.Widget({style_class: 'luma-lip-icon-stack',
