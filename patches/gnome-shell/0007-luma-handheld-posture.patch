diff --git a/data/theme/gnome-shell-sass/widgets/_panel.scss b/data/theme/gnome-shell-sass/widgets/_panel.scss
--- a/data/theme/gnome-shell-sass/widgets/_panel.scss
+++ b/data/theme/gnome-shell-sass/widgets/_panel.scss
@@ -275,5 +275,29 @@
     font-weight: 700;
     font-feature-settings: "tnum";
     text-align: center;
+  }
+}
+
+// Portrait handheld posture clears the camera cutout without turning the
+// entire top band into oversized chrome. Desktop geometry is unchanged.
+#panel.luma-handheld,
+#panel.luma-handheld:overview {
+  height: 42px;
+  background-color: #ffffff;
+  color: #202733;
+  box-shadow: 0 1px 0 rgba(30, 41, 59, 0.10);
+
+  .panel-button {
+    min-height: 38px;
+    color: #202733;
   }
+
+  .panel-button .system-status-icon {
+    icon-size: 17px;
+  }
+
+  #panelRight .panel-button {
+    margin-top: 2px;
+    margin-bottom: 2px;
+  }
 }
