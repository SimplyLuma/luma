diff --git a/js/ui/lumaDockWindows.js b/js/ui/lumaDockWindows.js
new file mode 100644
index 0000000..906be90
--- /dev/null
+++ b/js/ui/lumaDockWindows.js
@@ -0,0 +1,1225 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// The dock's windows. Under each app, a mark for every window it has open;
+// above it, on hover, a preview of those windows to pick one from.
+//
+// Mutter owns the windows: activation, unminimizing and closing (with the
+// application's own confirmation) all go through Meta.Window. Nothing here
+// holds a grab, so the dock, its menus and Grid keep their own input rules.
+import Atk from 'gi://Atk';
+import Clutter from 'gi://Clutter';
+import Cogl from 'gi://Cogl';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import Meta from 'gi://Meta';
+import Pango from 'gi://Pango';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import * as Main from './main.js';
+import * as SurfaceMaterials from './lumaSurfaceMaterials.js';
+import {smoothOffscreenSampling} from './iconMask.js';
+import {previewPlacement, windowMarkKinds} from './shelfMetrics.js';
+
+// Windows' taskbar thumbnails wait about as long; a preview already open, or
+// a tooltip already showing, moves to the next icon at once.
+const PREVIEW_HOVER_TIMEOUT = 400;
+// Long enough to travel from the icon, across the gap, into a card.
+const PREVIEW_CLOSE_TIMEOUT = 300;
+// With a preview open, another icon takes over only after the pointer rests
+// on it this long: a diagonal path up to a far card crosses the neighbours.
+const PREVIEW_SWITCH_TIMEOUT = 150;
+// After a preview closes, the next icon still opens at once for this long.
+const PREVIEW_WARM_TIMEOUT = 300;
+const PREVIEW_SHOW_TIME = 150;
+const PREVIEW_HIDE_TIME = 100;
+const PREVIEW_RISE = 4;
+const MARK_TIME = 150;
+
+// Thumbnail box and card measurements, logical pixels.
+const THUMB_MAX_WIDTH = 240;
+const THUMB_MAX_HEIGHT = 150;
+const THUMB_RADIUS = 8;
+const CARD_MIN_WIDTH = 160;
+const CARD_PADDING = 6;
+const CARD_GAP = 4;
+const POPOVER_PADDING = 6;
+const CARDS_PER_ROW = 5;
+
+const animations = () => St.Settings.get().enable_animations;
+const scaleFactor = () => St.ThemeContext.get_for_stage(global.stage).scale_factor;
+
+// The windows a person would call this app's windows: not the ones asking to
+// stay off the taskbar, and not dialogs attached to a parent, which are drawn
+// inside their parent's preview.
+export function appWindows(app) {
+    if (!app)
+        return [];
+    return app.get_windows().filter(window => !window.skip_taskbar &&
+        !window.is_attached_dialog() &&
+        window.get_window_type() !== Meta.WindowType.DESKTOP);
+}
+
+function isFocused(window, focus) {
+    return Boolean(focus) && (focus === window || focus.find_root_ancestor?.() === window);
+}
+
+function actorRect(actor) {
+    const [x, y] = actor.get_transformed_position();
+    const [width, height] = actor.get_transformed_size();
+    return {x, y, width, height};
+}
+
+// ── Marks ─────────────────────────────────────────────────────────────────
+
+const WindowMark = GObject.registerClass(
+class WindowMark extends St.Widget {
+    _init(key) {
+        super._init({style_class: 'luma-shelf-running-indicator luma-shelf-window-mark',
+            reactive: false, opacity: 0});
+        // Allocation changes follow this actor's easing state (see place()).
+        this.save_easing_state();
+        this.key = key;
+        this.kind = null;
+        this.box = null;
+        this.leaving = false;
+    }
+
+    setKind(kind) {
+        if (this.kind === kind)
+            return;
+        if (this.kind)
+            this.remove_style_class_name(this.kind);
+        this.kind = kind;
+        this.add_style_class_name(kind);
+        this._fade();
+    }
+
+    // Ink at 55% for every mark except the focused pill, which is full ink.
+    _fade(target = this.kind === 'focused' ? 255 : 140) {
+        this.remove_transition('opacity');
+        this.ease({opacity: target, duration: animations() && this.box ? MARK_TIME : 0,
+            mode: Clutter.AnimationMode.EASE_OUT_QUAD});
+    }
+
+    place(box) {
+        const first = !this.box;
+        this.box = box;
+        // A mark that already has a place slides and resizes into its new one;
+        // a new mark appears where it belongs and only fades in.
+        this.set_easing_duration(!first && animations() ? MARK_TIME : 0);
+        this.set_easing_mode(Clutter.AnimationMode.EASE_OUT_QUAD);
+        this.allocate(new Clutter.ActorBox({x1: box.x, y1: box.y,
+            x2: box.x + box.width, y2: box.y + box.height}));
+        if (first)
+            this._fade();
+    }
+
+    leave() {
+        this.leaving = true;
+        this.remove_transition('opacity');
+        this.ease({opacity: 0, duration: animations() ? MARK_TIME : 0,
+            mode: Clutter.AnimationMode.EASE_OUT_QUAD,
+            onStopped: () => this.destroy()});
+    }
+});
+
+// The marks under one dock icon. The shelf's indicator layer places the row;
+// the row places its marks.
+export const WindowMarks = GObject.registerClass(
+class WindowMarks extends St.Widget {
+    _init(app, tile) {
+        super._init({reactive: false});
+        this._app = app;
+        this._tile = tile;
+        this._marks = new Map();
+        this._watched = new Set();
+        this._geometry = null;
+        this.marks = [];
+        app?.connectObject('windows-changed', () => this._queueSync(), this);
+        global.display.connectObject('notify::focus-window', () => this._queueSync(), this);
+        Shell.WindowTracker.get_default().connectObject('notify::focus-app',
+            () => this._queueSync(), this);
+        this.connect('destroy', () => {
+            if (this._syncId)
+                GLib.source_remove(this._syncId);
+            this._syncId = 0;
+            for (const window of this._watched)
+                window.disconnectObject(this);
+            this._watched.clear();
+        });
+        this._sync();
+    }
+
+    _queueSync() {
+        if (this._syncId)
+            return;
+        // Focus moves out of one app and into another in separate
+        // notifications; settle once both have arrived.
+        this._syncId = GLib.idle_add(GLib.PRIORITY_DEFAULT, () => {
+            this._syncId = 0;
+            this._sync();
+            return GLib.SOURCE_REMOVE;
+        });
+    }
+
+    _sync() {
+        const windows = appWindows(this._app);
+        for (const window of windows) {
+            if (this._watched.has(window))
+                continue;
+            this._watched.add(window);
+            window.connectObject('notify::minimized', () => this._queueSync(), this);
+        }
+        for (const window of [...this._watched]) {
+            if (!windows.includes(window)) {
+                window.disconnectObject(this);
+                this._watched.delete(window);
+            }
+        }
+        const focus = global.display.focus_window;
+        let marks = windowMarkKinds(windows.map(window => ({
+            key: `${window.get_stable_sequence()}`,
+            focused: isFocused(window, focus),
+            minimized: window.minimized,
+        })));
+        // Running without a window of its own (a background service, a
+        // window the tracker has not matched yet): the plain running dot.
+        if (marks.length === 0) {
+            const focusApp = Shell.WindowTracker.get_default().focus_app;
+            marks = [{key: 'app', kind: focusApp && focusApp === this._app ? 'focused' : 'open'}];
+        }
+        if (JSON.stringify(marks) === JSON.stringify(this.marks))
+            return;
+        this.marks = marks;
+        const keys = new Set(marks.map(mark => mark.key));
+        for (const [key, mark] of this._marks) {
+            if (!keys.has(key)) {
+                this._marks.delete(key);
+                mark.leave();
+            }
+        }
+        for (const {key, kind} of marks) {
+            let mark = this._marks.get(key);
+            if (!mark) {
+                mark = new WindowMark(key);
+                this._marks.set(key, mark);
+                this.add_child(mark);
+            }
+            mark.setKind(kind);
+        }
+        // The marks are drawn, not focusable: a screen reader hears the same
+        // count as the icon's description ("3 windows, 1 minimized").
+        this.accessible_name = this._describe(windows);
+        this._tile?.get_accessible?.()?.set_description(this.accessible_name);
+        this.queue_relayout();
+    }
+
+    _describe(windows) {
+        const minimized = windows.filter(window => window.minimized).length;
+        if (windows.length === 0)
+            return '';
+        return minimized
+            ? _('%d windows, %d minimized').format(windows.length, minimized)
+            : windows.length === 1 ? _('1 window') : _('%d windows').format(windows.length);
+    }
+
+    // The indicator layer hands over the row and its marks, already in whole
+    // pixels, just before allocating the row.
+    setGeometry(geometry) {
+        this._geometry = geometry;
+    }
+
+    vfunc_get_preferred_width() {
+        return [0, 0];
+    }
+
+    vfunc_get_preferred_height() {
+        return [0, 0];
+    }
+
+    vfunc_allocate(box) {
+        this.set_allocation(box);
+        const boxes = this._geometry?.marks ?? [];
+        this.marks.forEach(({key}, index) => {
+            const mark = this._marks.get(key);
+            if (mark && boxes[index])
+                mark.place(boxes[index]);
+        });
+        // Leaving marks fade where they were.
+        for (const child of this.get_children()) {
+            if (child.leaving && child.box) {
+                child.set_easing_duration(0);
+                child.allocate(new Clutter.ActorBox({x1: child.box.x, y1: child.box.y,
+                    x2: child.box.x + child.box.width, y2: child.box.y + child.box.height}));
+            }
+        }
+    }
+});
+
+// ── Thumbnails ────────────────────────────────────────────────────────────
+
+// Rounds a live window thumbnail and shrinks it sharply. This is Grid's
+// preview recipe (lumaGrid.js, RoundedPreview): the window is laid out at its
+// own size and scaled as a whole, so the offscreen texture holds one texel per
+// window pixel, and each screen pixel averages a 4x4 grid of lookups across
+// the area it covers. A dock thumbnail is a tenth of the window, not half, so
+// the 16 lookups would be three texels apart and skip thin text strokes;
+// sampling them from the mipmap level two below the one the footprint asks
+// for lets each lookup average the texels between its neighbours.
+const RoundedThumbnail = GObject.registerClass(
+class RoundedThumbnail extends Shell.GLSLEffect {
+    vfunc_build_pipeline() {
+        this.add_glsl_snippet(Cogl.SnippetHook.FRAGMENT,
+            `uniform vec2 origin; uniform vec2 extent; uniform vec3 shape;
+             uniform vec2 footprint; uniform vec2 texel; uniform float pixel;
+             uniform float lod_bias;`,
+            `vec2 st = cogl_tex_coord_in[0].st;
+             vec2 spread = max(footprint - vec2(1.0), vec2(0.0)) * texel / 3.0;
+             vec4 sum = vec4(0.0);
+             for (int i = 0; i < 4; i++) {
+                 for (int j = 0; j < 4; j++)
+                     sum += texture2D(cogl_sampler0,
+                         st + (vec2(float(i), float(j)) - 1.5) * spread, lod_bias);
+             }
+             cogl_color_out = cogl_color_in * (sum / 16.0);
+             vec2 p = origin + st * extent;
+             vec2 q = abs(p - shape.xy * 0.5) - (shape.xy * 0.5 - vec2(shape.z));
+             float d = length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - shape.z;
+             cogl_color_out *= clamp(0.5 - d / pixel, 0.0, 1.0);`, true);
+    }
+
+    setShape(width, height, radius) {
+        this.set_uniform_float(this.get_uniform_location('shape'), 3, [width, height, radius]);
+    }
+
+    _textureOrigin(actor) {
+        const enlarge = (x1, width) => Math.ceil(x1 + width + 0.75) - Math.round(width) - 3;
+        const volume = actor.get_paint_volume();
+        if (volume && volume.get_width() * volume.get_height() !== 0) {
+            const origin = volume.get_origin();
+            return [Math.trunc(enlarge(origin.x, volume.get_width())),
+                Math.trunc(enlarge(origin.y, volume.get_height()))];
+        }
