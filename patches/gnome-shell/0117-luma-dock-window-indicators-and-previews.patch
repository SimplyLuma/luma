+// Where the window preview sits: 8 beyond the dock island's outer edge, like
+// the tooltip, centred on the icon along the shelf and kept 14 inside the
+// monitor. Rectangles are {x, y, width, height} in stage pixels.
+export function previewPlacement(edge, icon, island, size, monitor, scale = 1) {
+    const gap = 8 * scale;
+    const inset = SHELF_INSET * scale;
+    const clamp = (value, min, max) => Math.max(min, Math.min(value, Math.max(min, max)));
