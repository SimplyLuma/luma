+            if (!this._closing)
+                return;
+            this._closing = false;
+            popover.hide();
+            this._releaseHold();
+            popover.destroyCards();
+            this._icon?.disconnectObject(this);
+            this._app?.disconnectObject(this);
+            this._icon = null;
+            this._item = null;
+            this._app = null;
