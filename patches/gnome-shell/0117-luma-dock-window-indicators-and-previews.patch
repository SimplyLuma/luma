+
+// One mark per window, up to three, 2 apart and centred under the icon: the
+// focused window's 12x4 pill, a 4x4 dot for each other open window and a 4x4
+// ring for each minimized one. A fourth window and beyond adds one 2x2 dot at
+// the end, the way a page indicator shrinks its last dot to say there is more.
+export const WINDOW_MARKS_MAX = 3;
+export const WINDOW_MARK_GAP = 2;
+const WINDOW_MARK_LENGTH = {focused: 12, open: 4, minimized: 4, more: 2};
+
+// windows: [{key, focused, minimized}] most recently used first. The focused
+// window leads, then open windows, then minimized ones, each by recency. When
+// only three fit and a minimized window would fall off the end, it takes the
+// last place, so both kinds of window stay visible under the icon.
+export function windowMarkKinds(windows) {
+    const rank = window => window.focused ? 0 : window.minimized ? 2 : 1;
+    const ordered = windows.map((window, index) => ({window, index}))
+        .sort((a, b) => rank(a.window) - rank(b.window) || a.index - b.index)
+        .map(entry => entry.window);
+    const shown = ordered.slice(0, WINDOW_MARKS_MAX);
+    if (ordered.length > WINDOW_MARKS_MAX && !shown.some(window => window.minimized)) {
+        const minimized = ordered.find(window => window.minimized);
+        if (minimized)
+            shown[WINDOW_MARKS_MAX - 1] = minimized;
+    }
+    const marks = shown.map(window => ({key: window.key,
+        kind: window.focused ? 'focused' : window.minimized ? 'minimized' : 'open'}));
+    if (ordered.length > WINDOW_MARKS_MAX)
+        marks.push({key: 'more', kind: 'more'});
+    return marks;
+}
+
+// The row of marks under one icon, in the indicator layer's coordinates, and
+// each mark inside that row. Whole pixels throughout: a 4px dot on a half pixel
+// is resampled into a 5px smudge.
+export function windowMarkRow(edge, width, height, center, marks, scale = 1, padding = 8, rtl = false) {
+    const vertical = edge === 'left' || edge === 'right';
+    const depth = 4 * scale;
+    const gap = WINDOW_MARK_GAP * scale;
+    const lengths = marks.map(mark => (WINDOW_MARK_LENGTH[mark.kind] ?? 4) * scale);
+    const total = lengths.reduce((sum, length) => sum + length, 0) +
+        Math.max(0, marks.length - 1) * gap;
+    const start = Math.round(center - total / 2);
+    const clearance = (padding - 2) * scale;
+    const cross = vertical
+        ? (edge === 'left' ? clearance - depth : width - clearance)
+        : (edge === 'top' ? clearance - depth : height - clearance);
+    let offset = 0;
+    const boxes = marks.map((mark, index) => {
+        const length = lengths[index];
+        const thickness = mark.kind === 'more' ? 2 * scale : depth;
+        const inset = Math.round((depth - thickness) / 2);
+        const along = rtl && !vertical ? total - offset - length : offset;
+        offset += length + gap;
+        return vertical
+            ? {x: inset, y: along, width: thickness, height: length}
+            : {x: along, y: inset, width: length, height: thickness};
+    });
+    return {
+        row: vertical
+            ? {x: Math.round(cross), y: start, width: depth, height: total}
+            : {x: start, y: Math.round(cross), width: total, height: depth},
+        marks: boxes,
+    };
+}
