+    const centerY = icon.y + icon.height / 2;
+    let x, y;
+    if (edge === 'left' || edge === 'right') {
+        x = edge === 'left' ? island.x + island.width + gap : island.x - gap - size.width;
+        y = clamp(centerY - size.height / 2, monitor.y + inset,
+            monitor.y + monitor.height - inset - size.height);
+    } else {
+        x = clamp(centerX - size.width / 2, monitor.x + inset,
+            monitor.x + monitor.width - inset - size.width);
+        y = edge === 'top' ? island.y + island.height + gap : island.y - gap - size.height;
+    }
+    return {x: Math.round(x), y: Math.round(y)};
