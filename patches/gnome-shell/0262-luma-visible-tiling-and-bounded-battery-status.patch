diff --git a/js/ui/status/system.js b/js/ui/status/system.js
--- a/js/ui/status/system.js
+++ b/js/ui/status/system.js
@@ -21,6 +21,30 @@
 
 const BUS_NAME = 'org.freedesktop.UPower';
 const OBJECT_PATH = '/org/freedesktop/UPower/devices/DisplayDevice';
+
+export function lumaBatteryStatus(proxy) {
+    const state = proxy.State;
+    if (state === UPower.DeviceState.FULLY_CHARGED)
+        return _('Fully charged');
+    if (state === UPower.DeviceState.CHARGING)
+        return proxy.Percentage >= 99.5 ? _('Fully charged') : _('Charging');
+    if (state === UPower.DeviceState.PENDING_CHARGE)
+        return _('Plugged in');
+    if (state !== UPower.DeviceState.DISCHARGING || proxy.Percentage >= 100)
+        return '';
+    // Firmware sometimes reports stale or effectively infinite estimates.
+    // A percentage remains useful when no plausible discharge time exists.
+    const seconds = Number(proxy.TimeToEmpty);
+    if (!Number.isFinite(seconds) || seconds <= 0 || seconds > 48 * 60 * 60)
+        return '';
+    if (seconds < 60)
+        return _('Less than a minute left');
+    const hours = Math.floor(seconds / 3600);
+    const minutes = Math.floor(seconds % 3600 / 60);
+    return hours ? _('%d h %d min left').format(hours, minutes)
+        : _('%d min left').format(minutes);
+}
+
 
 const DisplayDeviceInterface = loadInterfaceXML('org.freedesktop.UPower.Device');
 const PowerManagerProxy = Gio.DBusProxy.makeProxyWrapper(DisplayDeviceInterface);
