From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <build@projectluma.org>
Date: Tue, 1 Sep 2026 16:20:00 -0500
Subject: [PATCH] Make login state atomic and use one native desktop Dash

The login avatar fills its rounded tile even when AccountsService supplies a
transparent circular source. Authentication progress atomically replaces the
submit glyph so the two never paint in the same frame.

Desktop Shelf and Activity View now share GNOME Shell's one Dash actor and
model. Handheld keeps its native Activity View Dash and does not construct the
desktop Shelf.
---

diff --git a/js/gdm/authPrompt.js b/js/gdm/authPrompt.js
index d0aabadc..37801aa2 100644
--- a/js/gdm/authPrompt.js
+++ b/js/gdm/authPrompt.js
@@ -537,6 +537,13 @@ export const AuthPrompt = GObject.registerClass({
     setActorInDefaultButtonWell(actor, animate) {
         actor ??= this._submitArrow;
 
+        const oldActor = this._defaultButtonWellActor;
+        // The submit glyph and verifier spinner occupy the same button well.
+        // Switch synchronously whenever progress enters or leaves so there is
+        // never a frame where both glyphs are painted on top of each other.
+        if (actor === this._spinner || oldActor === this._spinner)
+            animate = false;
+
         if (actor === this._spinner)
             this._spinner.play();
 
@@ -544,8 +551,6 @@ export const AuthPrompt = GObject.registerClass({
             !actor)
             return;
 
-        const oldActor = this._defaultButtonWellActor;
-
         if (oldActor)
             oldActor.remove_all_transitions();
 
diff --git a/js/ui/main.js b/js/ui/main.js
index cc842ec1..30ea456d 100644
--- a/js/ui/main.js
+++ b/js/ui/main.js
@@ -248,8 +248,6 @@ async function _initializeUI() {
 
     messageTray = new MessageTray.MessageTray();
     panel = new Panel.Panel();
-    if (!sessionMode.isGreeter)
-        shelf = new Shelf.Shelf();
     keyboard = new Keyboard.KeyboardManager();
     notificationDaemon = new NotificationDaemon.NotificationDaemon();
     windowAttentionHandler = new WindowAttentionHandler.WindowAttentionHandler();
@@ -274,6 +272,9 @@ async function _initializeUI() {
 
     layoutManager.init();
     overview.init();
+    if (!sessionMode.isGreeter &&
+        GLib.getenv('LUMA_DEVICE_CLASS') !== 'handheld')
+        shelf = new Shelf.Shelf();
 
     new PointerA11yTimeout.PointerA11yTimeout();
 
diff --git a/js/ui/overviewControls.js b/js/ui/overviewControls.js
index 61c1b460..3ee4ea4c 100644
--- a/js/ui/overviewControls.js
+++ b/js/ui/overviewControls.js
@@ -187,19 +187,23 @@ class ControlsManagerLayout extends Clutter.LayoutManager {
 
         availableHeight -= searchHeight + spacing;
 
-        // Dash
-        const maxDashHeight = this._handheldMode
-            ? 0
-            : Math.round(box.get_height() * DASH_MAX_HEIGHT_RATIO);
-        this._dash.setMaxSize(width, maxDashHeight);
-
-        let [, dashHeight] = this._dash.get_preferred_height(width);
-        dashHeight = Math.min(dashHeight, maxDashHeight);
-        childBox.set_origin(0, startY + height - dashHeight);
-        childBox.set_size(width, dashHeight);
-        this._dash.allocate(childBox);
-
-        availableHeight -= dashHeight + spacing;
+        // Desktop Luma adopts this actor into the persistent Shelf. Allocate
+        // it here only while Overview still owns it (including handheld).
+        const ownsDash = this._dash.get_parent() === container;
+        let dashHeight = 0;
+        if (ownsDash) {
+            const maxDashHeight = this._handheldMode
+                ? 0
+                : Math.round(box.get_height() * DASH_MAX_HEIGHT_RATIO);
+            this._dash.setMaxSize(width, maxDashHeight);
+
+            [, dashHeight] = this._dash.get_preferred_height(width);
+            dashHeight = Math.min(dashHeight, maxDashHeight);
+            childBox.set_origin(0, startY + height - dashHeight);
+            childBox.set_size(width, dashHeight);
+            this._dash.allocate(childBox);
+            availableHeight -= dashHeight + spacing;
+        }
 
         // Workspace Thumbnails
         let thumbnailsHeight = 0;
@@ -866,16 +870,17 @@ class ControlsManager extends St.Widget {
                 mode: Clutter.AnimationMode.EASE_OUT_QUAD,
             }));
 
-        // The Dash rises from the bottom. This is the last animation to finish,
-        // so resolve the promise there.
-        this.dash.translation_y = this.dash.height + this.dash.margin_bottom;
-        startupPromises.push(
-            this.dash.easeAsync({
-                translation_y: 0,
-                delay: STARTUP_ANIMATION_TIME,
-                duration: STARTUP_ANIMATION_TIME,
-                mode: Clutter.AnimationMode.EASE_OUT_QUAD,
-            }));
+        if (this.dash.get_parent() === this) {
+            // The Dash rises from the bottom only when Overview owns it.
+            this.dash.translation_y = this.dash.height + this.dash.margin_bottom;
+            startupPromises.push(
+                this.dash.easeAsync({
+                    translation_y: 0,
+                    delay: STARTUP_ANIMATION_TIME,
+                    duration: STARTUP_ANIMATION_TIME,
+                    mode: Clutter.AnimationMode.EASE_OUT_QUAD,
+                }));
+        }
 
         return Promise.allSettled(startupPromises);
     }
