@@ -278,6 +278,51 @@ $panel_transition_duration: 250ms; // same as the overview transition duration
   }
 }
 
+// Live Extensions are structured application state rendered entirely by the
+// system Shell. Applications cannot inject actors, markup, or styling here.
+.luma-live-extension {
+  margin: 3px 0;
+  border: 1px solid rgba(17, 24, 39, 0.10);
+  border-radius: 9px;
+  background-color: rgba(255, 255, 255, 0.72);
+  color: #1f2937;
+
+  &:hover, &:focus {
+    background-color: rgba(255, 255, 255, 0.92);
+  }
+
+  &:active {
+    background-color: rgba(72, 120, 184, 0.14);
+  }
+
+  .luma-live-extension-content {
+    spacing: 7px;
+    padding: 2px 9px;
+  }
+
+  .luma-live-extension-icon {
+    icon-size: 16px;
+    color: #4878b8;
+  }
+
+  .luma-live-extension-text {
+    spacing: 0;
+    width: 180px;
+  }
+
+  .luma-live-extension-title {
+    font-size: 11px;
+    font-weight: 600;
+    color: #1f2937;
+  }
+
+  .luma-live-extension-subtitle {
+    font-size: 9px;
+    font-weight: 500;
+    color: #6b7280;
+  }
+}
+
 // Portrait handheld posture clears the camera cutout without turning the
 // entire top band into oversized chrome. Desktop geometry is unchanged.
 #panel.luma-handheld,
