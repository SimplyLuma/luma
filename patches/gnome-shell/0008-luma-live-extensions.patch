@@ -1,9 +1,11 @@
 import Atk from 'gi://Atk';
 import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
 import GLib from 'gi://GLib';
 import GObject from 'gi://GObject';
 import Graphene from 'gi://Graphene';
 import Meta from 'gi://Meta';
+import Pango from 'gi://Pango';
 import St from 'gi://St';
 
 import * as Config from '../misc/config.js';
@@ -37,6 +39,142 @@ import {InputSourceIndicator} from './status/keyboard.js';
 import {DwellClickIndicator} from './status/dwellClick.js';
 import {ScreenRecordingIndicator, ScreenSharingIndicator} from './status/remoteAccess.js';
 
+const LUMA_LIVE_EXTENSIONS_BUS = 'org.projectluma.SemanticBroker1';
+const LUMA_LIVE_EXTENSIONS_PATH = '/org/projectluma/SemanticBroker1';
+const LUMA_LIVE_EXTENSIONS_INTERFACE = 'org.projectluma.SemanticBroker1';
+
+const LiveExtensionsIndicator = GObject.registerClass(
+class LiveExtensionsIndicator extends PanelMenu.Button {
+    _init() {
+        super._init(0.5, _('Ongoing activity'), true);
+        this.add_style_class_name('luma-live-extension');
+        this._handheld = GLib.getenv('LUMA_DEVICE_CLASS') === 'handheld';
+        this._current = null;
+
+        this._icon = new St.Icon({
+            style_class: 'luma-live-extension-icon',
+            icon_name: 'x-office-calendar-symbolic',
+            y_align: Clutter.ActorAlign.CENTER,
+        });
+        this._title = new St.Label({
+            style_class: 'luma-live-extension-title',
+            y_align: Clutter.ActorAlign.CENTER,
+        });
+        this._title.clutter_text.ellipsize = Pango.EllipsizeMode.END;
+        this._title.clutter_text.single_line_mode = true;
+        this._subtitle = new St.Label({
+            style_class: 'luma-live-extension-subtitle',
+            y_align: Clutter.ActorAlign.CENTER,
+        });
+        this._subtitle.clutter_text.ellipsize = Pango.EllipsizeMode.END;
+        this._subtitle.clutter_text.single_line_mode = true;
+        const text = new St.BoxLayout({
+            style_class: 'luma-live-extension-text',
+            vertical: true,
+        });
+        text.add_child(this._title);
+        text.add_child(this._subtitle);
+        const content = new St.BoxLayout({
+            style_class: 'luma-live-extension-content',
+        });
+        content.add_child(this._icon);
+        content.add_child(text);
+        this.add_child(content);
+
+        const click = new Clutter.ClickGesture();
+        click.set_recognize_on_press(true);
+        click.connect('recognize', () => this._openApplication());
+        this.add_action(click);
+
+        this._signal = Gio.DBus.session.signal_subscribe(
+            LUMA_LIVE_EXTENSIONS_BUS,
+            LUMA_LIVE_EXTENSIONS_INTERFACE,
+            'LiveExtensionsChanged',
+            LUMA_LIVE_EXTENSIONS_PATH,
+            null,
+            Gio.DBusSignalFlags.NONE,
+            () => this._refresh());
+        this.connect('destroy', () => {
+            if (this._signal)
+                Gio.DBus.session.signal_unsubscribe(this._signal);
+            this._signal = 0;
+        });
+        this.hide();
+        this._refresh();
+    }
+
+    _refresh() {
+        Gio.DBus.session.call(
+            LUMA_LIVE_EXTENSIONS_BUS,
+            LUMA_LIVE_EXTENSIONS_PATH,
+            LUMA_LIVE_EXTENSIONS_INTERFACE,
+            'ListLiveExtensions',
+            null,
+            new GLib.VariantType('(aa{sv})'),
+            Gio.DBusCallFlags.NONE,
+            3000,
+            null,
+            (connection, result) => {
+                try {
+                    const [reply] = connection.call_finish(result).recursiveUnpack();
+                    const extensions = Array.isArray(reply)
+                        ? reply.filter(item => this._isValidExtension(item))
+                        : [];
+                    extensions.sort((a, b) =>
+                        (a.extension.starts_at ?? a.extension.expires_at).localeCompare(
+                            b.extension.starts_at ?? b.extension.expires_at));
+                    this._setExtension(extensions[0] ?? null);
+                } catch (error) {
+                    console.debug(`Luma Live Extensions unavailable: ${error}`);
+                    this._setExtension(null);
+                }
+            });
+    }
+
+    _isValidExtension(item) {
+        if (!item || typeof item !== 'object' ||
+            typeof item.application_id !== 'string' ||
+            !item.extension || typeof item.extension !== 'object')
+            return false;
+
+        const extension = item.extension;
+        return typeof extension.title === 'string' &&
+            (extension.subtitle === undefined ||
+                typeof extension.subtitle === 'string') &&
+            (extension.starts_at === undefined ||
+                typeof extension.starts_at === 'string') &&
+            typeof extension.expires_at === 'string';
+    }
+
+    _setExtension(item) {
+        this._current = item;
+        if (!item || this._handheld) {
+            this.hide();
+            return;
+        }
+        const extension = item.extension;
+        this._title.text = extension.title;
+        this._subtitle.text = extension.subtitle ?? '';
+        this._subtitle.visible = Boolean(extension.subtitle);
+        this.accessible_name = extension.subtitle
+            ? `${extension.title}, ${extension.subtitle}`
+            : extension.title;
+        this.show();
+    }
+
+    _openApplication() {
+        if (!this._current)
+            return;
+        const application = Gio.DesktopAppInfo.new(
+            `${this._current.application_id}.desktop`);
+        try {
+            application?.launch([], null);
+        } catch (error) {
+            console.error(`Unable to open Live Extension application: ${error.message}`);
+        }
+    }
+});
+
 const BUTTON_DND_ACTIVATION_TIMEOUT = 250;
 
 const N_QUICK_SETTINGS_COLUMNS = 2;
