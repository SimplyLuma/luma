 // Media's boundary with status is fixed; spare space belongs to other gaps.
-export function shelfGaps(children, media, status, gap, spare = 0) {
-    // The status cluster is anchored at the end of the shelf, so whatever sits
-    // immediately before it belongs against it: one padding away, with the
-    // slack spent on the gaps further back. Only the media island used to be
-    // treated that way, by name. A live extension island landing in that same
-    // position was handed an even share of the leftover space on both sides
-    // instead, which is why it read as floating loose between the dock and the
-    // clock rather than belonging to the clock. Pinning by position covers the
-    // media island exactly as before and anything else that lands there.
-    const mediaPair = children.findIndex((child, index) =>
-        child === media && children[index + 1] === status);
+export function shelfGaps(children, media, status, gap, spare = 0, live = null) {
+    // The status cluster is anchored at the end of the shelf, and the islands
+    // that belong to it -- the media player and the live extension island --
+    // sit against it, one padding apart, as one group. The slack is spent on
+    // the gaps further back, towards the dock.
+    //
+    // Only the gap directly before the status cluster used to be pinned. With
+    // media and a live island both showing, the live island was then handed
+    // an even share of the slack on each side and floated in the middle of the
+    // shelf between the dock and the media player, and flew back beside the
+    // clock the moment the player closed.
     const gaps = children.slice(0, -1);
-    // Pinning the gap before the status cluster is what keeps a live extension
-    // island against the clock. But on a shelf holding only the dock and the
-    // clock that same gap is the only thing there is, and the slack inside it
-    // is what carries the cluster to the right edge of the screen -- pinning it
-    // tight left the clock sitting next to the dock in the middle of the shelf.
-    // So it is only pinned when some earlier gap can take the slack instead.
-    // The media island keeps its own pin either way: the allocation treats a
-    // lone media-and-status pair as right-anchored already, so it needs no
-    // slack of its own.
-    const pinned = mediaPair >= 0
-        ? mediaPair
-        : (gaps.length > 1 ? children.indexOf(status) - 1 : -1);
-    const flexible = gaps.length - (pinned >= 0 ? 1 : 0);
-    return gaps.map((_child, index) => index === pinned
+    const statusIndex = children.indexOf(status);
+    const pinned = new Set();
+    for (let index = statusIndex - 1;
+        index >= 0 && (children[index] === media || (live && children[index] === live));
+        index--)
+        pinned.add(index);
+    // Whatever else sits before the cluster still hugs it -- but on a shelf
+    // holding only the dock and the clock that single gap is what carries the
+    // clock to the right edge, so it keeps the slack instead of being pinned.
+    if (!pinned.size && statusIndex > 0 && gaps.length > 1)
+        pinned.add(statusIndex - 1);
+    const flexible = gaps.length - pinned.size;
+    return gaps.map((_child, index) => pinned.has(index)
         ? gap : gap + (flexible ? spare / flexible : 0));
 }
+
+// Whether every island on the shelf belongs with the status cluster, in which
+// case nothing takes the slack and the whole group is anchored at the end.
+export function anchoredToStatus(children, media, status, live = null) {
+    return children.length > 1 && children[children.length - 1] === status &&
+        children.slice(0, -1).every(child => child === media || (live && child === live));
+}
