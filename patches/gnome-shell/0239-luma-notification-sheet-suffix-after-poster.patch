From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <builds@project-luma.local>
Date: Sat, 26 Sep 2026 00:00:00 +0000
Subject: [PATCH] luma: keep the generated notification rules last after the
 sign-in sheets

The Poster sign-in and lock rules were appended after the notification-owned
suffix of gnome-shell-dark, -light and -high-contrast.css, so the build's
verify-generated.sh check failed. Move them in front of the suffix; no rule
changes.

diff --git a/data/theme/gnome-shell-dark.css b/data/theme/gnome-shell-dark.css
index 9da2e92..b38b7df 100644
--- a/data/theme/gnome-shell-dark.css
+++ b/data/theme/gnome-shell-dark.css
@@ -4681,1011 +4681,1010 @@ StScrollBar {
 .quick-settings.luma-studio-options .luma-options-detail > .popup-menu-section.luma-options-near-empty { padding: 0; background-color: transparent; box-shadow: none; }
 .quick-settings.luma-studio-options.luma-surface-light .luma-options-detail .luma-options-nearby { color: rgba(22,25,29,.76); }
 .quick-settings.luma-studio-options.luma-surface-light .luma-options-detail .luma-options-off { color: rgba(22,25,29,.56); }
-/* Luma notification-owned rules; safe to compile without the global Shell SCSS. */
-.notification-banner.luma-notification-card {
-  min-height: 0;
-  width: auto;
-  margin: 0;
-  padding: 10px 11px;
-  border: 1px solid transparent;
-  border-radius: 10px;
-  box-shadow: 0 3px 10px rgba(10, 14, 19, 0.16);
+/* Poster: the same native GDM and unlock actors share this composition. */
+.login-dialog, .unlock-dialog, #lockDialogGroup,
+.prairie-login-background {
+  background-color: #0d0d0f;
+  color: #eceeed; }
+
+.prairie-login-wallpaper {
+  background-image: url("file:///usr/share/backgrounds/luma/prism.png");
+  background-position: 30% center;
+  background-size: cover; }
+
+.prairie-login-wallpaper-overlay {
+  background-image: url("resource:///org/gnome/shell/theme/poster-photo-overlay.svg");
+  background-size: 100% 100%; }
+
+.poster-day {
+  spacing: 22px;
+  color: white;
+  text-shadow: 0 2px 30px rgba(0, 0, 0, 0.25); }
+
+.poster-weekday {
   font-family: "Figtree";
