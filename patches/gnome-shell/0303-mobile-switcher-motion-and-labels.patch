     // Travel animates each card's allocation between its window's place on
     // the desktop and its place in the row. Scaling a card instead would draw
     // its preview texture at the row's size and stretch it over the window.
+    // Mobile uses fixed card geometry and one opacity timeline in both
+    // directions. No per-frame preview layout, blur-radius update or resize.
+    _fadeMobile(leaving, onDone) {
+        const start = this._travelProgress ?? (leaving ? 1 : 0);
+        const previous = this._travelTimeline;
+        this._travelTimeline = null;
+        previous?.stop();
+        this._cancelTravelStart();
+        this._travelLeaving = leaving;
+        this._stage.clip_to_allocation = true;
+        this._cards.forEach(card => {
+            card.remove_all_transitions();
+            card.translation_y = 0;
+            card.setCloseShown(false);
+        });
+        const home = Main.presentation?._home;
+        const fadingHome = Boolean(home?.visible);
+        const target = leaving ? 0 : 1;
+        const paint = progress => {
+            this._travelProgress = progress;
+            this._stage.opacity = Math.round(255 * progress);
+            this._wallpaper.opacity = Math.round(255 * progress);
+            if (fadingHome) home.opacity = Math.round(255 * (1 - progress));
+        };
+        paint(start);
+        const timeline = this._travelTimeline = new Clutter.Timeline({actor: this,
+            duration: St.Settings.get().enable_animations
+                ? Math.max(1, Math.round(220 * Math.abs(target - start))) : 1,
+            progress_mode: Clutter.AnimationMode.EASE_OUT_QUAD});
+        timeline.connect('new-frame', () => paint(lerp(start, target, timeline.get_progress())));
+        timeline.connect('stopped', (_timeline, finished) => {
+            if (this._travelTimeline !== timeline) return;
+            this._travelTimeline = null;
+            if (!finished) return;
+            paint(target);
+            if (!leaving && fadingHome) { home.hide(); home.opacity = 255; }
+            onDone();
+        });
+        // Home can need its first layout when returning from an app. Start
+        // after that paint in either direction, so it cannot consume the fade.
+        this._travelStartId = global.stage.connect_after('after-paint', () => {
+            this._cancelTravelStart();
+            if (this._travelTimeline === timeline) timeline.start();
+        });
+        this.queue_redraw();
+    }
