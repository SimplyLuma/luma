+        ['music', _('Music'), ['music', 'rhythmbox', 'tide']],
+        ['place', _('Place'), ['map', 'place']],
+    ];
+    for (const [kind, label, markers] of kinds) {
+        if (markers.some(marker => identity.includes(marker)))
+            return {kind, label};
+    }
+    return {kind: 'app', label: _('App')};
