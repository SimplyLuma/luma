diff --git a/data/theme/luma-notifications/verify-generated.sh b/data/theme/luma-notifications/verify-generated.sh
new file mode 100755
index 0000000..05d2d28
--- /dev/null
+++ b/data/theme/luma-notifications/verify-generated.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+set -eu
+
+fragment_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+theme_dir=$(CDPATH= cd -- "$fragment_dir/.." && pwd)
+sassc_bin=${LUMA_NOTIFICATION_SASSC:-sassc}
+verify_dir=$(mktemp -d "${TMPDIR:-/tmp}/luma-notification-css.XXXXXX")
+trap 'rm -rf "$verify_dir"' EXIT HUP INT TERM
+
+for variant in dark light high-contrast; do
+    "$sassc_bin" -a "$fragment_dir/$variant.scss" "$verify_dir/$variant.css"
+    cmp "$verify_dir/$variant.css" "$fragment_dir/$variant.css"
+
+    fragment_bytes=$(wc -c < "$fragment_dir/$variant.css" | tr -d ' ')
+    tail -c "$fragment_bytes" "$theme_dir/gnome-shell-$variant.css" |
+        cmp - "$fragment_dir/$variant.css"
+done
+
+echo 'PASS: standalone notification CSS is compiler-current and exact stylesheet suffix'
