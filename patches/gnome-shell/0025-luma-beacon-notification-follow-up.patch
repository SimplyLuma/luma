diff --git a/data/theme/luma-notifications/_surface.scss b/data/theme/luma-notifications/_surface.scss
new file mode 100644
index 0000000..b9b5eda
--- /dev/null
+++ b/data/theme/luma-notifications/_surface.scss
@@ -0,0 +1,198 @@
+/* Luma notification-owned rules; safe to compile without the global Shell SCSS. */
+.notification-banner {
+  min-height: 64px;
+  width: 333px;
+  padding: 11px 12px;
+  color: $note-ink;
+  background-color: $note-surface;
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .08),
+              0 3px 10px rgba(8, 12, 17, .18),
+              0 20px 44px -20px rgba(8, 12, 17, .54);
+  border: 1px solid $note-border;
+  border-radius: 10px;
+  margin: 0;
+  font-family: "Figtree";
+
+  .message-header {
+    spacing: 10px;
+    padding: 0;
+
+    .message-source-icon {
+      icon-size: 16px;
+      min-width: 30px;
+      min-height: 30px;
+      border-radius: 9px;
+    }
+    .message-header-content {
+      spacing: 7px;
+      min-height: 30px;
+      padding-bottom: 0;
+    }
+    .message-source-title {
+      font-size: 11px;
+      font-weight: 700;
+      letter-spacing: 1.1px;
+    }
+    .event-time {
+      font-size: 11px;
+      font-weight: 600;
+      padding-bottom: 0;
+    }
+    .message-close-button {
+      min-width: 20px;
+      min-height: 20px;
+      width: 20px;
+      height: 20px;
+      padding: 0;
+      margin: 0;
+      opacity: 0;
+      border-radius: 999px;
+      background-color: transparent;
+
+      &:hover, &:focus { opacity: 1; }
+    }
+  }
+
+  &:hover .message-close-button,
+  &:focus .message-close-button { opacity: 1; }
+
+  .message-box {
+    padding: 1px 0 0 40px;
+    margin: 0;
+    spacing: 10px;
+    .message-content { spacing: 2px; }
+    .message-title { font-size: 13px; font-weight: 650; }
+    .message-body { font-size: 13px; font-weight: 500; }
+  }
+  .message-action-bin {
+    padding: 7px 0 0 40px;
+    spacing: 4px;
+  }
+
+  &.luma-notification-urgent {
+    border-color: rgba($note-ring-neutral, .60);
+    box-shadow: 0 0 0 2px rgba($note-ring-neutral, .18),
+                0 20px 44px -20px rgba(8, 12, 17, .54);
+  }
+  @if not $note-high-contrast {
+    &.luma-notification-urgent.luma-notification-tone-messages,
+    &.luma-notification-urgent.luma-notification-tone-phone {
+      border-color: rgba($note-ring-messages, .60);
+      box-shadow: 0 0 0 2px rgba($note-ring-messages, .18),
+                  0 20px 44px -20px rgba(8, 12, 17, .54);
+    }
+    &.luma-notification-urgent.luma-notification-tone-calendar {
+      border-color: rgba($note-ring-calendar, .60);
+      box-shadow: 0 0 0 2px rgba($note-ring-calendar, .18),
+                  0 20px 44px -20px rgba(8, 12, 17, .54);
+    }
+    &.luma-notification-urgent.luma-notification-tone-mail,
+    &.luma-notification-urgent.luma-notification-tone-files {
+      border-color: rgba($note-ring-mail, .60);
+      box-shadow: 0 0 0 2px rgba($note-ring-mail, .18),
+                  0 20px 44px -20px rgba(8, 12, 17, .54);
+    }
+    &.luma-notification-urgent.luma-notification-tone-depot {
+      border-color: rgba($note-ring-depot, .60);
+      box-shadow: 0 0 0 2px rgba($note-ring-depot, .18),
+                  0 20px 44px -20px rgba(8, 12, 17, .54);
+    }
+
+    &.luma-notification-tone-messages .message-source-icon,
+    &.luma-notification-tone-phone .message-source-icon { background-color: $note-mark-messages; }
+    &.luma-notification-tone-calendar .message-source-icon { background-color: $note-mark-calendar; }
+    &.luma-notification-tone-mail .message-source-icon,
+    &.luma-notification-tone-files .message-source-icon { background-color: $note-mark-mail; }
+    &.luma-notification-tone-depot .message-source-icon { background-color: $note-mark-depot; }
+    &.luma-notification-tone-neutral .message-source-icon { background-color: $note-mark-neutral; }
+  }
+
+  @if $note-high-contrast {
+    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .40);
+    &.luma-notification-urgent {
+      border-color: #ffffff;
+      box-shadow: inset 0 0 0 2px #ffffff;
+    }
+    &.luma-notification-tone-messages .message-source-icon,
+    &.luma-notification-tone-phone .message-source-icon,
+    &.luma-notification-tone-calendar .message-source-icon,
+    &.luma-notification-tone-mail .message-source-icon,
+    &.luma-notification-tone-files .message-source-icon,
+    &.luma-notification-tone-depot .message-source-icon,
+    &.luma-notification-tone-neutral .message-source-icon {
+      background-color: #ffffff;
+      color: #000000;
+    }
+  }
+}
+
+.notification-buttons-bin { spacing: 4px; }
+.notification-button {
+  min-height: 23px;
+  padding: 5px 11px;
+  border-radius: 999px;
+  font-size: 11px;
+  font-weight: 650;
+}
+.luma-notification-action-box { spacing: 4px; }
+.luma-inline-reply-row { spacing: 4px; min-height: 28px; }
+.luma-inline-reply-entry {
+  min-height: 28px;
+  padding: 0 10px;
+  border-radius: 999px;
+  font-size: 12px;
+}
+.luma-inline-reply-button {
+  min-height: 28px;
+  padding: 0 11px;
+  border-radius: 999px;
+  font-size: 11px;
+  font-weight: 650;
+}
+
+#panel .panel-button.clock-display .messages-indicator {
+  max-width: 220px;
+  min-height: 34px;
+  padding: 3px 7px;
+  spacing: 8px;
+  border-radius: 10px;
+  color: $note-beacon-ink;
+  background-color: $note-beacon-surface;
+  border: if($note-high-contrast, 2px solid #ffffff, 1px solid $note-beacon-border);
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .10),
+              0 3px 10px rgba(8, 12, 17, .16);
+  font-family: "Figtree";
+
+  .messages-indicator-mark {
+    icon-size: 14px;
+    min-width: 26px;
+    min-height: 26px;
+    border-radius: 8px;
+    color: #ffffff;
+    background-color: #4d5a68;
+
+    @if $note-high-contrast {
+      color: #000000;
+      background-color: #ffffff;
+    }
+  }
+  .messages-indicator-copy { max-width: 142px; spacing: 0; }
+  .messages-indicator-title { font-size: 11px; font-weight: 700; }
+  .messages-indicator-summary {
+    color: $note-summary-ink;
+    font-size: 10px;
+    font-weight: 600;
+  }
+  .messages-indicator-count {
+    min-width: 19px;
+    height: 19px;
+    padding: 0 5px;
+    border-radius: 999px;
+    background-color: $note-count-surface;
+    color: $note-count-ink;
+    font-size: 9px;
+    font-weight: 700;
+    font-feature-settings: "tnum";
+    text-align: center;
+  }
+}
