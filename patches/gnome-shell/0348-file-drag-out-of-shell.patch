diff --git a/js/ui/lumaFileDrag.js b/js/ui/lumaFileDrag.js
new file mode 100644
index 0000000..ce7c11d
--- /dev/null
+++ b/js/ui/lumaFileDrag.js
@@ -0,0 +1,500 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Files dragged out of the Shell.
+//
+// A Shell surface that shows files lets them be dragged as if they came from
+// Filer: into Filer and every other application, Wayland or X11, sandboxed or
+// not, browser drop zones included, and onto the Shell's own file targets (an
+// application's dock tile opens them, a dock folder takes them in). The
+// surface says which actor shows which files and how to step aside; this
+// module owns the gesture, the drag image, the data and the drop.
+//
+// The drag is Mutter's MetaDataDrag, a compositor-owned Wayland drag source,
+// so clients see an ordinary drag and Xwayland gets it through the XDND
+// bridge. It offers what Filer offers, in Filer's order: paths as text, the
+// URI list, and the document portal's transfer key for sandboxed targets.
+// Shift moves and Control copies, as in Filer; with neither a drop copies,
+// because a drag out of a folder's preview must never empty that folder by
+// accident.
+//
+// Pointer: a press becomes a drag once it has travelled DRAG_THRESHOLD, so a
+// click is always a click. Touch: a long press lifts the item and the first
+// movement after it drags; moving before that is a scroll and belongs to the
+// list.
+
+import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import Meta from 'gi://Meta';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import * as Main from './main.js';
+
+import * as Model from './lumaFileDragModel.js';
+
+export const {Action, DRAG_THRESHOLD, LONG_PRESS_MS, TOUCH_SLOP, MAX_FILES} = Model;
+const SENDER = 'shell';
+const PREVIEW_SIZE = 96;
+const PREVIEW_STACK = 3;
+const PORTAL_BUS = 'org.freedesktop.portal.Documents';
+const PORTAL_PATH = '/org/freedesktop/portal/documents';
+const PORTAL_IFACE = 'org.freedesktop.portal.FileTransfer';
+const PORTAL_BATCH = 16;
+const PORTAL_STOP_DELAY_S = 30;
+
+// Only local files can be dragged: a path is what every target reads.
+export function draggable(files) {
+    return files.filter(file => file?.get_path?.()).slice(0, MAX_FILES);
+}
+
+function bytes(text) {
+    return new GLib.Bytes(new TextEncoder().encode(text));
+}
+
+function scale() {
+    return St.ThemeContext.get_for_stage(global.stage).scale_factor;
+}
+
+export function isSupported() {
+    return typeof Meta.DataDrag?.new === 'function';
+}
+
+// ── The document portal ─────────────────────────────────────────────────────
+//
+// A sandboxed target cannot open a host path. The portal's FileTransfer
+// hands it the same files as documents: the source registers descriptors
+// under a key, and the target exchanges the key for paths it can open. The
+// key stays valid for every target that asks until the drag is over.
+
+class PortalTransfer {
+    constructor(paths) {
+        this._paths = paths;
+        this._key = null;
+        this._stopped = false;
+        this.ready = this._start();
+    }
+
+    _call(method, parameters, fdList = null) {
+        return new Promise((resolve, reject) => {
+            Gio.DBus.session.call_with_unix_fd_list(PORTAL_BUS, PORTAL_PATH, PORTAL_IFACE,
+                method, parameters, null, Gio.DBusCallFlags.NONE, 5000, fdList, null,
+                (connection, result) => {
+                    try {
+                        const [reply] = connection.call_with_unix_fd_list_finish(result);
+                        resolve(reply);
+                    } catch (error) {
+                        reject(error);
+                    }
+                });
+        });
+    }
+
+    async _register(writable) {
+        const options = {
+            writable: GLib.Variant.new_boolean(writable),
+            autostop: GLib.Variant.new_boolean(false),
+        };
+        const reply = await this._call('StartTransfer',
+            new GLib.Variant('(a{sv})', [options]));
+        const [key] = reply.deep_unpack();
+        try {
+            for (let start = 0; start < this._paths.length; start += PORTAL_BATCH) {
+                const batch = this._paths.slice(start, start + PORTAL_BATCH);
+                const fds = Shell.util_open_paths(batch);
+                await this._call('AddFiles', new GLib.Variant('(saha{sv})',
+                    [key, batch.map((_path, i) => i), {}]), fds);
+            }
+        } catch (error) {
+            this._stop(key);
+            throw error;
+        }
+        return key;
+    }
+
+    // Writable like Filer's, so an editor can save in place; a file that
+    // cannot be written is still offered, read-only.
+    async _start() {
+        try {
+            try {
+                this._key = await this._register(true);
+            } catch (error) {
+                this._key = await this._register(false);
+            }
+        } catch (error) {
+            console.debug(`Luma file drag: no document portal transfer: ${error.message}`);
+            return null;
+        }
+        if (this._stopped)
+            this._stop(this._key);
+        return this._key;
+    }
+
+    _stop(key) {
+        if (!key)
+            return;
+        Gio.DBus.session.call(PORTAL_BUS, PORTAL_PATH, PORTAL_IFACE, 'StopTransfer',
+            new GLib.Variant('(s)', [key]), null, Gio.DBusCallFlags.NONE, -1, null,
+            (connection, result) => {
+                try {
+                    connection.call_finish(result);
+                } catch (error) {
+                    console.debug(`Luma file drag: StopTransfer: ${error.message}`);
+                }
+            });
+    }
+
+    // A target may still be exchanging the key just after the drop.
+    stopLater() {
+        GLib.timeout_add_seconds(GLib.PRIORITY_LOW, PORTAL_STOP_DELAY_S, () => {
+            this._stopped = true;
+            this._stop(this._key);
+            this._key = null;
+            return GLib.SOURCE_REMOVE;
+        });
+    }
+}
+
+// ── The drag image ──────────────────────────────────────────────────────────
+
+class DragPreview {
+    constructor(actors, count, hotspot) {
+        const size = PREVIEW_SIZE * scale();
+        this.actor = new St.Widget({
+            style_class: 'luma-file-drag-preview',
+            layout_manager: new Clutter.BinLayout(),
+            width: size, height: size,
+            reactive: false,
+            opacity: 0,
+        });
+        // The image is never what the drag is over: it must not be picked,
+        // or every client would see the Shell under the pointer.
+        Shell.util_set_hidden_from_pick(this.actor, true);
+        actors.slice(0, PREVIEW_STACK).reverse().forEach((child, i, all) => {
+            const depth = all.length - 1 - i;
+            const card = new St.Bin({style_class: 'luma-file-drag-card',
+                x_expand: true, y_expand: true,
+                x_align: Clutter.ActorAlign.CENTER, y_align: Clutter.ActorAlign.CENTER,
+                child});
+            card.set_pivot_point(0.5, 0.5);
+            card.rotation_angle_z = depth * 6;
+            card.translation_x = depth * 4 * scale();
+            card.translation_y = -depth * 3 * scale();
+            this.actor.add_child(card);
+        });
+        if (count > 1) {
+            this._badge = new St.Label({style_class: 'luma-file-drag-count',
+                text: `${count}`, x_expand: true, y_expand: true,
+                x_align: Clutter.ActorAlign.END, y_align: Clutter.ActorAlign.START});
+            this.actor.add_child(this._badge);
+        }
+        this._hotspot = hotspot;
+        Main.layoutManager.uiGroup.add_child(this.actor);
+        this.actor.set_pivot_point(hotspot[0], hotspot[1]);
+    }
+
+    show(x, y) {
+        this.moveTo(x, y);
+        this.actor.ease({opacity: 255, scale_x: 1.04, scale_y: 1.04,
+            duration: 120, mode: Clutter.AnimationMode.EASE_OUT_QUAD});
+    }
+
+    moveTo(x, y) {
+        const [w, h] = this.actor.get_size();
+        this.actor.set_position(Math.round(x - w * this._hotspot[0]),
+            Math.round(y - h * this._hotspot[1]));
+        // Above everything the Shell draws, menus and the popover included.
+        this.actor.get_parent()?.set_child_above_sibling(this.actor, null);
+    }
+
+    setRefused(refused) {
+        this.actor.opacity = refused ? 200 : 255;
+    }
+
+    // Dropped: the item went where it was let go. Cancelled: it goes back
+    // to where it came from, if that is still on screen.
+    finish(result, origin) {
+        const done = () => this.actor.destroy();
+        if (!St.Settings.get().enable_animations) {
+            done();
+            return;
+        }
+        if (result === Meta.DataDragResult.CANCELLED && origin?.get_stage() && origin.mapped) {
+            const [x, y] = origin.get_transformed_position();
+            const [w, h] = origin.get_transformed_size();
+            const [pw, ph] = this.actor.get_size();
+            this.actor.ease({x: x + (w - pw) / 2, y: y + (h - ph) / 2,
+                scale_x: 1, scale_y: 1, opacity: 0, duration: 220,
+                mode: Clutter.AnimationMode.EASE_OUT_CUBIC, onStopped: done});
+            return;
+        }
+        this.actor.ease({scale_x: result === Meta.DataDragResult.CANCELLED ? 1 : 0.6,
+            scale_y: result === Meta.DataDragResult.CANCELLED ? 1 : 0.6,
+            opacity: 0, duration: 160,
+            mode: Clutter.AnimationMode.EASE_OUT_QUAD, onStopped: done});
+    }
+}
+
+// ── One drag ────────────────────────────────────────────────────────────────
+
+let _current = null;
+
+export function current() {
+    return _current;
+}
+
+export class FileDrag {
+    // files: Gio.File[]; kinds: content types in the same order (for the
+    // Shell's own targets); origin: the actor the drag left from.
+    constructor(files, {kinds = [], origin = null, preview = null, hotspot = [0.5, 0.5]} = {}) {
+        this.files = draggable(files);
+        this.kinds = this.files.map(file => kinds[files.indexOf(file)] ?? 'application/octet-stream');
+        this._origin = origin;
+        this._previewActors = preview ?? [];
+        this._hotspot = hotspot;
+        this.result = null;
+    }
+
+    // Starts the drag from the press or motion `event`. Returns false, with
+    // nothing left behind, when it cannot.
+    begin(event) {
+        if (!this.files.length || !isSupported() || _current)
+            return false;
+        const uris = this.files.map(file => file.get_uri());
+        const paths = this.files.map(file => file.get_path());
+        const drag = Meta.DataDrag.new(global.context);
+        drag.set_content(Model.MIME_TEXT, bytes(Model.plainText(paths)));
+        drag.set_content(Model.MIME_URI_LIST, bytes(Model.uriList(uris)));
+        drag.offer(Model.MIME_PORTAL);
+        drag.offer(Model.MIME_PORTAL_OLD);
+        drag.set_actions(Action.COPY | Action.MOVE, Action.COPY);
+
+        // The Shell's own targets answer through the handler Filer's drags
+        // use, so a dock tile treats these files exactly as Filer's.
+        this._token = Main.xdndHandler?.beginFileDrag?.(SENDER,
+            uris.map((uri, i) => [uri, this.kinds[i]])) ?? '';
+
+        drag.connect('motion', (_drag, x, y) => this._motion(x, y));
+        drag.connect('drop', (_drag, x, y) => this._drop(x, y));
+        drag.connect('ended', (_drag, result) => this._ended(result));
+        drag.connect('finished', () => this._finished());
+
+        this._drag = drag;
+        try {
+            if (!drag.begin(event))
+                throw new Error('the drag did not start');
+        } catch (error) {
+            console.warn(`Luma file drag: ${error.message}`);
+            this._drag = null;
+            this._endShellDrag(false);
+            return false;
+        }
+        _current = this;
+
+        const [x, y] = event.get_coords();
+        this._preview = new DragPreview(this._previewActors, this.files.length, this._hotspot);
+        this._preview.show(x, y);
+
+        // Requested only once someone may ask for it, and answered as soon
+        // as the portal has it: a target that asks earlier waits.
+        this._portal = new PortalTransfer(paths);
+        this._portal.ready.then(key => {
+            const content = key ? bytes(Model.portalKey(key)) : null;
+            drag.set_content(Model.MIME_PORTAL, content);
+            drag.set_content(Model.MIME_PORTAL_OLD, content);
+        });
+
+        // Escape is the drag's own; a lock or a mode change ends it too.
+        this._sessionId = Main.sessionMode.connect('updated', () => drag.cancel());
+        return true;
+    }
+
+    _motion(x, y) {
+        this._preview?.moveTo(x, y);
+        if (this._drag?.over_client) {
+            this._preview?.setRefused(false);
+            return Action.NONE;
+        }
+        const [, , modifiers] = global.get_pointer();
+        const action = Main.xdndHandler?.fileDropActionAt?.(SENDER, this._token, x, y,
+            Model.actionForModifiers(modifiers)) ?? Action.NONE;
+        this._preview?.setRefused(action === Action.NONE);
+        return action;
+    }
+
+    _drop(x, y) {
+        const [, , modifiers] = global.get_pointer();
+        const action = Main.xdndHandler?.fileDropActionAt?.(SENDER, this._token, x, y,
+            Model.actionForModifiers(modifiers)) ?? Action.NONE;
+        if (action === Action.NONE)
+            return false;
+        this._dropAction = action;
+        return true;
+    }
+
+    _endShellDrag(succeeded) {
+        if (!this._token)
+            return;
+        Main.xdndHandler.endFileDrag(SENDER, this._token, succeeded, this._dropAction);
+        this._token = '';
+    }
+
+    // The pointer let go: a new drag may start, while a client that took
+    // this one may still be reading it until finished.
+    _ended(result) {
+        this.result = result;
+        if (_current === this)
+            _current = null;
+        this._endShellDrag(result === Meta.DataDragResult.DROPPED_ON_COMPOSITOR);
+        this._preview?.finish(result, this._origin);
+        this._preview = null;
+        if (this._sessionId)
+            Main.sessionMode.disconnect(this._sessionId);
+        this._sessionId = 0;
+        this.onEnded?.(result);
+    }
+
+    _finished() {
+        this._portal?.stopLater();
+        this._portal = null;
+        this._drag = null;
+    }
+
+    cancel() {
+        this._drag?.cancel();
+    }
+}
+
+// ── The gesture ─────────────────────────────────────────────────────────────
+//
+// attach(actor, source) makes `actor` a place files are dragged from:
+//   source.files(): Gio.File[] (the selection when the actor is in one)
+//   source.kinds?(): content types, same order
+//   source.preview?(): actors for the drag image, one per file shown
+//   source.began?(drag), source.ended?(result): step aside, come back
+//
+// It watches the stage after a press rather than grabbing, so a press always
+// reaches what it landed on; nothing is taken until the gesture is a drag.
+
+export function attach(actor, source) {
+    let armed = null;
+
+    const disarm = () => {
+        if (!armed)
+            return;
+        if (armed.timer)
+            GLib.source_remove(armed.timer);
+        if (armed.watch)
+            global.stage.disconnect(armed.watch);
+        if (armed.lifted && actor.get_stage())
+            actor.remove_style_pseudo_class('lifted');
+        armed = null;
+    };
+
+    const start = event => {
+        const files = source.files?.() ?? [];
+        const drag = new FileDrag(files, {
+            kinds: source.kinds?.() ?? [],
+            origin: actor,
+            preview: source.preview?.() ?? [],
+            hotspot: armed.hotspot,
+        });
+        disarm();
+        // The press is the drag's now: the button forgets it, so the
+        // release cannot also be a click.
+        actor.fake_release?.();
+        if (!drag.begin(event))
+            return false;
+        drag.onEnded = result => source.ended?.(result, drag);
+        source.began?.(drag);
+        return true;
+    };
+
+    const onCaptured = (_stage, event) => {
+        if (!armed)
+            return Clutter.EVENT_PROPAGATE;
+        try {
+            const type = event.type();
+            if (armed.touch) {
+                if (event.get_event_sequence()?.get_slot() !== armed.slot)
+                    return Clutter.EVENT_PROPAGATE;
+                if (type === Clutter.EventType.TOUCH_UPDATE) {
+                    const [x, y] = event.get_coords();
+                    if (!armed.lifted) {
+                        if (Model.travelled(x - armed.x, y - armed.y, TOUCH_SLOP * scale()))
+                            disarm();
+                        return Clutter.EVENT_PROPAGATE;
+                    }
+                    return start(event) ? Clutter.EVENT_STOP : Clutter.EVENT_PROPAGATE;
+                }
+                if (type === Clutter.EventType.TOUCH_END ||
+                    type === Clutter.EventType.TOUCH_CANCEL) {
+                    const lifted = armed.lifted;
+                    disarm();
+                    // A long press that never moved was not a tap either.
+                    return lifted ? Clutter.EVENT_STOP : Clutter.EVENT_PROPAGATE;
+                }
+                return Clutter.EVENT_PROPAGATE;
+            }
+            if (type === Clutter.EventType.MOTION) {
+                const [x, y] = event.get_coords();
+                if (!Model.travelled(x - armed.x, y - armed.y, DRAG_THRESHOLD * scale()))
+                    return Clutter.EVENT_PROPAGATE;
+                return start(event) ? Clutter.EVENT_STOP : Clutter.EVENT_PROPAGATE;
+            }
+            if (type === Clutter.EventType.BUTTON_RELEASE ||
+                (type === Clutter.EventType.LEAVE && !actor.get_stage()))
+                disarm();
+        } catch (error) {
+            logError(error, 'Luma file drag: the gesture ended on an error');
+            disarm();
+        }
+        return Clutter.EVENT_PROPAGATE;
+    };
+
+    const arm = (event, touch) => {
+        disarm();
+        if (!isSupported() || _current)
+            return;
+        const [x, y] = event.get_coords();
+        const [ax, ay] = actor.get_transformed_position();
+        const [aw, ah] = actor.get_transformed_size();
+        armed = {
+            x, y, touch,
+            slot: event.get_event_sequence()?.get_slot(),
+            hotspot: Model.hotspot(x, y, ax, ay, aw, ah),
+            watch: global.stage.connect('captured-event', onCaptured),
+        };
+        if (touch) {
+            armed.timer = GLib.timeout_add(GLib.PRIORITY_DEFAULT, LONG_PRESS_MS, () => {
+                armed.timer = 0;
+                armed.lifted = true;
+                // Lifted: the tap is gone, the next movement drags.
+                actor.fake_release?.();
+                actor.add_style_pseudo_class('lifted');
+                return GLib.SOURCE_REMOVE;
+            });
+        }
+    };
+
+    const pressId = actor.connect('button-press-event', (_a, event) => {
+        if (event.get_button() === Clutter.BUTTON_PRIMARY)
+            arm(event, false);
+        return Clutter.EVENT_PROPAGATE;
+    });
+    const touchId = actor.connect('touch-event', (_a, event) => {
+        if (event.type() === Clutter.EventType.TOUCH_BEGIN)
+            arm(event, true);
+        return Clutter.EVENT_PROPAGATE;
+    });
+    const destroyId = actor.connect('destroy', () => disarm());
+
+    return {
+        detach() {
+            disarm();
+            actor.disconnect(pressId);
+            actor.disconnect(touchId);
+            actor.disconnect(destroyId);
+        },
+    };
+}
