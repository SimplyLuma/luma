+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// The rules of a file drag out of the Shell (lumaFileDrag.js), without the
+// Shell, so they can be tested on their own.
+
+// Meta.DataDragAction values.
+export const Action = {NONE: 0, COPY: 1, MOVE: 2, ASK: 4};
+
+// What a drag of files offers, in Filer's order (GTK's file list): paths as
+// text, the URI list, and the document portal's transfer key, new and old
+// names.
+export const MIME_TEXT = 'text/plain;charset=utf-8';
+export const MIME_URI_LIST = 'text/uri-list';
+export const MIME_PORTAL = 'application/vnd.portal.filetransfer';
+export const MIME_PORTAL_OLD = 'application/vnd.portal.files';
+export const MIME_TYPES = [MIME_TEXT, MIME_URI_LIST, MIME_PORTAL, MIME_PORTAL_OLD];
+
+export const DRAG_THRESHOLD = 8;        // px, GTK's default
+export const LONG_PRESS_MS = 450;
+export const TOUCH_SLOP = 12;           // px a finger may wander during the long press
+export const MAX_FILES = 64;            // what the Shell's own targets accept
+
+// Clutter.ModifierType bits.
+const SHIFT_MASK = 1 << 0;
+
+// RFC 2483: one URI per line, CRLF.
+export function uriList(uris) {
+    return uris.map(uri => `${uri}\r\n`).join('');
+}
+
+// GTK's text form of a file list: paths, one per line.
+export function plainText(paths) {
+    return paths.join('\n');
+}
+
+// GTK writes the key with its terminating NUL.
+export function portalKey(key) {
+    return `${key}\0`;
+}
+
+// Filer's modifier rules: Shift moves, Control copies. With neither a drop
+// copies: a drag out of a folder's preview must never empty the folder by
+// accident.
+export function actionForModifiers(modifiers) {
+    return modifiers & SHIFT_MASK ? Action.MOVE : Action.COPY;
+}
+
+// A press is a click until it has travelled further than the threshold.
+export function travelled(dx, dy, threshold) {
+    return Math.hypot(dx, dy) > threshold;
+}
+
+// Where the pointer took hold of the item, as fractions of its size, so the
+// drag image stays under the same spot of the item.
+export function hotspot(x, y, ax, ay, aw, ah) {
+    const fraction = (v, start, length) =>
+        length > 0 ? Math.min(1, Math.max(0, (v - start) / length)) : 0.5;
+    return [fraction(x, ax, aw), fraction(y, ay, ah)];
+}
+
+// The files one drag carries: what was pressed, or the selection when the
+// pressed item is part of it, in the order shown; never more than MAX_FILES.
+export function dragSet(pressed, ordered, selected, key = item => item.uri) {
+    if (!selected.has(key(pressed)))
+        return [pressed];
+    return ordered.filter(item => selected.has(key(item))).slice(0, MAX_FILES);
+}
+
+// Shift-click selects everything from the anchor to the item, inclusive.
+export function rangeBetween(ordered, anchor, item, key = i => i.uri) {
+    const from = ordered.findIndex(i => key(i) === anchor);
+    const to = ordered.findIndex(i => key(i) === key(item));
+    if (from < 0 || to < 0)
+        return [key(item)];
+    return ordered.slice(Math.min(from, to), Math.max(from, to) + 1).map(key);
+}
