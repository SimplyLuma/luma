+/**
+ * shell_util_open_paths:
+ * @paths: (array zero-terminated=1): absolute paths
+ * @error: return location for an error
+ *
+ * Opens each path as an O_PATH file descriptor, which names a file or folder
+ * without reading it, as the document portal's FileTransfer wants them.
+ *
+ * Returns: (transfer full): the descriptors, in the order of @paths
+ */
+GUnixFDList *
+shell_util_open_paths (const char * const  *paths,
+                       GError             **error)
+{
+  g_autoptr (GUnixFDList) list = g_unix_fd_list_new ();
+  int i;
+
+  for (i = 0; paths[i]; i++)
+    {
+      int fd = open (paths[i], O_PATH | O_CLOEXEC);
+      int saved_errno = errno;
+
+      if (fd < 0)
+        {
+          g_set_error (error, G_IO_ERROR, g_io_error_from_errno (saved_errno),
+                       "%s: %s", paths[i], g_strerror (saved_errno));
+          return NULL;
+        }
+
+      if (g_unix_fd_list_append (list, fd, error) < 0)
+        {
+          close (fd);
+          return NULL;
+        }
+      close (fd);
+    }
+
+  return g_steal_pointer (&list);
+}
