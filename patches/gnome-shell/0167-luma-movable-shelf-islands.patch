+
+    // Outlines, grips and empty zones.
+    _decorate() {
+        if (!this._active || !this._decorations)
+            return;
+        this._decorations.destroy_all_children();
+        this._grips = [];
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        const {monitors, groups} = this._context(this._drag?.ids ?? []);
+        const names = islandNames();
+        for (const group of groups) {
+            if (!group.islands.length)
+                continue;
+            const off = OUTLINE_OFFSET * scale;
+            const outline = new St.Widget({style_class: 'luma-arrange-outline', reactive: false});
+            outline.set_position(group.rect.x - off, group.rect.y - off);
+            outline.set_size(group.rect.width + 2 * off, group.rect.height + 2 * off);
+            this._decorations.add_child(outline);
+            if (group.islands.length < 2)
+                continue;
+            const vertical = Arrangement.isVertical(group.edge);
+            const grip = new St.Button({style_class: 'luma-arrange-grip', reactive: true, can_focus: true,
+                accessible_role: Atk.Role.PUSH_BUTTON,
+                accessible_name: _('Move the %s group').replace('%s', names[group.islands[0].id] ?? group.islands[0].id)});
+            grip.set_size((vertical ? 6 : 24) * scale, (vertical ? 24 : 6) * scale);
+            const g = GRIP_OFFSET * scale, r = group.rect;
+            const pos = {
+                bottom: [r.x + r.width / 2 - 12 * scale, r.y - g - 6 * scale],
+                top: [r.x + r.width / 2 - 12 * scale, r.y + r.height + g],
+                left: [r.x + r.width + g, r.y + r.height / 2 - 12 * scale],
+                right: [r.x - g - 6 * scale, r.y + r.height / 2 - 12 * scale],
+            }[group.edge];
+            grip.set_position(Math.round(pos[0]), Math.round(pos[1]));
+            grip._group = group;
+            grip.connect('button-press-event', (_a, event) => {
+                const [x, y] = event.get_coords();
+                this._pending = {ids: this._storedGroupIds(group), grab: group.islands[0].id, x, y, pressed: true, group: true};
+                return Clutter.EVENT_STOP;
+            });
+            this._decorations.add_child(grip);
+            this._grips.push(grip);
+        }
+        // Every empty zone on every monitor.
+        for (const monitor of monitors) {
+            for (const edge of Arrangement.EDGES) {
+                const band = monitor.bands[edge];
+                if (!band || monitor.sharedEdges.includes(edge))
+                    continue;
+                for (const anchor of Arrangement.ZONE_ANCHORS) {
+                    const rect = Arrangement.zoneRect(band, anchor, scale);
+                    const taken = groups.some(group => group.monitor === monitor.index &&
+                        group.islands.length && rectsMeet(group.rect, rect));
+                    if (taken)
+                        continue;
+                    const zone = new DashedOutline({style_class: 'luma-arrange-zone', reactive: false});
+                    zone.set_position(rect.x, rect.y);
+                    zone.set_size(rect.width, rect.height);
+                    zone._zone = {monitor: monitor.index, edge, anchor};
+                    this._decorations.add_child(zone);
+                }
+            }
+        }
+        this._zones = this._decorations.get_children().filter(a => a._zone);
+        this._placeCard();
+        this._cardReset?.set_reactive(!this._shelf.arrangementIsDefault || this._undo.length > 0);
+    }
+
+    // The stored ids of a drawn group, hidden islands included.
+    _storedGroupIds(group) {
+        const stored = this._shelf.arrangement;
+        return group.source.flatMap(index => stored[index]?.islands ?? []);
+    }
+
+    // --------------------------------------------------------- selection
+
+    _orderedIds() {
+        const {groups} = this._context();
+        const rank = {bottom: 0, top: 1, left: 2, right: 3};
+        return groups.sort((a, b) => a.monitor - b.monitor || rank[a.edge] - rank[b.edge] ||
+            (Arrangement.isVertical(a.edge) ? a.rect.y - b.rect.y : a.rect.x - b.rect.x))
+            .flatMap(group => group.islands.flatMap(island => island.ids));
+    }
+
+    _syncSelection() {
+        this._clearSelection();
+        if (!this._selected)
+            return;
+        const actor = this._shelf.islandActorFor(this._selected);
+        const material = actor?._content;
+        if (material) {
+            material.add_style_class_name('luma-island-focus');
+            this._selectedMaterial = material;
+        }
+    }
+
+    _clearSelection() {
+        this._selectedMaterial?.remove_style_class_name('luma-island-focus');
+        this._selectedMaterial = null;
+    }
+
+    // ------------------------------------------------------------ pointer
+
+    _onPress(event) {
+        if (event.get_button() !== Clutter.BUTTON_PRIMARY)
+            return Clutter.EVENT_STOP;
+        const [x, y] = event.get_coords();
+        if (this._card && contains(extentsOf(this._card), x, y))
+            return Clutter.EVENT_PROPAGATE;
+        const id = this._islandAt(x, y);
+        this._pending = id ? {ids: [id], grab: id, x, y, pressed: true} : {empty: true, x, y, pressed: true};
+        if (id) {
+            this._selected = id;
+            this._syncSelection();
+        }
+        return Clutter.EVENT_STOP;
+    }
+
+    _onTouch(event) {
+        const [x, y] = event.get_coords();
+        switch (event.type()) {
+        case Clutter.EventType.TOUCH_BEGIN: {
+            const id = this._islandAt(x, y);
+            this._pending = id ? {ids: [id], grab: id, x, y, pressed: true} : {empty: true, x, y, pressed: true};
+            break;
+        }
+        case Clutter.EventType.TOUCH_UPDATE:
+            this._pointerMoved(x, y);
+            break;
+        case Clutter.EventType.TOUCH_END:
+            this._pointerReleased(x, y);
+            break;
+        case Clutter.EventType.TOUCH_CANCEL:
+            this._cancelDrag(true);
+            break;
+        }
+        return Clutter.EVENT_STOP;
+    }
+
+    _onMotion(event) {
+        const [x, y] = event.get_coords();
+        this._pointerMoved(x, y);
+        return Clutter.EVENT_STOP;
+    }
+
+    _onRelease(event) {
+        if (event.get_button() !== Clutter.BUTTON_PRIMARY)
+            return Clutter.EVENT_STOP;
+        const [x, y] = event.get_coords();
+        this._pointerReleased(x, y);
+        return Clutter.EVENT_STOP;
+    }
+
+    _pointerMoved(x, y) {
+        if (this._drag) {
+            this._dragTo(x, y);
+            return;
+        }
+        const pending = this._pending;
+        if (!pending?.pressed || pending.empty)
+            return;
+        if (pending.lifted || Math.hypot(x - pending.x, y - pending.y) > Arrangement.DRAG_THRESHOLD) {
+            this._pending = null;
+            this._startDrag(pending, x, y);
+        }
+    }
+
+    _pointerReleased(x, y) {
+        if (this._drag) {
+            this._drop();
+            return;
+        }
+        const pending = this._pending;
+        this._pending = null;
+        if (pending?.lifted)
+            this._liftActor(this._shelf.islandActorFor(pending.grab), false);
+        // A click on empty desktop leaves arrange mode.
+        if (pending?.empty && Math.hypot(x - pending.x, y - pending.y) <= Arrangement.DRAG_THRESHOLD)
+            this.end({reason: 'click'});
+    }
+
+    _liftActor(actor, lifted) {
+        if (!actor)
+            return;
+        const animate = St.Settings.get().enable_animations;
+        actor.set_pivot_point(0.5, 0.5);
+        actor.ease({scale_x: lifted ? LIFT_SCALE : 1, scale_y: lifted ? LIFT_SCALE : 1,
+            duration: animate ? LIFT_TIME : 0, mode: Clutter.AnimationMode.EASE_OUT_CUBIC});
+        for (const island of [actor])
+            (lifted ? island.add_style_class_name : island.remove_style_class_name).call(island, 'luma-island-lifted');
+    }
+
+    // ---------------------------------------------------------------- drag
+
+    _startDrag(pending, x, y) {
+        const shelf = this._shelf;
+        const stored = shelf.arrangement;
+        const ids = pending.ids;
+        const sourceIndex = Arrangement.groupIndexOf(stored, ids[0]);
+        const source = stored[sourceIndex];
+        if (!source)
+            return;
+        // Where the dragged island is drawn now, and how long it is.
+        const actor = pending.group ? null : shelf.partActorFor(pending.grab);
+        const group = shelf.groupForActor(shelf.islandActorFor(pending.grab));
+        const rect = pending.group ? extentsOf(group) : extentsOf(actor ?? group);
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        const thickness = shelf._thickness * scale;
+        const edge = group?.placement?.edge ?? source.edge;
+        const along = Arrangement.isVertical(edge) ? rect.height : rect.width;
+        this._liftActor(shelf.islandActorFor(pending.grab), false);
+        const monitorIndex = group?.placement?.monitor ?? Main.layoutManager.primaryIndex;
+        this._drag = {
+            ids, grab: pending.grab, group: !!pending.group, stored, sourceIndex, edge,
+            // Held where it was pressed, not where the drag was noticed.
+            offset: [pending.x - (rect.x + rect.width / 2), pending.y - (rect.y + rect.height / 2)],
+            length: {horizontal: Arrangement.isVertical(edge) ? thickness * 2 : along,
+                vertical: Arrangement.isVertical(edge) ? along : thickness * 2},
+            along, origin: {x: rect.x, y: rect.y}, target: undefined, monitor: monitorIndex,
+        };
+        const base = Arrangement.applyMove(stored, ids, {kind: 'free', edge: source.edge, position: 0.5}, source.display)
+            .filter(g => !(g.islands.length === ids.length && g.islands.every(id => ids.includes(id))));
+        this._drag.base = base;
+        this._dragPreview(null);
+        const dragGroup = this._dragGroup();
+        if (dragGroup) {
+            dragGroup.set_pivot_point(0.5, 0.5);
+            dragGroup.set_scale(1, 1);
+            dragGroup.ease({scale_x: LIFT_SCALE, scale_y: LIFT_SCALE,
+                duration: St.Settings.get().enable_animations ? LIFT_TIME : 0,
+                mode: Clutter.AnimationMode.EASE_OUT_CUBIC});
+            dragGroup.row.get_children().forEach(island => island.add_style_class_name?.('luma-island-lifted'));
+        }
+        this._decorate();
+        this._dragTo(x, y);
+        console.log(`[luma-shelf] drag ${ids.join(',')} from ${source.edge}/${source.anchor}`);
+    }
+
+    _dragGroup() {
+        return this._shelf._groups.find(group => group.dragging) ?? null;
+    }
+
+    // Apply the preview for a target: the base arrangement (without the
+    // dragged islands) plus, for an attach, the gap in the target group.
+    _dragPreview(target) {
+        const drag = this._drag;
+        const groups = Arrangement.cloneArrangement(drag.base);
+        if (target?.kind === 'attach') {
+            const host = groups[target.storedGroup];
+            if (host)
+                host.islands.splice(target.storedIndex, 0, `gap:${Math.round(target.gapLength ?? drag.along)}`);
+        }
+        this._shelf.setPreview({
+            groups,
+            drag: {monitor: drag.monitor, edge: drag.edge, anchor: 'free', position: 0.5, islands: [...drag.ids]},
+        });
+    }
+
+    _dragTo(x, y) {
+        const drag = this._drag;
+        const dragGroup = this._dragGroup();
+        const cx = x - drag.offset[0], cy = y - drag.offset[1];
+        if (dragGroup) {
+            const [, w] = dragGroup.get_preferred_width(-1);
+            const [, h] = dragGroup.get_preferred_height(-1);
+            dragGroup.set_position(Math.round(cx - w / 2), Math.round(cy - h / 2));
+            Main.layoutManager.uiGroup.set_child_above_sibling(this._layer, null);
+        }
+        const {monitors, groups} = this._context(drag.ids);
+        const raw = Arrangement.resolveTarget([cx, cy], drag.length, monitors, groups, drag.ids,
+            St.ThemeContext.get_for_stage(global.stage).scale_factor);
+        const target = raw ? this._storedTarget(raw, groups) : null;
+        this._showHint(target, x, y);
+        const previous = drag.target;
+        drag.target = target;
+        // A free position moves with the pointer: only the ghost follows it.
+        // The groups are laid out again only when the target itself changes
+        // (another zone, another attach slot, another edge).
+        if (sameTarget(target, previous)) {
+            if (target?.kind === 'free')
+                this._showTarget(target);
+            return;
+        }
+        drag.monitor = target?.monitor ?? drag.monitor;
+        this._dragPreview(target);
+        this._showTarget(target);
+        this._announce(targetText(target, islandNames()));
+    }
+
+    // A target in terms of the stored (base) arrangement: the group and the
+    // index among its stored islands, hidden ones included.
+    _storedTarget(raw, groups) {
+        if (raw.kind !== 'attach')
+            return raw;
+        const group = groups.find(g => g.index === raw.group);
+        if (!group)
+            return null;
+        const base = this._drag.base;
+        const storedGroup = raw.group;
+        const host = base[storedGroup];
+        if (!host)
+            return null;
+        const islands = group.islands.filter(island => !island.ids.every(id => this._drag.ids.includes(id)));
+        let storedIndex;
+        if (raw.index < islands.length)
+            storedIndex = host.islands.indexOf(islands[raw.index].ids[0]);
+        else
+            storedIndex = host.islands.indexOf(islands.at(-1).ids.at(-1)) + 1;
+        if (storedIndex < 0)
+            storedIndex = host.islands.length;
+        return {...raw, storedGroup, storedIndex, group: storedGroup, index: storedIndex, gapLength: this._drag.along};
+    }
+
+    _showHint(target, x, y) {
+        if (!this._hint)
+            return;
+        this._hint.text = targetText(target, islandNames());
+        this._hint.show();
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        const [, w] = this._hint.get_preferred_width(-1);
+        const [, h] = this._hint.get_preferred_height(-1);
+        let hx = x + 24 * scale, hy = y - h - 24 * scale;
+        hx = Math.min(hx, global.stage.width - w - 8 * scale);
+        hy = Math.max(8 * scale, hy);
+        this._hint.set_position(Math.round(hx), Math.round(hy));
+    }
+
+    _clearTargetVisuals() {
+        this._activeZone?.remove_style_class_name('luma-arrange-zone-active');
+        this._activeZone?.queue_repaint();
+        this._activeZone = null;
+        this._overlay?.destroy_all_children();
+        this._ghost = null;
+    }
+
+    // The snap and free previews: the zone fills, and a ghost outline shows
+    // the island's final footprint (with a guide line when free).
+    _showTarget(target) {
+        this._clearTargetVisuals();
+        if (!target || target.kind === 'attach' || !this._overlay)
+            return;
+        const shelf = this._shelf;
+        const band = shelf._bands?.get(target.monitor)?.[target.edge];
+        if (!band)
+            return;
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        const vertical = Arrangement.isVertical(target.edge);
+        const length = vertical ? this._drag.length.vertical : this._drag.length.horizontal;
+        const thickness = shelf._thickness * scale;
+        const along = target.kind === 'snap'
+            ? Arrangement.zonePoints(band, length)[target.anchor]
+            : band.along[0] + target.position * band.length;
+        const start = Math.max(band.along[0], Math.min(along - length / 2, band.along[1] - length));
+        const rect = vertical
+            ? {x: band.rect.x, y: start, width: thickness, height: length}
+            : {x: start, y: band.rect.y, width: length, height: thickness};
+        if (target.kind === 'snap') {
+            this._activeZone = this._zones?.find(z => z._zone.monitor === target.monitor &&
+                z._zone.edge === target.edge && z._zone.anchor === target.anchor) ?? null;
+            this._activeZone?.add_style_class_name('luma-arrange-zone-active');
+            this._activeZone?.queue_repaint();
+        } else {
+            const guide = new St.Widget({style_class: 'luma-arrange-guide', reactive: false});
+            if (vertical) {
+                guide.set_position(Math.round(band.rect.x + thickness / 2), band.along[0]);
+                guide.set_size(1, band.length);
+            } else {
+                guide.set_position(band.along[0], Math.round(band.rect.y + thickness / 2));
+                guide.set_size(band.length, 1);
+            }
+            this._overlay.add_child(guide);
+        }
+        const ghost = new DashedOutline({style_class: 'luma-arrange-ghost', reactive: false});
+        ghost.set_position(Math.round(rect.x), Math.round(rect.y));
+        ghost.set_size(Math.round(rect.width), Math.round(rect.height));
+        this._overlay.add_child(ghost);
+        this._ghost = ghost;
+    }
+
+    _drop() {
+        const drag = this._drag;
+        const target = drag.target;
+        if (GLib.getenv('LUMA_SHELF_DEBUG'))
+            console.log(`[luma-shelf] drop ${drag.ids} on ${JSON.stringify(target)} base ${JSON.stringify(drag.base)}`);
+        this._hint?.hide();
+        this._clearTargetVisuals();
+        if (!target) {
+            this._cancelDrag(true);
+            return;
+        }
+        const shelf = this._shelf;
+        const display = Arrangement.displayFor(target.monitor, shelf.monitors, Main.layoutManager.primaryIndex);
+        // The move counts against the arrangement as stored before the drag.
+        let next;
+        if (target.kind === 'attach') {
+            const host = drag.base[target.storedGroup];
+            // Find the host group in the stored arrangement by one of its
+            // islands, then insert at the same stored neighbour.
+            const anchorId = host.islands[target.storedIndex] ?? null;
+            const lastId = host.islands.at(-1);
+            const stored = Arrangement.cloneArrangement(drag.stored);
+            const without = stored.map(g => ({...g, islands: g.islands.filter(id => !drag.ids.includes(id))}));
+            const hostIndex = without.findIndex(g => g.islands.includes(anchorId ?? lastId));
+            const index = anchorId ? without[hostIndex].islands.indexOf(anchorId)
+                : without[hostIndex].islands.indexOf(lastId) + 1;
+            next = Arrangement.applyMove(drag.stored, drag.ids, {kind: 'attach', group: hostIndex, index});
+        } else {
+            next = Arrangement.applyMove(drag.stored, drag.ids, target, display);
+        }
+        this._commit(next, drag);
+        this._announce(Arrangement.describePlacement(next, drag.grab, islandNames(), _));
+    }
+
+    // Write the arrangement once, end the preview, and let the dropped
+    // islands travel from where they were let go to their place.
+    _commit(next, drag = null) {
+        const shelf = this._shelf;
+        const before = drag?.stored ?? shelf.arrangement;
+        const from = drag ? this._dragOrigins() : null;
+        const edgeBefore = drag?.edge;
+        this._drag = null;
+        this._undo.push(before);
+        shelf._preview = null;
+        shelf._slideTime = 180;
+        const changed = shelf.writeArrangement(next);
+        if (!changed)
+            shelf._sync();
+        if (from)
+            this._travel(from, edgeBefore);
+        shelf._slideTime = null;
+        this._queueDecorate();
+    }
+
+    // Where each dragged island is on screen now, before it is put back.
+    _dragOrigins() {
+        const dragGroup = this._dragGroup();
+        const origins = new Map();
+        for (const island of dragGroup?.row.get_children() ?? []) {
+            if (island.islandId)
+                origins.set(island, extentsOf(island));
+        }
+        return origins;
+    }
+
+    // Each dropped island animates from the pointer to its final place
+    // (240 ms, ease-out cubic); into a new orientation it cross-fades.
+    _travel(origins, edgeBefore) {
+        const animate = St.Settings.get().enable_animations;
+        for (const [island, from] of origins) {
+            island.remove_style_class_name('luma-island-lifted');
+            island.set_scale(1, 1);
+            const vertical = Arrangement.isVertical(this._shelf.edgeForActor(island));
+            if (!animate)
+                continue;
+            if (vertical !== Arrangement.isVertical(edgeBefore)) {
+                island.opacity = 0;
+                island.ease({opacity: 255, duration: 110, delay: 110, mode: Clutter.AnimationMode.EASE_OUT_CUBIC});
+                continue;
+            }
+            let id = 0;
+            const run = () => {
+                if (id)
+                    island.disconnect(id);
+                id = 0;
+                const to = extentsOf(island);
+                const dx = from.x - (to.x - island.translation_x);
+                const dy = from.y - (to.y - island.translation_y);
+                if (Math.abs(dx) < 1 && Math.abs(dy) < 1)
+                    return;
+                island.remove_transition('translation-x');
+                island.remove_transition('translation-y');
+                island.translation_x = dx;
+                island.translation_y = dy;
+                island.ease({translation_x: 0, translation_y: 0, duration: DROP_TIME,
+                    mode: Clutter.AnimationMode.EASE_OUT_CUBIC});
+            };
+            id = island.connect('notify::allocation', run);
+            GLib.timeout_add(GLib.PRIORITY_DEFAULT, 80, () => {
+                if (id)
+                    run();
+                return GLib.SOURCE_REMOVE;
+            });
+        }
+    }
+
+    // Esc during a drag: the island travels back and nothing is written.
+    _cancelDrag(announce) {
+        const drag = this._drag;
+        if (!drag)
+            return;
+        const from = this._dragOrigins();
+        this._drag = null;
+        this._hint?.hide();
+        this._clearTargetVisuals();
+        this._shelf._slideTime = 180;
+        this._shelf.setPreview(null);
+        this._shelf._slideTime = null;
+        this._travel(from, drag.edge);
+        this._queueDecorate();
+        if (announce)
+            this._announce(_('Move cancelled'));
+        console.log('[luma-shelf] drag cancelled');
+    }
+
+    _slideAll(write) {
+        this._shelf._slideTime = 240;
+        write();
+        this._shelf._slideTime = null;
+        this._queueDecorate();
+    }
+
+    // ------------------------------------------------------------ keyboard
+
+    _onKey(event) {
+        const symbol = event.get_key_symbol();
+        const state = event.get_state();
+        const ctrl = (state & Clutter.ModifierType.CONTROL_MASK) !== 0;
+        const alt = (state & Clutter.ModifierType.MOD1_MASK) !== 0;
+        const shift = (state & Clutter.ModifierType.SHIFT_MASK) !== 0;
+        if (symbol === Clutter.KEY_Escape) {
+            if (this._drag)
+                this._cancelDrag(true);
+            else
+                this.end({reason: 'escape'});
+            return Clutter.EVENT_STOP;
+        }
+        if (symbol === Clutter.KEY_Return || symbol === Clutter.KEY_KP_Enter) {
+            const focus = global.stage.get_key_focus();
+            if (focus instanceof St.Button && this._card?.contains(focus))
+                return Clutter.EVENT_PROPAGATE;
+            this.end({reason: 'enter'});
+            return Clutter.EVENT_STOP;
+        }
+        if (ctrl && !alt && (symbol === Clutter.KEY_z || symbol === Clutter.KEY_Z)) {
+            this.undo();
+            return Clutter.EVENT_STOP;
+        }
+        if (symbol === Clutter.KEY_Tab || symbol === Clutter.KEY_ISO_Left_Tab) {
+            const ids = this._orderedIds();
+            if (ids.length) {
+                const at = ids.indexOf(this._selected);
+                const step = symbol === Clutter.KEY_ISO_Left_Tab || shift ? -1 : 1;
+                this._selected = ids[(at + step + ids.length) % ids.length] ?? ids[0];
+                this._syncSelection();
+                this._announce(Arrangement.describePlacement(this._shelf.arrangement, this._selected, islandNames(), _));
+            }
+            return Clutter.EVENT_STOP;
+        }
+        const direction = {
+            [Clutter.KEY_Left]: 'left', [Clutter.KEY_Right]: 'right',
+            [Clutter.KEY_Up]: 'up', [Clutter.KEY_Down]: 'down',
+        }[symbol];
+        if (direction && ctrl && alt) {
+            if (!this._selected)
+                this._selected = this._orderedIds()[0];
+            this.moveByKey(this._selected, direction, shift);
+            return Clutter.EVENT_STOP;
+        }
+        return Clutter.EVENT_PROPAGATE;
+    }
+
+    undo() {
+        const previous = this._undo.pop();
+        if (!previous)
+            return;
+        this._slideAll(() => {
+            if (!this._shelf.writeArrangement(previous))
+                this._shelf._sync();
+        });
+        this._announce(_('Move undone'));
+    }
+
+    // Ctrl+Alt+arrow: the selected island (or with Shift its whole group)
+    // steps to the next drop target in that direction, committed at once.
+    moveByKey(id, direction, wholeGroup = false) {
+        const shelf = this._shelf;
+        const stored = shelf.arrangement;
+        const index = Arrangement.groupIndexOf(stored, id);
+        if (index < 0)
+            return false;
+        const ids = wholeGroup ? [...stored[index].islands] : [id];
+        const actor = shelf.islandActorFor(id);
+        const group = shelf.groupForActor(actor);
+        if (!group?.placement)
+            return false;
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        const {monitors, groups} = this._context(ids);
+        const monitor = monitors.find(m => m.index === group.placement.monitor);
+        if (!monitor)
+            return false;
+        const rect = wholeGroup ? extentsOf(group) : extentsOf(shelf.partActorFor(id) ?? actor);
+        const edge = group.placement.edge;
+        const vertical = Arrangement.isVertical(edge);
+        const alongLength = vertical ? rect.height : rect.width;
+        const length = {horizontal: vertical ? shelf._thickness * scale * 2 : alongLength,
+            vertical: vertical ? alongLength : shelf._thickness * scale * 2};
+        const band = monitor.bands[edge];
+        const centre = vertical ? rect.y + rect.height / 2 : rect.x + rect.width / 2;
+        const fraction = band ? (centre - band.along[0]) / Math.max(1, band.length) : 0.5;
+        const targets = Arrangement.orderedTargets(monitor, groups, ids, length);
+        // The island's own place, so the step goes past it.
+        let here = null;
+        const own = groups.find(g => g.actor === group);
+        if (own) {
+            const i = own.islands.findIndex(island => island.ids.some(x => ids.includes(x)));
+            if (i >= 0)
+                here = {kind: 'attach', group: own.index, index: i, edge, monitor: monitor.index};
+        }
+        const step = Arrangement.stepTarget(targets, {edge, along: centre, fraction, target: here}, direction, monitor);
+        if (!step) {
+            this._announce(_('No place further in that direction'));
+            return false;
+        }
+        let next;
+        if (step.kind === 'attach') {
+            const target = groups.find(g => g.index === step.group);
+            const islands = target.islands.filter(island => !island.ids.every(x => ids.includes(x)));
+            const without = stored.map(g => ({...g, islands: g.islands.filter(x => !ids.includes(x))}));
+            const anchorId = islands[step.index]?.ids[0] ?? null;
+            const lastId = islands.at(-1)?.ids.at(-1);
+            const hostIndex = without.findIndex(g => g.islands.includes(anchorId ?? lastId));
+            if (hostIndex < 0)
+                return false;
+            const at = anchorId ? without[hostIndex].islands.indexOf(anchorId)
+                : without[hostIndex].islands.indexOf(lastId) + 1;
+            next = Arrangement.applyMove(stored, ids, {kind: 'attach', group: hostIndex, index: at});
+        } else {
+            const display = Arrangement.displayFor(step.monitor, shelf.monitors, Main.layoutManager.primaryIndex);
+            next = Arrangement.applyMove(stored, ids, step, display);
+        }
+        this._undo.push(stored);
+        this._slideAll(() => {
+            if (!shelf.writeArrangement(next))
+                shelf._sync();
+        });
+        this._selected = id;
+        GLib.timeout_add(GLib.PRIORITY_DEFAULT, 60, () => {
+            this._syncSelection();
+            return GLib.SOURCE_REMOVE;
+        });
+        this._announce(Arrangement.describePlacement(next, id, islandNames(), _));
+        console.log(`[luma-shelf] key move ${ids.join(',')} ${direction}`);
+        return true;
+    }
+
+    // --------------------------------------------------------- announce
+
+    _announce(text) {
+        this._lastAnnouncement = text;
+        const actor = this._card ?? this._shelf;
+        const accessible = actor.get_accessible?.();
+        try {
+            accessible?.emit('notification', text, Atk.Live.POLITE);
+        } catch (error) {
+            logError(error, 'Luma Shelf: announcement');
+        }
+        console.log(`[luma-shelf] announce: ${text}`);
+    }
+
+    get lastAnnouncement() {
+        return this._lastAnnouncement ?? null;
+    }
+}
+
+// The reactive actor under an event's point (Clutter no longer hands a
+// captured event its source).
+function pickAt(event) {
+    const [x, y] = event.get_coords();
+    return global.stage.get_actor_at_pos(Clutter.PickMode.REACTIVE, x, y);
+}
+
+function rectsMeet(a, b) {
+    return a.x < b.x + b.width && b.x < a.x + a.width && a.y < b.y + b.height && b.y < a.y + a.height;
+}
+
+function sameTarget(a, b) {
+    if (!a || !b)
+        return a === b;
+    if (a.kind !== b.kind || a.edge !== b.edge || a.monitor !== b.monitor)
+        return false;
+    if (a.kind === 'attach')
+        return a.storedGroup === b.storedGroup && a.storedIndex === b.storedIndex;
+    if (a.kind === 'snap')
+        return a.anchor === b.anchor;
+    return true;
+}
