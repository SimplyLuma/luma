+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Movable shelf islands (ADR-044): the placement model and its solver.
+//
+// Pure: no St, no Clutter, no settings. The Shelf (shelf.js) and arrange mode
+// (shelfArrange.js) hand this module plain rectangles and read plain answers
+// back, so every rule here runs under gjs without a session.
+//
+// Vocabulary:
+//   island     one painted, rounded surface on the shelf ('dock', 'clock', …)
+//   group      islands attached in a row, ISLAND_GAP apart; a free island is
+//              a group of one
+//   placement  where a group sits: display, edge, anchor, position
+//   zone       one of the twelve snap placements, edge × start/center/end
+//   band       the strip along one edge of one monitor holding its groups
+//
+// start/end are physical: left/right on horizontal edges, top/bottom on
+// vertical ones, in RTL too.
+
+export const ISLAND_IDS = Object.freeze(['dock', 'live', 'media', 'well',
+    'quick-options', 'clock', 'notifications']);
+// Shell .114's row: the dock, the live and media islands against Quick
+// Options, then the notification island at the far end.
+export const DEFAULT_ORDER = ISLAND_IDS;
+// The three parts Quick Options splits into. Adjacent in one group, they are
+// drawn as one fused island, today's status cluster.
+export const STATUS_PARTS = Object.freeze(['well', 'quick-options', 'clock']);
+export const EDGES = Object.freeze(['top', 'bottom', 'left', 'right']);
+export const ANCHORS = Object.freeze(['start', 'center', 'end', 'free']);
+export const ZONE_ANCHORS = Object.freeze(['start', 'center', 'end']);
+
+// Logical pixels; the caller multiplies by the display scale.
+export const ISLAND_GAP = 9;          // the kit's island_gap: attached islands
+export const GROUP_SEPARATION = 24;   // separate groups on one band, at least
+export const ATTACH_DISTANCE = 40;    // along a group's run, to attach to it
+export const SNAP_DISTANCE = 32;      // from a zone's point, to snap to it
+export const ZONE_LENGTH = 120;       // the dashed placeholder of an empty zone
+export const DRAG_THRESHOLD = 8;
+export const HOLD_FEEDBACK_TIME = 150;
+export const HOLD_TIME = 400;
+
+export function isVertical(edge) {
+    return edge === 'left' || edge === 'right';
+}
+
+const clamp = (value, min, max) => Math.max(min, Math.min(max, value));
+
+function cleanPosition(value) {
+    const number = Number(value);
+    return Number.isFinite(number) ? clamp(number, 0, 1) : 0.5;
+}
+
+// The v1 keys (shelf-edge, shelf-dock-anchor, shelf-actions-anchor,
+// shelf-group-layout) describe today's layout; an empty arrangement means
+// exactly that layout.
+export function defaultArrangement(v1 = {}, order = DEFAULT_ORDER) {
+    const edge = EDGES.includes(v1.edge) ? v1.edge : 'bottom';
+    const anchor = value => ZONE_ANCHORS.includes(value) ? value : 'center';
+    // A shelf that spans its edge with separate islands draws the dock at
+    // one end and everything else at the other: exactly two groups.
+    if (v1.spanSplit) {
+        return [
+            {display: '', edge, anchor: 'start', position: 0.5, islands: ['dock']},
+            {display: '', edge, anchor: 'end', position: 0.5, islands: order.filter(id => id !== 'dock')},
+        ];
+    }
+    if (v1.groupLayout === 'split-ends') {
+        const rest = order.filter(id => id !== 'dock');
+        return [
+            {display: '', edge, anchor: anchor(v1.dockAnchor ?? 'start'), position: 0.5, islands: ['dock']},
+            {display: '', edge, anchor: anchor(v1.actionsAnchor ?? 'end'), position: 0.5, islands: rest},
+        ].filter(group => group.islands.length);
+    }
+    return [{display: '', edge, anchor: 'center', position: 0.5, islands: [...order]}];
+}
+
+// Normalise whatever was read from settings. Unknown ids are dropped,
+// duplicates keep their first placement, a group on an unknown edge is
+// discarded, a position is clamped, and every placeable island missing from
+// the arrangement joins its default group beside its default neighbour. A
+// corrupt value therefore never loses the clock or the dock.
+export function normalizeArrangement(raw, v1 = {}, order = DEFAULT_ORDER) {
+    const fallback = defaultArrangement(v1, order);
+    if (!Array.isArray(raw) || raw.length === 0)
+        return {groups: fallback, isDefault: true};
+    const seen = new Set();
+    const groups = [];
+    for (const entry of raw) {
+        if (!entry || typeof entry !== 'object' || !EDGES.includes(entry.edge))
+            continue;
+        const islands = (Array.isArray(entry.islands) ? entry.islands : [])
+            .filter(id => order.includes(id) && !seen.has(id));
+        islands.forEach(id => seen.add(id));
+        if (!islands.length)
+            continue;
+        groups.push({
+            display: typeof entry.display === 'string' ? entry.display : '',
+            edge: entry.edge,
+            anchor: ANCHORS.includes(entry.anchor) ? entry.anchor : 'center',
+            position: cleanPosition(entry.position),
+            islands,
+        });
+    }
+    if (!groups.length)
+        return {groups: fallback, isDefault: true};
+    for (const id of order) {
+        if (seen.has(id))
+            continue;
+        insertBesideDefaultNeighbour(groups, id, order, fallback);
+        seen.add(id);
+    }
+    return {groups, isDefault: false};
+}
+
+function insertBesideDefaultNeighbour(groups, id, order, fallback) {
+    const home = fallback.find(group => group.islands.includes(id));
+    const siblings = home.islands;
+    const at = siblings.indexOf(id);
+    // The nearest default neighbour already placed, looking back first, so
+    // the clock missing from a status group lands after Quick Options.
+    for (let distance = 1; distance < siblings.length; distance++) {
+        for (const [index, after] of [[at - distance, true], [at + distance, false]]) {
+            const neighbour = siblings[index];
+            if (!neighbour)
+                continue;
+            const group = groups.find(g => g.islands.includes(neighbour));
+            if (!group)
+                continue;
+            const position = group.islands.indexOf(neighbour);
+            group.islands.splice(after ? position + 1 : position, 0, id);
+            return;
+        }
+    }
+    groups.push({display: '', edge: home.edge, anchor: home.anchor, position: 0.5, islands: [id]});
+}
+
+export function cloneArrangement(groups) {
+    return groups.map(group => ({...group, islands: [...group.islands]}));
+}
+
+export function sameArrangement(a, b) {
+    return JSON.stringify(a) === JSON.stringify(b);
+}
+
+export function groupIndexOf(groups, id) {
+    return groups.findIndex(group => group.islands.includes(id));
+}
+
+// Status fusion: maximal runs of adjacent status parts that include Quick
+// Options are drawn as one island hosted by Quick Options. Returns the row's
+// entries in order: {id} for an island drawn alone, {fused: [ids]} for a run.
+export function fuseStatus(islands) {
+    const entries = [];
+    let run = [];
+    const flush = () => {
+        if (!run.length)
+            return;
+        if (run.includes('quick-options') && run.length > 1)
+            entries.push({fused: run});
+        else
+            run.forEach(id => entries.push({id}));
+        run = [];
+    };
+    for (const id of islands) {
+        if (STATUS_PARTS.includes(id))
+            run.push(id);
+        else {
+            flush();
+            entries.push({id});
+        }
+    }
+    flush();
+    return entries;
+}
+
+// ---------------------------------------------------------------- geometry
+
+// The band along one edge of one monitor. metrics: {inset, thickness,
+// margin, scale}; reserved: {top, bottom} depths of the horizontal bands on
+// this monitor, so a side band's ends sit just inside them.
+//   rect      the painted strip, where the band's groups sit
+//   along     [start, end] of usable length, stage coordinates
+//   depth     the work area the band reserves from the monitor edge
+export function bandGeometry(monitor, edge, metrics, reserved = {}) {
+    const {inset, thickness, margin} = metrics;
+    const vertical = isVertical(edge);
+    const depth = inset + thickness + margin;
+    let start, end;
+    if (vertical) {
+        start = monitor.y + Math.max(inset, reserved.top ?? 0);
+        end = monitor.y + monitor.height - Math.max(inset, reserved.bottom ?? 0);
+    } else {
+        start = monitor.x + inset;
+        end = monitor.x + monitor.width - inset;
+    }
+    const cross = {
+        top: monitor.y + inset,
+        bottom: monitor.y + monitor.height - inset - thickness,
+        left: monitor.x + inset,
+        right: monitor.x + monitor.width - inset - thickness,
+    }[edge];
+    const rect = vertical
+        ? {x: cross, y: start, width: thickness, height: Math.max(0, end - start)}
+        : {x: start, y: cross, width: Math.max(0, end - start), height: thickness};
+    const work = {
+        top: {x: monitor.x, y: monitor.y, width: monitor.width, height: depth},
+        bottom: {x: monitor.x, y: monitor.y + monitor.height - depth, width: monitor.width, height: depth},
+        left: {x: monitor.x, y: monitor.y, width: depth, height: monitor.height},
+        right: {x: monitor.x + monitor.width - depth, y: monitor.y, width: depth, height: monitor.height},
+    }[edge];
+    return {edge, vertical, rect, along: [start, end], length: Math.max(0, end - start), depth, work};
+}
+
+// Where the groups of one band sit. groups: [{anchor, position, length,
+// minLength, span}] with lengths along the band; separation: the least
+// distance between two groups. Returns [{start, length}] relative to the
+// band's start, in the same order.
+//
+//   1. Start groups sit against the start, end groups against the end,
+//      centre groups centred on the band, free groups at their position.
+//   2. Groups keep `separation` apart: centre and free groups shift away from
+//      their neighbours, staying as close to their ideal as they allow.
+//   3. When the band is still too short, the compressible group (the dock's)
+//      shortens to what is left, down to its minimum.
+//   4. A spanning group (shelf-span-full) stretches between its neighbours.
+//   5. Anything left over is clipped by the band, never by the screen.
+export function solveBand(bandLength, groups, separation = GROUP_SEPARATION) {
+    const n = groups.length;
+    if (!n)
+        return [];
+    const lengths = groups.map(group => Math.max(0, group.length));
+    const total = lengths.reduce((sum, length) => sum + length, 0) + separation * (n - 1);
+    let overflow = total - bandLength;
+    if (overflow > 0) {
+        groups.forEach((group, index) => {
+            if (overflow <= 0 || group.minLength === undefined)
+                return;
+            const shrink = Math.min(overflow, Math.max(0, lengths[index] - group.minLength));
+            lengths[index] -= shrink;
+            overflow -= shrink;
+        });
+    }
+    const ideal = groups.map((group, index) => {
+        const length = lengths[index];
+        switch (group.anchor) {
+        case 'start': return 0;
+        case 'end': return bandLength - length;
+        case 'free': return clamp(cleanPosition(group.position) * bandLength - length / 2, 0,
+            Math.max(0, bandLength - length));
+        default: return (bandLength - length) / 2;
+        }
+    });
+    // Order by where each group wants to be; anchored ends win ties.
+    const rank = {start: 0, center: 1, free: 1, end: 2};
+    const order = [...groups.keys()].sort((a, b) =>
+        (ideal[a] + lengths[a] / 2) - (ideal[b] + lengths[b] / 2) ||
+        rank[groups[a].anchor] - rank[groups[b].anchor] || a - b);
+    const starts = order.map(index => ideal[index]);
+    const len = order.map(index => lengths[index]);
+    const fixed = order.map(index => groups[index].anchor === 'start' || groups[index].anchor === 'end');
+    // Push forwards, then back, then forwards again: groups that must move
+    // move away from the fixed ends, and never past the band's start.
+    for (let i = 1; i < order.length; i++)
+        starts[i] = Math.max(starts[i], starts[i - 1] + len[i - 1] + separation);
+    for (let i = order.length - 1; i >= 0; i--) {
+        const limit = i === order.length - 1 ? bandLength : starts[i + 1] - separation;
+        if (!fixed[i] || starts[i] + len[i] > limit)
+            starts[i] = Math.min(starts[i], limit - len[i]);
+    }
+    for (let i = 0; i < order.length; i++) {
+        const limit = i === 0 ? 0 : starts[i - 1] + len[i - 1] + separation;
+        starts[i] = Math.max(starts[i], limit);
+    }
+    // A spanning group fills the room between its neighbours.
+    order.forEach((index, i) => {
+        if (!groups[index].span)
+            return;
+        const from = i === 0 ? 0 : starts[i - 1] + len[i - 1] + separation;
+        const to = i === order.length - 1 ? bandLength : starts[i + 1] - separation;
+        starts[i] = from;
+        len[i] = Math.max(len[i], to - from);
+    });
+    const result = new Array(n);
+    order.forEach((index, i) => {
+        const start = Math.round(starts[i]);
+        const length = Math.max(0, Math.round(Math.min(len[i], bandLength - start)));
+        result[index] = {start, length, clipped: length < Math.round(len[i])};
+    });
+    return result;
+}
+
+// The three snap points of an edge for an island of `length`: its centre
+// when it sits at the start, the centre or the end of the band.
+export function zonePoints(band, length) {
+    const [start, end] = band.along;
+    const half = Math.min(length, band.length) / 2;
+    return {start: start + half, center: (start + end) / 2, end: end - half};
+}
+
+// The dashed placeholder of a zone, in stage coordinates.
+export function zoneRect(band, anchor, scale = 1) {
+    const zone = Math.min(ZONE_LENGTH * scale, band.length);
+    const [start, end] = band.along;
+    const from = anchor === 'start' ? start : anchor === 'end' ? end - zone : (start + end - zone) / 2;
+    return band.vertical
+        ? {x: band.rect.x, y: Math.round(from), width: band.rect.width, height: Math.round(zone)}
+        : {x: Math.round(from), y: band.rect.y, width: Math.round(zone), height: band.rect.height};
+}
+
+function centreOf(rect) {
+    return [rect.x + rect.width / 2, rect.y + rect.height / 2];
+}
+
+function alongOf(point, vertical) {
+    return vertical ? point[1] : point[0];
+}
+
+function crossOf(point, vertical) {
+    return vertical ? point[0] : point[1];
+}
+
+// The monitor edge nearest a point, among those that offer zones.
+export function nearestEdge(point, monitor, sharedEdges = []) {
+    const [x, y] = point;
+    const distances = {
+        top: y - monitor.y,
+        bottom: monitor.y + monitor.height - y,
+        left: x - monitor.x,
+        right: monitor.x + monitor.width - x,
+    };
+    return EDGES.filter(edge => !sharedEdges.includes(edge))
+        .sort((a, b) => distances[a] - distances[b])[0] ?? null;
+}
+
+export function monitorAt(point, monitors) {
+    const [x, y] = point;
+    return monitors.find(m => x >= m.x && x < m.x + m.width && y >= m.y && y < m.y + m.height) ??
+        monitors.reduce((best, m) => {
+            const [cx, cy] = [clamp(x, m.x, m.x + m.width), clamp(y, m.y, m.y + m.height)];
+            const d = Math.hypot(cx - x, cy - y);
+            return !best || d < best.d ? {m, d} : best;
+        }, null)?.m ?? null;
+}
+
+// Resolve the drop target for an island (or a whole group) being dragged.
+//
+// point:    the dragged island's centre, stage coordinates
+// length:   its length along a horizontal edge and along a vertical one
+//           ({horizontal, vertical}), for the zone points
+// monitors: [{index, x, y, width, height, sharedEdges: [...],
+//             bands: {edge: band}}]  (bandGeometry for every non-shared edge)
+// groups:   [{index, monitor, edge, rect, islands: [{id, rect}]}], the
+//           groups as they are drawn without the dragged islands
+// dragged:  ids being dragged (so a group never attaches to itself)
+//
+// Returns, in priority order:
+//   {kind: 'attach', group, index, neighbour, side}
+//   {kind: 'snap',   monitor, edge, anchor}
+//   {kind: 'free',   monitor, edge, position}
+// or null on a shared edge, where nothing may be dropped.
+export function resolveTarget(point, length, monitors, groups, dragged = [], scale = 1) {
+    const monitor = monitorAt(point, monitors);
+    if (!monitor)
+        return null;
+    // 1. Attach: within ATTACH_DISTANCE of a group's run along its axis and
+    //    inside its band across it.
+    let best = null;
+    for (const group of groups) {
+        if (group.monitor !== monitor.index || !group.islands.length)
+            continue;
+        if (group.islands.every(island => dragged.includes(island.id)))
+            continue;
+        const band = monitor.bands[group.edge];
+        if (!band)
+            continue;
+        const vertical = isVertical(group.edge);
+        const along = alongOf(point, vertical);
+        const cross = crossOf(point, vertical);
+        const bandCross = vertical ? [band.work.x, band.work.x + band.work.width]
+            : [band.work.y, band.work.y + band.work.height];
+        if (cross < bandCross[0] || cross > bandCross[1])
+            continue;
+        const reach = ATTACH_DISTANCE * scale;
+        const islands = group.islands.filter(island => !dragged.includes(island.id));
+        if (!islands.length)
+            continue;
+        // Distance to the nearest island of the run, not to the group's
+        // box: a spanning group's slack between the dock and the status
+        // cluster is open band, where an island is placed freely.
+        const spans = islands.map(island => vertical
+            ? [island.rect.y, island.rect.y + island.rect.height]
+            : [island.rect.x, island.rect.x + island.rect.width]);
+        const distance = Math.min(...spans.map(([from, to]) =>
+            along < from ? from - along : along > to ? along - to : 0));
+        if (distance > reach)
+            continue;
+        // Insert before the first island whose centre is past the point.
+        let index = islands.findIndex(island => alongOf(centreOf(island.rect), vertical) > along);
+        if (index < 0)
+            index = islands.length;
+        const side = index === 0 ? 'before' : 'after';
+        const neighbour = index === 0 ? islands[0].id : islands[index - 1].id;
+        if (!best || distance < best.distance)
+            best = {kind: 'attach', group: group.index, index, neighbour, side, edge: group.edge,
+                monitor: monitor.index, distance};
+    }
+    if (best) {
+        delete best.distance;
+        return best;
+    }
+    // 2. Snap, 3. free: on the nearest edge that offers zones.
+    const edge = nearestEdge(point, monitor, monitor.sharedEdges ?? []);
+    if (!edge)
+        return null;
+    const band = monitor.bands[edge];
+    if (!band)
+        return null;
+    const vertical = isVertical(edge);
+    const islandLength = vertical ? length.vertical : length.horizontal;
+    const points = zonePoints(band, islandLength);
+    const along = alongOf(point, vertical);
+    for (const anchor of ZONE_ANCHORS) {
+        if (Math.abs(along - points[anchor]) <= SNAP_DISTANCE * scale)
+            return {kind: 'snap', monitor: monitor.index, edge, anchor};
+    }
+    const position = band.length > 0 ? clamp((along - band.along[0]) / band.length, 0, 1) : 0.5;
+    return {kind: 'free', monitor: monitor.index, edge, position};
+}
+
+// ------------------------------------------------------------------ moves
+
+// The display a monitor stands for in the arrangement: '' follows the
+// primary monitor, anything else pins the group to that display.
+export function displayFor(monitorIndex, monitors, primaryIndex) {
+    if (monitorIndex === primaryIndex)
+        return '';
+    return monitors.find(m => m.index === monitorIndex)?.id ?? '';
+}
+
+function removeIslands(groups, ids) {
+    for (const group of groups)
+        group.islands = group.islands.filter(id => !ids.includes(id));
+    return groups.filter(group => group.islands.length);
+}
+
+function placementFor(target, display) {
+    return {
+        display,
+        edge: target.edge,
+        anchor: target.kind === 'snap' ? target.anchor : 'free',
+        position: target.kind === 'free' ? Math.round(target.position * 10000) / 10000 : 0.5,
+    };
+}
+
+// Move islands `ids` (one island, or a whole group's islands in order) to a
+// resolved target. groups are the stored arrangement; target.group indexes
+// into them. Returns a new arrangement; the input is not changed.
+export function applyMove(groups, ids, target, display = '') {
+    let next = cloneArrangement(groups);
+    if (!target)
+        return next;
+    if (target.kind === 'attach') {
+        const host = next[target.group];
+        if (!host)
+            return next;
+        // The index was counted without the dragged islands.
+        const islands = host.islands.filter(id => !ids.includes(id));
+        islands.splice(Math.min(target.index, islands.length), 0, ...ids);
+        for (const group of next) {
+            if (group !== host)
+                group.islands = group.islands.filter(id => !ids.includes(id));
+        }
+        host.islands = islands;
+        return next.filter(group => group.islands.length);
+    }
+    next = removeIslands(next, ids);
+    next.push({...placementFor(target, display), islands: [...ids]});
+    return next;
+}
+
+// ---------------------------------------------------------------- keyboard
+
+// Every drop target on the monitor's edges, in the order the pointer meets
+// them along each edge: attach slots and zones. `groups` as for
+// resolveTarget. Returns [{target, edge, monitor, along}].
+export function orderedTargets(monitor, groups, dragged, length) {
+    const targets = [];
+    for (const edge of EDGES) {
+        const band = monitor.bands[edge];
+        if (!band || (monitor.sharedEdges ?? []).includes(edge))
+            continue;
+        const vertical = isVertical(edge);
+        const islandLength = vertical ? length.vertical : length.horizontal;
+        const points = zonePoints(band, islandLength);
+        const occupied = groups.filter(g => g.monitor === monitor.index && g.edge === edge &&
+            g.islands.some(island => !dragged.includes(island.id)));
+        for (const anchor of ZONE_ANCHORS) {
+            // A zone a group already covers is reached through its attach
+            // slots instead.
+            const covered = occupied.some(group => {
+                const from = vertical ? group.rect.y : group.rect.x;
+                const to = from + (vertical ? group.rect.height : group.rect.width);
+                return points[anchor] >= from - ISLAND_GAP && points[anchor] <= to + ISLAND_GAP;
+            });
+            if (!covered)
+                targets.push({target: {kind: 'snap', monitor: monitor.index, edge, anchor}, edge, along: points[anchor]});
+        }
+        for (const group of occupied) {
+            const islands = group.islands.filter(island => !dragged.includes(island.id));
+            for (let index = 0; index <= islands.length; index++) {
+                const before = islands[index - 1], after = islands[index];
+                const along = before && after
+                    ? (alongOf(centreOf(before.rect), vertical) + alongOf(centreOf(after.rect), vertical)) / 2
+                    : after ? (vertical ? after.rect.y : after.rect.x)
+                        : (vertical ? before.rect.y + before.rect.height : before.rect.x + before.rect.width);
+                targets.push({target: {kind: 'attach', group: group.index, index,
+                    neighbour: index === 0 ? islands[0].id : islands[index - 1].id,
+                    side: index === 0 ? 'before' : 'after', edge, monitor: monitor.index}, edge, along});
+            }
+        }
+    }
+    const edgeRank = {bottom: 0, top: 1, left: 2, right: 3};
+    return targets.sort((a, b) => edgeRank[a.edge] - edgeRank[b.edge] || a.along - b.along);
+}
+
+function sameTarget(a, b) {
+    if (!a || !b || a.kind !== b.kind || a.edge !== b.edge || a.monitor !== b.monitor)
+        return false;
+    if (a.kind === 'attach')
+        return a.group === b.group && a.index === b.index;
+    if (a.kind === 'snap')
+        return a.anchor === b.anchor;
+    return Math.abs(a.position - b.position) < 0.001;
+}
+
+// The next target from `current` for an arrow key. Along the current edge the
+// arrow steps through the ordered targets; across it, it jumps to the nearest
+// target on the edge in that direction: Up from the bottom-left corner goes
+// to the left edge's end, Up from the bottom centre to the top centre.
+// current: {edge, along} where the island is now (its centre along the edge,
+// and its fraction along the band for the jump).
+export function stepTarget(targets, current, direction, monitor) {
+    const vertical = isVertical(current.edge);
+    const alongKeys = vertical ? ['up', 'down'] : ['left', 'right'];
+    if (alongKeys.includes(direction)) {
+        const forward = direction === alongKeys[1];
+        const onEdge = targets.filter(t => t.edge === current.edge);
+        if (!onEdge.length)
+            return null;
+        const ahead = forward
+            ? onEdge.filter(t => t.along > current.along + 0.5 && !sameTarget(t.target, current.target))
+            : onEdge.filter(t => t.along < current.along - 0.5 && !sameTarget(t.target, current.target)).reverse();
+        return ahead[0]?.target ?? null;
+    }
+    // Across the edge: Up from the bottom-left corner goes to the left
+    // edge's end, Up from the bottom centre to the top centre; sideways off
+    // a side edge goes to the opposite side at the same height.
+    const fraction = current.fraction ?? 0.5;
+    const third = fraction < 1 / 3 ? 'start' : fraction > 2 / 3 ? 'end' : 'center';
+    const side = {start: 'left', end: 'right', center: null};
+    const jumps = {
+        bottom: {up: side[third] ?? 'top'},
+        top: {down: side[third] ?? 'bottom'},
+        left: {right: 'right'},
+        right: {left: 'left'},
+    };
+    const edge = jumps[current.edge]?.[direction];
+    const band = edge && monitor.bands[edge];
+    if (!band)
+        return null;
+    const onEdge = targets.filter(t => t.edge === edge);
+    if (!onEdge.length)
+        return null;
+    let wanted;
+    if (current.edge === 'bottom' && isVertical(edge))
+        wanted = band.along[1];
+    else if (current.edge === 'top' && isVertical(edge))
+        wanted = band.along[0];
+    else
+        wanted = band.along[0] + fraction * band.length;
+    return onEdge.reduce((best, t) =>
+        !best || Math.abs(t.along - wanted) < Math.abs(best.along - wanted) ? t : best, null).target;
+}
+
+// --------------------------------------------------------- announcements
+
+const EDGE_NAMES = {top: 'top edge', bottom: 'bottom edge', left: 'left edge', right: 'right edge'};
+
+// "Clock, attached to the right of Dock, bottom edge" or
+// "Media, top edge, left corner". names: id → display name; translate: _.
+export function describePlacement(groups, id, names, translate = s => s) {
+    const t = translate;
+    const group = groups.find(g => g.islands.includes(id));
+    const name = names[id] ?? id;
+    if (!group)
+        return name;
+    const vertical = isVertical(group.edge);
+    const edge = t(EDGE_NAMES[group.edge]);
+    const parts = [name];
+    if (group.islands.length > 1) {
+        const index = group.islands.indexOf(id);
+        const [neighbour, relation] = index > 0
+            ? [group.islands[index - 1], vertical ? t('attached below %s') : t('attached to the right of %s')]
+            : [group.islands[1], vertical ? t('attached above %s') : t('attached to the left of %s')];
+        parts.push(relation.replace('%s', names[neighbour] ?? neighbour));
+    }
+    parts.push(edge);
+    if (group.islands.length === 1) {
+        if (group.anchor === 'free')
+            parts.push(t('free position'));
+        else if (group.anchor === 'center')
+            parts.push(t('centre'));
+        else if (vertical)
+            parts.push(group.anchor === 'start' ? t('top end') : t('bottom end'));
+        else
+            parts.push(group.anchor === 'start' ? t('left corner') : t('right corner'));
+    }
+    return parts.join(', ');
+}
+
+// ---------------------------------------------------------- work area
+
+// One strut per occupied edge per monitor, the band's full depth along the
+// whole edge; the monitor's other edges keep the floating margin. Returns
+// [{monitor, edge, rect}] for struts and margins alike. `occupied`:
+// Map monitorIndex → Set of edges holding a placed group.
+export function reservations(monitors, occupied, metrics) {
+    const out = [];
+    for (const monitor of monitors) {
+        const edges = occupied.get(monitor.index);
+        if (!edges?.size)
+            continue;
+        for (const edge of EDGES) {
+            if ((monitor.sharedEdges ?? []).includes(edge))
+                continue;
+            if (edges.has(edge)) {
+                out.push({monitor: monitor.index, edge, rect: bandGeometry(monitor, edge, metrics).work, band: true});
+            } else if (metrics.margin > 0) {
+                const m = metrics.margin;
+                const rect = {
+                    top: {x: monitor.x, y: monitor.y, width: monitor.width, height: m},
+                    bottom: {x: monitor.x, y: monitor.y + monitor.height - m, width: monitor.width, height: m},
+                    left: {x: monitor.x, y: monitor.y, width: m, height: monitor.height},
+                    right: {x: monitor.x + monitor.width - m, y: monitor.y, width: m, height: monitor.height},
+                }[edge];
+                out.push({monitor: monitor.index, edge, rect, band: false});
+            }
+        }
+    }
+    return out;
+}
+
+// Which edges of a monitor touch another monitor. Mutter ignores struts
+// there, and a pointer would slide into the neighbour before reaching an
+// island, so a shared edge offers no zone.
+export function sharedEdges(monitor, monitors) {
+    const out = [];
+    const overlaps = (a0, a1, b0, b1) => Math.min(a1, b1) - Math.max(a0, b0) > 0;
+    for (const other of monitors) {
+        if (other === monitor)
+            continue;
+        if (other.x + other.width === monitor.x && overlaps(monitor.y, monitor.y + monitor.height, other.y, other.y + other.height))
+            out.push('left');
+        if (monitor.x + monitor.width === other.x && overlaps(monitor.y, monitor.y + monitor.height, other.y, other.y + other.height))
+            out.push('right');
+        if (other.y + other.height === monitor.y && overlaps(monitor.x, monitor.x + monitor.width, other.x, other.x + other.width))
+            out.push('top');
+        if (monitor.y + monitor.height === other.y && overlaps(monitor.x, monitor.x + monitor.width, other.x, other.x + other.width))
+            out.push('bottom');
+    }
+    return [...new Set(out)];
+}
+
+// Where each stored group is drawn now. monitors: [{index, id, primary}].
+// A group pinned to an absent display is drawn on the primary monitor at
+// the same edge and anchor, and joins a group already there; a saved edge
+// that became shared falls back to the bottom. The stored arrangement is not
+// rewritten, so the group goes back when its display returns.
+// Returns [{source: [stored group indexes], monitor, edge, anchor, position,
+// islands}].
+export function resolveDisplays(groups, monitors, primaryIndex, shared = new Map()) {
+    const byId = new Map(monitors.filter(m => m.id).map(m => [m.id, m.index]));
+    const resolved = [];
+    groups.forEach((group, index) => {
+        let monitor = group.display ? byId.get(group.display) : primaryIndex;
+        const absent = monitor === undefined;
+        if (absent)
+            monitor = primaryIndex;
+        let edge = group.edge;
+        if ((shared.get(monitor) ?? []).includes(edge))
+            edge = 'bottom';
+        const zone = group.anchor;
+        const host = absent && zone !== 'free'
+            ? resolved.find(r => r.monitor === monitor && r.edge === edge && r.anchor === zone)
+            : null;
+        if (host) {
+            host.islands.push(...group.islands);
+            host.source.push(index);
+            return;
+        }
+        resolved.push({source: [index], monitor, edge, anchor: group.anchor,
+            position: group.position, islands: [...group.islands], fallback: absent});
+    });
+    return resolved;
+}
