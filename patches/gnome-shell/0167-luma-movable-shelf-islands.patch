+        const [width, height] = this.get_surface_size();
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        const line = (node.lookup_length('-luma-line-width', false)[1] || scale);
+        const [hasDash, dash] = node.lookup_double('-luma-dash', false);
+        const radius = Math.min(node.get_border_radius(St.Corner.TOPLEFT), width / 2, height / 2);
+        const color = node.get_foreground_color();
