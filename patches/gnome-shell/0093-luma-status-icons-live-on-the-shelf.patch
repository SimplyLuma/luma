+        // Applications and extensions put status icons in the top panel: tray
+        // icons, hardware monitors, the Save button of a layout being edited.
+        // Luma has no top panel, so anything added to it after the shelf is
+        // built is adopted the moment it arrives instead of vanishing with it.
+        this._panelAddToStatusArea = Main.panel.addToStatusArea;
+        Main.panel.addToStatusArea = (...args) => {
+            const indicator = this._panelAddToStatusArea.apply(Main.panel, args);
+            this._queueAdoptPanelActors();
+            return indicator;
+        };
+
         this.connect('destroy', () => {
+            if (this._panelAddToStatusArea) {
+                Main.panel.addToStatusArea = this._panelAddToStatusArea;
+                this._panelAddToStatusArea = null;
+            }
+            if (this._adoptLaterId) GLib.source_remove(this._adoptLaterId);
+            this._adoptLaterId = 0;
             this._workArea?.destroy();
             for (const actor of this._edgeInsets ?? []) actor.destroy();
             if (this._indicatorLaterId) GLib.source_remove(this._indicatorLaterId);
