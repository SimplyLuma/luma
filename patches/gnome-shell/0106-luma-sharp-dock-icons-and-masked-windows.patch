From: Project Luma <builds@project-luma.local>
Subject: [PATCH] luma: sharp dock icons and masked windows

Dock icons read as pixelated. Clutter draws an offscreen effect with
nearest-texel sampling at whole display scales, and the centred dock sat on
a half pixel whenever its width was odd, so every masked icon was resampled
across that half pixel. The dock now snaps to whole pixels, and the icon and
window masks sample their offscreen texture linearly.

--- a/js/ui/iconMask.js
+++ b/js/ui/iconMask.js
@@ -18,6 +18,14 @@
 cogl_color_out *= 1.0 - smoothstep(radius - 0.02, radius + 0.02, corner);
 `;
 
+// Clutter draws an offscreen effect with nearest-texel sampling at whole
+// display scales. Any sub-pixel position or scale on the way to the screen
+// then duplicated and dropped rows of the icon, which read as pixelation.
+export function smoothOffscreenSampling(effect) {
+    const pipeline = effect.get_pipeline();
+    pipeline?.set_layer_filters(0, Cogl.PipelineFilter.LINEAR, Cogl.PipelineFilter.LINEAR);
+}
+
 export const LumaIconMask = GObject.registerClass(
 class LumaIconMask extends Shell.GLSLEffect {
     vfunc_build_pipeline() {
@@ -25,5 +33,10 @@
             Cogl.SnippetHook.FRAGMENT,
             ICON_MASK_DECLARATIONS, ICON_MASK_CODE, false);
     }
+
+    vfunc_paint_target(node, paintContext) {
+        smoothOffscreenSampling(this);
+        super.vfunc_paint_target(node, paintContext);
+    }
 });
 
