diff --git a/js/ui/lumaShelfSurface.js b/js/ui/lumaShelfSurface.js
new file mode 100644
index 0000000..d079b03
--- /dev/null
+++ b/js/ui/lumaShelfSurface.js
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// The one placement rule for surfaces that open from the shelf. Given the
+// actor that opened a surface, find the painted island holding it and put the
+// surface SHELF_SURFACE_GAP beyond that island's desktop-facing edge (see
+// shelfSurfacePlacement in shelfMetrics.js). Every shelf surface goes through
+// here; a new one is added here rather than given its own offset.
+
+import St from 'gi://St';
+
+import * as Main from './main.js';
+import {SHELF_SURFACE_GAP, shelfSurfacePlacement} from './shelfMetrics.js';
+
+export {SHELF_SURFACE_GAP};
+
+function stageRect(actor) {
+    const [x, y] = actor.get_transformed_position();
+    const [width, height] = actor.get_transformed_size();
+    return {x, y, width, height};
+}
+
+// The island an actor sits in: the dock, the status cluster, a live or media
+// island, the Well's island. When the shelf paints one connected surface, the
+// painted island is that surface, so its edges are the ones measured.
+export function shelfIslandFor(actor) {
+    for (let parent = actor?.get_parent?.(); parent; parent = parent.get_parent()) {
+        if (!parent.has_style_class_name?.('luma-shelf-island'))
+            continue;
+        if (parent.has_style_class_name('luma-shelf-root'))
+            return null;
+        for (let root = parent.get_parent(); root; root = root.get_parent()) {
+            if (root.has_style_class_name?.('luma-shelf-root'))
+                return root.has_style_class_name('luma-shelf-connected') ? root : parent;
+        }
+        return parent;
+    }
+    return null;
+}
+
+// Which side of its monitor the shelf is on.
+export function shelfEdge() {
+    return Main.shelf?._edge ?? Main.overview?.dash?._shelfEdge ?? 'bottom';
+}
+
+// Everything a surface opened by `actor` is placed from, or null when the
+// actor is not in a shown shelf island.
+export function shelfSurfaceSource(actor) {
+    const island = shelfIslandFor(actor);
+    if (!island?.mapped)
+        return null;
+    const index = Main.layoutManager.findIndexForActor(island);
+    const monitor = Main.layoutManager.monitors[index] ?? Main.layoutManager.primaryMonitor;
+    if (!monitor)
+        return null;
+    return {
+        island,
+        edge: shelfEdge(),
+        anchor: stageRect(actor),
+        islandRect: stageRect(island),
+        monitor,
+        monitorIndex: index,
+        scale: St.ThemeContext.get_for_stage(global.stage).scale_factor,
+    };
+}
+
+// Stage position {x, y} for a surface of `size` opened by `actor`, or null
+// when the actor is not in a shown shelf island.
+export function placeShelfSurface(actor, size) {
+    const source = shelfSurfaceSource(actor);
+    if (!source)
+        return null;
+    return {
+        ...shelfSurfacePlacement(source.edge, source.anchor, source.islandRect,
+            size, source.monitor, source.scale),
+        edge: source.edge,
+        source,
+    };
+}
