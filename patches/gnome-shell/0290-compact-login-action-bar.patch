+// Layout responds to available space, independently of device and presentation.
+export function compactLogin(width, scale) {
+    return width / scale <= 700;
+}
+
+export function restoreCompactLogin(card) {
+    if (!card._compactLayout)
+        return;
+    card._compactLayout = false;
+    card.set_style(null);
+    card._status.show();
+    card._syncTransparency();
+    card.opacity = 255;
+    card.translation_y = 0;
+    card.reactive = true;
+    const auth = card._compactAuth;
+    if (auth) {
+        for (const actor of [auth, auth._inputWell, auth._inputRow, auth._mainBox, auth._submitButton])
+            actor.set_style(null);
+        auth._userWell.show();
+        auth._message.show();
+        auth._submitArrow.icon_name = 'lumaui-corner-down-left-symbolic';
+    }
+}
+
+export function allocateCompactLogin(clock, card, prompt, width, height, scale, progress = 1) {
+    const inset = 16 * scale;
+    const cardWidth = Math.max(0, width - 2 * inset);
+    card.configureSize(cardWidth, scale);
+    card._compactLayout = true;
+    card.set_style('background-color: transparent; border: 0; box-shadow: none; padding: 0;');
+    card._blur.enabled = false;
+    card._status.hide();
+    prompt.y_align = Clutter.ActorAlign.END;
+    prompt.x_expand = true;
+    prompt.x_align = Clutter.ActorAlign.FILL;
+    // The original AuthPrompt keeps PAM, retry, error and accessibility behavior.
+    const auth = prompt._entry ? prompt : prompt.get_children().find(child => child._entry);
+    if (auth) {
+        card._compactAuth = auth;
+        auth._userWell.hide();
+        auth._message.visible = auth._message.opacity > 0;
+        if (!auth._compactMessageHook) {
+            auth._compactMessageHook = true;
+            auth._message.connectObject('notify::opacity', () => {
+                auth._message.visible = !card._compactLayout || auth._message.opacity > 0;
+            }, auth);
+        }
+        const logicalWidth = Math.max(0, cardWidth / scale - 16);
+        auth.set_style(`width: ${logicalWidth}px; spacing: 12px;`);
+        auth._inputWell.set_style(`width: ${logicalWidth}px;`);
+        auth._inputRow.set_style(`width: ${Math.max(0, logicalWidth - 12)}px; padding: 6px; spacing: 6px; border-radius: 18px; background-color: rgba(30,30,36,0.72); border: 1px solid rgba(255,255,255,0.16);`);
+        auth._mainBox.set_style(`width: ${Math.max(0, logicalWidth - 82)}px; height: 44px; min-width: 0; padding: 0 8px; border-radius: 14px;`);
+        auth._submitButton.set_style('width: 44px; height: 44px; border-radius: 14px;');
+        auth._submitArrow.icon_name = 'go-next-symbolic';
+        auth._submitButton.accessible_name = _('Unlock');
+    }
+    card.allocate(new Clutter.ActorBox({x1: inset, x2: width - inset,
+        y1: Math.max(height * 0.4, inset), y2: Math.max(inset, height - inset)}));
+    card.opacity = Math.round(255 * progress);
+    card.translation_y = (1 - progress) * 48 * scale;
+    card.reactive = progress > 0;
+    clock.allocateCompact(width, height, scale, progress);
+}
