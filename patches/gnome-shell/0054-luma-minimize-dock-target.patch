+    getShelfIconGeometry(window) {
+        if (!this._shelfEdge || !this.mapped)
+            return null;
+        const app = Shell.WindowTracker.get_default().get_window_app(window);
+        const item = this._box.get_children().find(child =>
+            child.child?._delegate?.app === app);
+        const icon = item?.child?._delegate?.icon?.icon;
+        if (!app || !icon?.mapped)
+            return null;
+        const [x, y] = icon.get_transformed_position();
+        const [width, height] = icon.get_transformed_size();
+        return width > 0 && height > 0 ? {x, y, width, height} : null;
+    }
+
