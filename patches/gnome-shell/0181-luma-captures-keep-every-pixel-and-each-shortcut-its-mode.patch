+    // Luma Capture: the scale a capture of this area is taken at. An area on
+    // one monitor gets that monitor's scale, so it keeps exactly its pixels;
+    // an area across monitors of different scales gets the largest, so no
+    // part of it is scaled down.
+    _captureScale(x, y, width, height) {
+        const {monitors} = Main.layoutManager;
+        let scale = 0;
+        monitors.forEach((monitor, index) => {
+            if (x < monitor.x + monitor.width && x + width > monitor.x &&
+                y < monitor.y + monitor.height && y + height > monitor.y)
+                scale = Math.max(scale, global.display.get_monitor_scale(index));
+        });
+        return scale || this._scale || 1;
+    }
+
+    // The stage painted at `scale`, or null if it could not be.
+    _paintStageAt(scale) {
+        try {
+            const rect = new Mtk.Rectangle({
+                x: 0, y: 0, width: global.stage.width, height: global.stage.height,
+            });
+            const content = global.stage.paint_to_content(rect, scale, null,
+                Clutter.PaintFlag.NO_CURSORS);
+            return content?.get_texture() ?? null;
+        } catch (e) {
+            logError(e, `Luma Capture: could not paint the screen at scale ${scale}`);
+            return null;
+        }
+    }
+
+    // The frozen screen at every monitor scale, next to the one the tool
+    // shows (painted at the largest), so a capture on a monitor with a
+    // smaller scale is cut from a picture at its own scale.
+    _paintEachScale(shownScale) {
+        this._stageTextures = new Map([[shownScale, this._stageScreenshot.get_content()?.get_texture()]]);
+        const scales = new Set(Main.layoutManager.monitors.map(
+            (_monitor, index) => global.display.get_monitor_scale(index)));
+        for (const scale of scales) {
+            if (this._stageTextures.has(scale))
+                continue;
+            const texture = this._paintStageAt(scale);
+            if (texture)
+                this._stageTextures.set(scale, texture);
+        }
+    }
+
