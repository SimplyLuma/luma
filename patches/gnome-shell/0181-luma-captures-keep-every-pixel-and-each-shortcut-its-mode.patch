+// The shortcut that opens each screenshot mode, from the keybinding settings.
+const MODE_SHORTCUT_KEYS = {
+    [Mode.SELECTION]: 'show-screenshot-ui-area',
+    [Mode.WINDOW]: 'screenshot-window',
+    [Mode.SCREEN]: 'show-screenshot-ui-screen',
+};
+
+// "<Ctrl><Shift>1" as "Ctrl+Shift+1".
+export function formatAccelerator(accel) {
+    const names = {control: 'Ctrl', ctrl: 'Ctrl', primary: 'Ctrl', shift: 'Shift',
+        alt: 'Alt', mod1: 'Alt', super: 'Super', mod4: 'Super', meta: 'Meta'};
+    const parts = [];
+    let rest = accel.trim();
+    for (let match = rest.match(/^<([^>]+)>/); match; match = rest.match(/^<([^>]+)>/)) {
+        parts.push(names[match[1].toLowerCase()] ?? match[1]);
+        rest = rest.slice(match[0].length);
+    }
+    if (!rest)
+        return '';
+    parts.push(rest.length === 1 ? rest.toUpperCase() : rest);
+    return parts.join('+');
+}
+
+function modeShortcut(mode) {
+    const key = MODE_SHORTCUT_KEYS[mode];
+    if (!key)
+        return null;
+    try {
+        const settings = new Gio.Settings({schema_id: 'org.gnome.shell.keybindings'});
+        if (!settings.settings_schema.has_key(key))
+            return null;
+        const [accel] = settings.get_strv(key);
+        return accel ? formatAccelerator(accel) || null : null;
+    } catch {
+        return null;
+    }
+}
