diff --git a/js/ui/status/cellular.js b/js/ui/status/cellular.js
new file mode 100644
--- /dev/null
+++ b/js/ui/status/cellular.js
@@ -0,0 +1,105 @@
+// The cellular state of the device's modem for the status area: signal while
+// it is on a network, no service, or no SIM. Read from ModemManager, which
+// knows a modem's registration and SIM whether or not a data connection uses
+// it; lumaPresentation/cellularStatus.js maps what it publishes.
+import Gio from 'gi://Gio';
+import GObject from 'gi://GObject';
+
+import {SystemIndicator} from '../quickSettings.js';
+import {cellularStatus} from '../lumaPresentation/cellularStatus.js';
+
+const BUS_NAME = 'org.freedesktop.ModemManager1';
+const OBJECT_PATH = '/org/freedesktop/ModemManager1';
+const MODEM_IFACE = 'org.freedesktop.ModemManager1.Modem';
+const MODEM_3GPP_IFACE = 'org.freedesktop.ModemManager1.Modem.Modem3gpp';
+
+const CellularState = GObject.registerClass({
+    Properties: {
+        // Whether the device has a modem.
+        'present': GObject.ParamSpec.boolean('present', null, null,
+            GObject.ParamFlags.READABLE, false),
+        'icon-name': GObject.ParamSpec.string('icon-name', null, null,
+            GObject.ParamFlags.READABLE, null),
+    },
+}, class CellularState extends GObject.Object {
+    constructor() {
+        super();
+
+        this._status = null;
+        this._manager = null;
+        Gio.DBusObjectManagerClient.new_for_bus(Gio.BusType.SYSTEM,
+            Gio.DBusObjectManagerClientFlags.DO_NOT_AUTO_START,
+            BUS_NAME, OBJECT_PATH, null, null, (_source, result) => {
+                try {
+                    this._manager =
+                        Gio.DBusObjectManagerClient.new_for_bus_finish(result);
+                } catch (e) {
+                    console.warn(`Cellular state: ${e.message}`);
+                    return;
+                }
+                for (const signal of ['object-added', 'object-removed',
+                    'interface-added', 'interface-removed',
+                    'interface-proxy-properties-changed', 'notify::name-owner'])
+                    this._manager.connect(signal, () => this._sync());
+                this._sync();
+            });
+    }
+
+    get present() {
+        return this._status !== null;
+    }
+
+    get iconName() {
+        return this._status?.icon ?? null;
+    }
+
+    _sync() {
+        const read = (proxy, name) =>
+            proxy?.get_cached_property(name)?.recursiveUnpack() ?? null;
+        const modems = [];
+        for (const object of this._manager.get_objects()) {
+            const modem = object.get_interface(MODEM_IFACE);
+            if (!modem)
+                continue;
+            const modem3gpp = object.get_interface(MODEM_3GPP_IFACE);
+            modems.push({
+                path: object.get_object_path(),
+                state: read(modem, 'State'),
+                failedReason: read(modem, 'StateFailedReason') ?? undefined,
+                sim: read(modem, 'Sim'),
+                quality: read(modem, 'SignalQuality')?.[0],
+                registration: read(modem3gpp, 'RegistrationState'),
+            });
+        }
+        modems.sort((a, b) => a.path.localeCompare(b.path));
+
+        const previous = this._status;
+        this._status = cellularStatus(modems);
+        if ((previous === null) !== (this._status === null))
+            this.notify('present');
+        if (previous?.icon !== this._status?.icon)
+            this.notify('icon-name');
+    }
+});
+
+let _state = null;
+
+// One reader for the indicator and for the network indicator, which leaves
+// the signal to this one while mobile data is the connection.
+export function getCellularState() {
+    return (_state ??= new CellularState());
+}
+
+export const Indicator = GObject.registerClass(
+class Indicator extends SystemIndicator {
+    _init() {
+        super._init();
+
+        this._indicator = this._addIndicator();
+        const state = getCellularState();
+        state.bind_property('present', this._indicator, 'visible',
+            GObject.BindingFlags.SYNC_CREATE);
+        state.bind_property('icon-name', this._indicator, 'icon-name',
+            GObject.BindingFlags.SYNC_CREATE);
+    }
+});
