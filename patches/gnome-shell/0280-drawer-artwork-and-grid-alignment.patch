From: Luma Developers
Subject: [PATCH] Align application drawer cells and use matching blue shortcut artwork

diff --git a/js/ui/lumaDockFolders.js b/js/ui/lumaDockFolders.js
--- a/js/ui/lumaDockFolders.js
+++ b/js/ui/lumaDockFolders.js
@@ -404,7 +404,11 @@
     }
 
     setFolder(model) {
-        const gicon = model?.gicon ?? null;
+        const downloads = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD);
+        const artwork = model?.isApplications ? 'applications'
+            : downloads && model?.file?.get_path() === downloads ? 'downloads' : null;
+        const gicon = artwork ? new Gio.FileIcon({file: Gio.File.new_for_uri(
+            `resource:///org/gnome/shell/theme/luma-dock-${artwork}.svg`)}) : model?.gicon ?? null;
         const key = gicon ? gicon.to_string() : 'folder';
         if (this._key === key)
             return;
@@ -737,6 +741,7 @@
         const apps = Boolean(this._controller.openFolder?.isApplications);
         const metrics = this._controller.applicationMetrics();
         this._views.visible = !apps;
+        this._meta.visible = !apps;
         this.search.visible = apps;
         if (apps) this.add_style_class_name('luma-dockf-applications');
         else this.remove_style_class_name('luma-dockf-applications');
@@ -818,7 +823,7 @@
             line_alignment: Pango.Alignment.CENTER});
         box.add_child(name);
         const meta = metaFor(item);
-        const caption = new St.Label({style_class: 'luma-dockf-cell-meta', text: meta,
+        const caption = new St.Label({style_class: 'luma-dockf-cell-meta', text: meta, visible: !item.app,
             x_align: Clutter.ActorAlign.FILL});
         caption.clutter_text.set({ellipsize: Pango.EllipsizeMode.END,
             line_wrap: true, line_wrap_mode: Pango.WrapMode.WORD_CHAR,
@@ -1249,6 +1254,9 @@
         const query = model.isApplications ? this._surface.search.get_text().trim().toLocaleLowerCase() : '';
         const items = query ? model.items.filter(item => item.name.toLocaleLowerCase().includes(query)) : model.items;
         const columns = this.gridColumns();
+        const cellWidth = model.isApplications
+            ? Math.floor((this.applicationMetrics().width - (24 + 8 * (columns - 1)) * scaleFactor()) / columns)
+            : null;
         if (model.isApplications) {
             this._surface._meta.text = ngettext('%d application', '%d applications', model.count).format(model.count);
             if (!items.length) body.add_child(new St.Label({text: query ? _('No applications match your search') : _('No applications installed'),
@@ -1263,6 +1271,10 @@
                 }
                 const cell = new FolderCell(item);
                 cell.x_expand = true;
+                if (cellWidth !== null) {
+                    cell.width = cellWidth;
+                    cell.height = 132 * scaleFactor();
+                }
                 cell.connect('clicked', () => this._activate(item));
                 if (!item.app) this._hookItemMenu(cell, item);
                 row.add_child(cell);
@@ -1271,7 +1283,8 @@
             const remainder = items.length % columns;
             if (row && remainder) {
                 for (let i = remainder; i < columns; i++)
-                    row.add_child(new St.Widget({x_expand: true}));
+                    row.add_child(new St.Widget({x_expand: true,
+                        ...(cellWidth !== null ? {width: cellWidth, height: 132 * scaleFactor()} : {})}));
             }
         } else {
             for (const item of items) {
diff --git a/data/theme/luma-shelf.css b/data/theme/luma-shelf.css
--- a/data/theme/luma-shelf.css
+++ b/data/theme/luma-shelf.css
@@ -3274,3 +3274,13 @@
 .luma-dockf-applications .luma-dockf-thumb-large { background-color: transparent; border-width: 0; }
 .luma-dockf-applications .luma-dockf-cell-meta { height: 0; padding: 0; margin: 0; }
 .luma-dockf-empty { padding: 32px 16px; text-align: center; }
+
+/* A single title line and a quiet gap before search; app counts remain in the model. */
+.luma-dockf-applications .luma-dockf-head {
+  height: 48px; padding: 8px 12px 4px 16px; spacing: 10px; border-bottom-width: 0;
+}
+.luma-dockf-applications .luma-dockf-head-name { font-size: 16px; }
+.luma-dockf-applications .luma-dockf-search { margin: 4px 16px 16px; }
+.luma-dockf-applications .luma-dockf-cell-name { height: 34px; }
+
+.luma-dockf-applications .luma-dockf-grid { padding: 12px; spacing: 8px; }
diff --git a/data/gnome-shell-theme.gresource.xml b/data/gnome-shell-theme.gresource.xml
--- a/data/gnome-shell-theme.gresource.xml
+++ b/data/gnome-shell-theme.gresource.xml
@@ -13,6 +13,8 @@
     <file>luma-share.css</file>
     <file>luma-cast.css</file>
     <file>luma-shelf.css</file>
+    <file>luma-dock-applications.svg</file>
+    <file>luma-dock-downloads.svg</file>
     <file>gnome-shell-start.svg</file>
     <file>pad-osd.css</file>
     <file>prairie-daybreak.svg</file>
