     Properties: {
         'title': GObject.ParamSpec.string(
@@ -678,8 +706,7 @@ export const Message = GObject.registerClass({
                 logError(error, 'Luma notification tile mask unavailable');
             }
         }
-        sourceIcon.connectObject('notify::is-symbolic', () => this._syncTile(),
-            'notify::gicon', () => this._syncTile(), this);
+        sourceIcon.connectObject('notify::gicon', () => this._syncTile(), this);
         this._icon.visible = false;
         this._syncTile();
 
@@ -733,16 +760,17 @@ export const Message = GObject.registerClass({
             return;
         const sourceIcon = this._header.sourceIcon;
         const image = this._icon.gicon;
-        // A person or content image stands in for the app tile; the source
-        // row still names the app. A symbolic image is a glyph, not a photo,
-        // and keeps the app's tile.
-        const imageIsGlyph = image instanceof Gio.ThemedIcon &&
-            image.get_names().some(name => name.endsWith('-symbolic'));
-        const showImage = !!image && !imageIsGlyph;
+        // A person or content image -- a sender's avatar, a photo -- stands in
+        // for the app tile; the source row still names the app. Anything from
+        // the icon theme is a glyph or an app icon, not a picture, and keeps
+        // the app's full-colour tile, as does a symbolic image file: a glyph
+        // drawn at tile size is what made a mail notification's icon look
+        // tiny on its card.
+        const showImage = !!image && isPicture(image);
         this._tileImage.gicon = showImage ? image : null;
         this._tileImage.visible = showImage;
         sourceIcon.visible = !showImage;
-        const glyph = !showImage && sourceIcon.is_symbolic;
+        const glyph = !showImage && isGlyphIcon(sourceIcon.gicon);
         this._tile.remove_style_class_name(glyph
             ? 'luma-notification-tile-art' : 'luma-notification-tile-glyph');
         this._tile.add_style_class_name(glyph
diff --git a/js/ui/notificationDaemon.js b/js/ui/notificationDaemon.js
index e068d5a..36a2e56 100644
--- a/js/ui/notificationDaemon.js
+++ b/js/ui/notificationDaemon.js
@@ -87,18 +87,16 @@ class FdoNotificationDaemon {
         return null;
     }
 
+    // The app a notification belongs to decides the icon on its card, its
+    // title and its policy. The desktop-entry hint is the sender naming its
+    // own app, so it comes first: a background agent, a portable app or a
+    // capsule runs in a process the window tracker cannot place, or places
+    // under something else, and its card then showed whatever icon the
+    // notification carried -- often a symbolic glyph -- instead of the app.
     _getApp(pid, appId, appName) {
-        const appSys = Shell.AppSystem.get_default();
-        let app;
-
-        app = Shell.WindowTracker.get_default().get_app_from_pid(pid);
-        if (!app && appId)
-            app = appSys.lookup_app(`${appId}.desktop`);
-
-        if (!app)
-            app = appSys.lookup_app(`${appName}.desktop`);
-
-        return app;
+        return lookupNotifyingApp(appId) ??
+            Shell.WindowTracker.get_default().get_app_from_pid(pid) ??
+            lookupNotifyingApp(appName, {byName: true});
     }
 
     // Returns the source associated with an app.
@@ -382,6 +380,36 @@ class FdoNotificationDaemon {
     }
 }
 
+// Resolve the app a notification names, by desktop ID first and then more
+// loosely: the ID in another case, an ID that ends in the given name
+// ("charlie" -> org.projectluma.Charlie), the window class, and with byName the
+// app's own display name ("Charlie"). A loose match counts only when exactly
+// one installed app answers it, so a guess never picks between two apps.
+export function lookupNotifyingApp(name, {byName = false} = {}) {
+    if (!name)
+        return null;
+    const appSys = Shell.AppSystem.get_default();
+    const id = name.replace(/\.desktop$/, '');
+    const exact = appSys.lookup_app(`${id}.desktop`);
+    if (exact)
+        return exact;
+
+    const wanted = id.toLowerCase();
+    const ids = new Set();
+    for (const info of appSys.get_installed()) {
+        const infoId = info.get_id();
+        if (!infoId)
+            continue;
+        const bare = infoId.replace(/\.desktop$/, '').toLowerCase();
+        const wmClass = info.get_startup_wm_class?.()?.toLowerCase() ?? '';
+        const shown = info.should_show?.() ?? true;
+        if (bare === wanted || bare.endsWith(`.${wanted}`) || wmClass === wanted ||
+            (byName && shown && info.get_name()?.toLowerCase() === wanted))
+            ids.add(infoId);
+    }
+    return ids.size === 1 ? appSys.lookup_app([...ids][0]) : null;
+}
+
 export const FdoNotificationDaemonSource = GObject.registerClass(
 class FdoNotificationDaemonSource extends MessageTray.Source {
     constructor(sender, app) {
