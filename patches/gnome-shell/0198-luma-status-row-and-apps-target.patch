-            this._statusClockBox.add_child(this._statusTime);
+            // Studio Desktop: the time large, a small AM/PM beside it.
+            this._statusAmPm = new St.Label({style_class: 'luma-status-ampm',
+                y_align: Clutter.ActorAlign.END, visible: false});
+            this._statusTimeRow = new St.BoxLayout({x_align: Clutter.ActorAlign.START});
