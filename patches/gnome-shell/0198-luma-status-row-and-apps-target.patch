+            this._statusTimeRow.add_child(this._statusAmPm);
+            this._statusClockBox.add_child(this._statusTimeRow);
             this._statusClockBox.add_child(this._statusDateLabel);
             this._statusClockBox.add_child(this._statusDateShort);
             const shortDate = () => {
@@ -1371,11 +1383,24 @@ class QuickSettings extends PanelMenu.Button {
             dateMenu._dateDisplay.connectObject('notify::text', shortDate, this);
             shortDate();
             this._statusClock.child = this._statusClockBox;
-            // Bind the owned clock, rather than running another timer.
-            dateMenu._timeDisplay.bind_property('text', this._statusTime, 'text',
-                GObject.BindingFlags.SYNC_CREATE);
-            dateMenu._dateDisplay.bind_property('text', this._statusDateLabel, 'text',
-                GObject.BindingFlags.SYNC_CREATE);
+            // Follow the owned clock, rather than running another timer.
+            // Studio Desktop writes the time large with a small AM/PM beside
+            // it in the secondary ink, and the date as "Fri, Sep 25".
+            const syncTime = () => {
+                const text = dateMenu._timeDisplay.text ?? '';
+                const match = /^(.*?)\s*([AaPp]\.?[Mm]\.?)$/.exec(text);
+                this._statusTime.text = match ? match[1] : text;
+                this._statusAmPm.text = match ? match[2] : '';
+                this._statusAmPm.visible = Boolean(match) && !this._statusClockVertical;
+            };
+            const syncDate = () => {
+                this._statusDateLabel.text = GLib.DateTime.new_now_local().format('%a, %b %-d') ??
+                    dateMenu._dateDisplay.text;
+            };
+            dateMenu._timeDisplay.connectObject('notify::text', syncTime, this);
+            dateMenu._dateDisplay.connectObject('notify::text', syncDate, this);
+            syncTime();
+            syncDate();
             for (const label of [this._statusTime, this._statusDateLabel]) {
                 label.connectObject('notify::text', () => this._updateStatusName(), this);
                 label.connect_after('style-changed', () => this._setStatusLineHeight(label));
@@ -1498,6 +1523,10 @@ class QuickSettings extends PanelMenu.Button {
