From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <builds@project-luma.local>
Date: Sat, 26 Sep 2026 00:00:00 +0000
Subject: [PATCH] luma: the status island and the Apps target match Studio

The status island is one row of 15px glyphs in the secondary ink, 12px
apart: Wi-Fi, the sound output and the battery (at 75%), with the
microphone only while something listens. The time reads 21/600 with a small
AM/PM beside it, over the date as "Fri, Sep 25" (11.5/500), left-aligned.
The dock's Apps target is Lucide's grid at 18px in the secondary ink.

diff --git a/data/gnome-shell-icons.gresource.xml b/data/gnome-shell-icons.gresource.xml
index 04ce581..d98f396 100644
--- a/data/gnome-shell-icons.gresource.xml
+++ b/data/gnome-shell-icons.gresource.xml
@@ -50,6 +50,7 @@
     <file preprocess="xml-stripblanks">scalable/actions/shell-focus-top-bar-symbolic-rtl.svg</file>
     <file preprocess="xml-stripblanks">scalable/actions/shell-focus-windows-symbolic.svg</file>
     <file preprocess="xml-stripblanks">scalable/status/background-app-ghost-symbolic.svg</file>
+    <file preprocess="xml-stripblanks">scalable/status/luma-grid-2x2-symbolic.svg</file>
     <file preprocess="xml-stripblanks">scalable/status/check-symbolic.svg</file>
     <file preprocess="xml-stripblanks">scalable/status/keyboard-brightness-high-symbolic.svg</file>
     <file preprocess="xml-stripblanks">scalable/status/keyboard-brightness-medium-symbolic.svg</file>
diff --git a/data/icons/scalable/status/luma-grid-2x2-symbolic.svg b/data/icons/scalable/status/luma-grid-2x2-symbolic.svg
new file mode 100644
index 0000000..332483d
--- /dev/null
+++ b/data/icons/scalable/status/luma-grid-2x2-symbolic.svg
@@ -0,0 +1,7 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Lucide grid-2x2 geometry, ISC; strokes outlined for symbolic recolouring. -->
+<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
+  <path fill-rule="evenodd" d="M5,2 L19,2 Q22,2 22,5 L22,19 Q22,22 19,22 L5,22 Q2,22 2,19 L2,5 Q2,2 5,2 Z M5,4 Q4,4 4,5 L4,19 Q4,20 5,20 L19,20 Q20,20 20,19 L20,5 Q20,4 19,4 Z" fill="#2e3436"/>
+  <path d="M4,11 L20,11 L20,13 L4,13 Z" fill="#2e3436"/>
+  <path d="M11,4 L13,4 L13,20 L11,20 Z" fill="#2e3436"/>
+</svg>
diff --git a/data/theme/luma-shelf.css b/data/theme/luma-shelf.css
index 6f5806a..488d7b6 100644
--- a/data/theme/luma-shelf.css
+++ b/data/theme/luma-shelf.css
@@ -3100,3 +3100,16 @@ StBoxLayout.luma-notification-tray.luma-surface-dark .luma-notification-tray-cou
 .luma-live-extension-wave-bar { width: 3px; border-radius: 2px; background-color: #ff645f; }
 .luma-live-extension-paused .luma-live-extension-wave-bar { background-color: rgba(231,233,232,0.42); }
 .luma-shelf-live-island .luma-live-extension-recording .luma-live-extension-actions { spacing: 4px; }
+
+/* Studio Desktop status island: one row of 15px glyphs in the secondary ink,
+ * 12px apart (battery at 75%), a hairline, then the time (21/600) over the
+ * date (11.5/500), left-aligned. The Apps target is an 18px grid in the
+ * secondary ink. */
+.luma-status-cluster .luma-status-slot .system-status-icon { color: rgba(231,233,232,0.62); }
+.luma-status-cluster.luma-surface-light .luma-status-slot .system-status-icon { color: rgba(22,25,29,0.76); }
+.luma-status-cluster .luma-status-time { font-size: 21px; font-weight: 600; letter-spacing: -0.3px; font-feature-settings: "tnum"; }
+.luma-status-cluster .luma-status-date { font-size: 11.5px; font-weight: 500; }
+.luma-shelf-dock-island #dash .show-apps .show-apps-icon { color: rgba(231,233,232,0.62); }
+.luma-shelf-dock-island .luma-surface-light #dash .show-apps .show-apps-icon,
+.luma-shelf-dock-island.luma-surface-light #dash .show-apps .show-apps-icon { color: rgba(22,25,29,0.76); }
+.luma-status-cluster .luma-status-clock-text { spacing: 0; }
diff --git a/js/ui/dash.js b/js/ui/dash.js
index a0679f3..355502d 100644
--- a/js/ui/dash.js
+++ b/js/ui/dash.js
@@ -409,7 +409,8 @@ class ShowAppsIcon extends DashItemContainer {
 
     _createIcon(size) {
         this._iconActor = new St.Icon({
-            icon_name: 'view-app-grid-symbolic',
+            // The shelf's Apps target is Lucide's grid-2x2 (Studio Desktop).
+            icon_name: this._lumaShelf ? 'luma-grid-2x2-symbolic' : 'view-app-grid-symbolic',
             icon_size: this._lumaShelf ? 18 : size,
             style_class: 'show-apps-icon luma-shelf-artwork',
             track_hover: true,
diff --git a/js/ui/panel.js b/js/ui/panel.js
index 9ce6eab..edaafaf 100644
--- a/js/ui/panel.js
+++ b/js/ui/panel.js
@@ -71,8 +71,8 @@ const LUMA_LIVE_REQUEST_ROOT = '/org/projectluma/SemanticBroker1/request';
 const LUMA_LIVE_REQUEST_TIMEOUT = 35;
 const LUMA_LIVE_EXTENSION_TOOLTIP_DELAY = 300;
 // The status grid: 14px glyphs, 8 apart across and 6 apart down.
-const STATUS_GLYPH = 14;
-const STATUS_COLUMN_GAP = 8;
+const STATUS_GLYPH = 15;
+const STATUS_COLUMN_GAP = 12;
 const STATUS_ROW_GAP = 6;
 // Ink, secondary ink and rules of the status island, per surface treatment.
 // The status cluster keeps no ink table of its own: it reads the one ledger
@@ -1198,9 +1198,15 @@ class ShelfStatusLayout extends Clutter.LayoutManager {
         return container.get_children().filter(child => child.visible);
     }
 
+    // Studio Desktop's status is one row of glyphs along a horizontal
+    // shelf, and a two-wide grid down a side one.
     _columns(container) {
-        return this._vertical ? 2 : Math.max(3,
-            Math.ceil(this._visibleChildren(container).length / 2));
+        return this._vertical ? 2 : Math.max(1, this._visibleChildren(container).length);
+    }
+
+    _rows(container) {
+        return this._vertical
+            ? Math.max(2, Math.ceil(this._visibleChildren(container).length / 2)) : 1;
     }
 
     _scale() {
@@ -1241,7 +1247,7 @@ class ShelfStatusLayout extends Clutter.LayoutManager {
             return [minHeight, natHeight];
         }
 
-        const rows = Math.max(2, Math.ceil(this._visibleChildren(container).length / this._columns(container)));
+        const rows = this._rows(container);
         const glyphs = rows * STATUS_GLYPH + (rows - 1) * STATUS_ROW_GAP;
         return [glyphs * this._scale(), Math.max(DASH_TILE_SIZE, glyphs) * this._scale()];
     }
@@ -1270,7 +1276,7 @@ class ShelfStatusLayout extends Clutter.LayoutManager {
 
         const scale = this._scale();
         const columns = this._columns(container);
-        const rows = Math.max(2, Math.ceil(children.length / columns));
+        const rows = this._rows(container);
         const cell = STATUS_GLYPH * scale;
         const columnGap = STATUS_COLUMN_GAP * scale;
         const rowGap = STATUS_ROW_GAP * scale;
@@ -1356,13 +1362,19 @@ class QuickSettings extends PanelMenu.Button {
