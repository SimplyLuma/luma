diff --git a/board/samsung/exynos-mobile/luma-fit.S b/board/samsung/exynos-mobile/luma-fit.S
new file mode 100644
index 0000000..776009f
--- /dev/null
+++ b/board/samsung/exynos-mobile/luma-fit.S
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+
+	.section .rodata.luma_fit, "a"
+	.balign 8
+	.global luma_fit_start
+	.type luma_fit_start, %object
+luma_fit_start:
+	.incbin "board/samsung/exynos-mobile/luma-payload.fit"
+	.global luma_fit_end
+luma_fit_end:
+	.size luma_fit_start, luma_fit_end - luma_fit_start
+
+	.section .note.GNU-stack, "", %progbits
+	.balign 8
