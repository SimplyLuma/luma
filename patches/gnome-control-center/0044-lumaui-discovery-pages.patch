diff --git a/shell/cc-application.c b/shell/cc-application.c
index e3e9a4f..93b620b 100644
--- a/shell/cc-application.c
+++ b/shell/cc-application.c
@@ -238,6 +238,12 @@ cc_application_handle_local_options (GApplication *application,
       CcApplication *self = CC_APPLICATION (application);
       g_autoptr (GError) error = NULL;
       const char *page = g_getenv ("LUMA_SETTINGS_PAGE");
+      const char *query = g_getenv ("LUMA_SETTINGS_QUERY");
+      if (query && *query)
+        {
