diff --git a/shell/cc-luma-view-discovery.c b/shell/cc-luma-view-discovery.c
new file mode 100644
index 0000000..fd4a543
--- /dev/null
+++ b/shell/cc-luma-view-discovery.c
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view-private.h"
+#include "cc-luma-discovery.h"
+
+static const char * const durations[] = { "4", "4 seconds", "6", "6 seconds", "10", "10 seconds", "0", "Until dismissed", NULL };
+static GtkWidget *notification_preview (View *v)
+{
+  GtkWidget *preview = gtk_overlay_new ();
+  gtk_widget_set_name (preview, "cf-notification-preview");
+  gtk_widget_set_size_request (preview, -1, 150);
+  gtk_overlay_set_child (GTK_OVERLAY (preview), cc_luma_view_image (v, cc_luma_view_text (v, "wall"), 1040, 300));
+  if (cc_luma_view_flag (v, "dnd"))
+    {
+      GtkWidget *content = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 5);
+      gtk_box_append (GTK_BOX (content), luma_ui_icon_new ("bell-off"));
+      JsonObject *sample = json_object_get_object_member (cc_luma_fixture_get_data (v->model), "CFNOTIFY");
+      g_autofree char *count = g_strdup_printf ("%" G_GINT64_FORMAT, json_object_get_int_member (sample, "count"));
+      gtk_box_append (GTK_BOX (content), cc_luma_view_label (count, "caption", FALSE));
+      GtkWidget *lip = luma_card_new (content, FALSE);
+      gtk_widget_set_size_request (lip, 180, 22); gtk_widget_set_halign (lip, GTK_ALIGN_CENTER); gtk_widget_set_valign (lip, GTK_ALIGN_START);
+      gtk_overlay_add_overlay (GTK_OVERLAY (preview), lip);
+    }
+  else
+    {
+      GtkWidget *content = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 10);
+      GtkWidget *icon = cc_luma_view_image (v, "messages", 60, 60); gtk_widget_set_size_request (icon, 30, 30);
+      gtk_box_append (GTK_BOX (content), icon);
+      JsonObject *sample = json_object_get_object_member (cc_luma_fixture_get_data (v->model), "CFNOTIFY");
+      gtk_box_append (GTK_BOX (content), cc_luma_view_words (json_object_get_string_member (sample, "from"), json_object_get_string_member (sample, "text")));
+      gtk_box_append (GTK_BOX (content), cc_luma_view_label (json_object_get_string_member (sample, "when"), "caption", TRUE));
+      GtkWidget *card = luma_card_new (content, TRUE);
+      gtk_widget_set_size_request (card, 300, -1); gtk_widget_set_halign (card, GTK_ALIGN_CENTER); gtk_widget_set_valign (card, GTK_ALIGN_START); gtk_widget_set_margin_top (card, 16);
+      gtk_overlay_add_overlay (GTK_OVERLAY (preview), card);
+    }
+  GtkWidget *clamp = adw_clamp_new (); adw_clamp_set_maximum_size (ADW_CLAMP (clamp), 520); adw_clamp_set_child (ADW_CLAMP (clamp), preview);
+  return clamp;
+}
+void cc_luma_view_notifications_render (View *v)
+{
+  JsonObject *apps = json_node_get_object (cc_luma_fixture_get (v->model, "na"));
+  g_autoptr (GList) ids = json_object_get_members (apps);
+  guint count = 0;
+  for (GList *i = ids; i; i = i->next) if (json_object_get_boolean_member (apps, i->data)) count++;
+  g_autofree char *meta = cc_luma_view_flag (v, "dnd") ? g_strdup ("Do Not Disturb is on. Calls still come through.") : g_strdup_printf ("%u apps can notify you", count);
+  cc_luma_view_header (v, "Notifications", meta, "dnd");
+  GtkWidget *hero = luma_card_new (notification_preview (v), TRUE); luma_card_set_recessed (LUMA_CARD (hero), TRUE); gtk_widget_set_margin_top (hero, 20); gtk_box_append (v->body, hero);
+  GtkBox *rows = cc_luma_view_group (v, NULL);
+  cc_luma_view_row (rows, "On the lock screen", "Show who a notification is from while locked", cc_luma_view_toggle (v, "lockN", "cf-lockN", "On the lock screen"));
+  cc_luma_view_row (rows, "Stay on screen for", "Then it tucks into the top edge", cc_luma_view_picker (v, "nshow", durations));
+  rows = cc_luma_view_group (v, "Apps");
+  for (GList *i = ids; i; i = i->next)
+    {
+      const char *id = i->data, *name = cc_luma_app_name (v->model, id);
+      g_autofree char *key = g_strconcat ("na.", id, NULL), *widget_name = g_strconcat ("cf-na-", id, NULL);
+      GtkWidget *row = cc_luma_view_row (rows, name, NULL, cc_luma_view_toggle (v, key, widget_name, name));
+      GtkWidget *icon = cc_luma_view_image (v, id, 60, 60); gtk_widget_set_size_request (icon, 30, 30);
+      gtk_box_prepend (GTK_BOX (row), icon);
+    }
+}
+static void provider_changed (GtkSwitch *button, GParamSpec *spec, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  const char *id = g_object_get_data (G_OBJECT (button), "cf-app");
+  g_autoptr (GError) error = NULL;
+  if (cc_luma_search_set_app (v->model, id, gtk_switch_get_active (button), &error)) cc_luma_view_queue_refresh (v);
+  else cc_luma_view_report_error (v, error);
+}
+static void provider_dropped (GSimpleAction *action, GVariant *parameter, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  const char *id; guint target;
+  g_variant_get (parameter, "(&su)", &id, &target);
+  g_autoptr (GError) error = NULL;
+  if (cc_luma_search_move_app (v->model, id, target, &error)) cc_luma_view_queue_refresh (v);
+  else luma_toast_show (root, error->message, "error");
+}
+static GdkContentProvider *provider_dragged (GtkDragSource *source, double x, double y, gpointer unused)
+{
+  const char *id = g_object_get_data (G_OBJECT (source), "cf-app");
+  return gdk_content_provider_new_typed (G_TYPE_STRING, id);
+}
+static gboolean provider_drop (GtkDropTarget *target, const GValue *value, double x, double y, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return FALSE;
+  guint index = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (target), "cf-index"));
+  g_autoptr (GError) error = NULL;
+  if (!cc_luma_search_move_app (v->model, g_value_get_string (value), index, &error)) return FALSE;
+  cc_luma_view_queue_refresh (v);
+  return TRUE;
+}
+void cc_luma_view_search_render (View *v)
+{
+  g_autofree char *meta = g_strdup_printf ("Searching %u apps and %u places", cc_luma_search_app_count (v->model), cc_luma_search_place_count (v->model));
+  cc_luma_view_header (v, "Search", meta, NULL);
+  GtkBox *rows = cc_luma_view_group (v, "Results come from");
+  JsonArray *apps = json_node_get_array (cc_luma_fixture_get (v->model, "sa"));
+  for (guint i = 0; i < json_array_get_length (apps); i++)
+    {
+      JsonArray *pair = json_array_get_array_element (apps, i);
+      const char *id = json_array_get_string_element (pair, 0), *name = cc_luma_app_name (v->model, id);
+      GtkWidget *button = gtk_switch_new (); gtk_switch_set_active (GTK_SWITCH (button), json_array_get_boolean_element (pair, 1)); gtk_widget_set_valign (button, GTK_ALIGN_CENTER);
+      g_autofree char *widget_name = g_strconcat ("cf-sa-", id, NULL); gtk_widget_set_name (button, widget_name);
+      gtk_accessible_update_property (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_PROPERTY_LABEL, name, -1);
+      g_object_set_data_full (G_OBJECT (button), "cf-app", g_strdup (id), g_free); g_signal_connect_object (button, "notify::active", G_CALLBACK (provider_changed), v->root, 0);
+      GtkWidget *row = cc_luma_view_row (rows, name, NULL, button);
+      g_autofree char *row_name = g_strconcat ("cf-provider-", id, NULL); gtk_widget_set_name (row, row_name);
+      GtkWidget *icon = cc_luma_view_image (v, id, 60, 60); gtk_widget_set_size_request (icon, 30, 30); gtk_box_prepend (GTK_BOX (row), icon);
+      GtkWidget *grip = luma_ui_icon_new ("grip-vertical"); gtk_box_prepend (GTK_BOX (row), grip);
+      GtkDragSource *drag = gtk_drag_source_new (); gtk_drag_source_set_actions (drag, GDK_ACTION_MOVE);
+      g_object_set_data_full (G_OBJECT (drag), "cf-app", g_strdup (id), g_free); g_signal_connect (drag, "prepare", G_CALLBACK (provider_dragged), NULL); gtk_widget_add_controller (grip, GTK_EVENT_CONTROLLER (drag));
+      GtkDropTarget *drop = gtk_drop_target_new (G_TYPE_STRING, GDK_ACTION_MOVE); g_object_set_data (G_OBJECT (drop), "cf-index", GUINT_TO_POINTER (i));
+      g_signal_connect_object (drop, "drop", G_CALLBACK (provider_drop), v->root, 0); gtk_widget_add_controller (row, GTK_EVENT_CONTROLLER (drop));
+    }
+  GtkWidget *note = cc_luma_view_label ("Drag to change the order results appear in.", "caption", TRUE); gtk_widget_set_margin_top (note, 8); gtk_box_append (v->body, note);
+  rows = cc_luma_view_group (v, "Places");
+  g_autofree char *folders = g_strdup_printf ("%u folders", cc_luma_search_place_count (v->model));
+  cc_luma_view_row (rows, "Folders to search", "Filer looks inside these", cc_luma_view_link (v, folders, "search-places"));
+  rows = cc_luma_view_group (v, "Ari");
+  cc_luma_view_row (rows, "Offer to ask Ari", "When nothing matches what you typed", cc_luma_view_toggle (v, "askAri", "cf-askAri", "Offer to ask Ari"));
+  if (!g_action_map_lookup_action (G_ACTION_MAP (v->actions), "provider-move"))
+    {
+      GSimpleAction *move = g_simple_action_new ("provider-move", G_VARIANT_TYPE ("(su)")); g_signal_connect_object (move, "activate", G_CALLBACK (provider_dropped), v->root, 0); g_action_map_add_action (G_ACTION_MAP (v->actions), G_ACTION (move)); g_object_unref (move);
+    }
+}
+static void add_place (GtkButton *button, View *v)
+{
+  luma_toast_show (v->root, "Choose a folder in Filer", "success");
+}
+void cc_luma_view_search_places_render (View *v)
+{
+  cc_luma_view_header (v, "Folders to search", "Filer and search look inside these", NULL);
+  gtk_box_append (v->body, cc_luma_view_link (v, "Search", "search"));
+  GtkBox *rows = cc_luma_view_group (v, NULL);
+  JsonObject *places = json_node_get_object (cc_luma_fixture_get (v->model, "sl"));
+  g_autoptr (GList) names = json_object_get_members (places);
+  for (GList *i = names; i; i = i->next)
+    {
+      const char *name = i->data;
+      g_autofree char *key = g_strconcat ("sl.", name, NULL), *widget_name = g_strconcat ("cf-sl-", name, NULL);
+      GtkWidget *row = cc_luma_view_row (rows, name, g_str_equal (name, "Archive HD") ? "External drive" : NULL, cc_luma_view_toggle (v, key, widget_name, name));
+      gtk_box_prepend (GTK_BOX (row), luma_ui_icon_new (g_str_equal (name, "Archive HD") ? "hard-drive" : g_str_equal (name, "Home") ? "house" : "folder"));
+    }
+  cc_luma_view_row (cc_luma_view_group (v, NULL), "Another folder", NULL, cc_luma_view_command (v, "Add…", G_CALLBACK (add_place)));
+}
