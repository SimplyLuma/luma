+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "nshow")), ==, "0");
+  g_assert_true (has_text (view, "Until dismissed"));
+  gtk_switch_set_active (GTK_SWITCH (find_name (view, "cf-na-messages")), FALSE); drain ();
+  g_assert_true (json_node_get_boolean (cc_luma_fixture_get (model, "na.calendar")));
+  gtk_switch_set_active (GTK_SWITCH (find_name (view, "cf-dnd")), FALSE); drain ();
+  g_assert_true (has_text (view, "6 apps can notify you"));
+  wait_ms (100); g_assert_null (cc_luma_view_get_error (view)); g_object_unref (view);
