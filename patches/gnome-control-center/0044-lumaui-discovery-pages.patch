           g_autofree char *file = g_strconcat (id, ".png", NULL);
           return g_build_filename (self->resource_dir, file, NULL);
         }
-  const char *apps[] = { "write", "viola", "messages", "filer", "tide", "charlie", "photos" };
-  const char *artwork[] = { "documents", "browser", "messages", "files", "music", "mail", "photos" };
+  const char *apps[] = { "write", "viola", "messages", "filer", "tide", "charlie", "photos", "calendar", "phone", "clock", "depot", "maps", "settings", "calc", "contacts", "notes", "term" };
+  const char *artwork[] = { "documents", "browser", "messages", "files", "music", "mail", "photos", "calendar", "phone", "clock", "app-store", "maps", "settings", "calculator", "contacts", "notes", "terminal" };
   if (self->resource_dir && id)
     for (guint i = 0; i < G_N_ELEMENTS (apps); i++)
       if (g_str_equal (id, apps[i]))
@@ -379,6 +379,8 @@ char *cc_luma_fixture_asset_path (CcLumaFixture *self, const char *id, GError **
           g_autofree char *file = g_strdup_printf ("luma-v3-%s.svg", artwork[i]);
           return g_build_filename (self->resource_dir, file, NULL);
         }
+  if (self->resource_dir && g_strcmp0 (id, "tasks") == 0)
