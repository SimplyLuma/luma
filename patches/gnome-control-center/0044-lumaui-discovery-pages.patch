diff --git a/shell/cc-luma-discovery.c b/shell/cc-luma-discovery.c
index 31a3e3e..88ec891 100644
--- a/shell/cc-luma-discovery.c
+++ b/shell/cc-luma-discovery.c
@@ -29,6 +29,14 @@ static gboolean duration_allowed (gint64 seconds)
 gboolean cc_luma_notifications_validate (CcLumaFixture *model)
 {
   if (!is_flag (model, "dnd") || !is_flag (model, "lockN")) return FALSE;
+  JsonNode *sample = json_object_get_member (cc_luma_fixture_get_data (model), "CFNOTIFY");
+  if (!sample || !JSON_NODE_HOLDS_OBJECT (sample)) return FALSE;
+  JsonObject *preview = json_node_get_object (sample);
+  const char *fields[] = { "from", "text", "when" };
+  for (guint i = 0; i < G_N_ELEMENTS (fields); i++)
+    { JsonNode *n = json_object_get_member (preview, fields[i]); if (!n || json_node_get_value_type (n) != G_TYPE_STRING) return FALSE; }
+  JsonNode *count = json_object_get_member (preview, "count");
+  if (!count || json_node_get_value_type (count) != G_TYPE_INT64 || json_node_get_int (count) < 0) return FALSE;
   JsonNode *nshow = cc_luma_fixture_get (model, "nshow"), *apps = cc_luma_fixture_get (model, "na");
   if (!nshow || json_node_get_value_type (nshow) != G_TYPE_STRING ||
       !(g_str_equal (json_node_get_string (nshow), "0") || g_str_equal (json_node_get_string (nshow), "4") || g_str_equal (json_node_get_string (nshow), "6") || g_str_equal (json_node_get_string (nshow), "10")) || !apps || !JSON_NODE_HOLDS_OBJECT (apps)) return FALSE;
