+static void
+applications_add_activated (AdwButtonRow *row, CcDashPanel *self)
+{
+  g_auto(GStrv) uris = folder_uris (self);
+  guint count = g_strv_length (uris);
+  g_autofree const char **next = NULL;
+
+  if (!g_settings_is_writable (self->settings, "dock-folders"))
+    return;
+  for (guint i = 0; i < count; i++)
+    if (g_str_equal (uris[i], APPLICATIONS_URI))
+      return;
+  next = g_new0 (const char *, count + 2);
+  for (guint i = 0; i < count; i++)
+    next[i] = uris[i];
+  next[count] = APPLICATIONS_URI;
+  g_settings_set_strv (self->settings, "dock-folders", (const char * const *) next);
 }
 
