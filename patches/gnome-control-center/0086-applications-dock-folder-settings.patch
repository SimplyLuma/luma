+/* Match the Shell's untouched-profile defaults without overwriting an explicit
+ * empty list, custom pins or administrator policy. Mutations persist this
+ * effective list so removing one default keeps the other. */
+static char **
+folder_uris (CcDashPanel *self)
+{
+  g_auto(GStrv) uris = g_settings_get_strv (self->settings, "dock-folders");
+  g_autoptr(GVariant) user = g_settings_get_user_value (self->settings, "dock-folders");
+  const char *downloads;
+  g_autoptr(GPtrArray) defaults = NULL;
+
+  if (uris[0] || user || !g_settings_is_writable (self->settings, "dock-folders"))
+    return g_steal_pointer (&uris);
+
+  defaults = g_ptr_array_new_with_free_func (g_free);
+  g_ptr_array_add (defaults, g_strdup (APPLICATIONS_URI));
+  downloads = g_get_user_special_dir (G_USER_DIRECTORY_DOWNLOAD);
+  if (downloads && !g_str_equal (downloads, g_get_home_dir ()))
+    g_ptr_array_add (defaults, g_filename_to_uri (downloads, NULL, NULL));
+  g_ptr_array_add (defaults, NULL);
+  return (char **) g_ptr_array_free (g_steal_pointer (&defaults), FALSE);
+}
