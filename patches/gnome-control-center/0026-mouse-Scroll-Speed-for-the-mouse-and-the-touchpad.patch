diff --git a/panels/mouse/cc-scroll-speed.h b/panels/mouse/cc-scroll-speed.h
new file mode 100644
index 0000000..e2c51d8
--- /dev/null
+++ b/panels/mouse/cc-scroll-speed.h
@@ -0,0 +1,41 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Scroll speed slider mapping. The setting is a multiple of the usual scroll
+ * distance (0.25 to 4.0); the slider runs over its base-2 logarithm, so Slow
+ * and Fast are equally far from the middle and the middle is exactly 1.0.
+ */
+
+#pragma once
+
+#include <math.h>
+
+#define CC_SCROLL_SPEED_MIN 0.25
+#define CC_SCROLL_SPEED_MAX 4.0
+#define CC_SCROLL_SPEED_DEFAULT 1.0
+
+static inline double
+cc_scroll_speed_clamp (double speed)
+{
+  if (!isfinite (speed))
+    return CC_SCROLL_SPEED_DEFAULT;
+
+  return fmin (fmax (speed, CC_SCROLL_SPEED_MIN), CC_SCROLL_SPEED_MAX);
+}
+
+static inline double
+cc_scroll_speed_to_slider (double speed)
+{
+  return log2 (cc_scroll_speed_clamp (speed));
+}
+
+/* Near the middle snaps to exactly 1.0, which the compositor treats as
+ * "unchanged"; elsewhere the value is kept to two decimals. */
+static inline double
+cc_scroll_speed_from_slider (double position)
+{
+  if (!isfinite (position) || fabs (position) < 0.05)
+    return CC_SCROLL_SPEED_DEFAULT;
+
+  return cc_scroll_speed_clamp (round (exp2 (position) * 100.0) / 100.0);
+}
diff --git a/panels/mouse/test-scroll-speed.c b/panels/mouse/test-scroll-speed.c
new file mode 100644
index 0000000..5b3023a
--- /dev/null
+++ b/panels/mouse/test-scroll-speed.c
@@ -0,0 +1,65 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Scroll speed slider mapping. Built and run by the package's %check, which
+ * requires every test below to report ok.
+ */
+
+#include <glib.h>
+
+#include "cc-scroll-speed.h"
+
+static void
+test_middle_is_exactly_default (void)
+{
+  g_assert_cmpfloat (cc_scroll_speed_from_slider (0.0), ==, 1.0);
+  g_assert_cmpfloat (cc_scroll_speed_from_slider (0.04), ==, 1.0);
+  g_assert_cmpfloat (cc_scroll_speed_from_slider (-0.04), ==, 1.0);
+  g_assert_cmpfloat (cc_scroll_speed_to_slider (1.0), ==, 0.0);
+}
+
+static void
+test_ends_are_the_range (void)
+{
+  g_assert_cmpfloat (cc_scroll_speed_from_slider (-2.0), ==, CC_SCROLL_SPEED_MIN);
+  g_assert_cmpfloat (cc_scroll_speed_from_slider (2.0), ==, CC_SCROLL_SPEED_MAX);
+  g_assert_cmpfloat (cc_scroll_speed_from_slider (-9.0), ==, CC_SCROLL_SPEED_MIN);
+  g_assert_cmpfloat (cc_scroll_speed_to_slider (0.25), ==, -2.0);
+  g_assert_cmpfloat (cc_scroll_speed_to_slider (4.0), ==, 2.0);
+  g_assert_cmpfloat (cc_scroll_speed_to_slider (100.0), ==, 2.0);
+  g_assert_cmpfloat (cc_scroll_speed_to_slider (NAN), ==, 0.0);
+}
+
+/* Faster to the right everywhere, and a stored value read back into the
+ * slider gives the same stored value, so the binding settles. */
+static void
+test_monotonic_and_stable (void)
+{
+  double previous = 0;
+  double x;
+
+  for (x = -2.0; x <= 2.0001; x += 0.1)
+    {
+      double speed = cc_scroll_speed_from_slider (x);
+
+      g_assert_cmpfloat (speed, >=, previous);
+      g_assert_cmpfloat (cc_scroll_speed_from_slider (cc_scroll_speed_to_slider (speed)), ==, speed);
+      previous = speed;
+    }
+
+  g_assert_cmpfloat (cc_scroll_speed_from_slider (1.0), ==, 2.0);
+  g_assert_cmpfloat (cc_scroll_speed_from_slider (-1.0), ==, 0.5);
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+
+  g_test_add_func ("/scroll-speed/middle", test_middle_is_exactly_default);
+  g_test_add_func ("/scroll-speed/range", test_ends_are_the_range);
+  g_test_add_func ("/scroll-speed/monotonic", test_monotonic_and_stable);
+
+  return g_test_run ();
+}
