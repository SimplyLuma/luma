+static void handheld_device_identity (void)
+{
+  g_autofree char *saved_factor = g_strdup (g_getenv ("LUMA_FORM_FACTOR"));
+  g_autofree char *saved_class = g_strdup (g_getenv ("LUMA_DEVICE_CLASS"));
+  g_unsetenv ("LUMA_FORM_FACTOR");
+  g_setenv ("LUMA_DEVICE_CLASS", "handheld", TRUE);
+  g_assert_true (cc_luma_view_phone_device ());
+  g_setenv ("LUMA_DEVICE_CLASS", "desktop", TRUE);
+  g_assert_false (cc_luma_view_phone_device ());
+  g_setenv ("LUMA_FORM_FACTOR", "phone", TRUE);
+  g_assert_true (cc_luma_view_phone_device ());
+  if (saved_factor) g_setenv ("LUMA_FORM_FACTOR", saved_factor, TRUE);
+  else g_unsetenv ("LUMA_FORM_FACTOR");
+  if (saved_class) g_setenv ("LUMA_DEVICE_CLASS", saved_class, TRUE);
+  else g_unsetenv ("LUMA_DEVICE_CLASS");
+}
