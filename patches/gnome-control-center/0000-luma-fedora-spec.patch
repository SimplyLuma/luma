@@ -200,6 +288,48 @@
 
 %find_lang %{name} --all-name --with-gnome
 
+%check
+# Native Settings and its launcher work without a GNOME session identity.
+python3 %{SOURCE1000} %{_vpath_builddir}/shell/gnome-control-center \
+  %{_vpath_builddir}/shell/org.gnome.Settings.desktop
+# Luma: the device-name slug rules (0018) run through upstream's hostname test.
+%meson_test test-hostname
+# Luma's compositor schema is used only on this private package-check backend.
+task_runtime=$(mktemp -d)
+chmod 700 "$task_runtime"
+trap 'rm -rf "$task_runtime"' EXIT
+export XDG_RUNTIME_DIR="$task_runtime"
+mkdir "$task_runtime/schema"
+cp %{SOURCE1001} "$task_runtime/schema/"
+python3 %{SOURCE1003} %{SOURCE1002} "$task_runtime/schema/org.projectluma.peripherals.gschema.xml"
+glib-compile-schemas --strict "$task_runtime/schema"
+export GSETTINGS_SCHEMA_DIR="$task_runtime/schema"
+# LumaUI Settings model and adapter tests; display-bound tests run below.
+%meson_test luma-settings-fixture luma-settings-applications luma-settings-audio luma-settings-permissions luma-settings-power-reads luma-settings-preferences luma-settings-properties luma-settings-scroll-speed luma-settings-search-locations luma-settings-live-conn luma-settings-live-gsettings luma-settings-live-desk luma-settings-live-you luma-settings-live-keyboard luma-settings-display-preview luma-settings-display-save-view-1180 luma-settings-display-save-view-320
+# Test the actual native network editor frame and Cancel with accessibility enabled.
+xvfb-run -a --server-args="-screen 0 1600x1200x24" dbus-run-session -- env GSK_RENDERER=cairo GIO_USE_VFS=local GDK_DEBUG=no-portals meson test -C %{_vpath_builddir} --no-rebuild --print-errorlogs luma-settings-network-editor
+# Native page actions must reach the owned BlueZ/Rfkill service on a private bus.
+xvfb-run -a --server-args="-screen 0 1920x1080x24" env GSK_RENDERER=cairo meson test -C %{_vpath_builddir} --no-rebuild --print-errorlogs luma-settings-live-bluetooth
+# Native pointer clicks must stay in Luma and read back from their actual owner.
+xvfb-run -a --server-args="-screen 0 1600x1200x24" dbus-run-session -- env GSK_RENDERER=cairo GIO_USE_VFS=local GDK_DEBUG=no-portals meson test -C %{_vpath_builddir} --no-rebuild --print-errorlogs luma-settings-live-pointer
+# Native Wi-Fi confirmation, failure/readback and scan-refresh input preservation.
+xvfb-run -a --server-args="-screen 0 1920x1080x24" env GSK_RENDERER=cairo GIO_USE_VFS=local meson test -C %{_vpath_builddir} --no-rebuild --print-errorlogs luma-settings-live-network
+xvfb-run -a --server-args="-screen 0 1600x1200x24" dbus-run-session -- env GSK_RENDERER=cairo GSETTINGS_BACKEND=memory LUMA_SETTINGS_TEST_FIXTURE=%{SOURCE1004} %{_vpath_builddir}/shell/test-luma-view --tap -p /settings/view/scroll-speed
+# Luma: the pointing stick page is called TrackPoint and says what it is (0021).
+grep -Fq '>TrackPoint<' %{_vpath_builddir}/panels/mouse/cc-mouse-panel.ui
+grep -Fq 'translatable="yes">The small pointer control in the middle of your keyboard.<' \
+  %{_vpath_builddir}/panels/mouse/cc-mouse-panel.ui
+if grep -Fq 'Pointing Stick' %{_vpath_builddir}/panels/mouse/cc-mouse-panel.ui; then exit 1; fi
+grep -q '^Keywords=.*;TrackPoint;' %{_vpath_builddir}/panels/mouse/gnome-mouse-panel.desktop
+# Luma: Scroll Speed on the Mouse and Touchpad sections (0026), and its
+# slider mapping; every mapping test must report ok.
+test "$(grep -c 'translatable="yes">Scroll _Speed<' %{_vpath_builddir}/panels/mouse/cc-mouse-panel.ui)" -eq 2
+gcc -o test-scroll-speed panels/mouse/test-scroll-speed.c \
+  $(pkg-config --cflags --libs glib-2.0) -lm
+./test-scroll-speed --tap | tee test-scroll-speed.log
+passed=$(grep -c '^ok ' test-scroll-speed.log)
+test "$passed" -eq 3 || { echo "test-scroll-speed: $passed of 3 passed"; exit 1; }
+
