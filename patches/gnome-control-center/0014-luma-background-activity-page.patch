+                show-arrow: true;
+                action-name: "navigation.push";
+                action-target: "'background-activity'";
+              }
             }
 
             Adw.PreferencesGroup {
@@ -129,6 +137,19 @@ template $CcApplicationsPanel: $CcPanel {
     };
   }
 
+  [subpage]
