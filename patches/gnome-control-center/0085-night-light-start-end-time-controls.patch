+static char *night_time_caption (const char *value, gboolean twelve_hour)
+{
+  int hour = (int) hours (value), minute = (int) g_ascii_strtoll (value + 3, NULL, 10);
+  g_autoptr (GDateTime) time = g_date_time_new_utc (2000, 1, 1, hour, minute, 0);
+  g_autofree char *caption = g_date_time_format (time, twelve_hour ? "%I:%M %p" : "%H:%M");
+  return g_strdup (twelve_hour && g_str_has_prefix (caption, "0") ? caption + 1 : caption);
+}
+
+/* Draft in a native popover; commit once, rather than rebuilding the page
+ * after each digit. Dismissing the popover leaves the schedule unchanged. */
+typedef struct {
+  View *view;
+  const char *key;
+  GtkPopover *popover;
+  GtkSpinButton *hour;
+  GtkSpinButton *minute;
+  GtkDropDown *period;
+  gboolean twelve_hour;
+} NightTime;
+
+static gboolean minute_output (GtkSpinButton *spin, gpointer data)
+{
+  g_autofree char *text = g_strdup_printf ("%02d", gtk_spin_button_get_value_as_int (spin));
+  gtk_editable_set_text (GTK_EDITABLE (spin), text);
+  return TRUE;
+}
+
+static void night_time_save (GtkButton *button, NightTime *edit)
+{
+  g_autoptr (GError) error = NULL;
+  gtk_spin_button_update (edit->hour);
+  gtk_spin_button_update (edit->minute);
+  int hour = gtk_spin_button_get_value_as_int (edit->hour);
+  int minute = gtk_spin_button_get_value_as_int (edit->minute);
+  if (edit->twelve_hour)
+    hour = hour % 12 + 12 * gtk_drop_down_get_selected (edit->period);
+  g_autofree char *value = g_strdup_printf ("%02d:%02d", hour, minute);
+  if (!cc_luma_night_set_choice (edit->view->model, edit->key, value, &error))
+    {
+      cc_luma_view_report_error (edit->view, error);
+      return;
+    }
+  gtk_popover_popdown (edit->popover);
+  cc_luma_view_queue_refresh (edit->view);
+}
+
+static void night_time_row (View *v, GtkBox *card, const char *key,
+                            const char *title, gboolean manual)
+{
+  const char *current = cc_luma_view_text (v, key);
+  int hour = (int) hours (current), minute = (int) g_ascii_strtoll (current + 3, NULL, 10);
+  g_autoptr (GSettings) iface = g_settings_new ("org.gnome.desktop.interface");
+  g_autofree char *clock_format = g_settings_get_string (iface, "clock-format");
+  gboolean twelve_hour = g_str_equal (clock_format, "12h");
+  g_autofree char *caption = night_time_caption (current, twelve_hour);
+  GtkWidget *button = gtk_menu_button_new ();
+  gtk_menu_button_set_label (GTK_MENU_BUTTON (button), caption);
+  gtk_widget_add_css_class (button, "cf-pk");
+  g_autofree char *name = g_strconcat ("cf-", key, NULL);
+  gtk_widget_set_name (button, name);
+  g_autofree char *accessible = g_strdup_printf ("%s, %s", title, caption);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_PROPERTY_LABEL, accessible, -1);
+  gtk_widget_set_sensitive (button, manual);
+
+  GtkWidget *popover = gtk_popover_new ();
+  GtkWidget *body = gtk_box_new (GTK_ORIENTATION_VERTICAL, 12);
+  GtkWidget *fields = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+  GtkWidget *save = gtk_button_new_with_label ("Done");
+  gtk_widget_add_css_class (save, "suggested-action");
+  gtk_widget_set_margin_top (body, 12);
+  gtk_widget_set_margin_bottom (body, 12);
+  gtk_widget_set_margin_start (body, 12);
+  gtk_widget_set_margin_end (body, 12);
+  NightTime *edit = g_new0 (NightTime, 1);
+  edit->view = v; edit->key = key; edit->popover = GTK_POPOVER (popover); edit->twelve_hour = twelve_hour;
+  edit->hour = GTK_SPIN_BUTTON (gtk_spin_button_new_with_range (twelve_hour ? 1 : 0, twelve_hour ? 12 : 23, 1));
+  edit->minute = GTK_SPIN_BUTTON (gtk_spin_button_new_with_range (0, 59, 1));
+  for (guint i = 0; i < 2; i++)
+    {
+      GtkSpinButton *spin = i ? edit->minute : edit->hour;
+      gtk_spin_button_set_numeric (spin, TRUE);
+      gtk_spin_button_set_wrap (spin, TRUE);
+      gtk_spin_button_set_update_policy (spin, GTK_UPDATE_IF_VALID);
+      gtk_editable_set_width_chars (GTK_EDITABLE (spin), 2);
+      gtk_editable_set_max_width_chars (GTK_EDITABLE (spin), 2);
+      gtk_accessible_update_property (GTK_ACCESSIBLE (spin), GTK_ACCESSIBLE_PROPERTY_LABEL, i ? "Minute" : "Hour", -1);
+      if (i || !twelve_hour) g_signal_connect (spin, "output", G_CALLBACK (minute_output), NULL);
+    }
+  gtk_spin_button_set_value (edit->hour, twelve_hour ? ((hour + 11) % 12 + 1) : hour);
+  gtk_spin_button_set_value (edit->minute, minute);
+  gtk_box_append (GTK_BOX (fields), GTK_WIDGET (edit->hour));
+  gtk_box_append (GTK_BOX (fields), gtk_label_new (":"));
+  gtk_box_append (GTK_BOX (fields), GTK_WIDGET (edit->minute));
+  if (twelve_hour)
+    {
+      g_autoptr (GDateTime) morning = g_date_time_new_utc (2000, 1, 1, 0, 0, 0);
+      g_autoptr (GDateTime) evening = g_date_time_new_utc (2000, 1, 1, 12, 0, 0);
+      g_autofree char *am = g_date_time_format (morning, "%p");
+      g_autofree char *pm = g_date_time_format (evening, "%p");
+      const char *periods[] = {am, pm, NULL};
+      edit->period = GTK_DROP_DOWN (gtk_drop_down_new_from_strings (periods));
+      gtk_drop_down_set_selected (edit->period, hour >= 12);
+      gtk_accessible_update_property (GTK_ACCESSIBLE (edit->period), GTK_ACCESSIBLE_PROPERTY_LABEL, "AM or PM", -1);
+      gtk_box_append (GTK_BOX (fields), GTK_WIDGET (edit->period));
+    }
+  gtk_box_append (GTK_BOX (body), cc_luma_view_label (title, "body", FALSE));
+  gtk_box_append (GTK_BOX (body), fields);
+  gtk_box_append (GTK_BOX (body), save);
+  gtk_popover_set_child (GTK_POPOVER (popover), body);
+  gtk_menu_button_set_popover (GTK_MENU_BUTTON (button), popover);
+  g_object_set_data_full (G_OBJECT (popover), "night-time-editor", edit, g_free);
+  g_signal_connect (save, "clicked", G_CALLBACK (night_time_save), edit);
+  cf_row (card, NULL, title, NULL, button, FALSE);
+}
