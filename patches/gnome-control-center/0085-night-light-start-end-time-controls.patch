+static void nightlight_edit_time (GtkWidget *view, const char *key, int hour, int minute, int period, gboolean save)
+{
+  GtkMenuButton *button = GTK_MENU_BUTTON (find_name (view, key));
+  g_assert_true (GTK_IS_MENU_BUTTON (button));
+  gtk_menu_button_popup (button); wait_ms (100);
+  GtkPopover *popover = gtk_menu_button_get_popover (button);
+  GtkWidget *body = gtk_popover_get_child (popover);
+  GtkWidget *fields = gtk_widget_get_next_sibling (gtk_widget_get_first_child (body));
+  GtkWidget *hours = gtk_widget_get_first_child (fields);
+  GtkWidget *minutes = gtk_widget_get_next_sibling (gtk_widget_get_next_sibling (hours));
+  g_assert_true (GTK_IS_SPIN_BUTTON (hours)); g_assert_true (GTK_IS_SPIN_BUTTON (minutes));
+  gtk_spin_button_set_value (GTK_SPIN_BUTTON (hours), hour);
+  gtk_spin_button_set_value (GTK_SPIN_BUTTON (minutes), minute);
+  GtkWidget *ampm = gtk_widget_get_next_sibling (minutes);
+  if (period >= 0) { g_assert_true (GTK_IS_DROP_DOWN (ampm)); gtk_drop_down_set_selected (GTK_DROP_DOWN (ampm), period); }
+  if (save) g_signal_emit_by_name (gtk_widget_get_next_sibling (fields), "clicked");
+  else gtk_popover_popdown (popover);
+  drain ();
+}
