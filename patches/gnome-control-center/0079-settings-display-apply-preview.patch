+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Real DisplayConfig serialization against a private synthetic Mutter owner. */
+#include "cc-luma-live-displays.c"
+void cc_luma_live_ready (CcLumaFixture *model, const char *adapter) { cc_luma_fixture_changed (model); }
+static void spin (void) { gint64 end = g_get_monotonic_time () + 300000; do { while (g_main_context_iteration (NULL, FALSE)); g_usleep (1000); } while (g_get_monotonic_time () < end); }
+static void edit (Displays *self, const char *key, const char *text)
+{
+  g_autoptr(JsonNode) value = json_node_init_string (json_node_alloc (), text);
+  g_autoptr(GError) error = NULL;
+  g_assert_true (displays_write (self, key, value, &error)); g_assert_no_error (error); spin ();
+}
+static void action (Displays *self, const char *key)
+{
+  g_autoptr(JsonNode) value = json_node_init_boolean (json_node_alloc (), TRUE);
+  g_autoptr(GError) error = NULL;
+  g_assert_true (displays_write (self, key, value, &error)); g_assert_no_error (error); spin ();
+}
+int main (void)
+{
+  g_autoptr(JsonParser) parser = json_parser_new ();
+  g_assert_true (json_parser_load_from_data (parser, "{\"settings\":{},\"data\":{},\"pages\":[]}", -1, NULL));
+  g_autoptr(CcLumaFixture) model = cc_luma_fixture_new_live (json_parser_get_root (parser));
+  Displays *self = displays_start (model); spin ();
+  edit (self, "d.int.scale", "125"); edit (self, "d.int.rot", "Portrait right");
+  edit (self, "d.int.hz", "75 Hz"); edit (self, "d.ext.pos", "100,500");
+  g_assert_nonnull (self->draft); g_assert_false (self->preview);
+  action (self, "display.apply"); g_assert_true (self->preview); g_assert_cmpuint (self->remaining, ==, 15);
+  action (self, "display.revert"); g_assert_null (self->draft); g_assert_false (self->preview);
+  edit (self, "d.int.rot", "Landscape, flipped"); action (self, "display.apply"); action (self, "display.keep");
+  g_assert_null (self->draft); g_assert_false (self->preview);
+  edit (self, "d.int.scale", "125"); action (self, "display.apply");
+  self->remaining = 1; g_source_remove (self->timer); self->timer = 0;
+  g_assert_false (preview_tick (self)); spin ();
+  g_assert_null (self->draft); g_assert_false (self->preview);
+  edit (self, "d.ext.pos", "0,0"); action (self, "display.revert");
+  g_assert_null (self->draft); /* Cancel sends no ApplyMonitorsConfig. */
+  displays_stop (self); spin (); g_print ("Pending rotation/scale/rate/drag; Apply/Keep/Revert/timeout/cancel PASS\n");
+  return 0;
+}
