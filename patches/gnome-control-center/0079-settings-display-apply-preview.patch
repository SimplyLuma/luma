-static void changed (CcDisplayConfigManager *manager, Displays *self) { publish (self); }
+static gboolean deferred_publish (gpointer data)
+{
+  Displays *self = data; self->refresh = 0; publish (self); return G_SOURCE_REMOVE;
+}
+static void queue_publish (Displays *self)
+{
+  if (!self->refresh) self->refresh = g_idle_add (deferred_publish, self);
+}
+static void changed (CcDisplayConfigManager *manager, Displays *self) { queue_publish (self); }
+
+static gboolean discard (Displays *self, GError **error)
+{
+  if (self->preview && !cc_display_config_apply_preview (self->original, FALSE, error)) return FALSE;
+  if (self->timer) { g_source_remove (self->timer); self->timer = 0; }
+  self->remaining = 0; self->preview = FALSE;
+  g_clear_object (&self->draft); g_clear_object (&self->original);
+  queue_publish (self); return TRUE;
+}
+static gboolean preview_tick (gpointer data)
+{
+  Displays *self = data;
+  if (--self->remaining == 0) {
+    self->timer = 0;
+    g_autoptr(GError) error = NULL;
+    if (!discard (self, &error)) {
+      cc_luma_fixture_publish_string (self->model, "display.error", error->message);
+      /* Retry a refused rollback instead of silently accepting the preview. */
+      self->remaining = 1; self->timer = g_timeout_add_seconds (1, preview_tick, self);
+    }
+    return G_SOURCE_REMOVE;
+  }
+  queue_publish (self); return G_SOURCE_CONTINUE;
+}
 
