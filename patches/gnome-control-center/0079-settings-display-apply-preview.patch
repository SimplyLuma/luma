+#!/usr/bin/python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Private D-Bus owner: no real session, displays, or profile is accessed."""
+import subprocess, sys
+from gi.repository import Gio, GLib
+TYPE='(ua((ssss)a(siiddada{sv})a{sv})a(iiduba(ssss)a{sv})a{sv})'
+xml='''<node><interface name="org.gnome.Mutter.DisplayConfig">
+<method name="GetCurrentState"><arg type="u" direction="out"/><arg type="a((ssss)a(siiddada{sv})a{sv})" direction="out"/><arg type="a(iiduba(ssss)a{sv})" direction="out"/><arg type="a{sv}" direction="out"/></method>
+<method name="ApplyMonitorsConfig"><arg type="u" direction="in"/><arg type="u" direction="in"/><arg type="a(iiduba(ssa{sv}))" direction="in"/><arg type="a{sv}" direction="in"/></method>
+<property name="ApplyMonitorsConfigAllowed" type="b" access="read"/>
+<property name="PanelOrientationManaged" type="b" access="read"/>
+<signal name="MonitorsChanged"/></interface></node>'''
+bus=Gio.bus_get_sync(Gio.BusType.SESSION,None)
+bus.call_sync('org.freedesktop.DBus','/org/freedesktop/DBus','org.freedesktop.DBus','RequestName',GLib.Variant('(su)',('org.gnome.Mutter.DisplayConfig',0)),None,0,5000,None)
+serial=1; calls=[]; chosen={'eDP-1':'60','DP-1':'60'}
+specs={'eDP-1':('eDP-1','VND','Panel','S'),'DP-1':('DP-1','VND','External','T')}
+logical=[(0,0,1.,0,True,[specs['eDP-1']],{}),(1920,0,1.,0,False,[specs['DP-1']],{})]
+def state():
+    monitors=[]
+    for connector,spec in specs.items():
+        modes=[(rate,1920,1200,float(rate),1.,[1.,1.25,1.5,2.],{'is-current':GLib.Variant('b',chosen[connector]==rate),'is-preferred':GLib.Variant('b',rate=='60')}) for rate in ('60','75')]
+        monitors.append((spec,modes,{'is-builtin':GLib.Variant('b',connector=='eDP-1'),'display-name':GLib.Variant('s',spec[2])}))
+    return GLib.Variant(TYPE,(serial,monitors,logical,{'layout-mode':GLib.Variant('u',1),'supports-changing-layout-mode':GLib.Variant('b',True),'supports-mirroring':GLib.Variant('b',True)}))
+def method(_bus,_sender,_path,_iface,name,args,call):
+    global serial, logical
+    if name=='GetCurrentState': call.return_value(state());return
+    proposed,kind,rows,props=args.unpack()
+    if proposed!=serial: call.return_dbus_error('org.test.StaleSerial','Stale display serial');return
+    calls.append((kind,rows))
+    if kind:
+        serial+=1; logical=[]
+        for x,y,scale,rotation,primary,members in rows:
+            for connector,mode,_props in members: chosen[connector]=mode
+            logical.append((x,y,scale,rotation,primary,[specs[c] for c,_,_ in members],{}))
+        bus.emit_signal(None,'/org/gnome/Mutter/DisplayConfig','org.gnome.Mutter.DisplayConfig','MonitorsChanged',None)
+    call.return_value(GLib.Variant('()',()))
+info=Gio.DBusNodeInfo.new_for_xml(xml)
+bus.register_object('/org/gnome/Mutter/DisplayConfig',info.interfaces[0],method,lambda *_:GLib.Variant('b',_[-1]=='ApplyMonitorsConfigAllowed'),None)
+child=subprocess.Popen([sys.argv[1]])
+loop=GLib.MainLoop()
+def poll():
+    if child.poll() is None:return True
+    loop.quit();return False
+GLib.timeout_add(20,poll);loop.run()
+assert child.returncode==0,child.returncode
+assert [k for k,_ in calls]==[0,1,0,1,0,1,0,2,0,1,0,1],calls
+first=calls[1][1];assert any(s==1.25 and r==1 and m[0][1]=='75' for x,y,s,r,p,m in first),first
+rollback=calls[3][1];assert all(s==1. and r==0 and m[0][1]=='60' for x,y,s,r,p,m in rollback),rollback
+assert any(r==2 for x,y,s,r,p,m in calls[7][1]),calls[7]
+assert all(s==1. for x,y,s,r,p,m in calls[-1][1]),calls[-1]
+print('Private Mutter owner confirms batched preview, persistent Keep, exact rollback and fresh serial PASS')
