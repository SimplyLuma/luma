+/* A retained preview and its rollback use the current compositor serial,
+ * while preserving the monitor values captured before the edit. */
+gboolean
+cc_display_config_apply_preview (CcDisplayConfig *self,
+                                 gboolean persist,
+                                 GError **error)
+{
+  g_autoptr(GVariant) state = g_dbus_proxy_call_sync (self->proxy,
+      "GetCurrentState", NULL, G_DBUS_CALL_FLAGS_NO_AUTO_START, 5000, NULL, error);
+  if (!state) return FALSE;
+  g_autoptr(GVariant) serial = g_variant_get_child_value (state, 0);
+  self->serial = g_variant_get_uint32 (serial);
+  if (!config_apply (self, CC_DISPLAY_CONFIG_METHOD_VERIFY, error)) return FALSE;
+  return config_apply (self, persist ? CC_DISPLAY_CONFIG_METHOD_PERSISTENT :
+                                      CC_DISPLAY_CONFIG_METHOD_TEMPORARY, error);
+}
+
