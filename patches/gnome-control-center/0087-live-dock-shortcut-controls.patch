 static void
+test_dock_shortcuts (void)
+{
+  g_assert_true (has_key ("org.project_luma.shell-state", "dock-folders"));
+  g_autoptr (GSettings) settings = g_settings_new ("org.project_luma.shell-state");
+  g_settings_reset (settings, "dock-folders");
+  Running r;
+  g_autoptr (CcLumaFixture) model = model_new (&cc_luma_adapter_shelf, &r);
+  g_assert_true (json_node_get_boolean (cc_luma_fixture_get (model, "dockApplications")));
+  g_assert_null (g_settings_get_user_value (settings, "dock-folders"));
+  g_autoptr (GError) error = NULL;
+  g_assert_true (cc_luma_fixture_set_flag (model, "dockApplications", FALSE, &error));
+  g_assert_no_error (error);
+  spin ();
+  g_auto (GStrv) remaining = g_settings_get_strv (settings, "dock-folders");
+  g_assert_false (g_strv_contains ((const char * const *) remaining, "applications:///"));
+  const char *downloads = g_get_user_special_dir (G_USER_DIRECTORY_DOWNLOAD);
+  if (downloads && !g_str_equal (downloads, g_get_home_dir ()))
+    {
+      g_autofree char *uri = g_filename_to_uri (downloads, NULL, NULL);
+      g_assert_true (g_strv_contains ((const char * const *) remaining, uri));
+    }
+  const char *empty[] = { NULL };
+  g_settings_set_strv (settings, "dock-folders", empty);
+  spin ();
+  g_assert_false (json_node_get_boolean (cc_luma_fixture_get (model, "dockApplications")));
+  g_assert_false (json_node_get_boolean (cc_luma_fixture_get (model, "dockDownloads")));
+  const char *custom[] = { "file:///tmp/my-project", "file:///tmp/my-photos", NULL };
+  g_settings_set_strv (settings, "dock-folders", custom);
+  spin ();
+  g_assert_true (cc_luma_fixture_set_flag (model, "dockApplications", TRUE, &error));
+  spin ();
+  g_auto (GStrv) added = g_settings_get_strv (settings, "dock-folders");
+  g_assert_cmpuint (g_strv_length (added), ==, 3);
+  g_assert_cmpstr (added[0], ==, custom[0]);
+  g_assert_cmpstr (added[1], ==, custom[1]);
+  g_assert_cmpstr (added[2], ==, "applications:///");
+  g_assert_true (cc_luma_fixture_set_flag (model, "dockApplications", FALSE, &error));
+  spin ();
+  g_auto (GStrv) removed = g_settings_get_strv (settings, "dock-folders");
+  g_assert_cmpstrv ((const char * const *) removed, custom);
+  g_assert_true (cc_luma_fixture_set_flag (model, "dockFoldersVisible", FALSE, &error));
+  g_assert_false (g_settings_get_boolean (settings, "dock-folders-visible"));
+  g_assert_true (cc_luma_fixture_set_flag (model, "dockFoldersVisible", TRUE, &error));
+  g_assert_true (g_settings_get_boolean (settings, "dock-folders-visible"));
+  g_assert_no_error (error);
+  cc_luma_adapter_shelf.stop (r.state);
+}
