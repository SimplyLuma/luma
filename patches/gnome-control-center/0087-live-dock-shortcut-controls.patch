 static gboolean
+write_folder (Shelf *self, const char *key, JsonNode *value, GError **error)
+{
+  if (!JSON_NODE_HOLDS_VALUE (value) || json_node_get_value_type (value) != G_TYPE_BOOLEAN)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Choose whether to show this shortcut");
+      return FALSE;
+    }
+  gboolean enabled = json_node_get_boolean (value);
+  const char *setting = g_str_equal (key, "dockFoldersVisible") ? "dock-folders-visible" : "dock-folders";
+  if (!has_key (self->schema, setting) || !g_settings_is_writable (self->settings, setting))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Dock shortcuts are locked by policy");
+      return FALSE;
+    }
+  if (g_str_equal (key, "dockFoldersVisible"))
+    return g_settings_set_boolean (self->settings, setting, enabled);
+  g_autofree char *downloads = downloads_uri ();
+  const char *uri = g_str_equal (key, "dockApplications") ? "applications:///" : downloads;
+  if (!uri)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "The Downloads folder is disabled");
+      return FALSE;
+    }
+  g_auto(GStrv) uris = cc_dock_folder_uris (self->settings);
+  g_autoptr(GPtrArray) next = g_ptr_array_new ();
+  for (guint i = 0; uris[i]; i++)
+    if (!g_str_equal (uris[i], uri)) g_ptr_array_add (next, uris[i]);
+  if (enabled) g_ptr_array_add (next, (gpointer) uri);
+  /* Preserve the order when it is already pinned. */
+  if (enabled && g_strv_contains ((const char * const *) uris, uri)) return TRUE;
+  g_ptr_array_add (next, NULL);
+  return g_settings_set_strv (self->settings, setting, (const char * const *) next->pdata);
+}
