+static char *
+downloads_uri (void)
+{
+  const char *path = g_get_user_special_dir (G_USER_DIRECTORY_DOWNLOAD);
+  return path && !g_str_equal (path, g_get_home_dir ()) ? g_filename_to_uri (path, NULL, NULL) : NULL;
+}
+
+static void
+publish_folders (Shelf *self)
+{
+  if (!has_key (self->schema, "dock-folders")) return;
+  g_auto(GStrv) uris = cc_dock_folder_uris (self->settings);
+  g_autofree char *downloads = downloads_uri ();
+  cc_luma_fixture_publish_boolean (self->model, "dockApplications", g_strv_contains ((const char * const *) uris, "applications:///"));
+  cc_luma_fixture_publish_boolean (self->model, "dockDownloads", downloads && g_strv_contains ((const char * const *) uris, downloads));
+  cc_luma_fixture_publish_boolean (self->model, "dockFoldersWritable", g_settings_is_writable (self->settings, "dock-folders"));
+  cc_luma_fixture_publish_boolean (self->model, "dockDownloadsAvailable", downloads != NULL);
+  if (has_key (self->schema, "dock-folders-visible"))
+    {
+      cc_luma_fixture_publish_boolean (self->model, "dockFoldersVisible", g_settings_get_boolean (self->settings, "dock-folders-visible"));
+      cc_luma_fixture_publish_boolean (self->model, "dockFoldersVisibilityWritable", g_settings_is_writable (self->settings, "dock-folders-visible"));
+    }
+}
