From: Luma Developers
Subject: [PATCH] Manage dock shortcuts in the live Luma Settings page

--- /dev/null
+++ b/shell/cc-dock-folders.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <gio/gio.h>
+
+/* Match Shell defaults while preserving explicit empty/custom pins and policy. */
+static inline char **
+cc_dock_folder_uris (GSettings *settings)
+{
+  g_auto(GStrv) uris = g_settings_get_strv (settings, "dock-folders");
+  g_autoptr(GVariant) user = g_settings_get_user_value (settings, "dock-folders");
+  g_autoptr(GPtrArray) defaults = NULL;
+  const char *downloads;
+  if (uris[0] || user || !g_settings_is_writable (settings, "dock-folders"))
+    return g_steal_pointer (&uris);
+  defaults = g_ptr_array_new_with_free_func (g_free);
+  g_ptr_array_add (defaults, g_strdup ("applications:///"));
+  downloads = g_get_user_special_dir (G_USER_DIRECTORY_DOWNLOAD);
+  if (downloads && !g_str_equal (downloads, g_get_home_dir ()))
+    g_ptr_array_add (defaults, g_filename_to_uri (downloads, NULL, NULL));
+  g_ptr_array_add (defaults, NULL);
+  return (char **) g_ptr_array_free (g_steal_pointer (&defaults), FALSE);
+}
