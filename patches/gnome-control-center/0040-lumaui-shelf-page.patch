+static void shelf_view (void)
+{
+  g_autofree char *dir = asset_fixture ();
+  g_autofree char *json = g_build_filename (dir, "settings.json", NULL);
+  g_autoptr (CcLumaFixture) model = cc_luma_fixture_load (json, NULL);
+  JsonObject *wifi = json_object_get_object_member (cc_luma_fixture_get_data (model), "CFWIFI");
+  const char *art = json_object_get_string_member (json_object_get_object_member (wifi, "share_codes"), "Studio North");
+  const char *files[] = { "prism.png", "luma-v3-documents.svg", "luma-v3-browser.svg", "luma-v3-messages.svg", "luma-v3-files.svg", "luma-v3-music.svg", "luma-v3-mail.svg", "luma-v3-photos.svg" };
+  for (guint i = 0; i < G_N_ELEMENTS (files); i++)
+    { g_autofree char *p = g_build_filename (dir, files[i], NULL); g_assert_true (g_file_set_contents (p, art, -1, NULL)); }
+  GtkWidget *view = g_object_ref_sink (cc_luma_view_new (model, "shelf", NULL));
+  g_assert_nonnull (find_name (view, "cf-desk"));
+  g_assert_true (has_text (view, "Luma · always shown"));
+  g_signal_emit_by_name (find_name (view, "cf-preset-one"), "clicked"); drain ();
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "joined")), ==, "joined");
+  g_assert_true (has_text (view, "One bar · always shown"));
+  LumaSegmentedControl *edge = LUMA_SEGMENTED_CONTROL (find_name (view, "cf-edge"));
+  luma_segmented_control_set_selected (edge, "right"); drain ();
+  g_assert_true (has_text (view, "Custom · always shown"));
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "edge")), ==, "right");
+  gtk_widget_activate_action (view, "cf.pick", "(ss)", "hide", "always"); drain ();
+  g_assert_true (has_text (view, "Custom · hides until you point at it"));
+  GtkWidget *size = find_name (view, "cf-isz");
+  gtk_range_set_value (GTK_RANGE (size), 56); drain ();
+  g_assert_true (size == find_name (view, "cf-isz"));
+  g_assert_true (has_text (view, "56 px"));
+  g_signal_emit_by_name (find_name (view, "cf-preset-side"), "clicked"); drain ();
+  g_assert_cmpint (json_node_get_int (cc_luma_fixture_get (model, "isz")), ==, 56);
+  g_assert_true (has_text (view, "Side · hides until you point at it"));
+  wait_ms (100); g_assert_null (cc_luma_view_get_error (view));
+  GtkWidget *orphan = g_object_ref (find_name (view, "cf-preset-free"));
+  g_object_unref (view); g_signal_emit_by_name (orphan, "clicked"); g_object_unref (orphan); wait_ms (100);
+  for (guint i = 1; i < G_N_ELEMENTS (files); i++)
+    { g_autofree char *p = g_build_filename (dir, files[i], NULL); g_assert_cmpint (g_remove (p), ==, 0); }
+  remove_asset_fixture (dir);
+  /* An unknown asset fails during construction as well as asynchronous I/O. */
+  g_autoptr (JsonNode) wrong = json_node_init_string (json_node_alloc (), "private");
+  g_assert_true (cc_luma_fixture_set (model, "wall", wrong, NULL));
+  g_autoptr (GError) error = NULL;
+  g_assert_null (cc_luma_view_new (model, "shelf", &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+}
