--- /dev/null
+++ b/shell/cc-luma-view-shelf.c
@@ -0,0 +1,194 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view-private.h"
+#include "cc-luma-desktop.h"
+
+static void arrangement_changed (LumaSegmentedControl *control, const char *value, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  const char *key = g_object_get_data (G_OBJECT (control), "cf-key");
+  g_autoptr (GError) error = NULL;
+  if (cc_luma_shelf_set_choice (v->model, key, value, &error)) cc_luma_view_queue_refresh (v);
+  else cc_luma_view_report_error (v, error);
+}
+static GtkWidget *segments (View *v, const char *key, const char *caption, const char * const *values)
+{
+  GtkWidget *control = luma_segmented_control_new ();
+  for (guint i = 0; values[i]; i += 2)
+    luma_segmented_control_append (LUMA_SEGMENTED_CONTROL (control), values[i], values[i + 1]);
+  luma_segmented_control_set_selected (LUMA_SEGMENTED_CONTROL (control), cc_luma_view_text (v, key));
+  gtk_accessible_update_property (GTK_ACCESSIBLE (control), GTK_ACCESSIBLE_PROPERTY_LABEL, caption, -1);
+  g_autofree char *name = g_strconcat ("cf-", key, NULL);
+  gtk_widget_set_name (control, name);
+  g_object_set_data_full (G_OBJECT (control), "cf-key", g_strdup (key), g_free);
+  g_signal_connect_object (control, "changed", G_CALLBACK (arrangement_changed), v->root, 0);
+  return control;
+}
+static void preset_clicked (GtkButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  g_autoptr (GError) error = NULL;
+  const char *id = g_object_get_data (G_OBJECT (button), "cf-preset");
+  if (cc_luma_shelf_set_preset (v->model, id, &error)) cc_luma_view_queue_refresh (v);
+  else cc_luma_view_report_error (v, error);
+}
+static GtkWidget *preset_buttons (View *v)
+{
+  GtkWidget *flow = gtk_flow_box_new ();
+  gtk_flow_box_set_selection_mode (GTK_FLOW_BOX (flow), GTK_SELECTION_NONE);
+  gtk_flow_box_set_min_children_per_line (GTK_FLOW_BOX (flow), 1);
+  gtk_flow_box_set_max_children_per_line (GTK_FLOW_BOX (flow), 8);
+  gtk_flow_box_set_row_spacing (GTK_FLOW_BOX (flow), 4);
+  gtk_flow_box_set_column_spacing (GTK_FLOW_BOX (flow), 4);
+  gtk_widget_set_halign (flow, GTK_ALIGN_CENTER);
+  gtk_widget_set_margin_top (flow, 14);
+  JsonArray *catalog = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFPRE");
+  for (guint i = 0; i < json_array_get_length (catalog); i++)
+    {
+      JsonArray *entry = json_array_get_array_element (catalog, i);
+      const char *id = json_array_get_string_element (entry, 0);
+      GtkWidget *button = gtk_toggle_button_new_with_label (json_array_get_string_element (entry, 1));
+      gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (button), g_str_equal (id, cc_luma_view_text (v, "preset")));
+      g_autofree char *name = g_strconcat ("cf-preset-", id, NULL);
+      gtk_widget_set_name (button, name);
+      g_object_set_data_full (G_OBJECT (button), "cf-preset", g_strdup (id), g_free);
+      g_signal_connect_object (button, "clicked", G_CALLBACK (preset_clicked), v->root, 0);
+      gtk_flow_box_insert (GTK_FLOW_BOX (flow), button, -1);
+    }
+  return flow;
+}
+static GtkWidget *shelf_island (View *v, gboolean vertical, gboolean with_apps, gboolean with_clock)
+{
+  GtkWidget *content = gtk_box_new (vertical ? GTK_ORIENTATION_VERTICAL : GTK_ORIENTATION_HORIZONTAL, 4);
+  const char *apps[] = { "filer", "viola", "tide", "messages", "charlie", "photos", "write" };
+  if (with_apps)
+    for (guint i = 0; i < G_N_ELEMENTS (apps); i++)
+      {
+        GtkWidget *image = cc_luma_view_image (v, apps[i], 36, 36);
+        gtk_widget_set_size_request (image, vertical ? 16 : 18, vertical ? 16 : 18);
+        gtk_box_append (GTK_BOX (content), image);
+      }
+  if (with_clock)
+    {
+      if (with_apps)
+        {
+          GtkWidget *space = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+          gtk_widget_set_hexpand (space, !vertical);
+          gtk_widget_set_vexpand (space, vertical);
+          gtk_box_append (GTK_BOX (content), space);
+        }
+      g_autoptr (GDateTime) now = g_date_time_new_now_local ();
+      g_autofree char *clock = g_date_time_format (now, "%l:%M");
+      gtk_box_append (GTK_BOX (content), cc_luma_view_label (g_strstrip (clock), "caption", FALSE));
+    }
+  /* These miniature islands are app-only diagrams, composed from kit cards. */
+  GtkWidget *card = luma_card_new (content, FALSE);
+  gtk_widget_set_margin_start (content, 5); gtk_widget_set_margin_end (content, 5);
+  gtk_widget_set_margin_top (content, 5); gtk_widget_set_margin_bottom (content, 5);
+  return card;
+}
+static void place_island (GtkOverlay *desk, GtkWidget *island, gboolean vertical, gboolean right, GtkAlign along, gboolean attached)
+{
+  gtk_widget_set_halign (island, vertical ? (right ? GTK_ALIGN_END : GTK_ALIGN_START) : along);
+  gtk_widget_set_valign (island, vertical ? along : GTK_ALIGN_END);
+  if (vertical)
+    {
+      if (right) gtk_widget_set_margin_end (island, attached ? 0 : 8);
+      else gtk_widget_set_margin_start (island, attached ? 0 : 8);
+      if (along == GTK_ALIGN_END) gtk_widget_set_margin_bottom (island, 8);
+      else if (along == GTK_ALIGN_FILL) { gtk_widget_set_margin_top (island, attached ? 0 : 8); gtk_widget_set_margin_bottom (island, attached ? 0 : 8); }
+    }
+  else
+    {
+      gtk_widget_set_margin_bottom (island, attached ? 0 : 8);
+      if (along == GTK_ALIGN_END) gtk_widget_set_margin_end (island, attached ? 0 : 10);
+      else if (along == GTK_ALIGN_FILL) { gtk_widget_set_margin_start (island, attached ? 0 : 8); gtk_widget_set_margin_end (island, attached ? 0 : 8); }
+    }
+  gtk_overlay_add_overlay (desk, island);
+}
+static GtkWidget *desk_preview (View *v)
+{
+  gboolean vertical = !g_str_equal (cc_luma_view_text (v, "edge"), "bottom");
+  gboolean right = g_str_equal (cc_luma_view_text (v, "edge"), "right");
+  gboolean joined = g_str_equal (cc_luma_view_text (v, "joined"), "joined");
+  gboolean attached = g_str_equal (cc_luma_view_text (v, "float"), "edge");
+  gboolean spread = g_str_equal (cc_luma_view_text (v, "spread"), "spread");
+  const char *preset = cc_luma_view_text (v, "preset");
+  GtkWidget *desk = gtk_overlay_new ();
+  gtk_widget_set_name (desk, "cf-desk");
+  gtk_widget_set_size_request (desk, -1, 200);
+  gtk_overlay_set_child (GTK_OVERLAY (desk), cc_luma_view_image (v, cc_luma_view_text (v, "wall"), 1040, 400));
+  GtkWidget *apps = shelf_island (v, vertical, TRUE, joined);
+  place_island (GTK_OVERLAY (desk), apps, vertical, right, joined && spread ? GTK_ALIGN_FILL : GTK_ALIGN_CENTER, attached);
+  if (!joined)
+    {
+      GtkWidget *clock = shelf_island (v, vertical, FALSE, TRUE);
+      place_island (GTK_OVERLAY (desk), clock, vertical, right, spread ? GTK_ALIGN_END : GTK_ALIGN_CENTER, attached);
+      if (g_str_equal (preset, "split"))
+        { gtk_widget_set_halign (clock, GTK_ALIGN_CENTER); gtk_widget_set_valign (clock, GTK_ALIGN_START); gtk_widget_set_margin_top (clock, attached ? 0 : 8); }
+      else if (g_str_equal (preset, "free"))
+        { gtk_widget_set_halign (apps, GTK_ALIGN_START); gtk_widget_set_margin_start (apps, 18); gtk_widget_set_margin_bottom (apps, 14); gtk_widget_set_halign (clock, GTK_ALIGN_END); gtk_widget_set_valign (clock, GTK_ALIGN_START); gtk_widget_set_margin_top (clock, 14); gtk_widget_set_margin_end (clock, 18); }
+      else if (!spread)
+        {
+          /* v70 places the two adjacent islands at fixed diagram coordinates. */
+          gtk_widget_set_halign (apps, GTK_ALIGN_START); gtk_widget_set_valign (apps, vertical ? GTK_ALIGN_START : GTK_ALIGN_END);
+          gtk_widget_set_halign (clock, vertical ? (right ? GTK_ALIGN_END : GTK_ALIGN_START) : GTK_ALIGN_START);
+          if (vertical) { gtk_widget_set_margin_top (apps, 14); gtk_widget_set_valign (clock, GTK_ALIGN_START); gtk_widget_set_margin_top (clock, 166); }
+          else { gtk_widget_set_margin_start (apps, 152); gtk_widget_set_margin_start (clock, 318); }
+        }
+    }
+  GtkWidget *clamp = adw_clamp_new ();
+  adw_clamp_set_maximum_size (ADW_CLAMP (clamp), 520);
+  adw_clamp_set_child (ADW_CLAMP (clamp), desk);
+  return clamp;
+}
+static void size_changed (GtkRange *range, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  gint64 size = (gint64) gtk_range_get_value (range);
+  g_autoptr (GError) error = NULL;
+  if (!cc_luma_shelf_set_size (v->model, size, &error)) { cc_luma_view_report_error (v, error); return; }
+  g_autofree char *caption = g_strdup_printf ("%" G_GINT64_FORMAT " px", size);
+  gtk_label_set_text (g_object_get_data (G_OBJECT (range), "cf-output"), caption);
+}
+void cc_luma_view_shelf_render (View *v)
+{
+  const char *edge[] = { "bottom", "Bottom", "left", "Left", "right", "Right", NULL };
+  const char *spread[] = { "together", "Together", "spread", "Spread", NULL };
+  const char *joined[] = { "separate", "Separate", "joined", "One bar", NULL };
+  const char *floating[] = { "floating", "Floating", "edge", "Attached", NULL };
+  const char *hiding[] = { "never", "Never", "touch", "When a window touches it", "always", "Until you point at it", NULL };
+  const char *label = "Custom", *preset = cc_luma_view_text (v, "preset");
+  JsonArray *catalog = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFPRE");
+  for (guint i = 0; i < json_array_get_length (catalog); i++)
+    { JsonArray *entry = json_array_get_array_element (catalog, i); if (g_str_equal (json_array_get_string_element (entry, 0), preset)) label = json_array_get_string_element (entry, 1); }
+  const char *hide = cc_luma_view_text (v, "hide");
+  g_autofree char *meta = g_strdup_printf ("%s · %s", label, g_str_equal (hide, "never") ? "always shown" : g_str_equal (hide, "touch") ? "hides when a window touches it" : "hides until you point at it");
+  cc_luma_view_header (v, "Shelf", meta, NULL);
+  GtkWidget *hero_body = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  gtk_box_append (GTK_BOX (hero_body), desk_preview (v)); gtk_box_append (GTK_BOX (hero_body), preset_buttons (v));
+  GtkWidget *hero = luma_card_new (hero_body, TRUE); luma_card_set_recessed (LUMA_CARD (hero), TRUE);
+  gtk_widget_set_margin_top (hero, 20); gtk_box_append (v->body, hero);
+  GtkBox *rows = cc_luma_view_group (v, "Arrangement");
+  cc_luma_view_row (rows, "Position", NULL, segments (v, "edge", "Position", edge));
+  cc_luma_view_row (rows, "Islands", "Together in the middle, or spread to the ends", segments (v, "spread", "Islands", spread));
+  cc_luma_view_row (rows, "Surface", NULL, segments (v, "joined", "Surface", joined));
+  cc_luma_view_row (rows, "Edge", "Float above the edge, or grow out of it", segments (v, "float", "Edge", floating));
+  rows = cc_luma_view_group (v, "Behaviour");
+  cc_luma_view_row (rows, "Hide the shelf", NULL, cc_luma_view_picker (v, "hide", hiding));
+  GtkWidget *range = gtk_scale_new_with_range (GTK_ORIENTATION_HORIZONTAL, 32, 56, 4);
+  gtk_scale_set_draw_value (GTK_SCALE (range), FALSE); gtk_widget_set_size_request (range, 140, -1);
+  gint64 size = json_node_get_int (cc_luma_fixture_get (v->model, "isz")); gtk_range_set_value (GTK_RANGE (range), size);
+  gtk_widget_set_name (range, "cf-isz"); gtk_accessible_update_property (GTK_ACCESSIBLE (range), GTK_ACCESSIBLE_PROPERTY_LABEL, "Icon size", -1);
+  GtkWidget *size_box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 10);
+  g_autofree char *caption = g_strdup_printf ("%" G_GINT64_FORMAT " px", size);
+  GtkWidget *output = cc_luma_view_label (caption, "caption", TRUE);
+  gtk_box_append (GTK_BOX (size_box), range); gtk_box_append (GTK_BOX (size_box), output);
+  g_object_set_data (G_OBJECT (range), "cf-output", output); g_signal_connect_object (range, "value-changed", G_CALLBACK (size_changed), v->root, 0);
+  cc_luma_view_row (rows, "Icon size", NULL, size_box);
+  rows = cc_luma_view_group (v, "Status island");
+  cc_luma_view_row (rows, "Clock", "Format, weekday and seconds", cc_luma_view_link (v, "", "datetime"));
+  cc_luma_view_row (rows, "Battery percentage", NULL, cc_luma_view_link (v, cc_luma_view_flag (v, "pct") ? "Shown" : "Hidden", "power"));
+}
