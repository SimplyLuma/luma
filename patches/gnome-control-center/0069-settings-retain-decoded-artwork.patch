Subject: [PATCH] Settings: retain local artwork through live page refreshes

--- a/shell/cc-luma-view-image.c
+++ b/shell/cc-luma-view-image.c
@@ -1,10 +1,12 @@
 /* SPDX-License-Identifier: GPL-2.0-or-later */
 #include "cc-luma-view-private.h"
+#include <glib/gstdio.h>
 
 typedef struct {
   GWeakRef root;
   GWeakRef picture;
   char *path;
+  char *cache_key;
   int width, height;
   guint64 generation;
   gboolean application;
@@ -14,7 +16,31 @@
   g_weak_ref_clear (&job->root);
   g_weak_ref_clear (&job->picture);
   g_free (job->path);
+  g_free (job->cache_key);
   g_free (job);
+}
+/* Keep decoded local artwork through unrelated live-model page rebuilds.
+ * Main-thread-only, per-view and bounded; file metadata and requested size
+ * prevent an old wallpaper or another resolution from being reused. */
+static GHashTable *image_cache (GtkWidget *root)
+{
+  GHashTable *cache = g_object_get_data (G_OBJECT (root), "cf-decoded-images");
+  if (!cache)
+    {
+      cache = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_object_unref);
+      g_object_set_data_full (G_OBJECT (root), "cf-decoded-images", cache,
+                              (GDestroyNotify) g_hash_table_unref);
+    }
+  return cache;
+}
+static char *image_key (const char *path, int width, int height)
+{
+  GStatBuf metadata;
+  if (g_stat (path, &metadata) != 0) return NULL;
+  return g_strdup_printf ("%s:%d:%d:%" G_GINT64_FORMAT ":%" G_GINT64_FORMAT ":%ld:%" G_GUINT64_FORMAT,
+                          path, width, height, (gint64) metadata.st_size,
+                          (gint64) metadata.st_mtim.tv_sec, metadata.st_mtim.tv_nsec,
+                          (guint64) metadata.st_ino);
 }
 static void decode_image (GTask *task, gpointer source, gpointer data, GCancellable *cancel)
 {
@@ -32,13 +58,29 @@
   g_autoptr (GdkPixbuf) image = g_task_propagate_pointer (task, &error);
   g_autoptr (GtkWidget) root = g_weak_ref_get (&job->root);
   g_autoptr (GtkWidget) picture = g_weak_ref_get (&job->picture);
-  if (!root || !picture) return;
+  if (!root) return;
   View *v = g_object_get_data (G_OBJECT (root), "cf-view");
-  if (!v || v->generation != job->generation || g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
-  if (!image) { cc_luma_view_report_error (v, error); return; }
+  if (!v) return;
+  if (!image)
+    {
+      if (picture && v->generation == job->generation &&
+          !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        cc_luma_view_report_error (v, error);
+      return;
+    }
   g_autoptr (GdkTexture) texture = gdk_texture_new_for_pixbuf (image);
   g_autoptr (GdkPaintable) normalized = job->application ? luma_application_icon_new (GDK_PAINTABLE (texture)) : NULL;
-  gtk_picture_set_paintable (GTK_PICTURE (picture), normalized ? normalized : GDK_PAINTABLE (texture));
+  GdkPaintable *paintable = normalized ? normalized : GDK_PAINTABLE (texture);
+  if (job->cache_key)
+    {
+      GHashTable *cache = image_cache (root);
+      if (g_hash_table_size (cache) >= 32 && !g_hash_table_contains (cache, job->cache_key))
+        g_hash_table_remove_all (cache);
+      g_hash_table_replace (cache, g_strdup (job->cache_key), g_object_ref (paintable));
+    }
+  /* A completed obsolete decode may populate the cache, never its old widget. */
+  if (picture && v->generation == job->generation)
+    gtk_picture_set_paintable (GTK_PICTURE (picture), paintable);
 }
 GtkWidget *cc_luma_view_image (View *v, const char *asset, int width, int height)
 {
@@ -58,7 +100,18 @@
     }
   job->application = g_str_has_suffix (job->path, ".svg");
   job->width = width; job->height = height; job->generation = v->generation;
-  g_autoptr (GTask) task = g_task_new (NULL, v->images_cancel, image_decoded, NULL);
+  job->cache_key = image_key (job->path, width, height);
+  GdkPaintable *cached = job->cache_key ? g_hash_table_lookup (image_cache (v->root), job->cache_key) : NULL;
+  if (cached)
+    {
+      gtk_picture_set_paintable (GTK_PICTURE (picture), cached);
+      image_job_free (job);
+      return picture;
+    }
+  /* Local file decoding cannot be interrupted by GCancellable; allow it to
+   * finish into the cache when a live-model update replaces this generation.
+   * Weak refs still protect a closed view, and generation protects painting. */
+  g_autoptr (GTask) task = g_task_new (NULL, NULL, image_decoded, NULL);
   g_task_set_task_data (task, job, (GDestroyNotify) image_job_free);
   g_task_run_in_thread (task, decode_image);
   return picture;
