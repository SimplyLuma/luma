+/* Resolve only sources already installed or layouts advertised by XKB. */
+static gboolean resolve_source (Keyboard *self, const char *name, char **type, char **id)
+{
+  g_autoptr (GVariant) current = g_settings_get_value (self->settings, "sources");
+  for (gsize i = 0; i < g_variant_n_children (current); i++) {
+    const char *t, *s; g_variant_get_child (current, i, "(&s&s)", &t, &s);
+    g_autofree char *label = source_name (self, t, s);
+    if (g_strcmp0 (label, name) == 0) { *type = g_strdup (t); *id = g_strdup (s); return TRUE; }
+  }
+  g_autoptr (GList) layouts = gnome_xkb_info_get_all_layouts (self->xkb);
+  for (GList *l = layouts; l; l = l->next) {
+    g_autofree char *label = source_name (self, "xkb", l->data);
+    if (g_strcmp0 (label, name) == 0) { *type = g_strdup ("xkb"); *id = g_strdup (l->data); return TRUE; }
+  }
+  return FALSE;
+}
+static gboolean write_sources (Keyboard *self, JsonNode *value, GError **error)
+{
+  if (!value || !JSON_NODE_HOLDS_ARRAY (value) || !json_array_get_length (json_node_get_array (value))) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "At least one valid keyboard layout is required"); return FALSE;
+  }
+  if (!g_settings_is_writable (self->settings, "sources")) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Keyboard layouts are locked by policy"); return FALSE;
+  }
+  GVariantBuilder sources; g_variant_builder_init (&sources, G_VARIANT_TYPE ("a(ss)"));
+  g_autoptr (GHashTable) seen = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  JsonArray *list = json_node_get_array (value);
+  for (guint i = 0; i < json_array_get_length (list); i++) {
+    JsonNode *node = json_array_get_element (list, i);
+    const char *name = JSON_NODE_HOLDS_VALUE (node) && json_node_get_value_type (node) == G_TYPE_STRING ? json_node_get_string (node) : NULL;
+    g_autofree char *type = NULL, *id = NULL;
+    if (!name || !g_hash_table_add (seen, g_strdup (name)) || !resolve_source (self, name, &type, &id)) {
+      g_variant_builder_clear (&sources);
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Unknown or duplicate keyboard layout"); return FALSE;
+    }
+    g_variant_builder_add (&sources, "(ss)", type, id);
+  }
+  g_autoptr (GVariant) next = g_variant_ref_sink (g_variant_builder_end (&sources));
+  if (!g_settings_set_value (self->settings, "sources", next)) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_FAILED, "Keyboard layouts could not be saved"); return FALSE;
+  }
+  g_autoptr (GVariant) saved = g_settings_get_value (self->settings, "sources");
+  if (!g_variant_equal (saved, next)) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_FAILED, "Keyboard layouts did not remain saved"); return FALSE;
+  }
+  publish (self); return TRUE;
+}
