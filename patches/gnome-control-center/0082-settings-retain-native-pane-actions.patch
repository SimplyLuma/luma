+typedef struct { GWeakRef root; guint64 generation; char *method; char *message; } PrivacyCleanup;
+static void cleanup_free (PrivacyCleanup *cleanup)
+{
+  g_weak_ref_clear (&cleanup->root); g_free (cleanup->method); g_free (cleanup->message); g_free (cleanup);
+}
+static void cleanup_report (PrivacyCleanup *cleanup, GError *error)
+{
+  g_autoptr (GObject) root = g_weak_ref_get (&cleanup->root);
+  View *v = root ? g_object_get_data (root, "cf-view") : NULL;
+  if (!v || cleanup->generation != v->generation || !g_str_equal (v->page, "p-files")) return;
+  if (error) cc_luma_view_report_error (v, error);
+  else luma_toast_show (GTK_WIDGET (root), cleanup->message, "done");
+}
+static void cleanup_finished (GObject *source, GAsyncResult *result, gpointer data)
+{
+  PrivacyCleanup *cleanup = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  cleanup_report (cleanup, error); cleanup_free (cleanup);
+}
+static void cleanup_bus_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  PrivacyCleanup *cleanup = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GDBusConnection) bus = g_bus_get_finish (result, &error);
+  if (!bus) { cleanup_report (cleanup, error); cleanup_free (cleanup); return; }
+  g_dbus_connection_call (bus, "org.gnome.SettingsDaemon.Housekeeping", "/org/gnome/SettingsDaemon/Housekeeping",
+                          "org.gnome.SettingsDaemon.Housekeeping", cleanup->method, NULL, NULL,
+                          G_DBUS_CALL_FLAGS_NONE, 60000, NULL, cleanup_finished, cleanup);
+}
