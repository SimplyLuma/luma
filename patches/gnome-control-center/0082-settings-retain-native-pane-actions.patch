+/* Walk cache directories by directory descriptor. Every descendant opens
+ * without following symbolic links; links themselves are unlinked. Neither
+ * an app symlink nor a concurrent replacement can redirect deletion into
+ * the app's data directory or the person's documents. */
+static gboolean clear_cache_fd (int fd, GCancellable *cancel, GError **error)
+{
+  int scan = dup (fd);
+  if (scan < 0) goto failed;
+  DIR *dir = fdopendir (scan);
+  if (!dir) { int saved = errno; close (scan); errno = saved; goto failed; }
+  for (;;)
+    {
+      if (g_cancellable_set_error_if_cancelled (cancel, error)) { closedir (dir); return FALSE; }
+      errno = 0;
+      struct dirent *entry = readdir (dir);
+      if (!entry)
+        {
+          if (errno) { closedir (dir); goto failed; }
+          break;
+        }
+      if (g_str_equal (entry->d_name, ".") || g_str_equal (entry->d_name, "..")) continue;
+      struct stat st;
+      if (fstatat (fd, entry->d_name, &st, AT_SYMLINK_NOFOLLOW) < 0)
+        { if (errno == ENOENT) continue; closedir (dir); goto failed; }
+      if (S_ISDIR (st.st_mode))
+        {
+          int child = openat (fd, entry->d_name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+          if (child < 0) { closedir (dir); goto failed; }
+          gboolean ok = clear_cache_fd (child, cancel, error);
+          close (child);
+          if (!ok) { closedir (dir); return FALSE; }
+          if (unlinkat (fd, entry->d_name, AT_REMOVEDIR) < 0 && errno != ENOENT)
+            { closedir (dir); goto failed; }
+        }
+      else if (unlinkat (fd, entry->d_name, 0) < 0 && errno != ENOENT)
+        { closedir (dir); goto failed; }
+    }
+  closedir (dir);
+  return TRUE;
+failed:
+  g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno), "Could not clear the app cache: %s", g_strerror (errno));
+  return FALSE;
+}
+
+static void cache_thread (GTask *task, gpointer source, gpointer data, GCancellable *cancel)
+{
+  const char *id = data;
+  int fd = open (g_get_home_dir (), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+  const char *parts[] = { ".var", "app", id, "cache" };
+  g_autoptr (GError) error = NULL;
+  for (guint i = 0; fd >= 0 && i < G_N_ELEMENTS (parts); i++)
+    {
+      int next = openat (fd, parts[i], O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+      int saved = errno;
+      close (fd);
+      fd = next;
+      errno = saved;
+    }
+  if (fd < 0)
+    {
+      if (errno == ENOENT) { g_task_return_boolean (task, TRUE); return; }
+      g_task_return_new_error (task, G_IO_ERROR, g_io_error_from_errno (errno),
+                              "Could not open the app cache: %s", g_strerror (errno));
+      return;
+    }
+  gboolean ok = clear_cache_fd (fd, cancel, &error);
+  close (fd);
+  if (ok) g_task_return_boolean (task, TRUE); else g_task_return_error (task, g_steal_pointer (&error));
+}
+
+static void cache_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  View *v = g_object_get_data (source, "cf-view");
+  g_autoptr (GError) error = NULL;
+  gboolean ok = g_task_propagate_boolean (G_TASK (result), &error);
+  if (!v || !gtk_widget_get_root (GTK_WIDGET (source))) return;
+  if (!ok) cc_luma_view_report_error (v, error);
+  else
+    {
+      luma_toast_show (GTK_WIDGET (source), "Cache cleared", "done");
+      void (*refresh_apps) (gpointer) = g_object_get_data (G_OBJECT (v->model), "cc-luma-apps-refresh");
+      gpointer apps = g_object_get_data (G_OBJECT (v->model), "cc-luma-apps-state");
+      if (refresh_apps && apps) refresh_apps (apps); /* resample actual storage; never manufacture a size */
+    }
+  cc_luma_view_queue_refresh (v);
+}
