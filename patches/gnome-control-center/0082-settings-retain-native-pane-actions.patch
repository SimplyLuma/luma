-/* Live: goa-daemon's accounts and the providers it can add. Opening,
- * connecting and removing are GNOME's panel's (the shell delegates). */
+/* Native provider dialogs retain this Settings pane. Requests refer weakly
+ * to the view, cancel when its root goes away, and ignore superseded results. */
+typedef struct {
+  GWeakRef root;
+  GCancellable *cancel;
+  GoaClient *client;
+  char *id;
+  gboolean add;
+} AccountRequest;
+
+static void account_request_free (AccountRequest *r)
+{
+  g_weak_ref_clear (&r->root);
+  g_clear_object (&r->cancel);
+  g_clear_object (&r->client);
+  g_free (r->id);
+  g_free (r);
+}
+
+static void account_request_done (AccountRequest *r, const GError *error)
+{
+  g_autoptr (GObject) root = g_weak_ref_get (&r->root);
+  View *v = root ? g_object_get_data (root, "cf-view") : NULL;
+  if (v && g_object_get_data (root, "cf-account-request") == r->cancel) {
+    g_object_set_data (root, "cf-account-request", NULL);
+    if (error && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED) &&
+        !g_error_matches (error, GOA_ERROR, GOA_ERROR_DIALOG_DISMISSED))
+      cc_luma_view_report_error (v, error);
+    cc_luma_view_queue_refresh (v);
+  }
+  account_request_free (r);
+}
+
+static void account_provider_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  AccountRequest *r = data;
+  g_autoptr (GError) error = NULL;
+  if (r->add) {
+    g_autoptr (GoaObject) object = goa_provider_add_account_finish (GOA_PROVIDER (source), result, &error);
+  } else {
+    goa_provider_show_account_finish (GOA_PROVIDER (source), result, &error);
+  }
+  account_request_done (r, error);
+}
+
+static void account_client_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  AccountRequest *r = data;
+  g_autoptr (GError) error = NULL;
+  r->client = goa_client_new_finish (result, &error);
+  g_autoptr (GObject) root = g_weak_ref_get (&r->root);
+  GtkRoot *parent = root ? gtk_widget_get_root (GTK_WIDGET (root)) : NULL;
+  if (!r->client || !GTK_IS_WINDOW (parent) || g_cancellable_is_cancelled (r->cancel)) {
+    account_request_done (r, error); return;
+  }
+  g_autoptr (GoaObject) object = NULL;
+  if (!r->add) {
+    GList *accounts = goa_client_get_accounts (r->client);
+    for (GList *i = accounts; i; i = i->next) {
+      GoaAccount *account = goa_object_peek_account (i->data);
+      if (account && g_str_equal (goa_account_get_id (account), r->id)) {
+        object = g_object_ref (i->data); break;
+      }
+    }
+    g_list_free_full (accounts, g_object_unref);
+    if (!object) {
+      error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "This account is no longer connected.");
+      account_request_done (r, error); return;
+    }
+  }
+  const char *type = r->add ? r->id : goa_account_get_provider_type (goa_object_peek_account (object));
+  g_autoptr (GoaProvider) provider = goa_provider_get_for_provider_type (type);
+  if (!provider) {
+    error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "This account provider is not available.");
+    account_request_done (r, error); return;
+  }
+  if (r->add)
+    goa_provider_add_account (provider, r->client, GTK_WIDGET (parent), r->cancel, account_provider_done, r);
+  else
+    goa_provider_show_account (provider, r->client, object, GTK_WIDGET (parent), r->cancel, account_provider_done, r);
+}
+
+static void account_root_closed (GtkWidget *root, GCancellable *cancel)
+{
+  g_cancellable_cancel (cancel);
+}
+
+static void account_request (View *v, const char *id, gboolean add)
+{
+  if (!id || !*id) return;
+  GCancellable *previous = g_object_get_data (G_OBJECT (v->root), "cf-account-request");
+  if (previous) g_cancellable_cancel (previous);
+  AccountRequest *r = g_new0 (AccountRequest, 1);
+  g_weak_ref_init (&r->root, v->root);
+  r->id = g_strdup (id); r->add = add; r->cancel = g_cancellable_new ();
+  g_object_set_data_full (G_OBJECT (v->root), "cf-account-request", g_object_ref (r->cancel), g_object_unref);
+  g_signal_connect_object (v->root, "unrealize", G_CALLBACK (account_root_closed), r->cancel, 0);
+  goa_client_new (r->cancel, account_client_done, r);
+}
