+typedef struct { guint delegates, errors, writes; GQuark domain; gint code; } RetainedFailure;
+static gboolean unexpected_delegate (GtkWidget *root, const char *page, gpointer data)
+{
+  ((RetainedFailure *) data)->delegates++; return TRUE;
+}
+static void retained_error (GtkWidget *root, const GError *error, gpointer data)
+{
+  RetainedFailure *r = data;
+  r->errors++; r->domain = error->domain; r->code = error->code;
+}
+static gboolean rejected_write (CcLumaFixture *model, const char *key, JsonNode *value, gpointer data, GError **error)
+{
+  ((RetainedFailure *) data)->writes++;
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "The setting is locked by policy.");
+  return FALSE;
+}
+static void live_failure_keeps_pane (void)
+{
+  g_autoptr (JsonParser) parser = json_parser_new ();
+  g_assert_true (json_parser_load_from_file (parser, g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), NULL));
+  g_autoptr (CcLumaFixture) model = cc_luma_fixture_new_live (json_parser_get_root (parser));
+  RetainedFailure r = { 0 };
+  cc_luma_fixture_set_writer (model, rejected_write, &r);
+  cc_luma_fixture_set_page_ready_func (model, always_ready, NULL);
+  cc_luma_fixture_own_key (model, "devName");
+  g_autofree char *before = g_strdup (json_node_get_string (cc_luma_fixture_get (model, "devName")));
+  GtkWidget *window = gtk_window_new ();
+  GtkWidget *view = cc_luma_view_new (model, "sharing", NULL);
+  cc_luma_view_set_delegate (view, unexpected_delegate, &r);
+  cc_luma_view_set_error_handler (view, retained_error, &r);
+  gtk_window_set_child (GTK_WINDOW (window), view);
+  gtk_window_present (GTK_WINDOW (window)); wait_ms (100);
+  GtkWidget *field = find_name (view, "cf-devName");
+  g_assert_nonnull (field);
+  gtk_editable_set_text (GTK_EDITABLE (field), "Rejected change");
+  g_signal_emit_by_name (field, "activate"); drain ();
+  g_assert_cmpuint (r.errors, ==, 1);
+  g_assert_cmpint (r.code, ==, G_IO_ERROR_NOT_SUPPORTED);
+  g_assert_cmpuint (r.writes, ==, 0);
+  cc_luma_fixture_verify_key (model, "devName");
+  field = find_name (view, "cf-devName");
+  gtk_editable_set_text (GTK_EDITABLE (field), "Denied change");
+  g_signal_emit_by_name (field, "activate"); drain ();
+  g_assert_cmpuint (r.errors, ==, 2);
+  g_assert_cmpint (r.code, ==, G_IO_ERROR_PERMISSION_DENIED);
+  g_assert_cmpuint (r.writes, ==, 1);
+  View *v = g_object_get_data (G_OBJECT (view), "cf-view");
+  g_assert_true (cc_luma_view_delegated (v)); /* a remaining fixture-only action is blocked */
+  g_assert_cmpuint (r.errors, ==, 3);
+  g_autoptr (GError) async_error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                                                      "The service refused the change.");
+  cc_luma_fixture_report_write_error (model, async_error);
+  drain ();
+  g_assert_cmpuint (r.errors, ==, 4);
+  g_assert_cmpint (r.code, ==, G_IO_ERROR_PERMISSION_DENIED);
+  g_assert_cmpuint (r.delegates, ==, 0);
+  g_assert_cmpstr (cc_luma_view_get_page (view), ==, "sharing");
+  g_assert_true (gtk_window_get_child (GTK_WINDOW (window)) == view);
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "devName")), ==, before);
+  gtk_window_destroy (GTK_WINDOW (window)); drain ();
+}
