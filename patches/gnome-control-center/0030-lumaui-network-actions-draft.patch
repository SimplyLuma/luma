+static void share_clicked (GtkButton *button, View *v)
+{
+  JsonObject *data = cc_luma_fixture_get_data (v->model);
+  JsonObject *wifi_data = json_object_get_object_member (data, "CFWIFI");
+  JsonObject *codes = json_object_get_object_member (wifi_data, "share_codes");
+  const char *name = *text (v, "net") ? text (v, "net") : "Studio North";
+  const char *svg = json_object_get_string_member (codes, name);
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GInputStream) stream = g_memory_input_stream_new_from_data (svg, strlen (svg), NULL);
+  g_autoptr (GdkPixbuf) pixbuf = gdk_pixbuf_new_from_stream_at_scale (stream, 180, 180, TRUE, NULL, &error);
+  if (!pixbuf) { luma_toast_show (v->root, error->message, "error"); return; }
+  g_autofree char *title = g_strdup_printf ("Join %s", name);
+  LumaActionEditor *editor = new_editor (v, title, "qr-code", "Point a phone’s camera at the code.");
+  GtkWidget *body = gtk_box_new (GTK_ORIENTATION_VERTICAL, 12);
+  g_autoptr (GdkTexture) texture = gdk_texture_new_for_pixbuf (pixbuf);
+  GtkWidget *picture = gtk_picture_new_for_paintable (GDK_PAINTABLE (texture));
+  gtk_widget_set_size_request (picture, 180, 180);
+  gtk_widget_set_halign (picture, GTK_ALIGN_CENTER);
+  gtk_widget_set_name (picture, "cf-share-code");
+  gtk_box_append (GTK_BOX (body), picture);
+  GtkWidget *caption = label ("Password", "caption", TRUE);
+  GtkWidget *password = label (json_object_get_string_member (wifi_data, "share_password"), "numeric", FALSE);
+  gtk_widget_set_halign (caption, GTK_ALIGN_CENTER);
+  gtk_widget_set_halign (password, GTK_ALIGN_CENTER);
+  gtk_box_append (GTK_BOX (body), caption);
+  gtk_box_append (GTK_BOX (body), password);
+  luma_action_editor_set_body (editor, body);
+  g_autoptr (LumaBarItem) primary = luma_bar_item_new_action ("qr-code", "Done", NULL);
+  luma_bar_item_set_primary (primary, TRUE);
+  g_signal_connect_object (primary, "activated", G_CALLBACK (share_done), v->root, 0);
+  luma_action_editor_set_primary (editor, primary);
+  luma_action_center_grow (v->center);
+}
