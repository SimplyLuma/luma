+/* These are fixture operations. They never open NetworkManager or a keyring. */
+static JsonObject *
+fixture_network (CcLumaFixture *self, const char *name)
+{
+  JsonNode *node = json_object_get_member (cc_luma_fixture_get_data (self), "CFNETS");
+  JsonArray *nets;
+  if (!node || !JSON_NODE_HOLDS_ARRAY (node) || !name || !*name) return NULL;
+  nets = json_node_get_array (node);
+  for (guint i = 0; i < json_array_get_length (nets); i++)
+    {
+      JsonNode *n = json_array_get_element (nets, i);
+      JsonNode *id;
+      if (!JSON_NODE_HOLDS_OBJECT (n)) continue;
+      id = json_object_get_member (json_node_get_object (n), "n");
+      if (id && json_node_get_value_type (id) == G_TYPE_STRING &&
+          g_str_equal (json_node_get_string (id), name)) return json_node_get_object (n);
+    }
+  return NULL;
+}
+static JsonArray *
+fixture_known (CcLumaFixture *self)
+{
+  JsonNode *n = json_object_get_member (cc_luma_fixture_get_data (self), "CFKNOWN");
+  if (!n || !JSON_NODE_HOLDS_ARRAY (n)) return NULL;
+  for (guint i = 0; i < json_array_get_length (json_node_get_array (n)); i++)
+    if (json_node_get_value_type (json_array_get_element (json_node_get_array (n), i)) != G_TYPE_STRING)
+      return NULL;
+  return json_node_get_array (n);
+}
+gboolean
+cc_luma_fixture_connect_network (CcLumaFixture *self, const char *name, GError **error)
+{
+  g_autofree char *owned_name = g_strdup (name);
+  name = owned_name;
+  JsonObject *network = fixture_network (self, name);
+  JsonArray *known = fixture_known (self);
+  JsonNode *current = cc_luma_fixture_get (self, "net");
+  gboolean saved = FALSE;
+  if (!network || !known || !current || json_node_get_value_type (current) != G_TYPE_STRING)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Unknown fixture network or invalid network data");
+      return FALSE;
+    }
+  for (guint i = 0; i < json_array_get_length (known); i++)
+    saved |= g_str_equal (json_array_get_string_element (known, i), name);
+  if (!saved) json_array_add_string_element (known, name);
+  json_object_set_boolean_member (network, "known", TRUE);
+  json_node_set_string (current, name);
+  return TRUE;
+}
+gboolean
+cc_luma_fixture_forget_network (CcLumaFixture *self, const char *name, GError **error)
+{
+  g_autofree char *owned_name = g_strdup (name);
+  name = owned_name;
+  JsonArray *known = fixture_known (self);
+  JsonObject *network = fixture_network (self, name);
+  JsonNode *current = cc_luma_fixture_get (self, "net");
+  gint index = -1;
+  if (!known || !current || json_node_get_value_type (current) != G_TYPE_STRING || !name || !*name)
+    goto invalid;
+  for (guint i = 0; i < json_array_get_length (known); i++)
+    if (g_str_equal (json_array_get_string_element (known, i), name)) { index = i; break; }
+  if (index < 0) goto invalid;
+  json_array_remove_element (known, index);
+  if (network) json_object_set_boolean_member (network, "known", FALSE);
+  if (g_str_equal (json_node_get_string (current), name)) json_node_set_string (current, "");
+  return TRUE;
+invalid:
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Unknown saved fixture network or invalid network data");
+  return FALSE;
+}
