+static void
+networks (void)
+{
+  g_autoptr (CcLumaFixture) model = cc_luma_fixture_load (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), NULL);
+  g_autoptr (CcLumaFixture) untouched = cc_luma_fixture_load (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), NULL);
+  g_autoptr (GError) error = NULL;
+  JsonArray *known = json_object_get_array_member (cc_luma_fixture_get_data (model), "CFKNOWN");
+  g_assert_false (cc_luma_fixture_connect_network (model, "invented network", &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+  g_clear_error (&error);
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "net")), ==, "Studio North");
+  g_assert_cmpuint (json_array_get_length (known), ==, 6);
+  g_assert_true (cc_luma_fixture_connect_network (model, "Priya’s phone", NULL));
+  g_assert_cmpuint (json_array_get_length (known), ==, 7);
+  g_assert_true (cc_luma_fixture_connect_network (model, "Priya’s phone", NULL));
+  g_assert_cmpuint (json_array_get_length (known), ==, 7);
+  /* Exercise a name borrowed from the array being mutated. */
+  g_assert_true (cc_luma_fixture_forget_network (model, json_array_get_string_element (known, 6), NULL));
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "net")), ==, "");
+  g_assert_cmpuint (json_array_get_length (known), ==, 6);
+  g_assert_cmpstr (json_array_get_string_element (known, 0), ==, "Studio North");
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (untouched, "net")), ==, "Studio North");
+  g_assert_cmpuint (json_array_get_length (json_object_get_array_member (cc_luma_fixture_get_data (untouched), "CFKNOWN")), ==, 6);
+  g_assert_false (cc_luma_fixture_forget_network (model, "invented network", &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
