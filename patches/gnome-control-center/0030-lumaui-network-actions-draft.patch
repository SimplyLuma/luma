+static void open_picker (GtkButton *button, View *v)
+{
+  Pick *pick = g_object_get_data (G_OBJECT (button), "cf-pick");
+  GtkWidget *menu = luma_floating_menu_new (pick->key);
+  for (guint i = 0; pick->choices[i]; i += 2)
+    {
+      g_autofree char *action = g_action_print_detailed_name ("cf.pick",
+        g_variant_new ("(ss)", pick->key, pick->choices[i]));
+      luma_floating_menu_add_item (LUMA_FLOATING_MENU (menu), pick->choices[i + 1], NULL, NULL, NULL,
+        action, g_str_equal (text (v, pick->key), pick->choices[i]));
+    }
+  luma_floating_menu_popup (LUMA_FLOATING_MENU (menu), GTK_WIDGET (button));
+}
+static GtkWidget *picker (View *v, const char *key, const char * const *choices)
+{
+  Pick *pick = g_new0 (Pick, 1);
+  GtkWidget *button, *content = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+  const char *caption = text (v, key);
+  for (guint i = 0; choices[i]; i += 2)
+    if (g_str_equal (caption, choices[i])) { caption = choices[i + 1]; break; }
+  button = gtk_button_new ();
+  gtk_box_append (GTK_BOX (content), label (caption, "body", FALSE));
+  gtk_box_append (GTK_BOX (content), luma_ui_icon_new ("chevron-down"));
+  gtk_button_set_child (GTK_BUTTON (button), content);
+  pick->key = key; pick->choices = choices;
+  g_object_set_data_full (G_OBJECT (button), "cf-pick", pick, g_free);
+  g_signal_connect (button, "clicked", G_CALLBACK (open_picker), v);
+  g_autofree char *name = g_strconcat ("cf-", key, NULL);
+  gtk_widget_set_name (button, name);
+  return button;
+}
