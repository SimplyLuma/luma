+static const char * const metered_choices[] = { "auto", "Automatic", "yes", "Yes", "no", "No", NULL };
+static const char * const band_choices[] = { "auto", "Automatic", "5", "5 GHz", "2", "2.4 GHz", NULL };
+static const char * const proxy_choices[] = { "off", "Off", "auto", "Automatic", "manual", "Manual", NULL };
+static gboolean picker_value_allowed (const char *key, const char *value)
+{
+  const char * const *choices = g_str_equal (key, "metered") ? metered_choices :
+    g_str_equal (key, "hsBand") ? band_choices : g_str_equal (key, "proxy") ? proxy_choices : NULL;
