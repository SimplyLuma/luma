+static void forget_confirmed (LumaDestructiveDialog *dialog, gboolean checked, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  const char *name = g_object_get_data (G_OBJECT (dialog), "cf-network");
+  g_autoptr (GError) error = NULL;
+  if (!cc_luma_fixture_forget_network (v->model, name, &error))
+    { luma_toast_show (v->root, error->message, "error"); return; }
+  if (g_str_equal (v->page, "wifi-net"))
+    { g_free (v->page); v->page = g_strdup ("wifi"); }
+  queue_refresh (v);
+  luma_toast_show (v->root, "Network forgotten", "deleted");
