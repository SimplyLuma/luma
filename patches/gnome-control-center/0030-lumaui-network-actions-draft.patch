+typedef struct { const char *key; const char * const *choices; } Pick;
+static gboolean picker_value_allowed (const char *key, const char *value);
+static void pick_selected (GSimpleAction *action, GVariant *parameter, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  const char *key, *value;
+  g_autoptr (JsonNode) n = json_node_new (JSON_NODE_VALUE);
+  g_autoptr (GError) error = NULL;
+  g_variant_get (parameter, "(&s&s)", &key, &value);
+  if (!picker_value_allowed (key, value)) return;
+  json_node_set_string (n, value);
+  if (cc_luma_fixture_set (v->model, key, n, &error)) queue_refresh (v);
+  else g_warning ("%s", error->message);
