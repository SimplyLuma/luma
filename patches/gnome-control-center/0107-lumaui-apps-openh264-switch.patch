From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <engineering@projectluma.org>
Date: Fri, 20 Nov 2026 18:00:00 -0600
Subject: [PATCH] lumaui: Apps › OpenH264 video codec

Apps gains Cisco's OpenH264 switch: "OpenH264 video codec", Cisco's
attribution under it, and a row that opens Cisco's binary license terms.
The setting is what `luma-openh264 status` reports; a change runs
`pkexec /usr/bin/luma-openh264 enable|disable` (allowed for the active
local session by luma-openh264's polkit rule) and reads the status again.
Without luma-openh264 the rows are left out. The Apps page does not wait
for the status.
---
diff --git a/shell/cc-luma-live-openh264.c b/shell/cc-luma-live-openh264.c
new file mode 100644
index 0000000..948257d
--- /dev/null
+++ b/shell/cc-luma-live-openh264.c
@@ -0,0 +1,135 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live OpenH264 switch (Apps): Cisco's binary, downloaded from Cisco onto
+ * this computer by luma-openh264. "h264" is the setting as
+ * `luma-openh264 status` reports it; a change runs
+ * `pkexec /usr/bin/luma-openh264 enable|disable` (polkit allows both for the
+ * active local session) and reads the status again. Without luma-openh264
+ * the key is never published and the row is left out. The Apps page does not
+ * wait for this adapter. */
+#include "cc-luma-live.h"
+#include <string.h>
+
+#define ADAPTER "openh264"
+#define TOOL "/usr/bin/luma-openh264"
+static const char * const pages[] = { NULL };
+
+typedef struct {
+  CcLumaFixture *model;
+  GCancellable *cancel;
+  gboolean ready, busy;
+} OpenH264;
+
+static void read_status (OpenH264 *s);
+
+static void
+mark_ready (OpenH264 *s)
+{
+  if (s->ready) return;
+  s->ready = TRUE;
+  cc_luma_live_ready (s->model, ADAPTER);
+}
+
+static void
+status_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autofree char *out = NULL;
+  if (!g_subprocess_communicate_utf8_finish (G_SUBPROCESS (source), result, &out, NULL, &error) &&
+      g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    return;
+  OpenH264 *s = data;
+  /* "Setting:  enabled (…)" or "Setting:  disabled (…)" */
+  const char *line = out ? strstr (out, "\nSetting:") : NULL;
+  if (line && g_subprocess_get_successful (G_SUBPROCESS (source)))
+    {
+      line += strlen ("\nSetting:");
+      while (*line == ' ') line++;
+      cc_luma_fixture_publish_boolean (s->model, "h264", g_str_has_prefix (line, "enabled"));
+    }
+  else
+    g_message ("Settings: OpenH264 status: %s", error ? error->message : "unreadable");
+  mark_ready (s);
+}
+
+static void
+read_status (OpenH264 *s)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GSubprocess) p = g_subprocess_new (G_SUBPROCESS_FLAGS_STDOUT_PIPE | G_SUBPROCESS_FLAGS_STDERR_SILENCE,
+                                                &error, TOOL, "status", NULL);
+  if (!p)
+    {
+      g_message ("Settings: OpenH264 status: %s", error->message);
+      mark_ready (s);
+      return;
+    }
+  g_subprocess_communicate_utf8_async (p, NULL, s->cancel, status_done, s);
+}
+
+static void
+change_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  gboolean waited = g_subprocess_wait_finish (G_SUBPROCESS (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  OpenH264 *s = data;
+  s->busy = FALSE;
+  /* 75: Cisco's server could not be reached; the setting is changed and the
+   * service downloads the file later. */
+  if (!waited || (g_subprocess_get_exit_status (G_SUBPROCESS (source)) != 0 &&
+                  g_subprocess_get_exit_status (G_SUBPROCESS (source)) != 75))
+    g_message ("Settings: luma-openh264: %s", error ? error->message : "failed");
+  read_status (s);
+}
+
+static gboolean
+openh264_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  OpenH264 *s = state;
+  if (!g_str_equal (key, "h264")) return FALSE;
+  if (!value || !JSON_NODE_HOLDS_VALUE (value) || json_node_get_value_type (value) != G_TYPE_BOOLEAN)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "OpenH264 is on or off");
+      return FALSE;
+    }
+  if (s->busy)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_BUSY, "OpenH264 is still changing");
+      return FALSE;
+    }
+  gboolean on = json_node_get_boolean (value);
+  g_autoptr (GSubprocess) p = g_subprocess_new (G_SUBPROCESS_FLAGS_STDOUT_SILENCE | G_SUBPROCESS_FLAGS_STDERR_SILENCE,
+                                                error, "pkexec", TOOL, on ? "enable" : "disable", NULL);
+  if (!p) return FALSE;
+  s->busy = TRUE;
+  cc_luma_fixture_publish_boolean (s->model, "h264", on);
+  g_subprocess_wait_async (p, s->cancel, change_done, s);
+  return TRUE;
+}
+
+static gpointer
+openh264_start (CcLumaFixture *model)
+{
+  OpenH264 *s = g_new0 (OpenH264, 1);
+  s->model = model;
+  s->cancel = g_cancellable_new ();
+  if (!g_file_test (TOOL, G_FILE_TEST_IS_EXECUTABLE))
+    {
+      mark_ready (s);
+      return s;
+    }
+  cc_luma_fixture_own_key (model, "h264");
+  read_status (s);
+  return s;
+}
+
+static void
+openh264_stop (gpointer state)
+{
+  OpenH264 *s = state;
+  g_cancellable_cancel (s->cancel);
+  g_clear_object (&s->cancel);
+  g_free (s);
+}
+
+const CcLumaAdapter cc_luma_adapter_openh264 = { ADAPTER, pages, openh264_start, openh264_write, openh264_stop };
