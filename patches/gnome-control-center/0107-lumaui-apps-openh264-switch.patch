-extern const CcLumaAdapter cc_luma_adapter_apps, cc_luma_adapter_appoptions, cc_luma_adapter_tv, cc_luma_adapter_tv_account;
+extern const CcLumaAdapter cc_luma_adapter_apps, cc_luma_adapter_appoptions, cc_luma_adapter_tv, cc_luma_adapter_tv_account,
+  cc_luma_adapter_openh264;
 static const CcLumaAdapter *adapters[] = {
   &cc_luma_adapter_network, &cc_luma_adapter_airplane, &cc_luma_adapter_proxy,
   /* Bluetooth reads BlueZ over D-Bus: no second BluetoothClient beside the panel's. */
@@ -36,6 +37,8 @@ static const CcLumaAdapter *adapters[] = {
   &cc_luma_adapter_home, &cc_luma_adapter_shelf, &cc_luma_adapter_windows, &cc_luma_adapter_notifications, &cc_luma_adapter_search,
   &cc_luma_adapter_printers,
   &cc_luma_adapter_apps, &cc_luma_adapter_appoptions,
+  /* Cisco's OpenH264 on or off (luma-openh264): one switch in Apps. */
+  &cc_luma_adapter_openh264,
   &cc_luma_adapter_tv, &cc_luma_adapter_tv_account,
   NULL
 };
@@ -206,6 +209,10 @@ cc_luma_live_model_new (GError **error)
   /* Which display the rows show is the page's own choice (VM run
    * 20260930T214237-dp3-writes: a tile click stays on this page). */
   cc_luma_fixture_verify_key (model, "dsel");
+  /* OpenH264 off and on through pkexec luma-openh264 (VM 20 Nov, run
+   * 20261120T1537-openh264-settings, Settings in the session): Cisco's file
+   * removed and downloaded again, kept on reopening. */
+  cc_luma_fixture_verify_key (model, "h264");
   /* Join and mirror with two displays: Mirror then Revert Settings goes back
    * (VM run 20260930T230328-dp13-heads2-mirror), Mirror kept and kept on
    * reopening (20260930T230745-dp15-heads2-mirror-keep), Join from mirror
diff --git a/shell/cc-luma-view-application-options.c b/shell/cc-luma-view-application-options.c
index ea5fbbb..f93bb71 100644
--- a/shell/cc-luma-view-application-options.c
+++ b/shell/cc-luma-view-application-options.c
@@ -497,6 +497,27 @@ cc_luma_view_apps_row_widgets (GtkWidget *root)
   return r ? r->rows->len : 0;
 }
 
+/* Cisco's binary terms: its attribution and an on/off control where the
+ * person manages it, with the terms one click away. Shown while
+ * luma-openh264 reports the setting (cc-luma-live-openh264.c). */
+#define OPENH264_TERMS "https://www.openh264.org/BINARY_LICENSE.txt"
+static void openh264_terms (GtkButton *button, View *v G_GNUC_UNUSED)
+{
+  g_autoptr (GtkUriLauncher) launcher = gtk_uri_launcher_new (OPENH264_TERMS);
+  gtk_uri_launcher_launch (launcher, GTK_WINDOW (gtk_widget_get_root (GTK_WIDGET (button))), NULL, NULL, NULL);
+}
+static void openh264_rows (View *v)
+{
+  JsonNode *on = cc_luma_fixture_get (v->model, "h264");
+  if (!on || !JSON_NODE_HOLDS_VALUE (on)) return;
+  GtkBox *rows = cf_group (v, NULL, NULL);
+  cf_sw (v, rows, "h264", "OpenH264 video codec", "OpenH264 Video Codec provided by Cisco Systems, Inc.", cf_lead_icon ("film"));
+  GtkWidget *terms = cf_row (rows, cf_lead_icon ("file-text"), "Cisco’s license terms", NULL,
+                             luma_ui_icon_new ("square-arrow-out-up-right"), TRUE);
+  gtk_widget_set_tooltip_text (terms, OPENH264_TERMS);
+  g_signal_connect (terms, "clicked", G_CALLBACK (openh264_terms), v);
+}
+
 static void apps_render (View *v);
 static guint perf_renders;
 static gint64 perf_render_us;
@@ -527,6 +548,7 @@ static void apps_render (View *v)
   GtkBox *rows = cf_group (v, NULL, NULL);
   cf_nv (v, rows, "defaults", "Default apps", "Which app opens links, mail, music and photos", NULL, cf_lead_icon ("app-window"));
   cf_nv (v, rows, "media", "Removable media", "What happens when you plug in a drive or phone", NULL, cf_lead_icon ("usb"));
+  openh264_rows (v);
   JsonNode *category_node = json_object_get_member (data, "CFAPPCATS");
   JsonObject *categories = category_node && JSON_NODE_HOLDS_OBJECT (category_node) ? json_node_get_object (category_node) : NULL;
   if (json_array_get_length (apps) >= RECYCLE_FROM)
