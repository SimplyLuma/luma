diff --git a/shell/cc-luma-fixture.c b/shell/cc-luma-fixture.c
index 058c4a1..6c42fa9 100644
--- a/shell/cc-luma-fixture.c
+++ b/shell/cc-luma-fixture.c
@@ -143,6 +143,37 @@ cc_luma_fixture_set (CcLumaFixture *self, const char *key, JsonNode *value, GErr
   json_object_set_member (object, leaf, json_node_copy (value));
   return TRUE;
 }
+/* Radio dependencies follow v70 cfFx: airplane-on disables Wi-Fi and
+ * Bluetooth; enabling either radio clears airplane mode. Turning airplane
+ * off does not silently turn radios back on. Validate all keys first. */
+gboolean
+cc_luma_fixture_set_flag (CcLumaFixture *self, const char *key, gboolean value, GError **error)
+{
+  const char *keys[3] = { key, NULL, NULL };
+  gboolean values[3] = { value, FALSE, FALSE };
+  guint count = 1;
+  if (g_strcmp0 (key, "airplane") == 0 && value)
+    { keys[1] = "wifi"; keys[2] = "bt"; count = 3; }
+  else if ((g_strcmp0 (key, "wifi") == 0 || g_strcmp0 (key, "bt") == 0) && value)
+    { keys[1] = "airplane"; count = 2; }
+  for (guint i = 0; i < count; i++)
+    {
+      JsonNode *n = cc_luma_fixture_get (self, keys[i]);
+      if (!n || json_node_get_value_type (n) != G_TYPE_BOOLEAN)
+        {
+          g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                       "Unknown or non-boolean setting: %s", keys[i] ? keys[i] : "(null)");
+          return FALSE;
+        }
+    }
+  for (guint i = 0; i < count; i++)
+    {
+      g_autoptr (JsonNode) n = json_node_new (JSON_NODE_VALUE);
+      json_node_set_boolean (n, values[i]);
+      if (!cc_luma_fixture_set (self, keys[i], n, error)) return FALSE;
+    }
+  return TRUE;
+}
 JsonObject *
 cc_luma_fixture_get_data (CcLumaFixture *self)
 {
