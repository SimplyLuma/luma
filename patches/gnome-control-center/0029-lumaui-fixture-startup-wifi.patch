diff --git a/shell/test-luma-view.c b/shell/test-luma-view.c
new file mode 100644
index 0000000..4b8052e
--- /dev/null
+++ b/shell/test-luma-view.c
@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view.h"
+#include <string.h>
+
+static GtkWidget *find_name (GtkWidget *root, const char *name)
+{
+  if (g_str_equal (gtk_widget_get_name (root), name)) return root;
+  for (GtkWidget *w = gtk_widget_get_first_child (root); w; w = gtk_widget_get_next_sibling (w))
+    {
+      GtkWidget *found = find_name (w, name);
+      if (found) return found;
+    }
+  return NULL;
+}
+static gboolean has_text (GtkWidget *root, const char *text)
+{
+  if (GTK_IS_LABEL (root) && g_str_equal (gtk_label_get_text (GTK_LABEL (root)), text)) return TRUE;
+  for (GtkWidget *w = gtk_widget_get_first_child (root); w; w = gtk_widget_get_next_sibling (w))
+    if (has_text (w, text)) return TRUE;
+  return FALSE;
+}
+static CcLumaFixture *load (void)
+{
+  g_autoptr (GError) error = NULL;
+  CcLumaFixture *model = cc_luma_fixture_load (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (model);
+  return model;
+}
+static void radio_bindings (void)
+{
+  g_autoptr (CcLumaFixture) first = load ();
+  g_autoptr (CcLumaFixture) second = load ();
+  g_autoptr (GError) error = NULL;
+  GtkWidget *view = g_object_ref_sink (cc_luma_view_new (first, "wifi", &error));
+  GtkWidget *airplane;
+  g_assert_no_error (error);
+  g_assert_true (has_text (view, "Connected to Studio North"));
+  g_assert_true (has_text (view, "Studio North Guest"));
+  airplane = find_name (view, "cf-airplane");
+  g_assert_true (GTK_IS_SWITCH (airplane));
+  gtk_switch_set_active (GTK_SWITCH (airplane), TRUE);
+  while (g_main_context_iteration (NULL, FALSE)) {}
+  g_assert_true (json_node_get_boolean (cc_luma_fixture_get (first, "airplane")));
+  g_assert_false (json_node_get_boolean (cc_luma_fixture_get (first, "wifi")));
+  g_assert_false (json_node_get_boolean (cc_luma_fixture_get (first, "bt")));
+  g_assert_true (has_text (view, "Wi‑Fi is off"));
+  g_assert_false (has_text (view, "Nearby"));
+  g_assert_true (json_node_get_boolean (cc_luma_fixture_get (second, "wifi")));
+  g_assert_false (json_node_get_boolean (cc_luma_fixture_get (second, "airplane")));
+  /* Disabling airplane mode must not implicitly enable either radio. */
+  gtk_switch_set_active (GTK_SWITCH (find_name (view, "cf-airplane")), FALSE);
+  while (g_main_context_iteration (NULL, FALSE)) {}
+  g_assert_false (json_node_get_boolean (cc_luma_fixture_get (first, "wifi")));
+  /* Re-enable Wi-Fi; this does not re-enable Bluetooth. */
+  gtk_switch_set_active (GTK_SWITCH (find_name (view, "cf-wifi")), TRUE);
+  while (g_main_context_iteration (NULL, FALSE)) {}
+  g_assert_true (has_text (view, "Nearby"));
+  g_assert_false (json_node_get_boolean (cc_luma_fixture_get (first, "bt")));
+  g_object_unref (view);
+}
+static void reject_unported (void)
+{
+  g_autoptr (CcLumaFixture) model = load ();
+  g_autoptr (GError) error = NULL;
+  g_assert_null (cc_luma_view_new (model, "about", &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED);
+}
+static void cancel_pending_refresh (void)
+{
+  g_autoptr (CcLumaFixture) model = load ();
+  GtkWidget *view = g_object_ref_sink (cc_luma_view_new (model, "wifi", NULL));
+  gtk_switch_set_active (GTK_SWITCH (find_name (view, "cf-airplane")), TRUE);
+  g_object_unref (view);
+  while (g_main_context_iteration (NULL, FALSE)) {}
+}
+int main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  gtk_init ();
+  g_test_add_func ("/settings/view/radio-bindings", radio_bindings);
+  g_test_add_func ("/settings/view/reject-unported", reject_unported);
+  g_test_add_func ("/settings/view/cancel-pending-refresh", cancel_pending_refresh);
+  return g_test_run ();
+}
