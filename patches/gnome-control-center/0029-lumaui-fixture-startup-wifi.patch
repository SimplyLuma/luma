 shell/cc-luma-fixture.c                     |  31 ++
 shell/cc-luma-fixture.h                     |   2 +
 shell/cc-luma-view.c                        | 325 ++++++++++++++++++++
 shell/cc-luma-view.h                        |   8 +
 shell/gnome-control-center.gresource.xml.in |   1 +
 shell/luma-settings.css                     |   2 +
 shell/main.c                                |   6 +
 shell/meson.build                           |  12 +-
 shell/test-luma-view.c                      |  85 +++++
 10 files changed, 552 insertions(+), 5 deletions(-)
 create mode 100644 shell/cc-luma-view.c
 create mode 100644 shell/cc-luma-view.h
 create mode 100644 shell/luma-settings.css
 create mode 100644 shell/test-luma-view.c

