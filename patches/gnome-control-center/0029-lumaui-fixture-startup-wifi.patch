diff --git a/shell/cc-luma-view.c b/shell/cc-luma-view.c
new file mode 100644
index 0000000..87352b0
--- /dev/null
+++ b/shell/cc-luma-view.c
@@ -0,0 +1,325 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view.h"
+#include <luma-ui.h>
+#include <string.h>
+
+typedef struct {
+  CcLumaFixture *model;
+  GtkBox *body;
+  char *page;
+  guint refresh;
+} View;
+
+static void render (View *view);
+static gboolean refresh_view (gpointer data)
+{
+  View *v = data;
+  v->refresh = 0;
+  render (v);
+  return G_SOURCE_REMOVE;
+}
+
+static const char *text (View *v, const char *key)
+{
+  JsonNode *n = cc_luma_fixture_get (v->model, key);
+  return n && json_node_get_value_type (n) == G_TYPE_STRING ? json_node_get_string (n) : "";
+}
+static gboolean flag (View *v, const char *key)
+{
+  JsonNode *n = cc_luma_fixture_get (v->model, key);
+  return n && json_node_get_value_type (n) == G_TYPE_BOOLEAN && json_node_get_boolean (n);
+}
+static GtkWidget *label (const char *value, const char *role, gboolean muted)
+{
+  GtkWidget *w = gtk_label_new (value);
+  gtk_label_set_xalign (GTK_LABEL (w), 0);
+  gtk_label_set_wrap (GTK_LABEL (w), TRUE);
+  luma_ui_apply_type_full (w, role, muted);
+  return w;
+}
+static GtkWidget *words (const char *title, const char *subtitle)
+{
+  GtkWidget *box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+  gtk_widget_set_hexpand (box, TRUE);
+  gtk_box_append (GTK_BOX (box), label (title, "body", FALSE));
+  if (subtitle && *subtitle)
+    gtk_box_append (GTK_BOX (box), label (subtitle, "caption", TRUE));
+  return box;
+}
+static GtkBox *group (View *v, const char *title)
+{
+  GtkWidget *rows = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  GtkWidget *card = luma_card_new (rows, FALSE);
+  gtk_widget_set_margin_top (card, title ? 8 : 26);
+  if (title)
+    {
+      GtkWidget *heading = label (title, "label", TRUE);
+      gtk_widget_set_margin_top (heading, 26);
+      gtk_box_append (v->body, heading);
+    }
+  gtk_box_append (v->body, card);
+  return GTK_BOX (rows);
+}
+static GtkWidget *row (GtkBox *rows, const char *title, const char *subtitle, GtkWidget *trail)
+{
+  GtkWidget *r = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+  gtk_widget_add_css_class (r, "cf-setting-row");
+  gtk_box_append (GTK_BOX (r), words (title, subtitle));
+  if (trail)
+    gtk_box_append (GTK_BOX (r), trail);
+  gtk_box_append (rows, r);
+  return r;
+}
+static void navigate (GtkButton *button, View *v)
+{
+  const char *target = g_object_get_data (G_OBJECT (button), "cf-target");
+  g_free (v->page);
+  v->page = g_strdup (target);
+  render (v);
+}
+static GtkWidget *link_button (View *v, const char *caption, const char *target)
+{
+  GtkWidget *button = gtk_button_new_with_label (caption);
+  g_object_set_data_full (G_OBJECT (button), "cf-target", g_strdup (target), g_free);
+  g_signal_connect (button, "clicked", G_CALLBACK (navigate), v);
+  return button;
+}
+static void switch_changed (GtkSwitch *widget, GParamSpec *pspec, View *v)
+{
+  const char *key = g_object_get_data (G_OBJECT (widget), "cf-key");
+  g_autoptr (GError) error = NULL;
+  if (!cc_luma_fixture_set_flag (v->model, key, gtk_switch_get_active (widget), &error))
+    g_warning ("%s", error->message);
+  /* Avoid destroying the emitting widget inside its notification. */
+  if (!v->refresh)
+    v->refresh = g_idle_add (refresh_view, v);
+}
+static GtkWidget *toggle (View *v, const char *key, const char *name, const char *accessible)
+{
+  GtkWidget *w = gtk_switch_new ();
+  gtk_widget_set_valign (w, GTK_ALIGN_CENTER);
+  gtk_widget_set_name (w, name);
+  gtk_switch_set_active (GTK_SWITCH (w), flag (v, key));
+  g_object_set_data_full (G_OBJECT (w), "cf-key", g_strdup (key), g_free);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (w), GTK_ACCESSIBLE_PROPERTY_LABEL, accessible, -1);
+  g_signal_connect (w, "notify::active", G_CALLBACK (switch_changed), v);
+  return w;
+}
+static void header (View *v, const char *title, const char *subtitle, const char *switch_key)
+{
+  GtkWidget *head = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 16);
+  GtkWidget *titles = gtk_box_new (GTK_ORIENTATION_VERTICAL, 3);
+  gtk_widget_set_hexpand (titles, TRUE);
+  gtk_box_append (GTK_BOX (titles), label (title, "title-1", FALSE));
+  gtk_box_append (GTK_BOX (titles), label (subtitle, "caption", TRUE));
+  gtk_box_append (GTK_BOX (head), titles);
+  if (switch_key)
+    gtk_box_append (GTK_BOX (head), toggle (v, switch_key, g_str_equal (switch_key, "wifi") ? "cf-wifi" : "cf-hotspot", title));
+  gtk_box_append (v->body, head);
+}
+static void wifi (View *v)
+{
+  gboolean enabled = flag (v, "wifi");
+  const char *network = text (v, "net");
+  g_autofree char *meta = !enabled ? g_strdup ("Wi‑Fi is off") :
+    *network ? g_strdup_printf ("Connected to %s", network) : g_strdup ("6 networks nearby");
+  GtkWidget *hero, *hero_body;
+  JsonArray *nets = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFNETS");
+  JsonArray *known = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFKNOWN");
+  header (v, "Wi‑Fi", meta, "wifi");
+  hero_body = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 16);
+  gtk_box_append (GTK_BOX (hero_body), luma_ui_icon_new ("wifi"));
+  if (!enabled)
+    gtk_box_append (GTK_BOX (hero_body), words ("Wi‑Fi is off", NULL));
+  else if (!*network)
+    gtk_box_append (GTK_BOX (hero_body), words ("Not connected", "Pick a network below"));
+  else
+    {
+      JsonObject *current = NULL;
+      const char *signals[] = { "Weak", "Fair", "Good", "Excellent" };
+      for (guint i = 0; i < json_array_get_length (nets); i++)
+        {
+          JsonObject *n = json_array_get_object_element (nets, i);
+          if (g_str_equal (json_object_get_string_member (n, "n"), network))
+            current = n;
+        }
+      if (current)
+        {
+          gint signal = CLAMP (json_object_get_int_member (current, "sig"), 1, 4);
+          g_autofree char *detail = g_strdup_printf ("%s signal · %s · %s", signals[signal - 1],
+            json_object_get_boolean_member (current, "lock") ? "Secured" : "Open",
+            g_str_equal (text (v, "metered"), "yes") ? "Metered" : "Unlimited data");
+          gtk_box_append (GTK_BOX (hero_body), words (network, detail));
+          gtk_box_append (GTK_BOX (hero_body), link_button (v, "Details", "wifi-net"));
+        }
+      else
+        gtk_box_append (GTK_BOX (hero_body), words ("Not connected", "Pick a network below"));
+    }
+  hero = luma_card_new (hero_body, TRUE);
+  luma_card_set_recessed (LUMA_CARD (hero), TRUE);
+  gtk_widget_set_margin_top (hero, 20);
+  gtk_widget_set_name (hero, "cf-wifi-current");
+  gtk_box_append (v->body, hero);
+  if (enabled)
+    {
+      GtkBox *near = group (v, "Nearby");
+      for (guint i = 0; i < json_array_get_length (nets); i++)
+        {
+          JsonObject *n = json_array_get_object_element (nets, i);
+          const char *name = json_object_get_string_member (n, "n");
+          if (!g_str_equal (name, network))
+            row (near, name,
+              json_object_has_member (n, "known") && json_object_get_boolean_member (n, "known") ? "Saved" : NULL,
+              json_object_get_boolean_member (n, "lock") ? luma_ui_icon_new ("lock") : NULL);
+        }
+      row (near, "Hidden network", "Join a network that doesn’t show its name", NULL);
+    }
+  {
+    GtkBox *more = group (v, "More");
+    g_autofree char *count = g_strdup_printf ("%u", json_array_get_length (known));
+    row (more, "Known networks", "Networks this computer joins on its own", link_button (v, count, "wifi-known"));
+    row (more, "Hotspot", "Share this computer’s connection", link_button (v, flag (v, "hotspot") ? "On" : "Off", "hotspot"));
+    row (more, "Airplane mode", "Turns off Wi‑Fi, Bluetooth and mobile data", toggle (v, "airplane", "cf-airplane", "Airplane mode"));
+  }
+}
+static void wifi_details (View *v)
+{
+  GtkBox *settings, *connection, *addresses;
+  gtk_box_append (v->body, link_button (v, "Wi‑Fi", "wifi"));
+  header (v, *text (v, "net") ? text (v, "net") : "Network", "Connected · WPA3 · 5 GHz", NULL);
+  settings = group (v, NULL);
+  row (settings, "Join automatically", NULL, toggle (v, "autoJoin", "cf-auto-join", "Join automatically"));
+  row (settings, "Available to everyone on this computer", NULL, toggle (v, "allUsers", "cf-all-users", "Available to everyone on this computer"));
+  row (settings, "Metered", "Luma holds back big downloads on metered networks", label (text (v, "metered"), "body", TRUE));
+  connection = group (v, "Connection");
+  row (connection, "Signal", NULL, label ("Excellent", "body", TRUE));
+  row (connection, "Speed", NULL, label ("1.2 Gb/s", "body", TRUE));
+  row (connection, "Security", NULL, label ("WPA3", "body", TRUE));
+  row (connection, "Band", NULL, label ("5 GHz, channel 149", "body", TRUE));
+  addresses = group (v, "Addresses");
+  row (addresses, "IPv4", NULL, label ("192.168.10.24", "numeric", TRUE));
+  row (addresses, "IPv6", NULL, label ("fe80::9a3b:2cff:fe41:7d10", "numeric", TRUE));
+  row (addresses, "Router", NULL, label ("192.168.10.1", "numeric", TRUE));
+  row (addresses, "DNS", NULL, label ("Automatic", "body", TRUE));
+}
+static void known_networks (View *v)
+{
+  JsonArray *known = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFKNOWN");
+  JsonArray *nets = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFNETS");
+  g_autofree char *meta = g_strdup_printf ("%u networks", json_array_get_length (known));
+  GtkBox *rows;
+  gtk_box_append (v->body, link_button (v, "Wi‑Fi", "wifi"));
+  header (v, "Known networks", meta, NULL);
+  rows = group (v, NULL);
+  for (guint i = 0; i < json_array_get_length (known); i++)
+    {
+      const char *name = json_array_get_string_element (known, i);
+      gboolean nearby = FALSE;
+      for (guint j = 0; j < json_array_get_length (nets); j++)
+        nearby |= g_str_equal (name, json_object_get_string_member (json_array_get_object_element (nets, j), "n"));
+      row (rows, name, g_str_equal (name, text (v, "net")) ? "Connected" : nearby ? "In range" : "Not nearby", NULL);
+    }
+}
+static void hotspot (View *v)
+{
+  GtkBox *rows;
+  gtk_box_append (v->body, link_button (v, "Wi‑Fi", "wifi"));
+  header (v, "Hotspot", flag (v, "hotspot") ? "Other devices can join this computer" : "Off", "hotspot");
+  rows = group (v, NULL);
+  row (rows, "Network name", NULL, label (text (v, "hsName"), "body", FALSE));
+  row (rows, "Password", NULL, label (text (v, "hsPass"), "numeric", FALSE));
+  row (rows, "Band", NULL, label ("Automatic", "body", TRUE));
+}
+static void render (View *v)
+{
+  GtkWidget *child;
+  while ((child = gtk_widget_get_first_child (GTK_WIDGET (v->body))))
+    gtk_box_remove (v->body, child);
+  if (g_str_equal (v->page, "wifi")) wifi (v);
+  else if (g_str_equal (v->page, "wifi-net")) wifi_details (v);
+  else if (g_str_equal (v->page, "wifi-known")) known_networks (v);
+  else if (g_str_equal (v->page, "hotspot")) hotspot (v);
+}
+static void view_free (View *v)
+{
+  if (v->refresh)
+    g_source_remove (v->refresh);
+  g_object_unref (v->model);
+  g_free (v->page);
+  g_free (v);
+}
+static gboolean valid_wifi_model (CcLumaFixture *model)
+{
+  const char *booleans[] = { "wifi", "bt", "airplane", "hotspot", "autoJoin", "allUsers" };
+  const char *strings[] = { "net", "metered", "hsName", "hsPass" };
+  JsonObject *data = cc_luma_fixture_get_data (model);
+  JsonNode *nets = json_object_get_member (data, "CFNETS");
+  JsonNode *known = json_object_get_member (data, "CFKNOWN");
+  if (!nets || !JSON_NODE_HOLDS_ARRAY (nets) || !known || !JSON_NODE_HOLDS_ARRAY (known))
+    return FALSE;
+  for (guint i = 0; i < G_N_ELEMENTS (booleans); i++)
+    {
+      JsonNode *n = cc_luma_fixture_get (model, booleans[i]);
+      if (!n || json_node_get_value_type (n) != G_TYPE_BOOLEAN) return FALSE;
+    }
+  for (guint i = 0; i < G_N_ELEMENTS (strings); i++)
+    {
+      JsonNode *n = cc_luma_fixture_get (model, strings[i]);
+      if (!n || json_node_get_value_type (n) != G_TYPE_STRING) return FALSE;
+    }
+  for (guint i = 0; i < json_array_get_length (json_node_get_array (nets)); i++)
+    {
+      JsonNode *n = json_array_get_element (json_node_get_array (nets), i);
+      JsonObject *o;
+      JsonNode *name, *sig, *lock, *saved;
+      if (!JSON_NODE_HOLDS_OBJECT (n)) return FALSE;
+      o = json_node_get_object (n);
+      name = json_object_get_member (o, "n"); sig = json_object_get_member (o, "sig");
+      lock = json_object_get_member (o, "lock"); saved = json_object_get_member (o, "known");
+      if (!name || json_node_get_value_type (name) != G_TYPE_STRING ||
+          !sig || json_node_get_value_type (sig) != G_TYPE_INT64 ||
+          json_node_get_int (sig) < 1 || json_node_get_int (sig) > 4 ||
+          !lock || json_node_get_value_type (lock) != G_TYPE_BOOLEAN ||
+          (saved && json_node_get_value_type (saved) != G_TYPE_BOOLEAN)) return FALSE;
+    }
+  for (guint i = 0; i < json_array_get_length (json_node_get_array (known)); i++)
+    if (json_node_get_value_type (json_array_get_element (json_node_get_array (known), i)) != G_TYPE_STRING)
+      return FALSE;
+  return TRUE;
+}
+GtkWidget *cc_luma_view_new (CcLumaFixture *model, const char *page, GError **error)
+{
+  GtkWidget *scroll, *clamp;
+  View *v;
+  if (!page) page = "wifi";
+  if (!g_str_equal (page, "wifi") && !g_str_equal (page, "wifi-net") &&
+      !g_str_equal (page, "wifi-known") && !g_str_equal (page, "hotspot"))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Settings page is not ported yet: %s", page);
+      return NULL;
+    }
+  if (!valid_wifi_model (model))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Settings fixture contains invalid Wi-Fi data");
+      return NULL;
+    }
+  v = g_new0 (View, 1);
+  v->model = g_object_ref (model);
+  v->page = g_strdup (page);
+  v->body = GTK_BOX (gtk_box_new (GTK_ORIENTATION_VERTICAL, 0));
+  gtk_widget_set_name (GTK_WIDGET (v->body), "cf-page");
+  gtk_widget_set_margin_start (GTK_WIDGET (v->body), 32);
+  gtk_widget_set_margin_end (GTK_WIDGET (v->body), 32);
+  gtk_widget_set_margin_top (GTK_WIDGET (v->body), 30);
+  gtk_widget_set_margin_bottom (GTK_WIDGET (v->body), 120);
+  clamp = adw_clamp_new ();
+  adw_clamp_set_maximum_size (ADW_CLAMP (clamp), 680);
+  adw_clamp_set_child (ADW_CLAMP (clamp), GTK_WIDGET (v->body));
+  scroll = gtk_scrolled_window_new ();
+  gtk_widget_set_name (scroll, "cf-body");
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scroll), GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_scrolled_window_set_child (GTK_SCROLLED_WINDOW (scroll), clamp);
+  g_object_set_data_full (G_OBJECT (scroll), "cf-view", v, (GDestroyNotify) view_free);
+  render (v);
+  return scroll;
+}
