+typedef struct { gboolean done, success; GError *error; } EditSeen;
+static void edit_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  EditSeen *seen = data;
+  seen->success = cc_luma_preferences_set_finish (CC_LUMA_PREFERENCES (source), result, &seen->error);
+  seen->done = TRUE;
+}
+static void wait_edit (EditSeen *seen)
+{
+  gint64 deadline = g_get_monotonic_time () + 5000000;
+  while (!seen->done && g_get_monotonic_time () < deadline) { drain (); g_usleep (1000); }
+  g_assert_true (seen->done);
+}
+static GSettings *private_settings (const char *schema_id, const char *path, GSettingsBackend *backend)
+{
+  g_autoptr(GSettingsSchema) schema = g_settings_schema_source_lookup (g_settings_schema_source_get_default (), schema_id, TRUE);
+  g_assert_nonnull (schema);
+  return g_settings_new_full (schema, backend, path);
+}
+static char *backup_path (const char *directory, const char *schema, const char *path, const char *key)
+{
+  g_autofree char *identity = g_strjoin ("/", schema, path, key, NULL);
+  g_autofree char *digest = g_compute_checksum_for_string (G_CHECKSUM_SHA256, identity, -1);
+  g_autofree char *name = g_strconcat (digest, ".variant", NULL);
+  return g_build_filename (directory, name, NULL);
+}
+static void remove_backups (const char *directory)
+{
+  g_autoptr(GDir) entries = g_dir_open (directory, 0, NULL);
+  const char *name;
+  while (entries && (name = g_dir_read_name (entries))) {
+    g_autofree char *path = g_build_filename (directory, name, NULL);
+    g_assert_cmpint (g_remove (path), ==, 0);
+  }
+  g_clear_pointer (&entries, g_dir_close);
+  g_assert_cmpint (g_rmdir (directory), ==, 0);
+}
+static void scoped_write (void)
+{
+  g_autoptr(GSettingsBackend) backend = g_memory_settings_backend_new ();
+  g_autoptr(GSettings) settings = private_settings (SCHEMA, NULL, backend);
+  const char * const keys[] = { "enabled", "speed", NULL };
+  g_autoptr(CcLumaPreferences) self = cc_luma_preferences_new (settings, keys, NULL);
+  g_autofree char *directory = g_dir_make_tmp ("settings-preference-backup-XXXXXX", NULL);
+  g_assert_nonnull (directory);
+  g_autoptr(GVariant) value = g_variant_ref_sink (g_variant_new_boolean (FALSE));
+  EditSeen seen = { 0 };
+  cc_luma_preferences_set_async (self, "enabled", value, directory, NULL, edit_done, &seen);
+  g_assert_false (seen.done);
+  g_assert_true (g_settings_set_string (settings, "unrelated", "external edit survives"));
+  wait_edit (&seen); g_assert_true (seen.success); g_assert_no_error (seen.error);
+  g_assert_false (g_settings_get_boolean (settings, "enabled"));
+  g_autofree char *text = g_settings_get_string (settings, "unrelated");
+  g_assert_cmpstr (text, ==, "external edit survives");
+  gboolean delayed = TRUE; g_object_get (settings, "delay-apply", &delayed, NULL); g_assert_false (delayed);
+  g_autofree char *path = backup_path (directory, SCHEMA, "/org/project_luma/settings-preferences-test/", "enabled");
+  GStatBuf file_info; g_assert_cmpint (g_stat (path, &file_info), ==, 0); g_assert_cmpuint (file_info.st_mode & 0777, ==, 0600);
+  g_autofree char *original_text = NULL; g_assert_true (g_file_get_contents (path, &original_text, NULL, NULL));
+  g_autoptr(GVariant) original = g_variant_parse (G_VARIANT_TYPE ("(sssvmv)"), original_text, NULL, NULL, NULL);
+  g_assert_nonnull (original);
+  g_autoptr(GVariant) boxed = g_variant_get_child_value (original, 3);
+  g_autoptr(GVariant) old_value = g_variant_get_variant (boxed); g_assert_true (g_variant_get_boolean (old_value));
+  g_autoptr(GVariant) optional = g_variant_get_child_value (original, 4); g_assert_cmpuint (g_variant_n_children (optional), ==, 0);
+  seen = (EditSeen) { 0 }; cc_luma_preferences_set_async (self, "enabled", NULL, directory, NULL, edit_done, &seen);
+  wait_edit (&seen); g_assert_true (seen.success); g_assert_no_error (seen.error);
+  g_assert_true (g_settings_get_boolean (settings, "enabled"));
+  g_assert_null (g_settings_get_user_value (settings, "enabled"));
+  g_autofree char *after = NULL; g_assert_true (g_file_get_contents (path, &after, NULL, NULL));
+  g_assert_cmpstr (after, ==, original_text);
+  remove_backups (directory);
+}
+static void edit_boundaries (void)
+{
+  g_autoptr(GSettingsBackend) backend = g_memory_settings_backend_new ();
+  g_autoptr(GSettings) settings = private_settings (SCHEMA, NULL, backend);
+  const char * const keys[] = { "enabled", "speed", NULL };
+  g_autoptr(CcLumaPreferences) self = cc_luma_preferences_new (settings, keys, NULL);
+  g_autofree char *directory = g_dir_make_tmp ("settings-preference-refusal-XXXXXX", NULL);
+  const char *forbidden[] = { "unrelated", "missing", NULL };
+  for (guint i = 0; i < G_N_ELEMENTS (forbidden); i++) {
+    EditSeen seen = { 0 }; g_autoptr(GVariant) value = g_variant_ref_sink (g_variant_new_boolean (FALSE));
+    cc_luma_preferences_set_async (self, forbidden[i], value, directory, NULL, edit_done, &seen);
+    wait_edit (&seen); g_assert_false (seen.success); g_assert_error (seen.error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED);
+    g_clear_error (&seen.error);
+  }
+  const double invalid_numbers[] = { -2, 2, NAN, INFINITY, -INFINITY };
+  for (guint i = 0; i < G_N_ELEMENTS (invalid_numbers); i++) {
+    EditSeen seen = { 0 }; g_autoptr(GVariant) value = g_variant_ref_sink (g_variant_new_double (invalid_numbers[i]));
+    cc_luma_preferences_set_async (self, "speed", value, directory, NULL, edit_done, &seen);
+    wait_edit (&seen); g_assert_false (seen.success); g_assert_error (seen.error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+    g_clear_error (&seen.error); g_assert_cmpfloat (g_settings_get_double (settings, "speed"), ==, 0.2);
+  }
+  EditSeen seen = { 0 }; g_autoptr(GVariant) wrong = g_variant_ref_sink (g_variant_new_string ("wrong type"));
+  cc_luma_preferences_set_async (self, "enabled", wrong, directory, NULL, edit_done, &seen);
+  wait_edit (&seen); g_assert_false (seen.success); g_assert_error (seen.error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT); g_clear_error (&seen.error);
+  g_autoptr(GVariant) value = g_variant_ref_sink (g_variant_new_boolean (FALSE));
+  g_autoptr(GCancellable) cancel = g_cancellable_new (); g_cancellable_cancel (cancel);
+  seen = (EditSeen) { 0 }; cc_luma_preferences_set_async (self, "enabled", value, directory, cancel, edit_done, &seen);
+  wait_edit (&seen); g_assert_false (seen.success); g_assert_error (seen.error, G_IO_ERROR, G_IO_ERROR_CANCELLED); g_clear_error (&seen.error);
+  g_assert_true (g_settings_get_boolean (settings, "enabled"));
+  g_setenv ("LUMA_SETTINGS_FIXTURE", "", TRUE);
+  seen = (EditSeen) { 0 }; cc_luma_preferences_set_async (self, "enabled", value, directory, NULL, edit_done, &seen);
+  wait_edit (&seen); g_assert_false (seen.success); g_assert_error (seen.error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED); g_clear_error (&seen.error);
+  g_unsetenv ("LUMA_SETTINGS_FIXTURE");
+  g_settings_delay (settings);
+  seen = (EditSeen) { 0 }; cc_luma_preferences_set_async (self, "enabled", value, directory, NULL, edit_done, &seen);
+  wait_edit (&seen); g_assert_false (seen.success); g_assert_error (seen.error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT); g_clear_error (&seen.error);
+  g_assert_true (g_settings_get_boolean (settings, "enabled"));
+  g_autoptr(GDir) entries = g_dir_open (directory, 0, NULL); g_assert_null (g_dir_read_name (entries));
+  g_clear_pointer (&entries, g_dir_close); g_assert_cmpint (g_rmdir (directory), ==, 0);
+}
+static void recovery_and_paths (void)
+{
+  const char *schema_id = "org.project_luma.settings-relocatable-test";
+  g_autoptr(GSettingsBackend) backend = g_memory_settings_backend_new ();
+  g_autoptr(GSettings) first = private_settings (schema_id, "/org/project_luma/first/", backend);
+  g_autoptr(GSettings) second = private_settings (schema_id, "/org/project_luma/second/", backend);
+  const char * const keys[] = { "enabled", NULL };
+  g_autoptr(CcLumaPreferences) a = cc_luma_preferences_new (first, keys, NULL);
+  g_autoptr(CcLumaPreferences) b = cc_luma_preferences_new (second, keys, NULL);
+  g_autofree char *directory = g_dir_make_tmp ("settings-preference-paths-XXXXXX", NULL);
+  g_autoptr(GVariant) off = g_variant_ref_sink (g_variant_new_boolean (FALSE));
+  g_autoptr(GVariant) on = g_variant_ref_sink (g_variant_new_boolean (TRUE));
+  EditSeen seen = { 0 }; cc_luma_preferences_set_async (a, "enabled", off, directory, NULL, edit_done, &seen);
+  wait_edit (&seen); g_assert_true (seen.success); g_assert_no_error (seen.error);
+  g_assert_true (g_settings_set_boolean (second, "enabled", FALSE));
+  seen = (EditSeen) { 0 }; cc_luma_preferences_set_async (b, "enabled", on, directory, NULL, edit_done, &seen);
+  wait_edit (&seen); g_assert_true (seen.success); g_assert_no_error (seen.error);
+  g_autofree char *a_path = backup_path (directory, schema_id, "/org/project_luma/first/", "enabled");
+  g_autofree char *b_path = backup_path (directory, schema_id, "/org/project_luma/second/", "enabled");
+  g_assert_cmpstr (a_path, !=, b_path); g_assert_true (g_file_test (a_path, G_FILE_TEST_IS_REGULAR));
+  g_autofree char *contents = NULL; g_assert_true (g_file_get_contents (b_path, &contents, NULL, NULL));
+  g_autoptr(GVariant) saved = g_variant_parse (G_VARIANT_TYPE ("(sssvmv)"), contents, NULL, NULL, NULL); g_assert_nonnull (saved);
+  g_autoptr(GVariant) optional = g_variant_get_child_value (saved, 4);
+  g_autoptr(GVariant) boxed = g_variant_get_maybe (optional); g_assert_nonnull (boxed);
+  g_autoptr(GVariant) original_user = g_variant_get_variant (boxed); g_assert_false (g_variant_get_boolean (original_user));
+  g_assert_false (g_settings_get_boolean (first, "enabled")); g_assert_true (g_settings_get_boolean (second, "enabled"));
+  /* Corrupt immutable recovery evidence must prevent any subsequent write. */
+  g_assert_true (g_file_set_contents (a_path, "invalid recovery record", -1, NULL));
+  seen = (EditSeen) { 0 }; cc_luma_preferences_set_async (a, "enabled", on, directory, NULL, edit_done, &seen);
+  wait_edit (&seen); g_assert_false (seen.success); g_assert_nonnull (seen.error); g_clear_error (&seen.error);
+  g_assert_false (g_settings_get_boolean (first, "enabled"));
+  g_clear_pointer (&contents, g_free);
+  g_assert_true (g_file_get_contents (a_path, &contents, NULL, NULL)); g_assert_cmpstr (contents, ==, "invalid recovery record");
+  remove_backups (directory);
+}
+static void recovery_refusals (void)
+{
+  g_autofree char *directory = g_dir_make_tmp ("settings-recovery-refusal-XXXXXX", NULL);
+  g_autoptr(GVariant) record = g_variant_ref_sink (g_variant_new ("(ssv)", "owner", "key", g_variant_new_boolean (TRUE)));
+  g_autoptr(GError) error = NULL;
+  g_assert_cmpint (g_chmod (directory, 0755), ==, 0);
+  g_assert_null (cc_luma_backup_once (directory, "identity", record, 2, NULL, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED); g_clear_error (&error);
+  g_assert_cmpint (g_chmod (directory, 0700), ==, 0);
+  g_autoptr(GVariant) saved = cc_luma_backup_once (directory, "identity", record, 2, NULL, &error);
+  g_assert_no_error (error); g_assert_nonnull (saved);
+  g_autofree char *digest = g_compute_checksum_for_string (G_CHECKSUM_SHA256, "identity", -1);
+  g_autofree char *name = g_strconcat (digest, ".variant", NULL);
+  g_autofree char *path = g_build_filename (directory, name, NULL);
+  g_assert_cmpint (g_chmod (path, 0644), ==, 0);
+  g_assert_null (cc_luma_backup_once (directory, "identity", record, 2, NULL, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA); g_clear_error (&error);
+  g_assert_cmpint (g_chmod (path, 0600), ==, 0);
+  g_autoptr(GVariant) other = g_variant_ref_sink (g_variant_new ("(ssv)", "another owner", "key", g_variant_new_boolean (FALSE)));
+  g_assert_null (cc_luma_backup_once (directory, "identity", other, 2, NULL, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA); g_clear_error (&error);
+  g_autofree char *target = g_build_filename (directory, "preserved-target", NULL);
+  g_assert_cmpint (g_rename (path, target), ==, 0); g_assert_cmpint (symlink (target, path), ==, 0);
+  g_assert_null (cc_luma_backup_once (directory, "identity", record, 2, NULL, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA); g_clear_error (&error);
+  g_autofree char *contents = NULL; g_assert_true (g_file_get_contents (target, &contents, NULL, NULL));
+  g_autofree char *expected = g_variant_print (record, TRUE); g_assert_cmpstr (contents, ==, expected);
+  remove_backups (directory);
+}
+static void backend_boundaries (void)
+{
+  g_autofree char *directory = g_dir_make_tmp ("settings-backend-refusal-XXXXXX", NULL);
+  g_autofree char *file = g_build_filename (directory, "scratch.ini", NULL);
+  g_autoptr(GSettingsBackend) backend = g_keyfile_settings_backend_new (file, "/", NULL);
+  g_autoptr(GSettings) settings = private_settings (SCHEMA, NULL, backend);
+  const char * const keys[] = { "enabled", NULL };
+  g_autoptr(CcLumaPreferences) self = cc_luma_preferences_new (settings, keys, NULL);
+  g_autoptr(GVariant) off = g_variant_ref_sink (g_variant_new_boolean (FALSE));
+  /* GSETTINGS_BACKEND=memory cannot authorize an actually different backend. */
+  EditSeen seen = { 0 }; cc_luma_preferences_set_async (self, "enabled", off, directory, NULL, edit_done, &seen);
+  wait_edit (&seen); g_assert_false (seen.success); g_assert_error (seen.error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED);
+  g_clear_error (&seen.error); g_assert_true (g_settings_get_boolean (settings, "enabled"));
+  g_assert_false (g_file_test (file, G_FILE_TEST_EXISTS));
+  g_autoptr(GSettingsBackend) locked_backend = g_null_settings_backend_new ();
+  g_autoptr(GSettings) locked_settings = private_settings (SCHEMA, NULL, locked_backend);
+  g_autoptr(CcLumaPreferences) locked = cc_luma_preferences_new (locked_settings, keys, NULL);
+  seen = (EditSeen) { 0 }; cc_luma_preferences_set_async (locked, "enabled", off, directory, NULL, edit_done, &seen);
+  wait_edit (&seen); g_assert_false (seen.success); g_assert_error (seen.error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED);
+  g_clear_error (&seen.error); g_assert_true (g_settings_get_boolean (locked_settings, "enabled"));
+  g_clear_object (&self); g_clear_object (&settings); g_clear_object (&backend); drain ();
+  remove_backups (directory);
+}
 int main (int argc, char **argv)
 {
   g_test_init (&argc, &argv, NULL);
   g_assert_cmpstr (g_getenv ("GSETTINGS_BACKEND"), ==, "memory");
   g_test_add_func ("/settings/preferences/values", values);
   g_test_add_func ("/settings/preferences/invalid", invalid);
+  g_test_add_func ("/settings/preferences/scoped-write", scoped_write);
+  g_test_add_func ("/settings/preferences/edit-boundaries", edit_boundaries);
+  g_test_add_func ("/settings/preferences/recovery-and-paths", recovery_and_paths);
+  g_test_add_func ("/settings/preferences/recovery-refusals", recovery_refusals);
+  g_test_add_func ("/settings/preferences/backend-boundaries", backend_boundaries);
