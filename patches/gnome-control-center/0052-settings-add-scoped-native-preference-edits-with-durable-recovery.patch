diff --git a/shell/cc-luma-backup.c b/shell/cc-luma-backup.c
new file mode 100644
index 0000000..fb4f276
--- /dev/null
+++ b/shell/cc-luma-backup.c
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-backup.h"
+#include <glib/gstdio.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <unistd.h>
+
+/* Extracted from Settings' tested Tracker backup implementation. The native
+ * owner validates payload semantics; storage enforces identity, ownership,
+ * no overwrite, private regular files and durability before a write. */
+static gboolean durable (const char *path, const char *directory, GError **error)
+{
+  const char *targets[] = { path, directory };
+  for (guint i = 0; i < G_N_ELEMENTS (targets); i++) {
+    int fd = g_open (targets[i], O_RDONLY | O_CLOEXEC | O_NOFOLLOW | (i ? O_DIRECTORY : 0), 0);
+    int saved_errno = 0;
+    if (fd < 0) saved_errno = errno;
+    else {
+      int result; do result = fsync (fd); while (result != 0 && errno == EINTR);
+      if (result != 0) saved_errno = errno;
+      if (close (fd) != 0 && !saved_errno) saved_errno = errno;
+    }
+    if (saved_errno) {
+      g_set_error (error, G_IO_ERROR, g_io_error_from_errno (saved_errno),
+                   "Cannot make Settings backup durable: %s", g_strerror (saved_errno));
+      return FALSE;
+    }
+  }
+  return TRUE;
+}
+
+GVariant *cc_luma_backup_once (const char *directory, const char *identity,
+  GVariant *record, guint identity_fields, GCancellable *cancel, GError **error)
+{
+  if (!directory || !g_path_is_absolute (directory) || !identity || !*identity ||
+      !record || !g_variant_is_container (record) || !identity_fields ||
+      identity_fields >= g_variant_n_children (record)) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid Settings recovery record");
+    return NULL;
+  }
+  for (guint i = 0; i < identity_fields; i++) {
+    g_autoptr(GVariant) field = g_variant_get_child_value (record, i);
+    if (!g_variant_is_of_type (field, G_VARIANT_TYPE_STRING)) {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid Settings recovery identity");
+      return NULL;
+    }
+  }
+  if (g_mkdir_with_parents (directory, 0700) != 0) {
+    g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno),
+                 "Cannot create Settings backup directory: %s", g_strerror (errno));
+    return NULL;
+  }
+  GStatBuf directory_info;
+  if (g_lstat (directory, &directory_info) != 0 || !S_ISDIR (directory_info.st_mode) ||
+      directory_info.st_uid != getuid () || (directory_info.st_mode & 0777) != 0700) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Settings backups need a private directory owned by this user");
+    return NULL;
+  }
+  g_autofree char *digest = g_compute_checksum_for_string (G_CHECKSUM_SHA256, identity, -1);
+  g_autofree char *name = g_strconcat (digest, ".variant", NULL);
+  g_autofree char *path = g_build_filename (directory, name, NULL);
+  g_autoptr(GFile) file = g_file_new_for_path (path);
+  g_autoptr(GError) create_error = NULL;
+  g_autoptr(GFileOutputStream) stream = g_file_create (file, G_FILE_CREATE_PRIVATE, cancel, &create_error);
+  if (!stream) {
+    if (!g_error_matches (create_error, G_IO_ERROR, G_IO_ERROR_EXISTS)) {
+      g_propagate_error (error, g_steal_pointer (&create_error)); return NULL;
+    }
+    g_autoptr(GFileInfo) info = g_file_query_info (file,
+      G_FILE_ATTRIBUTE_STANDARD_TYPE "," G_FILE_ATTRIBUTE_UNIX_MODE "," G_FILE_ATTRIBUTE_UNIX_UID,
+      G_FILE_QUERY_INFO_NOFOLLOW_SYMLINKS, cancel, error);
+    if (!info) return NULL;
+    if (g_file_info_get_file_type (info) != G_FILE_TYPE_REGULAR ||
+        (g_file_info_get_attribute_uint32 (info, G_FILE_ATTRIBUTE_UNIX_MODE) & 0777) != 0600 ||
+        g_file_info_get_attribute_uint32 (info, G_FILE_ATTRIBUTE_UNIX_UID) != getuid ()) {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Settings backup must be a private regular file owned by this user");
+      return NULL;
+    }
+    g_autofree char *contents = NULL;
+    if (!g_file_load_contents (file, cancel, &contents, NULL, NULL, error)) return NULL;
+    g_autoptr(GVariant) saved = g_variant_parse (g_variant_get_type (record), contents, NULL, NULL, error);
+    if (!saved) return NULL;
+    for (guint i = 0; i < identity_fields; i++) {
+      g_autoptr(GVariant) old_field = g_variant_get_child_value (saved, i);
+      g_autoptr(GVariant) expected = g_variant_get_child_value (record, i);
+      if (!g_variant_equal (old_field, expected)) {
+        g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Settings backup does not match the edited setting");
+        return NULL;
+      }
+    }
+    if (!durable (path, directory, error)) return NULL;
+    return g_steal_pointer (&saved);
+  }
+  g_autofree char *contents = g_variant_print (record, TRUE);
+  gboolean written = g_output_stream_write_all (G_OUTPUT_STREAM (stream), contents, strlen (contents), NULL, cancel, error);
+  if (written) written = g_output_stream_close (G_OUTPUT_STREAM (stream), cancel, error);
+  if (written) written = durable (path, directory, error);
+  if (!written) {
+    g_output_stream_close (G_OUTPUT_STREAM (stream), NULL, NULL);
+    g_file_delete (file, NULL, NULL);
+    return NULL;
+  }
+  return g_variant_ref (record);
+}
diff --git a/shell/cc-luma-backup.h b/shell/cc-luma-backup.h
new file mode 100644
index 0000000..6520f8c
--- /dev/null
+++ b/shell/cc-luma-backup.h
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <gio/gio.h>
+G_BEGIN_DECLS
+/* Settings-owned, immutable first-write recovery record. Owner-supplied
+ * identity determines the filename; initial tuple string fields identify
+ * the exact store/key. Existing payloads are returned for owner validation.
+ * This performs file I/O and must run off the UI thread. */
+GVariant *cc_luma_backup_once (const char *directory, const char *identity,
+  GVariant *record, guint identity_fields, GCancellable *cancel, GError **error);
+G_END_DECLS
diff --git a/shell/cc-luma-preferences.c b/shell/cc-luma-preferences.c
index 58de64b..74f374a 100644
--- a/shell/cc-luma-preferences.c
+++ b/shell/cc-luma-preferences.c
@@ -1,5 +1,9 @@
 /* SPDX-License-Identifier: GPL-2.0-or-later */
 #include "cc-luma-preferences.h"
+#include "cc-luma-backup.h"
+#define G_SETTINGS_ENABLE_BACKEND
+#include <gio/gsettingsbackend.h>
+#include <math.h>
 #include <string.h>
 
 struct _CcLumaPreferences {
@@ -194,6 +198,128 @@ void cc_luma_preferences_start (CcLumaPreferences *self)
 }
 GVariant *cc_luma_preferences_dup_values (CcLumaPreferences *self) { return self->values ? g_variant_ref (self->values) : NULL; }
 GVariant *cc_luma_preferences_dup_writable (CcLumaPreferences *self) { return self->writable ? g_variant_ref (self->writable) : NULL; }
+
+typedef struct { char *key, *directory; GVariant *value; } PreferenceEdit;
+static void edit_free (PreferenceEdit *edit)
+{
+  g_free (edit->key); g_free (edit->directory);
+  g_clear_pointer (&edit->value, g_variant_unref); g_free (edit);
+}
+static gboolean edit_valid (CcLumaPreferences *self, const char *key, GVariant *value, GError **error)
+{
+  gboolean selected = FALSE, delayed = FALSE;
+  for (guint i = 0; self->keys[i]; i++) if (g_strcmp0 (key, self->keys[i]) == 0) selected = TRUE;
+  if (!selected || g_getenv ("LUMA_SETTINGS_FIXTURE")) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                         "This Settings preference is not authorized for editing"); return FALSE;
+  }
+  g_object_get (self->settings, "delay-apply", &delayed, NULL);
+  if (delayed) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                         "Settings edits require an observer without pending delayed writes"); return FALSE;
+  }
+  g_autoptr(GSettingsSchema) schema = NULL;
+  g_object_get (self->settings, "settings-schema", &schema, NULL);
+  g_autoptr(GSettingsSchemaKey) schema_key = g_settings_schema_get_key (schema, key);
+  if (value && (!g_variant_is_of_type (value, g_settings_schema_key_get_value_type (schema_key)) ||
+                !g_settings_schema_key_range_check (schema_key, value) ||
+                (g_variant_is_of_type (value, G_VARIANT_TYPE_DOUBLE) && !isfinite (g_variant_get_double (value))))) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                         "The native Settings schema rejects this value"); return FALSE;
+  }
+  if (!g_settings_is_writable (self->settings, key)) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                         "This native Settings preference is locked"); return FALSE;
+  }
+  return TRUE;
+}
+static void preference_apply (GTask *task, gpointer source, gpointer data, GCancellable *cancel)
+{
+  static GMutex edits;
+  g_autoptr(GMutexLocker) lock = g_mutex_locker_new (&edits);
+  CcLumaPreferences *self = source; PreferenceEdit *edit = data;
+  g_autoptr(GError) error = NULL;
+  if (!edit_valid (self, edit->key, edit->value, &error)) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  if (g_task_return_error_if_cancelled (task)) return;
+  g_autofree char *schema_id = NULL, *path = NULL;
+  g_autoptr(GSettingsSchema) schema = NULL;
+  g_autoptr(GObject) backend = NULL;
+  g_object_get (self->settings, "schema-id", &schema_id, "path", &path,
+                "settings-schema", &schema, "backend", &backend, NULL);
+  /* Include the relocatable path in identity. Per-app schemas must not share
+   * a recovery record merely because their schema and key names match. */
+  g_autofree char *identity = g_strjoin ("/", schema_id, path, edit->key, NULL);
+  g_autoptr(GVariant) before = g_settings_get_value (self->settings, edit->key);
+  g_autoptr(GVariant) user_value = g_settings_get_user_value (self->settings, edit->key);
+  g_autoptr(GVariant) record = g_variant_ref_sink (g_variant_new ("(sssv@mv)",
+    schema_id, path, edit->key, before,
+    g_variant_new_maybe (G_VARIANT_TYPE_VARIANT, user_value ? g_variant_new_variant (user_value) : NULL)));
+  g_autoptr(GVariant) saved = cc_luma_backup_once (edit->directory, identity, record, 3, cancel, &error);
+  if (!saved) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  g_autoptr(GVariant) boxed = g_variant_get_child_value (saved, 3);
+  g_autoptr(GVariant) original = g_variant_get_variant (boxed);
+  g_autoptr(GVariant) optional = g_variant_get_child_value (saved, 4);
+  g_autoptr(GVariant) override = g_variant_get_maybe (optional);
+  g_autoptr(GVariant) original_override = override ? g_variant_get_variant (override) : NULL;
+  const GVariantType *type = g_variant_get_type (before);
+  if (!g_variant_is_of_type (original, type) ||
+      (original_override && !g_variant_is_of_type (original_override, type))) {
+    g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                            "Settings recovery value has the wrong native type"); return;
+  }
+  if (!edit_valid (self, edit->key, edit->value, &error)) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  if (g_task_return_error_if_cancelled (task)) return;
+  /* A separate transaction uses the same backend and only this edited key;
+   * unrelated external changes and the observer's immediate mode survive. */
+  g_autoptr(GSettings) transaction = g_settings_new_full (schema, (GSettingsBackend *) backend, path);
+  g_settings_delay (transaction);
+  if (edit->value) {
+    if (!g_settings_set_value (transaction, edit->key, edit->value)) {
+      g_settings_revert (transaction);
+      g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_FAILED, "Native Settings rejected the staged edit"); return;
+    }
+  } else g_settings_reset (transaction, edit->key);
+  if (g_task_return_error_if_cancelled (task)) { g_settings_revert (transaction); return; }
+  /* A cancellation after commit begins must not falsely report no write. */
+  g_task_set_check_cancellable (task, FALSE);
+  g_settings_apply (transaction);
+  g_task_return_boolean (task, TRUE);
+}
+void cc_luma_preferences_set_async (CcLumaPreferences *self, const char *key,
+  GVariant *value, const char *backup_dir, GCancellable *cancel,
+  GAsyncReadyCallback callback, gpointer data)
+{
+  g_return_if_fail (CC_IS_LUMA_PREFERENCES (self));
+  g_autoptr(GTask) task = g_task_new (self, cancel, callback, data);
+  g_task_set_source_tag (task, cc_luma_preferences_set_async);
+  g_autoptr(GError) error = NULL;
+  if (!edit_valid (self, key, value, &error)) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  if (!backup_dir || !g_path_is_absolute (backup_dir)) {
+    g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Settings edits need an absolute backup directory"); return;
+  }
+  g_autoptr(GObject) backend = NULL;
+  g_object_get (self->settings, "backend", &backend, NULL);
+  g_autoptr(GObject) memory = G_OBJECT (g_memory_settings_backend_new ());
+  if (!backend || !g_type_is_a (G_OBJECT_TYPE (backend), G_OBJECT_TYPE (memory))) {
+    g_autofree char *expected = g_build_filename (g_get_user_data_dir (), "luma", "settings", "backups", NULL);
+    g_autofree char *normalized = g_canonicalize_filename (backup_dir, NULL);
+    if (g_strcmp0 (expected, normalized) != 0) {
+      g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                              "Native Settings backups must stay in the documented app-local backup store"); return;
+    }
+  }
+  PreferenceEdit *edit = g_new0 (PreferenceEdit, 1);
+  edit->key = g_strdup (key); edit->directory = g_strdup (backup_dir);
+  edit->value = value ? g_variant_ref (value) : NULL;
+  g_task_set_task_data (task, edit, (GDestroyNotify) edit_free);
+  g_task_run_in_thread (task, preference_apply);
+}
+gboolean cc_luma_preferences_set_finish (CcLumaPreferences *self, GAsyncResult *result, GError **error)
+{
+  g_return_val_if_fail (g_task_is_valid (result, self), FALSE);
+  g_return_val_if_fail (g_async_result_is_tagged (result, cc_luma_preferences_set_async), FALSE);
+  return g_task_propagate_boolean (G_TASK (result), error);
+}
 static void dispose (GObject *object)
 {
   CcLumaPreferences *self = CC_LUMA_PREFERENCES (object);
