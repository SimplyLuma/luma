-/* Read-only glue for existing native schemas. The injected-object route
+/* Observer glue for existing native schemas. Construction/start never write.
+ * The injected-object route
  * permits memory-only tests; no fixture constructor opens a native schema. */
 CcLumaPreferences *cc_luma_preferences_new (GSettings *settings,
   const char * const *keys, GError **error);
@@ -44,4 +45,15 @@ void cc_luma_preferences_stop (CcLumaPreferences *self);
  * Both are NULL until the first asynchronous ::changed notification. */
 GVariant *cc_luma_preferences_dup_values (CcLumaPreferences *self);
 GVariant *cc_luma_preferences_dup_writable (CcLumaPreferences *self);
+/* Explicit edits affect only a key selected by this observer. A durable,
+ * immutable recovery record precedes the update and preserves whether the
+ * original value was an override. NULL value resets to the schema default.
+ * Native backups stay in ~/.local/share/luma/settings/backups; injected
+ * memory backends permit a scratch test directory. Fixture mode refuses.
+ * Backup I/O runs in a worker; cancellation before commit prevents writes. */
+void cc_luma_preferences_set_async (CcLumaPreferences *self, const char *key,
+  GVariant *value, const char *backup_dir, GCancellable *cancel,
+  GAsyncReadyCallback callback, gpointer data);
+gboolean cc_luma_preferences_set_finish (CcLumaPreferences *self,
+  GAsyncResult *result, GError **error);
 G_END_DECLS
