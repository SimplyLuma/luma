diff --git a/shell/cc-luma-live-modem.c b/shell/cc-luma-live-modem.c
new file mode 100644
index 0000000..6ee1606
--- /dev/null
+++ b/shell/cc-luma-live-modem.c
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live modem presence: ModemManager's objects, as panels/wwan/cc-wwan-panel.c
+ * decides whether its panel is shown. The model's "modem" key is TRUE while
+ * ModemManager reports a modem the Mobile Network panel supports; without one,
+ * or without ModemManager, the key is absent. ModemManager is never started
+ * for this: a computer without it stays as it was. */
+#include "cc-luma-live.h"
+#include <gio/gio.h>
+
+#define ADAPTER "modem"
+#define MM_NAME "org.freedesktop.ModemManager1"
+#define MM_PATH "/org/freedesktop/ModemManager1"
+#define MM_MODEM "org.freedesktop.ModemManager1.Modem"
+/* MMModemCapability: GSM_UMTS, LTE and LTE_ADVANCED, the capabilities the panel supports. */
+#define MM_PANEL_CAPABILITIES ((1u << 2) | (1u << 3) | (1u << 4))
+
+typedef struct {
+  CcLumaFixture *model;
+  GDBusObjectManager *manager;
+  GCancellable *cancel;
+  gboolean ready;
+} Modem;
+
+static gboolean
+supported (GDBusObject *object)
+{
+  g_autoptr (GDBusInterface) iface = g_dbus_object_get_interface (object, MM_MODEM);
+  g_autoptr (GVariant) caps = iface ? g_dbus_proxy_get_cached_property (G_DBUS_PROXY (iface), "CurrentCapabilities") : NULL;
+  return caps && g_variant_is_of_type (caps, G_VARIANT_TYPE_UINT32) &&
+         (g_variant_get_uint32 (caps) & MM_PANEL_CAPABILITIES) != 0;
+}
+
+static gboolean
+reported (CcLumaFixture *model)
+{
+  JsonNode *n = cc_luma_fixture_get (model, ADAPTER);
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_BOOLEAN && json_node_get_boolean (n);
+}
+
+static void
+publish (Modem *m)
+{
+  GList *objects = m->manager ? g_dbus_object_manager_get_objects (m->manager) : NULL;
+  gboolean present = FALSE;
+  for (GList *l = objects; l && !present; l = l->next)
+    present = supported (l->data);
+  g_list_free_full (objects, g_object_unref);
+  /* Signal quality and the like change often; the model changes only with the answer. */
+  if (present && !reported (m->model)) cc_luma_fixture_publish_boolean (m->model, ADAPTER, TRUE);
+  else if (!present) cc_luma_fixture_unpublish (m->model, ADAPTER);
+  if (!m->ready) { m->ready = TRUE; cc_luma_live_ready (m->model, ADAPTER); }
+}
+
+static void
+manager_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusObjectManager *manager = g_dbus_object_manager_client_new_for_bus_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Modem *m = data;
+  if (error) g_debug ("Settings: no ModemManager (%s)", error->message);
+  m->manager = manager;
+  if (manager)
+    {
+      g_signal_connect_swapped (manager, "object-added", G_CALLBACK (publish), m);
+      g_signal_connect_swapped (manager, "object-removed", G_CALLBACK (publish), m);
+      g_signal_connect_swapped (manager, "interface-added", G_CALLBACK (publish), m);
+      g_signal_connect_swapped (manager, "interface-removed", G_CALLBACK (publish), m);
+      g_signal_connect_swapped (manager, "interface-proxy-properties-changed", G_CALLBACK (publish), m);
+      g_signal_connect_swapped (manager, "notify::name-owner", G_CALLBACK (publish), m);
+    }
+  publish (m);
+}
+
+static gpointer
+modem_start (CcLumaFixture *model)
+{
+  Modem *m = g_new0 (Modem, 1);
+  m->model = model;
+  m->cancel = g_cancellable_new ();
+  g_dbus_object_manager_client_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_OBJECT_MANAGER_CLIENT_FLAGS_DO_NOT_AUTO_START,
+                                            MM_NAME, MM_PATH, NULL, NULL, NULL, m->cancel, manager_ready, m);
+  return m;
+}
+
+static void
+modem_stop (gpointer state)
+{
+  Modem *m = state;
+  g_cancellable_cancel (m->cancel);
+  g_clear_object (&m->cancel);
+  if (m->manager) g_signal_handlers_disconnect_by_data (m->manager, m);
+  g_clear_object (&m->manager);
+  g_free (m);
+}
+
+/* No page of its own: Mobile Network is the wwan panel's. */
+const CcLumaAdapter cc_luma_adapter_modem = { ADAPTER, NULL, modem_start, NULL, modem_stop };
