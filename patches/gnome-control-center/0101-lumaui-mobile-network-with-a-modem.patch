+#pragma once
+#include <glib.h>
+
+G_BEGIN_DECLS
+/* The wwan panel reads NetworkManager and ModemManager from the object
+ * storage that GNOME's own window fills at startup (the network panels and
+ * cc_wwan_panel_static_init_func); Settings' LumaUI window fills them only
+ * before the panel opens. */
+void cc_luma_wwan_prepare (void);
+G_END_DECLS
