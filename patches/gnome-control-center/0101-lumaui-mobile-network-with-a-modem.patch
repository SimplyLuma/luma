+++ b/shell/cc-luma-window.c
@@ -13,11 +13,14 @@ typedef struct {
   const char *id;
   const char *title;
   const char *icon;
+  /* Listed only while the model reports this key TRUE (hardware the page needs). */
+  const char *needs;
 } Destination;
 
 /* Studio v70 CFP: each top-level page's name and Lucide icon. */
 static const Destination destinations[] = {
   { "wifi", "Wi‑Fi", "wifi" },
+  { "mobile", "Mobile Network", "radio-tower", "modem" },
   { "network", "Network", "ethernet-port" },
   { "bluetooth", "Bluetooth", "bluetooth" },
   { "appearance", "Appearance", "palette" },
@@ -79,6 +82,7 @@ typedef struct {
   gboolean following;
   gboolean tv;       /* the island carries the TV destinations */
   GtkWidget *sidebar;
+  char *hardware;    /* which hardware-bound destinations are listed */
 } Frame;
 
 static void frame_free (Frame *f)
@@ -86,6 +90,7 @@ static void frame_free (Frame *f)
   g_clear_object (&f->model);
   g_clear_object (&f->search_item);
   g_free (f->shown);
+  g_free (f->hardware);
   g_hash_table_unref (f->rows);
   g_clear_pointer (&f->groups, json_array_unref);
   g_free (f);
@@ -103,6 +108,23 @@ static const Destination *destination (const char *id)
   return NULL;
 }
 
+/* A destination whose hardware is missing is left out, not shown empty. */
+static gboolean destination_offered (CcLumaFixture *model, const Destination *d)
+{
+  JsonNode *n;
+  if (!d->needs) return TRUE;
+  n = model ? cc_luma_fixture_get (model, d->needs) : NULL;
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_BOOLEAN && json_node_get_boolean (n);
+}
+
+static char *hardware_listed (CcLumaFixture *model)
+{
+  GString *listed = g_string_new (NULL);
+  for (guint i = 0; i < G_N_ELEMENTS (destinations); i++)
+    if (destinations[i].needs) g_string_append_c (listed, destination_offered (model, &destinations[i]) ? '1' : '0');
+  return g_string_free (listed, FALSE);
+}
+
 /* The top-level page a page belongs to (cfRoot). */
 static char *root_page (CcLumaFixture *model, const char *page)
 {
@@ -232,9 +254,16 @@ static void follow_page (CcLumaShell *shell, const char *page, gpointer data)
   f->shown = g_strdup (page);
 }
 
+static void rebuild_destinations (Frame *f);
 static void refresh_meta (GtkWidget *shell)
 {
   Frame *f = g_object_get_data (G_OBJECT (gtk_widget_get_root (shell)), "cf-frame");
+  if (f && !f->tv)
+    {
+      /* A modem came or went: its destination follows. */
+      g_autofree char *listed = hardware_listed (f->model);
+      if (g_strcmp0 (listed, f->hardware) != 0) rebuild_destinations (f);
+    }
   if (f && cc_luma_shell_get_page (CC_LUMA_SHELL (shell))) follow_page (CC_LUMA_SHELL (shell), cc_luma_shell_get_page (CC_LUMA_SHELL (shell)), f);
 }
 
@@ -330,6 +359,8 @@ static void add_destinations (Frame *f)
   JsonArray *groups = f->groups;
   GtkWidget *sidebar = f->sidebar;
   f->tv = tv_posture () && !phone_form_factor ();
+  g_free (f->hardware);
+  f->hardware = hardware_listed (f->model);
   if (f->tv)
     {
       for (guint i = 0; i < G_N_ELEMENTS (tv_destinations); i++)
@@ -361,7 +392,7 @@ static void add_destinations (Frame *f)
         {
           const Destination *d = destination (json_array_get_string_element (ids, i));
           GtkWidget *row;
-          if (!d) continue;
+          if (!d || !destination_offered (f->model, d)) continue;
           row = luma_navigation_row_new (d->title, NULL);
           luma_navigation_row_set_lead (LUMA_NAVIGATION_ROW (row), luma_ui_icon_new (d->icon));
           g_object_set_data (G_OBJECT (row), "cf-page", (gpointer) d->id);
@@ -371,15 +402,20 @@ static void add_destinations (Frame *f)
     }
 }
 
-/* TV posture turned on or off: the island's destinations follow; the page draws again. */
-static void posture_changed (GObject *context, GParamSpec *pspec, Frame *f)
+static void rebuild_destinations (Frame *f)
 {
-  if (f->tv == (tv_posture () && !phone_form_factor ())) return;
   f->following = TRUE;
   luma_navigation_sidebar_clear (LUMA_NAVIGATION_SIDEBAR (f->sidebar));
   g_hash_table_remove_all (f->rows);
   add_destinations (f);
   f->following = FALSE;
+}
+
+/* TV posture turned on or off: the island's destinations follow; the page draws again. */
+static void posture_changed (GObject *context, GParamSpec *pspec, Frame *f)
+{
+  if (f->tv == (tv_posture () && !phone_form_factor ())) return;
+  rebuild_destinations (f);
   cc_luma_shell_redraw (CC_LUMA_SHELL (f->shell));
   follow_page (CC_LUMA_SHELL (f->shell), cc_luma_shell_get_page (CC_LUMA_SHELL (f->shell)), f);
 }
diff --git a/shell/cc-luma-wwan.c b/shell/cc-luma-wwan.c
new file mode 100644
index 0000000..cacbd5a
--- /dev/null
+++ b/shell/cc-luma-wwan.c
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-wwan.h"
+#include "cc-object-storage.h"
+#include <libmm-glib.h>
+#include <NetworkManager.h>
+
+void
+cc_luma_wwan_prepare (void)
+{
+  g_autoptr (GError) error = NULL;
+  if (!cc_object_storage_has_object (CC_OBJECT_NMCLIENT))
+    {
+      /* As cc-network-panel.c does. */
+      g_autoptr (NMClient) client = nm_client_new (NULL, &error);
+      if (client) cc_object_storage_add_object (CC_OBJECT_NMCLIENT, client);
+      else g_warning ("Mobile Network: no NetworkManager client (%s)", error->message);
+      g_clear_error (&error);
+    }
+  if (!cc_object_storage_has_object (CC_OBJECT_MMMANAGER))
+    {
+      /* As cc_wwan_panel_static_init_func does, without starting ModemManager. */
+      g_autoptr (GDBusConnection) bus = g_bus_get_sync (G_BUS_TYPE_SYSTEM, NULL, &error);
+      g_autoptr (MMManager) manager = bus ? mm_manager_new_sync (bus, G_DBUS_OBJECT_MANAGER_CLIENT_FLAGS_DO_NOT_AUTO_START,
+                                                                 NULL, &error) : NULL;
+      if (manager) cc_object_storage_add_object (CC_OBJECT_MMMANAGER, manager);
+      else g_warning ("Mobile Network: no ModemManager (%s)", error->message);
+    }
+}
