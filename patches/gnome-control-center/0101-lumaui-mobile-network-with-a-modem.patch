diff --git a/shell/test-luma-live-modem.c b/shell/test-luma-live-modem.c
new file mode 100644
index 0000000..b951c59
--- /dev/null
+++ b/shell/test-luma-live-modem.c
@@ -0,0 +1,221 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live modem presence against a stand-in ModemManager on a private bus: the
+ * model's "modem" key follows a supported modem coming and going, and
+ * ModemManager arriving and leaving. */
+#include "cc-luma-live.h"
+#include <gio/gio.h>
+
+#define MM_NAME "org.freedesktop.ModemManager1"
+#define MM_PATH "/org/freedesktop/ModemManager1"
+#define MM_MODEM "org.freedesktop.ModemManager1.Modem"
+
+extern const CcLumaAdapter cc_luma_adapter_modem;
+/* The registry isn't under test: readiness is recorded here. */
+static gboolean modem_ready;
+void cc_luma_live_ready (CcLumaFixture *model, const char *adapter) { modem_ready |= g_str_equal (adapter, "modem"); }
+
+typedef struct {
+  GDBusConnection *bus;
+  GHashTable *modems; /* path → capabilities */
+  guint registration;
+} FakeMM;
+
+static GVariant *
+interfaces (guint32 caps)
+{
+  GVariantBuilder props, ifaces;
+  g_variant_builder_init (&props, G_VARIANT_TYPE ("a{sv}"));
+  g_variant_builder_add (&props, "{sv}", "CurrentCapabilities", g_variant_new_uint32 (caps));
+  g_variant_builder_init (&ifaces, G_VARIANT_TYPE ("a{sa{sv}}"));
+  g_variant_builder_add (&ifaces, "{sa{sv}}", MM_MODEM, &props);
+  return g_variant_builder_end (&ifaces);
+}
+
+static void
+mm_call (GDBusConnection *connection, const char *sender, const char *path, const char *iface, const char *method,
+         GVariant *parameters, GDBusMethodInvocation *invocation, gpointer data)
+{
+  FakeMM *mm = data;
+  GVariantBuilder objects;
+  GHashTableIter iter;
+  gpointer key, value;
+  g_variant_builder_init (&objects, G_VARIANT_TYPE ("a{oa{sa{sv}}}"));
+  g_hash_table_iter_init (&iter, mm->modems);
+  while (g_hash_table_iter_next (&iter, &key, &value))
+    g_variant_builder_add (&objects, "{o@a{sa{sv}}}", (const char *) key, interfaces (GPOINTER_TO_UINT (value)));
+  g_dbus_method_invocation_return_value (invocation, g_variant_new ("(a{oa{sa{sv}}})", &objects));
+}
+
+static const GDBusInterfaceVTable mm_vtable = { .method_call = mm_call };
+static const char object_manager_xml[] =
+  "<node><interface name='org.freedesktop.DBus.ObjectManager'>"
+  "<method name='GetManagedObjects'><arg type='a{oa{sa{sv}}}' direction='out'/></method>"
+  "<signal name='InterfacesAdded'><arg type='o'/><arg type='a{sa{sv}}'/></signal>"
+  "<signal name='InterfacesRemoved'><arg type='o'/><arg type='as'/></signal>"
+  "</interface></node>";
+
+static void
+fake_start (FakeMM *mm, GTestDBus *bus)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GDBusNodeInfo) node = g_dbus_node_info_new_for_xml (object_manager_xml, &error);
+  g_autoptr (GVariant) reply = NULL;
+  g_assert_no_error (error);
+  mm->bus = g_dbus_connection_new_for_address_sync (g_test_dbus_get_bus_address (bus),
+                                                    G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT |
+                                                    G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION,
+                                                    NULL, NULL, &error);
+  g_assert_no_error (error);
+  if (!mm->modems) mm->modems = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  mm->registration = g_dbus_connection_register_object (mm->bus, MM_PATH, node->interfaces[0], &mm_vtable, mm, NULL, &error);
+  g_assert_no_error (error);
+  reply = g_dbus_connection_call_sync (mm->bus, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
+                                       "RequestName", g_variant_new ("(su)", MM_NAME, 0), G_VARIANT_TYPE ("(u)"),
+                                       G_DBUS_CALL_FLAGS_NONE, -1, NULL, &error);
+  g_assert_no_error (error);
+}
+
+static void
+fake_stop (FakeMM *mm)
+{
+  g_dbus_connection_unregister_object (mm->bus, mm->registration);
+  g_dbus_connection_close_sync (mm->bus, NULL, NULL);
+  g_clear_object (&mm->bus);
+}
+
+static void
+fake_add (FakeMM *mm, const char *path, guint32 caps)
+{
+  g_hash_table_insert (mm->modems, g_strdup (path), GUINT_TO_POINTER (caps));
+  g_dbus_connection_emit_signal (mm->bus, NULL, MM_PATH, "org.freedesktop.DBus.ObjectManager", "InterfacesAdded",
+                                 g_variant_new ("(o@a{sa{sv}})", path, interfaces (caps)), NULL);
+}
+
+static void
+fake_remove (FakeMM *mm, const char *path)
+{
+  const char *gone[] = { MM_MODEM, NULL };
+  g_hash_table_remove (mm->modems, path);
+  g_dbus_connection_emit_signal (mm->bus, NULL, MM_PATH, "org.freedesktop.DBus.ObjectManager", "InterfacesRemoved",
+                                 g_variant_new ("(o^as)", path, gone), NULL);
+}
+
+static gboolean
+present (CcLumaFixture *model)
+{
+  JsonNode *n = cc_luma_fixture_get (model, "modem");
+  return n && json_node_get_boolean (n);
+}
+
+/* Lets both sides of the bus run until the model says what is expected. */
+static gboolean
+settle (CcLumaFixture *model, gboolean expected)
+{
+  gint64 deadline = g_get_monotonic_time () + 5 * G_USEC_PER_SEC;
+  while (g_get_monotonic_time () < deadline)
+    {
+      g_main_context_iteration (NULL, FALSE);
+      if (modem_ready && present (model) == expected)
+        {
+          /* Stay a moment: nothing later may undo it. */
+          gint64 hold = g_get_monotonic_time () + 100 * 1000;
+          while (g_get_monotonic_time () < hold) g_main_context_iteration (NULL, FALSE);
+          return present (model) == expected;
+        }
+    }
+  return FALSE;
+}
+
+static guint changes;
+static void count_change (CcLumaFixture *model, gpointer data) { changes++; }
+
+static CcLumaFixture *
+live_model (void)
+{
+  g_autoptr (JsonParser) parser = json_parser_new ();
+  g_assert_true (json_parser_load_from_data (parser,
+    "{\"version\":1,\"settings\":{},\"data\":{},\"pages\":[{\"id\":\"mobile\"}]}", -1, NULL));
+  return cc_luma_fixture_new_live (json_parser_get_root (parser));
+}
+
+static void
+test_presence (void)
+{
+  g_autoptr (GTestDBus) bus = g_test_dbus_new (G_TEST_DBUS_NONE);
+  g_autoptr (CcLumaFixture) model = live_model ();
+  FakeMM mm = { 0 };
+  gpointer state;
+
+  g_test_dbus_up (bus);
+  g_setenv ("DBUS_SYSTEM_BUS_ADDRESS", g_test_dbus_get_bus_address (bus), TRUE);
+  g_signal_connect (model, "changed", G_CALLBACK (count_change), NULL);
+
+  /* No ModemManager: the adapter reports, and there is no modem. */
+  state = cc_luma_adapter_modem.start (model);
+  g_assert_true (settle (model, FALSE));
+  g_assert_null (cc_luma_fixture_get (model, "modem"));
+
+  /* ModemManager starts later with an LTE modem. */
+  fake_start (&mm, bus);
+  fake_add (&mm, MM_PATH "/Modem/0", 1u << 3);
+  g_assert_true (settle (model, TRUE));
+
+  /* Property changes on a modem already counted don't change the model. */
+  changes = 0;
+  fake_add (&mm, MM_PATH "/Modem/0", (1u << 3) | (1u << 2));
+  g_assert_true (settle (model, TRUE));
+  g_assert_cmpuint (changes, ==, 0);
+
+  /* The modem goes away. */
+  fake_remove (&mm, MM_PATH "/Modem/0");
+  g_assert_true (settle (model, FALSE));
+
+  /* A modem the panel doesn't support (CDMA only) is not a Mobile Network. */
+  fake_add (&mm, MM_PATH "/Modem/1", 1u << 1);
+  g_assert_true (settle (model, FALSE));
+  fake_add (&mm, MM_PATH "/Modem/2", 1u << 2);
+  g_assert_true (settle (model, TRUE));
+
+  /* ModemManager leaves: its modems go with it. */
+  fake_stop (&mm);
+  g_assert_true (settle (model, FALSE));
+
+  cc_luma_adapter_modem.stop (state);
+  g_hash_table_unref (mm.modems);
+  g_test_dbus_down (bus);
+}
+
+static void
+test_modem_at_start (void)
+{
+  g_autoptr (GTestDBus) bus = g_test_dbus_new (G_TEST_DBUS_NONE);
+  g_autoptr (CcLumaFixture) model = live_model ();
+  FakeMM mm = { 0 };
+  gpointer state;
+
+  g_test_dbus_up (bus);
+  g_setenv ("DBUS_SYSTEM_BUS_ADDRESS", g_test_dbus_get_bus_address (bus), TRUE);
+  fake_start (&mm, bus);
+  fake_add (&mm, MM_PATH "/Modem/0", (1u << 2) | (1u << 3) | (1u << 6));
+  modem_ready = FALSE;
+  state = cc_luma_adapter_modem.start (model);
+  g_assert_true (settle (model, TRUE));
+  /* Stopping before replies arrive leaves nothing behind. */
+  cc_luma_adapter_modem.stop (state);
+  state = cc_luma_adapter_modem.start (model);
+  cc_luma_adapter_modem.stop (state);
+  g_main_context_iteration (NULL, FALSE);
+
+  fake_stop (&mm);
+  g_hash_table_unref (mm.modems);
+  g_test_dbus_down (bus);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/settings/live/modem/presence", test_presence);
+  g_test_add_func ("/settings/live/modem/at-start", test_modem_at_start);
+  return g_test_run ();
+}
