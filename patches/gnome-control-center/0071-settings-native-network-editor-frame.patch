diff --git a/tests/network/test-luma-network-editor.c b/tests/network/test-luma-network-editor.c
--- a/tests/network/test-luma-network-editor.c
+++ b/tests/network/test-luma-network-editor.c
@@ -0,0 +1,269 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+#include <adwaita.h>
+#include <luma-ui.h>
+#include <luma-appearance.h>
+#include "net-connection-editor.h"
+#include "nm-test-libnm-utils.h"
+
+static GtkWidget *named (GtkWidget *root, const char *name)
+{
+  if (g_strcmp0 (gtk_widget_get_name (root), name) == 0)
+    return root;
+  for (GtkWidget *child = gtk_widget_get_first_child (root); child;
+       child = gtk_widget_get_next_sibling (child)) {
+    GtkWidget *found = named (child, name);
+    if (found) return found;
+  }
+  return NULL;
+}
+
+static GtkWidget *typed (GtkWidget *root, GType type)
+{
+  if (G_TYPE_CHECK_INSTANCE_TYPE (root, type)) return root;
+  for (GtkWidget *child = gtk_widget_get_first_child (root); child;
+       child = gtk_widget_get_next_sibling (child)) {
+    GtkWidget *found = typed (child, type);
+    if (found) return found;
+  }
+  return NULL;
+}
+
+static void cancelled (NetConnectionEditor *editor, gboolean success, guint *count)
+{
+  g_assert_false (success);
+  (*count)++;
+}
+
+static void iterate (void)
+{
+  while (g_main_context_pending (NULL))
+    g_main_context_iteration (NULL, FALSE);
+}
+
+static void native_editor_frame (void)
+{
+  /* Construct the actual owner without an NM service: presentation and Cancel
+   * must not require a network or change connection state. */
+  NetConnectionEditor *editor = g_object_new (NET_TYPE_CONNECTION_EDITOR, NULL);
+  g_object_ref_sink (editor);
+  GtkWidget *window = GTK_WIDGET (editor);
+  g_assert_true (ADW_IS_APPLICATION_WINDOW (editor));
+  g_assert_true (gtk_widget_has_css_class (window, "luma-adw-native-window"));
+  g_assert_nonnull (named (window, "lumaui-title-row"));
+  g_assert_nonnull (typed (window, LUMA_TYPE_ISLAND));
+  net_connection_editor_set_title (editor, "Native test network");
+  GtkWidget *heading = typed (window, LUMA_TYPE_TYPE_LABEL);
+  g_assert_nonnull (heading);
+  g_assert_cmpstr (luma_type_label_get_text (LUMA_TYPE_LABEL (heading)), ==, "Native test network");
+  GtkWidget *cancel = named (window, "luma-network-cancel");
+  GtkWidget *apply = named (window, "luma-network-apply");
+  g_assert_true (GTK_IS_BUTTON (cancel));
+  g_assert_true (GTK_IS_BUTTON (apply));
+  g_assert_true (gtk_widget_has_css_class (cancel, "lumaui-text-button"));
+  g_assert_true (gtk_widget_has_css_class (cancel, "raised"));
+  g_assert_true (gtk_widget_has_css_class (apply, "lumaui-text-button"));
+  g_assert_true (gtk_widget_has_css_class (apply, "raised"));
+
+  const int widths[] = {360, 500, 1024, 1366};
+  for (guint theme = 0; theme < 2; theme++) {
+    g_autoptr (LumaSurfacePolicy) policy = luma_surface_policy_new (LUMA_SURFACE_TARGET_APPLICATION);
+    g_autoptr (GError) theme_error = NULL;
+    g_assert_true (luma_surface_policy_select (policy, theme ? "dark" : "light", &theme_error));
+    g_assert_no_error (theme_error);
+    g_assert_cmpint (adw_style_manager_get_dark (adw_style_manager_get_default ()), ==, theme);
+    for (guint i = 0; i < G_N_ELEMENTS (widths); i++) {
+      gtk_window_set_default_size (GTK_WINDOW (window), widths[i], 540);
+      gtk_window_present (GTK_WINDOW (window));
+      gint64 end = g_get_monotonic_time () + G_TIME_SPAN_SECOND;
+      do { iterate (); g_usleep (1000); } while (g_get_monotonic_time () < end);
+      g_assert_true (gtk_widget_get_mapped (window));
+      g_assert_true (gtk_widget_get_mapped (cancel));
+      g_assert_true (gtk_widget_get_mapped (apply));
+      g_assert_cmpint (gtk_widget_get_height (cancel), <=, 44);
+      g_assert_cmpint (gtk_widget_get_height (apply), <=, 44);
+    }
+  }
+  guint done_count = 0;
+  g_signal_connect (editor, "done", G_CALLBACK (cancelled), &done_count);
+  g_assert_true (gtk_widget_activate (cancel));
+  gint64 end = g_get_monotonic_time () + 2 * G_TIME_SPAN_SECOND;
+  do { iterate (); g_usleep (1000); } while (!done_count && g_get_monotonic_time () < end);
+  g_assert_cmpuint (done_count, ==, 1);
+  g_assert_false (gtk_widget_get_mapped (window));
+  g_object_unref (editor);
+}
+
+/* A private upstream test NM service owns these synthetic profiles. The UI,
+ * libnm, page validation and add/commit callbacks are the production code. */
+static void saved (NetConnectionEditor *editor, gboolean success, guint *count)
+{
+  g_assert_true (success);
+  (*count)++;
+}
+
+static void wait_for (gboolean (*condition) (gpointer), gpointer data)
+{
+  gint64 end = g_get_monotonic_time () + 5 * G_TIME_SPAN_SECOND;
+  do { iterate (); g_usleep (1000); } while (!condition (data) && g_get_monotonic_time () < end);
+  g_assert_true (condition (data));
+}
+
+static gboolean choices_ready (gpointer data) { return named (data, "luma-network-pages") != NULL; }
+static gboolean is_sensitive (gpointer data) { return gtk_widget_get_sensitive (data); }
+static gboolean is_insensitive (gpointer data) { return !gtk_widget_get_sensitive (data); }
+static gboolean done (gpointer data) { return *(guint *) data == 1; }
+
+static void capture (GtkWidget *window, const char *name)
+{
+  const char *directory = g_getenv ("LUMA_NETWORK_EDITOR_EVIDENCE_DIR");
+  if (!directory) return;
+  g_autoptr (GdkPaintable) paintable = gtk_widget_paintable_new (window);
+  GtkSnapshot *snapshot = gtk_snapshot_new ();
+  gdk_paintable_snapshot (paintable, GDK_SNAPSHOT (snapshot), gtk_widget_get_width (window), gtk_widget_get_height (window));
+  g_autoptr (GskRenderNode) node = gtk_snapshot_free_to_node (snapshot);
+  g_assert_nonnull (node);
+  g_autoptr (GdkTexture) texture = gsk_renderer_render_texture (gtk_native_get_renderer (GTK_NATIVE (window)), node, NULL);
+  g_autofree char *path = g_build_filename (directory, name, NULL);
+  g_assert_true (gdk_texture_save_to_png (texture, path));
+}
+
+static GtkEditable *wifi_ssid_entry (GtkNotebook *notebook)
+{
+  GtkWidget *page = gtk_notebook_get_nth_page (notebook, 1);
+  GObject *entry = gtk_widget_get_template_child (page, G_OBJECT_TYPE (page), "ssid_entry");
+  g_assert_true (GTK_IS_EDITABLE (entry));
+  return GTK_EDITABLE (entry);
+}
+
+static void native_wifi_pages_and_save (void)
+{
+  NMTstcServiceInfo *service = nmtstc_service_init ();
+  g_autoptr (GError) error = NULL;
+  g_autoptr (NMClient) client = nm_client_new (NULL, &error);
+  g_assert_no_error (error);
+  g_assert_true (nm_client_get_nm_running (client));
+  g_autoptr (NMConnection) connection = nm_simple_connection_new ();
+  NMSetting *base = nm_setting_connection_new ();
+  g_autofree char *uuid = nm_utils_uuid_generate ();
+  g_object_set (base, NM_SETTING_CONNECTION_ID, "Luma private test network",
+                NM_SETTING_CONNECTION_UUID, uuid,
+                NM_SETTING_CONNECTION_TYPE, NM_SETTING_WIRELESS_SETTING_NAME, NULL);
+  nm_connection_add_setting (connection, base);
+  NMSetting *wireless = nm_setting_wireless_new ();
+  g_autoptr (GBytes) ssid = g_bytes_new_static ("Luma test", 9);
+  g_object_set (wireless, NM_SETTING_WIRELESS_SSID, ssid,
+                NM_SETTING_WIRELESS_MODE, "infrastructure", NULL);
+  nm_connection_add_setting (connection, wireless);
+  g_assert_true (nm_connection_normalize (connection, NULL, NULL, &error));
+  g_assert_no_error (error);
+
+  NetConnectionEditor *editor = net_connection_editor_new (connection, NULL, NULL, client);
+  g_object_ref_sink (editor);
+  gtk_window_present (GTK_WINDOW (editor));
+  wait_for (choices_ready, editor);
+  GtkNotebook *notebook = GTK_NOTEBOOK (typed (GTK_WIDGET (editor), GTK_TYPE_NOTEBOOK));
+  g_assert_cmpint (gtk_notebook_get_n_pages (notebook), ==, 5);
+  g_assert_false (gtk_notebook_get_show_tabs (notebook));
+  for (guint i = 0; i < 5; i++) {
+    g_autofree char *key = g_strdup_printf ("page-%u", i);
+    g_assert_true (gtk_widget_activate_action (GTK_WIDGET (editor), "editor.page", "s", key));
+    iterate ();
+    g_assert_cmpint (gtk_notebook_get_current_page (notebook), ==, i);
+  }
+  const int widths[] = {360, 500, 1024, 1366};
+  gtk_widget_activate_action (GTK_WIDGET (editor), "editor.page", "s", "page-0");
+  for (guint theme = 0; theme < 2; theme++) {
+    g_autoptr (LumaSurfacePolicy) policy = luma_surface_policy_new (LUMA_SURFACE_TARGET_APPLICATION);
+    g_autoptr (GError) theme_error = NULL;
+    g_assert_true (luma_surface_policy_select (policy, theme ? "dark" : "light", &theme_error));
+    g_assert_no_error (theme_error);
+    g_assert_cmpint (adw_style_manager_get_dark (adw_style_manager_get_default ()), ==, theme);
+    for (guint i = 0; i < G_N_ELEMENTS (widths); i++) {
+      gtk_window_set_default_size (GTK_WINDOW (editor), widths[i], 540);
+      gint64 end = g_get_monotonic_time () + 150 * 1000;
+      do { iterate (); g_usleep (1000); } while (g_get_monotonic_time () < end);
+      g_autofree char *name = g_strdup_printf ("native-wifi-%u-%d.png", theme, widths[i]);
+      capture (GTK_WIDGET (editor), name);
+    }
+  }
+  /* Every native page is still present; selecting a different page and Apply
+   * reaches real libnm async save, rather than a replacement local model. */
+  GtkWidget *apply = named (GTK_WIDGET (editor), "luma-network-apply");
+  wait_for (is_sensitive, apply);
+  g_assert_true (gtk_button_get_use_underline (GTK_BUTTON (apply)));
+  guint count = 0;
+  g_signal_connect (editor, "done", G_CALLBACK (saved), &count);
+  g_assert_true (gtk_widget_activate (apply));
+  wait_for (done, &count);
+  NMRemoteConnection *stored = nm_client_get_connection_by_uuid (client, uuid);
+  g_assert_nonnull (stored);
+  g_assert_cmpstr (nm_connection_get_id (NM_CONNECTION (stored)), ==, "Luma private test network");
+  NMSettingWireless *stored_wifi = nm_connection_get_setting_wireless (NM_CONNECTION (stored));
+  g_assert_true (g_bytes_equal (nm_setting_wireless_get_ssid (stored_wifi), ssid));
+  gtk_window_destroy (GTK_WINDOW (editor));
+  g_object_unref (editor);
+  /* Editing an existing connection must retain validation, Cancel and the
+   * asynchronous remote commit path. A draft never changes the saved profile. */
+  editor = net_connection_editor_new (NM_CONNECTION (stored), NULL, NULL, client);
+  g_object_ref_sink (editor);
+  gtk_window_present (GTK_WINDOW (editor));
+  wait_for (choices_ready, editor);
+  notebook = GTK_NOTEBOOK (typed (GTK_WIDGET (editor), GTK_TYPE_NOTEBOOK));
+  GtkEditable *ssid_entry = wifi_ssid_entry (notebook);
+  gtk_editable_set_text (ssid_entry, "Luma cancelled draft");
+  iterate ();
+  g_assert_true (g_bytes_equal (nm_setting_wireless_get_ssid (stored_wifi), ssid));
+  guint cancel_count = 0;
+  g_signal_connect (editor, "done", G_CALLBACK (cancelled), &cancel_count);
+  g_assert_true (gtk_widget_activate (named (GTK_WIDGET (editor), "luma-network-cancel")));
+  wait_for (done, &cancel_count);
+  g_assert_true (g_bytes_equal (nm_setting_wireless_get_ssid (stored_wifi), ssid));
+  gtk_window_destroy (GTK_WINDOW (editor));
+  g_object_unref (editor);
+
+  editor = net_connection_editor_new (NM_CONNECTION (stored), NULL, NULL, client);
+  g_object_ref_sink (editor);
+  gtk_window_present (GTK_WINDOW (editor));
+  wait_for (choices_ready, editor);
+  notebook = GTK_NOTEBOOK (typed (GTK_WIDGET (editor), GTK_TYPE_NOTEBOOK));
+  ssid_entry = wifi_ssid_entry (notebook);
+  apply = named (GTK_WIDGET (editor), "luma-network-apply");
+  GtkWidget *wifi_page = gtk_notebook_get_nth_page (notebook, 1);
+  GtkComboBox *bssid_combo = GTK_COMBO_BOX (gtk_widget_get_template_child (wifi_page, G_OBJECT_TYPE (wifi_page), "bssid_combo"));
+  GtkEditable *bssid_entry = GTK_EDITABLE (gtk_combo_box_get_child (bssid_combo));
+  gtk_editable_set_text (bssid_entry, "invalid MAC address");
+  wait_for (is_insensitive, apply);
+  gtk_editable_set_text (bssid_entry, "");
+  gtk_editable_set_text (ssid_entry, "Luma committed draft");
+  wait_for (is_sensitive, apply);
+  g_assert_true (g_bytes_equal (nm_setting_wireless_get_ssid (stored_wifi), ssid));
+  count = 0;
+  g_signal_connect (editor, "done", G_CALLBACK (saved), &count);
+  g_assert_true (gtk_widget_activate (apply));
+  wait_for (done, &count);
+  stored = nm_client_get_connection_by_uuid (client, uuid);
+  g_autoptr (GBytes) committed_ssid = g_bytes_new_static ("Luma committed draft", 20);
+  g_assert_true (g_bytes_equal (nm_setting_wireless_get_ssid (nm_connection_get_setting_wireless (NM_CONNECTION (stored))), committed_ssid));
+  gtk_window_destroy (GTK_WINDOW (editor));
+  g_object_unref (editor);
+  nmtstc_service_cleanup (service);
+}
+
+int main (int argc, char **argv)
+{
+  g_setenv ("LIBNM_USE_SESSION_BUS", "1", TRUE);
+  g_test_init (&argc, &argv, NULL);
+  adw_init ();
+  g_set_application_name ("Settings");
+  g_autoptr (GtkApplication) application = gtk_application_new ("org.gnome.Settings", G_APPLICATION_NON_UNIQUE);
+  g_autoptr (GError) error = NULL;
+  g_assert_true (g_application_register (G_APPLICATION (application), NULL, &error));
+  g_assert_no_error (error);
+  g_application_set_default (G_APPLICATION (application));
+  gtk_window_set_default_icon_name ("org.gnome.Settings");
+  luma_init ();
+  g_test_add_func ("/luma/network-editor/native-frame-and-cancel", native_editor_frame);
+  g_test_add_func ("/luma/network-editor/native-wifi-pages-and-save", native_wifi_pages_and_save);
+  return g_test_run ();
+}
