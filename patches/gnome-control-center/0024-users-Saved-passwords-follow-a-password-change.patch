From: Project Luma <engineering@projectluma.org>
Date: Sun, 20 Sep 2026 20:00:00 -0500
Subject: [PATCH] users: Saved passwords follow a password change, or the person is told

Changing your own password goes through passwd, whose PAM stack re-keys the
login keyring with it -- normally. When that does not happen, and it does
not when the keyring daemon was out of reach or when an account and its
keyring never matched in the first place, the person meets "the login
keyring did not get unlocked" at every login from then on, with nothing to
say why or what to do.

Settings now checks rather than assumes. If the keyring opens with the new
password there was nothing to do. If it does not but still opens with the
old one, Settings changes it over here -- this is the one moment where both
passwords are in hand. If neither works, the person is told at once, where
they made the change, instead of finding out at their next login.

Neither password is kept, logged or written anywhere: they are the
arguments of one D-Bus call.
diff --git a/panels/system/users/cc-password-dialog.c b/panels/system/users/cc-password-dialog.c
index ae1b3b9..c70216a 100644
--- a/panels/system/users/cc-password-dialog.c
+++ b/panels/system/users/cc-password-dialog.c
@@ -116,6 +116,112 @@ update_password_strength (CcPasswordDialog *self)
         return accept;
 }
 
+/* Luma: the saved passwords follow the account password.
+ *
+ * Changing your own password goes through passwd, whose PAM stack has
+ * pam_gnome_keyring with use_authtok, so the login keyring is normally
+ * re-keyed at the same moment. Normally is not always: the keyring daemon may
+ * not have been reachable, or the account and its keyring may never have
+ * matched (an installer that made one with one password and the other with
+ * another). The person then meets a prompt at every login from then on, with
+ * no idea why.
+ *
+ * So Settings checks rather than assumes. If the keyring opens with the new
+ * password, nothing was needed. If it does not, and it still opens with the
+ * old one, Settings changes it over here -- it has both passwords in hand,
+ * for this one moment, and nowhere else does. If neither works, the person is
+ * told plainly instead of finding out at their next login.
+ */
+#define LUMA_SECRETS_NAME "org.freedesktop.secrets"
+#define LUMA_SECRETS_PATH "/org/freedesktop/secrets"
+#define LUMA_SECRETS_SERVICE "org.freedesktop.Secret.Service"
+#define LUMA_SECRETS_LOGIN "/org/freedesktop/secrets/collection/login"
+#define LUMA_KEYRING_IFACE "org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface"
+
+static GVariant *
+luma_keyring_secret (GDBusConnection *bus,
+                     const char      *session,
+                     const char      *password)
+{
+        GVariantBuilder value;
+
+        g_variant_builder_init (&value, G_VARIANT_TYPE ("ay"));
+        for (const char *p = password; *p; p++)
+                g_variant_builder_add (&value, "y", (guchar) *p);
+
+        return g_variant_new ("(o@ay@ays)", session,
+                              g_variant_new_array (G_VARIANT_TYPE_BYTE, NULL, 0),
+                              g_variant_builder_end (&value),
+                              "text/plain");
+}
+
+static gboolean
+luma_keyring_follows_password (const char *old_password,
+                               const char *new_password)
+{
+        g_autoptr (GDBusConnection) bus = NULL;
+        g_autoptr (GVariant) opened = NULL;
+        g_autoptr (GError) error = NULL;
+        g_autofree char *session = NULL;
+        g_autoptr (GVariant) unlocked = NULL;
+
+        bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, &error);
+        if (!bus)
+                return TRUE;  /* No session bus: nothing to keep in step. */
+
+        opened = g_dbus_connection_call_sync (bus, LUMA_SECRETS_NAME, LUMA_SECRETS_PATH,
+                                              LUMA_SECRETS_SERVICE, "OpenSession",
+                                              g_variant_new ("(sv)", "plain",
+                                                             g_variant_new_string ("")),
+                                              G_VARIANT_TYPE ("(vo)"),
+                                              G_DBUS_CALL_FLAGS_NONE, 20000, NULL, &error);
+        if (!opened) {
+                g_debug ("Luma: no keyring to follow the password change: %s",
+                         error->message);
+                return TRUE;  /* No keyring at all: nothing is out of step. */
+        }
+        g_variant_get_child (opened, 1, "o", &session);
+
+        unlocked = g_dbus_connection_call_sync (bus, LUMA_SECRETS_NAME, LUMA_SECRETS_PATH,
+                                                LUMA_KEYRING_IFACE, "UnlockWithMasterPassword",
+                                                g_variant_new ("(o@(oayays))", LUMA_SECRETS_LOGIN,
+                                                               luma_keyring_secret (bus, session, new_password)),
+                                                NULL, G_DBUS_CALL_FLAGS_NONE, 20000, NULL, &error);
+        if (unlocked)
+                return TRUE;  /* Already in step, by PAM or by never differing. */
+
+        g_clear_error (&error);
+        unlocked = g_dbus_connection_call_sync (bus, LUMA_SECRETS_NAME, LUMA_SECRETS_PATH,
+                                                LUMA_KEYRING_IFACE, "ChangeWithMasterPassword",
+                                                g_variant_new ("(o@(oayays)@(oayays))", LUMA_SECRETS_LOGIN,
+                                                               luma_keyring_secret (bus, session, old_password),
+                                                               luma_keyring_secret (bus, session, new_password)),
+                                                NULL, G_DBUS_CALL_FLAGS_NONE, 20000, NULL, &error);
+        if (unlocked)
+                return TRUE;
+
+        g_warning ("Luma: the login keyring still uses the old password: %s",
+                   error ? error->message : "unknown");
+        return FALSE;
+}
+
+static void
+luma_say_keyring_is_behind (CcPasswordDialog *self)
+{
+        AdwDialog *dialog;
+
+        dialog = adw_alert_dialog_new (_("Saved passwords still use your old password"),
+                                       _("Your password has been changed. The keyring holding "
+                                         "saved Wi-Fi passwords and website logins could not be "
+                                         "changed with it, so you will be asked for the old one "
+                                         "when you log in. Saved Passwords can put that right."));
+        adw_alert_dialog_add_responses (ADW_ALERT_DIALOG (dialog),
+                                        "ok", _("_OK"),
+                                        NULL);
+        adw_alert_dialog_set_default_response (ADW_ALERT_DIALOG (dialog), "ok");
+        adw_dialog_present (dialog, GTK_WIDGET (self));
+}
+
 static void
 password_changed_cb (PasswdHandler    *handler,
                      GError           *error,
@@ -128,6 +234,17 @@ password_changed_cb (PasswdHandler    *handler,
         gtk_widget_set_sensitive (GTK_WIDGET (self), TRUE);
 
         if (!error) {
+                const gchar *old_password, *new_password;
+
+                /* Luma: the saved passwords come along, or the person is told. */
+                old_password = gtk_editable_get_text (GTK_EDITABLE (self->old_password_entry));
+                new_password = gtk_editable_get_text (GTK_EDITABLE (self->password_entry));
+                if (!luma_keyring_follows_password (old_password, new_password)) {
+                        luma_say_keyring_is_behind (self);
+                        adw_dialog_close (ADW_DIALOG (self));
+                        return;
+                }
+
                 adw_dialog_close (ADW_DIALOG (self));
                 return;
         }
