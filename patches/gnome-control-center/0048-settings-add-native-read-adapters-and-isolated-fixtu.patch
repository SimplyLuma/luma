diff --git a/shell/cc-luma-discovery.c b/shell/cc-luma-discovery.c
index 88ec891..8d16231 100644
--- a/shell/cc-luma-discovery.c
+++ b/shell/cc-luma-discovery.c
@@ -140,3 +140,28 @@ guint cc_luma_search_place_count (CcLumaFixture *model)
   for (GList *i = names; i; i = i->next) if (json_object_get_boolean_member (places, i->data)) count++;
   return count;
 }
+gboolean cc_luma_search_add_place (CcLumaFixture *model, const char *uri, GError **error)
+{
+  if (!cc_luma_search_validate (model) || !uri || !g_str_has_prefix (uri, "file:///")) return invalid (error);
+  g_autoptr (GUri) parsed = g_uri_parse (uri, G_URI_FLAGS_NONE, NULL);
+  if (!parsed || g_uri_get_query (parsed) || g_uri_get_fragment (parsed) ||
+      (g_uri_get_host (parsed) && *g_uri_get_host (parsed))) return invalid (error);
+  g_autoptr (GFile) file = g_file_new_for_uri (uri);
+  g_autofree char *path = g_file_get_path (file);
+  if (!path || !g_path_is_absolute (path)) return invalid (error);
+  g_autofree char *canonical = g_file_get_uri (file);
+  JsonObject *places = json_node_get_object (cc_luma_fixture_get (model, "sl"));
+  /* Only the chosen folder changes. This is fixture memory, never a write
+   * to the filesystem or the live search indexer's settings. */
+  json_object_set_boolean_member (places, canonical, TRUE);
+  return TRUE;
+}
+gboolean cc_luma_search_set_place (CcLumaFixture *model, const char *id, gboolean enabled, GError **error)
+{
+  if (!cc_luma_search_validate (model) || !id) return invalid (error);
+  JsonObject *places = json_node_get_object (cc_luma_fixture_get (model, "sl"));
+  if (!json_object_has_member (places, id)) return invalid (error);
+  /* URI keys may contain dots; they are identities, not fixture key paths. */
+  json_object_set_boolean_member (places, id, enabled);
+  return TRUE;
+}
