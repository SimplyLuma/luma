diff --git a/shell/cc-luma-displays.c b/shell/cc-luma-displays.c
index 8571c83..03ba4de 100644
--- a/shell/cc-luma-displays.c
+++ b/shell/cc-luma-displays.c
@@ -54,7 +54,7 @@ gboolean cc_luma_displays_validate (CcLumaFixture *model)
       !string_in (cc_luma_fixture_get (model, "dsel"), ids) ||
       !string_in (cc_luma_fixture_get (model, "arr.side"), sides)) return FALSE;
   JsonNode *offset = cc_luma_fixture_get (model, "arr.off");
-  if (!offset || json_node_get_value_type (offset) != G_TYPE_DOUBLE || !isfinite (json_node_get_double (offset)) || json_node_get_double (offset) < 0 || json_node_get_double (offset) > 1) return FALSE;
+  if (!offset || json_node_get_value_type (offset) != G_TYPE_DOUBLE || !isfinite (json_node_get_double (offset)) || json_node_get_double (offset) < -.2 || json_node_get_double (offset) > 1.2) return FALSE;
   JsonObject *catalog = json_node_get_object (catalog_node);
   guint primary = 0;
   for (guint i = 0; ids[i]; i++) {
@@ -166,3 +166,55 @@ gboolean cc_luma_display_draft_tick (CcLumaDisplayDraft *draft, GError **error)
 }
 void cc_luma_display_draft_keep (CcLumaDisplayDraft *draft) { draft->remaining = 0; g_hash_table_remove_all (draft->original); }
 void cc_luma_display_draft_free (CcLumaDisplayDraft *draft) { if (!draft) return; g_object_unref (draft->model); g_hash_table_unref (draft->original); g_free (draft); }
+
+static const char * const schedules[] = { "sun", "manual", NULL };
+static const char * const from_times[] = { "19:00", "20:00", "21:00", "22:00", "23:00", NULL };
+static const char * const to_times[] = { "05:30", "06:00", "06:30", "07:00", "08:00", NULL };
+gboolean cc_luma_night_validate (CcLumaFixture *model)
+{
+  JsonNode *enabled = cc_luma_fixture_get (model, "night"), *temperature = cc_luma_fixture_get (model, "nightT");
+  return enabled && json_node_get_value_type (enabled) == G_TYPE_BOOLEAN &&
+    temperature && json_node_get_value_type (temperature) == G_TYPE_INT64 &&
+    json_node_get_int (temperature) >= 0 && json_node_get_int (temperature) <= 100 &&
+    string_in (cc_luma_fixture_get (model, "nightWhen"), schedules) &&
+    string_in (cc_luma_fixture_get (model, "nightFrom"), from_times) &&
+    string_in (cc_luma_fixture_get (model, "nightTo"), to_times);
+}
+gboolean cc_luma_night_set_choice (CcLumaFixture *model, const char *key, const char *value, GError **error)
+{
+  if (!cc_luma_night_validate (model) || !key || !value) return invalid (error);
+  const char * const *choices = g_str_equal (key, "nightWhen") ? schedules :
+    g_str_equal (key, "nightFrom") ? from_times : g_str_equal (key, "nightTo") ? to_times : NULL;
+  g_autoptr (JsonNode) node = json_node_init_string (json_node_alloc (), value);
+  if (!choices || !string_in (node, choices)) return invalid (error);
+  return cc_luma_fixture_set (model, key, node, error);
+}
+gboolean cc_luma_night_set_temperature (CcLumaFixture *model, gint64 value, GError **error)
+{
+  if (!cc_luma_night_validate (model) || value < 0 || value > 100) return invalid (error);
+  g_autoptr (JsonNode) node = json_node_init_int (json_node_alloc (), value);
+  return cc_luma_fixture_set (model, "nightT", node, error);
+}
+static double time_hours (const char *text)
+{
+  return g_ascii_strtod (text, NULL) + g_ascii_strtod (text + 3, NULL) / 60;
+}
+gboolean cc_luma_night_spans (CcLumaFixture *model, double sunset, double sunrise, CcLumaNightSpan spans[2], guint *count, GError **error)
+{
+  if (!cc_luma_night_validate (model)) return invalid (error);
+  double from = sunset, to = sunrise;
+  if (g_str_equal (json_node_get_string (cc_luma_fixture_get (model, "nightWhen")), "manual")) {
+    from = time_hours (json_node_get_string (cc_luma_fixture_get (model, "nightFrom")));
+    to = time_hours (json_node_get_string (cc_luma_fixture_get (model, "nightTo")));
+  } else if (!isfinite (sunset) || !isfinite (sunrise) || sunset < 0 || sunset > 24 || sunrise < 0 || sunrise > 24) {
+    return invalid (error);
+  }
+  if (from > to) {
+    spans[0] = (CcLumaNightSpan) { from / 24, (24 - from) / 24 };
+    spans[1] = (CcLumaNightSpan) { 0, to / 24 }; *count = 2;
+  } else {
+    spans[0] = (CcLumaNightSpan) { from / 24, (to - from) / 24 };
+    spans[1] = (CcLumaNightSpan) { 0, 0 }; *count = 1;
+  }
+  return TRUE;
+}
