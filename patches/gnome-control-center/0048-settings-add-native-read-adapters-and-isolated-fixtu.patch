+JsonNode *cc_luma_audio_dup_snapshot (CcLumaAudio *self);
+G_END_DECLS
diff --git a/shell/cc-luma-device-options.c b/shell/cc-luma-device-options.c
new file mode 100644
index 0000000..d0b36ac
--- /dev/null
+++ b/shell/cc-luma-device-options.c
@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-device-options.h"
+#include <gio/gio.h>
+
+typedef struct { const char *key; GType type; gint64 low, high; const char *choices[10]; } Field;
+/* Catalogues are the actual v70 control values. No battery, device or service
+ * capability is inferred from a preference. Production metadata stays native. */
+static const Field power[] = {
+  { "pmode", G_TYPE_STRING, 0, 0, { "perf", "bal", "save", NULL } },
+  { "charge", G_TYPE_STRING, 0, 0, { "max", "health", NULL } },
+  { "pbtn", G_TYPE_STRING, 0, 0, { "suspend", "off", "nothing", NULL } },
+  { "blank", G_TYPE_STRING, 0, 0, { "1", "2", "3", "5", "8", "10", "15", "0", NULL } },
+  { "susBatD", G_TYPE_STRING, 0, 0, { "15", "20", "30", "60", NULL } },
+  { "susAcD", G_TYPE_STRING, 0, 0, { "30", "60", "120", NULL } },
+  { .key = "pct", .type = G_TYPE_BOOLEAN }, { .key = "autoBright", .type = G_TYPE_BOOLEAN },
+  { .key = "dim", .type = G_TYPE_BOOLEAN }, { .key = "autoSaver", .type = G_TYPE_BOOLEAN },
+  { .key = "susBat", .type = G_TYPE_BOOLEAN }, { .key = "susAc", .type = G_TYPE_BOOLEAN },
+};
+static const Field pointer[] = {
+  { "mtab", G_TYPE_STRING, 0, 0, { "mouse", "touchpad", NULL } },
+  { "mBtn", G_TYPE_STRING, 0, 0, { "left", "right", NULL } },
+  { .key = "mSpeed", .type = G_TYPE_INT64, .low = -100, .high = 100 },
+  { .key = "tSpeed", .type = G_TYPE_INT64, .low = -100, .high = 100 },
+  { .key = "mAccel", .type = G_TYPE_BOOLEAN }, { .key = "mNat", .type = G_TYPE_BOOLEAN },
+  { .key = "tp", .type = G_TYPE_BOOLEAN }, { .key = "tpType", .type = G_TYPE_BOOLEAN },
+  { .key = "tTap", .type = G_TYPE_BOOLEAN }, { .key = "tNat", .type = G_TYPE_BOOLEAN },
+  { "tSec", G_TYPE_STRING, 0, 0, { "two", "corner", NULL } },
+  { "tScroll", G_TYPE_STRING, 0, 0, { "two", "edge", NULL } },
+};
+static gboolean allowed (const Field *field, JsonNode *value)
+{
+  if (!value || json_node_get_value_type (value) != field->type) return FALSE;
+  if (field->type == G_TYPE_BOOLEAN) return TRUE;
+  if (field->type == G_TYPE_INT64)
+    return json_node_get_int (value) >= field->low && json_node_get_int (value) <= field->high;
+  for (guint i = 0; field->choices[i]; i++)
+    if (g_str_equal (field->choices[i], json_node_get_string (value))) return TRUE;
+  return FALSE;
+}
+static gboolean validate (CcLumaFixture *model, const Field *fields, guint length)
+{
+  for (guint i = 0; i < length; i++)
+    if (!allowed (&fields[i], cc_luma_fixture_get (model, fields[i].key))) return FALSE;
+  return TRUE;
+}
+static gboolean set (CcLumaFixture *model, const Field *fields, guint length,
+                     const char *key, JsonNode *value, GError **error)
+{
+  if (key && validate (model, fields, length))
+    for (guint i = 0; i < length; i++)
+      if (g_str_equal (key, fields[i].key) && allowed (&fields[i], value))
+        return cc_luma_fixture_set (model, key, value, error);
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid Settings device preference");
+  return FALSE;
+}
+gboolean cc_luma_power_validate (CcLumaFixture *model) { return validate (model, power, G_N_ELEMENTS (power)); }
+gboolean cc_luma_power_fixture_validate (CcLumaFixture *model)
+{
+  if (!cc_luma_power_validate (model)) return FALSE;
+  JsonObject *data = cc_luma_fixture_get_data (model);
+  JsonNode *facts = json_object_get_member (data, "CFPOWER");
+  JsonNode *minutes = json_object_get_member (data, "CFMINS");
+  if (!facts || !JSON_NODE_HOLDS_OBJECT (facts) || !minutes || !JSON_NODE_HOLDS_ARRAY (minutes)) return FALSE;
+  JsonObject *object = json_node_get_object (facts);
+  JsonNode *status = json_object_get_member (object, "status");
+  JsonNode *devices = json_object_get_member (object, "devices");
+  if (!status || json_node_get_value_type (status) != G_TYPE_STRING ||
+      !devices || !JSON_NODE_HOLDS_ARRAY (devices)) return FALSE;
+  JsonArray *array = json_node_get_array (devices);
+  for (guint i = 0; i < json_array_get_length (array); i++) {
+    JsonNode *item = json_array_get_element (array, i);
+    if (!JSON_NODE_HOLDS_OBJECT (item)) return FALSE;
+    const char *keys[] = { "name", "icon" };
+    for (guint k = 0; k < G_N_ELEMENTS (keys); k++) {
+      JsonNode *node = json_object_get_member (json_node_get_object (item), keys[k]);
+      if (!node || json_node_get_value_type (node) != G_TYPE_STRING || !*json_node_get_string (node)) return FALSE;
+    }
+    JsonNode *level = json_object_get_member (json_node_get_object (item), "percentage");
+    if (!level || json_node_get_value_type (level) != G_TYPE_INT64 || json_node_get_int (level) < 0 || json_node_get_int (level) > 100) return FALSE;
+  }
+  array = json_node_get_array (minutes);
+  g_autoptr(GHashTable) seen = g_hash_table_new (g_str_hash, g_str_equal);
+  for (guint i = 0; i < json_array_get_length (array); i++) {
+    JsonNode *item = json_array_get_element (array, i);
+    if (!JSON_NODE_HOLDS_ARRAY (item)) return FALSE;
+    JsonArray *pair = json_node_get_array (item);
+    if (json_array_get_length (pair) != 2) return FALSE;
+    for (guint k = 0; k < 2; k++)
+      if (json_node_get_value_type (json_array_get_element (pair, k)) != G_TYPE_STRING) return FALSE;
+    const char *key = json_array_get_string_element (pair, 0);
+    gboolean known = FALSE;
+    for (guint k = 0; power[3].choices[k]; k++) if (g_str_equal (key, power[3].choices[k])) known = TRUE;
+    if (!known || !*json_array_get_string_element (pair, 1) || !g_hash_table_add (seen, (gpointer) key)) return FALSE;
+  }
+  return g_hash_table_size (seen) == 8;
+}
+gboolean cc_luma_power_set (CcLumaFixture *model, const char *key, JsonNode *value, GError **error) { return set (model, power, G_N_ELEMENTS (power), key, value, error); }
+gboolean cc_luma_pointer_validate (CcLumaFixture *model) { return validate (model, pointer, G_N_ELEMENTS (pointer)); }
+gboolean cc_luma_pointer_set (CcLumaFixture *model, const char *key, JsonNode *value, GError **error) { return set (model, pointer, G_N_ELEMENTS (pointer), key, value, error); }
