+G_END_DECLS
diff --git a/shell/cc-luma-power-reads.c b/shell/cc-luma-power-reads.c
new file mode 100644
index 0000000..6a54f2b
--- /dev/null
+++ b/shell/cc-luma-power-reads.c
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-power-reads.h"
+#include "cc-object-storage.h"
+#include <math.h>
+
+#define DEVICE_PREFIX "/org/freedesktop/UPower/devices/"
+typedef struct { gboolean history; char *owner; } Read;
+static void read_free (Read *read) { g_free (read->owner); g_free (read); }
+static gboolean device_path_valid (const char *path)
+{
+  return path && g_variant_is_object_path (path) && g_str_has_prefix (path, DEVICE_PREFIX) && path[sizeof DEVICE_PREFIX - 1];
+}
+static gboolean invalid (GError **error, const char *message)
+{
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, message);
+  return FALSE;
+}
+gboolean cc_luma_power_history_validate (GVariant *history, GError **error)
+{
+  if (!history || !g_variant_is_of_type (history, G_VARIANT_TYPE ("a(udu)")))
+    return invalid (error, "Invalid UPower charge history type");
+  guint32 previous = 0;
+  for (gsize i = 0; i < g_variant_n_children (history); i++) {
+    guint32 time, state; double charge;
+    g_variant_get_child (history, i, "(udu)", &time, &charge, &state);
+    if (!isfinite (charge) || charge < 0 || charge > 100 || (i && time < previous))
+      return invalid (error, "Invalid UPower charge history sample");
+    /* Keep real timestamps and states, including gaps and unknown states.
+     * No interpolation or invented hourly sample enters the live model. */
+    previous = time;
+  }
+  return TRUE;
+}
+gboolean cc_luma_power_devices_validate (GVariant *devices, GError **error)
+{
+  if (!devices || !g_variant_is_of_type (devices, G_VARIANT_TYPE ("ao")))
+    return invalid (error, "Invalid UPower device catalogue type");
+  g_autoptr(GHashTable) seen = g_hash_table_new (g_str_hash, g_str_equal);
+  for (gsize i = 0; i < g_variant_n_children (devices); i++) {
+    const char *path;
+    g_variant_get_child (devices, i, "&o", &path);
+    if (!device_path_valid (path) || !g_hash_table_add (seen, (gpointer) path))
+      return invalid (error, "Invalid or duplicate UPower device path");
+  }
+  return TRUE;
+}
+static void read_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr(GTask) task = data;
+  Read *read = g_task_get_task_data (task);
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GVariant) reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+  if (g_task_return_error_if_cancelled (task)) return;
+  if (!reply) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  g_autofree char *owner = g_dbus_proxy_get_name_owner (G_DBUS_PROXY (source));
+  if (g_strcmp0 (owner, read->owner) != 0) {
+    g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED, "UPower owner changed during the read"); return;
+  }
+  const GVariantType *type = read->history ? G_VARIANT_TYPE ("(a(udu))") : G_VARIANT_TYPE ("(ao)");
+  if (!g_variant_is_of_type (reply, type)) {
+    g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Invalid UPower read reply"); return;
+  }
+  g_autoptr(GVariant) payload = g_variant_get_child_value (reply, 0);
+  gboolean valid = read->history ? cc_luma_power_history_validate (payload, &error) : cc_luma_power_devices_validate (payload, &error);
+  if (!valid) g_task_return_error (task, g_steal_pointer (&error));
+  else g_task_return_pointer (task, g_steal_pointer (&payload), (GDestroyNotify) g_variant_unref);
+}
+static void proxy_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr(GTask) task = data;
+  Read *read = g_task_get_task_data (task);
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GDBusProxy) proxy = cc_object_storage_create_dbus_proxy_finish (result, &error);
+  if (g_task_return_error_if_cancelled (task)) return;
+  if (!proxy) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  read->owner = g_dbus_proxy_get_name_owner (proxy);
+  if (!read->owner) {
+    g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED, "Native UPower service is unavailable"); return;
+  }
+  /* Exact native signatures: https://upower.freedesktop.org/docs/Device.html
+   * and https://upower.freedesktop.org/docs/UPower.html. */
+  g_dbus_proxy_call (proxy, read->history ? "GetHistory" : "EnumerateDevices",
+    read->history ? g_variant_new ("(suu)", "charge", 86400u, 24u) : NULL,
+    G_DBUS_CALL_FLAGS_NO_AUTO_START, 5000, g_task_get_cancellable (task), read_done, g_object_ref (task));
+}
+static void start (const char *path, gboolean history, GCancellable *cancel, GAsyncReadyCallback callback, gpointer data)
+{
+  g_autoptr(GTask) task = g_task_new (NULL, cancel, callback, data);
+  g_task_set_source_tag (task, cc_luma_power_read_finish);
+  if (g_getenv ("LUMA_SETTINGS_FIXTURE") != NULL || (history && !device_path_valid (path))) {
+    g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Native UPower read refused in fixture mode or for an invalid device"); return;
+  }
+  if (g_task_return_error_if_cancelled (task)) return;
+  Read *read = g_new0 (Read, 1); read->history = history;
+  g_task_set_task_data (task, read, (GDestroyNotify) read_free);
+  cc_object_storage_create_dbus_proxy (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START,
+    "org.freedesktop.UPower", history ? path : "/org/freedesktop/UPower",
+    history ? "org.freedesktop.UPower.Device" : "org.freedesktop.UPower", cancel, proxy_ready, g_object_ref (task));
+}
+void cc_luma_power_enumerate_async (GCancellable *cancel, GAsyncReadyCallback callback, gpointer data) { start (NULL, FALSE, cancel, callback, data); }
+void cc_luma_power_history_async (const char *path, GCancellable *cancel, GAsyncReadyCallback callback, gpointer data) { start (path, TRUE, cancel, callback, data); }
+GVariant *cc_luma_power_read_finish (GAsyncResult *result, GError **error)
+{
+  g_return_val_if_fail (G_IS_TASK (result) && g_task_get_source_tag (G_TASK (result)) == cc_luma_power_read_finish, NULL);
+  return g_task_propagate_pointer (G_TASK (result), error);
+}
diff --git a/shell/cc-luma-power-reads.h b/shell/cc-luma-power-reads.h
new file mode 100644
index 0000000..1610cd9
--- /dev/null
