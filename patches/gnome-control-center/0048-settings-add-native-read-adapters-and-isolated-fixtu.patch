diff --git a/shell/cc-luma-view-displays.c b/shell/cc-luma-view-displays.c
new file mode 100644
index 0000000..ebc7e37
--- /dev/null
+++ b/shell/cc-luma-view-displays.c
@@ -0,0 +1,265 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view-private.h"
+#include <math.h>
+
+/* App-owned display diagram: allocation matches cfArr, while the shared kit
+ * owns its controls and text. The 560px coordinate space clips at phone width,
+ * as v70 does. A custom layout avoids imposing that width on the window. */
+typedef struct { GtkWidget parent; CcLumaFixture *model; GtkWidget *monitors[2]; CcLumaPreviewRect rects[2]; double offset, dx, dy; gboolean mirror; } Arrangement;
+typedef struct { GtkWidgetClass parent; } ArrangementClass;
+GType cc_luma_arrangement_get_type (void);
+G_DEFINE_TYPE (Arrangement, cc_luma_arrangement, GTK_TYPE_WIDGET)
+static guint arrangement_signals[2];
+static void arrangement_measure (GtkWidget *widget, GtkOrientation orientation, int for_size, int *minimum, int *natural, int *min_baseline, int *nat_baseline)
+{
+  *minimum = orientation == GTK_ORIENTATION_HORIZONTAL ? 0 : 216;
+  *natural = orientation == GTK_ORIENTATION_HORIZONTAL ? 560 : 216;
+  *min_baseline = *nat_baseline = -1;
+}
+static void arrangement_allocate (GtkWidget *widget, int width, int height, int baseline)
+{
+  Arrangement *self = (Arrangement *) widget;
+  self->offset = MAX (0, (width - 560) / 2.0);
+  for (guint i = 0; i < (self->mirror ? 1 : 2); i++) {
+    CcLumaPreviewRect r = self->rects[i];
+    graphene_point_t point = GRAPHENE_POINT_INIT (r.x + self->offset + (i ? self->dx : 0), r.y + (i ? self->dy : 0));
+    gtk_widget_allocate (self->monitors[i], (int) r.width, (int) r.height, -1, gsk_transform_translate (NULL, &point));
+  }
+}
+static void arrangement_snapshot (GtkWidget *widget, GtkSnapshot *snapshot)
+{
+  Arrangement *self = (Arrangement *) widget;
+  for (guint i = 0; i < (self->mirror ? 1 : 2); i++) gtk_widget_snapshot_child (widget, self->monitors[i], snapshot);
+}
+static void arrangement_dispose (GObject *object)
+{
+  Arrangement *self = (Arrangement *) object;
+  for (guint i = 0; i < 2; i++) if (self->monitors[i]) { gtk_widget_unparent (self->monitors[i]); self->monitors[i] = NULL; }
+  g_clear_object (&self->model); G_OBJECT_CLASS (cc_luma_arrangement_parent_class)->dispose (object);
+}
+static void monitor_clicked (GtkButton *button, Arrangement *self)
+{
+  if (!self->mirror) g_signal_emit (self, arrangement_signals[0], 0, g_object_get_data (G_OBJECT (button), "cf-display"));
+}
+static void drag_update (GtkGestureDrag *gesture, double dx, double dy, Arrangement *self)
+{
+  if (self->mirror) return;
+  if (fabs (dx) + fabs (dy) > 3) gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_CLAIMED);
+  self->dx = dx; self->dy = dy; gtk_widget_queue_allocate (GTK_WIDGET (self));
+}
+static void drag_end (GtkGestureDrag *gesture, double dx, double dy, Arrangement *self)
+{
+  if (self->mirror || fabs (dx) + fabs (dy) <= 3) return;
+  CcLumaPreviewRect a = self->rects[0], b = self->rects[1];
+  double iw = a.width + 4, ih = a.height + 4, ew = b.width + 4, eh = b.height + 4;
+  double x = b.x + dx, y = b.y + dy;
+  double cx = x + ew / 2 - (a.x + iw / 2), cy = y + eh / 2 - (a.y + ih / 2);
+  const char *side = fabs (cy) / (ih + eh) > fabs (cx) / (iw + ew) && cy < 0 ? "top" : cx < 0 ? "left" : "right";
+  double denominator = g_str_equal (side, "top") ? iw - ew : ih - eh;
+  double off = (g_str_equal (side, "top") ? x - a.x : y - a.y) / (denominator ? denominator : 1);
+  self->dx = self->dy = 0;
+  g_signal_emit (self, arrangement_signals[1], 0, side, CLAMP (isfinite (off) ? off : .5, -.2, 1.2));
+}
+static void cc_luma_arrangement_class_init (ArrangementClass *klass)
+{
+  G_OBJECT_CLASS (klass)->dispose = arrangement_dispose;
+  GtkWidgetClass *widget = GTK_WIDGET_CLASS (klass);
+  widget->measure = arrangement_measure; widget->size_allocate = arrangement_allocate; widget->snapshot = arrangement_snapshot;
+  arrangement_signals[0] = g_signal_new ("selected", G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL, G_TYPE_NONE, 1, G_TYPE_STRING);
+  arrangement_signals[1] = g_signal_new ("arranged", G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL, G_TYPE_NONE, 2, G_TYPE_STRING, G_TYPE_DOUBLE);
+}
+static void cc_luma_arrangement_init (Arrangement *self) { gtk_widget_set_overflow (GTK_WIDGET (self), GTK_OVERFLOW_HIDDEN); }
+static GtkWidget *arrangement_new (View *v)
+{
+  Arrangement *self = g_object_new (cc_luma_arrangement_get_type (), NULL);
+  self->model = g_object_ref (v->model);
+  self->mirror = g_str_equal (cc_luma_view_text (v, "join"), "mirror");
+  cc_luma_displays_rects (v->model, self->rects, NULL);
+  gtk_widget_set_name (GTK_WIDGET (self), "cf-arr");
+  for (guint i = 0; i < (self->mirror ? 1 : 2); i++) {
+    const char *id = i ? "ext" : "int";
+    GtkWidget *content = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+    GtkWidget *title = cc_luma_view_label (self->mirror ? "Both" : i ? "Dell" : "Built-in", "label", FALSE);
+    gtk_label_set_xalign (GTK_LABEL (title), .5);
+    gtk_box_append (GTK_BOX (content), title);
+    g_autofree char *key = g_strdup_printf ("d.%s.primary", id);
+    GtkWidget *sub = cc_luma_view_label (self->mirror ? "3840 × 2160" : cc_luma_view_flag (v, key) ? "Main" : "", "caption", TRUE);
+    gtk_label_set_xalign (GTK_LABEL (sub), .5); gtk_box_append (GTK_BOX (content), sub);
+    GtkWidget *button = gtk_toggle_button_new ();
+    gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (button), self->mirror || g_str_equal (cc_luma_view_text (v, "dsel"), id));
+    gtk_button_set_child (GTK_BUTTON (button), content);
+    gtk_widget_set_name (button, i ? "cf-display-ext" : "cf-display-int");
+    g_object_set_data (G_OBJECT (button), "cf-display", (gpointer) id);
+    g_signal_connect_object (button, "clicked", G_CALLBACK (monitor_clicked), self, 0);
+    gtk_widget_set_parent (button, GTK_WIDGET (self)); self->monitors[i] = button;
+    if (i) {
+      GtkGesture *drag = gtk_gesture_drag_new ();
+      g_signal_connect_object (drag, "drag-update", G_CALLBACK (drag_update), self, 0);
+      g_signal_connect_object (drag, "drag-end", G_CALLBACK (drag_end), self, 0);
+      gtk_widget_add_controller (button, GTK_EVENT_CONTROLLER (drag));
+    }
+  }
+  return GTK_WIDGET (self);
+}
+static void display_bar (View *v);
+static gboolean display_tick (gpointer data)
+{
+  View *v = data;
+  g_autoptr (GError) error = NULL;
+  if (!cc_luma_display_draft_tick (v->display_draft, &error)) { v->display_timer = 0; cc_luma_view_report_error (v, error); return G_SOURCE_REMOVE; }
+  if (!cc_luma_display_draft_remaining (v->display_draft)) {
+    v->display_timer = 0; luma_action_center_hide_bar (v->center); cc_luma_view_queue_refresh (v);
+    luma_toast_show (v->root, "Display settings put back", "done"); return G_SOURCE_REMOVE;
+  }
+  display_bar (v); return G_SOURCE_CONTINUE;
+}
+static void display_finished (LumaBarItem *item, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view"); if (!v) return;
+  gboolean revert = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (item), "cf-revert"));
+  if (revert) {
+    g_autoptr (GError) error = NULL;
+    if (!cc_luma_display_draft_revert (v->display_draft, &error)) { cc_luma_view_report_error (v, error); return; }
+    cc_luma_view_queue_refresh (v); luma_toast_show (root, "Display settings put back", "done");
+  } else cc_luma_display_draft_keep (v->display_draft);
+  if (v->display_timer) { g_source_remove (v->display_timer); v->display_timer = 0; }
+  luma_action_center_hide_bar (v->center);
+}
+static void display_bar (View *v)
+{
+  g_autofree char *countdown = g_strdup_printf ("Going back in %u s", cc_luma_display_draft_remaining (v->display_draft));
+  g_autoptr (LumaBarItem) context = luma_bar_item_new_chip ("Keep these display settings?", NULL, FALSE);
+  g_autoptr (LumaBarItem) count = luma_bar_item_new_chip (countdown, NULL, FALSE);
+  g_autoptr (LumaBarItem) revert = luma_bar_item_new_action (NULL, "Go back", NULL);
+  g_autoptr (LumaBarItem) keep = luma_bar_item_new_action (NULL, "Keep", NULL);
+  luma_bar_item_set_primary (keep, TRUE); g_object_set_data (G_OBJECT (revert), "cf-revert", GINT_TO_POINTER (TRUE));
+  g_signal_connect_object (revert, "activated", G_CALLBACK (display_finished), v->root, 0);
+  g_signal_connect_object (keep, "activated", G_CALLBACK (display_finished), v->root, 0);
+  LumaBarItem *items[] = { count, revert, keep };
+  luma_action_center_show_bar (v->center, items, G_N_ELEMENTS (items), context);
+  if (!v->display_timer) v->display_timer = g_timeout_add (1000, display_tick, v);
+}
+static gboolean set_display (View *v, const char *key, JsonNode *value, GError **error)
+{
+  if (g_str_has_suffix (key, ".bright") || g_str_has_suffix (key, ".prof") || g_str_has_suffix (key, ".primary")) {
+    CcLumaDisplayDraft *immediate = cc_luma_display_draft_new (v->model);
+    gboolean changed = cc_luma_display_draft_set (immediate, key, value, error);
+    cc_luma_display_draft_keep (immediate); cc_luma_display_draft_free (immediate);
+    return changed;
+  }
+  if (!v->display_draft) v->display_draft = cc_luma_display_draft_new (v->model);
+  if (!cc_luma_display_draft_set (v->display_draft, key, value, error)) return FALSE;
+  if (v->display_timer) { g_source_remove (v->display_timer); v->display_timer = 0; }
+  display_bar (v); return TRUE;
+}
+gboolean cc_luma_view_displays_pick (View *v, const char *key, const char *value, GError **error)
+{
+  g_autoptr (JsonNode) node = json_node_init_string (json_node_alloc (), value);
+  return set_display (v, key, node, error);
+}
+static void segmented_changed (LumaSegmentedControl *control, const char *value, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view"); if (!v) return;
+  const char *key = g_object_get_data (G_OBJECT (control), "cf-key");
+  g_autoptr (GError) error = NULL;
+  if (cc_luma_view_displays_pick (v, key, value, &error)) cc_luma_view_queue_refresh (v); else cc_luma_view_report_error (v, error);
+}
+static GtkWidget *segments (View *v, const char *key, const char * const *values)
+{
+  GtkWidget *control = luma_segmented_control_new ();
+  for (guint i = 0; values[i]; i += 2) luma_segmented_control_append (LUMA_SEGMENTED_CONTROL (control), values[i], values[i + 1]);
+  luma_segmented_control_set_selected (LUMA_SEGMENTED_CONTROL (control), cc_luma_view_text (v, key));
+  g_autofree char *name = g_strconcat ("cf-", key, NULL); gtk_widget_set_name (control, name);
+  g_object_set_data_full (G_OBJECT (control), "cf-key", g_strdup (key), g_free);
+  g_signal_connect_object (control, "changed", G_CALLBACK (segmented_changed), v->root, 0); return control;
+}
+static void selected (Arrangement *arrangement, const char *id, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view"); if (!v) return;
+  g_autoptr (JsonNode) node = json_node_init_string (json_node_alloc (), id);
+  cc_luma_fixture_set (v->model, "dsel", node, NULL); cc_luma_view_queue_refresh (v);
+}
+static void arranged (Arrangement *arrangement, const char *side, double off, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view"); if (!v) return;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (JsonNode) offset = json_node_init_double (json_node_alloc (), off);
+  if (!cc_luma_view_displays_pick (v, "arr.side", side, &error) || !set_display (v, "arr.off", offset, &error)) cc_luma_view_report_error (v, error);
+  else cc_luma_view_queue_refresh (v);
+}
+static void flag_changed (GtkSwitch *control, GParamSpec *pspec, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view"); if (!v) return;
+  g_autoptr (JsonNode) node = json_node_init_boolean (json_node_alloc (), gtk_switch_get_active (control));
+  g_autoptr (GError) error = NULL;
+  if (set_display (v, g_object_get_data (G_OBJECT (control), "cf-key"), node, &error)) cc_luma_view_queue_refresh (v); else cc_luma_view_report_error (v, error);
+}
+static GtkWidget *flag (View *v, const char *key)
+{
+  GtkWidget *control = gtk_switch_new ();
+  gtk_switch_set_active (GTK_SWITCH (control), cc_luma_view_flag (v, key));
+  g_autofree char *name = g_strconcat ("cf-", key, NULL); gtk_widget_set_name (control, name);
+  g_object_set_data_full (G_OBJECT (control), "cf-key", g_strdup (key), g_free);
+  g_signal_connect_object (control, "notify::active", G_CALLBACK (flag_changed), v->root, 0); return control;
+}
+static void brightness_changed (GtkRange *control, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view"); if (!v) return;
+  g_autoptr (JsonNode) node = json_node_init_int (json_node_alloc (), gtk_range_get_value (control));
+  g_autoptr (GError) error = NULL;
+  if (!set_display (v, "d.int.bright", node, &error)) { cc_luma_view_report_error (v, error); return; }
+  g_autofree char *value = g_strdup_printf ("%d%%", (int) gtk_range_get_value (control));
+  gtk_label_set_text (g_object_get_data (G_OBJECT (control), "cf-output"), value);
+}
+void cc_luma_view_displays_render (View *v)
+{
+  gboolean mirror = g_str_equal (cc_luma_view_text (v, "join"), "mirror");
+  const char *id = mirror ? "ext" : cc_luma_view_text (v, "dsel");
+  const char *joining[] = { "join", "Join", "mirror", "Mirror", NULL };
+  const char *scales[] = { "100", "100%", "125", "125%", "150", "150%", "175", "175%", "200", "200%", NULL };
+  const char *rotations[] = { "Landscape", "Landscape", "Portrait right", "Portrait right", "Portrait left", "Portrait left", "Landscape, flipped", "Landscape, flipped", NULL };
+  const char *internal_profiles[] = { "Built-in, factory calibrated", "Built-in, factory calibrated", "sRGB", "sRGB", NULL };
+  const char *external_profiles[] = { "Dell U2723QE", "Dell U2723QE", "sRGB", "sRGB", "Display P3", "Display P3", NULL };
+  cc_luma_view_header (v, "Displays", mirror ? "Two displays · showing the same thing" : "Two displays · one desk across both", NULL);
+  GtkWidget *content = gtk_box_new (GTK_ORIENTATION_VERTICAL, 8);
+  GtkWidget *join = segments (v, "join", joining); gtk_widget_set_halign (join, GTK_ALIGN_CENTER); gtk_box_append (GTK_BOX (content), join);
+  GtkWidget *arrangement = arrangement_new (v);
+  g_signal_connect_object (arrangement, "selected", G_CALLBACK (selected), v->root, 0);
+  g_signal_connect_object (arrangement, "arranged", G_CALLBACK (arranged), v->root, 0);
+  gtk_box_append (GTK_BOX (content), arrangement);
+  gtk_box_append (GTK_BOX (content), cc_luma_view_label (mirror ? "Both displays show the same picture" : "Drag to match where your displays sit on the desk", "caption", TRUE));
+  GtkWidget *hero = luma_card_new (content, TRUE); luma_card_set_recessed (LUMA_CARD (hero), TRUE);
+  gtk_widget_set_margin_top (hero, 20); gtk_box_append (v->body, hero);
+  GtkBox *rows = cc_luma_view_group (v, mirror ? "Both displays" : g_str_equal (id, "ext") ? "Dell U2723QE" : "Built-in display");
+  JsonObject *catalog = json_object_get_object_member (json_object_get_object_member (cc_luma_fixture_get_data (v->model), "CFDISP"), id);
+  const char *fields[] = { "res", "hz" }, *titles[] = { "Resolution", "Refresh rate" };
+  for (guint i = 0; i < 2; i++) {
+    JsonArray *values = json_object_get_array_member (catalog, fields[i]);
+    g_auto (GStrv) choices = g_new0 (char *, 2 * json_array_get_length (values) + 1);
+    for (guint j = 0; j < json_array_get_length (values); j++) choices[2*j] = g_strdup (json_array_get_string_element (values, j)), choices[2*j+1] = g_strdup (json_array_get_string_element (values, j));
+    g_autofree char *key = g_strdup_printf ("d.%s.%s", id, fields[i]);
+    cc_luma_view_row (rows, titles[i], NULL, cc_luma_view_picker (v, key, (const char * const *) choices));
+  }
+  g_autofree char *scale_key = g_strdup_printf ("d.%s.scale", id), *rot_key = g_strdup_printf ("d.%s.rot", id), *primary_key = g_strdup_printf ("d.%s.primary", id), *profile_key = g_strdup_printf ("d.%s.prof", id);
+  cc_luma_view_row (rows, "Scale", "How big things look", segments (v, scale_key, scales));
+  cc_luma_view_row (rows, "Orientation", NULL, cc_luma_view_picker (v, rot_key, rotations));
+  if (g_str_equal (id, "ext")) cc_luma_view_row (rows, "HDR", "Brighter highlights in videos and photos that support it", flag (v, "d.ext.hdr"));
+  else {
+    GtkWidget *controls = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 10);
+    GtkWidget *range = gtk_scale_new_with_range (GTK_ORIENTATION_HORIZONTAL, 5, 100, 1);
+    gtk_scale_set_draw_value (GTK_SCALE (range), FALSE); gtk_range_set_value (GTK_RANGE (range), json_node_get_int (cc_luma_fixture_get (v->model, "d.int.bright")));
+    gtk_widget_set_size_request (range, 140, -1); gtk_widget_set_name (range, "cf-d.int.bright");
+    g_autofree char *value = g_strdup_printf ("%d%%", (int) gtk_range_get_value (GTK_RANGE (range)));
+    GtkWidget *output = cc_luma_view_label (value, "caption", TRUE); g_object_set_data (G_OBJECT (range), "cf-output", output);
+    g_signal_connect_object (range, "value-changed", G_CALLBACK (brightness_changed), v->root, 0);
+    gtk_box_append (GTK_BOX (controls), range); gtk_box_append (GTK_BOX (controls), output); cc_luma_view_row (rows, "Brightness", NULL, controls);
+  }
+  if (!mirror) {
+    GtkWidget *primary = flag (v, primary_key);
+    gtk_widget_set_sensitive (primary, !cc_luma_view_flag (v, primary_key));
+    if (cc_luma_view_flag (v, primary_key)) gtk_widget_set_tooltip_text (primary, "Choose the other display to move the shelf");
+    cc_luma_view_row (rows, "Main display", "Holds the shelf and new windows", primary);
+  }
+  cc_luma_view_row (rows, "Colour profile", NULL, cc_luma_view_picker (v, profile_key, g_str_equal (id, "ext") ? external_profiles : internal_profiles));
+  rows = cc_luma_view_group (v, NULL); gtk_box_append (rows, cc_luma_view_link (v, "Night Light", "nightlight"));
+}
diff --git a/shell/cc-luma-view-keyboard.c b/shell/cc-luma-view-keyboard.c
new file mode 100644
index 0000000..70d4161
--- /dev/null
+++ b/shell/cc-luma-view-keyboard.c
@@ -0,0 +1,144 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view-private.h"
+#include "cc-luma-keyboard.h"
+static void layout_clicked (GtkButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v || !g_str_equal (v->page, "keyboard")) return;
+  const char *layout = g_object_get_data (G_OBJECT (button), "cf-layout");
+  g_autoptr(GError) error = NULL;
+  gboolean done = g_object_get_data (G_OBJECT (button), "cf-remove") ?
+    cc_luma_keyboard_remove (v->model, layout, &error) : cc_luma_keyboard_select (v->model, layout, &error);
+  if (done) cc_luma_view_queue_refresh (v); else cc_luma_view_report_error (v, error);
+}
+static GtkWidget *layout_button (View *v, const char *layout, gboolean remove)
+{
+  GtkWidget *button = remove ? gtk_button_new () : gtk_button_new_with_label ("Use");
+  if (remove) gtk_button_set_child (GTK_BUTTON (button), luma_ui_icon_new ("x"));
+  g_autofree char *caption = g_strdup_printf ("%s %s", remove ? "Remove" : "Use", layout);
+  g_autofree char *name = g_strconcat (remove ? "cf-src-remove-" : "cf-src-use-", layout, NULL);
+  gtk_widget_set_name (button, name);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_PROPERTY_LABEL, caption, -1);
+  g_object_set_data_full (G_OBJECT (button), "cf-layout", g_strdup (layout), g_free);
+  g_object_set_data (G_OBJECT (button), "cf-remove", GINT_TO_POINTER (remove));
+  g_signal_connect_object (button, "clicked", G_CALLBACK (layout_clicked), v->root, 0);
+  return button;
+}
+static void add_selected (GSimpleAction *action, GVariant *parameter, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v || !g_str_equal (v->page, "keyboard")) return;
+  g_autoptr(GError) error = NULL;
+  if (cc_luma_keyboard_add (v->model, g_variant_get_string (parameter, NULL), &error)) cc_luma_view_queue_refresh (v);
+  else cc_luma_view_report_error (v, error);
+}
+static void add_layout (GtkButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  GtkWidget *menu = luma_floating_menu_new ("Add a layout");
+  JsonObject *catalog = json_object_get_object_member (json_object_get_object_member (cc_luma_fixture_get_data (v->model), "CFKB"), "L");
+  g_autoptr(GList) labels = json_object_get_members (catalog);
+  const char *more[] = { "Español", "Italiano", "日本語", "한국어" };
+  g_autoptr(GPtrArray) names = g_ptr_array_new ();
+  for (GList *p = labels; p; p = p->next) g_ptr_array_add (names, p->data);
+  for (guint i = 0; i < G_N_ELEMENTS (more); i++) g_ptr_array_add (names, (gpointer) more[i]);
+  JsonArray *sources = json_node_get_array (cc_luma_fixture_get (v->model, "srcs"));
+  for (guint i = 0; i < names->len; i++) {
+    const char *name = g_ptr_array_index (names, i);
+    gboolean installed = FALSE;
+    for (guint j = 0; j < json_array_get_length (sources); j++)
+      if (g_str_equal (name, json_array_get_string_element (sources, j))) installed = TRUE;
+    if (installed) continue;
+    g_autofree char *action = g_action_print_detailed_name ("cf.keyboard-add", g_variant_new_string (name));
+    luma_floating_menu_add_item (LUMA_FLOATING_MENU (menu), name, NULL, NULL, NULL, action, FALSE);
+  }
+  luma_floating_menu_popup (LUMA_FLOATING_MENU (menu), GTK_WIDGET (button));
+}
+static void per_window_changed (GtkCheckButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v || !gtk_check_button_get_active (button)) return;
+  g_autoptr(GError) error = NULL;
+  if (cc_luma_keyboard_set_choice (v->model, "perWin", g_object_get_data (G_OBJECT (button), "cf-choice"), &error)) cc_luma_view_queue_refresh (v);
+  else cc_luma_view_report_error (v, error);
+}
+static GdkContentProvider *dragged (GtkDragSource *source, double x, double y, gpointer data)
+{
+  return gdk_content_provider_new_typed (G_TYPE_STRING, g_object_get_data (G_OBJECT (source), "cf-layout"));
+}
+static gboolean dropped (GtkDropTarget *target, const GValue *value, double x, double y, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return FALSE;
+  JsonArray *sources = json_node_get_array (cc_luma_fixture_get (v->model, "srcs"));
+  const char *from_name = g_value_get_string (value);
+  const char *to_name = g_object_get_data (G_OBJECT (target), "cf-layout");
+  guint from = G_MAXUINT, to = G_MAXUINT;
+  for (guint i = 0; i < json_array_get_length (sources); i++) {
+    const char *name = json_array_get_string_element (sources, i);
+    if (g_strcmp0 (name, from_name) == 0) from = i;
+    if (g_strcmp0 (name, to_name) == 0) to = i;
+  }
+  if (from == G_MAXUINT || to == G_MAXUINT) return FALSE;
+  g_autoptr(GError) error = NULL;
+  if (!cc_luma_keyboard_move (v->model, from, to, &error)) { cc_luma_view_report_error (v, error); return FALSE; }
+  cc_luma_view_queue_refresh (v); return TRUE;
+}
+void cc_luma_view_keyboard_render (View *v)
+{
+  JsonArray *sources = json_node_get_array (cc_luma_fixture_get (v->model, "srcs"));
+  guint count = json_array_get_length (sources);
+  g_autofree char *subtitle = count == 1 ? g_strdup_printf ("%s · one layout", cc_luma_view_text (v, "src")) :
+    g_strdup_printf ("%s · %u layouts", cc_luma_view_text (v, "src"), count);
+  cc_luma_view_header (v, "Keyboard", subtitle, NULL);
+  /* TODO(kit-request settings-09): the keyboard and shortcut keycaps consume
+   * the shared semantic C part, with no application-local font/paint clone. */
+  if (!g_action_map_lookup_action (G_ACTION_MAP (v->actions), "keyboard-add")) {
+    g_autoptr(GSimpleAction) action = g_simple_action_new ("keyboard-add", G_VARIANT_TYPE_STRING);
+    g_signal_connect_object (action, "activate", G_CALLBACK (add_selected), v->root, 0);
+    g_action_map_add_action (G_ACTION_MAP (v->actions), G_ACTION (action));
+  }
+  GtkBox *rows = cc_luma_view_group (v, "Layouts");
+  for (guint i = 0; i < count; i++) {
+    const char *layout = json_array_get_string_element (sources, i);
+    gboolean current = g_str_equal (layout, cc_luma_view_text (v, "src"));
+    GtkWidget *trail = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+    if (!current) gtk_box_append (GTK_BOX (trail), layout_button (v, layout, FALSE));
+    if (count > 1) gtk_box_append (GTK_BOX (trail), layout_button (v, layout, TRUE));
+    GtkWidget *row = cc_luma_view_row (rows, layout, current ? "In use" : NULL, trail);
+    g_autofree char *row_name = g_strconcat ("cf-src-", layout, NULL); gtk_widget_set_name (row, row_name);
+    GtkWidget *grip = luma_ui_icon_new ("grip-vertical"); gtk_box_prepend (GTK_BOX (row), grip);
+    GtkDragSource *drag = gtk_drag_source_new (); gtk_drag_source_set_actions (drag, GDK_ACTION_MOVE);
+    g_object_set_data_full (G_OBJECT (drag), "cf-layout", g_strdup (layout), g_free);
+    g_signal_connect (drag, "prepare", G_CALLBACK (dragged), NULL); gtk_widget_add_controller (grip, GTK_EVENT_CONTROLLER (drag));
+    GtkDropTarget *drop = gtk_drop_target_new (G_TYPE_STRING, GDK_ACTION_MOVE);
+    g_object_set_data_full (G_OBJECT (drop), "cf-layout", g_strdup (layout), g_free);
+    g_signal_connect_object (drop, "drop", G_CALLBACK (dropped), v->root, 0); gtk_widget_add_controller (row, GTK_EVENT_CONTROLLER (drop));
+  }
+  GtkWidget *add = luma_add_row_new ("Add a layout", "plus", NULL);
+  gtk_widget_set_name (add, "cf-addsrc");
+  g_signal_connect_object (add, "clicked", G_CALLBACK (add_layout), v->root, 0); gtk_box_append (rows, add);
+  if (count > 1) {
+    const char *ids[] = { "all", "win" };
+    const char *titles[] = { "Same layout in every window", "Each window remembers its layout" };
+    GtkCheckButton *group = NULL;
+    for (guint i = 0; i < G_N_ELEMENTS (ids); i++) {
+      GtkWidget *button = gtk_check_button_new (); gtk_check_button_set_group (GTK_CHECK_BUTTON (button), group);
+      if (!group) group = GTK_CHECK_BUTTON (button);
+      gtk_check_button_set_active (GTK_CHECK_BUTTON (button), g_str_equal (cc_luma_view_text (v, "perWin"), ids[i]));
+      g_autofree char *name = g_strconcat ("cf-perWin-", ids[i], NULL); gtk_widget_set_name (button, name);
+      gtk_accessible_update_property (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_PROPERTY_LABEL, titles[i], -1);
+      g_object_set_data (G_OBJECT (button), "cf-choice", (gpointer) ids[i]);
+      g_signal_connect_object (button, "toggled", G_CALLBACK (per_window_changed), v->root, 0);
+      cc_luma_view_row (rows, titles[i], NULL, button);
+    }
+  }
+  rows = cc_luma_view_group (v, "Typing special characters");
+  const char * const accents[] = { "off", "None", "AltRight", "Right Alt", "AltLeft", "Left Alt", "ContextMenu", "Menu", NULL };
+  const char * const compose[] = { "off", "None", "ContextMenu", "Menu", "CapsLock", "Caps Lock", "ControlRight", "Right Ctrl", NULL };
+  cc_luma_view_row (rows, "Accents and symbols key", "Hold it and type a letter", cc_luma_view_picker (v, "altKey", accents));
+  cc_luma_view_row (rows, "Compose key", "Press it, then two characters: o then e makes œ", cc_luma_view_picker (v, "compose", compose));
+  rows = cc_luma_view_group (v, NULL);
+  cc_luma_view_row (rows, "Keyboard shortcuts", "See and change them", cc_luma_view_link (v, "Keyboard shortcuts", "shortcuts"));
+}
diff --git a/shell/cc-luma-view-nightlight.c b/shell/cc-luma-view-nightlight.c
new file mode 100644
index 0000000..40a5c96
--- /dev/null
+++ b/shell/cc-luma-view-nightlight.c
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view-private.h"
+
+static void schedule_changed (GtkCheckButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v || !gtk_check_button_get_active (button)) return;
+  g_autoptr(GError) error = NULL;
+  if (cc_luma_night_set_choice (v->model, "nightWhen", g_object_get_data (G_OBJECT (button), "cf-schedule"), &error))
+    cc_luma_view_queue_refresh (v);
+  else cc_luma_view_report_error (v, error);
+}
+static void temperature_changed (GtkRange *range, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  g_autoptr(GError) error = NULL;
+  if (!cc_luma_night_set_temperature (v->model, gtk_range_get_value (range), &error))
+    cc_luma_view_report_error (v, error);
+  /* Retain the emitting slider during continuous input. The app-owned
+   * gradient indicator will consume this value through its paint tokens. */
+}
+static void until_tomorrow (GtkButton *button, View *v)
+{
+  g_autoptr(GError) error = NULL;
+  if (cc_luma_fixture_set_flag (v->model, "night", FALSE, &error)) {
+    cc_luma_view_queue_refresh (v);
+    luma_toast_show (v->root, "Night Light is off until tomorrow", "moon");
+  } else cc_luma_view_report_error (v, error);
+}
+void cc_luma_view_nightlight_render (View *v)
+{
+  gboolean automatic = g_str_equal (cc_luma_view_text (v, "nightWhen"), "sun");
+  g_autofree char *subtitle = !cc_luma_view_flag (v, "night") ? g_strdup ("Off") :
+    automatic ? g_strdup ("From sunset to sunrise") :
+    g_strdup_printf ("From %s to %s", cc_luma_view_text (v, "nightFrom"), cc_luma_view_text (v, "nightTo"));
+  cc_luma_view_header (v, "Night Light", subtitle, "night");
+  /* TODO(kit-request settings-08): app-owned temperature/day drawing must
+   * consume the public gradient, time-marker and surface tokens. */
+  GtkBox *rows = cc_luma_view_group (v, NULL);
+  const char *ids[] = { "sun", "manual" };
+  const char *titles[] = { "Sunset to sunrise", "Set times" };
+  GtkCheckButton *group = NULL;
+  for (guint i = 0; i < G_N_ELEMENTS (ids); i++) {
+    GtkWidget *button = gtk_check_button_new ();
+    gtk_check_button_set_group (GTK_CHECK_BUTTON (button), group);
+    if (!group) group = GTK_CHECK_BUTTON (button);
+    gtk_check_button_set_active (GTK_CHECK_BUTTON (button), g_str_equal (cc_luma_view_text (v, "nightWhen"), ids[i]));
+    g_autofree char *name = g_strconcat ("cf-nightWhen-", ids[i], NULL);
+    gtk_widget_set_name (button, name);
+    gtk_accessible_update_property (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_PROPERTY_LABEL, titles[i], -1);
+    g_object_set_data (G_OBJECT (button), "cf-schedule", (gpointer) ids[i]);
+    g_signal_connect_object (button, "toggled", G_CALLBACK (schedule_changed), v->root, 0);
+    cc_luma_view_row (rows, titles[i], i == 0 ? "Follows the sun where you are" : NULL, button);
+  }
+  if (!automatic) {
+    const char * const from[] = { "19:00", "19:00", "20:00", "20:00", "21:00", "21:00", "22:00", "22:00", "23:00", "23:00", NULL };
+    const char * const to[] = { "05:30", "05:30", "06:00", "06:00", "06:30", "06:30", "07:00", "07:00", "08:00", "08:00", NULL };
+    cc_luma_view_row (rows, "From", NULL, cc_luma_view_picker (v, "nightFrom", from));
+    cc_luma_view_row (rows, "To", NULL, cc_luma_view_picker (v, "nightTo", to));
+  }
+  rows = cc_luma_view_group (v, NULL);
+  GtkWidget *control = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+  GtkWidget *range = gtk_scale_new_with_range (GTK_ORIENTATION_HORIZONTAL, 0, 100, 1);
+  gtk_scale_set_draw_value (GTK_SCALE (range), FALSE);
+  gtk_range_set_value (GTK_RANGE (range), json_node_get_int (cc_luma_fixture_get (v->model, "nightT")));
+  gtk_widget_set_size_request (range, 140, -1);
+  gtk_widget_set_name (range, "cf-nightT");
+  gtk_accessible_update_property (GTK_ACCESSIBLE (range), GTK_ACCESSIBLE_PROPERTY_LABEL, "Colour temperature", -1);
+  g_signal_connect_object (range, "value-changed", G_CALLBACK (temperature_changed), v->root, 0);
+  gtk_box_append (GTK_BOX (control), cc_luma_view_label ("Cooler", "small", TRUE));
+  gtk_box_append (GTK_BOX (control), range);
+  gtk_box_append (GTK_BOX (control), cc_luma_view_label ("Warmer", "small", TRUE));
+  cc_luma_view_row (rows, "Colour temperature", NULL, control);
+  rows = cc_luma_view_group (v, NULL);
+  GtkWidget *off = cc_luma_view_command (v, "Turn off", G_CALLBACK (until_tomorrow));
+  gtk_widget_set_name (off, "cf-nightoff");
+  cc_luma_view_row (rows, "Turn off until tomorrow", NULL, off);
+}
