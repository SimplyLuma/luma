+  g_assert_cmpfloat_with_epsilon (spans[0].start, 18.87 / 24, .000001);
+  g_assert_cmpfloat_with_epsilon (spans[0].length + spans[1].length, (24 - 18.87 + 6.97) / 24, .000001);
