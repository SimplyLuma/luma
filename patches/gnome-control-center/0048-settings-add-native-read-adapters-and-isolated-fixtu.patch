diff --git a/shell/test-luma-folder-portal.c b/shell/test-luma-folder-portal.c
new file mode 100644
index 0000000..0811c67
--- /dev/null
+++ b/shell/test-luma-folder-portal.c
@@ -0,0 +1,198 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view.h"
+#include <adwaita.h>
+#include <glib/gstdio.h>
+#include <luma-ui.h>
+#define PORTAL "org.freedesktop.portal.Desktop"
+#define PORTAL_PATH "/org/freedesktop/portal/desktop"
+#define CHOOSER "org.freedesktop.portal.FileChooser"
+#define REQUEST "org.freedesktop.portal.Request"
+
+typedef struct { char *path, *sender; guint registration; gboolean closed; } Request;
+static GDBusConnection *service;
+static GDBusNodeInfo *info;
+static GPtrArray *requests;
+static void request_free (Request *request)
+{
+  g_dbus_connection_unregister_object (service, request->registration);
+  g_free (request->path); g_free (request->sender); g_free (request);
+}
+static GVariant *property (GDBusConnection *connection, const char *sender, const char *path,
+  const char *interface, const char *name, GError **error, gpointer data)
+{
+  g_assert_cmpstr (name, ==, "version");
+  return g_variant_new_uint32 (4);
+}
+static void method (GDBusConnection *connection, const char *sender, const char *path,
+  const char *interface, const char *name, GVariant *parameters, GDBusMethodInvocation *invocation, gpointer data);
+static const GDBusInterfaceVTable vtable = { .method_call = method, .get_property = property };
+static void method (GDBusConnection *connection, const char *sender, const char *path,
+  const char *interface, const char *name, GVariant *parameters, GDBusMethodInvocation *invocation, gpointer data)
+{
+  if (g_str_equal (interface, REQUEST)) {
+    g_assert_cmpstr (name, ==, "Close");
+    ((Request *) data)->closed = TRUE;
+    g_dbus_method_invocation_return_value (invocation, NULL);
+    return;
+  }
+  g_assert_cmpstr (interface, ==, CHOOSER); g_assert_cmpstr (name, ==, "OpenFile");
+  const char *parent, *title, *token;
+  g_autoptr(GVariant) options = NULL;
+  g_variant_get (parameters, "(&s&s@a{sv})", &parent, &title, &options);
+  g_assert_cmpstr (title, ==, "Select Location");
+  gboolean directory = FALSE, multiple = FALSE;
+  g_assert_true (g_variant_lookup (options, "directory", "b", &directory)); g_assert_true (directory);
+  g_variant_lookup (options, "multiple", "b", &multiple); g_assert_false (multiple);
+  g_assert_true (g_variant_lookup (options, "handle_token", "&s", &token));
+  g_assert_true (g_str_has_prefix (sender, ":"));
+  g_autofree char *component = g_strdup (sender + 1); g_strdelimit (component, ".", '_');
+  Request *request = g_new0 (Request, 1);
+  request->sender = g_strdup (sender);
+  request->path = g_strdup_printf (PORTAL_PATH "/request/%s/%s", component, token);
+  g_assert_true (g_variant_is_object_path (request->path));
+  g_autoptr(GError) error = NULL;
+  request->registration = g_dbus_connection_register_object (service, request->path, info->interfaces[1], &vtable, request, NULL, &error);
+  g_assert_no_error (error); g_assert_cmpuint (request->registration, !=, 0);
+  g_ptr_array_add (requests, request);
+  g_dbus_method_invocation_return_value (invocation, g_variant_new ("(o)", request->path));
+}
+static void spin (guint ms)
+{
+  gint64 end = g_get_monotonic_time () + ms * 1000;
+  do { while (g_main_context_iteration (NULL, FALSE)) {} g_usleep (1000); } while (g_get_monotonic_time () < end);
+}
+static void await_requests (guint count)
+{
+  gint64 end = g_get_monotonic_time () + 5000000;
+  while (requests->len < count && g_get_monotonic_time () < end) spin (1);
+  g_assert_cmpuint (requests->len, ==, count);
+}
+static GtkWidget *find (GtkWidget *widget, const char *name)
+{
+  if (g_str_equal (gtk_widget_get_name (widget), name)) return widget;
+  for (GtkWidget *child = gtk_widget_get_first_child (widget); child; child = gtk_widget_get_next_sibling (child)) {
+    GtkWidget *found = find (child, name); if (found) return found;
+  }
+  return NULL;
+}
+static void respond (guint index, guint code, const char *uri)
+{
+  Request *request = requests->pdata[index];
+  GVariantBuilder result; g_variant_builder_init (&result, G_VARIANT_TYPE_VARDICT);
+  /* GTK consumes the typed URI list before interpreting the response code.
+   * A dismissed private portal returns an empty list, never an absent field. */
+  const char *uris[] = { code == 0 ? uri : NULL, NULL };
+  g_variant_builder_add (&result, "{sv}", "uris", g_variant_new_strv (uris, -1));
+  g_autoptr(GError) error = NULL;
+  g_assert_true (g_dbus_connection_emit_signal (service, request->sender, request->path, REQUEST, "Response",
+    g_variant_new ("(ua{sv})", code, &result), &error));
+  g_assert_no_error (error);
+}
+static void chooser_route (void)
+{
+  if (!g_test_subprocess ()) {
+    g_test_trap_subprocess (NULL, 15000000,
+      G_TEST_SUBPROCESS_INHERIT_STDOUT | G_TEST_SUBPROCESS_INHERIT_STDERR);
+    g_test_trap_assert_passed ();
+    return;
+  }
+  g_autoptr(GError) error = NULL;
+  g_autoptr(CcLumaFixture) model = cc_luma_fixture_load (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), &error);
+  g_assert_no_error (error);
+  g_autofree char *dir = g_dir_make_tmp ("luma-settings-folder-portal-XXXXXX", &error);
+  g_assert_no_error (error);
+  g_autofree char *chosen = g_build_filename (dir, "folder.with.dots", NULL);
+  g_assert_cmpint (g_mkdir (chosen, 0700), ==, 0);
+  g_autoptr(GFile) file = g_file_new_for_path (chosen);
+  g_autofree char *uri = g_file_get_uri (file);
+  JsonObject *places = json_node_get_object (cc_luma_fixture_get (model, "sl"));
+  guint original = json_object_get_size (places);
+  GtkWidget *window = gtk_window_new ();
+  GtkWidget *view = cc_luma_view_new (model, "search-places", &error);
+  g_assert_no_error (error); g_assert_nonnull (view);
+  gtk_window_set_child (GTK_WINDOW (window), view); gtk_window_set_default_size (GTK_WINDOW (window), 390, 740);
+  gtk_window_present (GTK_WINDOW (window)); spin (100);
+  g_test_message ("chooser: presenting first request");
+  g_signal_emit_by_name (find (view, "cf-add-place"), "clicked"); await_requests (1);
+  g_test_message ("chooser: first request received");
+  respond (0, 0, uri);
+  gint64 end = g_get_monotonic_time () + 5000000;
+  while (!json_object_has_member (json_node_get_object (cc_luma_fixture_get (model, "sl")), uri) && g_get_monotonic_time () < end) spin (1);
+  places = json_node_get_object (cc_luma_fixture_get (model, "sl"));
+  g_assert_true (json_object_has_member (places, uri)); g_assert_true (json_object_get_boolean_member (places, uri));
+  g_assert_cmpuint (json_object_get_size (places), ==, original + 1);
+  g_assert_true (json_object_get_boolean_member (places, "Home"));
+  spin (100);
+  g_test_message ("chooser: selected folder rendered");
+  g_autofree char *widget_name = g_strconcat ("cf-sl-", uri, NULL);
+  g_assert_nonnull (find (view, widget_name));
+  g_assert_null (cc_luma_view_get_error (view));
+  g_assert_cmpint (gtk_widget_get_width (window), ==, 390);
+  /* A dismissed chooser leaves every folder setting untouched. */
+  g_signal_emit_by_name (find (view, "cf-add-place"), "clicked"); await_requests (2);
+  respond (1, 1, NULL); spin (100);
+  g_assert_cmpuint (json_object_get_size (places), ==, original + 1);
+  g_assert_null (cc_luma_view_get_error (view));
+  /* Destroying the root cancels the portal request. Retained commands and a
+   * late remote success cannot act on the destroyed view. */
+  GtkWidget *orphan = g_object_ref (find (view, "cf-add-place"));
+  g_signal_emit_by_name (orphan, "clicked"); await_requests (3);
+  /* Receipt by the fake service precedes GTK dispatching its opening reply.
+   * Exercise an established chooser here; opt-in immediate cancellation
+   * preserves the independently evidenced GTK 4.22.4 connection-clear race. */
+  if (!g_getenv ("LUMA_SETTINGS_TEST_IMMEDIATE_CANCEL")) spin (100);
+  GWeakRef weak; g_weak_ref_init (&weak, view);
+  gtk_window_destroy (GTK_WINDOW (window)); spin (100);
+  Request *last = requests->pdata[2];
+  end = g_get_monotonic_time () + 5000000;
+  while (!last->closed && g_get_monotonic_time () < end) spin (1);
+  g_assert_true (last->closed);
+  respond (2, 0, "file:///tmp/must-not-be-added-by-a-late-portal"); spin (100);
+  g_autoptr(GObject) retained = g_weak_ref_get (&weak); g_assert_null (retained); g_weak_ref_clear (&weak);
+  g_assert_false (json_object_has_member (places, "file:///tmp/must-not-be-added-by-a-late-portal"));
+  g_signal_emit_by_name (orphan, "clicked"); spin (100); g_object_unref (orphan);
+  g_assert_cmpuint (requests->len, ==, 3);
+  g_assert_cmpint (g_rmdir (chosen), ==, 0); g_assert_cmpint (g_rmdir (dir), ==, 0);
+}
+int main (int argc, char **argv)
+{
+  g_autoptr(GTestDBus) bus = NULL;
+  g_autofree char *display = g_strdup (g_getenv ("DISPLAY"));
+  g_test_init (&argc, &argv, NULL);
+  g_assert_cmpstr (g_getenv ("GSETTINGS_BACKEND"), ==, "memory");
+  g_assert_cmpstr (g_getenv ("GDK_DEBUG"), ==, "portals");
+  if (!g_test_subprocess ()) {
+    /* Parent owns the bus; GTK's process-wide portal caches stay in the
+     * child that runs every real chooser/lifetime assertion below. */
+    bus = g_test_dbus_new (G_TEST_DBUS_NONE); g_test_dbus_up (bus);
+    if (display) g_setenv ("DISPLAY", display, TRUE);
+    g_assert_cmpstr (g_getenv ("DBUS_SESSION_BUS_ADDRESS"), ==, g_test_dbus_get_bus_address (bus));
+    g_test_add_func ("/settings/folders/private-portal-route", chooser_route);
+    int status = g_test_run ();
+    g_test_dbus_down (bus);
+    return status;
+  }
+  service = g_dbus_connection_new_for_address_sync (g_getenv ("DBUS_SESSION_BUS_ADDRESS"),
+    G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT | G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION, NULL, NULL, NULL);
+  g_assert_nonnull (service);
+  g_autoptr(GVariant) owner = g_dbus_connection_call_sync (service, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
+    "RequestName", g_variant_new ("(su)", PORTAL, 0u), G_VARIANT_TYPE ("(u)"), G_DBUS_CALL_FLAGS_NONE, 5000, NULL, NULL);
+  guint result; g_assert_nonnull (owner); g_variant_get (owner, "(u)", &result); g_assert_cmpuint (result, ==, 1);
+  info = g_dbus_node_info_new_for_xml (
+    "<node><interface name='" CHOOSER "'><property name='version' type='u' access='read'/>"
+    "<method name='OpenFile'><arg type='s' direction='in'/><arg type='s' direction='in'/><arg type='a{sv}' direction='in'/><arg type='o' direction='out'/></method></interface>"
+    "<interface name='" REQUEST "'><method name='Close'/><signal name='Response'><arg type='u'/><arg type='a{sv}'/></signal></interface></node>", NULL);
+  g_assert_nonnull (info);
+  guint registration = g_dbus_connection_register_object (service, PORTAL_PATH, info->interfaces[0], &vtable, NULL, NULL, NULL);
+  g_assert_cmpuint (registration, !=, 0);
+  requests = g_ptr_array_new_with_free_func ((GDestroyNotify) request_free);
+  adw_init (); luma_init ();
+  g_test_add_func ("/settings/folders/private-portal-route", chooser_route);
+  int status = g_test_run ();
+  g_ptr_array_unref (requests); g_dbus_connection_unregister_object (service, registration); g_dbus_node_info_unref (info);
+  g_dbus_connection_close_sync (service, NULL, NULL); g_clear_object (&service);
+  /* GTK's portal/display globals belong to this short-lived child. The
+   * parent reaps it and its private bus after all close/lifetime assertions.
+   * Closing GdkDisplay here invalidates GTK's pending portal Close reply. */
+  return status;
+}
diff --git a/shell/test-luma-identity.c b/shell/test-luma-identity.c
new file mode 100644
index 0000000..3b12c01
--- /dev/null
+++ b/shell/test-luma-identity.c
@@ -0,0 +1,134 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+#include <adwaita.h>
+#include "cc-application.h"
+#include "cc-luma-identity.h"
+
+static guint production_activations;
+
+static void
+activated (GApplication *application, gpointer data)
+{
+  production_activations++;
+}
+
+static gboolean
+has_owner (GDBusConnection *connection, const char *name)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GVariant) reply = g_dbus_connection_call_sync (connection,
+    "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
+    "NameHasOwner", g_variant_new ("(s)", name), G_VARIANT_TYPE ("(b)"),
+    G_DBUS_CALL_FLAGS_NONE, 3000, NULL, &error);
+  gboolean owned = FALSE;
+  g_assert_no_error (error);
+  g_variant_get (reply, "(b)", &owned);
+  return owned;
+}
+
+static void
+identity (void)
+{
+  if (!g_test_subprocess ()) {
+    /* GTK retains process-wide portal connections. Keep the actual native
+     * assertions in a child and let the parent own/reap the private bus. */
+    g_test_trap_subprocess (NULL, 10000000,
+      G_TEST_SUBPROCESS_INHERIT_STDOUT | G_TEST_SUBPROCESS_INHERIT_STDERR);
+    g_test_trap_assert_passed ();
+    return;
+  }
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GApplication) production = NULL;
+  g_autoptr(GtkApplication) preview = NULL;
+  g_autoptr(GDBusConnection) connection = NULL;
+
+  g_unsetenv ("LUMA_SETTINGS_FIXTURE");
+  g_unsetenv ("LUMA_SETTINGS_APPLICATION_ID");
+  g_setenv ("LUMA_SETTINGS_SMOKE", "1", TRUE);
+  g_assert_null (cc_application_new ());
+  g_setenv ("LUMA_SETTINGS_SMOKE", "invalid", TRUE);
+  g_assert_null (cc_application_new ());
+  g_unsetenv ("LUMA_SETTINGS_SMOKE");
+  /* Negative control for the Photos mismatch: generic launcher variables
+   * cannot masquerade as the native Settings identity hook. */
+  g_setenv ("APP_ID", APPLICATION_ID ".LumaUIPreview", TRUE);
+  g_setenv ("APPLICATION_ID", APPLICATION_ID ".LumaUIPreview", TRUE);
+  g_assert_cmpstr (cc_luma_identity_select (FALSE, NULL, &error), ==, APPLICATION_ID);
+  preview = cc_application_new ();
+  g_assert_cmpstr (g_application_get_application_id (G_APPLICATION (preview)), ==, APPLICATION_ID);
+  g_setenv ("LUMA_SETTINGS_APPLICATION_ID", APPLICATION_ID ".LumaUIPreview", TRUE);
+  g_assert_null (cc_application_new ());
+  g_assert_cmpstr (g_application_get_application_id (G_APPLICATION (preview)), ==, APPLICATION_ID);
+  g_unsetenv ("LUMA_SETTINGS_APPLICATION_ID");
+  g_clear_object (&preview);
+  g_unsetenv ("APP_ID");
+  g_unsetenv ("APPLICATION_ID");
+  g_assert_null (cc_luma_identity_select (FALSE, APPLICATION_ID, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+  g_clear_error (&error);
+  g_assert_null (cc_luma_identity_select (FALSE, "", &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+  g_clear_error (&error);
+  g_assert_cmpstr (cc_luma_identity_select (TRUE, NULL, &error), ==, "org.luma.Settings.Fixture");
+
+  /* Occupy the installed application's name on this PRIVATE bus. The real
+   * native CcApplication must register independently without activating it. */
+  production = g_application_new (APPLICATION_ID, G_APPLICATION_DEFAULT_FLAGS);
+  g_signal_connect (production, "activate", G_CALLBACK (activated), NULL);
+  g_assert_true (g_application_register (production, NULL, &error));
+  g_assert_no_error (error);
+  connection = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, &error);
+  g_assert_no_error (error);
+  g_assert_true (has_owner (connection, APPLICATION_ID));
+
+  g_setenv ("LUMA_SETTINGS_APPLICATION_ID", APPLICATION_ID ".LumaUIPreview", TRUE);
+  preview = cc_application_new ();
+  g_assert_cmpstr (g_application_get_application_id (G_APPLICATION (preview)), ==,
+                   APPLICATION_ID ".LumaUIPreview");
+  g_assert_true (g_application_register (G_APPLICATION (preview), NULL, &error));
+  g_assert_no_error (error);
+  g_assert_false (g_application_get_is_remote (G_APPLICATION (preview)));
+  g_assert_false ((g_application_get_flags (G_APPLICATION (preview)) & G_APPLICATION_NON_UNIQUE) != 0);
+  g_assert_true (has_owner (connection, APPLICATION_ID ".LumaUIPreview"));
+  g_assert_true (has_owner (connection, APPLICATION_ID));
+  g_assert_null (gtk_application_get_windows (preview));
+  g_assert_cmpuint (production_activations, ==, 0);
+  g_test_message ("Actual native application: id=%s remote=%d windows=%u; private production owner retained, activations=%u",
+    g_application_get_application_id (G_APPLICATION (preview)),
+    g_application_get_is_remote (G_APPLICATION (preview)),
+    g_list_length (gtk_application_get_windows (preview)), production_activations);
+  /* Exercise the application's actual shutdown path without activation:
+   * --version exits through upstream's local-options handler. Registering
+   * alone does not run GApplication's shutdown/unregistration lifecycle. */
+  char *version_argv[] = { "gnome-control-center", "--version", NULL };
+  g_assert_cmpint (g_application_run (G_APPLICATION (preview), 2, version_argv), ==, 0);
+  g_assert_null (gtk_application_get_windows (preview));
+  g_clear_object (&preview);
+  g_dbus_connection_flush_sync (connection, NULL, &error);
+  g_assert_no_error (error);
+  g_assert_false (has_owner (connection, APPLICATION_ID ".LumaUIPreview"));
+  g_assert_true (has_owner (connection, APPLICATION_ID));
+  g_assert_cmpuint (production_activations, ==, 0);
+  g_test_message ("Preview destroyed: preview bus name released; production name still owned; no windows opened");
+  g_unsetenv ("LUMA_SETTINGS_APPLICATION_ID");
+}
+
+int
+main (int argc, char **argv)
+{
+  g_autoptr(GTestDBus) bus = NULL;
+  g_autofree char *display = g_strdup (g_getenv ("DISPLAY"));
+  g_test_init (&argc, &argv, NULL);
+  g_assert_cmpstr (g_getenv ("GSETTINGS_BACKEND"), ==, "memory");
+  /* Start before GTK connects to any session service. No inherited user bus. */
+  if (!g_test_subprocess ()) {
+    bus = g_test_dbus_new (G_TEST_DBUS_NONE);
+    g_test_dbus_up (bus);
+    g_assert_cmpstr (g_getenv ("DBUS_SESSION_BUS_ADDRESS"), ==, g_test_dbus_get_bus_address (bus));
+    if (display) g_setenv ("DISPLAY", display, TRUE);
+  } else adw_init ();
+  g_test_add_func ("/luma/settings/native-preview-identity", identity);
+  int result = g_test_run ();
+  if (bus) g_test_dbus_down (bus);
+  return result;
+}
diff --git a/shell/test-luma-power-reads.c b/shell/test-luma-power-reads.c
new file mode 100644
index 0000000..afebcdf
--- /dev/null
+++ b/shell/test-luma-power-reads.c
@@ -0,0 +1,155 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-power-reads.h"
+#include "cc-object-storage.h"
+#include <math.h>
+#define ROOT "/org/freedesktop/UPower"
+#define DEVICE ROOT "/devices/battery_PrivateTest"
+static guint calls;
+static gboolean hold_history;
+static GDBusMethodInvocation *held;
+static GDBusConnection *service;
+typedef struct { guint done; GVariant *value; GError *error; } Result;
+static void completed (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Result *seen = data;
+  seen->value = cc_luma_power_read_finish (result, &seen->error);
+  seen->done++;
+}
+static void clear (Result *seen)
+{
+  g_clear_pointer (&seen->value, g_variant_unref); g_clear_error (&seen->error); seen->done = 0;
+}
+static void spin (guint ms)
+{
+  gint64 end = g_get_monotonic_time () + ms * 1000;
+  do { while (g_main_context_iteration (NULL, FALSE)) {} g_usleep (1000); } while (g_get_monotonic_time () < end);
+}
+static void wait_result (Result *seen)
+{
+  gint64 end = g_get_monotonic_time () + 6000000;
+  while (!seen->done && g_get_monotonic_time () < end) spin (1);
+  g_assert_cmpuint (seen->done, ==, 1);
+}
+static GVariant *history_reply (void)
+{
+  GVariantBuilder samples; g_variant_builder_init (&samples, G_VARIANT_TYPE ("a(udu)"));
+  g_variant_builder_add (&samples, "(udu)", 100u, 91.5, 2u);
+  g_variant_builder_add (&samples, "(udu)", 150u, 0.0, 0u);
+  g_variant_builder_add (&samples, "(udu)", 800u, 88.25, 2u);
+  return g_variant_new ("(a(udu))", &samples);
+}
+static void method (GDBusConnection *connection, const char *sender, const char *path,
+                    const char *interface, const char *name, GVariant *parameters,
+                    GDBusMethodInvocation *invocation, gpointer data)
+{
+  calls++;
+  if (g_str_equal (name, "EnumerateDevices")) {
+    g_assert_cmpstr (path, ==, ROOT);
+    const char *devices[] = { DEVICE, ROOT "/devices/mouse_PrivateTest", NULL };
+    g_dbus_method_invocation_return_value (invocation, g_variant_new ("(^ao)", devices));
+  } else {
+    const char *type; guint span, resolution;
+    g_assert_cmpstr (name, ==, "GetHistory"); g_assert_cmpstr (path, ==, DEVICE);
+    g_variant_get (parameters, "(&suu)", &type, &span, &resolution);
+    g_assert_cmpstr (type, ==, "charge"); g_assert_cmpuint (span, ==, 86400); g_assert_cmpuint (resolution, ==, 24);
+    if (hold_history) held = g_object_ref (invocation);
+    else g_dbus_method_invocation_return_value (invocation, history_reply ());
+  }
+}
+static void name_call (const char *method_name)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GVariant) reply = g_dbus_connection_call_sync (service, "org.freedesktop.DBus", "/org/freedesktop/DBus",
+    "org.freedesktop.DBus", method_name, g_str_equal (method_name, "RequestName") ?
+    g_variant_new ("(su)", "org.freedesktop.UPower", 0u) : g_variant_new ("(s)", "org.freedesktop.UPower"),
+    G_VARIANT_TYPE ("(u)"), G_DBUS_CALL_FLAGS_NONE, 3000, NULL, &error);
+  guint code = 0; g_assert_no_error (error); g_variant_get (reply, "(u)", &code); g_assert_cmpuint (code, ==, 1);
+}
+static void reads (void)
+{
+  Result result = { 0 };
+  cc_luma_power_enumerate_async (NULL, completed, &result);
+  g_assert_cmpuint (result.done, ==, 0); wait_result (&result);
+  g_assert_no_error (result.error); g_assert_cmpuint (g_variant_n_children (result.value), ==, 2); clear (&result);
+  cc_luma_power_history_async (DEVICE, NULL, completed, &result); wait_result (&result);
+  g_assert_no_error (result.error); g_assert_cmpuint (g_variant_n_children (result.value), ==, 3);
+  guint time, state; double charge;
+  g_variant_get_child (result.value, 2, "(udu)", &time, &charge, &state);
+  g_assert_cmpuint (time, ==, 800); g_assert_cmpfloat (charge, ==, 88.25); g_assert_cmpuint (state, ==, 2); clear (&result);
+  guint before = calls;
+  g_setenv ("LUMA_SETTINGS_FIXTURE", "", TRUE);
+  cc_luma_power_enumerate_async (NULL, completed, &result); wait_result (&result);
+  g_assert_error (result.error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT); g_assert_null (result.value); clear (&result);
+  cc_luma_power_history_async (DEVICE, NULL, completed, &result); wait_result (&result);
+  g_assert_error (result.error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT); clear (&result);
+  g_assert_cmpuint (calls, ==, before); g_unsetenv ("LUMA_SETTINGS_FIXTURE");
+  cc_luma_power_history_async ("/foreign/device", NULL, completed, &result); wait_result (&result);
+  g_assert_error (result.error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT); clear (&result); g_assert_cmpuint (calls, ==, before);
+  g_autoptr(GCancellable) cancel = g_cancellable_new (); g_cancellable_cancel (cancel);
+  cc_luma_power_enumerate_async (cancel, completed, &result); wait_result (&result);
+  g_assert_error (result.error, G_IO_ERROR, G_IO_ERROR_CANCELLED); clear (&result); g_assert_cmpuint (calls, ==, before);
+
+  hold_history = TRUE;
+  cc_luma_power_history_async (DEVICE, NULL, completed, &result);
+  gint64 end = g_get_monotonic_time () + 6000000;
+  while (!held && g_get_monotonic_time () < end) spin (1);
+  g_assert_nonnull (held); name_call ("ReleaseName"); spin (100);
+  g_dbus_method_invocation_return_value (held, history_reply ()); g_clear_object (&held);
+  wait_result (&result); g_assert_error (result.error, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED); g_assert_null (result.value); clear (&result);
+  cc_luma_power_enumerate_async (NULL, completed, &result); wait_result (&result);
+  g_assert_error (result.error, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED); clear (&result);
+}
+static void validation (void)
+{
+  g_autoptr(GVariant) reply = g_variant_ref_sink (history_reply ());
+  g_autoptr(GVariant) samples = g_variant_get_child_value (reply, 0);
+  g_assert_true (cc_luma_power_history_validate (samples, NULL));
+  g_autoptr(GVariant) wrong = g_variant_ref_sink (g_variant_new_string ("wrong"));
+  g_assert_false (cc_luma_power_history_validate (wrong, NULL));
+  const double bad_values[] = { -1.0, 101.0, NAN, INFINITY };
+  for (guint i = 0; i < G_N_ELEMENTS (bad_values); i++) {
+    GVariantBuilder b; g_variant_builder_init (&b, G_VARIANT_TYPE ("a(udu)"));
+    g_variant_builder_add (&b, "(udu)", 1u, bad_values[i], 2u);
+    g_autoptr(GVariant) bad = g_variant_ref_sink (g_variant_builder_end (&b));
+    g_assert_false (cc_luma_power_history_validate (bad, NULL));
+  }
+  GVariantBuilder b; g_variant_builder_init (&b, G_VARIANT_TYPE ("a(udu)"));
+  g_variant_builder_add (&b, "(udu)", 200u, 50.0, 2u); g_variant_builder_add (&b, "(udu)", 100u, 40.0, 2u);
+  g_autoptr(GVariant) unordered = g_variant_ref_sink (g_variant_builder_end (&b));
+  g_assert_false (cc_luma_power_history_validate (unordered, NULL));
+  const char *duplicate[] = { DEVICE, DEVICE, NULL };
+  g_autoptr(GVariant) devices = g_variant_ref_sink (g_variant_new_objv (duplicate, -1));
+  g_assert_false (cc_luma_power_devices_validate (devices, NULL));
+  const char *foreign[] = { "/foreign/device", NULL };
+  g_autoptr(GVariant) alien = g_variant_ref_sink (g_variant_new_objv (foreign, -1));
+  g_assert_false (cc_luma_power_devices_validate (alien, NULL));
+}
+int main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_autoptr(GTestDBus) bus = g_test_dbus_new (G_TEST_DBUS_NONE); g_test_dbus_up (bus);
+  g_setenv ("DBUS_SYSTEM_BUS_ADDRESS", g_test_dbus_get_bus_address (bus), TRUE);
+  g_assert_cmpstr (g_getenv ("DBUS_SYSTEM_BUS_ADDRESS"), ==, g_test_dbus_get_bus_address (bus));
+  g_unsetenv ("LUMA_SETTINGS_FIXTURE");
+  g_autoptr(GError) error = NULL;
+  service = g_dbus_connection_new_for_address_sync (g_test_dbus_get_bus_address (bus),
+    G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT | G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION, NULL, NULL, &error);
+  g_assert_no_error (error); name_call ("RequestName");
+  g_autoptr(GDBusNodeInfo) info = g_dbus_node_info_new_for_xml (
+    "<node><interface name='org.freedesktop.UPower'><method name='EnumerateDevices'><arg type='ao' direction='out'/></method></interface>"
+    "<interface name='org.freedesktop.UPower.Device'><method name='GetHistory'><arg type='s' direction='in'/><arg type='u' direction='in'/>"
+    "<arg type='u' direction='in'/><arg type='a(udu)' direction='out'/></method></interface></node>", &error);
+  g_assert_no_error (error);
+  const GDBusInterfaceVTable vtable = { .method_call = method };
+  guint root = g_dbus_connection_register_object (service, ROOT, info->interfaces[0], &vtable, NULL, NULL, &error);
+  g_assert_no_error (error); g_assert_cmpuint (root, >, 0);
+  guint device = g_dbus_connection_register_object (service, DEVICE, info->interfaces[1], &vtable, NULL, NULL, &error);
+  g_assert_no_error (error); g_assert_cmpuint (device, >, 0);
+  cc_object_storage_initialize ();
+  g_test_add_func ("/settings/power/native-private-reads", reads);
+  g_test_add_func ("/settings/power/validation", validation);
+  int result = g_test_run (); cc_object_storage_destroy ();
+  g_dbus_connection_unregister_object (service, root); g_dbus_connection_unregister_object (service, device);
+  g_dbus_connection_close_sync (service, NULL, &error); g_assert_no_error (error); g_clear_object (&service);
+  g_test_dbus_down (bus); return result;
+}
diff --git a/shell/test-luma-preferences.c b/shell/test-luma-preferences.c
new file mode 100644
index 0000000..e77a1f9
--- /dev/null
+++ b/shell/test-luma-preferences.c
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-preferences.h"
+#define SCHEMA "org.project_luma.settings-preferences-test"
+static guint changes;
+static void changed (CcLumaPreferences *self, gpointer unused) { changes++; }
+static void drain (void) { while (g_main_context_iteration (NULL, FALSE)) {} }
+static void values (void)
+{
+  g_autoptr(GSettings) settings = g_settings_new (SCHEMA);
+  const char * const keys[] = { "enabled", "speed", "names", NULL };
+  g_settings_reset (settings, "enabled"); g_settings_reset (settings, "speed"); g_settings_reset (settings, "names");
+  g_autoptr(CcLumaPreferences) self = cc_luma_preferences_new (settings, keys, NULL);
+  g_assert_nonnull (self); g_signal_connect (self, "changed", G_CALLBACK (changed), NULL);
+  changes = 0; cc_luma_preferences_start (self);
+  g_assert_cmpuint (changes, ==, 0); g_assert_null (cc_luma_preferences_dup_values (self));
+  drain (); g_assert_cmpuint (changes, ==, 1);
+  g_autoptr(GVariant) original = cc_luma_preferences_dup_values (self);
+  g_autoptr(GVariant) writable = cc_luma_preferences_dup_writable (self);
+  gboolean enabled = FALSE; double speed = 0;
+  g_assert_true (g_variant_lookup (original, "enabled", "b", &enabled)); g_assert_true (enabled);
+  g_assert_true (g_variant_lookup (original, "speed", "d", &speed)); g_assert_cmpfloat (speed, ==, 0.2);
+  g_assert_null (g_variant_lookup_value (original, "unrelated", NULL));
+  g_assert_true (g_variant_lookup (writable, "enabled", "b", &enabled)); g_assert_true (enabled);
+  /* External native changes update the observer; it never performs writes. */
+  g_assert_true (g_settings_set_boolean (settings, "enabled", FALSE));
+  g_assert_true (g_settings_set_double (settings, "speed", -0.7));
+  const char * const names[] = { "new", "second", NULL };
+  g_assert_true (g_settings_set_strv (settings, "names", names));
+  drain (); g_assert_cmpuint (changes, ==, 2);
+  g_autoptr(GVariant) current = cc_luma_preferences_dup_values (self);
+  g_assert_true (g_variant_lookup (current, "enabled", "b", &enabled)); g_assert_false (enabled);
+  g_assert_true (g_variant_lookup (current, "speed", "d", &speed)); g_assert_cmpfloat (speed, ==, -0.7);
+  g_autoptr(GVariant) list = g_variant_lookup_value (current, "names", G_VARIANT_TYPE_STRING_ARRAY);
+  g_auto(GStrv) actual = g_variant_dup_strv (list, NULL);
+  g_assert_true (g_strv_equal ((const char * const *) actual, names));
+  g_assert_true (g_variant_lookup (original, "enabled", "b", &enabled)); g_assert_true (enabled);
+  g_assert_true (g_settings_set_string (settings, "unrelated", "external")); drain ();
+  g_assert_cmpuint (changes, ==, 2);
+  cc_luma_preferences_stop (self); g_assert_null (cc_luma_preferences_dup_values (self));
+  g_assert_null (cc_luma_preferences_dup_writable (self));
+  g_assert_true (g_settings_set_boolean (settings, "enabled", TRUE)); drain ();
+  g_assert_cmpuint (changes, ==, 2);
+  cc_luma_preferences_start (self); g_clear_object (&self); drain ();
+}
+static void invalid (void)
+{
+  g_autoptr(GSettings) settings = g_settings_new (SCHEMA);
+  const char * const duplicate[] = { "enabled", "enabled", NULL };
+  const char * const missing[] = { "not-a-native-key", NULL };
+  const char * const keys[] = { "enabled", NULL };
+  g_autoptr(GError) error = NULL;
+  g_assert_null (cc_luma_preferences_new_native (-1, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT); g_clear_error (&error);
+  g_assert_null (cc_luma_preferences_new (settings, duplicate, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA); g_clear_error (&error);
+  g_assert_null (cc_luma_preferences_new (settings, missing, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA); g_clear_error (&error);
+  g_assert_null (cc_luma_preferences_new_schema ("org.project_luma.UnavailableTestSchema", NULL, keys, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED); g_clear_error (&error);
+  g_assert_null (cc_luma_preferences_new_schema (SCHEMA, "/wrong/", keys, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT); g_clear_error (&error);
+  g_assert_null (cc_luma_preferences_new_schema ("org.project_luma.settings-relocatable-test", "/missing-trailing-slash", keys, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT); g_clear_error (&error);
+  g_autoptr(CcLumaPreferences) relocated = cc_luma_preferences_new_schema (
+    "org.project_luma.settings-relocatable-test", "/org/project_luma/app-with-hyphens/", keys, &error);
+  g_assert_no_error (error); g_assert_nonnull (relocated);
+  g_setenv ("LUMA_SETTINGS_FIXTURE", "", TRUE);
+  g_assert_null (cc_luma_preferences_new_schema (SCHEMA, NULL, keys, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED);
+  g_clear_error (&error);
+  for (guint i = CC_LUMA_PREFS_NIGHT_LIGHT; i < CC_LUMA_PREFS_COUNT; i++) {
+    g_assert_null (cc_luma_preferences_new_native (i, &error));
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED); g_clear_error (&error);
+  }
+  g_unsetenv ("LUMA_SETTINGS_FIXTURE");
+}
+int main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_assert_cmpstr (g_getenv ("GSETTINGS_BACKEND"), ==, "memory");
+  g_test_add_func ("/settings/preferences/values", values);
+  g_test_add_func ("/settings/preferences/invalid", invalid);
+  return g_test_run ();
+}
diff --git a/shell/test-luma-properties.c b/shell/test-luma-properties.c
new file mode 100644
index 0000000..16148d9
--- /dev/null
+++ b/shell/test-luma-properties.c
@@ -0,0 +1,181 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-properties.h"
+#include "cc-luma-services.h"
+#include <math.h>
+#include "cc-object-storage.h"
+#define NAME "org.project_luma.SettingsPropertiesTest"
+#define PATH "/org/project_luma/SettingsPropertiesTest"
+#define IFACE "org.project_luma.SettingsPropertiesTest"
+static GDBusConnection *service;
+static gboolean enabled = TRUE;
+static const char *label = "Original";
+static const char * const required[] = { "Enabled", "Label", NULL };
+typedef struct { guint changed, failed; GError *error; } Seen;
+static void changed (CcLumaProperties *self, Seen *seen) { seen->changed++; }
+static void failed (CcLumaProperties *self, GError *error, Seen *seen) { seen->failed++; g_clear_error (&seen->error); seen->error = g_error_copy (error); }
+static void spin (guint ms)
+{
+  gint64 end = g_get_monotonic_time () + ms * 1000;
+  do { while (g_main_context_iteration (NULL, FALSE)) {} g_usleep (1000); } while (g_get_monotonic_time () < end);
+}
+static void until (guint *count, guint minimum)
+{
+  gint64 end = g_get_monotonic_time () + 5000000;
+  while (*count < minimum && g_get_monotonic_time () < end) spin (1);
+  g_assert_cmpuint (*count, >=, minimum);
+}
+static GVariant *get (GDBusConnection *connection, const char *sender, const char *path, const char *interface, const char *property, GError **error, gpointer data)
+{
+  if (g_str_equal (property, "Enabled")) return g_variant_new_boolean (enabled);
+  if (g_str_equal (property, "Label")) return g_variant_new_string (label);
+  if (g_str_equal (property, "Secret")) return g_variant_new_string ("must not reach the app snapshot");
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "Unknown private test property"); return NULL;
+}
+static void name_call (const char *method)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) result = g_dbus_connection_call_sync (service, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", method,
+    g_str_equal (method, "RequestName") ? g_variant_new ("(su)", NAME, 0u) : g_variant_new ("(s)", NAME), G_VARIANT_TYPE ("(u)"), G_DBUS_CALL_FLAGS_NONE, 5000, NULL, &error);
+  g_assert_no_error (error); g_assert_nonnull (result);
+  guint code; g_variant_get (result, "(u)", &code);
+  g_assert_true (code == 1 || (g_str_equal (method, "RequestName") && code == 4));
+}
+static void values_and_owner (void)
+{
+  g_autoptr (CcLumaProperties) self = cc_luma_properties_new (G_BUS_TYPE_SESSION, NAME, PATH, IFACE, required, NULL);
+  Seen seen = { 0 }; g_signal_connect (self, "changed", G_CALLBACK (changed), &seen); g_signal_connect (self, "failed", G_CALLBACK (failed), &seen);
+  g_autoptr (CcLumaProperties) peer = cc_luma_properties_new (G_BUS_TYPE_SESSION, NAME, PATH, IFACE, required, NULL);
+  Seen parallel = { 0 }; g_signal_connect (peer, "changed", G_CALLBACK (changed), &parallel); g_signal_connect (peer, "failed", G_CALLBACK (failed), &parallel);
+  cc_luma_properties_start (self); cc_luma_properties_start (peer);
+  g_assert_cmpuint (seen.changed + seen.failed, ==, 0); until (&seen.changed, 1); until (&parallel.changed, 1);
+  g_assert_cmpuint (parallel.failed, ==, 0);
+  g_assert_cmpuint (seen.failed, ==, 0);
+  g_autoptr (GVariant) first = cc_luma_properties_dup_snapshot (self); g_assert_nonnull (first); g_assert_cmpuint (g_variant_n_children (first), ==, 2);
+  gboolean value; const char *text;
+  g_assert_true (g_variant_lookup (first, "Enabled", "b", &value)); g_assert_true (value);
+  g_assert_true (g_variant_lookup (first, "Label", "&s", &text)); g_assert_cmpstr (text, ==, "Original");
+  g_assert_null (g_variant_lookup_value (first, "Secret", NULL));
+  enabled = FALSE; label = "Changed";
+  GVariantBuilder props; g_variant_builder_init (&props, G_VARIANT_TYPE_VARDICT);
+  g_variant_builder_add (&props, "{sv}", "Enabled", g_variant_new_boolean (enabled)); g_variant_builder_add (&props, "{sv}", "Label", g_variant_new_string (label));
+  guint before = seen.changed;
+  g_assert_true (g_dbus_connection_emit_signal (service, NULL, PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
+    g_variant_new ("(sa{sv}as)", IFACE, &props, NULL), NULL));
+  until (&seen.changed, before + 1);
+  g_autoptr (GVariant) later = cc_luma_properties_dup_snapshot (self);
+  g_assert_true (g_variant_lookup (later, "Enabled", "b", &value)); g_assert_false (value);
+  g_assert_true (g_variant_lookup (later, "Label", "&s", &text)); g_assert_cmpstr (text, ==, "Changed");
+  g_assert_true (g_variant_lookup (first, "Enabled", "b", &value)); g_assert_true (value);
+  name_call ("ReleaseName"); until (&seen.failed, 1);
+  until (&parallel.failed, 1); g_assert_null (cc_luma_properties_dup_snapshot (peer));
+  g_assert_null (cc_luma_properties_dup_snapshot (self)); g_assert_error (seen.error, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED);
+  cc_luma_properties_stop (self); cc_luma_properties_stop (peer); g_clear_error (&seen.error); g_clear_error (&parallel.error);
+}
+static void missing_and_cancelled (void)
+{
+  const char *missing[] = { "Missing", NULL };
+  name_call ("RequestName");
+  /* Wait for the cached proxy to observe reacquisition after the preceding
+   * owner-loss case, before checking a deliberately missing property. */
+  spin (100);
+  g_autoptr (CcLumaProperties) self = cc_luma_properties_new (G_BUS_TYPE_SESSION, NAME, PATH, IFACE, missing, NULL);
+  Seen seen = { 0 }; g_signal_connect (self, "changed", G_CALLBACK (changed), &seen); g_signal_connect (self, "failed", G_CALLBACK (failed), &seen);
+  cc_luma_properties_start (self); until (&seen.failed, 1);
+  g_assert_cmpuint (seen.changed, ==, 0); g_assert_error (seen.error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  g_assert_null (cc_luma_properties_dup_snapshot (self)); cc_luma_properties_stop (self); g_clear_error (&seen.error);
+  seen = (Seen) { 0 }; cc_luma_properties_start (self); cc_luma_properties_stop (self); spin (100);
+  g_assert_cmpuint (seen.failed + seen.changed, ==, 0);
+  CcLumaProperties *gone = cc_luma_properties_new (G_BUS_TYPE_SESSION, NAME, PATH, IFACE, required, NULL);
+  g_signal_connect (gone, "changed", G_CALLBACK (changed), &seen); cc_luma_properties_start (gone); g_object_unref (gone); spin (100);
+  g_assert_cmpuint (seen.changed, ==, 0);
+}
+static void invalid (void)
+{
+  const char *duplicate[] = { "Enabled", "Enabled", NULL };
+  g_autoptr (GError) error = NULL;
+  g_assert_null (cc_luma_properties_new (G_BUS_TYPE_SESSION, NAME, "not/a/path", IFACE, required, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT); g_clear_error (&error);
+  g_assert_null (cc_luma_properties_new (G_BUS_TYPE_SESSION, NAME, PATH, IFACE, duplicate, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+}
+static GVariant *dictionary (const char *text)
+{
+  g_autoptr(GError) error = NULL;
+  GVariant *value = g_variant_parse (G_VARIANT_TYPE_VARDICT, text, NULL, NULL, &error);
+  g_assert_no_error (error);
+  return value;
+}
+static void service_contracts (void)
+{
+  const char *valid[] = {
+    "{'NightLightDisabledUntilTomorrow': <false>, 'Sunset': <18.87>, 'Sunrise': <6.97>}",
+    "{'OnBattery': <true>, 'LidIsPresent': <true>, 'LidIsClosed': <false>}",
+    "{'Type': <uint32 2>, 'State': <uint32 2>, 'IsPresent': <true>, 'Percentage': <78.0>, 'TimeToEmpty': <int64 18600>, 'TimeToFull': <int64 0>, 'BatteryLevel': <uint32 1>}",
+    "{'ActiveProfile': <'balanced'>, 'Profiles': <[{'Profile': <'balanced'>}, {'Profile': <'power-saver'>}]>}"
+  };
+  for (guint i = 0; i < G_N_ELEMENTS (valid); i++) {
+    g_autoptr(GError) error = NULL;
+    g_autoptr(GVariant) data = dictionary (valid[i]);
+    g_autoptr(CcLumaProperties) observer = cc_luma_services_observe (i, &error);
+    g_assert_no_error (error); g_assert_nonnull (observer);
+    g_assert_true (cc_luma_services_validate (i, data, &error));
+    /* Construction/validation cannot initiate live I/O. */
+    g_assert_null (cc_luma_properties_dup_snapshot (observer));
+  }
+  const struct { CcLumaService service; const char *text; } invalid_data[] = {
+    { CC_LUMA_SERVICE_NIGHT_LIGHT, "{'NightLightDisabledUntilTomorrow': <false>, 'Sunset': <25.0>, 'Sunrise': <6.97>}" },
+    { CC_LUMA_SERVICE_NIGHT_LIGHT, "{'NightLightDisabledUntilTomorrow': <'false'>, 'Sunset': <18.87>, 'Sunrise': <6.97>}" },
+    { CC_LUMA_SERVICE_POWER, "{'OnBattery': <true>, 'LidIsPresent': <true>}" },
+    { CC_LUMA_SERVICE_POWER_PROFILES, "{'ActiveProfile': <'balanced'>, 'Profiles': <[{'Profile': <'power-saver'>}]>}" },
+    { CC_LUMA_SERVICE_POWER_PROFILES, "{'ActiveProfile': <'balanced'>, 'Profiles': <[{'Profile': <'balanced'>}, {'Profile': <'balanced'>}]>}" },
+    { CC_LUMA_SERVICE_POWER_PROFILES, "{'ActiveProfile': <'balanced'>, 'Profiles': <[{'Profile': <42>}]>}" },
+  };
+  for (guint i = 0; i < G_N_ELEMENTS (invalid_data); i++) {
+    g_autoptr(GError) error = NULL;
+    g_autoptr(GVariant) data = dictionary (invalid_data[i].text);
+    g_assert_false (cc_luma_services_validate (invalid_data[i].service, data, &error));
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  }
+  g_autoptr(GVariant) battery = dictionary (valid[CC_LUMA_SERVICE_BATTERY]);
+  const double percentages[] = { -1, 101, NAN, INFINITY };
+  for (guint i = 0; i < G_N_ELEMENTS (percentages); i++) {
+    GVariantDict dict; g_variant_dict_init (&dict, battery);
+    g_variant_dict_insert (&dict, "Percentage", "d", percentages[i]);
+    g_autoptr(GVariant) data = g_variant_ref_sink (g_variant_dict_end (&dict));
+    g_autoptr(GError) error = NULL;
+    g_assert_false (cc_luma_services_validate (CC_LUMA_SERVICE_BATTERY, data, &error));
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  }
+  GVariantDict dict; g_variant_dict_init (&dict, battery);
+  g_variant_dict_insert (&dict, "TimeToEmpty", "x", (gint64) -1);
+  g_autoptr(GVariant) data = g_variant_ref_sink (g_variant_dict_end (&dict));
+  g_autoptr(GError) error = NULL;
+  g_assert_false (cc_luma_services_validate (CC_LUMA_SERVICE_BATTERY, data, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA); g_clear_error (&error);
+  g_assert_null (cc_luma_services_observe (-1, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+}
+
+int main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_autoptr (GTestDBus) bus = g_test_dbus_new (G_TEST_DBUS_NONE); g_test_dbus_up (bus);
+  g_autoptr (GError) error = NULL;
+  service = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, &error); g_assert_no_error (error);
+  /* This process owns and deliberately closes the private bus. A cached
+   * g_bus_get connection otherwise terminates the test on a close race. */
+  g_dbus_connection_set_exit_on_close (service, FALSE);
+  const char *xml = "<node><interface name='" IFACE "'><property name='Enabled' type='b' access='read'/><property name='Label' type='s' access='read'/><property name='Secret' type='s' access='read'/></interface></node>";
+  g_autoptr (GDBusNodeInfo) info = g_dbus_node_info_new_for_xml (xml, &error); g_assert_no_error (error);
+  const GDBusInterfaceVTable vtable = { .get_property = get };
+  guint registered = g_dbus_connection_register_object (service, PATH, info->interfaces[0], &vtable, NULL, NULL, &error); g_assert_no_error (error); g_assert_cmpuint (registered, >, 0);
+  name_call ("RequestName"); cc_object_storage_initialize ();
+  g_test_add_func ("/settings/properties/values-and-owner", values_and_owner);
+  g_test_add_func ("/settings/properties/missing-and-cancelled", missing_and_cancelled);
+  g_test_add_func ("/settings/properties/invalid", invalid);
+  g_test_add_func ("/settings/properties/native-contracts", service_contracts);
+  int status = g_test_run ();
+  cc_object_storage_destroy (); g_dbus_connection_unregister_object (service, registered);
+  g_dbus_connection_close_sync (service, NULL, NULL); g_clear_object (&service); spin (100); g_test_dbus_down (bus);
+  return status;
+}
diff --git a/shell/test-luma-search-locations.c b/shell/test-luma-search-locations.c
new file mode 100644
index 0000000..ebf9b29
--- /dev/null
+++ b/shell/test-luma-search-locations.c
@@ -0,0 +1,107 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-search-locations.h"
+#include <glib/gstdio.h>
+
+typedef struct { gboolean done, success; GError *error; } Result;
+static void finished (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Result *seen = data;
+  seen->success = cc_luma_search_locations_set_finish (G_SETTINGS (source), result, &seen->error);
+  seen->done = TRUE;
+}
+static void await (Result *result)
+{
+  gint64 deadline = g_get_monotonic_time () + 5000000;
+  while (!result->done && g_get_monotonic_time () < deadline) {
+    while (g_main_context_iteration (NULL, FALSE)) {} g_usleep (1000);
+  }
+  g_assert_true (result->done);
+}
+static gboolean contains (char **values, const char *needle)
+{
+  for (guint i = 0; values[i]; i++) if (g_str_equal (values[i], needle)) return TRUE;
+  return FALSE;
+}
+static void consistent (GSettings *settings, const char *key, guint *notifications)
+{
+  g_auto(GStrv) recursive = cc_luma_search_locations_dup (settings, TRUE);
+  g_auto(GStrv) single = cc_luma_search_locations_dup (settings, FALSE);
+  g_assert_cmpint (contains (recursive, "/tmp/chosen.with.dots"), ==,
+                   contains (single, "/tmp/chosen.with.dots"));
+  (*notifications)++;
+}
+static void scoped_edit (void)
+{
+  g_autoptr (GSettings) settings = g_settings_new ("org.project_luma.settings-search-test");
+  g_settings_reset (settings, "index-recursive-directories"); g_settings_reset (settings, "index-single-directories");
+  g_autofree char *dir = g_dir_make_tmp ("luma-settings-search-XXXXXX", NULL); g_assert_nonnull (dir);
+  g_autoptr (GFile) folder = g_file_new_for_path ("/tmp/chosen.with.dots");
+  Result result = { 0 };
+  cc_luma_search_locations_set_async (settings, folder, TRUE, dir, NULL, finished, &result);
+  g_assert_false (result.done); await (&result); g_assert_no_error (result.error); g_assert_true (result.success);
+  g_auto (GStrv) current = cc_luma_search_locations_dup (settings, TRUE);
+  g_assert_cmpuint (g_strv_length (current), ==, 3);
+  g_assert_true (contains (current, "$HOME")); g_assert_true (contains (current, "/tmp/unrelated")); g_assert_true (contains (current, "/tmp/chosen.with.dots"));
+  g_auto (GStrv) single = cc_luma_search_locations_dup (settings, FALSE);
+  g_assert_cmpstr (single[0], ==, "/tmp/single"); g_assert_null (single[1]);
+  g_autoptr (GDir) listing = g_dir_open (dir, 0, NULL);
+  const char *name = g_dir_read_name (listing); g_assert_nonnull (name);
+  g_autofree char *backup_path = g_build_filename (dir, name, NULL);
+  g_assert_null (g_dir_read_name (listing));
+  g_autofree char *first_backup = NULL; g_assert_true (g_file_get_contents (backup_path, &first_backup, NULL, NULL));
+  GStatBuf statbuf; g_assert_cmpint (g_stat (backup_path, &statbuf), ==, 0); g_assert_cmpuint (statbuf.st_mode & 0777, ==, 0600);
+  g_autoptr (GVariant) saved = g_variant_parse (G_VARIANT_TYPE ("(ssv)"), first_backup, NULL, NULL, NULL); g_assert_nonnull (saved);
+  const char *schema, *key; g_autoptr (GVariant) original = NULL;
+  g_variant_get (saved, "(&s&sv)", &schema, &key, &original);
+  g_assert_cmpstr (schema, ==, "org.project_luma.settings-search-test"); g_assert_cmpstr (key, ==, "index-recursive-directories");
+  g_auto (GStrv) old = g_variant_dup_strv (original, NULL); g_assert_cmpuint (g_strv_length (old), ==, 2); g_assert_false (contains (old, "/tmp/chosen.with.dots"));
+  /* An unrelated edit between user actions must survive the later removal. */
+  const char *newer[] = { "$HOME", "/tmp/unrelated", "/tmp/chosen.with.dots", "/tmp/newer", NULL };
+  g_assert_true (g_settings_set_strv (settings, "index-recursive-directories", newer));
+  const char *newer_single[] = { "/tmp/single", "/tmp/chosen.with.dots", "/tmp/newer-single", NULL };
+  g_assert_true (g_settings_set_strv (settings, "index-single-directories", newer_single));
+  guint notifications = 0;
+  gulong watch = g_signal_connect (settings, "changed", G_CALLBACK (consistent), &notifications);
+  result = (Result) { 0 }; cc_luma_search_locations_set_async (settings, folder, FALSE, dir, NULL, finished, &result); await (&result);
+  g_assert_no_error (result.error); g_assert_true (result.success);
+  g_auto (GStrv) removed = cc_luma_search_locations_dup (settings, TRUE);
+  g_assert_true (contains (removed, "/tmp/newer")); g_assert_false (contains (removed, "/tmp/chosen.with.dots")); g_assert_cmpuint (g_strv_length (removed), ==, 3);
+  g_auto (GStrv) unchanged_single = cc_luma_search_locations_dup (settings, FALSE);
+  g_assert_cmpstr (unchanged_single[0], ==, "/tmp/single");
+  g_assert_cmpstr (unchanged_single[1], ==, "/tmp/newer-single"); g_assert_null (unchanged_single[2]);
+  while (g_main_context_iteration (NULL, FALSE)) {}
+  g_assert_cmpuint (notifications, >=, 1); g_signal_handler_disconnect (settings, watch);
+  g_autofree char *later_backup = NULL; g_assert_true (g_file_get_contents (backup_path, &later_backup, NULL, NULL)); g_assert_cmpstr (later_backup, ==, first_backup);
+  /* Cancellation and an invalid earlier backup both refuse the write. */
+  g_autoptr (GCancellable) cancel = g_cancellable_new (); g_cancellable_cancel (cancel);
+  result = (Result) { 0 }; cc_luma_search_locations_set_async (settings, folder, TRUE, dir, cancel, finished, &result); await (&result);
+  g_assert_false (result.success); g_assert_error (result.error, G_IO_ERROR, G_IO_ERROR_CANCELLED); g_clear_error (&result.error);
+  g_assert_cmpint (g_chmod (backup_path, 0644), ==, 0);
+  result = (Result) { 0 }; cc_luma_search_locations_set_async (settings, folder, TRUE, dir, NULL, finished, &result); await (&result);
+  g_assert_false (result.success); g_assert_error (result.error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA); g_clear_error (&result.error);
+  g_assert_cmpint (g_chmod (backup_path, 0600), ==, 0);
+  g_autoptr(GSettings) delayed = g_settings_new ("org.project_luma.settings-search-test");
+  g_settings_delay (delayed);
+  const char *pending[] = { "/tmp/unrelated-uncommitted-draft", NULL };
+  g_assert_true (g_settings_set_strv (delayed, "index-recursive-directories", pending));
+  result = (Result) { 0 }; cc_luma_search_locations_set_async (delayed, folder, TRUE, dir, NULL, finished, &result); await (&result);
+  g_assert_false (result.success); g_assert_error (result.error, G_IO_ERROR, G_IO_ERROR_PENDING); g_clear_error (&result.error);
+  g_assert_true (g_settings_get_has_unapplied (delayed));
+  g_auto(GStrv) committed = cc_luma_search_locations_dup (settings, TRUE);
+  g_assert_false (contains (committed, "/tmp/unrelated-uncommitted-draft"));
+  g_settings_revert (delayed);
+  g_assert_true (g_file_set_contents (backup_path, "broken backup", -1, NULL));
+  result = (Result) { 0 }; cc_luma_search_locations_set_async (settings, folder, TRUE, dir, NULL, finished, &result); await (&result);
+  g_assert_false (result.success); g_assert_nonnull (result.error); g_clear_error (&result.error);
+  g_auto (GStrv) after_failure = cc_luma_search_locations_dup (settings, TRUE); g_assert_false (contains (after_failure, "/tmp/chosen.with.dots"));
+  g_autoptr (GDir) cleanup = g_dir_open (dir, 0, NULL); guint backups = 0;
+  while ((name = g_dir_read_name (cleanup))) { g_autofree char *p = g_build_filename (dir, name, NULL); g_assert_cmpint (g_remove (p), ==, 0); backups++; }
+  g_assert_cmpuint (backups, ==, 2); g_assert_cmpint (g_rmdir (dir), ==, 0);
+}
+int main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_assert_cmpstr (g_getenv ("GSETTINGS_BACKEND"), ==, "memory");
+  g_test_add_func ("/settings/search-locations/scoped-edit", scoped_edit);
+  return g_test_run ();
+}
