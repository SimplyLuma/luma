+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <gio/gio.h>
+#include <json-glib/json-glib.h>
+G_BEGIN_DECLS
+#define CC_TYPE_LUMA_AUDIO (cc_luma_audio_get_type ())
+G_DECLARE_FINAL_TYPE (CcLumaAudio, cc_luma_audio, CC, LUMA_AUDIO, GObject)
+/* Read-only, asynchronous Gvc connection. No recording, test sound, route,
+ * volume or Luma AudioDevices1 policy write happens on start or refresh. */
+CcLumaAudio *cc_luma_audio_new (void);
+void cc_luma_audio_start (CcLumaAudio *self);
+void cc_luma_audio_stop (CcLumaAudio *self);
+/* NULL until ready; caller owns an independent snapshot. ::changed and
