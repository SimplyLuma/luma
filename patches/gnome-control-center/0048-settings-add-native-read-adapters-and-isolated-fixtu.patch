+  g_assert_true (cc_luma_search_add_place (model, uri, NULL));
+  g_assert_cmpuint (json_object_get_size (places), ==, size + 1);
+  g_assert_true (cc_luma_search_set_place (model, uri, FALSE, NULL));
+  g_assert_cmpuint (cc_luma_search_place_count (model), ==, before);
+  g_assert_true (json_object_get_boolean_member (places, "Documents"));
