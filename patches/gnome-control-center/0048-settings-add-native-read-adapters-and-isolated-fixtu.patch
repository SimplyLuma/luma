+ * ao device catalogue or a(udu) charge history. No Refresh or threshold write.
+ * Initialize CcObjectStorage before starting; cancel with the view generation. */
+void cc_luma_power_enumerate_async (GCancellable *cancel, GAsyncReadyCallback callback, gpointer data);
+void cc_luma_power_history_async (const char *device_path, GCancellable *cancel, GAsyncReadyCallback callback, gpointer data);
+GVariant *cc_luma_power_read_finish (GAsyncResult *result, GError **error);
+gboolean cc_luma_power_history_validate (GVariant *history, GError **error);
