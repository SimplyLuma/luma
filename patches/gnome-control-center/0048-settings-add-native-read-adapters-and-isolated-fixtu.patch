+static void live_search_folders (void)
+{
+  g_assert_cmpstr (g_getenv ("GSETTINGS_BACKEND"), ==, "memory");
+  g_autoptr (CcLumaFixture) model = load ();
+  g_autoptr (GSettings) settings = g_settings_new ("org.project_luma.settings-search-test");
+  const char *initial[] = { "/tmp/real.folders", "/tmp/keep", NULL };
+  const char *single[] = { "/tmp/real.folders", "/tmp/single.keep", NULL };
+  g_assert_true (g_settings_set_strv (settings, "index-recursive-directories", initial));
+  g_assert_true (g_settings_set_strv (settings, "index-single-directories", single));
+  g_autofree char *dir = g_dir_make_tmp ("luma-settings-search-view-XXXXXX", NULL); g_assert_nonnull (dir);
+  GtkWidget *view = g_object_ref_sink (cc_luma_view_new (model, "search-places", NULL));
+  g_assert_true (cc_luma_view_bind_search_locations (view, settings, dir, NULL)); drain ();
+  g_assert_null (find_name (view, "cf-sl-Archive HD"));
+  GtkWidget *button = find_name (view, "cf-sl-file:///tmp/real.folders"); g_assert_true (GTK_IS_SWITCH (button));
+  g_assert_true (gtk_switch_get_active (GTK_SWITCH (button)));
+  gtk_switch_set_active (GTK_SWITCH (button), FALSE);
+  gint64 deadline = g_get_monotonic_time () + 5000000;
+  JsonObject *places = json_node_get_object (cc_luma_fixture_get (model, "sl"));
+  while (json_object_get_boolean_member (places, "file:///tmp/real.folders") && g_get_monotonic_time () < deadline) wait_ms (10);
+  g_assert_false (json_object_get_boolean_member (places, "file:///tmp/real.folders")); wait_ms (100);
+  g_auto (GStrv) recursive = cc_luma_search_locations_dup (settings, TRUE);
+  g_auto (GStrv) actual_single = cc_luma_search_locations_dup (settings, FALSE);
+  g_assert_cmpstr (recursive[0], ==, "/tmp/keep"); g_assert_null (recursive[1]);
+  g_assert_cmpstr (actual_single[0], ==, "/tmp/single.keep"); g_assert_null (actual_single[1]);
+  const char *external[] = { "/tmp/keep", "/tmp/external.edit", NULL };
+  g_assert_true (g_settings_set_strv (settings, "index-recursive-directories", external)); drain ();
+  g_assert_nonnull (find_name (view, "cf-sl-file:///tmp/external.edit"));
+  g_assert_null (cc_luma_view_get_error (view)); g_object_unref (view); wait_ms (100);
+  g_autoptr (GDir) backups = g_dir_open (dir, 0, NULL); const char *name; guint count = 0;
+  while ((name = g_dir_read_name (backups))) { g_autofree char *p = g_build_filename (dir, name, NULL); g_assert_cmpint (g_remove (p), ==, 0); count++; }
+  g_assert_cmpuint (count, ==, 2); g_assert_cmpint (g_rmdir (dir), ==, 0);
+}
