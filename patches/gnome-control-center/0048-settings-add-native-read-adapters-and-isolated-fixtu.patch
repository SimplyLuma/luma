diff --git a/shell/cc-luma-application-options.c b/shell/cc-luma-application-options.c
new file mode 100644
index 0000000..41cd1fd
--- /dev/null
+++ b/shell/cc-luma-application-options.c
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-application-options.h"
+#include <gio/gio.h>
+static const struct { const char *key; const char *choices[5]; } fields[] = {
+  { "def.web", { "viola", NULL } }, { "def.mail", { "charlie", NULL } },
+  { "def.cal", { "calendar", NULL } }, { "def.music", { "tide", NULL } },
+  { "def.video", { "viewer", "reel", NULL } }, { "def.photo", { "photos", "viewer", "darkroom", NULL } },
+  { "media.audio", { "ask", "folder", "nothing", "tide", NULL } },
+  { "media.photos", { "ask", "folder", "nothing", "photos", NULL } },
+  { "media.video", { "ask", "folder", "nothing", "viewer", NULL } },
+  { "media.software", { "ask", "folder", "nothing", NULL } },
+};
+static gboolean allowed (guint field, JsonNode *value)
+{
+  if (!value || json_node_get_value_type (value) != G_TYPE_STRING) return FALSE;
+  for (guint i = 0; fields[field].choices[i]; i++)
+    if (g_str_equal (json_node_get_string (value), fields[field].choices[i])) return TRUE;
+  return FALSE;
+}
+gboolean cc_luma_application_options_validate (CcLumaFixture *model)
+{
+  JsonNode *flag = cc_luma_fixture_get (model, "neverMedia");
+  if (!flag || json_node_get_value_type (flag) != G_TYPE_BOOLEAN) return FALSE;
+  for (guint i = 0; i < G_N_ELEMENTS (fields); i++)
+    if (!allowed (i, cc_luma_fixture_get (model, fields[i].key))) return FALSE;
+  return TRUE;
+}
+gboolean cc_luma_application_option_set (CcLumaFixture *model, const char *key, JsonNode *value, GError **error)
+{
+  if (key && cc_luma_application_options_validate (model)) {
+    if (g_str_equal (key, "neverMedia") && value && json_node_get_value_type (value) == G_TYPE_BOOLEAN)
+      return cc_luma_fixture_set (model, key, value, error);
+    for (guint i = 0; i < G_N_ELEMENTS (fields); i++)
+      if (g_str_equal (key, fields[i].key) && allowed (i, value)) return cc_luma_fixture_set (model, key, value, error);
+  }
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid Settings application option"); return FALSE;
+}
