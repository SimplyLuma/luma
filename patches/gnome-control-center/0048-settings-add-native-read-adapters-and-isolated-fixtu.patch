diff --git a/shell/cc-luma-preferences.c b/shell/cc-luma-preferences.c
new file mode 100644
index 0000000..4d66b80
--- /dev/null
+++ b/shell/cc-luma-preferences.c
@@ -0,0 +1,177 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-preferences.h"
+#include <string.h>
+
+struct _CcLumaPreferences {
+  GObject parent_instance;
+  GSettings *settings;
+  char **keys;
+  GVariant *values, *writable;
+  guint idle;
+  gulong changed, writable_changed;
+};
+G_DEFINE_TYPE (CcLumaPreferences, cc_luma_preferences, G_TYPE_OBJECT)
+static guint signal_changed;
+
+static gboolean refresh (gpointer data)
+{
+  CcLumaPreferences *self = data;
+  g_autoptr(CcLumaPreferences) hold = g_object_ref (self);
+  self->idle = 0;
+  GVariantBuilder values, writable;
+  g_variant_builder_init (&values, G_VARIANT_TYPE_VARDICT);
+  g_variant_builder_init (&writable, G_VARIANT_TYPE ("a{sb}"));
+  for (guint i = 0; self->keys[i]; i++) {
+    g_autoptr(GVariant) value = g_settings_get_value (self->settings, self->keys[i]);
+    g_variant_builder_add (&values, "{sv}", self->keys[i], value);
+    g_variant_builder_add (&writable, "{sb}", self->keys[i], g_settings_is_writable (self->settings, self->keys[i]));
+  }
+  g_clear_pointer (&self->values, g_variant_unref);
+  g_clear_pointer (&self->writable, g_variant_unref);
+  self->values = g_variant_ref_sink (g_variant_builder_end (&values));
+  self->writable = g_variant_ref_sink (g_variant_builder_end (&writable));
+  g_signal_emit (self, signal_changed, 0);
+  return G_SOURCE_REMOVE;
+}
+static void settings_changed (GSettings *settings, const char *key, CcLumaPreferences *self)
+{
+  for (guint i = 0; self->keys[i]; i++)
+    if (g_str_equal (key, self->keys[i])) {
+      if (!self->idle) self->idle = g_idle_add (refresh, self);
+      return;
+    }
+}
+
+CcLumaPreferences *cc_luma_preferences_new (GSettings *settings, const char * const *keys, GError **error)
+{
+  g_autoptr(GSettingsSchema) schema = NULL;
+  if (G_IS_SETTINGS (settings)) g_object_get (settings, "settings-schema", &schema, NULL);
+  if (!schema || !keys || !keys[0]) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid Settings preference observer");
+    return NULL;
+  }
+  g_autoptr(GHashTable) selected = g_hash_table_new (g_str_hash, g_str_equal);
+  for (guint i = 0; keys[i]; i++) {
+    if (!*keys[i] || !g_settings_schema_has_key (schema, keys[i]) || g_hash_table_contains (selected, keys[i])) {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Missing or duplicate native Settings key: %s", keys[i]);
+      return NULL;
+    }
+    g_hash_table_add (selected, (gpointer) keys[i]);
+  }
+  CcLumaPreferences *self = g_object_new (CC_TYPE_LUMA_PREFERENCES, NULL);
+  self->settings = g_object_ref (settings);
+  self->keys = g_strdupv ((char **) keys);
+  return self;
+}
+
+CcLumaPreferences *cc_luma_preferences_new_schema (const char *schema_id, const char *path, const char * const *keys, GError **error)
+{
+  if (g_getenv ("LUMA_SETTINGS_FIXTURE")) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                         "Fixture Settings cannot open native preference schemas");
+    return NULL;
+  }
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr(GSettingsSchema) schema = source && schema_id && *schema_id ?
+    g_settings_schema_source_lookup (source, schema_id, TRUE) : NULL;
+  if (!schema) {
+    g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Native Settings schema is unavailable: %s", schema_id ? schema_id : "(none)");
+    return NULL;
+  }
+  const char *fixed = g_settings_schema_get_path (schema);
+  /* GSettings paths end in a slash and can contain application-ID hyphens;
+   * they are not D-Bus object paths. */
+  if ((!fixed && (!path || !g_utf8_validate (path, -1, NULL) || !g_str_has_prefix (path, "/") ||
+                  !g_str_has_suffix (path, "/") || strstr (path, "//"))) ||
+      (fixed && path && g_strcmp0 (fixed, path) != 0)) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid native Settings schema path");
+    return NULL;
+  }
+  g_autoptr(GSettings) settings = g_settings_new_full (schema, NULL, path);
+  return cc_luma_preferences_new (settings, keys, error);
+}
+
+void cc_luma_preferences_stop (CcLumaPreferences *self)
+{
+  if (self->idle) { g_source_remove (self->idle); self->idle = 0; }
+  if (self->changed) { g_signal_handler_disconnect (self->settings, self->changed); self->changed = 0; }
+  if (self->writable_changed) { g_signal_handler_disconnect (self->settings, self->writable_changed); self->writable_changed = 0; }
+  g_clear_pointer (&self->values, g_variant_unref);
+  g_clear_pointer (&self->writable, g_variant_unref);
+}
+
+CcLumaPreferences *cc_luma_preferences_new_native (CcLumaPreferenceSet set, GError **error)
+{
+  /* Names and ownership follow the installed display, mouse, keyboard,
+   * notifications and multitasking panels. This catalog performs no writes. */
+  static const struct { const char *schema; const char *keys[10]; const char *types[10]; } native[] = {
+    { "org.gnome.settings-daemon.plugins.color",
+      { "night-light-enabled", "night-light-schedule-automatic", "night-light-schedule-from", "night-light-schedule-to", "night-light-temperature", NULL },
+      { "b", "b", "d", "d", "u", NULL } },
+    { "org.gnome.desktop.peripherals.mouse",
+      { "left-handed", "natural-scroll", "speed", "accel-profile", NULL }, { "b", "b", "d", "s", NULL } },
+    { "org.gnome.desktop.peripherals.touchpad",
+      { "send-events", "natural-scroll", "speed", "tap-to-click", "click-method", "two-finger-scrolling-enabled", "edge-scrolling-enabled", "disable-while-typing", NULL },
+      { "s", "b", "d", "b", "s", "b", "b", "b", NULL } },
+    { "org.gnome.desktop.input-sources",
+      { "sources", "per-window", "xkb-options", NULL }, { "a(ss)", "b", "as", NULL } },
+    { "org.gnome.desktop.notifications",
+      { "show-banners", "show-in-lock-screen", "application-children", NULL }, { "b", "b", "as", NULL } },
+    { "org.gnome.mutter",
+      { "workspaces-only-on-primary", "edge-tiling", "dynamic-workspaces", NULL }, { "b", "b", "b", NULL } },
+    { "org.gnome.desktop.wm.preferences", { "num-workspaces", NULL }, { "i", NULL } },
+    { "org.gnome.shell.app-switcher", { "current-workspace-only", NULL }, { "b", NULL } },
+    { "org.gnome.desktop.interface", { "enable-hot-corners", NULL }, { "b", NULL } },
+    { "org.gnome.settings-daemon.plugins.power",
+      { "ambient-enabled", "idle-dim", "power-saver-profile-on-low-battery", "sleep-inactive-battery-type", "sleep-inactive-battery-timeout", "sleep-inactive-ac-type", "sleep-inactive-ac-timeout", "power-button-action", NULL },
+      { "b", "b", "b", "s", "i", "s", "i", "s", NULL } },
+    { "org.gnome.desktop.session", { "idle-delay", NULL }, { "u", NULL } },
+    { "org.gnome.desktop.interface", { "show-battery-percentage", NULL }, { "b", NULL } },
+    { "org.gnome.desktop.media-handling",
+      { "autorun-never", "autorun-x-content-start-app", "autorun-x-content-ignore", "autorun-x-content-open-folder", NULL },
+      { "b", "as", "as", "as", NULL } },
+  };
+  G_STATIC_ASSERT (G_N_ELEMENTS (native) == CC_LUMA_PREFS_COUNT);
+  if ((guint) set >= G_N_ELEMENTS (native)) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Unknown native Settings preference set");
+    return NULL;
+  }
+  g_autoptr(CcLumaPreferences) self = cc_luma_preferences_new_schema (native[set].schema, NULL, native[set].keys, error);
+  if (!self) return NULL;
+  g_autoptr(GSettingsSchema) schema = NULL;
+  g_object_get (self->settings, "settings-schema", &schema, NULL);
+  for (guint i = 0; native[set].keys[i]; i++) {
+    g_autoptr(GSettingsSchemaKey) key = g_settings_schema_get_key (schema, native[set].keys[i]);
+    if (!g_variant_type_equal (g_settings_schema_key_get_value_type (key), G_VARIANT_TYPE (native[set].types[i]))) {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Unexpected native Settings key type: %s", native[set].keys[i]);
+      return NULL;
+    }
+  }
+  return g_steal_pointer (&self);
+}
+void cc_luma_preferences_start (CcLumaPreferences *self)
+{
+  cc_luma_preferences_stop (self);
+  self->changed = g_signal_connect_object (self->settings, "changed", G_CALLBACK (settings_changed), self, 0);
+  self->writable_changed = g_signal_connect_object (self->settings, "writable-changed", G_CALLBACK (settings_changed), self, 0);
+  self->idle = g_idle_add (refresh, self);
+}
+GVariant *cc_luma_preferences_dup_values (CcLumaPreferences *self) { return self->values ? g_variant_ref (self->values) : NULL; }
+GVariant *cc_luma_preferences_dup_writable (CcLumaPreferences *self) { return self->writable ? g_variant_ref (self->writable) : NULL; }
+static void dispose (GObject *object)
+{
+  CcLumaPreferences *self = CC_LUMA_PREFERENCES (object);
+  cc_luma_preferences_stop (self); g_clear_object (&self->settings);
+  G_OBJECT_CLASS (cc_luma_preferences_parent_class)->dispose (object);
+}
+static void finalize (GObject *object)
+{
+  g_strfreev (CC_LUMA_PREFERENCES (object)->keys);
+  G_OBJECT_CLASS (cc_luma_preferences_parent_class)->finalize (object);
+}
+static void cc_luma_preferences_init (CcLumaPreferences *self) {}
+static void cc_luma_preferences_class_init (CcLumaPreferencesClass *klass)
+{
+  GObjectClass *object = G_OBJECT_CLASS (klass); object->dispose = dispose; object->finalize = finalize;
+  signal_changed = g_signal_new ("changed", G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL, G_TYPE_NONE, 0);
+}
diff --git a/shell/cc-luma-preferences.h b/shell/cc-luma-preferences.h
new file mode 100644
index 0000000..2441030
--- /dev/null
+++ b/shell/cc-luma-preferences.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <gio/gio.h>
+G_BEGIN_DECLS
+#define CC_TYPE_LUMA_PREFERENCES (cc_luma_preferences_get_type ())
+G_DECLARE_FINAL_TYPE (CcLumaPreferences, cc_luma_preferences, CC, LUMA_PREFERENCES, GObject)
+/* Read-only glue for existing native schemas. The injected-object route
+ * permits memory-only tests; no fixture constructor opens a native schema. */
+CcLumaPreferences *cc_luma_preferences_new (GSettings *settings,
+  const char * const *keys, GError **error);
+CcLumaPreferences *cc_luma_preferences_new_schema (const char *schema_id,
+  const char *path, const char * const *keys, GError **error);
+typedef enum {
+  CC_LUMA_PREFS_NIGHT_LIGHT,
+  CC_LUMA_PREFS_MOUSE,
+  CC_LUMA_PREFS_TOUCHPAD,
+  CC_LUMA_PREFS_INPUT_SOURCES,
+  CC_LUMA_PREFS_NOTIFICATIONS,
+  CC_LUMA_PREFS_MUTTER,
+  CC_LUMA_PREFS_WORKSPACES,
+  CC_LUMA_PREFS_APP_SWITCHER,
+  CC_LUMA_PREFS_HOT_CORNERS,
+  CC_LUMA_PREFS_POWER,
+  CC_LUMA_PREFS_SESSION_IDLE,
+  CC_LUMA_PREFS_BATTERY_INDICATOR,
+  CC_LUMA_PREFS_REMOVABLE_MEDIA,
+  CC_LUMA_PREFS_COUNT,
+} CcLumaPreferenceSet;
+CcLumaPreferences *cc_luma_preferences_new_native (CcLumaPreferenceSet set,
+                                                    GError **error);
+void cc_luma_preferences_start (CcLumaPreferences *self);
+void cc_luma_preferences_stop (CcLumaPreferences *self);
+/* Immutable a{sv} values and a{sb} editability for requested keys only.
+ * Both are NULL until the first asynchronous ::changed notification. */
+GVariant *cc_luma_preferences_dup_values (CcLumaPreferences *self);
+GVariant *cc_luma_preferences_dup_writable (CcLumaPreferences *self);
+G_END_DECLS
diff --git a/shell/cc-luma-properties.c b/shell/cc-luma-properties.c
new file mode 100644
index 0000000..010b075
--- /dev/null
+++ b/shell/cc-luma-properties.c
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-properties.h"
+#include "cc-object-storage.h"
+
+struct _CcLumaProperties {
+  GObject parent_instance;
+  GBusType bus;
+  char *name, *path, *interface;
+  char **required;
+  GCancellable *cancel;
+  GDBusProxy *proxy;
+  GVariant *snapshot;
+  guint64 generation;
+};
+G_DEFINE_TYPE (CcLumaProperties, cc_luma_properties, G_TYPE_OBJECT)
+static guint signals[2];
+static void refresh (CcLumaProperties *self)
+{
+  g_autoptr (CcLumaProperties) hold = g_object_ref (self);
+  g_clear_pointer (&self->snapshot, g_variant_unref);
+  g_autofree char *owner = self->proxy ? g_dbus_proxy_get_name_owner (self->proxy) : NULL;
+  if (!owner) {
+    g_autoptr (GError) error = g_error_new (G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED, "Settings service is unavailable: %s", self->name);
+    g_signal_emit (self, signals[1], 0, error); return;
+  }
+  GVariantBuilder builder; g_variant_builder_init (&builder, G_VARIANT_TYPE_VARDICT);
+  for (guint i = 0; self->required[i]; i++) {
+    g_autoptr (GVariant) value = g_dbus_proxy_get_cached_property (self->proxy, self->required[i]);
+    if (!value) {
+      g_variant_builder_clear (&builder);
+      g_autoptr (GError) error = g_error_new (G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+        "Settings service %s lacks property %s", self->name, self->required[i]);
+      g_signal_emit (self, signals[1], 0, error); return;
+    }
+    g_variant_builder_add (&builder, "{sv}", self->required[i], value);
+  }
+  self->snapshot = g_variant_ref_sink (g_variant_builder_end (&builder));
+  g_signal_emit (self, signals[0], 0);
+}
+static void properties_changed (GDBusProxy *proxy, GVariant *changed, char **invalidated, CcLumaProperties *self) { refresh (self); }
+static void owner_changed (GObject *proxy, GParamSpec *spec, CcLumaProperties *self) { refresh (self); }
+typedef struct { GWeakRef self; guint64 generation; } Pending;
+static void connected (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Pending *pending = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GDBusProxy) proxy = cc_object_storage_create_dbus_proxy_finish (result, &error);
+  g_autoptr (CcLumaProperties) self = g_weak_ref_get (&pending->self);
+  if (self && self->generation == pending->generation) {
+    if (!proxy) {
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) g_signal_emit (self, signals[1], 0, error);
+    } else {
+      self->proxy = g_steal_pointer (&proxy);
+      g_signal_connect_object (self->proxy, "g-properties-changed", G_CALLBACK (properties_changed), self, 0);
+      g_signal_connect_object (self->proxy, "notify::g-name-owner", G_CALLBACK (owner_changed), self, 0);
+      refresh (self);
+    }
+  }
+  g_weak_ref_clear (&pending->self); g_free (pending);
+}
+CcLumaProperties *cc_luma_properties_new (GBusType bus, const char *name, const char *path, const char *interface, const char * const *required, GError **error)
+{
+  if ((bus != G_BUS_TYPE_SESSION && bus != G_BUS_TYPE_SYSTEM) || !name || !g_dbus_is_name (name) || !path || !g_variant_is_object_path (path) ||
+      !interface || !g_dbus_is_interface_name (interface) || !required || !required[0]) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid Settings service observer"); return NULL;
+  }
+  g_autoptr (GHashTable) fields = g_hash_table_new (g_str_hash, g_str_equal);
+  for (guint i = 0; required[i]; i++) {
+    if (!g_dbus_is_member_name (required[i]) || g_hash_table_contains (fields, required[i])) {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid or duplicate Settings property name"); return NULL;
+    }
+    g_hash_table_add (fields, (gpointer) required[i]);
+  }
+  CcLumaProperties *self = g_object_new (CC_TYPE_LUMA_PROPERTIES, NULL);
+  self->bus = bus; self->name = g_strdup (name); self->path = g_strdup (path); self->interface = g_strdup (interface); self->required = g_strdupv ((char **) required);
+  return self;
+}
+void cc_luma_properties_stop (CcLumaProperties *self)
+{
+  self->generation++;
+  if (self->cancel) g_cancellable_cancel (self->cancel);
+  g_clear_object (&self->cancel);
+  if (self->proxy) g_signal_handlers_disconnect_by_data (self->proxy, self);
+  g_clear_object (&self->proxy); g_clear_pointer (&self->snapshot, g_variant_unref);
+}
+void cc_luma_properties_start (CcLumaProperties *self)
+{
+  cc_luma_properties_stop (self); self->cancel = g_cancellable_new ();
+  Pending *pending = g_new0 (Pending, 1); g_weak_ref_init (&pending->self, self); pending->generation = self->generation;
+  cc_object_storage_create_dbus_proxy (self->bus, G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START,
+    self->name, self->path, self->interface, self->cancel, connected, pending);
+}
+GVariant *cc_luma_properties_dup_snapshot (CcLumaProperties *self)
+{
+  if (!self->snapshot || !self->proxy) return NULL;
+  g_autofree char *owner = g_dbus_proxy_get_name_owner (self->proxy);
+  return owner ? g_variant_ref (self->snapshot) : NULL;
+}
+static void dispose (GObject *object)
+{
+  cc_luma_properties_stop (CC_LUMA_PROPERTIES (object)); G_OBJECT_CLASS (cc_luma_properties_parent_class)->dispose (object);
+}
+static void finalize (GObject *object)
+{
+  CcLumaProperties *self = CC_LUMA_PROPERTIES (object); g_free (self->name); g_free (self->path); g_free (self->interface); g_strfreev (self->required);
+  G_OBJECT_CLASS (cc_luma_properties_parent_class)->finalize (object);
+}
+static void cc_luma_properties_init (CcLumaProperties *self) {}
+static void cc_luma_properties_class_init (CcLumaPropertiesClass *klass)
+{
+  GObjectClass *object = G_OBJECT_CLASS (klass); object->dispose = dispose; object->finalize = finalize;
+  signals[0] = g_signal_new ("changed", G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL, G_TYPE_NONE, 0);
+  signals[1] = g_signal_new ("failed", G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL, G_TYPE_NONE, 1, G_TYPE_ERROR);
+}
diff --git a/shell/cc-luma-properties.h b/shell/cc-luma-properties.h
new file mode 100644
index 0000000..68b9477
--- /dev/null
+++ b/shell/cc-luma-properties.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <gio/gio.h>
+G_BEGIN_DECLS
+#define CC_TYPE_LUMA_PROPERTIES (cc_luma_properties_get_type ())
+G_DECLARE_FINAL_TYPE (CcLumaProperties, cc_luma_properties, CC, LUMA_PROPERTIES, GObject)
+/* Observer glue around Settings' existing CcObjectStorage async proxy API.
+ * No new proxy cache or service is introduced. Initialize CcObjectStorage
+ * through the existing application lifecycle before starting an observer. */
+CcLumaProperties *cc_luma_properties_new (GBusType bus, const char *name,
+  const char *path, const char *interface, const char * const *required,
+  GError **error);
+void cc_luma_properties_start (CcLumaProperties *self);
+void cc_luma_properties_stop (CcLumaProperties *self);
+/* An immutable a{sv} containing only the required properties, or NULL.
+ * ::changed / ::failed(GError) follow owner loss and property invalidation. */
+GVariant *cc_luma_properties_dup_snapshot (CcLumaProperties *self);
+G_END_DECLS
diff --git a/shell/cc-luma-search-locations.c b/shell/cc-luma-search-locations.c
new file mode 100644
index 0000000..b7ea848
--- /dev/null
+++ b/shell/cc-luma-search-locations.c
@@ -0,0 +1,236 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-search-locations.h"
+#define G_SETTINGS_ENABLE_BACKEND
+#include <gio/gsettingsbackend.h>
+#include <glib/gstdio.h>
+#include <errno.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+#define RECURSIVE "index-recursive-directories"
+#define SINGLE "index-single-directories"
+gboolean cc_luma_search_locations_check (GSettings *settings, GError **error)
+{
+  g_autoptr (GSettingsSchema) schema = NULL;
+  gboolean delayed = FALSE;
+  if (G_IS_SETTINGS (settings)) g_object_get (settings, "settings-schema", &schema, "delay-apply", &delayed, NULL);
+  if (delayed) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PENDING,
+                         "Search folder edits require committed native settings, not an unrelated delayed draft");
+    return FALSE;
+  }
+  if (schema && g_settings_schema_has_key (schema, RECURSIVE) && g_settings_schema_has_key (schema, SINGLE)) {
+    g_autoptr (GSettingsSchemaKey) recursive = g_settings_schema_get_key (schema, RECURSIVE);
+    g_autoptr (GSettingsSchemaKey) single = g_settings_schema_get_key (schema, SINGLE);
+    if (g_variant_type_equal (g_settings_schema_key_get_value_type (recursive), G_VARIANT_TYPE_STRING_ARRAY) &&
+        g_variant_type_equal (g_settings_schema_key_get_value_type (single), G_VARIANT_TYPE_STRING_ARRAY)) return TRUE;
+  }
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Invalid search indexer location schema"); return FALSE;
+}
+GSettings *cc_luma_search_locations_new (GError **error)
+{
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  const char *schemas[] = { "org.freedesktop.Tracker3.Miner.Files", "org.freedesktop.Tracker.Miner.Files" };
+  for (guint i = 0; source && i < G_N_ELEMENTS (schemas); i++) {
+    g_autoptr (GSettingsSchema) schema = g_settings_schema_source_lookup (source, schemas[i], TRUE);
+    if (!schema || !g_settings_schema_has_key (schema, RECURSIVE) || !g_settings_schema_has_key (schema, SINGLE)) continue;
+    g_autoptr (GSettingsSchemaKey) recursive = g_settings_schema_get_key (schema, RECURSIVE);
+    g_autoptr (GSettingsSchemaKey) single = g_settings_schema_get_key (schema, SINGLE);
+    if (g_variant_type_equal (g_settings_schema_key_get_value_type (recursive), G_VARIANT_TYPE_STRING_ARRAY) &&
+        g_variant_type_equal (g_settings_schema_key_get_value_type (single), G_VARIANT_TYPE_STRING_ARRAY))
+      return g_settings_new_full (schema, NULL, NULL);
+  }
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Search indexer location settings are unavailable"); return NULL;
+}
+char **cc_luma_search_locations_dup (GSettings *settings, gboolean recursive)
+{
+  return g_settings_get_strv (settings, recursive ? RECURSIVE : SINGLE);
+}
+/* Match upstream's special directory representation. Retain the original
+ * spelling of every unrelated item rather than rewriting the whole list. */
+static const char *expanded (const char *value)
+{
+  if (g_str_equal (value, "$HOME")) return g_get_home_dir ();
+  const char *tokens[] = { "&DESKTOP", "&DOCUMENTS", "&DOWNLOAD", "&MUSIC", "&PICTURES", "&PUBLIC_SHARE", "&TEMPLATES", "&VIDEOS" };
+  const GUserDirectory dirs[] = { G_USER_DIRECTORY_DESKTOP, G_USER_DIRECTORY_DOCUMENTS, G_USER_DIRECTORY_DOWNLOAD, G_USER_DIRECTORY_MUSIC, G_USER_DIRECTORY_PICTURES, G_USER_DIRECTORY_PUBLIC_SHARE, G_USER_DIRECTORY_TEMPLATES, G_USER_DIRECTORY_VIDEOS };
+  for (guint i = 0; i < G_N_ELEMENTS (tokens); i++) if (g_str_equal (value, tokens[i])) return g_get_user_special_dir (dirs[i]);
+  return value;
+}
+typedef struct { GFile *folder; gboolean enabled; char *backup_dir; } Edit;
+static gboolean same_folder (const char *value, GFile *folder)
+{
+  const char *path = expanded (value);
+  g_autoptr (GFile) candidate = path && g_path_is_absolute (path) ? g_file_new_for_path (path) : NULL;
+  return candidate && g_file_equal (candidate, folder);
+}
+GPtrArray *cc_luma_search_locations_dup_folders (GSettings *settings)
+{
+  GPtrArray *folders = g_ptr_array_new_with_free_func (g_object_unref);
+  const char *keys[] = { RECURSIVE, SINGLE };
+  for (guint k = 0; k < G_N_ELEMENTS (keys); k++) {
+    g_auto (GStrv) values = g_settings_get_strv (settings, keys[k]);
+    for (guint i = 0; values[i]; i++) {
+      const char *path = expanded (values[i]);
+      if (!path || !g_path_is_absolute (path)) continue;
+      g_autoptr (GFile) folder = g_file_new_for_path (path);
+      gboolean duplicate = FALSE;
+      for (guint j = 0; j < folders->len; j++) if (g_file_equal (folder, folders->pdata[j])) { duplicate = TRUE; break; }
+      if (!duplicate) g_ptr_array_add (folders, g_steal_pointer (&folder));
+    }
+  }
+  return folders;
+}
+static void edit_free (Edit *edit) { g_object_unref (edit->folder); g_free (edit->backup_dir); g_free (edit); }
+static gboolean sync_backup (const char *path, const char *dir, GError **error)
+{
+  const char *targets[] = { path, dir };
+  for (guint i = 0; i < G_N_ELEMENTS (targets); i++) {
+    int fd = g_open (targets[i], O_RDONLY | O_CLOEXEC | O_NOFOLLOW | (i ? O_DIRECTORY : 0), 0);
+    int saved_errno = 0;
+    if (fd < 0) saved_errno = errno;
+    else {
+      int result; do result = fsync (fd); while (result != 0 && errno == EINTR);
+      if (result != 0) saved_errno = errno;
+      if (close (fd) != 0 && !saved_errno) saved_errno = errno;
+    }
+    if (saved_errno) {
+      g_set_error (error, G_IO_ERROR, g_io_error_from_errno (saved_errno), "Cannot make Settings backup durable: %s", g_strerror (saved_errno)); return FALSE;
+    }
+  }
+  return TRUE;
+}
+static gboolean backup (GSettings *settings, const char *dir, const char *key, GCancellable *cancel, GError **error)
+{
+  g_autofree char *schema = NULL; g_object_get (settings, "schema-id", &schema, NULL);
+  g_autofree char *identity = g_strconcat (schema, "/", key, NULL);
+  g_autofree char *digest = g_compute_checksum_for_string (G_CHECKSUM_SHA256, identity, -1);
+  g_autofree char *name = g_strconcat (digest, ".variant", NULL);
+  if (g_mkdir_with_parents (dir, 0700) != 0) {
+    g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno), "Cannot create Settings backup directory: %s", g_strerror (errno)); return FALSE;
+  }
+  g_autofree char *path = g_build_filename (dir, name, NULL);
+  g_autoptr (GFile) file = g_file_new_for_path (path);
+  g_autoptr (GError) create_error = NULL;
+  g_autoptr (GFileOutputStream) stream = g_file_create (file, G_FILE_CREATE_PRIVATE, cancel, &create_error);
+  if (!stream) {
+    if (!g_error_matches (create_error, G_IO_ERROR, G_IO_ERROR_EXISTS)) { g_propagate_error (error, g_steal_pointer (&create_error)); return FALSE; }
+    /* A first-kind backup is immutable. Refuse a malformed previous backup
+     * rather than overwrite it or proceed without recovery evidence. */
+    g_autoptr(GFileInfo) info = g_file_query_info (file,
+      G_FILE_ATTRIBUTE_STANDARD_TYPE "," G_FILE_ATTRIBUTE_UNIX_MODE "," G_FILE_ATTRIBUTE_UNIX_UID,
+      G_FILE_QUERY_INFO_NOFOLLOW_SYMLINKS, cancel, error);
+    if (!info) return FALSE;
+    if (g_file_info_get_file_type (info) != G_FILE_TYPE_REGULAR ||
+        (g_file_info_get_attribute_uint32 (info, G_FILE_ATTRIBUTE_UNIX_MODE) & 0777) != 0600 ||
+        g_file_info_get_attribute_uint32 (info, G_FILE_ATTRIBUTE_UNIX_UID) != getuid ()) {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                           "Settings backup must be a private regular file owned by this user");
+      return FALSE;
+    }
+    g_autofree char *contents = NULL;
+    if (!g_file_load_contents (file, cancel, &contents, NULL, NULL, error)) return FALSE;
+    g_autoptr (GVariant) saved = g_variant_parse (G_VARIANT_TYPE ("(ssv)"), contents, NULL, NULL, error);
+    if (!saved) return FALSE;
+    const char *old_schema, *old_key; g_autoptr (GVariant) old_value = NULL;
+    g_variant_get (saved, "(&s&sv)", &old_schema, &old_key, &old_value);
+    if (!g_str_equal (old_schema, schema) || !g_str_equal (old_key, key) || !g_variant_is_of_type (old_value, G_VARIANT_TYPE_STRING_ARRAY)) {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Settings backup does not match the edited setting"); return FALSE;
+    }
+    return sync_backup (path, dir, error);
+  }
+  g_autoptr (GVariant) before = g_settings_get_value (settings, key);
+  g_autoptr (GVariant) saved = g_variant_ref_sink (g_variant_new ("(ssv)", schema, key, before));
+  g_autofree char *contents = g_variant_print (saved, TRUE);
+  gboolean written = g_output_stream_write_all (G_OUTPUT_STREAM (stream), contents, strlen (contents), NULL, cancel, error);
+  if (written) written = g_output_stream_close (G_OUTPUT_STREAM (stream), cancel, error);
+  if (written) written = sync_backup (path, dir, error);
+  if (!written) { g_output_stream_close (G_OUTPUT_STREAM (stream), NULL, NULL); g_file_delete (file, NULL, NULL); }
+  return written;
+}
+static void apply (GTask *task, gpointer source, gpointer task_data, GCancellable *cancel)
+{
+  static GMutex writes;
+  g_autoptr (GMutexLocker) lock = g_mutex_locker_new (&writes);
+  GSettings *settings = source; Edit *edit = task_data;
+  g_autoptr (GError) error = NULL;
+  if (!cc_luma_search_locations_check (settings, &error)) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  g_autofree char *path = g_file_get_path (edit->folder);
+  if (!path || !g_path_is_absolute (path)) { g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Search folders must be local folders"); return; }
+  const char *keys[] = { RECURSIVE, SINGLE };
+  guint count = edit->enabled ? 1 : 2;
+  for (guint k = 0; k < count; k++)
+    if (!g_settings_is_writable (settings, keys[k])) { g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Search folder settings are locked"); return; }
+  if (g_task_return_error_if_cancelled (task)) return;
+  for (guint k = 0; k < count; k++)
+    if (!backup (settings, edit->backup_dir, keys[k], cancel, &error)) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  if (g_task_return_error_if_cancelled (task)) return;
+  /* Stage only this edit on a separate object backed by the SAME injected
+   * backend. Never place the view's shared GSettings into permanent delay
+   * mode. Both indexer keys commit together, or staging fails before writes.
+   * https://docs.gtk.org/gio/method.Settings.delay.html */
+  if (!cc_luma_search_locations_check (settings, &error)) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  g_autoptr(GSettingsSchema) schema = NULL;
+  g_autoptr(GObject) backend = NULL;
+  g_autofree char *settings_path = NULL;
+  g_object_get (settings, "settings-schema", &schema, "backend", &backend, "path", &settings_path, NULL);
+  g_autoptr(GSettings) transaction = g_settings_new_full (schema, (GSettingsBackend *) backend, settings_path);
+  g_settings_delay (transaction);
+  /* Read again after backup I/O so intervening unrelated edits survive. */
+  for (guint k = 0; k < count; k++) {
+    g_auto (GStrv) current = g_settings_get_strv (settings, keys[k]);
+    g_autoptr (GPtrArray) next = g_ptr_array_new_with_free_func (g_free);
+    gboolean found = FALSE;
+    for (guint i = 0; current[i]; i++) {
+      gboolean same = same_folder (current[i], edit->folder);
+      if (same) found = TRUE;
+      if (!same || edit->enabled) g_ptr_array_add (next, g_strdup (current[i]));
+    }
+    if (!found && edit->enabled) g_ptr_array_add (next, g_strdup (path));
+    g_ptr_array_add (next, NULL);
+    if (g_strv_equal ((const char * const *) current, (const char * const *) next->pdata)) continue;
+    if (!g_settings_set_strv (transaction, keys[k], (const char * const *) next->pdata)) {
+      g_settings_revert (transaction);
+      g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_FAILED, "Search indexer rejected the folder update (%s)", keys[k]); return;
+    }
+  }
+  if (g_task_return_error_if_cancelled (task)) { g_settings_revert (transaction); return; }
+  /* Once the scoped transaction starts committing, report its result rather
+   * than a late cancellation that would falsely imply no edit occurred. */
+  g_task_set_check_cancellable (task, FALSE);
+  g_settings_apply (transaction);
+  g_task_return_boolean (task, TRUE);
+}
+void cc_luma_search_locations_set_async (GSettings *settings, GFile *folder, gboolean enabled, const char *backup_dir, GCancellable *cancel, GAsyncReadyCallback callback, gpointer data)
+{
+  g_return_if_fail (G_IS_SETTINGS (settings));
+  g_autoptr (GTask) task = g_task_new (settings, cancel, callback, data);
+  g_task_set_source_tag (task, cc_luma_search_locations_set_async);
+  g_autoptr (GError) error = NULL;
+  if (!cc_luma_search_locations_check (settings, &error)) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  if (!G_IS_FILE (folder) || !backup_dir || !g_path_is_absolute (backup_dir)) { g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid Settings folder edit"); return; }
+  /* Test-store permission follows the actual injected backend, never an
+   * environment label that could disagree with that object. */
+  g_autoptr(GObject) backend = NULL;
+  g_object_get (settings, "backend", &backend, NULL);
+  g_autoptr(GObject) memory = G_OBJECT (g_memory_settings_backend_new ());
+  gboolean isolated = backend && g_type_is_a (G_OBJECT_TYPE (backend), G_OBJECT_TYPE (memory));
+  if (!isolated) {
+    g_autofree char *expected = g_build_filename (g_get_user_data_dir (), "luma", "settings", "backups", NULL);
+    g_autofree char *normalized = g_canonicalize_filename (backup_dir, NULL);
+    if (g_strcmp0 (expected, normalized) != 0) {
+      g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                              "Native Settings backups must stay in the documented app-local backup store");
+      return;
+    }
+  }
+  Edit *edit = g_new0 (Edit, 1); edit->folder = g_object_ref (folder); edit->enabled = enabled; edit->backup_dir = g_strdup (backup_dir);
+  g_task_set_task_data (task, edit, (GDestroyNotify) edit_free);
+  g_task_run_in_thread (task, apply);
+}
+gboolean cc_luma_search_locations_set_finish (GSettings *settings, GAsyncResult *result, GError **error)
+{
+  g_return_val_if_fail (g_task_is_valid (result, settings), FALSE);
+  g_return_val_if_fail (g_async_result_is_tagged (result, cc_luma_search_locations_set_async), FALSE);
+  return g_task_propagate_boolean (G_TASK (result), error);
+}
diff --git a/shell/cc-luma-search-locations.h b/shell/cc-luma-search-locations.h
new file mode 100644
index 0000000..110bab1
--- /dev/null
+++ b/shell/cc-luma-search-locations.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <gio/gio.h>
+G_BEGIN_DECLS
+/* The upstream Tracker settings own indexing. No daemon, replay script or new
+ * index is introduced. Missing schemas return an explicit unavailable error. */
+GSettings *cc_luma_search_locations_new (GError **error);
+gboolean cc_luma_search_locations_check (GSettings *settings, GError **error);
+char **cc_luma_search_locations_dup (GSettings *settings, gboolean recursive);
+GPtrArray *cc_luma_search_locations_dup_folders (GSettings *settings);
+/* The caller supplies its contained app-owned backup directory. Tests supply
+ * a temporary directory and a memory GSettings backend. Backup I/O and the
+ * scoped update run off the UI thread. Adding uses the recursive key, as
+ * upstream does. Disabling removes only this folder from either key. */
+void cc_luma_search_locations_set_async (GSettings *settings, GFile *folder,
+  gboolean enabled, const char *backup_dir, GCancellable *cancel,
+  GAsyncReadyCallback callback, gpointer data);
+gboolean cc_luma_search_locations_set_finish (GSettings *settings,
+  GAsyncResult *result, GError **error);
+G_END_DECLS
diff --git a/shell/cc-luma-services.c b/shell/cc-luma-services.c
new file mode 100644
index 0000000..c56bdbf
--- /dev/null
+++ b/shell/cc-luma-services.c
@@ -0,0 +1,94 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-services.h"
+#include <math.h>
+
+typedef struct {
+  GBusType bus;
+  const char *name, *path, *interface;
+  const char *fields[9];
+  const char *types[9];
+} Contract;
+
+/* Color and PowerProfiles identities follow the installed 50.4 panels.
+ * UPower Device contract: https://upower.freedesktop.org/docs/Device.html
+ * The display device path is guaranteed by the native UPower API. */
+static const Contract contracts[] = {
+  { G_BUS_TYPE_SESSION, "org.gnome.SettingsDaemon.Color",
+    "/org/gnome/SettingsDaemon/Color", "org.gnome.SettingsDaemon.Color",
+    { "NightLightDisabledUntilTomorrow", "Sunset", "Sunrise", NULL },
+    { "b", "d", "d", NULL } },
+  { G_BUS_TYPE_SYSTEM, "org.freedesktop.UPower", "/org/freedesktop/UPower",
+    "org.freedesktop.UPower",
+    { "OnBattery", "LidIsPresent", "LidIsClosed", NULL },
+    { "b", "b", "b", NULL } },
+  { G_BUS_TYPE_SYSTEM, "org.freedesktop.UPower", "/org/freedesktop/UPower/devices/DisplayDevice",
+    "org.freedesktop.UPower.Device",
+    { "Type", "State", "IsPresent", "Percentage", "TimeToEmpty", "TimeToFull", "BatteryLevel", NULL },
+    { "u", "u", "b", "d", "x", "x", "u", NULL } },
+  { G_BUS_TYPE_SYSTEM, "org.freedesktop.UPower.PowerProfiles",
+    "/org/freedesktop/UPower/PowerProfiles", "org.freedesktop.UPower.PowerProfiles",
+    { "ActiveProfile", "Profiles", NULL }, { "s", "aa{sv}", NULL } },
+};
+
+static const Contract *contract (CcLumaService service)
+{
+  return (guint) service < G_N_ELEMENTS (contracts) ? &contracts[service] : NULL;
+}
+
+CcLumaProperties *
+cc_luma_services_observe (CcLumaService service, GError **error)
+{
+  const Contract *c = contract (service);
+  if (!c) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Unknown Settings native service");
+    return NULL;
+  }
+  return cc_luma_properties_new (c->bus, c->name, c->path, c->interface, c->fields, error);
+}
+
+static gboolean invalid (GError **error, const char *field)
+{
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+               "Invalid Settings service property: %s", field);
+  return FALSE;
+}
+
+gboolean
+cc_luma_services_validate (CcLumaService service, GVariant *snapshot, GError **error)
+{
+  const Contract *c = contract (service);
+  if (!c) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Unknown Settings native service");
+    return FALSE;
+  }
+  if (!snapshot || !g_variant_is_of_type (snapshot, G_VARIANT_TYPE_VARDICT))
+    return invalid (error, "snapshot");
+  for (guint i = 0; c->fields[i]; i++) {
+    g_autoptr(GVariant) value = g_variant_lookup_value (snapshot, c->fields[i], G_VARIANT_TYPE (c->types[i]));
+    if (!value) return invalid (error, c->fields[i]);
+    if (g_variant_is_of_type (value, G_VARIANT_TYPE_DOUBLE)) {
+      double n = g_variant_get_double (value);
+      if (!isfinite (n)) return invalid (error, c->fields[i]);
+      if (service == CC_LUMA_SERVICE_NIGHT_LIGHT && (n < 0 || n > 24)) return invalid (error, c->fields[i]);
+      if (service == CC_LUMA_SERVICE_BATTERY && (n < 0 || n > 100)) return invalid (error, c->fields[i]);
+    }
+    if (g_variant_is_of_type (value, G_VARIANT_TYPE_INT64) && g_variant_get_int64 (value) < 0)
+      return invalid (error, c->fields[i]);
+  }
+  if (service == CC_LUMA_SERVICE_POWER_PROFILES) {
+    const char *active;
+    g_variant_lookup (snapshot, "ActiveProfile", "&s", &active);
+    if (!*active) return invalid (error, "ActiveProfile");
+    g_autoptr(GVariant) profiles = g_variant_lookup_value (snapshot, "Profiles", G_VARIANT_TYPE ("aa{sv}"));
+    g_autoptr(GHashTable) ids = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+    for (gsize i = 0; i < g_variant_n_children (profiles); i++) {
+      g_autoptr(GVariant) item = g_variant_get_child_value (profiles, i);
+      const char *id = NULL;
+      if (!g_variant_lookup (item, "Profile", "&s", &id) || !*id || g_hash_table_contains (ids, id))
+        return invalid (error, "Profiles");
+      g_hash_table_add (ids, g_strdup (id));
+    }
+    if (!g_hash_table_contains (ids, active)) return invalid (error, "ActiveProfile");
+  }
+  return TRUE;
+}
