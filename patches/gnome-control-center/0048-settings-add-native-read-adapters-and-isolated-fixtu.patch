diff --git a/shell/cc-luma-sound.c b/shell/cc-luma-sound.c
new file mode 100644
index 0000000..65741ea
--- /dev/null
+++ b/shell/cc-luma-sound.c
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-sound.h"
+#include "cc-luma-discovery.h"
+#include <gio/gio.h>
+#include <string.h>
+
+static gboolean invalid (GError **error)
+{
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid sound setting"); return FALSE;
+}
+static gboolean string_choice (JsonNode *node, const char * const *choices)
+{
+  if (!node || json_node_get_value_type (node) != G_TYPE_STRING) return FALSE;
+  for (guint i = 0; choices[i]; i++) if (g_str_equal (json_node_get_string (node), choices[i])) return TRUE;
+  return FALSE;
+}
+static gboolean level (JsonNode *node, gint64 low, gint64 high)
+{
+  return node && json_node_get_value_type (node) == G_TYPE_INT64 && json_node_get_int (node) >= low && json_node_get_int (node) <= high;
+}
+static const char * const configurations[] = { "Stereo", "Mono", NULL };
+static const char * const inputs[] = { "int", "hp", NULL };
+static const char * const alerts[] = { "Default", "Click", "Hum", "String", "Swing", "None", NULL };
+static JsonArray *outputs (CcLumaFixture *model)
+{
+  JsonNode *node = json_object_get_member (cc_luma_fixture_get_data (model), "CFOUT");
+  return node && JSON_NODE_HOLDS_ARRAY (node) ? json_node_get_array (node) : NULL;
+}
+static gboolean output_known (CcLumaFixture *model, const char *id)
+{
+  JsonArray *items = outputs (model);
+  if (!items || !id) return FALSE;
+  for (guint i = 0; i < json_array_get_length (items); i++) {
+    JsonNode *node = json_array_get_element (items, i);
+    if (!JSON_NODE_HOLDS_OBJECT (node)) return FALSE;
+    JsonNode *key = json_object_get_member (json_node_get_object (node), "id");
+    if (key && json_node_get_value_type (key) == G_TYPE_STRING && g_str_equal (json_node_get_string (key), id)) return TRUE;
+  }
+  return FALSE;
+}
+gboolean cc_luma_sound_validate (CcLumaFixture *model)
+{
+  JsonArray *items = outputs (model);
+  JsonNode *out = cc_luma_fixture_get (model, "out"), *boost = cc_luma_fixture_get (model, "overamp"), *levels = cc_luma_fixture_get (model, "lv");
+  if (!items || !json_array_get_length (items) || !out || json_node_get_value_type (out) != G_TYPE_STRING ||
+      !boost || json_node_get_value_type (boost) != G_TYPE_BOOLEAN ||
+      !level (cc_luma_fixture_get (model, "vol"), 0, 150) ||
+      !level (cc_luma_fixture_get (model, "bal"), -100, 100) ||
+      !level (cc_luma_fixture_get (model, "inVol"), 0, 100) ||
+      !string_choice (cc_luma_fixture_get (model, "cfg"), configurations) ||
+      !string_choice (cc_luma_fixture_get (model, "inDev"), inputs) ||
+      !string_choice (cc_luma_fixture_get (model, "alert"), alerts) ||
+      !levels || !JSON_NODE_HOLDS_OBJECT (levels)) return FALSE;
+  g_autoptr (GHashTable) ids = g_hash_table_new (g_str_hash, g_str_equal);
+  for (guint i = 0; i < json_array_get_length (items); i++) {
+    JsonNode *node = json_array_get_element (items, i);
+    if (!JSON_NODE_HOLDS_OBJECT (node)) return FALSE;
+    JsonObject *item = json_node_get_object (node);
+    const char *fields[] = { "id", "n", "s", "i" };
+    for (guint j = 0; j < G_N_ELEMENTS (fields); j++) {
+      JsonNode *field = json_object_get_member (item, fields[j]);
+      if (!field || json_node_get_value_type (field) != G_TYPE_STRING || !*json_node_get_string (field)) return FALSE;
+    }
+    const char *id = json_object_get_string_member (item, "id");
+    if (g_hash_table_contains (ids, id)) return FALSE;
+    g_hash_table_add (ids, (gpointer) id);
+  }
+  if (!output_known (model, json_node_get_string (out))) return FALSE;
+  JsonObject *values = json_node_get_object (levels);
+  g_autoptr (GList) names = json_object_get_members (values);
+  for (GList *i = names; i; i = i->next)
+    if ((!g_str_equal (i->data, "system") && !cc_luma_app_name (model, i->data)) || !level (json_object_get_member (values, i->data), 0, 100)) return FALSE;
+  return TRUE;
+}
+gboolean cc_luma_sound_set_choice (CcLumaFixture *model, const char *key, const char *value, GError **error)
+{
+  if (!cc_luma_sound_validate (model) || !key || !value) return invalid (error);
+  g_autoptr (JsonNode) node = json_node_init_string (json_node_alloc (), value);
+  const char * const *choices = g_str_equal (key, "cfg") ? configurations : g_str_equal (key, "inDev") ? inputs : g_str_equal (key, "alert") ? alerts : NULL;
+  if (g_str_equal (key, "out")) { if (!output_known (model, value)) return invalid (error); }
+  else if (!choices || !string_choice (node, choices)) return invalid (error);
+  return cc_luma_fixture_set (model, key, node, error);
+}
+gboolean cc_luma_sound_set_level (CcLumaFixture *model, const char *key, gint64 value, GError **error)
+{
+  if (!cc_luma_sound_validate (model) || !key) return invalid (error);
+  gint64 low = 0, high = 100;
+  if (g_str_equal (key, "vol")) {
+    if (json_node_get_boolean (cc_luma_fixture_get (model, "overamp"))) high = 150;
+  } else if (g_str_equal (key, "bal")) low = -100;
+  else if (!g_str_equal (key, "inVol") && !(g_str_has_prefix (key, "lv.") && cc_luma_fixture_get (model, key))) return invalid (error);
+  if (value < low || value > high) return invalid (error);
+  g_autoptr (JsonNode) node = json_node_init_int (json_node_alloc (), value);
+  return cc_luma_fixture_set (model, key, node, error);
+}
