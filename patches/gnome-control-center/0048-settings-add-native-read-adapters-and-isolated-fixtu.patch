diff --git a/shell/test-luma-applications.c b/shell/test-luma-applications.c
new file mode 100644
index 0000000..2444d57
--- /dev/null
+++ b/shell/test-luma-applications.c
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-applications.h"
+#include <glib/gstdio.h>
+static char *registry;
+typedef struct { guint done; GVariant *value; GError *error; } Result;
+static void completed (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Result *seen = data; seen->value = cc_luma_applications_read_finish (result, &seen->error); seen->done++;
+}
+static void wait_result (Result *seen)
+{
+  gint64 end = g_get_monotonic_time () + 6000000;
+  while (!seen->done && g_get_monotonic_time () < end) {
+    while (g_main_context_iteration (NULL, FALSE)) {} g_usleep (1000);
+  }
+  g_assert_cmpuint (seen->done, ==, 1);
+}
+static void isolated_registry (void)
+{
+  Result seen = { 0 };
+  cc_luma_applications_read_async (NULL, completed, &seen);
+  g_assert_cmpuint (seen.done, ==, 0); wait_result (&seen); g_assert_no_error (seen.error);
+  g_autoptr(GVariant) snapshot = seen.value;
+  g_autoptr(GVariant) apps = g_variant_lookup_value (snapshot, "applications", G_VARIANT_TYPE ("aa{sv}"));
+  g_assert_cmpuint (g_variant_n_children (apps), ==, 1);
+  g_autoptr(GVariant) app = g_variant_get_child_value (apps, 0);
+  const char *id = NULL, *name = NULL;
+  g_assert_true (g_variant_lookup (app, "id", "&s", &id)); g_assert_cmpstr (id, ==, "private-luma-settings.desktop");
+  g_assert_true (g_variant_lookup (app, "name", "&s", &name)); g_assert_cmpstr (name, ==, "Private Settings reader test");
+  g_assert_null (g_variant_lookup_value (app, "size", NULL));
+  g_assert_null (g_variant_lookup_value (app, "data-size", NULL));
+  g_autoptr(GVariant) defaults = g_variant_lookup_value (snapshot, "defaults", G_VARIANT_TYPE ("a{sa{sv}}"));
+  g_autoptr(GVariant) photo = g_variant_lookup_value (defaults, "photo", G_VARIANT_TYPE_VARDICT);
+  g_assert_nonnull (photo); g_assert_true (g_variant_lookup (photo, "id", "&s", &id));
+  g_assert_cmpstr (id, ==, "private-luma-settings.desktop");
+  g_assert_null (g_variant_lookup_value (defaults, "cal", NULL));
+  /* A read must not add a per-user desktop entry or rewrite associations. */
+  g_autofree char *associations = g_build_filename (registry, "config", "mimeapps.list", NULL);
+  g_autofree char *contents = NULL;
+  g_assert_true (g_file_get_contents (associations, &contents, NULL, NULL));
+  g_assert_cmpstr (contents, ==, "[Default Applications]\nimage/jpeg=private-luma-settings.desktop;\n");
+}
+static void fixture_and_cancel (void)
+{
+  g_setenv ("LUMA_SETTINGS_FIXTURE", "", TRUE);
+  Result fixture = { 0 }; cc_luma_applications_read_async (NULL, completed, &fixture); wait_result (&fixture);
+  g_assert_error (fixture.error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED); g_assert_null (fixture.value); g_clear_error (&fixture.error);
+  g_unsetenv ("LUMA_SETTINGS_FIXTURE");
+  g_autoptr(GCancellable) cancel = g_cancellable_new (); g_cancellable_cancel (cancel);
+  Result stopped = { 0 }; cc_luma_applications_read_async (cancel, completed, &stopped); wait_result (&stopped);
+  g_assert_error (stopped.error, G_IO_ERROR, G_IO_ERROR_CANCELLED); g_assert_null (stopped.value); g_clear_error (&stopped.error);
+}
+static void descriptor (void)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GAppInfo) info = g_app_info_create_from_commandline ("/usr/bin/true %u", "Private command record", G_APP_INFO_CREATE_SUPPORTS_URIS, &error);
+  g_assert_no_error (error); g_assert_nonnull (info);
+  g_autoptr(GVariant) fields = cc_luma_applications_describe (info);
+  gboolean uris = FALSE; g_assert_true (g_variant_lookup (fields, "supports-uris", "b", &uris)); g_assert_true (uris);
+  g_assert_null (g_variant_lookup_value (fields, "id", NULL));
+  g_assert_null (g_variant_lookup_value (fields, "size", NULL));
+}
+static void write_file (const char *relative, const char *contents)
+{
+  g_autofree char *path = g_build_filename (registry, relative, NULL);
+  g_autofree char *parent = g_path_get_dirname (path);
+  g_assert_cmpint (g_mkdir_with_parents (parent, 0700), ==, 0);
+  g_assert_true (g_file_set_contents (path, contents, -1, NULL));
+}
+int main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  registry = g_dir_make_tmp ("luma-settings-apps-XXXXXX", NULL); g_assert_nonnull (registry);
+  const struct { const char *key, *relative; } roots[] = {
+    { "XDG_DATA_HOME", "data" }, { "XDG_DATA_DIRS", "system" },
+    { "XDG_CONFIG_HOME", "config" }, { "XDG_CONFIG_DIRS", "system-config" },
+  };
+  for (guint i = 0; i < G_N_ELEMENTS (roots); i++) {
+    g_autofree char *path = g_build_filename (registry, roots[i].relative, NULL);
+    g_assert_cmpint (g_mkdir_with_parents (path, 0700), ==, 0); g_setenv (roots[i].key, path, TRUE);
+  }
+  g_unsetenv ("LUMA_SETTINGS_FIXTURE");
+  write_file ("data/applications/private-luma-settings.desktop",
+    "[Desktop Entry]\nType=Application\nName=Private Settings reader test\nExec=/usr/bin/true %u\nMimeType=image/jpeg;\nIcon=private-test-icon\n");
+  write_file ("data/applications/hidden-private-luma-settings.desktop",
+    "[Desktop Entry]\nType=Application\nName=Hidden private test\nExec=/usr/bin/true\nNoDisplay=true\n");
+  write_file ("config/mimeapps.list", "[Default Applications]\nimage/jpeg=private-luma-settings.desktop;\n");
+  g_test_add_func ("/settings/applications/isolated-registry", isolated_registry);
+  g_test_add_func ("/settings/applications/fixture-and-cancel", fixture_and_cancel);
+  g_test_add_func ("/settings/applications/descriptor", descriptor);
+  int result = g_test_run ();
+  const char *files[] = { "data/applications/private-luma-settings.desktop", "data/applications/hidden-private-luma-settings.desktop", "config/mimeapps.list" };
+  for (guint i = 0; i < G_N_ELEMENTS (files); i++) { g_autofree char *path = g_build_filename (registry, files[i], NULL); g_assert_cmpint (g_remove (path), ==, 0); }
+  const char *dirs[] = { "data/applications", "data", "system", "config", "system-config" };
+  for (guint i = 0; i < G_N_ELEMENTS (dirs); i++) { g_autofree char *path = g_build_filename (registry, dirs[i], NULL); g_assert_cmpint (g_rmdir (path), ==, 0); }
+  g_assert_cmpint (g_rmdir (registry), ==, 0); g_free (registry); return result;
+}
diff --git a/shell/test-luma-audio.c b/shell/test-luma-audio.c
new file mode 100644
index 0000000..0086b7e
--- /dev/null
+++ b/shell/test-luma-audio.c
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-audio.h"
+typedef struct { guint changed, failed; GError *error; } Seen;
+static void changed (CcLumaAudio *audio, Seen *seen) { seen->changed++; }
+static void failed (CcLumaAudio *audio, GError *error, Seen *seen)
+{
+  seen->failed++; g_clear_error (&seen->error); seen->error = g_error_copy (error);
+}
+static void spin (guint ms)
+{
+  gint64 end = g_get_monotonic_time () + ms * 1000;
+  do { while (g_main_context_iteration (NULL, FALSE)) {} g_usleep (1000); } while (g_get_monotonic_time () < end);
+}
+static void cancellation (void)
+{
+  CcLumaAudio *audio = cc_luma_audio_new (); Seen seen = { 0 };
+  g_signal_connect (audio, "changed", G_CALLBACK (changed), &seen);
+  g_signal_connect (audio, "failed", G_CALLBACK (failed), &seen);
+  g_test_expect_message ("Gvc", G_LOG_LEVEL_WARNING, "Failed to connect context: Connection refused");
+  cc_luma_audio_start (audio); cc_luma_audio_stop (audio); spin (100);
+  g_test_assert_expected_messages ();
+  g_assert_cmpuint (seen.changed + seen.failed, ==, 0); g_assert_null (cc_luma_audio_dup_snapshot (audio));
+  g_test_expect_message ("Gvc", G_LOG_LEVEL_WARNING, "Failed to connect context: Connection refused");
+  cc_luma_audio_start (audio); g_object_unref (audio); spin (100);
+  g_test_assert_expected_messages ();
+  g_assert_cmpuint (seen.changed + seen.failed, ==, 0);
+}
+static void unavailable (void)
+{
+  g_autoptr (CcLumaAudio) audio = cc_luma_audio_new (); Seen seen = { 0 };
+  g_signal_connect (audio, "changed", G_CALLBACK (changed), &seen);
+  g_signal_connect (audio, "failed", G_CALLBACK (failed), &seen);
+  gint64 started = g_get_monotonic_time ();
+  g_test_expect_message ("Gvc", G_LOG_LEVEL_WARNING, "Failed to connect context: Connection refused");
+  cc_luma_audio_start (audio);
+  g_assert_cmpint (g_get_monotonic_time () - started, <, 100000);
+  g_assert_cmpuint (seen.changed + seen.failed, ==, 0);
+  g_assert_null (cc_luma_audio_dup_snapshot (audio));
+  gint64 deadline = started + 12000000;
+  while (!seen.failed && g_get_monotonic_time () < deadline) spin (1);
+  g_test_assert_expected_messages ();
+  g_assert_cmpuint (seen.failed, >, 0); g_assert_cmpuint (seen.changed, ==, 0);
+  g_assert_nonnull (seen.error); g_assert_cmpuint (seen.error->domain, ==, G_IO_ERROR);
+  g_assert_true (seen.error->code == G_IO_ERROR_NOT_CONNECTED || seen.error->code == G_IO_ERROR_TIMED_OUT);
+  g_assert_null (cc_luma_audio_dup_snapshot (audio)); cc_luma_audio_stop (audio); g_clear_error (&seen.error);
+}
+int main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  /* The runner supplies a private nonexistent socket, never Nick's daemon. */
+  const char *server = g_getenv ("PULSE_SERVER");
+  g_assert_nonnull (server); g_assert_true (g_str_has_prefix (server, "unix:"));
+  g_assert_false (g_file_test (server + 5, G_FILE_TEST_EXISTS));
+  g_test_add_func ("/settings/audio/cancellation", cancellation);
+  g_test_add_func ("/settings/audio/unavailable", unavailable);
+  return g_test_run ();
+}
