+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "cc-luma-properties.h"
+G_BEGIN_DECLS
+typedef enum {
+  CC_LUMA_SERVICE_NIGHT_LIGHT,
+  CC_LUMA_SERVICE_POWER,
+  CC_LUMA_SERVICE_BATTERY,
+  CC_LUMA_SERVICE_POWER_PROFILES,
+} CcLumaService;
+/* Exact native read-only contracts, backed by the existing proxy factory.
+ * No service activation, Properties.Set, playback or device operation. */
+CcLumaProperties *cc_luma_services_observe (CcLumaService service, GError **error);
+gboolean cc_luma_services_validate (CcLumaService service, GVariant *snapshot,
+                                     GError **error);
