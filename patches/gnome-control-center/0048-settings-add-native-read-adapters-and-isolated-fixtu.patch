diff --git a/shell/cc-luma-keyboard.c b/shell/cc-luma-keyboard.c
new file mode 100644
index 0000000..a9fb8bc
--- /dev/null
+++ b/shell/cc-luma-keyboard.c
@@ -0,0 +1,135 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-keyboard.h"
+#include <gio/gio.h>
+#include <string.h>
+static gboolean string_is (JsonNode *node, const char *value)
+{
+  return node && json_node_get_value_type (node) == G_TYPE_STRING && g_strcmp0 (json_node_get_string (node), value) == 0;
+}
+static gboolean layout_known (CcLumaFixture *model, const char *layout)
+{
+  JsonNode *keyboard = json_object_get_member (cc_luma_fixture_get_data (model), "CFKB");
+  if (!layout || !keyboard || !JSON_NODE_HOLDS_OBJECT (keyboard)) return FALSE;
+  JsonNode *layouts = json_object_get_member (json_node_get_object (keyboard), "L");
+  if (!layouts || !JSON_NODE_HOLDS_OBJECT (layouts)) return FALSE;
+  if (json_object_has_member (json_node_get_object (layouts), layout)) return TRUE;
+  const char *more[] = { "Español", "Italiano", "日本語", "한국어" };
+  for (guint i = 0; i < G_N_ELEMENTS (more); i++) if (g_str_equal (layout, more[i])) return TRUE;
+  return FALSE;
+}
+static gboolean choice_allowed (const char *key, const char *choice)
+{
+  static const struct { const char *key; const char *values[5]; } fields[] = {
+    { "perWin", { "all", "win", NULL } },
+    { "altKey", { "off", "AltRight", "AltLeft", "ContextMenu", NULL } },
+    { "compose", { "off", "ContextMenu", "CapsLock", "ControlRight", NULL } },
+  };
+  if (!key || !choice) return FALSE;
+  for (guint i = 0; i < G_N_ELEMENTS (fields); i++)
+    if (g_str_equal (key, fields[i].key))
+      for (guint j = 0; fields[i].values[j]; j++) if (g_str_equal (choice, fields[i].values[j])) return TRUE;
+  return FALSE;
+}
+gboolean cc_luma_keyboard_validate (CcLumaFixture *model)
+{
+  JsonNode *sources = cc_luma_fixture_get (model, "srcs");
+  if (!sources || !JSON_NODE_HOLDS_ARRAY (sources)) return FALSE;
+  JsonArray *array = json_node_get_array (sources);
+  if (!json_array_get_length (array)) return FALSE;
+  gboolean selected = FALSE;
+  g_autoptr(GHashTable) seen = g_hash_table_new (g_str_hash, g_str_equal);
+  for (guint i = 0; i < json_array_get_length (array); i++) {
+    JsonNode *node = json_array_get_element (array, i);
+    if (json_node_get_value_type (node) != G_TYPE_STRING) return FALSE;
+    const char *name = json_node_get_string (node);
+    if (!layout_known (model, name) || !g_hash_table_add (seen, (gpointer) name)) return FALSE;
+    if (string_is (cc_luma_fixture_get (model, "src"), name)) selected = TRUE;
+  }
+  const char *keys[] = { "perWin", "altKey", "compose" };
+  for (guint i = 0; i < G_N_ELEMENTS (keys); i++) {
+    JsonNode *node = cc_luma_fixture_get (model, keys[i]);
+    if (!node || json_node_get_value_type (node) != G_TYPE_STRING || !choice_allowed (keys[i], json_node_get_string (node))) return FALSE;
+  }
+  return selected;
+}
+static gboolean invalid (GError **error)
+{
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid Settings keyboard action"); return FALSE;
+}
+static gboolean replace_sources (CcLumaFixture *model, JsonNode *node)
+{
+  /* The generic fixture setter intentionally edits scalars only. This
+   * validated keyboard helper owns just the layout array, as provider
+   * reordering owns its own array; it cannot replace other preferences. */
+  JsonArray *current = json_node_get_array (cc_luma_fixture_get (model, "srcs"));
+  JsonArray *next = json_node_get_array (node);
+  while (json_array_get_length (current)) json_array_remove_element (current, json_array_get_length (current) - 1);
+  for (guint i = 0; i < json_array_get_length (next); i++)
+    json_array_add_element (current, json_node_copy (json_array_get_element (next, i)));
+  return TRUE;
+}
+static gint index_of (CcLumaFixture *model, const char *layout)
+{
+  JsonArray *array = json_node_get_array (cc_luma_fixture_get (model, "srcs"));
+  for (guint i = 0; layout && i < json_array_get_length (array); i++)
+    if (string_is (json_array_get_element (array, i), layout)) return i;
+  return -1;
+}
+static JsonNode *copy_sources (CcLumaFixture *model)
+{
+  /* json_node_copy retains a JsonArray; structural edits need a fresh array. */
+  JsonArray *source = json_node_get_array (cc_luma_fixture_get (model, "srcs"));
+  JsonArray *copy = json_array_new ();
+  for (guint i = 0; i < json_array_get_length (source); i++)
+    json_array_add_element (copy, json_node_copy (json_array_get_element (source, i)));
+  JsonNode *node = json_node_new (JSON_NODE_ARRAY);
+  json_node_take_array (node, copy);
+  return node;
+}
+gboolean cc_luma_keyboard_select (CcLumaFixture *model, const char *layout, GError **error)
+{
+  if (!cc_luma_keyboard_validate (model) || index_of (model, layout) < 0) return invalid (error);
+  g_autoptr(JsonNode) node = json_node_init_string (json_node_alloc (), layout);
+  return cc_luma_fixture_set (model, "src", node, error);
+}
+gboolean cc_luma_keyboard_set_choice (CcLumaFixture *model, const char *key, const char *choice, GError **error)
+{
+  if (!cc_luma_keyboard_validate (model) || !choice_allowed (key, choice)) return invalid (error);
+  g_autoptr(JsonNode) node = json_node_init_string (json_node_alloc (), choice);
+  return cc_luma_fixture_set (model, key, node, error);
+}
+gboolean cc_luma_keyboard_add (CcLumaFixture *model, const char *layout, GError **error)
+{
+  if (!cc_luma_keyboard_validate (model) || !layout_known (model, layout)) return invalid (error);
+  if (index_of (model, layout) >= 0) return TRUE;
+  g_autoptr(JsonNode) node = copy_sources (model);
+  json_array_add_string_element (json_node_get_array (node), layout);
+  return replace_sources (model, node);
+}
+gboolean cc_luma_keyboard_remove (CcLumaFixture *model, const char *layout, GError **error)
+{
+  if (!cc_luma_keyboard_validate (model)) return invalid (error);
+  gint index = index_of (model, layout);
+  JsonArray *sources = json_node_get_array (cc_luma_fixture_get (model, "srcs"));
+  if (index < 0 || json_array_get_length (sources) == 1) return invalid (error);
+  gboolean was_selected = string_is (cc_luma_fixture_get (model, "src"), layout);
+  g_autoptr(JsonNode) node = copy_sources (model);
+  json_array_remove_element (json_node_get_array (node), index);
+  g_autoptr(JsonNode) next = was_selected ? json_node_copy (json_array_get_element (json_node_get_array (node), 0)) : NULL;
+  replace_sources (model, node);
+  return !was_selected || cc_luma_fixture_set (model, "src", next, error);
+}
+gboolean cc_luma_keyboard_move (CcLumaFixture *model, guint from, guint to, GError **error)
+{
+  if (!cc_luma_keyboard_validate (model)) return invalid (error);
+  JsonArray *sources = json_node_get_array (cc_luma_fixture_get (model, "srcs"));
+  guint length = json_array_get_length (sources);
+  if (from >= length || to >= length) return invalid (error);
+  g_autoptr(JsonNode) node = json_node_new (JSON_NODE_ARRAY);
+  JsonArray *result = json_array_new (); json_node_take_array (node, result);
+  for (guint i = 0; i < length; i++) {
+    guint original = i == to ? from : from < to && i >= from && i < to ? i + 1 : from > to && i > to && i <= from ? i - 1 : i;
+    json_array_add_element (result, json_node_copy (json_array_get_element (sources, original)));
+  }
+  return replace_sources (model, node);
+}
diff --git a/shell/cc-luma-keyboard.h b/shell/cc-luma-keyboard.h
new file mode 100644
index 0000000..01de2ae
--- /dev/null
