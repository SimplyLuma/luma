+static gboolean fixture_pictures_ready (GtkWidget *widget)
+{
+  if (GTK_IS_PICTURE (widget) && !gtk_picture_get_paintable (GTK_PICTURE (widget))) return FALSE;
+  for (GtkWidget *child = gtk_widget_get_first_child (widget); child; child = gtk_widget_get_next_sibling (child))
+    if (!fixture_pictures_ready (child)) return FALSE;
+  return TRUE;
+}
+static gboolean fixture_smoke (gpointer data)
+{
+  CcApplication *self = data;
+  GtkWidget *view = self->fixture_window ? g_object_get_data (G_OBJECT (self->fixture_window), "cf-smoke-view") : NULL;
+  gboolean ready = view && !self->fixture_failed && !cc_luma_view_get_error (view) &&
+    gtk_widget_get_mapped (GTK_WIDGET (self->fixture_window)) &&
+    gtk_widget_get_width (view) > 0 && gtk_widget_get_height (view) > 0 && fixture_pictures_ready (view);
+  self->fixture_smoke_frames = ready ? self->fixture_smoke_frames + 1 : 0;
+  if (self->fixture_smoke_frames < 5 && g_get_monotonic_time () < self->fixture_smoke_deadline) return G_SOURCE_CONTINUE;
+  self->fixture_smoke_source = 0;
+  if (!ready || self->fixture_smoke_frames < 5) {
+    self->fixture_failed = TRUE;
+    g_printerr ("Settings fixture runtime smoke: FAIL (view did not map with loaded artwork)\n");
+  }
+  if (self->fixture_window) gtk_window_destroy (self->fixture_window);
+  if (gtk_application_get_windows (GTK_APPLICATION (self))) {
+    self->fixture_failed = TRUE;
+    g_printerr ("Settings fixture runtime smoke: FAIL (application window remained open)\n");
+  }
+  if (!self->fixture_failed)
+    {
+      self->fixture_smoke_complete = TRUE;
+      g_print ("Settings fixture runtime smoke: PASS page=%s id=%s mapped/artwork checked; application windows closed\n",
+      g_getenv ("LUMA_SETTINGS_PAGE") ? g_getenv ("LUMA_SETTINGS_PAGE") : "wifi",
+      g_application_get_application_id (G_APPLICATION (self)));
+    }
+  g_application_quit (G_APPLICATION (self));
+  return G_SOURCE_REMOVE;
 }
 
