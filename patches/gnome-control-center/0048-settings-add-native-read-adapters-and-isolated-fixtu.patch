diff --git a/shell/cc-luma-view-sound.c b/shell/cc-luma-view-sound.c
new file mode 100644
index 0000000..b7ab6bb
--- /dev/null
+++ b/shell/cc-luma-view-sound.c
@@ -0,0 +1,207 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view-private.h"
+#include "cc-luma-sound.h"
+#include "cc-luma-discovery.h"
+
+static void volume_changed (GtkRange *range, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  const char *key = g_object_get_data (G_OBJECT (range), "cf-key");
+  g_autoptr (GError) error = NULL;
+  gint64 value = (gint64) gtk_range_get_value (range);
+  if (!cc_luma_sound_set_level (v->model, key, value, &error)) {
+    cc_luma_view_report_error (v, error); return;
+  }
+  /* Keep the emitting slider alive throughout a pointer or keyboard edit. */
+  if (g_object_get_data (G_OBJECT (range), "cf-percent")) {
+    g_autofree char *text = g_strdup_printf ("%" G_GINT64_FORMAT "%%", value);
+    gtk_label_set_text (g_object_get_data (G_OBJECT (range), "cf-output"), text);
+  }
+  if (g_str_equal (key, "vol") && v->subtitle) {
+    JsonArray *outputs = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFOUT");
+    for (guint i = 0; i < json_array_get_length (outputs); i++) {
+      JsonObject *item = json_array_get_object_element (outputs, i);
+      if (!g_str_equal (json_object_get_string_member (item, "id"), cc_luma_view_text (v, "out"))) continue;
+      g_autofree char *subtitle = g_strdup_printf ("Playing through %s · %" G_GINT64_FORMAT "%%", json_object_get_string_member (item, "n"), value);
+      gtk_label_set_text (v->subtitle, subtitle);
+      break;
+    }
+  }
+}
+static GtkWidget *level_control (View *v, const char *key, const char *title, int low, int high, gboolean percent)
+{
+  GtkWidget *box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 10);
+  GtkWidget *range = gtk_scale_new_with_range (GTK_ORIENTATION_HORIZONTAL, low, high, 1);
+  gtk_scale_set_draw_value (GTK_SCALE (range), FALSE);
+  gtk_range_set_value (GTK_RANGE (range), json_node_get_int (cc_luma_fixture_get (v->model, key)));
+  gtk_widget_set_size_request (range, 140, -1);
+  g_autofree char *name = g_strconcat ("cf-", key, NULL);
+  gtk_widget_set_name (range, name);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (range), GTK_ACCESSIBLE_PROPERTY_LABEL, title, -1);
+  g_autofree char *text = percent ? g_strdup_printf ("%" G_GINT64_FORMAT "%%", json_node_get_int (cc_luma_fixture_get (v->model, key))) : g_strdup ("");
+  GtkWidget *output = cc_luma_view_label (text, "caption", TRUE);
+  g_object_set_data_full (G_OBJECT (range), "cf-key", g_strdup (key), g_free);
+  g_object_set_data (G_OBJECT (range), "cf-output", output);
+  g_object_set_data (G_OBJECT (range), "cf-percent", GINT_TO_POINTER (percent));
+  g_signal_connect_object (range, "value-changed", G_CALLBACK (volume_changed), v->root, 0);
+  gtk_box_append (GTK_BOX (box), range); gtk_box_append (GTK_BOX (box), output);
+  return box;
+}
+void cc_luma_view_sound_levels_render (View *v)
+{
+  cc_luma_view_header (v, "Volume by app", "Apps playing sound now, and system sounds", NULL);
+  GtkBox *rows = cc_luma_view_group (v, NULL);
+  JsonObject *levels = json_node_get_object (cc_luma_fixture_get (v->model, "lv"));
+  g_autoptr (GList) ids = json_object_get_members (levels);
+  for (GList *i = ids; i; i = i->next) {
+    const char *id = i->data;
+    gboolean system = g_str_equal (id, "system");
+    const char *name = system ? "System sounds" : cc_luma_app_name (v->model, id);
+    g_autofree char *key = g_strconcat ("lv.", id, NULL);
+    GtkWidget *row = cc_luma_view_row (rows, name, NULL, level_control (v, key, name, 0, 100, TRUE));
+    GtkWidget *icon = system ? luma_ui_icon_new ("volume-2") : cc_luma_view_image (v, id, 60, 60);
+    if (!system) gtk_widget_set_size_request (icon, 30, 30);
+    gtk_box_prepend (GTK_BOX (row), icon);
+  }
+}
+static void alert_changed (GtkCheckButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v || !gtk_check_button_get_active (button)) return;
+  g_autoptr (GError) error = NULL;
+  if (cc_luma_sound_set_choice (v->model, "alert", g_object_get_data (G_OBJECT (button), "cf-alert"), &error))
+    cc_luma_view_queue_refresh (v);
+  else cc_luma_view_report_error (v, error);
+}
+void cc_luma_view_sound_alert_render (View *v)
+{
+  cc_luma_view_header (v, "Alert sound", cc_luma_view_text (v, "alert"), NULL);
+  GtkBox *rows = cc_luma_view_group (v, NULL);
+  const char *alerts[] = { "Default", "Click", "Hum", "String", "Swing", "None" };
+  GtkCheckButton *group = NULL;
+  for (guint i = 0; i < G_N_ELEMENTS (alerts); i++) {
+    GtkWidget *button = gtk_check_button_new ();
+    gtk_check_button_set_group (GTK_CHECK_BUTTON (button), group);
+    if (!group) group = GTK_CHECK_BUTTON (button);
+    gtk_check_button_set_active (GTK_CHECK_BUTTON (button), g_str_equal (cc_luma_view_text (v, "alert"), alerts[i]));
+    g_autofree char *name = g_strconcat ("cf-alert-", alerts[i], NULL); gtk_widget_set_name (button, name);
+    gtk_accessible_update_property (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_PROPERTY_LABEL, alerts[i], -1);
+    g_object_set_data (G_OBJECT (button), "cf-alert", (gpointer) alerts[i]);
+    g_signal_connect_object (button, "toggled", G_CALLBACK (alert_changed), v->root, 0);
+    cc_luma_view_row (rows, alerts[i], NULL, button);
+  }
+}
+
+static void output_clicked (GtkButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  g_autoptr(GError) error = NULL;
+  const char *id = g_object_get_data (G_OBJECT (button), "cf-output-id");
+  if (cc_luma_sound_set_choice (v->model, "out", id, &error))
+    cc_luma_view_queue_refresh (v);
+  else cc_luma_view_report_error (v, error);
+}
+
+static gboolean test_done (gpointer root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (v) {
+    v->sound_test_timer = 0;
+    cc_luma_view_queue_refresh (v);
+  }
+  return G_SOURCE_REMOVE;
+}
+
+static void test_clicked (GtkButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  /* Fixture state only. Production speaker playback uses the upstream
+   * speaker-test adapter; this callback must never play on Nick's machine. */
+  if (v->sound_test_timer) g_source_remove (v->sound_test_timer);
+  v->sound_test_timer = g_timeout_add (3000, test_done, root);
+  cc_luma_view_queue_refresh (v);
+}
+
+static GtkWidget *labelled_level (View *v, const char *key, const char *title,
+                                 int low, int high, const char *left, const char *right)
+{
+  GtkWidget *box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 4);
+  gtk_box_append (GTK_BOX (box), level_control (v, key, title, low, high, FALSE));
+  GtkWidget *labels = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  GtkWidget *start = cc_luma_view_label (left, "small", TRUE);
+  GtkWidget *end = cc_luma_view_label (right, "small", TRUE);
+  gtk_widget_set_hexpand (start, TRUE);
+  gtk_label_set_xalign (GTK_LABEL (start), 0);
+  gtk_label_set_xalign (GTK_LABEL (end), 1);
+  gtk_box_append (GTK_BOX (labels), start); gtk_box_append (GTK_BOX (labels), end);
+  gtk_box_append (GTK_BOX (box), labels);
+  return box;
+}
+
+void cc_luma_view_sound_render (View *v)
+{
+  JsonArray *outputs = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFOUT");
+  const char *selected = cc_luma_view_text (v, "out"), *selected_name = NULL;
+  for (guint i = 0; i < json_array_get_length (outputs); i++) {
+    JsonObject *item = json_array_get_object_element (outputs, i);
+    if (g_str_equal (selected, json_object_get_string_member (item, "id")))
+      selected_name = json_object_get_string_member (item, "n");
+  }
+  g_autofree char *subtitle = g_strdup_printf ("Playing through %s · %" G_GINT64_FORMAT "%%",
+    selected_name, json_node_get_int (cc_luma_fixture_get (v->model, "vol")));
+  cc_luma_view_header (v, "Sound", subtitle, NULL);
+  GtkWidget *choices = gtk_flow_box_new ();
+  gtk_flow_box_set_selection_mode (GTK_FLOW_BOX (choices), GTK_SELECTION_NONE);
+  gtk_flow_box_set_min_children_per_line (GTK_FLOW_BOX (choices), 2);
+  gtk_flow_box_set_max_children_per_line (GTK_FLOW_BOX (choices), 3);
+  gtk_flow_box_set_column_spacing (GTK_FLOW_BOX (choices), 10);
+  gtk_flow_box_set_row_spacing (GTK_FLOW_BOX (choices), 10);
+  for (guint i = 0; i < json_array_get_length (outputs); i++) {
+    JsonObject *item = json_array_get_object_element (outputs, i);
+    const char *id = json_object_get_string_member (item, "id");
+    GtkWidget *button = gtk_toggle_button_new ();
+    GtkWidget *content = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+    GtkWidget *icon = luma_ui_icon_new (json_object_get_string_member (item, "i"));
+    gtk_widget_set_halign (icon, GTK_ALIGN_START);
+    gtk_widget_set_margin_bottom (icon, 6);
+    gtk_box_append (GTK_BOX (content), icon);
+    gtk_box_append (GTK_BOX (content), cc_luma_view_label (json_object_get_string_member (item, "n"), "body", FALSE));
+    gtk_box_append (GTK_BOX (content), cc_luma_view_label (json_object_get_string_member (item, "s"), "small", TRUE));
+    gtk_button_set_child (GTK_BUTTON (button), content);
+    gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (button), g_str_equal (selected, id));
+    g_autofree char *name = g_strconcat ("cf-out-", id, NULL);
+    gtk_widget_set_name (button, name);
+    g_object_set_data_full (G_OBJECT (button), "cf-output-id", g_strdup (id), g_free);
+    g_signal_connect_object (button, "clicked", G_CALLBACK (output_clicked), v->root, 0);
+    gtk_flow_box_insert (GTK_FLOW_BOX (choices), button, -1);
+  }
+  gtk_box_append (v->body, choices);
+  GtkWidget *volume = level_control (v, "vol", "Volume", 0, cc_luma_view_flag (v, "overamp") ? 150 : 100, TRUE);
+  GtkWidget *range = gtk_widget_get_first_child (volume);
+  gtk_widget_set_hexpand (range, TRUE);
+  gtk_box_prepend (GTK_BOX (volume), luma_ui_icon_new ("volume-2"));
+  gtk_widget_set_margin_top (volume, 18);
+  gtk_box_append (v->body, volume);
+  /* TODO(kit-request settings-08): compose the app-owned 32/24 segment
+   * meters using public paint tokens. This page is not marked complete. */
+  GtkBox *rows = cc_luma_view_group (v, "Output");
+  const char * const configs[] = { "Stereo", "Stereo", "Mono", "Mono", NULL };
+  cc_luma_view_row (rows, "Configuration", NULL, cc_luma_view_picker (v, "cfg", configs));
+  cc_luma_view_row (rows, "Balance", NULL, labelled_level (v, "bal", "Balance", -100, 100, "Left", "Right"));
+  GtkWidget *test = gtk_button_new_with_label (v->sound_test_timer ? "Playing…" : "Test");
+  gtk_widget_set_name (test, "cf-test-sound");
