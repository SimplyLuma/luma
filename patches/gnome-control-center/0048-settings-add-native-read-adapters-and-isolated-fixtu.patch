diff --git a/shell/cc-luma-view-devices.c b/shell/cc-luma-view-devices.c
new file mode 100644
index 0000000..8adee6f
--- /dev/null
+++ b/shell/cc-luma-view-devices.c
@@ -0,0 +1,208 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view-private.h"
+#include "cc-luma-device-options.h"
+
+static gboolean set_device (View *v, const char *key, JsonNode *value, gboolean refresh)
+{
+  g_autoptr(GError) error = NULL;
+  gboolean changed = g_str_equal (v->page, "power") ?
+    cc_luma_power_set (v->model, key, value, &error) :
+    cc_luma_pointer_set (v->model, key, value, &error);
+  if (!changed) cc_luma_view_report_error (v, error);
+  else if (refresh) cc_luma_view_queue_refresh (v);
+  return changed;
+}
+static void selected (LumaSegmentedControl *control, const char *value, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  const char *key = g_object_get_data (G_OBJECT (control), "cf-key");
+  g_autoptr(JsonNode) node = g_str_equal (key, "mNat") || g_str_equal (key, "tNat") ?
+    json_node_init_boolean (json_node_alloc (), g_str_equal (value, "true")) :
+    json_node_init_string (json_node_alloc (), value);
+  set_device (v, key, node, TRUE);
+}
+static GtkWidget *segments (View *v, const char *key, const char * const *choices)
+{
+  GtkWidget *control = luma_segmented_control_new ();
+  for (guint i = 0; choices[i]; i += 2)
+    luma_segmented_control_append (LUMA_SEGMENTED_CONTROL (control), choices[i], choices[i + 1]);
+  const char *value = g_str_equal (key, "mNat") || g_str_equal (key, "tNat") ?
+    cc_luma_view_flag (v, key) ? "true" : "false" : cc_luma_view_text (v, key);
+  luma_segmented_control_set_selected (LUMA_SEGMENTED_CONTROL (control), value);
+  g_autofree char *name = g_strconcat ("cf-", key, NULL);
+  gtk_widget_set_name (control, name);
+  g_object_set_data_full (G_OBJECT (control), "cf-key", g_strdup (key), g_free);
+  g_signal_connect_object (control, "changed", G_CALLBACK (selected), v->root, 0);
+  return control;
+}
+static void flag_changed (GtkSwitch *control, GParamSpec *pspec, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  g_autoptr(JsonNode) node = json_node_init_boolean (json_node_alloc (), gtk_switch_get_active (control));
+  set_device (v, g_object_get_data (G_OBJECT (control), "cf-key"), node, TRUE);
+}
+static void flag_row (View *v, GtkBox *rows, const char *key, const char *title, const char *hint)
+{
+  GtkWidget *control = gtk_switch_new ();
+  gtk_switch_set_active (GTK_SWITCH (control), cc_luma_view_flag (v, key));
+  gtk_widget_set_valign (control, GTK_ALIGN_CENTER);
+  g_autofree char *name = g_strconcat ("cf-", key, NULL);
+  gtk_widget_set_name (control, name);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (control), GTK_ACCESSIBLE_PROPERTY_LABEL, title, -1);
+  g_object_set_data_full (G_OBJECT (control), "cf-key", g_strdup (key), g_free);
+  g_signal_connect_object (control, "notify::active", G_CALLBACK (flag_changed), v->root, 0);
+  cc_luma_view_row (rows, title, hint, control);
+}
+static void radio_changed (GtkCheckButton *control, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v || !gtk_check_button_get_active (control)) return;
+  g_autoptr(JsonNode) node = json_node_init_string (json_node_alloc (), g_object_get_data (G_OBJECT (control), "cf-value"));
+  set_device (v, g_object_get_data (G_OBJECT (control), "cf-key"), node, TRUE);
+}
+static GtkCheckButton *radio_row (View *v, GtkBox *rows, GtkCheckButton *group,
+                                 const char *key, const char *value, const char *title, const char *hint)
+{
+  GtkWidget *control = gtk_check_button_new ();
+  gtk_check_button_set_group (GTK_CHECK_BUTTON (control), group);
+  gtk_check_button_set_active (GTK_CHECK_BUTTON (control), g_str_equal (cc_luma_view_text (v, key), value));
+  g_autofree char *name = g_strconcat ("cf-", key, "-", value, NULL);
+  gtk_widget_set_name (control, name);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (control), GTK_ACCESSIBLE_PROPERTY_LABEL, title, -1);
+  g_object_set_data_full (G_OBJECT (control), "cf-key", g_strdup (key), g_free);
+  g_object_set_data_full (G_OBJECT (control), "cf-value", g_strdup (value), g_free);
+  g_signal_connect_object (control, "toggled", G_CALLBACK (radio_changed), v->root, 0);
+  cc_luma_view_row (rows, title, hint, control);
+  return group ? group : GTK_CHECK_BUTTON (control);
+}
+static void speed_changed (GtkRange *control, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  g_autoptr(JsonNode) node = json_node_init_int (json_node_alloc (), gtk_range_get_value (control));
+  /* Continuous input retains the emitting range. */
+  set_device (v, g_object_get_data (G_OBJECT (control), "cf-key"), node, FALSE);
+}
+static void speed_row (View *v, GtkBox *rows, const char *key)
+{
+  GtkWidget *trail = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+  GtkWidget *range = gtk_scale_new_with_range (GTK_ORIENTATION_HORIZONTAL, -100, 100, 1);
+  gtk_scale_set_draw_value (GTK_SCALE (range), FALSE);
+  gtk_range_set_value (GTK_RANGE (range), json_node_get_int (cc_luma_fixture_get (v->model, key)));
+  gtk_widget_set_size_request (range, 120, -1);
+  g_autofree char *name = g_strconcat ("cf-", key, NULL);
+  gtk_widget_set_name (range, name);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (range), GTK_ACCESSIBLE_PROPERTY_LABEL, "Pointer speed", -1);
+  g_object_set_data_full (G_OBJECT (range), "cf-key", g_strdup (key), g_free);
+  g_signal_connect_object (range, "value-changed", G_CALLBACK (speed_changed), v->root, 0);
+  gtk_box_append (GTK_BOX (trail), cc_luma_view_label ("Slow", "small", TRUE));
+  gtk_box_append (GTK_BOX (trail), range);
+  gtk_box_append (GTK_BOX (trail), cc_luma_view_label ("Fast", "small", TRUE));
+  cc_luma_view_row (rows, "Pointer speed", NULL, trail);
+}
+static void mode_clicked (GtkButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  g_autoptr(JsonNode) node = json_node_init_string (json_node_alloc (), g_object_get_data (G_OBJECT (button), "cf-mode"));
+  set_device (v, "pmode", node, TRUE);
+}
+void cc_luma_view_power_render (View *v)
+{
+  JsonObject *facts = json_object_get_object_member (cc_luma_fixture_get_data (v->model), "CFPOWER");
+  cc_luma_view_header (v, "Power", json_object_get_string_member (facts, "status"), NULL);
+  /* TODO(kit-request settings-08): battery cell, daily history and mode-card paint
+   * consume the public battery/paint metrics. Fixture facts are never live
+   * metadata; the native UPower observer owns production values. */
+  GtkWidget *modes = gtk_flow_box_new ();
+  gtk_flow_box_set_selection_mode (GTK_FLOW_BOX (modes), GTK_SELECTION_NONE);
+  gtk_flow_box_set_min_children_per_line (GTK_FLOW_BOX (modes), 2);
+  gtk_flow_box_set_max_children_per_line (GTK_FLOW_BOX (modes), 3);
+  gtk_flow_box_set_column_spacing (GTK_FLOW_BOX (modes), 8);
+  gtk_flow_box_set_row_spacing (GTK_FLOW_BOX (modes), 8);
+  gtk_widget_set_name (modes, "cf-power-modes");
+  const char *ids[] = { "perf", "bal", "save" };
+  const char *titles[] = { "Performance", "Balanced", "Power saver" };
+  const char *icons[] = { "zap", "gauge", "battery-medium" };
+  const char *hints[] = { "Fast, runs warmer", "Speed and battery", "Longer battery" };
+  for (guint i = 0; i < G_N_ELEMENTS (ids); i++) {
+    GtkWidget *content = gtk_box_new (GTK_ORIENTATION_VERTICAL, 4);
+    gtk_box_append (GTK_BOX (content), luma_ui_icon_new (icons[i]));
+    gtk_box_append (GTK_BOX (content), cc_luma_view_label (titles[i], "body", FALSE));
+    gtk_box_append (GTK_BOX (content), cc_luma_view_label (hints[i], "small", TRUE));
+    GtkWidget *button = gtk_toggle_button_new ();
+    gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (button), g_str_equal (cc_luma_view_text (v, "pmode"), ids[i]));
+    gtk_button_set_child (GTK_BUTTON (button), content);
+    g_autofree char *name = g_strconcat ("cf-pmode-", ids[i], NULL);
+    gtk_widget_set_name (button, name);
+    g_object_set_data (G_OBJECT (button), "cf-mode", (gpointer) ids[i]);
+    g_signal_connect_object (button, "clicked", G_CALLBACK (mode_clicked), v->root, 0);
+    gtk_flow_box_insert (GTK_FLOW_BOX (modes), button, -1);
+  }
+  gtk_box_append (v->body, modes);
+  GtkBox *rows = cc_luma_view_group (v, "Charging");
+  GtkCheckButton *group = radio_row (v, rows, NULL, "charge", "max", "Charge to full", "Uses the whole battery. It wears out faster.");
+  radio_row (v, rows, group, "charge", "health", "Stop at 80%", "The battery lasts more years");
+  rows = cc_luma_view_group (v, "Connected devices");
+  JsonArray *devices = json_object_get_array_member (facts, "devices");
+  for (guint i = 0; i < json_array_get_length (devices); i++) {
+    JsonObject *device = json_array_get_object_element (devices, i);
+    g_autofree char *level = g_strdup_printf ("%" G_GINT64_FORMAT "%%", json_object_get_int_member (device, "percentage"));
+    GtkWidget *row = cc_luma_view_row (rows, json_object_get_string_member (device, "name"), NULL, cc_luma_view_label (level, "body", FALSE));
+    gtk_box_prepend (GTK_BOX (row), luma_ui_icon_new (json_object_get_string_member (device, "icon")));
+  }
+  rows = cc_luma_view_group (v, "Saving power");
+  flag_row (v, rows, "autoBright", "Automatic brightness", "Follows the light in the room");
+  flag_row (v, rows, "dim", "Dim when idle", NULL);
+  flag_row (v, rows, "autoSaver", "Power saver when low", "Turns on at 20%");
+  JsonArray *minutes = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFMINS");
+  g_auto(GStrv) choices = g_new0 (char *, json_array_get_length (minutes) * 2 + 1);
+  for (guint i = 0; i < json_array_get_length (minutes); i++) {
+    JsonArray *pair = json_array_get_array_element (minutes, i);
