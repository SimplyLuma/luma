diff --git a/shell/cc-luma-applications.c b/shell/cc-luma-applications.c
new file mode 100644
index 0000000..f087d87
--- /dev/null
+++ b/shell/cc-luma-applications.c
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-applications.h"
+GVariant *cc_luma_applications_describe (GAppInfo *info)
+{
+  g_return_val_if_fail (G_IS_APP_INFO (info), NULL);
+  GVariantBuilder fields; g_variant_builder_init (&fields, G_VARIANT_TYPE_VARDICT);
+  const char *id = g_app_info_get_id (info);
+  const char *name = g_app_info_get_display_name (info);
+  const char *description = g_app_info_get_description (info);
+  const char *executable = g_app_info_get_executable (info);
+  if (id) g_variant_builder_add (&fields, "{sv}", "id", g_variant_new_string (id));
+  if (name) g_variant_builder_add (&fields, "{sv}", "name", g_variant_new_string (name));
+  if (description) g_variant_builder_add (&fields, "{sv}", "description", g_variant_new_string (description));
+  if (executable) g_variant_builder_add (&fields, "{sv}", "executable", g_variant_new_string (executable));
+  GIcon *icon = g_app_info_get_icon (info);
+  g_autofree char *icon_text = icon ? g_icon_to_string (icon) : NULL;
+  if (icon_text) g_variant_builder_add (&fields, "{sv}", "icon", g_variant_new_string (icon_text));
+  const char * const *types = g_app_info_get_supported_types (info);
+  if (types) g_variant_builder_add (&fields, "{sv}", "types", g_variant_new_strv (types, -1));
+  g_variant_builder_add (&fields, "{sv}", "supports-uris", g_variant_new_boolean (g_app_info_supports_uris (info)));
+  g_variant_builder_add (&fields, "{sv}", "supports-files", g_variant_new_boolean (g_app_info_supports_files (info)));
+  return g_variant_ref_sink (g_variant_builder_end (&fields));
+}
+static void read_thread (GTask *task, gpointer source, gpointer task_data, GCancellable *cancel)
+{
+  if (g_task_return_error_if_cancelled (task)) return;
+  GVariantBuilder applications, defaults, result;
+  g_variant_builder_init (&applications, G_VARIANT_TYPE ("aa{sv}"));
+  g_variant_builder_init (&defaults, G_VARIANT_TYPE ("a{sa{sv}}"));
+  GList *all = g_app_info_get_all ();
+  for (GList *p = all; p; p = p->next) {
+    if (cancel && g_cancellable_is_cancelled (cancel)) break;
+    GAppInfo *info = p->data;
+    if (!g_app_info_should_show (info)) continue;
+    g_autoptr(GVariant) fields = cc_luma_applications_describe (info);
+    g_variant_builder_add_value (&applications, fields);
+  }
+  g_list_free_full (all, g_object_unref);
+  /* The same content types as upstream cc-default-apps-page.blp. An absent
+   * default is omitted, not replaced with the corresponding fixture app. */
+  const struct { const char *key, *type; } queries[] = {
+    { "web", "x-scheme-handler/http" }, { "mail", "x-scheme-handler/mailto" },
+    { "cal", "text/calendar" }, { "music", "audio/x-vorbis+ogg" },
+    { "video", "video/x-ogm+ogg" }, { "photo", "image/jpeg" },
+  };
+  for (guint i = 0; i < G_N_ELEMENTS (queries); i++) {
+    if (cancel && g_cancellable_is_cancelled (cancel)) break;
+    g_autoptr(GAppInfo) info = g_app_info_get_default_for_type (queries[i].type, FALSE);
+    if (!info) continue;
+    g_autoptr(GVariant) fields = cc_luma_applications_describe (info);
+    g_variant_builder_add (&defaults, "{s@a{sv}}", queries[i].key, fields);
+  }
+  if (g_task_return_error_if_cancelled (task)) {
+    g_variant_builder_clear (&applications); g_variant_builder_clear (&defaults); return;
+  }
+  g_variant_builder_init (&result, G_VARIANT_TYPE_VARDICT);
+  g_variant_builder_add (&result, "{sv}", "applications", g_variant_builder_end (&applications));
+  g_variant_builder_add (&result, "{sv}", "defaults", g_variant_builder_end (&defaults));
+  g_task_return_pointer (task, g_variant_ref_sink (g_variant_builder_end (&result)), (GDestroyNotify) g_variant_unref);
+}
+void cc_luma_applications_read_async (GCancellable *cancel, GAsyncReadyCallback callback, gpointer data)
+{
+  g_autoptr(GTask) task = g_task_new (NULL, cancel, callback, data);
+  g_task_set_source_tag (task, cc_luma_applications_read_async);
+  if (g_getenv ("LUMA_SETTINGS_FIXTURE") != NULL) {
+    g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Fixture Settings cannot read the native application registry"); return;
+  }
+  if (g_task_return_error_if_cancelled (task)) return;
+  g_task_run_in_thread (task, read_thread);
+}
+GVariant *cc_luma_applications_read_finish (GAsyncResult *result, GError **error)
+{
+  g_return_val_if_fail (G_IS_TASK (result) && g_task_get_source_tag (G_TASK (result)) == cc_luma_applications_read_async, NULL);
+  return g_task_propagate_pointer (G_TASK (result), error);
+}
diff --git a/shell/cc-luma-applications.h b/shell/cc-luma-applications.h
new file mode 100644
index 0000000..87d3544
--- /dev/null
+++ b/shell/cc-luma-applications.h
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <gio/gio.h>
+G_BEGIN_DECLS
+/* Asynchronous native GAppInfo read. No launch, association write, uninstall,
+ * cache deletion or fabricated package/data size is performed. */
+void cc_luma_applications_read_async (GCancellable *cancel, GAsyncReadyCallback callback, gpointer data);
+GVariant *cc_luma_applications_read_finish (GAsyncResult *result, GError **error);
+/* Converts supplied native records without I/O; permits isolated tests. */
+GVariant *cc_luma_applications_describe (GAppInfo *info);
+G_END_DECLS
diff --git a/shell/cc-luma-audio.c b/shell/cc-luma-audio.c
new file mode 100644
index 0000000..340de38
--- /dev/null
+++ b/shell/cc-luma-audio.c
@@ -0,0 +1,164 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-audio.h"
+#include <gvc-mixer-control.h>
+
+struct _CcLumaAudio {
+  GObject parent_instance;
+  GvcMixerControl *control;
+  GPtrArray *watched;
+  JsonNode *snapshot;
+  guint idle;
+  guint connect_timeout;
+  gboolean failure_pending;
+  GIOErrorEnum failure_code;
+};
+G_DEFINE_TYPE (CcLumaAudio, cc_luma_audio, G_TYPE_OBJECT)
+static guint signals[2];
+static void schedule (CcLumaAudio *self);
+static void property_changed (GObject *object, GParamSpec *spec, CcLumaAudio *self) { schedule (self); }
+static void control_changed (GvcMixerControl *control, guint id, CcLumaAudio *self) { schedule (self); }
+static void clear_watches (CcLumaAudio *self)
+{
+  for (guint i = 0; i < self->watched->len; i++) g_signal_handlers_disconnect_by_data (self->watched->pdata[i], self);
+  g_ptr_array_set_size (self->watched, 0);
+}
+static gboolean watch (CcLumaAudio *self, GObject *object)
+{
+  for (guint i = 0; i < self->watched->len; i++) if (self->watched->pdata[i] == object) return FALSE;
+  g_ptr_array_add (self->watched, g_object_ref (object));
+  g_signal_connect_object (object, "notify", G_CALLBACK (property_changed), self, 0);
+  return TRUE;
+}
+static void map_changed (GvcChannelMap *map, gboolean set, CcLumaAudio *self) { schedule (self); }
+static void text (JsonObject *object, const char *key, const char *value)
+{
+  if (value) json_object_set_string_member (object, key, value);
+  else json_object_set_null_member (object, key);
+}
+static void streams (CcLumaAudio *self, JsonObject *root, const char *key, GSList *list, GvcMixerStream *selected)
+{
+  JsonArray *array = json_array_new ();
+  for (GSList *i = list; i; i = i->next) {
+    GvcMixerStream *stream = i->data;
+    JsonObject *item = json_object_new ();
+    json_object_set_int_member (item, "id", gvc_mixer_stream_get_id (stream));
+    json_object_set_int_member (item, "index", gvc_mixer_stream_get_index (stream));
+    text (item, "name", gvc_mixer_stream_get_name (stream));
+    text (item, "description", gvc_mixer_stream_get_description (stream));
+    text (item, "application_id", gvc_mixer_stream_get_application_id (stream));
+    json_object_set_int_member (item, "volume", gvc_mixer_stream_get_volume (stream));
+    json_object_set_boolean_member (item, "muted", gvc_mixer_stream_get_is_muted (stream));
+    json_object_set_boolean_member (item, "selected", stream == selected);
+    json_object_set_boolean_member (item, "running", gvc_mixer_stream_is_running (stream));
+    json_object_set_boolean_member (item, "event_stream", gvc_mixer_stream_is_event_stream (stream));
+    const GvcChannelMap *map = gvc_mixer_stream_get_channel_map (stream);
+    if (map) {
+      json_object_set_int_member (item, "channels", gvc_channel_map_get_num_channels (map));
+      json_object_set_boolean_member (item, "can_balance", gvc_channel_map_can_balance (map));
+      text (item, "channel_mapping", gvc_channel_map_get_mapping (map));
+      const double *values = gvc_channel_map_get_volume ((GvcChannelMap *) map);
+      if (values) json_object_set_double_member (item, "balance", values[BALANCE]);
+      if (watch (self, G_OBJECT (map))) g_signal_connect_object ((GvcChannelMap *) map, "volume-changed", G_CALLBACK (map_changed), self, 0);
+    }
+    GvcMixerUIDevice *device = gvc_mixer_control_lookup_device_from_stream (self->control, stream);
+    if (device) {
+      json_object_set_int_member (item, "device_id", gvc_mixer_ui_device_get_id (device));
+      text (item, "origin", gvc_mixer_ui_device_get_origin (device));
+      text (item, "port", gvc_mixer_ui_device_get_port (device));
+      text (item, "profile", gvc_mixer_ui_device_get_active_profile (device));
+      watch (self, G_OBJECT (device));
+    }
+    watch (self, G_OBJECT (stream)); json_array_add_object_element (array, item);
+  }
+  g_slist_free (list); json_object_set_array_member (root, key, array);
+}
+static gboolean refresh (gpointer data)
+{
+  CcLumaAudio *self = data; self->idle = 0;
+  g_autoptr (CcLumaAudio) hold = g_object_ref (self);
+  if (!self->control) return G_SOURCE_REMOVE;
+  if (self->failure_pending) {
+    self->failure_pending = FALSE;
+    clear_watches (self); g_clear_pointer (&self->snapshot, json_node_free);
+    g_autoptr (GError) error = g_error_new_literal (G_IO_ERROR, self->failure_code,
+      self->failure_code == G_IO_ERROR_TIMED_OUT ? "Audio service connection timed out" : "Audio service is unavailable");
+    g_signal_emit (self, signals[1], 0, error); return G_SOURCE_REMOVE;
+  }
+  if (gvc_mixer_control_get_state (self->control) != GVC_STATE_READY) return G_SOURCE_REMOVE;
+  clear_watches (self);
+  JsonObject *root = json_object_new ();
+  json_object_set_double_member (root, "normal_volume", gvc_mixer_control_get_vol_max_norm (self->control));
+  json_object_set_double_member (root, "amplified_volume", gvc_mixer_control_get_vol_max_amplified (self->control));
+  streams (self, root, "outputs", gvc_mixer_control_get_sinks (self->control), gvc_mixer_control_get_default_sink (self->control));
+  streams (self, root, "inputs", gvc_mixer_control_get_sources (self->control), gvc_mixer_control_get_default_source (self->control));
+  streams (self, root, "applications", gvc_mixer_control_get_sink_inputs (self->control), NULL);
+  g_clear_pointer (&self->snapshot, json_node_free);
+  self->snapshot = json_node_init_object (json_node_alloc (), root); json_object_unref (root);
+  g_signal_emit (self, signals[0], 0); return G_SOURCE_REMOVE;
+}
+static void schedule (CcLumaAudio *self)
+{
+  if (!self->idle) self->idle = g_idle_add (refresh, self);
+}
+static void state_changed (GvcMixerControl *control, guint state, CcLumaAudio *self)
+{
+  if (state == GVC_STATE_READY) {
+    self->failure_pending = FALSE;
+    if (self->connect_timeout) { g_source_remove (self->connect_timeout); self->connect_timeout = 0; }
+    schedule (self); return;
+  }
+  if (state == GVC_STATE_FAILED || state == GVC_STATE_CLOSED) {
+    if (self->connect_timeout) { g_source_remove (self->connect_timeout); self->connect_timeout = 0; }
+    self->failure_pending = TRUE; self->failure_code = G_IO_ERROR_NOT_CONNECTED; schedule (self);
+  }
+}
+static gboolean connection_expired (gpointer data)
+{
+  CcLumaAudio *self = data; self->connect_timeout = 0;
+  self->failure_pending = TRUE; self->failure_code = G_IO_ERROR_TIMED_OUT; schedule (self); return G_SOURCE_REMOVE;
+}
+CcLumaAudio *cc_luma_audio_new (void) { return g_object_new (CC_TYPE_LUMA_AUDIO, NULL); }
+void cc_luma_audio_stop (CcLumaAudio *self)
+{
+  if (self->idle) { g_source_remove (self->idle); self->idle = 0; }
+  if (self->connect_timeout) { g_source_remove (self->connect_timeout); self->connect_timeout = 0; }
+  self->failure_pending = FALSE;
+  clear_watches (self); g_clear_pointer (&self->snapshot, json_node_free);
+  if (self->control) { g_signal_handlers_disconnect_by_data (self->control, self); gvc_mixer_control_close (self->control); g_clear_object (&self->control); }
+}
+void cc_luma_audio_start (CcLumaAudio *self)
+{
+  cc_luma_audio_stop (self);
+  self->control = gvc_mixer_control_new ("Luma Settings");
+  g_signal_connect_object (self->control, "state-changed", G_CALLBACK (state_changed), self, 0);
+  const char *events[] = { "stream-added", "stream-changed", "stream-removed", "default-sink-changed", "default-source-changed", "output-added", "input-added", "output-removed", "input-removed", "active-output-update", "active-input-update" };
+  for (guint i = 0; i < G_N_ELEMENTS (events); i++) g_signal_connect_object (self->control, events[i], G_CALLBACK (control_changed), self, 0);
+  self->connect_timeout = g_timeout_add_seconds (10, connection_expired, self);
+  /* This upstream version declares gboolean but returns PulseAudio's integer
+   * result: zero means successful initiation. State signals own readiness. */
+  gvc_mixer_control_open (self->control);
+}
+JsonNode *cc_luma_audio_dup_snapshot (CcLumaAudio *self)
+{
+  if (!self->snapshot || !self->control || self->failure_pending || gvc_mixer_control_get_state (self->control) != GVC_STATE_READY) return NULL;
+  g_autofree char *serialized = json_to_string (self->snapshot, FALSE);
+  g_autoptr (JsonParser) parser = json_parser_new ();
+  if (!json_parser_load_from_data (parser, serialized, -1, NULL)) return NULL;
+  return json_node_copy (json_parser_get_root (parser));
+}
+static void dispose (GObject *object)
+{
+  CcLumaAudio *self = CC_LUMA_AUDIO (object); cc_luma_audio_stop (self);
+  G_OBJECT_CLASS (cc_luma_audio_parent_class)->dispose (object);
+}
+static void finalize (GObject *object)
+{
+  g_ptr_array_unref (CC_LUMA_AUDIO (object)->watched); G_OBJECT_CLASS (cc_luma_audio_parent_class)->finalize (object);
+}
+static void cc_luma_audio_init (CcLumaAudio *self) { self->watched = g_ptr_array_new_with_free_func (g_object_unref); }
+static void cc_luma_audio_class_init (CcLumaAudioClass *klass)
+{
+  GObjectClass *object = G_OBJECT_CLASS (klass); object->dispose = dispose; object->finalize = finalize;
+  signals[0] = g_signal_new ("changed", G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL, G_TYPE_NONE, 0);
+  signals[1] = g_signal_new ("failed", G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL, G_TYPE_NONE, 1, G_TYPE_ERROR);
+}
diff --git a/shell/cc-luma-audio.h b/shell/cc-luma-audio.h
new file mode 100644
index 0000000..40d0a0c
