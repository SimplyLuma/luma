+    g_printerr ("Settings runtime smoke: LUMA_SETTINGS_SMOKE=1 requires an explicit fixture\n");
+    return NULL;
+  }
+  const char *id = cc_luma_identity_select (g_getenv ("LUMA_SETTINGS_FIXTURE") != NULL,
+    g_getenv ("LUMA_SETTINGS_APPLICATION_ID"), &error);
+  if (!id)
+    {
+      g_printerr ("Settings identity: %s\n", error->message);
+      return NULL;
+    }
+  GtkApplication *application = g_object_new (CC_TYPE_APPLICATION,
+                       "application-id", id,
                        "flags", G_APPLICATION_HANDLES_COMMAND_LINE |
                          (g_getenv ("LUMA_SETTINGS_FIXTURE") ? G_APPLICATION_NON_UNIQUE : 0),
                        NULL);
+  /* Upstream's constructor is a singleton. Fail closed if another caller
