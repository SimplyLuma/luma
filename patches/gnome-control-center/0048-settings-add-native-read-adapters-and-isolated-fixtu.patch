+  g_assert_true (cc_luma_keyboard_select (model, "Deutsch", NULL));
+  g_assert_true (cc_luma_keyboard_move (model, 2, 0, NULL));
+  JsonArray *sources = json_node_get_array (cc_luma_fixture_get (model, "srcs"));
+  g_assert_cmpuint (json_array_get_length (sources), ==, 3);
+  g_assert_cmpstr (json_array_get_string_element (sources, 0), ==, "Français");
+  g_assert_cmpstr (json_array_get_string_element (sources, 1), ==, "English (US)");
+  g_assert_cmpstr (json_array_get_string_element (sources, 2), ==, "Deutsch");
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "src")), ==, "Deutsch");
+  g_assert_true (cc_luma_keyboard_move (model, 0, 2, NULL));
+  g_assert_false (cc_luma_keyboard_move (model, 0, 3, NULL));
+  g_assert_true (cc_luma_keyboard_remove (model, "Deutsch", NULL));
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "src")), ==, "English (US)");
+  const struct { const char *key; const char *choices[5]; } catalog[] = {
+    { "perWin", { "all", "win", NULL } },
+    { "altKey", { "off", "AltRight", "AltLeft", "ContextMenu", NULL } },
+    { "compose", { "off", "ContextMenu", "CapsLock", "ControlRight", NULL } },
+  };
+  for (guint i = 0; i < G_N_ELEMENTS (catalog); i++)
+    for (guint j = 0; catalog[i].choices[j]; j++) {
+      g_assert_true (cc_luma_keyboard_set_choice (model, catalog[i].key, catalog[i].choices[j], NULL));
+      g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, catalog[i].key)), ==, catalog[i].choices[j]);
+    }
+  g_assert_false (cc_luma_keyboard_set_choice (model, "compose", "AltRight", NULL));
+  g_assert_false (cc_luma_keyboard_set_choice (model, "nightFrom", "19:00", NULL));
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "nightFrom")), ==, night_before);
+  g_assert_true (cc_luma_keyboard_validate (model));
+  g_autoptr(JsonNode) empty = json_node_new (JSON_NODE_ARRAY);
+  json_node_take_array (empty, json_array_new ());
+  sources = json_node_get_array (cc_luma_fixture_get (model, "srcs"));
+  while (json_array_get_length (sources)) json_array_remove_element (sources, 0);
+  g_assert_false (cc_luma_keyboard_validate (model));
+  g_assert_false (cc_luma_keyboard_add (model, "Deutsch", NULL));
+}
+static void pointer_model (void)
+{
+  g_autoptr(CcLumaFixture) model = cc_luma_fixture_load (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), NULL);
+  g_assert_true (cc_luma_pointer_validate (model));
+  const struct { const char *key; const char *choices[3]; } catalog[] = {
+    { "mtab", { "mouse", "touchpad", NULL } }, { "mBtn", { "left", "right", NULL } },
+    { "tSec", { "two", "corner", NULL } }, { "tScroll", { "two", "edge", NULL } },
+  };
+  for (guint i = 0; i < G_N_ELEMENTS (catalog); i++)
+    for (guint j = 0; catalog[i].choices[j]; j++) {
+      g_autoptr(JsonNode) value = json_node_init_string (json_node_alloc (), catalog[i].choices[j]);
+      g_assert_true (cc_luma_pointer_set (model, catalog[i].key, value, NULL));
+    }
+  const char *flags[] = { "mAccel", "mNat", "tp", "tpType", "tTap", "tNat" };
+  for (guint i = 0; i < G_N_ELEMENTS (flags); i++) {
+    g_autoptr(JsonNode) value = json_node_init_boolean (json_node_alloc (), FALSE);
+    g_assert_true (cc_luma_pointer_set (model, flags[i], value, NULL));
+  }
+  const char *speeds[] = { "mSpeed", "tSpeed" };
+  for (guint i = 0; i < G_N_ELEMENTS (speeds); i++) {
+    for (gint64 speed = -100; speed <= 100; speed += 100) {
+      g_autoptr(JsonNode) value = json_node_init_int (json_node_alloc (), speed);
+      g_assert_true (cc_luma_pointer_set (model, speeds[i], value, NULL));
+    }
+    g_autoptr(JsonNode) low = json_node_init_int (json_node_alloc (), -101);
+    g_autoptr(JsonNode) high = json_node_init_int (json_node_alloc (), 101);
+    g_assert_false (cc_luma_pointer_set (model, speeds[i], low, NULL));
+    g_assert_false (cc_luma_pointer_set (model, speeds[i], high, NULL));
+    g_assert_cmpint (json_node_get_int (cc_luma_fixture_get (model, speeds[i])), ==, 100);
+  }
+  g_autoptr(JsonNode) invalid = json_node_init_string (json_node_alloc (), "true");
+  g_assert_false (cc_luma_pointer_set (model, "tNat", invalid, NULL));
+  g_assert_false (cc_luma_pointer_set (model, "pmode", invalid, NULL));
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "pmode")), ==, "bal");
+  g_assert_true (cc_luma_pointer_validate (model));
+}
+
 int main (int argc, char **argv)
 {
   g_test_init (&argc, &argv, NULL);
@@ -392,6 +668,13 @@ int main (int argc, char **argv)
       g_test_add_func ("/settings/fixture/appearance", appearance_model);
       g_test_add_func ("/settings/fixture/discovery", discovery_model);
       g_test_add_func ("/settings/fixture/displays", display_model);
+      g_test_add_func ("/settings/fixture/night", night_model);
+      g_test_add_func ("/settings/fixture/sound", sound_model);
+      g_test_add_func ("/settings/fixture/search-folder", search_folder_model);
+      g_test_add_func ("/settings/fixture/power", power_model);
+      g_test_add_func ("/settings/fixture/pointer", pointer_model);
+      g_test_add_func ("/settings/fixture/keyboard", keyboard_model);
