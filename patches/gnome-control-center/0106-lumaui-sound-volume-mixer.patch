+/* The Volume mixer is offered while the service runs at version 2 or later. */
+static void
+devices_sync (Sound *self)
+{
+  g_autofree char *owner = g_dbus_proxy_get_name_owner (self->devices);
+  g_autoptr (GVariant) version = g_dbus_proxy_get_cached_property (self->devices, "Version");
+  cc_luma_fixture_publish_boolean (self->model, "mixer", owner && version &&
+    g_variant_is_of_type (version, G_VARIANT_TYPE_UINT32) && g_variant_get_uint32 (version) >= 2);
+}
+
+static void devices_owner (GDBusProxy *proxy, GParamSpec *pspec, Sound *self) { devices_sync (self); }
+static void devices_properties (GDBusProxy *proxy, GVariant *changed, GStrv invalidated, Sound *self) { devices_sync (self); }
+
+static void
+devices_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Sound *self = data;
+  if (!proxy) { g_debug ("Luma sound service: %s", error->message); return; }
+  self->devices = proxy;
+  g_signal_connect (proxy, "notify::g-name-owner", G_CALLBACK (devices_owner), self);
+  g_signal_connect (proxy, "g-properties-changed", G_CALLBACK (devices_properties), self);
+  devices_sync (self);
+}
