diff --git a/shell/luma-settings-devices.css b/shell/luma-settings-devices.css
index 301eef1..1cb46a0 100644
--- a/shell/luma-settings-devices.css
+++ b/shell/luma-settings-devices.css
@@ -46,6 +46,31 @@ button.cf-mon.on { box-shadow: inset 0 1px 0 @luma_chip_highlight, 0 0 0 1px @lu
 .cf-meter > box.on { background: @luma_good; }
 .cf-meter.in { min-width: 170px; margin: 0; }
 
+/* Volume mixer (cc-luma-view-mixer.c): one well of channel strips on a grid on a wide page, rows on a phone or a TV.
+ * A strip is 96 wide (STRIP_WIDTH); every part sits on the same line as its neighbours': a 36 icon, the name on two
+ * 18 px lines and where it plays on one, the LumaUI volume with its level (LumaVolumeSlider, 148 tall), the readout, the keys. */
+.cf-mix-columns { padding: 12px 8px; }
+.cf-mix-columns > flowboxchild, .cf-mix-columns > flowboxchild:hover, .cf-mix-columns > flowboxchild:selected { padding: 0; background: none; outline: none; }
+.cf-mix-strip { padding: 12px 6px 10px; border-radius: 14px; }
+/* The output is the whole mix: raised on the well like a chip. */
+.cf-mix-strip.output { background: @luma_chip; box-shadow: inset 0 1px 0 @luma_chip_highlight, 0 0 0 1px @luma_chip_ring, 0 1px 2px @luma_chip_shadow, 0 3px 8px -3px @luma_chip_drop; }
+.cf-mix-strip > .cf-mix-face { min-width: 36px; min-height: 36px; margin-bottom: 8px; }
+.cf-mix-tile { border-radius: 11px; }
+.cf-mix-tile image { -gtk-icon-size: 18px; }
+.cf-row .cf-mix-tile { border-radius: 9px; }
+.cf-row .cf-mix-tile image { -gtk-icon-size: 16px; }
+.cf-mix-strip > label { min-height: 18px; }
+.cf-mix-strip > label.cf-mix-name { min-height: 36px; }
+.cf-mix-strip > lumaui-volume-slider.cf-mix-fader { min-height: 148px; margin: 12px 0 8px; }
+.cf-mix-readout { min-width: 40px; min-height: 18px; font-feature-settings: "tnum"; }
+.cf-mix-strip > .cf-mix-readout { margin-bottom: 6px; }
+.cf-mix-keys { min-height: 28px; }
+/* Rows: the volume runs under the words, from the words' edge to the row's end. */
+.cf-mixer .cf-card .cf-mix-row { padding-top: 12px; padding-bottom: 10px; background-position: 0 -12px; }
+.cf-mixer .cf-card > box > .cf-mix-row:first-child { background-image: none; }
+.cf-mix-level { margin-left: 37px; } /* the track starts on the words' edge (the knob's half less the track's) */
+.cf-mix-level > .cf-mix-readout { margin-top: 3px; }
+
 /* Power (v70 .cfbat, .cfcell, .cfbars) */
 .cf-cell { min-width: 124px; min-height: 46px; padding: 4px; border-radius: 13px; box-shadow: inset 0 0 0 2px @luma_faint; }
 .cf-cell-fill { border-radius: 9px; background: @luma_good; box-shadow: 0 0 16px alpha(@luma_good, 0.35); }
