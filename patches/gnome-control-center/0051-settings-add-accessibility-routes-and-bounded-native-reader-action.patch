+  g_assert_cmpint (json_node_get_int (cc_luma_fixture_get (model, "vol")), ==, volume_before);
+  g_autofree char *data_after = json_to_string (
+    json_object_get_member (cc_luma_fixture_get_data (model), "CFSZ"), FALSE);
+  g_assert_cmpstr (data_after, ==, data_before);
