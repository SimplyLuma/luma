 gboolean cc_luma_pointer_validate (CcLumaFixture *model);
 gboolean cc_luma_pointer_set (CcLumaFixture *model, const char *key, JsonNode *value, GError **error);
+gboolean cc_luma_a11y_validate (CcLumaFixture *model);
+gboolean cc_luma_a11y_set (CcLumaFixture *model, const char *key, JsonNode *value, GError **error);
 G_END_DECLS
diff --git a/shell/cc-luma-fixture.c b/shell/cc-luma-fixture.c
index 5c945fb..7bb1bf8 100644
--- a/shell/cc-luma-fixture.c
+++ b/shell/cc-luma-fixture.c
@@ -1,6 +1,7 @@
 /* SPDX-License-Identifier: GPL-2.0-or-later */
 #include "cc-luma-fixture.h"
 #include <gio/gio.h>
+#include <math.h>
 
 struct _CcLumaFixture
 {
@@ -151,6 +152,23 @@ cc_luma_fixture_set (CcLumaFixture *self, const char *key, JsonNode *value, GErr
   json_object_set_member (object, leaf, json_node_copy (value));
   return TRUE;
 }
+gboolean
+cc_luma_fixture_set_number (CcLumaFixture *self, const char *key, double value, GError **error)
+{
+  g_autofree char *leaf = NULL;
+  JsonObject *object = parent_for_key (self, key, &leaf);
+  JsonNode *previous = object ? json_object_get_member (object, leaf) : NULL;
+  GType type = previous && JSON_NODE_HOLDS_VALUE (previous) ?
+    json_node_get_value_type (previous) : G_TYPE_INVALID;
+  if (!isfinite (value) || (type != G_TYPE_INT64 && type != G_TYPE_DOUBLE)) {
+    g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                 "Unknown or nonnumeric fixture setting: %s", key ? key : "(null)");
+    return FALSE;
+  }
+  JsonNode *number = json_node_init_double (json_node_alloc (), value);
+  json_object_set_member (object, leaf, number);
+  return TRUE;
+}
 /* Radio dependencies follow v70 cfFx: airplane-on disables Wi-Fi and
  * Bluetooth; enabling either radio clears airplane mode. Turning airplane
  * off does not silently turn radios back on. Validate all keys first. */
diff --git a/shell/cc-luma-fixture.h b/shell/cc-luma-fixture.h
index 1cf952b..0acc326 100644
--- a/shell/cc-luma-fixture.h
+++ b/shell/cc-luma-fixture.h
@@ -12,6 +12,11 @@ CcLumaFixture *cc_luma_fixture_parse (const char *data, gssize length, GError **
 JsonNode *cc_luma_fixture_get (CcLumaFixture *self, const char *key);
 gboolean cc_luma_fixture_set (CcLumaFixture *self, const char *key,
                               JsonNode *value, GError **error);
+/* Numeric fixture controls may cross integer/fractional representations;
+ * their owning domain still validates bounds and steps before this call.
+ * The ordinary scalar setter retains its exact-type contract. */
+gboolean cc_luma_fixture_set_number (CcLumaFixture *self, const char *key,
+                                     double value, GError **error);
 gboolean cc_luma_fixture_set_flag (CcLumaFixture *self, const char *key,
                                    gboolean value, GError **error);
 gboolean cc_luma_fixture_connect_network (CcLumaFixture *self, const char *name, GError **error);
