+static void accessibility_model (void)
+{
+  g_autoptr(CcLumaFixture) model = cc_luma_fixture_load (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), NULL);
+  g_assert_nonnull (model);
+  g_assert_true (cc_luma_a11y_validate (model));
+  g_autofree char *data_before = json_to_string (
+    json_object_get_member (cc_luma_fixture_get_data (model), "CFSZ"), FALSE);
+  gboolean wifi_before = json_node_get_boolean (cc_luma_fixture_get (model, "wifi"));
+  gint64 volume_before = json_node_get_int (cc_luma_fixture_get (model, "vol"));
+  g_autoptr(JsonNode) enabled = json_node_init_boolean (json_node_alloc (), TRUE);
+  g_assert_true (cc_luma_a11y_set (model, "hc", enabled, NULL));
+  g_assert_true (json_node_get_boolean (cc_luma_fixture_get (model, "hc")));
+  g_assert_false (cc_luma_a11y_set (model, "wifi", enabled, NULL));
+  g_assert_cmpint (json_node_get_boolean (cc_luma_fixture_get (model, "wifi")), ==, wifi_before);
+  /* Initial zoom 2 is a JSON integer. Real half-step input must work without
+   * relaxing the ordinary exact-type setter or accepting arbitrary factors. */
+  g_autoptr(JsonNode) fractional = json_node_init_double (json_node_alloc (), 2.5);
+  g_assert_false (cc_luma_fixture_set (model, "zoomX", fractional, NULL));
+  g_assert_true (cc_luma_a11y_set (model, "zoomX", fractional, NULL));
+  g_assert_cmpfloat (json_node_get_double (cc_luma_fixture_get (model, "zoomX")), ==, 2.5);
+  const double invalid_factors[] = { 0.5, 1.25, 2.3, 10.5, NAN, INFINITY, -INFINITY };
+  for (guint i = 0; i < G_N_ELEMENTS (invalid_factors); i++) {
+    g_autoptr(JsonNode) value = json_node_init_double (json_node_alloc (), invalid_factors[i]);
+    g_autoptr(GError) error = NULL;
+    g_assert_false (cc_luma_a11y_set (model, "zoomX", value, &error));
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+    g_assert_cmpfloat (json_node_get_double (cc_luma_fixture_get (model, "zoomX")), ==, 2.5);
+  }
+  const double endpoints[] = { 1, 1.5, 10 };
+  for (guint i = 0; i < G_N_ELEMENTS (endpoints); i++) {
+    g_autoptr(JsonNode) value = json_node_init_double (json_node_alloc (), endpoints[i]);
+    g_assert_true (cc_luma_a11y_set (model, "zoomX", value, NULL));
+    g_assert_cmpfloat (json_node_get_double (cc_luma_fixture_get (model, "zoomX")), ==, endpoints[i]);
+  }
+  g_autoptr(JsonNode) bad_integer = json_node_init_double (json_node_alloc (), 50.5);
+  g_assert_false (cc_luma_a11y_set (model, "repDelay", bad_integer, NULL));
+  g_assert_cmpint (json_node_get_int (cc_luma_fixture_get (model, "repDelay")), ==, 50);
+  g_autoptr(JsonNode) bad_choice = json_node_init_string (json_node_alloc (), "unpublished-choice");
+  g_assert_false (cc_luma_a11y_set (model, "cursor", bad_choice, NULL));
+  g_assert_false (cc_luma_a11y_set (model, "zoomF", bad_choice, NULL));
+  g_assert_false (cc_luma_fixture_set_number (model, "hc", 1, NULL));
+  g_assert_false (cc_luma_fixture_set_number (model, "no-such-setting", 1, NULL));
+  g_assert_false (cc_luma_fixture_set_number (model, "zoomX", NAN, NULL));
+  /* A malformed peer is rejected before editing a valid boolean. */
+  g_autoptr(JsonNode) malformed = json_node_init_int (json_node_alloc (), 101);
+  g_assert_true (cc_luma_fixture_set (model, "repSpeed", malformed, NULL));
+  g_assert_false (cc_luma_a11y_validate (model));
