+++ b/shell/cc-luma-preferences.c
@@ -130,6 +130,33 @@ CcLumaPreferences *cc_luma_preferences_new_native (CcLumaPreferenceSet set, GErr
     { "org.gnome.desktop.media-handling",
       { "autorun-never", "autorun-x-content-start-app", "autorun-x-content-ignore", "autorun-x-content-open-folder", NULL },
       { "b", "as", "as", "as", NULL } },
+    /* GNOME Control Center 50.4 panels/universal-access is the owner of
