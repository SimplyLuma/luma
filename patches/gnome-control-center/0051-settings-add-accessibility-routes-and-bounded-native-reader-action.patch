diff --git a/shell/cc-luma-services.c b/shell/cc-luma-services.c
index c56bdbf..49ce730 100644
--- a/shell/cc-luma-services.c
+++ b/shell/cc-luma-services.c
@@ -35,6 +35,38 @@ static const Contract *contract (CcLumaService service)
   return (guint) service < G_N_ELEMENTS (contracts) ? &contracts[service] : NULL;
 }
 
+static void reader_preferences_called (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr(GTask) task = data;
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (!reply) g_task_return_error (task, g_steal_pointer (&error));
+  else g_task_return_boolean (task, TRUE);
+}
+
+void cc_luma_services_reader_preferences_async (GDBusConnection *connection,
+  GCancellable *cancellable, GAsyncReadyCallback callback, gpointer user_data)
+{
+  g_return_if_fail (G_IS_DBUS_CONNECTION (connection));
+  GTask *task = g_task_new (connection, cancellable, callback, user_data);
+  g_task_set_source_tag (task, cc_luma_services_reader_preferences_async);
+  if (g_task_return_error_if_cancelled (task)) { g_object_unref (task); return; }
+  /* Match cc-ua-seeing-page.c's existing Orca contract. DO_NOT_AUTO_START
+   * keeps owner absence an explicit failure instead of launching an app. */
+  g_dbus_connection_call (connection, "org.gnome.Orca.Service",
+    "/org/gnome/Orca/Service", "org.gnome.Orca.Service", "ShowPreferences",
+    NULL, G_VARIANT_TYPE_UNIT, G_DBUS_CALL_FLAGS_NO_AUTO_START, 5000,
+    cancellable, reader_preferences_called, task);
+}
+
+gboolean cc_luma_services_reader_preferences_finish (GDBusConnection *connection,
+  GAsyncResult *result, GError **error)
+{
+  g_return_val_if_fail (g_task_is_valid (result, connection), FALSE);
+  g_return_val_if_fail (g_async_result_is_tagged (result, cc_luma_services_reader_preferences_async), FALSE);
+  return g_task_propagate_boolean (G_TASK (result), error);
+}
+
 CcLumaProperties *
 cc_luma_services_observe (CcLumaService service, GError **error)
 {
diff --git a/shell/cc-luma-services.h b/shell/cc-luma-services.h
index b27d721..a02154a 100644
--- a/shell/cc-luma-services.h
+++ b/shell/cc-luma-services.h
@@ -13,4 +13,11 @@ typedef enum {
 CcLumaProperties *cc_luma_services_observe (CcLumaService service, GError **error);
 gboolean cc_luma_services_validate (CcLumaService service, GVariant *snapshot,
                                      GError **error);
+/* GNOME 50.4's screen-reader preferences action. The caller supplies its
+ * session connection (a private connection in tests). Never auto-starts Orca;
+ * the async call is cancellable and bounded to five seconds. */
+void cc_luma_services_reader_preferences_async (GDBusConnection *connection,
+  GCancellable *cancellable, GAsyncReadyCallback callback, gpointer user_data);
+gboolean cc_luma_services_reader_preferences_finish (GDBusConnection *connection,
+  GAsyncResult *result, GError **error);
 G_END_DECLS
diff --git a/shell/cc-luma-view-devices.c b/shell/cc-luma-view-devices.c
index 8adee6f..ed2de00 100644
--- a/shell/cc-luma-view-devices.c
+++ b/shell/cc-luma-view-devices.c
@@ -206,3 +206,224 @@ void cc_luma_view_pointer_render (View *v)
     cc_luma_view_row (rows, "Direction", "Natural moves the page with your fingers", segments (v, "tNat", direction));
   }
 }
+
+static View *a11y_view (GtkWidget *control, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  const char *page = g_object_get_data (G_OBJECT (control), "cf-a11y-page");
+  return v && page && g_str_equal (page, v->page) && gtk_widget_is_ancestor (control, root) ? v : NULL;
+}
+static void a11y_control (View *v, GtkWidget *control, const char *key, const char *title)
+{
+  g_autofree char *name = g_strconcat ("cf-", key, NULL);
+  gtk_widget_set_name (control, name);
+  g_object_set_data_full (G_OBJECT (control), "cf-key", g_strdup (key), g_free);
+  g_object_set_data_full (G_OBJECT (control), "cf-a11y-page", g_strdup (v->page), g_free);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (control), GTK_ACCESSIBLE_PROPERTY_LABEL, title, -1);
+}
+static void a11y_flag_changed (GtkSwitch *control, GParamSpec *pspec, GtkWidget *root)
+{
+  View *v = a11y_view (GTK_WIDGET (control), root);
+  if (!v) return;
+  g_autoptr(JsonNode) value = json_node_init_boolean (json_node_alloc (), gtk_switch_get_active (control));
+  g_autoptr(GError) error = NULL;
+  if (cc_luma_a11y_set (v->model, g_object_get_data (G_OBJECT (control), "cf-key"), value, &error))
+    cc_luma_view_queue_refresh (v);
+  else cc_luma_view_report_error (v, error);
+}
+static void a11y_flag (View *v, GtkBox *rows, const char *key, const char *title, const char *hint)
+{
+  GtkWidget *control = gtk_switch_new ();
+  gtk_switch_set_active (GTK_SWITCH (control), cc_luma_view_flag (v, key));
+  gtk_widget_set_valign (control, GTK_ALIGN_CENTER);
+  a11y_control (v, control, key, title);
+  g_signal_connect_object (control, "notify::active", G_CALLBACK (a11y_flag_changed), v->root, 0);
+  cc_luma_view_row (rows, title, hint, control);
+}
+static void a11y_range_changed (GtkRange *control, GtkWidget *root)
+{
+  View *v = a11y_view (GTK_WIDGET (control), root);
+  if (!v) return;
+  const char *key = g_object_get_data (G_OBJECT (control), "cf-key");
+  double number = gtk_range_get_value (control);
+  gboolean fractional = g_str_equal (key, "zoomX");
+  g_autoptr(JsonNode) value = fractional ? json_node_init_double (json_node_alloc (), number) :
+    json_node_init_int (json_node_alloc (), (gint64) number);
+  g_autoptr(GError) error = NULL;
+  if (!cc_luma_a11y_set (v->model, key, value, &error)) { cc_luma_view_report_error (v, error); return; }
+  /* Keep continuous input alive instead of rebuilding its emitting range. */
+  if (fractional) {
+    char buffer[G_ASCII_DTOSTR_BUF_SIZE];
+    g_ascii_dtostr (buffer, sizeof buffer, number);
+    g_autofree char *caption = g_strconcat (buffer, "×", NULL);
+    GtkLabel *label = g_object_get_data (G_OBJECT (control), "cf-a11y-number");
+    gtk_label_set_text (label, caption);
+    gtk_label_set_text (v->subtitle, cc_luma_view_flag (v, "zoom") ? caption : "Off · Super Alt = zooms in");
+  }
+}
+static void a11y_range (View *v, GtkBox *rows, const char *key, const char *title,
+                        const char *low, const char *high, gboolean fractional)
+{
+  GtkWidget *trail = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+  GtkWidget *range = gtk_scale_new_with_range (GTK_ORIENTATION_HORIZONTAL, fractional ? 1 : 0, fractional ? 10 : 100, fractional ? 0.5 : 1);
+  gtk_scale_set_draw_value (GTK_SCALE (range), FALSE);
+  gtk_scale_set_digits (GTK_SCALE (range), fractional ? 1 : 0);
+  gtk_range_set_value (GTK_RANGE (range), json_node_get_double (cc_luma_fixture_get (v->model, key)));
+  gtk_widget_set_size_request (range, 120, -1);
+  a11y_control (v, range, key, title);
+  if (low) gtk_box_append (GTK_BOX (trail), cc_luma_view_label (low, "small", TRUE));
+  gtk_box_append (GTK_BOX (trail), range);
+  if (high) gtk_box_append (GTK_BOX (trail), cc_luma_view_label (high, "small", TRUE));
+  if (fractional) {
+    char buffer[G_ASCII_DTOSTR_BUF_SIZE];
+    g_ascii_dtostr (buffer, sizeof buffer, json_node_get_double (cc_luma_fixture_get (v->model, key)));
+    g_autofree char *caption = g_strconcat (buffer, "×", NULL);
+    GtkWidget *number = cc_luma_view_label (caption, "body", FALSE);
+    gtk_box_append (GTK_BOX (trail), number);
+    g_object_set_data (G_OBJECT (range), "cf-a11y-number", number);
+  }
+  g_signal_connect_object (range, "value-changed", G_CALLBACK (a11y_range_changed), v->root, 0);
+  cc_luma_view_row (rows, title, NULL, trail);
+}
+static void a11y_segment_changed (LumaSegmentedControl *control, const char *selection, GtkWidget *root)
+{
+  View *v = a11y_view (GTK_WIDGET (control), root);
+  if (!v) return;
+  g_autoptr(JsonNode) value = json_node_init_string (json_node_alloc (), selection);
+  g_autoptr(GError) error = NULL;
+  if (cc_luma_a11y_set (v->model, "vAlertHow", value, &error)) cc_luma_view_queue_refresh (v);
+  else cc_luma_view_report_error (v, error);
+}
+static void a11y_reader_options (GtkButton *button, View *v)
+{
+  if (!g_str_equal (v->page, "a-see") || !gtk_widget_is_ancestor (GTK_WIDGET (button), v->root)) return;
+  /* Exact v70 fixture action, without launching an installed reader. The
+   * production route must use org.gnome.Orca.Service.ShowPreferences and
+   * remains unported until the live view is connected to that owner. */
+  luma_toast_show (v->root, "Opens screen reader settings", "opening");
+}
+static void a11y_flash (GtkButton *button, View *v)
+{
+  if (!g_str_equal (v->page, "a-hear") || !cc_luma_view_flag (v, "vAlert") ||
+      !gtk_widget_is_ancestor (GTK_WIDGET (button), v->root)) return;
+  GtkNative *native = gtk_widget_get_native (v->root);
+  GdkSurface *surface = native ? gtk_native_get_surface (native) : NULL;
+  if (surface) gdk_surface_beep (surface);
+  else {
+    g_autoptr(GError) error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "A visual alert needs a visible Settings window");
+    cc_luma_view_report_error (v, error);
+  }
+  /* Native GNOME uses the owning window's bell. Exact fixture cf-main
+   * white-half-opacity/400ms overlay paint still needs public tokens (08);
+   * this action is not claimed as fixture visual parity or live completion. */
+}
+static void a11y_navigate (LumaDetailsItem *item, GtkWidget *root)
+{
+  View *v = a11y_view (GTK_WIDGET (item), root);
+  if (v) cc_luma_view_navigate (v, g_object_get_data (G_OBJECT (item), "cf-target"));
+}
+static void a11y_link (View *v, GtkBox *rows, const char *target, const char *title,
+                       const char *hint, const char *icon, const char *status)
+{
+  GtkWidget *item = luma_details_item_new (title, hint, NULL);
+  luma_details_item_set_lead (LUMA_DETAILS_ITEM (item), luma_ui_icon_new (icon));
+  GtkWidget *trail = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+  if (status) gtk_box_append (GTK_BOX (trail), cc_luma_view_label (status, "body", TRUE));
+  gtk_box_append (GTK_BOX (trail), luma_ui_icon_new ("chevron-right"));
+  luma_details_item_set_trail (LUMA_DETAILS_ITEM (item), trail);
+  g_autofree char *name = g_strconcat ("cf-go-", target, NULL);
+  gtk_widget_set_name (item, name);
+  g_object_set_data_full (G_OBJECT (item), "cf-a11y-page", g_strdup (v->page), g_free);
+  g_object_set_data_full (G_OBJECT (item), "cf-target", g_strdup (target), g_free);
+  g_signal_connect_object (item, "clicked", G_CALLBACK (a11y_navigate), v->root, 0);
+  gtk_box_append (rows, item);
+}
+void cc_luma_view_a11y_render (View *v)
+{
+  GtkBox *rows;
+  if (g_str_equal (v->page, "a11y")) {
+    const char *flags[] = { "hc", "motion", "large", "reader", "osk", "sticky", "slow", "bounce", "mkeys", "zoom", "vAlert" };
+    guint count = 0;
+    for (guint i = 0; i < G_N_ELEMENTS (flags); i++) if (cc_luma_view_flag (v, flags[i])) count++;
+    g_autofree char *meta = count ? g_strdup_printf ("%u turned on", count) : g_strdup ("Nothing turned on");
+    cc_luma_view_header (v, "Accessibility", meta, NULL);
+    rows = cc_luma_view_group (v, NULL);
+    a11y_flag (v, rows, "a11yMenu", "In Quick Options", "Keep these settings one click away");
+    rows = cc_luma_view_group (v, NULL);
+    a11y_link (v, rows, "a-see", "Seeing", "Contrast, text size, motion, screen reader", "eye", NULL);
+    a11y_link (v, rows, "a-hear", "Hearing", "Visual alerts", "volume-2", NULL);
+    a11y_link (v, rows, "a-type", "Typing", "Screen keyboard, repeat keys, typing assist", "keyboard", NULL);
+    a11y_link (v, rows, "a-point", "Pointing and clicking", "Mouse keys, double-click, hover click", "mouse-pointer-2", NULL);
+    a11y_link (v, rows, "a-zoom", "Zoom", "Magnify part of the screen", "zoom-in", cc_luma_view_flag (v, "zoom") ? "On" : "Off");
+  } else if (g_str_equal (v->page, "a-see")) {
+    cc_luma_view_header (v, "Seeing", "Make things easier to see", NULL);
+    rows = cc_luma_view_group (v, NULL);
+    a11y_flag (v, rows, "hc", "High contrast", "Stronger edges and text");
+    a11y_flag (v, rows, "motion", "Less motion", "Fades instead of slides and zooms");
+    a11y_flag (v, rows, "large", "Larger text", NULL);
+    const char * const sizes[] = { "default", "Default", "m", "Medium", "l", "Large", "xl", "Larger", "xxl", "Largest", NULL };
+    cc_luma_view_row (rows, "Pointer size", NULL, cc_luma_view_picker (v, "cursor", sizes));
+    a11y_flag (v, rows, "scrollbars", "Always show scroll bars", NULL);
+    a11y_flag (v, rows, "soundKeys", "Sound for lock keys", "A beep when Caps Lock or Num Lock turns on or off");
+    rows = cc_luma_view_group (v, "Screen reader");
+    a11y_flag (v, rows, "reader", "Screen reader", "Reads out what’s on screen. Super Alt S turns it on or off.");
+    GtkWidget *open = cc_luma_view_command (v, "Open…", G_CALLBACK (a11y_reader_options));
+    gtk_widget_set_name (open, "cf-reader-options");
+    cc_luma_view_row (rows, "Voice and speed", NULL, open);
+  } else if (g_str_equal (v->page, "a-hear")) {
+    cc_luma_view_header (v, "Hearing", "See alerts as well as hear them", NULL);
+    rows = cc_luma_view_group (v, NULL);
+    a11y_flag (v, rows, "vAlert", "Visual alerts", "Flash when the alert sound plays");
+    if (cc_luma_view_flag (v, "vAlert")) {
+      GtkWidget *segments = luma_segmented_control_new ();
+      luma_segmented_control_append (LUMA_SEGMENTED_CONTROL (segments), "window", "The window");
+      luma_segmented_control_append (LUMA_SEGMENTED_CONTROL (segments), "screen", "The whole screen");
+      luma_segmented_control_set_selected (LUMA_SEGMENTED_CONTROL (segments), cc_luma_view_text (v, "vAlertHow"));
+      a11y_control (v, segments, "vAlertHow", "Flash");
+      g_signal_connect_object (segments, "changed", G_CALLBACK (a11y_segment_changed), v->root, 0);
+      cc_luma_view_row (rows, "Flash", NULL, segments);
+      GtkWidget *flash = cc_luma_view_command (v, "Flash", G_CALLBACK (a11y_flash));
+      gtk_widget_set_name (flash, "cf-flash");
+      cc_luma_view_row (rows, "Try it", NULL, flash);
+    }
+    a11y_flag (v, rows, "overamp", "Over-amplification", "Lets the volume go past 100%");
+  } else if (g_str_equal (v->page, "a-type")) {
+    cc_luma_view_header (v, "Typing", "Keyboard help", NULL);
+    rows = cc_luma_view_group (v, NULL);
+    a11y_flag (v, rows, "osk", "Screen keyboard", "Appears when you tap a text field");
+    rows = cc_luma_view_group (v, "Repeat keys");
+    a11y_flag (v, rows, "rep", "Repeat when held", NULL);
+    if (cc_luma_view_flag (v, "rep")) {
+      a11y_range (v, rows, "repDelay", "Delay", "Short", "Long", FALSE);
+      a11y_range (v, rows, "repSpeed", "Speed", "Slow", "Fast", FALSE);
+    }
+    rows = cc_luma_view_group (v, "Text cursor");
+    a11y_flag (v, rows, "blink", "Blinking", NULL);
+    if (cc_luma_view_flag (v, "blink")) a11y_range (v, rows, "blinkS", "Speed", "Slow", "Fast", FALSE);
+    rows = cc_luma_view_group (v, "Typing assist");
+    a11y_flag (v, rows, "sticky", "Sticky keys", "Press Ctrl, then C, instead of both at once");
+    a11y_flag (v, rows, "slow", "Slow keys", "A key has to be held a moment to count");
+    a11y_flag (v, rows, "bounce", "Bounce keys", "Ignores quick repeats of the same key");
+    a11y_flag (v, rows, "kbdA11y", "Turn these on from the keyboard", "Press Shift five times");
+  } else if (g_str_equal (v->page, "a-point")) {
+    cc_luma_view_header (v, "Pointing and clicking", "Mouse and click help", NULL);
+    rows = cc_luma_view_group (v, NULL);
+    a11y_flag (v, rows, "mkeys", "Mouse keys", "Move the pointer with the number pad");
+    a11y_flag (v, rows, "locate", "Find the pointer", "Press Ctrl to show where it is");
+    a11y_range (v, rows, "dbl", "Double-click speed", "Slow", "Fast", FALSE);
+    rows = cc_luma_view_group (v, "Click assist");
+    a11y_flag (v, rows, "hold", "Hold to right click", "Press and hold the main button");
+    a11y_flag (v, rows, "hover", "Hover click", "Clicks when the pointer rests");
+  } else if (g_str_equal (v->page, "a-zoom")) {
+    char buffer[G_ASCII_DTOSTR_BUF_SIZE];
+    g_ascii_dtostr (buffer, sizeof buffer, json_node_get_double (cc_luma_fixture_get (v->model, "zoomX")));
+    g_autofree char *meta = cc_luma_view_flag (v, "zoom") ? g_strconcat (buffer, "×", NULL) : g_strdup ("Off · Super Alt = zooms in");
+    cc_luma_view_header (v, "Zoom", meta, "zoom");
+    rows = cc_luma_view_group (v, NULL);
+    a11y_range (v, rows, "zoomX", "Magnification", NULL, NULL, TRUE);
+    const char * const following[] = { "push", "Push the view along", "center", "Keep it centred", "prop", "Move in proportion", NULL };
+    cc_luma_view_row (rows, "Follow the pointer", NULL, cc_luma_view_picker (v, "zoomF", following));
+    a11y_flag (v, rows, "cross", "Crosshairs", NULL);
+    a11y_flag (v, rows, "invert", "Invert colours", NULL);
+  }
+}
