+typedef struct { guint completed; gboolean success; GError *error; } ReaderSeen;
+static guint reader_calls;
+static gboolean reader_hold;
+static gboolean reader_error;
+static GDBusMethodInvocation *reader_pending;
+static void reader_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  ReaderSeen *seen = data;
+  seen->success = cc_luma_services_reader_preferences_finish (G_DBUS_CONNECTION (source), result, &seen->error);
+  seen->completed++;
+}
+static void reader_method (GDBusConnection *connection, const char *sender,
+  const char *path, const char *interface, const char *method,
+  GVariant *parameters, GDBusMethodInvocation *invocation, gpointer data)
+{
+  g_assert_cmpstr (method, ==, "ShowPreferences");
+  g_assert_cmpstr (path, ==, "/org/gnome/Orca/Service");
+  g_assert_cmpstr (interface, ==, "org.gnome.Orca.Service");
+  g_assert_true (g_variant_is_of_type (parameters, G_VARIANT_TYPE_UNIT));
+  reader_calls++;
+  if (reader_error) {
+    g_dbus_method_invocation_return_dbus_error (invocation, "org.gnome.Orca.Service.Error", "Private reader refused preferences");
+    return;
+  }
+  if (reader_hold) { g_assert_null (reader_pending); reader_pending = g_object_ref (invocation); }
+  else g_dbus_method_invocation_return_value (invocation, NULL);
+}
+static void reader_name (const char *method)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GVariant) reply = g_dbus_connection_call_sync (service,
+    "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", method,
+    g_str_equal (method, "RequestName") ? g_variant_new ("(su)", "org.gnome.Orca.Service", 0u) :
+      g_variant_new ("(s)", "org.gnome.Orca.Service"),
+    G_VARIANT_TYPE ("(u)"), G_DBUS_CALL_FLAGS_NONE, 5000, NULL, &error);
+  g_assert_no_error (error); g_assert_nonnull (reply);
+  guint code; g_variant_get (reply, "(u)", &code); g_assert_cmpuint (code, ==, 1);
+}
+static void reader_preferences (void)
+{
+  /* This name exists exclusively on GTestDBus. No installed reader or user
+   * session bus is contacted, including the absent-owner case. */
+  const char *xml = "<node><interface name='org.gnome.Orca.Service'><method name='ShowPreferences'/></interface></node>";
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GDBusNodeInfo) info = g_dbus_node_info_new_for_xml (xml, &error);
+  g_assert_no_error (error);
+  const GDBusInterfaceVTable vtable = { .method_call = reader_method };
+  guint registered = g_dbus_connection_register_object (service,
+    "/org/gnome/Orca/Service", info->interfaces[0], &vtable, NULL, NULL, &error);
+  g_assert_no_error (error); g_assert_cmpuint (registered, >, 0);
+  reader_name ("RequestName");
+  ReaderSeen seen = { 0 };
+  cc_luma_services_reader_preferences_async (service, NULL, reader_done, &seen);
+  g_assert_cmpuint (seen.completed, ==, 0);
+  until (&seen.completed, 1); g_assert_true (seen.success); g_assert_no_error (seen.error);
+  g_assert_cmpuint (reader_calls, ==, 1);
+  g_autoptr(GCancellable) cancel = g_cancellable_new ();
+  g_cancellable_cancel (cancel); seen = (ReaderSeen) { 0 };
+  cc_luma_services_reader_preferences_async (service, cancel, reader_done, &seen);
+  until (&seen.completed, 1); g_assert_false (seen.success);
+  g_assert_error (seen.error, G_IO_ERROR, G_IO_ERROR_CANCELLED); g_clear_error (&seen.error);
+  g_assert_cmpuint (reader_calls, ==, 1);
+  g_cancellable_reset (cancel); reader_hold = TRUE; seen = (ReaderSeen) { 0 };
+  cc_luma_services_reader_preferences_async (service, cancel, reader_done, &seen);
+  until (&reader_calls, 2); g_assert_nonnull (reader_pending);
+  g_cancellable_cancel (cancel); until (&seen.completed, 1);
+  g_assert_false (seen.success); g_assert_error (seen.error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+  g_clear_error (&seen.error);
+  g_dbus_method_invocation_return_value (reader_pending, NULL); g_clear_object (&reader_pending);
+  spin (100); g_assert_cmpuint (seen.completed, ==, 1); reader_hold = FALSE;
+  /* An owner that never replies must also finish. Keep this assertion
+   * independent of cancellation so the native five-second bound is tested. */
+  reader_hold = TRUE; seen = (ReaderSeen) { 0 };
+  gint64 started = g_get_monotonic_time ();
+  cc_luma_services_reader_preferences_async (service, NULL, reader_done, &seen);
+  until (&reader_calls, 3); g_assert_nonnull (reader_pending);
+  while (!seen.completed && g_get_monotonic_time () - started < 7000000) spin (1);
+  g_assert_cmpuint (seen.completed, ==, 1); g_assert_false (seen.success);
+  g_assert_error (seen.error, G_IO_ERROR, G_IO_ERROR_TIMED_OUT); g_clear_error (&seen.error);
+  g_assert_cmpint (g_get_monotonic_time () - started, <, 7000000);
+  g_dbus_method_invocation_return_value (reader_pending, NULL); g_clear_object (&reader_pending);
+  spin (100); g_assert_cmpuint (seen.completed, ==, 1); reader_hold = FALSE;
+  reader_error = TRUE; seen = (ReaderSeen) { 0 };
+  cc_luma_services_reader_preferences_async (service, NULL, reader_done, &seen);
+  until (&seen.completed, 1); g_assert_false (seen.success); g_assert_nonnull (seen.error);
+  g_assert_true (g_dbus_error_is_remote_error (seen.error));
+  g_autofree char *remote = g_dbus_error_get_remote_error (seen.error);
+  g_assert_cmpstr (remote, ==, "org.gnome.Orca.Service.Error");
+  g_assert_nonnull (strstr (seen.error->message, "Private reader refused preferences"));
+  g_clear_error (&seen.error); reader_error = FALSE;
+  reader_name ("ReleaseName"); seen = (ReaderSeen) { 0 };
+  cc_luma_services_reader_preferences_async (service, NULL, reader_done, &seen);
+  until (&seen.completed, 1); g_assert_false (seen.success); g_assert_nonnull (seen.error);
+  g_assert_true (g_error_matches (seen.error, G_DBUS_ERROR, G_DBUS_ERROR_NAME_HAS_NO_OWNER) ||
+    g_error_matches (seen.error, G_DBUS_ERROR, G_DBUS_ERROR_SERVICE_UNKNOWN));
+  g_clear_error (&seen.error); g_assert_cmpuint (reader_calls, ==, 4);
+  g_assert_true (g_dbus_connection_unregister_object (service, registered));
+}
+
 int main (int argc, char **argv)
 {
   g_test_init (&argc, &argv, NULL);
@@ -174,6 +274,7 @@ int main (int argc, char **argv)
