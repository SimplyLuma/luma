diff --git a/shell/cc-luma-device-options.c b/shell/cc-luma-device-options.c
index d0b36ac..e1e2b40 100644
--- a/shell/cc-luma-device-options.c
+++ b/shell/cc-luma-device-options.c
@@ -1,6 +1,7 @@
 /* SPDX-License-Identifier: GPL-2.0-or-later */
 #include "cc-luma-device-options.h"
 #include <gio/gio.h>
+#include <math.h>
 
 typedef struct { const char *key; GType type; gint64 low, high; const char *choices[10]; } Field;
 /* Catalogues are the actual v70 control values. No battery, device or service
@@ -27,8 +28,41 @@ static const Field pointer[] = {
   { "tSec", G_TYPE_STRING, 0, 0, { "two", "corner", NULL } },
   { "tScroll", G_TYPE_STRING, 0, 0, { "two", "edge", NULL } },
 };
+static const Field accessibility[] = {
+  { .key = "a11yMenu", .type = G_TYPE_BOOLEAN },
+  { .key = "hc", .type = G_TYPE_BOOLEAN }, { .key = "motion", .type = G_TYPE_BOOLEAN },
+  { .key = "large", .type = G_TYPE_BOOLEAN }, { .key = "soundKeys", .type = G_TYPE_BOOLEAN },
+  { .key = "scrollbars", .type = G_TYPE_BOOLEAN }, { .key = "reader", .type = G_TYPE_BOOLEAN },
+  { .key = "vAlert", .type = G_TYPE_BOOLEAN }, { .key = "overamp", .type = G_TYPE_BOOLEAN },
+  { .key = "osk", .type = G_TYPE_BOOLEAN }, { .key = "rep", .type = G_TYPE_BOOLEAN },
+  { .key = "blink", .type = G_TYPE_BOOLEAN }, { .key = "sticky", .type = G_TYPE_BOOLEAN },
+  { .key = "slow", .type = G_TYPE_BOOLEAN }, { .key = "bounce", .type = G_TYPE_BOOLEAN },
+  { .key = "kbdA11y", .type = G_TYPE_BOOLEAN }, { .key = "mkeys", .type = G_TYPE_BOOLEAN },
+  { .key = "locate", .type = G_TYPE_BOOLEAN }, { .key = "hold", .type = G_TYPE_BOOLEAN },
+  { .key = "hover", .type = G_TYPE_BOOLEAN }, { .key = "zoom", .type = G_TYPE_BOOLEAN },
+  { .key = "cross", .type = G_TYPE_BOOLEAN }, { .key = "invert", .type = G_TYPE_BOOLEAN },
+  { "cursor", G_TYPE_STRING, 0, 0, { "default", "m", "l", "xl", "xxl", NULL } },
+  { "vAlertHow", G_TYPE_STRING, 0, 0, { "window", "screen", NULL } },
+  { "zoomF", G_TYPE_STRING, 0, 0, { "push", "center", "prop", NULL } },
+  { .key = "repDelay", .type = G_TYPE_INT64, .low = 0, .high = 100 },
+  { .key = "repSpeed", .type = G_TYPE_INT64, .low = 0, .high = 100 },
+  { .key = "blinkS", .type = G_TYPE_INT64, .low = 0, .high = 100 },
+  { .key = "dbl", .type = G_TYPE_INT64, .low = 0, .high = 100 },
+  { .key = "zoomX", .type = G_TYPE_DOUBLE, .low = 1, .high = 10 },
+};
 static gboolean allowed (const Field *field, JsonNode *value)
 {
+  /* Zoom is the sole fractional control in these v70 field catalogs. JSON
+   * may represent its initial 2 as an integer; subsequent half steps remain
+   * valid numeric values without relaxing other fields' exact types. */
+  if (field->type == G_TYPE_DOUBLE) {
+    if (!value || !JSON_NODE_HOLDS_VALUE (value)) return FALSE;
+    GType type = json_node_get_value_type (value);
+    if (type != G_TYPE_INT64 && type != G_TYPE_DOUBLE) return FALSE;
+    double number = json_node_get_double (value);
+    if (!isfinite (number) || number < field->low || number > field->high) return FALSE;
+    return number * 2 == (gint64) (number * 2);
+  }
   if (!value || json_node_get_value_type (value) != field->type) return FALSE;
   if (field->type == G_TYPE_BOOLEAN) return TRUE;
   if (field->type == G_TYPE_INT64)
@@ -48,8 +82,11 @@ static gboolean set (CcLumaFixture *model, const Field *fields, guint length,
 {
   if (key && validate (model, fields, length))
     for (guint i = 0; i < length; i++)
-      if (g_str_equal (key, fields[i].key) && allowed (&fields[i], value))
+      if (g_str_equal (key, fields[i].key) && allowed (&fields[i], value)) {
+        if (fields[i].type == G_TYPE_DOUBLE)
+          return cc_luma_fixture_set_number (model, key, json_node_get_double (value), error);
         return cc_luma_fixture_set (model, key, value, error);
+      }
   g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid Settings device preference");
   return FALSE;
 }
@@ -97,3 +134,5 @@ gboolean cc_luma_power_fixture_validate (CcLumaFixture *model)
 gboolean cc_luma_power_set (CcLumaFixture *model, const char *key, JsonNode *value, GError **error) { return set (model, power, G_N_ELEMENTS (power), key, value, error); }
 gboolean cc_luma_pointer_validate (CcLumaFixture *model) { return validate (model, pointer, G_N_ELEMENTS (pointer)); }
 gboolean cc_luma_pointer_set (CcLumaFixture *model, const char *key, JsonNode *value, GError **error) { return set (model, pointer, G_N_ELEMENTS (pointer), key, value, error); }
+gboolean cc_luma_a11y_validate (CcLumaFixture *model) { return validate (model, accessibility, G_N_ELEMENTS (accessibility)); }
+gboolean cc_luma_a11y_set (CcLumaFixture *model, const char *key, JsonNode *value, GError **error) { return set (model, accessibility, G_N_ELEMENTS (accessibility), key, value, error); }
