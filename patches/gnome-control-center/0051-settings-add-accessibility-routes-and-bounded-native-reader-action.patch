+    { "org.gnome.desktop.a11y",
+      { "always-show-universal-access-status", NULL }, { "b", NULL } },
+    { "org.gnome.desktop.a11y.interface",
+      { "high-contrast", "reduced-motion", NULL }, { "b", "s", NULL } },
+    { "org.gnome.desktop.interface",
+      { "cursor-blink", "cursor-blink-time", "locate-pointer", "cursor-size", "overlay-scrolling", "text-scaling-factor", NULL },
+      { "b", "i|u", "b", "i", "b", "d", NULL } },
+    { "org.gnome.desktop.a11y.applications",
+      { "screen-reader-enabled", "screen-keyboard-enabled", "screen-magnifier-enabled", NULL },
+      { "b", "b", "b", NULL } },
+    { "org.gnome.desktop.a11y.keyboard",
+      { "togglekeys-enable", "enable", "stickykeys-enable", "slowkeys-enable", "bouncekeys-enable", "mousekeys-enable", NULL },
+      { "b", "b", "b", "b", "b", "b", NULL } },
+    { "org.gnome.desktop.a11y.mouse",
+      { "secondary-click-enabled", "dwell-click-enabled", NULL }, { "b", "b", NULL } },
+    { "org.gnome.desktop.wm.preferences",
+      { "visual-bell", "visual-bell-type", NULL }, { "b", "s", NULL } },
+    { "org.gnome.desktop.sound",
+      { "allow-volume-above-100-percent", NULL }, { "b", NULL } },
+    { "org.gnome.desktop.a11y.magnifier",
+      { "mag-factor", "mouse-tracking", "show-cross-hairs", "invert-lightness", NULL },
+      { "d", "s", "b", "b", NULL } },
+    { "org.gnome.desktop.peripherals.keyboard",
+      { "repeat", "delay", "repeat-interval", NULL }, { "b", "i|u", "i|u", NULL } },
   };
   G_STATIC_ASSERT (G_N_ELEMENTS (native) == CC_LUMA_PREFS_COUNT);
   if ((guint) set >= G_N_ELEMENTS (native)) {
@@ -142,7 +169,16 @@ CcLumaPreferences *cc_luma_preferences_new_native (CcLumaPreferenceSet set, GErr
   g_object_get (self->settings, "settings-schema", &schema, NULL);
   for (guint i = 0; native[set].keys[i]; i++) {
     g_autoptr(GSettingsSchemaKey) key = g_settings_schema_get_key (schema, native[set].keys[i]);
-    if (!g_variant_type_equal (g_settings_schema_key_get_value_type (key), G_VARIANT_TYPE (native[set].types[i]))) {
+    const GVariantType *actual = g_settings_schema_key_get_value_type (key);
+    const char *expected = native[set].types[i];
+    /* The installed upstream inverted timing mapping deliberately accepts
+     * either signed or unsigned 32-bit milliseconds. Keep that exact
+     * numeric contract while retaining the original immutable native value. */
+    gboolean matches = g_str_equal (expected, "i|u") ?
+      g_variant_type_equal (actual, G_VARIANT_TYPE_INT32) ||
+      g_variant_type_equal (actual, G_VARIANT_TYPE_UINT32) :
+      g_variant_type_equal (actual, G_VARIANT_TYPE (expected));
+    if (!matches) {
       g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Unexpected native Settings key type: %s", native[set].keys[i]);
       return NULL;
     }
