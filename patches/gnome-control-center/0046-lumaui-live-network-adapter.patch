+++ b/shell/cc-luma-network.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <gio/gio.h>
+#include <json-glib/json-glib.h>
+G_BEGIN_DECLS
+#define CC_TYPE_LUMA_NETWORK (cc_luma_network_get_type ())
+G_DECLARE_FINAL_TYPE (CcLumaNetwork, cc_luma_network, CC, LUMA_NETWORK, GObject)
+/* Live, read-only NetworkManager adapter. Never constructed by fixture views.
+ * ::changed supplies a new snapshot, ::failed a service error. start() returns
+ * immediately; stop() invalidates every pending callback. No secrets are read. */
+CcLumaNetwork *cc_luma_network_new (void);
+void cc_luma_network_start (CcLumaNetwork *self);
+void cc_luma_network_stop (CcLumaNetwork *self);
+JsonObject *cc_luma_network_dup_snapshot (CcLumaNetwork *self);
+G_END_DECLS
