diff --git a/shell/cc-luma-network.c b/shell/cc-luma-network.c
new file mode 100644
index 0000000..d3993b2
--- /dev/null
+++ b/shell/cc-luma-network.c
@@ -0,0 +1,198 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-network.h"
+#include <NetworkManager.h>
+
+struct _CcLumaNetwork {
+  GObject parent_instance;
+  NMClient *client;
+  GCancellable *cancel;
+  JsonObject *snapshot;
+  GHashTable *watched;
+  guint refresh;
+  guint64 generation;
+};
+G_DEFINE_TYPE (CcLumaNetwork, cc_luma_network, G_TYPE_OBJECT)
+enum { CHANGED, FAILED, N_SIGNALS };
+static guint signals[N_SIGNALS];
+typedef struct { GWeakRef self; guint64 generation; } Load;
+static void load_free (Load *load) { g_weak_ref_clear (&load->self); g_free (load); }
+static void queue_snapshot (CcLumaNetwork *self);
+static void property_changed (GObject *object, GParamSpec *pspec, CcLumaNetwork *self) { queue_snapshot (self); }
+static void watch (CcLumaNetwork *self, GObject *object)
+{
+  if (!object || g_hash_table_contains (self->watched, object)) return;
+  g_hash_table_add (self->watched, g_object_ref (object));
+  g_signal_connect_object (object, "notify", G_CALLBACK (property_changed), self, 0);
+}
+static void unwatch (CcLumaNetwork *self)
+{
+  GHashTableIter iter; gpointer object;
+  g_hash_table_iter_init (&iter, self->watched);
+  while (g_hash_table_iter_next (&iter, &object, NULL)) g_signal_handlers_disconnect_by_data (object, self);
+  g_hash_table_remove_all (self->watched);
+}
+static void add_addresses (JsonObject *device, const char *key, NMIPConfig *config)
+{
+  JsonArray *addresses = json_array_new ();
+  const GPtrArray *items = config ? nm_ip_config_get_addresses (config) : NULL;
+  for (guint i = 0; items && i < items->len; i++)
+    {
+      NMIPAddress *address = g_ptr_array_index (items, i);
+      JsonObject *entry = json_object_new ();
+      json_object_set_string_member (entry, "address", nm_ip_address_get_address (address));
+      json_object_set_int_member (entry, "prefix", nm_ip_address_get_prefix (address));
+      json_array_add_object_element (addresses, entry);
+    }
+  json_object_set_array_member (device, key, addresses);
+}
+static gboolean refresh_snapshot (gpointer data)
+{
+  CcLumaNetwork *self = data;
+  self->refresh = 0;
+  if (!self->client) return G_SOURCE_REMOVE;
+  if (!nm_client_get_nm_running (self->client))
+    {
+      g_clear_pointer (&self->snapshot, json_object_unref);
+      g_autoptr (GError) error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED, "NetworkManager is not running");
+      g_signal_emit (self, signals[FAILED], 0, error);
+      return G_SOURCE_REMOVE;
+    }
+  unwatch (self); watch (self, G_OBJECT (self->client));
+  JsonObject *snapshot = json_object_new ();
+  json_object_set_boolean_member (snapshot, "wifi", nm_client_wireless_get_enabled (self->client));
+  json_object_set_boolean_member (snapshot, "wifi-hardware", nm_client_wireless_hardware_get_enabled (self->client));
+  json_object_set_int_member (snapshot, "connectivity", nm_client_get_connectivity (self->client));
+  JsonArray *devices = json_array_new (), *saved = json_array_new ();
+  const GPtrArray *items = nm_client_get_devices (self->client);
+  for (guint i = 0; i < items->len; i++)
+    {
+      NMDevice *device = g_ptr_array_index (items, i);
+      if (!NM_IS_DEVICE_WIFI (device) && !NM_IS_DEVICE_ETHERNET (device)) continue;
+      watch (self, G_OBJECT (device));
+      NMIPConfig *ip4 = nm_device_get_ip4_config (device), *ip6 = nm_device_get_ip6_config (device);
+      watch (self, G_OBJECT (ip4)); watch (self, G_OBJECT (ip6));
+      JsonObject *entry = json_object_new ();
+      json_object_set_string_member (entry, "path", nm_object_get_path (NM_OBJECT (device)));
+      json_object_set_string_member (entry, "interface", nm_device_get_iface (device));
+      json_object_set_string_member (entry, "kind", NM_IS_DEVICE_WIFI (device) ? "wifi" : "ethernet");
+      json_object_set_int_member (entry, "state", nm_device_get_state (device));
+      add_addresses (entry, "ipv4", ip4); add_addresses (entry, "ipv6", ip6);
+      JsonArray *aps = json_array_new ();
+      if (NM_IS_DEVICE_WIFI (device))
+        {
+          NMAccessPoint *active = nm_device_wifi_get_active_access_point (NM_DEVICE_WIFI (device));
+          const GPtrArray *points = nm_device_wifi_get_access_points (NM_DEVICE_WIFI (device));
+          for (guint j = 0; j < points->len; j++)
+            {
+              NMAccessPoint *ap = g_ptr_array_index (points, j);
+              watch (self, G_OBJECT (ap));
+              GBytes *ssid = nm_access_point_get_ssid (ap);
+              if (!ssid || !g_bytes_get_size (ssid)) continue;
+              gsize size; const guint8 *bytes = g_bytes_get_data (ssid, &size);
+              g_autofree char *name = nm_utils_ssid_to_utf8 (bytes, size);
+              g_autofree char *raw = g_base64_encode (bytes, size);
+              JsonObject *point = json_object_new ();
+              /* Paths/raw bytes identify a network; display labels never do. */
+              json_object_set_string_member (point, "path", nm_object_get_path (NM_OBJECT (ap)));
+              json_object_set_string_member (point, "ssid", raw);
+              json_object_set_string_member (point, "name", name ? name : "");
+              json_object_set_int_member (point, "strength", nm_access_point_get_strength (ap));
+              json_object_set_boolean_member (point, "connected", ap == active);
+              json_object_set_boolean_member (point, "locked", nm_access_point_get_flags (ap) & NM_802_11_AP_FLAGS_PRIVACY || nm_access_point_get_wpa_flags (ap) || nm_access_point_get_rsn_flags (ap));
+              json_array_add_object_element (aps, point);
+            }
+        }
+      json_object_set_array_member (entry, "access-points", aps);
+      json_array_add_object_element (devices, entry);
+    }
+  items = nm_client_get_connections (self->client);
+  for (guint i = 0; i < items->len; i++)
+    {
+      NMRemoteConnection *remote = g_ptr_array_index (items, i);
+      watch (self, G_OBJECT (remote));
+      NMSettingWireless *wireless = nm_connection_get_setting_wireless (NM_CONNECTION (remote));
+      GBytes *ssid = wireless ? nm_setting_wireless_get_ssid (wireless) : NULL;
+      if (!ssid) continue;
+      gsize size; const guint8 *bytes = g_bytes_get_data (ssid, &size);
+      g_autofree char *raw = g_base64_encode (bytes, size);
+      g_autofree char *name = nm_utils_ssid_to_utf8 (bytes, size);
+      JsonObject *entry = json_object_new ();
+      json_object_set_string_member (entry, "uuid", nm_connection_get_uuid (NM_CONNECTION (remote)));
+      json_object_set_string_member (entry, "ssid", raw);
+      json_object_set_string_member (entry, "name", name ? name : "");
+      NMSettingConnection *setting = nm_connection_get_setting_connection (NM_CONNECTION (remote));
+      json_object_set_boolean_member (entry, "autoconnect", nm_setting_connection_get_autoconnect (setting));
+      json_object_set_int_member (entry, "metered", nm_setting_connection_get_metered (setting));
+      json_array_add_object_element (saved, entry);
+    }
+  json_object_set_array_member (snapshot, "devices", devices);
+  json_object_set_array_member (snapshot, "saved", saved);
+  g_clear_pointer (&self->snapshot, json_object_unref); self->snapshot = snapshot;
+  g_signal_emit (self, signals[CHANGED], 0);
+  return G_SOURCE_REMOVE;
+}
+static void queue_snapshot (CcLumaNetwork *self)
+{
+  if (!self->refresh) self->refresh = g_idle_add (refresh_snapshot, self);
+}
+static void client_loaded (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Load *load = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (NMClient) client = nm_client_new_finish (result, &error);
+  g_autoptr (CcLumaNetwork) self = g_weak_ref_get (&load->self);
+  guint64 generation = load->generation; load_free (load);
+  if (!self || generation != self->generation) return;
+  if (!client) { g_signal_emit (self, signals[FAILED], 0, error); return; }
+  self->client = g_steal_pointer (&client);
+  watch (self, G_OBJECT (self->client)); queue_snapshot (self);
+}
+void cc_luma_network_stop (CcLumaNetwork *self)
+{
+  self->generation++;
+  if (self->cancel) g_cancellable_cancel (self->cancel);
+  g_clear_object (&self->cancel);
+  if (self->refresh) { g_source_remove (self->refresh); self->refresh = 0; }
+  unwatch (self); g_clear_object (&self->client);
+  g_clear_pointer (&self->snapshot, json_object_unref);
+}
+void cc_luma_network_start (CcLumaNetwork *self)
+{
+  cc_luma_network_stop (self);
+  self->cancel = g_cancellable_new ();
+  Load *load = g_new0 (Load, 1);
+  g_weak_ref_init (&load->self, self); load->generation = self->generation;
+  nm_client_new_async (self->cancel, client_loaded, load);
+}
+JsonObject *cc_luma_network_dup_snapshot (CcLumaNetwork *self)
+{
+  if (!self->snapshot) return NULL;
+  g_autoptr (JsonNode) node = json_node_init_object (json_node_alloc (), self->snapshot);
+  g_autoptr (JsonNode) copy = json_node_copy (node);
+  /* JSON-GLib node copies share objects; clone through the serialized value. */
+  g_autofree char *text = json_to_string (copy, FALSE);
+  g_autoptr (JsonParser) parser = json_parser_new ();
+  if (!json_parser_load_from_data (parser, text, -1, NULL)) return NULL;
+  return json_object_ref (json_node_get_object (json_parser_get_root (parser)));
+}
+static void dispose (GObject *object)
+{
+  cc_luma_network_stop (CC_LUMA_NETWORK (object));
+  G_OBJECT_CLASS (cc_luma_network_parent_class)->dispose (object);
+}
+static void finalize (GObject *object)
+{
+  g_hash_table_unref (CC_LUMA_NETWORK (object)->watched);
+  G_OBJECT_CLASS (cc_luma_network_parent_class)->finalize (object);
+}
+static void cc_luma_network_class_init (CcLumaNetworkClass *klass)
+{
+  G_OBJECT_CLASS (klass)->dispose = dispose; G_OBJECT_CLASS (klass)->finalize = finalize;
+  signals[CHANGED] = g_signal_new ("changed", G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL, G_TYPE_NONE, 0);
+  signals[FAILED] = g_signal_new ("failed", G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL, G_TYPE_NONE, 1, G_TYPE_ERROR);
+}
+static void cc_luma_network_init (CcLumaNetwork *self)
+{
+  self->watched = g_hash_table_new_full (g_direct_hash, g_direct_equal, g_object_unref, NULL);
+}
+CcLumaNetwork *cc_luma_network_new (void) { return g_object_new (CC_TYPE_LUMA_NETWORK, NULL); }
diff --git a/shell/cc-luma-network.h b/shell/cc-luma-network.h
new file mode 100644
index 0000000..9efe9d9
