diff --git a/shell/test-luma-network.c b/shell/test-luma-network.c
new file mode 100644
index 0000000..2d07ac6
--- /dev/null
+++ b/shell/test-luma-network.c
@@ -0,0 +1,149 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-network.h"
+
+typedef struct { guint changed, failed; GError *error; } Seen;
+static void changed (CcLumaNetwork *self, Seen *seen) { seen->changed++; }
+static void failed (CcLumaNetwork *self, GError *error, Seen *seen)
+{
+  seen->failed++; g_clear_error (&seen->error); seen->error = g_error_copy (error);
+}
+static void spin (guint ms)
+{
+  gint64 end = g_get_monotonic_time () + ms * 1000;
+  do { while (g_main_context_iteration (NULL, FALSE)) {} g_usleep (1000); }
+  while (g_get_monotonic_time () < end);
+}
+static void unavailable (void)
+{
+  g_autoptr (CcLumaNetwork) network = cc_luma_network_new ();
+  Seen seen = { 0 };
+  g_signal_connect (network, "changed", G_CALLBACK (changed), &seen);
+  g_signal_connect (network, "failed", G_CALLBACK (failed), &seen);
+  gint64 began = g_get_monotonic_time ();
+  cc_luma_network_start (network);
+  g_assert_cmpint (g_get_monotonic_time () - began, <, 100000);
+  g_assert_cmpuint (seen.failed, ==, 0);
+  g_assert_null (cc_luma_network_dup_snapshot (network));
+  gint64 deadline = began + 5000000;
+  while (!seen.failed && g_get_monotonic_time () < deadline) spin (1);
+  g_assert_cmpuint (seen.failed, ==, 1);
+  g_assert_cmpuint (seen.changed, ==, 0);
+  g_assert_error (seen.error, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED);
+  g_assert_null (cc_luma_network_dup_snapshot (network));
+  g_clear_error (&seen.error);
+}
+static void cancel_and_destroy (void)
+{
+  CcLumaNetwork *network = cc_luma_network_new ();
+  Seen seen = { 0 };
+  g_signal_connect (network, "changed", G_CALLBACK (changed), &seen);
+  g_signal_connect (network, "failed", G_CALLBACK (failed), &seen);
+  cc_luma_network_start (network);
+  cc_luma_network_stop (network);
+  spin (100);
+  g_assert_cmpuint (seen.changed + seen.failed, ==, 0);
+  cc_luma_network_start (network);
+  g_object_unref (network); spin (100);
+  g_assert_cmpuint (seen.changed + seen.failed, ==, 0);
+}
+static void generation (void)
+{
+  g_autoptr (CcLumaNetwork) network = cc_luma_network_new ();
+  Seen seen = { 0 };
+  g_signal_connect (network, "failed", G_CALLBACK (failed), &seen);
+  cc_luma_network_start (network); cc_luma_network_start (network);
+  gint64 deadline = g_get_monotonic_time () + 5000000;
+  while (!seen.failed && g_get_monotonic_time () < deadline) spin (1);
+  spin (100);
+  g_assert_cmpuint (seen.failed, ==, 1);
+  g_assert_error (seen.error, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED);
+  g_clear_error (&seen.error);
+}
+static GVariant *call (GDBusConnection *bus, const char *method, GVariant *args)
+{
+  g_autoptr (GError) error = NULL;
+  GVariant *result = g_dbus_connection_call_sync (bus, "org.freedesktop.NetworkManager",
+    "/org/freedesktop/NetworkManager", "org.freedesktop.NetworkManager.LibnmGlibTest",
+    method, args, NULL, G_DBUS_CALL_FLAGS_NONE, 5000, NULL, &error);
+  g_assert_no_error (error); g_assert_nonnull (result); return result;
+}
+static JsonObject *wait_snapshot (CcLumaNetwork *network, guint devices, guint aps)
+{
+  gint64 deadline = g_get_monotonic_time () + 5000000;
+  do {
+    JsonObject *snapshot = cc_luma_network_dup_snapshot (network);
+    if (snapshot) {
+      JsonArray *list = json_object_get_array_member (snapshot, "devices");
+      if (json_array_get_length (list) == devices && (!devices ||
+          json_array_get_length (json_object_get_array_member (json_array_get_object_element (list, 0), "access-points")) == aps)) return snapshot;
+      json_object_unref (snapshot);
+    }
+    spin (1);
+  } while (g_get_monotonic_time () < deadline);
+  g_error ("Live NetworkManager snapshot did not reach %u devices and %u APs", devices, aps);
+  return NULL;
+}
+static void service_snapshot (void)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GSubprocess) service = g_subprocess_new (G_SUBPROCESS_FLAGS_STDIN_PIPE, &error,
+    "python3", TEST_NM_SERVICE, NULL);
+  g_assert_no_error (error);
+  g_autoptr (GDBusConnection) bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, &error);
+  g_assert_no_error (error);
+  gboolean owner = FALSE;
+  gint64 deadline = g_get_monotonic_time () + 5000000;
+  while (!owner && g_get_monotonic_time () < deadline) {
+    g_autoptr (GVariant) result = g_dbus_connection_call_sync (bus, "org.freedesktop.DBus",
+      "/org/freedesktop/DBus", "org.freedesktop.DBus", "NameHasOwner",
+      g_variant_new ("(s)", "org.freedesktop.NetworkManager"), G_VARIANT_TYPE ("(b)"),
+      G_DBUS_CALL_FLAGS_NONE, 5000, NULL, &error);
+    g_assert_no_error (error); g_variant_get (result, "(b)", &owner); if (!owner) spin (1);
+  }
+  g_assert_true (owner);
+  g_autoptr (GVariant) device = call (bus, "AddWifiDevice", g_variant_new ("(s)", "test-wifi"));
+  const char *device_path; g_variant_get (device, "(&o)", &device_path);
+  g_autoptr (GVariant) ap1 = call (bus, "AddWifiAp", g_variant_new ("(sss)", "test-wifi", "Same label", "52:54:00:00:00:01"));
+  g_autoptr (GVariant) ap2 = call (bus, "AddWifiAp", g_variant_new ("(sss)", "test-wifi", "Same label", "52:54:00:00:00:02"));
+  g_autoptr (CcLumaNetwork) network = cc_luma_network_new ();
+  Seen seen = { 0 };
+  g_signal_connect (network, "failed", G_CALLBACK (failed), &seen);
+  cc_luma_network_start (network);
+  g_autoptr (JsonObject) snapshot = wait_snapshot (network, 1, 2);
+  JsonObject *d = json_array_get_object_element (json_object_get_array_member (snapshot, "devices"), 0);
+  g_assert_cmpstr (json_object_get_string_member (d, "interface"), ==, "test-wifi");
+  JsonArray *aps = json_object_get_array_member (d, "access-points");
+  JsonObject *first = json_array_get_object_element (aps, 0), *second = json_array_get_object_element (aps, 1);
+  g_assert_cmpstr (json_object_get_string_member (first, "name"), ==, "Same label");
+  g_assert_cmpstr (json_object_get_string_member (first, "ssid"), ==, "U2FtZSBsYWJlbA==");
+  g_assert_cmpstr (json_object_get_string_member (first, "path"), !=, json_object_get_string_member (second, "path"));
+  json_object_set_string_member (first, "name", "Caller edited its copy");
+  g_autoptr (JsonObject) independent = cc_luma_network_dup_snapshot (network);
+  JsonObject *fresh_device = json_array_get_object_element (json_object_get_array_member (independent, "devices"), 0);
+  g_assert_cmpstr (json_object_get_string_member (json_array_get_object_element (json_object_get_array_member (fresh_device, "access-points"), 0), "name"), ==, "Same label");
+  const char *ap_path; g_variant_get (ap1, "(&o)", &ap_path);
+  g_autoptr (GVariant) removed = call (bus, "RemoveWifiAp", g_variant_new ("(so)", "test-wifi", ap_path));
+  g_autoptr (JsonObject) after = wait_snapshot (network, 1, 1);
+  g_autoptr (GVariant) unplugged = call (bus, "RemoveDevice", g_variant_new ("(o)", device_path));
+  g_autoptr (JsonObject) empty = wait_snapshot (network, 0, 0);
+  g_assert_cmpuint (seen.failed, ==, 0);
+  cc_luma_network_stop (network);
+  g_output_stream_close (g_subprocess_get_stdin_pipe (service), NULL, &error); g_assert_no_error (error);
+  g_assert_true (g_subprocess_wait_check (service, NULL, &error)); g_assert_no_error (error);
+}
+int main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  /* An isolated system bus, deliberately without NetworkManager. Tests cannot
+   * contact Nick's services or accidentally read or modify his connections. */
+  GTestDBus *bus = g_test_dbus_new (G_TEST_DBUS_NONE);
+  g_test_dbus_up (bus);
+  g_setenv ("DBUS_SYSTEM_BUS_ADDRESS", g_test_dbus_get_bus_address (bus), TRUE);
