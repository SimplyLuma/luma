diff --git a/shell/cc-luma-live-network.c b/shell/cc-luma-live-network.c
index b668692..5ce292e 100644
--- a/shell/cc-luma-live-network.c
+++ b/shell/cc-luma-live-network.c
@@ -9,6 +9,7 @@
 #include <gio/gio.h>
 #include <string.h>
 #include "panels/network/qrcodegen.h"
+#include <luma-ui.h>
 
 #define ADAPTER "network"
 static const char * const pages[] = { "wifi", "wifi-net", "wifi-known", "hotspot", "network", NULL };
@@ -35,6 +36,10 @@ typedef struct {
   /* The person's hotspot edits, saved to the hotspot connection when valid. */
   char *hs_name, *hs_pass, *hs_band;
   guint hs_save;
+  /* A join in progress: its outcome is published (joinDone, joinFailed). */
+  char *trying;
+  NMDevice *trying_device;
+  gulong trying_id;
 } Net;
 
 static void queue_refresh (Net *n);
@@ -48,6 +53,48 @@ static void notice (Net *n, const char *message, gboolean error)
   cc_luma_fixture_publish_string (n->model, "netError", error ? message : "");
   cc_luma_fixture_publish_string (n->model, "netStatus", error ? "" : message);
 }
+static char *ssid_text (GBytes *ssid);
+/* The outcome of a join: connected, or refused. In TV posture a refused password does not leave the
+ * shell's password dialog over the TV: the attempt is stopped and the page asks again in place. */
+static void join_settled (Net *n, gboolean connected, const char *why)
+{
+  g_autofree char *name = g_steal_pointer (&n->trying);
+  if (!name || n->stopped) return;
+  g_autofree char *serial = g_strdup_printf ("%s\n%" G_GINT64_FORMAT, name, g_get_monotonic_time ());
+  cc_luma_fixture_publish_string (n->model, connected ? "joinDone" : "joinFailed", serial);
+  g_autofree char *message = connected ? g_strdup_printf ("Connected to %s", name) : g_strdup (why);
+  notice (n, message, !connected);
+}
+static void trying_state (NMDevice *device, guint state, guint old, guint reason, Net *n)
+{
+  if (!n->trying) return;
+  if (state == NM_DEVICE_STATE_ACTIVATED)
+    {
+      NMAccessPoint *ap = NM_IS_DEVICE_WIFI (device) ? nm_device_wifi_get_active_access_point (NM_DEVICE_WIFI (device)) : NULL;
+      g_autofree char *ssid = ap ? ssid_text (nm_access_point_get_ssid (ap)) : NULL;
+      if (g_strcmp0 (ssid, n->trying) == 0) join_settled (n, TRUE, NULL);
+    }
+  else if (state == NM_DEVICE_STATE_NEED_AUTH && old > NM_DEVICE_STATE_PREPARE && luma_ui_tv_posture ())
+    {
+      nm_device_disconnect_async (device, NULL, NULL, NULL);
+      join_settled (n, FALSE, "Wrong password");
+    }
+  else if (state == NM_DEVICE_STATE_FAILED)
+    join_settled (n, FALSE, reason == NM_DEVICE_STATE_REASON_NO_SECRETS || reason == NM_DEVICE_STATE_REASON_SUPPLICANT_DISCONNECT
+                              ? "Wrong password" : reason == NM_DEVICE_STATE_REASON_SUPPLICANT_TIMEOUT
+                              ? "The network didn’t answer" : "Couldn’t join the network");
+}
+static void watch_join (Net *n, NMDevice *device, const char *name)
+{
+  g_free (n->trying);
+  n->trying = g_strdup (name);
+  if (n->trying_device == device) return;
+  if (n->trying_device) g_clear_signal_handler (&n->trying_id, n->trying_device);
+  g_clear_object (&n->trying_device);
+  n->trying_device = g_object_ref (device);
+  n->trying_id = g_signal_connect (device, "state-changed", G_CALLBACK (trying_state), n);
+}
+
 /* These writes are exercised against the native NM owner and UI by %check. */
 void cc_luma_live_verify_network_keys (CcLumaFixture *model)
 {
@@ -735,6 +782,39 @@ strongest_ap (NMDeviceWifi *dev, const char *name)
     }
   return best;
 }
+/* TV posture: a network joined on the TV is saved for the whole TV where the session may (the
+ * connection editor's "All users"), its password always kept by NetworkManager in the connection
+ * (psk-flags 0). Nothing is left to a user's secret agent, whose keyring is locked under automatic sign-in and
+ * would put a prompt over the TV. */
+static void system_wide (NMClient *client, NMConnection *connection, const char *password)
+{
+  NMSettingConnection *owner = nm_connection_get_setting_connection (connection);
+  if (owner && nm_client_get_permission_result (client, NM_CLIENT_PERMISSION_SETTINGS_MODIFY_SYSTEM) == NM_CLIENT_PERMISSION_RESULT_YES)
+    g_object_set (owner, NM_SETTING_CONNECTION_PERMISSIONS, NULL, NULL);
+  NMSettingConnection *s = nm_connection_get_setting_connection (connection);
+  if (s) g_object_set (s, NM_SETTING_CONNECTION_AUTOCONNECT, TRUE, NULL);
+  NMSettingWirelessSecurity *sec = nm_connection_get_setting_wireless_security (connection);
+  if (sec && password && *password)
+    g_object_set (sec, NM_SETTING_WIRELESS_SECURITY_PSK, password,
+                  NM_SETTING_WIRELESS_SECURITY_PSK_FLAGS, NM_SETTING_SECRET_FLAG_NONE, NULL);
+}
+typedef struct { Net *net; NMDevice *device; char *ap; } Resave;
+static void
+resaved (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Resave *r = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) out = nm_remote_connection_update2_finish (NM_REMOTE_CONNECTION (source), result, &error);
+  if (error) report (r->net, error);
+  else if (!r->net->stopped)
+    nm_client_activate_connection_async (r->net->client, NM_CONNECTION (source), r->device, r->ap,
+                                         r->net->cancel, activated, net_ref (r->net));
+  net_unref (r->net);
+  g_object_unref (r->device);
+  g_free (r->ap);
+  g_free (r);
+}
+
 /* net-device-wifi.c wireless_try_to_connect, with the password the person
  * typed on the page handed to NetworkManager in the new connection. If it is
  * wrong NetworkManager asks again through its agent (the shell's prompt),
@@ -742,6 +822,7 @@ strongest_ap (NMDeviceWifi *dev, const char *name)
 static gboolean
 join (Net *n, const char *name, const char *password, gboolean hidden, GError **error)
 {
+  gboolean tv = luma_ui_tv_posture ();
