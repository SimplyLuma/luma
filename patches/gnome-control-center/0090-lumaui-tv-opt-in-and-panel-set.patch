+{
+  JsonArray *groups = f->groups;
+  GtkWidget *sidebar = f->sidebar;
+  f->tv = tv_posture () && !phone_form_factor ();
+  if (f->tv)
+    {
+      for (guint i = 0; i < G_N_ELEMENTS (tv_destinations); i++)
+        {
+          const Destination *d = &tv_destinations[i];
+          GtkWidget *row;
+          if (!d->id)
+            {
+              luma_navigation_sidebar_append_section (LUMA_NAVIGATION_SIDEBAR (sidebar), d->title);
+              continue;
+            }
+          if (!cc_luma_view_page_offered (f->model, d->id)) continue; /* hide rather than fake */
+          row = luma_navigation_row_new (d->title, NULL);
+          luma_navigation_row_set_lead (LUMA_NAVIGATION_ROW (row), luma_ui_icon_new (d->icon));
+          g_object_set_data (G_OBJECT (row), "cf-page", (gpointer) d->id);
+          luma_navigation_sidebar_append_row (LUMA_NAVIGATION_SIDEBAR (sidebar), GTK_LIST_BOX_ROW (row));
+          g_hash_table_insert (f->rows, (gpointer) d->id, row);
+        }
+      return;
+    }
+  for (guint g = 0; groups && g < json_array_get_length (groups); g++)
+    {
+      JsonArray *group = json_array_get_array_element (groups, g);
+      const char *heading = json_array_get_string_element (group, 0);
+      JsonArray *ids = json_array_get_array_element (group, 1);
+      if (heading && *heading)
+        luma_navigation_sidebar_append_section (LUMA_NAVIGATION_SIDEBAR (sidebar), heading);
+      for (guint i = 0; i < json_array_get_length (ids); i++)
+        {
+          const Destination *d = destination (json_array_get_string_element (ids, i));
+          GtkWidget *row;
+          if (!d) continue;
+          row = luma_navigation_row_new (d->title, NULL);
+          luma_navigation_row_set_lead (LUMA_NAVIGATION_ROW (row), luma_ui_icon_new (d->icon));
+          g_object_set_data (G_OBJECT (row), "cf-page", (gpointer) d->id);
+          luma_navigation_sidebar_append_row (LUMA_NAVIGATION_SIDEBAR (sidebar), GTK_LIST_BOX_ROW (row));
+          g_hash_table_insert (f->rows, (gpointer) d->id, row);
+        }
+    }
+}
