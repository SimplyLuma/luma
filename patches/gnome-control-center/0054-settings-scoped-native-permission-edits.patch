diff --git a/shell/test-luma-permissions.c b/shell/test-luma-permissions.c
new file mode 100644
index 0000000..9e4d050
--- /dev/null
+++ b/shell/test-luma-permissions.c
@@ -0,0 +1,228 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-permissions.h"
+#include <glib/gstdio.h>
+#define NAME "org.freedesktop.impl.portal.PermissionStore"
+#define PATH "/org/freedesktop/impl/portal/PermissionStore"
+static GDBusConnection *service, *client;
+static GVariant *entries;
+static guint lookups, writes;
+static gboolean conflict, unrelated, lose_owner, hold_lookup, hold_write, refuse_write;
+static GDBusMethodInvocation *pending;
+typedef struct { gboolean done, success; GVariant *snapshot; GError *error; } Seen;
+static void drain (void) { while (g_main_context_iteration (NULL, FALSE)) {} }
+static void wait_seen (Seen *seen)
+{
+  gint64 deadline = g_get_monotonic_time () + 7000000;
+  while (!seen->done && g_get_monotonic_time () < deadline) { drain (); g_usleep (1000); }
+  g_assert_true (seen->done);
+}
+static void read_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Seen *seen = data; seen->snapshot = cc_luma_permissions_read_finish (G_DBUS_CONNECTION (source), result, &seen->error); seen->done = TRUE;
+}
+static void set_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Seen *seen = data; seen->success = cc_luma_permissions_set_finish (G_DBUS_CONNECTION (source), result, &seen->error); seen->done = TRUE;
+}
+static void name_call (const char *method)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GVariant) result = g_dbus_connection_call_sync (service, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", method,
+    g_str_equal (method, "RequestName") ? g_variant_new ("(su)", NAME, 0u) : g_variant_new ("(s)", NAME), G_VARIANT_TYPE ("(u)"), G_DBUS_CALL_FLAGS_NONE, 5000, NULL, &error);
+  g_assert_no_error (error); g_assert_nonnull (result);
+  guint code; g_variant_get (result, "(u)", &code); g_assert_true (code == 1 || code == 4);
+}
+static void replace (const char *app, GVariant *values)
+{
+  GVariantBuilder builder; g_variant_builder_init (&builder, G_VARIANT_TYPE ("a{sas}"));
+  GVariantIter iter; g_variant_iter_init (&iter, entries);
+  const char *key; GVariant *old; gboolean found = FALSE;
+  while (g_variant_iter_next (&iter, "{&s@as}", &key, &old)) {
+    if (g_str_equal (key, app)) { g_variant_builder_add (&builder, "{s@as}", key, g_variant_ref (values)); found = TRUE; }
+    else g_variant_builder_add (&builder, "{s@as}", key, g_variant_ref (old));
+    g_variant_unref (old);
+  }
+  g_assert_true (found); g_clear_pointer (&entries, g_variant_unref); entries = g_variant_ref_sink (g_variant_builder_end (&builder));
+}
+static void reset (gboolean location)
+{
+  g_assert_null (pending); name_call ("RequestName");
+  lookups = writes = 0; conflict = unrelated = lose_owner = hold_lookup = hold_write = refuse_write = FALSE;
+  g_clear_pointer (&entries, g_variant_unref);
+  entries = g_variant_parse (G_VARIANT_TYPE ("a{sas}"), location ?
+    "{'org.example.Selected': ['EXACT', '1712345678', 'future metadata'], 'org.example.Other': ['NONE', '999'], 'unknown record': []}" :
+    "{'org.example.Selected': ['yes', 'future metadata'], 'org.example.Other': ['no'], 'unknown record': []}", NULL, NULL, NULL);
+  g_assert_nonnull (entries);
+}
+static void method (GDBusConnection *connection, const char *sender, const char *path,
+  const char *interface, const char *name, GVariant *parameters, GDBusMethodInvocation *invocation, gpointer data)
+{
+  g_assert_cmpstr (path, ==, PATH); g_assert_cmpstr (interface, ==, NAME);
+  if (g_str_equal (name, "Lookup")) {
+    const char *table, *id; g_variant_get (parameters, "(&s&s)", &table, &id);
+    g_assert_true ((g_str_equal (table, "devices") && (g_str_equal (id, "camera") || g_str_equal (id, "microphone"))) ||
+                   (g_str_equal (table, "location") && g_str_equal (id, "location")));
+    lookups++;
+    if (lookups == 2) {
+      if (conflict) { const char *values[] = { "no", "concurrent selected edit", NULL }; g_autoptr(GVariant) value = g_variant_ref_sink (g_variant_new_strv (values, -1)); replace ("org.example.Selected", value); }
+      if (unrelated) { const char *values[] = { "yes", "external unrelated metadata", NULL }; g_autoptr(GVariant) value = g_variant_ref_sink (g_variant_new_strv (values, -1)); replace ("org.example.Other", value); }
+      if (lose_owner) name_call ("ReleaseName");
+    }
+    if (hold_lookup) { g_assert_null (pending); pending = g_object_ref (invocation); return; }
+    g_dbus_method_invocation_return_value (invocation, g_variant_new ("(@a{sas}v)", g_variant_ref (entries), g_variant_new_string ("opaque metadata unchanged")));
+  } else {
+    g_assert_cmpstr (name, ==, "SetPermission");
+    const char *table, *id, *app; gboolean create; GVariant *values;
+    g_variant_get (parameters, "(&sb&s&s@as)", &table, &create, &id, &app, &values);
+    g_assert_false (create); g_assert_cmpstr (app, ==, "org.example.Selected"); writes++;
+    if (refuse_write) { g_variant_unref (values); g_dbus_method_invocation_return_dbus_error (invocation, NAME ".Error", "Private permission service refused write"); return; }
+    replace (app, values); g_variant_unref (values);
+    if (hold_write) { g_assert_null (pending); pending = g_object_ref (invocation); return; }
+    g_dbus_method_invocation_return_value (invocation, NULL);
+  }
+}
+static char *directory (void) { return g_build_filename (g_get_user_data_dir (), "luma", "settings", "backups", NULL); }
+static void cleanup_backups (void)
+{
+  g_autofree char *dir = directory (); g_autoptr(GDir) files = g_dir_open (dir, 0, NULL); const char *name;
+  while (files && (name = g_dir_read_name (files))) { g_autofree char *path = g_build_filename (dir, name, NULL); g_assert_cmpint (g_remove (path), ==, 0); }
+  g_clear_pointer (&files, g_dir_close);
+}
+static void read_and_scoped_edit (void)
+{
+  reset (FALSE); cleanup_backups ();
+  Seen read = { 0 }; cc_luma_permissions_read_async (client, CC_LUMA_PERMISSION_CAMERA, NULL, read_done, &read); g_assert_false (read.done); wait_seen (&read);
+  g_assert_no_error (read.error); g_assert_nonnull (read.snapshot); g_assert_true (g_variant_is_of_type (read.snapshot, G_VARIANT_TYPE ("(sa{sas}v)")));
+  g_autoptr(GVariant) opaque = g_variant_get_child_value (read.snapshot, 2); g_autoptr(GVariant) payload = g_variant_get_variant (opaque);
+  g_assert_cmpstr (g_variant_get_string (payload, NULL), ==, "opaque metadata unchanged");
+  g_autoptr(GVariant) unknown = g_variant_lookup_value (entries, "unknown record", G_VARIANT_TYPE_STRING_ARRAY); g_assert_nonnull (unknown); g_assert_cmpuint (g_variant_n_children (unknown), ==, 0);
+  lookups = 0; unrelated = TRUE;
+  g_autofree char *dir = directory (); Seen edit = { 0 };
+  cc_luma_permissions_set_async (client, CC_LUMA_PERMISSION_CAMERA, "org.example.Selected", FALSE, dir, NULL, set_done, &edit); wait_seen (&edit);
+  g_assert_true (edit.success); g_assert_no_error (edit.error); g_assert_cmpuint (writes, ==, 1);
+  g_autoptr(GVariant) selected = g_variant_lookup_value (entries, "org.example.Selected", G_VARIANT_TYPE_STRING_ARRAY);
+  g_auto(GStrv) values = g_variant_dup_strv (selected, NULL); g_assert_cmpstr (values[0], ==, "no"); g_assert_cmpstr (values[1], ==, "future metadata");
+  g_autoptr(GVariant) other = g_variant_lookup_value (entries, "org.example.Other", G_VARIANT_TYPE_STRING_ARRAY);
+  g_auto(GStrv) other_values = g_variant_dup_strv (other, NULL); g_assert_cmpstr (other_values[1], ==, "external unrelated metadata");
