diff --git a/shell/cc-luma-permissions.c b/shell/cc-luma-permissions.c
new file mode 100644
index 0000000..2ab73ea
--- /dev/null
+++ b/shell/cc-luma-permissions.c
@@ -0,0 +1,150 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-permissions.h"
+#include "cc-luma-backup.h"
+#include <string.h>
+#define NAME "org.freedesktop.impl.portal.PermissionStore"
+#define PATH "/org/freedesktop/impl/portal/PermissionStore"
+typedef struct { CcLumaPermission kind; char *app, *directory; gboolean enabled; } Operation;
+static const struct { const char *table, *id; } contracts[] = {
+  { "devices", "camera" }, { "devices", "microphone" }, { "location", "location" }
+};
+static void operation_free (Operation *op) { g_free (op->app); g_free (op->directory); g_free (op); }
+static char *owner (GDBusConnection *connection, GCancellable *cancel, GError **error)
+{
+  g_autoptr(GVariant) result = g_dbus_connection_call_sync (connection,
+    "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetNameOwner",
+    g_variant_new ("(s)", NAME), G_VARIANT_TYPE ("(s)"), G_DBUS_CALL_FLAGS_NO_AUTO_START, 5000, cancel, error);
+  if (!result) return NULL;
+  const char *name; g_variant_get (result, "(&s)", &name);
+  if (!g_dbus_is_unique_name (name)) { g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "PermissionStore has no valid native owner"); return NULL; }
+  return g_strdup (name);
+}
+static gboolean owner_matches (GDBusConnection *connection, const char *expected, GCancellable *cancel, GError **error)
+{
+  g_autofree char *current = owner (connection, cancel, error);
+  if (!current) return FALSE;
+  if (g_str_equal (current, expected)) return TRUE;
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED, "PermissionStore owner changed during the operation"); return FALSE;
+}
+static GVariant *lookup (GDBusConnection *connection, Operation *op, const char *name, GCancellable *cancel, GError **error)
+{
+  g_autoptr(GVariant) reply = g_dbus_connection_call_sync (connection, name, PATH, NAME, "Lookup",
+    g_variant_new ("(ss)", contracts[op->kind].table, contracts[op->kind].id),
+    G_VARIANT_TYPE ("(a{sas}v)"), G_DBUS_CALL_FLAGS_NO_AUTO_START, 5000, cancel, error);
+  if (!reply) return NULL;
+  g_autoptr(GVariant) entries = g_variant_get_child_value (reply, 0);
+  GVariantIter iter; g_variant_iter_init (&iter, entries);
+  const char *app; GVariant *values;
+  g_autoptr(GHashTable) seen = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  while (g_variant_iter_next (&iter, "{&s@as}", &app, &values)) {
+    g_variant_unref (values);
+    if (!*app || !g_hash_table_add (seen, g_strdup (app))) {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "PermissionStore returned duplicate or empty application IDs"); return NULL;
+    }
+  }
+  if (!owner_matches (connection, name, cancel, error)) return NULL;
+  return g_steal_pointer (&reply);
+}
+static void read_worker (GTask *task, gpointer source, gpointer data, GCancellable *cancel)
+{
+  Operation *op = data; GDBusConnection *connection = source;
+  g_autoptr(GError) error = NULL;
+  g_autofree char *name = owner (connection, cancel, &error);
+  if (!name) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  g_autoptr(GVariant) reply = lookup (connection, op, name, cancel, &error);
+  if (!reply) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  g_autoptr(GVariant) entries = g_variant_get_child_value (reply, 0);
+  g_autoptr(GVariant) opaque = g_variant_get_child_value (reply, 1);
+  GVariant *snapshot = g_variant_ref_sink (g_variant_new ("(s@a{sas}@v)", name, g_variant_ref (entries), g_variant_ref (opaque)));
+  g_task_return_pointer (task, snapshot, (GDestroyNotify) g_variant_unref);
+}
+static void set_worker (GTask *task, gpointer source, gpointer data, GCancellable *cancel)
+{
+  static GMutex writes;
+  g_autoptr(GMutexLocker) lock = g_mutex_locker_new (&writes);
+  Operation *op = data; GDBusConnection *connection = source;
+  g_autoptr(GError) error = NULL;
+  g_autofree char *name = owner (connection, cancel, &error);
+  if (!name) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  g_autoptr(GVariant) reply = lookup (connection, op, name, cancel, &error);
+  if (!reply) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  g_autoptr(GVariant) entries = g_variant_get_child_value (reply, 0);
+  g_autoptr(GVariant) before = g_variant_lookup_value (entries, op->app, G_VARIANT_TYPE_STRING_ARRAY);
+  if (!before || !g_variant_n_children (before) ||
+      (op->kind == CC_LUMA_PERMISSION_LOCATION && g_variant_n_children (before) < 2)) {
+    g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "The requested app has no editable native permission record"); return;
+  }
+  g_auto(GStrv) values = g_variant_dup_strv (before, NULL);
+  gboolean known = op->kind == CC_LUMA_PERMISSION_LOCATION ?
+    g_str_equal (values[0], "NONE") || g_str_equal (values[0], "EXACT") || g_str_equal (values[0], "CITY") || g_str_equal (values[0], "NEIGHBORHOOD") || g_str_equal (values[0], "STREET") :
+    g_str_equal (values[0], "yes") || g_str_equal (values[0], "no") || g_str_equal (values[0], "ask");
+  if (!known) { g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Unknown native permission value remains unchanged"); return; }
+  const char *table = contracts[op->kind].table, *id = contracts[op->kind].id;
+  g_autofree char *identity = g_strjoin ("/", NAME, table, id, op->app, NULL);
+  g_autoptr(GVariant) record = g_variant_ref_sink (g_variant_new ("(sssv)", table, id, op->app, before));
+  g_autoptr(GVariant) saved = cc_luma_backup_once (op->directory, identity, record, 3, cancel, &error);
+  if (!saved) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  g_autoptr(GVariant) boxed = g_variant_get_child_value (saved, 3);
+  g_autoptr(GVariant) original = g_variant_get_variant (boxed);
+  if (!g_variant_is_of_type (original, G_VARIANT_TYPE_STRING_ARRAY)) { g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Permission recovery record has an invalid type"); return; }
+  /* Re-read after durable backup. Refuse a concurrent change to the selected
+   * record; unrelated records are never rewritten or filtered. */
+  g_autoptr(GVariant) latest = lookup (connection, op, name, cancel, &error);
+  if (!latest) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  g_autoptr(GVariant) current_entries = g_variant_get_child_value (latest, 0);
+  g_autoptr(GVariant) current = g_variant_lookup_value (current_entries, op->app, G_VARIANT_TYPE_STRING_ARRAY);
+  if (!current || !g_variant_equal (current, before)) { g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_BUSY, "The app permission changed while preparing its edit; refresh first"); return; }
+  if (g_task_return_error_if_cancelled (task)) return;
+  g_free (values[0]); values[0] = g_strdup (op->kind == CC_LUMA_PERMISSION_LOCATION ? op->enabled ? "EXACT" : "NONE" : op->enabled ? "yes" : "no");
+  /* SetPermission is the upstream scoped write contract. Require the entry
+   * to exist rather than recreating a deleted table record. Lookup/re-read
+   * also require the selected app. This API supplies no atomic compare/set;
+   * callers must refresh after native errors or competing owner changes. */
+  /* Once dispatch begins cancellation cannot prove the daemon did not edit.
+   * Finish the bounded call and report its actual reply; callers refresh on
+   * an error/timeout, whose write outcome may be unknown. */
+  g_task_set_check_cancellable (task, FALSE);
+  g_autoptr(GVariant) applied = g_dbus_connection_call_sync (connection, name, PATH, NAME, "SetPermission",
+    g_variant_new ("(sbss^as)", table, FALSE, id, op->app, values), G_VARIANT_TYPE_UNIT,
+    G_DBUS_CALL_FLAGS_NO_AUTO_START, 5000, NULL, &error);
+  if (!applied) { g_task_return_error (task, g_steal_pointer (&error)); return; }
+  g_task_return_boolean (task, TRUE);
+}
+static GTask *prepare (GDBusConnection *connection, CcLumaPermission kind, GCancellable *cancel, GAsyncReadyCallback callback, gpointer data, gpointer tag)
+{
+  GTask *task = g_task_new (connection, cancel, callback, data); g_task_set_source_tag (task, tag);
+  if ((guint) kind >= G_N_ELEMENTS (contracts)) { g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Unknown Settings permission domain"); g_object_unref (task); return NULL; }
+  if (g_getenv ("LUMA_SETTINGS_FIXTURE")) { g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Fixture Settings cannot contact PermissionStore"); g_object_unref (task); return NULL; }
+  if (g_task_return_error_if_cancelled (task)) { g_object_unref (task); return NULL; }
+  Operation *op = g_new0 (Operation, 1); op->kind = kind; g_task_set_task_data (task, op, (GDestroyNotify) operation_free); return task;
+}
+void cc_luma_permissions_read_async (GDBusConnection *connection, CcLumaPermission kind, GCancellable *cancel, GAsyncReadyCallback callback, gpointer data)
+{
+  g_return_if_fail (G_IS_DBUS_CONNECTION (connection));
+  g_autoptr(GTask) task = prepare (connection, kind, cancel, callback, data, cc_luma_permissions_read_async);
+  if (task) g_task_run_in_thread (task, read_worker);
+}
+GVariant *cc_luma_permissions_read_finish (GDBusConnection *connection, GAsyncResult *result, GError **error)
+{
+  g_return_val_if_fail (g_task_is_valid (result, connection), NULL);
+  g_return_val_if_fail (g_async_result_is_tagged (result, cc_luma_permissions_read_async), NULL);
+  return g_task_propagate_pointer (G_TASK (result), error);
+}
+void cc_luma_permissions_set_async (GDBusConnection *connection, CcLumaPermission kind, const char *app, gboolean enabled,
+  const char *backup_dir, GCancellable *cancel, GAsyncReadyCallback callback, gpointer data)
+{
+  g_return_if_fail (G_IS_DBUS_CONNECTION (connection));
+  g_autoptr(GTask) task = prepare (connection, kind, cancel, callback, data, cc_luma_permissions_set_async);
+  if (!task) return;
+  g_autofree char *expected = g_build_filename (g_get_user_data_dir (), "luma", "settings", "backups", NULL);
+  g_autofree char *actual = backup_dir && g_path_is_absolute (backup_dir) ? g_canonicalize_filename (backup_dir, NULL) : NULL;
+  if (!app || !*app || g_strcmp0 (expected, actual)) { g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Permission edits require an existing app and the documented Settings recovery store"); return; }
+  Operation *op = g_task_get_task_data (task); op->app = g_strdup (app); op->directory = g_strdup (actual); op->enabled = enabled;
+  g_task_run_in_thread (task, set_worker);
+}
+gboolean cc_luma_permissions_set_finish (GDBusConnection *connection, GAsyncResult *result, GError **error)
+{
+  g_return_val_if_fail (g_task_is_valid (result, connection), FALSE);
+  g_return_val_if_fail (g_async_result_is_tagged (result, cc_luma_permissions_set_async), FALSE);
+  return g_task_propagate_boolean (G_TASK (result), error);
+}
diff --git a/shell/cc-luma-permissions.h b/shell/cc-luma-permissions.h
new file mode 100644
index 0000000..526716a
--- /dev/null
+++ b/shell/cc-luma-permissions.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <gio/gio.h>
+G_BEGIN_DECLS
+typedef enum { CC_LUMA_PERMISSION_CAMERA, CC_LUMA_PERMISSION_MICROPHONE, CC_LUMA_PERMISSION_LOCATION } CcLumaPermission;
+/* Existing GNOME/portal PermissionStore. Caller supplies its connection;
+ * tests supply only a private bus. No service activation or fixture I/O.
+ * Reads return (sa{sas}v): unique owner, exact app permissions, opaque data. */
+void cc_luma_permissions_read_async (GDBusConnection *connection, CcLumaPermission kind,
+  GCancellable *cancel, GAsyncReadyCallback callback, gpointer data);
+GVariant *cc_luma_permissions_read_finish (GDBusConnection *connection, GAsyncResult *result, GError **error);
+/* Change only a requested existing app permission, preserving other fields,
+ * entries and opaque data. Backup is durable before SetPermission; directory
+ * must be the documented app-local store, including in private tests.
+ * Cancellation prevents dispatch; after dispatch the bounded native reply
+ * decides the result. An error/timeout may have an unknown write outcome. */
+void cc_luma_permissions_set_async (GDBusConnection *connection, CcLumaPermission kind,
+  const char *app, gboolean enabled, const char *backup_dir, GCancellable *cancel,
+  GAsyncReadyCallback callback, gpointer data);
+gboolean cc_luma_permissions_set_finish (GDBusConnection *connection, GAsyncResult *result, GError **error);
+G_END_DECLS
