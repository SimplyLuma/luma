 {
-  if (cc_luma_fixture_is_live (model)) return live_validate (model);
+  if (cc_luma_displays_live_shape (model)) return live_validate (model);
   const char *join[] = { "join", "mirror", NULL }, *ids[] = { "int", "ext", NULL };
   const char *scales[] = { "100", "125", "150", "175", "200", NULL };
   const char *rotations[] = { "Landscape", "Portrait right", "Portrait left", "Landscape, flipped", NULL };
@@ -181,7 +192,7 @@ CcLumaDisplayDraft *cc_luma_display_draft_new (CcLumaFixture *model)
 }
