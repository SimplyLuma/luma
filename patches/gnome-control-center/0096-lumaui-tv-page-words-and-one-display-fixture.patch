+/* Displays as the live reader reports them (each with its logical rectangle): the live model, or a
+ * fixture that describes a machine that way (one TV on HDMI, say), not v70's fixed pair. */
+gboolean cc_luma_displays_live_shape (CcLumaFixture *model)
+{
+  if (cc_luma_fixture_is_live (model)) return TRUE;
+  JsonNode *catalog = json_object_get_member (cc_luma_fixture_get_data (model), "CFDISP");
+  if (!catalog || !JSON_NODE_HOLDS_OBJECT (catalog)) return FALSE;
+  g_autoptr (GList) ids = json_object_get_members (json_node_get_object (catalog));
+  JsonNode *first = ids ? json_object_get_member (json_node_get_object (catalog), ids->data) : NULL;
+  return first && JSON_NODE_HOLDS_OBJECT (first) && number_member (json_node_get_object (first), "lw");
+}
