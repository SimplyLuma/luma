 {
-  gboolean live = cc_luma_fixture_is_live (draft->model);
+  gboolean live = cc_luma_displays_live_shape (draft->model);
   if (!cc_luma_displays_validate (draft->model) || !key || !value ||
       !(g_str_equal (key, "join") || g_str_equal (key, "arr.side") || g_str_equal (key, "arr.off") || g_str_has_prefix (key, "d.int.") || g_str_has_prefix (key, "d.ext.") ||
         (live && g_str_has_prefix (key, "d.") && strchr (key + 2, '.')))) return invalid (error);
