From: Project Luma
Subject: [PATCH] Settings: restore mouse and touchpad scroll speed in native LumaUI

The active native page replaced the legacy mouse panel without exposing its
existing Mutter-owned scroll settings. Reuse its logarithmic conversion and
shared range controls, keeping wheel and finger scrolling independent.

diff --git a/shell/cc-luma-live-gsettings.h b/shell/cc-luma-live-gsettings.h
--- a/shell/cc-luma-live-gsettings.h
+++ b/shell/cc-luma-live-gsettings.h
@@ -15,6 +15,7 @@
   CC_LUMA_GS_CHOICE,    /* any scalar ↔ string: choices = { model, gsettings, … } in GVariant text */
   CC_LUMA_GS_CHOICE_INT,/* same, model side is an integer */
   CC_LUMA_GS_LINEAR,    /* number ↔ integer model = round (value * scale + offset), clamped to low…high */
+  CC_LUMA_GS_SCROLL,    /* factor .25…4 ↔ log2 slider -100…100; zero is normal */
   CC_LUMA_GS_DOUBLE,    /* d ↔ double */
   CC_LUMA_GS_MINUTES,   /* seconds (i/u) ↔ string of whole minutes */
   CC_LUMA_GS_HOURS,     /* hours (d) ↔ "HH:MM" */
diff --git a/shell/cc-luma-live-gsettings.c b/shell/cc-luma-live-gsettings.c
--- a/shell/cc-luma-live-gsettings.c
+++ b/shell/cc-luma-live-gsettings.c
@@ -3,6 +3,7 @@
 #include "cc-luma-displays.h"
 #include "cc-luma-device-options.h"
 #include <math.h>
+#include "../panels/mouse/cc-scroll-speed.h"
 #include <stdio.h>
 
 typedef struct {
@@ -96,6 +97,12 @@
         double number = number_of (value) * row->scale + row->offset;
         if (!isfinite (number)) break;
         return json_node_init_int (node, (gint64) round (CLAMP (number, row->low, row->high)));
+      }
+    case CC_LUMA_GS_SCROLL:
+      {
+        double factor = number_of (value);
+        if (!isfinite (factor) || factor < CC_SCROLL_SPEED_MIN || factor > CC_SCROLL_SPEED_MAX) break;
+        return json_node_init_int (node, (gint64) round (cc_scroll_speed_to_slider (factor) * 50));
       }
     case CC_LUMA_GS_DOUBLE:
       if (!isfinite (number_of (value))) break;
@@ -159,6 +166,13 @@
         double model = json_node_get_double (value);
         if (!isfinite (model) || model < row->low || model > row->high || row->scale == 0) return NULL;
         return number_as (b->type, (model - row->offset) / row->scale);
+      }
+    case CC_LUMA_GS_SCROLL:
+      {
+        if (type != G_TYPE_INT64 && type != G_TYPE_DOUBLE) return NULL;
+        double position = json_node_get_double (value);
+        if (!isfinite (position) || position < -100 || position > 100) return NULL;
+        return number_as (b->type, cc_scroll_speed_from_slider (position / 50));
       }
     case CC_LUMA_GS_DOUBLE:
       if (type != G_TYPE_INT64 && type != G_TYPE_DOUBLE) return NULL;
@@ -385,11 +399,13 @@
   { "mSpeed", MOUSE, "speed", CC_LUMA_GS_LINEAR, NULL, 100, 0, -100, 100 },
   { "mAccel", MOUSE, "accel-profile", CC_LUMA_GS_UNLESS, accel },
   { "mNat", MOUSE, "natural-scroll", CC_LUMA_GS_BOOLEAN },
+  { "mScrollSpeed", "org.projectluma.peripherals.mouse", "scroll-speed", CC_LUMA_GS_SCROLL },
   { "tp", TOUCHPAD, "send-events", CC_LUMA_GS_UNLESS, send_events },
   { "tpType", TOUCHPAD, "disable-while-typing", CC_LUMA_GS_BOOLEAN },
   { "tSpeed", TOUCHPAD, "speed", CC_LUMA_GS_LINEAR, NULL, 100, 0, -100, 100 },
   { "tTap", TOUCHPAD, "tap-to-click", CC_LUMA_GS_BOOLEAN },
   { "tNat", TOUCHPAD, "natural-scroll", CC_LUMA_GS_BOOLEAN },
+  { "tScrollSpeed", "org.projectluma.peripherals.touchpad", "scroll-speed", CC_LUMA_GS_SCROLL },
   { "tSec", TOUCHPAD, "click-method", CC_LUMA_GS_CHOICE, click_method },
   /* Keyboard */
   { "perWin", "org.gnome.desktop.input-sources", "per-window", CC_LUMA_GS_CHOICE, per_window },
diff --git a/shell/cc-luma-device-options.c b/shell/cc-luma-device-options.c
--- a/shell/cc-luma-device-options.c
+++ b/shell/cc-luma-device-options.c
@@ -22,6 +22,8 @@
   { "mBtn", G_TYPE_STRING, 0, 0, { "left", "right", NULL } },
   { .key = "mSpeed", .type = G_TYPE_INT64, .low = -100, .high = 100 },
   { .key = "tSpeed", .type = G_TYPE_INT64, .low = -100, .high = 100 },
+  { .key = "mScrollSpeed", .type = G_TYPE_INT64, .low = -100, .high = 100 },
+  { .key = "tScrollSpeed", .type = G_TYPE_INT64, .low = -100, .high = 100 },
   { .key = "mAccel", .type = G_TYPE_BOOLEAN }, { .key = "mNat", .type = G_TYPE_BOOLEAN },
   { .key = "tp", .type = G_TYPE_BOOLEAN }, { .key = "tpType", .type = G_TYPE_BOOLEAN },
   { .key = "tTap", .type = G_TYPE_BOOLEAN }, { .key = "tNat", .type = G_TYPE_BOOLEAN },
@@ -99,6 +101,10 @@
   for (guint i = 0; i < length; i++)
     {
       JsonNode *value = cc_luma_fixture_get (model, fields[i].key);
+      /* Older fixtures and systems without Luma's Mutter schema have no
+       * scroll owner. Omit those controls without inventing a speed. */
+      if ((!value || JSON_NODE_HOLDS_NULL (value)) &&
+          (g_str_equal (fields[i].key, "mScrollSpeed") || g_str_equal (fields[i].key, "tScrollSpeed"))) continue;
       if (cc_luma_fixture_is_live (model) && (!value || JSON_NODE_HOLDS_NULL (value))) continue;
       if (!allowed_in (model, &fields[i], value)) return FALSE;
     }
