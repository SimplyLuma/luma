From: Project Luma <engineering@projectluma.org>
Date: Sat, 19 Sep 2026 15:00:00 -0500
Subject: [PATCH] dash: Span and Float follow Use islands

Shell .119 draws the Dash without islands as one bar the whole length of
each edge it holds. Without islands, "Span full edge" therefore always
applies: its switch shows On, cannot be changed and says "Always on when
islands are off", and the stored choice is kept for when islands come back.
"Float outer edges" can be changed, and the preview draws the full-length
bar.

---
diff --git a/panels/dash/cc-dash-panel.c b/panels/dash/cc-dash-panel.c
--- a/panels/dash/cc-dash-panel.c
+++ b/panels/dash/cc-dash-panel.c
@@ -17,6 +17,8 @@
   GSettings *settings;
   GtkWidget *preview;
   AdwSwitchRow *float_row;
+  AdwSwitchRow *span_row;
+  gboolean syncing_span;
   AdwSpinRow *padding_row;
   GtkCheckButton *positions[4];
 };
@@ -184,9 +186,9 @@
   g_autofree char *surface = g_settings_get_string (self->settings, "shelf-surface-mode");
   gboolean vertical = g_str_equal (edge, "left") || g_str_equal (edge, "right");
   gboolean attached = g_str_equal (mode, "protruding");
-  gboolean span = g_settings_get_boolean (self->settings, "shelf-span-full");
-  gboolean floating = g_settings_get_boolean (self->settings, "shelf-float-ends");
   gboolean islands = g_str_equal (surface, "separate");
+  gboolean span = g_settings_get_boolean (self->settings, "shelf-span-full") || !islands;
+  gboolean floating = g_settings_get_boolean (self->settings, "shelf-float-ends");
   GdkRGBA fg;
   double sw = MIN (width - 32, 300), sh = height - 24, sx = (width-sw)/2, sy = 12;
   double padding = g_settings_get_int (self->settings, "shelf-padding") * .4;
@@ -231,9 +233,26 @@
 sync_settings (CcDashPanel *self)
 {
   g_autofree char *edge = g_settings_get_string (self->settings, "shelf-edge");
-  gboolean span = g_settings_get_boolean (self->settings, "shelf-span-full");
+  g_autofree char *surface = g_settings_get_string (self->settings, "shelf-surface-mode");
+  /* Without islands the Dash is one bar the whole length of each edge it
+   * holds (Shell .119), so it always spans and Float outer edges applies. */
+  gboolean islands = g_str_equal (surface, "separate");
+  gboolean span = g_settings_get_boolean (self->settings, "shelf-span-full") || !islands;
   for (guint i = 0; i < G_N_ELEMENTS (edges); i++)
     gtk_check_button_set_active (self->positions[i], g_str_equal (edge, edges[i]));
+  if (self->span_row)
+    {
+      /* With islands the switch is the setting; without them it shows the
+       * bar as it is drawn (always spanning), and the stored choice is kept
+       * for when islands come back. */
+      self->syncing_span = TRUE;
+      adw_switch_row_set_active (self->span_row, span);
+      self->syncing_span = FALSE;
+      gtk_widget_set_sensitive (GTK_WIDGET (self->span_row), islands &&
+                                g_settings_is_writable (self->settings, "shelf-span-full"));
+      adw_action_row_set_subtitle (ADW_ACTION_ROW (self->span_row), islands ?
+        _("Stretch along the selected edge") : _("Always on when islands are off"));
+    }
   gtk_widget_set_sensitive (GTK_WIDGET (self->float_row), span &&
                             g_settings_is_writable (self->settings, "shelf-float-ends"));
   adw_action_row_set_subtitle (ADW_ACTION_ROW (self->float_row), span ?
@@ -274,6 +293,18 @@
   return g_variant_new_string (values[g_value_get_boolean (value)]);
 }
 
+static void
+span_toggled (AdwSwitchRow *row, GParamSpec *pspec, CcDashPanel *self)
+{
+  g_autofree char *surface = NULL;
+
+  if (self->syncing_span)
+    return;
+  surface = g_settings_get_string (self->settings, "shelf-surface-mode");
+  if (g_str_equal (surface, "separate"))
+    g_settings_set_boolean (self->settings, "shelf-span-full", adw_switch_row_get_active (row));
+}
+
 static AdwSwitchRow *
 add_switch (CcDashPanel *self, AdwPreferencesGroup *group, const char *title,
             const char *subtitle, const char *key, const char * const *values)
@@ -285,6 +316,9 @@
   if (values)
     g_settings_bind_with_mapping (self->settings, key, row, "active", G_SETTINGS_BIND_DEFAULT,
                                  string_to_active, active_to_string, (gpointer) values, NULL);
+  else if (g_str_equal (key, "shelf-span-full"))
+    /* Not bound: without islands the switch shows On without storing it. */
+    g_signal_connect_object (row, "notify::active", G_CALLBACK (span_toggled), self, 0);
   else
     g_settings_bind (self->settings, key, row, "active",
                      g_str_equal (key, "shelf-float-ends") ? G_SETTINGS_BIND_NO_SENSITIVITY : G_SETTINGS_BIND_DEFAULT);
@@ -419,8 +453,8 @@
   adw_preferences_group_set_title (shape, _("Shape"));
   add_switch (self, shape, _("Protrude from edge"), _("Attach the Dash to the screen edge"),
               "shelf-edge-mode", protrude_values);
-  add_switch (self, shape, _("Span full edge"), _("Stretch along the selected edge"),
-              "shelf-span-full", NULL);
+  self->span_row = add_switch (self, shape, _("Span full edge"), _("Stretch along the selected edge"),
+                               "shelf-span-full", NULL);
   self->float_row = add_switch (self, shape, _("Float outer edges"), "",
                                 "shelf-float-ends", NULL);
   /* Movable islands (ADR-044): off, an island goes beside another island or
