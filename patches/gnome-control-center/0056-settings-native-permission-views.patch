diff --git a/panels/privacy/cc-privacy-panel.c b/panels/privacy/cc-privacy-panel.c
index 4ae1421..13d3be8 100644
--- a/panels/privacy/cc-privacy-panel.c
+++ b/panels/privacy/cc-privacy-panel.c
@@ -33,6 +33,8 @@
 #include "cc-privacy-resources.h"
 #include "screen/cc-screen-page.h"
 #include "usage/cc-usage-page.h"
+#include "../../shell/cc-luma-view.h"
+#include <luma-ui.h>
 
 struct _CcPrivacyPanel
 {
@@ -44,6 +46,15 @@ struct _CcPrivacyPanel
 
 CC_PANEL_REGISTER (CcPrivacyPanel, cc_privacy_panel)
 
+static void
+microphone_failed (GtkWidget    *view,
+                   const GError *error,
+                   gpointer      unused)
+{
+  if (gtk_widget_get_root (view))
+    luma_toast_show (view, error->message, "error");
+}
+
 static const char *
 cc_privacy_panel_get_help_uri (CcPanel *panel)
 {
@@ -86,6 +97,19 @@ cc_privacy_panel_init (CcPrivacyPanel *self)
 
   gtk_widget_init_template (GTK_WIDGET (self));
 
+  /* GNOME's PermissionStore devices/microphone contract uses the same native
+   * scoped adapter as camera. Keep it reachable through upstream navigation. */
+  g_autoptr(GError) microphone_error = NULL;
+  GtkWidget *microphone = cc_luma_view_new_native_permission (CC_LUMA_PERMISSION_MICROPHONE, &microphone_error);
+  if (microphone)
+    cc_luma_view_set_error_handler (microphone, microphone_failed, NULL);
+  else {
+    microphone = gtk_label_new (microphone_error ? microphone_error->message : "Microphone permissions are unavailable");
+    luma_ui_apply_type_full (microphone, "body", FALSE); gtk_label_set_wrap (GTK_LABEL (microphone), TRUE);
+  }
+  AdwNavigationPage *microphone_page = adw_navigation_page_new (microphone, "Microphone");
+  cc_panel_add_subpage (CC_PANEL (self), "microphone", microphone_page);
+
 #ifdef BUILD_THUNDERBOLT
   CcBoltPage* bolt_page = cc_bolt_page_new ();
 
