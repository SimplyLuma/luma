             action-target: "'camera'";
           }
 
+          $CcListRow {
+            title: _("_Microphone");
+            subtitle: _("Control microphone access");
+            show-arrow: true;
+            action-name: "navigation.push";
+            action-target: "'microphone'";
+          }
+
           $CcListRow bolt_row {
             visible: false;
