diff --git a/shell/cc-luma-view-live-permission.c b/shell/cc-luma-view-live-permission.c
new file mode 100644
index 0000000..f0d8a37
--- /dev/null
+++ b/shell/cc-luma-view-live-permission.c
@@ -0,0 +1,290 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view-private.h"
+#include "cc-luma-permissions.h"
+#include "cc-luma-applications.h"
+
+#define STORE "org.freedesktop.impl.portal.PermissionStore"
+struct _CcLumaLivePermission {
+  CcLumaPreferences *prefs;
+  GDBusConnection *connection;
+  CcLumaPermission kind;
+  GCancellable *lifetime, *read, *write;
+  GVariant *snapshot, *registry;
+  char *backup, *read_error;
+  guint subscription, owner_subscription, bus_timeout;
+  guint64 epoch;
+  gboolean enabled, ready, read_done;
+  GWeakRef root;
+};
+typedef struct { GWeakRef root; guint64 epoch; GCancellable *cancel; } PermissionJob;
+static PermissionJob *job_new (View *v, GCancellable *cancel)
+{
+  PermissionJob *job = g_new0 (PermissionJob, 1); g_weak_ref_init (&job->root, v->root);
+  job->epoch = v->live_permission->epoch; job->cancel = g_object_ref (cancel); return job;
+}
+static void job_free (PermissionJob *job)
+{ g_weak_ref_clear (&job->root); g_object_unref (job->cancel); g_free (job); }
+static const char *master (CcLumaLivePermission *self)
+{ return self->kind == CC_LUMA_PERMISSION_CAMERA ? "cam" : self->kind == CC_LUMA_PERMISSION_MICROPHONE ? "mic" : "loc"; }
+static const char *native_master (CcLumaLivePermission *self)
+{ return self->kind == CC_LUMA_PERMISSION_CAMERA ? "disable-camera" : self->kind == CC_LUMA_PERMISSION_MICROPHONE ? "disable-microphone" : "enabled"; }
+CcLumaLivePermission *cc_luma_live_permission_new (CcLumaPreferences *prefs,
+  GDBusConnection *connection, CcLumaPermission kind, const char *backup, GError **error)
+{
+  if (g_getenv ("LUMA_SETTINGS_FIXTURE") || !CC_IS_LUMA_PREFERENCES (prefs) ||
+      (connection && !G_IS_DBUS_CONNECTION (connection)) || (guint) kind > CC_LUMA_PERMISSION_LOCATION ||
+      !backup || !g_path_is_absolute (backup)) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid live Settings permission binding outside fixture mode"); return NULL;
+  }
+  CcLumaLivePermission *self = g_new0 (CcLumaLivePermission, 1);
+  self->prefs = g_object_ref (prefs); self->kind = kind; self->backup = g_strdup (backup);
+  self->connection = connection ? g_object_ref (connection) : NULL;
+  self->lifetime = g_cancellable_new (); g_weak_ref_init (&self->root, NULL); return self;
+}
+void cc_luma_live_permission_free (CcLumaLivePermission *self)
+{
+  if (!self) return;
+  g_cancellable_cancel (self->lifetime);
+  if (self->read) g_cancellable_cancel (self->read);
+  if (self->write) g_cancellable_cancel (self->write);
+  if (self->bus_timeout) g_source_remove (self->bus_timeout);
+  if (self->subscription) g_dbus_connection_signal_unsubscribe (self->connection, self->subscription);
+  if (self->owner_subscription) g_dbus_connection_signal_unsubscribe (self->connection, self->owner_subscription);
+  cc_luma_preferences_stop (self->prefs); g_object_unref (self->prefs);
+  g_clear_object (&self->connection); g_clear_object (&self->read); g_clear_object (&self->write); g_object_unref (self->lifetime);
+  g_clear_pointer (&self->snapshot, g_variant_unref); g_clear_pointer (&self->registry, g_variant_unref);
+  g_weak_ref_clear (&self->root); g_free (self->backup); g_free (self->read_error); g_free (self);
+}
+static void read_start (View *v);
+static void read_finished (GObject *source, GAsyncResult *result, gpointer data)
+{
+  PermissionJob *job = data; g_autoptr(GError) error = NULL;
+  g_autoptr(GVariant) snapshot = cc_luma_permissions_read_finish (G_DBUS_CONNECTION (source), result, &error);
+  g_autoptr(GtkWidget) root = g_weak_ref_get (&job->root);
+  View *v = root ? g_object_get_data (G_OBJECT (root), "cf-view") : NULL;
+  if (v && v->live_permission && v->live_permission->epoch == job->epoch) {
+    CcLumaLivePermission *self = v->live_permission; self->read_done = TRUE;
+    g_clear_pointer (&self->snapshot, g_variant_unref); g_clear_pointer (&self->read_error, g_free);
+    if (snapshot) self->snapshot = g_variant_ref (snapshot);
+    else if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) self->read_error = g_strdup (error->message);
+    cc_luma_view_queue_refresh (v);
+  }
+  job_free (job);
+}
+static void read_start (View *v)
+{
+  CcLumaLivePermission *self = v->live_permission;
+  if (!self->connection) return;
+  if (self->read) g_cancellable_cancel (self->read);
+  g_clear_object (&self->read); self->read = g_cancellable_new (); self->epoch++;
+  self->read_done = FALSE;
+  /* Stale permissions must not stay editable during owner changes/refresh. */
+  g_clear_pointer (&self->snapshot, g_variant_unref);
+  cc_luma_permissions_read_async (self->connection, self->kind, self->read,
+    read_finished, job_new (v, self->read)); cc_luma_view_queue_refresh (v);
+}
+static void store_changed (GDBusConnection *connection, const char *sender,
+  const char *path, const char *interface, const char *signal, GVariant *parameters, gpointer data)
+{
+  CcLumaLivePermission *self = data;
+  g_autoptr(GtkWidget) root = g_weak_ref_get (&self->root);
+  View *v = root ? g_object_get_data (G_OBJECT (root), "cf-view") : NULL;
+  if (!v || v->live_permission != self) return;
+  if (g_str_equal (signal, "Changed")) {
+    if (!g_variant_is_of_type (parameters, G_VARIANT_TYPE ("(ssba{sas}v)"))) return;
+    const char *table, *id; g_variant_get_child (parameters, 0, "&s", &table); g_variant_get_child (parameters, 1, "&s", &id);
+    if (!g_str_equal (table, self->kind == CC_LUMA_PERMISSION_LOCATION ? "location" : "devices") ||
+        !g_str_equal (id, self->kind == CC_LUMA_PERMISSION_CAMERA ? "camera" : self->kind == CC_LUMA_PERMISSION_MICROPHONE ? "microphone" : "location")) return;
+  }
+  read_start (v);
+}
+static void connected (View *v)
+{
+  CcLumaLivePermission *self = v->live_permission;
+  self->subscription = g_dbus_connection_signal_subscribe (self->connection, STORE, STORE,
+    "Changed", "/org/freedesktop/impl/portal/PermissionStore", NULL, G_DBUS_SIGNAL_FLAGS_NONE, store_changed, self, NULL);
+  self->owner_subscription = g_dbus_connection_signal_subscribe (self->connection, "org.freedesktop.DBus", "org.freedesktop.DBus",
+    "NameOwnerChanged", "/org/freedesktop/DBus", STORE, G_DBUS_SIGNAL_FLAGS_NONE, store_changed, self, NULL);
+  read_start (v);
+}
+static void bus_finished (GObject *source, GAsyncResult *result, gpointer data)
+{
+  PermissionJob *job = data; g_autoptr(GError) error = NULL;
+  g_autoptr(GDBusConnection) connection = g_bus_get_finish (result, &error);
+  g_autoptr(GtkWidget) root = g_weak_ref_get (&job->root);
+  View *v = root ? g_object_get_data (G_OBJECT (root), "cf-view") : NULL;
+  if (v && v->live_permission) {
