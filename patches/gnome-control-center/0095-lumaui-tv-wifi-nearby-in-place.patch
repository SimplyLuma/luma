+/* The page's words in order: two drawings of the same state read the same. */
+static void words (GtkWidget *w, GString *out)
+{
+  if (!gtk_widget_get_visible (w)) return;
+  if (GTK_IS_LABEL (w)) { g_string_append (out, gtk_label_get_text (GTK_LABEL (w))); g_string_append_c (out, '\n'); }
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c)) words (c, out);
+}
+/* A scan's report (signal, order, networks coming and going) updates the Nearby list in place:
+ * unchanged rows are the same widgets, and the page reads exactly as one drawn afresh. */
+static void nearby_in_place (void)
+{
+  g_autoptr (CcLumaFixture) model = load ();
+  GtkWidget *view = g_object_ref_sink (cc_luma_view_new (model, "wifi", NULL));
+  drain ();
+  JsonArray *nets = json_object_get_array_member (cc_luma_fixture_get_data (model), "CFNETS");
+  const char *net = json_node_get_string (cc_luma_fixture_get (model, "net"));
+  g_autoptr (GPtrArray) names = g_ptr_array_new_with_free_func (g_free);
+  for (guint i = 0; i < json_array_get_length (nets); i++)
+    {
+      const char *n = json_object_get_string_member (json_array_get_object_element (nets, i), "n");
+      if (!g_str_equal (n, net)) g_ptr_array_add (names, g_strdup (n));
+    }
+  g_assert_cmpuint (names->len, >=, 3);
+  const char *kept = names->pdata[0], *changed = names->pdata[1], *gone = names->pdata[2];
+  GtkWidget *kept_row = find_network (view, kept), *changed_row = find_network (view, changed);
+  g_assert_nonnull (kept_row);
+  /* the next scan: reversed, one weaker, one gone, one new */
+  g_autoptr (JsonNode) next = json_node_new (JSON_NODE_ARRAY);
+  JsonArray *list = json_array_new ();
+  for (guint i = json_array_get_length (nets); i-- > 0;)
+    {
+      JsonObject *n = json_array_get_object_element (nets, i);
+      const char *name = json_object_get_string_member (n, "n");
+      if (g_str_equal (name, gone)) continue;
+      JsonNode *copy = json_node_copy (json_array_get_element (nets, i));
+      if (g_str_equal (name, changed))
+        json_object_set_int_member (json_node_get_object (copy), "sig", json_object_get_int_member (n, "sig") > 1 ? 1 : 4);
+      json_array_add_element (list, copy);
+    }
+  JsonObject *fresh = json_object_new ();
+  json_object_set_string_member (fresh, "n", "Luma Test Network");
+  json_object_set_int_member (fresh, "sig", 2);
+  json_object_set_boolean_member (fresh, "lock", TRUE);
+  json_array_add_object_element (list, fresh);
+  json_node_take_array (next, list);
+  /* every network can be shared (the model's own rule for a valid page) */
+  JsonObject *codes = json_object_get_object_member (json_object_get_object_member (cc_luma_fixture_get_data (model), "CFWIFI"), "share_codes");
+  json_object_set_string_member (codes, "Luma Test Network", "WIFI:T:WPA;S:Luma Test Network;P:test;;");
+  cc_luma_fixture_publish_data (model, "CFNETS", next);
+  cc_luma_view_refresh (view); /* a live owner's report refreshes the view the same way */
+  drain (); drain ();
+  g_assert_true (find_network (view, kept) == kept_row);          /* the same widget, kept */
+  g_assert_true (find_network (view, changed) != changed_row);    /* redrawn where it stands */
+  g_assert_null (find_network (view, gone));
+  g_assert_nonnull (find_network (view, "Luma Test Network"));
+  GtkWidget *drawn = g_object_ref_sink (cc_luma_view_new (model, "wifi", NULL));
+  drain ();
+  g_autoptr (GString) a = g_string_new (NULL), b = g_string_new (NULL);
+  words (view, a); words (drawn, b);
+  g_assert_cmpstr (a->str, ==, b->str);
+  g_object_unref (drawn);
+  g_object_unref (view);
+  drain ();
+}
