+/* A scan's report changes only the Nearby list most of the time (signal, order, networks coming
+ * and going). Rebuilding the whole page for it redrew every widget, lost the focused row and
+ * re-laid the page out, on every desktop and on a TV alike. The page's other inputs are this
+ * signature; while it holds, the list is updated in place (wifi_update_nearby). */
+static char *wifi_signature (View *v)
+{
+  JsonObject *data = cc_luma_fixture_get_data (v->model);
+  JsonObject *wifi_data = json_object_get_object_member (data, "CFWIFI");
+  JsonArray *nets = json_object_get_array_member (data, "CFNETS");
+  JsonArray *known = json_object_get_array_member (data, "CFKNOWN");
+  const char *network = cc_luma_view_text (v, "net");
+  g_autoptr (GString) sig = g_string_new (NULL);
+  g_string_append_printf (sig, "%d|%d|%d|%d|%s|%s|%s|%s|%s|%u|%d|%d|%d|%s|%s|%s|%s",
+    cc_luma_view_flag (v, "wifi"), cc_luma_fixture_is_live (v->model),
+    wifi_data ? json_object_get_boolean_member_with_default (wifi_data, "present", FALSE) : -1,
+    wifi_data ? json_object_get_boolean_member_with_default (wifi_data, "hardwareEnabled", TRUE) : -1,
+    cc_luma_view_flag (v, "wifiConnecting") ? "c" : "", network, cc_luma_view_text (v, "metered"),
+    cc_luma_view_text (v, "netError"), cc_luma_view_text (v, "netStatus"), json_array_get_length (known),
+    cc_luma_view_flag (v, "hotspot"), cc_luma_fixture_get (v->model, "airplane") != NULL,
+    cc_luma_fixture_get (v->model, "airplane") ? cc_luma_view_flag (v, "airplane") : -1,
+    v->connecting ? v->connecting : "", v->joining ? v->joining : "",
+    cc_luma_view_text (v, "joinFailed"), cc_luma_view_text (v, "joinDone"));
+  g_string_append_printf (sig, "|%d", v->phone);
+  /* the connected network's own line (the hero) */
+  for (guint i = 0; nets && i < json_array_get_length (nets); i++)
+    {
+      JsonObject *n = json_array_get_object_element (nets, i);
+      if (g_str_equal (json_object_get_string_member (n, "n"), network))
+        g_string_append_printf (sig, "|%" G_GINT64_FORMAT "|%d", json_object_get_int_member (n, "sig"), json_object_get_boolean_member (n, "lock"));
+    }
+  return g_string_free (g_steal_pointer (&sig), FALSE);
+}
+/* What a nearby network's row shows: a row whose key is unchanged is kept as it is. */
+static char *nearby_key (View *v, JsonObject *network)
+{
+  const char *name = json_object_get_string_member (network, "n");
+  return g_strdup_printf ("%s|%" G_GINT64_FORMAT "|%d|%d|%d|%d", name, json_object_get_int_member (network, "sig"),
+    json_object_get_boolean_member (network, "lock"),
+    json_object_has_member (network, "known") && json_object_get_boolean_member (network, "known"),
+    json_object_has_member (network, "ent") && json_object_get_boolean_member (network, "ent"),
+    g_strcmp0 (v->connecting, name) == 0);
+}
