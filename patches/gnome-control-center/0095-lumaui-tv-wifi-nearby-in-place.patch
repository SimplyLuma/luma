+/* The Nearby list brought up to date in place: rows whose network and what it shows are unchanged
+ * are kept (and with them the focus, the scroll and every drawn node), changed rows are replaced
+ * where they stand, new ones added, gone ones removed, and the order follows the scan. FALSE when
+ * anything else on the page changed: the page is then drawn afresh. */
+static gboolean wifi_update_nearby (View *v)
+{
+  if (!v->wifi_near || !g_str_equal (v->page, "wifi") || (v->query && *v->query) || v->live_lock || v->live_permission)
+    return FALSE;
+  g_autofree char *sig = wifi_signature (v);
+  if (g_strcmp0 (sig, v->wifi_sig) != 0)
+    return FALSE;
+  GtkBox *near = GTK_BOX (v->wifi_near);
+  JsonArray *nets = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFNETS");
+  const char *network = cc_luma_view_text (v, "net");
+  g_autoptr (GHashTable) rows = g_hash_table_new (g_str_hash, g_str_equal);
+  GtkWidget *tail = NULL; /* the rows after the networks (Hidden network) stay last */
+  for (GtkWidget *c = gtk_widget_get_first_child (GTK_WIDGET (near)); c; c = gtk_widget_get_next_sibling (c))
+    {
+      const char *name = g_object_get_data (G_OBJECT (c), "cf-nearby-name");
+      if (name) g_hash_table_insert (rows, (gpointer) name, c);
+      else if (!tail) tail = c;
+    }
+  GtkWidget *previous = NULL;
+  g_autoptr (GHashTable) kept = g_hash_table_new (g_direct_hash, g_direct_equal);
+  for (guint i = 0; nets && i < json_array_get_length (nets); i++)
+    {
+      JsonObject *n = json_array_get_object_element (nets, i);
+      const char *name = json_object_get_string_member (n, "n");
+      if (g_str_equal (name, network)) continue;
+      GtkWidget *row = g_hash_table_lookup (rows, name);
+      g_autofree char *key = nearby_key (v, n);
+      if (row && g_hash_table_contains (kept, row)) continue; /* the same name twice in a scan */
+      if (!row || g_strcmp0 (g_object_get_data (G_OBJECT (row), "cf-nearby-key"), key) != 0)
+        {
+          /* new, or showing something new: drawn as the full page would draw it, in its place */
+          GtkWidget *scratch = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+          g_object_ref_sink (scratch);
+          nearby_row (v, GTK_BOX (scratch), n);
+          GtkWidget *fresh = g_object_ref (gtk_widget_get_first_child (scratch));
+          gtk_box_remove (GTK_BOX (scratch), fresh);
+          g_object_unref (scratch);
+          gtk_box_insert_child_after (near, fresh, previous);
+          cf_rows_prepare (v, fresh);
+          g_object_unref (fresh);
+          if (row) gtk_box_remove (near, row);
+          row = fresh;
+        }
+      else if (gtk_widget_get_prev_sibling (row) != previous)
+        gtk_box_reorder_child_after (near, row, previous);
+      g_hash_table_add (kept, row);
+      previous = row;
+    }
+  for (GtkWidget *c = gtk_widget_get_first_child (GTK_WIDGET (near)), *next; c; c = next)
+    {
+      next = gtk_widget_get_next_sibling (c);
+      if (g_object_get_data (G_OBJECT (c), "cf-nearby-name") && !g_hash_table_contains (kept, c))
+        gtk_box_remove (near, c);
+    }
+  if (tail && gtk_widget_get_prev_sibling (tail) != previous)
+    gtk_box_reorder_child_after (near, tail, previous);
+  /* the header's count, as the page would say it */
+  if (v->subtitle && cc_luma_view_flag (v, "wifi") && !*network)
+    {
+      g_autofree char *meta = g_strdup_printf ("%u networks nearby", json_array_get_length (nets));
+      gtk_label_set_text (v->subtitle, meta);
+    }
+  return TRUE;
+}
