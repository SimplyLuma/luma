+/* Arm reports no model name in /proc/cpuinfo: the core's part number, named, and the count
+ * ("Cortex-A76 × 4"), as the desktop shows "Intel Core Ultra 7 155U × 14". */
+static char *
+arm_cpu_name (void)
+{
+  static const struct { guint part; const char *name; } parts[] = {
+    { 0xd03, "Cortex-A53" }, { 0xd04, "Cortex-A35" }, { 0xd05, "Cortex-A55" }, { 0xd07, "Cortex-A57" },
+    { 0xd08, "Cortex-A72" }, { 0xd09, "Cortex-A73" }, { 0xd0a, "Cortex-A75" }, { 0xd0b, "Cortex-A76" },
+    { 0xd0d, "Cortex-A77" }, { 0xd41, "Cortex-A78" }, { 0xd44, "Cortex-X1" }, { 0xd46, "Cortex-A510" },
+    { 0xd47, "Cortex-A710" }, { 0xd48, "Cortex-X2" }, { 0xd4d, "Cortex-A715" }, { 0xd4e, "Cortex-X3" },
+    { 0xd80, "Cortex-A520" }, { 0xd81, "Cortex-A720" }, { 0xd82, "Cortex-X4" },
+  };
+  g_autofree char *info = NULL;
+  if (!g_file_get_contents ("/proc/cpuinfo", &info, NULL, NULL)) return g_strdup ("");
+  guint part = 0, count = 0;
+  g_auto (GStrv) lines = g_strsplit (info, "\n", -1);
+  for (guint i = 0; lines[i]; i++)
+    if (g_str_has_prefix (lines[i], "CPU part"))
+      {
+        const char *colon = strchr (lines[i], ':');
+        if (colon) part = (guint) g_ascii_strtoull (colon + 1, NULL, 0);
+        count++;
+      }
+  for (guint i = 0; part && i < G_N_ELEMENTS (parts); i++)
+    if (parts[i].part == part)
+      return count > 1 ? g_strdup_printf ("%s × %u", parts[i].name, count) : g_strdup (parts[i].name);
+  return g_strdup ("");
+}
