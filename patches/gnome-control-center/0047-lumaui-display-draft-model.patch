diff --git a/shell/test-luma-fixture.c b/shell/test-luma-fixture.c
index aaabc7f..03a6359 100644
--- a/shell/test-luma-fixture.c
+++ b/shell/test-luma-fixture.c
@@ -3,6 +3,7 @@
 #include "cc-luma-bluetooth.h"
 #include "cc-luma-desktop.h"
 #include "cc-luma-discovery.h"
+#include "cc-luma-displays.h"
 #include <gio/gio.h>
 
 static const char fixture[] = "{\"version\":1,\"settings\":{\"wifi\":true,\"d\":{\"ext\":{\"scale\":\"150\"}},\"vol\":62},\"data\":{\"CFAPPS\":[\"tide\"]},\"pages\":[{\"id\":\"wifi\"}]}";
@@ -318,6 +319,60 @@ static void discovery_model (void)
   g_assert_false (cc_luma_search_set_app (model, "filer", TRUE, NULL));
   g_assert_false (json_array_get_boolean_element (json_array_get_array_element (initial, 0), 1));
 }
+static void display_model (void)
+{
+  g_autoptr (CcLumaFixture) model = cc_luma_fixture_load (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), NULL);
+  g_assert_true (cc_luma_displays_validate (model));
+  CcLumaDisplayDraft *draft = cc_luma_display_draft_new (model);
+  const char *sides[] = { "top", "left", "right" }, *rotations[] = { "Landscape", "Portrait right", "Portrait left", "Landscape, flipped" }, *scales[] = { "100", "125", "150", "175", "200" };
+  for (guint i = 0; i < G_N_ELEMENTS (sides); i++)
+    for (guint j = 0; j < G_N_ELEMENTS (rotations); j++)
+      for (guint k = 0; k < G_N_ELEMENTS (scales); k++) {
+        g_autoptr (JsonNode) side = json_node_init_string (json_node_alloc (), sides[i]);
+        g_autoptr (JsonNode) rotation = json_node_init_string (json_node_alloc (), rotations[j]);
+        g_autoptr (JsonNode) scale = json_node_init_string (json_node_alloc (), scales[k]);
+        g_assert_true (cc_luma_display_draft_set (draft, "arr.side", side, NULL));
+        g_assert_true (cc_luma_display_draft_set (draft, "d.ext.rot", rotation, NULL));
+        g_assert_true (cc_luma_display_draft_set (draft, "d.ext.scale", scale, NULL));
+        CcLumaPreviewRect rects[2]; g_assert_true (cc_luma_displays_rects (model, rects, NULL));
+        for (guint n = 0; n < 2; n++) {
+          g_assert_cmpfloat (rects[n].x, >=, 0); g_assert_cmpfloat (rects[n].y, >=, 0);
+          g_assert_cmpfloat (rects[n].width, >, 0); g_assert_cmpfloat (rects[n].height, >, 0);
+          g_assert_cmpfloat (rects[n].x + rects[n].width, <=, 560);
+          g_assert_cmpfloat (rects[n].y + rects[n].height, <=, 216);
+        }
+        g_assert_true (rects[0].x + rects[0].width <= rects[1].x || rects[1].x + rects[1].width <= rects[0].x || rects[0].y + rects[0].height <= rects[1].y || rects[1].y + rects[1].height <= rects[0].y);
+      }
+  g_assert_true (cc_luma_display_draft_revert (draft, NULL));
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "d.ext.scale")), ==, "150");
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "arr.side")), ==, "top");
+  g_autoptr (JsonNode) scale = json_node_init_string (json_node_alloc (), "200");
+  g_assert_true (cc_luma_display_draft_set (draft, "d.ext.scale", scale, NULL));
+  for (guint i = 0; i < 14; i++) g_assert_true (cc_luma_display_draft_tick (draft, NULL));
+  g_assert_cmpuint (cc_luma_display_draft_remaining (draft), ==, 1);
+  json_node_set_string (scale, "175");
+  g_assert_true (cc_luma_display_draft_set (draft, "d.ext.scale", scale, NULL));
+  g_assert_cmpuint (cc_luma_display_draft_remaining (draft), ==, 15);
+  g_assert_true (cc_luma_fixture_set_flag (model, "wifi", FALSE, NULL));
+  for (guint i = 0; i < 15; i++) g_assert_true (cc_luma_display_draft_tick (draft, NULL));
+  g_assert_cmpuint (cc_luma_display_draft_remaining (draft), ==, 0);
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "d.ext.scale")), ==, "150");
+  g_assert_false (json_node_get_boolean (cc_luma_fixture_get (model, "wifi")));
+  g_autoptr (JsonNode) on = json_node_init_boolean (json_node_alloc (), TRUE);
+  g_assert_true (cc_luma_display_draft_set (draft, "d.int.primary", on, NULL));
+  g_assert_false (json_node_get_boolean (cc_luma_fixture_get (model, "d.ext.primary")));
+  cc_luma_display_draft_keep (draft);
+  g_assert_true (cc_luma_display_draft_set (draft, "d.ext.primary", on, NULL));
+  g_assert_true (cc_luma_display_draft_revert (draft, NULL));
+  g_assert_true (json_node_get_boolean (cc_luma_fixture_get (model, "d.int.primary")));
+  json_node_set_string (scale, "999");
+  g_assert_false (cc_luma_display_draft_set (draft, "d.ext.scale", scale, NULL));
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "d.ext.scale")), ==, "150");
+  g_assert_cmpuint (cc_luma_display_draft_remaining (draft), ==, 0);
+  g_assert_false (cc_luma_display_draft_set (draft, "wifi", on, NULL));
+  g_assert_false (json_node_get_boolean (cc_luma_fixture_get (model, "wifi")));
+  cc_luma_display_draft_free (draft);
+}
 int main (int argc, char **argv)
 {
   g_test_init (&argc, &argv, NULL);
@@ -336,6 +391,7 @@ int main (int argc, char **argv)
       g_test_add_func ("/settings/fixture/shelf", shelf_model);
       g_test_add_func ("/settings/fixture/appearance", appearance_model);
       g_test_add_func ("/settings/fixture/discovery", discovery_model);
+      g_test_add_func ("/settings/fixture/displays", display_model);
     }
   return g_test_run ();
 }
