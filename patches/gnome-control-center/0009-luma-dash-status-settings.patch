+/* A compact illustration of the live status choices inside the same preview.
+ * It uses sample clock text, never fabricated machine status. */
+static void
+preview_status (CcDashPanel *self, cairo_t *cr, double cx, double cy, gboolean vertical)
+{
+  g_autofree char *scope = g_settings_get_string (self->settings, "status-frame-scope");
+  g_autofree char *frame = g_settings_get_string (self->settings, "status-frame");
+  g_autofree char *strength = g_settings_get_string (self->settings, "status-fill-strength");
+  g_autofree char *material = g_settings_get_string (self->settings, "shelf-material");
+  gboolean light = g_str_equal (material, "light") || g_str_equal (material, "frost");
+  gboolean flush = g_str_equal (scope, "flush");
+  gboolean joined = flush || g_str_equal (scope, "joined");
+  gboolean fill = flush || g_str_equal (frame, "fill") || g_str_equal (frame, "both");
+  gboolean stroke = !flush && (g_str_equal (frame, "stroke") || g_str_equal (frame, "both"));
+  gboolean right = g_settings_get_boolean (self->settings, "status-controls-right");
+  gboolean rtl = gtk_widget_get_direction (GTK_WIDGET (self)) == GTK_TEXT_DIR_RTL;
+  double pad = g_settings_get_int (self->settings, "shelf-padding");
+  double gap = joined ? 0 : 7, clock = vertical ? 62 : 70, controls = 36;
+  double length = clock + controls + gap + 2*pad, thickness = 36 + 2*pad;
+  double w = vertical ? thickness : length, h = vertical ? length : thickness;
+  cairo_save (cr);
+  cairo_translate (cr, cx-w/2, cy-h/2);
+  rounded_rect (cr, 0, 0, w, h, 15);
+  cairo_clip (cr);
+  cairo_set_source_rgb (cr, light ? .93 : .13, light ? .94 : .15, light ? .95 : .17);
+  cairo_paint (cr);
+  if (fill && g_str_equal (scope, "all"))
+    {
+      g_autofree char *color = g_settings_get_string (self->settings, "status-clock-fill");
+      GdkRGBA tint;
+      if (strlen (color) != 7 || color[0] != '#' || !gdk_rgba_parse (&tint, color))
+        gdk_rgba_parse (&tint, "#7f8892");
+      rounded_rect (cr, pad, pad, w-2*pad, h-2*pad, 10);
+      cairo_set_source_rgba (cr, tint.red, tint.green, tint.blue, atoi (strength)/100.);
+      cairo_fill (cr);
+    }
+  gboolean clock_first = vertical ? right : right != rtl;
+  double start = flush ? 0 : pad;
+  for (guint i = 0; i < 2; i++)
+    {
+      gboolean is_clock = (i == 0) == clock_first;
+      double len = (is_clock ? clock : controls) + (flush ? pad : 0);
+      double x = vertical ? (flush ? 0 : pad) : start;
+      double y = vertical ? start : (flush ? 0 : pad);
+      double pw = vertical ? (flush ? thickness : 36) : len;
+      double ph = vertical ? len : (flush ? thickness : 36);
+      gboolean framed = joined || g_str_equal (scope, "split") ||
+                         (!is_clock && g_str_equal (scope, "controls"));
+      g_autofree char *color = g_settings_get_string (self->settings,
+        is_clock ? "status-clock-fill" : "status-controls-fill");
+      GdkRGBA tint;
+      if (strlen (color) != 7 || color[0] != '#' || !gdk_rgba_parse (&tint, color))
+        gdk_rgba_parse (&tint, "#7f8892");
+      if (fill && framed)
+        {
+          rounded_rect (cr, x, y, pw, ph, joined ? 0 : 10);
+          cairo_set_source_rgba (cr, tint.red, tint.green, tint.blue, atoi (strength)/100.);
+          cairo_fill (cr);
+        }
+      if (stroke && framed)
+        {
+          rounded_rect (cr, x+.5, y+.5, pw-1, ph-1, joined ? 0 : 10);
+          cairo_set_source_rgba (cr, light ? .1 : 1, light ? .1 : 1, light ? .1 : 1, light ? .14 : .16);
+          cairo_stroke (cr);
+        }
+      cairo_set_source_rgb (cr, light ? .1 : .9, light ? .1 : .9, light ? .1 : .9);
+      if (is_clock)
+        {
+          cairo_text_extents_t ext;
+          int ts = g_settings_get_int (self->settings, "status-time-size");
+          int ds = g_settings_get_int (self->settings, "status-date-size");
+          cairo_select_font_face (cr, "Figtree", CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_BOLD);
+          cairo_set_font_size (cr, ts);
+          const char *time = vertical ? "12:41" : "12:41 PM";
+          cairo_text_extents (cr, time, &ext);
+          cairo_move_to (cr, x+(pw-ext.width)/2-ext.x_bearing, y+ph/2-3);
+          cairo_show_text (cr, time);
+          cairo_set_font_size (cr, ds);
+          const char *date = vertical ? "Mon 7" : "Mon Sep 7";
+          cairo_text_extents (cr, date, &ext);
+          cairo_move_to (cr, x+(pw-ext.width)/2-ext.x_bearing, y+ph/2+ds);
+          cairo_show_text (cr, date);
+        }
+      else
+        for (guint k = 0; k < 4; k++)
+          {
+            double gx = x+(pw-29)/2+(k%2)*16, gy = y+(ph-29)/2+(k/2)*16;
+            if (g_settings_get_boolean (self->settings, "status-glyph-tiles"))
+              {
+                rounded_rect (cr, gx, gy, 13, 13, 3);
+                cairo_set_source_rgba (cr, light ? .1 : 1, light ? .1 : 1, light ? .1 : 1, light ? .05 : .08);
+                cairo_fill (cr);
+              }
+            cairo_set_source_rgba (cr, light ? .1 : .9, light ? .1 : .9, light ? .1 : .9, .8);
+            cairo_arc (cr, gx+6.5, gy+6.5, 3.5, 0, 2*G_PI);
+            cairo_stroke (cr);
+          }
+      if (i == 0 && g_settings_get_boolean (self->settings, "status-divider") &&
+          (!g_str_equal (frame, "none") || flush))
+        {
+          cairo_set_source_rgba (cr, light ? .1 : 1, light ? .1 : 1, light ? .1 : 1, .16);
+          if (vertical) { cairo_move_to (cr, x, y+ph+gap/2); cairo_line_to (cr, x+pw, y+ph+gap/2); }
+          else { cairo_move_to (cr, x+pw+gap/2, y); cairo_line_to (cr, x+pw+gap/2, y+ph); }
+          cairo_stroke (cr);
+        }
+      start += len+gap;
+    }
+  if (g_str_equal (scope, "all") && (stroke || fill))
+    {
+      rounded_rect (cr, pad+.5, pad+.5, w-2*pad-1, h-2*pad-1, 10);
+      if (stroke) { cairo_set_source_rgba (cr, light ? .1 : 1, light ? .1 : 1, light ? .1 : 1, .16); cairo_stroke (cr); }
+      else cairo_new_path (cr);
+    }
+  cairo_restore (cr);
 }
 
