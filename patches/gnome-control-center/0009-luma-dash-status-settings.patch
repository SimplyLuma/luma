+static gboolean
+string_to_index (GValue *value, GVariant *variant, gpointer data)
+{
+  const char * const *values = data;
+  for (guint i = 0; values[i]; i++)
+    if (g_str_equal (g_variant_get_string (variant, NULL), values[i]))
+      { g_value_set_uint (value, i); return TRUE; }
+  return FALSE;
+}
+
+static GVariant *
+index_to_string (const GValue *value, const GVariantType *type, gpointer data)
+{
+  const char * const *values = data;
+  guint index = g_value_get_uint (value);
+  for (guint i = 0; values[i]; i++)
+    if (i == index) return g_variant_new_string (values[i]);
+  return NULL;
+}
+
+static void
+add_choice (CcDashPanel *self, AdwPreferencesGroup *group, const char *title,
+            const char *key, const char * const *values, const char * const *labels)
+{
+  g_autoptr(GtkStringList) model = gtk_string_list_new (labels);
+  AdwComboRow *row = ADW_COMBO_ROW (adw_combo_row_new ());
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), title);
+  adw_combo_row_set_model (row, G_LIST_MODEL (model));
+  g_settings_bind_with_mapping (self->settings, key, row, "selected", G_SETTINGS_BIND_DEFAULT,
+                               string_to_index, index_to_string, (gpointer) values, NULL);
+  adw_preferences_group_add (group, GTK_WIDGET (row));
+}
+
+static GVariant *
+hex_to_setting (const GValue *value, const GVariantType *type, gpointer data)
+{
+  const char *text = g_value_get_string (value);
+  gboolean valid = text && strlen (text) == 7 && text[0] == '#';
+  for (guint i = 1; valid && i < 7; i++) valid = g_ascii_isxdigit (text[i]);
+  if (valid) gtk_widget_remove_css_class (GTK_WIDGET (data), "error");
+  else gtk_widget_add_css_class (GTK_WIDGET (data), "error");
+  return valid ? g_variant_new_string (text) : NULL;
+}
+
+static void
+add_color (CcDashPanel *self, AdwPreferencesGroup *group, const char *title, const char *key)
+{
+  AdwEntryRow *row = ADW_ENTRY_ROW (adw_entry_row_new ());
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), title);
+  gtk_widget_set_tooltip_text (GTK_WIDGET (row), _("A six-digit colour, such as #7f8892"));
+  g_settings_bind_with_mapping (self->settings, key, row, "text", G_SETTINGS_BIND_DEFAULT,
+                               NULL, hex_to_setting, row, NULL);
+  adw_preferences_group_add (group, GTK_WIDGET (row));
+}
+
+static void
+add_size (CcDashPanel *self, AdwPreferencesGroup *group, const char *title,
+          const char *key, double min, double max)
+{
+  AdwSpinRow *row = ADW_SPIN_ROW (adw_spin_row_new_with_range (min, max, 1));
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), title);
+  g_settings_bind (self->settings, key, row, "value", G_SETTINGS_BIND_DEFAULT);
+  adw_preferences_group_add (group, GTK_WIDGET (row));
 }
 
