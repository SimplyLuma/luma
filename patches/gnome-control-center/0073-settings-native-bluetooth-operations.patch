+/* Device rows retain identity across owner reports. A fresh device or changed
+ * state replaces only its row, rather than allocating the discovery list again.
+ * The view owns this cache and prunes devices the real owner removed. */
+typedef struct { GtkWidget *widget; char *signature; gboolean seen; } BtRow;
+static void row_free (BtRow *row) { g_object_unref (row->widget); g_free (row->signature); g_free (row); }
+static GHashTable *row_cache (View *v) {
+  GHashTable *cache = g_object_get_data (G_OBJECT (v->root), "cf-bt-rows");
+  if (!cache) {
+    cache = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, (GDestroyNotify) row_free);
+    g_object_set_data_full (G_OBJECT (v->root), "cf-bt-rows", cache, (GDestroyNotify) g_hash_table_unref);
+  }
+  return cache;
+}
+static char *row_signature (JsonObject *device) {
+  g_autoptr (JsonNode) node = json_node_init_object (json_node_alloc (), device);
+  return json_to_string (node, FALSE);
+}
+static GtkWidget *row_lookup (View *v, JsonObject *device, gboolean saved) {
+  g_autofree char *id = g_strconcat (saved ? "saved:" : "near:", json_object_get_string_member (device, "id"), NULL);
+  g_autofree char *signature = row_signature (device);
+  BtRow *row = g_hash_table_lookup (row_cache (v), id);
+  if (!row || g_strcmp0 (row->signature, signature)) return NULL;
+  /* GTK may retain the old layout for a frame after its body is removed.
+   * Move the owned row through its actual container API before reattaching. */
+  GtkWidget *parent = gtk_widget_get_parent (row->widget);
+  if (GTK_IS_GRID (parent)) gtk_grid_remove (GTK_GRID (parent), row->widget);
+  else if (GTK_IS_BOX (parent)) gtk_box_remove (GTK_BOX (parent), row->widget);
+  else if (parent) return NULL;
+  row->seen = TRUE;
+  return row->widget;
+}
+static void row_remember (View *v, JsonObject *device, gboolean saved, GtkWidget *widget) {
+  char *id = g_strconcat (saved ? "saved:" : "near:", json_object_get_string_member (device, "id"), NULL);
+  BtRow *row = g_new0 (BtRow, 1);row->widget = g_object_ref_sink (widget);row->signature = row_signature (device);row->seen = TRUE;
+  g_hash_table_replace (row_cache (v), id, row);
+}
+static gboolean unused_row (gpointer key, gpointer value, gpointer data) { return !((BtRow *) value)->seen; }
+static void reset_seen (gpointer key, gpointer value, gpointer data) { ((BtRow *) value)->seen = FALSE; }
