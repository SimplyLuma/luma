 {
   JsonArray *saved = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFBT");
@@ -258,6 +293,7 @@
   guint connected_count = 0, shown;
   gboolean live = cc_luma_fixture_is_live (v->model), on = cc_luma_view_flag (v, "bt");
   GtkWidget *hero_body;
+  g_hash_table_foreach (row_cache (v), reset_seen, NULL);
