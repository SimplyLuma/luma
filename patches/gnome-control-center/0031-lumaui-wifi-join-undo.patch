 }
+static GtkWidget *find_network (GtkWidget *root, const char *name)
+{
+  const char *network = g_object_get_data (G_OBJECT (root), "cf-network");
+  if (g_strcmp0 (network, name) == 0) return root;
+  for (GtkWidget *w = gtk_widget_get_first_child (root); w; w = gtk_widget_get_next_sibling (w))
+    {
+      GtkWidget *found = find_network (w, name);
+      if (found) return found;
+    }
+  return NULL;
+}
+static void drain (void) { while (g_main_context_iteration (NULL, FALSE)) {} }
+static void nearby_join (void)
+{
+  g_autoptr (CcLumaFixture) model = load ();
+  GtkWidget *view = g_object_ref_sink (cc_luma_view_new (model, "wifi", NULL));
+  JsonArray *nets = json_object_get_array_member (cc_luma_fixture_get_data (model), "CFNETS");
+  const char *locked = NULL;
+  for (guint i = 0; i < json_array_get_length (nets); i++)
+    {
+      JsonObject *n = json_array_get_object_element (nets, i);
+      if (json_object_get_boolean_member (n, "lock") &&
+          (!json_object_has_member (n, "known") || !json_object_get_boolean_member (n, "known")))
+        { locked = json_object_get_string_member (n, "n"); break; }
+    }
+  g_assert_nonnull (locked);
+  g_signal_emit_by_name (find_network (view, locked), "clicked"); drain ();
+  g_assert_nonnull (find_name (view, "cf-join-password"));
+  g_assert_false (gtk_entry_get_visibility (GTK_ENTRY (find_name (view, "cf-join-password"))));
+  /* A second click cancels the form without saving a credential or connecting. */
+  g_signal_emit_by_name (find_network (view, locked), "clicked"); drain ();
+  g_assert_null (find_name (view, "cf-join-form"));
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "net")), ==, "Studio North");
+  g_signal_emit_by_name (find_network (view, "Studio North Guest"), "clicked"); drain ();
+  g_assert_true (has_text (view, "Connecting…"));
+  gint64 deadline = g_get_monotonic_time () + 1600 * 1000;
+  while (g_get_monotonic_time () < deadline) { drain (); g_usleep (1000); }
+  drain ();
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "net")), ==, "Studio North Guest");
+  g_assert_true (has_text (view, "Connected to Studio North Guest"));
+  /* Destroy with another connection timer outstanding: no late access to View. */
+  g_signal_emit_by_name (find_network (view, "Studio North"), "clicked");
+  g_object_unref (view); drain ();
+}
+static void turn_on (void)
+{
+  g_autoptr (CcLumaFixture) model = load ();
+  g_assert_true (cc_luma_fixture_set_flag (model, "airplane", TRUE, NULL));
+  GtkWidget *view = g_object_ref_sink (cc_luma_view_new (model, "wifi", NULL));
+  g_signal_emit_by_name (find_name (view, "cf-wifi-on"), "clicked"); drain ();
+  g_assert_true (json_node_get_boolean (cc_luma_fixture_get (model, "wifi")));
+  g_assert_false (json_node_get_boolean (cc_luma_fixture_get (model, "airplane")));
+  g_assert_false (json_node_get_boolean (cc_luma_fixture_get (model, "bt")));
+  g_assert_nonnull (find_network (view, "Studio North Guest"));
+  g_object_unref (view);
+}
 int main (int argc, char **argv)
 {
   g_test_init (&argc, &argv, NULL);
@@ -105,5 +161,7 @@ int main (int argc, char **argv)
   g_test_add_func ("/settings/view/cancel-pending-refresh", cancel_pending_refresh);
   g_test_add_func ("/settings/view/picker-binding", picker_binding);
   g_test_add_func ("/settings/view/missing-share-artwork", missing_share_artwork);
+  g_test_add_func ("/settings/view/nearby-join", nearby_join);
+  g_test_add_func ("/settings/view/turn-on", turn_on);
   return g_test_run ();
 }
