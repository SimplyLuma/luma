@@ -98,6 +98,31 @@ networks (void)
   g_assert_false (cc_luma_fixture_forget_network (model, "invented network", &error));
   g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
 }
+static void network_undo (void)
+{
+  g_autoptr (CcLumaFixture) model = cc_luma_fixture_load (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), NULL);
+  g_autoptr (GError) error = NULL;
+  CcLumaNetworkUndo *undo = cc_luma_fixture_forget_with_undo (model, "Studio North", &error);
+  g_assert_no_error (error); g_assert_nonnull (undo);
+  /* A newer connection and newly saved network must survive Undo. */
+  g_assert_true (cc_luma_fixture_connect_network (model, "Priya’s phone", NULL));
+  g_assert_true (cc_luma_network_undo_restore (undo, &error));
+  g_assert_no_error (error);
+  JsonArray *known = json_object_get_array_member (cc_luma_fixture_get_data (model), "CFKNOWN");
+  g_assert_cmpuint (json_array_get_length (known), ==, 7);
+  g_assert_cmpstr (json_array_get_string_element (known, 0), ==, "Studio North");
+  g_assert_cmpstr (json_array_get_string_element (known, 6), ==, "Priya’s phone");
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "net")), ==, "Priya’s phone");
+  g_assert_false (cc_luma_network_undo_restore (undo, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+  cc_luma_network_undo_free (undo); g_clear_error (&error);
+  undo = cc_luma_fixture_forget_with_undo (model, "Priya’s phone", NULL);
+  g_assert_true (cc_luma_network_undo_restore (undo, NULL));
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "net")), ==, "Priya’s phone");
+  cc_luma_network_undo_free (undo);
+  g_assert_null (cc_luma_fixture_forget_with_undo (model, "invented", &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+}
