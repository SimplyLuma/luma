+static void forget_undone (LumaToast *toast, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  CcLumaNetworkUndo *undo = g_object_get_data (G_OBJECT (toast), "cf-undo");
+  g_autoptr (GError) error = NULL;
+  if (!v || !undo) return;
+  if (cc_luma_network_undo_restore (undo, &error))
+    { queue_refresh (v); luma_toast_show (root, "Network restored", "undone"); }
+  else luma_toast_show (root, error->message, "error");
+}
