@@ -327,6 +349,80 @@ static GtkWidget *command (View *v, const char *caption, GCallback callback)
   g_signal_connect (w, "clicked", callback, v);
   return w;
 }
+static gboolean connected (gpointer data)
+{
+  View *v = data;
+  g_autoptr (GError) error = NULL;
+  v->connection = 0;
+  if (flag (v, "wifi") && !cc_luma_fixture_connect_network (v->model, v->connecting, &error))
+    luma_toast_show (v->root, error->message, "error");
+  g_clear_pointer (&v->connecting, g_free);
+  queue_refresh (v);
+  return G_SOURCE_REMOVE;
+}
+static void connect_network (View *v, const char *name)
+{
+  if (v->connection) g_source_remove (v->connection);
+  g_free (v->connecting);
+  v->connecting = g_strdup (name);
+  g_clear_pointer (&v->joining, g_free);
+  v->connection = g_timeout_add (1300, connected, v);
+  queue_refresh (v);
+}
+static void nearby_clicked (LumaDetailsItem *item, View *v)
+{
+  const char *name = g_object_get_data (G_OBJECT (item), "cf-network");
+  gboolean password_required = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (item), "cf-password-required"));
+  if (!flag (v, "wifi")) return;
+  if (!password_required) { connect_network (v, name); return; }
+  char *next = g_strcmp0 (v->joining, name) ? g_strdup (name) : NULL;
+  g_free (v->joining); v->joining = next;
+  queue_refresh (v);
+}
+static void join_cancelled (GtkButton *button, View *v)
+{
+  g_clear_pointer (&v->joining, g_free);
+  queue_refresh (v);
+}
+static void join_clicked (GtkButton *button, View *v)
+{
+  if (v->joining) connect_network (v, v->joining);
+}
+static void wifi_on (GtkButton *button, View *v)
+{
+  g_autoptr (GError) error = NULL;
+  if (cc_luma_fixture_set_flag (v->model, "wifi", TRUE, &error)) queue_refresh (v);
+  else luma_toast_show (v->root, error->message, "error");
+}
+static void nearby_row (View *v, GtkBox *rows, JsonObject *network)
+{
+  const char *name = json_object_get_string_member (network, "n");
+  gboolean saved = json_object_has_member (network, "known") && json_object_get_boolean_member (network, "known");
+  gboolean locked = json_object_get_boolean_member (network, "lock");
+  GtkWidget *item = luma_details_item_new (name, g_strcmp0 (v->connecting, name) == 0 ? "Connecting…" : saved ? "Saved" : NULL, "wifi");
+  if (locked) luma_details_item_set_trail (LUMA_DETAILS_ITEM (item), luma_ui_icon_new ("lock"));
+  g_object_set_data_full (G_OBJECT (item), "cf-network", g_strdup (name), g_free);
+  g_object_set_data (G_OBJECT (item), "cf-password-required", GINT_TO_POINTER (locked && !saved));
+  g_signal_connect (item, "clicked", G_CALLBACK (nearby_clicked), v);
+  gtk_box_append (rows, item);
+  if (g_strcmp0 (v->joining, name) == 0)
+    {
+      GtkWidget *form = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+      GtkWidget *password = gtk_entry_new ();
+      gtk_widget_add_css_class (form, "cf-setting-row");
+      gtk_widget_set_name (form, "cf-join-form");
+      gtk_widget_set_name (password, "cf-join-password");
+      gtk_entry_set_visibility (GTK_ENTRY (password), FALSE);
+      gtk_entry_set_placeholder_text (GTK_ENTRY (password), "Password");
+      g_autofree char *accessible = g_strdup_printf ("Password for %s", name);
+      gtk_accessible_update_property (GTK_ACCESSIBLE (password), GTK_ACCESSIBLE_PROPERTY_LABEL, accessible, -1);
+      gtk_widget_set_hexpand (password, TRUE);
+      gtk_box_append (GTK_BOX (form), password);
+      gtk_box_append (GTK_BOX (form), command (v, "Cancel", G_CALLBACK (join_cancelled)));
+      gtk_box_append (GTK_BOX (form), command (v, "Join", G_CALLBACK (join_clicked)));
+      gtk_box_append (rows, form);
+    }
+}
