diff --git a/shell/cc-luma-fixture.c b/shell/cc-luma-fixture.c
index 0baa9a3..6beb4ae 100644
--- a/shell/cc-luma-fixture.c
+++ b/shell/cc-luma-fixture.c
@@ -283,3 +283,69 @@ invalid:
   g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Unknown saved fixture network or invalid network data");
   return FALSE;
 }
+
+/* A one-shot command retains only the fields affected by Forget. Restoring it
+ * preserves networks added meanwhile, and never replaces a newer connection. */
+struct _CcLumaNetworkUndo {
+  CcLumaFixture *model;
+  char *name;
+  guint index;
+  gboolean connected;
+  gboolean used;
+};
+CcLumaNetworkUndo *
+cc_luma_fixture_forget_with_undo (CcLumaFixture *self, const char *name, GError **error)
+{
+  CcLumaNetworkUndo *undo = g_new0 (CcLumaNetworkUndo, 1);
+  JsonArray *known = fixture_known (self);
+  JsonNode *current = cc_luma_fixture_get (self, "net");
+  undo->name = g_strdup (name);
+  if (known)
+    for (guint i = 0; i < json_array_get_length (known); i++)
+      if (g_strcmp0 (json_array_get_string_element (known, i), name) == 0) { undo->index = i; break; }
+  undo->connected = current && json_node_get_value_type (current) == G_TYPE_STRING &&
+    g_strcmp0 (json_node_get_string (current), name) == 0;
+  if (!cc_luma_fixture_forget_network (self, undo->name, error))
+    { g_free (undo->name); g_free (undo); return NULL; }
+  undo->model = g_object_ref (self);
+  return undo;
+}
+gboolean
+cc_luma_network_undo_restore (CcLumaNetworkUndo *undo, GError **error)
+{
+  JsonArray *known = fixture_known (undo->model);
+  JsonNode *current = cc_luma_fixture_get (undo->model, "net");
+  if (undo->used || !known || !current || json_node_get_value_type (current) != G_TYPE_STRING)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Network undo has expired or its data is invalid");
+      return FALSE;
+    }
+  gboolean present = FALSE;
+  for (guint i = 0; i < json_array_get_length (known); i++)
+    present |= g_str_equal (json_array_get_string_element (known, i), undo->name);
+  if (!present)
+    {
+      JsonArray *restored = json_array_new ();
+      guint at = MIN (undo->index, json_array_get_length (known));
+      for (guint i = 0; i <= json_array_get_length (known); i++)
+        {
+          if (i == at) json_array_add_string_element (restored, undo->name);
+          if (i < json_array_get_length (known))
+            json_array_add_string_element (restored, json_array_get_string_element (known, i));
+        }
+      json_object_set_array_member (cc_luma_fixture_get_data (undo->model), "CFKNOWN", restored);
+    }
+  JsonObject *network = fixture_network (undo->model, undo->name);
+  if (network) json_object_set_boolean_member (network, "known", TRUE);
+  if (undo->connected && !*json_node_get_string (current)) json_node_set_string (current, undo->name);
+  undo->used = TRUE;
+  return TRUE;
+}
+void
+cc_luma_network_undo_free (CcLumaNetworkUndo *undo)
+{
+  if (!undo) return;
+  g_object_unref (undo->model);
+  g_free (undo->name);
+  g_free (undo);
+}
