   "tv", (const char * const[]) { "tv-idle", "tv-remotes", NULL }, tv_start, tv_write, (GDestroyNotify) cc_luma_gs_table_free
 };
+
+/* ── Account, in TV posture: the Luma account, as Luma Connect keeps it ─────────────────────
+ * Read from the Connect daemon (org.projectluma.Connect1 GetState, followed by StateChanged):
+ * whether this TV is signed in, and the account's name and email. Signing in and out stay in
+ * Luma Connect; Settings opens it. No daemon: the page says Connect is not installed. */
+
+#define CONNECT_BUS "org.projectluma.Connect1"
+#define CONNECT_PATH "/org/projectluma/Connect"
+
+typedef struct {
+  CcLumaFixture *model;
+  GDBusConnection *bus;
+  GCancellable *cancel;
+  guint changed_id;
+  gboolean ready;
+} Account;
+
+static void account_publish (Account *a, const char *status, const char *name, const char *email)
+{
+  cc_luma_fixture_publish_string (a->model, "lumaAccount", status);
+  cc_luma_fixture_publish_string (a->model, "lumaAccountName", name);
+  cc_luma_fixture_publish_string (a->model, "lumaAccountEmail", email);
+  if (!a->ready) { a->ready = TRUE; cc_luma_live_ready (a->model, "tv-account"); }
+}
+
+static void account_state (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Account *a = data;
+  if (!reply) { account_publish (a, "unavailable", "", ""); return; }
+  const char *text = NULL;
+  g_variant_get (reply, "(&s)", &text);
+  g_autoptr (JsonParser) parser = json_parser_new ();
+  JsonNode *root = json_parser_load_from_data (parser, text, -1, NULL) ? json_parser_get_root (parser) : NULL;
+  JsonObject *state = root && JSON_NODE_HOLDS_OBJECT (root) ? json_node_get_object (root) : NULL;
+  if (!state) { account_publish (a, "unavailable", "", ""); return; }
+  const char *account = json_object_get_string_member_with_default (state, "account_status", "signed_out");
+  JsonObject *profile = json_object_has_member (state, "profile") && JSON_NODE_HOLDS_OBJECT (json_object_get_member (state, "profile"))
+    ? json_object_get_object_member (state, "profile") : NULL;
+  account_publish (a, g_str_equal (account, "signed_in") ? "signed_in" : g_str_equal (account, "locked") ? "locked" : "signed_out",
+                   profile ? json_object_get_string_member_with_default (profile, "name", "") : "",
+                   profile ? json_object_get_string_member_with_default (profile, "email", "") : "");
+}
+
+static void account_fetch (Account *a)
+{
+  g_dbus_connection_call (a->bus, CONNECT_BUS, CONNECT_PATH, CONNECT_BUS, "GetState", NULL, G_VARIANT_TYPE ("(s)"),
+                          G_DBUS_CALL_FLAGS_NONE, 5000, a->cancel, account_state, a);
+}
+
+static void account_changed (GDBusConnection *bus, const char *sender, const char *path, const char *iface,
+                             const char *signal, GVariant *parameters, gpointer data)
+{
+  account_fetch (data);
+}
+
+static gpointer account_start (CcLumaFixture *model)
+{
+  Account *a = g_new0 (Account, 1);
+  a->model = model;
+  a->cancel = g_cancellable_new ();
+  a->bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+  if (!a->bus) { account_publish (a, "unavailable", "", ""); return a; }
+  a->changed_id = g_dbus_connection_signal_subscribe (a->bus, CONNECT_BUS, CONNECT_BUS, "StateChanged", CONNECT_PATH, NULL,
+                                                      G_DBUS_SIGNAL_FLAGS_NONE, account_changed, a, NULL);
+  account_fetch (a);
+  return a;
+}
+
+static void account_stop (gpointer data)
+{
+  Account *a = data;
+  g_cancellable_cancel (a->cancel);
+  if (a->bus && a->changed_id) g_dbus_connection_signal_unsubscribe (a->bus, a->changed_id);
+  g_clear_object (&a->bus);
+  g_clear_object (&a->cancel);
+  g_free (a);
+}
+
+const CcLumaAdapter cc_luma_adapter_tv_account = {
+  "tv-account", (const char * const[]) { "tv-account", NULL }, account_start, NULL, account_stop
+};
