+/* ── Account ───────────────────────────────────────────────────────────── */
+
+/* Luma Connect owns the account: signing in (a code, or later a QR code), syncing, signing out. */
+static void open_connect (GtkButton *button, View *v)
+{
+  g_autoptr (GDesktopAppInfo) app = g_desktop_app_info_new ("org.projectluma.Connect.desktop");
+  g_autoptr (GError) error = NULL;
+  if (!app || !g_app_info_launch (G_APP_INFO (app), NULL, NULL, &error))
+    luma_toast_show (v->root, "Luma Connect isn’t installed", "error");
+}
+
+/* Signing in from the TV itself, later: a QR code here that a phone (or another Luma device)
+ * scans to approve this TV, beside the code Luma Connect asks for today. Until that flow
+ * exists the page offers Luma Connect's own sign-in and adds nothing here. */
+static void account_qr_hook (View *v, GtkBox *rows)
+{
+  (void) v; (void) rows;
+}
+
+static void account (View *v)
+{
+  const char *status = cc_luma_view_text (v, "lumaAccount");
+  const char *name = cc_luma_view_text (v, "lumaAccountName"), *email = cc_luma_view_text (v, "lumaAccountEmail");
+  cc_luma_view_header (v, "Account", "Your Luma account on this TV.", NULL);
+  if (g_str_equal (status, "signed_in"))
+    {
+      g_autofree char *detail = *email ? g_strdup_printf ("%s · Signed in", email) : g_strdup ("Signed in");
+      cf_hero (v, cc_luma_view_tv_hero_line ("user", *name ? name : "Luma Account", detail), "cf-tv-account");
+      GtkBox *rows = cf_group (v, NULL, NULL);
+      cf_bt (v, rows, "Syncing and devices", "In Luma Connect", "Open", FALSE, G_CALLBACK (open_connect));
+      cf_bt (v, rows, "Sign out", "In Luma Connect", "Open", FALSE, G_CALLBACK (open_connect));
+    }
+  else if (g_str_equal (status, "unavailable"))
+    cf_hero (v, cc_luma_view_tv_hero_line ("user", "Luma Connect isn’t installed", "Install it from Depot to sign in"), "cf-tv-account");
+  else
+    {
+      gboolean locked = g_str_equal (status, "locked");
+      cf_hero (v, cc_luma_view_tv_hero_line ("user", locked ? "Account locked" : "Not signed in",
+                             locked ? "Unlock it in Luma Connect" : "Keep photos, contacts, calendar and notes in step"), "cf-tv-account");
+      GtkBox *rows = cf_group (v, NULL, NULL);
+      account_qr_hook (v, rows);
+      cf_bt (v, rows, locked ? "Unlock" : "Sign in", "With Luma Connect", locked ? "Open" : "Sign In…", FALSE, G_CALLBACK (open_connect));
+    }
+}
+
 void cc_luma_view_tv_render (View *v)
 {
   if (g_str_equal (v->page, "tv-idle")) idle_sleep (v);
   else if (g_str_equal (v->page, "tv-remotes")) remotes (v);
+  else if (g_str_equal (v->page, "tv-account")) account (v);
 }
