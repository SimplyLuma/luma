+static char *asset_fixture (void)
+{
+  g_autoptr (GError) error = NULL;
+  char *dir = g_dir_make_tmp ("luma-settings-assets-XXXXXX", &error);
+  g_assert_no_error (error);
+  g_autofree char *contents = NULL;
+  g_assert_true (g_file_get_contents (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), &contents, NULL, &error));
+  g_assert_no_error (error);
+  g_autofree char *json = g_build_filename (dir, "settings.json", NULL);
+  g_assert_true (g_file_set_contents (json, contents, -1, &error));
+  g_assert_no_error (error);
+  return dir;
+}
+static void remove_asset_fixture (const char *dir)
+{
+  g_autofree char *json = g_build_filename (dir, "settings.json", NULL);
+  g_autofree char *image = g_build_filename (dir, "prism.png", NULL);
+  g_assert_cmpint (g_remove (json), ==, 0);
+  if (g_file_test (image, G_FILE_TEST_EXISTS)) g_assert_cmpint (g_remove (image), ==, 0);
+  g_assert_cmpint (g_rmdir (dir), ==, 0);
+}
+static void asset_loading (void)
+{
+  g_autofree char *dir = asset_fixture ();
+  g_autofree char *json = g_build_filename (dir, "settings.json", NULL);
+  g_autoptr (CcLumaFixture) model = cc_luma_fixture_load (json, NULL);
+  JsonObject *wifi = json_object_get_object_member (cc_luma_fixture_get_data (model), "CFWIFI");
+  JsonObject *codes = json_object_get_object_member (wifi, "share_codes");
+  const char *art = json_object_get_string_member (codes, "Studio North");
+  g_autofree char *path = g_build_filename (dir, "prism.png", NULL);
+  g_assert_true (g_file_set_contents (path, art, -1, NULL));
+  GtkWidget *view = g_object_ref_sink (cc_luma_view_new (model, "wifi", NULL));
+  View *v = g_object_get_data (G_OBJECT (view), "cf-view");
+  GtkWidget *picture = cc_luma_view_image (v, "prism", 128, 128);
+  gtk_box_append (v->body, picture);
+  gint64 deadline = g_get_monotonic_time () + 2 * G_USEC_PER_SEC;
+  while (!gtk_picture_get_paintable (GTK_PICTURE (picture)) && g_get_monotonic_time () < deadline) { drain (); g_usleep (1000); }
+  GdkPaintable *paintable = gtk_picture_get_paintable (GTK_PICTURE (picture));
+  g_assert_nonnull (paintable);
+  g_assert_cmpint (gdk_paintable_get_intrinsic_width (paintable), ==, 128);
+  g_assert_null (cc_luma_view_get_error (view));
+  g_autoptr (GError) error = NULL;
+  g_assert_null (cc_luma_fixture_asset_path (model, "../../private-data", &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+  g_object_unref (view); drain ();
+  remove_asset_fixture (dir);
+}
+static void missing_asset (void)
+{
+  g_autofree char *dir = asset_fixture ();
+  g_autofree char *json = g_build_filename (dir, "settings.json", NULL);
+  g_autoptr (CcLumaFixture) model = cc_luma_fixture_load (json, NULL);
+  GtkWidget *view = g_object_ref_sink (cc_luma_view_new (model, "wifi", NULL));
+  View *v = g_object_get_data (G_OBJECT (view), "cf-view");
+  GtkWidget *picture = cc_luma_view_image (v, "prism", 128, 128);
+  gtk_box_append (v->body, picture);
+  gint64 deadline = g_get_monotonic_time () + 2 * G_USEC_PER_SEC;
+  while (!cc_luma_view_get_error (view) && g_get_monotonic_time () < deadline) { drain (); g_usleep (1000); }
+  g_assert_nonnull (cc_luma_view_get_error (view));
+  g_assert_null (gtk_picture_get_paintable (GTK_PICTURE (picture)));
+  g_object_unref (view); drain ();
+  /* Results from a superseded generation cannot surface an obsolete error. */
+  view = g_object_ref_sink (cc_luma_view_new (model, "wifi", NULL));
+  v = g_object_get_data (G_OBJECT (view), "cf-view");
+  picture = cc_luma_view_image (v, "prism", 128, 128);
+  gtk_box_append (v->body, picture);
+  gtk_switch_set_active (GTK_SWITCH (find_name (view, "cf-airplane")), TRUE);
+  wait_ms (100);
+  g_assert_null (cc_luma_view_get_error (view));
+  picture = cc_luma_view_image (v, "prism", 128, 128);
+  gtk_box_append (v->body, picture);
+  g_object_unref (view); wait_ms (100);
+  remove_asset_fixture (dir);
+}
 int main (int argc, char **argv)
 {
   g_test_init (&argc, &argv, NULL);
@@ -317,5 +392,7 @@ int main (int argc, char **argv)
   g_test_add_func ("/settings/view/bluetooth", bluetooth_view);
   g_test_add_func ("/settings/view/bluetooth-pairing", bluetooth_pairing);
   g_test_add_func ("/settings/view/copy-addresses", copy_addresses);
+  g_test_add_func ("/settings/view/asset-loading", asset_loading);
+  g_test_add_func ("/settings/view/missing-asset", missing_asset);
   return g_test_run ();
 }
