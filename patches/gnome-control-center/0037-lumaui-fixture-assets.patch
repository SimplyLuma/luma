diff --git a/shell/cc-luma-view.c b/shell/cc-luma-view.c
index 92f25f2..f7e9175 100644
--- a/shell/cc-luma-view.c
+++ b/shell/cc-luma-view.c
@@ -18,6 +18,9 @@ static gboolean refresh_view (gpointer data)
 
 void cc_luma_view_queue_refresh (View *v)
 {
+  /* Invalidate now: a completed task may run before the redraw idle. */
+  v->generation++;
+  if (v->images_cancel) g_cancellable_cancel (v->images_cancel);
   if (!v->refresh) v->refresh = g_idle_add (refresh_view, v);
 }
 const char *cc_luma_view_text (View *v, const char *key)
@@ -576,6 +579,10 @@ static void network (View *v)
 static void render (View *v)
 {
   GtkWidget *child;
+  if (v->images_cancel) g_cancellable_cancel (v->images_cancel);
+  g_clear_object (&v->images_cancel);
+  v->images_cancel = g_cancellable_new ();
+  v->generation++;
   while ((child = gtk_widget_get_first_child (GTK_WIDGET (v->body))))
     gtk_box_remove (v->body, child);
   if (g_str_equal (v->page, "wifi")) wifi (v);
@@ -587,6 +594,9 @@ static void render (View *v)
 }
 static void view_free (View *v)
 {
+  if (v->images_cancel) g_cancellable_cancel (v->images_cancel);
+  g_clear_object (&v->images_cancel);
+  g_clear_error (&v->image_error);
   if (v->refresh)
     g_source_remove (v->refresh);
   if (v->connection) g_source_remove (v->connection);
@@ -755,3 +765,21 @@ gboolean cc_luma_view_set_variant (GtkWidget *root, const char *variant, GError
   else v->variant_tick = gtk_widget_add_tick_callback (root, capture_variant, NULL, NULL);
   return TRUE;
 }
+
+void cc_luma_view_set_error_handler (GtkWidget *root, CcLumaViewErrorFunc handler, gpointer data)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  v->error_handler = handler;
+  v->error_data = data;
+}
+const GError *cc_luma_view_get_error (GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  return v->image_error;
+}
+void cc_luma_view_report_error (View *v, const GError *error)
+{
+  g_clear_error (&v->image_error);
+  v->image_error = g_error_copy (error);
+  if (v->error_handler) v->error_handler (v->root, v->image_error, v->error_data);
+}
