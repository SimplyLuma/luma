diff --git a/shell/cc-luma-view-image.c b/shell/cc-luma-view-image.c
new file mode 100644
index 0000000..1e92493
--- /dev/null
+++ b/shell/cc-luma-view-image.c
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view-private.h"
+
+typedef struct {
+  GWeakRef root;
+  GWeakRef picture;
+  char *path;
+  int width, height;
+  guint64 generation;
+} ImageJob;
+static void image_job_free (ImageJob *job)
+{
+  g_weak_ref_clear (&job->root);
+  g_weak_ref_clear (&job->picture);
+  g_free (job->path);
+  g_free (job);
+}
+static void decode_image (GTask *task, gpointer source, gpointer data, GCancellable *cancel)
+{
+  ImageJob *job = data;
+  g_autoptr (GError) error = NULL;
+  GdkPixbuf *image = gdk_pixbuf_new_from_file_at_scale (job->path, job->width, job->height, TRUE, &error);
+  if (!image) g_task_return_error (task, g_steal_pointer (&error));
+  else g_task_return_pointer (task, image, g_object_unref);
+}
+static void image_decoded (GObject *source, GAsyncResult *result, gpointer unused)
+{
+  GTask *task = G_TASK (result);
+  ImageJob *job = g_task_get_task_data (task);
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GdkPixbuf) image = g_task_propagate_pointer (task, &error);
+  g_autoptr (GtkWidget) root = g_weak_ref_get (&job->root);
+  g_autoptr (GtkWidget) picture = g_weak_ref_get (&job->picture);
+  if (!root || !picture) return;
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v || v->generation != job->generation || g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  if (!image) { cc_luma_view_report_error (v, error); return; }
+  g_autoptr (GdkTexture) texture = gdk_texture_new_for_pixbuf (image);
+  gtk_picture_set_paintable (GTK_PICTURE (picture), GDK_PAINTABLE (texture));
+}
+GtkWidget *cc_luma_view_image (View *v, const char *asset, int width, int height)
+{
+  GtkWidget *picture = gtk_picture_new ();
+  gtk_picture_set_content_fit (GTK_PICTURE (picture), GTK_CONTENT_FIT_COVER);
+  gtk_picture_set_can_shrink (GTK_PICTURE (picture), TRUE);
+  ImageJob *job = g_new0 (ImageJob, 1);
+  g_weak_ref_init (&job->root, v->root);
+  g_weak_ref_init (&job->picture, picture);
+  g_autoptr (GError) error = NULL;
+  job->path = cc_luma_fixture_asset_path (v->model, asset, &error);
+  if (!job->path)
+    {
+      image_job_free (job);
+      cc_luma_view_report_error (v, error);
+      return picture;
+    }
+  job->width = width; job->height = height; job->generation = v->generation;
+  g_autoptr (GTask) task = g_task_new (NULL, v->images_cancel, image_decoded, NULL);
+  g_task_set_task_data (task, job, (GDestroyNotify) image_job_free);
+  g_task_run_in_thread (task, decode_image);
+  return picture;
+}
