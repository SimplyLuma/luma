@@ -6,6 +6,7 @@ struct _CcLumaFixture
 {
   GObject parent_instance;
   JsonNode *root;
+  char *resource_dir;
 };
 G_DEFINE_TYPE (CcLumaFixture, cc_luma_fixture, G_TYPE_OBJECT)
 
@@ -14,6 +15,7 @@ cc_luma_fixture_finalize (GObject *object)
 {
   CcLumaFixture *self = CC_LUMA_FIXTURE (object);
   g_clear_pointer (&self->root, json_node_free);
+  g_free (self->resource_dir);
   G_OBJECT_CLASS (cc_luma_fixture_parent_class)->finalize (object);
 }
 static void
@@ -90,7 +92,13 @@ cc_luma_fixture_load (const char *path, GError **error)
     }
   if (!g_file_get_contents (path, &contents, &length, error))
     return NULL;
-  return cc_luma_fixture_parse (contents, length, error);
+  CcLumaFixture *self = cc_luma_fixture_parse (contents, length, error);
+  if (self)
+    {
+      g_autofree char *absolute = g_canonicalize_filename (path, NULL);
+      self->resource_dir = g_path_get_dirname (absolute);
+    }
+  return self;
 }
 
 static JsonObject *
@@ -349,3 +357,19 @@ cc_luma_network_undo_free (CcLumaNetworkUndo *undo)
   g_free (undo->name);
   g_free (undo);
 }
+
+/* Assets must be explicitly supplied beside the fixture. No installed-data or
+ * user-directory fallback is permitted. IDs never become arbitrary paths. */
+char *cc_luma_fixture_asset_path (CcLumaFixture *self, const char *id, GError **error)
+{
+  const char *known[] = { "prism", "meadow", "blue-fog", "ember", "luma-creatives" };
+  if (self->resource_dir && id)
+    for (guint i = 0; i < G_N_ELEMENTS (known); i++)
+      if (g_str_equal (id, known[i]))
+        {
+          g_autofree char *file = g_strconcat (id, ".png", NULL);
+          return g_build_filename (self->resource_dir, file, NULL);
+        }
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Unknown fixture asset or no fixture resource directory");
+  return NULL;
+}
