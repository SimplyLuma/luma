+    g_autoptr(GVariant) ap=call(bus,NM_DBUS_PATH,"org.freedesktop.NetworkManager.LibnmGlibTest","AddWifiAp",g_variant_new("(sss)","audit-wifi",ssid,"52:54:00:00:00:01"));
