+static void spin (guint ms) {
+  gint64 end = g_get_monotonic_time () + ms * 1000;
+  do { while (g_main_context_iteration (NULL, FALSE)); g_usleep (1000); } while (g_get_monotonic_time () < end);
+}
+static gboolean write_owner (CcLumaFixture *model, const char *key, JsonNode *value, gpointer state, GError **error) {
+  return cc_luma_adapter_network.write (state, key, value, error);
+}
+static gboolean delegate (GtkWidget *root, const char *page, gpointer data) { delegates++; return TRUE; }
+static GtkWidget *named (GtkWidget *root, const char *name) {
+  if (!g_strcmp0 (gtk_widget_get_name (root), name)) return root;
+  for (GtkWidget *c=gtk_widget_get_first_child(root);c;c=gtk_widget_get_next_sibling(c)) { GtkWidget *w=named(c,name);if(w)return w; }
+  return NULL;
+}
