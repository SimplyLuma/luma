+      (forget ? !gtk_widget_has_css_class(root,"cf-net") : gtk_widget_has_css_class(root,"cf-net"))) return root;
+  for (GtkWidget *c=gtk_widget_get_first_child(root);c;c=gtk_widget_get_next_sibling(c)) { GtkWidget *w=network_button(c,ssid,forget);if(w)return w; }return NULL;
