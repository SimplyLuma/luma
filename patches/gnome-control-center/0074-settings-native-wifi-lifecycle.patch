+  g_autoptr(GVariant) out=call(bus,NM_DBUS_PATH_SETTINGS,NM_DBUS_INTERFACE_SETTINGS,"AddConnection",g_variant_new("(@a{sa{sv}})",g_variant_ref(settings)));
