+static void bluetooth_view (void)
+{
+  g_autoptr (CcLumaFixture) model = load ();
+  GtkWidget *view = g_object_ref_sink (cc_luma_view_new (model, "bluetooth", NULL));
+  g_assert_true (has_text (view, "2 connected · visible as “Nick’s ThinkPad”"));
+  g_assert_true (has_text (view, "Connected · 80% battery"));
+  g_assert_true (has_text (view, "Keychron K3"));
+  g_assert_nonnull (find_name (view, "cf-bt-nearby"));
+  /* Turning Bluetooth off cancels discovery before its first delayed result. */
+  gtk_switch_set_active (GTK_SWITCH (find_name (view, "cf-bt")), FALSE); drain ();
+  g_assert_null (find_name (view, "cf-bt-nearby"));
+  g_signal_emit_by_name (find_name (view, "cf-bt-on"), "clicked"); drain ();
+  g_assert_true (json_node_get_boolean (cc_luma_fixture_get (model, "bt")));
+  g_assert_false (json_node_get_boolean (cc_luma_fixture_get (model, "airplane")));
+  /* Pending discovery is also cancelled on destruction. */
+  g_object_unref (view); drain ();
+}
+static GtkWidget *find_device_control (GtkWidget *root, const char *id, GType type)
+{
+  if (G_TYPE_CHECK_INSTANCE_TYPE (root, type) && g_strcmp0 (g_object_get_data (G_OBJECT (root), "cf-device"), id) == 0) return root;
+  for (GtkWidget *w = gtk_widget_get_first_child (root); w; w = gtk_widget_get_next_sibling (w))
+    {
+      GtkWidget *found = find_device_control (w, id, type);
+      if (found) return found;
+    }
+  return NULL;
+}
+static void wait_ms (guint ms)
+{
+  gint64 deadline = g_get_monotonic_time () + ms * 1000;
+  while (g_get_monotonic_time () < deadline) { drain (); g_usleep (1000); }
+  drain ();
+}
+static void bluetooth_pairing (void)
+{
+  g_autoptr (CcLumaFixture) model = load ();
+  GtkWidget *view = g_object_ref_sink (cc_luma_view_new (model, "bluetooth", NULL));
+  GtkWidget *window = gtk_window_new ();
+  gtk_window_set_child (GTK_WINDOW (window), view);
+  gtk_window_present (GTK_WINDOW (window));
+  g_signal_emit_by_name (find_device_control (view, "hp", GTK_TYPE_BUTTON), "clicked"); drain ();
+  g_assert_true (has_text (view, "1 connected · visible as “Nick’s ThinkPad”"));
+  wait_ms (1500);
+  GtkWidget *near = find_device_control (view, "jbl", LUMA_TYPE_DETAILS_ITEM);
+  g_assert_nonnull (near);
+  g_signal_emit_by_name (near, "clicked"); drain ();
+  g_assert_true (has_text (view, "Pairing…"));
+  wait_ms (1750);
+  g_assert_true (has_text (view, "JBL Flip 6"));
+  g_assert_nonnull (find_device_control (view, "jbl", GTK_TYPE_BUTTON));
+  g_assert_null (find_device_control (view, "jbl", LUMA_TYPE_DETAILS_ITEM));
+  gtk_window_destroy (GTK_WINDOW (window));
+  g_object_unref (view); drain ();
+}
