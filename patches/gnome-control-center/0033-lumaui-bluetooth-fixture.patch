+static void bluetooth_model (void)
+{
+  g_autoptr (CcLumaFixture) model = cc_luma_fixture_load (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), NULL);
+  g_autoptr (CcLumaFixture) untouched = cc_luma_fixture_load (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), NULL);
+  g_autoptr (GError) error = NULL;
+  g_assert_true (cc_luma_bluetooth_validate (model));
+  g_assert_false (cc_luma_bluetooth_pair (model, "invented", &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT); g_clear_error (&error);
+  g_assert_true (cc_luma_bluetooth_connect (model, "hp", FALSE, NULL));
+  JsonArray *saved = json_object_get_array_member (cc_luma_fixture_get_data (model), "CFBT");
+  g_assert_false (json_object_get_boolean_member (json_array_get_object_element (saved, 0), "on"));
+  g_assert_true (cc_luma_bluetooth_pair (model, "k2", NULL));
+  g_assert_cmpuint (json_array_get_length (saved), ==, 4);
+  JsonObject *keyboard = json_array_get_object_element (saved, 3);
+  g_assert_cmpint (json_object_get_int_member (keyboard, "bat"), ==, 90);
+  g_assert_true (json_object_get_boolean_member (keyboard, "on"));
+  g_assert_false (json_object_has_member (keyboard, "code"));
+  g_assert_false (cc_luma_bluetooth_pair (model, "k2", &error)); g_clear_error (&error);
+  CcLumaBluetoothUndo *undo = cc_luma_bluetooth_forget (model, "hp", NULL);
+  g_assert_nonnull (undo);
+  /* A later connection change survives restoration of a different device. */
+  g_assert_true (cc_luma_bluetooth_connect (model, "ms", FALSE, NULL));
+  g_assert_true (cc_luma_bluetooth_undo (undo, NULL));
+  saved = json_object_get_array_member (cc_luma_fixture_get_data (model), "CFBT");
+  g_assert_cmpstr (json_object_get_string_member (json_array_get_object_element (saved, 0), "id"), ==, "hp");
+  g_assert_false (json_object_get_boolean_member (json_array_get_object_element (saved, 1), "on"));
+  g_assert_false (cc_luma_bluetooth_undo (undo, &error)); g_clear_error (&error);
+  cc_luma_bluetooth_undo_free (undo);
+  g_assert_true (cc_luma_fixture_set_flag (model, "bt", FALSE, NULL));
+  g_assert_false (cc_luma_bluetooth_pair (model, "jbl", &error)); g_clear_error (&error);
+  g_assert_false (cc_luma_bluetooth_connect (model, "hp", TRUE, &error)); g_clear_error (&error);
+  g_assert_cmpuint (json_array_get_length (json_object_get_array_member (cc_luma_fixture_get_data (untouched), "CFBT")), ==, 3);
+  json_object_set_string_member (json_array_get_object_element (saved, 0), "on", "invalid");
+  g_assert_false (cc_luma_bluetooth_validate (model));
+  g_assert_false (cc_luma_bluetooth_connect (model, "hp", TRUE, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+}
