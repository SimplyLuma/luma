diff --git a/shell/cc-luma-bluetooth.c b/shell/cc-luma-bluetooth.c
new file mode 100644
index 0000000..773f144
--- /dev/null
+++ b/shell/cc-luma-bluetooth.c
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-bluetooth.h"
+#include <gio/gio.h>
+#include <string.h>
+
+static gboolean string_member (JsonObject *o, const char *key)
+{
+  JsonNode *n = json_object_get_member (o, key);
+  return n && json_node_get_value_type (n) == G_TYPE_STRING && *json_node_get_string (n);
+}
+static JsonArray *devices (CcLumaFixture *model, const char *key)
+{
+  JsonNode *n = json_object_get_member (cc_luma_fixture_get_data (model), key);
+  return n && JSON_NODE_HOLDS_ARRAY (n) ? json_node_get_array (n) : NULL;
+}
+static JsonObject *device (JsonArray *list, const char *id, guint *index)
+{
+  if (!list || !id) return NULL;
+  for (guint i = 0; i < json_array_get_length (list); i++)
+    {
+      JsonNode *n = json_array_get_element (list, i);
+      if (!JSON_NODE_HOLDS_OBJECT (n)) continue;
+      JsonObject *o = json_node_get_object (n);
+      if (string_member (o, "id") && g_str_equal (json_object_get_string_member (o, "id"), id))
+        { if (index) *index = i; return o; }
+    }
+  return NULL;
+}
+gboolean cc_luma_bluetooth_validate (CcLumaFixture *model)
+{
+  JsonNode *enabled = cc_luma_fixture_get (model, "bt");
+  JsonNode *name = cc_luma_fixture_get (model, "devName");
+  if (!enabled || json_node_get_value_type (enabled) != G_TYPE_BOOLEAN ||
+      !name || json_node_get_value_type (name) != G_TYPE_STRING) return FALSE;
+  const char *keys[] = { "CFBT", "CFNEAR" };
+  for (guint k = 0; k < G_N_ELEMENTS (keys); k++)
+    {
+      JsonArray *list = devices (model, keys[k]);
+      if (!list) return FALSE;
+      g_autoptr (GHashTable) ids = g_hash_table_new (g_str_hash, g_str_equal);
+      for (guint i = 0; i < json_array_get_length (list); i++)
+        {
+          JsonNode *n = json_array_get_element (list, i);
+          if (!JSON_NODE_HOLDS_OBJECT (n)) return FALSE;
+          JsonObject *o = json_node_get_object (n);
+          if (!string_member (o, "id") || !string_member (o, "n") ||
+              !string_member (o, "i") || !string_member (o, "kind")) return FALSE;
+          const char *id = json_object_get_string_member (o, "id");
+          if (g_hash_table_contains (ids, id)) return FALSE;
+          g_hash_table_add (ids, (gpointer) id);
+          if (k == 0)
+            {
+              JsonNode *on = json_object_get_member (o, "on");
+              if (!on || json_node_get_value_type (on) != G_TYPE_BOOLEAN) return FALSE;
+            }
+          JsonNode *bat = json_object_get_member (o, "bat");
+          if (bat && !JSON_NODE_HOLDS_NULL (bat) &&
+              (json_node_get_value_type (bat) != G_TYPE_INT64 || json_node_get_int (bat) < 0 || json_node_get_int (bat) > 100)) return FALSE;
+          if (json_object_has_member (o, "code") && !string_member (o, "code")) return FALSE;
+        }
+    }
+  return TRUE;
+}
+static gboolean invalid (GError **error)
+{
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Unknown Bluetooth device or invalid fixture data");
+  return FALSE;
+}
+gboolean cc_luma_bluetooth_connect (CcLumaFixture *model, const char *id, gboolean connected, GError **error)
+{
+  if (!cc_luma_bluetooth_validate (model)) return invalid (error);
+  JsonObject *d = device (devices (model, "CFBT"), id, NULL);
+  if (!d || (connected && !json_node_get_boolean (cc_luma_fixture_get (model, "bt")))) return invalid (error);
+  json_object_set_boolean_member (d, "on", connected);
+  return TRUE;
+}
+gboolean cc_luma_bluetooth_pair (CcLumaFixture *model, const char *id, GError **error)
+{
+  if (!cc_luma_bluetooth_validate (model) || !json_node_get_boolean (cc_luma_fixture_get (model, "bt"))) return invalid (error);
+  JsonArray *near = devices (model, "CFNEAR"), *saved = devices (model, "CFBT");
+  guint at;
+  JsonObject *d = device (near, id, &at);
+  if (!d || device (saved, id, NULL)) return invalid (error);
+  JsonNode *copy = json_node_copy (json_array_get_element (near, at));
+  JsonObject *paired = json_node_get_object (copy);
+  json_object_set_boolean_member (paired, "on", TRUE);
+  json_object_remove_member (paired, "code");
+  if (g_str_equal (id, "k2")) json_object_set_int_member (paired, "bat", 90);
+  json_array_add_element (saved, copy);
+  json_array_remove_element (near, at);
+  return TRUE;
+}
+
+struct _CcLumaBluetoothUndo {
+  CcLumaFixture *model;
+  JsonNode *device;
+  guint index;
+  gboolean used;
+};
+CcLumaBluetoothUndo *cc_luma_bluetooth_forget (CcLumaFixture *model, const char *id, GError **error)
+{
+  if (!cc_luma_bluetooth_validate (model)) { invalid (error); return NULL; }
+  JsonArray *saved = devices (model, "CFBT");
+  guint at;
+  if (!device (saved, id, &at)) { invalid (error); return NULL; }
+  CcLumaBluetoothUndo *undo = g_new0 (CcLumaBluetoothUndo, 1);
+  undo->model = g_object_ref (model);
+  undo->device = json_node_copy (json_array_get_element (saved, at));
+  undo->index = at;
+  json_array_remove_element (saved, at);
+  return undo;
+}
+gboolean cc_luma_bluetooth_undo (CcLumaBluetoothUndo *undo, GError **error)
+{
+  if (undo->used || !cc_luma_bluetooth_validate (undo->model)) return invalid (error);
+  JsonArray *saved = devices (undo->model, "CFBT");
+  const char *id = json_object_get_string_member (json_node_get_object (undo->device), "id");
+  if (!device (saved, id, NULL))
+    {
+      JsonArray *restored = json_array_new ();
+      guint at = MIN (undo->index, json_array_get_length (saved));
+      for (guint i = 0; i <= json_array_get_length (saved); i++)
+        {
+          if (i == at) json_array_add_element (restored, json_node_copy (undo->device));
+          if (i < json_array_get_length (saved)) json_array_add_element (restored, json_node_copy (json_array_get_element (saved, i)));
+        }
+      json_object_set_array_member (cc_luma_fixture_get_data (undo->model), "CFBT", restored);
+    }
+  undo->used = TRUE;
+  return TRUE;
+}
+void cc_luma_bluetooth_undo_free (CcLumaBluetoothUndo *undo)
+{
+  if (!undo) return;
+  g_object_unref (undo->model);
+  json_node_unref (undo->device);
+  g_free (undo);
+}
diff --git a/shell/cc-luma-bluetooth.h b/shell/cc-luma-bluetooth.h
new file mode 100644
index 0000000..1b468e7
--- /dev/null
+++ b/shell/cc-luma-bluetooth.h
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "cc-luma-fixture.h"
+G_BEGIN_DECLS
+/* Pure fixture operations, with no BlueZ or persistent device access. */
+gboolean cc_luma_bluetooth_validate (CcLumaFixture *model);
+gboolean cc_luma_bluetooth_connect (CcLumaFixture *model, const char *id, gboolean connected, GError **error);
+gboolean cc_luma_bluetooth_pair (CcLumaFixture *model, const char *id, GError **error);
+typedef struct _CcLumaBluetoothUndo CcLumaBluetoothUndo;
+CcLumaBluetoothUndo *cc_luma_bluetooth_forget (CcLumaFixture *model, const char *id, GError **error);
+gboolean cc_luma_bluetooth_undo (CcLumaBluetoothUndo *undo, GError **error);
+void cc_luma_bluetooth_undo_free (CcLumaBluetoothUndo *undo);
+G_END_DECLS
