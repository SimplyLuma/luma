diff --git a/shell/cc-luma-live-tv.c b/shell/cc-luma-live-tv.c
new file mode 100644
index 0000000..d6c324d
--- /dev/null
+++ b/shell/cc-luma-live-tv.c
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* TV posture's pages (cc-luma-view-tv.c). Their rows belong to owners other adapters already run
+ * (the session's idle delay, the mouse speed, BlueZ) except the idle view's delay, which is the
+ * shell state's tv-idle-delay. Without that key the row stays unowned and the page leaves it out. */
+#include "cc-luma-live-gsettings.h"
+
+#define SCHEMA "org.project_luma.shell-state"
+
+static const CcLumaGsRow tv_rows[] = {
+  { "tvIdleAfter", SCHEMA, "tv-idle-delay", CC_LUMA_GS_CHOICE,
+    (const char * const[]) { "auto", "-1", "300", "300", "600", "600", "1200", "1200", "0", "0", NULL } },
+  /* Display › Fit › Screen edges: 0–10 %, applied live by the shell's TV presentation */
+  { "tvEdges", SCHEMA, "tv-screen-edges", CC_LUMA_GS_LINEAR, NULL, 1, 0, 0, 10 },
+};
+
+static gpointer tv_start (CcLumaFixture *model)
+{
+  CcLumaGsTable *table = cc_luma_gs_table_new (model, tv_rows, G_N_ELEMENTS (tv_rows));
+  cc_luma_fixture_publish_boolean (model, "tvIdleOwned", cc_luma_gs_table_covers (table, "tvIdleAfter"));
+  cc_luma_fixture_publish_boolean (model, "tvEdgesOwned", cc_luma_gs_table_covers (table, "tvEdges"));
+  cc_luma_gs_table_verify (table, (const char * const[]) { "tvIdleAfter", "tvEdges", NULL });
+  cc_luma_live_ready (model, "tv");
+  return table;
+}
+
+static gboolean tv_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  return cc_luma_gs_table_write (state, key, value, error);
+}
+
+const CcLumaAdapter cc_luma_adapter_tv = {
+  "tv", (const char * const[]) { "tv-idle", "tv-remotes", NULL }, tv_start, tv_write, (GDestroyNotify) cc_luma_gs_table_free
+};
