diff --git a/shell/cc-luma-view-tv.c b/shell/cc-luma-view-tv.c
new file mode 100644
index 0000000..fd8f39e
--- /dev/null
+++ b/shell/cc-luma-view-tv.c
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* The pages only a TV needs: Idle & Sleep and Remotes. The island lists them in TV posture only
+ * (cc-luma-window.c); a deep link opens them anywhere. Every row is bound to the owner that
+ * already keeps the value: the shell state's tv-idle-delay, the session's idle delay (the screen
+ * turning off), the mouse pointer speed and BlueZ's devices. Rows with no owner yet are not shown. */
+#include "cc-luma-rows.h"
+#include <math.h>
+#include <string.h>
+
+gboolean cc_luma_view_tv_page (const char *page)
+{
+  return g_strcmp0 (page, "tv-idle") == 0 || g_strcmp0 (page, "tv-remotes") == 0;
+}
+
+/* The hero: the thing itself, an icon tile beside its name and state. */
+static GtkWidget *hero_line (const char *icon, const char *title, const char *subtitle)
+{
+  GtkWidget *line = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 18);
+  GtkWidget *words = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+  GtkWidget *name = cf_text (title, "cf-now-title");
+  GtkWidget *state = cf_text (subtitle, NULL);
+  gtk_box_append (GTK_BOX (line), cf_lead_icon (icon));
+  luma_ui_apply_type (name, "hero-title");
+  luma_ui_apply_type_full (state, "meta", TRUE);
+  gtk_widget_set_hexpand (words, TRUE);
+  gtk_widget_set_valign (words, GTK_ALIGN_CENTER);
+  gtk_box_append (GTK_BOX (words), name);
+  gtk_box_append (GTK_BOX (words), state);
+  gtk_box_append (GTK_BOX (line), words);
+  return line;
+}
+
+/* ── Idle & Sleep ──────────────────────────────────────────────────────── */
+
+static void idle_sleep (View *v)
+{
+  cc_luma_view_header (v, "Idle & Sleep", "What the TV shows when no one is using it.", NULL);
+  /* shell state tv-idle-delay, read live by every TV app's idle hook (LumaUI TvIdle); an older
+   * shell state without the key: the row is left out rather than shown doing nothing */
+  if (!cc_luma_fixture_is_live (v->model) || cc_luma_view_flag (v, "tvIdleOwned"))
+    {
+  GtkBox *idle = cf_group (v, NULL, NULL);
+  cf_pk (v, idle, "tvIdleAfter", "Show the idle view after", NULL,
+    (const char * const[]) { "auto", "Automatic", "300", "5 minutes", "600", "10 minutes", "1200", "20 minutes", "0", "Never", NULL });
+    }
+  GtkBox *sleep = cf_group (v, "Sleep", NULL);
+  /* org.gnome.desktop.session idle-delay: the screen turns off, and the TV with it */
+  cf_pk (v, sleep, "blank", "Turn the TV off after", NULL,
+    (const char * const[]) { "60", "1 hour", "240", "4 hours", "480", "8 hours", "0", "Never", NULL });
+}
+
+/* ── Remotes ───────────────────────────────────────────────────────────── */
+
+/* The connected remote: a connected input device among the paired ones, one named a remote first. */
+static JsonObject *connected_remote (View *v)
+{
+  static const char * const kinds[] = { "Keyboard", "Game controller", "Mouse", "Tablet", "Device", NULL };
+  JsonObject *data = v->model ? cc_luma_fixture_get_data (v->model) : NULL;
+  JsonArray *saved = data && json_object_has_member (data, "CFBT") ? json_object_get_array_member (data, "CFBT") : NULL;
+  JsonObject *found = NULL;
+  for (guint i = 0; saved && i < json_array_get_length (saved); i++)
+    {
+      JsonObject *d = json_array_get_object_element (saved, i);
+      if (!json_object_get_boolean_member_with_default (d, "on", FALSE)) continue;
+      if (!g_strv_contains (kinds, json_object_get_string_member_with_default (d, "kind", ""))) continue;
+      g_autofree char *name = g_utf8_strdown (json_object_get_string_member_with_default (d, "n", ""), -1);
+      if (strstr (name, "remote")) return d;
+      if (!found) found = d;
+    }
+  return found;
+}
+
+static char *speed_format (double value)
+{
+  return g_strdup_printf ("%d", (int) round ((value + 100) / 20));
+}
+
+static void remotes (View *v)
+{
+  cc_luma_view_header (v, "Remotes", "The remote and how it moves.", NULL);
+  JsonObject *remote = connected_remote (v);
+  if (remote)
+    {
+      g_autofree char *state = json_object_has_member (remote, "bat")
+        ? g_strdup_printf ("Connected · %" G_GINT64_FORMAT "%% battery", json_object_get_int_member (remote, "bat"))
+        : g_strdup ("Connected");
+      cf_hero (v, hero_line ("smartphone", json_object_get_string_member (remote, "n"), state), "cf-tv-remote");
+    }
+  else
+    cf_hero (v, hero_line ("smartphone", "No remote connected", "Pair one in Bluetooth"), "cf-tv-remote");
+  GtkBox *rows = cf_group (v, NULL, NULL);
+  /* org.gnome.desktop.peripherals.mouse speed (-1…1), as Mouse & Touchpad shows it, read 0–10 */
+  cf_rg (v, rows, "mSpeed", "Pointer speed", NULL, -100, 100, 20, NULL, NULL, speed_format);
+  GtkBox *pair = cf_group (v, NULL, NULL);
+  cf_nv (v, pair, "bluetooth", "Pair a remote", "In Bluetooth", NULL, cf_lead_icon ("bluetooth"));
+}
+
+/* ── Display, in TV posture ────────────────────────────────────────────── */
+
+static char *percent_format (double value)
+{
+  return g_strdup_printf ("%d%%", (int) round (value));
+}
+
+void cc_luma_view_tv_display_rows (View *v)
+{
+  if (!luma_ui_tv_posture ()) return; /* TV-only rows: never on a desktop, tablet or phone */
+  if (cc_luma_fixture_is_live (v->model) && !cc_luma_view_flag (v, "tvEdgesOwned")) return;
+  GtkBox *fit = cf_group (v, "Fit", NULL);
+  cf_rg (v, fit, "tvEdges", "Screen edges", "Shrink the picture if the TV cuts off its edges", 0, 10, 1, NULL, NULL, percent_format);
+}
+
+void cc_luma_view_tv_render (View *v)
+{
+  if (g_str_equal (v->page, "tv-idle")) idle_sleep (v);
+  else if (g_str_equal (v->page, "tv-remotes")) remotes (v);
+}
