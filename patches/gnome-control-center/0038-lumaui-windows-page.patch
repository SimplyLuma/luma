diff --git a/shell/cc-luma-view-windows.c b/shell/cc-luma-view-windows.c
new file mode 100644
index 0000000..396dd2f
--- /dev/null
+++ b/shell/cc-luma-view-windows.c
@@ -0,0 +1,146 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view-private.h"
+#include "cc-luma-desktop.h"
+
+static GtkWidget *tiles (View *v);
+
+static void choice_changed (GtkCheckButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v || !gtk_check_button_get_active (button)) return;
+  const char *key = g_object_get_data (G_OBJECT (button), "cf-key");
+  const char *value = g_object_get_data (G_OBJECT (button), "cf-value");
+  g_autoptr (GError) error = NULL;
+  if (cc_luma_windows_set_choice (v->model, key, value, &error)) cc_luma_view_queue_refresh (v);
+  else cc_luma_view_report_error (v, error);
+}
+static void choices (View *v, GtkBox *rows, const char *key, const char * const *values)
+{
+  GtkCheckButton *first = NULL;
+  for (guint i = 0; values[i]; i += 3)
+    {
+      GtkWidget *button = gtk_check_button_new ();
+      if (first) gtk_check_button_set_group (GTK_CHECK_BUTTON (button), first);
+      else first = GTK_CHECK_BUTTON (button);
+      gtk_check_button_set_active (GTK_CHECK_BUTTON (button), g_str_equal (cc_luma_view_text (v, key), values[i]));
+      gtk_widget_set_valign (button, GTK_ALIGN_CENTER);
+      g_autofree char *name = g_strdup_printf ("cf-%s-%s", key, values[i]);
+      gtk_widget_set_name (button, name);
+      gtk_accessible_update_property (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_PROPERTY_LABEL, values[i + 1], -1);
+      g_object_set_data_full (G_OBJECT (button), "cf-key", g_strdup (key), g_free);
+      g_object_set_data_full (G_OBJECT (button), "cf-value", g_strdup (values[i]), g_free);
+      /* TODO(kit-request settings-02-type-and-control-roles.md): compact radio. */
+      cc_luma_view_row (rows, values[i + 1], values[i + 2], button);
+      g_signal_connect_object (button, "toggled", G_CALLBACK (choice_changed), v->root, 0);
+    }
+}
+static void number_changed (GtkRange *range, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  const char *key = g_object_get_data (G_OBJECT (range), "cf-key");
+  g_autoptr (GError) error = NULL;
+  gint64 value = (gint64) gtk_range_get_value (range);
+  if (!cc_luma_windows_set_number (v->model, key, value, &error))
+    { cc_luma_view_report_error (v, error); return; }
+  /* Keep the emitting slider alive, including through a continuous drag. */
+  GtkLabel *output = g_object_get_data (G_OBJECT (range), "cf-output");
+  g_autofree char *caption = g_strdup_printf ("%" G_GINT64_FORMAT "%s", value, g_str_equal (key, "gap") ? " px" : "");
+  gtk_label_set_text (output, caption);
+  if (g_str_equal (key, "gap") && v->tiles_host)
+    {
+      GtkWidget *old = gtk_widget_get_first_child (GTK_WIDGET (v->tiles_host));
+      if (old) gtk_box_remove (v->tiles_host, old);
+      gtk_box_append (v->tiles_host, tiles (v));
+    }
+  else if (g_str_equal (key, "wsN") && v->subtitle)
+    {
+      g_autofree char *meta = g_strdup_printf ("%s · %" G_GINT64_FORMAT " workspaces", cc_luma_view_flag (v, "tile") ? "Tiling" : "Free windows", value);
+      gtk_label_set_text (v->subtitle, meta);
+    }
+}
+static void number_row (View *v, GtkBox *rows, const char *key, const char *title, int low, int high, int step, const char *suffix)
+{
+  gint64 value = json_node_get_int (cc_luma_fixture_get (v->model, key));
+  GtkWidget *controls = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 10);
+  GtkWidget *scale = gtk_scale_new_with_range (GTK_ORIENTATION_HORIZONTAL, low, high, step);
+  gtk_scale_set_draw_value (GTK_SCALE (scale), FALSE);
+  gtk_range_set_value (GTK_RANGE (scale), value);
+  gtk_widget_set_size_request (scale, 140, -1);
+  gtk_widget_set_hexpand (scale, TRUE);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (scale), GTK_ACCESSIBLE_PROPERTY_LABEL, title, -1);
+  g_autofree char *name = g_strconcat ("cf-", key, NULL);
+  gtk_widget_set_name (scale, name);
+  g_autofree char *caption = g_strdup_printf ("%" G_GINT64_FORMAT "%s", value, suffix);
+  gtk_box_append (GTK_BOX (controls), scale);
+  GtkWidget *output = cc_luma_view_label (caption, "caption", TRUE);
+  gtk_box_append (GTK_BOX (controls), output);
+  g_object_set_data (G_OBJECT (scale), "cf-output", output);
+  g_object_set_data_full (G_OBJECT (scale), "cf-key", g_strdup (key), g_free);
+  g_signal_connect_object (scale, "value-changed", G_CALLBACK (number_changed), v->root, 0);
+  cc_luma_view_row (rows, title, NULL, controls);
+}
+static void boolean_row (View *v, GtkBox *rows, const char *key, const char *title, const char *subtitle)
+{
+  g_autofree char *name = g_strconcat ("cf-", key, NULL);
+  cc_luma_view_row (rows, title, subtitle, cc_luma_view_toggle (v, key, name, title));
+}
+static GtkWidget *tiles (View *v)
+{
+  CcLumaPreviewRect rects[3];
+  g_autoptr (GError) error = NULL;
+  if (!cc_luma_windows_rects (v->model, rects, &error))
+    { cc_luma_view_report_error (v, error); return gtk_box_new (GTK_ORIENTATION_VERTICAL, 0); }
+  GtkWidget *overlay = gtk_overlay_new ();
+  gtk_widget_set_name (overlay, "cf-tiles");
+  gtk_widget_set_size_request (overlay, 360, 176);
+  gtk_widget_set_halign (overlay, GTK_ALIGN_CENTER);
+  GtkWidget *background = cc_luma_view_image (v, cc_luma_view_text (v, "wall"), 720, 352);
+  gtk_overlay_set_child (GTK_OVERLAY (overlay), background);
+  GtkWidget *fixed = gtk_fixed_new ();
+  const char *apps[] = { "write", "viola", "messages" };
+  /* The first window is frontmost in both tiled and overlapping modes. */
+  for (int i = 2; i >= 0; i--)
+    {
+      GtkWidget *icon = cc_luma_view_image (v, apps[i], 44, 44);
+      gtk_widget_set_size_request (icon, 22, 22);
+      gtk_widget_set_halign (icon, GTK_ALIGN_CENTER);
+      gtk_widget_set_valign (icon, GTK_ALIGN_CENTER);
+      GtkWidget *window = luma_card_new (icon, FALSE);
+      gtk_widget_set_size_request (window, (int) rects[i].width, (int) rects[i].height);
+      g_autofree char *name = g_strdup_printf ("cf-tile-%s", apps[i]);
+      gtk_widget_set_name (window, name);
+      gtk_fixed_put (GTK_FIXED (fixed), window, rects[i].x, rects[i].y);
+    }
+  gtk_overlay_add_overlay (GTK_OVERLAY (overlay), fixed);
+  return overlay;
+}
+void cc_luma_view_windows_render (View *v)
+{
+  const char *ws[] = { "dynamic", "As many as you need", "Empty workspaces go away on their own", "fixed", "A fixed number", "", NULL };
+  const char *monitors[] = { "primary", "Workspaces on the main display only", "", "all", "Workspaces on every display", "", NULL };
+  const char *switching[] = { "current", "Apps on this workspace", "", "all", "Apps on every workspace", "", NULL };
+  gint64 count = json_node_get_int (cc_luma_fixture_get (v->model, "wsN"));
+  g_autofree char *space = g_str_equal (cc_luma_view_text (v, "ws"), "dynamic") ?
+    g_strdup ("workspaces come and go") : g_strdup_printf ("%" G_GINT64_FORMAT " workspaces", count);
+  g_autofree char *meta = g_strdup_printf ("%s · %s", cc_luma_view_flag (v, "tile") ? "Tiling" : "Free windows", space);
+  cc_luma_view_header (v, "Windows & Workspaces", meta, NULL);
+  v->tiles_host = GTK_BOX (gtk_box_new (GTK_ORIENTATION_VERTICAL, 0));
+  gtk_box_append (v->tiles_host, tiles (v));
+  GtkWidget *hero = luma_card_new (GTK_WIDGET (v->tiles_host), TRUE);
+  luma_card_set_recessed (LUMA_CARD (hero), TRUE);
+  gtk_widget_set_margin_top (hero, 20);
+  gtk_box_append (v->body, hero);
+  GtkBox *rows = cc_luma_view_group (v, "Tiling");
+  boolean_row (v, rows, "tile", "Tile windows", "New windows sit side by side instead of on top of each other");
+  if (cc_luma_view_flag (v, "tile")) number_row (v, rows, "gap", "Space between windows", 0, 24, 2, " px");
+  boolean_row (v, rows, "edgeTile", "Drag to an edge to tile", "Drop a window on the left, right or top edge");
+  rows = cc_luma_view_group (v, "General");
+  boolean_row (v, rows, "hot", "Hot corner", "Point at the top left corner to see all windows");
+  boolean_row (v, rows, "edges", "Screen edges", "Drag a window against an edge to resize it");
+  rows = cc_luma_view_group (v, "Workspaces");
+  choices (v, rows, "ws", ws);
+  if (g_str_equal (cc_luma_view_text (v, "ws"), "fixed")) number_row (v, rows, "wsN", "Number of workspaces", 1, 9, 1, "");
+  choices (v, cc_luma_view_group (v, "On more than one display"), "wsMon", monitors);
+  choices (v, cc_luma_view_group (v, "Switching apps"), "swi", switching);
+}
