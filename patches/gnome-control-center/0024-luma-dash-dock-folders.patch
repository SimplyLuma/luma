 }
 
+/* The pinned folders, in the order they are drawn. The rows are rebuilt only
+ * when the list or an arrangement actually changes, so typing in another row
+ * does not take the list apart underneath the pointer. */
+static void
+folders_sync (CcDashPanel *self)
+{
+  if (!self->folders_group)
+    return;
+
+  g_auto(GStrv) uris = g_settings_get_strv (self->settings, "dock-folders");
+  guint count = g_strv_length (uris);
+  gboolean pinned = count > 0;
+  gboolean shown = folders_shown (self);
+
+  if (self->folders_show_row)
+    {
+      gtk_widget_set_sensitive (GTK_WIDGET (self->folders_show_row), pinned &&
+                                g_settings_is_writable (self->settings, "dock-folders-visible"));
+      adw_action_row_set_subtitle (ADW_ACTION_ROW (self->folders_show_row), pinned ?
+        _("Show the pinned folders in the Dash") : _("Pin a folder to show it"));
+    }
+  if (self->folders_separate_row)
+    {
+      gtk_widget_set_sensitive (GTK_WIDGET (self->folders_separate_row), shown &&
+                                g_settings_is_writable (self->settings, "dock-folders-separate"));
+      adw_action_row_set_subtitle (ADW_ACTION_ROW (self->folders_separate_row), shown ?
+        _("Give the folders a surface of their own beside the dock") :
+        _("Show the folders to place them separately"));
+    }
+
+  g_autoptr(GString) key = g_string_new (NULL);
+  for (guint i = 0; i < count; i++)
+    g_string_append_printf (key, "%s\t%s\n", uris[i], folder_view_for (self, uris[i]));
+  if (g_strcmp0 (key->str, self->folders_key) == 0)
+    return;
+  g_free (self->folders_key);
+  self->folders_key = g_strdup (key->str);
+
+  for (guint i = 0; i < self->folder_rows->len; i++)
+    adw_preferences_group_remove (self->folders_group, g_ptr_array_index (self->folder_rows, i));
+  g_ptr_array_set_size (self->folder_rows, 0);
+
+  self->syncing_folders = TRUE;
+  for (guint i = 0; i < count; i++)
+    {
+      g_autoptr(GFile) file = g_file_new_for_uri (uris[i]);
+      g_autofree char *path = g_file_get_path (file);
+      g_autofree char *name = g_file_get_basename (file);
+      g_autofree char *shortened = NULL;
+      const char *home = g_get_home_dir ();
+      AdwActionRow *row = ADW_ACTION_ROW (adw_action_row_new ());
+      GtkWidget *views, *buttons, *remove;
+      const char *icons[] = { "go-up-symbolic", "go-down-symbolic" };
+      const char *moves[] = { N_("Move up"), N_("Move down") };
+
+      adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), name ? name : uris[i]);
+      /* The folder's path is its second line, written the way Files writes
+       * it, so a folder is told apart from another of the same name. */
+      if (path && home && g_str_has_prefix (path, home))
+        shortened = g_strconcat ("~", path + strlen (home), NULL);
+      adw_action_row_set_subtitle (ADW_ACTION_ROW (row),
+                                   shortened ? shortened : (path ? path : uris[i]));
+      adw_action_row_add_prefix (row, gtk_image_new_from_icon_name ("folder-symbolic"));
+
+      views = gtk_drop_down_new_from_strings ((const char * const *) (const char *[]) { _("Stack"), _("Grid"), NULL });
+      gtk_widget_set_valign (views, GTK_ALIGN_CENTER);
+      gtk_drop_down_set_selected (GTK_DROP_DOWN (views),
+        g_str_equal (folder_view_for (self, uris[i]), folder_views[1]) ? 1 : 0);
+      gtk_accessible_update_property (GTK_ACCESSIBLE (views),
+                                      GTK_ACCESSIBLE_PROPERTY_LABEL, _("Opens as"), -1);
+      g_object_set_data_full (G_OBJECT (views), "folder-uri", g_strdup (uris[i]), g_free);
+      g_signal_connect_object (views, "notify::selected", G_CALLBACK (folder_view_changed), self, 0);
+      adw_action_row_add_suffix (row, views);
+
+      buttons = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+      gtk_widget_add_css_class (buttons, "linked");
+      gtk_widget_set_valign (buttons, GTK_ALIGN_CENTER);
+      for (guint b = 0; b < G_N_ELEMENTS (icons); b++)
+        {
+          GtkWidget *button = gtk_button_new_from_icon_name (icons[b]);
+          gtk_widget_add_css_class (button, "flat");
+          gtk_widget_set_tooltip_text (button, _(moves[b]));
+          gtk_accessible_update_property (GTK_ACCESSIBLE (button),
+                                          GTK_ACCESSIBLE_PROPERTY_LABEL, _(moves[b]), -1);
+          gtk_widget_set_sensitive (button, b == 0 ? i > 0 : i + 1 < count);
+          g_object_set_data_full (G_OBJECT (button), "folder-uri", g_strdup (uris[i]), g_free);
+          g_object_set_data (G_OBJECT (button), "folder-delta", GINT_TO_POINTER (b == 0 ? -1 : 1));
+          g_signal_connect_object (button, "clicked", G_CALLBACK (folder_move_clicked), self, 0);
+          gtk_box_append (GTK_BOX (buttons), button);
+        }
+      remove = gtk_button_new_from_icon_name ("list-remove-symbolic");
+      gtk_widget_add_css_class (remove, "flat");
+      gtk_widget_set_tooltip_text (remove, _("Remove from the dock"));
+      gtk_accessible_update_property (GTK_ACCESSIBLE (remove),
+                                      GTK_ACCESSIBLE_PROPERTY_LABEL, _("Remove from the dock"), -1);
+      g_object_set_data_full (G_OBJECT (remove), "folder-uri", g_strdup (uris[i]), g_free);
+      g_signal_connect_object (remove, "clicked", G_CALLBACK (folder_remove_clicked), self, 0);
+      gtk_box_append (GTK_BOX (buttons), remove);
+      adw_action_row_add_suffix (row, buttons);
+
+      adw_preferences_group_add (self->folders_group, GTK_WIDGET (row));
+      g_ptr_array_add (self->folder_rows, row);
+    }
+  self->syncing_folders = FALSE;
+
+  {
+    AdwButtonRow *add = ADW_BUTTON_ROW (adw_button_row_new ());
+    adw_preferences_row_set_title (ADW_PREFERENCES_ROW (add), _("Add folder…"));
+    adw_button_row_set_start_icon_name (add, "list-add-symbolic");
+    g_signal_connect_object (add, "activated", G_CALLBACK (folder_add_activated), self, 0);
+    adw_preferences_group_add (self->folders_group, GTK_WIDGET (add));
+    g_ptr_array_add (self->folder_rows, add);
+  }
+}
+
 static void
 settings_changed (GSettings *settings, const char *key, CcDashPanel *self)
