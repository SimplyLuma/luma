+static const char * const folder_views[] = { "stack", "grid", NULL };
+
+/* A key the installed shell state does not have is simply absent: the row
+ * that would set it is not built, rather than built and dead. */
+static gboolean
+has_key (CcDashPanel *self, const char *key)
+{
+  g_autoptr(GSettingsSchema) schema = NULL;
+  g_object_get (self->settings, "settings-schema", &schema, NULL);
+  return schema && g_settings_schema_has_key (schema, key);
+}
+
+static gboolean
+folders_pinned (CcDashPanel *self)
+{
+  if (!has_key (self, "dock-folders"))
+    return FALSE;
+  g_auto(GStrv) uris = g_settings_get_strv (self->settings, "dock-folders");
+  return uris != NULL && uris[0] != NULL;
+}
+
+/* Pinned and not hidden: what the dock actually draws. */
+static gboolean
+folders_shown (CcDashPanel *self)
+{
+  return folders_pinned (self) &&
+    (!has_key (self, "dock-folders-visible") ||
+     g_settings_get_boolean (self->settings, "dock-folders-visible"));
+}
+
+static gboolean
+folders_separate (CcDashPanel *self)
+{
+  return has_key (self, "dock-folders-separate") &&
+    g_settings_get_boolean (self->settings, "dock-folders-separate");
+}
 
