+static void folders_sync (CcDashPanel *self);
+
+/* The arrangement a folder opens in, from the map the Shell keeps by URI.
+ * A folder with no entry of its own opens as a Stack. */
+static const char *
+folder_view_for (CcDashPanel *self, const char *uri)
+{
+  const char *view = NULL;
+  g_autoptr(GVariant) stored = NULL;
+  if (!has_key (self, "dock-folders-views"))
+    return folder_views[0];
+  stored = g_settings_get_value (self->settings, "dock-folders-views");
+  if (g_variant_lookup (stored, uri, "&s", &view) && g_str_equal (view, "grid"))
+    return folder_views[1];
+  return folder_views[0];
+}
+
+static void
+folder_set_view (CcDashPanel *self, const char *uri, const char *view)
+{
+  g_autoptr(GVariant) stored = g_settings_get_value (self->settings, "dock-folders-views");
+  GVariantBuilder builder;
+  GVariantIter iter;
+  const char *key, *value;
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("a{ss}"));
+  g_variant_iter_init (&iter, stored);
+  while (g_variant_iter_next (&iter, "{&s&s}", &key, &value))
+    if (!g_str_equal (key, uri))
+      g_variant_builder_add (&builder, "{ss}", key, value);
+  g_variant_builder_add (&builder, "{ss}", uri, view);
+  g_settings_set_value (self->settings, "dock-folders-views", g_variant_builder_end (&builder));
+}
+
+/* A folder that is no longer pinned leaves nothing behind: not the
+ * arrangement it opened in, not the stamp its count was measured against,
+ * and not a position it was last left in away from the Dash. */
+static void
+folder_forget (CcDashPanel *self, const char *uri)
+{
+  if (has_key (self, "dock-folders-views"))
+    {
+      g_autoptr(GVariant) stored = g_settings_get_value (self->settings, "dock-folders-views");
+      GVariantBuilder builder;
+      GVariantIter iter;
+      const char *key, *value;
+      g_variant_builder_init (&builder, G_VARIANT_TYPE ("a{ss}"));
+      g_variant_iter_init (&iter, stored);
+      while (g_variant_iter_next (&iter, "{&s&s}", &key, &value))
+        if (!g_str_equal (key, uri))
+          g_variant_builder_add (&builder, "{ss}", key, value);
+      g_settings_set_value (self->settings, "dock-folders-views", g_variant_builder_end (&builder));
+    }
+  if (has_key (self, "dock-folders-seen"))
+    {
+      g_autoptr(GVariant) stored = g_settings_get_value (self->settings, "dock-folders-seen");
+      GVariantBuilder builder;
+      GVariantIter iter;
+      const char *key;
+      gint64 when;
+      g_variant_builder_init (&builder, G_VARIANT_TYPE ("a{sx}"));
+      g_variant_iter_init (&iter, stored);
+      while (g_variant_iter_next (&iter, "{&sx}", &key, &when))
+        if (!g_str_equal (key, uri))
+          g_variant_builder_add (&builder, "{sx}", key, when);
+      g_settings_set_value (self->settings, "dock-folders-seen", g_variant_builder_end (&builder));
+    }
+  if (has_key (self, "dock-folders-detached"))
+    {
+      g_autoptr(GVariant) stored = g_settings_get_value (self->settings, "dock-folders-detached");
+      const char *open_uri = NULL;
+      if (g_variant_lookup (stored, "uri", "&s", &open_uri) && g_str_equal (open_uri, uri))
+        g_settings_set_value (self->settings, "dock-folders-detached",
+                              g_variant_new_array (G_VARIANT_TYPE ("{sv}"), NULL, 0));
+    }
+}
+
+static void
+folder_view_changed (GtkDropDown *drop, GParamSpec *pspec, CcDashPanel *self)
+{
+  const char *uri = g_object_get_data (G_OBJECT (drop), "folder-uri");
+  guint selected = gtk_drop_down_get_selected (drop);
+  if (self->syncing_folders || !uri || selected >= G_N_ELEMENTS (folder_views) - 1)
+    return;
+  folder_set_view (self, uri, folder_views[selected]);
+}
+
+static void
+folder_remove_clicked (GtkButton *button, CcDashPanel *self)
+{
+  const char *uri = g_object_get_data (G_OBJECT (button), "folder-uri");
+  g_auto(GStrv) uris = g_settings_get_strv (self->settings, "dock-folders");
+  g_autoptr(GPtrArray) kept = g_ptr_array_new ();
+  for (guint i = 0; uris[i]; i++)
+    if (!g_str_equal (uris[i], uri))
+      g_ptr_array_add (kept, uris[i]);
+  g_ptr_array_add (kept, NULL);
+  g_settings_set_strv (self->settings, "dock-folders", (const char * const *) kept->pdata);
+  folder_forget (self, uri);
+}
+
+/* The list is the order the tiles are drawn in, so moving a row moves a
+ * tile. */
+static void
+folder_move_clicked (GtkButton *button, CcDashPanel *self)
+{
+  const char *uri = g_object_get_data (G_OBJECT (button), "folder-uri");
+  int delta = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (button), "folder-delta"));
+  g_auto(GStrv) uris = g_settings_get_strv (self->settings, "dock-folders");
+  guint count = g_strv_length (uris);
+  for (guint i = 0; i < count; i++)
+    {
+      if (!g_str_equal (uris[i], uri))
+        continue;
+      int to = (int) i + delta;
+      if (to < 0 || to >= (int) count)
+        return;
+      char *moved = uris[i];
+      uris[i] = uris[to];
+      uris[to] = moved;
+      g_settings_set_strv (self->settings, "dock-folders", (const char * const *) uris);
+      return;
+    }
+}
+
+static void
+folder_chosen (GObject *source, GAsyncResult *result, gpointer data)
+{
+  CcDashPanel *self = data;
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GFile) folder = gtk_file_dialog_select_folder_finish (GTK_FILE_DIALOG (source), result, &error);
+  if (!folder)
+    return;
+  g_autofree char *uri = g_file_get_uri (folder);
+  g_auto(GStrv) uris = g_settings_get_strv (self->settings, "dock-folders");
+  guint count = g_strv_length (uris);
+  for (guint i = 0; i < count; i++)
+    if (g_str_equal (uris[i], uri))
+      return;
+  g_autofree const char **next = g_new0 (const char *, count + 2);
+  for (guint i = 0; i < count; i++)
+    next[i] = uris[i];
+  next[count] = uri;
+  g_settings_set_strv (self->settings, "dock-folders", (const char * const *) next);
+}
+
+static void
+folder_add_activated (AdwButtonRow *row, CcDashPanel *self)
+{
+  g_autoptr(GtkFileDialog) dialog = gtk_file_dialog_new ();
+  GtkRoot *root = gtk_widget_get_root (GTK_WIDGET (self));
+  gtk_file_dialog_set_title (dialog, _("Add a folder to the dock"));
+  gtk_file_dialog_select_folder (dialog, GTK_IS_WINDOW (root) ? GTK_WINDOW (root) : NULL,
+                                 NULL, folder_chosen, self);
+}
