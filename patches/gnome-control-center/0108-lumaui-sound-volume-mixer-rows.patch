+/* A row's slider and its percent: 180 px of slider where the row has room (140 on a phone), down to
+ * the slider's own minimum where it has not, so a narrow window still reaches its phone layout. */
+#define SLIDER_GAP 10
+static void
+slider_measure (GtkWidget *box, GtkOrientation o, int for_size, int *min, int *nat, int *minb, int *natb)
+{
+  GtkWidget *scale = gtk_widget_get_first_child (box), *readout = gtk_widget_get_last_child (box);
+  int smin, snat, rmin, rnat;
+  *minb = *natb = -1;
+  gtk_widget_measure (scale, o, -1, &smin, &snat, NULL, NULL);
+  gtk_widget_measure (readout, o, -1, &rmin, &rnat, NULL, NULL);
+  if (o == GTK_ORIENTATION_VERTICAL) { *min = MAX (smin, rmin); *nat = MAX (snat, rnat); return; }
+  int wide = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (box), "cf-mix-slider"));
+  *min = smin + SLIDER_GAP + rnat;
+  *nat = MAX (smin, wide) + SLIDER_GAP + rnat;
+}
+
+static void
+slider_allocate (GtkWidget *box, int width, int height, int baseline)
+{
+  GtkWidget *scale = gtk_widget_get_first_child (box), *readout = gtk_widget_get_last_child (box);
+  gboolean rtl = gtk_widget_get_direction (box) == GTK_TEXT_DIR_RTL;
+  int rnat, scale_width;
+  gtk_widget_measure (readout, GTK_ORIENTATION_HORIZONTAL, -1, NULL, &rnat, NULL, NULL);
+  scale_width = MAX (0, width - SLIDER_GAP - rnat);
+  gtk_widget_size_allocate (scale, &(GtkAllocation) { rtl ? rnat + SLIDER_GAP : 0, 0, scale_width, height }, -1);
+  gtk_widget_size_allocate (readout, &(GtkAllocation) { rtl ? 0 : width - rnat, 0, rnat, height }, -1);
+}
 
