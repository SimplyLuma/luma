diff --git a/shell/cc-luma-view-bluetooth.c b/shell/cc-luma-view-bluetooth.c
new file mode 100644
index 0000000..7866f5b
--- /dev/null
+++ b/shell/cc-luma-view-bluetooth.c
@@ -0,0 +1,179 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view-private.h"
+#include "cc-luma-bluetooth.h"
+
+void cc_luma_view_bluetooth_stop (View *v)
+{
+  if (v->scan_timer) { g_source_remove (v->scan_timer); v->scan_timer = 0; }
+  if (v->pair_timer) { g_source_remove (v->pair_timer); v->pair_timer = 0; }
+  g_clear_pointer (&v->pairing, g_free);
+  v->near_count = 0;
+}
+static gboolean scan_next (gpointer data)
+{
+  View *v = data;
+  v->scan_timer = 0;
+  if (!g_str_equal (v->page, "bluetooth") || !cc_luma_view_flag (v, "bt")) return G_SOURCE_REMOVE;
+  JsonArray *near = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFNEAR");
+  v->near_count = MIN (v->near_count + 1, json_array_get_length (near));
+  cc_luma_view_queue_refresh (v);
+  if (v->near_count < json_array_get_length (near)) v->scan_timer = g_timeout_add (2200, scan_next, v);
+  return G_SOURCE_REMOVE;
+}
+void cc_luma_view_bluetooth_start (View *v)
+{
+  cc_luma_view_bluetooth_stop (v);
+  if (g_str_equal (v->page, "bluetooth") && cc_luma_view_flag (v, "bt")) v->scan_timer = g_timeout_add (1400, scan_next, v);
+}
+static void bluetooth_on (GtkButton *button, View *v)
+{
+  g_autoptr (GError) error = NULL;
+  if (!cc_luma_fixture_set_flag (v->model, "bt", TRUE, &error))
+    { luma_toast_show (v->root, error->message, "error"); return; }
+  cc_luma_view_bluetooth_start (v); cc_luma_view_queue_refresh (v);
+}
+static void device_connection (GtkButton *button, View *v)
+{
+  const char *id = g_object_get_data (G_OBJECT (button), "cf-device");
+  gboolean active = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (button), "cf-connected"));
+  g_autoptr (GError) error = NULL;
+  if (cc_luma_bluetooth_connect (v->model, id, !active, &error)) cc_luma_view_queue_refresh (v);
+  else luma_toast_show (v->root, error->message, "error");
+}
+static gboolean device_paired (gpointer data)
+{
+  View *v = data;
+  g_autoptr (GError) error = NULL;
+  v->pair_timer = 0;
+  g_autofree char *device_name = NULL;
+  JsonArray *near = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFNEAR");
+  for (guint i = 0; i < json_array_get_length (near); i++)
+    {
+      JsonObject *d = json_array_get_object_element (near, i);
+      if (g_strcmp0 (json_object_get_string_member (d, "id"), v->pairing) == 0)
+        device_name = g_strdup (json_object_get_string_member (d, "n"));
+    }
+  if (!cc_luma_bluetooth_pair (v->model, v->pairing, &error)) luma_toast_show (v->root, error->message, "error");
+  else
+    {
+      v->near_count = v->near_count ? v->near_count - 1 : 0;
+      g_autofree char *message = g_strdup_printf ("%s is connected", device_name);
+      luma_toast_show (v->root, message, "done");
+    }
+  g_clear_pointer (&v->pairing, g_free); cc_luma_view_queue_refresh (v);
+  return G_SOURCE_REMOVE;
+}
+static void pair_device (LumaDetailsItem *item, View *v)
+{
+  if (v->pair_timer || !cc_luma_view_flag (v, "bt")) return;
+  v->pairing = g_strdup (g_object_get_data (G_OBJECT (item), "cf-device"));
+  guint delay = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (item), "cf-pair-delay"));
+  v->pair_timer = g_timeout_add (delay, device_paired, v);
+  cc_luma_view_queue_refresh (v);
+}
+static void send_files (GtkButton *button, View *v)
+{
+  luma_toast_show (v->root, "Choose files, then a device", "done");
+}
+static void device_undone (LumaToast *toast, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  CcLumaBluetoothUndo *undo = g_object_get_data (G_OBJECT (toast), "cf-device-undo");
+  g_autoptr (GError) error = NULL;
+  if (!v || !undo) return;
+  if (cc_luma_bluetooth_undo (undo, &error))
+    { cc_luma_view_queue_refresh (v); luma_toast_show (root, "Device restored", "undone"); }
+  else luma_toast_show (root, error->message, "error");
+}
+static void device_forgotten (LumaDestructiveDialog *dialog, gboolean checked, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  g_autoptr (GError) error = NULL;
+  CcLumaBluetoothUndo *undo = cc_luma_bluetooth_forget (v->model, g_object_get_data (G_OBJECT (dialog), "cf-device"), &error);
+  if (!undo) { luma_toast_show (root, error->message, "error"); return; }
+  cc_luma_view_queue_refresh (v);
+  LumaToast *toast = luma_toast_show_with_undo (root, "Device forgotten", "deleted");
+  g_object_set_data_full (G_OBJECT (toast), "cf-device-undo", undo, (GDestroyNotify) cc_luma_bluetooth_undo_free);
+  g_signal_connect_object (toast, "undo", G_CALLBACK (device_undone), root, 0);
+}
+static void device_forget (GtkButton *button, View *v)
+{
+  g_autofree char *title = g_strdup_printf ("Forget %s?", (char *) g_object_get_data (G_OBJECT (button), "cf-device-name"));
+  LumaDestructiveDialog *dialog = luma_destructive_dialog_ask (v->root, title,
+    "You’ll need to pair it again to use it.", "Forget", "trash-2", NULL);
+  g_object_set_data_full (G_OBJECT (dialog), "cf-device", g_strdup (g_object_get_data (G_OBJECT (button), "cf-device")), g_free);
+  g_signal_connect_object (dialog, "confirmed", G_CALLBACK (device_forgotten), v->root, 0);
+}
+void cc_luma_view_bluetooth_render (View *v)
+{
+  JsonArray *saved = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFBT");
+  JsonArray *near = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFNEAR");
+  guint connected_count = 0;
+  for (guint i = 0; i < json_array_get_length (saved); i++)
+    connected_count += json_object_get_boolean_member (json_array_get_object_element (saved, i), "on");
+  g_autofree char *meta = cc_luma_view_flag (v, "bt") ? g_strdup_printf ("%u connected · visible as “%s”", connected_count, cc_luma_view_text (v, "devName")) : g_strdup ("Bluetooth is off");
+  cc_luma_view_header (v, "Bluetooth", meta, "bt");
+  GtkWidget *hero_body = gtk_box_new (GTK_ORIENTATION_VERTICAL, 12);
+  if (!cc_luma_view_flag (v, "bt"))
+    {
+      gtk_box_append (GTK_BOX (hero_body), luma_ui_icon_new ("bluetooth"));
+      gtk_box_append (GTK_BOX (hero_body), cc_luma_view_label ("Bluetooth is off", "body", FALSE));
+      GtkWidget *on = cc_luma_view_command (v, "Turn on", G_CALLBACK (bluetooth_on));
+      gtk_widget_set_name (on, "cf-bt-on");
+      gtk_box_append (GTK_BOX (hero_body), on);
+    }
+  else
+    {
+      gtk_box_append (GTK_BOX (hero_body), cc_luma_view_words ("Looking for devices", "Put a device in pairing mode and it appears here"));
+      GtkWidget *near_rows = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+      gtk_widget_set_name (near_rows, "cf-bt-nearby");
+      for (guint i = 0; i < MIN (v->near_count, json_array_get_length (near)); i++)
+        {
+          JsonObject *d = json_array_get_object_element (near, i);
+          const char *id = json_object_get_string_member (d, "id");
+          gboolean pairing = g_strcmp0 (v->pairing, id) == 0;
+          g_autofree char *prompt = pairing && json_object_has_member (d, "code") ?
+            g_strdup_printf ("Type %s on it, then Return", json_object_get_string_member (d, "code")) : NULL;
+          GtkWidget *item = luma_details_item_new (json_object_get_string_member (d, "n"),
+            pairing ? prompt ? prompt : "Pairing…" : json_object_get_string_member (d, "kind"), json_object_get_string_member (d, "i"));
+          gtk_widget_set_hexpand (item, TRUE);
+          g_object_set_data_full (G_OBJECT (item), "cf-device", g_strdup (id), g_free);
+          g_object_set_data (G_OBJECT (item), "cf-pair-delay", GUINT_TO_POINTER (json_object_has_member (d, "code") ? 3200 : 1600));
+          g_signal_connect (item, "clicked", G_CALLBACK (pair_device), v);
+          gtk_box_append (GTK_BOX (near_rows), item);
+        }
+      gtk_box_append (GTK_BOX (hero_body), near_rows);
+    }
+  GtkWidget *hero = luma_card_new (hero_body, TRUE);
+  luma_card_set_recessed (LUMA_CARD (hero), TRUE);
+  gtk_widget_set_margin_top (hero, 20);
+  gtk_box_append (v->body, hero);
+  if (!cc_luma_view_flag (v, "bt")) return;
+  GtkBox *rows = cc_luma_view_group (v, "Your devices");
+  for (guint i = 0; i < json_array_get_length (saved); i++)
+    {
+      JsonObject *d = json_array_get_object_element (saved, i);
+      gboolean active = json_object_get_boolean_member (d, "on");
+      JsonNode *battery = json_object_get_member (d, "bat");
+      g_autofree char *status = active && battery && !JSON_NODE_HOLDS_NULL (battery) ?
+        g_strdup_printf ("Connected · %" G_GINT64_FORMAT "%% battery", json_node_get_int (battery)) : g_strdup (active ? "Connected" : "Not connected");
+      GtkWidget *button = cc_luma_view_command (v, active ? "Disconnect" : "Connect", G_CALLBACK (device_connection));
+      g_object_set_data_full (G_OBJECT (button), "cf-device", g_strdup (json_object_get_string_member (d, "id")), g_free);
+      g_object_set_data (G_OBJECT (button), "cf-connected", GINT_TO_POINTER (active));
+      GtkWidget *actions = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+      gtk_box_append (GTK_BOX (actions), button);
+      GtkWidget *forget = gtk_button_new ();
+      gtk_button_set_child (GTK_BUTTON (forget), luma_ui_icon_new ("x"));
+      g_autofree char *accessible = g_strdup_printf ("Forget %s", json_object_get_string_member (d, "n"));
+      gtk_widget_set_tooltip_text (forget, "Forget");
+      gtk_accessible_update_property (GTK_ACCESSIBLE (forget), GTK_ACCESSIBLE_PROPERTY_LABEL, accessible, -1);
+      g_object_set_data_full (G_OBJECT (forget), "cf-device", g_strdup (json_object_get_string_member (d, "id")), g_free);
+      g_object_set_data_full (G_OBJECT (forget), "cf-device-name", g_strdup (json_object_get_string_member (d, "n")), g_free);
+      g_signal_connect (forget, "clicked", G_CALLBACK (device_forget), v);
+      gtk_box_append (GTK_BOX (actions), forget);
+      cc_luma_view_row (rows, json_object_get_string_member (d, "n"), status, actions);
+    }
+  rows = cc_luma_view_group (v, NULL);
+  cc_luma_view_row (rows, "Send files", "To a phone or computer nearby", cc_luma_view_command (v, "Send…", G_CALLBACK (send_files)));
+}
