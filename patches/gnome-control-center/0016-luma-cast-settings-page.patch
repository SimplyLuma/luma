+static gboolean
+push_cast_page_idle (gpointer user_data)
+{
+  CcDisplayPanel *self = CC_DISPLAY_PANEL (user_data);
+
+  if (self->cast_page != NULL &&
+      cc_panel_get_visible_subpage (CC_PANEL (self)) != self->cast_page)
+    cc_panel_push_subpage (CC_PANEL (self), self->cast_page);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+cc_display_panel_set_property (GObject      *object,
+                               guint         prop_id,
+                               const GValue *value,
+                               GParamSpec   *pspec)
+{
+  switch (prop_id) {
+  case PROP_PARAMETERS: {
+    GVariant *parameters = g_value_get_variant (value);
+    g_autoptr(GVariant) first = NULL;
+
+    if (parameters == NULL || g_variant_n_children (parameters) == 0)
+      break;
+    first = g_variant_get_child_value (parameters, 0);
+    if (g_variant_is_of_type (first, G_VARIANT_TYPE_VARIANT))
+      {
+        GVariant *inner = g_variant_get_variant (first);
+        g_variant_unref (first);
+        first = inner;
+      }
+    /* `gnome-control-center display cast`: Quick Settings › Cast › Cast Settings.
+     * The navigation view is ready once construction finishes. */
+    if (g_variant_is_of_type (first, G_VARIANT_TYPE_STRING) &&
+        g_str_equal (g_variant_get_string (first, NULL), "cast"))
+      g_idle_add_full (G_PRIORITY_DEFAULT, push_cast_page_idle,
+                       g_object_ref (object), g_object_unref);
+    break;
+  }
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+    break;
+  }
+}
