diff --git a/shell/cc-luma-privacy.c b/shell/cc-luma-privacy.c
new file mode 100644
index 0000000..d3a88b1
--- /dev/null
+++ b/shell/cc-luma-privacy.c
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-privacy.h"
+#include <gio/gio.h>
+#include <string.h>
+typedef struct { const char *page, *key; GType type; const char *choices[10]; } Field;
+static const Field fields[] = {
+  { "p-lock", "lock.blank", G_TYPE_STRING, { "1", "2", "3", "5", "8", "10", "15", "0", NULL } },
+  { "p-lock", "lock.delay", G_TYPE_STRING, { "0", "30", "60", "300", NULL } },
+  { "p-lock", "lock.auto", G_TYPE_BOOLEAN, { NULL } },
+  { "p-lock", "lock.notes", G_TYPE_BOOLEAN, { NULL } },
+  { "p-loc", "loc", G_TYPE_BOOLEAN, { NULL } },
+  { "p-cam", "cam", G_TYPE_BOOLEAN, { NULL } },
+  { "p-mic", "mic", G_TYPE_BOOLEAN, { NULL } },
+  { "p-files", "hist", G_TYPE_BOOLEAN, { NULL } },
+  { "p-files", "trash", G_TYPE_BOOLEAN, { NULL } },
+  { "p-files", "temp", G_TYPE_BOOLEAN, { NULL } },
+  { "p-files", "histKeep", G_TYPE_STRING, { "1", "7", "30", "forever", NULL } },
+  { "p-files", "trashAge", G_TYPE_STRING, { "1", "7", "30", NULL } },
+  { "p-diag", "diag", G_TYPE_STRING, { "never", "ask", "auto", NULL } },
+  { "p-dev", "tbolt", G_TYPE_BOOLEAN, { NULL } },
+};
+static const struct { const char *page, *key; } permissions[] = {
+  { "p-loc", "appLoc" }, { "p-cam", "appCam" }, { "p-mic", "appMic" }
+};
+gboolean cc_luma_privacy_page (const char *page)
+{
+  if (!page) return FALSE;
+  if (g_str_equal (page, "privacy")) return TRUE;
+  for (guint i = 0; i < G_N_ELEMENTS (fields); i++) if (g_str_equal (page, fields[i].page)) return TRUE;
+  return FALSE;
+}
+static gboolean valid (const Field *field, JsonNode *value)
+{
+  if (!value || !JSON_NODE_HOLDS_VALUE (value) || json_node_get_value_type (value) != field->type) return FALSE;
+  if (field->type == G_TYPE_BOOLEAN) return TRUE;
+  for (guint i = 0; field->choices[i]; i++) if (g_str_equal (field->choices[i], json_node_get_string (value))) return TRUE;
+  return FALSE;
+}
+gboolean cc_luma_privacy_validate (CcLumaFixture *model)
+{
+  for (guint i = 0; i < G_N_ELEMENTS (fields); i++) if (!valid (&fields[i], cc_luma_fixture_get (model, fields[i].key))) return FALSE;
+  for (guint i = 0; i < G_N_ELEMENTS (permissions); i++) {
+    JsonNode *node = cc_luma_fixture_get (model, permissions[i].key);
+    if (!node || !JSON_NODE_HOLDS_OBJECT (node)) return FALSE;
+    JsonObject *object = json_node_get_object (node);
+    g_autoptr(GList) names = json_object_get_members (object);
+    for (GList *name = names; name; name = name->next) {
+      const char *id = name->data;
+      JsonNode *flag = json_object_get_member (object, id);
+      if (!*id || strchr (id, '.') || !cc_luma_fixture_app_name (model, id) ||
+          !JSON_NODE_HOLDS_VALUE (flag) || json_node_get_value_type (flag) != G_TYPE_BOOLEAN) return FALSE;
+    }
+  }
+  return TRUE;
+}
+gboolean cc_luma_privacy_set (CcLumaFixture *model, const char *page,
+                             const char *key, JsonNode *value, GError **error)
+{
+  if (page && key && cc_luma_privacy_validate (model)) {
+    for (guint i = 0; i < G_N_ELEMENTS (fields); i++)
+      if (g_str_equal (page, fields[i].page) && g_str_equal (key, fields[i].key) && valid (&fields[i], value))
+        return cc_luma_fixture_set (model, key, value, error);
+    for (guint i = 0; i < G_N_ELEMENTS (permissions); i++) {
+      g_autofree char *prefix = g_strconcat (permissions[i].key, ".", NULL);
+      if (g_str_equal (page, permissions[i].page) && g_str_has_prefix (key, prefix) &&
+          value && JSON_NODE_HOLDS_VALUE (value) && json_node_get_value_type (value) == G_TYPE_BOOLEAN &&
+          cc_luma_fixture_get (model, key)) return cc_luma_fixture_set (model, key, value, error);
+    }
+  }
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid or cross-page Settings privacy preference");
+  return FALSE;
+}
diff --git a/shell/cc-luma-privacy.h b/shell/cc-luma-privacy.h
new file mode 100644
index 0000000..1bab330
--- /dev/null
+++ b/shell/cc-luma-privacy.h
@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "cc-luma-fixture.h"
+G_BEGIN_DECLS
+gboolean cc_luma_privacy_page (const char *page);
+gboolean cc_luma_privacy_validate (CcLumaFixture *model);
+gboolean cc_luma_privacy_set (CcLumaFixture *model, const char *page,
+                             const char *key, JsonNode *value, GError **error);
+G_END_DECLS
diff --git a/shell/cc-luma-view-privacy.c b/shell/cc-luma-view-privacy.c
new file mode 100644
index 0000000..323d595
--- /dev/null
+++ b/shell/cc-luma-view-privacy.c
@@ -0,0 +1,191 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view-private.h"
+#include "cc-luma-privacy.h"
+
+static void flag (View *v, GtkBox *rows, const char *key, const char *title, const char *hint)
+{
+  g_autofree char *name = g_strconcat ("cf-", key, NULL);
+  cc_luma_view_row (rows, title, hint, cc_luma_view_toggle (v, key, name, title));
+}
+static void link_clicked (GtkButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (v && gtk_widget_is_ancestor (GTK_WIDGET (button), root))
+    cc_luma_view_navigate (v, g_object_get_data (G_OBJECT (button), "cf-target"));
+}
+static void link_row (View *v, GtkBox *rows, const char *target, const char *title,
+                      const char *hint, const char *icon, const char *status)
+{
+  GtkWidget *item = luma_details_item_new (title, hint, icon);
+  g_autofree char *name = g_strconcat ("cf-go-", target, NULL);
+  gtk_widget_set_name (item, name);
+  g_object_set_data_full (G_OBJECT (item), "cf-target", g_strdup (target), g_free);
+  g_signal_connect_object (item, "clicked", G_CALLBACK (link_clicked), v->root, 0);
+  GtkWidget *trail = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 10);
+  if (status) gtk_box_append (GTK_BOX (trail), cc_luma_view_label (status, "meta", TRUE));
+  gtk_box_append (GTK_BOX (trail), luma_ui_icon_new ("chevron-right"));
+  luma_details_item_set_trail (LUMA_DETAILS_ITEM (item), trail);
+  gtk_box_append (rows, item);
+}
+static void facts (View *v)
+{
+  const char *titles[] = { "Disk encryption", "Secure Boot", "Firmware" };
+  const char *values[] = { "On", "On", "Up to date" };
+  GtkWidget *row = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 20);
+  gtk_widget_set_name (row, "cf-security-facts");
+  for (guint i = 0; i < G_N_ELEMENTS (titles); i++) {
+    GtkWidget *fact = gtk_box_new (GTK_ORIENTATION_VERTICAL, 4);
+    gtk_widget_set_hexpand (fact, TRUE);
+    gtk_box_append (GTK_BOX (fact), luma_ui_icon_new ("shield-check"));
+    gtk_box_append (GTK_BOX (fact), cc_luma_view_label (values[i], "body", FALSE));
+    gtk_box_append (GTK_BOX (fact), cc_luma_view_label (titles[i], "small", TRUE));
+    gtk_box_append (GTK_BOX (row), fact);
+  }
+  /* Exact sample facts are fixture-only. A production adapter must supply
+   * actual encrypted-device, Secure Boot and firmware evidence. */
+  gtk_box_append (v->body, row);
+}
+static void privacy (View *v)
+{
+  g_autofree char *meta = g_strdup_printf ("Screen locks %s · location %s",
+    cc_luma_view_flag (v, "lock.auto") ? "when it turns off" : "only when you lock it",
+    cc_luma_view_flag (v, "loc") ? "on" : "off");
+  cc_luma_view_header (v, "Privacy & Security", meta, NULL); facts (v);
+  GtkBox *rows = cc_luma_view_group (v, NULL);
+  link_row (v, rows, "p-lock", "Screen lock", "When the screen locks, and what shows on it", "lock", NULL);
+  link_row (v, rows, "p-loc", "Location", "Apps that can see where you are", "map-pin", cc_luma_view_flag (v, "loc") ? "On" : "Off");
+  link_row (v, rows, "p-cam", "Camera", NULL, "camera", cc_luma_view_flag (v, "cam") ? "On" : "Off");
+  link_row (v, rows, "p-mic", "Microphone", NULL, "mic", cc_luma_view_flag (v, "mic") ? "On" : "Off");
+  rows = cc_luma_view_group (v, NULL);
+  link_row (v, rows, "p-files", "File history and trash", "Recent files, the trash and temporary files", "history", NULL);
+  const char *diag = cc_luma_view_text (v, "diag");
+  link_row (v, rows, "p-diag", "Problem reports", NULL, "triangle-alert", g_str_equal (diag, "never") ? "Off" : g_str_equal (diag, "ask") ? "Ask first" : "Automatic");
+  link_row (v, rows, "p-dev", "Device security", "Encryption, Secure Boot and firmware", "shield-check", NULL);
+}
+static void screen_lock (View *v)
+{
+  cc_luma_view_header (v, "Screen lock", cc_luma_view_flag (v, "lock.auto") ? "Locks when the screen turns off" : "Locks only when you lock it", NULL);
+  GtkBox *rows = cc_luma_view_group (v, NULL);
+  const char * const blank[] = { "1", "1 minute", "2", "2 minutes", "3", "3 minutes", "5", "5 minutes", "8", "8 minutes", "10", "10 minutes", "15", "15 minutes", "0", "Never", NULL };
+  const char * const delay[] = { "0", "Straight away", "30", "30 seconds", "60", "1 minute", "300", "5 minutes", NULL };
+  cc_luma_view_row (rows, "Turn the screen off after", NULL, cc_luma_view_picker (v, "lock.blank", blank));
+  flag (v, rows, "lock.auto", "Lock when the screen turns off", NULL);
+  if (cc_luma_view_flag (v, "lock.auto")) cc_luma_view_row (rows, "Lock after", "Time to wake it without your password", cc_luma_view_picker (v, "lock.delay", delay));
+  flag (v, rows, "lock.notes", "Notifications on the lock screen", NULL);
+}
+static void permissions (View *v)
+{
+  gboolean location = g_str_equal (v->page, "p-loc"), camera = g_str_equal (v->page, "p-cam");
+  const char *master = location ? "loc" : camera ? "cam" : "mic";
+  const char *prefix = location ? "appLoc" : camera ? "appCam" : "appMic";
+  gboolean enabled = cc_luma_view_flag (v, master);
+  cc_luma_view_header (v, location ? "Location" : camera ? "Camera" : "Microphone",
+    location ? enabled ? "Worked out from nearby Wi‑Fi networks" : "No app can see where you are" :
+    camera ? enabled ? "Apps you allow can use the camera" : "No app can use the camera" :
+    enabled ? "Apps you allow can use the microphone" : "No app can use the microphone", master);
+  if (!enabled) return;
+  GtkBox *rows = cc_luma_view_group (v, "Apps that asked");
+  JsonObject *apps = json_node_get_object (cc_luma_fixture_get (v->model, prefix));
+  g_autoptr(GList) names = json_object_get_members (apps);
+  for (GList *name = names; name; name = name->next) {
+    const char *id = name->data;
+    g_autofree char *key = g_strconcat (prefix, ".", id, NULL);
+    g_autofree char *widget_name = g_strconcat ("cf-", key, NULL);
+    GtkWidget *item = luma_details_item_new (cc_luma_fixture_app_name (v->model, id), location && g_str_equal (id, "maps") ? "Last used today" : NULL, NULL);
+    luma_details_item_set_lead (LUMA_DETAILS_ITEM (item), cc_luma_view_image (v, id, 30, 30));
+    luma_details_item_set_trail (LUMA_DETAILS_ITEM (item), cc_luma_view_toggle (v, key, widget_name, cc_luma_fixture_app_name (v->model, id)));
+    gtk_box_append (rows, item);
+  }
+}
+static void confirmed (LumaDestructiveDialog *dialog, gboolean checked, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  guint64 *generation = g_object_get_data (G_OBJECT (dialog), "cf-privacy-generation");
+  if (!v || !generation || *generation != v->generation || !g_str_equal (v->page, "p-files") || !gtk_widget_get_root (root)) return;
+  luma_toast_show (root, g_object_get_data (G_OBJECT (dialog), "cf-privacy-message"), "done");
+}
+static void clear_history (GtkButton *button, View *v);
+static void empty_trash (GtkButton *button, View *v);
+static void ask (View *v, const char *title, const char *body, const char *caption, const char *message)
+{
+  LumaDestructiveDialog *dialog = luma_destructive_dialog_ask (v->root, title, body, caption, "trash-2", NULL);
+  guint64 *generation = g_new (guint64, 1); *generation = v->generation;
+  g_object_set_data_full (G_OBJECT (dialog), "cf-privacy-generation", generation, g_free);
+  g_object_set_data_full (G_OBJECT (dialog), "cf-privacy-message", g_strdup (message), g_free);
+  g_signal_connect_object (dialog, "confirmed", G_CALLBACK (confirmed), v->root, 0);
+}
+static void clear_history (GtkButton *button, View *v) { ask (v, "Clear recent files?", "The files stay where they are. Only the list is cleared.", "Clear", "Recent files cleared"); }
+static void empty_trash (GtkButton *button, View *v) { ask (v, "Empty the trash?", "214 items, 1.2 GB. They can’t be brought back.", "Empty trash", "Trash emptied"); }
+static void clear_temp (GtkButton *button, View *v) { luma_toast_show (v->root, "380 MB of temporary files deleted", "done"); }
+static void command (View *v, GtkBox *rows, const char *name, const char *title, const char *hint, const char *caption, GCallback callback)
+{
+  GtkWidget *button = cc_luma_view_command (v, caption, callback); gtk_widget_set_name (button, name);
+  cc_luma_view_row (rows, title, hint, button);
+}
+static void files (View *v)
+{
+  cc_luma_view_header (v, "File history and trash", cc_luma_view_flag (v, "hist") ? "Remembering files you open" : "Not remembering files you open", NULL);
+  GtkBox *rows = cc_luma_view_group (v, "Recent files");
+  flag (v, rows, "hist", "Remember files I open", "Shown in Recent and in search");
+  const char * const history[] = { "1", "1 day", "7", "7 days", "30", "30 days", "forever", "Forever", NULL };
+  const char * const age[] = { "1", "1 day", "7", "7 days", "30", "30 days", NULL };
+  if (cc_luma_view_flag (v, "hist")) cc_luma_view_row (rows, "Keep for", NULL, cc_luma_view_picker (v, "histKeep", history));
+  command (v, rows, "cf-clearhist", "Clear recent files", NULL, "Clear…", G_CALLBACK (clear_history));
+  rows = cc_luma_view_group (v, "Trash and temporary files");
+  flag (v, rows, "trash", "Empty the trash on its own", NULL);
+  flag (v, rows, "temp", "Delete temporary files on their own", NULL);
+  if (cc_luma_view_flag (v, "trash") || cc_luma_view_flag (v, "temp")) cc_luma_view_row (rows, "After", NULL, cc_luma_view_picker (v, "trashAge", age));
+  command (v, rows, "cf-emptytrash", "Empty the trash", "1.2 GB in 214 items", "Empty…", G_CALLBACK (empty_trash));
+  command (v, rows, "cf-cleartemp", "Delete temporary files", "380 MB", "Delete…", G_CALLBACK (clear_temp));
+  /* Feedback follows the fixture exactly. This never opens Housekeeping,
+   * RecentManager, a trash store or an installed application's data. */
+}
+static void diag_selected (GtkCheckButton *control, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v || !gtk_check_button_get_active (control) || !gtk_widget_is_ancestor (GTK_WIDGET (control), root) || !g_str_equal (v->page, "p-diag")) return;
+  g_autoptr(JsonNode) value = json_node_init_string (json_node_alloc (), g_object_get_data (G_OBJECT (control), "cf-diag-value"));
+  g_autoptr(GError) error = NULL;
+  if (cc_luma_privacy_set (v->model, v->page, "diag", value, &error)) cc_luma_view_queue_refresh (v);
+  else cc_luma_view_report_error (v, error);
+}
+static void diagnostics (View *v)
+{
+  cc_luma_view_header (v, "Problem reports", "When an app crashes, a report can help the Luma team fix it", NULL);
+  GtkBox *rows = cc_luma_view_group (v, NULL);
+  const char *values[] = { "never", "ask", "auto" }, *titles[] = { "Don’t send", "Ask me each time", "Send automatically" };
+  GtkCheckButton *group = NULL;
+  for (guint i = 0; i < G_N_ELEMENTS (values); i++) {
+    GtkWidget *control = gtk_check_button_new ();
+    gtk_check_button_set_group (GTK_CHECK_BUTTON (control), group);
+    if (!group) group = GTK_CHECK_BUTTON (control);
+    gtk_check_button_set_active (GTK_CHECK_BUTTON (control), g_str_equal (values[i], cc_luma_view_text (v, "diag")));
+    g_autofree char *name = g_strconcat ("cf-diag-", values[i], NULL); gtk_widget_set_name (control, name);
+    gtk_accessible_update_property (GTK_ACCESSIBLE (control), GTK_ACCESSIBLE_PROPERTY_LABEL, titles[i], -1);
+    g_object_set_data_full (G_OBJECT (control), "cf-diag-value", g_strdup (values[i]), g_free);
+    g_signal_connect_object (control, "toggled", G_CALLBACK (diag_selected), v->root, 0);
+    cc_luma_view_row (rows, titles[i], i == 1 ? "You see what’s in it first" : NULL, control);
+  }
+}
+static void device (View *v)
+{
+  cc_luma_view_header (v, "Device security", "Every check passed", NULL);
+  GtkBox *rows = cc_luma_view_group (v, NULL);
+  const char *titles[] = { "Disk encryption", "Secure Boot", "TPM", "Firmware" };
+  const char *values[] = { "On", "On", "Version 2.0", "Up to date" };
+  const char *icons[] = { "lock", "shield-check", "cpu", "refresh-cw" };
+  for (guint i = 0; i < G_N_ELEMENTS (titles); i++) {
+    GtkWidget *item = luma_details_item_new (titles[i], NULL, icons[i]);
+    luma_details_item_set_trail (LUMA_DETAILS_ITEM (item), cc_luma_view_label (values[i], "meta", TRUE)); gtk_box_append (rows, item);
+  }
+  rows = cc_luma_view_group (v, "Thunderbolt"); flag (v, rows, "tbolt", "Allow new Thunderbolt devices", "Devices you already use keep working");
+}
+void cc_luma_view_privacy_render (View *v)
+{
+  if (g_str_equal (v->page, "privacy")) privacy (v);
+  else if (g_str_equal (v->page, "p-lock")) screen_lock (v);
+  else if (g_str_equal (v->page, "p-loc") || g_str_equal (v->page, "p-cam") || g_str_equal (v->page, "p-mic")) permissions (v);
+  else if (g_str_equal (v->page, "p-files")) files (v);
+  else if (g_str_equal (v->page, "p-diag")) diagnostics (v);
+  else if (g_str_equal (v->page, "p-dev")) device (v);
+}
