diff --git a/shell/test-luma-view.c b/shell/test-luma-view.c
index b383b9a..cafb46b 100644
--- a/shell/test-luma-view.c
+++ b/shell/test-luma-view.c
@@ -3,6 +3,7 @@
 #include <string.h>
 #include <luma-ui.h>
 #include <glib/gstdio.h>
+#include <luma-appearance.h>
 
 static GtkWidget *find_name (GtkWidget *root, const char *name)
 {
@@ -324,6 +325,41 @@ static void remove_asset_fixture (const char *dir)
   if (g_file_test (image, G_FILE_TEST_EXISTS)) g_assert_cmpint (g_remove (image), ==, 0);
   g_assert_cmpint (g_rmdir (dir), ==, 0);
 }
+static void appearance_view (void)
+{
+  g_autofree char *dir = asset_fixture ();
+  g_autofree char *json = g_build_filename (dir, "settings.json", NULL);
+  g_autoptr (CcLumaFixture) model = cc_luma_fixture_load (json, NULL);
+  JsonObject *wifi = json_object_get_object_member (cc_luma_fixture_get_data (model), "CFWIFI");
+  const char *art = json_object_get_string_member (json_object_get_object_member (wifi, "share_codes"), "Studio North");
+  const char *files[] = { "prism.png", "meadow.png", "blue-fog.png", "ember.png", "luma-creatives.png" };
+  for (guint i = 0; i < G_N_ELEMENTS (files); i++)
+    { g_autofree char *p = g_build_filename (dir, files[i], NULL); g_assert_true (g_file_set_contents (p, art, -1, NULL)); }
+  AdwStyleManager *manager = adw_style_manager_get_default ();
+  g_autoptr (GSettings) treatment = g_settings_new ("org.project_luma.shell-state");
+  g_autoptr (GVariant) before = g_settings_get_user_value (treatment, "surface-treatment");
+  g_autoptr (LumaSurfacePolicy) policy = luma_surface_policy_new (LUMA_SURFACE_TARGET_APPLICATION);
+  g_assert_true (luma_surface_policy_select (policy, "dark", NULL));
+  GtkWidget *view = g_object_ref_sink (cc_luma_view_new (model, "appearance", NULL));
+  g_assert_true (has_text (view, "Dark · Blue accent · Prism"));
+  g_signal_emit_by_name (find_name (view, "cf-mode-light"), "clicked"); drain ();
+  g_assert_false (adw_style_manager_get_dark (manager));
+  g_assert_true (has_text (view, "Light · Blue accent · Prism"));
+  g_signal_emit_by_name (find_name (view, "cf-wall-meadow"), "clicked"); drain ();
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "wall")), ==, "meadow");
+  g_assert_true (has_text (view, "Light · Blue accent · Meadow"));
+  gtk_switch_set_active (GTK_SWITCH (find_name (view, "cf-tint")), FALSE); drain ();
+  g_assert_false (json_node_get_boolean (cc_luma_fixture_get (model, "tint")));
+  wait_ms (100); g_assert_null (cc_luma_view_get_error (view));
+  GtkWidget *button = g_object_ref (find_name (view, "cf-mode-dark"));
+  g_object_unref (view); g_signal_emit_by_name (button, "clicked"); g_object_unref (button); wait_ms (100);
+  g_assert_false (adw_style_manager_get_dark (manager));
+  if (before) g_settings_set_value (treatment, "surface-treatment", before);
+  else g_settings_reset (treatment, "surface-treatment");
+  for (guint i = 1; i < G_N_ELEMENTS (files); i++)
+    { g_autofree char *p = g_build_filename (dir, files[i], NULL); g_assert_cmpint (g_remove (p), ==, 0); }
+  remove_asset_fixture (dir);
+}
 static void shelf_view (void)
 {
   g_autofree char *dir = asset_fixture ();
@@ -481,6 +517,7 @@ int main (int argc, char **argv)
   g_test_add_func ("/settings/view/asset-loading", asset_loading);
   g_test_add_func ("/settings/view/windows", windows_view);
   g_test_add_func ("/settings/view/shelf", shelf_view);
+  g_test_add_func ("/settings/view/appearance", appearance_view);
   g_test_add_func ("/settings/view/missing-asset", missing_asset);
   return g_test_run ();
 }
