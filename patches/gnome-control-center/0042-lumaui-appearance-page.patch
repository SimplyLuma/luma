diff --git a/shell/cc-luma-view-appearance.c b/shell/cc-luma-view-appearance.c
new file mode 100644
index 0000000..c23b77c
--- /dev/null
+++ b/shell/cc-luma-view-appearance.c
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view-private.h"
+#include "cc-luma-desktop.h"
+#include <luma-appearance.h>
+
+static void mode_clicked (GtkButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  const char *mode = g_object_get_data (G_OBJECT (button), "cf-mode");
+  /* The fixture entry point selects memory before any kit/settings object.
+   * Refuse a persistent backend if this view is reused outside that contract. */
+  if (g_strcmp0 (g_getenv ("GSETTINGS_BACKEND"), "memory") != 0)
+    {
+      g_autoptr (GError) error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Fixture theme requires memory settings");
+      cc_luma_view_report_error (v, error);
+      return;
+    }
+  g_autoptr (LumaSurfacePolicy) policy = luma_surface_policy_new (LUMA_SURFACE_TARGET_APPLICATION);
+  g_autoptr (GError) error = NULL;
+  if (luma_surface_policy_select (policy, mode, &error)) cc_luma_view_queue_refresh (v);
+  else cc_luma_view_report_error (v, error);
+}
+static GtkWidget *mini_frame (View *v)
+{
+  GtkWidget *preview = gtk_overlay_new ();
+  gtk_widget_set_size_request (preview, 210, 128);
+  gtk_overlay_set_child (GTK_OVERLAY (preview), cc_luma_view_image (v, cc_luma_view_text (v, "wall"), 420, 256));
+  GtkWidget *parts = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 5);
+  GtkWidget *side = luma_card_new (NULL, FALSE);
+  gtk_widget_set_size_request (side, 34, -1);
+  GtkWidget *content = luma_card_new (NULL, FALSE);
+  luma_card_set_recessed (LUMA_CARD (content), TRUE);
+  gtk_widget_set_hexpand (content, TRUE);
+  gtk_box_append (GTK_BOX (parts), side); gtk_box_append (GTK_BOX (parts), content);
+  GtkWidget *window = luma_card_new (parts, FALSE);
+  gtk_widget_set_margin_start (parts, 5); gtk_widget_set_margin_end (parts, 5);
+  gtk_widget_set_margin_top (parts, 5); gtk_widget_set_margin_bottom (parts, 5);
+  gtk_widget_set_margin_start (window, 20); gtk_widget_set_margin_end (window, 20);
+  gtk_widget_set_margin_top (window, 16); gtk_widget_set_margin_bottom (window, 26);
+  gtk_overlay_add_overlay (GTK_OVERLAY (preview), window);
+  /* TODO(kit-request settings-06-color-swatch-and-fixture-accent.md):
+   * explicit light/dark diagram tokens and miniature frame paint parity. */
+  return preview;
+}
+static GtkWidget *modes (View *v)
+{
+  const char *ids[] = { "light", "dark" }, *names[] = { "Light", "Dark" };
+  gboolean dark = adw_style_manager_get_dark (adw_style_manager_get_default ());
+  GtkWidget *group = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 18);
+  gtk_widget_set_halign (group, GTK_ALIGN_CENTER);
+  for (guint i = 0; i < G_N_ELEMENTS (ids); i++)
+    {
+      GtkWidget *button = gtk_toggle_button_new ();
+      GtkWidget *content = gtk_box_new (GTK_ORIENTATION_VERTICAL, 8);
+      gtk_box_append (GTK_BOX (content), mini_frame (v));
+      GtkWidget *label = cc_luma_view_label (names[i], "caption", FALSE);
+      gtk_label_set_xalign (GTK_LABEL (label), .5);
+      gtk_box_append (GTK_BOX (content), label);
+      gtk_button_set_child (GTK_BUTTON (button), content);
+      gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (button), (i == 1) == dark);
+      g_autofree char *name = g_strconcat ("cf-mode-", ids[i], NULL);
+      gtk_widget_set_name (button, name);
+      g_object_set_data (G_OBJECT (button), "cf-mode", (gpointer) ids[i]);
+      gtk_accessible_update_property (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_PROPERTY_LABEL, names[i], -1);
+      g_signal_connect_object (button, "clicked", G_CALLBACK (mode_clicked), v->root, 0);
+      gtk_box_append (GTK_BOX (group), button);
+    }
+  return group;
+}
+static void wallpaper_clicked (GtkButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  const char *wall = g_object_get_data (G_OBJECT (button), "cf-wall");
+  g_autoptr (GError) error = NULL;
+  if (cc_luma_appearance_set_wall (v->model, wall, &error)) cc_luma_view_queue_refresh (v);
+  else cc_luma_view_report_error (v, error);
+}
+static void add_wallpaper (GtkButton *button, GtkWidget *root)
+{
+  if (g_object_get_data (G_OBJECT (root), "cf-view")) luma_toast_show (root, "Choose a picture in Filer", "success");
+}
+static GtkWidget *wallpapers (View *v)
+{
+  GtkWidget *grid = gtk_grid_new ();
+  gtk_grid_set_column_homogeneous (GTK_GRID (grid), TRUE);
+  gtk_grid_set_column_spacing (GTK_GRID (grid), 10);
+  JsonArray *catalog = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFWALL");
+  for (guint i = 0; i < json_array_get_length (catalog); i++)
+    {
+      JsonArray *pair = json_array_get_array_element (catalog, i);
+      const char *id = json_array_get_string_element (pair, 0), *caption = json_array_get_string_element (pair, 1);
+      GtkWidget *button = gtk_toggle_button_new ();
+      GtkWidget *picture = cc_luma_view_image (v, id, 160, 100);
+      gtk_widget_set_size_request (picture, 40, 25);
+      gtk_button_set_child (GTK_BUTTON (button), picture);
+      gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (button), g_str_equal (id, cc_luma_view_text (v, "wall")));
+      gtk_widget_set_tooltip_text (button, caption);
+      gtk_accessible_update_property (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_PROPERTY_LABEL, caption, -1);
+      g_autofree char *name = g_strconcat ("cf-wall-", id, NULL);
+      gtk_widget_set_name (button, name);
+      g_object_set_data_full (G_OBJECT (button), "cf-wall", g_strdup (id), g_free);
+      g_signal_connect_object (button, "clicked", G_CALLBACK (wallpaper_clicked), v->root, 0);
+      gtk_grid_attach (GTK_GRID (grid), button, i, 0, 1, 1);
+    }
+  GtkWidget *add = gtk_button_new ();
+  g_signal_connect_object (add, "clicked", G_CALLBACK (add_wallpaper), v->root, 0);
+  gtk_button_set_child (GTK_BUTTON (add), luma_ui_icon_new ("plus"));
+  gtk_widget_set_name (add, "cf-wall-add");
+  gtk_widget_set_tooltip_text (add, "Add a picture");
+  gtk_accessible_update_property (GTK_ACCESSIBLE (add), GTK_ACCESSIBLE_PROPERTY_LABEL, "Add a picture", -1);
+  gtk_grid_attach (GTK_GRID (grid), add, json_array_get_length (catalog), 0, 1, 1);
+  return grid;
+}
+void cc_luma_view_appearance_render (View *v)
+{
+  JsonObject *data = cc_luma_fixture_get_data (v->model);
+  JsonArray *accents = json_object_get_array_member (data, "CFACC"), *walls = json_object_get_array_member (data, "CFWALL");
+  const char *accent = "", *wall = "";
+  for (guint i = 0; i < json_array_get_length (accents); i++)
+    { JsonArray *p = json_array_get_array_element (accents, i); if (json_array_get_int_element (p, 0) == json_node_get_int (cc_luma_fixture_get (v->model, "acc"))) accent = json_array_get_string_element (p, 1); }
+  for (guint i = 0; i < json_array_get_length (walls); i++)
+    { JsonArray *p = json_array_get_array_element (walls, i); if (g_str_equal (json_array_get_string_element (p, 0), cc_luma_view_text (v, "wall"))) wall = json_array_get_string_element (p, 1); }
+  g_autofree char *meta = g_strdup_printf ("%s · %s accent · %s", adw_style_manager_get_dark (adw_style_manager_get_default ()) ? "Dark" : "Light", accent, wall);
+  cc_luma_view_header (v, "Appearance", meta, NULL);
+  GtkWidget *hero = luma_card_new (modes (v), TRUE);
+  luma_card_set_recessed (LUMA_CARD (hero), TRUE); gtk_widget_set_margin_top (hero, 20); gtk_box_append (v->body, hero);
+  /* TODO(kit-request settings-06-color-swatch-and-fixture-accent.md):
+   * compose the Accent group once the C semantic swatch API lands. */
+  GtkBox *rows = cc_luma_view_group (v, "Background");
+  gtk_box_append (rows, wallpapers (v));
+  rows = cc_luma_view_group (v, "Windows");
+  cc_luma_view_row (rows, "Tint windows with what they hold", "A frame takes a little colour from its album, photo or folder",
+    cc_luma_view_toggle (v, "tint", "cf-tint", "Tint windows with what they hold"));
+}
diff --git a/shell/cc-luma-view-private.h b/shell/cc-luma-view-private.h
index 270610e..869c905 100644
--- a/shell/cc-luma-view-private.h
+++ b/shell/cc-luma-view-private.h
@@ -51,3 +51,5 @@ void cc_luma_view_windows_render (View *v);
 GtkWidget *cc_luma_view_link (View *v, const char *caption, const char *target);
 GtkWidget *cc_luma_view_picker (View *v, const char *key, const char * const *choices);
 void cc_luma_view_shelf_render (View *v);
+
+void cc_luma_view_appearance_render (View *v);
diff --git a/shell/cc-luma-view.c b/shell/cc-luma-view.c
index 8fe8582..a13274f 100644
--- a/shell/cc-luma-view.c
+++ b/shell/cc-luma-view.c
@@ -601,6 +601,7 @@ static void render (View *v)
   else if (g_str_equal (v->page, "bluetooth")) cc_luma_view_bluetooth_render (v);
   else if (g_str_equal (v->page, "windows")) cc_luma_view_windows_render (v);
   else if (g_str_equal (v->page, "shelf")) cc_luma_view_shelf_render (v);
+  else if (g_str_equal (v->page, "appearance")) cc_luma_view_appearance_render (v);
 }
 static void view_free (View *v)
 {
@@ -678,14 +679,15 @@ GtkWidget *cc_luma_view_new (CcLumaFixture *model, const char *page, GError **er
   View *v;
   if (!page) page = "wifi";
   if (!g_str_equal (page, "wifi") && !g_str_equal (page, "wifi-net") &&
-      !g_str_equal (page, "wifi-known") && !g_str_equal (page, "hotspot") && !g_str_equal (page, "network") && !g_str_equal (page, "bluetooth") && !g_str_equal (page, "windows") && !g_str_equal (page, "shelf"))
+      !g_str_equal (page, "wifi-known") && !g_str_equal (page, "hotspot") && !g_str_equal (page, "network") && !g_str_equal (page, "bluetooth") && !g_str_equal (page, "windows") && !g_str_equal (page, "shelf") && !g_str_equal (page, "appearance"))
     {
       g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Settings page is not ported yet: %s", page);
       return NULL;
     }
   if (!valid_wifi_model (model) || (g_str_equal (page, "bluetooth") && !cc_luma_bluetooth_validate (model)) ||
       (g_str_equal (page, "windows") && !cc_luma_windows_validate (model)) ||
-      (g_str_equal (page, "shelf") && !cc_luma_shelf_validate (model)))
+      (g_str_equal (page, "shelf") && !cc_luma_shelf_validate (model)) ||
+      (g_str_equal (page, "appearance") && !cc_luma_appearance_validate (model)))
     {
       g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Settings fixture contains invalid Wi-Fi data");
       return NULL;
