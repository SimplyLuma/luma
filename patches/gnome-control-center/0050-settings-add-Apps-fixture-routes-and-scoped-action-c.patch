+static void apps_model (void)
+{
+  g_autoptr(CcLumaFixture) model = cc_luma_fixture_load (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), NULL);
+  g_assert_nonnull (model);
+  g_assert_true (cc_luma_fixture_apps_validate (model));
+  JsonArray *apps = json_object_get_array_member (cc_luma_fixture_get_data (model), "CFAPPS");
+  g_assert_cmpuint (json_array_get_length (apps), ==, 18);
+  for (guint i = 0; i < json_array_get_length (apps); i++) {
+    const char *app = json_array_get_string_element (apps, i);
+    g_assert_nonnull (cc_luma_fixture_app_name (model, app));
+    g_assert_true (cc_luma_fixture_prepare_app (model, app, NULL));
+    for (guint j = 0; j < cc_luma_fixture_app_permission_count (model, app); j++) {
+      const char *permission = cc_luma_fixture_app_permission (model, app, j);
+      g_autofree char *key = g_strconcat ("perm_", app, permission, NULL);
+      g_assert_true (json_node_get_boolean (cc_luma_fixture_get (model, key)));
+      g_assert_true (cc_luma_fixture_set_flag (model, key, FALSE, NULL));
+      g_assert_true (cc_luma_fixture_prepare_app (model, app, NULL));
+      g_assert_false (json_node_get_boolean (cc_luma_fixture_get (model, key)));
+    }
+    g_autofree char *unknown = g_strconcat ("perm_", app, "unknown", NULL);
+    g_assert_false (cc_luma_fixture_set_flag (model, unknown, TRUE, NULL));
+    g_assert_null (cc_luma_fixture_get (model, unknown));
+    g_assert_null (cc_luma_fixture_app_permission (model, app, 99));
+  }
+  g_assert_false (cc_luma_fixture_prepare_app (model, "../../real-app", NULL));
+  g_assert_false (cc_luma_fixture_prepare_app (model, "no-such-app", NULL));
+  g_assert_true (cc_luma_fixture_apps_validate (model));
+  g_autoptr(CcLumaFixture) malformed = cc_luma_fixture_load (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), NULL);
+  JsonObject *permissions = json_object_get_object_member (cc_luma_fixture_get_data (malformed), "CFPERMS");
+  JsonArray *camera = json_object_get_array_member (permissions, "camera");
+  json_array_remove_element (camera, 1);
+  json_array_add_string_element (camera, "unknown");
+  g_assert_null (cc_luma_fixture_get (malformed, "perm_cameracam"));
+  g_assert_false (cc_luma_fixture_prepare_app (malformed, "camera", NULL));
+  /* A valid first permission must not be initialized before a later failure. */
+  g_assert_null (cc_luma_fixture_get (malformed, "perm_cameracam"));
+  g_assert_false (cc_luma_fixture_apps_validate (malformed));
+  g_autoptr(CcLumaFixture) bad_size = cc_luma_fixture_load (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), NULL);
+  JsonObject *sizes = json_object_get_object_member (cc_luma_fixture_get_data (bad_size), "CFSZ");
+  json_node_set_int (json_array_get_element (json_object_get_array_member (sizes, "filer"), 0), -1);
+  g_assert_false (cc_luma_fixture_prepare_app (bad_size, "filer", NULL));
+  g_assert_null (cc_luma_fixture_get (bad_size, "perm_filersearch"));
+  g_assert_false (cc_luma_fixture_apps_validate (bad_size));
+  const gint64 amounts[] = { 0, 999, 1000, 1050, 1150, 1250, 1450, 2250, 2650, 18700, G_MAXINT64 };
+  const char *expected[] = { "0 MB", "999 MB", "1 GB", "1.1 GB", "1.1 GB", "1.3 GB", "1.4 GB", "2.3 GB", "2.6 GB", "18.7 GB", "9223372036854776 GB" };
+  for (guint i = 0; i < G_N_ELEMENTS (amounts); i++) {
+    g_autofree char *formatted = cc_luma_fixture_format_size (amounts[i]);
+    g_assert_cmpstr (formatted, ==, expected[i]);
+  }
+}
