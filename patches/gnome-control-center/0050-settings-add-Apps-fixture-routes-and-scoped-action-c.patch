+static void apps_view (void)
+{
+  g_autofree char *dir = asset_fixture ();
+  g_autofree char *json = g_build_filename (dir, "settings.json", NULL);
+  g_autoptr(CcLumaFixture) model = cc_luma_fixture_load (json, NULL);
+  JsonObject *data = cc_luma_fixture_get_data (model);
+  JsonArray *apps = json_object_get_array_member (data, "CFAPPS");
+  JsonObject *wifi = json_object_get_object_member (data, "CFWIFI");
+  const char *art = json_object_get_string_member (json_object_get_object_member (wifi, "share_codes"), "Studio North");
+  g_assert_cmpuint (json_array_get_length (apps), ==, 18);
+  for (guint i = 0; i < json_array_get_length (apps); i++) {
+    g_autoptr(GError) error = NULL;
+    g_autofree char *path = cc_luma_fixture_asset_path (model, json_array_get_string_element (apps, i), &error);
+    g_assert_no_error (error); g_assert_nonnull (path);
+    g_assert_true (g_file_set_contents (path, art, -1, &error)); g_assert_no_error (error);
+  }
+  g_autofree char *sizes_before = json_to_string (json_object_get_member (data, "CFSZ"), FALSE);
+  const int widths[] = {1180, 390};
+  for (guint presentation = 0; presentation < G_N_ELEMENTS (widths); presentation++) {
+    GtkWidget *window = gtk_window_new ();
+    g_autoptr(GError) error = NULL;
+    GtkWidget *view = cc_luma_view_new (model, "apps", &error);
+    g_assert_no_error (error); g_assert_nonnull (view);
+    gtk_window_set_child (GTK_WINDOW (window), view);
+    gtk_window_set_default_size (GTK_WINDOW (window), widths[presentation], 740);
+    gtk_window_present (GTK_WINDOW (window)); wait_ms (150);
+    g_assert_cmpint (gtk_widget_get_width (window), ==, widths[presentation]);
+    g_assert_true (gtk_widget_get_mapped (view));
+    g_assert_nonnull (find_name (view, "cf-go-defaults")); g_assert_nonnull (find_name (view, "cf-go-media"));
+    View *v = g_object_get_data (G_OBJECT (view), "cf-view");
+    for (guint i = 0; i < json_array_get_length (apps); i++) {
+      const char *app = json_array_get_string_element (apps, i);
+      g_autofree char *target = g_strconcat ("app:", app, NULL);
+      g_autofree char *link_name = g_strconcat ("cf-go-", target, NULL);
+      GtkWidget *link = find_name (view, link_name); g_assert_true (LUMA_IS_DETAILS_ITEM (link));
+      g_signal_emit_by_name (link, "clicked"); wait_ms (100); g_assert_cmpstr (v->page, ==, target);
+      g_assert_true (has_text (view, cc_luma_fixture_app_name (model, app)));
+      g_assert_nonnull (find_name (view, "cf-app-open")); g_assert_true (has_text (view, "Documents and data"));
+      for (guint permission = 0; permission < cc_luma_fixture_app_permission_count (model, app); permission++) {
+        g_autofree char *key = g_strconcat ("perm_", app, cc_luma_fixture_app_permission (model, app, permission), NULL);
+        g_autofree char *name = g_strconcat ("cf-", key, NULL);
+        GtkWidget *toggle = find_name (view, name); g_assert_true (GTK_IS_SWITCH (toggle));
+        g_assert_cmpint (gtk_switch_get_active (GTK_SWITCH (toggle)), ==, json_node_get_boolean (cc_luma_fixture_get (model, key)));
+        gtk_switch_set_active (GTK_SWITCH (toggle), FALSE); wait_ms (100);
+        g_assert_false (json_node_get_boolean (cc_luma_fixture_get (model, key)));
+      }
+      g_signal_emit_by_name (find_name (view, "cf-app-clear-cache"), "clicked"); drain ();
+      g_assert_nonnull (find_type (window, LUMA_TYPE_TOAST));
+      g_autofree char *sizes_after = json_to_string (json_object_get_member (data, "CFSZ"), FALSE);
+      g_assert_cmpstr (sizes_after, ==, sizes_before);
+      gboolean system = g_str_equal (app, "filer") || g_str_equal (app, "viola") || g_str_equal (app, "term") || g_str_equal (app, "depot");
+      GtkWidget *uninstall = find_name (view, "cf-app-uninstall");
+      if (system) { g_assert_null (uninstall); g_assert_true (has_text (view, "Part of Luma")); }
+      else {
+        g_assert_true (GTK_IS_BUTTON (uninstall)); g_signal_emit_by_name (uninstall, "clicked"); wait_ms (100);
+        GtkWidget *dialog = find_type (window, LUMA_TYPE_DESTRUCTIVE_DIALOG); g_assert_nonnull (dialog);
+        g_assert_true (has_text (dialog, "Also remove its data"));
+        GtkWidget *cancel = find_button_caption (dialog, "Cancel"); g_assert_nonnull (cancel);
+        g_signal_emit_by_name (cancel, "clicked"); wait_dialog_closed (window);
+        g_assert_cmpstr (v->page, ==, target); g_assert_null (find_type (window, LUMA_TYPE_DESTRUCTIVE_DIALOG));
+      }
+      g_assert_null (cc_luma_view_get_error (view));
+      GtkWidget *back = find_name (view, "cf-go-apps"); g_assert_true (LUMA_IS_NAVIGATION_TRAIL_BAR (back));
+      g_signal_emit_by_name (back, "back"); wait_ms (100); g_assert_cmpstr (v->page, ==, "apps");
+    }
+    /* A confirmation may not act on a newer page or generation. */
+    g_signal_emit_by_name (find_name (view, "cf-go-app:photos"), "clicked"); wait_ms (100);
+    g_signal_emit_by_name (find_name (view, "cf-app-uninstall"), "clicked"); wait_ms (100);
+    GtkWidget *stale = find_type (window, LUMA_TYPE_DESTRUCTIVE_DIALOG); g_assert_nonnull (stale); g_object_ref (stale);
+    cc_luma_view_navigate (v, "app:messages"); wait_ms (100);
+    g_signal_emit_by_name (stale, "confirmed", TRUE); drain (); g_assert_cmpstr (v->page, ==, "app:messages");
+    GtkWidget *cancel = find_button_caption (stale, "Cancel"); g_assert_nonnull (cancel);
+    g_signal_emit_by_name (cancel, "clicked"); wait_dialog_closed (window); g_object_unref (stale);
+    g_signal_emit_by_name (find_name (view, "cf-app-uninstall"), "clicked"); wait_ms (100);
+    GtkWidget *dialog = find_type (window, LUMA_TYPE_DESTRUCTIVE_DIALOG); g_assert_nonnull (dialog);
+    GtkWidget *confirm = find_button_caption (dialog, "Uninstall"); g_assert_nonnull (confirm);
+    g_signal_emit_by_name (confirm, "clicked"); wait_dialog_closed (window); g_assert_cmpstr (v->page, ==, "apps");
+    g_assert_true (has_text (window, "Messages uninstalled. Its data is kept"));
+    cc_luma_view_navigate (v, "app:photos"); wait_ms (100);
+    g_signal_emit_by_name (find_name (view, "cf-app-uninstall"), "clicked"); wait_ms (100);
+    dialog = find_type (window, LUMA_TYPE_DESTRUCTIVE_DIALOG); g_assert_nonnull (dialog);
+    GtkWidget *option = find_type (dialog, GTK_TYPE_CHECK_BUTTON); g_assert_nonnull (option);
+    gtk_check_button_set_active (GTK_CHECK_BUTTON (option), TRUE);
+    g_assert_true (luma_destructive_dialog_get_option_checked (LUMA_DESTRUCTIVE_DIALOG (dialog)));
+    confirm = find_button_caption (dialog, "Uninstall"); g_assert_nonnull (confirm);
+    g_signal_emit_by_name (confirm, "clicked"); wait_dialog_closed (window);
+    g_assert_cmpstr (v->page, ==, "apps"); g_assert_true (has_text (window, "Photos uninstalled with its data"));
+    g_assert_cmpuint (json_array_get_length (apps), ==, 18);
+    g_autofree char *sizes_after = json_to_string (json_object_get_member (data, "CFSZ"), FALSE);
+    g_assert_cmpstr (sizes_after, ==, sizes_before); g_assert_null (cc_luma_view_get_error (view));
+    GtkWidget *orphan = g_object_ref (find_name (view, "cf-go-app:photos"));
+    gpointer weak_view = view; g_object_add_weak_pointer (G_OBJECT (view), &weak_view);
+    gtk_window_destroy (GTK_WINDOW (window)); wait_ms (100);
+    if (weak_view)
+    {
+      g_test_message ("Apps retained root: width=%d refs=%u parent=%s mapped=%d; orphan parent=%s",
+                      widths[presentation], G_OBJECT (weak_view)->ref_count,
+                      gtk_widget_get_parent (weak_view) ? G_OBJECT_TYPE_NAME (gtk_widget_get_parent (weak_view)) : "none",
+                      gtk_widget_get_mapped (weak_view),
+                      gtk_widget_get_parent (orphan) ? G_OBJECT_TYPE_NAME (gtk_widget_get_parent (orphan)) : "none");
+      gpointer observed = weak_view;
+      gint64 started = g_get_monotonic_time ();
+      g_object_add_weak_pointer (G_OBJECT (observed), &observed);
+      while (observed && g_get_monotonic_time () - started < 2 * G_USEC_PER_SEC)
+        wait_ms (10);
+      g_test_message ("Apps root observation after original deadline: released=%d elapsed-us=%" G_GINT64_FORMAT,
+                      observed == NULL, g_get_monotonic_time () - started);
+      if (observed) g_object_remove_weak_pointer (G_OBJECT (observed), &observed);
+      /* Observation must never turn the original 100 ms failure into a pass. */
+      g_error ("Apps view was retained at the original 100 ms teardown deadline");
+    }
+    g_assert_null (weak_view);
+    g_signal_emit_by_name (orphan, "clicked"); drain (); g_object_unref (orphan);
+    g_assert_cmpuint (json_array_get_length (apps), ==, 18);
+  }
+  for (guint i = 0; i < json_array_get_length (apps); i++) {
+    g_autofree char *path = cc_luma_fixture_asset_path (model, json_array_get_string_element (apps, i), NULL);
+    g_assert_cmpint (g_remove (path), ==, 0);
+  }
+  remove_asset_fixture (dir);
+}
