+    g_assert_null (find_name (view, "cf-lock.delay"));
+    gtk_switch_set_active (GTK_SWITCH (orphan), FALSE);
+    gtk_switch_set_active (GTK_SWITCH (orphan), TRUE); drain ();
+    g_assert_false (g_settings_get_boolean (lock, "lock-enabled")); g_object_unref (orphan);
