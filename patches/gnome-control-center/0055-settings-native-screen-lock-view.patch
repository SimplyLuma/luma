diff --git a/shell/cc-luma-view-live-lock.c b/shell/cc-luma-view-live-lock.c
new file mode 100644
index 0000000..1b3076e
--- /dev/null
+++ b/shell/cc-luma-view-live-lock.c
@@ -0,0 +1,167 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-view-private.h"
+
+struct _CcLumaLiveLock {
+  CcLumaPreferences *prefs[3];
+  GCancellable *write;
+  char *backup, *blank, *delay;
+  gboolean ready, automatic, notifications;
+  guint idle_seconds, delay_seconds;
+};
+static void changed (CcLumaPreferences *source, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (v && v->live_lock) cc_luma_view_queue_refresh (v);
+}
+CcLumaLiveLock *cc_luma_live_lock_new (CcLumaPreferences *lock,
+  CcLumaPreferences *session, CcLumaPreferences *notifications,
+  const char *backup, GError **error)
+{
+  if (g_getenv ("LUMA_SETTINGS_FIXTURE") || !CC_IS_LUMA_PREFERENCES (lock) ||
+      !CC_IS_LUMA_PREFERENCES (session) || !CC_IS_LUMA_PREFERENCES (notifications) ||
+      lock == session || lock == notifications || session == notifications ||
+      !backup || !g_path_is_absolute (backup)) {
+    g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+      "Live Screen lock requires dedicated native observers and a recovery directory outside fixture mode");
+    return NULL;
+  }
+  CcLumaLiveLock *self = g_new0 (CcLumaLiveLock, 1);
+  self->prefs[0] = g_object_ref (lock); self->prefs[1] = g_object_ref (session);
+  self->prefs[2] = g_object_ref (notifications); self->backup = g_strdup (backup);
+  return self;
+}
+void cc_luma_live_lock_start (View *v)
+{
+  for (guint i = 0; i < 3; i++) {
+    g_signal_connect_object (v->live_lock->prefs[i], "changed", G_CALLBACK (changed), v->root, 0);
+    cc_luma_preferences_start (v->live_lock->prefs[i]);
+  }
+}
+void cc_luma_live_lock_free (CcLumaLiveLock *self)
+{
+  if (!self) return;
+  if (self->write) g_cancellable_cancel (self->write);
+  g_clear_object (&self->write);
+  for (guint i = 0; i < 3; i++) { cc_luma_preferences_stop (self->prefs[i]); g_object_unref (self->prefs[i]); }
+  g_free (self->backup); g_free (self->blank); g_free (self->delay); g_free (self);
+}
+const char *cc_luma_live_lock_text (CcLumaLiveLock *self, const char *key)
+{
+  return g_str_equal (key, "lock.blank") ? self->blank ? self->blank : "" :
+    g_str_equal (key, "lock.delay") ? self->delay ? self->delay : "" : "";
+}
+gboolean cc_luma_live_lock_flag (CcLumaLiveLock *self, const char *key)
+{
+  return self->ready && (g_str_equal (key, "lock.auto") ? self->automatic :
+    g_str_equal (key, "lock.notes") && self->notifications);
+}
+static gint owner_key (const char *key, const char **native)
+{
+  if (g_str_equal (key, "lock.auto")) { *native = "lock-enabled"; return 0; }
+  if (g_str_equal (key, "lock.delay")) { *native = "lock-delay"; return 0; }
+  if (g_str_equal (key, "lock.blank")) { *native = "idle-delay"; return 1; }
+  if (g_str_equal (key, "lock.notes")) { *native = "show-in-lock-screen"; return 2; }
+  return -1;
+}
+gboolean cc_luma_live_lock_editable (CcLumaLiveLock *self, const char *key)
+{
+  const char *native = NULL; gint owner = owner_key (key, &native); gboolean writable = FALSE;
+  if (!self->ready || self->write || owner < 0) return FALSE;
+  g_autoptr(GVariant) values = cc_luma_preferences_dup_writable (self->prefs[owner]);
+  return values && g_variant_lookup (values, native, "b", &writable) && writable;
+}
+typedef struct { GWeakRef root; GCancellable *cancel; } LockWrite;
+static void written (GObject *source, GAsyncResult *result, gpointer data)
+{
+  LockWrite *write = data; g_autoptr(GError) error = NULL;
+  gboolean success = cc_luma_preferences_set_finish (CC_LUMA_PREFERENCES (source), result, &error);
+  g_autoptr(GtkWidget) root = g_weak_ref_get (&write->root);
+  View *v = root ? g_object_get_data (G_OBJECT (root), "cf-view") : NULL;
+  if (v && v->live_lock && v->live_lock->write == write->cancel) {
+    g_clear_object (&v->live_lock->write);
+    if (!success && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) cc_luma_view_report_error (v, error);
+    cc_luma_view_queue_refresh (v);
+  }
+  g_weak_ref_clear (&write->root); g_object_unref (write->cancel); g_free (write);
+}
+void cc_luma_live_lock_edit (View *v, const char *key, GVariant *value)
+{
+  CcLumaLiveLock *self = v->live_lock; const char *native = NULL;
+  gint owner = owner_key (key, &native);
+  if (owner < 0 || !cc_luma_live_lock_editable (self, key)) {
+    g_autoptr(GError) error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+      "This native Screen lock preference is unavailable, locked or already being edited");
+    cc_luma_view_report_error (v, error); cc_luma_view_queue_refresh (v); return;
+  }
+  self->write = g_cancellable_new (); LockWrite *write = g_new0 (LockWrite, 1);
+  g_weak_ref_init (&write->root, v->root); write->cancel = g_object_ref (self->write);
+  cc_luma_preferences_set_async (self->prefs[owner], native, value, self->backup,
+    self->write, written, write); cc_luma_view_queue_refresh (v);
+}
+void cc_luma_live_lock_pick (View *v, const char *key, const char *value)
+{
+  const char * const blanks[] = { "0", "1", "2", "3", "5", "8", "10", "15", NULL };
+  const char * const delays[] = { "0", "30", "60", "300", NULL };
+  const char * const *allowed = g_str_equal (key, "lock.blank") ? blanks :
+    g_str_equal (key, "lock.delay") ? delays : NULL;
+  for (guint i = 0; allowed && allowed[i]; i++) if (g_str_equal (value, allowed[i])) {
+    guint seconds = (guint) g_ascii_strtoull (value, NULL, 10);
+    if (allowed == blanks) seconds *= 60;
+    g_autoptr(GVariant) native = g_variant_ref_sink (g_variant_new_uint32 (seconds));
+    cc_luma_live_lock_edit (v, key, native); return;
+  }
+  /* An uncommon existing value is displayed exactly, never normalized. Its
+   * menu item is a no-op; only an explicit standard selection edits it. */
+  if (allowed && g_str_equal (value, cc_luma_live_lock_text (v->live_lock, key))) return;
+  g_autoptr(GError) error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+    "Invalid or cross-page native Screen lock selection");
+  cc_luma_view_report_error (v, error);
+}
+static GtkWidget *duration (View *v, const char *key, const char * const *choices, guint seconds)
+{
+  const char *current = cc_luma_live_lock_text (v->live_lock, key);
+  gboolean known = FALSE; guint count = 0;
+  for (; choices[count]; count += 2) if (g_str_equal (choices[count], current)) known = TRUE;
+  g_autoptr(GPtrArray) items = g_ptr_array_new_with_free_func (g_free);
+  for (guint i = 0; i < count; i++) g_ptr_array_add (items, g_strdup (choices[i]));
+  if (!known) {
+    g_ptr_array_add (items, g_strdup (current));
+    g_ptr_array_add (items, g_strdup_printf ("%u seconds", seconds));
+  }
+  g_ptr_array_add (items, NULL);
+  GtkWidget *picker = cc_luma_view_picker (v, key, (const char * const *) items->pdata);
+  gtk_widget_set_sensitive (picker, cc_luma_live_lock_editable (v->live_lock, key));
+  return picker;
+}
+void cc_luma_live_lock_render (View *v)
+{
+  CcLumaLiveLock *self = v->live_lock;
+  g_autoptr(GVariant) lock = cc_luma_preferences_dup_values (self->prefs[0]);
+  g_autoptr(GVariant) session = cc_luma_preferences_dup_values (self->prefs[1]);
+  g_autoptr(GVariant) notifications = cc_luma_preferences_dup_values (self->prefs[2]);
+  self->ready = FALSE;
+  if (!lock || !session || !notifications) {
+    cc_luma_view_header (v, "Screen lock", "Loading…", NULL); return;
+  }
+  if (!g_variant_lookup (lock, "lock-enabled", "b", &self->automatic) ||
+      !g_variant_lookup (lock, "lock-delay", "u", &self->delay_seconds) ||
+      !g_variant_lookup (session, "idle-delay", "u", &self->idle_seconds) ||
+      !g_variant_lookup (notifications, "show-in-lock-screen", "b", &self->notifications)) {
+    g_autoptr(GError) error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+      "Native Screen lock preferences have missing or incompatible fields");
+    cc_luma_view_header (v, "Screen lock", error->message, NULL); cc_luma_view_report_error (v, error); return;
+  }
+  self->ready = TRUE; g_free (self->blank); g_free (self->delay);
+  self->blank = self->idle_seconds % 60 ? g_strdup_printf ("native:%u", self->idle_seconds) : g_strdup_printf ("%u", self->idle_seconds / 60);
+  self->delay = g_strdup_printf ("%u", self->delay_seconds);
+  cc_luma_view_header (v, "Screen lock", self->automatic ? "Locks when the screen turns off" : "Locks only when you lock it", NULL);
+  GtkBox *rows = cc_luma_view_group (v, NULL);
+  const char * const blanks[] = { "1", "1 minute", "2", "2 minutes", "3", "3 minutes", "5", "5 minutes", "8", "8 minutes", "10", "10 minutes", "15", "15 minutes", "0", "Never", NULL };
+  const char * const delays[] = { "0", "Straight away", "30", "30 seconds", "60", "1 minute", "300", "5 minutes", NULL };
+  cc_luma_view_row (rows, "Turn the screen off after", NULL, duration (v, "lock.blank", blanks, self->idle_seconds));
+  cc_luma_view_row (rows, "Lock when the screen turns off", NULL,
+    cc_luma_view_toggle (v, "lock.auto", "cf-lock.auto", "Lock when the screen turns off"));
+  if (self->automatic) cc_luma_view_row (rows, "Lock after", "Time to wake it without your password", duration (v, "lock.delay", delays, self->delay_seconds));
+  cc_luma_view_row (rows, "Notifications on the lock screen", NULL,
+    cc_luma_view_toggle (v, "lock.notes", "cf-lock.notes", "Notifications on the lock screen"));
+}
diff --git a/shell/cc-luma-view-private.h b/shell/cc-luma-view-private.h
