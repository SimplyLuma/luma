+  cf_header (v, "Remote Desktop", share ? "Others can see this screen" : login ? "Others can sign in remotely" : "Off", tabs);
+  {
+    /* v70's tabs keep their width at phone size; the title wraps instead. */
+    int natural = 0;
+    gtk_widget_measure (tabs, GTK_ORIENTATION_HORIZONTAL, -1, NULL, &natural, NULL, NULL);
+    gtk_widget_set_size_request (tabs, natural, -1);
