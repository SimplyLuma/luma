+static void
+icon_request (const char *path)
+{
+  if (!path) return;
+  if (!icon_cache)
+    {
+      icon_cache = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_object_unref);
+      icon_pending = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+    }
+  if (g_hash_table_contains (icon_cache, path) || g_hash_table_contains (icon_pending, path)) return;
+  g_hash_table_add (icon_pending, g_strdup (path));
+  g_autoptr (GTask) task = g_task_new (NULL, NULL, icon_decoded, NULL);
+  g_task_set_task_data (task, g_strdup (path), g_free);
+  g_task_run_in_thread (task, icon_decode);
+}
