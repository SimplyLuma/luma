+  gtk_widget_set_layout_manager (box, gtk_custom_layout_new (NULL, day_measure, day_allocate));
+  gtk_widget_add_css_class (box, "cf-dayl");
+  for (guint i = 0; labels[i]; i++)
+    gtk_box_append (GTK_BOX (box), cf_text (labels[i], NULL));
+  return box;
+}
