+      if (share) cf_sw (v, g, "rdCtl", "Let them use the mouse and keyboard", NULL, NULL);
+      if (share) connection_group (v);
+    }
+  else
+    {
+      cf_sw (v, g, "rdLogin", "Remote sign-in", "Sign in to this computer when nobody is using it", NULL);
