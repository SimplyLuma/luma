+/* v70 controls, as a person uses them. A switch row is a button whose GtkSwitch
+ * is its visual (rSw: the row is the switch); a radio row is a button carrying
+ * its dot; a segmented choice is the kit's LumaModeSwitch; a page's way back
+ * is a back button. Each helper presses what a person would press. */
+static GtkWidget *find_kind (GtkWidget *root, GType type)
+{
+  if (G_TYPE_CHECK_INSTANCE_TYPE (root, type)) return root;
+  for (GtkWidget *w = gtk_widget_get_first_child (root); w; w = gtk_widget_get_next_sibling (w))
+    {
+      GtkWidget *found = find_kind (w, type);
+      if (found) return found;
+    }
+  return NULL;
+}
+static GtkWidget *switch_visual (GtkWidget *w)
+{
+  if (!w) return NULL;
+  if (GTK_IS_SWITCH (w)) return w;
+  GtkWidget *visual = g_object_get_data (G_OBJECT (w), "cf-switch");
+  return visual && GTK_IS_SWITCH (visual) ? visual : NULL;
+}
+static gboolean is_switch (GtkWidget *w) { return switch_visual (w) != NULL; }
+static gboolean switch_on (GtkWidget *w)
+{
+  GtkWidget *visual = switch_visual (w);
+  g_assert_nonnull (visual);
+  return gtk_switch_get_active (GTK_SWITCH (visual));
+}
+static void set_switch (GtkWidget *w, gboolean on)
+{
+  GtkWidget *visual = switch_visual (w);
+  g_assert_nonnull (visual);
+  if (visual == w) { gtk_switch_set_active (GTK_SWITCH (w), on); return; }
+  if (gtk_switch_get_active (GTK_SWITCH (visual)) != on) g_signal_emit_by_name (w, "clicked");
+}
+static void choose (GtkWidget *w)
+{
+  g_assert_nonnull (w);
+  if (GTK_IS_CHECK_BUTTON (w)) gtk_check_button_set_active (GTK_CHECK_BUTTON (w), TRUE);
+  else g_signal_emit_by_name (w, "clicked");
+}
+static gboolean chosen (GtkWidget *w)
+{
+  g_assert_nonnull (w);
+  GtkWidget *dot = GTK_IS_CHECK_BUTTON (w) ? w : find_kind (w, GTK_TYPE_CHECK_BUTTON);
+  g_assert_nonnull (dot);
+  return gtk_check_button_get_active (GTK_CHECK_BUTTON (dot));
+}
+static GtkWidget *mode_button (GtkWidget *root, const char *key)
+{
+  if (GTK_IS_TOGGLE_BUTTON (root) && g_strcmp0 (g_object_get_data (G_OBJECT (root), "luma-mode-key"), key) == 0) return root;
+  for (GtkWidget *w = gtk_widget_get_first_child (root); w; w = gtk_widget_get_next_sibling (w))
+    {
+      GtkWidget *found = mode_button (w, key);
+      if (found) return found;
+    }
+  return NULL;
+}
+static void pick_mode (GtkWidget *w, const char *key)
+{
+  g_assert_true (LUMA_IS_MODE_SWITCH (w));
+  GtkWidget *button = mode_button (w, key);
+  g_assert_nonnull (button);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (button), TRUE);
+  g_assert_cmpstr (luma_mode_switch_get_current (LUMA_MODE_SWITCH (w)), ==, key);
+}
+/* A row that opens another page (v70 rNv). */
+static gboolean goes_to (GtkWidget *w, const char *page)
+{
+  return w && GTK_IS_BUTTON (w) && g_strcmp0 (g_object_get_data (G_OBJECT (w), "cf-target"), page) == 0;
+}
+/* A password field hides what is typed (GtkEntry or GtkPasswordEntry). */
+static gboolean hides_text (GtkWidget *w)
+{
+  g_assert_nonnull (w);
+  if (GTK_IS_ENTRY (w)) return !gtk_entry_get_visibility (GTK_ENTRY (w));
+  GtkWidget *text = find_kind (w, GTK_TYPE_TEXT);
+  g_assert_nonnull (text);
+  return !gtk_text_get_visibility (GTK_TEXT (text));
+}
+/* The copy button of a fixed value row (v70 rVl { copy }). */
+static GtkWidget *find_copy (GtkWidget *root, const char *value)
+{
+  if (GTK_IS_BUTTON (root) && g_strcmp0 (g_object_get_data (G_OBJECT (root), "cf-copy"), value) == 0) return root;
+  for (GtkWidget *w = gtk_widget_get_first_child (root); w; w = gtk_widget_get_next_sibling (w))
+    {
+      GtkWidget *found = find_copy (w, value);
+      if (found) return found;
+    }
+  return NULL;
+}
+static gboolean is_back (GtkWidget *w) { return w && GTK_IS_BUTTON (w) && gtk_widget_has_css_class (w, "cf-back"); }
+static void go_back (GtkWidget *w)
+{
+  g_assert_true (is_back (w));
+  g_signal_emit_by_name (w, "clicked");
+}
