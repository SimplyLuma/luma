diff --git a/shell/test-luma-live-conn.c b/shell/test-luma-live-conn.c
new file mode 100644
index 0000000..9ead8c5
--- /dev/null
+++ b/shell/test-luma-live-conn.c
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live connectivity: the proxy adapter against memory GSettings, and the
+ * pages' Wi‑Fi/Bluetooth commands reaching the live writer untouched. */
+#include "cc-luma-live.h"
+#include "cc-luma-bluetooth.h"
+#include <gio/gio.h>
+
+extern const CcLumaAdapter cc_luma_adapter_proxy;
+/* The registry isn't under test: readiness is recorded here. */
+static gboolean proxy_ready;
+void cc_luma_live_ready (CcLumaFixture *model, const char *adapter) { proxy_ready |= g_str_equal (adapter, "proxy"); }
+
+static CcLumaFixture *
+live_model (void)
+{
+  g_autoptr (JsonParser) parser = json_parser_new ();
+  g_assert_true (json_parser_load_from_data (parser,
+    "{\"version\":1,\"settings\":{},\"data\":{},\"pages\":[{\"id\":\"wifi\"}]}", -1, NULL));
+  return cc_luma_fixture_new_live (json_parser_get_root (parser));
+}
+
+static void
+test_proxy (void)
+{
+  g_autoptr (CcLumaFixture) model = live_model ();
+  g_autoptr (GSettings) settings = g_settings_new ("org.gnome.system.proxy");
+  gpointer state;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (JsonNode) manual = json_node_init_string (json_node_alloc (), "manual");
+  g_autoptr (JsonNode) bogus = json_node_init_string (json_node_alloc (), "sideways");
+
+  g_settings_set_string (settings, "mode", "auto");
+  state = cc_luma_adapter_proxy.start (model);
+  g_assert_true (proxy_ready);
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "proxy")), ==, "auto");
+  g_assert_true (cc_luma_fixture_writable (model, "proxy"));
+  g_assert_true (cc_luma_adapter_proxy.write (state, "proxy", manual, &error));
+  g_assert_no_error (error);
+  g_assert_cmpstr (g_settings_get_string (settings, "mode"), ==, "manual");
+  g_assert_false (cc_luma_adapter_proxy.write (state, "proxy", bogus, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+  g_clear_error (&error);
+  /* Not its key: the next adapter is asked. */
+  g_assert_false (cc_luma_adapter_proxy.write (state, "wifi", manual, &error));
+  g_assert_no_error (error);
+  g_settings_set_string (settings, "mode", "none");
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "proxy")), ==, "off");
+  cc_luma_adapter_proxy.stop (state);
+}
+
+typedef struct { GPtrArray *keys, *values; } Writes;
+static gboolean
+record (CcLumaFixture *model, const char *key, JsonNode *value, gpointer data, GError **error)
+{
+  Writes *w = data;
+  g_ptr_array_add (w->keys, g_strdup (key));
+  g_ptr_array_add (w->values, g_strdup (json_node_get_string (value)));
+  return TRUE;
+}
+
+static void
+test_commands (void)
+{
+  g_autoptr (CcLumaFixture) model = live_model ();
+  Writes w = { g_ptr_array_new_with_free_func (g_free), g_ptr_array_new_with_free_func (g_free) };
+  g_autoptr (GError) error = NULL;
+  const char *keys[] = { "CFNETS.join", "CFKNOWN.forget", "CFBT.connect", "CFBT.disconnect", "CFNEAR.pair" };
+  JsonObject *data = cc_luma_fixture_get_data (model);
+  g_autoptr (JsonParser) parser = json_parser_new ();
+
+  cc_luma_fixture_set_writer (model, record, &w);
+  for (guint i = 0; i < G_N_ELEMENTS (keys); i++) cc_luma_fixture_own_key (model, keys[i]);
+  cc_luma_fixture_verify_owned_keys (model); /* the writer here records; nothing reaches a system */
+  cc_luma_fixture_publish_boolean (model, "bt", TRUE);
+  cc_luma_fixture_publish_string (model, "devName", "Test");
+  g_assert_true (json_parser_load_from_data (parser,
+    "[[{\"id\":\"aa\",\"n\":\"Mouse\",\"i\":\"mouse\",\"kind\":\"Mouse\",\"on\":false}],"
+    "[{\"id\":\"bb\",\"n\":\"Phone\",\"i\":\"smartphone\",\"kind\":\"Phone\"}]]", -1, NULL));
+  JsonArray *lists = json_node_get_array (json_parser_get_root (parser));
+  cc_luma_fixture_publish_data (model, "CFBT", json_array_get_element (lists, 0));
+  cc_luma_fixture_publish_data (model, "CFNEAR", json_array_get_element (lists, 1));
+
+  g_assert_true (cc_luma_fixture_connect_network (model, "Cafe", &error));
+  g_assert_true (cc_luma_fixture_forget_network (model, "Home", &error));
+  g_assert_true (cc_luma_bluetooth_connect (model, "aa", TRUE, &error));
+  g_assert_true (cc_luma_bluetooth_connect (model, "aa", FALSE, &error));
+  g_assert_true (cc_luma_bluetooth_pair (model, "bb", &error));
+  g_assert_no_error (error);
+  g_assert_cmpuint (w.keys->len, ==, 5);
+  for (guint i = 0; i < G_N_ELEMENTS (keys); i++)
+    g_assert_cmpstr (g_ptr_array_index (w.keys, i), ==, keys[i]);
+  g_assert_cmpstr (g_ptr_array_index (w.values, 0), ==, "Cafe");
+  g_assert_cmpstr (g_ptr_array_index (w.values, 4), ==, "bb");
+  /* The owner reports the result; the model's lists are untouched. */
+  g_assert_cmpuint (json_array_get_length (json_object_get_array_member (data, "CFNEAR")), ==, 1);
+  g_assert_false (json_object_get_boolean_member (json_array_get_object_element (json_object_get_array_member (data, "CFBT"), 0), "on"));
+  g_ptr_array_unref (w.keys);
+  g_ptr_array_unref (w.values);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_setenv ("GSETTINGS_BACKEND", "memory", TRUE);
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/luma/live-conn/proxy", test_proxy);
+  g_test_add_func ("/luma/live-conn/commands", test_commands);
+  return g_test_run ();
+}
diff --git a/shell/test-luma-live-desk.c b/shell/test-luma-live-desk.c
new file mode 100644
index 0000000..037ab14
--- /dev/null
+++ b/shell/test-luma-live-desk.c
@@ -0,0 +1,180 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* The Shelf, Windows and Notifications adapters against memory settings:
+ * never the real dconf. */
+#include "cc-luma-live.h"
+#include "cc-luma-desktop.h"
+#include "cc-luma-discovery.h"
+
+extern const CcLumaAdapter cc_luma_adapter_shelf, cc_luma_adapter_windows, cc_luma_adapter_notifications;
+
+void cc_luma_live_ready (CcLumaFixture *model, const char *adapter) { cc_luma_fixture_changed (model); }
+
+static gboolean
+has_key (const char *id, const char *key)
+{
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = source ? g_settings_schema_source_lookup (source, id, TRUE) : NULL;
+  return schema && (!key || g_settings_schema_has_key (schema, key));
+}
+
+typedef struct { const CcLumaAdapter *adapter; gpointer state; } Running;
+
+static gboolean
+writer (CcLumaFixture *model, const char *key, JsonNode *value, gpointer data, GError **error)
+{
+  Running *r = data;
+  if (r->adapter->write (r->state, key, value, error)) return TRUE;
+  if (error && !*error) g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "unowned %s", key);
+  return FALSE;
+}
+
+/* v70's shelf presets, as the structure carries them. */
+static const char structure[] =
+  "{\"settings\":{},\"pages\":[],\"data\":{\"CFPRE\":["
+  "[\"luma\",\"Luma\",{\"edge\":\"bottom\",\"spread\":\"spread\",\"joined\":\"separate\",\"float\":\"floating\"}],"
+  "[\"one\",\"One bar\",{\"edge\":\"bottom\",\"spread\":\"together\",\"joined\":\"joined\",\"float\":\"floating\"}],"
+  "[\"split\",\"Split\",{\"edge\":\"bottom\",\"spread\":\"spread\",\"joined\":\"separate\",\"float\":\"floating\"}],"
+  "[\"side\",\"Side\",{\"edge\":\"left\",\"spread\":\"spread\",\"joined\":\"separate\",\"float\":\"floating\"}],"
+  "[\"free\",\"Free\",{\"edge\":\"bottom\",\"spread\":\"spread\",\"joined\":\"separate\",\"float\":\"floating\"}]]}}";
+
+static CcLumaFixture *
+model_new (const CcLumaAdapter *adapter, Running *r)
+{
+  g_autoptr (JsonParser) parser = json_parser_new ();
+  g_assert_true (json_parser_load_from_data (parser, structure, -1, NULL));
+  CcLumaFixture *model = cc_luma_fixture_new_live (json_parser_get_root (parser));
+  r->adapter = adapter;
+  r->state = adapter->start (model);
+  cc_luma_fixture_set_writer (model, writer, r);
+  cc_luma_fixture_verify_owned_keys (model); /* memory settings only */
+  return model;
+}
+
+static const char *
+text (CcLumaFixture *model, const char *key)
+{
+  JsonNode *n = cc_luma_fixture_get (model, key);
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_STRING ? json_node_get_string (n) : NULL;
+}
+
+static void
+spin (void)
+{
+  while (g_main_context_iteration (NULL, FALSE));
+}
+
+static void
+test_shelf (void)
+{
+  if (!has_key ("org.project_luma.shell-state", "shelf-arrangement")) { g_test_skip ("no shell-state schema"); return; }
+  Running r;
+  g_autoptr (CcLumaFixture) model = model_new (&cc_luma_adapter_shelf, &r);
+  g_autoptr (GSettings) state = g_settings_new ("org.project_luma.shell-state");
+  /* Luma's default: the luma layout, separate floating islands. */
+  g_assert_cmpstr (text (model, "edge"), ==, "bottom");
+  g_assert_cmpstr (text (model, "spread"), ==, "spread");
+  g_assert_cmpstr (text (model, "preset"), ==, "luma");
+  g_assert_null (cc_luma_fixture_get (model, "hide"));
+  g_assert_null (cc_luma_fixture_get (model, "isz"));
+  g_assert_true (cc_luma_shelf_validate (model));
+  /* Split has no owner; the catalog leaves it out. */
+  JsonArray *catalog = json_object_get_array_member (cc_luma_fixture_get_data (model), "CFPRE");
+  for (guint i = 0; i < json_array_get_length (catalog); i++)
+    g_assert_cmpstr (json_array_get_string_element (json_array_get_array_element (catalog, i), 0), !=, "split");
+  /* An arrangement made by hand: everything in one group is together. */
+  g_settings_set_value (state, "shelf-arrangement",
+    g_variant_new_parsed ("[{'display': <''>, 'edge': <'bottom'>, 'anchor': <'center'>, 'position': <0.5>, 'islands': <['dock', 'clock']>},"
+                          " {'display': <''>, 'edge': <'top'>, 'anchor': <'center'>, 'position': <0.5>, 'islands': <['notifications']>}]"));
+  spin ();
+  g_assert_cmpstr (text (model, "spread"), ==, "together");
+  /* The page's writes go to the keys the Shell reads. */
+  g_autoptr (GError) error = NULL;
+  g_assert_true (cc_luma_shelf_set_preset (model, "one", &error));
+  g_assert_no_error (error);
+  spin ();
+  g_autofree char *surface = g_settings_get_string (state, "shelf-surface-mode");
+  g_autofree char *layout = g_settings_get_string (state, "shelf-group-layout");
+  g_assert_cmpstr (surface, ==, "connected");
+  g_assert_cmpstr (layout, ==, "centered-combined");
+  g_assert_cmpstr (text (model, "preset"), ==, "one");
+  g_assert_true (cc_luma_shelf_set_choice (model, "edge", "left", &error));
+  g_autofree char *edge = g_settings_get_string (state, "shelf-edge");
+  g_assert_cmpstr (edge, ==, "left");
+  /* Spread again: the hand-made arrangement gives way to the layout. */
+  g_assert_true (cc_luma_shelf_set_choice (model, "spread", "spread", &error));
+  spin ();
+  g_autoptr (GVariant) arrangement = g_settings_get_value (state, "shelf-arrangement");
+  g_assert_cmpuint (g_variant_n_children (arrangement), ==, 0);
+  g_assert_cmpstr (text (model, "spread"), ==, "spread");
+  /* A shelf on the top edge is shown as it is. */
+  g_settings_set_string (state, "shelf-edge", "top");
+  spin ();
+  g_assert_cmpstr (text (model, "edge"), ==, "top");
+  g_assert_true (cc_luma_shelf_validate (model));
+  cc_luma_adapter_shelf.stop (r.state);
+}
+
+static void
+test_windows (void)
+{
+  if (!has_key ("org.gnome.mutter", "dynamic-workspaces") || !has_key ("org.gnome.shell.app-switcher", NULL) ||
+      !has_key ("org.gnome.desktop.wm.preferences", "num-workspaces")) { g_test_skip ("no multitasking schemas"); return; }
+  Running r;
+  g_autoptr (CcLumaFixture) model = model_new (&cc_luma_adapter_windows, &r);
+  g_autoptr (GSettings) mutter = g_settings_new ("org.gnome.mutter");
+  g_autoptr (GSettings) wm = g_settings_new ("org.gnome.desktop.wm.preferences");
+  g_autoptr (GSettings) switcher = g_settings_new ("org.gnome.shell.app-switcher");
+  g_assert_cmpstr (text (model, "ws"), ==, g_settings_get_boolean (mutter, "dynamic-workspaces") ? "dynamic" : "fixed");
+  /* Without Luma's tiling installed the Tiling rows are left out. */
+  if (!cc_luma_fixture_get (model, "tile")) g_assert_null (cc_luma_fixture_get (model, "gap"));
+  g_assert_true (cc_luma_windows_validate (model));
+  /* GNOME's range, not v70's: twelve workspaces are shown. */
+  g_settings_set_int (wm, "num-workspaces", 12);
+  spin ();
+  g_assert_cmpint (json_node_get_int (cc_luma_fixture_get (model, "wsN")), ==, 12);
+  g_assert_true (cc_luma_windows_validate (model));
+  g_autoptr (GError) error = NULL;
+  g_assert_true (cc_luma_windows_set_choice (model, "ws", "fixed", &error));
+  g_assert_false (g_settings_get_boolean (mutter, "dynamic-workspaces"));
+  g_assert_true (cc_luma_windows_set_number (model, "wsN", 3, &error));
+  g_assert_cmpint (g_settings_get_int (wm, "num-workspaces"), ==, 3);
+  g_assert_true (cc_luma_windows_set_choice (model, "swi", "all", &error));
+  g_assert_false (g_settings_get_boolean (switcher, "current-workspace-only"));
+  g_assert_true (cc_luma_windows_set_choice (model, "wsMon", "all", &error));
+  g_assert_false (g_settings_get_boolean (mutter, "workspaces-only-on-primary"));
+  g_assert_no_error (error);
+  cc_luma_adapter_windows.stop (r.state);
+}
+
+static void
+test_notifications (void)
+{
+  if (!has_key ("org.gnome.desktop.notifications", "application-children")) { g_test_skip ("no notifications schema"); return; }
+  Running r;
+  g_autoptr (CcLumaFixture) model = model_new (&cc_luma_adapter_notifications, &r);
+  g_autoptr (GSettings) master = g_settings_new ("org.gnome.desktop.notifications");
+  spin ();
+  g_assert_cmpint (json_node_get_boolean (cc_luma_fixture_get (model, "dnd")), ==, !g_settings_get_boolean (master, "show-banners"));
+  /* No sample notification and no duration in a live model. */
+  g_assert_null (json_object_get_member (cc_luma_fixture_get_data (model), "CFNOTIFY"));
+  g_assert_null (cc_luma_fixture_get (model, "nshow"));
+  g_assert_true (JSON_NODE_HOLDS_OBJECT (cc_luma_fixture_get (model, "na")));
+  g_assert_true (cc_luma_notifications_validate (model));
+  g_autoptr (GError) error = NULL;
+  g_assert_true (cc_luma_fixture_set_flag (model, "dnd", TRUE, &error));
+  g_assert_no_error (error);
+  g_assert_false (g_settings_get_boolean (master, "show-banners"));
+  g_assert_true (cc_luma_fixture_set_flag (model, "lockN", FALSE, &error));
+  g_assert_false (g_settings_get_boolean (master, "show-in-lock-screen"));
+  cc_luma_adapter_notifications.stop (r.state);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/luma-live/shelf", test_shelf);
+  g_test_add_func ("/luma-live/windows", test_windows);
+  g_test_add_func ("/luma-live/notifications", test_notifications);
+  return g_test_run ();
+}
diff --git a/shell/test-luma-live-gsettings.c b/shell/test-luma-live-gsettings.c
new file mode 100644
index 0000000..0c3eee0
--- /dev/null
+++ b/shell/test-luma-live-gsettings.c
@@ -0,0 +1,149 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* The GSettings table against memory settings: never the real dconf. */
+#include "cc-luma-live-gsettings.h"
+#include "cc-luma-displays.h"
+
+void cc_luma_live_ready (CcLumaFixture *model, const char *adapter) { cc_luma_fixture_changed (model); }
+
+static gboolean
+has_schema (const char *id)
+{
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = source ? g_settings_schema_source_lookup (source, id, TRUE) : NULL;
+  return schema != NULL;
+}
+
+static gboolean
+writer (CcLumaFixture *model, const char *key, JsonNode *value, gpointer state, GError **error)
+{
+  if (cc_luma_adapter_gsettings.write (state, key, value, error)) return TRUE;
+  if (error && !*error) g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "unowned %s", key);
+  return FALSE;
+}
+
+static CcLumaFixture *
+model_new (gpointer *state)
+{
+  g_autoptr (JsonParser) parser = json_parser_new ();
+  g_assert_true (json_parser_load_from_data (parser, "{\"settings\":{},\"data\":{},\"pages\":[]}", -1, NULL));
+  CcLumaFixture *model = cc_luma_fixture_new_live (json_parser_get_root (parser));
+  *state = cc_luma_adapter_gsettings.start (model);
+  cc_luma_fixture_set_writer (model, writer, *state);
+  cc_luma_fixture_verify_owned_keys (model); /* memory settings only */
+  return model;
+}
+
+static const char *
+text (CcLumaFixture *model, const char *key)
+{
+  JsonNode *n = cc_luma_fixture_get (model, key);
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_STRING ? json_node_get_string (n) : NULL;
+}
+
+static void
+spin (void)
+{
+  while (g_main_context_iteration (NULL, FALSE));
+}
+
+static void
+test_night (void)
+{
+  if (!has_schema ("org.gnome.settings-daemon.plugins.color")) { g_test_skip ("no color schema"); return; }
+  gpointer state;
+  g_autoptr (CcLumaFixture) model = model_new (&state);
+  g_autoptr (GSettings) color = g_settings_new ("org.gnome.settings-daemon.plugins.color");
+  g_assert_false (json_node_get_boolean (cc_luma_fixture_get (model, "night")));
+  g_assert_cmpstr (text (model, "nightWhen"), ==, "sun");
+  g_assert_cmpstr (text (model, "nightFrom"), ==, "20:00");
+  g_assert_cmpstr (text (model, "nightTo"), ==, "06:00");
+  g_assert_cmpint (json_node_get_int (cc_luma_fixture_get (model, "nightT")), ==, 67);
+  g_assert_true (cc_luma_night_validate (model));
+
+  g_autoptr (GError) error = NULL;
+  g_assert_true (cc_luma_night_set_choice (model, "nightFrom", "21:00", &error));
+  g_assert_cmpfloat (g_settings_get_double (color, "night-light-schedule-from"), ==, 21.0);
+  g_assert_true (cc_luma_night_set_choice (model, "nightWhen", "manual", &error));
+  g_assert_false (g_settings_get_boolean (color, "night-light-schedule-automatic"));
+  g_assert_true (cc_luma_night_set_temperature (model, 55, &error));
+  g_assert_cmpuint (g_settings_get_uint (color, "night-light-temperature"), ==, 3050);
+  g_assert_true (cc_luma_fixture_set_flag (model, "night", TRUE, &error));
+  g_assert_true (g_settings_get_boolean (color, "night-light-enabled"));
+
+  /* The owner changes: the model follows. */
+  g_settings_set_double (color, "night-light-schedule-to", 7.0);
+  spin ();
+  g_assert_cmpstr (text (model, "nightTo"), ==, "07:00");
+  /* A time the model can't show becomes null, not a sample. */
+  g_settings_set_double (color, "night-light-schedule-to", 6.25);
+  spin ();
+  g_assert_cmpstr (text (model, "nightTo"), ==, "06:15");
+  g_assert_false (cc_luma_night_validate (model));
+  cc_luma_adapter_gsettings.stop (state);
+}
+
+static void
+test_power_rows (void)
+{
+  if (!has_schema ("org.gnome.settings-daemon.plugins.power")) { g_test_skip ("no power schema"); return; }
+  gpointer state;
+  g_autoptr (CcLumaFixture) model = model_new (&state);
+  g_autoptr (GSettings) power = g_settings_new ("org.gnome.settings-daemon.plugins.power");
+  g_autoptr (GSettings) session = g_settings_new ("org.gnome.desktop.session");
+  g_autoptr (GError) error = NULL;
+  g_assert_cmpstr (text (model, "blank"), ==, "5");
+  g_assert_cmpstr (text (model, "pbtn"), ==, "suspend");
+  g_autoptr (JsonNode) off = json_node_init_string (json_node_alloc (), "off");
+  g_assert_true (cc_luma_fixture_set (model, "pbtn", off, &error));
+  g_assert_cmpstr (g_settings_get_string (power, "power-button-action"), ==, "interactive");
+  g_autoptr (JsonNode) never = json_node_init_string (json_node_alloc (), "0");
+  g_assert_true (cc_luma_fixture_set (model, "blank", never, &error));
+  g_assert_cmpuint (g_settings_get_uint (session, "idle-delay"), ==, 0);
+  g_assert_true (cc_luma_fixture_set_flag (model, "susBat", FALSE, &error));
+  g_assert_cmpstr (g_settings_get_string (power, "sleep-inactive-battery-type"), ==, "nothing");
+  g_autoptr (JsonNode) half = json_node_init_string (json_node_alloc (), "30");
+  g_assert_true (cc_luma_fixture_set (model, "susBatD", half, &error));
+  g_assert_cmpint (g_settings_get_int (power, "sleep-inactive-battery-timeout"), ==, 1800);
+  /* Not a key of any row: refused. */
+  g_autoptr (JsonNode) perf = json_node_init_string (json_node_alloc (), "perf");
+  g_assert_false (cc_luma_fixture_write (model, "pmode", perf, &error));
+  cc_luma_adapter_gsettings.stop (state);
+}
+
+static void
+test_accent_and_a11y (void)
+{
+  gpointer state;
+  g_autoptr (CcLumaFixture) model = model_new (&state);
+  g_autoptr (GSettings) iface = g_settings_new ("org.gnome.desktop.interface");
+  g_autoptr (GError) error = NULL;
+  JsonNode *accent = cc_luma_fixture_get (model, "acc");
+  if (accent && JSON_NODE_HOLDS_VALUE (accent))
+    {
+      g_autoptr (JsonNode) red = json_node_init_int (json_node_alloc (), 25);
+      g_assert_true (cc_luma_fixture_set (model, "acc", red, &error));
+      g_assert_cmpstr (g_settings_get_string (iface, "accent-color"), ==, "red");
+      g_settings_set_string (iface, "accent-color", "slate");
+      spin ();
+      g_assert_true (JSON_NODE_HOLDS_NULL (cc_luma_fixture_get (model, "acc")));
+    }
+  g_assert_true (cc_luma_fixture_set_flag (model, "motion", TRUE, &error));
+  g_assert_false (g_settings_get_boolean (iface, "enable-animations"));
+  g_assert_true (cc_luma_fixture_set_flag (model, "large", TRUE, &error));
+  g_assert_cmpfloat (g_settings_get_double (iface, "text-scaling-factor"), ==, 1.25);
+  g_autoptr (JsonNode) xl = json_node_init_string (json_node_alloc (), "xl");
+  g_assert_true (cc_luma_fixture_set (model, "cursor", xl, &error));
+  g_assert_cmpint (g_settings_get_int (iface, "cursor-size"), ==, 64);
+  cc_luma_adapter_gsettings.stop (state);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_setenv ("GSETTINGS_BACKEND", "memory", TRUE);
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/luma/live/gsettings/night", test_night);
+  g_test_add_func ("/luma/live/gsettings/power", test_power_rows);
+  g_test_add_func ("/luma/live/gsettings/accent-a11y", test_accent_and_a11y);
+  return g_test_run ();
+}
diff --git a/shell/test-luma-live-keyboard.c b/shell/test-luma-live-keyboard.c
new file mode 100644
index 0000000..038004d
--- /dev/null
+++ b/shell/test-luma-live-keyboard.c
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* The keyboard adapter against memory settings: names, the source in use,
+ * special keys and keycaps from the layout's own keymap. */
+#include "cc-luma-live-gsettings.h"
+#include "cc-luma-keyboard.h"
+
+extern const CcLumaAdapter cc_luma_adapter_keyboard;
+void cc_luma_live_ready (CcLumaFixture *model, const char *adapter) { cc_luma_fixture_changed (model); }
+
+static void
+test_sources (void)
+{
+  g_autofree char *structure = NULL;
+  g_autoptr (GError) error = NULL;
+  g_assert_true (g_file_get_contents (g_test_get_filename (G_TEST_DIST, "luma-settings-structure.json", NULL), &structure, NULL, &error));
+  g_autoptr (JsonParser) parser = json_parser_new ();
+  g_assert_true (json_parser_load_from_data (parser, structure, -1, &error));
+  g_autoptr (CcLumaFixture) model = cc_luma_fixture_new_live (json_parser_get_root (parser));
+  g_autoptr (GSettings) sources = g_settings_new ("org.gnome.desktop.input-sources");
+  g_settings_set_value (sources, "sources", g_variant_new_parsed ("[('xkb', 'us'), ('xkb', 'de')]"));
+  g_settings_set_value (sources, "mru-sources", g_variant_new_parsed ("[('xkb', 'de'), ('xkb', 'us')]"));
+  g_settings_set_strv (sources, "xkb-options", (const char * const[]) { "compose:caps", NULL });
+  gpointer state = cc_luma_adapter_keyboard.start (model);
+  JsonArray *list = json_node_get_array (cc_luma_fixture_get (model, "srcs"));
+  g_assert_cmpuint (json_array_get_length (list), ==, 2);
+  const char *german = json_array_get_string_element (list, 1);
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "src")), ==, german);
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "compose")), ==, "CapsLock");
+  g_assert_cmpstr (json_node_get_string (cc_luma_fixture_get (model, "altKey")), ==, "off");
+  JsonObject *layouts = json_object_get_object_member (json_object_get_object_member (cc_luma_fixture_get_data (model), "CFKB"), "L");
+  JsonArray *rows = json_object_get_array_member (layouts, german);
+  g_assert_nonnull (rows);
+  /* QWERTZ: the sixth letter of the top row is z; named keys keep the page's words. */
+  g_auto (GStrv) top = g_strsplit (json_array_get_string_element (rows, 1), " ", -1);
+  g_assert_cmpstr (top[0], ==, "Tab");
+  g_assert_cmpstr (top[6], ==, "z");
+  g_assert_true (cc_luma_keyboard_validate (model));
+  /* The special keys: only the key's own option changes. */
+  g_settings_set_strv (sources, "xkb-options", (const char * const[]) { "caps:none", "lv3:ralt_switch", NULL });
+  g_autoptr (JsonNode) menu = json_node_init_string (json_node_alloc (), "ContextMenu");
+  g_assert_true (cc_luma_adapter_keyboard.write (state, "altKey", menu, &error));
+  g_auto (GStrv) options = g_settings_get_strv (sources, "xkb-options");
+  g_autofree char *joined = g_strjoinv (",", options);
+  g_assert_cmpstr (joined, ==, "caps:none,lv3:menu_switch");
+  cc_luma_adapter_keyboard.stop (state);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_setenv ("GSETTINGS_BACKEND", "memory", TRUE);
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/luma/live/keyboard/sources", test_sources);
+  return g_test_run ();
+}
diff --git a/shell/test-luma-live-you.c b/shell/test-luma-live-you.c
new file mode 100644
index 0000000..021bf30
--- /dev/null
+++ b/shell/test-luma-live-you.c
@@ -0,0 +1,332 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Privacy and Wellbeing adapters against memory settings (never dconf) and
+ * no session bus (the permission store is simply absent). */
+#include "cc-luma-live-gsettings.h"
+
+extern const CcLumaAdapter cc_luma_adapter_privacy, cc_luma_adapter_wellbeing, cc_luma_adapter_sharing;
+static const char *ready_adapter;
+void cc_luma_live_ready (CcLumaFixture *model, const char *adapter) { ready_adapter = adapter; }
+
+static gboolean
+has_schema (const char *id)
+{
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = source ? g_settings_schema_source_lookup (source, id, TRUE) : NULL;
+  return schema != NULL;
+}
+
+static const CcLumaAdapter *current;
+static gboolean
+writer (CcLumaFixture *model, const char *key, JsonNode *value, gpointer state, GError **error)
+{
+  if (current->write (state, key, value, error)) return TRUE;
+  if (error && !*error) g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "unowned %s", key);
+  return FALSE;
+}
+
+static CcLumaFixture *
+model_new (const CcLumaAdapter *adapter, gpointer *state)
+{
+  g_autoptr (JsonParser) parser = json_parser_new ();
+  g_assert_true (json_parser_load_from_data (parser, "{\"settings\":{},\"data\":{},\"pages\":[]}", -1, NULL));
+  CcLumaFixture *model = cc_luma_fixture_new_live (json_parser_get_root (parser));
+  current = adapter;
+  *state = adapter->start (model);
+  cc_luma_fixture_set_writer (model, writer, *state);
+  cc_luma_fixture_verify_owned_keys (model); /* memory settings only */
+  return model;
+}
+
+static const char *
+text (CcLumaFixture *model, const char *key)
+{
+  JsonNode *n = cc_luma_fixture_get (model, key);
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_STRING ? json_node_get_string (n) : NULL;
+}
+static gboolean
+flag (CcLumaFixture *model, const char *key)
+{
+  JsonNode *n = cc_luma_fixture_get (model, key);
+  g_assert_nonnull (n);
+  return json_node_get_boolean (n);
+}
+
+static void
+test_privacy (void)
+{
+  if (!has_schema ("org.gnome.desktop.privacy") || !has_schema ("org.gnome.desktop.screensaver") ||
+      !has_schema ("org.gnome.system.location")) { g_test_skip ("no privacy schemas"); return; }
+  gpointer state;
+  g_autoptr (CcLumaFixture) model = model_new (&cc_luma_adapter_privacy, &state);
+  g_autoptr (GSettings) privacy = g_settings_new ("org.gnome.desktop.privacy");
+  g_autoptr (GSettings) saver = g_settings_new ("org.gnome.desktop.screensaver");
+  /* GNOME's defaults, as the pages show them. */
+  g_assert_cmpstr (text (model, "lock.delay"), ==, "0");
+  g_assert_cmpstr (text (model, "histKeep"), ==, "forever");
+  g_assert_cmpstr (text (model, "trashAge"), ==, "30");
+  g_assert_cmpstr (text (model, "lock.blank"), ==, "5");
+  g_assert_true (flag (model, "hist"));
+  g_assert_true (flag (model, "cam"));
+  /* Writes land on the GNOME keys, in GNOME's representation. */
+  g_autoptr (JsonNode) week = json_node_init_string (json_node_alloc (), "7");
+  g_assert_true (cc_luma_fixture_set (model, "histKeep", week, NULL));
+  g_assert_cmpint (g_settings_get_int (privacy, "recent-files-max-age"), ==, 7);
+  g_autoptr (JsonNode) forever = json_node_init_string (json_node_alloc (), "forever");
+  g_assert_true (cc_luma_fixture_set (model, "histKeep", forever, NULL));
+  g_assert_cmpint (g_settings_get_int (privacy, "recent-files-max-age"), ==, -1);
+  g_autoptr (JsonNode) off = json_node_init_boolean (json_node_alloc (), FALSE);
+  g_assert_true (cc_luma_fixture_set (model, "cam", off, NULL));
+  g_assert_true (g_settings_get_boolean (privacy, "disable-camera"));
+  g_autoptr (JsonNode) bad = json_node_init_string (json_node_alloc (), "soon");
+  g_assert_false (cc_luma_fixture_set (model, "lock.delay", bad, NULL));
+  g_settings_set_uint (saver, "lock-delay", 120);
+  while (g_main_context_iteration (NULL, FALSE));
+  g_assert_cmpstr (text (model, "lock.delay"), ==, "120"); /* any value GNOME holds */
+  cc_luma_adapter_privacy.stop (state);
+}
+
+static void
+test_wellbeing (void)
+{
+  if (!has_schema ("org.gnome.desktop.screen-time-limits") || !has_schema ("org.gnome.desktop.break-reminders.movement"))
+    { g_test_skip ("no wellbeing schemas"); return; }
+  gpointer state;
+  ready_adapter = NULL;
+  g_autoptr (CcLumaFixture) model = model_new (&cc_luma_adapter_wellbeing, &state);
+  g_autoptr (GSettings) limits = g_settings_new ("org.gnome.desktop.screen-time-limits");
+  g_autoptr (GSettings) move = g_settings_new ("org.gnome.desktop.break-reminders.movement");
+  g_assert_cmpstr (ready_adapter, ==, "wellbeing");
+  g_settings_set_uint (limits, "daily-limit-seconds", 5400);
+  g_settings_set_uint (move, "duration-seconds", 300);
+  g_settings_set_uint (move, "interval-seconds", 1800);
+  while (g_main_context_iteration (NULL, FALSE));
+  g_assert_cmpstr (text (model, "limitH"), ==, "1.5");
+  g_assert_cmpstr (text (model, "moveS"), ==, "5-30");
+  g_autoptr (JsonNode) on = json_node_init_boolean (json_node_alloc (), TRUE);
+  g_assert_true (cc_luma_fixture_set (model, "gray", on, NULL));
+  g_assert_true (g_settings_get_boolean (limits, "grayscale"));
+  /* The panel's other controls, in GNOME's representation. */
+  g_autoptr (GSettings) breaks = g_settings_new ("org.gnome.desktop.break-reminders");
+  g_autoptr (GSettings) eyes = g_settings_new ("org.gnome.desktop.break-reminders.eyesight");
+  g_assert_true (cc_luma_fixture_set (model, "eyes", on, NULL));
+  g_auto (GStrv) selected = g_settings_get_strv (breaks, "selected-breaks");
+  g_assert_true (g_strv_contains ((const char * const *) selected, "eyesight"));
+  g_autoptr (JsonNode) hourly = json_node_init_string (json_node_alloc (), "10-60");
+  g_assert_true (cc_luma_fixture_set (model, "moveS", hourly, NULL));
+  g_assert_cmpuint (g_settings_get_uint (move, "duration-seconds"), ==, 600);
+  g_assert_cmpuint (g_settings_get_uint (move, "interval-seconds"), ==, 3600);
+  g_autoptr (JsonNode) four = json_node_init_string (json_node_alloc (), "4");
+  g_assert_true (cc_luma_fixture_set (model, "limitH", four, NULL));
+  g_assert_cmpuint (g_settings_get_uint (limits, "daily-limit-seconds"), ==, 14400);
+  g_autoptr (JsonNode) quiet = json_node_init_boolean (json_node_alloc (), FALSE);
+  g_assert_true (cc_luma_fixture_set (model, "brSound", quiet, NULL));
+  g_assert_false (g_settings_get_boolean (eyes, "play-sound"));
+  g_assert_false (g_settings_get_boolean (move, "play-sound"));
+  g_autoptr (JsonNode) bad = json_node_init_string (json_node_alloc (), "60-5");
+  g_assert_false (cc_luma_fixture_set (model, "moveS", bad, NULL));
+  cc_luma_adapter_wellbeing.stop (state);
+}
+
+/* ── Sharing against a fake gsd-sharing on a private session bus ─────── */
+static const char sharing_xml[] =
+  "<node><interface name='org.gnome.SettingsDaemon.Sharing'>"
+  "<property name='CurrentNetworkName' type='s' access='read'/>"
+  "<property name='CurrentNetwork' type='s' access='read'/>"
+  "<property name='CarrierType' type='s' access='read'/>"
+  "<property name='SharingStatus' type='u' access='read'/>"
+  "<method name='EnableService'><arg name='service_name' direction='in' type='s'/></method>"
+  "<method name='DisableService'><arg name='service_name' direction='in' type='s'/>"
+  "<arg name='network' direction='in' type='s'/></method>"
+  "<method name='ListNetworks'><arg name='service_name' direction='in' type='s'/>"
+  "<arg name='networks' direction='out' type='a(sss)'/></method>"
+  "</interface></node>";
+
+/* The user manager's unit states, as cc_get_service_state asks them. */
+static const char systemd_xml[] =
+  "<node><interface name='org.freedesktop.systemd1.Manager'>"
+  "<method name='GetUnitFileState'><arg name='file' direction='in' type='s'/>"
+  "<arg name='state' direction='out' type='s'/></method>"
+  "</interface></node>";
+static void
+fake_systemd (GDBusConnection *bus, const char *sender, const char *path, const char *iface, const char *method,
+              GVariant *params, GDBusMethodInvocation *invocation, gpointer data)
+{
+  const char *unit;
+  g_variant_get (params, "(&s)", &unit);
+  g_dbus_method_invocation_return_value (invocation,
+    g_variant_new ("(s)", g_str_equal (unit, "gnome-remote-desktop.service") ? "enabled" : "disabled"));
+}
+
+/* service name → the network it is enabled on (one network: "net-1"). */
+static GHashTable *fake_enabled;
+static char *fake_last_disable_network;
+
+static void
+fake_call (GDBusConnection *bus, const char *sender, const char *path, const char *iface, const char *method,
+           GVariant *params, GDBusMethodInvocation *invocation, gpointer data)
+{
+  const char *service, *network;
+  if (g_str_equal (method, "EnableService"))
+    {
+      g_variant_get (params, "(&s)", &service);
+      g_hash_table_insert (fake_enabled, g_strdup (service), g_strdup ("net-1"));
+      g_dbus_method_invocation_return_value (invocation, NULL);
+    }
+  else if (g_str_equal (method, "DisableService"))
+    {
+      g_variant_get (params, "(&s&s)", &service, &network);
+      g_free (fake_last_disable_network);
+      fake_last_disable_network = g_strdup (network);
+      g_hash_table_remove (fake_enabled, service);
+      g_dbus_method_invocation_return_value (invocation, NULL);
+    }
+  else
+    {
+      GVariantBuilder b;
+      g_variant_get (params, "(&s)", &service);
+      g_variant_builder_init (&b, G_VARIANT_TYPE ("a(sss)"));
+      if (g_hash_table_contains (fake_enabled, service))
+        g_variant_builder_add (&b, "(sss)", "net-1", "Studio North", "wifi");
+      g_dbus_method_invocation_return_value (invocation, g_variant_new ("(a(sss))", &b));
+    }
+}
+
+static GVariant *
+fake_property (GDBusConnection *bus, const char *sender, const char *path, const char *iface, const char *name,
+               GError **error, gpointer data)
+{
+  if (g_str_equal (name, "SharingStatus")) return g_variant_new_uint32 (3); /* AVAILABLE */
+  if (g_str_equal (name, "CurrentNetwork")) return g_variant_new_string ("net-1");
+  if (g_str_equal (name, "CurrentNetworkName")) return g_variant_new_string ("Studio North");
+  return g_variant_new_string ("wifi");
+}
+
+static gboolean
+spin_until (gboolean (*done) (gpointer), gpointer data)
+{
+  gint64 end = g_get_monotonic_time () + 5 * G_USEC_PER_SEC;
+  while (!done (data) && g_get_monotonic_time () < end) g_main_context_iteration (NULL, TRUE);
+  return done (data);
+}
+static gboolean sharing_ready (gpointer data) { return g_strcmp0 (ready_adapter, "sharing") == 0; }
+typedef struct { CcLumaFixture *model; const char *key; gboolean want; } Want;
+static gboolean model_is (gpointer data)
+{
+  Want *w = data;
+  JsonNode *n = cc_luma_fixture_get (w->model, w->key);
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_BOOLEAN && json_node_get_boolean (n) == w->want;
+}
+static gboolean tick (gpointer data) { (*(int *) data)--; return *(int *) data > 0; }
+
+static void
+toggle_service (CcLumaFixture *model, const char *key, const char *service)
+{
+  g_autoptr (JsonNode) on = json_node_init_boolean (json_node_alloc (), TRUE);
+  g_autoptr (JsonNode) off = json_node_init_boolean (json_node_alloc (), FALSE);
+  Want w = { model, key, TRUE };
+  g_assert_true (cc_luma_fixture_write (model, key, on, NULL));
+  g_assert_true (spin_until (model_is, &w)); /* the adapter reads it back from ListNetworks */
+  g_assert_cmpstr (g_hash_table_lookup (fake_enabled, service), ==, "net-1");
+  w.want = FALSE;
+  g_assert_true (cc_luma_fixture_write (model, key, off, NULL));
+  g_assert_true (spin_until (model_is, &w));
+  g_assert_false (g_hash_table_contains (fake_enabled, service));
+  g_assert_cmpstr (fake_last_disable_network, ==, "net-1"); /* the current network only */
+}
+
+static void
+test_sharing (void)
+{
+  g_autoptr (GTestDBus) dbus = g_test_dbus_new (G_TEST_DBUS_NONE);
+  g_test_dbus_up (dbus);
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GDBusConnection) service = g_dbus_connection_new_for_address_sync (g_test_dbus_get_bus_address (dbus),
+    G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT | G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION, NULL, NULL, &error);
+  g_assert_no_error (error);
+  g_autoptr (GDBusNodeInfo) info = g_dbus_node_info_new_for_xml (sharing_xml, &error);
+  g_assert_no_error (error);
+  static const GDBusInterfaceVTable vtable = { fake_call, fake_property, NULL, { 0 } };
+  fake_enabled = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+  guint object = g_dbus_connection_register_object (service, "/org/gnome/SettingsDaemon/Sharing", info->interfaces[0],
+                                                    &vtable, NULL, NULL, &error);
+  g_assert_no_error (error);
+  g_autoptr (GDBusNodeInfo) units = g_dbus_node_info_new_for_xml (systemd_xml, &error);
+  g_assert_no_error (error);
+  static const GDBusInterfaceVTable systemd_vtable = { fake_systemd, NULL, NULL, { 0 } };
+  guint manager = g_dbus_connection_register_object (service, "/org/freedesktop/systemd1", units->interfaces[0],
+                                                     &systemd_vtable, NULL, NULL, &error);
+  g_assert_no_error (error);
+  const char *names[] = { "org.gnome.SettingsDaemon.Sharing", "org.freedesktop.systemd1" };
+  for (guint i = 0; i < G_N_ELEMENTS (names); i++)
+    {
+      g_autoptr (GVariant) owned = g_dbus_connection_call_sync (service, "org.freedesktop.DBus", "/org/freedesktop/DBus",
+        "org.freedesktop.DBus", "RequestName", g_variant_new ("(su)", names[i], 0),
+        G_VARIANT_TYPE ("(u)"), G_DBUS_CALL_FLAGS_NONE, -1, NULL, &error);
+      g_assert_no_error (error);
+    }
+
+  gpointer state;
+  ready_adapter = NULL;
+  g_autoptr (CcLumaFixture) model = model_new (&cc_luma_adapter_sharing, &state);
+  g_assert_true (spin_until (sharing_ready, NULL));
+  /* Rows are offered (and read back) only where their service exists. */
+  if (has_schema ("org.gnome.desktop.file-sharing")) toggle_service (model, "fileShare", "gnome-user-share-webdav");
+  g_autofree char *rygel = g_find_program_in_path ("rygel");
+  if (rygel) toggle_service (model, "media2", "rygel");
+
+  if (has_schema ("org.gnome.desktop.file-sharing"))
+    {
+      g_autoptr (GSettings) files = g_settings_new ("org.gnome.desktop.file-sharing");
+      g_autoptr (JsonNode) on = json_node_init_boolean (json_node_alloc (), TRUE);
+      g_autoptr (JsonNode) off = json_node_init_boolean (json_node_alloc (), FALSE);
+      g_assert_true (cc_luma_fixture_write (model, "fsPass", on, NULL));
+      g_autofree char *always = g_settings_get_string (files, "require-password");
+      g_assert_cmpstr (always, ==, "always");
+      g_assert_true (cc_luma_fixture_write (model, "fsPass", off, NULL));
+      g_autofree char *never = g_settings_get_string (files, "require-password");
+      g_assert_cmpstr (never, ==, "never");
+      /* "on_write" is not "always": the panel shows it as off. */
+      g_settings_set_string (files, "require-password", "on_write");
+      Want w = { model, "fsPass", FALSE };
+      g_assert_true (spin_until (model_is, &w));
+    }
+  if (has_schema ("org.gnome.desktop.remote-desktop.rdp"))
+    {
+      g_autoptr (GSettings) rdp = g_settings_new ("org.gnome.desktop.remote-desktop.rdp");
+      /* Desktop sharing reads as on when the key and the user unit both are. */
+      g_settings_set_boolean (rdp, "enable", TRUE);
+      Want shared = { model, "rdShare", TRUE };
+      g_assert_true (spin_until (model_is, &shared));
+      g_autoptr (JsonNode) on = json_node_init_boolean (json_node_alloc (), TRUE);
+      g_assert_true (cc_luma_fixture_write (model, "rdCtl", on, NULL));
+      g_assert_false (g_settings_get_boolean (rdp, "view-only"));
+      g_autoptr (JsonNode) off = json_node_init_boolean (json_node_alloc (), FALSE);
+      g_assert_true (cc_luma_fixture_write (model, "rdCtl", off, NULL));
+      g_assert_true (g_settings_get_boolean (rdp, "view-only"));
+    }
+  /* Desktop sharing and remote sign-in are the GNOME panel's. */
+  g_autoptr (JsonNode) on = json_node_init_boolean (json_node_alloc (), TRUE);
+  g_autoptr (GError) refused = NULL;
+  g_assert_false (cc_luma_fixture_write (model, "rdShare", on, &refused));
+
+  cc_luma_adapter_sharing.stop (state);
+  int ticks = 20;
+  g_timeout_add (10, tick, &ticks);
+  while (ticks > 0) g_main_context_iteration (NULL, TRUE); /* let cancelled calls finish */
+  g_dbus_connection_unregister_object (service, object);
+  g_dbus_connection_unregister_object (service, manager);
+  g_dbus_connection_close_sync (service, NULL, NULL);
+  g_clear_pointer (&fake_enabled, g_hash_table_unref);
+  g_clear_pointer (&fake_last_disable_network, g_free);
+  g_test_dbus_down (dbus);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/live/privacy", test_privacy);
+  g_test_add_func ("/live/wellbeing", test_wellbeing);
+  g_test_add_func ("/live/sharing", test_sharing);
+  return g_test_run ();
+}
diff --git a/shell/test-luma-permissions.c b/shell/test-luma-permissions.c
index e9c3ae8..eac1fc9 100644
--- a/shell/test-luma-permissions.c
+++ b/shell/test-luma-permissions.c
@@ -209,6 +209,34 @@ static GtkWidget *named (GtkWidget *widget, const char *name)
   }
   return NULL;
 }
+/* A v70 switch row is a button whose GtkSwitch is its visual; a person
+ * presses the row. A bare GtkSwitch is set directly. */
+static GtkWidget *switch_visual (GtkWidget *w)
+{
+  if (!w) return NULL;
+  if (GTK_IS_SWITCH (w)) return w;
+  GtkWidget *visual = g_object_get_data (G_OBJECT (w), "cf-switch");
+  return visual && GTK_IS_SWITCH (visual) ? visual : NULL;
+}
+static gboolean switch_on (GtkWidget *w)
+{
+  GtkWidget *visual = switch_visual (w);
+  g_assert_nonnull (visual);
+  return gtk_switch_get_active (GTK_SWITCH (visual));
+}
+static void set_switch (GtkWidget *w, gboolean on)
+{
+  GtkWidget *visual = switch_visual (w);
+  g_assert_nonnull (visual);
+  if (visual == w) { gtk_switch_set_active (GTK_SWITCH (w), on); return; }
+  if (gtk_switch_get_active (GTK_SWITCH (visual)) != on) g_signal_emit_by_name (w, "clicked");
+}
+/* The page's way back is its back button (v70 .cfback). */
+static void go_back (GtkWidget *w)
+{
+  g_assert_true (GTK_IS_BUTTON (w) && gtk_widget_has_css_class (w, "cf-back"));
+  g_signal_emit_by_name (w, "clicked");
+}
 static void wait_ms (guint ms)
 {
