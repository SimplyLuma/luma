+static void live_user (View *v)
+{
+  JsonObject *o = live_person (v, cc_luma_view_text (v, "pUser"));
+  if (!o) { cf_header (v, "Users", NULL, NULL); return; }
+  const char *user = json_object_get_string_member_with_default (o, "user", "");
+  const char *who = json_object_get_string_member_with_default (o, "name", user);
+  gboolean admin = g_str_equal (cc_luma_view_text (v, "pType"), "admin");
+  g_autofree char *asset = g_strconcat ("user:", user, NULL), *line = person_line (o);
+  g_autofree char *first = first_name (who), *remove = g_strdup_printf ("Remove %s", first);
+  g_autofree char *reset = g_strdup_printf ("Set a new one for %s", first);
+  const char *types[] = { "std", "Standard", "admin", "Administrator", NULL };
+  cf_header (v, who, admin ? "Administrator account" : "Standard account", NULL);
+  cf_hero (v, identity (v, live_avatar (v, who, asset, 64), "cf-id", id_words (who, line, NULL), NULL), "cf-user-id");
+  GtkBox *g = cf_group (v, NULL, NULL);
+  gboolean mine = cc_luma_view_flag (v, "me.admin");
+  GtkWidget *row = cf_sg (v, g, "pType", "Account type", NULL, types);
+  if (!mine) lock_row (row, "Only an administrator can change this");
+  if (json_object_get_boolean_member_with_default (o, "local", TRUE))
+    cf_sw (v, g, "pAuto", "Sign in automatically", NULL, NULL);
+  g_autofree char *malcontent = g_find_program_in_path ("malcontent-control");
+  if (malcontent && !admin)
+    bt_lead (v, g, NULL, "Parental controls", "Apps, web and screen time for this person", "Open…", FALSE,
+             G_CALLBACK (live_parental_clicked), "cf-parental");
+  if (mine)
+    bt_lead (v, g, NULL, "Password", reset, "Reset…", FALSE, G_CALLBACK (live_reset_clicked), "cf-pwreset");
+  if (!mine) return;
+  g = cf_group (v, NULL, NULL);
+  bt_lead (v, g, NULL, remove, "Choose whether their files stay", "Remove…", TRUE, G_CALLBACK (live_remove_clicked), "cf-rmuser");
+}
