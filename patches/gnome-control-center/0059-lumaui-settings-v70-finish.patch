+  JsonArray *pages = cc_luma_fixture_get_pages (v->model);
+  g_autoptr (GPtrArray) found = g_ptr_array_new_with_free_func (g_object_unref);   /* rows */
+  g_autoptr (GPtrArray) found_pages = g_ptr_array_new_with_free_func (g_free);     /* their page */
+  g_autoptr (GPtrArray) page_only = g_ptr_array_new_with_free_func (g_free);      /* pages matched by name */
+  g_autoptr (GPtrArray) ids = g_ptr_array_new_with_free_func (g_free);
+  guint count = 0;
+  for (guint i = 0; pages && i < json_array_get_length (pages); i++)
+    g_ptr_array_add (ids, g_strdup (json_object_get_string_member (json_array_get_object_element (pages, i), "id")));
+  JsonNode *apps = json_object_get_member (cc_luma_fixture_get_data (v->model), "CFAPPS");
+  for (guint i = 0; apps && JSON_NODE_HOLDS_ARRAY (apps) && i < json_array_get_length (json_node_get_array (apps)); i++)
+    g_ptr_array_add (ids, g_strdup_printf ("app:%s", json_array_get_string_element (json_node_get_array (apps), i)));
+  g_hash_table_remove_all (v->search_counts);
+  for (guint i = 0; i < ids->len && found->len < 40; i++)
+    {
+      const char *id = g_ptr_array_index (ids, i);
+      const char *title = NULL;
+      gboolean page_match, any = FALSE;
+      guint taken = 0;
+      GtkWidget *scratch = g_object_ref_sink (gtk_box_new (GTK_ORIENTATION_VERTICAL, 0));
+      g_autoptr (GPtrArray) rows = g_ptr_array_new ();
+      if (!page_supported (id) || !page_valid (v->model, id) || !cc_luma_fixture_page_ready (v->model, id))
+        { g_object_unref (scratch); continue; }
+      for (guint j = 0; pages && j < json_array_get_length (pages); j++)
+        if (g_str_equal (json_object_get_string_member (json_array_get_object_element (pages, j), "id"), id))
+          title = json_object_get_string_member (json_array_get_object_element (pages, j), "title");
+      page_match = title && !g_str_has_prefix (id, "app:") && contains (title, needle);
+      g_free (v->page); v->page = g_strdup (id);
+      v->body = GTK_BOX (scratch);
+      render_page (v);
+      collect_rows (scratch, rows);
+      for (guint r = 0; r < rows->len && found->len < 40; r++)
+        {
+          GtkWidget *row = g_ptr_array_index (rows, r);
+          const char *t = row_text (row, "cf-title"), *sub = row_text (row, "cf-sub");
+          g_autofree char *both = g_strdup_printf ("%s %s", t ? t : "", sub ? sub : "");
+          if (contains (both, needle) || (page_match && taken < 3))
+            {
+              g_object_ref (row);
+              gtk_box_remove (GTK_BOX (gtk_widget_get_parent (row)), row);
+              g_ptr_array_add (found, row);
+              g_ptr_array_add (found_pages, g_strdup (id));
+              taken++; any = TRUE;
+            }
+        }
+      if (page_match && !any) g_ptr_array_add (page_only, g_strdup (id));
+      count += taken + (page_match && !any ? 1 : 0);
+      if (taken || (page_match && !any))
+        {
+          g_autofree char *root = g_strdup (id);
+          for (guint depth = 0; depth < 6; depth++)
+            {
+              const char *parent = NULL;
+              if (g_str_has_prefix (root, "app:")) parent = "apps";
+              for (guint j = 0; !parent && pages && j < json_array_get_length (pages); j++)
+                {
+                  JsonObject *p = json_array_get_object_element (pages, j);
+                  JsonNode *up = json_object_get_member (p, "parent");
+                  if (g_str_equal (json_object_get_string_member (p, "id"), root) && up && json_node_get_value_type (up) == G_TYPE_STRING)
+                    parent = json_node_get_string (up);
+                }
+              if (!parent) break;
+              g_free (root); root = g_strdup (parent);
+            }
+          g_hash_table_insert (v->search_counts, g_strdup (root),
+            GUINT_TO_POINTER (GPOINTER_TO_UINT (g_hash_table_lookup (v->search_counts, root)) + MAX (taken, 1)));
+        }
+      g_object_unref (scratch);
+    }
+  g_free (v->page); v->page = g_steal_pointer (&saved_page);
+  v->body = saved_body;
+  {
+    g_autofree char *title = count ? g_strdup_printf ("%u result%s", count, count > 1 ? "s" : "") : g_strdup ("No results");
+    g_autofree char *meta = count ? g_strdup_printf ("For “%s”. Change them right here.", v->query) : g_strdup_printf ("Nothing matches “%s”", v->query);
+    char *page = v->page;
+    v->page = (char *) "search-results";
+    cf_header (v, title, meta, NULL);
+    v->page = page;
+  }
+  /* One group per page, in the order found; a crumb names it and goes there. */
+  const char *group_page = NULL;
+  GtkBox *card = NULL;
+  for (guint i = 0; i < found->len + page_only->len; i++)
+    {
+      const char *id = i < found->len ? g_ptr_array_index (found_pages, i) : g_ptr_array_index (page_only, i - found->len);
+      if (g_strcmp0 (id, group_page) != 0)
+        {
+          const char *name = NULL, *parent_name = NULL, *parent = g_str_has_prefix (id, "app:") ? "apps" : NULL;
+          for (guint j = 0; pages && j < json_array_get_length (pages); j++)
+            {
+              JsonObject *p = json_array_get_object_element (pages, j);
+              JsonNode *up = json_object_get_member (p, "parent");
+              if (g_str_equal (json_object_get_string_member (p, "id"), id))
+                {
+                  name = json_object_get_string_member (p, "title");
+                  if (up && json_node_get_value_type (up) == G_TYPE_STRING) parent = json_node_get_string (up);
+                }
+            }
+          if (g_str_has_prefix (id, "app:")) name = cc_luma_fixture_app_name (v->model, id + 4);
+          for (guint j = 0; parent && pages && j < json_array_get_length (pages); j++)
+            if (g_str_equal (json_object_get_string_member (json_array_get_object_element (pages, j), "id"), parent))
+              parent_name = json_object_get_string_member (json_array_get_object_element (pages, j), "title");
+          g_autofree char *crumb_text = parent_name ? g_strdup_printf ("%s › %s", parent_name, name ? name : id) : g_strdup (name ? name : id);
+          GtkWidget *crumb = gtk_button_new ();
+          GtkWidget *content = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 3);
+          GtkWidget *chev = luma_ui_icon_new ("chevron-right");
+          gtk_box_append (GTK_BOX (content), cf_text (crumb_text, NULL));
+          gtk_box_append (GTK_BOX (content), chev);
+          gtk_button_set_child (GTK_BUTTON (crumb), content);
+          gtk_widget_add_css_class (crumb, "cf-crumb");
+          gtk_widget_set_valign (crumb, GTK_ALIGN_CENTER); /* v70 .cfcrumb: its own 17.4 line, centred in the h6 */
+          gtk_widget_set_halign (crumb, GTK_ALIGN_START);
+          g_object_set_data_full (G_OBJECT (crumb), "cf-target", g_strdup (id), g_free);
+          g_signal_connect_object (crumb, "clicked", G_CALLBACK (crumb_clicked), v->root, 0);
+          if (i < found->len)
+            card = cf_group_with (v, NULL, crumb, NULL);
+          else
+            {
+              GtkWidget *section = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+              GtkWidget *h6 = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+              gtk_widget_add_css_class (section, "cf-group");
+              gtk_widget_add_css_class (h6, "cf-h6");
+              gtk_box_append (GTK_BOX (h6), crumb);
+              gtk_box_append (GTK_BOX (section), h6);
+              gtk_box_append (v->body, section);
+              card = NULL;
+            }
+          group_page = id;
+        }
+      if (i < found->len && card)
+        gtk_box_append (card, g_ptr_array_index (found, i));
+    }
+}
+void cc_luma_view_search (GtkWidget *root, const char *query)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  g_free (v->query);
+  v->query = query && *query ? g_strdup (query) : NULL;
+  render (v);
+  if (v->search_handler) v->search_handler (v->root, v->query ? v->search_counts : NULL, v->search_data);
+}
+void cc_luma_view_set_search_handler (GtkWidget *root, CcLumaViewSearchFunc handler, gpointer data)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  v->search_handler = handler;
+  v->search_data = data;
+}
+void cc_luma_view_set_delegate (GtkWidget *root, CcLumaViewRouteFunc delegate, gpointer data)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  v->delegate = delegate;
+  v->delegate_data = data;
+}
+gboolean cc_luma_view_delegated (View *v)
+{
+  if (!v->model || !cc_luma_fixture_is_live (v->model)) return FALSE;
+  if (v->delegate) v->delegate (v->root, v->page, v->delegate_data);
+  return TRUE;
+}
