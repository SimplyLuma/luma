+  cairo_pattern_t *gradient = cairo_pattern_create_linear (0, 0, 0, 300);
+  oklch_rgba (dark ? 0.42 : 0.9, dark ? 0.07 : 0.05, page_hue (v), dark ? 0.26 : 0.55, &top);
+  cairo_pattern_add_color_stop_rgba (gradient, 0, top.red, top.green, top.blue, top.alpha);
+  cairo_pattern_add_color_stop_rgba (gradient, 1, top.red, top.green, top.blue, 0);
+  cairo_rectangle (cr, 0, 0, width, MIN (height, 300));
+  cairo_set_source (cr, gradient);
+  cairo_fill (cr);
+  cairo_pattern_destroy (gradient);
+}
+/* Whether this device is a phone (LUMA_FORM_FACTOR, else CHASSIS=handset), as the kit decides it.
+ * TODO(kit): use a public luma_ui_mobile_form_factor () once the kit exports it. */
+gboolean cc_luma_view_phone_device (void)
+{
+  const char *value = g_getenv ("LUMA_FORM_FACTOR");
+  g_autofree char *info = NULL;
+  if (value && *value)
+    return !g_ascii_strcasecmp (value, "phone") || !g_ascii_strcasecmp (value, "handset") || !g_ascii_strcasecmp (value, "mobile");
+  if (!g_file_get_contents ("/etc/machine-info", &info, NULL, NULL)) return FALSE;
+  return strstr (info, "CHASSIS=handset") || strstr (info, "CHASSIS=\"handset\"");
+}
