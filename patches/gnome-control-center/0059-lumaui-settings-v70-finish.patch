+/* ── Clock (v70 cfTime / cfDate / cfZoneName) ──────────────────────────── */
+
+/* The moment the page shows: pinned by LUMA_SETTINGS_CLOCK or the fixture's
+ * "clock" (ISO 8601) so captures are deterministic; the real clock only
+ * when neither pins it. */
+static GDateTime *now_in (View *v, const char *zone)
+{
+  const char *pin = g_getenv ("LUMA_SETTINGS_CLOCK");
+  if (!pin || !*pin) pin = cc_luma_view_text (v, "clock");
+  g_autoptr (GTimeZone) utc = g_time_zone_new_utc ();
+  g_autoptr (GDateTime) t = *pin ? g_date_time_new_from_iso8601 (pin, utc) : g_date_time_new_now_utc ();
+  g_autoptr (GTimeZone) tz = g_time_zone_new_identifier (zone);
+  if (!t) t = g_date_time_new_now_utc ();
+  /* Without the zone's rules (no tzdata), a pin keeps its own offset. */
+  if (!tz) return *pin ? g_date_time_ref (t) : g_date_time_to_local (t);
+  return g_date_time_to_timezone (t, tz);
+}
+
+static char *clock_time (View *v, GDateTime *t)
+{
+  gboolean h24 = cc_luma_view_flag (v, "h24"), secs = cc_luma_view_flag (v, "secs");
+  int h = g_date_time_get_hour (t), m = g_date_time_get_minute (t), s = g_date_time_get_second (t);
+  g_autofree char *sec = secs ? g_strdup_printf (":%02d", s) : g_strdup ("");
+  if (h24) return g_strdup_printf ("%02d:%02d%s", h, m, sec);
+  /* As the spec shows it: a plain space before the day half. */
+  return g_strdup_printf ("%d:%02d%s %s", h % 12 ? h % 12 : 12, m, sec, h < 12 ? "AM" : "PM");
+}
+
+static char *clock_date (GDateTime *t)
+{
+  static const char *days[] = { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
+  static const char *months[] = { "January", "February", "March", "April", "May", "June", "July",
+                                  "August", "September", "October", "November", "December" };
+  return g_strdup_printf ("%s, %s %d, %d", days[g_date_time_get_day_of_week (t) - 1],
+                          months[g_date_time_get_month (t) - 1], g_date_time_get_day_of_month (t), g_date_time_get_year (t));
+}
+
+/* Intl's long zone names (en-US) for the zones v70 offers. */
+static const char *zone_name (const char *zone, GDateTime *t)
+{
+  static const struct { const char *id, *standard, *summer; } names[] = {
+    { "America/Chicago", "Central Standard Time", "Central Daylight Time" },
+    { "America/New_York", "Eastern Standard Time", "Eastern Daylight Time" },
+    { "America/Los_Angeles", "Pacific Standard Time", "Pacific Daylight Time" },
+    { "Europe/London", "Greenwich Mean Time", "British Summer Time" },
+    { "Europe/Berlin", "Central European Standard Time", "Central European Summer Time" },
+    { "Asia/Kolkata", "India Standard Time", "India Standard Time" },
+    { "Asia/Tokyo", "Japan Standard Time", "Japan Standard Time" },
+    { "Australia/Sydney", "Australian Eastern Standard Time", "Australian Eastern Daylight Time" },
+  };
+  for (guint i = 0; i < G_N_ELEMENTS (names); i++)
+    if (g_str_equal (zone, names[i].id))
+      return g_date_time_is_daylight_savings (t) ? names[i].summer : names[i].standard;
+  return g_date_time_get_timezone_abbreviation (t);
+}
