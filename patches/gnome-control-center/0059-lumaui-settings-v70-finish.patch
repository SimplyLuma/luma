+  Live *live;
+  if (!bytes) return NULL;
+  if (!json_parser_load_from_data (parser, g_bytes_get_data (bytes, NULL), g_bytes_get_size (bytes), error))
+    return NULL;
+  model = cc_luma_fixture_new_live (json_parser_get_root (parser));
+  live = g_new0 (Live, 1);
+  live->running = g_ptr_array_new_with_free_func (g_free);
+  live->owners = g_hash_table_new (g_str_hash, g_str_equal);
+  g_object_set_data_full (G_OBJECT (model), "cc-luma-live", live, (GDestroyNotify) live_free);
+  cc_luma_fixture_set_writer (model, live_write, live);
+  cc_luma_fixture_set_page_ready_func (model, page_ready, live);
+  /* Writes proven against a real owner (VM, 28 Sep): Appearance's mode and
+   * wallpaper, Night Light, the proxy and a VPN's switch. Every other change
+   * a live page offers opens the page's GNOME panel. */
+  for (const char * const *k = (const char * const[]) { "mode", "wall", "night", "nightWhen", "proxy", "vpn",
+                                                        /* Night Light's times and warmth wait for a VM write check */
+                                                        /* Bluetooth discovery while the page is open, as GNOME's panel does */
+                                                        "CFNEAR.scan",
+                                                        /* People, Date & Time and Remote Desktop (VM, 28 Sep): the
+                                                         * person Users opens, clock format, weekday, automatic time
+                                                         * zone, and Remote Desktop's tab (a view choice) */
+                                                        "pUser", "h24", "wday", "autoZone", "rdTab",
+                                                        /* Privacy, Wellbeing, names (VM 29 Sep, runs 20260929T065904-ys-r3b
+                                                         * and 20260929T070854-ys-r3c): landed and shown again on reopening */
+                                                        "lock.auto", "lock.notes", "cam", "mic", "hist", "trash", "temp",
+                                                        "limit", "gray", "myName",
+                                                        /* VM 29 Sep: runs 20260929T072940-ys-r3e (loc on and off, lock.delay,
+                                                         * limitH, eyes, move, brSound, fmt), T073945-ys-r3f (tbolt, no prompt),
+                                                         * T075912-ys-r3g (trashAge), T080608-ys-r3h (lock.blank, histKeep, lang),
+                                                         * T081550-ys-r3j (moveS) */
+                                                        "loc", "lock.delay", "trashAge", "limitH", "eyes",
+                                                        "move", "brSound", "fmt", "tbolt",
+                                                        /* Re-proven on the fixed rig, VM 29 Sep run 20260929T111859-ys-r4 (same
+                                                         * boot id and gnome-control-center package before every check):
+                                                         * landed and shown again on reopening; file sharing on and off. */
+                                                        "lock.blank", "histKeep", "lang", "moveS", "fileShare",
+                                                        /* VM 29 Sep, on and off through gsd-sharing / GSettings: runs
+                                                         * 20260929T083614-ys-r3k and T084007-ys-r3l */
+                                                        
+                                                        /* VM 28 Sep 21:57 (run 20260928T215513-live-desk): written,
+                                                         * taken by the Shell/GSettings and shown again on reopening */
+                                                        "edge", "joined", "float", "hot", "ws", "wsN", "wsMon", "dnd", "lockN",
+                                                        /* VM 29 Sep (runs 20260929T064332- and 20260929T070241-live-apps) */
+                                                        "neverMedia", "media.audio", "media.software", "media.photos", "media.video",
+                                                        "def.web",
+                                                        /* VM 29 Sep (run 20260929T072741-live-defaults): set, reopened, put back */
+                                                        "def.photo",
+                                                        /* VM 29 Sep (run 20260929T065510-ld4-writes): clicked,
+                                                         * landed in GSettings/PipeWire/the alert theme and shown
+                                                         * again after reopening Settings */
+                                                        "nightT", "vol", "bal", "overamp", "alert", "autoBright", "dim",
+                                                        "susAc", "mBtn",
+                                                        /* VM 29 Sep (run 20260929T070512-ld5-writes): written by a
+                                                         * click, in GSettings and shown again after reopening */
+                                                        "mSpeed", "mAccel", "mNat", "osk", "rep", "blink", "sticky", "slow",
+                                                        "bounce", "mkeys", "locate", "hold", "hover", "vAlert", "cross",
+                                                        "invert", "hc", "motion", "scrollbars", "soundKeys",
+                                                        /* VM 29 Sep (run 20260929T073511-ld6-writes): the touchpad
+                                                         * tab (a view choice) and its switches and speed, the account
+                                                         * name (AccountsService), shown again after reopening */
+                                                        "mtab", "tp", "tpType", "tSpeed", "tTap", "myName",
+                                                        /* VM 29 Sep (run 20260929T080303-ld7-writes): picked from
+                                                         * the pages' menus or switched, in GSettings and shown again
+                                                         * after reopening: Night Light's times, screen off and sleep
+                                                         * delays, Accessibility in Quick Options, per-window layouts,
+                                                         * larger text */
+                                                        
+                                                        
+                                                        /* VM 29 Sep (run 20260929T081024-ld8-writes): pointer size,
+                                                         * the accents key (xkb-options) and zoom, kept on reopening */
+                                                        
+                                                        /* VM 29 Sep (run 20260929T081706-ld9-writes): how visual
+                                                         * alerts flash, kept on reopening */
+                                                        
+                                                        /* VM 29 Sep (run 20260929T082026-ld10-writes, Settings
+                                                         * started inside the session so polkit sees it active):
+                                                         * the power mode, kept on reopening */
+                                                        
+                                                        /* VM 29 Sep (run 20260929T082445-ld11-writes): how zoom
+                                                         * follows the pointer, kept on reopening */
+                                                        
+                                                        /* VM 29 Sep (run 20260929T082829-ld12-writes): system
+                                                         * sounds' own level, kept by PipeWire on reopening */
+                                                        "lv.system",
+                                                        /* VM 29 Sep (run 20260929T083029-ld13-writes): typing assist
+                                                         * from the keyboard, the screen reader, kept on reopening */
+                                                        
+                                                        /* VM 29 Sep (run 20260929T090311-ld17-writes, Settings in
+                                                         * the session): the compose key, touchpad secondary click
+                                                         * and direction, magnification. The computer name and the
+                                                         * printer's default, paper and colour mode landed only with
+                                                         * a VM polkit rule standing in for the password (ld17, ld20);
+                                                         * the real password path isn't proven, so they stay with the
+                                                         * GNOME panels. */
+                                                        
+                                                        /* VM 29 Sep (run 20260929T090706-ld18-writes): the power
+                                                         * button, kept on reopening */
+                                                        
+                                                        /* Rig fault 29 Sep 08:03–10:36 EDT (greenboot rebooted guests mid-run): keys whose only proof was a run in that
+                                                         * window (ld7–ld11, ld13–ld20, ys-r3h–r3l) are back on the GNOME panels until re-proven. */
+                                                        NULL }; *k; k++)
+    cc_luma_fixture_verify_key (model, *k);
+  /* Which display the rows show is the page's own choice (VM run
+   * 20260930T214237-dp3-writes: a tile click stays on this page). */
+  cc_luma_fixture_verify_key (model, "dsel");
+  /* Join and mirror with two displays: Mirror then Revert Settings goes back
+   * (VM run 20260930T230328-dp13-heads2-mirror), Mirror kept and kept on
+   * reopening (20260930T230745-dp15-heads2-mirror-keep), Join from mirror
+   * kept and kept on reopening (20260930T231038-dp16-heads2-join). */
+  cc_luma_fixture_verify_key (model, "join");
+  /* A display's scale (VM runs 20260929T073511-ld6-writes, 20260930T220109-dp4-scale)
+   * and refresh rate (20260930T214237-dp3-writes): applied, confirmed in the
+   * Shell's keep-or-revert dialog, Mutter reports it, kept after reopening.
+   * With two displays: the main display (20260930T225535-dp10-heads2-writes)
+   * and dragging one beside another (20260930T230004-dp12-heads2-mirror).
+   * Resolution 1920×1200 → 1680×1050 (20260930T231611-dp18-res-keep);
+   * orientation Landscape → Landscape, flipped (20260930T232056-dp20-rot). */
+  for (const char * const *id = (const char * const[]) { "int", "ext", "ext2", "ext3", NULL }; *id; id++)
+    for (const char * const *f = (const char * const[]) { "scale", "hz", "primary", "pos", "res", "rot", NULL }; *f; f++)
+      {
+        g_autofree char *key = g_strdup_printf ("d.%s.%s", *id, *f);
+        cc_luma_fixture_verify_key (model, key);
+      }
+  for (guint i = 0; adapters[i]; i++)
+    {
+      Running *r = g_new0 (Running, 1);
+      r->adapter = adapters[i];
+      g_ptr_array_add (live->running, r);
+      r->state = adapters[i]->start (model);
+    }
+  return model;
+}
+
+void
+cc_luma_live_ready (CcLumaFixture *model, const char *adapter)
+{
+  Live *live = live_of (model);
+  for (guint i = 0; live && i < live->running->len; i++)
+    {
+      Running *r = g_ptr_array_index (live->running, i);
+      if (g_str_equal (r->adapter->name, adapter)) r->ready = TRUE;
+    }
+  cc_luma_fixture_changed (model);
+}
+
+static gboolean
+page_ready (CcLumaFixture *model, const char *page, gpointer data)
+{
+  Live *live = data;
+  gboolean covered = FALSE;
+  if (!page || !live) return FALSE;
+  for (guint i = 0; i < live->running->len; i++)
+    {
+      Running *r = g_ptr_array_index (live->running, i);
+      for (guint j = 0; r->adapter->pages && r->adapter->pages[j]; j++)
+        if (g_str_equal (r->adapter->pages[j], page) ||
+            (g_str_has_prefix (page, "app:") && g_str_equal (r->adapter->pages[j], "app:")))
+          {
+            if (!r->ready) return FALSE;
+            covered = TRUE;
+          }
+    }
+  return covered;
+}
+
+gboolean
+cc_luma_live_page_ready (CcLumaFixture *model, const char *page)
+{
+  return cc_luma_fixture_page_ready (model, page);
+}
diff --git a/shell/cc-luma-live.h b/shell/cc-luma-live.h
new file mode 100644
index 0000000..378c26f
--- /dev/null
+++ b/shell/cc-luma-live.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "cc-luma-fixture.h"
+
+G_BEGIN_DECLS
+/* The production model: Settings' page structure plus what the system's own
+ * owners report, through one adapter per owner. A page is drawn by LumaUI
+ * once every adapter it needs has reported; until then Settings shows the
+ * page's GNOME panel. Writes go to the owning adapter; nothing else writes. */
+typedef struct {
+  const char *name;
+  /* Pages this adapter makes drawable (NULL-terminated). */
+  const char * const *pages;
+  /* Begin observing; publish into the model; call cc_luma_live_ready. */
+  gpointer (*start) (CcLumaFixture *model);
+  /* Apply a change the person made (NULL: read-only adapter). Keys the
+   * adapter can write are declared with cc_luma_fixture_own_key. */
+  gboolean (*write) (gpointer state, const char *key, JsonNode *value, GError **error);
+  void (*stop) (gpointer state);
+} CcLumaAdapter;
+
+CcLumaFixture *cc_luma_live_model_new (GError **error);
+/* TRUE in fixture mode; in live mode when all of the page's adapters are ready. */
+gboolean cc_luma_live_page_ready (CcLumaFixture *model, const char *page);
+/* An adapter reports its first complete reading. */
+void cc_luma_live_ready (CcLumaFixture *model, const char *adapter);
+G_END_DECLS
diff --git a/shell/cc-luma-power-reads.c b/shell/cc-luma-power-reads.c
index 6a54f2b..c9d36ca 100644
--- a/shell/cc-luma-power-reads.c
+++ b/shell/cc-luma-power-reads.c
@@ -20,10 +20,13 @@ gboolean cc_luma_power_history_validate (GVariant *history, GError **error)
   if (!history || !g_variant_is_of_type (history, G_VARIANT_TYPE ("a(udu)")))
     return invalid (error, "Invalid UPower charge history type");
   guint32 previous = 0;
+  int direction = 0; /* UPower reports newest first; either order, never mixed */
   for (gsize i = 0; i < g_variant_n_children (history); i++) {
     guint32 time, state; double charge;
     g_variant_get_child (history, i, "(udu)", &time, &charge, &state);
-    if (!isfinite (charge) || charge < 0 || charge > 100 || (i && time < previous))
+    int step = i && time != previous ? (time > previous ? 1 : -1) : 0;
+    if (step && !direction) direction = step;
+    if (!isfinite (charge) || charge < 0 || charge > 100 || (step && step != direction))
       return invalid (error, "Invalid UPower charge history sample");
     /* Keep real timestamps and states, including gaps and unknown states.
      * No interpolation or invented hourly sample enters the live model. */
diff --git a/shell/cc-luma-privacy.c b/shell/cc-luma-privacy.c
