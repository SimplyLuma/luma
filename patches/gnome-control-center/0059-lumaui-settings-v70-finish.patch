+/* A box sized by its CSS alone: children get its width and either its
+ * height (@fit) or their own, and are clipped. */
+static void clip_measure (GtkWidget *w, GtkOrientation o, int for_size, int *min, int *nat, int *minb, int *natb)
+{
+  *min = *nat = 0; *minb = *natb = -1;
+}
+
+static void clip_allocate (GtkWidget *w, int width, int height, int baseline)
+{
+  gboolean fit = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (w), "cf-fit"));
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c))
+    {
+      int ch = height, cw, cmin;
+      /* never below the child's own minimum: the box clips what doesn't fit */
+      gtk_widget_measure (c, GTK_ORIENTATION_HORIZONTAL, -1, &cmin, NULL, NULL, NULL);
+      cw = MAX (width, cmin);
+      if (!fit) gtk_widget_measure (c, GTK_ORIENTATION_VERTICAL, cw, NULL, &ch, NULL, NULL);
+      gtk_widget_allocate (c, cw, MAX (ch, 0), -1, NULL);
+    }
+}
+
+GtkWidget *cc_luma_dev_clip (gboolean fit)
+{
+  GtkWidget *box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  gtk_widget_set_layout_manager (box, gtk_custom_layout_new (NULL, clip_measure, clip_allocate));
+  gtk_widget_set_overflow (box, GTK_OVERFLOW_HIDDEN);
+  g_object_set_data (G_OBJECT (box), "cf-fit", GINT_TO_POINTER (fit));
+  return box;
+}
+
+/* v70 flex: w with flex-basis 0: widths share what the gaps leave. */
+static void weighted_measure (GtkWidget *w, GtkOrientation o, int for_size, int *min, int *nat, int *minb, int *natb)
+{
+  *min = *nat = 0; *minb = *natb = -1;
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c))
+    {
+      int cm, cn;
+      gtk_widget_measure (c, o, -1, &cm, &cn, NULL, NULL);
+      if (o == GTK_ORIENTATION_VERTICAL) { *min = MAX (*min, cm); *nat = MAX (*nat, cn); }
+    }
+}
+
+static void weighted_allocate (GtkWidget *w, int width, int height, int baseline)
+{
+  int spacing = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (w), "cf-spacing"));
+  double total = 0, x = 0;
+  guint n = 0;
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c), n++)
+    total += *(double *) g_object_get_data (G_OBJECT (c), "cf-w");
+  double free_width = MAX (0, width - spacing * (int) (n ? n - 1 : 0));
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c))
+    {
+      double cw = free_width * *(double *) g_object_get_data (G_OBJECT (c), "cf-w") / total;
+      int x0 = (int) round (x), x1 = (int) round (x + cw);
+      graphene_point_t p = GRAPHENE_POINT_INIT ((float) x0, 0);
+      if (GTK_IS_LABEL (c))
+        {
+          /* CSS start-aligns a centred line that overflows its box (v70 .cfkr kbd "Super" on a phone):
+           * a key whose words don't fit starts at its left edge and spills right. */
+          int tw = 0;
+          PangoLayout *layout = gtk_widget_create_pango_layout (c, gtk_label_get_text (GTK_LABEL (c)));
+          pango_layout_get_pixel_size (layout, &tw, NULL);
+          g_object_unref (layout);
+          float want = tw > x1 - x0 ? 0.f : .5f;
+          if (gtk_label_get_xalign (GTK_LABEL (c)) != want) gtk_label_set_xalign (GTK_LABEL (c), want);
+        }
+      gtk_widget_allocate (c, x1 - x0, height, -1, gsk_transform_translate (NULL, &p));
+      x += cw + spacing;
+    }
+}
+
+GtkWidget *cc_luma_dev_weighted (int spacing)
+{
+  GtkWidget *box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_set_layout_manager (box, gtk_custom_layout_new (NULL, weighted_measure, weighted_allocate));
+  g_object_set_data (G_OBJECT (box), "cf-spacing", GINT_TO_POINTER (spacing));
+  return box;
+}
