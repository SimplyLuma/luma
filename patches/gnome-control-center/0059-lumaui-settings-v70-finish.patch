   GDBusConnection *connection, CcLumaPermission kind,
   const char *backup_dir, GError **error);
 GtkWidget *cc_luma_view_new_native_permission (CcLumaPermission kind, GError **error);
+/* Search rows across pages (NULL or "" ends it). The handler learns each
