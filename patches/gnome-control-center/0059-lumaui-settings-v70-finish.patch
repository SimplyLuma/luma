+/* Live text fields: one write per edit (Enter or leaving the field), and a redraw keeps the draft. */
+typedef struct { guint writes; char *last; } TextWrites;
+static gboolean text_writer (CcLumaFixture *model, const char *key, JsonNode *value, gpointer data, GError **error)
+{
+  TextWrites *w = data;
+  w->writes++;
+  g_free (w->last); w->last = g_strdup (json_node_get_string (value));
+  cc_luma_fixture_publish (model, key, value);
+  return TRUE;
+}
+static gboolean always_ready (CcLumaFixture *model, const char *page, gpointer data) { return TRUE; }
+static void live_text_commit (void)
+{
+  g_autoptr (JsonParser) parser = json_parser_new ();
+  g_assert_true (json_parser_load_from_file (parser, g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), NULL));
+  g_autoptr (CcLumaFixture) model = cc_luma_fixture_new_live (json_parser_get_root (parser));
+  TextWrites w = { 0 };
+  cc_luma_fixture_set_writer (model, text_writer, &w);
+  cc_luma_fixture_set_page_ready_func (model, always_ready, NULL);
+  cc_luma_fixture_own_key (model, "devName");
+  cc_luma_fixture_verify_key (model, "devName");
+  GtkWidget *window = gtk_window_new ();
+  GtkWidget *view = cc_luma_view_new (model, "sharing", NULL);
+  gtk_window_set_child (GTK_WINDOW (window), view);
+  gtk_window_present (GTK_WINDOW (window)); wait_ms (100);
+  GtkWidget *field = find_name (view, "cf-devName");
+  g_assert_nonnull (field);
+  gtk_widget_grab_focus (field); drain ();
+  gtk_editable_set_text (GTK_EDITABLE (field), "L");
+  gtk_editable_set_text (GTK_EDITABLE (field), "Lu");
+  gtk_editable_set_text (GTK_EDITABLE (field), "Luma Tester"); drain ();
+  g_assert_cmpuint (w.writes, ==, 0);
+  /* An owner's report redraws the page mid-edit: the draft and the focus survive. */
+  cc_luma_fixture_changed (model); wait_ms (50);
+  field = find_name (view, "cf-devName");
+  g_assert_cmpstr (gtk_editable_get_text (GTK_EDITABLE (field)), ==, "Luma Tester");
+  GtkWidget *focus = gtk_window_get_focus (GTK_WINDOW (window)); /* an entry's focus is its inner text */
+  g_assert_true (focus == field || (focus && gtk_widget_is_ancestor (focus, field)));
+  g_assert_cmpuint (w.writes, ==, 0);
+  g_signal_emit_by_name (field, "activate"); drain ();
+  g_assert_cmpuint (w.writes, ==, 1);
+  g_assert_cmpstr (w.last, ==, "Luma Tester");
+  /* Enter again without a change writes nothing. */
+  field = find_name (view, "cf-devName");
+  g_signal_emit_by_name (field, "activate"); drain ();
+  g_assert_cmpuint (w.writes, ==, 1);
+  gtk_window_destroy (GTK_WINDOW (window)); drain ();
+  g_free (w.last);
+}
