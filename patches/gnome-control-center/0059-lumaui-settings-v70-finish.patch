+static void datetime (View *v)
+{
+  const char *zone = cc_luma_view_text (v, "zone");
+  JsonArray *zones = data_array (v, "CFZONE");
+  const char *city = pair_label (zones, zone);
+  gboolean auto_time = cc_luma_view_flag (v, "autoTime");
+  g_autoptr (GDateTime) now = now_in (v, zone);
+  g_autofree char *time = clock_time (v, now), *date = clock_date (now);
+  g_autofree char *meta = g_strdup_printf ("%s · %s", city, auto_time ? "set automatically" : "set by hand");
+  g_autofree char *where = g_strdup_printf ("%s · %s", city, zone_name (zone, now));
+  cf_header (v, "Date & Time", meta, NULL);
+  {
+    GtkWidget *clock = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+    GtkWidget *place = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+    GtkWidget *t = cf_text (time, "cf-clock-time"), *d = cf_text (date, "cf-clock-date");
+    gtk_widget_add_css_class (clock, "cf-clock");
+    gtk_widget_set_name (t, "cf-time");
+    gtk_widget_set_name (d, "cf-date");
+    gtk_widget_add_css_class (place, "cf-clock-place");
+    gtk_box_append (GTK_BOX (place), luma_ui_icon_new ("map-pin"));
+    gtk_box_append (GTK_BOX (place), cf_text (where, NULL));
+    gtk_box_append (GTK_BOX (clock), t);
+    gtk_box_append (GTK_BOX (clock), d);
+    gtk_box_append (GTK_BOX (clock), place);
+    for (GtkWidget *c = gtk_widget_get_first_child (clock); c; c = gtk_widget_get_next_sibling (c))
+      gtk_widget_set_halign (c, GTK_ALIGN_CENTER);
+    cf_hero (v, clock, "cf-datetime-clock");
+  }
+  GtkBox *g = cf_group (v, NULL, NULL);
+  cf_sw (v, g, "autoTime", "Set the time automatically", "From the internet", NULL);
+  GtkWidget *row = bt_lead (v, g, NULL, "Date and time", date, "Change…", FALSE, G_CALLBACK (set_time_clicked), "cf-settime");
+  if (auto_time) lock_row (row, "Turn off automatic time first");
+  cf_sw (v, g, "autoZone", "Set the time zone automatically", "From your location", NULL);
+  g_auto (GStrv) zone_choices = pair_choices (zones);
+  row = pk (v, g, "zone", "Time zone", NULL, zone_choices);
+  if (cc_luma_view_flag (v, "autoZone")) lock_row (row, "Turn off automatic time zone first");
+  g = cf_group (v, "Clock", NULL);
+  {
+    const char *formats[] = { "false", "AM/PM", "true", "24-hour", NULL };
+    cf_sg (v, g, "h24", "Time format", NULL, formats);
+  }
+  cf_sw (v, g, "wday", "Weekday", NULL, NULL);
+  cf_sw (v, g, "date", "Date", NULL, NULL);
+  cf_sw (v, g, "secs", "Seconds", NULL, NULL);
+  g = cf_group (v, "Calendar", NULL);
+  cf_sw (v, g, "wnum", "Week numbers", NULL, NULL);
+}
