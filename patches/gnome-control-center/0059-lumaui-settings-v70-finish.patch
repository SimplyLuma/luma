+/* Nothing spills over an edge (Nick, 30 Sep): on every page, at 1180×740 and at phone width, with the fixture's
+ * names and with long real-world ones, no widget sticks out of a parent that doesn't clip it, and no label is
+ * narrower than the text it must show. */
+static gboolean spill_exempt (GtkWidget *w)
+{
+  /* Parts v70 sets into their row's padding on purpose (negative margins), and a battery's nub. */
+  const char *bleeds[] = { "cf-back", "cf-grip", "cf-swb", "cf-copy", "cf-cell-nub" };
+  for (guint i = 0; i < G_N_ELEMENTS (bleeds); i++)
+    if (gtk_widget_has_css_class (w, bleeds[i])) return TRUE;
+  return FALSE;
+}
+static gboolean clips (GtkWidget *p)
+{
+  return gtk_widget_get_overflow (p) == GTK_OVERFLOW_HIDDEN || GTK_IS_VIEWPORT (p) || GTK_IS_SCROLLED_WINDOW (p) ||
+         GTK_IS_STACK (p) || GTK_IS_REVEALER (p);
+}
+static const char *widget_label (GtkWidget *w)
+{
+  static char buf[160];
+  if (GTK_IS_LABEL (w)) return gtk_label_get_text (GTK_LABEL (w));
+  g_auto (GStrv) classes = gtk_widget_get_css_classes (w);
+  g_autofree char *joined = g_strjoinv (".", classes);
+  g_snprintf (buf, sizeof buf, "%s.%s", gtk_widget_get_name (w), joined);
+  return buf;
+}
+static void spill_walk (GtkWidget *w, GtkWidget *root, GString *out, const char *where)
+{
+  if (!gtk_widget_get_mapped (w)) return;
+  GtkWidget *p = gtk_widget_get_parent (w);
+  graphene_rect_t b, pb, self;
+  /* Bounds are border boxes, each in the parent's own coordinates. A range's slider rides past its trough by design. */
+  if (w != root && p && !clips (p) && !spill_exempt (w) && !GTK_IS_RANGE (p) && !gtk_widget_get_ancestor (w, GTK_TYPE_RANGE) &&
+      gtk_widget_compute_bounds (w, p, &b) && gtk_widget_compute_bounds (p, p, &pb))
+    {
+      if (b.origin.x < pb.origin.x - 1 || b.origin.x + b.size.width > pb.origin.x + pb.size.width + 1)
+        g_string_append_printf (out, "%s: %s \"%s\" spans %.0f..%.0f in its %s of %.0f..%.0f\n", where, G_OBJECT_TYPE_NAME (w),
+                                widget_label (w), b.origin.x, b.origin.x + b.size.width, G_OBJECT_TYPE_NAME (p),
+                                pb.origin.x, pb.origin.x + pb.size.width);
+    }
+  /* A timeline's tick labels are zero-wide anchors whose words sit over the timeline (v70 .cfdayl). */
+  gboolean anchor = p && gtk_widget_has_css_class (p, "cf-dayl");
+  if (!anchor && GTK_IS_LABEL (w) && *gtk_label_get_text (GTK_LABEL (w)) && gtk_widget_compute_bounds (w, w, &self))
+    {
+      /* The label's minimum (border box plus margins) against what it was given. */
+      int min = 0, given = (int) self.size.width + gtk_widget_get_margin_start (w) + gtk_widget_get_margin_end (w);
+      gtk_widget_measure (w, GTK_ORIENTATION_HORIZONTAL, -1, &min, NULL, NULL, NULL);
+      if (min > given + 1)
+        g_string_append_printf (out, "%s: label \"%s\" needs %d, has %d\n", where, gtk_label_get_text (GTK_LABEL (w)), min, given);
+    }
+  {
+    /* A layout must never claim more height than it naturally takes (GTK warns, and rows jump). */
+    int vmin = 0, vnat = 0, width = gtk_widget_get_width (w);
+    if (width > 0)
+      {
+        gtk_widget_measure (w, GTK_ORIENTATION_VERTICAL, width, &vmin, &vnat, NULL, NULL);
+        if (vmin > vnat)
+          {
+            g_autoptr (GString) classes = g_string_new (NULL);
+            g_auto (GStrv) list = gtk_widget_get_css_classes (w);
+            for (guint i = 0; list[i]; i++) g_string_append_printf (classes, ".%s", list[i]);
+            GtkWidget *p2 = gtk_widget_get_parent (w);
+            g_auto (GStrv) plist = p2 ? gtk_widget_get_css_classes (p2) : NULL;
+            g_string_append_printf (out, "%s: %s%s#%s (parent %s.%s) min height %d > natural %d at width %d\n", where,
+                                    G_OBJECT_TYPE_NAME (w), classes->str, gtk_widget_get_name (w),
+                                    p2 ? G_OBJECT_TYPE_NAME (p2) : "-", plist && plist[0] ? plist[0] : "", vmin, vnat, width);
+          }
+      }
+  }
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c))
+    spill_walk (c, root, out, where);
+}
+static void lengthen (JsonObject *o, const char *member, const char *text)
+{
+  if (o && json_object_has_member (o, member)) json_object_set_string_member (o, member, text);
+}
+static void long_names (CcLumaFixture *model)
+{
+  JsonObject *data = cc_luma_fixture_get_data (model);
+  JsonObject *disp = json_object_get_object_member (data, "CFDISP");
+  GList *ids = json_object_get_members (disp);
+  for (GList *l = ids; l; l = l->next)
+    {
+      JsonObject *d = json_object_get_object_member (disp, l->data);
+      lengthen (d, "n", "ASUSTek COMPUTER INC 27\" ProArt PA278CV Professional Monitor");
+      lengthen (d, "m", "27″ · DisplayPort over USB-C (Thunderbolt 4 dock, second port)");
+    }
+  g_list_free (ids);
+  const char *arrays[] = { "CFBT", "CFNEAR", "CFOUT" };
+  for (guint a = 0; a < G_N_ELEMENTS (arrays); a++)
+    {
+      JsonArray *list = json_object_get_array_member (data, arrays[a]);
+      for (guint i = 0; i < json_array_get_length (list); i++)
+        lengthen (json_array_get_object_element (list, i), "n", "Nick’s Sony WH-1000XM5 Wireless Noise Cancelling Headphones");
+    }
+  lengthen (json_object_get_object_member (data, "CFPRINTER"), "n", "Brother HL-L2350DW series (Office, second floor, by the window)");
+}
+static GString *spill_log;
+static char spill_where[128];
+static gboolean spill_fatal (const char *domain, GLogLevelFlags level, const char *message, gpointer data)
+{
+  /* A layout warning is a finding on that page, not the end of the sweep. */
+  if (spill_log && (level & (G_LOG_LEVEL_WARNING | G_LOG_LEVEL_CRITICAL)))
+    { g_string_append_printf (spill_log, "%s: %s-WARNING %s\n", *spill_where ? spill_where : "?", domain ? domain : "", message); return FALSE; }
+  return TRUE;
+}
+/* The sweep measures what people see: the kit's sheets and Settings' own, as cc-application loads them. */
+static void load_settings_style (void)
+{
+  luma_init ();
+  for (const char * const *sheet = (const char * const[]) { "luma-settings.css", "luma-settings-desktop.css",
+       "luma-settings-devices.css", "luma-settings-you.css", "luma-settings-system.css", NULL }; *sheet; sheet++)
+    {
+      g_autofree char *path = g_build_filename (LUMA_SHELL_SRCDIR, *sheet, NULL);
+      GtkCssProvider *provider = gtk_css_provider_new ();
+      gtk_css_provider_load_from_path (provider, path);
+      gtk_style_context_add_provider_for_display (gdk_display_get_default (), GTK_STYLE_PROVIDER (provider),
+                                                  GTK_STYLE_PROVIDER_PRIORITY_APPLICATION);
+      g_object_unref (provider);
+    }
+}
+static void no_spill (void)
+{
+  g_autoptr (GString) out = g_string_new (NULL);
+  load_settings_style ();
+  spill_log = out;
+  /* Layout warnings are reported on stderr under the page they came from (sweep progress lines), not fatal here. */
+  GLogLevelFlags fatal = g_log_set_always_fatal (G_LOG_FATAL_MASK);
+  /* v71: a phone device (LUMA_FORM_FACTOR=phone, the phone shell's 402×874) draws its own anatomy too. */
+  const struct { int w, h; const char *name; gboolean device; } sizes[] = { { 1180, 740, "desktop", FALSE }, { 390, 844, "phone", FALSE },
+                                                                           { 402, 874, "phone device", TRUE } };
+  for (guint longs = 0; longs < 2; longs++)
+    for (guint z = 0; z < G_N_ELEMENTS (sizes); z++)
+      {
+        g_autoptr (CcLumaFixture) model = load ();
+        if (longs) long_names (model);
+        if (sizes[z].device) g_setenv ("LUMA_FORM_FACTOR", "phone", TRUE);
+        else g_unsetenv ("LUMA_FORM_FACTOR");
+        JsonArray *pages = cc_luma_fixture_get_pages (model);
+        for (guint i = 0; i < json_array_get_length (pages); i++)
+          {
+            const char *id = json_object_get_string_member (json_array_get_object_element (pages, i), "id");
+            g_autoptr (GError) error = NULL;
+            GtkWidget *view = cc_luma_view_new (model, id, &error);
+            if (!view) continue;
+            GtkWidget *window = gtk_window_new ();
+            gtk_window_set_default_size (GTK_WINDOW (window), sizes[z].w, sizes[z].h);
+            gtk_window_set_child (GTK_WINDOW (window), view);
+            gtk_window_present (GTK_WINDOW (window)); wait_ms (z ? 300 : 120); /* a phone redraws once its breakpoint applies */
+            g_autofree char *where = g_strdup_printf ("%s %s%s", id, sizes[z].name, longs ? " long" : "");
+            g_strlcpy (spill_where, where, sizeof spill_where);
+            g_printerr ("spill-sweep: %s\n", where);
+            spill_walk (view, view, out, where);
+            gtk_window_destroy (GTK_WINDOW (window)); drain ();
+          }
+      }
+  g_unsetenv ("LUMA_FORM_FACTOR");
+  g_log_set_always_fatal (fatal);
+  spill_log = NULL; spill_where[0] = 0;
+  if (g_getenv ("LUMA_SPILL_REPORT")) g_file_set_contents (g_getenv ("LUMA_SPILL_REPORT"), out->str, -1, NULL);
+  if (out->len) g_test_message ("spills:\n%s", out->str);
+  g_assert_cmpuint (out->len, ==, 0);
+}
