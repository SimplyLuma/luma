+static void rg_moved (GtkRange *range, GtkWidget *root)
+{
+  View *v = view_of (root);
+  if (!v || !gtk_widget_is_ancestor (GTK_WIDGET (range), root)) return; /* a slider from an earlier drawing writes nothing */
+  double number = gtk_range_get_value (range);
+  gboolean fractional = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (range), "cf-fraction"));
+  g_autoptr (JsonNode) value = fractional ? json_node_init_double (json_node_alloc (), number) :
+    json_node_init_int (json_node_alloc (), (gint64) round (number));
+  /* Continuous input keeps the emitting range: no rebuild. */
+  if (!commit (v, G_OBJECT (range), value, FALSE)) return;
+  CfFormat format = g_object_get_data (G_OBJECT (range), "cf-format");
+  GtkLabel *readout = g_object_get_data (G_OBJECT (range), "cf-readout");
+  if (format && readout)
+    {
+      g_autofree char *text = format (number);
+      gtk_label_set_text (readout, text);
+    }
+}
