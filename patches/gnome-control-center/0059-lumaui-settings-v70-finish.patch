+static void live_users (View *v)
+{
+  const char *name = cc_luma_view_text (v, "myName");
+  gboolean admin = cc_luma_view_flag (v, "me.admin");
+  JsonArray *people = live_people (v);
+  guint n = people ? json_array_get_length (people) : 0;
+  g_autofree char *other = n == 1 ? first_name (json_object_get_string_member_with_default (json_array_get_object_element (people, 0), "name", "")) : NULL;
+  g_autofree char *meta = n == 0 ? g_strdup ("Just you") : n == 1 ? g_strdup_printf ("You and %s", other)
+                                                                  : g_strdup_printf ("You and %u others", n);
+  cf_header (v, "Users", meta, NULL);
+  cf_hero (v, identity (v, live_avatar (v, name, "me-picture", 64), "cf-id",
+                        id_words (name, admin ? "Administrator · signed in" : "Standard · signed in", NULL),
+                        hero_button (v, "Change picture", G_CALLBACK (live_users_panel), "cf-pic")), "cf-users-id");
+  GtkBox *g = cf_group (v, "Your account", NULL);
+  bt_lead (v, g, "key-round", "Password", NULL, "Change…", FALSE, G_CALLBACK (live_users_panel), "cf-pw");
+  if (cc_luma_view_flag (v, "me.local"))
+    cf_sw (v, g, "autoLogin", "Sign in automatically", "Anyone who turns on this computer gets in", lead ("lock-open"));
+  cf_vl (v, g, "Account type", admin ? "Administrator" : "Standard", admin ? "Can install apps and change anything" : NULL,
+         FALSE, NULL, lead ("user"));
+  g = cf_group (v, "Other people", NULL);
+  for (guint i = 0; i < n; i++)
+    {
+      JsonObject *o = json_array_get_object_element (people, i);
+      const char *user = json_object_get_string_member_with_default (o, "user", "");
+      const char *who = json_object_get_string_member_with_default (o, "name", user);
+      g_autofree char *asset = g_strconcat ("user:", user, NULL), *line = person_line (o);
+      g_autofree char *id = g_strconcat ("cf-go-user-", user, NULL);
+      GtkWidget *trail = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+      gtk_box_append (GTK_BOX (trail), cf_chevron ());
+      gtk_widget_add_css_class (trail, "only");
+      GtkWidget *row = cf_row (g, live_avatar (v, who, asset, 32), who, line, trail, TRUE);
+      gtk_widget_set_name (row, id);
+      g_object_set_data_full (G_OBJECT (row), "cf-user", g_strdup (user), g_free);
+      g_signal_connect_object (row, "clicked", G_CALLBACK (live_person_clicked), v->root, 0);
+    }
+  if (admin) add_row (v, g, "Add someone", G_CALLBACK (live_add_clicked), "cf-adduser");
+}
