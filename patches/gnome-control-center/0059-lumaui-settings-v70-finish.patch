+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live Online Accounts, read as panels/online-accounts reads them: the
+ * accounts goa-daemon reports (GoaClient) and the providers goabackend can
+ * add (goa_provider_get_all). The list is read-only here: opening an account,
+ * connecting one and removing one happen in GNOME's panel (the shell's
+ * delegation), which holds the sign-in flows. acct-fm and acct-nc (v70's two
+ * sample accounts) have no live counterpart and stay on the panel. */
+#include "cc-luma-live.h"
+#define GOA_API_IS_SUBJECT_TO_CHANGE
+#include <goa/goa.h>
+#define GOA_BACKEND_API_IS_SUBJECT_TO_CHANGE
+#include <goabackend/goabackend.h>
+
+#define ADAPTER "accounts"
+static const char * const pages[] = { "accounts", NULL };
+
+typedef struct {
+  CcLumaFixture *model;
+  GCancellable *cancel;
+  GoaClient *client;
+  gboolean providers, listing, ready;
+} Accounts;
+
+/* v70's Lucide glyph per provider kind (the page's own icons). */
+static const char *
+glyph_for (const char *type)
+{
+  static const struct { const char *type, *icon; } glyphs[] = {
+    { "google", "globe" }, { "ms_graph", "briefcase" }, { "exchange", "briefcase" }, { "owncloud", "cloud" },
+    { "imap_smtp", "mail" }, { "webdav", "server" }, { "kerberos", "key-round" }, { "fedora", "key-round" },
+  };
+  for (guint i = 0; type && i < G_N_ELEMENTS (glyphs); i++)
+    if (g_str_equal (type, glyphs[i].type)) return glyphs[i].icon;
+  return "user";
+}
+
+/* The services an account is used for, in v70's words and order. */
+static char *
+services_of (GoaObject *object, GoaAccount *account)
+{
+  g_autoptr (GPtrArray) on = g_ptr_array_new ();
+  if (goa_object_peek_mail (object) && !goa_account_get_mail_disabled (account)) g_ptr_array_add (on, "mail");
+  if (goa_object_peek_calendar (object) && !goa_account_get_calendar_disabled (account)) g_ptr_array_add (on, "calendar");
+  if (goa_object_peek_contacts (object) && !goa_account_get_contacts_disabled (account)) g_ptr_array_add (on, "contacts");
+  if (goa_object_peek_files (object) && !goa_account_get_files_disabled (account)) g_ptr_array_add (on, "files");
+  g_ptr_array_add (on, NULL);
+  g_autofree char *joined = g_strjoinv (", ", (char **) on->pdata);
+  if (*joined) joined[0] = g_ascii_toupper (joined[0]);
+  return g_steal_pointer (&joined);
+}
+
+/* Data tables are republished only when they change: a redraw closes an
+ * open picker. */
+static void
+publish_data_changed (CcLumaFixture *model, const char *name, JsonNode *node)
+{
+  JsonNode *before = json_object_get_member (cc_luma_fixture_get_data (model), name);
+  if (!before || !json_node_equal (before, node)) cc_luma_fixture_publish_data (model, name, node);
+}
+
+static void
+publish (Accounts *a)
+{
+  if (!a->client) return;
+  g_autoptr (JsonArray) list = json_array_new ();
+  GList *accounts = goa_client_get_accounts (a->client);
+  for (GList *l = accounts; l; l = l->next)
+    {
+      GoaAccount *account = goa_object_peek_account (l->data);
+      if (!account) continue;
+      JsonObject *o = json_object_new ();
+      g_autofree char *services = services_of (l->data, account);
+      json_object_set_string_member (o, "id", goa_account_get_id (account));
+      json_object_set_string_member (o, "provider", goa_account_get_provider_name (account));
+      json_object_set_string_member (o, "identity", goa_account_get_presentation_identity (account));
+      json_object_set_string_member (o, "services", services);
+      json_object_set_string_member (o, "icon", glyph_for (goa_account_get_provider_type (account)));
+      json_object_set_boolean_member (o, "attention", goa_account_get_attention_needed (account));
+      json_array_add_object_element (list, o);
+    }
+  g_list_free_full (accounts, g_object_unref);
+  g_autoptr (JsonNode) node = json_node_init_array (json_node_alloc (), list);
+  publish_data_changed (a->model, "LIVEACCTS", node);
+  if (!a->ready && a->providers)
+    {
+      a->ready = TRUE;
+      cc_luma_live_ready (a->model, ADAPTER);
+    }
+}
+
+static void
+providers_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Accounts *a = data;
+  g_autolist (GoaProvider) providers = NULL;
+  g_autoptr (GError) error = NULL;
+  /* goa_provider_get_all has no cancellable: the state lives until stop. */
+  a->listing = FALSE;
+  if (!a->model) { g_free (a); return; }
+  if (!goa_provider_get_all_finish (&providers, result, &error))
+    {
+      g_warning ("Settings: online account providers: %s", error->message);
+      return;
+    }
+  g_autoptr (JsonArray) list = json_array_new ();
+  for (GList *l = providers; l; l = l->next)
+    {
+      g_autofree char *name = goa_provider_get_provider_name (l->data, NULL);
+      JsonArray *pair = json_array_new ();
+      json_array_add_string_element (pair, name ? name : goa_provider_get_provider_type (l->data));
+      json_array_add_string_element (pair, glyph_for (goa_provider_get_provider_type (l->data)));
+      json_array_add_array_element (list, pair);
+    }
+  g_autoptr (JsonNode) node = json_node_init_array (json_node_alloc (), list);
+  cc_luma_fixture_publish_data (a->model, "LIVEPROVIDERS", node);
+  a->providers = TRUE;
+  publish (a);
+}
+
+static void
+client_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GoaClient *client = goa_client_new_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Accounts *a = data;
+  if (!client) { g_warning ("Settings: online accounts: %s", error->message); return; }
+  a->client = client;
+  g_signal_connect_swapped (client, "account-added", G_CALLBACK (publish), a);
+  g_signal_connect_swapped (client, "account-removed", G_CALLBACK (publish), a);
+  g_signal_connect_swapped (client, "account-changed", G_CALLBACK (publish), a);
+  a->listing = TRUE;
+  goa_provider_get_all (providers_done, a);
+}
+
+static gpointer
+accounts_start (CcLumaFixture *model)
+{
+  Accounts *a = g_new0 (Accounts, 1);
+  a->model = model;
+  a->cancel = g_cancellable_new ();
+  goa_client_new (a->cancel, client_ready, a);
+  return a;
+}
+
+static void
+accounts_stop (gpointer state)
+{
+  Accounts *a = state;
+  g_cancellable_cancel (a->cancel);
+  g_clear_object (&a->cancel);
+  if (a->client) g_signal_handlers_disconnect_by_data (a->client, a);
+  g_clear_object (&a->client);
+  /* A pending provider listing frees the state when it returns. */
+  a->model = NULL;
+  if (!a->listing) g_free (a);
+}
+
+const CcLumaAdapter cc_luma_adapter_accounts = { ADAPTER, pages, accounts_start, NULL, accounts_stop };
diff --git a/shell/cc-luma-live-admin.c b/shell/cc-luma-live-admin.c
new file mode 100644
index 0000000..8dbd624
--- /dev/null
+++ b/shell/cc-luma-live-admin.c
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-live-admin.h"
+#include <polkit/polkit.h>
+
+typedef struct {
+  char *action_id;
+  GCancellable *cancel;
+  CcLumaAdminFunc run, denied;
+  gpointer data;
+  GDestroyNotify free;
+} Admin;
+
+static void
+admin_free (Admin *a)
+{
+  if (a->free) a->free (a->data);
+  g_clear_object (&a->cancel);
+  g_free (a->action_id);
+  g_free (a);
+}
+
+static void
+finish (Admin *a, GPermission *permission, GError *error)
+{
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED) || (a->cancel && g_cancellable_is_cancelled (a->cancel)))
+    ;
+  else if (permission && g_permission_get_allowed (permission))
+    a->run (a->data);
+  else
+    {
+      g_message ("Settings live: %s not authorised%s%s", a->action_id, error ? ": " : "", error ? error->message : "");
+      if (a->denied) a->denied (a->data);
+    }
+  admin_free (a);
+}
+
+static void
+acquired (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_permission_acquire_finish (G_PERMISSION (source), result, &error);
+  finish (data, G_PERMISSION (source), error);
+  g_object_unref (source);
+}
+
+static void
+ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Admin *a = data;
+  g_autoptr (GError) error = NULL;
+  GPermission *permission = polkit_permission_new_finish (result, &error);
+  if (!permission || g_permission_get_allowed (permission))
+    {
+      finish (a, permission, error);
+      g_clear_object (&permission);
+      return;
+    }
+  g_permission_acquire_async (permission, a->cancel, acquired, a);
+}
+
+void
+cc_luma_live_as_admin (const char *action_id, GCancellable *cancel, CcLumaAdminFunc run,
+                       CcLumaAdminFunc denied, gpointer data, GDestroyNotify free)
+{
+  Admin *a = g_new0 (Admin, 1);
+  a->action_id = g_strdup (action_id);
+  a->cancel = cancel ? g_object_ref (cancel) : NULL;
+  a->run = run;
+  a->denied = denied;
+  a->data = data;
+  a->free = free;
+  polkit_permission_new (action_id, NULL, cancel, ready, a);
+}
diff --git a/shell/cc-luma-live-admin.h b/shell/cc-luma-live-admin.h
new file mode 100644
index 0000000..94577be
--- /dev/null
+++ b/shell/cc-luma-live-admin.h
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <gio/gio.h>
+
+G_BEGIN_DECLS
+/* An administrator change, as GNOME's panels unlock them: the panel's polkit
+ * action as a GPermission, acquired (the Shell asks for the password) before
+ * @run. @denied, if any, runs when the person cancels or isn't allowed.
+ * Neither runs if @cancel is cancelled. @free frees @data afterwards. */
+typedef void (*CcLumaAdminFunc) (gpointer data);
+void cc_luma_live_as_admin (const char *action_id, GCancellable *cancel, CcLumaAdminFunc run,
+                            CcLumaAdminFunc denied, gpointer data, GDestroyNotify free);
+G_END_DECLS
diff --git a/shell/cc-luma-live-airplane.c b/shell/cc-luma-live-airplane.c
new file mode 100644
index 0000000..49bafa9
--- /dev/null
+++ b/shell/cc-luma-live-airplane.c
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live airplane mode: gnome-settings-daemon's Rfkill interface, as
+ * panels/network/cc-wifi-panel.c reads and sets it. */
+#include "cc-luma-live.h"
+#include <gio/gio.h>
+
+#define ADAPTER "airplane"
+static const char * const pages[] = { "wifi", "wifi-net", "wifi-known", "hotspot", "network", NULL };
+
+typedef struct {
+  CcLumaFixture *model;
+  GDBusProxy *rfkill;
+  GCancellable *cancel;
+  gboolean ready;
+} Radio;
+
+static gboolean
+cached (Radio *r, const char *name, gboolean *value)
+{
+  g_autoptr (GVariant) v = r->rfkill ? g_dbus_proxy_get_cached_property (r->rfkill, name) : NULL;
+  if (!v || !g_variant_is_of_type (v, G_VARIANT_TYPE_BOOLEAN)) return FALSE;
+  *value = g_variant_get_boolean (v);
+  return TRUE;
+}
+static void
+publish (Radio *r)
+{
+  gboolean airplane = FALSE, radios = FALSE, show = FALSE;
+  /* cc-wifi-panel.c shows the row only when there are radios to turn off
+   * (and never without the daemon): otherwise the page leaves it out. */
+  if (cached (r, "AirplaneMode", &airplane) && cached (r, "HasAirplaneMode", &radios) && radios &&
+      cached (r, "ShouldShowAirplaneMode", &show) && show)
+    cc_luma_fixture_publish_boolean (r->model, "airplane", airplane);
+  else
+    cc_luma_fixture_unpublish (r->model, "airplane");
+  if (!r->ready) { r->ready = TRUE; cc_luma_live_ready (r->model, ADAPTER); }
+}
+static void
+proxy_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Radio *r = data;
+  r->rfkill = proxy;
+  if (proxy)
+    {
+      g_signal_connect_swapped (proxy, "g-properties-changed", G_CALLBACK (publish), r);
+      g_signal_connect_swapped (proxy, "notify::g-name-owner", G_CALLBACK (publish), r);
+    }
+  publish (r);
+}
+static void
+set_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) out = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  if (error) g_warning ("Settings: could not change airplane mode: %s", error->message);
+  publish (data);
+}
+static gboolean
+radio_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Radio *r = state;
+  gboolean hardware = FALSE;
+  if (!g_str_equal (key, "airplane")) return FALSE;
+  if (!r->rfkill || !JSON_NODE_HOLDS_VALUE (value) || json_node_get_value_type (value) != G_TYPE_BOOLEAN)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED, "Airplane mode isn’t available");
+      return FALSE;
+    }
+  gboolean radios = TRUE;
+  if (cached (r, "HasAirplaneMode", &radios) && !radios && json_node_get_boolean (value))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "This computer has no radios to turn off");
+      return FALSE;
+    }
+  if (cached (r, "HardwareAirplaneMode", &hardware) && hardware && !json_node_get_boolean (value))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "A hardware switch keeps airplane mode on");
+      return FALSE;
+    }
+  g_dbus_proxy_call (r->rfkill, "org.freedesktop.DBus.Properties.Set",
+                     g_variant_new_parsed ("('org.gnome.SettingsDaemon.Rfkill', 'AirplaneMode', %v)",
+                                           g_variant_new_boolean (json_node_get_boolean (value))),
+                     G_DBUS_CALL_FLAGS_NONE, -1, r->cancel, set_done, r);
+  return TRUE;
+}
+static gpointer
+radio_start (CcLumaFixture *model)
+{
+  Radio *r = g_new0 (Radio, 1);
+  r->model = model;
+  r->cancel = g_cancellable_new ();
+  cc_luma_fixture_own_key (model, "airplane");
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SESSION, G_DBUS_PROXY_FLAGS_NONE, NULL,
+                            "org.gnome.SettingsDaemon.Rfkill", "/org/gnome/SettingsDaemon/Rfkill",
+                            "org.gnome.SettingsDaemon.Rfkill", r->cancel, proxy_ready, r);
+  return r;
+}
+static void
+radio_stop (gpointer state)
+{
+  Radio *r = state;
+  g_cancellable_cancel (r->cancel);
+  g_clear_object (&r->cancel);
+  if (r->rfkill) g_signal_handlers_disconnect_by_data (r->rfkill, r);
+  g_clear_object (&r->rfkill);
+  g_free (r);
+}
+
+const CcLumaAdapter cc_luma_adapter_airplane = { ADAPTER, pages, radio_start, radio_write, radio_stop };
diff --git a/shell/cc-luma-live-app-options.c b/shell/cc-luma-live-app-options.c
new file mode 100644
index 0000000..eec2a7b
--- /dev/null
+++ b/shell/cc-luma-live-app-options.c
@@ -0,0 +1,244 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Default apps and Removable media, as panels/applications'
+ * cc-default-apps-row.c and cc-removable-media-settings.c do.
+ *   def.<k>    the default app for GNOME's content type, by its munged id;
+ *              CFDEFAPPS[def.<k>] = the default and the recommended apps
+ *              ([id, name]), the picker's choices. No default: no row.
+ *   neverMedia org.gnome.desktop.media-handling autorun-never
+ *   media.<k>  ask / folder / nothing from the autorun lists, or the
+ *              x-content type's default app's id when it starts one;
+ *              CFDEFAPPS[media.<k>] = the apps recommended for the type. */
+#include "cc-luma-live-gsettings.h"
+#include "cc-luma-live-apps.h"
+#include "cc-luma-application-options.h"
+#include <gio/gdesktopappinfo.h>
+#include <string.h>
+
+#define MEDIA "org.gnome.desktop.media-handling"
+
+/* cc-default-apps-page.blp */
+static const struct { const char *key, *type, *filters; } defaults[] = {
+  { "def.web", "x-scheme-handler/http", "text/html;application/xhtml+xml;x-scheme-handler/https" },
+  { "def.mail", "x-scheme-handler/mailto", NULL },
+  { "def.cal", "text/calendar", NULL },
+  { "def.music", "audio/x-vorbis+ogg", "audio/*" },
+  { "def.video", "video/x-ogm+ogg", "video/*" },
+  { "def.photo", "image/jpeg", "image/*" },
+};
+/* cc-removable-media-settings.c: the types v70's rows name. */
+static const struct { const char *key, *type; } media[] = {
+  { "media.audio", "x-content/audio-player" },
+  { "media.photos", "x-content/image-dcf" },
+  { "media.video", "x-content/video-dvd" },
+  { "media.software", "x-content/unix-software" },
+};
+
+static const CcLumaGsRow rows[] = {
+  { "neverMedia", MEDIA, "autorun-never", CC_LUMA_GS_BOOLEAN },
+};
+
+typedef struct {
+  CcLumaFixture *model;
+  CcLumaGsTable *table;
+  CcLumaReadyGate *gate;
+  GSettings *media;
+  GAppInfoMonitor *monitor;
+  GHashTable *infos; /* munged id → GAppInfo */
+} Options;
+
+static char *
+munge (GAppInfo *info)
+{
+  const char *desktop_id = g_app_info_get_id (info);
+  if (!desktop_id || !g_str_has_suffix (desktop_id, ".desktop")) return NULL;
+  char *id = g_strndup (desktop_id, strlen (desktop_id) - strlen (".desktop"));
+  g_strcanon (id, "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-", '-');
+  for (guint i = 0; id[i]; i++) id[i] = g_ascii_tolower (id[i]);
+  return id;
+}
+
+/* [id, name] for the default (first) and the recommended apps. */
+static JsonArray *
+choices_for (Options *self, const char *type, char **default_id)
+{
+  g_autoptr (GAppInfo) chosen = g_app_info_get_default_for_type (type, FALSE);
+  g_autolist (GAppInfo) recommended = g_app_info_get_recommended_for_type (type);
+  JsonArray *list = json_array_new ();
+  g_autoptr (GHashTable) seen = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  GList *all = g_list_prepend (g_list_copy (recommended), chosen);
+  for (GList *l = all; l; l = l->next)
+    {
+      GAppInfo *info = l->data;
+      g_autofree char *id = info ? munge (info) : NULL;
+      if (!id || g_hash_table_contains (seen, id) || !cc_luma_live_publish_app (self->model, id, info)) continue;
+      if (info == chosen && default_id) *default_id = g_strdup (id);
+      g_hash_table_insert (self->infos, g_strdup (id), g_object_ref (info));
+      JsonArray *pair = json_array_new ();
+      json_array_add_string_element (pair, id);
+      json_array_add_string_element (pair, g_app_info_get_display_name (info));
+      json_array_add_array_element (list, pair);
+      g_hash_table_add (seen, g_steal_pointer (&id));
+    }
+  g_list_free (all);
+  return list;
+}
+
+static void
+publish (Options *self)
+{
+  g_autoptr (JsonObject) choices = json_object_new ();
+  g_autoptr (JsonNode) none = json_node_init_null (json_node_alloc ());
+  for (guint i = 0; i < G_N_ELEMENTS (defaults); i++)
+    {
+      g_autofree char *current = NULL;
+      json_object_set_array_member (choices, defaults[i].key, choices_for (self, defaults[i].type, &current));
+      if (current) cc_luma_fixture_publish_string (self->model, defaults[i].key, current);
+      else if (cc_luma_fixture_get (self->model, defaults[i].key)) cc_luma_fixture_publish (self->model, defaults[i].key, none);
+    }
+  if (self->media)
+    {
+      g_auto (GStrv) start = g_settings_get_strv (self->media, "autorun-x-content-start-app");
+      g_auto (GStrv) ignore = g_settings_get_strv (self->media, "autorun-x-content-ignore");
+      g_auto (GStrv) folder = g_settings_get_strv (self->media, "autorun-x-content-open-folder");
+      for (guint i = 0; i < G_N_ELEMENTS (media); i++)
+        {
+          g_autofree char *app = NULL;
+          json_object_set_array_member (choices, media[i].key, choices_for (self, media[i].type, &app));
+          /* autorun_get_preferences: start-app, then ignore, then open folder. */
+          const char *value = g_strv_contains ((const char * const *) start, media[i].type) ? app :
+                              g_strv_contains ((const char * const *) ignore, media[i].type) ? "nothing" :
+                              g_strv_contains ((const char * const *) folder, media[i].type) ? "folder" : "ask";
+          if (value) cc_luma_fixture_publish_string (self->model, media[i].key, value);
+          else cc_luma_fixture_publish (self->model, media[i].key, none);
+        }
+    }
+  g_autoptr (JsonNode) node = json_node_init_object (json_node_alloc (), choices);
+  JsonNode *before = json_object_get_member (cc_luma_fixture_get_data (self->model), "CFDEFAPPS");
+  if (!before || !json_node_equal (before, node)) cc_luma_fixture_publish_data (self->model, "CFDEFAPPS", node);
+}
+
+static gpointer
+options_start (CcLumaFixture *model)
+{
+  Options *self = g_new0 (Options, 1);
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = source ? g_settings_schema_source_lookup (source, MEDIA, TRUE) : NULL;
+  self->model = g_object_ref (model);
+  self->infos = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_object_unref);
+  self->table = cc_luma_gs_table_new (model, rows, G_N_ELEMENTS (rows));
+  if (schema && g_settings_schema_has_key (schema, "autorun-x-content-start-app") &&
+      g_settings_schema_has_key (schema, "autorun-x-content-ignore") && g_settings_schema_has_key (schema, "autorun-x-content-open-folder"))
+    {
+      self->media = g_settings_new (MEDIA);
+      g_signal_connect_swapped (self->media, "changed", G_CALLBACK (publish), self);
+    }
+  for (guint i = 0; i < G_N_ELEMENTS (defaults); i++) cc_luma_fixture_own_key (model, defaults[i].key);
+  for (guint i = 0; self->media && i < G_N_ELEMENTS (media); i++) cc_luma_fixture_own_key (model, media[i].key);
+  self->monitor = g_app_info_monitor_get ();
+  g_signal_connect_swapped (self->monitor, "changed", G_CALLBACK (publish), self);
+  cc_luma_live_desk_dump_watch (model);
+  publish (self);
+  self->gate = cc_luma_ready_gate_new (model, "appoptions", cc_luma_application_options_validate);
+  return self;
+}
+
+/* cc-default-apps-row.c update_default_app: the type, then every type the
+ * app supports that the row's filters match. */
+static gboolean
+set_default (GAppInfo *info, const char *type, const char *filters, GError **error)
+{
+  if (!g_app_info_set_as_default_for_type (info, type, error)) return FALSE;
+  if (!filters) return TRUE;
+  g_auto (GStrv) entries = g_strsplit (filters, ";", -1);
+  const char * const *types = g_app_info_get_supported_types (info);
+  for (guint i = 0; types && types[i]; i++)
+    for (guint j = 0; entries[j]; j++)
+      if (g_pattern_match_simple (entries[j], types[i]))
+        {
+          g_autoptr (GError) ignored = NULL;
+          if (!g_app_info_set_as_default_for_type (info, types[i], &ignored))
+            g_warning ("Settings live: %s isn't the default for %s: %s", g_app_info_get_name (info), types[i], ignored->message);
+          break;
+        }
+  return TRUE;
+}
+
+/* cc-removable-media-settings.c autorun_set_preferences */
+static gboolean
+set_lists (Options *self, const char *type, gboolean start, gboolean ignore, gboolean folder, GError **error)
+{
+  const struct { const char *key; gboolean on; } lists[] = {
+    { "autorun-x-content-start-app", start }, { "autorun-x-content-ignore", ignore }, { "autorun-x-content-open-folder", folder },
+  };
+  for (guint i = 0; i < G_N_ELEMENTS (lists); i++)
+    if (!g_settings_is_writable (self->media, lists[i].key))
+      {
+        g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Removable media settings are locked by policy");
+        return FALSE;
+      }
+  /* The three lists change together, on a transaction of their own. */
+  g_autoptr (GSettings) edit = g_settings_new (MEDIA);
+  g_settings_delay (edit);
+  for (guint i = 0; i < G_N_ELEMENTS (lists); i++)
+    {
+      g_auto (GStrv) current = g_settings_get_strv (self->media, lists[i].key);
+      g_autoptr (GPtrArray) next = g_ptr_array_new_with_free_func (g_free);
+      for (guint k = 0; current[k]; k++) if (!g_str_equal (current[k], type)) g_ptr_array_add (next, g_strdup (current[k]));
+      if (lists[i].on) g_ptr_array_add (next, g_strdup (type));
+      g_ptr_array_add (next, NULL);
+      g_settings_set_strv (edit, lists[i].key, (const char * const *) next->pdata);
+    }
+  g_settings_apply (edit);
+  return TRUE;
+}
+
+static gboolean
+options_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Options *self = state;
+  if (cc_luma_gs_table_covers (self->table, key)) return cc_luma_gs_table_write (self->table, key, value, error);
+  const char *text = JSON_NODE_HOLDS_VALUE (value) && json_node_get_value_type (value) == G_TYPE_STRING ? json_node_get_string (value) : NULL;
+  for (guint i = 0; i < G_N_ELEMENTS (defaults); i++)
+    if (g_str_equal (key, defaults[i].key))
+      {
+        GAppInfo *info = text ? g_hash_table_lookup (self->infos, text) : NULL;
+        if (!info) goto invalid;
+        return set_default (info, defaults[i].type, defaults[i].filters, error);
+      }
+  for (guint i = 0; self->media && i < G_N_ELEMENTS (media); i++)
+    if (g_str_equal (key, media[i].key))
+      {
+        if (!text) goto invalid;
+        if (g_str_equal (text, "ask")) return set_lists (self, media[i].type, FALSE, FALSE, FALSE, error);
+        if (g_str_equal (text, "nothing")) return set_lists (self, media[i].type, FALSE, TRUE, FALSE, error);
+        if (g_str_equal (text, "folder")) return set_lists (self, media[i].type, FALSE, FALSE, TRUE, error);
+        GAppInfo *info = g_hash_table_lookup (self->infos, text);
+        if (!info) goto invalid;
+        /* on_chooser_changed_cb: start the app, and make it the type's default. */
+        if (!set_lists (self, media[i].type, TRUE, FALSE, FALSE, error)) return FALSE;
+        return g_app_info_set_as_default_for_type (info, media[i].type, error);
+      }
+  return FALSE;
+invalid:
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "%s can’t take that value", key);
+  return FALSE;
+}
+
+static void
+options_stop (gpointer state)
+{
+  Options *self = state;
+  cc_luma_ready_gate_free (self->gate);
+  cc_luma_gs_table_free (self->table);
+  if (self->media) g_signal_handlers_disconnect_by_data (self->media, self);
+  if (self->monitor) g_signal_handlers_disconnect_by_data (self->monitor, self);
+  g_clear_object (&self->media);
+  g_clear_object (&self->monitor);
+  g_hash_table_unref (self->infos);
+  g_object_unref (self->model);
+  g_free (self);
+}
+
+const CcLumaAdapter cc_luma_adapter_appoptions = {
+  "appoptions", (const char * const[]) { "defaults", "media", NULL }, options_start, options_write, options_stop
+};
diff --git a/shell/cc-luma-live-appearance.c b/shell/cc-luma-live-appearance.c
new file mode 100644
index 0000000..8a2a512
--- /dev/null
+++ b/shell/cc-luma-live-appearance.c
@@ -0,0 +1,233 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Appearance: the wallpapers of GNOME's background list (CcBackgroundXml,
+ * as the background panel's chooser loads it) and the current picture from
+ * org.gnome.desktop.background; the mode through Luma's surface policy and
+ * color-scheme, as panels/background/cc-background-panel.c does. The accent
+ * is a GSettings row. Luma has no schema for "tint windows": that row has no
+ * owner, so it is never published. */
+#define GNOME_DESKTOP_USE_UNSTABLE_API
+#include "cc-luma-live-gsettings.h"
+#include "cc-luma-desktop.h"
+#include "panels/background/cc-background-item.h"
+#include "panels/background/cc-background-xml.h"
+#include <luma-appearance.h>
+#include <string.h>
+
+#define WP_SCHEMA "org.gnome.desktop.background"
+#define WP_LOCK_SCHEMA "org.gnome.desktop.screensaver"
+
+typedef struct {
+  CcLumaFixture *model;
+  CcBackgroundXml *xml;
+  GPtrArray *items;        /* CcBackgroundItem, list order */
+  GSettings *background, *lock, *interface;
+  LumaSurfacePolicy *policy;
+  GCancellable *cancel;
+  guint idle;
+  CcLumaReadyGate *gate;
+} Appearance;
+
+/* A wallpaper's id is its file's name without the extension: the ids the
+ * pages know Luma's own wallpapers by. */
+static char *
+item_id (CcBackgroundItem *item)
+{
+  const char *uri = cc_background_item_get_uri (item);
+  g_autoptr (GFile) file = uri ? g_file_new_for_uri (uri) : NULL;
+  g_autofree char *base = file ? g_file_get_basename (file) : NULL;
+  char *dot = base ? strrchr (base, '.') : NULL;
+  if (dot) *dot = '\0';
+  return base && *base ? g_steal_pointer (&base) : NULL;
+}
+
+static CcBackgroundItem *
+item_for (Appearance *self, const char *id)
+{
+  for (guint i = 0; id && i < self->items->len; i++)
+    {
+      g_autofree char *candidate = item_id (self->items->pdata[i]);
+      if (g_strcmp0 (candidate, id) == 0) return self->items->pdata[i];
+    }
+  return NULL;
+}
+
+static gboolean
+publish (gpointer data)
+{
+  Appearance *self = data;
+  self->idle = 0;
+  JsonArray *walls = json_array_new ();
+  g_autoptr (GHashTable) seen = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  for (guint i = 0; i < self->items->len; i++)
+    {
+      CcBackgroundItem *item = self->items->pdata[i];
+      g_autofree char *id = item_id (item);
+      const char *name = cc_background_item_get_name (item);
+      if (!id || !name || !*name || g_hash_table_contains (seen, id)) continue;
+      g_autoptr (GFile) file = g_file_new_for_uri (cc_background_item_get_uri (item));
+      g_autofree char *path = g_file_get_path (file);
+      cc_luma_fixture_publish_asset (self->model, id, path);
+      JsonArray *pair = json_array_new ();
+      json_array_add_string_element (pair, id);
+      json_array_add_string_element (pair, name);
+      json_array_add_array_element (walls, pair);
+      g_hash_table_add (seen, g_steal_pointer (&id));
+    }
+  g_autoptr (JsonNode) list = json_node_init_array (json_node_alloc (), walls);
+  json_array_unref (walls);
+  cc_luma_fixture_publish_data (self->model, "CFWALL", list);
+
+  g_autofree char *uri = g_settings_get_string (self->background, "picture-uri");
+  const char *wall = NULL;
+  g_autofree char *id = NULL;
+  for (guint i = 0; i < self->items->len && !wall; i++)
+    if (g_strcmp0 (cc_background_item_get_uri (self->items->pdata[i]), uri) == 0)
+      wall = id = item_id (self->items->pdata[i]);
+  if (wall) cc_luma_fixture_publish_string (self->model, "wall", wall);
+  else { g_autoptr (JsonNode) none = json_node_init_null (json_node_alloc ()); cc_luma_fixture_publish (self->model, "wall", none); }
+
+  if (self->policy)
+    cc_luma_fixture_publish_string (self->model, "mode", luma_surface_policy_get_requested (self->policy));
+  return G_SOURCE_REMOVE;
+}
+
+static void
+schedule (Appearance *self)
+{
+  if (!self->idle) self->idle = g_idle_add (publish, self);
+}
+
+static void
+item_added (CcBackgroundXml *xml, CcBackgroundItem *item, Appearance *self)
+{
+  if (!cc_background_item_get_uri (item)) return;
+  g_ptr_array_add (self->items, g_object_ref (item));
+  schedule (self);
+}
+
+static void
+list_loaded (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  if (!cc_background_xml_load_list_finish (CC_BACKGROUND_XML (source), result, &error))
+    {
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) g_warning ("Wallpapers: %s", error->message);
+      return;
+    }
+  schedule (data);
+}
+
+static void settings_changed (GSettings *settings, const char *key, Appearance *self) { schedule (self); }
+static void policy_changed (LumaSurfacePolicy *policy, Appearance *self) { schedule (self); }
+
+static gboolean
+schema_has (const char *id, const char *key)
+{
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = source ? g_settings_schema_source_lookup (source, id, TRUE) : NULL;
+  return schema && g_settings_schema_has_key (schema, key);
+}
+
+static gpointer
+appearance_start (CcLumaFixture *model)
+{
+  Appearance *self = g_new0 (Appearance, 1);
+  self->model = g_object_ref (model);
+  self->cancel = g_cancellable_new ();
+  self->items = g_ptr_array_new_with_free_func (g_object_unref);
+  self->background = g_settings_new (WP_SCHEMA);
+  self->lock = g_settings_new (WP_LOCK_SCHEMA);
+  self->interface = g_settings_new ("org.gnome.desktop.interface");
+  g_settings_delay (self->background);
+  g_settings_delay (self->lock);
+  g_signal_connect (self->background, "changed", G_CALLBACK (settings_changed), self);
+  if (schema_has ("org.project_luma.shell-state", "surface-treatment"))
+    {
+      self->policy = luma_surface_policy_new (LUMA_SURFACE_TARGET_APPLICATION);
+      g_signal_connect (self->policy, "changed", G_CALLBACK (policy_changed), self);
+      cc_luma_fixture_own_key (model, "mode");
+    }
+  cc_luma_fixture_own_key (model, "wall");
+  self->xml = cc_background_xml_new ();
+  g_signal_connect (self->xml, "added", G_CALLBACK (item_added), self);
+  cc_background_xml_load_list_async (self->xml, self->cancel, list_loaded, self);
+  self->gate = cc_luma_ready_gate_new (model, "appearance", cc_luma_appearance_validate);
+  return self;
+}
+
+/* panels/background/cc-background-panel.c set_background, without the
+ * dconf clean-up of defaults. */
+static void
+set_background (GSettings *settings, CcBackgroundItem *item, gboolean set_dark)
+{
+  const char *uri = cc_background_item_get_uri (item);
+  CcBackgroundItemFlags flags = cc_background_item_get_flags (item);
+  g_settings_set_string (settings, "picture-uri", uri);
+  if (set_dark)
+    {
+      const char *dark = cc_background_item_get_uri_dark (item);
+      g_settings_set_string (settings, "picture-uri-dark", dark && *dark ? dark : uri);
+    }
+  if (flags & CC_BACKGROUND_ITEM_HAS_PLACEMENT)
+    g_settings_set_enum (settings, "picture-options", cc_background_item_get_placement (item));
+  else if (uri && g_settings_get_enum (settings, "picture-options") == G_DESKTOP_BACKGROUND_STYLE_NONE)
+    g_settings_set_enum (settings, "picture-options", cc_background_item_get_placement (item));
+  if (flags & CC_BACKGROUND_ITEM_HAS_SHADING)
+    g_settings_set_enum (settings, "color-shading-type", cc_background_item_get_shading (item));
+  g_settings_set_string (settings, "primary-color", cc_background_item_get_pcolor (item));
+  g_settings_set_string (settings, "secondary-color", cc_background_item_get_scolor (item));
+  g_settings_apply (settings);
+}
+
+static gboolean
+appearance_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Appearance *self = state;
+  const char *text = value && JSON_NODE_HOLDS_VALUE (value) && json_node_get_value_type (value) == G_TYPE_STRING ? json_node_get_string (value) : NULL;
+  if (g_str_equal (key, "wall"))
+    {
+      CcBackgroundItem *item = item_for (self, text);
+      if (!item)
+        {
+          g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "That wallpaper isn’t installed");
+          return FALSE;
+        }
+      set_background (self->background, item, TRUE);
+      set_background (self->lock, item, FALSE);
+      return TRUE;
+    }
+  if (g_str_equal (key, "mode") && self->policy)
+    {
+      /* on_color_scheme_toggle_active_cb: the treatment, then color-scheme. */
+      if (!luma_surface_policy_select (self->policy, text, error)) return FALSE;
+      g_settings_set_enum (self->interface, "color-scheme",
+                           g_strcmp0 (text, "dark") == 0 ? G_DESKTOP_COLOR_SCHEME_PREFER_DARK : G_DESKTOP_COLOR_SCHEME_DEFAULT);
+      return TRUE;
+    }
+  return FALSE;
+}
+
+static void
+appearance_stop (gpointer state)
+{
+  Appearance *self = state;
+  g_cancellable_cancel (self->cancel);
+  if (self->idle) g_source_remove (self->idle);
+  cc_luma_ready_gate_free (self->gate);
+  g_signal_handlers_disconnect_by_data (self->xml, self);
+  g_signal_handlers_disconnect_by_data (self->background, self);
+  if (self->policy) g_signal_handlers_disconnect_by_data (self->policy, self);
+  g_clear_object (&self->policy);
+  g_object_unref (self->xml);
+  g_object_unref (self->background);
+  g_object_unref (self->lock);
+  g_object_unref (self->interface);
+  g_ptr_array_unref (self->items);
+  g_object_unref (self->cancel);
+  g_object_unref (self->model);
+  g_free (self);
+}
+
+const CcLumaAdapter cc_luma_adapter_appearance = {
+  "appearance", (const char * const[]) { "appearance", NULL }, appearance_start, appearance_write, appearance_stop
+};
diff --git a/shell/cc-luma-live-applications.c b/shell/cc-luma-live-applications.c
new file mode 100644
index 0000000..620a898
--- /dev/null
+++ b/shell/cc-luma-live-applications.c
@@ -0,0 +1,549 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Apps and each app's page: the owners GNOME's Apps panel reads
+ * (panels/applications/cc-applications-panel.c).
+ *   CFAPPS, CFAPPINFO, CFAPPCATS  the apps GAppInfo shows, by their munged id
+ *                                 (the notification children's ids), with the
+ *                                 desktop Categories v70's pills name
+ *   CFSZ[id]   app, data and cache in MB, only for a Flatpak app (flatpak
+ *              info -s and ~/.var/app/<id>/{data,cache}, as the panel)
+ *   CFPERMS[id] + perm_<id><p>  the permissions the panel shows for the app:
+ *     notif  org.gnome.desktop.notifications.application enable
+ *     search its GNOME Shell search provider, when it has one
+ *     bg     portal "background" (Flatpak/Snap apps)
+ *     wall, shot, cam, mic, loc  portal wallpaper, screenshot, devices and
+ *            location entries, when the store has one for the app
+ * Version, source, launch, clearing the cache and uninstalling have no owner
+ * here; the page leaves those out or hands them to GNOME's panel. */
+#include "cc-luma-live.h"
+#include "cc-luma-live-apps.h"
+#include <gio/gdesktopappinfo.h>
+#include <string.h>
+
+#define NOTIF_SCHEMA "org.gnome.desktop.notifications.application"
+#define NOTIF_PREFIX "/org/gnome/desktop/notifications/application/"
+#define STORE_NAME "org.freedesktop.impl.portal.PermissionStore"
+#define STORE_PATH "/org/freedesktop/impl/portal/PermissionStore"
+#define SNAP_PREFIX "snap."
+
+typedef struct {
+  char *id;          /* munged: the notification child's id */
+  char *desktop_id;
+  char *portal_id;   /* Flatpak id or snap.<name>, else NULL */
+  char *category;
+  gboolean provider, provider_default_on;
+  gint64 sizes[3];   /* MB; -1 unknown */
+  GAppInfo *info;
+} App;
+
+/* Portal tables the page shows, in GNOME's order after notif and search. */
+static const struct { const char *perm, *table, *entry, *off; gboolean always; } portal[] = {
+  { "bg", "background", "background", "no", TRUE },
+  { "wall", "wallpaper", "wallpaper", "no", FALSE },
+  { "shot", "screenshot", "screenshot", "no", FALSE },
+  { "cam", "devices", "camera", "no", FALSE },
+  { "mic", "devices", "microphone", "no", FALSE },
+  { "loc", "location", "location", "NONE", FALSE },
+};
+
+typedef struct {
+  CcLumaFixture *model;
+  GCancellable *cancel;
+  GPtrArray *apps;           /* App, NULL until read */
+  GHashTable *by_id;         /* id → App */
+  GHashTable *notif;         /* id → GSettings */
+  GHashTable *tables;        /* "table/entry" → GVariant a{sas} */
+  GSettings *search;
+  GDBusConnection *bus;
+  guint store_signal;
+  GAppInfoMonitor *monitor;
+  guint pending, rescan;
+  gboolean reported, reading, stopped;
+} Apps;
+
+static void
+app_free (App *a)
+{
+  g_free (a->id); g_free (a->desktop_id); g_free (a->portal_id); g_free (a->category);
+  g_clear_object (&a->info);
+  g_free (a);
+}
+
+static char *
+munge (const char *desktop_id)
+{
+  if (!desktop_id || !g_str_has_suffix (desktop_id, ".desktop")) return NULL;
+  char *id = g_strndup (desktop_id, strlen (desktop_id) - strlen (".desktop"));
+  g_strcanon (id, "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-", '-');
+  for (guint i = 0; id[i]; i++) id[i] = g_ascii_tolower (id[i]);
+  return id;
+}
+
+/* v70's pills from the desktop file's own Categories. */
+static const char *
+category_of (GDesktopAppInfo *info)
+{
+  const char *categories = g_desktop_app_info_get_categories (info);
+  if (!categories) return NULL;
+  g_auto (GStrv) split = g_strsplit (categories, ";", -1);
+  const struct { const char *category, *pill; } map[] = {
+    { "Game", "play" }, { "Graphics", "create" }, { "AudioVideo", "media" }, { "Audio", "media" }, { "Video", "media" },
+    { "Office", "work" }, { "Development", "tools" }, { "Utility", "tools" }, { "System", "tools" },
+  };
+  for (guint i = 0; i < G_N_ELEMENTS (map); i++)
+    if (g_strv_contains ((const char * const *) split, map[i].category)) return map[i].pill;
+  return NULL;
+}
+
+/* ── Reading (worker thread) ───────────────────────────────────────── */
+static gint64
+tree_bytes (GFile *dir, GCancellable *cancel)
+{
+  guint64 disk = 0;
+  if (!g_file_query_exists (dir, NULL)) return 0;
+  if (!g_file_measure_disk_usage (dir, G_FILE_MEASURE_APPARENT_SIZE, cancel, NULL, NULL, &disk, NULL, NULL, NULL)) return -1;
+  return (gint64) disk;
+}
+
+/* panels/applications utils.c get_flatpak_app_size */
+static gint64
+flatpak_bytes (const char *app_id)
+{
+  const char *argv[] = { "flatpak", "info", "-s", app_id, NULL };
+  g_autofree char *out = NULL;
+  gint status = 0;
+  if (!g_spawn_sync (NULL, (char **) argv, NULL, G_SPAWN_SEARCH_PATH | G_SPAWN_STDERR_TO_DEV_NULL, NULL, NULL, &out, NULL, &status, NULL) ||
+      !g_spawn_check_wait_status (status, NULL) || !out) return -1;
+  g_strstrip (out);
+  const struct { const char *suffix; double factor; } units[] = {
+    { "kB", 1e3 }, { "kb", 1e3 }, { "MB", 1e6 }, { "Mb", 1e6 }, { "GB", 1e9 }, { "Gb", 1e9 },
+    { "KiB", 1024 }, { "Kib", 1024 }, { "MiB", 1048576 }, { "Mib", 1048576 }, { "GiB", 1073741824 }, { "Gib", 1073741824 },
+  };
+  double factor = 1;
+  for (guint i = 0; i < G_N_ELEMENTS (units); i++) if (g_str_has_suffix (out, units[i].suffix)) factor = units[i].factor;
+  double value = g_ascii_strtod (out, NULL);
+  return value > 0 ? (gint64) (value * factor) : -1;
+}
+
+static gint64
+megabytes (gint64 bytes)
+{
+  return bytes < 0 ? -1 : (bytes + 999999) / 1000000;
+}
+
+static void
+read_thread (GTask *task, gpointer source, gpointer data, GCancellable *cancel)
+{
+  GPtrArray *apps = g_ptr_array_new_with_free_func ((GDestroyNotify) app_free);
+  g_autoptr (GHashTable) providers = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  for (const char * const *dir = g_get_system_data_dirs (); *dir; dir++)
+    {
+      g_autofree char *path = g_build_filename (*dir, "gnome-shell", "search-providers", NULL);
+      g_autoptr (GDir) listing = g_dir_open (path, 0, NULL);
+      const char *name;
+      while (listing && (name = g_dir_read_name (listing)))
+        {
+          g_autofree char *file = g_build_filename (path, name, NULL);
+          g_autoptr (GKeyFile) keys = g_key_file_new ();
+          if (!g_key_file_load_from_file (keys, file, G_KEY_FILE_NONE, NULL)) continue;
+          g_autofree char *id = g_key_file_get_string (keys, "Shell Search Provider", "DesktopId", NULL);
+          if (id && !g_hash_table_contains (providers, id))
+            g_hash_table_insert (providers, g_steal_pointer (&id),
+                                 GINT_TO_POINTER (g_key_file_get_boolean (keys, "Shell Search Provider", "DefaultDisabled", NULL) ? 2 : 1));
+        }
+    }
+  g_autolist (GAppInfo) all = g_app_info_get_all ();
+  g_autoptr (GHashTable) seen = g_hash_table_new (g_str_hash, g_str_equal);
+  for (GList *l = all; l && !g_cancellable_is_cancelled (cancel); l = l->next)
+    {
+      GAppInfo *info = l->data;
+      if (!G_IS_DESKTOP_APP_INFO (info) || !g_app_info_should_show (info)) continue;
+      g_autofree char *id = munge (g_app_info_get_id (info));
+      /* The page ids the model can name (a leading digit can't be one). */
+      if (!id || !g_regex_match_simple ("^[a-z][a-z0-9-]*$", id, 0, 0) || g_hash_table_contains (seen, id)) continue;
+      App *a = g_new0 (App, 1);
+      a->id = g_steal_pointer (&id);
+      g_hash_table_add (seen, a->id);
+      a->desktop_id = g_strdup (g_app_info_get_id (info));
+      a->info = g_object_ref (info);
+      a->category = g_strdup (category_of (G_DESKTOP_APP_INFO (info)));
+      gpointer provider = g_hash_table_lookup (providers, a->desktop_id);
+      a->provider = provider != NULL;
+      a->provider_default_on = GPOINTER_TO_INT (provider) == 1;
+      g_autofree char *flatpak = g_desktop_app_info_get_string (G_DESKTOP_APP_INFO (info), "X-Flatpak");
+      g_autofree char *snap = g_desktop_app_info_get_string (G_DESKTOP_APP_INFO (info), "X-SnapInstanceName");
+      a->portal_id = flatpak ? g_strdup (flatpak) : snap ? g_strconcat (SNAP_PREFIX, snap, NULL) : NULL;
+      a->sizes[0] = a->sizes[1] = a->sizes[2] = -1;
+      if (flatpak)
+        {
+          g_autofree char *base = g_build_filename (g_get_home_dir (), ".var", "app", flatpak, NULL);
+          g_autoptr (GFile) data_dir = g_file_new_build_filename (base, "data", NULL);
+          g_autoptr (GFile) cache_dir = g_file_new_build_filename (base, "cache", NULL);
+          a->sizes[0] = megabytes (flatpak_bytes (flatpak));
+          a->sizes[1] = megabytes (tree_bytes (data_dir, cancel));
+          a->sizes[2] = megabytes (tree_bytes (cache_dir, cancel));
+        }
+      g_ptr_array_add (apps, a);
+    }
+  if (g_task_return_error_if_cancelled (task)) { g_ptr_array_unref (apps); return; }
+  g_task_return_pointer (task, apps, (GDestroyNotify) g_ptr_array_unref);
+}
+
+/* ── Publishing ────────────────────────────────────────────────────── */
+static GVariant *
+table_value (Apps *self, const char *table, const char *entry)
+{
+  g_autofree char *name = g_strconcat (table, "/", entry, NULL);
+  return g_hash_table_lookup (self->tables, name);
+}
+
+/* The app's entry in a portal table: NULL when the store has none. */
+static char **
+portal_permission (Apps *self, guint p, const char *portal_id)
+{
+  GVariant *apps = table_value (self, portal[p].table, portal[p].entry);
+  char **value = NULL;
+  if (!apps || !portal_id) return NULL;
+  if (g_variant_lookup (apps, portal_id, "^as", &value)) return value;
+  return NULL;
+}
+
+static gboolean
+search_on (Apps *self, App *a)
+{
+  g_auto (GStrv) enabled = g_settings_get_strv (self->search, "enabled");
+  g_auto (GStrv) disabled = g_settings_get_strv (self->search, "disabled");
+  if (g_strv_contains ((const char * const *) enabled, a->desktop_id)) return TRUE;
+  if (g_strv_contains ((const char * const *) disabled, a->desktop_id)) return FALSE;
+  return a->provider_default_on;
+}
+
+static void
+publish (Apps *self)
+{
+  if (!self->apps || self->pending) return;
+  JsonObject *data = cc_luma_fixture_get_data (self->model);
+  g_autoptr (JsonArray) list = json_array_new ();
+  g_autoptr (JsonObject) cats = json_object_new ();
+  g_autoptr (JsonObject) sizes = json_object_new ();
+  g_autoptr (JsonObject) perms = json_object_new ();
+  gboolean search_off = self->search && g_settings_get_boolean (self->search, "disable-external");
+  gint64 t0 = g_get_monotonic_time ();
+  cc_luma_live_apps_batch_begin (self->model);
+  for (guint i = 0; i < self->apps->len; i++)
+    {
+      App *a = self->apps->pdata[i];
+      if (!cc_luma_live_publish_app (self->model, a->id, a->info)) continue;
+      JsonArray *allowed = json_array_new ();
+      /* Keys first: the page never draws a permission it can't read. */
+      GSettings *child = g_hash_table_lookup (self->notif, a->id);
+      if (!child)
+        {
+          g_autofree char *path = g_strconcat (NOTIF_PREFIX, a->id, "/", NULL);
+          child = g_settings_new_with_path (NOTIF_SCHEMA, path);
+          g_signal_connect_swapped (child, "changed::enable", G_CALLBACK (publish), self);
+          g_hash_table_insert (self->notif, g_strdup (a->id), child);
+        }
+      g_autofree char *notif = g_strconcat ("perm_", a->id, "notif", NULL);
+      cc_luma_fixture_own_key (self->model, notif);
+      /* Proven in the VM (run 20260929T064332-live-apps): an app's
+       * notification and search switches land and survive reopening. The
+       * keys are per app, so the proof covers each app's key here. */
+      cc_luma_fixture_verify_key (self->model, notif);
+      cc_luma_fixture_publish_boolean (self->model, notif, g_settings_get_boolean (child, "enable"));
+      json_array_add_string_element (allowed, "notif");
+      if (a->provider && self->search && !search_off)
+        {
+          g_autofree char *key = g_strconcat ("perm_", a->id, "search", NULL);
+          cc_luma_fixture_own_key (self->model, key);
+          cc_luma_fixture_verify_key (self->model, key);
+          cc_luma_fixture_publish_boolean (self->model, key, search_on (self, a));
+          json_array_add_string_element (allowed, "search");
+        }
+      for (guint p = 0; a->portal_id && p < G_N_ELEMENTS (portal); p++)
+        {
+          g_auto (GStrv) value = portal_permission (self, p, a->portal_id);
+          if (!value && !portal[p].always) continue;
+          if (!table_value (self, portal[p].table, portal[p].entry) && !portal[p].always) continue;
+          g_autofree char *key = g_strconcat ("perm_", a->id, portal[p].perm, NULL);
+          cc_luma_fixture_own_key (self->model, key);
+          cc_luma_fixture_publish_boolean (self->model, key, !value || !value[0] || g_strcmp0 (value[0], portal[p].off) != 0);
+          json_array_add_string_element (allowed, portal[p].perm);
+        }
+      json_object_set_array_member (perms, a->id, allowed);
+      json_array_add_string_element (list, a->id);
+      if (a->category) json_object_set_string_member (cats, a->id, a->category);
+      if (a->sizes[0] >= 0 && a->sizes[1] >= 0 && a->sizes[2] >= 0)
+        {
+          JsonArray *size = json_array_new ();
+          for (guint k = 0; k < 3; k++) json_array_add_int_element (size, a->sizes[k]);
+          json_object_set_array_member (sizes, a->id, size);
+        }
+    }
+  cc_luma_live_apps_batch_end (self->model);
+  const struct { const char *name; JsonNode *node; } out[] = {
+    { "CFAPPCATS", json_node_init_object (json_node_alloc (), cats) },
+    { "CFSZ", json_node_init_object (json_node_alloc (), sizes) },
+    { "CFPERMS", json_node_init_object (json_node_alloc (), perms) },
+    { "CFAPPS", json_node_init_array (json_node_alloc (), list) },
+  };
+  for (guint i = 0; i < G_N_ELEMENTS (out); i++)
+    {
+      JsonNode *before = json_object_get_member (data, out[i].name);
+      if (!before || !json_node_equal (before, out[i].node)) cc_luma_fixture_publish_data (self->model, out[i].name, out[i].node);
+      json_node_unref (out[i].node);
+    }
+  if (g_getenv ("LUMA_SETTINGS_PERF"))
+    g_printerr ("PERF apps_publish=%.1fms apps=%u\n", (g_get_monotonic_time () - t0) / 1000.0, self->apps->len);
+  if (!self->reported)
+    {
+      self->reported = TRUE;
+      g_debug ("Settings live: apps is ready");
+      cc_luma_live_ready (self->model, "apps");
+    }
+}
+
+static void read_tables (Apps *self);
+static void read_apps (Apps *self);
+
+typedef struct { Apps *self; char *name; } TableRead;
+
+static void
+table_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  TableRead *read = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED) && !read->self->stopped)
+    {
+      Apps *self = read->self;
+      /* A table the store doesn't have is simply absent: no entries. */
+      if (reply) g_hash_table_replace (self->tables, g_strdup (read->name), g_variant_get_child_value (reply, 0));
+      else g_hash_table_remove (self->tables, read->name);
+      if (self->pending) self->pending--;
+      publish (self);
+    }
+  g_free (read->name);
+  g_free (read);
+}
+
+static void
+read_tables (Apps *self)
+{
+  if (!self->bus) return;
+  for (guint p = 0; p < G_N_ELEMENTS (portal); p++)
+    {
+      TableRead *read = g_new0 (TableRead, 1);
+      read->self = self;
+      read->name = g_strconcat (portal[p].table, "/", portal[p].entry, NULL);
+      self->pending++;
+      g_dbus_connection_call (self->bus, STORE_NAME, STORE_PATH, STORE_NAME, "Lookup",
+                              g_variant_new ("(ss)", portal[p].table, portal[p].entry), G_VARIANT_TYPE ("(a{sas}v)"),
+                              G_DBUS_CALL_FLAGS_NONE, 5000, self->cancel, table_done, read);
+    }
+}
+
+static void
+store_changed (GDBusConnection *bus, const char *sender, const char *path, const char *iface, const char *signal,
+               GVariant *parameters, gpointer data)
+{
+  Apps *self = data;
+  if (!self->pending) read_tables (self);
+}
+
+static int
+by_name (gconstpointer x, gconstpointer y)
+{
+  const App *a = *(App * const *) x, *b = *(App * const *) y;
+  int order = g_utf8_collate (g_app_info_get_display_name (a->info), g_app_info_get_display_name (b->info));
+  return order ? order : g_strcmp0 (a->id, b->id);
+}
+
+static void
+apps_read (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GPtrArray) apps = g_task_propagate_pointer (G_TASK (result), NULL);
+  if (!apps) return; /* cancelled: the adapter is gone */
+  Apps *self = data;
+  self->reading = FALSE;
+  g_clear_pointer (&self->apps, g_ptr_array_unref);
+  self->apps = g_steal_pointer (&apps);
+  g_ptr_array_sort (self->apps, by_name);
+  g_hash_table_remove_all (self->by_id);
+  for (guint i = 0; i < self->apps->len; i++)
+    g_hash_table_insert (self->by_id, ((App *) self->apps->pdata[i])->id, self->apps->pdata[i]);
+  publish (self);
+}
+
+static void
+read_apps (Apps *self)
+{
+  if (self->reading) return;
+  self->reading = TRUE;
+  g_autoptr (GTask) task = g_task_new (NULL, self->cancel, apps_read, self);
+  g_task_run_in_thread (task, read_thread);
+}
+
+static gboolean
+rescan (gpointer data)
+{
+  Apps *self = data;
+  self->rescan = 0;
+  read_apps (self);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+apps_changed (Apps *self)
+{
+  if (!self->rescan) self->rescan = g_timeout_add_seconds (1, rescan, self);
+}
+
+void cc_luma_view_apps_perf_arm (void); /* cc-luma-view-application-options.c */
+
+static gpointer
+apps_start (CcLumaFixture *model)
+{
+  cc_luma_view_apps_perf_arm ();
+  Apps *self = g_new0 (Apps, 1);
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) search = source ? g_settings_schema_source_lookup (source, "org.gnome.desktop.search-providers", TRUE) : NULL;
+  g_autoptr (GSettingsSchema) notif = source ? g_settings_schema_source_lookup (source, NOTIF_SCHEMA, TRUE) : NULL;
+  self->model = g_object_ref (model);
+  self->cancel = g_cancellable_new ();
+  self->by_id = g_hash_table_new (g_str_hash, g_str_equal);
+  self->notif = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_object_unref);
+  self->tables = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, (GDestroyNotify) g_variant_unref);
+  if (!notif || !g_settings_schema_has_key (notif, "enable")) return self; /* never ready: no owner for notif */
+  if (search && g_settings_schema_has_key (search, "disable-external"))
+    {
+      self->search = g_settings_new ("org.gnome.desktop.search-providers");
+      g_signal_connect_swapped (self->search, "changed", G_CALLBACK (publish), self);
+    }
+  self->bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+  if (self->bus)
+    self->store_signal = g_dbus_connection_signal_subscribe (self->bus, NULL, STORE_NAME, "Changed", STORE_PATH, NULL,
+                                                             G_DBUS_SIGNAL_FLAGS_NONE, store_changed, self, NULL);
+  self->monitor = g_app_info_monitor_get ();
+  g_signal_connect_swapped (self->monitor, "changed", G_CALLBACK (apps_changed), self);
+  cc_luma_live_desk_dump_watch (model);
+  read_tables (self);
+  read_apps (self);
+  return self;
+}
+
+/* ── Writes ────────────────────────────────────────────────────────── */
+static App *
+app_for_key (Apps *self, const char *key, const char **perm)
+{
+  if (!g_str_has_prefix (key, "perm_")) return NULL;
+  const char *rest = key + 5;
+  const char *perms[] = { "notif", "search", "bg", "wall", "shot", "cam", "mic", "loc" };
+  for (guint i = 0; i < G_N_ELEMENTS (perms); i++)
+    if (g_str_has_suffix (rest, perms[i]))
+      {
+        g_autofree char *id = g_strndup (rest, strlen (rest) - strlen (perms[i]));
+        App *a = g_hash_table_lookup (self->by_id, id);
+        if (a) { *perm = perms[i]; return a; }
+      }
+  return NULL;
+}
+
+/* panels/applications set_search_enabled */
+static gboolean
+set_search (Apps *self, App *a, gboolean on, GError **error)
+{
+  const char *key = a->provider_default_on ? "disabled" : "enabled";
+  gboolean listed = a->provider_default_on ? !on : on;
+  g_auto (GStrv) current = g_settings_get_strv (self->search, key);
+  g_autoptr (GPtrArray) next = g_ptr_array_new_with_free_func (g_free);
+  for (guint i = 0; current[i]; i++) if (!g_str_equal (current[i], a->desktop_id)) g_ptr_array_add (next, g_strdup (current[i]));
+  if (listed) g_ptr_array_add (next, g_strdup (a->desktop_id));
+  g_ptr_array_add (next, NULL);
+  if (!g_settings_is_writable (self->search, key))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Search results are locked by policy");
+      return FALSE;
+    }
+  return g_settings_set_strv (self->search, key, (const char * const *) next->pdata);
+}
+
+static void
+store_set (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (!reply && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    g_warning ("Settings live: the permission store did not take the change: %s", error->message);
+}
+
+static gboolean
+apps_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Apps *self = state;
+  const char *perm = NULL;
+  App *a = app_for_key (self, key, &perm);
+  if (!a) return FALSE;
+  if (!JSON_NODE_HOLDS_VALUE (value) || json_node_get_value_type (value) != G_TYPE_BOOLEAN)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "%s can’t take that value", key);
+      return FALSE;
+    }
+  gboolean on = json_node_get_boolean (value);
+  if (g_str_equal (perm, "notif"))
+    {
+      GSettings *child = g_hash_table_lookup (self->notif, a->id);
+      if (!child || !g_settings_is_writable (child, "enable"))
+        {
+          g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "%s is locked by policy", key);
+          return FALSE;
+        }
+      return g_settings_set_boolean (child, "enable", on);
+    }
+  if (g_str_equal (perm, "search"))
+    return self->search && a->provider && set_search (self, a, on, error);
+  for (guint p = 0; p < G_N_ELEMENTS (portal); p++)
+    if (g_str_equal (perm, portal[p].perm) && a->portal_id && self->bus)
+      {
+        /* panels/applications set_portal_permissions: this app's entry only. */
+        const char *location[] = { on ? "EXACT" : "NONE", "0", NULL };
+        const char *simple[] = { on ? "yes" : "no", NULL };
+        g_dbus_connection_call (self->bus, STORE_NAME, STORE_PATH, STORE_NAME, "SetPermission",
+                                g_variant_new ("(sbss^as)", portal[p].table, TRUE, portal[p].entry, a->portal_id,
+                                               g_str_equal (perm, "loc") ? location : simple),
+                                NULL, G_DBUS_CALL_FLAGS_NONE, 5000, self->cancel, store_set, NULL);
+        return TRUE;
+      }
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "%s has no owner", key);
+  return FALSE;
+}
+
+static void
+apps_stop (gpointer state)
+{
+  Apps *self = state;
+  self->stopped = TRUE;
+  g_cancellable_cancel (self->cancel);
+  g_clear_handle_id (&self->rescan, g_source_remove);
+  if (self->store_signal) g_dbus_connection_signal_unsubscribe (self->bus, self->store_signal);
+  if (self->monitor) g_signal_handlers_disconnect_by_data (self->monitor, self);
+  if (self->search) g_signal_handlers_disconnect_by_data (self->search, self);
+  GHashTableIter iter;
+  gpointer child;
+  g_hash_table_iter_init (&iter, self->notif);
+  while (g_hash_table_iter_next (&iter, NULL, &child)) g_signal_handlers_disconnect_by_data (child, self);
+  g_clear_object (&self->monitor);
+  g_clear_object (&self->search);
+  g_clear_object (&self->bus);
+  g_clear_pointer (&self->apps, g_ptr_array_unref);
+  g_hash_table_unref (self->by_id);
+  g_hash_table_unref (self->notif);
+  g_hash_table_unref (self->tables);
+  /* In-flight table reads still hold self: leak the small shell rather
+   * than let a late reply touch freed memory. */
+  g_clear_object (&self->cancel);
+  g_object_unref (self->model);
+}
+
+const CcLumaAdapter cc_luma_adapter_apps = {
+  "apps", (const char * const[]) { "apps", "app:", NULL }, apps_start, apps_write, apps_stop
+};
diff --git a/shell/cc-luma-live-apps.c b/shell/cc-luma-live-apps.c
new file mode 100644
index 0000000..9696f30
--- /dev/null
+++ b/shell/cc-luma-live-apps.c
@@ -0,0 +1,155 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-live-apps.h"
+#include <gtk/gtk.h>
+#include <gio/gdesktopappinfo.h>
+
+/* The file an app's icon is drawn from, at the size rows show it. */
+static char *
+icon_lookup (GIcon *icon)
+{
+  if (G_IS_FILE_ICON (icon))
+    return g_file_get_path (g_file_icon_get_file (G_FILE_ICON (icon)));
+  GdkDisplay *display = gdk_display_get_default ();
+  if (!icon || !display) return NULL;
+  GtkIconTheme *theme = gtk_icon_theme_get_for_display (display);
+  g_autoptr (GtkIconPaintable) paintable = gtk_icon_theme_lookup_by_gicon (theme, icon, 64, 1, GTK_TEXT_DIR_NONE, 0);
+  g_autoptr (GFile) file = paintable ? gtk_icon_paintable_get_file (paintable) : NULL;
+  return file ? g_file_get_path (file) : NULL;
+}
+
+/* Theme lookups are the slow part of naming many apps: once per icon. */
+static char *
+icon_file (GIcon *icon)
+{
+  static GHashTable *known;
+  if (!icon) return NULL;
+  g_autofree char *name = g_icon_to_string (icon);
+  if (!name) return icon_lookup (icon);
+  if (!known) known = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+  if (g_hash_table_contains (known, name)) return g_strdup (g_hash_table_lookup (known, name));
+  char *path = icon_lookup (icon);
+  g_hash_table_insert (known, g_steal_pointer (&name), g_strdup (path));
+  return path;
+}
+
+/* While a batch is open, names go to one table published at the end. */
+void
+cc_luma_live_apps_batch_begin (CcLumaFixture *model)
+{
+  JsonNode *known = json_object_get_member (cc_luma_fixture_get_data (model), "CFAPPINFO");
+  JsonNode *table = known && JSON_NODE_HOLDS_OBJECT (known) ? json_node_copy (known) : json_node_init_object (json_node_alloc (), json_object_new ());
+  g_object_set_data_full (G_OBJECT (model), "cc-luma-apps-batch", table, (GDestroyNotify) json_node_unref);
+  g_object_set_data (G_OBJECT (model), "cc-luma-apps-batch-dirty", NULL);
+}
+
+void
+cc_luma_live_apps_batch_end (CcLumaFixture *model)
+{
+  JsonNode *table = g_object_get_data (G_OBJECT (model), "cc-luma-apps-batch");
+  if (table && g_object_get_data (G_OBJECT (model), "cc-luma-apps-batch-dirty"))
+    cc_luma_fixture_publish_data (model, "CFAPPINFO", table);
+  g_object_set_data (G_OBJECT (model), "cc-luma-apps-batch", NULL);
+}
+
+gboolean
+cc_luma_live_publish_app (CcLumaFixture *model, const char *id, GAppInfo *info)
+{
+  const char *name = info ? g_app_info_get_name (info) : NULL;
+  if (!id || !*id || !name || !*name) return FALSE;
+  JsonObject *data = cc_luma_fixture_get_data (model);
+  JsonNode *batch = g_object_get_data (G_OBJECT (model), "cc-luma-apps-batch");
+  JsonNode *known = batch ? batch : json_object_get_member (data, "CFAPPINFO");
+  JsonNode *entry = known && JSON_NODE_HOLDS_OBJECT (known) ? json_object_get_member (json_node_get_object (known), id) : NULL;
+  JsonNode *current = entry && JSON_NODE_HOLDS_OBJECT (entry) ? json_object_get_member (json_node_get_object (entry), "name") : NULL;
+  const char *about = g_app_info_get_description (info);
+  if (about && !*about) about = NULL;
+  JsonNode *known_about = entry && JSON_NODE_HOLDS_OBJECT (entry) ? json_object_get_member (json_node_get_object (entry), "description") : NULL;
+  gboolean about_same = about ? known_about && JSON_NODE_HOLDS_VALUE (known_about) && g_strcmp0 (json_node_get_string (known_about), about) == 0 : !known_about;
+  if (!current || json_node_get_value_type (current) != G_TYPE_STRING || !g_str_equal (json_node_get_string (current), name) || !about_same)
+    {
+      JsonObject *app = json_object_new ();
+      json_object_set_string_member (app, "name", name);
+      if (about && *about) json_object_set_string_member (app, "description", about);
+      if (batch)
+        {
+          json_object_set_object_member (json_node_get_object (batch), id, app);
+          g_object_set_data (G_OBJECT (model), "cc-luma-apps-batch-dirty", GINT_TO_POINTER (1));
+        }
+      else
+        {
+          /* Other adapters name their apps in the same table: keep theirs. */
+          g_autoptr (JsonNode) table = known && JSON_NODE_HOLDS_OBJECT (known) ? json_node_copy (known)
+                                                                                : json_node_init_object (json_node_alloc (), json_object_new ());
+          json_object_set_object_member (json_node_get_object (table), id, app);
+          cc_luma_fixture_publish_data (model, "CFAPPINFO", table);
+        }
+    }
+  g_autoptr (GIcon) fallback = g_themed_icon_new ("application-x-executable");
+  GIcon *icon = g_app_info_get_icon (info);
+  g_autofree char *path = icon ? icon_file (icon) : NULL;
+  if (!path) path = icon_file (fallback);
+  cc_luma_fixture_publish_asset (model, id, path);
+  return TRUE;
+}
+
+/* ── The dock ──────────────────────────────────────────────────────── */
+static void
+publish_dock (GSettings *shell, const char *key, CcLumaFixture *model)
+{
+  g_auto (GStrv) favorites = g_settings_get_strv (shell, "favorite-apps");
+  g_autoptr (JsonArray) dock = json_array_new ();
+  for (guint i = 0; favorites[i]; i++)
+    {
+      g_autoptr (GDesktopAppInfo) info = g_desktop_app_info_new (favorites[i]);
+      if (info && cc_luma_live_publish_app (model, favorites[i], G_APP_INFO (info)))
+        json_array_add_string_element (dock, favorites[i]);
+    }
+  g_autoptr (JsonNode) node = json_node_init_array (json_node_alloc (), dock);
+  JsonNode *before = json_object_get_member (cc_luma_fixture_get_data (model), "CFDOCK");
+  if (!before || !json_node_equal (before, node)) cc_luma_fixture_publish_data (model, "CFDOCK", node);
+}
+
+void
+cc_luma_live_publish_dock (CcLumaFixture *model)
+{
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = source ? g_settings_schema_source_lookup (source, "org.gnome.shell", TRUE) : NULL;
+  if (!schema || !g_settings_schema_has_key (schema, "favorite-apps") || g_object_get_data (G_OBJECT (model), "cc-luma-dock")) return;
+  GSettings *shell = g_settings_new_full (schema, NULL, NULL);
+  g_object_set_data_full (G_OBJECT (model), "cc-luma-dock", shell, g_object_unref);
+  g_signal_connect_object (shell, "changed::favorite-apps", G_CALLBACK (publish_dock), model, 0);
+  publish_dock (shell, NULL, model);
+}
+
+static void
+desk_dump (CcLumaFixture *model, const char *path)
+{
+  static const char *data[] = { "CFPRE", "CFPRINTER", "CFDOCK", "CFAPPS", "CFPERMS", "CFSZ", "CFDEFAPPS", NULL };
+  /* Every live key, and the data the desk and apps pages draw. */
+  JsonObject *settings = cc_luma_fixture_get_settings (model);
+  g_autoptr (JsonNode) out = json_node_init_object (json_node_alloc (), json_object_new ());
+  g_autoptr (GList) keys = settings ? json_object_get_members (settings) : NULL;
+  for (GList *k = keys; k; k = k->next)
+    json_object_set_member (json_node_get_object (out), k->data, json_node_copy (json_object_get_member (settings, k->data)));
+  for (guint i = 0; data[i]; i++)
+    {
+      JsonNode *n = json_object_get_member (cc_luma_fixture_get_data (model), data[i]);
+      if (n) json_object_set_member (json_node_get_object (out), data[i], json_node_copy (n));
+    }
+  g_autofree char *text = json_to_string (out, TRUE);
+  g_file_set_contents (path, text, -1, NULL);
+}
+
+static void
+desk_dump_changed (CcLumaFixture *model, gpointer unused)
+{
+  desk_dump (model, g_getenv ("LUMA_SETTINGS_LIVE_DUMP_DESK"));
+}
+
+void
+cc_luma_live_desk_dump_watch (CcLumaFixture *model)
+{
+  if (!g_getenv ("LUMA_SETTINGS_LIVE_DUMP_DESK") || g_object_get_data (G_OBJECT (model), "cc-luma-desk-dump")) return;
+  g_object_set_data (G_OBJECT (model), "cc-luma-desk-dump", GINT_TO_POINTER (1));
+  g_signal_connect (model, "changed", G_CALLBACK (desk_dump_changed), NULL);
+}
diff --git a/shell/cc-luma-live-apps.h b/shell/cc-luma-live-apps.h
new file mode 100644
index 0000000..6aff33b
--- /dev/null
+++ b/shell/cc-luma-live-apps.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "cc-luma-live.h"
+#include <gio/gio.h>
+
+G_BEGIN_DECLS
+/* Names an installed app under the id a page lists it by (CFAPPINFO) and
+ * reports its icon's file as that id's image. FALSE: the app has no name. */
+gboolean cc_luma_live_publish_app (CcLumaFixture *model, const char *id, GAppInfo *info);
+/* Name many apps with one CFAPPINFO publication. */
+void cc_luma_live_apps_batch_begin (CcLumaFixture *model);
+void cc_luma_live_apps_batch_end (CcLumaFixture *model);
+/* The apps pinned to the dock (org.gnome.shell favorite-apps) as CFDOCK,
+ * each named and with its icon: the live shelf and window previews draw
+ * the person's own apps. */
+void cc_luma_live_publish_dock (CcLumaFixture *model);
+/* LUMA_SETTINGS_LIVE_DUMP_DESK=<file>: the Shelf, Windows, Notifications,
+ * Search and Printers pages' live keys and data after every change, to
+ * check a system's model without a screen. */
+void cc_luma_live_desk_dump_watch (CcLumaFixture *model);
+G_END_DECLS
diff --git a/shell/cc-luma-live-bluetooth.c b/shell/cc-luma-live-bluetooth.c
new file mode 100644
index 0000000..703236f
--- /dev/null
+++ b/shell/cc-luma-live-bluetooth.c
@@ -0,0 +1,581 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live Bluetooth: BlueZ read directly over D-Bus (its object manager:
+ * Adapter1, Device1, Battery1), with power through gnome-settings-daemon's
+ * Rfkill as panels/bluetooth does. No libgnome-bluetooth: the GNOME
+ * Bluetooth panel in the same process registers its own BluetoothClient.
+ * Connecting, pairing (with a Settings agent) and removal are the Device1 and
+ * Adapter1 calls BluetoothSettingsWidget makes. devName is the host's pretty
+ * name. */
+#include "cc-luma-live.h"
+#include <gio/gio.h>
+#include <string.h>
+
+#define ADAPTER "bluetooth"
+/* The Wi‑Fi pages' model check reads "bt" too. */
+static const char * const pages[] = { "bluetooth", "wifi", "wifi-net", "wifi-known", "hotspot", "network", NULL };
+static const char * const owned[] = { "bt", "CFBT.connect", "CFBT.disconnect", "CFBT.forget", "CFNEAR.pair", "CFNEAR.scan",
+                                      "CFNEAR.confirm", "CFNEAR.cancel", NULL };
+#define AGENT_PATH "/org/projectluma/Settings/BluetoothAgent"
+
+typedef struct {
+  CcLumaFixture *model;
+  GDBusObjectManager *bluez;
+  GDBusProxy *rfkill, *hostnamed;
+  GCancellable *cancel;
+  guint refresh, scan_lease, pending;
+  gboolean ready;
+  char *scanning;                /* the adapter this page asked to discover */
+  /* The pairing agent, registered only while this page pairs a device. */
+  GDBusConnection *system;
+  guint agent;
+  char *pairing;                 /* the device being paired */
+  char *code;                    /* what the person types or checks on it */
+  GDBusMethodInvocation *asking; /* waits for the page's Pair or Cancel */
+} Bt;
+
+static void queue_refresh (Bt *b);
+
+static gboolean
+rfkill_flag (Bt *b, const char *name)
+{
+  g_autoptr (GVariant) v = b->rfkill ? g_dbus_proxy_get_cached_property (b->rfkill, name) : NULL;
+  return v && g_variant_is_of_type (v, G_VARIANT_TYPE_BOOLEAN) && g_variant_get_boolean (v);
+}
+static gboolean
+prop_bool (GDBusProxy *p, const char *name)
+{
+  g_autoptr (GVariant) v = p ? g_dbus_proxy_get_cached_property (p, name) : NULL;
+  return v && g_variant_is_of_type (v, G_VARIANT_TYPE_BOOLEAN) && g_variant_get_boolean (v);
+}
+static const char *
+prop_string (GDBusProxy *p, const char *name, GVariant **hold)
+{
+  *hold = p ? g_dbus_proxy_get_cached_property (p, name) : NULL;
+  return *hold && (g_variant_is_of_type (*hold, G_VARIANT_TYPE_STRING) || g_variant_is_of_type (*hold, G_VARIANT_TYPE_OBJECT_PATH))
+    ? g_variant_get_string (*hold, NULL) : NULL;
+}
+static GDBusProxy *
+interface_of (GDBusObject *object, const char *name)
+{
+  GDBusInterface *i = g_dbus_object_get_interface (object, name);
+  return i ? G_DBUS_PROXY (i) : NULL;
+}
+static gint
+by_path (gconstpointer a, gconstpointer b)
+{
+  return g_strcmp0 (g_dbus_object_get_object_path ((GDBusObject *) a), g_dbus_object_get_object_path ((GDBusObject *) b));
+}
+/* BlueZ's objects, in path order (hci0 before hci1). */
+static GList *
+objects (Bt *b)
+{
+  g_autofree char *owner = b->bluez ? g_dbus_object_manager_client_get_name_owner (G_DBUS_OBJECT_MANAGER_CLIENT (b->bluez)) : NULL;
+  return owner ? g_list_sort (g_dbus_object_manager_get_objects (b->bluez), by_path) : NULL;
+}
+/* The default adapter as gnome-bluetooth picks it: a powered one, else the first. */
+static GDBusProxy *
+default_adapter (Bt *b)
+{
+  GList *list = objects (b);
+  GDBusProxy *found = NULL;
+  for (GList *l = list; l; l = l->next)
+    {
+      GDBusProxy *a = interface_of (l->data, "org.bluez.Adapter1");
+      if (!a) continue;
+      if (!found) found = a;
+      else if (prop_bool (a, "Powered") && !prop_bool (found, "Powered")) { g_object_unref (found); found = a; }
+      else g_object_unref (a);
+    }
+  g_list_free_full (list, g_object_unref);
+  return found;
+}
+static gboolean
+has_adapter (Bt *b)
+{
+  g_autoptr (GDBusProxy) adapter = default_adapter (b);
+  return adapter != NULL;
+}
+static gboolean
+powered (Bt *b)
+{
+  g_autoptr (GDBusProxy) adapter = default_adapter (b);
+  return prop_bool (adapter, "Powered") && !rfkill_flag (b, "AirplaneMode") && !rfkill_flag (b, "BluetoothAirplaneMode") &&
+         !rfkill_flag (b, "BluetoothHardwareAirplaneMode");
+}
+/* The device's freedesktop icon (bluetooth_type_to_icon) as a Lucide face. */
+static void
+face (const char *icon, const char **lucide, const char **kind)
+{
+  static const struct { const char *prefix, *lucide, *kind; } faces[] = {
+    { "audio-headphones", "headphones", "Headphones" }, { "audio-headset", "headphones", "Headset" },
+    { "audio-speakers", "speaker", "Speaker" }, { "audio-card", "volume-2", "Speaker" },
+    { "input-mouse", "mouse", "Mouse" }, { "input-tablet", "mouse", "Tablet" }, { "input-keyboard", "keyboard", "Keyboard" },
+    { "input-gaming", "gamepad-2", "Game controller" }, { "phone", "smartphone", "Phone" },
+    { "computer", "monitor", "Computer" }, { "video-display", "monitor", "Display" }, { "printer", "printer", "Printer" },
+    { "camera", "camera", "Camera" }, { "multimedia-player", "volume-2", "Media player" }, { "watch", "watch", "Watch" },
+  };
+  for (guint i = 0; icon && i < G_N_ELEMENTS (faces); i++)
+    if (g_str_has_prefix (icon, faces[i].prefix)) { *lucide = faces[i].lucide; *kind = faces[i].kind; return; }
+  *lucide = "bluetooth"; *kind = "Device";
+}
+/* A device of the default adapter by address (the page's id). */
+static GDBusProxy *
+find_device (Bt *b, const char *address)
+{
+  g_autoptr (GDBusProxy) adapter = default_adapter (b);
+  GList *list = objects (b);
+  GDBusProxy *found = NULL;
+  for (GList *l = list; adapter && address && !found && l; l = l->next)
+    {
+      GDBusProxy *d = interface_of (l->data, "org.bluez.Device1");
+      g_autoptr (GVariant) a = NULL, owner = NULL;
+      if (d && g_strcmp0 (prop_string (d, "Address", &a), address) == 0 &&
+          g_strcmp0 (prop_string (d, "Adapter", &owner), g_dbus_proxy_get_object_path (adapter)) == 0)
+        found = g_object_ref (d);
+      g_clear_object (&d);
+    }
+  g_list_free_full (list, g_object_unref);
+  return found;
+}
+static gboolean
+refresh (gpointer data)
+{
+  Bt *b = data;
+  gboolean on = powered (b);
+  JsonArray *saved = json_array_new (), *near = json_array_new ();
+  g_autoptr (GDBusProxy) adapter = default_adapter (b);
+  GList *list = on ? objects (b) : NULL;
+  b->refresh = 0;
+  for (GList *l = list; l; l = l->next)
+    {
+      g_autoptr (GDBusProxy) d = interface_of (l->data, "org.bluez.Device1");
+      g_autoptr (GDBusProxy) battery = interface_of (l->data, "org.bluez.Battery1");
+      g_autoptr (GVariant) owner = NULL, address = NULL, alias = NULL, name = NULL, icon = NULL, percent = NULL;
+      const char *lucide, *kind, *path = g_dbus_object_get_object_path (l->data);
+      if (!d || g_strcmp0 (prop_string (d, "Adapter", &owner), g_dbus_proxy_get_object_path (adapter)) != 0) continue;
+      const char *id = prop_string (d, "Address", &address), *label = prop_string (d, "Alias", &alias);
+      if (!label || !*label) label = prop_string (d, "Name", &name);
+      if (!id || !label || !*label) continue; /* nameless devices aren't offered */
+      face (prop_string (d, "Icon", &icon), &lucide, &kind);
+      JsonObject *o = json_object_new ();
+      json_object_set_string_member (o, "id", id);
+      json_object_set_string_member (o, "n", label);
+      json_object_set_string_member (o, "i", lucide);
+      json_object_set_string_member (o, "kind", kind);
+      if (prop_bool (d, "Paired") || prop_bool (d, "Trusted"))
+        {
+          json_object_set_boolean_member (o, "on", prop_bool (d, "Connected"));
+          percent = battery ? g_dbus_proxy_get_cached_property (battery, "Percentage") : NULL;
+          if (percent && g_variant_is_of_type (percent, G_VARIANT_TYPE_BYTE))
+            json_object_set_int_member (o, "bat", MIN (g_variant_get_byte (percent), 100));
+          json_array_add_object_element (saved, o);
+        }
+      else
+        {
+          if (b->pairing && g_strcmp0 (path, b->pairing) == 0) json_object_set_boolean_member (o, "pairing", TRUE);
+          if (b->code && g_strcmp0 (path, b->pairing) == 0) json_object_set_string_member (o, "code", b->code);
+          if (b->asking && g_strcmp0 (path, b->pairing) == 0) json_object_set_boolean_member (o, "confirm", TRUE);
+          json_array_add_object_element (near, o);
+        }
+    }
+  g_list_free_full (list, g_object_unref);
+  g_autoptr (GVariant) pretty = b->hostnamed ? g_dbus_proxy_get_cached_property (b->hostnamed, "PrettyHostname") : NULL;
+  const char *host = pretty ? g_variant_get_string (pretty, NULL) : NULL;
+  cc_luma_fixture_publish_boolean (b->model, "bt", on);
+  cc_luma_fixture_publish_string (b->model, "devName", host && *host ? host : g_get_host_name ());
+  {
+    g_autoptr (JsonNode) node = json_node_init_array (json_node_alloc (), saved);
+    cc_luma_fixture_publish_data (b->model, "CFBT", node);
+  }
+  {
+    g_autoptr (JsonNode) node = json_node_init_array (json_node_alloc (), near);
+    cc_luma_fixture_publish_data (b->model, "CFNEAR", node);
+  }
+  json_array_unref (saved); json_array_unref (near);
+  if (!b->ready) { b->ready = TRUE; cc_luma_live_ready (b->model, ADAPTER); }
+  return G_SOURCE_REMOVE;
+}
+static void
+queue_refresh (Bt *b)
+{
+  if (!b->pending && !b->refresh) b->refresh = g_idle_add (refresh, b);
+}
+
+/* ── Writing ─────────────────────────────────────────────────────────── */
+static gboolean
+fail (GError **error, const char *message)
+{
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_FAILED, message);
+  return FALSE;
+}
+static void
+warn (Bt *b, GError *error, const char *what)
+{
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  if (error) g_warning ("Settings: Bluetooth could not %s: %s", what, error->message);
+  queue_refresh (b);
+}
+static void
+power_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) out = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+  warn (data, error, "change power");
+}
+static void
+connect_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) out = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+  warn (data, error, "connect");
+}
+static void
+call_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) out = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  warn (data, error, "change a device");
+}
+/* ── Pairing agent (BluetoothSettingsWidget's, org.bluez.Agent1) ─────────
+ * Codes are shown on the device's tile; a confirmation waits for the page;
+ * nothing is accepted on its own. Only the device this page pairs is served. */
+static const char agent_xml[] =
+  "<node><interface name='org.bluez.Agent1'>"
+  "<method name='Release'/>"
+  "<method name='RequestPinCode'><arg type='o' direction='in'/><arg type='s' direction='out'/></method>"
+  "<method name='DisplayPinCode'><arg type='o' direction='in'/><arg type='s' direction='in'/></method>"
+  "<method name='RequestPasskey'><arg type='o' direction='in'/><arg type='u' direction='out'/></method>"
+  "<method name='DisplayPasskey'><arg type='o' direction='in'/><arg type='u' direction='in'/><arg type='q' direction='in'/></method>"
+  "<method name='RequestConfirmation'><arg type='o' direction='in'/><arg type='u' direction='in'/></method>"
+  "<method name='RequestAuthorization'><arg type='o' direction='in'/></method>"
+  "<method name='AuthorizeService'><arg type='o' direction='in'/><arg type='s' direction='in'/></method>"
+  "<method name='Cancel'/>"
+  "</interface></node>";
+
+static char *
+spaced (const char *digits)
+{
+  /* v70 shows six digits as "482 913". */
+  return strlen (digits) == 6 ? g_strdup_printf ("%.3s %.3s", digits, digits + 3) : g_strdup (digits);
+}
+static void
+set_code (Bt *b, const char *digits)
+{
+  g_free (b->code);
+  b->code = digits ? spaced (digits) : NULL;
+  queue_refresh (b);
+}
+static void
+answer (Bt *b, gboolean yes)
+{
+  GDBusMethodInvocation *asking = g_steal_pointer (&b->asking);
+  if (!asking) return;
+  if (yes) g_dbus_method_invocation_return_value (asking, NULL);
+  else g_dbus_method_invocation_return_dbus_error (asking, "org.bluez.Error.Rejected", "Cancelled on this computer");
+  queue_refresh (b);
+}
+static void
+agent_call (GDBusConnection *connection, const char *sender, const char *path, const char *interface,
+            const char *method, GVariant *parameters, GDBusMethodInvocation *invocation, gpointer data)
+{
+  Bt *b = data;
+  const char *device = NULL;
+  if (g_str_equal (method, "Release")) { g_dbus_method_invocation_return_value (invocation, NULL); return; }
+  if (g_str_equal (method, "Cancel"))
+    {
+      answer (b, FALSE);
+      set_code (b, NULL);
+      g_dbus_method_invocation_return_value (invocation, NULL);
+      return;
+    }
+  g_variant_get_child (parameters, 0, "&o", &device);
+  if (!b->pairing || g_strcmp0 (device, b->pairing) != 0 || g_str_equal (method, "AuthorizeService") ||
+      g_str_equal (method, "RequestPasskey"))
+    {
+      /* Not ours to accept (or a code the page has no field for). */
+      g_dbus_method_invocation_return_dbus_error (invocation, "org.bluez.Error.Rejected", "Not paired from Settings");
+      return;
+    }
+  if (g_str_equal (method, "RequestPinCode"))
+    {
+      g_autofree char *pin = g_strdup_printf ("%06u", g_random_int_range (0, 1000000));
+      set_code (b, pin);
+      g_dbus_method_invocation_return_value (invocation, g_variant_new ("(s)", pin));
+    }
+  else if (g_str_equal (method, "DisplayPinCode"))
+    {
+      const char *pin = NULL;
+      g_variant_get_child (parameters, 1, "&s", &pin);
+      set_code (b, pin);
+      g_dbus_method_invocation_return_value (invocation, NULL);
+    }
+  else if (g_str_equal (method, "DisplayPasskey"))
+    {
+      guint32 key = 0;
+      g_variant_get_child (parameters, 1, "u", &key);
+      g_autofree char *digits = g_strdup_printf ("%06u", key);
+      set_code (b, digits);
+      g_dbus_method_invocation_return_value (invocation, NULL);
+    }
+  else /* RequestConfirmation, RequestAuthorization: the page decides. */
+    {
+      answer (b, FALSE);
+      if (g_str_equal (method, "RequestConfirmation"))
+        {
+          guint32 key = 0;
+          g_variant_get_child (parameters, 1, "u", &key);
+          g_autofree char *digits = g_strdup_printf ("%06u", key);
+          set_code (b, digits);
+        }
+      b->asking = invocation;
+      queue_refresh (b);
+    }
+}
+static const GDBusInterfaceVTable agent_vtable = { agent_call, NULL, NULL, { 0 } };
+
+static void
+agent_stop (Bt *b)
+{
+  answer (b, FALSE);
+  if (b->agent)
+    {
+      g_dbus_connection_call (b->system, "org.bluez", "/org/bluez", "org.bluez.AgentManager1", "UnregisterAgent",
+                              g_variant_new ("(o)", AGENT_PATH), NULL, G_DBUS_CALL_FLAGS_NONE, -1, NULL, NULL, NULL);
+      g_dbus_connection_unregister_object (b->system, b->agent);
+      b->agent = 0;
+    }
+  g_clear_object (&b->system);
+  g_clear_pointer (&b->pairing, g_free);
+  g_clear_pointer (&b->code, g_free);
+}
+typedef struct { Bt *bt; char *path; GDBusProxy *device; } Pairing;
+static void
+paired (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Pairing *p = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) out = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+  if (!error)
+    {
+      /* bluetooth_client_setup_device: trust it, then connect its services. */
+      g_dbus_proxy_call (G_DBUS_PROXY (source), "org.freedesktop.DBus.Properties.Set",
+                         g_variant_new ("(ssv)", "org.bluez.Device1", "Trusted", g_variant_new_boolean (TRUE)),
+                         G_DBUS_CALL_FLAGS_NONE, -1, p->bt->cancel, NULL, NULL);
+      g_dbus_proxy_call (G_DBUS_PROXY (source), "Connect", NULL, G_DBUS_CALL_FLAGS_NONE, 60000, p->bt->cancel, connect_done, p->bt);
+    }
+  if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) agent_stop (p->bt);
+  warn (p->bt, error, "pair");
+  g_object_unref (p->device);
+  g_free (p->path);
+  g_free (p);
+}
+static void
+agent_registered (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Pairing *p = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) out = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (error && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    {
+      agent_stop (p->bt);
+      warn (p->bt, error, "start pairing");
+    }
+  if (error)
+    {
+      g_object_unref (p->device); g_free (p->path); g_free (p);
+      return;
+    }
+  /* BlueZ asks the agent of whoever called Pair. */
+  g_dbus_proxy_call (p->device, "Pair", NULL, G_DBUS_CALL_FLAGS_NONE, 90000, p->bt->cancel, paired, p);
+}
+static void
+discovery (Bt *b, const char *adapter, gboolean on, GCancellable *cancel)
+{
+  GDBusConnection *bus = b->bluez ? g_dbus_object_manager_client_get_connection (G_DBUS_OBJECT_MANAGER_CLIENT (b->bluez)) : NULL;
+  if (bus && adapter)
+    g_dbus_connection_call (bus, "org.bluez", adapter, "org.bluez.Adapter1", on ? "StartDiscovery" : "StopDiscovery",
+                            NULL, NULL, G_DBUS_CALL_FLAGS_NONE, -1, cancel, NULL, NULL);
+}
+static gboolean
+stop_scan (gpointer data)
+{
+  Bt *b = data;
+  b->scan_lease = 0;
+  discovery (b, b->scanning, FALSE, NULL);
+  g_clear_pointer (&b->scanning, g_free);
+  return G_SOURCE_REMOVE;
+}
+static gboolean
+has_rfkill (Bt *b)
+{
+  g_autofree char *owner = b->rfkill ? g_dbus_proxy_get_name_owner (b->rfkill) : NULL;
+  return owner != NULL;
+}
+static gboolean
+bt_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Bt *b = state;
+  if (!g_strv_contains (owned, key)) return FALSE;
+  g_autoptr (GDBusProxy) adapter = default_adapter (b);
+  if (!adapter) return fail (error, "This computer has no Bluetooth");
+  if (g_str_equal (key, "bt"))
+    {
+      gboolean on = JSON_NODE_HOLDS_VALUE (value) && json_node_get_boolean (value);
+      if (on && rfkill_flag (b, "BluetoothHardwareAirplaneMode")) return fail (error, "A hardware switch keeps Bluetooth off");
+      /* cc-bluetooth-panel.c: power is the Bluetooth airplane mode. */
+      if (has_rfkill (b))
+        g_dbus_proxy_call (b->rfkill, "org.freedesktop.DBus.Properties.Set",
+                           g_variant_new_parsed ("('org.gnome.SettingsDaemon.Rfkill', 'BluetoothAirplaneMode', %v)",
+                                                 g_variant_new_boolean (!on)),
+                           G_DBUS_CALL_FLAGS_NONE, -1, b->cancel, power_done, b);
+      if ((on && !prop_bool (adapter, "Powered")) || (!on && !has_rfkill (b)))
+        g_dbus_proxy_call (adapter, "org.freedesktop.DBus.Properties.Set",
+                           g_variant_new ("(ssv)", "org.bluez.Adapter1", "Powered", g_variant_new_boolean (on)),
+                           G_DBUS_CALL_FLAGS_NONE, -1, b->cancel, power_done, b);
+      return TRUE;
+    }
+  if (g_str_equal (key, "CFNEAR.scan"))
+    {
+      /* A lease: the page renews it while it is open; discovery stops when
+       * it lapses (and BlueZ stops it if Settings goes away). */
+      gboolean on = JSON_NODE_HOLDS_VALUE (value) && json_node_get_boolean (value);
+      g_clear_handle_id (&b->scan_lease, g_source_remove);
+      if (!on) { stop_scan (b); return TRUE; }
+      if (g_strcmp0 (b->scanning, g_dbus_proxy_get_object_path (adapter)) != 0)
+        {
+          if (b->scanning) discovery (b, b->scanning, FALSE, NULL);
+          g_free (b->scanning);
+          b->scanning = g_strdup (g_dbus_proxy_get_object_path (adapter));
+          discovery (b, b->scanning, TRUE, b->cancel);
+        }
+      b->scan_lease = g_timeout_add_seconds (30, stop_scan, b);
+      return TRUE;
+    }
+  const char *id = JSON_NODE_HOLDS_VALUE (value) && json_node_get_value_type (value) == G_TYPE_STRING ?
+    json_node_get_string (value) : NULL;
+  g_autoptr (GDBusProxy) d = find_device (b, id);
+  if (!d) return fail (error, "That device is no longer around");
+  const char *path = g_dbus_proxy_get_object_path (d);
+  if (g_str_equal (key, "CFBT.connect") || g_str_equal (key, "CFBT.disconnect"))
+    {
+      g_dbus_proxy_call (d, g_str_equal (key, "CFBT.connect") ? "Connect" : "Disconnect", NULL, G_DBUS_CALL_FLAGS_NONE,
+                         60000, b->cancel, connect_done, b);
+      return TRUE;
+    }
+  if (g_str_equal (key, "CFNEAR.pair"))
+    {
+      g_autoptr (GDBusProxy) proxy = g_object_ref (d);
+      if (b->pairing) return fail (error, "Finish pairing the other device first");
+      g_autoptr (GDBusNodeInfo) node = g_dbus_node_info_new_for_xml (agent_xml, NULL);
+      b->system = g_object_ref (g_dbus_proxy_get_connection (proxy));
+      b->agent = g_dbus_connection_register_object (b->system, AGENT_PATH, node->interfaces[0], &agent_vtable, b, NULL, error);
+      if (!b->agent) { g_clear_object (&b->system); return FALSE; }
+      b->pairing = g_strdup (path);
+      Pairing *p = g_new0 (Pairing, 1);
+      p->bt = b; p->path = g_strdup (path); p->device = g_steal_pointer (&proxy);
+      g_dbus_connection_call (b->system, "org.bluez", "/org/bluez", "org.bluez.AgentManager1", "RegisterAgent",
+                              g_variant_new ("(os)", AGENT_PATH, "KeyboardDisplay"), NULL, G_DBUS_CALL_FLAGS_NONE, -1,
+                              b->cancel, agent_registered, p);
+      return TRUE;
+    }
+  if (g_str_equal (key, "CFNEAR.confirm") || g_str_equal (key, "CFNEAR.cancel"))
+    {
+      if (!b->pairing || g_strcmp0 (path, b->pairing) != 0) return fail (error, "That device isn’t pairing");
+      if (g_str_equal (key, "CFNEAR.cancel"))
+        {
+          if (!b->asking)
+            g_dbus_proxy_call (d, "CancelPairing", NULL, G_DBUS_CALL_FLAGS_NONE, -1, b->cancel, NULL, NULL);
+        }
+      answer (b, g_str_equal (key, "CFNEAR.confirm"));
+      return TRUE;
+    }
+  /* CFBT.forget: the page has already asked. */
+  g_dbus_connection_call (g_dbus_proxy_get_connection (d), "org.bluez", g_dbus_proxy_get_object_path (adapter), "org.bluez.Adapter1",
+                          "RemoveDevice", g_variant_new ("(o)", path), NULL, G_DBUS_CALL_FLAGS_NONE, -1,
+                          b->cancel, call_done, b);
+  return TRUE;
+}
+
+/* ── Lifetime ────────────────────────────────────────────────────────── */
+static void
+settle (Bt *b)
+{
+  if (b->pending && --b->pending == 0) queue_refresh (b);
+}
+static void
+rfkill_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Bt *b = data;
+  b->rfkill = proxy;
+  if (proxy) g_signal_connect_swapped (proxy, "g-properties-changed", G_CALLBACK (queue_refresh), b);
+  settle (b);
+}
+static void
+hostnamed_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Bt *b = data;
+  b->hostnamed = proxy;
+  if (proxy) g_signal_connect_swapped (proxy, "g-properties-changed", G_CALLBACK (queue_refresh), b);
+  settle (b);
+}
+static void
+bluez_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusObjectManager *manager = g_dbus_object_manager_client_new_for_bus_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Bt *b = data;
+  b->bluez = manager;
+  if (manager)
+    {
+      const char *signals[] = { "object-added", "object-removed", "interface-added", "interface-removed",
+                                "interface-proxy-properties-changed", "notify::name-owner" };
+      for (guint i = 0; i < G_N_ELEMENTS (signals); i++)
+        g_signal_connect_swapped (manager, signals[i], G_CALLBACK (queue_refresh), b);
+    }
+  else g_warning ("Settings: BlueZ: %s", error->message);
+  settle (b);
+}
+static gpointer
+bt_start (CcLumaFixture *model)
+{
+  Bt *b = g_new0 (Bt, 1);
+  b->model = model;
+  b->cancel = g_cancellable_new ();
+  for (guint i = 0; owned[i]; i++) cc_luma_fixture_own_key (model, owned[i]);
+  b->pending = 3;
+  g_dbus_object_manager_client_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_OBJECT_MANAGER_CLIENT_FLAGS_DO_NOT_AUTO_START,
+                                            "org.bluez", "/", NULL, NULL, NULL, b->cancel, bluez_ready, b);
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SESSION, G_DBUS_PROXY_FLAGS_NONE, NULL,
+                            "org.gnome.SettingsDaemon.Rfkill", "/org/gnome/SettingsDaemon/Rfkill",
+                            "org.gnome.SettingsDaemon.Rfkill", b->cancel, rfkill_ready, b);
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_NONE, NULL, "org.freedesktop.hostname1",
+                            "/org/freedesktop/hostname1", "org.freedesktop.hostname1", b->cancel, hostnamed_ready, b);
+  return b;
+}
+static void
+bt_stop (gpointer state)
+{
+  Bt *b = state;
+  g_cancellable_cancel (b->cancel);
+  g_clear_object (&b->cancel);
+  g_clear_handle_id (&b->refresh, g_source_remove);
+  g_clear_handle_id (&b->scan_lease, g_source_remove);
+  if (b->scanning) stop_scan (b);
+  agent_stop (b);
+  if (b->bluez) g_signal_handlers_disconnect_by_data (b->bluez, b);
+  if (b->rfkill) g_signal_handlers_disconnect_by_data (b->rfkill, b);
+  if (b->hostnamed) g_signal_handlers_disconnect_by_data (b->hostnamed, b);
+  g_clear_object (&b->bluez);
+  g_clear_object (&b->rfkill);
+  g_clear_object (&b->hostnamed);
+  g_free (b);
+}
+
+const CcLumaAdapter cc_luma_adapter_bluetooth = { ADAPTER, pages, bt_start, bt_write, bt_stop };
diff --git a/shell/cc-luma-live-datetime.c b/shell/cc-luma-live-datetime.c
new file mode 100644
index 0000000..97a9569
--- /dev/null
+++ b/shell/cc-luma-live-datetime.c
@@ -0,0 +1,178 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live Date & Time, as panels/system/datetime/cc-datetime-page.c: timedated
+ * (automatic time, time zone, the zone list) with its own interactive polkit
+ * checks, and GSettings for automatic time zone and the clock's format. */
+#include "cc-luma-live-gsettings.h"
+#include <string.h>
+
+#define ADAPTER "datetime"
+static const char * const pages[] = { "datetime", NULL };
+
+static const char * const clock_format[] = { "24h", "12h", NULL };
+static const CcLumaGsRow rows[] = {
+  { "autoZone", "org.gnome.desktop.datetime", "automatic-timezone", CC_LUMA_GS_BOOLEAN },
+  { "h24", "org.gnome.desktop.interface", "clock-format", CC_LUMA_GS_UNLESS, clock_format },
+  { "wday", "org.gnome.desktop.interface", "clock-show-weekday", CC_LUMA_GS_BOOLEAN },
+  { "date", "org.gnome.desktop.interface", "clock-show-date", CC_LUMA_GS_BOOLEAN },
+  { "secs", "org.gnome.desktop.interface", "clock-show-seconds", CC_LUMA_GS_BOOLEAN },
+  { "wnum", "org.gnome.desktop.calendar", "show-weekdate", CC_LUMA_GS_BOOLEAN },
+};
+
+typedef struct {
+  CcLumaFixture *model;
+  CcLumaGsTable *table;
+  GDBusProxy *timedated;
+  GCancellable *cancel;
+  gboolean zones, ready;
+} Clock;
+
+static void
+check_ready (Clock *c)
+{
+  if (c->ready || !c->zones || !c->timedated) return;
+  for (guint i = 0; i < G_N_ELEMENTS (rows); i++)
+    if (!cc_luma_gs_table_covers (c->table, rows[i].key)) return; /* a schema is missing */
+  c->ready = TRUE;
+  cc_luma_live_ready (c->model, ADAPTER);
+}
+
+static void
+publish (Clock *c)
+{
+  g_autoptr (GVariant) ntp = g_dbus_proxy_get_cached_property (c->timedated, "NTP");
+  g_autoptr (GVariant) zone = g_dbus_proxy_get_cached_property (c->timedated, "Timezone");
+  g_autoptr (GVariant) can_ntp = g_dbus_proxy_get_cached_property (c->timedated, "CanNTP");
+  if (!ntp || !zone) return;
+  cc_luma_fixture_publish_boolean (c->model, "autoTime", g_variant_get_boolean (ntp));
+  cc_luma_fixture_publish_string (c->model, "zone", g_variant_get_string (zone, NULL));
+  cc_luma_fixture_publish_boolean (c->model, "canNtp", !can_ntp || g_variant_get_boolean (can_ntp));
+  check_ready (c);
+}
+
+/* v70's CFZONE pairs: zone id and the city it is named after. */
+static char *
+city_of (const char *zone)
+{
+  const char *slash = strrchr (zone, '/');
+  g_autofree char *city = g_strdup (slash ? slash + 1 : zone);
+  g_strdelimit (city, "_", ' ');
+  return g_steal_pointer (&city);
+}
+
+static void
+zones_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) out = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Clock *c = data;
+  g_autoptr (JsonArray) list = json_array_new ();
+  if (out)
+    {
+      g_autoptr (GVariantIter) iter = NULL;
+      const char *zone;
+      g_variant_get (out, "(as)", &iter);
+      while (g_variant_iter_next (iter, "&s", &zone))
+        {
+          /* The zone chooser offers places, not the legacy aliases. */
+          if (!strchr (zone, '/') || g_str_has_prefix (zone, "Etc/") || g_str_has_prefix (zone, "SystemV/")) continue;
+          JsonArray *pair = json_array_new ();
+          g_autofree char *city = city_of (zone);
+          json_array_add_string_element (pair, zone);
+          json_array_add_string_element (pair, city);
+          json_array_add_array_element (list, pair);
+        }
+    }
+  else
+    g_warning ("Settings: time zones: %s", error->message);
+  g_autoptr (JsonNode) node = json_node_init_array (json_node_alloc (), list);
+  cc_luma_fixture_publish_data (c->model, "CFZONE", node);
+  c->zones = TRUE;
+  check_ready (c);
+}
+
+static void
+proxy_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Clock *c = data;
+  if (!proxy) { g_warning ("Settings: timedated: %s", error->message); return; }
+  c->timedated = proxy;
+  g_signal_connect_swapped (proxy, "g-properties-changed", G_CALLBACK (publish), c);
+  publish (c);
+  g_dbus_proxy_call (proxy, "ListTimezones", NULL, G_DBUS_CALL_FLAGS_NONE, -1, c->cancel, zones_done, c);
+}
+
+static void
+set_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) out = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  if (error) g_message ("Settings: could not change the time settings: %s", error->message);
+  publish (data);
+}
+
+static gboolean
+clock_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Clock *c = state;
+  GType type = value && JSON_NODE_HOLDS_VALUE (value) ? json_node_get_value_type (value) : G_TYPE_INVALID;
+  if (cc_luma_gs_table_covers (c->table, key)) return cc_luma_gs_table_write (c->table, key, value, error);
+  if (!g_str_equal (key, "autoTime") && !g_str_equal (key, "zone")) return FALSE;
+  if (!c->timedated)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED, "The time service isn’t available");
+      return FALSE;
+    }
+  /* cc-datetime-page.c: SetNTP / SetTimezone with user interaction. */
+  if (g_str_equal (key, "autoTime"))
+    {
+      if (type != G_TYPE_BOOLEAN) goto invalid;
+      g_dbus_proxy_call (c->timedated, "SetNTP", g_variant_new ("(bb)", json_node_get_boolean (value), TRUE),
+                         G_DBUS_CALL_FLAGS_ALLOW_INTERACTIVE_AUTHORIZATION, -1, c->cancel, set_done, c);
+      return TRUE;
+    }
+  {
+    g_autoptr (GTimeZone) tz = type == G_TYPE_STRING ? g_time_zone_new_identifier (json_node_get_string (value)) : NULL;
+    if (tz)
+      {
+        g_dbus_proxy_call (c->timedated, "SetTimezone", g_variant_new ("(sb)", json_node_get_string (value), TRUE),
+                           G_DBUS_CALL_FLAGS_ALLOW_INTERACTIVE_AUTHORIZATION, -1, c->cancel, set_done, c);
+        return TRUE;
+      }
+  }
+invalid:
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "%s can’t take that value", key);
+  return FALSE;
+}
+
+static gpointer
+clock_start (CcLumaFixture *model)
+{
+  Clock *c = g_new0 (Clock, 1);
+  c->model = model;
+  c->cancel = g_cancellable_new ();
+  c->table = cc_luma_gs_table_new (model, rows, G_N_ELEMENTS (rows));
+  cc_luma_fixture_own_key (model, "autoTime");
+  cc_luma_fixture_own_key (model, "zone");
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_NONE, NULL, "org.freedesktop.timedate1",
+                            "/org/freedesktop/timedate1", "org.freedesktop.timedate1", c->cancel, proxy_ready, c);
+  return c;
+}
+
+static void
+clock_stop (gpointer state)
+{
+  Clock *c = state;
+  g_cancellable_cancel (c->cancel);
+  g_clear_object (&c->cancel);
+  if (c->timedated) g_signal_handlers_disconnect_by_data (c->timedated, c);
+  g_clear_object (&c->timedated);
+  cc_luma_gs_table_free (c->table);
+  g_free (c);
+}
+
+const CcLumaAdapter cc_luma_adapter_datetime = { ADAPTER, pages, clock_start, clock_write, clock_stop };
diff --git a/shell/cc-luma-live-displays.c b/shell/cc-luma-live-displays.c
new file mode 100644
index 0000000..949c048
--- /dev/null
+++ b/shell/cc-luma-live-displays.c
@@ -0,0 +1,494 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Displays: Mutter's DisplayConfig through the display panel's
+ * CcDisplayConfigManager. Each change is made on a fresh copy of the current
+ * configuration and applied with cc_display_config_apply, as the panel's
+ * Apply does; the page's own 15-second keep-or-go-back bar puts the old
+ * values back through the same path.
+ *
+ * Every usable display is published: the built-in one as "int", external
+ * ones as "ext", "ext2", … in Mutter's order, each with its logical
+ * rectangle for the diagram and the scales its mode supports. Colour
+ * profiles (colord) and brightness have no owner here and are left out. */
+#include "cc-luma-live-gsettings.h"
+#include "cc-luma-displays.h"
+#include "panels/display/cc-display-config-manager.h"
+#include "panels/display/cc-display-config.h"
+#include "panels/display/cc-display-arrangement.h"
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef struct {
+  CcLumaFixture *model;
+  CcDisplayConfigManager *manager;
+  gboolean selected;
+  CcLumaReadyGate *gate;
+} Displays;
+
+static const char *rotations[] = { "Landscape", "Portrait right", "Landscape, flipped", "Portrait left" };
+static const CcDisplayRotation rotation_values[] = { CC_DISPLAY_ROTATION_NONE, CC_DISPLAY_ROTATION_90,
+                                                     CC_DISPLAY_ROTATION_180, CC_DISPLAY_ROTATION_270 };
+
+#define MAX_DISPLAYS 8
+/* The usable monitors in page order (built-in first) and their ids. */
+static guint
+displays_of (CcDisplayConfig *config, CcDisplayMonitor **monitors, char ids[][8])
+{
+  guint n = 0, external = 0;
+  GList *all = config ? cc_display_config_get_monitors (config) : NULL;
+  for (int pass = 0; pass < 2; pass++)
+    for (GList *l = all; l && n < MAX_DISPLAYS; l = l->next)
+      {
+        if (!cc_display_monitor_is_usable (l->data) || cc_display_monitor_is_builtin (l->data) != (pass == 0)) continue;
+        if (pass == 0 && n) continue; /* one built-in panel */
+        monitors[n] = l->data;
+        if (pass == 0) g_strlcpy (ids[n], "int", 8);
+        else if (external++ == 0) g_strlcpy (ids[n], "ext", 8);
+        else g_snprintf (ids[n], 8, "ext%u", external);
+        n++;
+      }
+  return n;
+}
+
+static CcDisplayMonitor *
+monitor_by_id (CcDisplayConfig *config, const char *id)
+{
+  CcDisplayMonitor *monitors[MAX_DISPLAYS];
+  char ids[MAX_DISPLAYS][8];
+  guint n = displays_of (config, monitors, ids);
+  for (guint i = 0; id && i < n; i++)
+    if (g_str_equal (ids[i], id)) return monitors[i];
+  return NULL;
+}
+
+static char *
+resolution_text (CcDisplayMode *mode)
+{
+  int w, h;
+  cc_display_mode_get_resolution (mode, &w, &h);
+  return g_strdup_printf ("%d × %d", w, h);
+}
+
+static char *
+rate_text (CcDisplayMode *mode)
+{
+  return g_strdup_printf ("%d Hz", (int) round (cc_display_mode_get_freq_f (mode)));
+}
+
+static void
+add_unique (JsonArray *array, const char *text)
+{
+  for (guint i = 0; i < json_array_get_length (array); i++)
+    if (g_str_equal (json_array_get_string_element (array, i), text)) return;
+  json_array_add_string_element (array, text);
+}
+
+static void layout_box (CcDisplayConfig *config, CcDisplayMonitor *m, int *x, int *y, int *w, int *h);
+
+static JsonObject *
+catalog (CcDisplayConfig *config, CcDisplayMonitor *monitor)
+{
+  JsonObject *item = json_object_new ();
+  CcDisplayMode *current = cc_display_monitor_get_mode (monitor);
+  CcDisplayMode *preferred = cc_display_monitor_get_preferred_mode (monitor);
+  int w = 0, h = 0, pw = 0, ph = 0, cw = 0, ch = 0;
+  if (preferred) cc_display_mode_get_resolution (preferred, &pw, &ph);
+  if (current) cc_display_mode_get_resolution (current, &cw, &ch);
+  json_object_set_string_member (item, "n", cc_display_monitor_get_display_name (monitor));
+  cc_display_monitor_get_physical_size (monitor, &w, &h);
+  g_autofree char *size = w > 0 && h > 0 ? g_strdup_printf ("%.0f″", sqrt ((double) w * w + (double) h * h) / 25.4) : NULL;
+  const char *connector = cc_display_monitor_get_connector_name (monitor);
+  g_autofree char *meta = size ? g_strdup_printf ("%s · %s", size, connector) : g_strdup (connector);
+  json_object_set_string_member (item, "m", meta);
+  json_object_set_int_member (item, "w", pw);
+  json_object_set_int_member (item, "h", ph);
+  JsonArray *res = json_array_new (), *hz = json_array_new ();
+  for (GList *l = cc_display_monitor_get_modes (monitor); l; l = l->next)
+    {
+      int mw, mh;
+      if (cc_display_mode_is_interlaced (l->data)) continue;
+      cc_display_mode_get_resolution (l->data, &mw, &mh);
+      g_autofree char *r = resolution_text (l->data);
+      add_unique (res, r);
+      if (mw == cw && mh == ch) { g_autofree char *f = rate_text (l->data); add_unique (hz, f); }
+    }
+  json_object_set_array_member (item, "res", res);
+  json_object_set_array_member (item, "hz", hz);
+  int x, y, lw, lh;
+  layout_box (config, monitor, &x, &y, &lw, &lh);
+  json_object_set_int_member (item, "x", x);
+  json_object_set_int_member (item, "y", y);
+  json_object_set_int_member (item, "lw", lw);
+  json_object_set_int_member (item, "lh", lh);
+  JsonArray *scales = json_array_new ();
+  g_autoptr (GArray) supported = current ? cc_display_mode_get_supported_scales (current) : NULL;
+  for (guint i = 0; supported && i < supported->len; i++)
+    {
+      g_autofree char *percent = g_strdup_printf ("%d", (int) round (g_array_index (supported, double, i) * 100));
+      add_unique (scales, percent);
+    }
+  json_object_set_array_member (item, "scales", scales);
+  return item;
+}
+
+static void
+publish_monitor (Displays *self, const char *id, CcDisplayMonitor *monitor)
+{
+  CcDisplayMode *mode = cc_display_monitor_get_mode (monitor);
+  g_autofree char *res = mode ? resolution_text (mode) : NULL, *hz = mode ? rate_text (mode) : NULL;
+  g_autofree char *scale = g_strdup_printf ("%d", (int) round (cc_display_monitor_get_scale (monitor) * 100));
+  const char *rotation = NULL;
+  for (guint i = 0; i < G_N_ELEMENTS (rotation_values); i++)
+    if (cc_display_monitor_get_rotation (monitor) == rotation_values[i]) rotation = rotations[i];
+  struct { const char *field; const char *value; } texts[] = { { "res", res }, { "hz", hz }, { "scale", scale }, { "rot", rotation } };
+  for (guint i = 0; i < G_N_ELEMENTS (texts); i++)
+    {
+      g_autofree char *key = g_strdup_printf ("d.%s.%s", id, texts[i].field);
+      if (texts[i].value) cc_luma_fixture_publish_string (self->model, key, texts[i].value);
+      else { g_autoptr (JsonNode) none = json_node_init_null (json_node_alloc ()); cc_luma_fixture_publish (self->model, key, none); }
+    }
+  g_autofree char *primary = g_strdup_printf ("d.%s.primary", id);
+  cc_luma_fixture_publish_boolean (self->model, primary, cc_display_monitor_is_primary (monitor));
+  /* Its logical position, for dragging it in the diagram. */
+  int px, py, pw, ph;
+  cc_display_monitor_get_geometry (monitor, &px, &py, &pw, &ph);
+  g_autofree char *pos_key = g_strdup_printf ("d.%s.pos", id), *pos = g_strdup_printf ("%d,%d", px, py);
+  cc_luma_fixture_publish_string (self->model, pos_key, pos);
+  g_autofree char *hdr = g_strdup_printf ("d.%s.hdr", id);
+  if (cc_display_monitor_supports_color_mode (monitor, CC_DISPLAY_COLOR_MODE_BT2100))
+    cc_luma_fixture_publish_boolean (self->model, hdr, cc_display_monitor_get_color_mode (monitor) == CC_DISPLAY_COLOR_MODE_BT2100);
+  else { g_autoptr (JsonNode) none = json_node_init_null (json_node_alloc ()); cc_luma_fixture_publish (self->model, hdr, none); }
+  cc_luma_fixture_own_key (self->model, hdr);
+  const char *fields[] = { "res", "hz", "scale", "rot", "primary", "pos" };
+  for (guint i = 0; i < G_N_ELEMENTS (fields); i++)
+    {
+      g_autofree char *key = g_strdup_printf ("d.%s.%s", id, fields[i]);
+      cc_luma_fixture_own_key (self->model, key);
+    }
+}
+
+static void
+publish (Displays *self)
+{
+  g_autoptr (CcDisplayConfig) config = cc_display_config_manager_get_current (self->manager);
+  CcDisplayMonitor *monitors[MAX_DISPLAYS];
+  char ids[MAX_DISPLAYS][8];
+  guint n = displays_of (config, monitors, ids);
+  if (!n) return;
+  JsonObject *displays = json_object_new ();
+  for (guint i = 0; i < n; i++) json_object_set_object_member (displays, ids[i], catalog (config, monitors[i]));
+  g_autoptr (JsonNode) node = json_node_init_object (json_node_alloc (), displays);
+  json_object_unref (displays);
+  /* The display fields first, so the new catalog never lacks its values. */
+  for (guint i = 0; i < n; i++) publish_monitor (self, ids[i], monitors[i]);
+  cc_luma_fixture_publish_data (self->model, "CFDISP", node);
+  if (n >= 2) cc_luma_fixture_publish_string (self->model, "join", cc_display_config_is_cloning (config) ? "mirror" : "join");
+  else { g_autoptr (JsonNode) none = json_node_init_null (json_node_alloc ()); cc_luma_fixture_publish (self->model, "join", none); }
+  /* The page shows the main display first, then keeps the person's choice. */
+  JsonNode *selected = cc_luma_fixture_get (self->model, "dsel");
+  gboolean known = FALSE;
+  for (guint i = 0; selected && JSON_NODE_HOLDS_VALUE (selected) && i < n; i++) known |= g_str_equal (json_node_get_string (selected), ids[i]);
+  if (!self->selected || !known)
+    for (guint i = 0; i < n; i++)
+      if (cc_display_monitor_is_primary (monitors[i]) || i == n - 1) { cc_luma_fixture_publish_string (self->model, "dsel", ids[i]); break; }
+  self->selected = TRUE;
+  if (n != 2) return;
+  /* Where the second display sits against the first. */
+  int ix, iy, iw, ih, ex, ey, ew, eh;
+  cc_display_monitor_get_geometry (monitors[0], &ix, &iy, &iw, &ih);
+  cc_display_monitor_get_geometry (monitors[1], &ex, &ey, &ew, &eh);
+  const char *side = ey + eh <= iy ? "top" : ex + ew <= ix ? "left" : "right";
+  double span = g_str_equal (side, "top") ? iw - ew : ih - eh;
+  double offset = (g_str_equal (side, "top") ? ex - ix : ey - iy) / (span ? span : 1);
+  cc_luma_fixture_publish_string (self->model, "arr.side", side);
+  cc_luma_fixture_publish_double (self->model, "arr.off", isfinite (offset) ? CLAMP (offset, -.2, 1.2) : .5);
+}
+
+static void changed (CcDisplayConfigManager *manager, Displays *self) { publish (self); }
+
+static gpointer
+displays_start (CcLumaFixture *model)
+{
+  Displays *self = g_new0 (Displays, 1);
+  self->model = g_object_ref (model);
+  self->manager = cc_display_config_manager_new ();
+  g_signal_connect (self->manager, "changed", G_CALLBACK (changed), self);
+  const char *keys[] = { "join", "dsel", "arr.side", "arr.off" };
+  for (guint i = 0; i < G_N_ELEMENTS (keys); i++) cc_luma_fixture_own_key (model, keys[i]);
+  publish (self);
+  self->gate = cc_luma_ready_gate_new (model, "displays", cc_luma_displays_validate);
+  return self;
+}
+
+/* The layout starts at 0,0, as Mutter requires. */
+static void
+normalize (CcDisplayConfig *config)
+{
+  int min_x = G_MAXINT, min_y = G_MAXINT;
+  for (GList *l = cc_display_config_get_monitors (config); l; l = l->next)
+    {
+      int x, y, w, h;
+      if (!cc_display_monitor_is_active (l->data)) continue;
+      cc_display_monitor_get_geometry (l->data, &x, &y, &w, &h);
+      min_x = MIN (min_x, x); min_y = MIN (min_y, y);
+    }
+  if (min_x == G_MAXINT || (min_x == 0 && min_y == 0)) return;
+  for (GList *l = cc_display_config_get_monitors (config); l; l = l->next)
+    {
+      int x, y, w, h;
+      if (!cc_display_monitor_is_active (l->data)) continue;
+      cc_display_monitor_get_geometry (l->data, &x, &y, &w, &h);
+      cc_display_monitor_set_position (l->data, x - min_x, y - min_y);
+    }
+}
+
+/* After joining: GNOME's own snapping, then 0,0. */
+static void
+snap_and_normalize (CcDisplayConfig *config)
+{
+  cc_display_config_snap_outputs (config);
+  normalize (config);
+}
+
+/* As cc-display-arrangement.c's get_scaled_geometry: the monitor's box in
+ * the layout's own units (logical layouts divide by the scale; portrait
+ * modes swap). */
+static void
+layout_box (CcDisplayConfig *config, CcDisplayMonitor *m, int *x, int *y, int *w, int *h)
+{
+  cc_display_monitor_get_geometry (m, x, y, w, h);
+  if (cc_display_config_is_layout_logical (config))
+    {
+      double scale = cc_display_monitor_get_scale (m);
+      *w = (int) round (*w / scale);
+      *h = (int) round (*h / scale);
+    }
+  CcDisplayRotation r = cc_display_monitor_get_rotation (m);
+  if (r == CC_DISPLAY_ROTATION_90 || r == CC_DISPLAY_ROTATION_270 || r == CC_DISPLAY_ROTATION_90_FLIPPED || r == CC_DISPLAY_ROTATION_270_FLIPPED)
+    { int t = *w; *w = *h; *h = t; }
+}
+
+static gboolean
+overlaps (int ax, int ay, int aw, int ah, int bx, int by, int bw, int bh)
+{
+  return ax < bx + bw && bx < ax + aw && ay < by + bh && by < ay + ah;
+}
+
+/* A dragged monitor lands on the nearest edge of another, as GNOME's
+ * arrangement snaps it: beside or above/below, touching, aligned with that
+ * monitor's edges when within SNAP of them, overlapping none. */
+#define SNAP 64
+static void
+snap_dragged (CcDisplayConfig *config, CcDisplayMonitor *moved)
+{
+  int x, y, w, h, best_x = 0, best_y = 0;
+  double best = INFINITY;
+  layout_box (config, moved, &x, &y, &w, &h);
+  for (GList *l = cc_display_config_get_monitors (config); l; l = l->next)
+    {
+      int ox, oy, ow, oh;
+      if (l->data == moved || !cc_display_monitor_is_active (l->data)) continue;
+      layout_box (config, l->data, &ox, &oy, &ow, &oh);
+      int cy = CLAMP (y, oy - h + 1, oy + oh - 1), cx = CLAMP (x, ox - w + 1, ox + ow - 1);
+      if (abs (cy - oy) < SNAP) cy = oy; else if (abs (cy + h - oy - oh) < SNAP) cy = oy + oh - h;
+      if (abs (cx - ox) < SNAP) cx = ox; else if (abs (cx + w - ox - ow) < SNAP) cx = ox + ow - w;
+      int candidates[4][2] = { { ox + ow, cy }, { ox - w, cy }, { cx, oy + oh }, { cx, oy - h } };
+      for (guint c = 0; c < 4; c++)
+        {
+          gboolean clear = TRUE;
+          for (GList *m = cc_display_config_get_monitors (config); m && clear; m = m->next)
+            {
+              int mx, my, mw, mh;
+              if (m->data == moved || !cc_display_monitor_is_active (m->data)) continue;
+              layout_box (config, m->data, &mx, &my, &mw, &mh);
+              clear = !overlaps (candidates[c][0], candidates[c][1], w, h, mx, my, mw, mh);
+            }
+          double d = hypot (candidates[c][0] - x, candidates[c][1] - y);
+          if (clear && d < best) { best = d; best_x = candidates[c][0]; best_y = candidates[c][1]; }
+        }
+    }
+  if (isfinite (best)) cc_display_monitor_set_position (moved, best_x, best_y);
+}
+
+static CcDisplayMode *
+find_mode (CcDisplayMonitor *monitor, int w, int h, double hz)
+{
+  CcDisplayMode *best = NULL;
+  double distance = INFINITY;
+  for (GList *l = cc_display_monitor_get_modes (monitor); l; l = l->next)
+    {
+      int mw, mh;
+      cc_display_mode_get_resolution (l->data, &mw, &mh);
+      if (mw != w || mh != h || cc_display_mode_is_interlaced (l->data)) continue;
+      double d = fabs (cc_display_mode_get_freq_f (l->data) - hz);
+      if (d < distance) { distance = d; best = l->data; }
+    }
+  return best;
+}
+
+static gboolean
+refuse (GError **error, const char *message)
+{
+  g_message ("Displays: %s", message);
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, message);
+  return FALSE;
+}
+
+static gboolean
+displays_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Displays *self = state;
+  if (g_str_equal (key, "dsel")) return TRUE; /* which display the page shows: nothing to apply */
+  gboolean ours = g_str_equal (key, "join") || g_str_has_prefix (key, "arr.") || (g_str_has_prefix (key, "d.") && strchr (key + 2, '.'));
+  if (!ours) return FALSE;
+  if (!cc_display_config_manager_get_apply_allowed (self->manager)) return refuse (error, "Display changes aren’t allowed now");
+  g_autoptr (CcDisplayConfig) config = cc_display_config_manager_get_current (self->manager);
+  CcDisplayMonitor *monitors[MAX_DISPLAYS];
+  char ids[MAX_DISPLAYS][8];
+  guint n = displays_of (config, monitors, ids);
+  if (!n) return refuse (error, "The displays changed");
+  GType type = value && JSON_NODE_HOLDS_VALUE (value) ? json_node_get_value_type (value) : G_TYPE_INVALID;
+  const char *text = type == G_TYPE_STRING ? json_node_get_string (value) : NULL;
+  const char *field = NULL;
+  CcDisplayMonitor *monitor = NULL;
+  if (g_str_has_prefix (key, "d."))
+    {
+      g_autofree char *id = g_strndup (key + 2, strchr (key + 2, '.') - (key + 2));
+      field = strchr (key + 2, '.') + 1;
+      monitor = monitor_by_id (config, id);
+      if (!monitor) return refuse (error, "That display isn’t connected");
+    }
+  /* The arrangement: the second of exactly two against the first. */
+  CcDisplayMonitor *internal = monitors[0], *external = n == 2 ? monitors[1] : NULL;
+  int ix, iy, iw, ih, ex = 0, ey = 0, ew = 0, eh = 0;
+  cc_display_monitor_get_geometry (internal, &ix, &iy, &iw, &ih);
+  if (external) cc_display_monitor_get_geometry (external, &ex, &ey, &ew, &eh);
+
+  if (g_str_equal (key, "join"))
+    {
+      if (g_strcmp0 (text, "mirror") == 0)
+        {
+          g_autolist (CcDisplayMode) modes = NULL;
+          cc_display_config_set_cloning (config, TRUE);
+          modes = cc_display_config_generate_cloning_modes (config);
+          if (!modes) return refuse (error, "These displays can’t show the same picture");
+          for (GList *l = cc_display_config_get_monitors (config); l; l = l->next)
+            cc_display_monitor_set_compatible_clone_mode (l->data, modes->data);
+        }
+      else if (g_strcmp0 (text, "join") == 0)
+        {
+          cc_display_config_set_cloning (config, FALSE);
+          for (GList *l = cc_display_config_get_monitors (config); l; l = l->next)
+            {
+              cc_display_monitor_set_active (l->data, cc_display_monitor_is_usable (l->data));
+              cc_display_monitor_set_mode (l->data, cc_display_monitor_get_preferred_mode (l->data));
+            }
+          snap_and_normalize (config);
+        }
+      else return refuse (error, "Unknown display arrangement");
+    }
+  else if (g_str_equal (key, "arr.side") || g_str_equal (key, "arr.off"))
+    {
+      if (!external) return refuse (error, "Drag works with two displays");
+      const char *side = g_str_equal (key, "arr.side") ? text : json_node_get_string (cc_luma_fixture_get (self->model, "arr.side"));
+      double off = g_str_equal (key, "arr.off") && (type == G_TYPE_DOUBLE || type == G_TYPE_INT64) ? json_node_get_double (value) :
+                   json_node_get_double (cc_luma_fixture_get (self->model, "arr.off"));
+      if (!isfinite (off) || !side) return refuse (error, "Invalid arrangement");
+      if (g_str_equal (side, "top")) cc_display_monitor_set_position (external, ix + (int) round ((iw - ew) * off), iy - eh);
+      else if (g_str_equal (side, "left")) cc_display_monitor_set_position (external, ix - ew, iy + (int) round ((ih - eh) * off));
+      else if (g_str_equal (side, "right")) cc_display_monitor_set_position (external, ix + iw, iy + (int) round ((ih - eh) * off));
+      else return refuse (error, "Invalid arrangement");
+      cc_display_config_snap_outputs (config);
+    }
+  else if (!g_strcmp0 (field, "res") || !g_strcmp0 (field, "hz"))
+    {
+      CcDisplayMode *mode = cc_display_monitor_get_mode (monitor);
+      int w = 0, h = 0;
+      double hz = mode ? cc_display_mode_get_freq_f (mode) : 60;
+      if (mode) cc_display_mode_get_resolution (mode, &w, &h);
+      if (!text) return refuse (error, "Invalid display mode");
+      if (!g_strcmp0 (field, "res"))
+        {
+          /* Split on " × " as the page writes it; sscanf's multibyte literal
+           * didn't match in the session's locale (VM run 20260930T231339-dp17-res-debug). */
+          g_auto (GStrv) parts = g_strsplit (text, " × ", -1);
+          char *a = NULL, *b = NULL;
+          guint64 pw = g_strv_length (parts) == 2 ? g_ascii_strtoull (parts[0], &a, 10) : 0;
+          guint64 ph = pw ? g_ascii_strtoull (parts[1], &b, 10) : 0;
+          if (!pw || !ph || *a || *b || pw > G_MAXINT || ph > G_MAXINT) return refuse (error, "Invalid resolution");
+          w = (int) pw; h = (int) ph;
+        }
+      if (!g_strcmp0 (field, "hz")) hz = g_ascii_strtod (text, NULL);
+      CcDisplayMode *next = find_mode (monitor, w, h, hz);
+      if (!next) return refuse (error, "The display has no such mode");
+      if (cc_display_config_is_cloning (config)) cc_display_config_set_mode_on_all_outputs (config, next);
+      else cc_display_monitor_set_mode (monitor, next);
+    }
+  else if (!g_strcmp0 (field, "scale"))
+    {
+      double scale = text ? g_ascii_strtod (text, NULL) / 100 : 0;
+      CcDisplayMode *mode = cc_display_monitor_get_mode (monitor);
+      /* The panel offers the mode's supported scales; take the nearest. */
+      g_autoptr (GArray) scales = mode ? cc_display_mode_get_supported_scales (mode) : NULL;
+      double best = 0;
+      for (guint i = 0; scales && i < scales->len; i++)
+        if (!best || fabs (g_array_index (scales, double, i) - scale) < fabs (best - scale)) best = g_array_index (scales, double, i);
+      if (!best || fabs (best - scale) > .05 || !cc_display_config_is_scaled_mode_valid (config, mode, best))
+        return refuse (error, "The display can’t use that scale");
+      cc_display_monitor_set_scale (monitor, best);
+    }
+  else if (!g_strcmp0 (field, "rot"))
+    {
+      gboolean set = FALSE;
+      for (guint i = 0; i < G_N_ELEMENTS (rotations) && !set; i++)
+        if (g_strcmp0 (text, rotations[i]) == 0 && cc_display_monitor_supports_rotation (monitor, rotation_values[i]))
+          cc_display_monitor_set_rotation (monitor, rotation_values[i]), set = TRUE;
+      if (!set) return refuse (error, "The display can’t turn that way");
+    }
+  else if (!g_strcmp0 (field, "pos"))
+    {
+      /* Dragged in the diagram: its new logical spot, then GNOME's snapping. */
+      int x, y;
+      if (!text || sscanf (text, "%d,%d", &x, &y) != 2) return refuse (error, "Invalid position");
+      cc_display_monitor_set_position (monitor, x, y);
+      snap_dragged (config, monitor);
+      normalize (config);
+    }
+  else if (!g_strcmp0 (field, "primary"))
+    {
+      if (type != G_TYPE_BOOLEAN) return refuse (error, "Invalid main display");
+      /* Making one display the main one already cleared the other. */
+      if (!json_node_get_boolean (value)) return TRUE;
+      cc_display_monitor_set_primary (monitor, TRUE);
+    }
+  else if (!g_strcmp0 (field, "hdr"))
+    {
+      CcDisplayColorMode mode = type == G_TYPE_BOOLEAN && json_node_get_boolean (value) ? CC_DISPLAY_COLOR_MODE_BT2100 : CC_DISPLAY_COLOR_MODE_DEFAULT;
+      if (!cc_display_monitor_supports_color_mode (monitor, mode)) return refuse (error, "This display has no HDR");
+      cc_display_monitor_set_color_mode (monitor, mode);
+    }
+  else
+    return refuse (error, "This display setting has no owner yet");
+  if (!cc_display_config_is_applicable (config)) return refuse (error, "The displays can’t take that arrangement");
+  if (!cc_display_config_apply (config, error))
+    {
+      g_message ("Displays: %s not applied: %s", key, error && *error ? (*error)->message : "no reason given");
+      return FALSE;
+    }
+  return TRUE;
+}
+
+static void
+displays_stop (gpointer state)
+{
+  Displays *self = state;
+  cc_luma_ready_gate_free (self->gate);
+  g_signal_handlers_disconnect_by_data (self->manager, self);
+  g_object_unref (self->manager);
+  g_object_unref (self->model);
+  g_free (self);
+}
+
+const CcLumaAdapter cc_luma_adapter_displays = {
+  "displays", (const char * const[]) { "displays", NULL }, displays_start, displays_write, displays_stop
+};
diff --git a/shell/cc-luma-live-gsettings.c b/shell/cc-luma-live-gsettings.c
new file mode 100644
index 0000000..b580c38
--- /dev/null
+++ b/shell/cc-luma-live-gsettings.c
@@ -0,0 +1,528 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-live-gsettings.h"
+#include "cc-luma-displays.h"
+#include "cc-luma-device-options.h"
+#include <math.h>
+#include <stdio.h>
+
+typedef struct {
+  const CcLumaGsRow *row;
+  GSettings *settings;
+  GVariantClass type;
+  char type_string[16];
+} Bound;
+
+struct _CcLumaGsTable {
+  CcLumaFixture *model;
+  GHashTable *settings; /* schema id → GSettings */
+  GHashTable *keys;     /* model key → Bound */
+  GPtrArray *bound;
+};
+
+static void
+key_type (Bound *b)
+{
+  g_autoptr (GVariant) value = g_settings_get_value (b->settings, b->row->name);
+  b->type = g_variant_classify (value);
+  g_strlcpy (b->type_string, g_variant_get_type_string (value), sizeof b->type_string);
+}
+
+static double
+number_of (GVariant *value)
+{
+  switch (g_variant_classify (value))
+    {
+    case G_VARIANT_CLASS_DOUBLE: return g_variant_get_double (value);
+    case G_VARIANT_CLASS_INT32: return g_variant_get_int32 (value);
+    case G_VARIANT_CLASS_UINT32: return g_variant_get_uint32 (value);
+    case G_VARIANT_CLASS_INT64: return g_variant_get_int64 (value);
+    case G_VARIANT_CLASS_UINT64: return g_variant_get_uint64 (value);
+    default: return NAN;
+    }
+}
+
+static GVariant *
+number_as (GVariantClass type, double number)
+{
+  switch (type)
+    {
+    case G_VARIANT_CLASS_DOUBLE: return g_variant_new_double (number);
+    case G_VARIANT_CLASS_INT32: return g_variant_new_int32 ((gint32) round (number));
+    case G_VARIANT_CLASS_UINT32: return number < 0 ? NULL : g_variant_new_uint32 ((guint32) round (number));
+    case G_VARIANT_CLASS_INT64: return g_variant_new_int64 ((gint64) round (number));
+    case G_VARIANT_CLASS_UINT64: return number < 0 ? NULL : g_variant_new_uint64 ((guint64) round (number));
+    default: return NULL;
+    }
+}
+
+/* Strings compare by their plain text; enums read back as their nick. */
+static char *
+text_of (GVariant *value)
+{
+  if (g_variant_is_of_type (value, G_VARIANT_TYPE_STRING))
+    return g_variant_dup_string (value, NULL);
+  return g_variant_print (value, FALSE);
+}
+
+static JsonNode *
+read_row (Bound *b)
+{
+  const CcLumaGsRow *row = b->row;
+  g_autoptr (GVariant) value = g_settings_get_value (b->settings, row->name);
+  JsonNode *node = json_node_alloc ();
+  switch (row->kind)
+    {
+    case CC_LUMA_GS_BOOLEAN:
+    case CC_LUMA_GS_NOT:
+      if (!g_variant_is_of_type (value, G_VARIANT_TYPE_BOOLEAN)) break;
+      return json_node_init_boolean (node, g_variant_get_boolean (value) != (row->kind == CC_LUMA_GS_NOT));
+    case CC_LUMA_GS_UNLESS:
+      {
+        g_autofree char *text = text_of (value);
+        return json_node_init_boolean (node, g_strcmp0 (text, row->choices[1]) != 0);
+      }
+    case CC_LUMA_GS_CHOICE:
+    case CC_LUMA_GS_CHOICE_INT:
+      {
+        g_autofree char *text = text_of (value);
+        for (guint i = 0; row->choices[i] && row->choices[i + 1]; i += 2)
+          if (g_str_equal (text, row->choices[i + 1]))
+            return row->kind == CC_LUMA_GS_CHOICE ? json_node_init_string (node, row->choices[i])
+                                                  : json_node_init_int (node, g_ascii_strtoll (row->choices[i], NULL, 10));
+        break;
+      }
+    case CC_LUMA_GS_LINEAR:
+      {
+        double number = number_of (value) * row->scale + row->offset;
+        if (!isfinite (number)) break;
+        return json_node_init_int (node, (gint64) round (CLAMP (number, row->low, row->high)));
+      }
+    case CC_LUMA_GS_DOUBLE:
+      if (!isfinite (number_of (value))) break;
+      return json_node_init_double (node, number_of (value));
+    case CC_LUMA_GS_MINUTES:
+      {
+        double seconds = number_of (value);
+        if (!isfinite (seconds) || seconds < 0 || fmod (seconds, 60) != 0) break;
+        g_autofree char *text = g_strdup_printf ("%.0f", seconds / 60);
+        return json_node_init_string (node, text);
+      }
+    case CC_LUMA_GS_HOURS:
+      {
+        double hours = number_of (value);
+        if (!isfinite (hours) || hours < 0 || hours >= 24) break;
+        int minutes = (int) round (hours * 60) % (24 * 60);
+        g_autofree char *text = g_strdup_printf ("%02d:%02d", minutes / 60, minutes % 60);
+        return json_node_init_string (node, text);
+      }
+    case CC_LUMA_GS_ABOVE:
+      if (!isfinite (number_of (value))) break;
+      return json_node_init_boolean (node, number_of (value) > row->offset);
+    }
+  return json_node_init_null (node);
+}
+
+static GVariant *
+choice_variant (Bound *b, const char *text)
+{
+  if (b->type == G_VARIANT_CLASS_STRING) return g_variant_new_string (text);
+  return g_variant_parse (G_VARIANT_TYPE (b->type_string), text, NULL, NULL, NULL);
+}
+
+static GVariant *
+write_value (Bound *b, JsonNode *value)
+{
+  const CcLumaGsRow *row = b->row;
+  GType type = value && JSON_NODE_HOLDS_VALUE (value) ? json_node_get_value_type (value) : G_TYPE_INVALID;
+  switch (row->kind)
+    {
+    case CC_LUMA_GS_BOOLEAN:
+    case CC_LUMA_GS_NOT:
+      if (type != G_TYPE_BOOLEAN) return NULL;
+      return g_variant_new_boolean (json_node_get_boolean (value) != (row->kind == CC_LUMA_GS_NOT));
+    case CC_LUMA_GS_UNLESS:
+      if (type != G_TYPE_BOOLEAN) return NULL;
+      return choice_variant (b, row->choices[json_node_get_boolean (value) ? 0 : 1]);
+    case CC_LUMA_GS_CHOICE:
+    case CC_LUMA_GS_CHOICE_INT:
+      {
+        g_autofree char *wanted = NULL;
+        if (row->kind == CC_LUMA_GS_CHOICE && type == G_TYPE_STRING) wanted = g_strdup (json_node_get_string (value));
+        else if (row->kind == CC_LUMA_GS_CHOICE_INT && type == G_TYPE_INT64) wanted = g_strdup_printf ("%" G_GINT64_FORMAT, json_node_get_int (value));
+        for (guint i = 0; wanted && row->choices[i] && row->choices[i + 1]; i += 2)
+          if (g_str_equal (wanted, row->choices[i])) return choice_variant (b, row->choices[i + 1]);
+        return NULL;
+      }
+    case CC_LUMA_GS_LINEAR:
+      {
+        if (type != G_TYPE_INT64 && type != G_TYPE_DOUBLE) return NULL;
+        double model = json_node_get_double (value);
+        if (!isfinite (model) || model < row->low || model > row->high || row->scale == 0) return NULL;
+        return number_as (b->type, (model - row->offset) / row->scale);
+      }
+    case CC_LUMA_GS_DOUBLE:
+      if (type != G_TYPE_INT64 && type != G_TYPE_DOUBLE) return NULL;
+      return isfinite (json_node_get_double (value)) ? number_as (b->type, json_node_get_double (value)) : NULL;
+    case CC_LUMA_GS_MINUTES:
+      {
+        char *end;
+        if (type != G_TYPE_STRING) return NULL;
+        gint64 minutes = g_ascii_strtoll (json_node_get_string (value), &end, 10);
+        if (*end || !*json_node_get_string (value) || minutes < 0 || minutes > G_MAXINT32 / 60) return NULL;
+        return number_as (b->type, minutes * 60.0);
+      }
+    case CC_LUMA_GS_HOURS:
+      {
+        int hours, minutes;
+        char tail;
+        if (type != G_TYPE_STRING || sscanf (json_node_get_string (value), "%2d:%2d%c", &hours, &minutes, &tail) != 2 ||
+            hours < 0 || hours > 23 || minutes < 0 || minutes > 59) return NULL;
+        return number_as (b->type, hours + minutes / 60.0);
+      }
+    case CC_LUMA_GS_ABOVE:
+      if (type != G_TYPE_BOOLEAN) return NULL;
+      return number_as (b->type, json_node_get_boolean (value) ? row->scale : row->offset);
+    }
+  return NULL;
+}
+
+static void
+publish (CcLumaGsTable *table, Bound *b)
+{
+  g_autoptr (JsonNode) node = read_row (b);
+  cc_luma_fixture_publish (table->model, b->row->key, node);
+}
+
+static void
+settings_changed (GSettings *settings, const char *name, CcLumaGsTable *table)
+{
+  for (guint i = 0; i < table->bound->len; i++)
+    {
+      Bound *b = g_ptr_array_index (table->bound, i);
+      if (b->settings == settings && g_str_equal (b->row->name, name)) publish (table, b);
+    }
+}
+
+static GSettings *
+open_schema (CcLumaGsTable *table, const char *id, const char *name)
+{
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = source ? g_settings_schema_source_lookup (source, id, TRUE) : NULL;
+  if (!schema || !g_settings_schema_has_key (schema, name)) return NULL;
+  GSettings *settings = g_hash_table_lookup (table->settings, id);
+  if (!settings)
+    {
+      settings = g_settings_new_full (schema, NULL, NULL);
+      g_signal_connect (settings, "changed", G_CALLBACK (settings_changed), table);
+      g_hash_table_insert (table->settings, g_strdup (id), settings);
+    }
+  return settings;
+}
+
+CcLumaGsTable *
+cc_luma_gs_table_new (CcLumaFixture *model, const CcLumaGsRow *rows, guint n_rows)
+{
+  CcLumaGsTable *table = g_new0 (CcLumaGsTable, 1);
+  table->model = g_object_ref (model);
+  table->settings = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_object_unref);
+  table->keys = g_hash_table_new (g_str_hash, g_str_equal);
+  table->bound = g_ptr_array_new_with_free_func (g_free);
+  for (guint i = 0; i < n_rows; i++)
+    {
+      GSettings *settings = open_schema (table, rows[i].schema, rows[i].name);
+      if (!settings || g_hash_table_contains (table->keys, rows[i].key)) continue;
+      Bound *b = g_new0 (Bound, 1);
+      b->row = &rows[i];
+      b->settings = settings;
+      key_type (b);
+      g_ptr_array_add (table->bound, b);
+      g_hash_table_insert (table->keys, (gpointer) rows[i].key, b);
+      cc_luma_fixture_own_key (model, rows[i].key);
+      publish (table, b);
+    }
+  return table;
+}
+
+gboolean
+cc_luma_gs_table_covers (CcLumaGsTable *table, const char *key)
+{
+  return table && key && g_hash_table_contains (table->keys, key);
+}
+
+gboolean
+cc_luma_gs_table_write (CcLumaGsTable *table, const char *key, JsonNode *value, GError **error)
+{
+  Bound *b = table && key ? g_hash_table_lookup (table->keys, key) : NULL;
+  if (!b) return FALSE;
+  if (!g_settings_is_writable (b->settings, b->row->name))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "%s is locked by policy", key);
+      return FALSE;
+    }
+  g_autoptr (GVariant) variant = write_value (b, value);
+  if (variant) g_variant_ref_sink (variant);
+  if (variant && !g_variant_is_of_type (variant, G_VARIANT_TYPE (b->type_string)))
+    g_clear_pointer (&variant, g_variant_unref);
+  if (!variant)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "%s can’t take that value", key);
+      return FALSE;
+    }
+  if (!g_settings_set_value (b->settings, b->row->name, variant))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "%s refused that value", key);
+      return FALSE;
+    }
+  return TRUE;
+}
+
+void
+cc_luma_gs_table_free (CcLumaGsTable *table)
+{
+  if (!table) return;
+  GHashTableIter iter;
+  gpointer settings;
+  g_hash_table_iter_init (&iter, table->settings);
+  while (g_hash_table_iter_next (&iter, NULL, &settings))
+    g_signal_handlers_disconnect_by_data (settings, table);
+  g_hash_table_unref (table->settings);
+  g_hash_table_unref (table->keys);
+  g_ptr_array_unref (table->bound);
+  g_object_unref (table->model);
+  g_free (table);
+}
+
+/* ── Ready gate ────────────────────────────────────────────────────── */
+struct _CcLumaReadyGate {
+  CcLumaFixture *model;
+  char *adapter;
+  gboolean (*valid) (CcLumaFixture *model);
+  gulong handler;
+};
+
+static void
+gate_check (CcLumaReadyGate *gate)
+{
+  if (!gate->handler || !gate->valid (gate->model)) return;
+  g_clear_signal_handler (&gate->handler, gate->model);
+  g_debug ("Settings live: %s is ready", gate->adapter);
+  cc_luma_live_ready (gate->model, gate->adapter);
+}
+
+CcLumaReadyGate *
+cc_luma_ready_gate_new (CcLumaFixture *model, const char *adapter, gboolean (*valid) (CcLumaFixture *model))
+{
+  CcLumaReadyGate *gate = g_new0 (CcLumaReadyGate, 1);
+  gate->model = g_object_ref (model);
+  gate->adapter = g_strdup (adapter);
+  gate->valid = valid;
+  gate->handler = g_signal_connect_swapped (model, "changed", G_CALLBACK (gate_check), gate);
+  cc_luma_fixture_changed (model);
+  return gate;
+}
+
+void
+cc_luma_ready_gate_free (CcLumaReadyGate *gate)
+{
+  if (!gate) return;
+  g_clear_signal_handler (&gate->handler, gate->model);
+  g_object_unref (gate->model);
+  g_free (gate->adapter);
+  g_free (gate);
+}
+
+/* ── The table ─────────────────────────────────────────────────────── */
