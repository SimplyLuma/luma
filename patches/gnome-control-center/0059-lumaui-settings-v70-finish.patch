+static GtkWidget *find (GtkWidget *w, GType type, const char *cls)
+{
+  if (G_TYPE_CHECK_INSTANCE_TYPE (w, type) && (!cls || gtk_widget_has_css_class (w, cls))) return w;
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c))
+    {
+      GtkWidget *hit = find (c, type, cls);
+      if (hit) return hit;
+    }
+  return NULL;
