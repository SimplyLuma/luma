+/* The System pages (v70 CFP me … about-sys): each renders from the fixture,
+ * the clock is the pinned one, locks follow their switches, and destructive
+ * actions ask first and only then act. */
+static GtkWidget *system_window (CcLumaFixture *model, const char *page, GtkWidget **view)
+{
+  g_autoptr (GError) error = NULL;
+  GtkWidget *window = gtk_window_new ();
+  *view = cc_luma_view_new (model, page, &error);
+  g_assert_no_error (error); g_assert_nonnull (*view);
+  gtk_window_set_child (GTK_WINDOW (window), *view);
+  gtk_window_set_default_size (GTK_WINDOW (window), 1180, 740);
+  gtk_window_present (GTK_WINDOW (window)); wait_ms (100);
+  return window;
+}
