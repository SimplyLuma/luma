+/* ── LUMA_SETTINGS_PERF=1: the Apps page's timings (development) ───── */
+/* Opens Apps from the page shown, logs the time to the first frame, then
+ * scrolls the page for four seconds and logs the frame times, renders and
+ * row widgets; quits. Lines start "PERF". */
+typedef struct {
+  View *v;
+  gint64 t0, first_frame, last, start;
+  GArray *frames;
+  GtkAdjustment *adj;
+  gulong paint, changed;
+  guint changes, renders_at_start, renders_seen;
+  double dir;
+  gint64 worst_render_frame, worst_plain_frame;
+} Perf;
+
+static guint
+count_widgets (GtkWidget *w)
+{
+  guint n = 1;
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c)) n += count_widgets (c);
+  return n;
+}
+
+static int
+by_value (gconstpointer a, gconstpointer b)
+{
+  gint64 x = *(const gint64 *) a, y = *(const gint64 *) b;
+  return x < y ? -1 : x > y;
+}
+
+static gboolean
+perf_finish (gpointer data)
+{
+  Perf *p = data;
+  GArray *f = p->frames;
+  g_array_sort (f, by_value);
+  gint64 sum = 0;
+  for (guint i = 0; i < f->len; i++) sum += g_array_index (f, gint64, i);
+  double avg = f->len ? sum / (double) f->len / 1000.0 : 0;
+  g_printerr ("PERF worst_frame_with_redraw=%.1fms worst_frame_without=%.1fms\n", p->worst_render_frame / 1000.0, p->worst_plain_frame / 1000.0);
+  g_printerr ("PERF scroll frames=%u avg=%.1fms fps=%.1f p50=%.1fms p95=%.1fms max=%.1fms renders=%u model_changes=%u widgets=%u\n",
+              f->len, avg, avg > 0 ? 1000.0 / avg : 0,
+              f->len ? g_array_index (f, gint64, f->len / 2) / 1000.0 : 0,
+              f->len ? g_array_index (f, gint64, (guint) (f->len * 0.95)) / 1000.0 : 0,
+              f->len ? g_array_index (f, gint64, f->len - 1) / 1000.0 : 0,
+              perf_renders - p->renders_at_start, p->changes, count_widgets (GTK_WIDGET (p->v->body)));
+  g_application_quit (g_application_get_default ());
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+perf_scroll (GtkWidget *widget, GdkFrameClock *clock, gpointer data)
+{
+  Perf *p = data;
+  gint64 now = gdk_frame_clock_get_frame_time (clock);
+  if (p->last)
+    {
+      gint64 frame = now - p->last;
+      g_array_append_val (p->frames, frame);
+      /* Frames that held a redraw, and the others. */
+      if (perf_renders != p->renders_seen) p->worst_render_frame = MAX (p->worst_render_frame, frame);
+      else p->worst_plain_frame = MAX (p->worst_plain_frame, frame);
+    }
+  p->renders_seen = perf_renders;
+  p->last = now;
+  double value = gtk_adjustment_get_value (p->adj) + 24 * p->dir;
+  double top = gtk_adjustment_get_upper (p->adj) - gtk_adjustment_get_page_size (p->adj);
+  if (value >= top) { value = top; p->dir = -1; }
+  if (value <= 0) { value = 0; p->dir = 1; }
+  gtk_adjustment_set_value (p->adj, value);
+  if (now - p->start < 4 * G_USEC_PER_SEC) return G_SOURCE_CONTINUE;
+  g_idle_add (perf_finish, p);
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+perf_start_scroll (gpointer data)
+{
+  Perf *p = data;
+  GtkWidget *scroller = gtk_widget_get_ancestor (GTK_WIDGET (p->v->body), GTK_TYPE_SCROLLED_WINDOW);
+  JsonNode *apps = json_object_get_member (cc_luma_fixture_get_data (p->v->model), "CFAPPS");
+  g_printerr ("PERF page=%s apps=%u widgets=%u renders=%u render_avg=%.1fms\n", p->v->page,
+              apps && JSON_NODE_HOLDS_ARRAY (apps) ? json_array_get_length (json_node_get_array (apps)) : 0,
+              count_widgets (GTK_WIDGET (p->v->body)), perf_renders, perf_renders ? perf_render_us / 1000.0 / perf_renders : 0);
+  if (!scroller) { perf_finish (p); return G_SOURCE_REMOVE; }
+  p->adj = gtk_scrolled_window_get_vadjustment (GTK_SCROLLED_WINDOW (scroller));
+  p->start = g_get_monotonic_time ();
+  p->dir = 1;
+  p->renders_at_start = p->renders_seen = perf_renders;
+  gtk_widget_add_tick_callback (scroller, perf_scroll, p, NULL);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+perf_painted (GdkFrameClock *clock, Perf *p)
+{
+  if (p->first_frame) return;
+  p->first_frame = g_get_monotonic_time ();
+  g_printerr ("PERF click_to_first_frame=%.1fms\n", (p->first_frame - p->t0) / 1000.0);
+  g_signal_handler_disconnect (clock, p->paint);
+  g_timeout_add (1500, perf_start_scroll, p);
+}
+
+static void
+perf_model_changed (Perf *p)
+{
+  p->changes++;
+}
+
+static GtkWidget *
+find_view (GtkWidget *w)
+{
+  if (g_object_get_data (G_OBJECT (w), "cf-view")) return w;
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c))
+    {
+      GtkWidget *found = find_view (c);
+      if (found) return found;
+    }
+  return NULL;
+}
+
+static gboolean
+perf_go (gpointer unused)
+{
+  GListModel *windows = gtk_window_get_toplevels ();
+  GtkWidget *root = NULL;
+  for (guint i = 0; !root && i < g_list_model_get_n_items (windows); i++)
+    {
+      g_autoptr (GtkWidget) w = g_list_model_get_item (windows, i);
+      root = find_view (w);
+    }
+  if (!root) { g_printerr ("PERF no view\n"); g_application_quit (g_application_get_default ()); return G_SOURCE_REMOVE; }
+  Perf *p = g_new0 (Perf, 1);
+  p->v = g_object_get_data (G_OBJECT (root), "cf-view");
+  p->frames = g_array_new (FALSE, FALSE, sizeof (gint64));
+  p->changed = g_signal_connect_swapped (p->v->model, "changed", G_CALLBACK (perf_model_changed), p);
+  GdkFrameClock *clock = gtk_widget_get_frame_clock (root);
+  p->t0 = g_get_monotonic_time ();
+  cc_luma_view_navigate (p->v, g_getenv ("LUMA_SETTINGS_PERF_PAGE") ? g_getenv ("LUMA_SETTINGS_PERF_PAGE") : "apps");
+  g_printerr ("PERF navigate_sync=%.1fms\n", (g_get_monotonic_time () - p->t0) / 1000.0);
+  if (clock) p->paint = g_signal_connect (clock, "after-paint", G_CALLBACK (perf_painted), p);
+  return G_SOURCE_REMOVE;
+}
+
+void
+cc_luma_view_apps_perf_arm (void)
+{
+  if (g_getenv ("LUMA_SETTINGS_PERF")) g_timeout_add_seconds (6, perf_go, NULL);
 }
