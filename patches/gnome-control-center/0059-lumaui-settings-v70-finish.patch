+static void region (View *v)
+{
+  JsonArray *langs = data_array (v, "CFLANG");
+  const char *fmt_id = cc_luma_view_text (v, "fmt");
+  JsonArray *fmt = format_of (v, fmt_id);
+  const char *fmt_name = fmt ? json_array_get_string_element (fmt, 0) : fmt_id;
+  g_autofree char *meta = g_strdup_printf ("%s · %s formats", pair_label (langs, cc_luma_view_text (v, "lang")), fmt_name);
+  cf_header (v, "Region & Language", meta, NULL);
+  if (fmt)
+    {
+      static const char *names[] = { "Date", "Time", "Number", "Money", "Measures", "Paper" };
+      GtkWidget *grid = gtk_grid_new ();
+      int columns = v->phone ? 2 : 3, at = 0;
+      gtk_widget_add_css_class (grid, "cf-fmt");
+      gtk_grid_set_column_homogeneous (GTK_GRID (grid), TRUE);
+      gtk_grid_set_column_spacing (GTK_GRID (grid), 20);
+      gtk_grid_set_row_spacing (GTK_GRID (grid), 16);
+      for (guint i = 0; i < G_N_ELEMENTS (names); i++)
+        {
+          GtkWidget *cell = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+          int span = i == 0 ? 2 : 1;
+          gtk_box_append (GTK_BOX (cell), cf_text (names[i], "cf-fmt-name"));
+          gtk_box_append (GTK_BOX (cell), cf_text (json_array_get_string_element (fmt, i + 1), "cf-fmt-value"));
+          if (at % columns + span > columns) at += columns - at % columns;
+          gtk_grid_attach (GTK_GRID (grid), cell, at % columns, at / columns, span, 1);
+          at += span;
+        }
+      cf_hero (v, grid, "cf-region-formats");
+    }
+  g_auto (GStrv) lang_choices = pair_choices (langs);
+  GStrvBuilder *b = g_strv_builder_new ();
+  JsonObject *data = cc_luma_fixture_get_data (v->model);
+  JsonObject *all = json_object_has_member (data, "CFFMT") ? json_object_get_object_member (data, "CFFMT") : NULL;
+  g_autoptr (GList) ids = all ? json_object_get_members (all) : NULL;
+  for (GList *l = ids; l; l = l->next)
+    {
+      g_strv_builder_add (b, l->data);
+      g_strv_builder_add (b, json_array_get_string_element (json_object_get_array_member (all, l->data), 0));
+    }
+  g_auto (GStrv) fmt_choices = g_strv_builder_end (b);
+  g_strv_builder_unref (b);
+  GtkBox *g = cf_group (v, "You", NULL);
+  pk (v, g, "lang", "Language", "Menus and windows", lang_choices);
+  pk (v, g, "fmt", "Formats", "Dates, times, numbers and money", fmt_choices);
+  g = cf_group (v, "Sign-in screen", NULL);
+  pk (v, g, "loginLang", "Language", "For everyone on this computer", lang_choices);
+}
