+/* Live: a minutes value outside v70's choices is shown as it is. */
+static char **with_current (View *v, const char *key, const char * const *choices)
+{
+  GPtrArray *all = g_ptr_array_new ();
+  const char *current = cc_luma_view_text (v, key);
+  gboolean listed = !cc_luma_fixture_is_live (v->model) || !*current;
+  for (guint i = 0; choices[i]; i += 2)
+    {
+      listed |= g_str_equal (choices[i], current);
+      g_ptr_array_add (all, g_strdup (choices[i]));
+      g_ptr_array_add (all, g_strdup (choices[i + 1]));
+    }
+  if (!listed)
+    {
+      gint64 minutes = g_ascii_strtoll (current, NULL, 10);
+      g_ptr_array_add (all, g_strdup (current));
+      g_ptr_array_add (all, minutes == 0 ? g_strdup ("Never") :
+                            minutes % 60 == 0 ? g_strdup_printf (minutes == 60 ? "%" G_GINT64_FORMAT " hour" : "%" G_GINT64_FORMAT " hours", minutes / 60) :
+                            g_strdup_printf (minutes == 1 ? "%" G_GINT64_FORMAT " minute" : "%" G_GINT64_FORMAT " minutes", minutes));
+    }
+  g_ptr_array_add (all, NULL);
+  return (char **) g_ptr_array_free (all, FALSE);
 }
