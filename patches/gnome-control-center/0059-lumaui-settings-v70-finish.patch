+/* Live pickers: the apps the system has for the type (CFDEFAPPS), after
+ * any fixed choices; a row only when the key has a value. */
+static GStrv live_choices (View *v, const char *key, const char * const *fixed)
+{
+  GStrvBuilder *builder = g_strv_builder_new ();
+  for (guint i = 0; fixed && fixed[i]; i++) g_strv_builder_add (builder, fixed[i]);
+  JsonNode *all = json_object_get_member (cc_luma_fixture_get_data (v->model), "CFDEFAPPS");
+  JsonNode *list = all && JSON_NODE_HOLDS_OBJECT (all) ? json_object_get_member (json_node_get_object (all), key) : NULL;
+  for (guint i = 0; list && JSON_NODE_HOLDS_ARRAY (list) && i < json_array_get_length (json_node_get_array (list)); i++)
+    {
+      JsonArray *pair = json_array_get_array_element (json_node_get_array (list), i);
+      g_strv_builder_add (builder, json_array_get_string_element (pair, 0));
+      g_strv_builder_add (builder, json_array_get_string_element (pair, 1));
+    }
+  GStrv out = g_strv_builder_end (builder);
+  g_strv_builder_unref (builder);
+  return out;
+}
+static void option_pk (View *v, GtkBox *card, const char *key, const char *title, const char * const *fixture, const char * const *fixed)
+{
+  if (!cc_luma_fixture_is_live (v->model)) { cf_pk (v, card, key, title, NULL, fixture); return; }
+  JsonNode *value = cc_luma_fixture_get (v->model, key);
+  if (!value || !JSON_NODE_HOLDS_VALUE (value)) return;
+  g_auto (GStrv) choices = live_choices (v, key, fixed);
+  cf_pk (v, card, key, title, NULL, (const char * const *) choices);
+}
