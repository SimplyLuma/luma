+/* v71 phone (Settings audit, 1 Oct): Back and the page are one title island, top left: ‹ (to the
+ * parent page, or the list) | the page and its summary. It replaces the "‹ parent" link and the big
+ * heading. v71 draws it only on a phone (html[data-phone]), never in a narrow desktop window, and
+ * not while searching. */
+gboolean cc_luma_view_island_mode (View *v)
+{
+#if defined (LUMA_TYPE_TITLE_ISLAND)
+  return v->phone && cc_luma_view_phone_device () && !(v->query && *v->query);
+#else
+  /* TODO(v71-kit title-island): K-C's LumaTitleIsland; until the kit has it a phone keeps .39's header. */
+  return FALSE;
+#endif
+}
+#if defined (LUMA_TYPE_TITLE_ISLAND)
+#define CF_ISLAND_BOTTOM 100 /* v71 .cfisl { top: 52px; height: 48px }, until the kit has placed it */
+#define CF_ISLAND_GAP 16     /* the page starts 16 under the island */
+static void island_lead (LumaTitleIsland *island, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  gboolean up = v->island_parent != NULL;
+  if (up)
+    {
+      g_autofree char *parent = g_strdup (v->island_parent);
+      if (v->live_lock || v->live_permission) gtk_widget_activate_action (root, "navigation.pop", NULL);
+      else go_to (root, parent);
+    }
+  else if (v->list_handler) v->list_handler (root, GTK_WIDGET (island), TRUE, v->list_data); /* v71 [data-cfislback]: the list */
+  /* A subpage's ‹ goes up one level, and only that: the list the island also leads must not take it. */
+  if (up) g_signal_stop_emission_by_name (island, "lead");
+}
+static void island_meta (GtkLabel *meta, GParamSpec *pspec, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v || !v->island || v->subtitle != meta) return;
+  const char *text = gtk_label_get_text (meta);
+  g_autofree char *title = g_strdup (luma_title_island_get_title (LUMA_TITLE_ISLAND (v->island)));
+  luma_title_island_set_title (LUMA_TITLE_ISLAND (v->island), title, text && *text ? text : NULL);
+}
+/* The island floats over the window (v71 places it in the window, under the clock); the page's
+ * scroller starts wherever the frame puts it, so the page's top room is measured, not guessed. */
+static gboolean island_room (gpointer data)
+{
+  GtkWidget *root = data;
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  GtkRoot *window = gtk_widget_get_root (root);
+  if (!v || !GTK_IS_WINDOW (window)) return G_SOURCE_REMOVE;
+  GtkWidget *sw = gtk_widget_get_ancestor (GTK_WIDGET (v->body), GTK_TYPE_SCROLLED_WINDOW);
+  graphene_point_t at = GRAPHENE_POINT_INIT (0, 0), out;
+  graphene_rect_t isl;
+  if (cc_luma_view_island_mode (v) && sw && gtk_widget_compute_point (sw, GTK_WIDGET (window), &at, &out))
+    {
+      int bottom = v->island && gtk_widget_get_mapped (v->island) && gtk_widget_compute_bounds (v->island, GTK_WIDGET (window), &isl) &&
+                   isl.size.height > 0 ? (int) (isl.origin.y + isl.size.height) : CF_ISLAND_BOTTOM;
+      int top = MAX (CF_ISLAND_GAP, bottom + CF_ISLAND_GAP - (int) out.y);
+      if (gtk_widget_get_margin_top (GTK_WIDGET (v->body)) != top) gtk_widget_set_margin_top (GTK_WIDGET (v->body), top);
+      v->island_room = TRUE;
+    }
+  else if (v->island_room)
+    {
+      gtk_widget_set_margin_top (GTK_WIDGET (v->body), v->phone ? 20 : 30); /* the breakpoint's own */
+      v->island_room = FALSE;
+    }
+  return G_SOURCE_REMOVE;
+}
+/* The island floats over the page's own layer host (12 from the side, under the top), so it travels with
+ * the page when a phone pushes it and steps away with it when the list comes back. */
+static void island_place (View *v)
+{
+  GtkWidget *host = gtk_widget_get_first_child (v->root);
+  if (!v->island || gtk_widget_get_parent (v->island)) return;
+  luma_title_island_float_over (LUMA_TITLE_ISLAND (v->island), host);
+}
+static void island_rooted (GtkWidget *root, gpointer unused)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  g_idle_add_full (G_PRIORITY_LOW, island_room, g_object_ref (root), g_object_unref);
+}
+#endif
+/* After a page is drawn: the island follows it, or steps away (a computer, a search). */
+static void island_drawn (View *v)
+{
+#if defined (LUMA_TYPE_TITLE_ISLAND)
+  if (v->island && !cc_luma_view_island_mode (v)) gtk_widget_set_visible (v->island, FALSE);
+  if (v->island_room || cc_luma_view_island_mode (v))
+    g_idle_add_full (G_PRIORITY_LOW, island_room, g_object_ref (v->root), g_object_unref);
+#endif
+}
+static void island_free (View *v)
+{
+#if defined (LUMA_TYPE_TITLE_ISLAND)
+  if (v->island)
+    {
+      GtkWidget *parent = gtk_widget_get_parent (v->island);
+      if (GTK_IS_OVERLAY (parent)) gtk_overlay_remove_overlay (GTK_OVERLAY (parent), v->island);
+      g_clear_object (&v->island);
+    }
+#endif
+  g_clear_pointer (&v->island_parent, g_free);
+}
+void cc_luma_view_island_set (View *v, const char *title, GtkLabel *meta, const char *parent, const char *parent_title)
+{
+#if defined (LUMA_TYPE_TITLE_ISLAND)
+  if (!cc_luma_view_island_mode (v))
+    {
+      if (v->island) gtk_widget_set_visible (v->island, FALSE);
+      return;
+    }
+  const char *summary = meta ? gtk_label_get_text (meta) : NULL;
+  if (!v->island)
+    {
+      v->island = g_object_ref_sink (luma_title_island_new (LUMA_TITLE_ISLAND_LEAD_BACK, title, NULL));
+      gtk_widget_set_name (v->island, "cf-island");
+      g_signal_connect_object (v->island, "lead", G_CALLBACK (island_lead), v->root, 0);
+      g_signal_connect (v->root, "map", G_CALLBACK (island_rooted), NULL);
+      if (v->list_handler) v->list_handler (v->root, v->island, FALSE, v->list_data);
+    }
+  luma_title_island_set_title (LUMA_TITLE_ISLAND (v->island), title, summary && *summary ? summary : NULL);
+  g_autofree char *back = g_strdup_printf ("Back to %s", parent ? parent_title : "Settings");
+  luma_title_island_set_lead (LUMA_TITLE_ISLAND (v->island), LUMA_TITLE_ISLAND_LEAD_BACK, back);
+  g_free (v->island_parent);
+  v->island_parent = g_strdup (parent);
+  if (meta) g_signal_connect_object (meta, "notify::label", G_CALLBACK (island_meta), v->root, 0);
+  gtk_widget_set_visible (v->island, TRUE);
+  island_place (v);
+#endif
+}
