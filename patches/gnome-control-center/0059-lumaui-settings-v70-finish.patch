+  gboolean share_tab = g_str_equal (cc_luma_view_text (v, "rdTab"), "share");
+  GtkWidget *tabs = cf_seg_new ();
+  /* v70 .cfhda .seg.cftabs: the header's tabs are the full-size switch. */
