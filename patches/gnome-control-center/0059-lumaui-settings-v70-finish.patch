+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-live.h"
+#include "cc-luma-live-gsettings.h"
+#include <gio/gio.h>
+
+extern const CcLumaAdapter cc_luma_adapter_power, cc_luma_adapter_sound, cc_luma_adapter_appearance,
+                           cc_luma_adapter_displays, cc_luma_adapter_keyboard;
+extern const CcLumaAdapter cc_luma_adapter_shelf, cc_luma_adapter_windows, cc_luma_adapter_notifications,
+                           cc_luma_adapter_search, cc_luma_adapter_printers;
+
+/* Adapters, one per owning service. Each lives in its own file. */
+extern const CcLumaAdapter cc_luma_adapter_network, cc_luma_adapter_airplane,
+  cc_luma_adapter_proxy, cc_luma_adapter_bluetooth;
+extern const CcLumaAdapter cc_luma_adapter_users, cc_luma_adapter_about, cc_luma_adapter_ssh, cc_luma_adapter_datetime,
+  cc_luma_adapter_sharing, cc_luma_adapter_region, cc_luma_adapter_privacy, cc_luma_adapter_accounts,
+  cc_luma_adapter_wellbeing, cc_luma_adapter_security;
+extern const CcLumaAdapter cc_luma_adapter_apps, cc_luma_adapter_appoptions;
+static const CcLumaAdapter *adapters[] = {
+  &cc_luma_adapter_network, &cc_luma_adapter_airplane, &cc_luma_adapter_proxy,
+  /* Bluetooth reads BlueZ over D-Bus: no second BluetoothClient beside the panel's. */
+  &cc_luma_adapter_bluetooth,
+  &cc_luma_adapter_gsettings,
+  &cc_luma_adapter_nightlight,
+  &cc_luma_adapter_pointer,
+  &cc_luma_adapter_a11y,
+  &cc_luma_adapter_power,
+  &cc_luma_adapter_sound,
+  &cc_luma_adapter_appearance,
+  &cc_luma_adapter_displays,
+  &cc_luma_adapter_keyboard,
+  &cc_luma_adapter_users, &cc_luma_adapter_about, &cc_luma_adapter_ssh, &cc_luma_adapter_datetime,
+  &cc_luma_adapter_sharing, &cc_luma_adapter_region,
+  &cc_luma_adapter_privacy, &cc_luma_adapter_accounts, &cc_luma_adapter_wellbeing, &cc_luma_adapter_security,
+  &cc_luma_adapter_shelf, &cc_luma_adapter_windows, &cc_luma_adapter_notifications, &cc_luma_adapter_search,
+  &cc_luma_adapter_printers,
+  &cc_luma_adapter_apps, &cc_luma_adapter_appoptions,
+  NULL
+};
+
+typedef struct {
+  const CcLumaAdapter *adapter;
+  gpointer state;
+  gboolean ready;
+} Running;
+
+typedef struct {
+  GPtrArray *running;
+  GHashTable *owners; /* key → Running (writes) */
+} Live;
+
+static void
+live_free (Live *live)
+{
+  for (guint i = 0; i < live->running->len; i++)
+    {
+      Running *r = g_ptr_array_index (live->running, i);
+      if (r->adapter->stop && r->state) r->adapter->stop (r->state);
+    }
+  g_ptr_array_unref (live->running);
+  g_hash_table_unref (live->owners);
+  g_free (live);
+}
+
+static Live *
+live_of (CcLumaFixture *model)
+{
+  return model ? g_object_get_data (G_OBJECT (model), "cc-luma-live") : NULL;
+}
+
+static gboolean
+live_write (CcLumaFixture *model, const char *key, JsonNode *value, gpointer data, GError **error)
+{
+  Live *live = data;
+  for (guint i = 0; i < live->running->len; i++)
+    {
+      Running *r = g_ptr_array_index (live->running, i);
+      if (r->ready && r->adapter->write && r->adapter->write (r->state, key, value, error))
+        return TRUE;
+      if (error && *error) return FALSE;
+    }
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "No owner changes %s", key);
+  return FALSE;
+}
+
+static gboolean page_ready (CcLumaFixture *model, const char *page, gpointer data);
+
+CcLumaFixture *
+cc_luma_live_model_new (GError **error)
+{
+  g_autoptr (GBytes) bytes = g_resources_lookup_data ("/org/gnome/Settings/gtk/luma-settings-structure.json", 0, error);
+  g_autoptr (JsonParser) parser = json_parser_new ();
