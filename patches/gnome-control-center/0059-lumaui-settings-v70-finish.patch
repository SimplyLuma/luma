+static void live_sharing (View *v)
+{
+  g_autofree char *meta = g_strdup_printf ("Visible as “%s”", cc_luma_view_text (v, "devName"));
+  gboolean remote = cc_luma_view_flag (v, "rdShare") || cc_luma_view_flag (v, "rdLogin");
+  cf_header (v, "Sharing", meta, NULL);
+  GtkBox *g = cf_group (v, NULL, NULL);
+  tx (v, g, "devName", "Computer name", "How it appears to other devices");
+  if (cc_luma_view_flag (v, "share.files") || cc_luma_view_flag (v, "share.media"))
+    {
+      g = cf_group (v, "On this network", NULL);
+      if (cc_luma_view_flag (v, "share.files"))
+        {
+          cf_sw (v, g, "fileShare", "File sharing", "Your Public folder", NULL);
+          if (cc_luma_view_flag (v, "fileShare")) cf_sw (v, g, "fsPass", "Ask for a password", NULL, NULL);
+        }
+      if (cc_luma_view_flag (v, "share.media"))
+        cf_sw (v, g, "media2", "Media sharing", "Music, videos and photos, for TVs and speakers", NULL);
+    }
+  g = cf_group (v, NULL, NULL);
+  if (cc_luma_view_flag (v, "rd.available") || cc_luma_view_flag (v, "rd.login"))
+    cf_nv (v, g, "remote", "Remote desktop", "Use this computer from another one", remote ? "On" : "Off", lead ("monitor-up"));
+  cf_nv (v, g, "ssh", "Secure Shell", "Sign in from a terminal", cc_luma_view_flag (v, "ssh") ? "On" : "Off", lead ("terminal"));
+}
