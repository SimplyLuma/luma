+/* A box of a set size whose children fill it; a negative size asks for
+ * nothing, like a CSS background (a GtkPicture asks for its image's size).
+ * With shrink, the width is a maximum (v70 max-width: 100%). */
+static void fill_allocate (GtkWidget *widget, int width, int height, int baseline)
+{
+  for (GtkWidget *c = gtk_widget_get_first_child (widget); c; c = gtk_widget_get_next_sibling (c))
+    if (gtk_widget_should_layout (c)) gtk_widget_allocate (c, width, height, -1, NULL);
+}
+static void sized_measure (GtkWidget *widget, GtkOrientation orientation, int for_size,
+                           int *minimum, int *natural, int *minimum_baseline, int *natural_baseline)
+{
+  int size = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (widget), orientation == GTK_ORIENTATION_HORIZONTAL ? "cf-w" : "cf-h"));
+  *natural = MAX (size, 0);
+  *minimum = orientation == GTK_ORIENTATION_HORIZONTAL && g_object_get_data (G_OBJECT (widget), "cf-shrink") ? 0 : *natural;
+}
+static GtkWidget *sized (GtkWidget *child, int width, int height, gboolean shrink)
+{
+  GtkWidget *box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_set_layout_manager (box, gtk_custom_layout_new (NULL, sized_measure, fill_allocate));
+  g_object_set_data (G_OBJECT (box), "cf-w", GINT_TO_POINTER (width));
+  g_object_set_data (G_OBJECT (box), "cf-h", GINT_TO_POINTER (height));
+  if (shrink) g_object_set_data (G_OBJECT (box), "cf-shrink", GINT_TO_POINTER (1));
+  gtk_box_append (GTK_BOX (box), child);
+  return box;
+}
+
+/* v70 rows wrap their text, never their control: the segmented choice keeps
+ * its natural width (its labels would otherwise ellipsize at phone width). */
+static void rigid_measure (GtkWidget *widget, GtkOrientation orientation, int for_size,
+                           int *minimum, int *natural, int *minimum_baseline, int *natural_baseline)
+{
+  gtk_widget_measure (gtk_widget_get_first_child (widget), orientation, for_size, minimum, natural, minimum_baseline, natural_baseline);
+  if (orientation == GTK_ORIENTATION_HORIZONTAL) *minimum = *natural;
+}
+static void rigid_allocate (GtkWidget *widget, int width, int height, int baseline)
+{
+  gtk_widget_allocate (gtk_widget_get_first_child (widget), width, height, baseline, NULL);
+}
+static GtkWidget *rigid (GtkWidget *child)
+{
+  GtkWidget *box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_set_layout_manager (box, gtk_custom_layout_new (NULL, rigid_measure, rigid_allocate));
+  gtk_widget_set_valign (box, GTK_ALIGN_CENTER);
+  gtk_box_append (GTK_BOX (box), child);
+  return box;
+}
