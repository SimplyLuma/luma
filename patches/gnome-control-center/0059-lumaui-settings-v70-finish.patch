+/* A switch the row's own button drives: the visual keeps the tested name and
+ * carries the handler; the button is what people press and name. */
+static void flip (GtkButton *button, GtkSwitch *visual)
+{
+  gtk_switch_set_active (visual, !gtk_switch_get_active (visual));
+}
+static GtkWidget *switch_button (View *v, const char *name, const char *label, gboolean on, GCallback changed, const char *cls)
+{
+  GtkWidget *visual = luma_switch_new (FALSE);
+  GtkWidget *button = g_object_new (GTK_TYPE_BUTTON, "accessible-role", GTK_ACCESSIBLE_ROLE_SWITCH, NULL);
+  gtk_switch_set_active (GTK_SWITCH (visual), on);
+  gtk_widget_set_valign (visual, GTK_ALIGN_CENTER);
+  gtk_widget_set_can_target (visual, FALSE);
+  gtk_widget_set_can_focus (visual, FALSE);
+  gtk_widget_set_name (visual, name);
+  g_signal_connect_object (visual, "notify::active", changed, v->root, 0);
+  gtk_widget_add_css_class (button, cls);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_PROPERTY_LABEL, label, -1);
+  gtk_accessible_update_state (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_STATE_CHECKED,
+                               on ? GTK_ACCESSIBLE_TRISTATE_TRUE : GTK_ACCESSIBLE_TRISTATE_FALSE, -1);
+  g_object_set_data (G_OBJECT (button), "cf-switch", visual);
+  g_signal_connect (button, "clicked", G_CALLBACK (flip), visual);
+  return button;
+}
+/* v70 rSw with an owner-specific handler. */
+static GtkWidget *switch_row (View *v, GtkBox *card, GtkWidget *lead, const char *title, const char *subtitle,
+                              const char *name, gboolean on, GCallback changed)
+{
+  GtkWidget *button = switch_button (v, name, title, on, changed, "cf-row");
+  GtkWidget *inner = cf_row (NULL, lead, title, subtitle, g_object_get_data (G_OBJECT (button), "cf-switch"), FALSE);
+  gtk_widget_remove_css_class (inner, "cf-row");
+  gtk_button_set_child (GTK_BUTTON (button), inner);
+  gtk_box_append (card, button);
+  return button;
+}
+/* cf_sw, keeping the switch's tested name on the visual. */
+static GtkWidget *key_row (View *v, GtkBox *card, const char *key, const char *name, const char *title, const char *subtitle, GtkWidget *lead)
+{
+  GtkWidget *row = cf_sw (v, card, key, title, subtitle, lead);
+  g_autofree char *row_name = g_strconcat ("cf-row-", name + 3, NULL);
+  gtk_widget_set_name (row, row_name);
