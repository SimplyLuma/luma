+/* Settings' you pages: page-only surfaces (heroes). Tokens only. */
+
+/* Privacy: v70 .cffacts */
+.cf-fact { padding: 4px 6px; }
+.cf-fact > image { -gtk-icon-size: 20px; margin-bottom: 8px; color: @luma_good; }
+.cf-fact-v { font-size: 15px; font-weight: 650; }
+.cf-fact-n { font-size: 12px; letter-spacing: 0.12px; color: @luma_muted; }
+
+/* Wellbeing: v70 .cfweek / .cfwb */
+.cf-week { padding: 4px 6px 0; }
+.cf-wk-time { line-height: 15px; font-size: 10.5px; letter-spacing: 0.105px; color: @luma_faint; }
+.cf-wk-day { line-height: 16px; font-size: 11.5px; letter-spacing: 0.115px; color: @luma_muted; }
+.cf-wk-bar { border-radius: 8px 8px 4px 4px; background: @luma_control_fill_hover; }
+.today > .cf-wk-time, .today > .cf-wk-day { color: @luma_ink; font-weight: 600; }
+/* v70 paints today in the page's own hue (oklch(0.72 0.12 var(--cfh)), Wellbeing h 120),
+ * the same hue the page wash uses; the over-limit amber is v70's literal. */
+.today > .cf-wk-bar { background: oklch(0.72 0.12 120); }
+.over > .cf-wk-bar { background: oklch(0.78 0.13 70 / 0.8); }
+.cf-wk-rule { min-height: 0; margin-left: -6px; margin-right: -6px; border-top: 1px dashed @luma_faint; }
+.cf-wk-rule.lim { border-top-color: oklch(0.78 0.13 70); }
diff --git a/shell/luma-settings.css b/shell/luma-settings.css
index f664f5e..d7dfa37 100644
--- a/shell/luma-settings.css
+++ b/shell/luma-settings.css
@@ -1,2 +1,145 @@
-/* Settings-only row composition; shared parts own all paint. */
-.cf-setting-row { min-height: 34px; padding: 9px 16px; }
+/* Settings' own surfaces (v70 .cfpage, .cfhd, .cfgrp, .cfcard, .cfrow).
+ * Colours are LumaUI tokens; shared parts inside keep the kit's paint.
+ */
+
+/* Page */
+.cf-back { min-height: 28px; padding: 0 9px 0 3px; margin: -6px 0 8px -6px; border-radius: 8px;
+  background: none; box-shadow: none; color: @luma_muted; font-weight: 500; }
+.cf-back:hover { background: @luma_hover; color: @luma_ink; }
+.cf-back image { -gtk-icon-size: 16px; }
+.cf-head { min-height: 52px; }
+/* v71 phone: under the title island the page's first block sits 16 below it (.cfpage > :first-of-type { margin-top: 0 }) */
+.cf-island-page > .cf-hero:first-child, .cf-island-page > .cf-group:first-child { margin-top: 0; }
+label.cf-h1 { line-height: 37px; }
+.cf-meta { margin-top: 3px; }
+.cf-top { padding: 4px; border-radius: 10px; background: none; box-shadow: none; min-height: 0; min-width: 0; }
+.cf-hero { margin-top: 20px; padding: 20px; border-radius: 18px; background: @luma_well;
+  box-shadow: inset 0 0 0 1px @luma_well_ring, inset 0 1px 2px @luma_well_shade, 0 1px 0 @luma_well_lip; }
+/* v70 gives rBt rows the .bt class too: medium subtitles that never wrap. */
+.cf-row.bt .cf-sub { font-weight: 500; }
+/* v70 .cfrow.bt also takes the global .bt height: always 52 tall, two lines of words overflowing its padding. */
+.cf-row.bt { min-height: 36px; padding-top: 8px; padding-bottom: 8px; }
+.cf-group { margin-top: 26px; }
+.cf-hero + .cf-group { margin-top: 24px; }
+.cf-h6 { min-height: 24px; margin: 0 4px 8px; }
+.cf-note { margin: 8px 6px 0; font-size: 12px; letter-spacing: 0.12px; color: @luma_faint; }
+.cf-card { border-radius: 16px; box-shadow: inset 0 0 0 1px @luma_menu_border; }
+
+/* Rows */
+.cf-row { min-height: 34px; padding: 9px 16px; border-radius: 0; color: @luma_ink;
+  background-image: linear-gradient(@luma_menu_border, @luma_menu_border); background-repeat: no-repeat;
+  background-origin: content-box; background-clip: padding-box; background-size: 100% 1px; background-position: 0 -9px; }
+.cf-card > .cf-row:first-child { background-image: none; }
+button.cf-row { background-color: transparent; box-shadow: none; font-weight: inherit; }
+button.cf-row:hover { background-color: @luma_hover; }
+.cf-sub { margin-top: 2px; }
+.cf-row:disabled .cf-t { opacity: .5; }
+.cf-row:disabled label.cf-sub { color: @luma_muted; } /* a disabled label would take ink; v70 keeps em ink-3 under the .5 */
+.cf-ri { min-width: 30px; min-height: 30px; border-radius: 9px; background: @luma_hover; }
+.cf-ri image { -gtk-icon-size: 16px; color: @luma_ink_secondary; }
+.cf-img { border-radius: 8px; }
+.cf-v { font-size: 13px; color: @luma_muted; }
+label.cf-v.mono { font-size: 12px; } /* v70 .cfv .mono; .cf-v's 13 px would win over the role */
+entry.cf-tx.mono { font-family: "IBM Plex Mono", monospace; font-size: 12px; letter-spacing: 0.12px; } /* the kit mono role's face */
+.cf-chevron { -gtk-icon-size: 15px; color: @luma_faint; }
+.only > .cf-chevron { color: @luma_muted; }
+.cf-small { font-size: 11.5px; letter-spacing: 0.115px; color: @luma_muted; }
+.cf-out { min-width: 40px; font-size: 12.5px; color: @luma_ink_secondary; font-feature-settings: "tnum"; }
+.cf-rg scale { min-width: 200px; }
+.cf-rg.phone scale { min-width: 140px; }
+button.cf-copy { margin-right: -6px; }
+
+/* Picker */
+button.cf-pk { min-height: 32px; padding: 0 8px 0 11px; border-radius: 10px; background: @luma_well;
+  box-shadow: inset 0 0 0 1px @luma_well_ring, inset 0 1px 2px @luma_well_shade, 0 1px 0 @luma_well_lip;
+  color: @luma_ink; font-weight: 500; }
+button.cf-pk image { -gtk-icon-size: 13px; color: @luma_muted; }
+
+/* Text field */
+/* v70 phone .cftx: the input's own 20-character width (170 in the UI face, 201 in mono) */
+entry.cf-tx.phone { min-width: 150px; }
+entry.cf-tx.phone.mono { min-width: 181px; }
+entry.cf-tx { min-width: 220px; min-height: 32px; padding: 0 10px; border-radius: 10px; background: @luma_well;
+  box-shadow: inset 0 0 0 1px @luma_well_ring, inset 0 1px 2px @luma_well_shade, 0 1px 0 @luma_well_lip; color: @luma_ink; font-size: 13px; }
+
+/* Radio (.cfrd) */
+checkbutton.cf-rd { padding: 0; min-width: 0; min-height: 0; margin: 0; }
+checkbutton.cf-rd > check { min-width: 18px; min-height: 18px; margin: 0; border-radius: 999px; border: 0; background: none;
+  box-shadow: inset 0 0 0 1.5px @luma_faint; -gtk-icon-source: none; }
+checkbutton.cf-rd > check:checked { background: radial-gradient(circle, white 3.5px, @luma_accent 4px); box-shadow: none; }
+.cf-topl { font-size: 12.5px; font-weight: 500; color: @luma_ink_secondary; }
+
+/* Heroes */
+.cf-off { padding: 14px 0 8px; }
+.cf-off-icon { -gtk-icon-size: 26px; color: @luma_faint; margin-bottom: 4px; }
+.cf-off-title { font-size: 15px; font-weight: 600; line-height: 22px; } /* v70 .cfoff b: 15 px at 1.45 */
+.cf-off-sub { font-size: 12.5px; color: @luma_muted; }
+.cf-off-action { margin-top: 8px; }
+.cf-big { min-width: 60px; min-height: 60px; border-radius: 17px; background: @luma_chip;
+  box-shadow: inset 0 1px 0 @luma_chip_highlight, 0 0 0 1px @luma_chip_ring, 0 1px 2px @luma_chip_shadow; }
+.cf-now-sub { margin-top: 3px; }
+label.cf-now-title { line-height: 25px; } /* v70 .cfnowt b, .cfprnt b: 17 px at 1.45 = 24.6 */
+.cf-sig { min-width: 18px; }
+.cf-sig > box { min-width: 3px; margin-right: 2px; border-radius: 1px; background: @luma_control_fill; }
+.cf-sig > box:last-child { margin-right: 0; }
+.cf-sig > box.on { background: @luma_ink_secondary; }
+.cf-sig > .b1 { min-height: 5px; } .cf-sig > .b2 { min-height: 8px; } .cf-sig > .b3 { min-height: 11px; } .cf-sig > .b4 { min-height: 14px; }
+.cf-sig.big > box { min-width: 6px; margin-right: 4px; border-radius: 2px; }
+.cf-sig.big > .b1 { min-height: 8px; } .cf-sig.big > .b2 { min-height: 14px; } .cf-sig.big > .b3 { min-height: 20px; } .cf-sig.big > .b4 { min-height: 26px; }
+.cf-sig.big > box:last-child { margin-right: 0; }
+
+/* Nearby networks */
+.cf-netrow { padding: 0; min-height: 52px; }
+button.cf-net { min-height: 32px; padding: 9px 16px; border-radius: 0; background: none; box-shadow: none; font-weight: inherit; }
+button.cf-net:hover { background: @luma_hover; }
+button.cf-net image { -gtk-icon-size: 14px; color: @luma_faint; }
+.cf-joinf { padding: 2px 16px 12px 48px; }
+box.cf-joinf.phone > entry.cf-field { min-width: 150px; } /* 172 with its padding */
+/* v70 .cfjoinf input: a well, 34 tall, 10 round */
+box.cf-joinf > entry.cf-field { min-height: 34px; padding: 0 11px; border-radius: 10px; background: @luma_well;
+  box-shadow: inset 0 0 0 1px @luma_well_ring, inset 0 1px 2px @luma_well_shade, 0 1px 0 @luma_well_lip; color: @luma_ink; font-size: 13px; }
+/* v70 .cfjoinf input:focus: the well edge plus a 2 px accent ring */
+box.cf-joinf > entry.cf-field:focus-within { outline: 0 solid transparent;
+  box-shadow: inset 0 0 0 1px @luma_well_ring, inset 0 1px 2px @luma_well_shade, 0 1px 0 @luma_well_lip, 0 0 0 2px oklch(from @luma_accent 0.65 0.13 h); }
+
+/* Rows holding a shared add row (v70 .cfrow.cu:has(> .laddrow)) */
+.cf-row.cf-addrow { padding: 4px 8px; }
+/* A locked row: its words dim, it can't be pressed (v70 .cfrow.locked) */
+.cf-row.locked .cf-t { opacity: .5; }
+
+/* A locked or disabled row keeps its paint; only its words dim (v70 .cfrow[disabled] .cft). */
+button.cf-row:disabled, button.cf-row:disabled label, button.cf-row:disabled image, button.cf-row:disabled switch { opacity: 1; filter: none; color: inherit; }
+button.cf-row:disabled { color: @luma_ink; }
+button.cf-row:disabled .cf-ri image { color: @luma_ink_secondary; }
+button.cf-pk label { font-weight: 500; }
+
+/* Search results: the crumb naming each row's page (v70 .cfcrumb) */
+button.cf-crumb { min-height: 0; padding: 0; border-radius: 6px; background: none; box-shadow: none; color: @luma_muted; font-size: 12px; font-weight: 600; }
+button.cf-crumb:hover { color: @luma_ink; }
+button.cf-crumb image { -gtk-icon-size: 12px; }
+/* Sidebar rows with no search hits (v70 .cfside .si.dim) */
+.cf-dim { opacity: .38; }
+
+/* Bluetooth: looking for devices (v70 .cfscan, .cfnear, .cfndev) */
+.cf-scan-title { font-size: 13.5px; font-weight: 600; }
+.cf-scan-sub { font-size: 12px; letter-spacing: 0.12px; color: @luma_muted; }
+.cf-pulse { min-width: 8px; min-height: 8px; border-radius: 999px; background: @luma_accent; }
+.cf-near { margin-top: 14px; }
+.cf-ndev { min-height: 60px; padding: 12px 14px; border-radius: 14px; background: none;
+  box-shadow: inset 0 0 0 1.5px @luma_control_fill; font-weight: inherit; }
+.cf-ndev.ghost { box-shadow: inset 0 0 0 1.5px @luma_hover; }
+.cf-ndev.pairing { box-shadow: inset 0 0 0 1.5px @luma_accent; background: @luma_hover; }
+.cf-ndev-icon { -gtk-icon-size: 18px; color: @luma_ink_secondary; margin-bottom: 6px; }
+.cf-ndev-name { font-size: 13px; font-weight: 600; }
+.cf-ndev-kind { font-size: 11.5px; letter-spacing: 0.115px; color: @luma_muted; }
+
+/* A page still drawn by its GNOME panel sits in the island as a v70 page does: no bar of its own over the
+ * page (Nick, 30 Sep: "a weird top bar"), and its back button is v70's crumb (.cfback), not a framed key. */
+.cf-panel-host toolbarview > .top-bar, .cf-panel-host headerbar,
+.cf-panel-host toolbarview.undershoot-top > .top-bar { background: none; box-shadow: none; border: none; }
+.cf-panel-host headerbar { min-height: 40px; padding: 4px 8px 0; }
+.cf-panel-host headerbar button.image-button, .cf-panel-host headerbar button.back {
+  min-height: 28px; min-width: 28px; padding: 0 6px; border-radius: 8px; background: none; box-shadow: none;
+  border: none; outline: none; color: @luma_muted; }
+.cf-panel-host headerbar button.image-button:hover, .cf-panel-host headerbar button.back:hover { background: @luma_hover; color: @luma_ink; }
+.cf-panel-host headerbar button image { -gtk-icon-size: 16px; }
