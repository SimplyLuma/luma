+/* v70 cfBars: four rising bars, the lit ones ink. */
+GtkWidget *cf_signal_bars (int strength, gboolean big)
+{
+  static const char *names[] = { "Weak signal", "Fair signal", "Good signal", "Excellent signal" };
+  GtkWidget *bars = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  strength = CLAMP (strength, 1, 4);
+  gtk_widget_add_css_class (bars, "cf-sig");
+  if (big) gtk_widget_add_css_class (bars, "big");
+  gtk_widget_set_valign (bars, GTK_ALIGN_CENTER);
+  gtk_widget_set_halign (bars, GTK_ALIGN_CENTER);
+  for (int i = 1; i <= 4; i++)
+    {
+      GtkWidget *bar = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+      g_autofree char *cls = g_strdup_printf ("b%d", i);
+      gtk_widget_add_css_class (bar, cls);
+      if (i <= strength) gtk_widget_add_css_class (bar, "on");
+      gtk_widget_set_valign (bar, GTK_ALIGN_END);
+      gtk_box_append (GTK_BOX (bars), bar);
+    }
+  gtk_widget_set_tooltip_text (bars, names[strength - 1]);
+  return bars;
+}
+/* A line of children at their own widths, 8 apart, that may run past its box (overflow visible). */
+static void run_on_measure (GtkWidget *w, GtkOrientation o, int for_size, int *min, int *nat, int *minb, int *natb)
+{
+  *min = *nat = 0; *minb = *natb = -1;
+  int n = 0;
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c))
+    {
+      int cn = 0;
+      if (!gtk_widget_should_layout (c)) continue;
+      gtk_widget_measure (c, o, -1, NULL, &cn, NULL, NULL);
+      if (o == GTK_ORIENTATION_HORIZONTAL) { *nat += cn + (n ? 8 : 0); n++; }
+      else { *min = MAX (*min, cn); *nat = MAX (*nat, cn); }
+    }
+}
+static void run_on_allocate (GtkWidget *w, int width, int height, int baseline)
+{
+  int x = 0;
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c))
+    {
+      int cw = 0, ch = 0;
+      if (!gtk_widget_should_layout (c)) continue;
+      gtk_widget_measure (c, GTK_ORIENTATION_HORIZONTAL, -1, NULL, &cw, NULL, NULL);
+      gtk_widget_measure (c, GTK_ORIENTATION_VERTICAL, cw, NULL, &ch, NULL, NULL);
+      GtkAllocation a = { x, (height - ch) / 2, cw, ch };
+      gtk_widget_size_allocate (c, &a, -1);
+      x += cw + 8;
+    }
+}
