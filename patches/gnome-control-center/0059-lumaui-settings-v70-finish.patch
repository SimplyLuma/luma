+static void live_remote (View *v)
+{
+  gboolean share = cc_luma_view_flag (v, "rdShare"), login = cc_luma_view_flag (v, "rdLogin");
+  gboolean can_share = cc_luma_view_flag (v, "rd.available"), can_login = cc_luma_view_flag (v, "rd.login");
+  /* One half only when the other's service isn't on this system. */
+  gboolean share_tab = can_share && (!can_login || !g_str_equal (cc_luma_view_text (v, "rdTab"), "login"));
+  GtkWidget *tabs = can_share && can_login ? cf_seg_new () : NULL;
+  if (tabs)
+    {
+      cf_seg_add (tabs, "share", "Share this screen");
+      cf_seg_add (tabs, "login", "Sign in remotely");
+      luma_mode_switch_set_current (LUMA_MODE_SWITCH (tabs), share_tab ? "share" : "login");
+      gtk_accessible_update_property (GTK_ACCESSIBLE (tabs), GTK_ACCESSIBLE_PROPERTY_LABEL, "Mode", -1);
+      gtk_widget_set_name (tabs, "cf-rdTab");
+      g_signal_connect_object (tabs, "changed", G_CALLBACK (remote_tab_changed), v->root, 0);
+    }
+  cf_header (v, "Remote Desktop", share ? "Others can see this screen" : login ? "Others can sign in remotely" : "Off", tabs);
+  GtkBox *g = cf_group (v, NULL, NULL);
+  /* How to connect (address, user, password) needs the credentials the
+   * GNOME panel reads behind its permission: not shown here. */
+  if (share_tab && cc_luma_view_flag (v, "rd.available"))
+    {
+      cf_sw (v, g, "rdShare", "Desktop sharing", "Someone can see your screen while you’re signed in", NULL);
+      if (share) cf_sw (v, g, "rdCtl", "Let them use the mouse and keyboard", NULL, NULL);
+    }
+  else if (!share_tab && cc_luma_view_flag (v, "rd.login"))
+    cf_sw (v, g, "rdLogin", "Remote sign-in", "Sign in to this computer when nobody is using it", NULL);
+}
