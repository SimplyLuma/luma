+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Printers and keyboard shortcuts (Devices). v70 CFP, drawn with the row builders. */
+#include "cc-luma-view-devices.h"
+#include "cc-luma-live-printers.h"
+
+gboolean cc_luma_view_hardware_page (const char *page)
+{
+  const char *pages[] = { "printers", "shortcuts" };
+  for (guint i = 0; page && i < G_N_ELEMENTS (pages); i++)
+    if (g_str_equal (page, pages[i])) return TRUE;
+  return FALSE;
+}
+
+/* ── Printers ────────────────────────────────────────────────────────── */
+/* The printer comes from the fixture's CFPRINTER { n, status, toner }. */
+static JsonObject *printer (View *v)
+{
+  JsonObject *data = cc_luma_fixture_get_data (v->model);
+  JsonNode *node = data ? json_object_get_member (data, "CFPRINTER") : NULL;
+  return node && JSON_NODE_HOLDS_OBJECT (node) ? json_node_get_object (node) : NULL;
+}
+
+/* A key the owner reports (live printers publish null for what they don't). */
+static gboolean reported (View *v, const char *key)
+{
+  JsonNode *n = cc_luma_fixture_get (v->model, key);
+  return n && JSON_NODE_HOLDS_VALUE (n);
+}
+
+/* Live: through the printer owner (panels/printers' helpers). */
+static gboolean live_command (View *v, const char *command)
+{
+  g_autoptr (GError) error = NULL;
+  if (!cc_luma_fixture_is_live (v->model)) return FALSE;
+  if (!cc_luma_live_printer_command (v->model, command, v->root, &error)) cc_luma_view_report_error (v, error);
+  return TRUE;
+}
+
+static void add_printer (GtkButton *button, View *v)
+{
+  if (cc_luma_view_delegated (v)) return; /* live: GNOME's Printers panel adds (not yet proven here) */
+  if (live_command (v, "add")) return;
+  luma_toast_show (v->root, "Looking for printers on Studio North…", "opening");
+}
+
+static void test_page (GtkButton *button, View *v)
+{
+  if (cc_luma_view_delegated (v)) return; /* live: GNOME's Printers panel prints it */
+  JsonObject *p = printer (v);
+  g_autofree char *text = g_strdup_printf ("Test page sent to %s", p ? json_object_get_string_member (p, "n") : "");
+  if (cc_luma_fixture_is_live (v->model))
+    {
+      g_autoptr (GError) error = NULL;
+      if (!cc_luma_live_printer_command (v->model, "test", v->root, &error)) { cc_luma_view_report_error (v, error); return; }
+    }
+  luma_toast_show (v->root, text, "sent");
+}
+
+static void removed (GObject *dialog, gboolean option, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (v && cc_luma_fixture_is_live (v->model))
+    {
+      g_autoptr (GError) error = NULL;
+      if (!cc_luma_live_printer_command (v->model, "remove", root, &error)) { cc_luma_view_report_error (v, error); return; }
+    }
+  luma_toast_show (root, "Printer removed", "deleted");
+}
+
+static void remove_printer (GtkButton *button, View *v)
+{
+  if (cc_luma_view_delegated (v)) return; /* live: GNOME's Printers panel removes */
+  JsonObject *p = printer (v);
+  g_autofree char *title = g_strdup_printf ("Remove %s?", p ? json_object_get_string_member (p, "n") : "");
+  GObject *dialog = G_OBJECT (luma_destructive_dialog_ask (v->root, title, "You can add it again later.", "Remove", "trash-2", NULL));
+  if (dialog) g_signal_connect_object (dialog, "confirmed", G_CALLBACK (removed), v->root, 0);
+}
+
+static void printers (View *v)
+{
+  JsonObject *p = printer (v);
+  GtkWidget *add = luma_text_button_new ("Add printer", "plus", "fill");
+  luma_text_button_set_hero (GTK_BUTTON (add), TRUE);
+  cc_luma_view_bind_command (v, add, G_CALLBACK (add_printer));
+  gtk_widget_add_css_class (add, "cf-add-printer");
+  gtk_widget_set_name (add, "cf-addprinter");
+  if (!cc_luma_fixture_is_live (v->model))
+    cf_header (v, "Printers", "One printer · ready", add);
+  else
+    {
+      /* Live: what CUPS reports; with no printer, the page is the header. */
+      gint64 count = p ? json_object_get_int_member_with_default (p, "count", 1) : 0;
+      g_autofree char *state = p ? g_utf8_strdown (json_object_get_string_member (p, "status"), -1) : NULL;
+      g_autofree char *meta = count == 0 ? g_strdup ("No printers") : count == 1 ? g_strdup_printf ("One printer · %s", state)
+                                                                   : g_strdup_printf ("%" G_GINT64_FORMAT " printers", count);
+      cf_header (v, "Printers", meta, add);
+    }
+  if (!p)
+    {
+      /* An empty page read as broken (Nick, 30 Sep): with no printer the hero says so. */
+      cf_hero (v, cf_off_hero (v, "printer", "No printers", NULL, NULL, NULL), "cf-printers-none");
+      return;
+    }
+  const char *name = json_object_get_string_member (p, "n");
+  gboolean toner_known = json_object_has_member (p, "toner");
+
+  GtkWidget *hero = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 16);
