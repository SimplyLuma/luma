+G_BEGIN_DECLS
+typedef gboolean (*CcLumaDevSet) (View *v, const char *key, JsonNode *value, GError **error);
+
+/* Row kinds whose writes go through @set; switches, radios and segments
+ * refresh the page, ranges only update their readout. */
+GtkWidget *cc_luma_dev_sw (View *v, GtkBox *card, const char *key, const char *title, const char *subtitle,
+                           GtkWidget *lead, CcLumaDevSet set);
+GtkWidget *cc_luma_dev_rd (View *v, GtkBox *card, const char *key, const char *value, const char *title,
+                           const char *subtitle, CcLumaDevSet set);
+/* A bare segmented control; @boolean keys hold true/false. */
+GtkWidget *cc_luma_dev_seg (View *v, const char *key, const char *label, const char * const *choices,
+                            gboolean boolean, CcLumaDevSet set);
+GtkWidget *cc_luma_dev_sg (View *v, GtkBox *card, const char *key, const char *title, const char *subtitle,
+                           const char * const *choices, gboolean boolean, CcLumaDevSet set);
+GtkWidget *cc_luma_dev_rg (View *v, GtkBox *card, const char *key, const char *title, const char *subtitle,
+                           double min, double max, double step, const char *lo, const char *hi,
+                           CfFormat format, CcLumaDevSet set);
+/* A box sized by its CSS alone, clipping its children; @fit gives them its size. */
+GtkWidget *cc_luma_dev_clip (gboolean fit);
+/* v70 .cfdayl: labels at 0, 1/(n-1) … 1 of the width, the ends flush. */
+GtkWidget *cc_luma_dev_day_labels (const char * const *labels);
+/* A row of children sized by the double "cf-w" on each (v70 flex: w). */
+GtkWidget *cc_luma_dev_weighted (int spacing);
+/* A hero chooser card (v70 .cfmode / .cfout). */
+GtkWidget *cc_luma_dev_choice_card (const char *icon, const char *title, const char *subtitle, gboolean on);
