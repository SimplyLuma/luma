@@ -36,8 +36,24 @@ static gboolean valid (const Field *field, JsonNode *value)
   for (guint i = 0; field->choices[i]; i++) if (g_str_equal (field->choices[i], json_node_get_string (value))) return TRUE;
   return FALSE;
 }
+/* Live: what the system reports, of the right type (a value v70 doesn't
+ * offer shows as itself; apps are whatever asked). Absent keys belong to
+ * pages that stay on their GNOME panel. */
+static gboolean live_valid (CcLumaFixture *model)
+{
+  for (guint i = 0; i < G_N_ELEMENTS (fields); i++) {
+    JsonNode *n = cc_luma_fixture_get (model, fields[i].key);
+    if (n && (!JSON_NODE_HOLDS_VALUE (n) || json_node_get_value_type (n) != fields[i].type)) return FALSE;
+  }
+  for (guint i = 0; i < G_N_ELEMENTS (permissions); i++) {
+    JsonNode *node = cc_luma_fixture_get (model, permissions[i].key);
+    if (node && !JSON_NODE_HOLDS_OBJECT (node)) return FALSE;
+  }
+  return TRUE;
+}
 gboolean cc_luma_privacy_validate (CcLumaFixture *model)
 {
+  if (cc_luma_fixture_is_live (model)) return live_valid (model);
   for (guint i = 0; i < G_N_ELEMENTS (fields); i++) if (!valid (&fields[i], cc_luma_fixture_get (model, fields[i].key))) return FALSE;
   for (guint i = 0; i < G_N_ELEMENTS (permissions); i++) {
     JsonNode *node = cc_luma_fixture_get (model, permissions[i].key);
@@ -56,7 +72,14 @@ gboolean cc_luma_privacy_validate (CcLumaFixture *model)
