+/* v70 .cfndev: a device found nearby, a tile to press to pair. */
+/* v70 phone .cfscan: pulse, then the two texts sharing the rest (gap 10), shrunk in proportion to their
+ * one-line widths as CSS flex items with flex-shrink 1 are, never below their longest word. */
+#define SCAN_GAP 10
+static int scan_line_width (GtkWidget *l)
+{
+  int w = 0;
+  if (!GTK_IS_LABEL (l)) { gtk_widget_measure (l, GTK_ORIENTATION_HORIZONTAL, -1, NULL, &w, NULL, NULL); return w; }
+  PangoLayout *layout = gtk_widget_create_pango_layout (l, gtk_label_get_text (GTK_LABEL (l)));
+  pango_layout_get_pixel_size (layout, &w, NULL);
+  g_object_unref (layout);
+  return w;
+}
+static void scan_widths (GtkWidget *box, int width, int *pw, int *w1, int *w2)
+{
+  GtkWidget *p = gtk_widget_get_first_child (box), *a = gtk_widget_get_next_sibling (p), *b = gtk_widget_get_next_sibling (a);
+  int m1, m2, n1 = scan_line_width (a), n2 = scan_line_width (b);
+  gtk_widget_measure (p, GTK_ORIENTATION_HORIZONTAL, -1, NULL, pw, NULL, NULL);
+  gtk_widget_measure (a, GTK_ORIENTATION_HORIZONTAL, -1, &m1, NULL, NULL, NULL);
+  gtk_widget_measure (b, GTK_ORIENTATION_HORIZONTAL, -1, &m2, NULL, NULL, NULL);
+  int room = MAX (0, width - *pw - 2 * SCAN_GAP);
+  if (n1 + n2 <= room || n1 + n2 == 0) { *w1 = n1; *w2 = room - n1; return; }
+  *w1 = MAX (m1, (int) ((double) room * n1 / (n1 + n2) + 0.5));
+  *w2 = MAX (m2, room - *w1);
+}
+static void scan_measure (GtkWidget *box, GtkOrientation o, int for_size, int *min, int *nat, int *minb, int *natb)
+{
+  GtkWidget *p = gtk_widget_get_first_child (box), *a = gtk_widget_get_next_sibling (p), *b = gtk_widget_get_next_sibling (a);
+  *minb = *natb = -1;
+  if (o == GTK_ORIENTATION_HORIZONTAL)
+    {
+      int pm, m1, m2;
+      gtk_widget_measure (p, o, -1, &pm, NULL, NULL, NULL);
+      gtk_widget_measure (a, o, -1, &m1, NULL, NULL, NULL);
+      gtk_widget_measure (b, o, -1, &m2, NULL, NULL, NULL);
+      *min = pm + m1 + m2 + 2 * SCAN_GAP;
+      *nat = pm + scan_line_width (a) + scan_line_width (b) + 2 * SCAN_GAP;
+      return;
+    }
+  int pw, w1, w2, h1, h2, hp;
+  scan_widths (box, for_size < 0 ? 302 : for_size, &pw, &w1, &w2);
+  gtk_widget_measure (p, o, pw, NULL, &hp, NULL, NULL);
+  gtk_widget_measure (a, o, w1, NULL, &h1, NULL, NULL);
+  gtk_widget_measure (b, o, w2, NULL, &h2, NULL, NULL);
+  *min = *nat = MAX (hp, MAX (h1, h2));
+}
+static void scan_place (GtkWidget *w, int x, int y, int width, int height)
+{
+  GtkAllocation a = { x, y, width, height };
+  gtk_widget_size_allocate (w, &a, -1);
+}
+static void scan_allocate (GtkWidget *box, int width, int height, int baseline)
+{
+  GtkWidget *p = gtk_widget_get_first_child (box), *a = gtk_widget_get_next_sibling (p), *b = gtk_widget_get_next_sibling (a);
+  int pw, w1, w2, hp, h1, h2;
+  scan_widths (box, width, &pw, &w1, &w2);
+  gtk_widget_measure (p, GTK_ORIENTATION_VERTICAL, pw, NULL, &hp, NULL, NULL);
+  gtk_widget_measure (a, GTK_ORIENTATION_VERTICAL, w1, NULL, &h1, NULL, NULL);
+  gtk_widget_measure (b, GTK_ORIENTATION_VERTICAL, w2, NULL, &h2, NULL, NULL);
+  scan_place (p, 0, (height - hp) / 2, pw, hp);
+  scan_place (a, pw + SCAN_GAP, (height - h1) / 2, w1, h1);
+  scan_place (b, pw + 2 * SCAN_GAP + w1, (height - h2) / 2, w2, h2);
+}
