+/* Live: the choices are the apps the system has for the type (CFDEFAPPS),
+ * plus ask / folder / nothing for removable media. */
+static gboolean live_allowed (CcLumaFixture *model, guint field, JsonNode *value)
+{
+  if (!value || !JSON_NODE_HOLDS_VALUE (value) || json_node_get_value_type (value) != G_TYPE_STRING) return FALSE;
+  const char *text = json_node_get_string (value);
+  if (g_str_has_prefix (fields[field].key, "media.") &&
+      (g_str_equal (text, "ask") || g_str_equal (text, "folder") || g_str_equal (text, "nothing"))) return TRUE;
+  JsonNode *all = json_object_get_member (cc_luma_fixture_get_data (model), "CFDEFAPPS");
+  JsonNode *list = all && JSON_NODE_HOLDS_OBJECT (all) ? json_object_get_member (json_node_get_object (all), fields[field].key) : NULL;
+  for (guint i = 0; list && JSON_NODE_HOLDS_ARRAY (list) && i < json_array_get_length (json_node_get_array (list)); i++)
+    {
+      JsonNode *pair = json_array_get_element (json_node_get_array (list), i);
+      if (JSON_NODE_HOLDS_ARRAY (pair) && g_strcmp0 (json_array_get_string_element (json_node_get_array (pair), 0), text) == 0) return TRUE;
+    }
+  return FALSE;
+}
