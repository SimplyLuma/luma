+  { "mSpeed", MOUSE, "speed", CC_LUMA_GS_LINEAR, NULL, 100, 0, -100, 100 },
+  { "mAccel", MOUSE, "accel-profile", CC_LUMA_GS_UNLESS, accel },
+  { "mNat", MOUSE, "natural-scroll", CC_LUMA_GS_BOOLEAN },
+  { "tp", TOUCHPAD, "send-events", CC_LUMA_GS_UNLESS, send_events },
+  { "tpType", TOUCHPAD, "disable-while-typing", CC_LUMA_GS_BOOLEAN },
+  { "tSpeed", TOUCHPAD, "speed", CC_LUMA_GS_LINEAR, NULL, 100, 0, -100, 100 },
+  { "tTap", TOUCHPAD, "tap-to-click", CC_LUMA_GS_BOOLEAN },
+  { "tNat", TOUCHPAD, "natural-scroll", CC_LUMA_GS_BOOLEAN },
+  { "tSec", TOUCHPAD, "click-method", CC_LUMA_GS_CHOICE, click_method },
+  /* Keyboard */
+  { "perWin", "org.gnome.desktop.input-sources", "per-window", CC_LUMA_GS_CHOICE, per_window },
+  { "rep", KEYBOARD, "repeat", CC_LUMA_GS_BOOLEAN },
+  /* Accessibility (panels/universal-access) */
+  { "a11yMenu", "org.gnome.desktop.a11y", "always-show-universal-access-status", CC_LUMA_GS_BOOLEAN },
+  { "hc", "org.gnome.desktop.a11y.interface", "high-contrast", CC_LUMA_GS_BOOLEAN },
+  { "motion", IFACE, "enable-animations", CC_LUMA_GS_NOT },
+  { "large", IFACE, "text-scaling-factor", CC_LUMA_GS_ABOVE, NULL, 1.25, 1.0 },
+  { "cursor", IFACE, "cursor-size", CC_LUMA_GS_CHOICE, cursor_sizes },
+  { "scrollbars", IFACE, "overlay-scrolling", CC_LUMA_GS_NOT },
+  { "soundKeys", A11Y_KEYBOARD, "togglekeys-enable", CC_LUMA_GS_BOOLEAN },
+  { "reader", A11Y_APPS, "screen-reader-enabled", CC_LUMA_GS_BOOLEAN },
+  { "osk", A11Y_APPS, "screen-keyboard-enabled", CC_LUMA_GS_BOOLEAN },
+  { "zoom", A11Y_APPS, "screen-magnifier-enabled", CC_LUMA_GS_BOOLEAN },
+  { "vAlert", "org.gnome.desktop.wm.preferences", "visual-bell", CC_LUMA_GS_BOOLEAN },
+  { "vAlertHow", "org.gnome.desktop.wm.preferences", "visual-bell-type", CC_LUMA_GS_CHOICE, bell_type },
+  { "blink", IFACE, "cursor-blink", CC_LUMA_GS_BOOLEAN },
+  { "sticky", A11Y_KEYBOARD, "stickykeys-enable", CC_LUMA_GS_BOOLEAN },
+  { "slow", A11Y_KEYBOARD, "slowkeys-enable", CC_LUMA_GS_BOOLEAN },
+  { "bounce", A11Y_KEYBOARD, "bouncekeys-enable", CC_LUMA_GS_BOOLEAN },
+  { "kbdA11y", A11Y_KEYBOARD, "enable", CC_LUMA_GS_BOOLEAN },
+  { "mkeys", A11Y_KEYBOARD, "mousekeys-enable", CC_LUMA_GS_BOOLEAN },
+  { "locate", IFACE, "locate-pointer", CC_LUMA_GS_BOOLEAN },
+  { "hold", A11Y_MOUSE, "secondary-click-enabled", CC_LUMA_GS_BOOLEAN },
+  { "hover", A11Y_MOUSE, "dwell-click-enabled", CC_LUMA_GS_BOOLEAN },
+  { "cross", MAGNIFIER, "show-cross-hairs", CC_LUMA_GS_BOOLEAN },
+  { "invert", MAGNIFIER, "invert-lightness", CC_LUMA_GS_BOOLEAN },
+  { "zoomF", MAGNIFIER, "mouse-tracking", CC_LUMA_GS_CHOICE, tracking },
+  { "zoomX", MAGNIFIER, "mag-factor", CC_LUMA_GS_DOUBLE },
+};
+
+/* No GNOME key means exactly these: v70's 0–100 comfort sliders (GNOME
+ * stores milliseconds on other scales), the view's own tab (mtab), two-key
+ * touchpad scrolling (tScroll), xkb option pairs (altKey, compose) and the
+ * input-source list (src, srcs, CFKB). */
+const char * const cc_luma_gs_unowned_keys[] = {
+  "tScroll", "src", "srcs", "altKey", "compose", "repDelay", "repSpeed", "blinkS", "dbl", NULL
+};
+
+/* LUMA_SETTINGS_LIVE_DUMP=<file>: the dev pages' live keys and data after
+ * every change, to check a system's model without a screen. */
+static void
+dump (CcLumaFixture *model, const char *path)
+{
+  static const char *keys[] = { "out", "vol", "bal", "cfg", "inDev", "inVol", "alert", "lv", "overamp", "night", "nightWhen",
+    "nightFrom", "nightTo", "nightT", "pmode", "charge", "pbtn", "blank", "susBat", "susBatD", "susAc", "susAcD", "pct",
+    "autoBright", "dim", "autoSaver", "acc", "wall", "mode", "tint", "join", "dsel", "arr", "d", NULL };
+  static const char *data[] = { "CFOUT", "CFPOWER", "CFWALL", "CFDISP", NULL };
+  g_autoptr (JsonBuilder) builder = json_builder_new ();
+  json_builder_begin_object (builder);
+  for (guint i = 0; keys[i]; i++)
+    {
+      JsonNode *n = cc_luma_fixture_get (model, keys[i]);
+      json_builder_set_member_name (builder, keys[i]);
+      json_builder_add_value (builder, n ? json_node_copy (n) : json_node_init_null (json_node_alloc ()));
+    }
+  for (guint i = 0; data[i]; i++)
+    {
+      JsonNode *n = json_object_get_member (cc_luma_fixture_get_data (model), data[i]);
+      json_builder_set_member_name (builder, data[i]);
+      json_builder_add_value (builder, n ? json_node_copy (n) : json_node_init_null (json_node_alloc ()));
+    }
+  json_builder_end_object (builder);
+  g_autoptr (JsonNode) root = json_builder_get_root (builder);
+  g_autofree char *text = json_to_string (root, TRUE);
+  g_file_set_contents (path, text, -1, NULL);
+}
+
+static void
+dump_changed (CcLumaFixture *model, gpointer unused)
+{
+  dump (model, g_getenv ("LUMA_SETTINGS_LIVE_DUMP"));
+}
+
+static gpointer
+gsettings_start (CcLumaFixture *model)
+{
+  CcLumaGsTable *table = cc_luma_gs_table_new (model, rows, G_N_ELEMENTS (rows));
+  /* Mouse & Touchpad's tab is the page's own state, not a setting. */
+  cc_luma_fixture_publish_string (model, "mtab", "mouse");
+  cc_luma_fixture_own_key (model, "mtab");
+  if (g_getenv ("LUMA_SETTINGS_LIVE_DUMP"))
+    g_signal_connect (model, "changed", G_CALLBACK (dump_changed), NULL);
+  cc_luma_live_ready (model, "gsettings");
+  return table;
+}
+
+static gboolean
+gsettings_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  if (g_str_equal (key, "mtab"))
+    return value && JSON_NODE_HOLDS_VALUE (value) && json_node_get_value_type (value) == G_TYPE_STRING &&
+           (g_str_equal (json_node_get_string (value), "mouse") || g_str_equal (json_node_get_string (value), "touchpad"));
+  return cc_luma_gs_table_write (state, key, value, error);
+}
+
+static void
+gsettings_stop (gpointer state)
+{
+  cc_luma_gs_table_free (state);
+}
+
+/* Publishes and writes every row; draws no page by itself. */
+const CcLumaAdapter cc_luma_adapter_gsettings = {
+  "gsettings", (const char * const[]) { NULL }, gsettings_start, gsettings_write, gsettings_stop
+};
+
+/* Night Light is the gsettings rows alone: drawn once they validate. */
+static gpointer
+night_start (CcLumaFixture *model)
+{
+  return cc_luma_ready_gate_new (model, "nightlight", cc_luma_night_validate);
+}
+
+static void
+night_stop (gpointer state)
+{
+  cc_luma_ready_gate_free (state);
+}
+
+const CcLumaAdapter cc_luma_adapter_nightlight = {
+  "nightlight", (const char * const[]) { "nightlight", NULL }, night_start, NULL, night_stop
+};
+
+/* Mouse & Touchpad and Accessibility are GSettings rows alone; rows with no
+ * owner are left out of the live pages. */
+static gpointer pointer_start (CcLumaFixture *model) { return cc_luma_ready_gate_new (model, "pointer", cc_luma_pointer_validate); }
+static gpointer a11y_start (CcLumaFixture *model) { return cc_luma_ready_gate_new (model, "a11y", cc_luma_a11y_validate); }
+
+const CcLumaAdapter cc_luma_adapter_pointer = {
+  "pointer", (const char * const[]) { "mouse", NULL }, pointer_start, NULL, night_stop
+};
+const CcLumaAdapter cc_luma_adapter_a11y = {
+  "a11y", (const char * const[]) { "a11y", "a-see", "a-hear", "a-type", "a-point", "a-zoom", NULL }, a11y_start, NULL, night_stop
+};
diff --git a/shell/cc-luma-live-gsettings.h b/shell/cc-luma-live-gsettings.h
new file mode 100644
index 0000000..2006475
--- /dev/null
+++ b/shell/cc-luma-live-gsettings.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "cc-luma-live.h"
+#include <gio/gio.h>
+
+G_BEGIN_DECLS
+/* One row maps a model key onto one GSettings key, only where the model
+ * key means exactly what the GNOME key means. Conversions are value
+ * representations, never policy. A value the model can't represent is
+ * published as null (the page then stays on its GNOME panel). */
+typedef enum {
+  CC_LUMA_GS_BOOLEAN,   /* b ↔ bool */
+  CC_LUMA_GS_NOT,       /* b ↔ !bool */
+  CC_LUMA_GS_UNLESS,    /* s/enum ↔ bool: TRUE unless choices[1]; writes choices[0] or choices[1] */
+  CC_LUMA_GS_CHOICE,    /* any scalar ↔ string: choices = { model, gsettings, … } in GVariant text */
+  CC_LUMA_GS_CHOICE_INT,/* same, model side is an integer */
+  CC_LUMA_GS_LINEAR,    /* number ↔ integer model = round (value * scale + offset), clamped to low…high */
+  CC_LUMA_GS_DOUBLE,    /* d ↔ double */
+  CC_LUMA_GS_MINUTES,   /* seconds (i/u) ↔ string of whole minutes */
+  CC_LUMA_GS_HOURS,     /* hours (d) ↔ "HH:MM" */
+  CC_LUMA_GS_ABOVE,     /* d ↔ bool: TRUE when above offset; TRUE writes scale, FALSE resets */
+} CcLumaGsKind;
+
+typedef struct {
+  const char *key;
+  const char *schema;
+  const char *name;
+  CcLumaGsKind kind;
+  const char * const *choices;
+  double scale, offset, low, high;
+} CcLumaGsRow;
+
+typedef struct _CcLumaGsTable CcLumaGsTable;
+/* Opens only installed schemas with the key; publishes, owns and watches. */
+CcLumaGsTable *cc_luma_gs_table_new (CcLumaFixture *model, const CcLumaGsRow *rows, guint n_rows);
+/* FALSE without an error: not a key of this table. */
+gboolean cc_luma_gs_table_write (CcLumaGsTable *table, const char *key, JsonNode *value, GError **error);
+gboolean cc_luma_gs_table_covers (CcLumaGsTable *table, const char *key);
+void cc_luma_gs_table_free (CcLumaGsTable *table);
+/* Model keys of the Mouse & Touchpad, Keyboard and Accessibility pages
+ * that no GSettings key means exactly (NULL-terminated). */
+extern const char * const cc_luma_gs_unowned_keys[];
+
+/* Reports an adapter ready once the page validator accepts the model, so a
+ * page is drawn only from values the system actually has. */
+typedef struct _CcLumaReadyGate CcLumaReadyGate;
+CcLumaReadyGate *cc_luma_ready_gate_new (CcLumaFixture *model, const char *adapter,
+                                         gboolean (*valid) (CcLumaFixture *model));
+void cc_luma_ready_gate_free (CcLumaReadyGate *gate);
+
+extern const CcLumaAdapter cc_luma_adapter_gsettings;
+extern const CcLumaAdapter cc_luma_adapter_nightlight;
+extern const CcLumaAdapter cc_luma_adapter_pointer;
+extern const CcLumaAdapter cc_luma_adapter_a11y;
+G_END_DECLS
diff --git a/shell/cc-luma-live-keyboard.c b/shell/cc-luma-live-keyboard.c
new file mode 100644
index 0000000..9df6c5a
--- /dev/null
+++ b/shell/cc-luma-live-keyboard.c
@@ -0,0 +1,226 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Keyboard: the input sources GNOME keeps (org.gnome.desktop.input-sources,
+ * named as the keyboard panel names them through GnomeXkbInfo), the one in
+ * use (the Shell's most recently used), the accents and compose keys from
+ * xkb-options as the panel's special-character dialog sets them, and each
+ * layout's keycaps from its xkb keymap. Changing the list stays with GNOME's
+ * keyboard panel (delegated); the special keys write xkb-options. */
+#define GNOME_DESKTOP_USE_UNSTABLE_API
+#include "cc-luma-live-gsettings.h"
+#include "cc-luma-keyboard.h"
+#include <libgnome-desktop/gnome-xkb-info.h>
+#include <xkbcommon/xkbcommon.h>
+#include <string.h>
+
+#define SOURCES "org.gnome.desktop.input-sources"
+
+typedef struct {
+  CcLumaFixture *model;
+  GSettings *settings;
+  GnomeXkbInfo *xkb;
+  struct xkb_context *context;
+  JsonNode *structure; /* the page's CFKB: key codes, widths, English (US) */
+  CcLumaReadyGate *gate;
+} Keyboard;
+
+/* The panel's own xkb options for the two special keys. */
+static const char *alt_options[] = { "lv3:ralt_switch", "AltRight", "lv3:lalt_switch", "AltLeft", "lv3:menu_switch", "ContextMenu", NULL };
+static const char *compose_options[] = { "compose:menu", "ContextMenu", "compose:caps", "CapsLock", "compose:rctrl", "ControlRight", NULL };
+
+/* Web key codes (the page's CFKB.codes) → evdev. */
+static const struct { const char *code; guint evdev; } codes[] = {
+  { "Backquote", 41 }, { "Digit1", 2 }, { "Digit2", 3 }, { "Digit3", 4 }, { "Digit4", 5 }, { "Digit5", 6 }, { "Digit6", 7 },
+  { "Digit7", 8 }, { "Digit8", 9 }, { "Digit9", 10 }, { "Digit0", 11 }, { "Minus", 12 }, { "Equal", 13 },
+  { "KeyQ", 16 }, { "KeyW", 17 }, { "KeyE", 18 }, { "KeyR", 19 }, { "KeyT", 20 }, { "KeyY", 21 }, { "KeyU", 22 },
+  { "KeyI", 23 }, { "KeyO", 24 }, { "KeyP", 25 }, { "BracketLeft", 26 }, { "BracketRight", 27 }, { "Backslash", 43 },
+  { "KeyA", 30 }, { "KeyS", 31 }, { "KeyD", 32 }, { "KeyF", 33 }, { "KeyG", 34 }, { "KeyH", 35 }, { "KeyJ", 36 },
+  { "KeyK", 37 }, { "KeyL", 38 }, { "Semicolon", 39 }, { "Quote", 40 },
+  { "KeyZ", 44 }, { "KeyX", 45 }, { "KeyC", 46 }, { "KeyV", 47 }, { "KeyB", 48 }, { "KeyN", 49 }, { "KeyM", 50 },
+  { "Comma", 51 }, { "Period", 52 }, { "Slash", 53 },
+};
+static const struct { xkb_keysym_t sym; const char *cap; } dead[] = {
+  { XKB_KEY_dead_grave, "`" }, { XKB_KEY_dead_acute, "´" }, { XKB_KEY_dead_circumflex, "^" }, { XKB_KEY_dead_tilde, "~" },
+  { XKB_KEY_dead_diaeresis, "¨" }, { XKB_KEY_dead_cedilla, "¸" }, { XKB_KEY_dead_abovering, "°" }, { XKB_KEY_dead_caron, "ˇ" },
+};
+
+static char *
+source_name (Keyboard *self, const char *type, const char *id)
+{
+  const char *name = NULL;
+  if (g_str_equal (type, "xkb") && gnome_xkb_info_get_layout_info (self->xkb, id, &name, NULL, NULL, NULL) && name)
+    return g_strdup (name);
+  return g_strdup (id);
+}
+
+/* One layout's five rows of keycaps: letters from its keymap, the named
+ * keys as the page labels them. */
+static JsonArray *
+keycaps (Keyboard *self, const char *id)
+{
+  g_auto (GStrv) parts = g_strsplit (id, "+", 2);
+  struct xkb_rule_names names = { .layout = parts[0], .variant = parts[1] };
+  struct xkb_keymap *keymap = xkb_keymap_new_from_names (self->context, &names, XKB_KEYMAP_COMPILE_NO_FLAGS);
+  if (!keymap) return NULL;
+  struct xkb_state *state = xkb_state_new (keymap);
+  JsonObject *structure = json_node_get_object (self->structure);
+  JsonArray *rows = json_object_get_array_member (structure, "codes");
+  JsonArray *english = json_object_get_array_member (json_object_get_object_member (structure, "L"), "English (US)");
+  JsonArray *result = json_array_new ();
+  for (guint r = 0; r < json_array_get_length (rows); r++)
+    {
+      JsonArray *row = json_array_get_array_element (rows, r);
+      g_auto (GStrv) labels = g_strsplit (json_array_get_string_element (english, r), " ", -1);
+      g_autoptr (GPtrArray) caps = g_ptr_array_new_with_free_func (g_free);
+      for (guint i = 0; i < json_array_get_length (row); i++)
+        {
+          const char *code = json_array_get_string_element (row, i);
+          char *cap = NULL;
+          for (guint c = 0; c < G_N_ELEMENTS (codes) && !cap; c++)
+            {
+              if (!g_str_equal (codes[c].code, code)) continue;
+              xkb_keysym_t sym = xkb_state_key_get_one_sym (state, codes[c].evdev + 8);
+              char text[16] = "";
+              for (guint d = 0; d < G_N_ELEMENTS (dead) && !*text; d++)
+                if (dead[d].sym == sym) g_strlcpy (text, dead[d].cap, sizeof text);
+              if (!*text && xkb_keysym_to_utf8 (sym, text, sizeof text) <= 0) *text = '\0';
+              cap = *text && g_unichar_isgraph (g_utf8_get_char (text)) ? g_strdup (text) : g_strdup ("_");
+            }
+          g_ptr_array_add (caps, cap ? cap : g_strdup (i < g_strv_length (labels) ? labels[i] : "_"));
+        }
+      g_ptr_array_add (caps, NULL);
+      g_autofree char *line = g_strjoinv (" ", (char **) caps->pdata);
+      json_array_add_string_element (result, line);
+    }
+  xkb_state_unref (state);
+  xkb_keymap_unref (keymap);
+  return result;
+}
+
+static const char *
+option_key (char **options, const char * const *table)
+{
+  for (guint i = 0; options && options[i]; i++)
+    for (guint t = 0; table[t]; t += 2)
+      if (g_str_equal (options[i], table[t])) return table[t + 1];
+  for (guint i = 0; options && options[i]; i++)
+    if (g_str_has_prefix (options[i], g_str_equal (table[0], "compose:menu") ? "compose:" : "lv3:")) return NULL; /* a choice the page doesn't offer */
+  return "off";
+}
+
+static void
+publish (Keyboard *self)
+{
+  g_autoptr (GVariant) sources = g_settings_get_value (self->settings, "sources");
+  g_autoptr (GVariant) mru = g_settings_get_value (self->settings, "mru-sources");
+  g_auto (GStrv) options = g_settings_get_strv (self->settings, "xkb-options");
+  JsonArray *list = json_array_new ();
+  JsonObject *layouts = json_object_new ();
+  g_autofree char *current = NULL;
+  const char *mru_type = NULL, *mru_id = NULL;
+  if (g_variant_n_children (mru)) g_variant_get_child (mru, 0, "(&s&s)", &mru_type, &mru_id);
+  for (gsize i = 0; i < g_variant_n_children (sources); i++)
+    {
+      const char *type, *id;
+      g_variant_get_child (sources, i, "(&s&s)", &type, &id);
+      g_autofree char *name = source_name (self, type, id);
+      json_array_add_string_element (list, name);
+      if (g_str_equal (type, "xkb") && !json_object_has_member (layouts, name))
+        {
+          JsonArray *caps = keycaps (self, id);
+          if (caps) json_object_set_array_member (layouts, name, caps);
+        }
+      if (!current || (mru_id && g_str_equal (type, mru_type) && g_str_equal (id, mru_id)))
+        { g_free (current); current = g_strdup (name); }
+    }
+  JsonObject *structure = json_node_get_object (self->structure);
+  JsonObject *kb = json_object_new ();
+  json_object_set_member (kb, "codes", json_node_copy (json_object_get_member (structure, "codes")));
+  json_object_set_member (kb, "w", json_node_copy (json_object_get_member (structure, "w")));
+  json_object_set_object_member (kb, "L", layouts);
+  g_autoptr (JsonNode) kb_node = json_node_init_object (json_node_alloc (), kb);
+  json_object_unref (kb);
+  g_autoptr (JsonNode) list_node = json_node_init_array (json_node_alloc (), list);
+  json_array_unref (list);
+  cc_luma_fixture_publish_data (self->model, "CFKB", kb_node);
+  cc_luma_fixture_publish (self->model, "srcs", list_node);
+  if (current) cc_luma_fixture_publish_string (self->model, "src", current);
+  const char *keys[] = { "altKey", "compose" };
+  const char * const *tables[] = { alt_options, compose_options };
+  for (guint k = 0; k < 2; k++)
+    {
+      const char *value = option_key (options, tables[k]);
+      if (value) cc_luma_fixture_publish_string (self->model, keys[k], value);
+      else { g_autoptr (JsonNode) none = json_node_init_null (json_node_alloc ()); cc_luma_fixture_publish (self->model, keys[k], none); }
+    }
+}
+
+static void changed (GSettings *settings, const char *key, Keyboard *self) { publish (self); }
+
+static gpointer
+keyboard_start (CcLumaFixture *model)
+{
+  Keyboard *self = g_new0 (Keyboard, 1);
+  JsonNode *structure = json_object_get_member (cc_luma_fixture_get_data (model), "CFKB");
+  self->model = g_object_ref (model);
+  if (!structure || !JSON_NODE_HOLDS_OBJECT (structure)) return self; /* never ready */
+  self->structure = json_node_copy (structure);
+  self->settings = g_settings_new (SOURCES);
+  self->xkb = gnome_xkb_info_new ();
+  self->context = xkb_context_new (XKB_CONTEXT_NO_FLAGS);
+  g_signal_connect (self->settings, "changed", G_CALLBACK (changed), self);
+  cc_luma_fixture_own_key (model, "altKey");
+  cc_luma_fixture_own_key (model, "compose");
+  publish (self);
+  self->gate = cc_luma_ready_gate_new (model, "keyboard", cc_luma_keyboard_validate);
+  return self;
+}
+
+/* The special keys, as the panel's special-character dialog writes them:
+ * drop the key's own options from xkb-options and add the chosen one. */
+static gboolean
+keyboard_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Keyboard *self = state;
+  gboolean alt = g_str_equal (key, "altKey");
+  if (!alt && !g_str_equal (key, "compose")) return FALSE;
+  const char * const *table = alt ? alt_options : compose_options;
+  const char *choice = value && JSON_NODE_HOLDS_VALUE (value) && json_node_get_value_type (value) == G_TYPE_STRING ? json_node_get_string (value) : NULL;
+  const char *option = NULL;
+  for (guint t = 0; choice && table[t]; t += 2)
+    if (g_str_equal (table[t + 1], choice)) option = table[t];
+  if (!self->settings || !choice || (!option && !g_str_equal (choice, "off")))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Unknown key choice");
+      return FALSE;
+    }
+  g_auto (GStrv) current = g_settings_get_strv (self->settings, "xkb-options");
+  g_autoptr (GStrvBuilder) next = g_strv_builder_new ();
+  for (guint i = 0; current[i]; i++)
+    {
+      gboolean ours = FALSE;
+      for (guint t = 0; table[t]; t += 2) ours |= g_str_equal (current[i], table[t]);
+      if (!ours) g_strv_builder_add (next, current[i]);
+    }
+  if (option) g_strv_builder_add (next, option);
+  g_auto (GStrv) options = g_strv_builder_end (next);
+  return g_settings_set_strv (self->settings, "xkb-options", (const char * const *) options);
+}
+
+static void
+keyboard_stop (gpointer state)
+{
+  Keyboard *self = state;
+  cc_luma_ready_gate_free (self->gate);
+  if (self->settings) { g_signal_handlers_disconnect_by_data (self->settings, self); g_object_unref (self->settings); }
+  g_clear_object (&self->xkb);
+  if (self->context) xkb_context_unref (self->context);
+  if (self->structure) json_node_unref (self->structure);
+  g_object_unref (self->model);
+  g_free (self);
+}
+
+/* The layout list's changes open GNOME's keyboard panel; the special keys
+ * write xkb-options (live only once VM-verified). */
+const CcLumaAdapter cc_luma_adapter_keyboard = {
+  "keyboard", (const char * const[]) { "keyboard", NULL }, keyboard_start, keyboard_write, keyboard_stop
+};
diff --git a/shell/cc-luma-live-network.c b/shell/cc-luma-live-network.c
new file mode 100644
index 0000000..413e7ab
--- /dev/null
+++ b/shell/cc-luma-live-network.c
@@ -0,0 +1,1023 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live Wi‑Fi, known networks, hotspot and wired/VPN: NetworkManager through
+ * libnm, the way panels/network (cc-wifi-panel, net-device-wifi,
+ * net-device-ethernet, net-vpn, cc-wifi-hotspot-dialog) reads and changes it.
+ * Joining a new secured network leaves the password to NetworkManager's secret
+ * agent (the shell's prompt), exactly as the Wi‑Fi panel does. */
+#include "cc-luma-live.h"
+#include <NetworkManager.h>
+#include <gio/gio.h>
+#include <string.h>
+#include "panels/network/qrcodegen.h"
+
+#define ADAPTER "network"
+static const char * const pages[] = { "wifi", "wifi-net", "wifi-known", "hotspot", "network", NULL };
+static const char * const owned[] = { "wifi", "autoJoin", "allUsers", "metered", "hotspot", "hsName", "hsPass",
+                                      "hsBand", "eth", "vpn", "CFNETS.join", "CFKNOWN.forget", NULL };
+
+typedef struct {
+  CcLumaFixture *model;
+  NMClient *client;
+  GDBusProxy *hostnamed;
+  GCancellable *cancel;
+  GHashTable *watched;
+  guint refresh;
+  gboolean ready;
+  /* The current network's password, fetched for its share code. */
+  char *share_uuid;
+  char *share_password;
+  gboolean share_fetching;
+  /* The hotspot's saved password. */
+  char *hs_uuid;
+  char *hs_password;
+  gboolean hs_fetching;
+  /* The person's hotspot edits, saved to the hotspot connection when valid. */
+  char *hs_name, *hs_pass, *hs_band;
+  guint hs_save;
+} Net;
+
+static void queue_refresh (Net *n);
+
+/* ── Reading ─────────────────────────────────────────────────────────── */
+static char *
+ssid_text (GBytes *ssid)
+{
+  gsize size;
+  const guint8 *bytes;
+  if (!ssid) return NULL;
+  bytes = g_bytes_get_data (ssid, &size);
+  return size ? nm_utils_ssid_to_utf8 (bytes, size) : NULL;
+}
+static char *
+connection_ssid (NMConnection *c)
+{
+  NMSettingWireless *w = nm_connection_get_setting_wireless (c);
+  return w ? ssid_text (nm_setting_wireless_get_ssid (w)) : NULL;
+}
+static gboolean
+is_hotspot (NMConnection *c)
+{
+  NMSettingWireless *w = c ? nm_connection_get_setting_wireless (c) : NULL;
+  NMSettingIPConfig *ip4 = c ? nm_connection_get_setting_ip4_config (c) : NULL;
+  const char *mode = w ? nm_setting_wireless_get_mode (w) : NULL;
+  return w && (g_strcmp0 (mode, "ap") == 0 || g_strcmp0 (mode, "adhoc") == 0) &&
+         ip4 && g_strcmp0 (nm_setting_ip_config_get_method (ip4), "shared") == 0;
+}
+static gboolean
+is_wifi_client (NMConnection *c)
+{
+  NMSettingWireless *w = nm_connection_get_setting_wireless (c);
+  const char *mode = w ? nm_setting_wireless_get_mode (w) : NULL;
+  return w && (!mode || g_str_equal (mode, "infrastructure"));
+}
+static gboolean
+is_vpn (NMConnection *c)
+{
+  return nm_connection_is_type (c, NM_SETTING_VPN_SETTING_NAME) ||
+         nm_connection_is_type (c, NM_SETTING_WIREGUARD_SETTING_NAME);
+}
+static NMDeviceWifi *
+wifi_device (Net *n)
+{
+  const GPtrArray *devices = nm_client_get_devices (n->client);
+  for (guint i = 0; devices && i < devices->len; i++)
+    {
+      NMDevice *d = g_ptr_array_index (devices, i);
+      if (NM_IS_DEVICE_WIFI (d) && nm_device_get_managed (d)) return NM_DEVICE_WIFI (d);
+    }
+  return NULL;
+}
+static NMDevice *
+ethernet_device (Net *n)
+{
+  const GPtrArray *devices = nm_client_get_devices (n->client);
+  NMDevice *found = NULL;
+  for (guint i = 0; devices && i < devices->len; i++)
+    {
+      NMDevice *d = g_ptr_array_index (devices, i);
+      if (!NM_IS_DEVICE_ETHERNET (d) || !nm_device_get_managed (d)) continue;
+      if (!found || nm_device_get_state (d) > nm_device_get_state (found)) found = d;
+    }
+  return found;
+}
+/* The Wi‑Fi device's own connection (joined network or hotspot). */
+static NMRemoteConnection *
+device_connection (NMDeviceWifi *dev, gboolean hotspot)
+{
+  NMActiveConnection *active = dev ? nm_device_get_active_connection (NM_DEVICE (dev)) : NULL;
+  NMRemoteConnection *remote = active ? nm_active_connection_get_connection (active) : NULL;
+  if (!remote || is_hotspot (NM_CONNECTION (remote)) != hotspot) return NULL;
+  return remote;
+}
+static NMRemoteConnection *
+current_connection (NMDeviceWifi *dev)
+{
+  if (!dev || nm_device_get_state (NM_DEVICE (dev)) != NM_DEVICE_STATE_ACTIVATED) return NULL;
+  return device_connection (dev, FALSE);
+}
+static NMRemoteConnection *
+hotspot_connection (Net *n, NMDeviceWifi *dev)
+{
+  NMRemoteConnection *active = device_connection (dev, TRUE), *found = NULL;
+  const GPtrArray *all = nm_client_get_connections (n->client);
+  if (active) return active;
+  for (guint i = 0; all && i < all->len; i++)
+    {
+      NMRemoteConnection *c = g_ptr_array_index (all, i);
+      if (!is_hotspot (NM_CONNECTION (c))) continue;
+      if (!found || g_strcmp0 (nm_connection_get_id (NM_CONNECTION (c)), "Hotspot") == 0) found = c;
+    }
+  return found;
+}
+static guint64
+timestamp (NMConnection *c)
+{
+  return nm_setting_connection_get_timestamp (nm_connection_get_setting_connection (c));
+}
+static gint
+newest_first (gconstpointer a, gconstpointer b)
+{
+  guint64 x = timestamp (*(NMConnection **) a), y = timestamp (*(NMConnection **) b);
+  return x < y ? 1 : x > y ? -1 : 0;
+}
+/* Saved networks this computer joins (not hotspots), most recently used first. */
+static GPtrArray *
+saved_networks (Net *n)
+{
+  const GPtrArray *all = nm_client_get_connections (n->client);
+  GPtrArray *list = g_ptr_array_new ();
+  for (guint i = 0; all && i < all->len; i++)
+    {
+      NMConnection *c = g_ptr_array_index (all, i);
+      if (is_wifi_client (c)) g_ptr_array_add (list, c);
+    }
+  g_ptr_array_sort (list, newest_first);
+  return list;
+}
+static NMConnection *
+first_vpn (Net *n)
+{
+  const GPtrArray *all = nm_client_get_connections (n->client);
+  g_autoptr (GPtrArray) list = g_ptr_array_new ();
+  for (guint i = 0; all && i < all->len; i++)
+    if (is_vpn (g_ptr_array_index (all, i))) g_ptr_array_add (list, g_ptr_array_index (all, i));
+  if (!list->len) return NULL;
+  g_ptr_array_sort (list, newest_first);
+  return g_ptr_array_index (list, 0);
+}
+static NMActiveConnection *
+active_for (Net *n, NMConnection *c)
+{
+  const GPtrArray *active = nm_client_get_active_connections (n->client);
+  for (guint i = 0; c && active && i < active->len; i++)
+    {
+      NMActiveConnection *a = g_ptr_array_index (active, i);
+      if (g_strcmp0 (nm_active_connection_get_uuid (a), nm_connection_get_uuid (c)) == 0) return a;
+    }
+  return NULL;
+}
+/* panels/network's signal icons: <40 weak, <50 ok, <80 good, else excellent. */
+static int
+bars (guint8 strength)
+{
+  return strength < 40 ? 1 : strength < 50 ? 2 : strength < 80 ? 3 : 4;
+}
+static const char *
+ap_security (NMAccessPoint *ap)
+{
+  NM80211ApSecurityFlags wpa = nm_access_point_get_wpa_flags (ap), rsn = nm_access_point_get_rsn_flags (ap);
+  if ((wpa | rsn) & NM_802_11_AP_SEC_KEY_MGMT_802_1X) return "Enterprise";
+  if (rsn & NM_802_11_AP_SEC_KEY_MGMT_SAE) return "WPA3";
+  if (rsn & NM_802_11_AP_SEC_KEY_MGMT_PSK) return "WPA2";
+  if (wpa & NM_802_11_AP_SEC_KEY_MGMT_PSK) return "WPA";
+  if (rsn & NM_802_11_AP_SEC_KEY_MGMT_OWE) return "Enhanced Open";
+  if (nm_access_point_get_flags (ap) & NM_802_11_AP_FLAGS_PRIVACY) return "WEP";
+  return "Open";
+}
+static gboolean
+ap_locked (NMAccessPoint *ap)
+{
+  const char *security = ap_security (ap);
+  return !g_str_equal (security, "Open") && !g_str_equal (security, "Enhanced Open");
+}
+static const char *
+band_text (guint32 frequency)
+{
+  return frequency > 5925 ? "6 GHz" : frequency > 4900 ? "5 GHz" : "2.4 GHz";
+}
+static const char *
+signal_word (int bars_lit)
+{
+  static const char *words[] = { "Weak", "Fair", "Good", "Excellent" };
+  return words[CLAMP (bars_lit, 1, 4) - 1];
+}
+static char *
+first_address (NMIPConfig *config, gboolean prefer_global)
+{
+  const GPtrArray *items = config ? nm_ip_config_get_addresses (config) : NULL;
+  const char *found = NULL;
+  for (guint i = 0; items && i < items->len; i++)
+    {
+      const char *address = nm_ip_address_get_address (g_ptr_array_index (items, i));
+      if (!found) found = address;
+      if (prefer_global && !g_str_has_prefix (address, "fe80")) return g_strdup (address);
+    }
+  return g_strdup (found);
+}
+static char *
+dns_text (NMConnection *c)
+{
+  NMSettingIPConfig *ip4 = nm_connection_get_setting_ip4_config (c);
+  g_autoptr (GPtrArray) servers = g_ptr_array_new ();
+  for (guint i = 0; ip4 && i < nm_setting_ip_config_get_num_dns (ip4); i++)
+    g_ptr_array_add (servers, (gpointer) nm_setting_ip_config_get_dns (ip4, i));
+  g_ptr_array_add (servers, NULL);
+  if (servers->len == 1) return g_strdup ("Automatic");
+  return g_strjoinv (", ", (char **) servers->pdata);
+}
+static char *
+hostname_ssid (Net *n)
+{
+  g_autoptr (GVariant) pretty = n->hostnamed ? g_dbus_proxy_get_cached_property (n->hostnamed, "PrettyHostname") : NULL;
+  const char *name = pretty ? g_variant_get_string (pretty, NULL) : NULL;
+  if (!name || !*name) name = g_get_host_name ();
+  /* An SSID holds 32 bytes; keep whole characters (pretty_hostname_to_ssid). */
+  const char *end = name;
+  while (*end && (end - name) + (g_utf8_next_char (end) - end) <= 32) end = g_utf8_next_char (end);
+  return g_strndup (name, end - name);
+}
+
+/* ── Share codes (panels/network cc-qr-code.c) ───────────────────────── */
+static void
+escape_into (GString *out, const char *text)
+{
+  for (const char *p = text; p && *p; p++)
+    {
+      if (strchr ("\\;,\":", *p)) g_string_append_c (out, '\\');
+      g_string_append_c (out, *p);
+    }
+}
+static const char *
+qr_security (NMConnection *c)
+{
+  NMSettingWirelessSecurity *s = nm_connection_get_setting_wireless_security (c);
+  const char *mgmt = s ? nm_setting_wireless_security_get_key_mgmt (s) : NULL;
+  if (!s) return "nopass";
+  if (g_strcmp0 (mgmt, "none") == 0) return "WEP";
+  if (g_strcmp0 (mgmt, "wpa-psk") == 0) return "WPA";
+  if (g_strcmp0 (mgmt, "sae") == 0) return "SAE";
+  return NULL; /* enterprise: no code (is_qr_code_supported) */
+}
+static char *
+share_svg (NMConnection *c, const char *password)
+{
+  const char *security = qr_security (c);
+  g_autofree char *name = connection_ssid (c);
+  NMSettingWireless *w = nm_connection_get_setting_wireless (c);
+  uint8_t code[qrcodegen_BUFFER_LEN_MAX], scratch[qrcodegen_BUFFER_LEN_MAX];
+  if (!security || !name || (!g_str_equal (security, "nopass") && (!password || !*password))) return g_strdup ("");
+  g_autoptr (GString) text = g_string_new ("WIFI:S:");
+  escape_into (text, name);
+  g_string_append_printf (text, ";T:%s;", security);
+  if (!g_str_equal (security, "nopass")) { g_string_append (text, "P:"); escape_into (text, password); g_string_append_c (text, ';'); }
+  if (w && nm_setting_wireless_get_hidden (w)) g_string_append (text, "H:true;");
+  g_string_append_c (text, ';');
+  if (!qrcodegen_encodeText (text->str, scratch, code, qrcodegen_Ecc_LOW, qrcodegen_VERSION_MIN,
+                             qrcodegen_VERSION_MAX, qrcodegen_Mask_AUTO, true))
+    return g_strdup ("");
+  int size = qrcodegen_getSize (code);
+  GString *svg = g_string_new (NULL);
+  g_string_append_printf (svg, "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"-2 -2 %d %d\">"
+                          "<rect x=\"-2\" y=\"-2\" width=\"%d\" height=\"%d\" fill=\"#fff\"/><g fill=\"#111\">",
+                          size + 4, size + 4, size + 4, size + 4);
+  for (int y = 0; y < size; y++)
+    for (int x = 0; x < size; x++)
+      if (qrcodegen_getModule (code, x, y))
+        g_string_append_printf (svg, "<rect x=\"%d\" y=\"%d\" width=\"1\" height=\"1\"/>", x, y);
+  g_string_append (svg, "</g></svg>");
+  return g_string_free (svg, FALSE);
+}
+static char *
+password_of (NMConnection *c)
+{
+  NMSettingWirelessSecurity *s = nm_connection_get_setting_wireless_security (c);
+  const char *mgmt = s ? nm_setting_wireless_security_get_key_mgmt (s) : NULL;
+  if (!s) return NULL;
+  if (g_strcmp0 (mgmt, "none") == 0)
+    return g_strdup (nm_setting_wireless_security_get_wep_key (s, nm_setting_wireless_security_get_wep_tx_keyidx (s)));
+  return g_strdup (nm_setting_wireless_security_get_psk (s));
+}
+typedef struct { Net *net; gboolean hotspot; char *uuid; } SecretsRequest;
+static void
+secrets_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  SecretsRequest *request = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) secrets = nm_remote_connection_get_secrets_finish (NM_REMOTE_CONNECTION (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) goto out;
+  Net *n = request->net;
+  char *password = NULL;
+  if (secrets)
+    {
+      g_autoptr (NMConnection) copy = nm_simple_connection_new_clone (NM_CONNECTION (source));
+      if (nm_connection_update_secrets (copy, NM_SETTING_WIRELESS_SECURITY_SETTING_NAME, secrets, NULL))
+        password = password_of (copy);
+    }
+  if (request->hotspot)
+    {
+      n->hs_fetching = FALSE;
+      if (g_strcmp0 (n->hs_uuid, request->uuid) == 0) { g_free (n->hs_password); n->hs_password = password ? password : g_strdup (""); }
+      else g_free (password);
+    }
+  else
+    {
+      n->share_fetching = FALSE;
+      if (g_strcmp0 (n->share_uuid, request->uuid) == 0) { g_free (n->share_password); n->share_password = password ? password : g_strdup (""); }
+      else g_free (password);
+    }
+  queue_refresh (n);
+out:
+  g_free (request->uuid);
+  g_free (request);
+}
+/* Fetch a saved password once per connection, as the panel does for its
+ * share code and hotspot dialog. Kept in memory only. */
+static void
+want_secrets (Net *n, NMRemoteConnection *c, gboolean hotspot)
+{
+  char **uuid = hotspot ? &n->hs_uuid : &n->share_uuid;
+  char **password = hotspot ? &n->hs_password : &n->share_password;
+  gboolean *fetching = hotspot ? &n->hs_fetching : &n->share_fetching;
+  const char *id = c ? nm_connection_get_uuid (NM_CONNECTION (c)) : NULL;
+  if (g_strcmp0 (*uuid, id) == 0 && (*password || *fetching)) return;
+  g_free (*uuid); *uuid = g_strdup (id);
+  g_clear_pointer (password, g_free);
+  if (!c) return;
+  if (!nm_connection_get_setting_wireless_security (NM_CONNECTION (c))) { *password = g_strdup (""); return; }
+  SecretsRequest *request = g_new0 (SecretsRequest, 1);
+  request->net = n; request->hotspot = hotspot; request->uuid = g_strdup (id);
+  *fetching = TRUE;
+  nm_remote_connection_get_secrets_async (c, NM_SETTING_WIRELESS_SECURITY_SETTING_NAME, n->cancel, secrets_done, request);
+}
+
+/* ── Publishing ──────────────────────────────────────────────────────── */
+static void
+watch (Net *n, gpointer object)
+{
+  if (!object || g_hash_table_contains (n->watched, object)) return;
+  g_hash_table_add (n->watched, g_object_ref (object));
+  g_signal_connect_swapped (object, "notify", G_CALLBACK (queue_refresh), n);
+}
+static void
+unwatch (Net *n)
+{
+  GHashTableIter iter;
+  gpointer object;
+  g_hash_table_iter_init (&iter, n->watched);
+  while (g_hash_table_iter_next (&iter, &object, NULL))
+    g_signal_handlers_disconnect_by_data (object, n);
+  g_hash_table_remove_all (n->watched);
+}
+static JsonObject *
+network_entry (const char *name, NMAccessPoint *ap, gboolean known)
+{
+  JsonObject *o = json_object_new ();
+  json_object_set_string_member (o, "n", name);
+  json_object_set_int_member (o, "sig", bars (nm_access_point_get_strength (ap)));
+  json_object_set_boolean_member (o, "lock", ap_locked (ap));
+  if (known) json_object_set_boolean_member (o, "known", TRUE);
+  /* Enterprise networks sign in through NetworkManager's prompt, not the page's form. */
+  if (g_str_equal (ap_security (ap), "Enterprise")) json_object_set_boolean_member (o, "ent", TRUE);
+  json_object_set_string_member (o, "band", band_text (nm_access_point_get_frequency (ap)));
+  return o;
+}
+static void
+publish_wired_and_vpn (Net *n, JsonObject *extra)
+{
+  NMDevice *eth = ethernet_device (n);
+  NMConnection *vpn = first_vpn (n);
+  NMActiveConnection *vpn_active = active_for (n, vpn);
+  JsonObject *wired = json_object_new ();
+  NMDeviceState state = eth ? nm_device_get_state (eth) : NM_DEVICE_STATE_UNKNOWN;
+  gboolean carrier = eth && nm_device_ethernet_get_carrier (NM_DEVICE_ETHERNET (eth));
+  const char *text = !eth ? "No Ethernet port" : state == NM_DEVICE_STATE_ACTIVATED ? "Connected" :
+    !carrier ? "Cable unplugged" : state > NM_DEVICE_STATE_DISCONNECTED && state < NM_DEVICE_STATE_ACTIVATED ? "Connecting…" : "Not connected";
+  watch (n, eth);
+  json_object_set_boolean_member (wired, "present", eth != NULL);
+  json_object_set_boolean_member (wired, "carrier", carrier);
+  json_object_set_string_member (wired, "state", text);
+  json_object_set_object_member (extra, "wired", wired);
+  cc_luma_fixture_publish_boolean (n->model, "eth", state == NM_DEVICE_STATE_ACTIVATED);
+  if (vpn)
+    {
+      JsonObject *o = json_object_new ();
+      const char *service = nm_connection_is_type (vpn, NM_SETTING_VPN_SETTING_NAME) ?
+        nm_setting_vpn_get_service_type (nm_connection_get_setting_vpn (vpn)) : NULL;
+      const char *kind = nm_connection_is_type (vpn, NM_SETTING_WIREGUARD_SETTING_NAME) ? "WireGuard" :
+        service && strstr (service, "openvpn") ? "OpenVPN" : service && strstr (service, "wireguard") ? "WireGuard" : "VPN";
+      json_object_set_string_member (o, "name", nm_connection_get_id (vpn));
+      json_object_set_string_member (o, "type", kind);
+      json_object_set_object_member (extra, "vpn", o);
+      watch (n, vpn); watch (n, vpn_active);
+    }
+  cc_luma_fixture_publish_boolean (n->model, "vpn", vpn_active &&
+    nm_active_connection_get_state (vpn_active) == NM_ACTIVE_CONNECTION_STATE_ACTIVATED);
+}
+static gboolean
+refresh (gpointer data)
+{
+  Net *n = data;
+  n->refresh = 0;
+  if (!n->client || !nm_client_get_nm_running (n->client)) return G_SOURCE_REMOVE;
+  unwatch (n);
+  watch (n, n->client);
+  NMDeviceWifi *dev = wifi_device (n);
+  NMRemoteConnection *current = current_connection (dev);
+  NMAccessPoint *active_ap = dev && current ? nm_device_wifi_get_active_access_point (dev) : NULL;
+  g_autofree char *network = current ? connection_ssid (NM_CONNECTION (current)) : NULL;
+  g_autoptr (GPtrArray) saved = saved_networks (n);
+  g_autoptr (GHashTable) known = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  JsonArray *known_list = json_array_new ();
+  watch (n, dev); watch (n, current); watch (n, active_ap);
+  for (guint i = 0; i < saved->len; i++)
+    {
+      char *name = connection_ssid (g_ptr_array_index (saved, i));
+      watch (n, g_ptr_array_index (saved, i));
+      if (!name || g_hash_table_contains (known, name)) { g_free (name); continue; }
+      json_array_add_string_element (known_list, name);
+      g_hash_table_add (known, name);
+    }
+  /* Nearby: one row per network name, its strongest access point (the
+   * joined one for the joined network). */
+  g_autoptr (GHashTable) best = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  const GPtrArray *points = dev ? nm_device_wifi_get_access_points (dev) : NULL;
+  for (guint i = 0; points && i < points->len; i++)
+    {
+      NMAccessPoint *ap = g_ptr_array_index (points, i);
+      g_autofree char *name = ssid_text (nm_access_point_get_ssid (ap));
+      NMAccessPoint *have;
+      if (!name || !*name) continue;
+      watch (n, ap);
+      have = g_hash_table_lookup (best, name);
+      if (ap == active_ap || !have || (have != active_ap && nm_access_point_get_strength (ap) > nm_access_point_get_strength (have)))
+        g_hash_table_insert (best, g_steal_pointer (&name), ap);
+    }
+  if (network && active_ap && !g_hash_table_contains (best, network))
+    g_hash_table_insert (best, g_strdup (network), active_ap);
+  JsonArray *nets = json_array_new ();
+  JsonObject *codes = json_object_new ();
+  {
+    /* Strongest first. */
+    g_autoptr (GPtrArray) sorted = g_ptr_array_new ();
+    GHashTableIter iter; gpointer key, value;
+    g_hash_table_iter_init (&iter, best);
+    while (g_hash_table_iter_next (&iter, &key, &value)) g_ptr_array_add (sorted, key);
+    for (guint i = 0; i < sorted->len; i++)
+      for (guint j = i + 1; j < sorted->len; j++)
+        {
+          NMAccessPoint *a = g_hash_table_lookup (best, g_ptr_array_index (sorted, i));
+          NMAccessPoint *b = g_hash_table_lookup (best, g_ptr_array_index (sorted, j));
+          if (nm_access_point_get_strength (b) > nm_access_point_get_strength (a))
+            {
+              gpointer t = sorted->pdata[i]; sorted->pdata[i] = sorted->pdata[j]; sorted->pdata[j] = t;
+            }
+        }
+    for (guint i = 0; i < sorted->len; i++)
+      {
+        const char *name = g_ptr_array_index (sorted, i);
+        json_array_add_object_element (nets, network_entry (name, g_hash_table_lookup (best, name), g_hash_table_contains (known, name)));
+        json_object_set_string_member (codes, name, "");
+      }
+  }
+  /* The joined network: its code, details and per-network settings. */
+  JsonObject *extra = json_object_new ();
+  want_secrets (n, current, FALSE);
+  if (network && active_ap)
+    {
+      g_autofree char *svg = share_svg (NM_CONNECTION (current), n->share_password);
+      NMIPConfig *ip4 = nm_device_get_ip4_config (NM_DEVICE (dev)), *ip6 = nm_device_get_ip6_config (NM_DEVICE (dev));
+      guint32 frequency = nm_access_point_get_frequency (active_ap), rate = nm_device_wifi_get_bitrate (dev);
+      /* libnm numbers 2.4 and 5 GHz channels; 6 GHz ones start at 5955 MHz = 1. */
+      guint channel = frequency > 5925 ? (frequency - 5950) / 5 : nm_utils_wifi_freq_to_channel (frequency);
+      g_autofree char *band = g_strdup_printf ("%s, channel %u", band_text (frequency), channel);
+      g_autofree char *speed = rate >= 1000000 ? g_strdup_printf ("%.1f Gb/s", rate / 1000000.0) : g_strdup_printf ("%u Mb/s", rate / 1000);
+      g_autofree char *v4 = first_address (ip4, FALSE), *v6 = first_address (ip6, TRUE), *dns = dns_text (NM_CONNECTION (current));
+      g_autofree char *summary = g_strdup_printf ("Connected · %s · %s", ap_security (active_ap), band_text (frequency));
+      JsonObject *details = json_object_new ();
+      watch (n, ip4); watch (n, ip6);
+      json_object_set_string_member (codes, network, svg);
+      json_object_set_string_member (details, "summary", summary);
+      json_object_set_string_member (details, "signal", signal_word (bars (nm_access_point_get_strength (active_ap))));
+      json_object_set_string_member (details, "speed", rate ? speed : "");
+      json_object_set_string_member (details, "security", ap_security (active_ap));
+      json_object_set_string_member (details, "band", band);
+      json_object_set_string_member (details, "ipv4", v4 ? v4 : "");
+      json_object_set_string_member (details, "ipv6", v6 ? v6 : "");
+      json_object_set_string_member (details, "router", ip4 && nm_ip_config_get_gateway (ip4) ? nm_ip_config_get_gateway (ip4) : "");
+      json_object_set_string_member (details, "dns", dns);
+      json_object_set_object_member (extra, "current", details);
+    }
+  else g_clear_pointer (&network, g_free);
+  {
+    NMSettingConnection *s = current ? nm_connection_get_setting_connection (NM_CONNECTION (current)) : NULL;
+    NMMetered metered = s ? nm_setting_connection_get_metered (s) : NM_METERED_UNKNOWN;
+    cc_luma_fixture_publish_boolean (n->model, "autoJoin", s && nm_setting_connection_get_autoconnect (s));
+    cc_luma_fixture_publish_boolean (n->model, "allUsers", s && nm_setting_connection_get_num_permissions (s) == 0);
+    cc_luma_fixture_publish_string (n->model, "metered", metered == NM_METERED_YES ? "yes" : metered == NM_METERED_NO ? "no" : "auto");
+  }
+  /* Hotspot: NM's shared access-point connection. */
+  {
+    NMRemoteConnection *hs = hotspot_connection (n, dev);
+    NMRemoteConnection *hs_active = device_connection (dev, TRUE);
+    NMSettingWireless *w = hs ? nm_connection_get_setting_wireless (NM_CONNECTION (hs)) : NULL;
+    const char *band = w ? nm_setting_wireless_get_band (w) : NULL;
+    g_autofree char *hs_ssid = hs ? connection_ssid (NM_CONNECTION (hs)) : hostname_ssid (n);
+    watch (n, hs);
+    want_secrets (n, hs, TRUE);
+    cc_luma_fixture_publish_boolean (n->model, "hotspot", hs_active != NULL);
+    cc_luma_fixture_publish_string (n->model, "hsName", n->hs_name ? n->hs_name : hs_ssid);
+    cc_luma_fixture_publish_string (n->model, "hsPass", n->hs_pass ? n->hs_pass : n->hs_password);
+    cc_luma_fixture_publish_string (n->model, "hsBand", n->hs_band ? n->hs_band :
+                                    g_strcmp0 (band, "a") == 0 ? "5" : g_strcmp0 (band, "bg") == 0 ? "2" : "auto");
+  }
+  publish_wired_and_vpn (n, extra);
+  json_object_set_object_member (extra, "share_codes", codes);
+  json_object_set_string_member (extra, "share_password", network && n->share_password ? n->share_password : "");
+  {
+    g_autoptr (JsonNode) node = json_node_init_array (json_node_alloc (), nets);
+    cc_luma_fixture_publish_data (n->model, "CFNETS", node);
+  }
+  {
+    g_autoptr (JsonNode) node = json_node_init_array (json_node_alloc (), known_list);
+    cc_luma_fixture_publish_data (n->model, "CFKNOWN", node);
+  }
+  {
+    g_autoptr (JsonNode) node = json_node_init_object (json_node_alloc (), extra);
+    cc_luma_fixture_publish_data (n->model, "CFWIFI", node);
+  }
+  json_array_unref (nets); json_array_unref (known_list); json_object_unref (extra);
+  /* No Wi‑Fi radio reads as off, as the panel's "No Wi‑Fi adapter". */
+  cc_luma_fixture_publish_boolean (n->model, "wifi", dev && nm_client_wireless_get_enabled (n->client) &&
+                                   nm_client_wireless_hardware_get_enabled (n->client));
+  cc_luma_fixture_publish_string (n->model, "net", network);
+  if (!n->ready) { n->ready = TRUE; cc_luma_live_ready (n->model, ADAPTER); }
+  return G_SOURCE_REMOVE;
+}
+static void
+queue_refresh (Net *n)
+{
+  if (!n->refresh) n->refresh = g_idle_add (refresh, n);
+}
+
+/* ── Writing ─────────────────────────────────────────────────────────── */
+static void
+report (Net *n, GError *error)
+{
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  if (error) g_warning ("Settings: NetworkManager refused a change: %s", error->message);
+  queue_refresh (n);
+}
+static void
+updated (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) out = nm_remote_connection_update2_finish (NM_REMOTE_CONNECTION (source), result, &error);
+  report (data, error);
+}
+static void
+disconnected (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  nm_device_disconnect_finish (NM_DEVICE (source), result, &error);
+  report (data, error);
+}
+static void
+activated (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (NMActiveConnection) active = nm_client_activate_connection_finish (NM_CLIENT (source), result, &error);
+  report (data, error);
+}
+static void
+added (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (NMActiveConnection) active = nm_client_add_and_activate_connection_finish (NM_CLIENT (source), result, &error);
+  report (data, error);
+}
+static void
+deactivated (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  nm_client_deactivate_connection_finish (NM_CLIENT (source), result, &error);
+  report (data, error);
+}
+static void
+property_set (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  nm_client_dbus_set_property_finish (NM_CLIENT (source), result, &error);
+  report (data, error);
+}
+static void
+deleted (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  if (!nm_remote_connection_delete_finish (NM_REMOTE_CONNECTION (source), result, &error) &&
+      !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    g_warning ("Settings: could not forget a network: %s", error->message);
+}
+static void
+update (Net *n, NMRemoteConnection *remote, NMConnection *copy, GAsyncReadyCallback callback, gpointer data)
+{
+  nm_remote_connection_update2 (remote, nm_connection_to_dbus (copy, NM_CONNECTION_SERIALIZE_ALL),
+                                NM_SETTINGS_UPDATE2_FLAG_TO_DISK, NULL, n->cancel,
+                                callback ? callback : updated, callback ? data : n);
+}
+static gboolean
+fail (GError **error, const char *message)
+{
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_FAILED, message);
+  return FALSE;
+}
+static gboolean
+edit_current (Net *n, const char *key, JsonNode *value, GError **error)
+{
+  NMRemoteConnection *remote = current_connection (wifi_device (n));
+  if (!remote) return fail (error, "Join a network to change its settings");
+  g_autoptr (NMConnection) copy = nm_simple_connection_new_clone (NM_CONNECTION (remote));
+  NMSettingConnection *s = nm_connection_get_setting_connection (copy);
+  if (g_str_equal (key, "autoJoin"))
+    g_object_set (s, NM_SETTING_CONNECTION_AUTOCONNECT, json_node_get_boolean (value), NULL);
+  else if (g_str_equal (key, "metered"))
+    {
+      const char *m = json_node_get_string (value);
+      g_object_set (s, NM_SETTING_CONNECTION_METERED, g_str_equal (m, "yes") ? NM_METERED_YES :
+                    g_str_equal (m, "no") ? NM_METERED_NO : NM_METERED_UNKNOWN, NULL);
+    }
+  else if (json_node_get_boolean (value)) /* allUsers, as the connection editor's "all users" */
+    g_object_set (s, NM_SETTING_CONNECTION_PERMISSIONS, NULL, NULL);
+  else
+    {
+      g_object_set (s, NM_SETTING_CONNECTION_PERMISSIONS, NULL, NULL);
+      nm_setting_connection_add_permission (s, "user", g_get_user_name (), NULL);
+    }
+  update (n, remote, copy, NULL, NULL);
+  return TRUE;
+}
+static NMAccessPoint *
+strongest_ap (NMDeviceWifi *dev, const char *name)
+{
+  const GPtrArray *points = dev ? nm_device_wifi_get_access_points (dev) : NULL;
+  NMAccessPoint *best = NULL;
+  for (guint i = 0; points && i < points->len; i++)
+    {
+      NMAccessPoint *ap = g_ptr_array_index (points, i);
+      g_autofree char *ssid = ssid_text (nm_access_point_get_ssid (ap));
+      if (g_strcmp0 (ssid, name) == 0 && (!best || nm_access_point_get_strength (ap) > nm_access_point_get_strength (best)))
+        best = ap;
+    }
+  return best;
+}
+/* net-device-wifi.c wireless_try_to_connect, with the password the person
+ * typed on the page handed to NetworkManager in the new connection. If it is
+ * wrong NetworkManager asks again through its agent (the shell's prompt),
+ * which also signs in to enterprise networks. */
+static gboolean
+join (Net *n, const char *name, const char *password, gboolean hidden, GError **error)
+{
+  NMDeviceWifi *dev = wifi_device (n);
+  NMAccessPoint *ap = dev && name ? strongest_ap (dev, name) : NULL;
+  if (!dev) return fail (error, "This computer has no Wi‑Fi");
+  if (!name || !*name) return fail (error, "Type the network’s name");
+  if (!ap && !hidden) return fail (error, "That network is out of range");
+  if (ap)
+    {
+      g_autoptr (GPtrArray) saved = saved_networks (n);
+      g_autoptr (GPtrArray) usable = nm_access_point_filter_connections (ap, saved);
+      if (usable && usable->len)
+        {
+          nm_client_activate_connection_async (n->client, g_ptr_array_index (usable, 0), NM_DEVICE (dev),
+                                               nm_object_get_path (NM_OBJECT (ap)), n->cancel, activated, n);
+          return TRUE;
+        }
+    }
+  NM80211ApSecurityFlags rsn = ap ? nm_access_point_get_rsn_flags (ap) : 0, wpa = ap ? nm_access_point_get_wpa_flags (ap) : 0;
+  gboolean enterprise = ((rsn | wpa) & NM_802_11_AP_SEC_KEY_MGMT_802_1X) != 0;
+  gboolean wep = ap && !rsn && !wpa && (nm_access_point_get_flags (ap) & NM_802_11_AP_FLAGS_PRIVACY);
+  gsize length = password ? strlen (password) : 0;
+  g_autoptr (NMConnection) partial = nm_simple_connection_new ();
+  NMSettingConnection *s_con = NM_SETTING_CONNECTION (nm_setting_connection_new ());
+  if (nm_client_get_permission_result (n->client, NM_CLIENT_PERMISSION_SETTINGS_MODIFY_SYSTEM) != NM_CLIENT_PERMISSION_RESULT_YES)
+    nm_setting_connection_add_permission (s_con, "user", g_get_user_name (), NULL);
+  nm_connection_add_setting (partial, NM_SETTING (s_con));
+  if (hidden)
+    {
+      NMSetting *w = nm_setting_wireless_new ();
+      g_autoptr (GBytes) ssid = g_bytes_new (name, strlen (name));
+      g_object_set (w, NM_SETTING_WIRELESS_SSID, ssid, NM_SETTING_WIRELESS_HIDDEN, TRUE, NULL);
+      nm_connection_add_setting (partial, w);
+    }
+  if (enterprise)
+    {
+      NMSetting8021x *x = NM_SETTING_802_1X (nm_setting_802_1x_new ());
+      NMSetting *sec = nm_setting_wireless_security_new ();
+      nm_setting_802_1x_add_eap_method (x, "peap");
+      g_object_set (x, NM_SETTING_802_1X_PHASE2_AUTH, "mschapv2", NULL);
+      g_object_set (sec, NM_SETTING_WIRELESS_SECURITY_KEY_MGMT, "wpa-eap", NULL);
+      nm_connection_add_setting (partial, NM_SETTING (x));
+      nm_connection_add_setting (partial, sec);
+    }
+  else if (length)
+    {
+      NMSetting *sec = nm_setting_wireless_security_new ();
+      if (wep)
+        g_object_set (sec, NM_SETTING_WIRELESS_SECURITY_KEY_MGMT, "none", NM_SETTING_WIRELESS_SECURITY_WEP_KEY0, password,
+                      NM_SETTING_WIRELESS_SECURITY_WEP_KEY_TYPE,
+                      length == 5 || length == 13 || length == 10 || length == 26 ? NM_WEP_KEY_TYPE_KEY : NM_WEP_KEY_TYPE_PASSPHRASE, NULL);
+      else
+        {
+          if (length < 8 || length > 64) { g_object_unref (sec); return fail (error, "The password needs 8 to 63 characters"); }
+          g_object_set (sec, NM_SETTING_WIRELESS_SECURITY_KEY_MGMT,
+                        (rsn & NM_802_11_AP_SEC_KEY_MGMT_SAE) && !(rsn & NM_802_11_AP_SEC_KEY_MGMT_PSK) ? "sae" : "wpa-psk",
+                        NM_SETTING_WIRELESS_SECURITY_PSK, password, NULL);
+        }
+      nm_connection_add_setting (partial, sec);
+    }
+  nm_client_add_and_activate_connection_async (n->client, partial, NM_DEVICE (dev), ap ? nm_object_get_path (NM_OBJECT (ap)) : NULL,
+                                               n->cancel, added, n);
+  return TRUE;
+}
+static gboolean
+forget (Net *n, const char *name, GError **error)
+{
+  g_autoptr (GPtrArray) saved = saved_networks (n);
+  guint count = 0;
+  for (guint i = 0; i < saved->len; i++)
+    {
+      g_autofree char *ssid = connection_ssid (g_ptr_array_index (saved, i));
+      if (g_strcmp0 (ssid, name) != 0) continue;
+      nm_remote_connection_delete_async (g_ptr_array_index (saved, i), n->cancel, deleted, n);
+      count++;
+    }
+  return count ? TRUE : fail (error, "This network isn’t saved on this computer");
+}
+static char *
+random_wpa_key (void)
+{
+  static const char set[] = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789";
+  char key[9];
+  for (guint i = 0; i < 8; i++) key[i] = set[g_random_int_range (0, sizeof set - 1)];
+  key[8] = 0;
+  return g_strdup (key);
+}
+static gboolean
+valid_password (const char *password)
+{
+  gsize length = password ? strlen (password) : 0;
+  return length >= 8 && length <= 63;
+}
+/* cc-wifi-hotspot-dialog.c: the shared access point's settings. */
+static NMConnection *
+hotspot_settings (Net *n, NMDeviceWifi *dev, NMRemoteConnection *existing, char **password_out, GError **error)
+{
+  NMConnection *c = existing ? nm_simple_connection_new_clone (NM_CONNECTION (existing)) : nm_simple_connection_new ();
+  g_autofree char *default_name = existing ? connection_ssid (NM_CONNECTION (existing)) : hostname_ssid (n);
+  const char *name = n->hs_name ? n->hs_name : default_name;
+  const char *band = n->hs_band ? n->hs_band : NULL;
+  g_autofree char *password = g_strdup (n->hs_pass ? n->hs_pass : n->hs_password);
+  NMDeviceWifiCapabilities caps = nm_device_wifi_get_capabilities (dev);
+  NMSetting *s;
+  if (!name || !*name) { g_object_unref (c); fail (error, "Give the hotspot a name"); return NULL; }
+  if (password && *password && !valid_password (password))
+    { g_object_unref (c); fail (error, "The password needs 8 to 63 characters"); return NULL; }
+  if (!password || !*password) { g_free (password); password = random_wpa_key (); }
+  if (!nm_connection_get_setting_connection (c))
+    {
+      s = nm_setting_connection_new ();
+      g_autofree char *uuid = nm_utils_uuid_generate ();
+      g_object_set (s, NM_SETTING_CONNECTION_TYPE, NM_SETTING_WIRELESS_SETTING_NAME, NM_SETTING_CONNECTION_ID, "Hotspot",
+                    NM_SETTING_CONNECTION_UUID, uuid, NM_SETTING_CONNECTION_AUTOCONNECT, FALSE, NULL);
+      nm_connection_add_setting (c, s);
+    }
+  if (!nm_connection_get_setting_ip4_config (c))
+    {
+      s = nm_setting_ip4_config_new ();
+      g_object_set (s, NM_SETTING_IP_CONFIG_METHOD, NM_SETTING_IP4_CONFIG_METHOD_SHARED, NULL);
+      nm_connection_add_setting (c, s);
+    }
+  if (!nm_connection_get_setting_wireless (c)) nm_connection_add_setting (c, nm_setting_wireless_new ());
+  s = NM_SETTING (nm_connection_get_setting_wireless (c));
+  g_autoptr (GBytes) ssid = g_bytes_new (name, strlen (name));
+  g_object_set (s, NM_SETTING_WIRELESS_MODE, caps & NM_WIFI_DEVICE_CAP_AP ? "ap" : "adhoc", NM_SETTING_WIRELESS_SSID, ssid, NULL);
+  if (band) g_object_set (s, NM_SETTING_WIRELESS_BAND, g_str_equal (band, "5") ? "a" : g_str_equal (band, "2") ? "bg" : NULL, NULL);
+  if (!nm_connection_get_setting_wireless_security (c)) nm_connection_add_setting (c, nm_setting_wireless_security_new ());
+  NMSettingWirelessSecurity *sec = nm_connection_get_setting_wireless_security (c);
+  nm_setting_wireless_security_clear_protos (sec);
+  nm_setting_wireless_security_clear_pairwise (sec);
+  nm_setting_wireless_security_clear_groups (sec);
+  g_object_set (sec, NM_SETTING_WIRELESS_SECURITY_KEY_MGMT, "wpa-psk", NM_SETTING_WIRELESS_SECURITY_PSK, password, NULL);
+  if (caps & NM_WIFI_DEVICE_CAP_RSN)
+    {
+      nm_setting_wireless_security_add_proto (sec, "rsn");
+      nm_setting_wireless_security_add_pairwise (sec, "ccmp");
+      nm_setting_wireless_security_add_group (sec, "ccmp");
+    }
+  else if (caps & NM_WIFI_DEVICE_CAP_WPA)
+    {
+      nm_setting_wireless_security_add_proto (sec, "wpa");
+      nm_setting_wireless_security_add_pairwise (sec, "tkip");
+      nm_setting_wireless_security_add_group (sec, "tkip");
+    }
+  *password_out = g_steal_pointer (&password);
+  return c;
+}
+typedef struct { Net *net; NMRemoteConnection *connection; NMDeviceWifi *device; gboolean activate; } HotspotSave;
+static void
+hotspot_saved (GObject *source, GAsyncResult *result, gpointer data)
+{
+  HotspotSave *save = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) out = nm_remote_connection_update2_finish (NM_REMOTE_CONNECTION (source), result, &error);
+  if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    {
+      if (error) g_warning ("Settings: could not save the hotspot: %s", error->message);
+      else if (save->activate)
+        nm_client_activate_connection_async (save->net->client, NM_CONNECTION (save->connection), NM_DEVICE (save->device),
+                                             NULL, save->net->cancel, activated, save->net);
+      queue_refresh (save->net);
+    }
+  g_object_unref (save->connection);
+  g_object_unref (save->device);
+  g_free (save);
+}
+static gboolean
+apply_hotspot (Net *n, gboolean activate, GError **error)
+{
+  NMDeviceWifi *dev = wifi_device (n);
+  NMRemoteConnection *existing;
+  g_autofree char *password = NULL;
+  if (!dev) return fail (error, "This computer has no Wi‑Fi to share a connection with");
+  existing = hotspot_connection (n, dev);
+  if (!existing && !activate) return TRUE; /* saved when the hotspot is first turned on */
+  g_autoptr (NMConnection) settings = hotspot_settings (n, dev, existing, &password, error);
+  if (!settings) return FALSE;
+  g_clear_pointer (&n->hs_name, g_free);
+  g_clear_pointer (&n->hs_pass, g_free);
+  g_clear_pointer (&n->hs_band, g_free);
+  g_free (n->hs_password); n->hs_password = g_steal_pointer (&password);
+  if (existing)
+    {
+      HotspotSave *save = g_new0 (HotspotSave, 1);
+      save->net = n; save->connection = g_object_ref (existing); save->device = g_object_ref (dev); save->activate = activate;
+      g_free (n->hs_uuid); n->hs_uuid = g_strdup (nm_connection_get_uuid (NM_CONNECTION (existing)));
+      update (n, existing, settings, hotspot_saved, save);
+    }
+  else
+    {
+      g_free (n->hs_uuid); n->hs_uuid = g_strdup (nm_connection_get_uuid (settings));
+      nm_client_add_and_activate_connection_async (n->client, settings, NM_DEVICE (dev), NULL, n->cancel, added, n);
+    }
+  return TRUE;
+}
+static gboolean
+save_hotspot (gpointer data)
+{
+  Net *n = data;
+  g_autoptr (GError) error = NULL;
+  n->hs_save = 0;
+  if ((n->hs_name && !*n->hs_name) || (n->hs_pass && !valid_password (n->hs_pass))) return G_SOURCE_REMOVE;
+  if (!apply_hotspot (n, FALSE, &error)) g_warning ("Settings: %s", error->message);
+  return G_SOURCE_REMOVE;
+}
+static gboolean
+write_hotspot (Net *n, gboolean on, GError **error)
+{
+  NMDeviceWifi *dev = wifi_device (n);
+  NMActiveConnection *active = dev ? nm_device_get_active_connection (NM_DEVICE (dev)) : NULL;
+  g_clear_handle_id (&n->hs_save, g_source_remove);
+  if (on) return apply_hotspot (n, TRUE, error);
+  if (!active || !device_connection (dev, TRUE)) return TRUE;
+  nm_client_deactivate_connection_async (n->client, active, n->cancel, deactivated, n);
+  return TRUE;
+}
+static gboolean
+write_wired (Net *n, gboolean on, GError **error)
+{
+  NMDevice *eth = ethernet_device (n);
+  if (!eth) return fail (error, "This computer has no Ethernet port");
+  if (on) nm_client_activate_connection_async (n->client, NULL, eth, NULL, n->cancel, activated, n);
+  else nm_device_disconnect_async (eth, n->cancel, disconnected, n);
+  return TRUE;
+}
+static gboolean
+write_vpn (Net *n, gboolean on, GError **error)
+{
+  NMConnection *c = first_vpn (n);
+  NMActiveConnection *active = active_for (n, c);
+  if (!c) return fail (error, "Add a VPN first");
+  if (on && !active) nm_client_activate_connection_async (n->client, c, NULL, NULL, n->cancel, activated, n);
+  else if (!on && active) nm_client_deactivate_connection_async (n->client, active, n->cancel, deactivated, n);
+  return TRUE;
+}
+static gboolean
+net_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Net *n = state;
+  if (!g_strv_contains (owned, key)) return FALSE;
+  if (!n->client || !nm_client_get_nm_running (n->client)) return fail (error, "NetworkManager isn’t running");
+  if (g_str_equal (key, "CFNETS.join") && JSON_NODE_HOLDS_OBJECT (value))
+    {
+      JsonObject *o = json_node_get_object (value);
+      return join (n, json_object_get_string_member_with_default (o, "n", NULL),
+                   json_object_get_string_member_with_default (o, "psk", NULL),
+                   json_object_get_boolean_member_with_default (o, "hidden", FALSE), error);
+    }
+  if (!JSON_NODE_HOLDS_VALUE (value)) return fail (error, "Invalid value");
+  if (g_str_equal (key, "wifi"))
+    {
+      if (!wifi_device (n) && json_node_get_boolean (value)) return fail (error, "This computer has no Wi‑Fi");
+      nm_client_dbus_set_property (n->client, NM_DBUS_PATH, NM_DBUS_INTERFACE, "WirelessEnabled",
+                                   g_variant_new_boolean (json_node_get_boolean (value)), -1, n->cancel, property_set, n);
+      return TRUE;
+    }
+  if (g_str_equal (key, "autoJoin") || g_str_equal (key, "allUsers") || g_str_equal (key, "metered"))
+    return edit_current (n, key, value, error);
+  if (g_str_equal (key, "CFNETS.join")) return join (n, json_node_get_string (value), NULL, FALSE, error);
+  if (g_str_equal (key, "CFKNOWN.forget")) return forget (n, json_node_get_string (value), error);
+  if (g_str_equal (key, "hotspot")) return write_hotspot (n, json_node_get_boolean (value), error);
+  if (g_str_equal (key, "eth")) return write_wired (n, json_node_get_boolean (value), error);
+  if (g_str_equal (key, "vpn")) return write_vpn (n, json_node_get_boolean (value), error);
+  /* hsName, hsPass, hsBand: kept as typed, saved to the hotspot once valid. */
+  char **slot = g_str_equal (key, "hsName") ? &n->hs_name : g_str_equal (key, "hsPass") ? &n->hs_pass : &n->hs_band;
+  g_free (*slot); *slot = g_strdup (json_node_get_string (value));
+  g_clear_handle_id (&n->hs_save, g_source_remove);
+  n->hs_save = g_timeout_add (800, save_hotspot, n);
+  return TRUE;
+}
+
+/* ── Lifetime ────────────────────────────────────────────────────────── */
+static void
+client_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  NMClient *client = nm_client_new_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Net *n = data;
+  if (!client) { g_warning ("Settings: NetworkManager: %s", error->message); return; }
+  n->client = client;
+  g_signal_connect_swapped (client, "notify", G_CALLBACK (queue_refresh), n);
+  g_signal_connect_swapped (client, "any-device-added", G_CALLBACK (queue_refresh), n);
+  g_signal_connect_swapped (client, "any-device-removed", G_CALLBACK (queue_refresh), n);
+  g_signal_connect_swapped (client, "connection-added", G_CALLBACK (queue_refresh), n);
+  g_signal_connect_swapped (client, "connection-removed", G_CALLBACK (queue_refresh), n);
+  g_signal_connect_swapped (client, "active-connection-added", G_CALLBACK (queue_refresh), n);
+  g_signal_connect_swapped (client, "active-connection-removed", G_CALLBACK (queue_refresh), n);
+  g_signal_connect_swapped (client, "permission-changed", G_CALLBACK (queue_refresh), n);
+  queue_refresh (n);
+}
+static void
+hostnamed_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Net *n = data;
+  n->hostnamed = proxy;
+  if (proxy) g_signal_connect_swapped (proxy, "g-properties-changed", G_CALLBACK (queue_refresh), n);
+  queue_refresh (n);
+}
+static gpointer
+net_start (CcLumaFixture *model)
+{
+  Net *n = g_new0 (Net, 1);
+  n->model = model;
+  n->cancel = g_cancellable_new ();
+  n->watched = g_hash_table_new_full (g_direct_hash, g_direct_equal, g_object_unref, NULL);
+  for (guint i = 0; owned[i]; i++) cc_luma_fixture_own_key (model, owned[i]);
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_NONE, NULL, "org.freedesktop.hostname1",
+                            "/org/freedesktop/hostname1", "org.freedesktop.hostname1", n->cancel, hostnamed_ready, n);
+  nm_client_new_async (n->cancel, client_ready, n);
+  return n;
+}
+static void
+net_stop (gpointer state)
+{
+  Net *n = state;
+  g_cancellable_cancel (n->cancel);
+  g_clear_object (&n->cancel);
+  g_clear_handle_id (&n->refresh, g_source_remove);
+  g_clear_handle_id (&n->hs_save, g_source_remove);
+  unwatch (n);
+  g_hash_table_unref (n->watched);
+  if (n->client) g_signal_handlers_disconnect_by_data (n->client, n);
+  if (n->hostnamed) g_signal_handlers_disconnect_by_data (n->hostnamed, n);
+  g_clear_object (&n->client);
+  g_clear_object (&n->hostnamed);
+  g_free (n->share_uuid); g_free (n->share_password);
+  g_free (n->hs_uuid); g_free (n->hs_password);
+  g_free (n->hs_name); g_free (n->hs_pass); g_free (n->hs_band);
+  g_free (n);
+}
+
+const CcLumaAdapter cc_luma_adapter_network = { ADAPTER, pages, net_start, net_write, net_stop };
diff --git a/shell/cc-luma-live-notifications.c b/shell/cc-luma-live-notifications.c
new file mode 100644
index 0000000..8a8844c
--- /dev/null
+++ b/shell/cc-luma-live-notifications.c
@@ -0,0 +1,205 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Notifications: org.gnome.desktop.notifications and one child per app, the
+ * apps panels/notifications lists: those GNOME Shell has recorded
+ * (application-children) and those that declare X-GNOME-UsesNotifications,
+ * never system services. Each app is its canonical id (na.<id>). v70's
+ * "Stay on screen for" has no owner and is not published. */
+#include "cc-luma-live-gsettings.h"
+#include "cc-luma-live-apps.h"
+#include "cc-luma-discovery.h"
+#include <gio/gdesktopappinfo.h>
+#include <string.h>
+
+#define MASTER_SCHEMA "org.gnome.desktop.notifications"
+#define APP_SCHEMA MASTER_SCHEMA ".application"
+#define APP_PREFIX "/org/gnome/desktop/notifications/application/"
+
+static const CcLumaGsRow rows[] = {
+  { "dnd", MASTER_SCHEMA, "show-banners", CC_LUMA_GS_NOT },
+  { "lockN", MASTER_SCHEMA, "show-in-lock-screen", CC_LUMA_GS_BOOLEAN },
+};
+
+typedef struct {
+  CcLumaFixture *model;
+  CcLumaGsTable *table;
+  CcLumaReadyGate *gate;
+  GSettings *master;
+  GAppInfoMonitor *monitor;
+  GHashTable *apps; /* canonical id → GSettings (the app's child) */
+  guint idle;
+} Notifications;
+
+static gboolean
+system_service (GDesktopAppInfo *app)
+{
+  const char *categories = g_desktop_app_info_get_categories (app);
+  if (!categories || !*categories) return FALSE;
+  g_auto (GStrv) split = g_strsplit (categories, ";", -1);
+  return g_strv_contains ((const char * const *) split, "X-GNOME-Settings-Panel") ||
+         g_strv_contains ((const char * const *) split, "Settings") ||
+         g_strv_contains ((const char * const *) split, "System");
+}
+
+/* panels/notifications app_info_get_id + g_strcanon + lower case. */
+static char *
+canonical_id (GAppInfo *info)
+{
+  const char *desktop_id = g_app_info_get_id (info);
+  g_autofree char *id = desktop_id ? g_strdup (desktop_id)
+                                   : g_path_get_basename (g_desktop_app_info_get_filename (G_DESKTOP_APP_INFO (info)));
+  if (!id || !g_str_has_suffix (id, ".desktop")) return NULL;
+  id[strlen (id) - strlen (".desktop")] = '\0';
+  g_strcanon (id, "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-", '-');
+  for (guint i = 0; id[i]; i++) id[i] = g_ascii_tolower (id[i]);
+  return g_steal_pointer (&id);
+}
+
+static void publish_apps (Notifications *self);
+
+static void
+add_app (Notifications *self, GHashTable *seen, const char *id, GAppInfo *info)
+{
+  if (!id || !*id || g_hash_table_contains (seen, id) || system_service (G_DESKTOP_APP_INFO (info))) return;
+  if (!cc_luma_live_publish_app (self->model, id, info)) return;
+  g_hash_table_add (seen, g_strdup (id));
+  if (g_hash_table_contains (self->apps, id)) return;
+  g_autofree char *path = g_strconcat (APP_PREFIX, id, "/", NULL);
+  GSettings *settings = g_settings_new_with_path (APP_SCHEMA, path);
+  g_signal_connect_swapped (settings, "changed::enable", G_CALLBACK (publish_apps), self);
+  g_hash_table_insert (self->apps, g_strdup (id), settings);
+  g_autofree char *key = g_strconcat ("na.", id, NULL);
+  cc_luma_fixture_own_key (self->model, key);
+}
+
+static int
+by_name (gconstpointer a, gconstpointer b, gpointer model)
+{
+  const char *x = cc_luma_app_name (model, a), *y = cc_luma_app_name (model, b);
+  int order = g_utf8_collate (x ? x : "", y ? y : "");
+  return order ? order : g_strcmp0 (a, b);
+}
+
+static void
+publish_apps (Notifications *self)
+{
+  g_autoptr (GList) ids = g_hash_table_get_keys (self->apps);
+  ids = g_list_sort_with_data (ids, by_name, self->model);
+  g_autoptr (JsonNode) node = json_node_init_object (json_node_alloc (), json_object_new ());
+  for (GList *i = ids; i; i = i->next)
+    json_object_set_boolean_member (json_node_get_object (node), i->data,
+                                    g_settings_get_boolean (g_hash_table_lookup (self->apps, i->data), "enable"));
+  cc_luma_fixture_publish (self->model, "na", node);
+}
+
+static gboolean
+scan (gpointer data)
+{
+  Notifications *self = data;
+  g_autoptr (GHashTable) seen = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  self->idle = 0;
+  /* Apps GNOME Shell has recorded, while they are installed. */
+  g_auto (GStrv) children = g_settings_get_strv (self->master, "application-children");
+  for (guint i = 0; children[i]; i++)
+    {
+      if (!*children[i] || strchr (children[i], '/')) continue;
+      g_autofree char *path = g_strconcat (APP_PREFIX, children[i], "/", NULL);
+      g_autoptr (GSettings) child = g_settings_new_with_path (APP_SCHEMA, path);
+      g_autofree char *full = g_settings_get_string (child, "application-id");
+      g_autoptr (GDesktopAppInfo) info = *full ? g_desktop_app_info_new (full) : NULL;
+      if (info) add_app (self, seen, children[i], G_APP_INFO (info));
+    }
+  /* Apps that say they notify. */
+  g_autolist (GAppInfo) all = g_app_info_get_all ();
+  for (GList *l = all; l; l = l->next)
+    {
+      if (!g_desktop_app_info_get_boolean (G_DESKTOP_APP_INFO (l->data), "X-GNOME-UsesNotifications")) continue;
+      g_autofree char *id = canonical_id (l->data);
+      add_app (self, seen, id, l->data);
+    }
+  /* An app that went away leaves the list. */
+  GHashTableIter iter;
+  gpointer id;
+  g_hash_table_iter_init (&iter, self->apps);
+  while (g_hash_table_iter_next (&iter, &id, NULL))
+    if (!g_hash_table_contains (seen, id)) g_hash_table_iter_remove (&iter);
+  publish_apps (self);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+rescan (Notifications *self)
+{
+  if (!self->idle) self->idle = g_idle_add (scan, self);
+}
+
+static void
+app_free (gpointer settings)
+{
+  g_signal_handlers_disconnect_matched (settings, G_SIGNAL_MATCH_FUNC, 0, 0, NULL, publish_apps, NULL);
+  g_object_unref (settings);
+}
+
+static gpointer
+notifications_start (CcLumaFixture *model)
+{
+  Notifications *self = g_new0 (Notifications, 1);
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) master = source ? g_settings_schema_source_lookup (source, MASTER_SCHEMA, TRUE) : NULL;
+  g_autoptr (GSettingsSchema) app = source ? g_settings_schema_source_lookup (source, APP_SCHEMA, TRUE) : NULL;
+  self->model = g_object_ref (model);
+  self->apps = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, app_free);
+  self->table = cc_luma_gs_table_new (model, rows, G_N_ELEMENTS (rows));
+  if (master && app && g_settings_schema_has_key (master, "application-children") &&
+      g_settings_schema_has_key (app, "enable") && g_settings_schema_has_key (app, "application-id"))
+    {
+      self->master = g_settings_new (MASTER_SCHEMA);
+      g_signal_connect_swapped (self->master, "changed::application-children", G_CALLBACK (rescan), self);
+      self->monitor = g_app_info_monitor_get ();
+      g_signal_connect_swapped (self->monitor, "changed", G_CALLBACK (rescan), self);
+      scan (self);
+    }
+  cc_luma_live_desk_dump_watch (model);
+  self->gate = cc_luma_ready_gate_new (model, "notifications", cc_luma_notifications_validate);
+  return self;
+}
+
+static gboolean
+notifications_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Notifications *self = state;
+  if (cc_luma_gs_table_covers (self->table, key))
+    return cc_luma_gs_table_write (self->table, key, value, error);
+  GSettings *app = g_str_has_prefix (key, "na.") ? g_hash_table_lookup (self->apps, key + 3) : NULL;
+  if (!app) return FALSE;
+  if (!JSON_NODE_HOLDS_VALUE (value) || json_node_get_value_type (value) != G_TYPE_BOOLEAN)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "%s can’t take that value", key);
+      return FALSE;
+    }
+  if (!g_settings_is_writable (app, "enable"))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "%s is locked by policy", key);
+      return FALSE;
+    }
+  return g_settings_set_boolean (app, "enable", json_node_get_boolean (value));
+}
+
+static void
+notifications_stop (gpointer state)
+{
+  Notifications *self = state;
+  g_clear_handle_id (&self->idle, g_source_remove);
+  cc_luma_ready_gate_free (self->gate);
+  cc_luma_gs_table_free (self->table);
+  if (self->master) g_signal_handlers_disconnect_by_data (self->master, self);
+  if (self->monitor) g_signal_handlers_disconnect_by_data (self->monitor, self);
+  g_clear_object (&self->master);
+  g_clear_object (&self->monitor);
+  g_hash_table_unref (self->apps);
+  g_object_unref (self->model);
+  g_free (self);
+}
+
+const CcLumaAdapter cc_luma_adapter_notifications = {
+  "notifications", (const char * const[]) { "notifications", NULL }, notifications_start, notifications_write, notifications_stop
+};
diff --git a/shell/cc-luma-live-power.c b/shell/cc-luma-live-power.c
new file mode 100644
index 0000000..3f30c73
--- /dev/null
+++ b/shell/cc-luma-live-power.c
@@ -0,0 +1,458 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Power: UPower's display device, batteries and peripherals (charge history
+ * through cc-luma-power-reads.c) and power-profiles-daemon, as
+ * panels/power/cc-power-panel.c reads them. The saving and sleep switches
+ * are GSettings rows (cc-luma-live-gsettings.c). */
+#include "cc-luma-live-gsettings.h"
+#include "cc-luma-power-reads.h"
+#include "cc-luma-device-options.h"
+#include <math.h>
+
+#define UPOWER "org.freedesktop.UPower"
+#define DEVICE_IFACE "org.freedesktop.UPower.Device"
+#define PROFILES "org.freedesktop.UPower.PowerProfiles"
+#define PROFILES_PATH "/org/freedesktop/UPower/PowerProfiles"
+
+enum { KIND_LINE_POWER = 1, KIND_BATTERY = 2 };
+enum { STATE_CHARGING = 1, STATE_DISCHARGING = 2, STATE_EMPTY = 3, STATE_FULL = 4, STATE_PENDING_CHARGE = 5, STATE_PENDING_DISCHARGE = 6 };
+
+typedef struct {
+  CcLumaFixture *model;
+  GCancellable *cancel;
+  GDBusProxy *display;
+  GDBusProxy *profiles;
+  GDBusProxy *upower;
+  GHashTable *devices; /* object path → GDBusProxy */
+  GVariant *history;
+  char *history_path;
+  guint idle;
+  int pending;         /* first readings still to come */
+  CcLumaReadyGate *gate;
+} Power;
+
+static void schedule (Power *self);
+
+static gboolean
+prop_boolean (GDBusProxy *proxy, const char *name)
+{
+  g_autoptr (GVariant) v = proxy ? g_dbus_proxy_get_cached_property (proxy, name) : NULL;
+  return v && g_variant_is_of_type (v, G_VARIANT_TYPE_BOOLEAN) && g_variant_get_boolean (v);
+}
+static double
+prop_double (GDBusProxy *proxy, const char *name)
+{
+  g_autoptr (GVariant) v = proxy ? g_dbus_proxy_get_cached_property (proxy, name) : NULL;
+  return v && g_variant_is_of_type (v, G_VARIANT_TYPE_DOUBLE) ? g_variant_get_double (v) : NAN;
+}
+static gint64
+prop_int (GDBusProxy *proxy, const char *name)
+{
+  g_autoptr (GVariant) v = proxy ? g_dbus_proxy_get_cached_property (proxy, name) : NULL;
+  if (v && g_variant_is_of_type (v, G_VARIANT_TYPE_UINT32)) return g_variant_get_uint32 (v);
+  if (v && g_variant_is_of_type (v, G_VARIANT_TYPE_INT64)) return g_variant_get_int64 (v);
+  return -1;
+}
+static const char *
+prop_string (GDBusProxy *proxy, const char *name, GVariant **hold)
+{
+  *hold = proxy ? g_dbus_proxy_get_cached_property (proxy, name) : NULL;
+  return *hold && g_variant_is_of_type (*hold, G_VARIANT_TYPE_STRING) ? g_variant_get_string (*hold, NULL) : NULL;
+}
+
+static char *
+duration (gint64 seconds)
+{
+  gint64 minutes = (seconds + 30) / 60;
+  if (minutes < 60) return g_strdup_printf ("%" G_GINT64_FORMAT " min", MAX (minutes, 1));
+  if (minutes % 60 == 0) return g_strdup_printf ("%" G_GINT64_FORMAT " h", minutes / 60);
+  return g_strdup_printf ("%" G_GINT64_FORMAT " h %" G_GINT64_FORMAT " min", minutes / 60, minutes % 60);
+}
+
+/* The laptop's own battery: the power-supply battery the panel's charge
+ * limit acts on. */
+static GDBusProxy *
+system_battery (Power *self)
+{
+  GHashTableIter iter;
+  gpointer path, proxy;
+  g_hash_table_iter_init (&iter, self->devices);
+  while (g_hash_table_iter_next (&iter, &path, &proxy))
+    if (prop_int (proxy, "Type") == KIND_BATTERY && prop_boolean (proxy, "PowerSupply") && prop_boolean (proxy, "IsPresent"))
+      return proxy;
+  return NULL;
+}
+
+static const char *
+device_icon (gint64 kind)
+{
+  switch (kind)
+    {
+    case 5: return "mouse";
+    case 6: return "keyboard";
+    case 8: return "smartphone";
+    case 9: return "music";
+    case 10: return "tablet";
+    case 12: return "gamepad-2";
+    case 13: return "pen";
+    case 14: return "mouse-pointer-2";
+    case 17: case 19: return "headphones";
+    case 18: case 21: return "speaker";
+    case 22: return "tv";
+    case 26: return "watch";
+    default: return "battery";
+    }
+}
+
+/* Today's hours from midnight, as the page draws them: each hour's last
+ * UPower sample and whether it was charging. Hours before the first sample
+ * are null (drawn empty), never guessed. */
+static void
+publish_history (Power *self, JsonObject *facts)
+{
+  g_autoptr (GDateTime) now = g_date_time_new_now_local ();
+  g_autoptr (GDateTime) midnight = g_date_time_new_local (g_date_time_get_year (now), g_date_time_get_month (now),
+                                                          g_date_time_get_day_of_month (now), 0, 0, 0);
+  gint64 start = g_date_time_to_unix (midnight);
+  int hours = g_date_time_get_hour (now) + 1;
+  double levels[24];
+  int states[24];
+  guint32 latest[24] = { 0 };
+  for (int h = 0; h < 24; h++) levels[h] = NAN, states[h] = 0;
+  for (gsize i = 0; self->history && i < g_variant_n_children (self->history); i++)
+    {
+      guint32 time, state;
+      double charge;
+      g_variant_get_child (self->history, i, "(udu)", &time, &charge, &state);
+      if (time < start || state == 0) continue; /* unknown state: no reading */
+      int h = (int) ((time - start) / 3600);
+      if (h >= 0 && h < hours && time >= latest[h]) levels[h] = charge, states[h] = state, latest[h] = time;
+    }
+  JsonArray *samples = json_array_new (), *charging = json_array_new ();
+  gboolean seen = FALSE;
+  for (int h = 0; h < hours; h++)
+    {
+      if (isfinite (levels[h])) seen = TRUE;
+      else if (seen && h > 0) levels[h] = levels[h - 1], states[h] = states[h - 1];
+      if (isfinite (levels[h])) json_array_add_int_element (samples, (gint64) round (levels[h]));
+      else json_array_add_null_element (samples);
+      json_array_add_boolean_element (charging, states[h] == STATE_CHARGING);
+    }
+  json_object_set_array_member (facts, "history", samples);
+  json_object_set_array_member (facts, "charging", charging);
+}
+
+static gboolean
+publish (gpointer data)
+{
+  Power *self = data;
+  self->idle = 0;
+  GDBusProxy *battery = system_battery (self);
+
+  /* Profiles: power-profiles-daemon names, as the panel's rows. */
+  g_autoptr (GVariant) hold = NULL;
+  const char *profile = prop_string (self->profiles, "ActiveProfile", &hold);
+  const char *mode = g_strcmp0 (profile, "performance") == 0 ? "perf" : g_strcmp0 (profile, "balanced") == 0 ? "bal" :
+                     g_strcmp0 (profile, "power-saver") == 0 ? "save" : NULL;
+  if (mode) cc_luma_fixture_publish_string (self->model, "pmode", mode);
+  else { g_autoptr (JsonNode) none = json_node_init_null (json_node_alloc ()); cc_luma_fixture_publish (self->model, "pmode", none); }
+
+  /* Charge limit: UPower's threshold, only where the battery supports it. */
+  if (battery && prop_boolean (battery, "ChargeThresholdSupported"))
+    cc_luma_fixture_publish_string (self->model, "charge", prop_boolean (battery, "ChargeThresholdEnabled") ? "health" : "max");
+  else { g_autoptr (JsonNode) none = json_node_init_null (json_node_alloc ()); cc_luma_fixture_publish (self->model, "charge", none); }
+
+  /* The display device summarises the system batteries. No battery: no facts. */
+  if (!self->display || !prop_boolean (self->display, "IsPresent") || !isfinite (prop_double (self->display, "Percentage")))
+    return G_SOURCE_REMOVE;
+  JsonObject *facts = json_object_new ();
+  gint64 percentage = (gint64) round (prop_double (self->display, "Percentage"));
+  gint64 state = prop_int (self->display, "State");
+  g_autofree char *status = NULL, *remaining = NULL, *time = NULL;
+  if (state == STATE_DISCHARGING || state == STATE_PENDING_DISCHARGE)
+    {
+      gint64 seconds = prop_int (self->display, "TimeToEmpty");
+      time = seconds > 0 ? duration (seconds) : NULL;
+      remaining = time ? g_strdup_printf ("About %s left", time) : g_strdup ("");
+      status = time ? g_strdup_printf ("On battery · about %s left", time) : g_strdup ("On battery");
+    }
+  else if (state == STATE_CHARGING)
+    {
+      gint64 seconds = prop_int (self->display, "TimeToFull");
+      time = seconds > 0 ? duration (seconds) : NULL;
+      remaining = time ? g_strdup_printf ("Full in %s", time) : g_strdup ("");
+      status = time ? g_strdup_printf ("Charging · full in %s", time) : g_strdup ("Charging");
+    }
+  else if (state == STATE_FULL)
+    status = g_strdup ("Fully charged"), remaining = g_strdup ("");
+  else if (state == STATE_PENDING_CHARGE)
+    status = g_strdup ("Plugged in · not charging"), remaining = g_strdup ("");
+  else if (state == STATE_EMPTY)
+    status = g_strdup ("Empty"), remaining = g_strdup ("");
+  else
+    status = g_strdup_printf ("%" G_GINT64_FORMAT "%%", percentage), remaining = g_strdup ("");
+  json_object_set_string_member (facts, "status", status);
+  json_object_set_int_member (facts, "percentage", CLAMP (percentage, 0, 100));
+  json_object_set_string_member (facts, "remaining", remaining);
+  publish_history (self, facts);
+
+  /* Peripherals the panel lists: devices that don't power this computer. */
+  JsonArray *devices = json_array_new ();
+  g_autoptr (GList) paths = g_hash_table_get_keys (self->devices);
+  paths = g_list_sort (paths, (GCompareFunc) g_strcmp0);
+  for (GList *l = paths; l; l = l->next)
+    {
+      GDBusProxy *proxy = g_hash_table_lookup (self->devices, l->data);
+      gint64 kind = prop_int (proxy, "Type");
+      double level = prop_double (proxy, "Percentage");
+      if (kind <= KIND_BATTERY || kind == 3 /* ups */ || kind == 4 /* monitor */ || prop_boolean (proxy, "PowerSupply") ||
+          !prop_boolean (proxy, "IsPresent") || !isfinite (level)) continue;
+      g_autoptr (GVariant) model_hold = NULL, vendor_hold = NULL;
+      const char *name = prop_string (proxy, "Model", &model_hold);
+      if (!name || !*name) name = prop_string (proxy, "Vendor", &vendor_hold);
+      if (!name || !*name) continue;
+      JsonObject *item = json_object_new ();
+      json_object_set_string_member (item, "name", name);
+      json_object_set_int_member (item, "percentage", CLAMP ((gint64) round (level), 0, 100));
+      json_object_set_string_member (item, "icon", device_icon (kind));
+      json_array_add_object_element (devices, item);
+    }
+  json_object_set_array_member (facts, "devices", devices);
+  g_autoptr (JsonNode) node = json_node_init_object (json_node_alloc (), facts);
+  json_object_unref (facts);
+  cc_luma_fixture_publish_data (self->model, "CFPOWER", node);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+schedule (Power *self)
+{
+  if (!self->idle) self->idle = g_idle_add (publish, self);
+}
+
+static void
+history_read (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) history = cc_luma_power_read_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Power *self = data;
+  if (!history) { g_debug ("Power history: %s", error->message); return; }
+  g_clear_pointer (&self->history, g_variant_unref);
+  self->history = g_steal_pointer (&history);
+  schedule (self);
+}
+
+static void
+refresh_history (Power *self)
+{
+  GDBusProxy *battery = system_battery (self);
+  const char *path = battery ? g_dbus_proxy_get_object_path (battery) : NULL;
+  if (!path) return;
+  g_free (self->history_path);
+  self->history_path = g_strdup (path);
+  cc_luma_power_history_async (path, self->cancel, history_read, self);
+}
+
+static void
+device_changed (GDBusProxy *proxy, GVariant *changed, GStrv invalidated, Power *self)
+{
+  g_autoptr (GVariant) level = g_variant_lookup_value (changed, "Percentage", NULL);
+  if (level && proxy == system_battery (self))
+    refresh_history (self);
+  schedule (self);
+}
+
+static void
+device_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GDBusProxy) proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+  if (!proxy) { if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) g_debug ("UPower device: %s", error->message); return; }
+  Power *self = data;
+  g_signal_connect (proxy, "g-properties-changed", G_CALLBACK (device_changed), self);
+  /* The key first: argument evaluation order is unspecified. */
+  char *path = g_strdup (g_dbus_proxy_get_object_path (proxy));
+  g_hash_table_replace (self->devices, path, g_steal_pointer (&proxy));
+  if (!self->history_path) refresh_history (self);
+  schedule (self);
+}
+
+static void
+enumerated (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) paths = cc_luma_power_read_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Power *self = data;
+  if (!paths) { g_debug ("UPower devices: %s", error->message); return; }
+  GHashTableIter iter;
+  gpointer path, proxy;
+  g_hash_table_iter_init (&iter, self->devices);
+  while (g_hash_table_iter_next (&iter, &path, &proxy))
+    {
+      gboolean kept = FALSE;
+      for (gsize i = 0; i < g_variant_n_children (paths) && !kept; i++)
+        {
+          const char *p;
+          g_variant_get_child (paths, i, "&o", &p);
+          kept = g_str_equal (p, path);
+        }
+      if (!kept)
+        {
+          g_signal_handlers_disconnect_by_data (proxy, self);
+          g_hash_table_iter_remove (&iter);
+        }
+    }
+  for (gsize i = 0; i < g_variant_n_children (paths); i++)
+    {
+      const char *p;
+      g_variant_get_child (paths, i, "&o", &p);
+      if (!g_hash_table_contains (self->devices, p))
+        g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START, NULL, UPOWER, p, DEVICE_IFACE,
+                                  self->cancel, device_ready, self);
+    }
+  schedule (self);
+}
+
+static void
+upower_signal (GDBusProxy *proxy, const char *sender, const char *signal, GVariant *parameters, Power *self)
+{
+  if (g_str_equal (signal, "DeviceAdded") || g_str_equal (signal, "DeviceRemoved"))
+    cc_luma_power_enumerate_async (self->cancel, enumerated, self);
+}
+
+static void
+changed_properties (GDBusProxy *proxy, GVariant *changed, GStrv invalidated, Power *self)
+{
+  schedule (self);
+}
+
+static void
+first_reading (Power *self)
+{
+  /* The page is drawn from a complete reading: battery facts or none. */
+  if (--self->pending == 0)
+    {
+      if (self->idle) g_source_remove (self->idle);
+      publish (self);
+      self->gate = cc_luma_ready_gate_new (self->model, "power", cc_luma_power_fixture_validate);
+    }
+}
+
+static void
+proxy_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+  if (!proxy && g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Power *self = data;
+  if (!proxy) { g_debug ("Power: %s", error->message); first_reading (self); return; }
+  const char *iface = g_dbus_proxy_get_interface_name (proxy);
+  if (g_str_equal (iface, PROFILES)) self->profiles = proxy;
+  else if (g_str_equal (iface, DEVICE_IFACE)) self->display = proxy;
+  else
+    {
+      self->upower = proxy;
+      g_signal_connect (proxy, "g-signal", G_CALLBACK (upower_signal), self);
+      cc_luma_power_enumerate_async (self->cancel, enumerated, self);
+      return;
+    }
+  g_signal_connect (proxy, "g-properties-changed", G_CALLBACK (changed_properties), self);
+  schedule (self);
+  first_reading (self);
+}
+
+static gpointer
+power_start (CcLumaFixture *model)
+{
+  Power *self = g_new0 (Power, 1);
+  self->model = g_object_ref (model);
+  self->cancel = g_cancellable_new ();
+  self->devices = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_object_unref);
+  cc_luma_fixture_own_key (model, "pmode");
+  cc_luma_fixture_own_key (model, "charge");
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START, NULL, UPOWER,
+                            "/org/freedesktop/UPower/devices/DisplayDevice", DEVICE_IFACE, self->cancel, proxy_ready, self);
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START, NULL, UPOWER,
+                            "/org/freedesktop/UPower", UPOWER, self->cancel, proxy_ready, self);
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START, NULL, PROFILES,
+                            PROFILES_PATH, PROFILES, self->cancel, proxy_ready, self);
+  self->pending = 2; /* the display device and power-profiles-daemon */
+  return self;
+}
+
+static void
+call_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (!reply && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    {
+      Power *self = data;
+      g_warning ("Power: %s", error->message);
+      schedule (self); /* show what the system kept */
+    }
+}
+
+static gboolean
+power_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Power *self = state;
+  const char *text = value && JSON_NODE_HOLDS_VALUE (value) && json_node_get_value_type (value) == G_TYPE_STRING ? json_node_get_string (value) : NULL;
+  if (g_str_equal (key, "pmode"))
+    {
+      const char *profile = g_strcmp0 (text, "perf") == 0 ? "performance" : g_strcmp0 (text, "bal") == 0 ? "balanced" :
+                            g_strcmp0 (text, "save") == 0 ? "power-saver" : NULL;
+      if (!profile || !self->profiles)
+        {
+          g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Power modes aren’t available");
+          return FALSE;
+        }
+      /* As the panel: set the daemon's ActiveProfile property. */
+      g_dbus_connection_call (g_dbus_proxy_get_connection (self->profiles), PROFILES, PROFILES_PATH,
+                              "org.freedesktop.DBus.Properties", "Set",
+                              g_variant_new ("(ssv)", PROFILES, "ActiveProfile", g_variant_new_string (profile)),
+                              NULL, G_DBUS_CALL_FLAGS_NONE, -1, self->cancel, call_done, self);
+      return TRUE;
+    }
+  if (g_str_equal (key, "charge"))
+    {
+      GDBusProxy *battery = system_battery (self);
+      if ((g_strcmp0 (text, "max") != 0 && g_strcmp0 (text, "health") != 0) || !battery || !prop_boolean (battery, "ChargeThresholdSupported"))
+        {
+          g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "This battery has no charge limit");
+          return FALSE;
+        }
+      g_dbus_connection_call (g_dbus_proxy_get_connection (battery), UPOWER, g_dbus_proxy_get_object_path (battery),
+                              DEVICE_IFACE, "EnableChargeThreshold", g_variant_new ("(b)", g_str_equal (text, "health")),
+                              NULL, G_DBUS_CALL_FLAGS_NONE, -1, self->cancel, call_done, self);
+      return TRUE;
+    }
+  return FALSE;
+}
+
+static void
+power_stop (gpointer state)
+{
+  Power *self = state;
+  g_cancellable_cancel (self->cancel);
+  if (self->idle) g_source_remove (self->idle);
+  cc_luma_ready_gate_free (self->gate);
+  GDBusProxy *proxies[] = { self->display, self->profiles, self->upower };
+  for (guint i = 0; i < G_N_ELEMENTS (proxies); i++)
+    if (proxies[i]) { g_signal_handlers_disconnect_by_data (proxies[i], self); g_object_unref (proxies[i]); }
+  GHashTableIter iter;
+  gpointer proxy;
+  g_hash_table_iter_init (&iter, self->devices);
+  while (g_hash_table_iter_next (&iter, NULL, &proxy)) g_signal_handlers_disconnect_by_data (proxy, self);
+  g_hash_table_unref (self->devices);
+  g_clear_pointer (&self->history, g_variant_unref);
+  g_free (self->history_path);
+  g_object_unref (self->cancel);
+  g_object_unref (self->model);
+  g_free (self);
+}
+
+const CcLumaAdapter cc_luma_adapter_power = {
+  "power", (const char * const[]) { "power", NULL }, power_start, power_write, power_stop
+};
diff --git a/shell/cc-luma-live-printers.c b/shell/cc-luma-live-printers.c
new file mode 100644
index 0000000..0b221f0
--- /dev/null
+++ b/shell/cc-luma-live-printers.c
@@ -0,0 +1,486 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Printers: CUPS through panels/printers' own helpers (PpCups for the
+ * destinations, get_ipp_attributes_async for the defaults, cups-pk-helper
+ * for every change). The page shows the default printer (else the first).
+ *   CFPRINTER { n, status, count, queue, toner when IPP reports a level }
+ *   prDef ↔ the CUPS default; prPaper, prDuplex, prProf ↔ media-, sides-
+ *   and print-color-mode-default, each only when the printer reports it. */
+#include "cc-luma-live.h"
+#include "cc-luma-live-printers.h"
+#include "cc-luma-live-admin.h"
+#include "cc-luma-live-apps.h"
+#include "panels/printers/pp-cups.h"
+#include "panels/printers/pp-printer.h"
+#include "panels/printers/pp-new-printer.h"
+#include "panels/printers/pp-new-printer-dialog.h"
+#include <glib/gstdio.h>
+
+#define REFRESH_SECONDS 10
+
+typedef struct {
+  CcLumaFixture *model;
+  PpCups *cups;
+  GCancellable *cancel;
+  char *queue;          /* the printer shown */
+  char *color_auto;     /* how "Automatic" colour is written, from print-color-mode-supported */
+  guint timer;
+  gboolean reading;
+  gboolean reported;
+  gboolean stopped;
+} Printers;
+
+static Printers *
+printers_ref (Printers *self)
+{
+  return g_rc_box_acquire (self);
+}
+
+static void
+printers_clear (Printers *self)
+{
+  g_clear_object (&self->cups);
+  g_clear_object (&self->cancel);
+  g_free (self->queue);
+  g_free (self->color_auto);
+  g_clear_object (&self->model);
+}
+
+static void
+printers_unref (Printers *self)
+{
+  g_rc_box_release_full (self, (GDestroyNotify) printers_clear);
+}
+
+static const char *
+option (cups_dest_t *dest, const char *name)
+{
+  return cupsGetOption (name, dest->num_options, dest->options);
+}
+
+/* panels/printers pp-printer-entry: the state line, without translation. */
+static const char *
+state_text (cups_dest_t *dest)
+{
+  const char *state = option (dest, "printer-state");
+  const char *accepting = option (dest, "printer-is-accepting-jobs");
+  int value = state ? atoi (state) : 3;
+  if (value == 5) return "Stopped";
+  if (value == 4) return "Processing";
+  return g_strcmp0 (accepting, "false") == 0 ? "Does not accept jobs" : "Ready";
+}
+
+/* The toner level IPP reports: the black toner, or the only marker. */
+static gint
+toner_level (cups_dest_t *dest)
+{
+  const char *levels = option (dest, "marker-levels"), *colors = option (dest, "marker-colors"), *types = option (dest, "marker-types");
+  if (!levels) return -1;
+  g_auto (GStrv) level = g_strsplit (levels, ",", -1);
+  g_auto (GStrv) color = colors ? g_strsplit (colors, ",", -1) : NULL;
+  g_auto (GStrv) type = types ? g_strsplit (types, ",", -1) : NULL;
+  guint n = g_strv_length (level);
+  gint found = n == 1 ? atoi (level[0]) : -1;
+  for (guint i = 0; n > 1 && i < n; i++)
+    if (color && i < g_strv_length (color) && g_ascii_strcasecmp (color[i], "#000000") == 0 &&
+        (!type || i >= g_strv_length (type) || g_str_has_prefix (type[i], "toner") || g_str_has_prefix (type[i], "ink")))
+      found = atoi (level[i]);
+  return found >= 0 && found <= 100 ? found : -1;
+}
+
+static void
+unpublish (Printers *self, const char *key)
+{
+  g_autoptr (JsonNode) none = json_node_init_null (json_node_alloc ());
+  if (cc_luma_fixture_get (self->model, key)) cc_luma_fixture_publish (self->model, key, none);
+}
+
+static const char * const media[] = { "na_letter_8.5x11in", "Letter", "iso_a4_210x297mm", "A4", "na_legal_8.5x14in", "Legal", NULL };
+static const char * const sides[] = { "two-sided-long-edge", "long", "two-sided-short-edge", "short", "one-sided", "off", NULL };
+
+static const char *
+mapped (const char * const *pairs, const char *value, gboolean to_model)
+{
+  for (guint i = 0; value && pairs[i]; i += 2)
+    if (g_str_equal (pairs[i + (to_model ? 0 : 1)], value)) return pairs[i + (to_model ? 1 : 0)];
+  return NULL;
+}
+
+static const char *
+attribute_text (GHashTable *table, const char *name)
+{
+  IPPAttribute *attr = table ? g_hash_table_lookup (table, name) : NULL;
+  return attr && attr->attribute_type == IPP_ATTRIBUTE_TYPE_STRING && attr->num_of_values > 0 ? attr->attribute_values[0].string_value : NULL;
+}
+
+static void
+got_attributes (GHashTable *table, gpointer data)
+{
+  Printers *self = data;
+  if (!self->stopped)
+    {
+      /* A value v70 doesn't offer is shown as the printer names it. */
+      const char *paper = attribute_text (table, "media-default");
+      const char *duplex = attribute_text (table, "sides-default");
+      const char *color = attribute_text (table, "print-color-mode-default");
+      if (paper) cc_luma_fixture_publish_string (self->model, "prPaper", mapped (media, paper, TRUE) ? mapped (media, paper, TRUE) : paper);
+      else unpublish (self, "prPaper");
+      if (duplex) cc_luma_fixture_publish_string (self->model, "prDuplex", mapped (sides, duplex, TRUE) ? mapped (sides, duplex, TRUE) : duplex);
+      else unpublish (self, "prDuplex");
+      if (color) cc_luma_fixture_publish_string (self->model, "prProf", g_str_equal (color, "monochrome") ? "Black and white" : "Automatic");
+      else unpublish (self, "prProf");
+      IPPAttribute *supported = table ? g_hash_table_lookup (table, "print-color-mode-supported") : NULL;
+      g_clear_pointer (&self->color_auto, g_free);
+      for (gint i = 0; supported && supported->attribute_type == IPP_ATTRIBUTE_TYPE_STRING && i < supported->num_of_values; i++)
+        if (g_strcmp0 (supported->attribute_values[i].string_value, "auto") == 0 ||
+            (!self->color_auto && g_strcmp0 (supported->attribute_values[i].string_value, "color") == 0))
+          g_set_str (&self->color_auto, supported->attribute_values[i].string_value);
+      if (!self->reported)
+        {
+          self->reported = TRUE;
+          g_debug ("Settings live: printers is ready");
+          cc_luma_live_ready (self->model, "printers");
+        }
+    }
+  printers_unref (self);
+}
+
+static void
+got_dests (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Printers *self = data;
+  g_autoptr (GError) error = NULL;
+  PpCupsDests *dests = pp_cups_get_dests_finish (PP_CUPS (source), result, &error);
+  self->reading = FALSE;
+  if (self->stopped || !dests)
+    {
+      if (!self->stopped && error && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        g_debug ("Settings live: printers not read: %s", error->message);
+      if (dests) { cupsFreeDests (dests->num_of_dests, dests->dests); g_free (dests); }
+      printers_unref (self);
+      return;
+    }
+  cups_dest_t *shown = NULL;
+  for (gint i = 0; i < dests->num_of_dests && !shown; i++)
+    if (self->queue && !dests->dests[i].instance && g_str_equal (dests->dests[i].name, self->queue)) shown = &dests->dests[i];
+  for (gint i = 0; i < dests->num_of_dests && !shown; i++)
+    if (dests->dests[i].is_default) shown = &dests->dests[i];
+  for (gint i = 0; i < dests->num_of_dests && !shown; i++)
+    if (!dests->dests[i].instance) shown = &dests->dests[i];
+  g_set_str (&self->queue, shown ? shown->name : NULL);
+  if (!shown)
+    {
+      g_autoptr (JsonNode) none = json_node_init_null (json_node_alloc ());
+      cc_luma_fixture_publish_data (self->model, "CFPRINTER", none);
+      const char *keys[] = { "prDef", "prPaper", "prDuplex", "prProf" };
+      for (guint i = 0; i < G_N_ELEMENTS (keys); i++) unpublish (self, keys[i]);
+      if (!self->reported)
+        {
+          self->reported = TRUE;
+          g_debug ("Settings live: printers is ready");
+          cc_luma_live_ready (self->model, "printers");
+        }
+    }
+  else
+    {
+      const char *info = option (shown, "printer-info");
+      JsonObject *p = json_object_new ();
+      json_object_set_string_member (p, "n", info && *info ? info : shown->name);
+      json_object_set_string_member (p, "queue", shown->name);
+      json_object_set_string_member (p, "status", state_text (shown));
+      json_object_set_int_member (p, "count", dests->num_of_dests);
+      gint toner = toner_level (shown);
+      if (toner >= 0) json_object_set_int_member (p, "toner", toner);
+      g_autoptr (JsonNode) node = json_node_init_object (json_node_alloc (), p);
+      JsonNode *before = json_object_get_member (cc_luma_fixture_get_data (self->model), "CFPRINTER");
+      if (!before || !json_node_equal (before, node)) cc_luma_fixture_publish_data (self->model, "CFPRINTER", node);
+      cc_luma_fixture_publish_boolean (self->model, "prDef", shown->is_default);
+      const char *names[] = { "media-default", "sides-default", "print-color-mode-default", "print-color-mode-supported", NULL };
+      get_ipp_attributes_async (shown->name, (char **) names, got_attributes, printers_ref (self));
+    }
+  cupsFreeDests (dests->num_of_dests, dests->dests);
+  g_free (dests);
+  printers_unref (self);
+}
+
+static void
+refresh (Printers *self)
+{
+  if (self->stopped || self->reading) return;
+  self->reading = TRUE;
+  pp_cups_get_dests_async (self->cups, self->cancel, got_dests, printers_ref (self));
+}
+
+static gboolean
+tick (gpointer data)
+{
+  refresh (data);
+  return G_SOURCE_CONTINUE;
+}
+
+static gboolean printer_command (CcLumaFixture *model, const char *command, GtkWidget *parent, GError **error);
+
+static gpointer
+printers_start (CcLumaFixture *model)
+{
+  Printers *self = g_rc_box_new0 (Printers);
+  self->model = g_object_ref (model);
+  self->cups = pp_cups_new ();
+  self->cancel = g_cancellable_new ();
+  const char *keys[] = { "prDef", "prPaper", "prDuplex", "prProf" };
+  for (guint i = 0; i < G_N_ELEMENTS (keys); i++) cc_luma_fixture_own_key (model, keys[i]);
+  g_object_set_data (G_OBJECT (model), "cc-luma-live-printers", self);
+  g_object_set_data (G_OBJECT (model), CC_LUMA_LIVE_PRINTER_COMMAND, printer_command);
+  cc_luma_live_desk_dump_watch (model);
+  refresh (self);
+  self->timer = g_timeout_add_seconds (REFRESH_SECONDS, tick, self);
+  return self;
+}
+
+static void
+option_set (gboolean success, gpointer data)
+{
+  Printers *self = data;
+  if (!success) g_warning ("Settings live: the printer did not take the option");
+  refresh (self); /* show what CUPS has */
+  printers_unref (self);
+}
+
+typedef struct { Printers *self; char *queue; gboolean ok; } DefaultJob;
+
+static void
+default_thread (GTask *task, gpointer source, gpointer data, GCancellable *cancel)
+{
+  DefaultJob *job = data;
+  job->ok = printer_set_default (job->queue);
+  g_task_return_boolean (task, TRUE);
+}
+
+static void
+default_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  DefaultJob *job = g_task_get_task_data (G_TASK (result));
+  if (!job->ok) g_warning ("Settings live: %s did not become the default printer", job->queue);
+  refresh (job->self);
+}
+
+static void
+default_job_free (DefaultJob *job)
+{
+  printers_unref (job->self);
+  g_free (job->queue);
+  g_free (job);
+}
+
+#define PRINTERS_PERMISSION "org.opensuse.cupspkhelper.mechanism.all-edit"
+
+/* An option or default change waiting for the unlock. */
+typedef struct { Printers *self; char *queue; const char *name; char *value; } AdminJob;
+static void
+admin_job_free (AdminJob *job)
+{
+  printers_unref (job->self);
+  g_free (job->queue);
+  g_free (job->value);
+  g_free (job);
+}
+
+static AdminJob *
+admin_job (Printers *self, const char *name, const char *value)
+{
+  AdminJob *job = g_new0 (AdminJob, 1);
+  job->self = printers_ref (self);
+  job->queue = g_strdup (self->queue);
+  job->name = name;
+  job->value = g_strdup (value);
+  return job;
+}
+
+static void
+refresh_after (gpointer data)
+{
+  AdminJob *job = data;
+  if (!job->self->stopped) refresh (job->self); /* show what CUPS kept */
+}
+
+static void
+run_option (gpointer data)
+{
+  AdminJob *job = data;
+  char *values[] = { job->value, NULL };
+  printer_add_option_async (job->queue, job->name, values, TRUE, job->self->cancel, option_set, printers_ref (job->self));
+}
+
+static void
+run_default (gpointer data)
+{
+  AdminJob *job = data;
+  DefaultJob *d = g_new0 (DefaultJob, 1);
+  d->self = printers_ref (job->self);
+  d->queue = g_strdup (job->queue);
+  g_autoptr (GTask) task = g_task_new (NULL, NULL, default_done, NULL);
+  g_task_set_task_data (task, d, (GDestroyNotify) default_job_free);
+  g_task_run_in_thread (task, default_thread);
+}
+
+static gboolean
+printers_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Printers *self = state;
+  const char *keys[] = { "prDef", "prPaper", "prDuplex", "prProf" };
+  gboolean ours = FALSE;
+  for (guint i = 0; i < G_N_ELEMENTS (keys); i++) ours |= g_str_equal (key, keys[i]);
+  if (!ours) return FALSE;
+  if (!self->queue)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "There is no printer");
+      return FALSE;
+    }
+  GType type = JSON_NODE_HOLDS_VALUE (value) ? json_node_get_value_type (value) : G_TYPE_INVALID;
+  if (g_str_equal (key, "prDef"))
+    {
+      if (type != G_TYPE_BOOLEAN) goto invalid;
+      if (!json_node_get_boolean (value))
+        {
+          g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Make another printer the default instead");
+          return FALSE;
+        }
+      /* The printers panel's lock: cups-pk-helper's all-edit, then the change. */
+      cc_luma_live_as_admin (PRINTERS_PERMISSION, self->cancel, run_default, refresh_after,
+                             admin_job (self, NULL, NULL), (GDestroyNotify) admin_job_free);
+      return TRUE;
+    }
+  if (type != G_TYPE_STRING) goto invalid;
+  const char *text = json_node_get_string (value), *name, *written;
+  if (g_str_equal (key, "prPaper")) { name = "media"; written = mapped (media, text, FALSE); }
+  else if (g_str_equal (key, "prDuplex")) { name = "sides"; written = mapped (sides, text, FALSE); }
+  else { name = "print-color-mode"; written = g_str_equal (text, "Black and white") ? "monochrome" : g_str_equal (text, "Automatic") ? self->color_auto : NULL; }
+  if (!written) goto invalid;
+  cc_luma_live_as_admin (PRINTERS_PERMISSION, self->cancel, run_option, refresh_after,
+                         admin_job (self, name, written), (GDestroyNotify) admin_job_free);
+  return TRUE;
+invalid:
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "The printer can’t take that value");
+  return FALSE;
+}
+
+static void
+printers_stop (gpointer state)
+{
+  Printers *self = state;
+  self->stopped = TRUE;
+  g_clear_handle_id (&self->timer, g_source_remove);
+  g_cancellable_cancel (self->cancel);
+  if (self->model && g_object_get_data (G_OBJECT (self->model), "cc-luma-live-printers") == self)
+    {
+      g_object_set_data (G_OBJECT (self->model), "cc-luma-live-printers", NULL);
+      g_object_set_data (G_OBJECT (self->model), CC_LUMA_LIVE_PRINTER_COMMAND, NULL);
+    }
+  printers_unref (self);
+}
+
+/* ── Commands ──────────────────────────────────────────────────────── */
+static void
+command_finished (Printers *self, gboolean ok, GError *error)
+{
+  if (!ok && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    g_warning ("Settings live: printer command failed: %s", error ? error->message : "refused");
+  if (!self->stopped) refresh (self);
+  printers_unref (self);
+}
+
+static void
+add_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  command_finished (data, pp_new_printer_add_finish (PP_NEW_PRINTER (source), result, &error), error);
+}
+
+static void
+remove_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  command_finished (data, pp_printer_delete_finish (PP_PRINTER (source), result, &error), error);
+}
+
+static void
+test_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  command_finished (data, pp_printer_print_file_finish (PP_PRINTER (source), result, &error), error);
+}
+
+static void
+added (GtkWindow *dialog, gint response, gpointer data)
+{
+  Printers *self = data;
+  if (response == GTK_RESPONSE_OK && !self->stopped)
+    {
+      g_autoptr (PpNewPrinter) printer = pp_new_printer_dialog_get_new_printer (PP_NEW_PRINTER_DIALOG (dialog));
+      pp_new_printer_add_async (printer, self->cancel, add_done, printers_ref (self));
+    }
+  gtk_window_destroy (dialog);
+  printers_unref (self);
+}
+
+/* panels/printers pp-options-dialog: CUPS' own test page, else the
+ * printer's self-test. */
+static char *
+test_page_file (void)
+{
+  const char *env = g_getenv ("CUPS_DATADIR");
+  const char *dirs[] = { env, "/usr/share/cups", "/usr/local/share/cups" };
+  for (guint i = env ? 0 : 1; i < G_N_ELEMENTS (dirs); i++)
+    for (const char * const *name = (const char * const[]) { "testprint", "testprint.ps", NULL }; *name; name++)
+      {
+        g_autofree char *file = g_build_filename (dirs[i], "data", *name, NULL);
+        if (g_access (file, R_OK) == 0) return g_steal_pointer (&file);
+      }
+  return NULL;
+}
+
+static gboolean
+printer_command (CcLumaFixture *model, const char *command, GtkWidget *parent, GError **error)
+{
+  Printers *self = model ? g_object_get_data (G_OBJECT (model), "cc-luma-live-printers") : NULL;
+  if (!self || self->stopped)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Printers aren’t connected");
+      return FALSE;
+    }
+  if (g_strcmp0 (command, "add") == 0)
+    {
+      PpNewPrinterDialog *dialog = pp_new_printer_dialog_new (NULL, added, printers_ref (self));
+      GtkRoot *root = parent ? gtk_widget_get_root (parent) : NULL;
+      if (GTK_IS_WINDOW (root)) gtk_window_set_transient_for (GTK_WINDOW (dialog), GTK_WINDOW (root));
+      gtk_window_present (GTK_WINDOW (dialog));
+      return TRUE;
+    }
+  if (!self->queue)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "There is no printer");
+      return FALSE;
+    }
+  g_autoptr (PpPrinter) printer = pp_printer_new (self->queue);
+  if (g_strcmp0 (command, "remove") == 0)
+    {
+      pp_printer_delete_async (printer, self->cancel, remove_done, printers_ref (self));
+      return TRUE;
+    }
+  if (g_strcmp0 (command, "test") == 0)
+    {
+      g_autofree char *file = test_page_file ();
+      if (!file)
+        {
+          g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "No test page is installed");
+          return FALSE;
+        }
+      pp_printer_print_file_async (printer, file, "Test page", self->cancel, test_done, printers_ref (self));
+      return TRUE;
+    }
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Unknown printer command");
+  return FALSE;
+}
+
+const CcLumaAdapter cc_luma_adapter_printers = {
+  "printers", (const char * const[]) { "printers", NULL }, printers_start, printers_write, printers_stop
+};
diff --git a/shell/cc-luma-live-printers.h b/shell/cc-luma-live-printers.h
new file mode 100644
index 0000000..b352d5b
--- /dev/null
+++ b/shell/cc-luma-live-printers.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "cc-luma-fixture.h"
+#include <gtk/gtk.h>
+
+G_BEGIN_DECLS
+/* The Printers page's commands on a live model, through panels/printers'
+ * own helpers: "add" (GNOME's add-printer dialog), "test" (a test page) and
+ * "remove" (only after the page's destructive confirmation). The printers
+ * adapter hangs its handler on the model, so the page needs no link to it. */
+typedef gboolean (*CcLumaLivePrinterCommand) (CcLumaFixture *model, const char *command, GtkWidget *parent, GError **error);
+#define CC_LUMA_LIVE_PRINTER_COMMAND "cc-luma-live-printer-command"
+
+static inline gboolean
+cc_luma_live_printer_command (CcLumaFixture *model, const char *command, GtkWidget *parent, GError **error)
+{
+  CcLumaLivePrinterCommand run = model ? (CcLumaLivePrinterCommand) g_object_get_data (G_OBJECT (model), CC_LUMA_LIVE_PRINTER_COMMAND) : NULL;
+  if (run) return run (model, command, parent, error);
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Printers aren’t connected");
+  return FALSE;
+}
+G_END_DECLS
diff --git a/shell/cc-luma-live-privacy.c b/shell/cc-luma-live-privacy.c
new file mode 100644
index 0000000..82bf1f3
--- /dev/null
+++ b/shell/cc-luma-live-privacy.c
@@ -0,0 +1,255 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live Privacy & Security, from what panels/privacy reads:
+ *  - screen lock: org.gnome.desktop.session idle-delay, org.gnome.desktop.
+ *    screensaver lock-enabled / lock-delay, org.gnome.desktop.notifications
+ *    show-in-lock-screen;
+ *  - location: org.gnome.system.location enabled; camera and microphone:
+ *    org.gnome.desktop.privacy disable-camera / disable-microphone; the apps
+ *    that asked: the portal PermissionStore (location/location,
+ *    devices/camera, devices/microphone), as the camera, microphone and
+ *    location pages list them;
+ *  - file history and trash: org.gnome.desktop.privacy remember-recent-files,
+ *    recent-files-max-age, remove-old-trash-files, remove-old-temp-files,
+ *    old-files-age.
+ * Problem reports (v70's never/ask/auto has no GNOME owner) and device
+ * security (no firmware-security reader here yet) stay on their panel. */
+#include "cc-luma-live-gsettings.h"
+#include "cc-luma-live-apps.h"
+#include <gio/gdesktopappinfo.h>
+#include <string.h>
+
+#define ADAPTER "privacy"
+static const char * const pages[] = { "privacy", "p-lock", "p-loc", "p-cam", "p-mic", "p-files", NULL };
+#define PRIVACY "org.gnome.desktop.privacy"
+#define SAVER "org.gnome.desktop.screensaver"
+
+static const CcLumaGsRow rows[] = {
+  { "lock.blank", "org.gnome.desktop.session", "idle-delay", CC_LUMA_GS_MINUTES },
+  { "lock.auto", SAVER, "lock-enabled", CC_LUMA_GS_BOOLEAN },
+  { "lock.notes", "org.gnome.desktop.notifications", "show-in-lock-screen", CC_LUMA_GS_BOOLEAN },
+  { "loc", "org.gnome.system.location", "enabled", CC_LUMA_GS_BOOLEAN },
+  { "cam", PRIVACY, "disable-camera", CC_LUMA_GS_NOT },
+  { "mic", PRIVACY, "disable-microphone", CC_LUMA_GS_NOT },
+  { "hist", PRIVACY, "remember-recent-files", CC_LUMA_GS_BOOLEAN },
+  { "trash", PRIVACY, "remove-old-trash-files", CC_LUMA_GS_BOOLEAN },
+  { "temp", PRIVACY, "remove-old-temp-files", CC_LUMA_GS_BOOLEAN },
+};
+
+static const struct { const char *key, *table, *id; } stores[] = {
+  { "appLoc", "location", "location" }, { "appCam", "devices", "camera" }, { "appMic", "devices", "microphone" },
+};
+
+typedef struct {
+  CcLumaFixture *model;
+  CcLumaGsTable *table;
+  GSettings *saver, *privacy;
+  GDBusConnection *bus;
+  GCancellable *cancel;
+  guint changed_signal;
+  gboolean read[G_N_ELEMENTS (stores)], ready;
+} Privacy;
+
+static gboolean
+covered (Privacy *p)
+{
+  for (guint i = 0; i < G_N_ELEMENTS (rows); i++)
+    if (!cc_luma_gs_table_covers (p->table, rows[i].key)) return FALSE;
+  return p->saver && p->privacy;
+}
+
+static void
+check_ready (Privacy *p)
+{
+  if (p->ready || !covered (p)) return;
+  for (guint i = 0; i < G_N_ELEMENTS (stores); i++) if (!p->read[i]) return;
+  p->ready = TRUE;
+  cc_luma_live_ready (p->model, ADAPTER);
+}
+
+/* Values GNOME stores on scales the pages show as strings. */
+static void
+publish_scales (Privacy *p)
+{
+  if (!covered (p)) return;
+  g_autofree char *delay = g_strdup_printf ("%u", g_settings_get_uint (p->saver, "lock-delay"));
+  cc_luma_fixture_publish_string (p->model, "lock.delay", delay);
+  int age = g_settings_get_int (p->privacy, "recent-files-max-age");
+  g_autofree char *keep = age < 0 ? g_strdup ("forever") : g_strdup_printf ("%d", age);
+  cc_luma_fixture_publish_string (p->model, "histKeep", keep);
+  g_autofree char *old = g_strdup_printf ("%u", g_settings_get_uint (p->privacy, "old-files-age"));
+  cc_luma_fixture_publish_string (p->model, "trashAge", old);
+}
+
+/* notifications' canonical app id (panels/notifications, cc-luma-live-notifications.c). */
+static char *
+canonical_id (const char *app)
+{
+  g_autofree char *id = g_strdup (app);
+  g_strcanon (id, "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-", '-');
+  for (guint i = 0; id[i]; i++) id[i] = g_ascii_tolower (id[i]);
+  return g_steal_pointer (&id);
+}
+
+typedef struct { Privacy *p; guint store; } Lookup;
+
+static void
+lookup_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Lookup *l = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) { g_free (l); return; }
+  Privacy *p = l->p;
+  guint s = l->store;
+  g_free (l);
+  g_autoptr (JsonObject) apps = json_object_new ();
+  if (reply)
+    {
+      g_autoptr (GVariant) perms = g_variant_get_child_value (reply, 0);
+      GVariantIter iter;
+      const char *app;
+      g_autofree const char **values = NULL;
+      g_variant_iter_init (&iter, perms);
+      while (g_variant_iter_next (&iter, "{&s^a&s}", &app, &values))
+        {
+          /* The location page's apps are allowed unless NONE; devices when "yes". */
+          gboolean allowed = values && values[0] &&
+            (g_str_equal (stores[s].table, "location") ? !g_str_equal (values[0], "NONE") : g_str_equal (values[0], "yes"));
+          g_clear_pointer (&values, g_free);
+          g_autofree char *desktop = g_strconcat (app, ".desktop", NULL);
+          g_autoptr (GDesktopAppInfo) info = *app ? g_desktop_app_info_new (desktop) : NULL;
+          g_autofree char *id = canonical_id (app);
+          /* Apps no longer installed have no row on GNOME's pages either. */
+          if (!info || !*id || !cc_luma_live_publish_app (p->model, id, G_APP_INFO (info))) continue;
+          json_object_set_boolean_member (apps, id, allowed);
+        }
+    }
+  else if (!g_error_matches (error, G_DBUS_ERROR, G_DBUS_ERROR_SERVICE_UNKNOWN) &&
+           !g_dbus_error_is_remote_error (error))
+    g_message ("Settings: %s permissions: %s", stores[s].id, error->message);
+  /* No table yet (nothing asked): an empty list, as GNOME shows. */
+  g_autoptr (JsonNode) node = json_node_init_object (json_node_alloc (), apps);
+  cc_luma_fixture_publish (p->model, stores[s].key, node);
+  p->read[s] = TRUE;
+  check_ready (p);
+}
+
+static void
+read_store (Privacy *p, guint s)
+{
+  Lookup *l = g_new0 (Lookup, 1);
+  l->p = p;
+  l->store = s;
+  g_dbus_connection_call (p->bus, "org.freedesktop.impl.portal.PermissionStore", "/org/freedesktop/impl/portal/PermissionStore",
+                          "org.freedesktop.impl.portal.PermissionStore", "Lookup",
+                          g_variant_new ("(ss)", stores[s].table, stores[s].id), G_VARIANT_TYPE ("(a{sas}v)"),
+                          G_DBUS_CALL_FLAGS_NONE, -1, p->cancel, lookup_done, l);
+}
+
+static void
+store_changed (GDBusConnection *bus, const char *sender, const char *path, const char *iface,
+               const char *signal, GVariant *params, gpointer data)
+{
+  Privacy *p = data;
+  const char *table, *id;
+  g_variant_get (params, "(&s&s@b@v@a{sas})", &table, &id, NULL, NULL, NULL);
+  for (guint s = 0; s < G_N_ELEMENTS (stores); s++)
+    if (g_str_equal (table, stores[s].table) && g_str_equal (id, stores[s].id)) read_store (p, s);
+}
+
+static void
+bus_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusConnection *bus = g_bus_get_finish (result, &error);
+  if (!bus) return; /* cancelled or no session bus */
+  Privacy *p = data;
+  p->bus = bus;
+  p->changed_signal = g_dbus_connection_signal_subscribe (bus, "org.freedesktop.impl.portal.PermissionStore",
+    "org.freedesktop.impl.portal.PermissionStore", "Changed", "/org/freedesktop/impl/portal/PermissionStore",
+    NULL, G_DBUS_SIGNAL_FLAGS_NONE, store_changed, p, NULL);
+  for (guint s = 0; s < G_N_ELEMENTS (stores); s++) read_store (p, s);
+}
+
+static gboolean
+privacy_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Privacy *p = state;
+  if (cc_luma_gs_table_covers (p->table, key)) return cc_luma_gs_table_write (p->table, key, value, error);
+  GType type = value && JSON_NODE_HOLDS_VALUE (value) ? json_node_get_value_type (value) : G_TYPE_INVALID;
+  const char *text = type == G_TYPE_STRING ? json_node_get_string (value) : NULL;
+  char *end = NULL;
+  gint64 number = text ? g_ascii_strtoll (text, &end, 10) : -1;
+  gboolean digits = text && *text && end && !*end && number >= 0 && number <= G_MAXINT32;
+  if (g_str_equal (key, "lock.delay"))
+    {
+      if (!digits) goto invalid;
+      return g_settings_set_uint (p->saver, "lock-delay", (guint) number) ||
+             (g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "lock-delay is locked"), FALSE);
+    }
+  if (g_str_equal (key, "histKeep"))
+    {
+      if (!digits && g_strcmp0 (text, "forever") != 0) goto invalid;
+      return g_settings_set_int (p->privacy, "recent-files-max-age", digits ? (int) number : -1) ||
+             (g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "recent-files-max-age is locked"), FALSE);
+    }
+  if (g_str_equal (key, "trashAge"))
+    {
+      if (!digits) goto invalid;
+      return g_settings_set_uint (p->privacy, "old-files-age", (guint) number) ||
+             (g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "old-files-age is locked"), FALSE);
+    }
+  /* App permissions change in GNOME's panel (the shell's delegation). */
+  return FALSE;
+invalid:
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "%s can’t take that value", key);
+  return FALSE;
+}
+
+static GSettings *
+installed (const char *id)
+{
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = source ? g_settings_schema_source_lookup (source, id, TRUE) : NULL;
+  return schema ? g_settings_new_full (schema, NULL, NULL) : NULL;
+}
+
+static gpointer
+privacy_start (CcLumaFixture *model)
+{
+  Privacy *p = g_new0 (Privacy, 1);
+  p->model = model;
+  p->cancel = g_cancellable_new ();
+  p->table = cc_luma_gs_table_new (model, rows, G_N_ELEMENTS (rows));
+  p->saver = installed (SAVER);
+  p->privacy = installed (PRIVACY);
+  const char *keys[] = { "lock.delay", "histKeep", "trashAge" };
+  for (guint i = 0; i < G_N_ELEMENTS (keys); i++) cc_luma_fixture_own_key (model, keys[i]);
+  if (p->saver) g_signal_connect_swapped (p->saver, "changed::lock-delay", G_CALLBACK (publish_scales), p);
+  if (p->privacy)
+    {
+      g_signal_connect_swapped (p->privacy, "changed::recent-files-max-age", G_CALLBACK (publish_scales), p);
+      g_signal_connect_swapped (p->privacy, "changed::old-files-age", G_CALLBACK (publish_scales), p);
+    }
+  publish_scales (p);
+  g_bus_get (G_BUS_TYPE_SESSION, p->cancel, bus_ready, p);
+  return p;
+}
+
+static void
+privacy_stop (gpointer state)
+{
+  Privacy *p = state;
+  g_cancellable_cancel (p->cancel);
+  g_clear_object (&p->cancel);
+  if (p->bus && p->changed_signal) g_dbus_connection_signal_unsubscribe (p->bus, p->changed_signal);
+  g_clear_object (&p->bus);
+  if (p->saver) g_signal_handlers_disconnect_by_data (p->saver, p);
+  if (p->privacy) g_signal_handlers_disconnect_by_data (p->privacy, p);
+  g_clear_object (&p->saver);
+  g_clear_object (&p->privacy);
+  cc_luma_gs_table_free (p->table);
+  g_free (p);
+}
+
+const CcLumaAdapter cc_luma_adapter_privacy = { ADAPTER, pages, privacy_start, privacy_write, privacy_stop };
diff --git a/shell/cc-luma-live-proxy.c b/shell/cc-luma-live-proxy.c
new file mode 100644
index 0000000..448163d
--- /dev/null
+++ b/shell/cc-luma-live-proxy.c
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live proxy mode: org.gnome.system.proxy, as panels/network/cc-net-proxy-page.c. */
+#include "cc-luma-live.h"
+#include <gio/gio.h>
+
+#define ADAPTER "proxy"
+static const char * const pages[] = { "wifi", "wifi-net", "wifi-known", "hotspot", "network", NULL };
+
+typedef struct {
+  CcLumaFixture *model;
+  GSettings *settings;
+} Proxy;
+
+static void
+publish (Proxy *p)
+{
+  g_autofree char *mode = g_settings_get_string (p->settings, "mode");
+  cc_luma_fixture_publish_string (p->model, "proxy", g_str_equal (mode, "auto") ? "auto" :
+                                  g_str_equal (mode, "manual") ? "manual" : "off");
+}
+static gboolean
+proxy_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Proxy *p = state;
+  const char *mode;
+  if (!g_str_equal (key, "proxy")) return FALSE;
+  mode = JSON_NODE_HOLDS_VALUE (value) && json_node_get_value_type (value) == G_TYPE_STRING ? json_node_get_string (value) : NULL;
+  if (!p->settings || !mode || !(g_str_equal (mode, "off") || g_str_equal (mode, "auto") || g_str_equal (mode, "manual")))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Unknown proxy mode");
+      return FALSE;
+    }
+  return g_settings_set_string (p->settings, "mode", g_str_equal (mode, "off") ? "none" : mode) ||
+         (g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "The proxy setting is locked"), FALSE);
+}
+static gpointer
+proxy_start (CcLumaFixture *model)
+{
+  Proxy *p = g_new0 (Proxy, 1);
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = source ? g_settings_schema_source_lookup (source, "org.gnome.system.proxy", TRUE) : NULL;
+  p->model = model;
+  if (!schema) return p; /* never ready: the page keeps its panel */
+  p->settings = g_settings_new_full (schema, NULL, NULL);
+  cc_luma_fixture_own_key (model, "proxy");
+  g_signal_connect_swapped (p->settings, "changed::mode", G_CALLBACK (publish), p);
+  publish (p);
+  cc_luma_live_ready (model, ADAPTER);
+  return p;
+}
+static void
+proxy_stop (gpointer state)
+{
+  Proxy *p = state;
+  if (p->settings) g_signal_handlers_disconnect_by_data (p->settings, p);
+  g_clear_object (&p->settings);
+  g_free (p);
+}
+
+const CcLumaAdapter cc_luma_adapter_proxy = { ADAPTER, pages, proxy_start, proxy_write, proxy_stop };
diff --git a/shell/cc-luma-live-region.c b/shell/cc-luma-live-region.c
new file mode 100644
index 0000000..eff242f
--- /dev/null
+++ b/shell/cc-luma-live-region.c
@@ -0,0 +1,305 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live Region & Language, as panels/system/region/cc-region-page.c reads it:
+ * your language from AccountsService (else LC_MESSAGES), formats from
+ * org.gnome.system.locale region (empty: your language's), the sign-in
+ * screen's from localed. The choices are gnome_get_all_locales() with
+ * GNOME's names; each format's samples come from the locale itself, as
+ * cc-format-preview.c makes them, on a worker thread (uselocale is per
+ * thread). Your language and formats are written as the panel writes them;
+ * the sign-in screen's language opens the GNOME panel. */
+#define GNOME_DESKTOP_USE_UNSTABLE_API
+#include "cc-luma-live.h"
+#include <act/act.h>
+#include <langinfo.h>
+#include <libgnome-desktop/gnome-languages.h>
+#include <locale.h>
+#include <monetary.h>
+#include <unistd.h>
+
+#define ADAPTER "region"
+static const char * const pages[] = { "region", NULL };
+
+typedef struct {
+  CcLumaFixture *model;
+  GCancellable *cancel;
+  ActUserManager *manager;
+  GSettings *locale;
+  GDBusProxy *localed;
+  gboolean formats, ready;
+} Region;
+
+static void
+check_ready (Region *r)
+{
+  gboolean loaded = FALSE;
+  g_object_get (r->manager, "is-loaded", &loaded, NULL);
+  if (r->ready || !r->formats || !r->localed || !loaded) return;
+  r->ready = TRUE;
+  cc_luma_live_ready (r->model, ADAPTER);
+}
+
+static void
+publish (Region *r)
+{
+  ActUser *me = act_user_manager_get_user_by_id (r->manager, getuid ());
+  const char *language = me && act_user_is_loaded (me) ? act_user_get_language (me) : NULL;
+  if (!language || !*language) language = setlocale (LC_MESSAGES, NULL);
+  cc_luma_fixture_publish_string (r->model, "lang", language);
+  g_autofree char *region = r->locale ? g_settings_get_string (r->locale, "region") : g_strdup ("");
+  cc_luma_fixture_publish_string (r->model, "fmt", *region ? region : language);
+  g_autoptr (GVariant) v = r->localed ? g_dbus_proxy_get_cached_property (r->localed, "Locale") : NULL;
+  const char *login = "";
+  g_autofree const char **strv = v ? g_variant_get_strv (v, NULL) : NULL;
+  for (guint i = 0; strv && strv[i]; i++)
+    if (g_str_has_prefix (strv[i], "LANG=")) login = strv[i] + 5;
+  cc_luma_fixture_publish_string (r->model, "loginLang", login);
+  check_ready (r);
+}
+
+/* ── Samples (cc-format-preview.c) ───────────────────────────────────── */
+static char *
+in_locale (const char *id, int mask, char *(*make) (void))
+{
+  locale_t l = newlocale (mask, id, (locale_t) 0);
+  if (l == (locale_t) 0) return NULL;
+  locale_t old = uselocale (l);
+  char *out = make ();
+  uselocale (old);
+  freelocale (l);
+  return out;
+}
+static char *sample_date (void)
+{
+  g_autoptr (GDateTime) now = g_date_time_new_now_local ();
+  return g_date_time_format (now, "%x");
+}
+static char *sample_time (void)
+{
+  g_autoptr (GDateTime) now = g_date_time_new_now_local ();
+  return g_date_time_format (now, "%X");
+}
+static char *sample_number (void) { return g_strdup_printf ("%'.2f", 1234567.89); }
+static char *sample_money (void)
+{
+  char buf[64];
+  return strfmon (buf, sizeof buf, "%n", 1234.56) > 0 ? g_locale_to_utf8 (buf, -1, NULL, NULL, NULL) : NULL;
+}
+static char *sample_measures (void)
+{
+  const char *m = nl_langinfo (_NL_MEASUREMENT_MEASUREMENT);
+  return g_strdup (m && *m == 2 ? "US Customary" : "Metric");
+}
+static char *sample_paper (void)
+{
+  int w = (int) (intptr_t) nl_langinfo (_NL_PAPER_WIDTH), h = (int) (intptr_t) nl_langinfo (_NL_PAPER_HEIGHT);
+  if (w == 210 && h == 297) return g_strdup ("A4");
+  if (w == 216 && h == 279) return g_strdup ("Letter");
+  return w > 0 && h > 0 ? g_strdup_printf ("%d × %d mm", w, h) : NULL;
+}
+
+typedef struct { JsonArray *langs; JsonObject *formats; } Lists;
+
+static void
+add_format (JsonObject *formats, const char *id)
+{
+  if (json_object_has_member (formats, id)) return;
+  g_autofree char *country = gnome_get_country_from_locale (id, NULL);
+  char *(*makers[]) (void) = { sample_date, sample_time, sample_number, sample_money, sample_measures, sample_paper };
+  int masks[] = { LC_TIME_MASK, LC_TIME_MASK, LC_NUMERIC_MASK, LC_MONETARY_MASK, LC_MEASUREMENT_MASK, LC_PAPER_MASK };
+  JsonArray *row = json_array_new ();
+  json_array_add_string_element (row, country ? country : id);
+  for (guint i = 0; i < G_N_ELEMENTS (makers); i++)
+    {
+      g_autofree char *value = in_locale (id, masks[i], makers[i]);
+      json_array_add_string_element (row, value ? value : "");
+    }
+  json_object_set_array_member (formats, id, row);
+}
+
+typedef struct { char *id, *name, *country; } Named;
+static void named_free (gpointer p) { Named *n = p; g_free (n->id); g_free (n->name); g_free (n->country); g_free (n); }
+static int by_name (gconstpointer a, gconstpointer b)
+{
+  const Named *x = *(Named **) a, *y = *(Named **) b;
+  int o = g_utf8_collate (x->name, y->name);
+  return o ? o : g_strcmp0 (x->id, y->id);
+}
+static int by_country (gconstpointer a, gconstpointer b)
+{
+  const Named *x = *(Named **) a, *y = *(Named **) b;
+  int o = g_utf8_collate (x->country, y->country);
+  return o ? o : g_strcmp0 (x->id, y->id);
+}
+
+/* The pickers list languages and formats by name, as GNOME's choosers sort them. */
+static void
+lists_thread (GTask *task, gpointer source, gpointer data, GCancellable *cancel)
+{
+  Lists *lists = g_new0 (Lists, 1);
+  g_auto (GStrv) ids = gnome_get_all_locales ();
+  const char *extra = data; /* the current format, even if not in the list */
+  g_autoptr (GPtrArray) all = g_ptr_array_new_with_free_func (named_free);
+  lists->langs = json_array_new ();
+  lists->formats = json_object_new ();
+  for (guint i = 0; ids && ids[i]; i++)
+    {
+      Named *n = g_new0 (Named, 1);
+      n->id = g_strdup (ids[i]);
+      n->name = gnome_get_language_from_locale (ids[i], NULL);
+      n->country = gnome_get_country_from_locale (ids[i], NULL);
+      if (!n->name) n->name = g_strdup (ids[i]);
+      if (!n->country) n->country = g_strdup (ids[i]);
+      g_ptr_array_add (all, n);
+    }
+  g_ptr_array_sort (all, by_name);
+  for (guint i = 0; i < all->len; i++)
+    {
+      Named *n = g_ptr_array_index (all, i);
+      JsonArray *pair = json_array_new ();
+      json_array_add_string_element (pair, n->id);
+      json_array_add_string_element (pair, n->name);
+      json_array_add_array_element (lists->langs, pair);
+    }
+  g_ptr_array_sort (all, by_country);
+  for (guint i = 0; i < all->len; i++) add_format (lists->formats, ((Named *) g_ptr_array_index (all, i))->id);
+  if (extra && *extra) add_format (lists->formats, extra);
+  g_task_return_pointer (task, lists, NULL);
+}
+
+static void
+lists_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  Lists *lists = g_task_propagate_pointer (G_TASK (result), &error);
+  if (!lists) return;
+  Region *r = data;
+  g_autoptr (JsonNode) langs = json_node_init_array (json_node_alloc (), lists->langs);
+  g_autoptr (JsonNode) formats = json_node_init_object (json_node_alloc (), lists->formats);
+  json_array_unref (lists->langs);
+  json_object_unref (lists->formats);
+  g_free (lists);
+  cc_luma_fixture_publish_data (r->model, "CFLANG", langs);
+  cc_luma_fixture_publish_data (r->model, "CFFMT", formats);
+  r->formats = TRUE;
+  publish (r);
+}
+
+static void
+localed_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Region *r = data;
+  if (!proxy) { g_warning ("Settings: localed: %s", error->message); return; }
+  r->localed = proxy;
+  g_signal_connect_swapped (proxy, "g-properties-changed", G_CALLBACK (publish), r);
+  publish (r);
+}
+
+static void
+user_ready (Region *r)
+{
+  ActUser *me = act_user_manager_get_user_by_id (r->manager, getuid ());
+  if (me)
+    {
+      g_signal_handlers_disconnect_by_data (me, r);
+      g_signal_connect_swapped (me, "changed", G_CALLBACK (publish), r);
+      g_signal_connect_swapped (me, "notify::is-loaded", G_CALLBACK (publish), r);
+    }
+  publish (r);
+}
+
+static gpointer
+region_start (CcLumaFixture *model)
+{
+  Region *r = g_new0 (Region, 1);
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = source ? g_settings_schema_source_lookup (source, "org.gnome.system.locale", TRUE) : NULL;
+  gboolean loaded = FALSE;
+  r->model = model;
+  r->cancel = g_cancellable_new ();
+  r->manager = g_object_ref (act_user_manager_get_default ());
+  cc_luma_fixture_own_key (model, "lang");
+  cc_luma_fixture_own_key (model, "fmt");
+  if (schema) r->locale = g_settings_new_full (schema, NULL, NULL);
+  if (r->locale) g_signal_connect_swapped (r->locale, "changed", G_CALLBACK (publish), r);
+  g_signal_connect_swapped (r->manager, "notify::is-loaded", G_CALLBACK (user_ready), r);
+  g_object_get (r->manager, "is-loaded", &loaded, NULL);
+  if (loaded) user_ready (r);
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_NONE, NULL, "org.freedesktop.locale1",
+                            "/org/freedesktop/locale1", "org.freedesktop.locale1", r->cancel, localed_ready, r);
+  /* gnome-languages fills its tables on first use, unlocked: fill them here
+   * on the main thread before the worker reads them. */
+  {
+    g_auto (GStrv) warm = gnome_get_all_locales ();
+    if (warm && warm[0])
+      {
+        g_free (gnome_get_language_from_locale (warm[0], NULL));
+        g_free (gnome_get_country_from_locale (warm[0], NULL));
+      }
+  }
+  g_autofree char *region = r->locale ? g_settings_get_string (r->locale, "region") : NULL;
+  g_autoptr (GTask) task = g_task_new (NULL, r->cancel, lists_done, r);
+  g_task_set_task_data (task, g_steal_pointer (&region), g_free);
+  g_task_run_in_thread (task, lists_thread);
+  return r;
+}
+
+static void
+region_stop (gpointer state)
+{
+  Region *r = state;
+  g_cancellable_cancel (r->cancel);
+  g_clear_object (&r->cancel);
+  ActUser *me = act_user_manager_get_user_by_id (r->manager, getuid ());
+  if (me) g_signal_handlers_disconnect_by_data (me, r);
+  g_signal_handlers_disconnect_by_data (r->manager, r);
+  if (r->locale) g_signal_handlers_disconnect_by_data (r->locale, r);
+  if (r->localed) g_signal_handlers_disconnect_by_data (r->localed, r);
+  g_clear_object (&r->locale);
+  g_clear_object (&r->localed);
+  g_clear_object (&r->manager);
+  g_free (r);
+}
+
+static gboolean
+known_locale (const char *id)
+{
+  g_auto (GStrv) all = gnome_get_all_locales ();
+  return id && all && g_strv_contains ((const char * const *) all, id);
+}
+
+/* As cc-region-page.c: your language through AccountsService (it applies
+ * at your next sign-in), formats through org.gnome.system.locale region.
+ * The sign-in screen's language needs localed's admin permission: it
+ * changes in GNOME's panel. */
+static gboolean
+region_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Region *r = state;
+  const char *id = value && JSON_NODE_HOLDS_VALUE (value) && json_node_get_value_type (value) == G_TYPE_STRING
+                   ? json_node_get_string (value) : NULL;
+  if (!g_str_equal (key, "lang") && !g_str_equal (key, "fmt")) return FALSE;
+  if (!known_locale (id))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "%s isn’t a language this computer has", id ? id : "");
+      return FALSE;
+    }
+  if (g_str_equal (key, "fmt"))
+    {
+      if (r->locale && g_settings_set_string (r->locale, "region", id)) return TRUE;
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Formats are locked");
+      return FALSE;
+    }
+  ActUser *me = act_user_manager_get_user_by_id (r->manager, getuid ());
+  if (!me || !act_user_is_loaded (me))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED, "Accounts aren’t available");
+      return FALSE;
+    }
+  act_user_set_language (me, id);
+  return TRUE;
+}
+
+const CcLumaAdapter cc_luma_adapter_region = { ADAPTER, pages, region_start, region_write, region_stop };
diff --git a/shell/cc-luma-live-search.c b/shell/cc-luma-live-search.c
new file mode 100644
index 0000000..9fb48ec
--- /dev/null
+++ b/shell/cc-luma-live-search.c
@@ -0,0 +1,343 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Search: the installed GNOME Shell search providers and
+ * org.gnome.desktop.search-providers, read and written as panels/search
+ * does (sort-order, and enabled or disabled by each provider's default);
+ * the folders search looks inside through the Tracker settings
+ * (cc-luma-search-locations.c, with its first-write backup). "Offer to ask
+ * Ari" has no owner and is not published. */
+#include "cc-luma-live-gsettings.h"
+#include "cc-luma-live-apps.h"
+#include "cc-luma-discovery.h"
+#include "cc-luma-search-locations.h"
+#include <gio/gdesktopappinfo.h>
+
+#define PROVIDER_GROUP "Shell Search Provider"
+
+typedef struct {
+  char *id;               /* desktop id */
+  gboolean default_on;    /* not DefaultDisabled */
+} Provider;
+
+typedef struct {
+  CcLumaFixture *model;
+  CcLumaReadyGate *gate;
+  GSettings *search;
+  GSettings *places;      /* Tracker's, NULL without it */
+  GPtrArray *providers;   /* Provider, NULL until found */
+  GCancellable *cancel;
+  char *backup_dir;
+} Search;
+
+static void
+provider_free (Provider *p)
+{
+  g_free (p->id);
+  g_free (p);
+}
+
+static gboolean
+provider_on (Search *self, Provider *p)
+{
+  g_auto (GStrv) list = g_settings_get_strv (self->search, p->default_on ? "disabled" : "enabled");
+  gboolean listed = g_strv_contains ((const char * const *) list, p->id);
+  return !g_settings_get_boolean (self->search, "disable-external") && (p->default_on ? !listed : listed);
+}
+
+static int
+provider_order (gconstpointer a, gconstpointer b, gpointer data)
+{
+  const Provider *x = *(Provider **) a, *y = *(Provider **) b;
+  char **order = data;
+  int ix = -1, iy = -1;
+  for (int i = 0; order[i]; i++)
+    {
+      if (g_str_equal (order[i], x->id)) ix = i;
+      if (g_str_equal (order[i], y->id)) iy = i;
+    }
+  /* Listed ones first, in the list's order; the others by id. */
+  if (ix != iy) return ix < 0 ? 1 : iy < 0 ? -1 : ix - iy;
+  return g_strcmp0 (x->id, y->id);
+}
+
+static void
+publish_providers (Search *self)
+{
+  if (!self->providers) return;
+  g_auto (GStrv) order = g_settings_get_strv (self->search, "sort-order");
+  g_ptr_array_sort_with_data (self->providers, provider_order, order);
+  g_autoptr (JsonArray) list = json_array_new ();
+  for (guint i = 0; i < self->providers->len; i++)
+    {
+      Provider *p = self->providers->pdata[i];
+      JsonArray *pair = json_array_new ();
+      json_array_add_string_element (pair, p->id);
+      json_array_add_boolean_element (pair, provider_on (self, p));
+      json_array_add_array_element (list, pair);
+    }
+  g_autoptr (JsonNode) node = json_node_init_array (json_node_alloc (), list);
+  cc_luma_fixture_publish (self->model, "sa", node);
+}
+
+/* ── Providers (panels/search: search_providers_discover_thread) ───── */
+static void
+discover (GTask *task, gpointer source, gpointer data, GCancellable *cancel)
+{
+  GPtrArray *found = g_ptr_array_new_with_free_func ((GDestroyNotify) provider_free);
+  g_autoptr (GHashTable) seen = g_hash_table_new (g_str_hash, g_str_equal);
+  for (const char * const *dir = g_get_system_data_dirs (); *dir && !g_cancellable_is_cancelled (cancel); dir++)
+    {
+      g_autofree char *path = g_build_filename (*dir, "gnome-shell", "search-providers", NULL);
+      g_autoptr (GDir) listing = g_dir_open (path, 0, NULL);
+      const char *name;
+      while (listing && (name = g_dir_read_name (listing)))
+        {
+          g_autofree char *file = g_build_filename (path, name, NULL);
+          g_autoptr (GKeyFile) keys = g_key_file_new ();
+          if (!g_key_file_load_from_file (keys, file, G_KEY_FILE_NONE, NULL) || !g_key_file_has_group (keys, PROVIDER_GROUP)) continue;
+          g_autofree char *id = g_key_file_get_string (keys, PROVIDER_GROUP, "DesktopId", NULL);
+          if (!id || g_hash_table_contains (seen, id)) continue;
+          Provider *p = g_new0 (Provider, 1);
+          p->default_on = !g_key_file_get_boolean (keys, PROVIDER_GROUP, "DefaultDisabled", NULL);
+          p->id = g_steal_pointer (&id);
+          g_hash_table_add (seen, p->id);
+          g_ptr_array_add (found, p);
+        }
+    }
+  g_task_return_pointer (task, found, (GDestroyNotify) g_ptr_array_unref);
+}
+
+static void
+discovered (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GPtrArray) found = g_task_propagate_pointer (G_TASK (result), NULL);
+  if (!found) return; /* cancelled: the adapter is gone */
+  Search *self = data;
+  self->providers = g_ptr_array_new_with_free_func ((GDestroyNotify) provider_free);
+  for (guint i = 0; i < found->len; i++)
+    {
+      Provider *p = found->pdata[i];
+      g_autoptr (GDesktopAppInfo) info = g_desktop_app_info_new (p->id);
+      /* An app that isn't installed has no provider (as panels/search). */
+      if (!info || !cc_luma_live_publish_app (self->model, p->id, G_APP_INFO (info))) continue;
+      found->pdata[i] = NULL;
+      g_ptr_array_add (self->providers, p);
+    }
+  g_ptr_array_set_free_func (found, NULL);
+  for (guint i = 0; i < found->len; i++) if (found->pdata[i]) provider_free (found->pdata[i]);
+  g_signal_connect_swapped (self->search, "changed", G_CALLBACK (publish_providers), self);
+  publish_providers (self);
+}
+
+/* ── Folders ───────────────────────────────────────────────────────── */
+static char *
+uri_of (const char *path)
+{
+  g_autoptr (GFile) file = g_file_new_for_path (path);
+  return g_file_get_uri (file);
+}
+
+/* Home and the usual folders, on or off, and every folder Tracker has. */
+static void
+publish_places (Search *self)
+{
+  g_autoptr (JsonNode) node = json_node_init_object (json_node_alloc (), json_object_new ());
+  JsonObject *places = json_node_get_object (node);
+  const GUserDirectory dirs[] = { G_USER_DIRECTORY_DOCUMENTS, G_USER_DIRECTORY_DOWNLOAD, G_USER_DIRECTORY_MUSIC,
+                                  G_USER_DIRECTORY_PICTURES, G_USER_DIRECTORY_VIDEOS };
+  g_autofree char *home = uri_of (g_get_home_dir ());
+  json_object_set_boolean_member (places, home, FALSE);
+  for (guint i = 0; i < G_N_ELEMENTS (dirs); i++)
+    {
+      const char *path = g_get_user_special_dir (dirs[i]);
+      if (!path || !g_path_is_absolute (path)) continue;
+      g_autofree char *uri = uri_of (path);
+      json_object_set_boolean_member (places, uri, FALSE);
+    }
+  g_autoptr (GPtrArray) folders = cc_luma_search_locations_dup_folders (self->places);
+  for (guint i = 0; i < folders->len; i++)
+    {
+      g_autofree char *uri = g_file_get_uri (folders->pdata[i]);
+      json_object_set_boolean_member (places, uri, TRUE);
+    }
+  cc_luma_fixture_publish (self->model, "sl", node);
+}
+
+static gpointer
+search_start (CcLumaFixture *model)
+{
+  Search *self = g_new0 (Search, 1);
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = source ? g_settings_schema_source_lookup (source, "org.gnome.desktop.search-providers", TRUE) : NULL;
+  self->model = g_object_ref (model);
+  self->cancel = g_cancellable_new ();
+  self->backup_dir = g_build_filename (g_get_user_data_dir (), "luma", "settings", "backups", NULL);
+  if (schema && g_settings_schema_has_key (schema, "sort-order") && g_settings_schema_has_key (schema, "enabled") &&
+      g_settings_schema_has_key (schema, "disabled") && g_settings_schema_has_key (schema, "disable-external"))
+    {
+      self->search = g_settings_new ("org.gnome.desktop.search-providers");
+      cc_luma_fixture_own_key (model, "sa");
+      g_autoptr (GTask) task = g_task_new (NULL, self->cancel, discovered, self);
+      g_task_run_in_thread (task, discover);
+    }
+  self->places = cc_luma_search_locations_new (NULL);
+  if (self->places)
+    {
+      g_signal_connect_swapped (self->places, "changed", G_CALLBACK (publish_places), self);
+      cc_luma_fixture_own_key (model, "sl");
+      publish_places (self);
+    }
+  cc_luma_live_desk_dump_watch (model);
+  self->gate = cc_luma_ready_gate_new (model, "search", cc_luma_search_validate);
+  return self;
+}
+
+static gboolean
+set_list (Search *self, const char *key, GPtrArray *list, GError **error)
+{
+  g_ptr_array_add (list, NULL);
+  if (!g_settings_is_writable (self->search, key))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Search results are locked by policy");
+      return FALSE;
+    }
+  return g_settings_set_strv (self->search, key, (const char * const *) list->pdata);
+}
+
+/* A new "sa": the providers in their new order, each on or off. */
+static gboolean
+write_providers (Search *self, JsonNode *value, GError **error)
+{
+  JsonArray *list = JSON_NODE_HOLDS_ARRAY (value) ? json_node_get_array (value) : NULL;
+  if (!self->providers || !list || json_array_get_length (list) != self->providers->len)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Search results can’t take that list");
+      return FALSE;
+    }
+  g_autoptr (GPtrArray) order = g_ptr_array_new ();
+  gboolean off_all = g_settings_get_boolean (self->search, "disable-external");
+  for (guint i = 0; i < json_array_get_length (list); i++)
+    {
+      JsonArray *pair = json_array_get_array_element (list, i);
+      const char *id = pair && json_array_get_length (pair) == 2 ? json_array_get_string_element (pair, 0) : NULL;
+      Provider *p = NULL;
+      for (guint j = 0; id && j < self->providers->len; j++)
+        if (g_str_equal (((Provider *) self->providers->pdata[j])->id, id)) p = self->providers->pdata[j];
+      if (!p || g_ptr_array_find_with_equal_func (order, p->id, g_str_equal, NULL))
+        {
+          g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Search results can’t take that list");
+          return FALSE;
+        }
+      g_ptr_array_add (order, p->id);
+      gboolean on = json_array_get_boolean_element (pair, 1);
+      if (on == provider_on (self, p)) continue;
+      if (off_all)
+        {
+          /* GNOME's own "App Search" switch is off: no app searches. */
+          g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Searching in apps is turned off");
+          return FALSE;
+        }
+      /* panels/search switch_settings_mapping_set_generic */
+      const char *key = p->default_on ? "disabled" : "enabled";
+      gboolean listed = p->default_on ? !on : on;
+      g_auto (GStrv) current = g_settings_get_strv (self->search, key);
+      g_autoptr (GPtrArray) next = g_ptr_array_new_with_free_func (g_free);
+      for (guint k = 0; current[k]; k++)
+        if (!g_str_equal (current[k], p->id)) g_ptr_array_add (next, g_strdup (current[k]));
+      if (listed) g_ptr_array_add (next, g_strdup (p->id));
+      if (!set_list (self, key, next, error)) return FALSE;
+    }
+  /* panels/search search_panel_propagate_sort_order: every provider. */
+  g_auto (GStrv) before = g_settings_get_strv (self->search, "sort-order");
+  gboolean same = g_strv_length (before) >= order->len;
+  for (guint i = 0; same && i < order->len; i++) same = g_str_equal (before[i], order->pdata[i]);
+  if (same) return TRUE;
+  g_autoptr (GPtrArray) sorted = g_ptr_array_new_with_free_func (g_free);
+  for (guint i = 0; i < order->len; i++) g_ptr_array_add (sorted, g_strdup (order->pdata[i]));
+  return set_list (self, "sort-order", sorted, error);
+}
+
+typedef struct { Search *self; GCancellable *cancel; } PlaceWrite;
+
+static void
+place_written (GObject *source, GAsyncResult *result, gpointer data)
+{
+  PlaceWrite *write = data;
+  g_autoptr (GError) error = NULL;
+  if (!cc_luma_search_locations_set_finish (G_SETTINGS (source), result, &error) &&
+      !g_cancellable_is_cancelled (write->cancel))
+    {
+      g_warning ("Settings live: search folder not changed: %s", error->message);
+      publish_places (write->self); /* show what Tracker has */
+    }
+  g_object_unref (write->cancel);
+  g_free (write);
+}
+
+/* A new "sl": each folder whose switch changed goes to Tracker's settings. */
+static gboolean
+write_places (Search *self, JsonNode *value, GError **error)
+{
+  JsonNode *now = cc_luma_fixture_get (self->model, "sl");
+  if (!JSON_NODE_HOLDS_OBJECT (value) || !now || !JSON_NODE_HOLDS_OBJECT (now))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Search folders can’t take that value");
+      return FALSE;
+    }
+  JsonObject *wanted = json_node_get_object (value), *current = json_node_get_object (now);
+  g_autoptr (GList) uris = json_object_get_members (wanted);
+  g_autoptr (GPtrArray) edits = g_ptr_array_new_with_free_func (g_object_unref);
+  g_autoptr (GArray) states = g_array_new (FALSE, FALSE, sizeof (gboolean));
+  for (GList *i = uris; i; i = i->next)
+    {
+      JsonNode *on = json_object_get_member (wanted, i->data);
+      if (!JSON_NODE_HOLDS_VALUE (on) || json_node_get_value_type (on) != G_TYPE_BOOLEAN) goto invalid;
+      gboolean enabled = json_node_get_boolean (on);
+      if (json_object_has_member (current, i->data) && json_object_get_boolean_member (current, i->data) == enabled) continue;
+      g_autoptr (GFile) folder = g_file_new_for_uri (i->data);
+      if (!g_file_is_native (folder)) goto invalid;
+      g_ptr_array_add (edits, g_steal_pointer (&folder));
+      g_array_append_val (states, enabled);
+    }
+  for (guint i = 0; i < edits->len; i++)
+    {
+      PlaceWrite *write = g_new0 (PlaceWrite, 1);
+      write->self = self;
+      write->cancel = g_object_ref (self->cancel);
+      cc_luma_search_locations_set_async (self->places, edits->pdata[i], g_array_index (states, gboolean, i),
+                                          self->backup_dir, self->cancel, place_written, write);
+    }
+  return TRUE;
+invalid:
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Search folders can’t take that value");
+  return FALSE;
+}
+
+static gboolean
+search_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Search *self = state;
+  if (g_str_equal (key, "sa") && self->search) return write_providers (self, value, error);
+  if (g_str_equal (key, "sl") && self->places) return write_places (self, value, error);
+  return FALSE;
+}
+
+static void
+search_stop (gpointer state)
+{
+  Search *self = state;
+  g_cancellable_cancel (self->cancel);
+  cc_luma_ready_gate_free (self->gate);
+  if (self->search) g_signal_handlers_disconnect_by_data (self->search, self);
+  if (self->places) g_signal_handlers_disconnect_by_data (self->places, self);
+  g_clear_object (&self->search);
+  g_clear_object (&self->places);
+  g_clear_pointer (&self->providers, g_ptr_array_unref);
+  g_clear_object (&self->cancel);
+  g_free (self->backup_dir);
+  g_object_unref (self->model);
+  g_free (self);
+}
+
+const CcLumaAdapter cc_luma_adapter_search = {
+  "search", (const char * const[]) { "search", "search-places", NULL }, search_start, search_write, search_stop
+};
diff --git a/shell/cc-luma-live-security.c b/shell/cc-luma-live-security.c
new file mode 100644
index 0000000..6924f70
--- /dev/null
+++ b/shell/cc-luma-live-security.c
@@ -0,0 +1,177 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live Device security, from what panels/privacy reads:
+ *  - fwupd's host security (HostSecurityId, GetHostSecurityAttrs), as
+ *    firmware-security/cc-firmware-security-page.c: Secure Boot active when
+ *    org.fwupd.hsi.Uefi.SecureBoot succeeds, TPM 2.0 when
+ *    org.fwupd.hsi.Tpm.Version20 succeeds;
+ *  - boltd's AuthMode for "Allow new Thunderbolt devices", set as
+ *    bolt/cc-bolt-page.c sets it (the enabled flag, the daemon's own polkit
+ *    check with interaction).
+ * Disk encryption and firmware updates have no reader here: left out. A
+ * system without fwupd or boltd leaves those rows out. */
+#include "cc-luma-live.h"
+#include <string.h>
+
+#define ADAPTER "security"
+static const char * const pages[] = { "p-dev", NULL };
+#define FLAG_SUCCESS 1 /* FWUPD_SECURITY_ATTR_FLAG_SUCCESS */
+
+typedef struct {
+  CcLumaFixture *model;
+  GCancellable *cancel;
+  GDBusProxy *bolt;
+  gboolean fwupd_read, bolt_read, ready;
+} Security;
+
+static void
+check_ready (Security *s)
+{
+  if (s->ready || !s->fwupd_read || !s->bolt_read) return;
+  s->ready = TRUE;
+  cc_luma_live_ready (s->model, ADAPTER);
+}
+
+static void
+attrs_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) out = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Security *s = data;
+  const char *sb = "", *tpm = "";
+  if (out)
+    {
+      g_autoptr (GVariant) list = g_variant_get_child_value (out, 0);
+      for (gsize i = 0; i < g_variant_n_children (list); i++)
+        {
+          g_autoptr (GVariant) attr = g_variant_get_child_value (list, i);
+          const char *id = NULL;
+          guint64 flags = 0;
+          if (!g_variant_lookup (attr, "AppstreamId", "&s", &id)) continue;
+          g_variant_lookup (attr, "Flags", "t", &flags);
+          if (g_str_equal (id, "org.fwupd.hsi.Uefi.SecureBoot")) sb = flags & FLAG_SUCCESS ? "On" : "Off";
+          else if (g_str_equal (id, "org.fwupd.hsi.Tpm.Version20") && (flags & FLAG_SUCCESS)) tpm = "Version 2.0";
+        }
+    }
+  else
+    g_message ("Settings: host security: %s", error->message);
+  cc_luma_fixture_publish_string (s->model, "sec.sb", sb);
+  cc_luma_fixture_publish_string (s->model, "sec.tpm", tpm);
+  s->fwupd_read = TRUE;
+  check_ready (s);
+}
+
+static void
+fwupd_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GDBusProxy) proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Security *s = data;
+  g_autoptr (GVariant) hsi = proxy ? g_dbus_proxy_get_cached_property (proxy, "HostSecurityId") : NULL;
+  /* "HSI:2 (v…)" or "HSI:INVALID:…": the level only when fwupd could judge. */
+  const char *id = hsi && g_variant_is_of_type (hsi, G_VARIANT_TYPE_STRING) ? g_variant_get_string (hsi, NULL) : "";
+  int level = g_str_has_prefix (id, "HSI:") && g_ascii_isdigit (id[4]) ? id[4] - '0' : -1;
+  cc_luma_fixture_publish_int (s->model, "sec.hsi", level);
+  if (!hsi)
+    {
+      cc_luma_fixture_publish_string (s->model, "sec.sb", "");
+      cc_luma_fixture_publish_string (s->model, "sec.tpm", "");
+      s->fwupd_read = TRUE;
+      check_ready (s);
+      return;
+    }
+  g_dbus_proxy_call (proxy, "GetHostSecurityAttrs", NULL, G_DBUS_CALL_FLAGS_NONE, -1, s->cancel, attrs_done, s);
+}
+
+/* boltd's AuthMode is a flags string ("enabled" | "disabled"). */
+static void
+publish_bolt (Security *s)
+{
+  g_autoptr (GVariant) mode = s->bolt ? g_dbus_proxy_get_cached_property (s->bolt, "AuthMode") : NULL;
+  gboolean present = mode && g_variant_is_of_type (mode, G_VARIANT_TYPE_STRING);
+  g_auto (GStrv) flags = present ? g_strsplit (g_variant_get_string (mode, NULL), "|", -1) : NULL;
+  gboolean enabled = FALSE;
+  for (guint i = 0; flags && flags[i]; i++) if (g_str_equal (g_strstrip (flags[i]), "enabled")) enabled = TRUE;
+  cc_luma_fixture_publish_boolean (s->model, "sec.bolt", present);
+  cc_luma_fixture_publish_boolean (s->model, "tbolt", enabled);
+  s->bolt_read = TRUE;
+  check_ready (s);
+}
+
+static void
+bolt_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Security *s = data;
+  s->bolt = proxy;
+  if (proxy) g_signal_connect_swapped (proxy, "g-properties-changed", G_CALLBACK (publish_bolt), s);
+  publish_bolt (s);
+}
+
+static void
+set_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) out = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  if (error) g_message ("Settings: Thunderbolt policy: %s", error->message);
+  publish_bolt (data);
+}
+
+static gboolean
+security_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Security *s = state;
+  if (!g_str_equal (key, "tbolt")) return FALSE;
+  g_autoptr (GVariant) mode = s->bolt ? g_dbus_proxy_get_cached_property (s->bolt, "AuthMode") : NULL;
+  if (!mode || !value || !JSON_NODE_HOLDS_VALUE (value) || json_node_get_value_type (value) != G_TYPE_BOOLEAN)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Thunderbolt isn’t available");
+      return FALSE;
+    }
+  /* cc_bolt_page: toggle only the enabled flag, keep the others. */
+  g_auto (GStrv) flags = g_strsplit (g_variant_get_string (mode, NULL), "|", -1);
+  g_autoptr (GStrvBuilder) b = g_strv_builder_new ();
+  for (guint i = 0; flags[i]; i++)
+    {
+      g_strstrip (flags[i]);
+      if (*flags[i] && !g_str_equal (flags[i], "enabled") && !g_str_equal (flags[i], "disabled")) g_strv_builder_add (b, flags[i]);
+    }
+  g_strv_builder_add (b, json_node_get_boolean (value) ? "enabled" : "disabled");
+  g_auto (GStrv) next = g_strv_builder_end (b);
+  g_autofree char *text = g_strjoinv ("|", next);
+  g_dbus_proxy_call (s->bolt, "org.freedesktop.DBus.Properties.Set",
+                     g_variant_new ("(ssv)", "org.freedesktop.bolt1.Manager", "AuthMode", g_variant_new_string (text)),
+                     G_DBUS_CALL_FLAGS_ALLOW_INTERACTIVE_AUTHORIZATION, -1, s->cancel, set_done, s);
+  return TRUE;
+}
+
+static gpointer
+security_start (CcLumaFixture *model)
+{
+  Security *s = g_new0 (Security, 1);
+  s->model = model;
+  s->cancel = g_cancellable_new ();
+  cc_luma_fixture_own_key (model, "tbolt");
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_NONE, NULL, "org.freedesktop.fwupd", "/",
+                            "org.freedesktop.fwupd", s->cancel, fwupd_ready, s);
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_NONE, NULL, "org.freedesktop.bolt",
+                            "/org/freedesktop/bolt", "org.freedesktop.bolt1.Manager", s->cancel, bolt_ready, s);
+  return s;
+}
+
+static void
+security_stop (gpointer state)
+{
+  Security *s = state;
+  g_cancellable_cancel (s->cancel);
+  g_clear_object (&s->cancel);
+  if (s->bolt) g_signal_handlers_disconnect_by_data (s->bolt, s);
+  g_clear_object (&s->bolt);
+  g_free (s);
+}
+
+const CcLumaAdapter cc_luma_adapter_security = { ADAPTER, pages, security_start, security_write, security_stop };
diff --git a/shell/cc-luma-live-sharing.c b/shell/cc-luma-live-sharing.c
new file mode 100644
index 0000000..6569f60
--- /dev/null
+++ b/shell/cc-luma-live-sharing.c
@@ -0,0 +1,304 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live Sharing and Remote Desktop, read as the GNOME panels read them:
+ *  - file and media sharing: gnome-settings-daemon's Sharing service, on for
+ *    the current network when that network is in the service's list
+ *    (panels/sharing/cc-sharing-networks.c), the password rule from
+ *    org.gnome.desktop.file-sharing; each row only when its service exists;
+ *  - desktop sharing: org.gnome.desktop.remote-desktop.rdp enable plus the
+ *    gnome-remote-desktop user unit, view-only for control
+ *    (cc-desktop-sharing-page.c); remote sign-in: the system
+ *    org.gnome.RemoteDesktop.Configuration Rdp server's Enabled
+ *    (cc-remote-login-page.c).
+ * File and media sharing are switched through gsd-sharing, the password
+ * rule and remote control through their GSettings keys; desktop sharing
+ * (credentials, a certificate) and remote sign-in (an administrator) open
+ * the GNOME panels. */
+#include "cc-luma-live-gsettings.h"
+#include "panels/system/cc-systemd-service.h"
+
+#define ADAPTER "sharing"
+static const char * const pages[] = { "sharing", "remote", NULL };
+#define FILES_SERVICE "gnome-user-share-webdav"
+#define MEDIA_SERVICE "rygel"
+#define RDP_SCHEMA "org.gnome.desktop.remote-desktop.rdp"
+
+typedef struct {
+  CcLumaFixture *model;
+  GCancellable *cancel;
+  GDBusProxy *sharing, *login;
+  GSettings *files, *rdp;
+  guint poll;
+  gboolean files_ok, media_ok;       /* the services exist */
+  gboolean files_read, media_read, rdp_read, login_read, ready;
+} Share;
+
+static GSettings *
+settings_if_installed (const char *id, const char *key)
+{
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = source ? g_settings_schema_source_lookup (source, id, TRUE) : NULL;
+  return schema && g_settings_schema_has_key (schema, key) ? g_settings_new_full (schema, NULL, NULL) : NULL;
+}
+
+static void
+check_ready (Share *s)
+{
+  if (s->ready || !s->files_read || !s->media_read || !s->rdp_read || !s->login_read) return;
+  s->ready = TRUE;
+  cc_luma_live_ready (s->model, ADAPTER);
+}
+
+/* ── File and media sharing ─────────────────────────────────────────── */
+typedef struct { Share *s; const char *key; } Listing;
+
+static void
+networks_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Listing *l = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) out = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) { g_free (l); return; }
+  Share *s = l->s;
+  g_autoptr (GVariant) current = g_dbus_proxy_get_cached_property (s->sharing, "CurrentNetwork");
+  const char *uuid = current && g_variant_is_of_type (current, G_VARIANT_TYPE_STRING) ? g_variant_get_string (current, NULL) : "";
+  gboolean on = FALSE;
+  if (out && *uuid)
+    {
+      g_autoptr (GVariantIter) iter = NULL;
+      const char *net, *name, *carrier;
+      g_variant_get (out, "(a(sss))", &iter);
+      while (g_variant_iter_next (iter, "(&s&s&s)", &net, &name, &carrier))
+        if (g_str_equal (net, uuid)) on = TRUE;
+    }
+  else if (error)
+    g_message ("Settings: sharing networks: %s", error->message);
+  cc_luma_fixture_publish_boolean (s->model, l->key, on);
+  if (g_str_equal (l->key, "fileShare")) s->files_read = TRUE; else s->media_read = TRUE;
+  check_ready (s);
+  g_free (l);
+}
+
+static void
+list_networks (Share *s, const char *service, const char *key)
+{
+  Listing *l = g_new0 (Listing, 1);
+  l->s = s;
+  l->key = key;
+  g_dbus_proxy_call (s->sharing, "ListNetworks", g_variant_new ("(s)", service), G_DBUS_CALL_FLAGS_NONE, -1,
+                     s->cancel, networks_done, l);
+}
+
+static void
+publish_sharing (Share *s)
+{
+  g_autoptr (GVariant) status = s->sharing ? g_dbus_proxy_get_cached_property (s->sharing, "SharingStatus") : NULL;
+  /* Sharing needs a network it may use (GSD_SHARING_STATUS_AVAILABLE = 3). */
+  cc_luma_fixture_publish_boolean (s->model, "share.network", status && g_variant_get_uint32 (status) == 3);
+  cc_luma_fixture_publish_boolean (s->model, "share.files", s->files_ok);
+  cc_luma_fixture_publish_boolean (s->model, "share.media", s->media_ok);
+  if (s->files)
+    {
+      g_autofree char *rule = g_settings_get_string (s->files, "require-password");
+      /* cc-sharing-panel.c file_sharing_get_require_password: only "always". */
+      cc_luma_fixture_publish_boolean (s->model, "fsPass", g_strcmp0 (rule, "always") == 0);
+    }
+  if (s->files_ok) list_networks (s, FILES_SERVICE, "fileShare");
+  else { cc_luma_fixture_publish_boolean (s->model, "fileShare", FALSE); s->files_read = TRUE; }
+  if (s->media_ok) list_networks (s, MEDIA_SERVICE, "media2");
+  else { cc_luma_fixture_publish_boolean (s->model, "media2", FALSE); s->media_read = TRUE; }
+  check_ready (s);
+}
+
+static void
+sharing_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Share *s = data;
+  g_autoptr (GVariant) probe = proxy ? g_dbus_proxy_get_cached_property (proxy, "SharingStatus") : NULL;
+  if (!probe)
+    {
+      /* No sharing service: the rows aren't offered (as the panel hides them). */
+      g_clear_object (&proxy);
+      s->files_ok = s->media_ok = FALSE;
+    }
+  s->sharing = proxy;
+  if (proxy) g_signal_connect_swapped (proxy, "g-properties-changed", G_CALLBACK (publish_sharing), s);
+  publish_sharing (s);
+}
+
+/* ── Remote desktop ──────────────────────────────────────────────────── */
+static void
+rdp_state_thread (GTask *task, gpointer source, gpointer data, GCancellable *cancel)
+{
+  g_task_return_int (task, cc_get_service_state (REMOTE_DESKTOP_SERVICE, G_BUS_TYPE_SESSION));
+}
+
+static void
+rdp_state_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  gssize state = g_task_propagate_int (G_TASK (result), &error);
+  if (error) return;
+  Share *s = data;
+  gboolean enable = s->rdp && g_settings_get_boolean (s->rdp, "enable");
+  cc_luma_fixture_publish_boolean (s->model, "rdShare", enable && state == CC_SERVICE_STATE_ENABLED);
+  cc_luma_fixture_publish_boolean (s->model, "rdCtl", s->rdp && !g_settings_get_boolean (s->rdp, "view-only"));
+  cc_luma_fixture_publish_boolean (s->model, "rd.available", s->rdp && state != CC_SERVICE_STATE_NOT_FOUND);
+  s->rdp_read = TRUE;
+  check_ready (s);
+}
+
+static void
+publish_rdp (Share *s)
+{
+  g_autoptr (GTask) task = g_task_new (NULL, s->cancel, rdp_state_done, s);
+  g_task_run_in_thread (task, rdp_state_thread);
+}
+
+static void
+publish_login (Share *s)
+{
+  g_autofree char *owner = s->login ? g_dbus_proxy_get_name_owner (s->login) : NULL;
+  g_autoptr (GVariant) enabled = owner ? g_dbus_proxy_get_cached_property (s->login, "Enabled") : NULL;
+  cc_luma_fixture_publish_boolean (s->model, "rdLogin", enabled && g_variant_get_boolean (enabled));
+  cc_luma_fixture_publish_boolean (s->model, "rd.login", enabled != NULL);
+  s->login_read = TRUE;
+  check_ready (s);
+}
+
+static void
+login_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Share *s = data;
+  s->login = proxy;
+  if (proxy) g_signal_connect_swapped (proxy, "g-properties-changed", G_CALLBACK (publish_login), s);
+  publish_login (s);
+}
+
+static gboolean
+poll_units (gpointer data)
+{
+  publish_rdp (data);
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+service_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) out = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  if (error) g_message ("Settings: sharing: %s", error->message);
+  publish_sharing (data);
+}
+
+static gboolean
+share_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Share *s = state;
+  GType type = value && JSON_NODE_HOLDS_VALUE (value) ? json_node_get_value_type (value) : G_TYPE_INVALID;
+  if (g_str_equal (key, "rdTab"))
+    {
+      /* Which half of Remote Desktop the page shows; changes nothing. */
+      if (type != G_TYPE_STRING ||
+          (!g_str_equal (json_node_get_string (value), "share") && !g_str_equal (json_node_get_string (value), "login")))
+        goto invalid;
+      cc_luma_fixture_publish_string (s->model, "rdTab", json_node_get_string (value));
+      return TRUE;
+    }
+  if (g_str_equal (key, "fileShare") || g_str_equal (key, "media2"))
+    {
+      /* cc-sharing-networks.c: enable on the current network, or drop it. */
+      const char *service = g_str_equal (key, "fileShare") ? FILES_SERVICE : MEDIA_SERVICE;
+      g_autoptr (GVariant) current = s->sharing ? g_dbus_proxy_get_cached_property (s->sharing, "CurrentNetwork") : NULL;
+      const char *uuid = current && g_variant_is_of_type (current, G_VARIANT_TYPE_STRING) ? g_variant_get_string (current, NULL) : "";
+      if (type != G_TYPE_BOOLEAN) goto invalid;
+      if (!s->sharing || !*uuid)
+        {
+          g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED, "Sharing needs a network");
+          return FALSE;
+        }
+      if (json_node_get_boolean (value))
+        g_dbus_proxy_call (s->sharing, "EnableService", g_variant_new ("(s)", service), G_DBUS_CALL_FLAGS_NONE, -1,
+                           s->cancel, service_done, s);
+      else
+        g_dbus_proxy_call (s->sharing, "DisableService", g_variant_new ("(ss)", service, uuid), G_DBUS_CALL_FLAGS_NONE, -1,
+                           s->cancel, service_done, s);
+      return TRUE;
+    }
+  if (g_str_equal (key, "fsPass"))
+    {
+      if (type != G_TYPE_BOOLEAN || !s->files) goto invalid;
+      if (g_settings_set_string (s->files, "require-password", json_node_get_boolean (value) ? "always" : "never")) return TRUE;
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "The password rule is locked");
+      return FALSE;
+    }
+  if (g_str_equal (key, "rdCtl"))
+    {
+      /* cc-desktop-sharing-page.c binds view-only inverted. */
+      if (type != G_TYPE_BOOLEAN || !s->rdp) goto invalid;
+      if (g_settings_set_boolean (s->rdp, "view-only", !json_node_get_boolean (value))) return TRUE;
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Remote control is locked");
+      return FALSE;
+    }
+  /* Desktop sharing needs credentials and a certificate, remote sign-in an
+   * administrator: both change in GNOME's panel. */
+  return FALSE;
+invalid:
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "%s can’t take that value", key);
+  return FALSE;
+}
+
+static gpointer
+share_start (CcLumaFixture *model)
+{
+  Share *s = g_new0 (Share, 1);
+  g_autofree char *rygel = g_find_program_in_path ("rygel");
+  s->model = model;
+  s->cancel = g_cancellable_new ();
+  s->files = settings_if_installed ("org.gnome.desktop.file-sharing", "require-password");
+  s->rdp = settings_if_installed (RDP_SCHEMA, "enable");
+  s->files_ok = s->files != NULL;
+  s->media_ok = rygel != NULL;
+  const char *owned[] = { "rdTab", "fileShare", "media2", "fsPass", "rdCtl" };
+  for (guint i = 0; i < G_N_ELEMENTS (owned); i++) cc_luma_fixture_own_key (model, owned[i]);
+  cc_luma_fixture_publish_string (model, "rdTab", "share");
+  if (s->files) g_signal_connect_swapped (s->files, "changed", G_CALLBACK (publish_sharing), s);
+  if (s->rdp) g_signal_connect_swapped (s->rdp, "changed", G_CALLBACK (publish_rdp), s);
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SESSION, G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START, NULL,
+                            "org.gnome.SettingsDaemon.Sharing", "/org/gnome/SettingsDaemon/Sharing",
+                            "org.gnome.SettingsDaemon.Sharing", s->cancel, sharing_ready, s);
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_NONE, NULL,
+                            "org.gnome.RemoteDesktop.Configuration", "/org/gnome/RemoteDesktop/Configuration",
+                            "org.gnome.RemoteDesktop.Configuration.Rdp.Server", s->cancel, login_ready, s);
+  publish_rdp (s);
+  s->poll = g_timeout_add_seconds (10, poll_units, s);
+  return s;
+}
+
+static void
+share_stop (gpointer state)
+{
+  Share *s = state;
+  g_cancellable_cancel (s->cancel);
+  g_clear_object (&s->cancel);
+  g_clear_handle_id (&s->poll, g_source_remove);
+  GDBusProxy **proxies[] = { &s->sharing, &s->login };
+  for (guint i = 0; i < G_N_ELEMENTS (proxies); i++)
+    {
+      if (*proxies[i]) g_signal_handlers_disconnect_by_data (*proxies[i], s);
+      g_clear_object (proxies[i]);
+    }
+  if (s->files) g_signal_handlers_disconnect_by_data (s->files, s);
+  if (s->rdp) g_signal_handlers_disconnect_by_data (s->rdp, s);
+  g_clear_object (&s->files);
+  g_clear_object (&s->rdp);
+  g_free (s);
+}
+
+const CcLumaAdapter cc_luma_adapter_sharing = { ADAPTER, pages, share_start, share_write, share_stop };
diff --git a/shell/cc-luma-live-shelf.c b/shell/cc-luma-live-shelf.c
new file mode 100644
index 0000000..c31bab6
--- /dev/null
+++ b/shell/cc-luma-live-shelf.c
@@ -0,0 +1,245 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Shelf: Luma's shell-state keys, the ones panels/dash reads and writes and
+ * the Shell draws from.
+ *   edge   ↔ shelf-edge
+ *   spread ↔ the islands' groups: an arranged shelf (shelf-arrangement) is
+ *            spread when the dock's edge holds more than one group; else
+ *            shelf-group-layout (centered-combined = together)
+ *   joined ↔ shelf-surface-mode (connected = one bar)
+ *   float  ↔ shelf-edge-mode (protruding = attached)
+ *   preset ↔ free = shelf-free-placement; otherwise the preset whose four
+ *            values are the shelf's, or custom
+ * v70's hiding and icon size have no owner (shelf-auto-hide is reserved),
+ * and neither has the Split preset (a clock island on its own edge): those
+ * are not published. */
+#include "cc-luma-live-gsettings.h"
+#include "cc-luma-live-apps.h"
+#include "cc-luma-desktop.h"
+
+#define SCHEMA "org.project_luma.shell-state"
+
+typedef struct {
+  CcLumaFixture *model;
+  GSettings *settings;
+  GSettingsSchema *schema;
+  CcLumaReadyGate *gate;
+  gboolean free_placement;  /* the schema has shelf-free-placement */
+  gboolean arrangement;     /* the schema has shelf-arrangement */
+} Shelf;
+
+static const char * const owned[] = { "edge", "spread", "joined", "float", "preset", NULL };
+
+static gboolean
+has_key (GSettingsSchema *schema, const char *key)
+{
+  return schema && g_settings_schema_has_key (schema, key);
+}
+
+/* Together or spread, as the Shell places the islands. */
+static const char *
+spread_of (Shelf *self)
+{
+  if (self->arrangement)
+    {
+      g_autoptr (GVariant) groups = g_settings_get_value (self->settings, "shelf-arrangement");
+      gsize n = g_variant_n_children (groups);
+      const char *dock_edge = NULL;
+      g_autoptr (GPtrArray) edges = g_ptr_array_new_with_free_func (g_free);
+      for (gsize i = 0; i < n; i++)
+        {
+          g_autoptr (GVariant) group = g_variant_get_child_value (groups, i);
+          g_autoptr (GVariantDict) dict = g_variant_dict_new (group);
+          g_autofree char *edge = NULL;
+          g_autofree char *display = NULL;
+          g_autofree const char **islands = NULL;
+          if (!g_variant_dict_lookup (dict, "edge", "s", &edge)) continue;
+          /* Only the primary display's shelf: the one the page draws. */
+          if (g_variant_dict_lookup (dict, "display", "s", &display) && *display) continue;
+          if (g_variant_dict_lookup (dict, "islands", "^a&s", &islands) && g_strv_contains (islands, "dock"))
+            dock_edge = g_intern_string (edge);
+          g_ptr_array_add (edges, g_steal_pointer (&edge));
+        }
+      if (dock_edge)
+        {
+          guint on_edge = 0;
+          for (guint i = 0; i < edges->len; i++) if (g_str_equal (edges->pdata[i], dock_edge)) on_edge++;
+          return on_edge > 1 ? "spread" : "together";
+        }
+    }
+  g_autofree char *layout = g_settings_get_string (self->settings, "shelf-group-layout");
+  return g_str_equal (layout, "centered-combined") ? "together" : "spread";
+}
+
+static JsonArray *
+catalog (Shelf *self)
+{
+  JsonNode *n = json_object_get_member (cc_luma_fixture_get_data (self->model), "CFPRE");
+  return n && JSON_NODE_HOLDS_ARRAY (n) ? json_node_get_array (n) : NULL;
+}
+
+static void
+publish (Shelf *self)
+{
+  g_autofree char *edge = g_settings_get_string (self->settings, "shelf-edge");
+  g_autofree char *surface = g_settings_get_string (self->settings, "shelf-surface-mode");
+  g_autofree char *mode = g_settings_get_string (self->settings, "shelf-edge-mode");
+  const char *values[4] = { edge, spread_of (self), g_str_equal (surface, "connected") ? "joined" : "separate",
+                            g_str_equal (mode, "protruding") ? "edge" : "floating" };
+  const char *keys[4] = { "edge", "spread", "joined", "float" };
+  for (guint i = 0; i < G_N_ELEMENTS (keys); i++)
+    cc_luma_fixture_publish_string (self->model, keys[i], values[i]);
+  const char *preset = "custom";
+  if (self->free_placement && g_settings_get_boolean (self->settings, "shelf-free-placement"))
+    preset = "free";
+  else
+    {
+      JsonArray *presets = catalog (self);
+      for (guint i = 0; presets && i < json_array_get_length (presets); i++)
+        {
+          JsonArray *entry = json_array_get_array_element (presets, i);
+          const char *id = json_array_get_string_element (entry, 0);
+          JsonObject *map = json_array_get_object_element (entry, 2);
+          gboolean same = !g_str_equal (id, "free");
+          for (guint k = 0; same && k < G_N_ELEMENTS (keys); k++)
+            same = g_strcmp0 (json_object_get_string_member_with_default (map, keys[k], NULL), values[k]) == 0;
+          if (same) { preset = id; break; }
+        }
+    }
+  cc_luma_fixture_publish_string (self->model, "preset", preset);
+}
+
+/* v70's presets the shell-state keys can hold. */
+static void
+publish_catalog (Shelf *self)
+{
+  JsonArray *presets = catalog (self);
+  if (!presets) return;
+  g_autoptr (JsonArray) kept = json_array_new ();
+  for (guint i = 0; i < json_array_get_length (presets); i++)
+    {
+      const char *id = json_array_get_string_element (json_array_get_array_element (presets, i), 0);
+      if (g_str_equal (id, "split") || (g_str_equal (id, "free") && !self->free_placement)) continue;
+      json_array_add_element (kept, json_node_copy (json_array_get_element (presets, i)));
+    }
+  g_autoptr (JsonNode) node = json_node_init_array (json_node_alloc (), kept);
+  cc_luma_fixture_publish_data (self->model, "CFPRE", node);
+}
+
+static gpointer
+shelf_start (CcLumaFixture *model)
+{
+  Shelf *self = g_new0 (Shelf, 1);
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  self->model = g_object_ref (model);
+  self->schema = source ? g_settings_schema_source_lookup (source, SCHEMA, TRUE) : NULL;
+  const char *required[] = { "shelf-edge", "shelf-group-layout", "shelf-surface-mode", "shelf-edge-mode" };
+  gboolean complete = self->schema != NULL;
+  for (guint i = 0; complete && i < G_N_ELEMENTS (required); i++) complete = has_key (self->schema, required[i]);
+  if (complete)
+    {
+      self->settings = g_settings_new_full (self->schema, NULL, NULL);
+      self->free_placement = has_key (self->schema, "shelf-free-placement");
+      self->arrangement = has_key (self->schema, "shelf-arrangement");
+      g_signal_connect_swapped (self->settings, "changed", G_CALLBACK (publish), self);
+      for (guint i = 0; owned[i]; i++) cc_luma_fixture_own_key (model, owned[i]);
+      publish_catalog (self);
+      publish (self);
+    }
+  cc_luma_live_publish_dock (model);
+  cc_luma_live_desk_dump_watch (model);
+  self->gate = cc_luma_ready_gate_new (model, "shelf", cc_luma_shelf_validate);
+  return self;
+}
+
+static gboolean
+set_choice (Shelf *self, const char *key, const char *value, GError **error)
+{
+  g_autoptr (GSettingsSchemaKey) schema_key = g_settings_schema_get_key (self->schema, key);
+  g_autoptr (GVariant) variant = g_variant_ref_sink (g_variant_new_string (value));
+  if (!g_settings_schema_key_range_check (schema_key, variant))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "The shelf can’t take %s here", value);
+      return FALSE;
+    }
+  if (!g_settings_is_writable (self->settings, key))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "%s is locked by policy", key);
+      return FALSE;
+    }
+  return g_settings_set_string (self->settings, key, value);
+}
+
+static gboolean
+shelf_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Shelf *self = state;
+  if (!self->settings || !g_strv_contains (owned, key)) return FALSE;
+  const char *text = JSON_NODE_HOLDS_VALUE (value) && json_node_get_value_type (value) == G_TYPE_STRING ? json_node_get_string (value) : NULL;
+  if (!text)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "%s can’t take that value", key);
+      return FALSE;
+    }
+  if (g_str_equal (key, "edge"))
+    return set_choice (self, "shelf-edge", text, error);
+  if (g_str_equal (key, "joined"))
+    return set_choice (self, "shelf-surface-mode", g_str_equal (text, "joined") ? "connected" : "separate", error);
+  if (g_str_equal (key, "float"))
+    return set_choice (self, "shelf-edge-mode", g_str_equal (text, "edge") ? "protruding" : "floating", error);
+  if (g_str_equal (key, "spread"))
+    {
+      /* Luma's own spread layout where the schema has it. */
+      g_autoptr (GSettingsSchemaKey) layout = g_settings_schema_get_key (self->schema, "shelf-group-layout");
+      g_autoptr (GVariant) luma = g_variant_ref_sink (g_variant_new_string ("luma"));
+      const char *wanted = g_str_equal (text, "together") ? "centered-combined" :
+                           g_settings_schema_key_range_check (layout, luma) ? "luma" : "split-ends";
+      if (!set_choice (self, "shelf-group-layout", wanted, error)) return FALSE;
+      /* Islands arranged by hand hold their own places; choosing how the
+       * islands sit gives the shelf back its default arrangement for the
+       * layout, the way panels/dash's layout choices take effect. */
+      if (self->arrangement && g_str_equal (spread_of (self), text) == FALSE)
+        {
+          if (!g_settings_is_writable (self->settings, "shelf-arrangement"))
+            {
+              g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "The shelf’s arrangement is locked by policy");
+              return FALSE;
+            }
+          g_settings_reset (self->settings, "shelf-arrangement");
+        }
+      return TRUE;
+    }
+  /* preset: only free placement is a key of its own. */
+  if (!self->free_placement)
+    {
+      if (g_str_equal (text, "free"))
+        {
+          g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Free placement isn’t available");
+          return FALSE;
+        }
+      return TRUE;
+    }
+  gboolean free = g_str_equal (text, "free");
+  if (g_settings_get_boolean (self->settings, "shelf-free-placement") == free) return TRUE;
+  if (!g_settings_is_writable (self->settings, "shelf-free-placement"))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Free placement is locked by policy");
+      return FALSE;
+    }
+  return g_settings_set_boolean (self->settings, "shelf-free-placement", free);
+}
+
+static void
+shelf_stop (gpointer state)
+{
+  Shelf *self = state;
+  cc_luma_ready_gate_free (self->gate);
+  if (self->settings) g_signal_handlers_disconnect_by_data (self->settings, self);
+  g_clear_object (&self->settings);
+  g_clear_pointer (&self->schema, g_settings_schema_unref);
+  g_object_unref (self->model);
+  g_free (self);
+}
+
+const CcLumaAdapter cc_luma_adapter_shelf = {
+  "shelf", (const char * const[]) { "shelf", NULL }, shelf_start, shelf_write, shelf_stop
+};
diff --git a/shell/cc-luma-live-sound.c b/shell/cc-luma-live-sound.c
new file mode 100644
index 0000000..70e1f84
--- /dev/null
+++ b/shell/cc-luma-live-sound.c
@@ -0,0 +1,460 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Sound: the GvcMixerControl the sound panel uses (panels/sound): output
+ * devices, output volume, balance and configuration (the device profile),
+ * the input device and its volume, per-app levels from the mixer's
+ * streams (cc-volume-levels-page.c) and the alert sound as
+ * cc-alert-chooser-page.c keeps it. Over-amplification is a GSettings row. */
+#include "config.h"
+#include "cc-luma-live-gsettings.h"
+#include "cc-luma-sound.h"
+#include "cc-luma-discovery.h"
+#include <pulse/pulseaudio.h>
+#include <gvc-mixer-control.h>
+#include <gvc-channel-map-private.h>
+#include <math.h>
+#include <string.h>
+
+#define SOUND_SCHEMA "org.gnome.desktop.sound"
+#define CUSTOM_THEME_NAME "__custom"
+
+typedef struct {
+  CcLumaFixture *model;
+  GvcMixerControl *control;
+  GSettings *sound;
+  GHashTable *outputs, *inputs; /* ui device ids */
+  GPtrArray *watched;
+  guint idle;
+  CcLumaReadyGate *gate;
+} Sound;
+
+static void schedule (Sound *self);
+static void notified (GObject *object, GParamSpec *pspec, Sound *self) { schedule (self); }
+static void map_changed (GvcChannelMap *map, gboolean set, Sound *self) { schedule (self); }
+
+static void
+watch (Sound *self, gpointer object)
+{
+  if (!object) return;
+  for (guint i = 0; i < self->watched->len; i++)
+    if (self->watched->pdata[i] == object) return;
+  g_ptr_array_add (self->watched, g_object_ref (object));
+  g_signal_connect (object, "notify", G_CALLBACK (notified), self);
+  if (GVC_IS_CHANNEL_MAP (object)) g_signal_connect (object, "volume-changed", G_CALLBACK (map_changed), self);
+}
+
+static void
+clear_watches (Sound *self)
+{
+  for (guint i = 0; i < self->watched->len; i++)
+    g_signal_handlers_disconnect_by_data (self->watched->pdata[i], self);
+  g_ptr_array_set_size (self->watched, 0);
+}
+
+static void
+publish_null (Sound *self, const char *key)
+{
+  g_autoptr (JsonNode) none = json_node_init_null (json_node_alloc ());
+  cc_luma_fixture_publish (self->model, key, none);
+}
+
+static gint64
+percent (Sound *self, GvcMixerStream *stream)
+{
+  return (gint64) round (gvc_mixer_stream_get_volume (stream) * 100.0 / gvc_mixer_control_get_vol_max_norm (self->control));
+}
+
+static const char *
+output_icon (GvcMixerUIDevice *device)
+{
+  const char *icon = gvc_mixer_ui_device_get_icon_name (device);
+  if (!icon) return "volume-2";
+  if (strstr (icon, "headphone") || strstr (icon, "headset")) return "headphones";
+  if (strstr (icon, "hdmi") || strstr (icon, "display") || strstr (icon, "video")) return "monitor";
+  if (strstr (icon, "bluetooth")) return "bluetooth";
+  return "volume-2";
+}
+
+/* v70's Configuration is the device's output profile: Stereo or Mono. */
+static const char *
+profile_configuration (const char *profile)
+{
+  if (!profile) return NULL;
+  if (strstr (profile, "surround")) return NULL;
+  if (strstr (profile, "output:") && strstr (profile, "mono")) return "Mono";
+  if (strstr (profile, "stereo")) return "Stereo";
+  return NULL;
+}
+
+/* A stream's app, as the model names apps (CFAPPINFO), by its application
+ * id's last part or its name. No match: the app isn't shown. */
+static char *
+stream_app (Sound *self, GvcMixerStream *stream)
+{
+  const char *candidates[] = { gvc_mixer_stream_get_application_id (stream), gvc_mixer_stream_get_name (stream) };
+  for (guint i = 0; i < G_N_ELEMENTS (candidates); i++)
+    {
+      if (!candidates[i] || !*candidates[i]) continue;
+      const char *last = strrchr (candidates[i], '.');
+      g_autofree char *id = g_ascii_strdown (last && last[1] ? last + 1 : candidates[i], -1);
+      if (cc_luma_app_name (self->model, id)) return g_steal_pointer (&id);
+    }
+  return NULL;
+}
+
+static gboolean
+level_stream (GvcMixerStream *stream)
+{
+  const char *app = gvc_mixer_stream_get_application_id (stream);
+  return !gvc_mixer_stream_is_virtual (stream) && !gvc_mixer_stream_is_event_stream (stream) &&
+         g_strcmp0 (app, "org.gnome.VolumeControl") != 0 && g_strcmp0 (app, "org.PulseAudio.pavucontrol") != 0;
+}
+
+static char *
+alert_name (Sound *self)
+{
+  if (!g_settings_get_boolean (self->sound, "event-sounds")) return g_strdup ("None");
+  g_autofree char *theme = g_settings_get_string (self->sound, "theme-name");
+  if (g_strcmp0 (theme, CUSTOM_THEME_NAME) != 0) return g_strdup ("Default");
+  g_autofree char *link = g_build_filename (g_get_user_data_dir (), "sounds", CUSTOM_THEME_NAME, "bell-terminal.ogg", NULL);
+  g_autofree char *target = g_file_read_link (link, NULL);
+  g_autofree char *base = target ? g_path_get_basename (target) : NULL;
+  const char *names[] = { "click", "Click", "hum", "Hum", "string", "String", "swing", "Swing" };
+  for (guint i = 0; base && i < G_N_ELEMENTS (names); i += 2)
+    {
+      g_autofree char *file = g_strconcat (names[i], ".ogg", NULL);
+      if (g_str_equal (base, file)) return g_strdup (names[i + 1]);
+    }
+  return NULL;
+}
+
+static gint
+by_id (gconstpointer a, gconstpointer b)
+{
+  return (gint) GPOINTER_TO_UINT (a) - (gint) GPOINTER_TO_UINT (b);
+}
+
+static void
+publish_devices (Sound *self, const char *name, GHashTable *set,
+                 GvcMixerUIDevice *(*lookup) (GvcMixerControl *, guint), gboolean output)
+{
+  JsonArray *devices = json_array_new ();
+  g_autoptr (GList) ids = g_hash_table_get_keys (set);
+  ids = g_list_sort (ids, by_id);
+  for (GList *l = ids; l; l = l->next)
+    {
+      GvcMixerUIDevice *device = lookup (self->control, GPOINTER_TO_UINT (l->data));
+      const char *description = device ? gvc_mixer_ui_device_get_description (device) : NULL;
+      const char *origin = device ? gvc_mixer_ui_device_get_origin (device) : NULL;
+      if (!description || !*description) continue;
+      JsonObject *item = json_object_new ();
+      g_autofree char *id = g_strdup_printf ("%u", gvc_mixer_ui_device_get_id (device));
+      json_object_set_string_member (item, "id", id);
+      json_object_set_string_member (item, "n", description);
+      json_object_set_string_member (item, "s", origin && *origin ? origin : description);
+      json_object_set_string_member (item, "i", output ? output_icon (device) : "mic");
+      json_array_add_object_element (devices, item);
+    }
+  g_autoptr (JsonNode) list = json_node_init_array (json_node_alloc (), devices);
+  json_array_unref (devices);
+  cc_luma_fixture_publish_data (self->model, name, list);
+}
+
+static gboolean
+publish (gpointer data)
+{
+  Sound *self = data;
+  self->idle = 0;
+  if (gvc_mixer_control_get_state (self->control) != GVC_STATE_READY) return G_SOURCE_REMOVE;
+  clear_watches (self);
+
+  /* Outputs and microphones, as the panel's device rows list them. */
+  publish_devices (self, "CFOUT", self->outputs, gvc_mixer_control_lookup_output_id, TRUE);
+  publish_devices (self, "CFIN", self->inputs, gvc_mixer_control_lookup_input_id, FALSE);
+
+  GvcMixerStream *sink = gvc_mixer_control_get_default_sink (self->control);
+  GvcMixerUIDevice *output = sink ? gvc_mixer_control_lookup_device_from_stream (self->control, sink) : NULL;
+  if (output)
+    {
+      g_autofree char *id = g_strdup_printf ("%u", gvc_mixer_ui_device_get_id (output));
+      cc_luma_fixture_publish_string (self->model, "out", id);
+      const char *configuration = profile_configuration (gvc_mixer_ui_device_get_active_profile (output));
+      if (configuration) cc_luma_fixture_publish_string (self->model, "cfg", configuration);
+      else publish_null (self, "cfg");
+      watch (self, output);
+    }
+  else
+    publish_null (self, "out"), publish_null (self, "cfg");
+  if (sink)
+    {
+      const GvcChannelMap *map = gvc_mixer_stream_get_channel_map (sink);
+      const double *volumes = map ? gvc_channel_map_get_volume ((GvcChannelMap *) map) : NULL;
+      cc_luma_fixture_publish_int (self->model, "vol", percent (self, sink));
+      cc_luma_fixture_publish_int (self->model, "bal", volumes ? (gint64) round (volumes[BALANCE] * 100) : 0);
+      watch (self, sink);
+      watch (self, (gpointer) map);
+    }
+  else
+    publish_null (self, "vol"), publish_null (self, "bal");
+
+  GvcMixerStream *source = gvc_mixer_control_get_default_source (self->control);
+  GvcMixerUIDevice *input = source ? gvc_mixer_control_lookup_device_from_stream (self->control, source) : NULL;
+  if (input)
+    {
+      g_autofree char *id = g_strdup_printf ("%u", gvc_mixer_ui_device_get_id (input));
+      cc_luma_fixture_publish_string (self->model, "inDev", id);
+    }
+  else publish_null (self, "inDev");
+  if (source) cc_luma_fixture_publish_int (self->model, "inVol", percent (self, source)), watch (self, source);
+  else publish_null (self, "inVol");
+
+  /* Per-app levels: system sounds and the apps playing now. */
+  JsonObject *levels = json_object_new ();
+  GvcMixerStream *events = gvc_mixer_control_get_event_sink_input (self->control);
+  if (events) json_object_set_int_member (levels, "system", percent (self, events)), watch (self, events);
+  g_autoptr (GSList) inputs = gvc_mixer_control_get_sink_inputs (self->control);
+  for (GSList *l = inputs; l; l = l->next)
+    {
+      if (!level_stream (l->data)) continue;
+      g_autofree char *app = stream_app (self, l->data);
+      if (!app || json_object_has_member (levels, app)) continue;
+      json_object_set_int_member (levels, app, percent (self, l->data));
+      watch (self, l->data);
+    }
+  g_autoptr (JsonNode) level_node = json_node_init_object (json_node_alloc (), levels);
+  json_object_unref (levels);
+  cc_luma_fixture_publish (self->model, "lv", level_node);
+  /* Level keys are the apps playing now. */
+  GList *members = json_object_get_members (json_node_get_object (level_node));
+  for (GList *m = members; m; m = m->next)
+    {
+      g_autofree char *key = g_strconcat ("lv.", (char *) m->data, NULL);
+      cc_luma_fixture_own_key (self->model, key);
+    }
+  g_list_free (members);
+
+  g_autofree char *alert = alert_name (self);
+  if (alert) cc_luma_fixture_publish_string (self->model, "alert", alert);
+  else publish_null (self, "alert");
+  return G_SOURCE_REMOVE;
+}
+
+static void
+schedule (Sound *self)
+{
+  if (!self->idle) self->idle = g_idle_add (publish, self);
+}
+
+static void control_changed (GvcMixerControl *control, guint id, Sound *self) { schedule (self); }
+static void output_added (GvcMixerControl *control, guint id, Sound *self) { g_hash_table_add (self->outputs, GUINT_TO_POINTER (id)); schedule (self); }
+static void output_removed (GvcMixerControl *control, guint id, Sound *self) { g_hash_table_remove (self->outputs, GUINT_TO_POINTER (id)); schedule (self); }
+static void input_added (GvcMixerControl *control, guint id, Sound *self) { g_hash_table_add (self->inputs, GUINT_TO_POINTER (id)); schedule (self); }
+static void input_removed (GvcMixerControl *control, guint id, Sound *self) { g_hash_table_remove (self->inputs, GUINT_TO_POINTER (id)); schedule (self); }
+static void state_changed (GvcMixerControl *control, guint state, Sound *self) { schedule (self); }
+static void sound_changed (GSettings *settings, const char *key, Sound *self) { schedule (self); }
+
+static gpointer
+sound_start (CcLumaFixture *model)
+{
+  Sound *self = g_new0 (Sound, 1);
+  self->model = g_object_ref (model);
+  self->outputs = g_hash_table_new (g_direct_hash, g_direct_equal);
+  self->inputs = g_hash_table_new (g_direct_hash, g_direct_equal);
+  self->watched = g_ptr_array_new_with_free_func (g_object_unref);
+  self->sound = g_settings_new (SOUND_SCHEMA);
+  g_signal_connect (self->sound, "changed", G_CALLBACK (sound_changed), self);
+  const char *keys[] = { "out", "vol", "bal", "cfg", "inDev", "inVol", "alert" };
+  for (guint i = 0; i < G_N_ELEMENTS (keys); i++) cc_luma_fixture_own_key (model, keys[i]);
+  self->control = gvc_mixer_control_new ("Luma Settings");
+  g_signal_connect (self->control, "state-changed", G_CALLBACK (state_changed), self);
+  g_signal_connect (self->control, "output-added", G_CALLBACK (output_added), self);
+  g_signal_connect (self->control, "output-removed", G_CALLBACK (output_removed), self);
+  g_signal_connect (self->control, "input-added", G_CALLBACK (input_added), self);
+  g_signal_connect (self->control, "input-removed", G_CALLBACK (input_removed), self);
+  const char *events[] = { "stream-added", "stream-removed", "stream-changed", "default-sink-changed",
+                           "default-source-changed", "active-output-update", "active-input-update" };
+  for (guint i = 0; i < G_N_ELEMENTS (events); i++)
+    g_signal_connect (self->control, events[i], G_CALLBACK (control_changed), self);
+  gvc_mixer_control_open (self->control);
+  self->gate = cc_luma_ready_gate_new (model, "sound", cc_luma_sound_validate);
+  return self;
+}
+
+static gboolean
+refuse (GError **error, const char *message)
+{
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, message);
+  return FALSE;
+}
+
+/* The volume slider's write (cc-volume-slider.c): unmute, set, push. */
+static gboolean
+set_level (Sound *self, GvcMixerStream *stream, JsonNode *value, double high, GError **error)
+{
+  if (!stream || !value || !JSON_NODE_HOLDS_VALUE (value)) return refuse (error, "That sound isn’t playing now");
+  double level = json_node_get_double (value);
+  if (!isfinite (level) || level < 0 || level > high) return refuse (error, "Volume out of range");
+  if (gvc_mixer_stream_get_is_muted (stream) && level > 0) gvc_mixer_stream_change_is_muted (stream, FALSE);
+  if (gvc_mixer_stream_set_volume (stream, (pa_volume_t) round (level / 100 * gvc_mixer_control_get_vol_max_norm (self->control))))
+    gvc_mixer_stream_push_volume (stream);
+  return TRUE;
+}
+
+static void
+link_alert (const char *alert, const char *name)
+{
+  g_autofree char *file = g_strconcat (name, ".ogg", NULL);
+  g_autofree char *target = NULL;
+  for (const char * const *dir = g_get_system_data_dirs (); *dir && !target; dir++)
+    {
+      g_autofree char *path = g_build_filename (*dir, "sounds", "gnome", "default", "alerts", file, NULL);
+      if (g_file_test (path, G_FILE_TEST_EXISTS)) target = g_steal_pointer (&path);
+    }
+  g_autofree char *source_file = g_strconcat (alert, ".ogg", NULL);
+  g_autofree char *source = g_build_filename (g_get_user_data_dir (), "sounds", CUSTOM_THEME_NAME, source_file, NULL);
+  g_autoptr (GFile) link = g_file_new_for_path (source);
+  g_file_delete (link, NULL, NULL);
+  if (target) g_file_make_symbolic_link (link, target, NULL, NULL);
+}
+
+static void
+touch (const char *path)
+{
+  g_autoptr (GFile) file = g_file_new_for_path (path);
+  g_autoptr (GDateTime) now = g_date_time_new_now_utc ();
+  g_file_set_attribute_uint64 (file, G_FILE_ATTRIBUTE_TIME_MODIFIED, g_date_time_to_unix (now), G_FILE_QUERY_INFO_NONE, NULL, NULL);
+}
+
+/* cc-alert-chooser-page.c's set_custom_theme, for one of GNOME's alerts. */
+static gboolean
+set_alert (Sound *self, const char *alert, GError **error)
+{
+  if (g_strcmp0 (alert, "None") == 0) return g_settings_set_boolean (self->sound, "event-sounds", FALSE);
+  if (g_strcmp0 (alert, "Default") == 0)
+    {
+      g_settings_reset (self->sound, "theme-name");
+      return g_settings_set_boolean (self->sound, "event-sounds", TRUE);
+    }
+  const char *names[] = { "Click", "Hum", "String", "Swing" };
+  g_autofree char *name = NULL;
+  for (guint i = 0; i < G_N_ELEMENTS (names); i++)
+    if (g_strcmp0 (alert, names[i]) == 0) name = g_ascii_strdown (names[i], -1);
+  if (!name) return refuse (error, "Unknown alert sound");
+  g_autofree char *dir = g_build_filename (g_get_user_data_dir (), "sounds", CUSTOM_THEME_NAME, NULL);
+  g_autofree char *index = g_build_filename (dir, "index.theme", NULL);
+  g_autofree char *sounds = g_build_filename (g_get_user_data_dir (), "sounds", NULL);
+  g_autoptr (GKeyFile) theme = g_key_file_new ();
+  g_autoptr (GVariant) inherits = g_settings_get_default_value (self->sound, "theme-name");
+  g_mkdir_with_parents (dir, USER_DIR_MODE);
+  g_key_file_load_from_file (theme, index, G_KEY_FILE_KEEP_COMMENTS, NULL);
+  g_key_file_set_string (theme, "Sound Theme", "Name", "Custom");
+  if (inherits) g_key_file_set_string (theme, "Sound Theme", "Inherits", g_variant_get_string (inherits, NULL));
+  g_key_file_set_string (theme, "Sound Theme", "Directories", ".");
+  if (!g_key_file_save_to_file (theme, index, error)) return FALSE;
+  link_alert ("bell-terminal", name);
+  link_alert ("bell-window-system", name);
+  touch (sounds);
+  touch (dir);
+  g_settings_set_boolean (self->sound, "event-sounds", TRUE);
+  return g_settings_set_string (self->sound, "theme-name", CUSTOM_THEME_NAME);
+}
+
+static gboolean
+sound_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Sound *self = state;
+  if (gvc_mixer_control_get_state (self->control) != GVC_STATE_READY &&
+      (g_str_equal (key, "out") || g_str_equal (key, "vol") || g_str_equal (key, "bal") || g_str_equal (key, "cfg") ||
+       g_str_equal (key, "inDev") || g_str_equal (key, "inVol") || g_str_has_prefix (key, "lv.")))
+    return refuse (error, "The sound service isn’t connected");
+  const char *text = value && JSON_NODE_HOLDS_VALUE (value) && json_node_get_value_type (value) == G_TYPE_STRING ? json_node_get_string (value) : NULL;
+  GvcMixerStream *sink = gvc_mixer_control_get_default_sink (self->control);
+  if (g_str_equal (key, "out"))
+    {
+      char *end = NULL;
+      guint64 id = text ? g_ascii_strtoull (text, &end, 10) : 0;
+      GvcMixerUIDevice *device = text && !*end && g_hash_table_contains (self->outputs, GUINT_TO_POINTER ((guint) id)) ?
+        gvc_mixer_control_lookup_output_id (self->control, (guint) id) : NULL;
+      if (!device) return refuse (error, "That output isn’t connected");
+      gvc_mixer_control_change_output (self->control, device);
+      return TRUE;
+    }
+  if (g_str_equal (key, "vol"))
+    return set_level (self, sink, value, g_settings_get_boolean (self->sound, "allow-volume-above-100-percent") ? 150 : 100, error);
+  if (g_str_equal (key, "inVol"))
+    return set_level (self, gvc_mixer_control_get_default_source (self->control), value, 100, error);
+  if (g_str_equal (key, "bal"))
+    {
+      GvcChannelMap *map = sink ? (GvcChannelMap *) gvc_mixer_stream_get_channel_map (sink) : NULL;
+      double balance = value && JSON_NODE_HOLDS_VALUE (value) ? json_node_get_double (value) / 100 : NAN;
+      if (!map || !gvc_channel_map_can_balance (map)) return refuse (error, "This output has no balance");
+      if (!isfinite (balance) || balance < -1 || balance > 1) return refuse (error, "Balance out of range");
+      /* cc-balance-slider.c */
+      pa_cvolume volume = *gvc_channel_map_get_cvolume (map);
+      pa_cvolume_set_balance (&volume, gvc_channel_map_get_pa_channel_map (map), balance);
+      gvc_channel_map_volume_changed (map, &volume, TRUE);
+      return TRUE;
+    }
+  if (g_str_equal (key, "cfg"))
+    {
+      GvcMixerUIDevice *device = sink ? gvc_mixer_control_lookup_device_from_stream (self->control, sink) : NULL;
+      for (GList *l = device ? gvc_mixer_ui_device_get_profiles (device) : NULL; l; l = l->next)
+        {
+          GvcMixerCardProfile *profile = l->data;
+          if (g_strcmp0 (profile_configuration (profile->profile), text) != 0) continue;
+          /* cc-profile-combo-row.c */
+          if (!gvc_mixer_control_change_profile_on_selected_device (self->control, device, profile->profile))
+            return refuse (error, "The output refused that configuration");
+          return TRUE;
+        }
+      return refuse (error, "This output has no such configuration");
+    }
+  if (g_str_equal (key, "inDev"))
+    {
+      char *end = NULL;
+      guint64 id = text ? g_ascii_strtoull (text, &end, 10) : 0;
+      GvcMixerUIDevice *device = text && !*end && g_hash_table_contains (self->inputs, GUINT_TO_POINTER ((guint) id)) ?
+        gvc_mixer_control_lookup_input_id (self->control, (guint) id) : NULL;
+      if (!device) return refuse (error, "That microphone isn’t connected");
+      gvc_mixer_control_change_input (self->control, device);
+      return TRUE;
+    }
+  if (g_str_has_prefix (key, "lv."))
+    {
+      const char *app = key + 3;
+      if (g_str_equal (app, "system"))
+        return set_level (self, gvc_mixer_control_get_event_sink_input (self->control), value, 100, error);
+      g_autoptr (GSList) inputs = gvc_mixer_control_get_sink_inputs (self->control);
+      for (GSList *l = inputs; l; l = l->next)
+        {
+          g_autofree char *id = level_stream (l->data) ? stream_app (self, l->data) : NULL;
+          if (g_strcmp0 (id, app) == 0) return set_level (self, l->data, value, 100, error);
+        }
+      return refuse (error, "That app isn’t playing now");
+    }
+  if (g_str_equal (key, "alert"))
+    return set_alert (self, text, error);
+  return FALSE;
+}
+
+static void
+sound_stop (gpointer state)
+{
+  Sound *self = state;
+  if (self->idle) g_source_remove (self->idle);
+  cc_luma_ready_gate_free (self->gate);
+  clear_watches (self);
+  g_ptr_array_unref (self->watched);
+  g_signal_handlers_disconnect_by_data (self->sound, self);
+  g_object_unref (self->sound);
+  g_signal_handlers_disconnect_by_data (self->control, self);
+  gvc_mixer_control_close (self->control);
+  g_object_unref (self->control);
+  g_hash_table_unref (self->outputs);
+  g_hash_table_unref (self->inputs);
+  g_object_unref (self->model);
+  g_free (self);
+}
+
+const CcLumaAdapter cc_luma_adapter_sound = {
+  "sound", (const char * const[]) { "sound", "sound-levels", "sound-alert", NULL }, sound_start, sound_write, sound_stop
+};
diff --git a/shell/cc-luma-live-system.c b/shell/cc-luma-live-system.c
new file mode 100644
index 0000000..7921671
--- /dev/null
+++ b/shell/cc-luma-live-system.c
@@ -0,0 +1,448 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live About and Secure Shell, from the owners panels/system reads:
+ * hostnamed (device name, model, firmware, kernel), os-release, the about
+ * page's CPU / memory / disk readers (cc-system-details-window.c), the
+ * session's renderer and switcheroo-control for graphics, and sshd.service
+ * through cc-systemd-service.c behind the Secure Shell page's polkit
+ * permission. The device name is written by cc-hostname.c, as the about
+ * page's name row does. Slow readers run on a worker thread. */
+#include "cc-luma-live.h"
+#include "cc-luma-live-admin.h"
+#include "panels/common/cc-hostname.h"
+#include "panels/system/cc-systemd-service.h"
+#include <polkit/polkit.h>
+
+/* The about page's readers (panels/system/about/cc-system-details-window.c). */
+char *get_cpu_info (void);
+char *get_os_name (void);
+guint64 get_ram_size_dmi (void);
+guint64 get_ram_size_libgtop (void);
+char *get_primary_disk_info (void);
+char *info_cleanup (const char *input);
+
+/* ── About: hostnamed + facts ──────────────────────────────────────────── */
+static const char * const about_pages[] = { "about", "about-sys", "ssh", "sharing", NULL };
+
+typedef struct {
+  CcLumaFixture *model;
+  GCancellable *cancel;
+  GDBusProxy *hostnamed, *session, *switcheroo;
+  guint pending;        /* proxies and facts still to report */
+  gboolean ready;
+} About;
+
+typedef struct { char *cpu, *os, *disk, *build; guint64 ram, fs_size, fs_used; } Facts;
+
+static char *
+prop (GDBusProxy *proxy, const char *name)
+{
+  g_autoptr (GVariant) v = proxy ? g_dbus_proxy_get_cached_property (proxy, name) : NULL;
+  return v && g_variant_is_of_type (v, G_VARIANT_TYPE_STRING) ? g_strstrip (g_variant_dup_string (v, NULL)) : g_strdup ("");
+}
+
+static void
+about_check_ready (About *a)
+{
+  if (a->pending || a->ready || !a->hostnamed) return;
+  a->ready = TRUE;
+  cc_luma_live_ready (a->model, "about");
+}
+
+static void
+publish_host (About *a)
+{
+  g_autofree char *pretty = prop (a->hostnamed, "PrettyHostname");
+  g_autofree char *stat = prop (a->hostnamed, "StaticHostname");
+  g_autofree char *host = prop (a->hostnamed, "Hostname");
+  g_autofree char *vendor = prop (a->hostnamed, "HardwareVendor");
+  g_autofree char *model = prop (a->hostnamed, "HardwareModel");
+  g_autofree char *fw = prop (a->hostnamed, "FirmwareVersion");
+  g_autofree char *kname = prop (a->hostnamed, "KernelName");
+  g_autofree char *krel = prop (a->hostnamed, "KernelRelease");
+  if (!*stat) g_set_str (&stat, host);
+  /* cc_hostname_get_display_hostname: the pretty name, else the host name. */
+  cc_luma_fixture_publish_string (a->model, "devName", *pretty ? pretty : host);
+  cc_luma_fixture_publish_string (a->model, "sys.host", stat);
+  cc_luma_fixture_publish_string (a->model, "sys.user", g_get_user_name ());
+  /* get_hardware_model_string: vendor and model, both or nothing. */
+  g_autofree char *hw = *vendor && *model ? g_strdup_printf ("%s %s", vendor, model) : g_strdup ("");
+  cc_luma_fixture_publish_string (a->model, "sys.model", hw);
+  cc_luma_fixture_publish_string (a->model, "sys.fw", fw);
+  g_autofree char *kernel = *kname && *krel ? g_strdup_printf ("%s %s", kname, krel) : g_strdup ("");
+  cc_luma_fixture_publish_string (a->model, "sys.kernel", kernel);
+}
+
+static void
+publish_graphics (About *a)
+{
+  g_autoptr (GString) all = g_string_new (NULL);
+  g_autoptr (GVariant) gpus = a->switcheroo ? g_dbus_proxy_get_cached_property (a->switcheroo, "GPUs") : NULL;
+  g_autoptr (GVariant) renderer = a->session ? g_dbus_proxy_get_cached_property (a->session, "Renderer") : NULL;
+  g_autofree char *main = renderer && g_variant_is_of_type (renderer, G_VARIANT_TYPE_STRING) &&
+                          *g_variant_get_string (renderer, NULL) ? info_cleanup (g_variant_get_string (renderer, NULL)) : NULL;
+  /* The default GPU renders the session; others are listed by name. */
+  if (main) g_string_append (all, main);
+  for (gsize i = 0; gpus && g_variant_is_of_type (gpus, G_VARIANT_TYPE ("aa{sv}")) && i < g_variant_n_children (gpus); i++)
+    {
+      g_autoptr (GVariant) gpu = g_variant_get_child_value (gpus, i);
+      const char *name = NULL;
+      gboolean is_default = FALSE;
+      g_variant_lookup (gpu, "Name", "&s", &name);
+      g_variant_lookup (gpu, "Default", "b", &is_default);
+      if (!name || (is_default && main)) continue;
+      if (all->len) g_string_append (all, " · ");
+      g_string_append (all, name);
+    }
+  cc_luma_fixture_publish_string (a->model, "sys.gpu", all->str);
+}
+
+static void
+host_changed (About *a)
+{
+  publish_host (a);
+}
+
+static void
+proxy_done (About *a)
+{
+  a->pending--;
+  about_check_ready (a);
+}
+
+static void
+hostnamed_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  About *a = data;
+  if (!proxy) { g_warning ("Settings: hostnamed: %s", error->message); return; }
+  g_autoptr (GVariant) probe = g_dbus_proxy_get_cached_property (proxy, "Hostname");
+  if (!probe) { g_object_unref (proxy); return; } /* not running: pages stay with their panels */
+  a->hostnamed = proxy;
+  g_signal_connect_swapped (proxy, "g-properties-changed", G_CALLBACK (host_changed), a);
+  publish_host (a);
+  about_check_ready (a); /* hostnamed gates readiness; it isn't counted in pending */
+}
+
+static void
+graphics_ready (GObject *source, GAsyncResult *result, gpointer data, GDBusProxy **slot)
+{
+  g_autoptr (GError) error = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  About *a = data;
+  *slot = proxy;
+  if (proxy) g_signal_connect_swapped (proxy, "g-properties-changed", G_CALLBACK (publish_graphics), a);
+  publish_graphics (a);
+  proxy_done (a);
+}
+static void session_ready (GObject *s, GAsyncResult *r, gpointer d) { graphics_ready (s, r, d, &((About *) d)->session); }
+static void switcheroo_ready (GObject *s, GAsyncResult *r, gpointer d) { graphics_ready (s, r, d, &((About *) d)->switcheroo); }
+
+static void
+facts_free (Facts *f)
+{
+  g_free (f->cpu);
+  g_free (f->os);
+  g_free (f->disk);
+  g_free (f->build);
+  g_free (f);
+}
+
+static void
+facts_thread (GTask *task, gpointer source, gpointer data, GCancellable *cancel)
+{
+  Facts *f = g_new0 (Facts, 1);
+  f->cpu = get_cpu_info ();
+  f->os = get_os_name ();
+  f->ram = get_ram_size_dmi ();
+  if (!f->ram) f->ram = get_ram_size_libgtop ();
+  f->disk = get_primary_disk_info ();
+  /* get_os_image_version: IMAGE_VERSION, else BUILD_ID. */
+  f->build = g_get_os_info ("IMAGE_VERSION");
+  if (!f->build || !*f->build) { g_free (f->build); f->build = g_get_os_info ("BUILD_ID"); }
+  /* The home file system (on an image system, the disk's data part). */
+  g_autoptr (GFile) home = g_file_new_for_path (g_get_home_dir ());
+  g_autoptr (GFileInfo) fs = g_file_query_filesystem_info (home, G_FILE_ATTRIBUTE_FILESYSTEM_SIZE "," G_FILE_ATTRIBUTE_FILESYSTEM_USED, cancel, NULL);
+  if (fs)
+    {
+      f->fs_size = g_file_info_get_attribute_uint64 (fs, G_FILE_ATTRIBUTE_FILESYSTEM_SIZE);
+      f->fs_used = g_file_info_get_attribute_uint64 (fs, G_FILE_ATTRIBUTE_FILESYSTEM_USED);
+    }
+  g_task_return_pointer (task, f, (GDestroyNotify) facts_free);
+}
+
+static void
+facts_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  Facts *f = g_task_propagate_pointer (G_TASK (result), &error);
+  if (!f) return; /* cancelled */
+  About *a = data;
+  g_autofree char *ram = f->ram ? g_format_size_full (f->ram, G_FORMAT_SIZE_IEC_UNITS) : g_strdup ("");
+  cc_luma_fixture_publish_string (a->model, "sys.cpu", f->cpu ? f->cpu : "");
+  cc_luma_fixture_publish_string (a->model, "sys.os", f->os ? f->os : "");
+  cc_luma_fixture_publish_string (a->model, "sys.build", f->build ? f->build : "");
+  cc_luma_fixture_publish_string (a->model, "sys.mem", ram);
+  cc_luma_fixture_publish_string (a->model, "sys.disk", f->disk ? f->disk : "");
+  if (f->fs_size)
+    {
+      g_autofree char *used = g_format_size (f->fs_used), *size = g_format_size (f->fs_size);
+      g_autofree char *line = g_strdup_printf ("%s used of %s", used, size);
+      cc_luma_fixture_publish_string (a->model, "sys.storage", line);
+    }
+  else
+    cc_luma_fixture_publish_string (a->model, "sys.storage", "");
+  facts_free (f);
+  proxy_done (a);
+}
+
+static void
+set_name_thread (GTask *task, gpointer source, gpointer data, GCancellable *cancel)
+{
+  cc_hostname_set_hostname (CC_HOSTNAME (source), data);
+  g_task_return_boolean (task, TRUE);
+}
+
+#define HOSTNAME_PERMISSION "org.freedesktop.hostname1.set-static-hostname"
+
+typedef struct { About *a; char *name; } NameJob;
+static void
+name_job_free (NameJob *job)
+{
+  g_free (job->name);
+  g_free (job);
+}
+
+static void
+run_rename (gpointer data)
+{
+  NameJob *job = data;
+  g_autoptr (GTask) task = g_task_new (cc_hostname_get_default (), job->a->cancel, NULL, NULL);
+  g_task_set_task_data (task, g_strdup (job->name), g_free);
+  g_task_run_in_thread (task, set_name_thread);
+}
+
+static void
+rename_denied (gpointer data)
+{
+  NameJob *job = data;
+  publish_host (job->a); /* show the name the system kept */
+}
+
+static gboolean
+about_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  About *a = state;
+  if (!g_str_equal (key, "devName")) return FALSE;
+  if (!value || !JSON_NODE_HOLDS_VALUE (value) || json_node_get_value_type (value) != G_TYPE_STRING)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Type a name");
+      return FALSE;
+    }
+  g_autofree char *name = g_strstrip (g_strdup (json_node_get_string (value)));
+  /* hostnamed takes at most 64 characters for the pretty name's host form. */
+  if (!*name || g_utf8_strlen (name, -1) > 64)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Use 1 to 64 characters");
+      return FALSE;
+    }
+  /* hostnamed asks for an administrator: unlock with its polkit action (as
+   * the About panel's name dialog is allowed to), then the panel's
+   * cc_hostname_set_hostname, off the main thread. */
+  NameJob *job = g_new0 (NameJob, 1);
+  job->a = a;
+  job->name = g_steal_pointer (&name);
+  cc_luma_live_as_admin (HOSTNAME_PERMISSION, a->cancel, run_rename, rename_denied, job, (GDestroyNotify) name_job_free);
+  return TRUE;
+}
+
+static gpointer
+about_start (CcLumaFixture *model)
+{
+  About *a = g_new0 (About, 1);
+  a->model = model;
+  a->cancel = g_cancellable_new ();
+  a->pending = 3; /* session, switcheroo, facts (hostnamed gates separately) */
+  cc_luma_fixture_own_key (model, "devName");
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_NONE, NULL, "org.freedesktop.hostname1",
+                            "/org/freedesktop/hostname1", "org.freedesktop.hostname1", a->cancel, hostnamed_ready, a);
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SESSION, G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START, NULL, "org.gnome.SessionManager",
+                            "/org/gnome/SessionManager", "org.gnome.SessionManager", a->cancel, session_ready, a);
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START, NULL, "net.hadess.SwitcherooControl",
+                            "/net/hadess/SwitcherooControl", "net.hadess.SwitcherooControl", a->cancel, switcheroo_ready, a);
+  /* cc_hostname_get_default keeps its object in the shell's storage (main thread). */
+  (void) cc_hostname_get_default ();
+  g_autoptr (GTask) task = g_task_new (NULL, a->cancel, facts_done, a);
+  g_task_run_in_thread (task, facts_thread);
+  return a;
+}
+
+static void
+about_stop (gpointer state)
+{
+  About *a = state;
+  g_cancellable_cancel (a->cancel);
+  g_clear_object (&a->cancel);
+  GDBusProxy **proxies[] = { &a->hostnamed, &a->session, &a->switcheroo };
+  for (guint i = 0; i < G_N_ELEMENTS (proxies); i++)
+    {
+      if (*proxies[i]) g_signal_handlers_disconnect_by_data (*proxies[i], a);
+      g_clear_object (proxies[i]);
+    }
+  g_free (a);
+}
+
+const CcLumaAdapter cc_luma_adapter_about = { "about", about_pages, about_start, about_write, about_stop };
+
+/* ── Secure Shell: sshd.service ───────────────────────────────────────── */
+#define SSHD_SERVICE "sshd.service"
+#define SSH_PERMISSION "org.gnome.controlcenter.remote-login-helper"
+static const char * const ssh_pages[] = { "ssh", "sharing", NULL };
+
+typedef struct {
+  CcLumaFixture *model;
+  GCancellable *cancel;
+  guint poll;
+  gboolean ready;
+} Ssh;
+
+static void
+state_thread (GTask *task, gpointer source, gpointer data, GCancellable *cancel)
+{
+  g_task_return_int (task, cc_get_service_state (SSHD_SERVICE, G_BUS_TYPE_SYSTEM));
+}
+
+static void
+state_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  gssize state = g_task_propagate_int (G_TASK (result), &error);
+  if (error) return;
+  Ssh *s = data;
+  /* Not installed: the page stays with its panel (which hides the row too). */
+  if (state == CC_SERVICE_STATE_NOT_FOUND) return;
+  cc_luma_fixture_publish_boolean (s->model, "ssh", state == CC_SERVICE_STATE_ENABLED);
+  if (!s->ready) { s->ready = TRUE; cc_luma_live_ready (s->model, "ssh"); }
+}
+
+static void
+ssh_read (Ssh *s)
+{
+  g_autoptr (GTask) task = g_task_new (NULL, s->cancel, state_done, s);
+  g_task_run_in_thread (task, state_thread);
+}
+
+/* The unit changes outside Settings too (systemctl); follow it slowly. */
+static gboolean
+ssh_poll (gpointer data)
+{
+  ssh_read (data);
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+apply_thread (GTask *task, gpointer source, gpointer data, GCancellable *cancel)
+{
+  g_autoptr (GError) error = NULL;
+  gboolean on = GPOINTER_TO_INT (data);
+  if (on ? cc_enable_service (SSHD_SERVICE, G_BUS_TYPE_SYSTEM, &error)
+         : cc_disable_service (SSHD_SERVICE, G_BUS_TYPE_SYSTEM, &error))
+    g_task_return_boolean (task, TRUE);
+  else
+    g_task_return_error (task, g_steal_pointer (&error));
+}
+
+static void
+apply_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  if (!g_task_propagate_boolean (G_TASK (result), &error))
+    {
+      if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+      g_warning ("Settings: Secure Shell: %s", error->message);
+    }
+  ssh_read (data);
+}
+
+typedef struct { Ssh *s; gboolean on; } SshChange;
+
+static void
+ssh_acquired (GObject *source, GAsyncResult *result, gpointer data)
+{
+  SshChange *c = data;
+  g_autoptr (GError) error = NULL;
+  gboolean ok = g_permission_acquire_finish (G_PERMISSION (source), result, &error) && g_permission_get_allowed (G_PERMISSION (source));
+  if (ok)
+    {
+      g_autoptr (GTask) task = g_task_new (NULL, c->s->cancel, apply_done, c->s);
+      g_task_set_task_data (task, GINT_TO_POINTER (c->on), NULL);
+      g_task_run_in_thread (task, apply_thread);
+    }
+  else if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    ssh_read (c->s); /* not authorised: show the unit's state again */
+  g_object_unref (source);
+  g_free (c);
+}
+
+static void
+ssh_permission (GObject *source, GAsyncResult *result, gpointer data)
+{
+  SshChange *c = data;
+  g_autoptr (GError) error = NULL;
+  GPermission *permission = polkit_permission_new_finish (result, &error);
+  if (!permission)
+    {
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        {
+          g_warning ("Settings: %s: %s", SSH_PERMISSION, error->message);
+          ssh_read (c->s);
+        }
+      g_free (c);
+      return;
+    }
+  g_permission_acquire_async (permission, c->s->cancel, ssh_acquired, c);
+}
+
+static gboolean
+ssh_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Ssh *s = state;
+  if (!g_str_equal (key, "ssh")) return FALSE;
+  if (!value || !JSON_NODE_HOLDS_VALUE (value) || json_node_get_value_type (value) != G_TYPE_BOOLEAN)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "ssh is on or off");
+      return FALSE;
+    }
+  /* As cc_secure_shell_set_enabled: acquire the permission, then the unit. */
+  SshChange *c = g_new0 (SshChange, 1);
+  c->s = s;
+  c->on = json_node_get_boolean (value);
+  polkit_permission_new (SSH_PERMISSION, NULL, s->cancel, ssh_permission, c);
+  return TRUE;
+}
+
+static gpointer
+ssh_start (CcLumaFixture *model)
+{
+  Ssh *s = g_new0 (Ssh, 1);
+  s->model = model;
+  s->cancel = g_cancellable_new ();
+  cc_luma_fixture_own_key (model, "ssh");
+  ssh_read (s);
+  s->poll = g_timeout_add_seconds (10, ssh_poll, s);
+  return s;
+}
+
+static void
+ssh_stop (gpointer state)
+{
+  Ssh *s = state;
+  g_cancellable_cancel (s->cancel);
+  g_clear_object (&s->cancel);
+  g_clear_handle_id (&s->poll, g_source_remove);
+  g_free (s);
+}
+
+const CcLumaAdapter cc_luma_adapter_ssh = { "ssh", ssh_pages, ssh_start, ssh_write, ssh_stop };
diff --git a/shell/cc-luma-live-users.c b/shell/cc-luma-live-users.c
new file mode 100644
index 0000000..af58d40
--- /dev/null
+++ b/shell/cc-luma-live-users.c
@@ -0,0 +1,471 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live people: AccountsService, as panels/system/users reads and changes it.
+ * The signed-in person (name, username, picture, account type, automatic
+ * sign-in) and the other people on this computer. Changes that need an
+ * administrator acquire the users panel's own polkit permission first
+ * (org.gnome.controlcenter.user-accounts.administration), then call the same
+ * ActUser / ActUserManager methods the panel calls. No Luma account service
+ * exists yet, so email, sync and signed-in computers are never published. */
+#include "cc-luma-live.h"
+#include <act/act.h>
+#include <polkit/polkit.h>
+#include <string.h>
+#include <unistd.h>
+
+#define ADAPTER "users"
+#define USER_ACCOUNTS_PERMISSION "org.gnome.controlcenter.user-accounts.administration"
+static const char * const pages[] = { "me", "users", "user-priya", NULL };
+
+typedef struct {
+  CcLumaFixture *model;
+  ActUserManager *manager;
+  GCancellable *cancel;
+  char *selected;       /* the other person user-priya shows */
+  gboolean ready;
+} People;
+
+typedef void (*AdminAction) (People *p, gpointer data);
+typedef struct { People *p; AdminAction action; gpointer data; GDestroyNotify free; } Pending;
+
+static ActUser *
+self_user (People *p)
+{
+  ActUser *u = act_user_manager_get_user_by_id (p->manager, getuid ());
+  return u && act_user_is_loaded (u) ? u : NULL;
+}
+
+static ActUser *
+find_user (People *p, const char *name)
+{
+  if (!name || !*name) return NULL;
+  ActUser *u = act_user_manager_get_user (p->manager, name);
+  return u && act_user_is_loaded (u) && !act_user_is_system_account (u) && act_user_get_uid (u) != getuid () ? u : NULL;
+}
+
+static const char *
+picture_of (ActUser *u)
+{
+  const char *file = act_user_get_icon_file (u);
+  return file && g_file_test (file, G_FILE_TEST_IS_REGULAR) ? file : NULL;
+}
+
+/* Data tables are republished only when they change: a redraw closes an
+ * open picker. */
+static void
+publish_data_changed (CcLumaFixture *model, const char *name, JsonNode *node)
+{
+  JsonNode *before = json_object_get_member (cc_luma_fixture_get_data (model), name);
+  if (!before || !json_node_equal (before, node)) cc_luma_fixture_publish_data (model, name, node);
+}
+
+static void
+publish (People *p)
+{
+  ActUser *me = self_user (p);
+  gboolean loaded = FALSE;
+  g_object_get (p->manager, "is-loaded", &loaded, NULL);
+  if (!loaded || !me) return;
+  const char *real = act_user_get_real_name (me);
+  cc_luma_fixture_publish_string (p->model, "myName", real && *real ? real : act_user_get_user_name (me));
+  cc_luma_fixture_publish_string (p->model, "me.user", act_user_get_user_name (me));
+  cc_luma_fixture_publish_boolean (p->model, "me.admin",
+                                   act_user_get_account_type (me) == ACT_USER_ACCOUNT_TYPE_ADMINISTRATOR);
+  cc_luma_fixture_publish_boolean (p->model, "me.local", act_user_is_local_account (me));
+  cc_luma_fixture_publish_asset (p->model, "me-picture", picture_of (me));
+  cc_luma_fixture_publish_boolean (p->model, "me.picture", picture_of (me) != NULL);
+  cc_luma_fixture_publish_boolean (p->model, "autoLogin", act_user_get_automatic_login (me));
+
+  g_autoptr (JsonArray) people = json_array_new ();
+  g_autoptr (GSList) list = act_user_manager_list_users (p->manager);
+  gboolean selected_seen = FALSE;
+  for (GSList *l = list; l; l = l->next)
+    {
+      ActUser *u = l->data;
+      if (!act_user_is_loaded (u) || act_user_is_system_account (u) || act_user_get_uid (u) == getuid ()) continue;
+      JsonObject *o = json_object_new ();
+      const char *name = act_user_get_real_name (u);
+      g_autofree char *asset = g_strconcat ("user:", act_user_get_user_name (u), NULL);
+      json_object_set_string_member (o, "user", act_user_get_user_name (u));
+      json_object_set_string_member (o, "name", name && *name ? name : act_user_get_user_name (u));
+      json_object_set_boolean_member (o, "admin", act_user_get_account_type (u) == ACT_USER_ACCOUNT_TYPE_ADMINISTRATOR);
+      json_object_set_boolean_member (o, "auto", act_user_get_automatic_login (u));
+      json_object_set_boolean_member (o, "local", act_user_is_local_account (u));
+      json_object_set_int_member (o, "last", act_user_get_login_time (u));
+      json_object_set_boolean_member (o, "picture", picture_of (u) != NULL);
+      cc_luma_fixture_publish_asset (p->model, asset, picture_of (u));
+      json_array_add_object_element (people, o);
+      if (g_strcmp0 (p->selected, act_user_get_user_name (u)) == 0) selected_seen = TRUE;
+    }
+  g_autoptr (JsonNode) node = json_node_init_array (json_node_alloc (), people);
+  publish_data_changed (p->model, "LIVEUSERS", node);
+
+  /* The person user-priya shows (chosen on Users; removed → none). */
+  if (!selected_seen) g_clear_pointer (&p->selected, g_free);
+  ActUser *sel = find_user (p, p->selected);
+  cc_luma_fixture_publish_string (p->model, "pUser", p->selected);
+  cc_luma_fixture_publish_string (p->model, "pType",
+    sel && act_user_get_account_type (sel) == ACT_USER_ACCOUNT_TYPE_ADMINISTRATOR ? "admin" : "std");
+  cc_luma_fixture_publish_boolean (p->model, "pAuto", sel && act_user_get_automatic_login (sel));
+
+  if (!p->ready) { p->ready = TRUE; cc_luma_live_ready (p->model, ADAPTER); }
+}
+
+static void
+user_changed (People *p)
+{
+  publish (p);
+}
+
+static void
+watch_user (People *p, ActUser *u)
+{
+  g_signal_handlers_disconnect_by_data (u, p);
+  g_signal_connect_swapped (u, "changed", G_CALLBACK (user_changed), p);
+  g_signal_connect_swapped (u, "notify::is-loaded", G_CALLBACK (user_changed), p);
+}
+
+static void
+user_added (ActUserManager *m, ActUser *u, People *p)
+{
+  watch_user (p, u);
+  publish (p);
+}
+
+static void
+manager_loaded (People *p)
+{
+  g_autoptr (GSList) list = act_user_manager_list_users (p->manager);
+  for (GSList *l = list; l; l = l->next) watch_user (p, l->data);
+  ActUser *me = act_user_manager_get_user_by_id (p->manager, getuid ());
+  if (me) watch_user (p, me);
+  publish (p);
+}
+
+/* ── Administrator actions: the users panel's permission, then the call ── */
+static void
+pending_free (Pending *pending)
+{
+  if (pending->free) pending->free (pending->data);
+  g_free (pending);
+}
+
+static void
+permission_acquired (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Pending *pending = data;
+  g_autoptr (GError) error = NULL;
+  if (!g_permission_acquire_finish (G_PERMISSION (source), result, &error) || !g_permission_get_allowed (G_PERMISSION (source)))
+    {
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        {
+          g_message ("Settings: users: not authorised%s%s", error ? ": " : "", error ? error->message : "");
+          publish (pending->p); /* redraw what the system still has */
+        }
+    }
+  else
+    pending->action (pending->p, pending->data);
+  g_object_unref (source);
+  pending_free (pending);
+}
+
+static void
+permission_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Pending *pending = data;
+  g_autoptr (GError) error = NULL;
+  GPermission *permission = polkit_permission_new_finish (result, &error);
+  if (!permission)
+    {
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        g_warning ("Settings: users: %s: %s", USER_ACCOUNTS_PERMISSION, error->message);
+      pending_free (pending);
+      return;
+    }
+  if (g_permission_get_allowed (permission))
+    {
+      pending->action (pending->p, pending->data);
+      g_object_unref (permission);
+      pending_free (pending);
+      return;
+    }
+  g_permission_acquire_async (permission, pending->p->cancel, permission_acquired, pending);
+}
+
+static void
+as_admin (People *p, AdminAction action, gpointer data, GDestroyNotify free)
+{
+  Pending *pending = g_new0 (Pending, 1);
+  pending->p = p;
+  pending->action = action;
+  pending->data = data;
+  pending->free = free;
+  polkit_permission_new (USER_ACCOUNTS_PERMISSION, NULL, p->cancel, permission_ready, pending);
+}
+
+typedef struct { char *user; gboolean flag; char *name; } Change;
+static void
+change_free (gpointer data)
+{
+  Change *c = data;
+  g_free (c->user);
+  g_free (c->name);
+  g_free (c);
+}
+static Change *
+change_new (const char *user, gboolean flag, const char *name)
+{
+  Change *c = g_new0 (Change, 1);
+  c->user = g_strdup (user);
+  c->flag = flag;
+  c->name = g_strdup (name);
+  return c;
+}
+
+static ActUser *
+change_target (People *p, Change *c)
+{
+  ActUser *me = self_user (p);
+  if (me && g_strcmp0 (c->user, act_user_get_user_name (me)) == 0) return me;
+  return find_user (p, c->user);
+}
+
+static void
+set_type (People *p, gpointer data)
+{
+  Change *c = data;
+  ActUser *u = change_target (p, c);
+  if (u) act_user_set_account_type (u, c->flag ? ACT_USER_ACCOUNT_TYPE_ADMINISTRATOR : ACT_USER_ACCOUNT_TYPE_STANDARD);
+}
+
+/* As cc-user-page.c autologin_changed: one person signs in automatically. */
+static void
+set_auto (People *p, gpointer data)
+{
+  Change *c = data;
+  ActUser *u = change_target (p, c);
+  if (!u) return;
+  if (c->flag)
+    {
+      g_autoptr (GSList) list = act_user_manager_list_users (p->manager);
+      for (GSList *l = list; l; l = l->next)
+        if (act_user_get_uid (l->data) != act_user_get_uid (u) && act_user_get_automatic_login (l->data))
+          act_user_set_automatic_login (l->data, FALSE);
+    }
+  act_user_set_automatic_login (u, c->flag);
+}
+
+/* As the password dialog's "set at next login" for someone else. */
+static void
+reset_password (People *p, gpointer data)
+{
+  ActUser *u = change_target (p, data);
+  if (u) act_user_set_password_mode (u, ACT_USER_PASSWORD_MODE_SET_AT_LOGIN);
+}
+
+static void
+delete_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  if (!act_user_manager_delete_user_finish (ACT_USER_MANAGER (source), result, &error) &&
+      !g_error_matches (error, ACT_USER_MANAGER_ERROR, ACT_USER_MANAGER_ERROR_PERMISSION_DENIED))
+    g_warning ("Settings: could not remove the account: %s", error->message);
+}
+
+/* As cc-user-page.c remove_local_user_response. */
+static void
+remove_user (People *p, gpointer data)
+{
+  Change *c = data;
+  ActUser *u = find_user (p, c->user);
+  if (!u) return;
+  if (act_user_get_automatic_login (u)) act_user_set_automatic_login (u, FALSE);
+  act_user_manager_delete_user_async (p->manager, u, !c->flag, NULL, delete_done, NULL);
+}
+
+static void
+added_loaded (ActUser *u, GParamSpec *pspec, gpointer data)
+{
+  if (!act_user_is_loaded (u)) return;
+  g_signal_handlers_disconnect_by_func (u, added_loaded, data);
+  /* The add dialog's "set a password at next login". */
+  act_user_set_password_mode (u, ACT_USER_PASSWORD_MODE_SET_AT_LOGIN);
+}
+
+static void
+create_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  ActUser *u = act_user_manager_create_user_finish (ACT_USER_MANAGER (source), result, &error);
+  if (!u)
+    {
+      if (!g_error_matches (error, ACT_USER_MANAGER_ERROR, ACT_USER_MANAGER_ERROR_PERMISSION_DENIED))
+        g_warning ("Settings: could not add the account: %s", error->message);
+      return;
+    }
+  if (act_user_is_loaded (u)) added_loaded (u, NULL, NULL);
+  else g_signal_connect (u, "notify::is-loaded", G_CALLBACK (added_loaded), NULL);
+}
+
+static void
+create_user (People *p, gpointer data)
+{
+  Change *c = data;
+  act_user_manager_create_user_async (p->manager, c->user, c->name, ACT_USER_ACCOUNT_TYPE_STANDARD,
+                                      p->cancel, create_done, NULL);
+}
+
+/* The users panel's username rule (user-utils.c is_valid_username, without
+ * the async lookup: AccountsService refuses a name already in use). */
+static gboolean
+valid_username (const char *name)
+{
+  if (!name || !*name || strlen (name) > 32 || name[0] == '-' || g_ascii_isdigit (name[0])) return FALSE;
+  for (const char *c = name; *c; c++)
+    if (!(g_ascii_islower (*c) || g_ascii_isdigit (*c) || *c == '_' || *c == '-' || *c == '.')) return FALSE;
+  return TRUE;
+}
+
+static gboolean
+is_string (JsonNode *value)
+{
+  return value && JSON_NODE_HOLDS_VALUE (value) && json_node_get_value_type (value) == G_TYPE_STRING;
+}
+static gboolean
+is_bool (JsonNode *value)
+{
+  return value && JSON_NODE_HOLDS_VALUE (value) && json_node_get_value_type (value) == G_TYPE_BOOLEAN;
+}
+
+static gboolean
+people_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  People *p = state;
+  ActUser *me = self_user (p);
+  if (!g_str_equal (key, "myName") && !g_str_equal (key, "autoLogin") && !g_str_equal (key, "pUser") &&
+      !g_str_equal (key, "pType") && !g_str_equal (key, "pAuto") && !g_str_equal (key, "users.reset") &&
+      !g_str_equal (key, "users.remove") && !g_str_equal (key, "users.add"))
+    return FALSE;
+  if (!me)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED, "Accounts aren’t available");
+      return FALSE;
+    }
+  if (g_str_equal (key, "myName"))
+    {
+      /* Your own name needs no administrator (cc-user-page.c real_name). */
+      g_autofree char *name = is_string (value) ? g_strstrip (g_strdup (json_node_get_string (value))) : NULL;
+      if (!name || !*name || strlen (name) > 255)
+        {
+          g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Type a name");
+          return FALSE;
+        }
+      act_user_set_real_name (me, name);
+      return TRUE;
+    }
+  if (g_str_equal (key, "autoLogin"))
+    {
+      if (!is_bool (value)) goto invalid;
+      as_admin (p, set_auto, change_new (act_user_get_user_name (me), json_node_get_boolean (value), NULL), change_free);
+      return TRUE;
+    }
+  if (g_str_equal (key, "pUser"))
+    {
+      /* A choice of whom user-priya shows; changes nothing on the system. */
+      if (!is_string (value) || !find_user (p, json_node_get_string (value))) goto invalid;
+      g_free (p->selected);
+      p->selected = g_strdup (json_node_get_string (value));
+      publish (p);
+      return TRUE;
+    }
+  if (g_str_equal (key, "users.add"))
+    {
+      JsonObject *o = value && JSON_NODE_HOLDS_OBJECT (value) ? json_node_get_object (value) : NULL;
+      const char *user = o ? json_object_get_string_member_with_default (o, "user", "") : "";
+      const char *name = o ? json_object_get_string_member_with_default (o, "name", "") : "";
+      if (!*name || strlen (name) > 255)
+        {
+          g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Type their full name");
+          return FALSE;
+        }
+      if (!valid_username (user))
+        {
+          g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                               "A username uses lower-case letters, digits, “_”, “-” and “.”, and doesn’t start with a digit");
+          return FALSE;
+        }
+      as_admin (p, create_user, change_new (user, FALSE, name), change_free);
+      return TRUE;
+    }
+  /* The rest act on the person user-priya shows. */
+  ActUser *sel = find_user (p, p->selected);
+  if (!sel)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "That account is gone");
+      return FALSE;
+    }
+  if (g_str_equal (key, "pType"))
+    {
+      if (!is_string (value) || (!g_str_equal (json_node_get_string (value), "std") && !g_str_equal (json_node_get_string (value), "admin")))
+        goto invalid;
+      as_admin (p, set_type, change_new (p->selected, g_str_equal (json_node_get_string (value), "admin"), NULL), change_free);
+      return TRUE;
+    }
+  if (g_str_equal (key, "pAuto"))
+    {
+      if (!is_bool (value)) goto invalid;
+      as_admin (p, set_auto, change_new (p->selected, json_node_get_boolean (value), NULL), change_free);
+      return TRUE;
+    }
+  if (g_str_equal (key, "users.reset"))
+    {
+      as_admin (p, reset_password, change_new (p->selected, FALSE, NULL), change_free);
+      return TRUE;
+    }
+  if (g_str_equal (key, "users.remove"))
+    {
+      /* TRUE keeps their files in /home (the dialog's option). */
+      if (!is_bool (value)) goto invalid;
+      as_admin (p, remove_user, change_new (p->selected, json_node_get_boolean (value), NULL), change_free);
+      return TRUE;
+    }
+invalid:
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "%s can’t take that value", key);
+  return FALSE;
+}
+
+static gpointer
+people_start (CcLumaFixture *model)
+{
+  People *p = g_new0 (People, 1);
+  gboolean loaded = FALSE;
+  p->model = model;
+  p->cancel = g_cancellable_new ();
+  p->manager = g_object_ref (act_user_manager_get_default ());
+  const char *keys[] = { "myName", "autoLogin", "pUser", "pType", "pAuto", "users.reset", "users.remove", "users.add" };
+  for (guint i = 0; i < G_N_ELEMENTS (keys); i++) cc_luma_fixture_own_key (model, keys[i]);
+  g_signal_connect_swapped (p->manager, "notify::is-loaded", G_CALLBACK (manager_loaded), p);
+  g_signal_connect (p->manager, "user-added", G_CALLBACK (user_added), p);
+  g_signal_connect_swapped (p->manager, "user-removed", G_CALLBACK (publish), p);
+  g_signal_connect_swapped (p->manager, "user-changed", G_CALLBACK (publish), p);
+  g_object_get (p->manager, "is-loaded", &loaded, NULL);
+  if (loaded) manager_loaded (p);
+  return p;
+}
+
+static void
+people_stop (gpointer state)
+{
+  People *p = state;
+  g_cancellable_cancel (p->cancel);
+  g_clear_object (&p->cancel);
+  g_autoptr (GSList) list = act_user_manager_list_users (p->manager);
+  for (GSList *l = list; l; l = l->next) g_signal_handlers_disconnect_by_data (l->data, p);
+  ActUser *me = act_user_manager_get_user_by_id (p->manager, getuid ());
+  if (me) g_signal_handlers_disconnect_by_data (me, p);
+  g_signal_handlers_disconnect_by_data (p->manager, p);
+  g_clear_object (&p->manager);
+  g_free (p->selected);
+  g_free (p);
+}
+
+const CcLumaAdapter cc_luma_adapter_users = { ADAPTER, pages, people_start, people_write, people_stop };
diff --git a/shell/cc-luma-live-wellbeing.c b/shell/cc-luma-live-wellbeing.c
new file mode 100644
index 0000000..4642ad0
--- /dev/null
+++ b/shell/cc-luma-live-wellbeing.c
@@ -0,0 +1,258 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live Wellbeing, from what panels/wellbeing reads:
+ *  - org.gnome.desktop.screen-time-limits: daily-limit-enabled,
+ *    daily-limit-seconds, grayscale, history-enabled;
+ *  - org.gnome.desktop.break-reminders selected-breaks (eyesight, movement),
+ *    .movement duration-seconds / interval-seconds, play-sound on both (the panel's sound
+ *    switch is on when both are);
+ *  - the week of screen time from gnome-shell's session-active-history.json,
+ *    summed per local day as cc-screen-time-statistics-row.c does.
+ * With history off there is no week: the page leaves the chart out. */
+#include "cc-luma-live-gsettings.h"
+#include <stdio.h>
+
+#define ADAPTER "wellbeing"
+static const char * const pages[] = { "wellbeing", NULL };
+#define LIMITS "org.gnome.desktop.screen-time-limits"
+#define BREAKS "org.gnome.desktop.break-reminders"
+
+static const CcLumaGsRow rows[] = {
+  { "limit", LIMITS, "daily-limit-enabled", CC_LUMA_GS_BOOLEAN },
+  { "gray", LIMITS, "grayscale", CC_LUMA_GS_BOOLEAN },
+};
+
+typedef struct {
+  CcLumaFixture *model;
+  CcLumaGsTable *table;
+  GSettings *limits, *breaks, *eyes, *move;
+  GFileMonitor *monitor;
+  GCancellable *cancel;
+  gboolean week, ready;
+} Wellbeing;
+
+static GSettings *
+installed (const char *id)
+{
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = source ? g_settings_schema_source_lookup (source, id, TRUE) : NULL;
+  return schema ? g_settings_new_full (schema, NULL, NULL) : NULL;
+}
+
+static void
+check_ready (Wellbeing *w)
+{
+  if (w->ready || !w->week || !w->limits || !w->breaks || !w->eyes || !w->move) return;
+  for (guint i = 0; i < G_N_ELEMENTS (rows); i++) if (!cc_luma_gs_table_covers (w->table, rows[i].key)) return;
+  w->ready = TRUE;
+  cc_luma_live_ready (w->model, ADAPTER);
+}
+
+static void
+publish (Wellbeing *w)
+{
+  if (!w->limits || !w->breaks || !w->eyes || !w->move) return;
+  guint seconds = g_settings_get_uint (w->limits, "daily-limit-seconds");
+  g_autofree char *hours = seconds % 3600 ? g_strdup_printf ("%g", seconds / 3600.0) : g_strdup_printf ("%u", seconds / 3600);
+  cc_luma_fixture_publish_string (w->model, "limitH", hours);
+  g_auto (GStrv) selected = g_settings_get_strv (w->breaks, "selected-breaks");
+  cc_luma_fixture_publish_boolean (w->model, "eyes", g_strv_contains ((const char * const *) selected, "eyesight"));
+  cc_luma_fixture_publish_boolean (w->model, "move", g_strv_contains ((const char * const *) selected, "movement"));
+  g_autofree char *schedule = g_strdup_printf ("%u-%u", g_settings_get_uint (w->move, "duration-seconds") / 60,
+                                               g_settings_get_uint (w->move, "interval-seconds") / 60);
+  cc_luma_fixture_publish_string (w->model, "moveS", schedule);
+  cc_luma_fixture_publish_boolean (w->model, "brSound", g_settings_get_boolean (w->eyes, "play-sound") &&
+                                                        g_settings_get_boolean (w->move, "play-sound"));
+  check_ready (w);
+}
+
+/* Data tables are republished only when they change: a redraw closes an
+ * open picker. */
+static void
+publish_data_changed (CcLumaFixture *model, const char *name, JsonNode *node)
+{
+  JsonNode *before = json_object_get_member (cc_luma_fixture_get_data (model), name);
+  if (!before || !json_node_equal (before, node)) cc_luma_fixture_publish_data (model, name, node);
+}
+
+/* ── The week ────────────────────────────────────────────────────────── */
+static gint64
+local_midnight_after (gint64 t)
+{
+  g_autoptr (GDateTime) at = g_date_time_new_from_unix_local (t);
+  g_autoptr (GDateTime) day = g_date_time_new_local (g_date_time_get_year (at), g_date_time_get_month (at),
+                                                     g_date_time_get_day_of_month (at), 0, 0, 0);
+  g_autoptr (GDateTime) next = g_date_time_add_days (day, 1);
+  return g_date_time_to_unix (next);
+}
+
+/* Minutes active on each of the last seven local days, today last. */
+static gboolean
+read_week (const char *path, double minutes[7])
+{
+  g_autoptr (JsonParser) parser = json_parser_new_immutable ();
+  if (!json_parser_load_from_mapped_file (parser, path, NULL)) return FALSE;
+  JsonNode *root = json_parser_get_root (parser);
+  if (!root || !JSON_NODE_HOLDS_ARRAY (root)) return FALSE;
+  gint64 now = g_get_real_time () / G_USEC_PER_SEC, start = local_midnight_after (now) - 7 * 86400;
+  gint64 prev = 0, prev_state = 0;
+  JsonArray *items = json_node_get_array (root);
+  for (guint i = 0; i <= json_array_get_length (items); i++)
+    {
+      gint64 when = now, state = 0;
+      if (i < json_array_get_length (items))
+        {
+          JsonNode *e = json_array_get_element (items, i);
+          if (!JSON_NODE_HOLDS_OBJECT (e)) return FALSE;
+          JsonObject *o = json_node_get_object (e);
+          when = json_object_get_int_member_with_default (o, "wallTimeSecs", -1);
+          state = json_object_get_int_member_with_default (o, "newState", -1);
+          if (when <= prev || when > now || (state != 0 && state != 1)) return FALSE;
+        }
+      /* An active stretch from the previous transition to this one. */
+      for (gint64 from = MAX (prev, start); prev_state == 1 && from < when; )
+        {
+          gint64 to = MIN (when, local_midnight_after (from));
+          gint64 day = (local_midnight_after (from) - start + 43200) / 86400 - 1; /* whole days across DST */
+          if (day >= 0 && day < 7) minutes[day] += (to - from) / 60.0;
+          from = to;
+        }
+      prev = when;
+      prev_state = state;
+    }
+  return TRUE;
+}
+
+static void
+publish_week (Wellbeing *w)
+{
+  g_autoptr (JsonArray) week = json_array_new ();
+  double minutes[7] = { 0 };
+  g_autofree char *path = g_build_filename (g_get_user_data_dir (), "gnome-shell", "session-active-history.json", NULL);
+  gboolean history = w->limits && g_settings_get_boolean (w->limits, "history-enabled");
+  if (history && read_week (path, minutes))
+    {
+      g_autoptr (GDateTime) now = g_date_time_new_now_local ();
+      for (int i = 0; i < 7; i++)
+        {
+          g_autoptr (GDateTime) day = g_date_time_add_days (now, i - 6);
+          g_autofree char *name = i == 6 ? g_strdup ("Today") : g_date_time_format (day, "%a");
+          JsonArray *entry = json_array_new ();
+          json_array_add_string_element (entry, name);
+          json_array_add_int_element (entry, (gint64) (minutes[i] + 0.5));
+          json_array_add_array_element (week, entry);
+        }
+    }
+  g_autoptr (JsonNode) node = json_node_init_array (json_node_alloc (), week);
+  publish_data_changed (w->model, "CFWEEK", node);
+  cc_luma_fixture_publish_boolean (w->model, "wb.history", history);
+  w->week = TRUE;
+  check_ready (w);
+}
+
+/* As cc-wellbeing-panel.c's strv mapping: add or remove one break. */
+static gboolean
+set_break (Wellbeing *w, const char *name, gboolean on)
+{
+  g_auto (GStrv) selected = g_settings_get_strv (w->breaks, "selected-breaks");
+  g_autoptr (GStrvBuilder) b = g_strv_builder_new ();
+  for (guint i = 0; selected[i]; i++) if (!g_str_equal (selected[i], name)) g_strv_builder_add (b, selected[i]);
+  if (on) g_strv_builder_add (b, name);
+  g_auto (GStrv) next = g_strv_builder_end (b);
+  return g_settings_set_strv (w->breaks, "selected-breaks", (const char * const *) next);
+}
+
+static gboolean
+wellbeing_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Wellbeing *w = state;
+  if (cc_luma_gs_table_covers (w->table, key)) return cc_luma_gs_table_write (w->table, key, value, error);
+  GType type = value && JSON_NODE_HOLDS_VALUE (value) ? json_node_get_value_type (value) : G_TYPE_INVALID;
+  if (!w->limits || !w->breaks || !w->eyes || !w->move) return FALSE;
+  if ((g_str_equal (key, "eyes") || g_str_equal (key, "move")) && type == G_TYPE_BOOLEAN)
+    {
+      if (set_break (w, g_str_equal (key, "eyes") ? "eyesight" : "movement", json_node_get_boolean (value))) return TRUE;
+      goto locked;
+    }
+  if (g_str_equal (key, "brSound") && type == G_TYPE_BOOLEAN)
+    {
+      /* The panel's one switch sets play-sound on both breaks. */
+      gboolean on = json_node_get_boolean (value);
+      if (g_settings_set_boolean (w->eyes, "play-sound", on) && g_settings_set_boolean (w->move, "play-sound", on)) return TRUE;
+      goto locked;
+    }
+  if (g_str_equal (key, "limitH") && type == G_TYPE_STRING)
+    {
+      char *end;
+      double hours = g_ascii_strtod (json_node_get_string (value), &end);
+      if (*end || hours <= 0 || hours > 24) goto invalid;
+      if (g_settings_set_uint (w->limits, "daily-limit-seconds", (guint) (hours * 3600 + 0.5))) return TRUE;
+      goto locked;
+    }
+  if (g_str_equal (key, "moveS") && type == G_TYPE_STRING)
+    {
+      unsigned duration, interval;
+      char tail;
+      if (sscanf (json_node_get_string (value), "%u-%u%c", &duration, &interval, &tail) != 2 ||
+          !duration || interval <= duration || interval > 24 * 60) goto invalid;
+      /* Both at once, as the panel's delayed-apply schedule (on its own
+       * settings object, so the adapter's stays immediate). */
+      g_autoptr (GSettings) schedule = installed (BREAKS ".movement");
+      g_settings_delay (schedule);
+      g_settings_set_uint (schedule, "duration-seconds", duration * 60);
+      g_settings_set_uint (schedule, "interval-seconds", interval * 60);
+      g_settings_apply (schedule);
+      return TRUE;
+    }
+  return FALSE;
+invalid:
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "%s can’t take that value", key);
+  return FALSE;
+locked:
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "%s is locked", key);
+  return FALSE;
+}
+
+static gpointer
+wellbeing_start (CcLumaFixture *model)
+{
+  Wellbeing *w = g_new0 (Wellbeing, 1);
+  w->model = model;
+  w->cancel = g_cancellable_new ();
+  w->table = cc_luma_gs_table_new (model, rows, G_N_ELEMENTS (rows));
+  const char *owned[] = { "limitH", "eyes", "move", "moveS", "brSound" };
+  for (guint i = 0; i < G_N_ELEMENTS (owned); i++) cc_luma_fixture_own_key (model, owned[i]);
+  w->limits = installed (LIMITS);
+  w->breaks = installed (BREAKS);
+  w->eyes = installed (BREAKS ".eyesight");
+  w->move = installed (BREAKS ".movement");
+  GSettings *all[] = { w->limits, w->breaks, w->eyes, w->move };
+  for (guint i = 0; i < G_N_ELEMENTS (all); i++)
+    if (all[i]) g_signal_connect_swapped (all[i], "changed", G_CALLBACK (publish), w);
+  if (w->limits) g_signal_connect_swapped (w->limits, "changed::history-enabled", G_CALLBACK (publish_week), w);
+  g_autoptr (GFile) history = g_file_new_build_filename (g_get_user_data_dir (), "gnome-shell", "session-active-history.json", NULL);
+  w->monitor = g_file_monitor_file (history, G_FILE_MONITOR_NONE, w->cancel, NULL);
+  if (w->monitor) g_signal_connect_swapped (w->monitor, "changed", G_CALLBACK (publish_week), w);
+  publish (w);
+  publish_week (w);
+  return w;
+}
+
+static void
+wellbeing_stop (gpointer state)
+{
+  Wellbeing *w = state;
+  g_cancellable_cancel (w->cancel);
+  g_clear_object (&w->cancel);
+  GSettings **all[] = { &w->limits, &w->breaks, &w->eyes, &w->move };
+  for (guint i = 0; i < G_N_ELEMENTS (all); i++)
+    {
+      if (*all[i]) g_signal_handlers_disconnect_by_data (*all[i], w);
+      g_clear_object (all[i]);
+    }
+  if (w->monitor) { g_signal_handlers_disconnect_by_data (w->monitor, w); g_file_monitor_cancel (w->monitor); }
+  g_clear_object (&w->monitor);
+  cc_luma_gs_table_free (w->table);
+  g_free (w);
+}
+
+const CcLumaAdapter cc_luma_adapter_wellbeing = { ADAPTER, pages, wellbeing_start, wellbeing_write, wellbeing_stop };
diff --git a/shell/cc-luma-live-windows.c b/shell/cc-luma-live-windows.c
new file mode 100644
index 0000000..38eb5f5
--- /dev/null
+++ b/shell/cc-luma-live-windows.c
@@ -0,0 +1,179 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Windows & Workspaces: GNOME's multitasking keys (panels/multitasking) and,
+ * where Luma's tiling is installed, the Tiling Shell extension the Quick
+ * Options tiling toggle drives: on/off through GNOME Shell's extension
+ * service, its gap and screen edges through its own schema. Without that
+ * extension the Tiling rows are left out. */
+#include "cc-luma-live-gsettings.h"
+#include "cc-luma-live-apps.h"
+#include "cc-luma-desktop.h"
+
+#define TILING_UUID "tilingshell@ferrarodomenico.com"
+#define TILING_SCHEMA "org.gnome.shell.extensions.tilingshell"
+
+static const CcLumaGsRow rows[] = {
+  { "edges", "org.gnome.mutter", "edge-tiling", CC_LUMA_GS_BOOLEAN },
+  { "hot", "org.gnome.desktop.interface", "enable-hot-corners", CC_LUMA_GS_BOOLEAN },
+  { "ws", "org.gnome.mutter", "dynamic-workspaces", CC_LUMA_GS_CHOICE, (const char * const[]) { "dynamic", "true", "fixed", "false", NULL } },
+  { "wsN", "org.gnome.desktop.wm.preferences", "num-workspaces", CC_LUMA_GS_LINEAR, NULL, 1, 0, 1, 36 },
+  { "wsMon", "org.gnome.mutter", "workspaces-only-on-primary", CC_LUMA_GS_CHOICE, (const char * const[]) { "primary", "true", "all", "false", NULL } },
+  { "swi", "org.gnome.shell.app-switcher", "current-workspace-only", CC_LUMA_GS_CHOICE, (const char * const[]) { "current", "true", "all", "false", NULL } },
+};
+
+typedef struct {
+  CcLumaFixture *model;
+  CcLumaGsTable *table;
+  CcLumaReadyGate *gate;
+  GSettings *shell;   /* org.gnome.shell: which extensions are on */
+  GSettings *tiling;  /* the extension's own settings */
+  GCancellable *cancel;
+} Windows;
+
+/* The extension's schema ships beside it, as the tiling toggle finds it. */
+static GSettings *
+tiling_settings (void)
+{
+  g_autoptr (GPtrArray) dirs = g_ptr_array_new_with_free_func (g_free);
+  g_ptr_array_add (dirs, g_build_filename (g_get_user_data_dir (), "gnome-shell", "extensions", TILING_UUID, "schemas", NULL));
+  for (const char * const *d = g_get_system_data_dirs (); *d; d++)
+    g_ptr_array_add (dirs, g_build_filename (*d, "gnome-shell", "extensions", TILING_UUID, "schemas", NULL));
+  for (guint i = 0; i < dirs->len; i++)
+    {
+      if (!g_file_test (dirs->pdata[i], G_FILE_TEST_IS_DIR)) continue;
+      g_autoptr (GSettingsSchemaSource) source =
+        g_settings_schema_source_new_from_directory (dirs->pdata[i], g_settings_schema_source_get_default (), FALSE, NULL);
+      g_autoptr (GSettingsSchema) schema = source ? g_settings_schema_source_lookup (source, TILING_SCHEMA, FALSE) : NULL;
+      if (schema && g_settings_schema_has_key (schema, "inner-gaps") && g_settings_schema_has_key (schema, "active-screen-edges"))
+        return g_settings_new_full (schema, NULL, NULL);
+    }
+  return NULL;
+}
+
+static gboolean
+tiling_on (Windows *self)
+{
+  g_auto (GStrv) enabled = g_settings_get_strv (self->shell, "enabled-extensions");
+  g_auto (GStrv) disabled = g_settings_get_strv (self->shell, "disabled-extensions");
+  return g_strv_contains ((const char * const *) enabled, TILING_UUID) &&
+         !g_strv_contains ((const char * const *) disabled, TILING_UUID);
+}
+
+static void
+publish_tiling (Windows *self)
+{
+  if (!self->tiling || !self->shell) return;
+  cc_luma_fixture_publish_boolean (self->model, "tile", tiling_on (self));
+  cc_luma_fixture_publish_int (self->model, "gap", g_settings_get_uint (self->tiling, "inner-gaps"));
+  cc_luma_fixture_publish_boolean (self->model, "edgeTile", g_settings_get_boolean (self->tiling, "active-screen-edges"));
+}
+
+static gpointer
+windows_start (CcLumaFixture *model)
+{
+  Windows *self = g_new0 (Windows, 1);
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) shell = source ? g_settings_schema_source_lookup (source, "org.gnome.shell", TRUE) : NULL;
+  self->model = g_object_ref (model);
+  self->cancel = g_cancellable_new ();
+  self->table = cc_luma_gs_table_new (model, rows, G_N_ELEMENTS (rows));
+  if (shell && g_settings_schema_has_key (shell, "enabled-extensions") && g_settings_schema_has_key (shell, "disabled-extensions"))
+    self->tiling = tiling_settings ();
+  if (self->tiling)
+    {
+      self->shell = g_settings_new ("org.gnome.shell");
+      g_signal_connect_swapped (self->shell, "changed::enabled-extensions", G_CALLBACK (publish_tiling), self);
+      g_signal_connect_swapped (self->shell, "changed::disabled-extensions", G_CALLBACK (publish_tiling), self);
+      g_signal_connect_swapped (self->tiling, "changed", G_CALLBACK (publish_tiling), self);
+      cc_luma_fixture_own_key (model, "tile");
+      cc_luma_fixture_own_key (model, "gap");
+      cc_luma_fixture_own_key (model, "edgeTile");
+      publish_tiling (self);
+    }
+  cc_luma_live_publish_dock (model);
+  cc_luma_live_desk_dump_watch (model);
+  self->gate = cc_luma_ready_gate_new (model, "windows", cc_luma_windows_validate);
+  return self;
+}
+
+static void
+extension_called (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  gboolean done = FALSE;
+  if (reply) g_variant_get (reply, "(b)", &done);
+  if (!done && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    {
+      g_warning ("Settings live: GNOME Shell did not switch tiling: %s", error ? error->message : "refused");
+      /* Show what the shell has, not what was asked for. */
+      publish_tiling (data);
+    }
+}
+
+static gboolean
+windows_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Windows *self = state;
+  if (cc_luma_gs_table_covers (self->table, key))
+    return cc_luma_gs_table_write (self->table, key, value, error);
+  if (!self->tiling || !(g_str_equal (key, "tile") || g_str_equal (key, "gap") || g_str_equal (key, "edgeTile")))
+    return FALSE;
+  GType type = JSON_NODE_HOLDS_VALUE (value) ? json_node_get_value_type (value) : G_TYPE_INVALID;
+  if (g_str_equal (key, "gap"))
+    {
+      gint64 gap = type == G_TYPE_INT64 ? json_node_get_int (value) : -1;
+      if (gap < 0 || gap > G_MAXINT32)
+        {
+          g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "gap can’t take that value");
+          return FALSE;
+        }
+      if (!g_settings_is_writable (self->tiling, "inner-gaps"))
+        {
+          g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "gap is locked by policy");
+          return FALSE;
+        }
+      return g_settings_set_uint (self->tiling, "inner-gaps", (guint) gap);
+    }
+  if (type != G_TYPE_BOOLEAN)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "%s can’t take that value", key);
+      return FALSE;
+    }
+  if (g_str_equal (key, "edgeTile"))
+    {
+      if (!g_settings_is_writable (self->tiling, "active-screen-edges"))
+        {
+          g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "edgeTile is locked by policy");
+          return FALSE;
+        }
+      return g_settings_set_boolean (self->tiling, "active-screen-edges", json_node_get_boolean (value));
+    }
+  /* The same call the Quick Options tiling toggle makes. */
+  g_autoptr (GDBusConnection) bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, error);
+  if (!bus) return FALSE;
+  g_dbus_connection_call (bus, "org.gnome.Shell.Extensions", "/org/gnome/Shell/Extensions", "org.gnome.Shell.Extensions",
+                          json_node_get_boolean (value) ? "EnableExtension" : "DisableExtension",
+                          g_variant_new ("(s)", TILING_UUID), G_VARIANT_TYPE ("(b)"),
+                          G_DBUS_CALL_FLAGS_NO_AUTO_START, -1, self->cancel, extension_called, self);
+  return TRUE;
+}
+
+static void
+windows_stop (gpointer state)
+{
+  Windows *self = state;
+  g_cancellable_cancel (self->cancel);
+  g_clear_object (&self->cancel);
+  cc_luma_ready_gate_free (self->gate);
+  cc_luma_gs_table_free (self->table);
+  if (self->shell) g_signal_handlers_disconnect_by_data (self->shell, self);
+  if (self->tiling) g_signal_handlers_disconnect_by_data (self->tiling, self);
+  g_clear_object (&self->shell);
+  g_clear_object (&self->tiling);
+  g_object_unref (self->model);
+  g_free (self);
+}
+
+const CcLumaAdapter cc_luma_adapter_windows = {
+  "windows", (const char * const[]) { "windows", NULL }, windows_start, windows_write, windows_stop
+};
diff --git a/shell/cc-luma-live.c b/shell/cc-luma-live.c
