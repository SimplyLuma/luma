diff --git a/shell/test-luma-apps-list.c b/shell/test-luma-apps-list.c
new file mode 100644
index 0000000..acff916
--- /dev/null
+++ b/shell/test-luma-apps-list.c
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* The Apps page with 150 apps: the Installed list recycles its rows (the
+ * row widgets made stay bounded while scrolling to the end), a redraw that
+ * doesn't change the apps keeps the list, and the timings are logged. */
+#include "cc-luma-view-private.h"
+#include <luma-ui.h>
+
+guint cc_luma_view_apps_row_widgets (GtkWidget *root);
+
+static void drain_for (int ms)
+{
+  gint64 deadline = g_get_monotonic_time () + ms * 1000;
+  while (g_get_monotonic_time () < deadline) { while (g_main_context_iteration (NULL, FALSE)) {} g_usleep (1000); }
+}
+
+static GtkWidget *find_name (GtkWidget *root, const char *name)
+{
+  if (g_strcmp0 (gtk_widget_get_name (root), name) == 0) return root;
+  for (GtkWidget *c = gtk_widget_get_first_child (root); c; c = gtk_widget_get_next_sibling (c))
+    { GtkWidget *found = find_name (c, name); if (found) return found; }
+  return NULL;
+}
+
+/* v70's fixture with its apps repeated to 150 (filer, filer-2 … ). */
+static CcLumaFixture *load_many (guint count)
+{
+  g_autoptr (GError) error = NULL;
+  CcLumaFixture *model = cc_luma_fixture_load (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), &error);
+  g_assert_no_error (error);
+  JsonObject *data = cc_luma_fixture_get_data (model);
+  JsonArray *apps = json_object_get_array_member (data, "CFAPPS");
+  JsonObject *info = json_object_get_object_member (data, "CFAPPINFO");
+  JsonObject *sizes = json_object_get_object_member (data, "CFSZ");
+  JsonObject *cats = json_object_get_object_member (data, "CFAPPCATS");
+  guint base = json_array_get_length (apps);
+  for (guint i = base; i < count; i++)
+    {
+      const char *from = json_array_get_string_element (apps, i % base);
+      g_autofree char *id = g_strdup_printf ("%s-%u", from, i);
+      g_autofree char *name = g_strdup_printf ("%s %u", json_object_get_string_member (json_object_get_object_member (info, from), "name"), i);
+      JsonObject *entry = json_object_new ();
+      json_object_set_string_member (entry, "name", name);
+      json_object_set_object_member (info, id, entry);
+      json_object_set_array_member (sizes, id, json_array_ref (json_object_get_array_member (sizes, from)));
+      if (json_object_has_member (cats, from)) json_object_set_string_member (cats, id, json_object_get_string_member (cats, from));
+      json_array_add_string_element (apps, id);
+    }
+  return model;
+}
+
+static void recycles (void)
+{
+  g_autoptr (CcLumaFixture) model = load_many (150);
+  GtkWidget *window = gtk_window_new ();
+  gtk_window_set_default_size (GTK_WINDOW (window), 1180, 740);
+  gint64 t0 = g_get_monotonic_time ();
+  GtkWidget *view = cc_luma_view_new (model, "apps", NULL);
+  g_assert_nonnull (view);
+  gint64 built = g_get_monotonic_time ();
+  gtk_window_set_child (GTK_WINDOW (window), view);
+  gtk_window_present (GTK_WINDOW (window));
+  drain_for (400);
+  GtkWidget *root = view;
+  guint made = cc_luma_view_apps_row_widgets (root);
+  g_test_message ("apps list: build %.1f ms, %u row widgets for 150 apps", (built - t0) / 1000.0, made);
+  g_assert_cmpuint (made, >, 0);
+  g_assert_cmpuint (made, <=, 40);
+  g_assert_nonnull (find_name (view, "cf-go-app:filer"));
+  /* Scroll to the end: the last app is drawn by the same few rows. */
+  GtkWidget *scroller = gtk_widget_get_ancestor (find_name (view, "cf-apps-list"), GTK_TYPE_SCROLLED_WINDOW);
+  g_assert_nonnull (scroller);
+  GtkAdjustment *adj = gtk_scrolled_window_get_vadjustment (GTK_SCROLLED_WINDOW (scroller));
+  gint64 s0 = g_get_monotonic_time ();
+  for (double y = 0; y <= gtk_adjustment_get_upper (adj); y += 120)
+    {
+      gtk_adjustment_set_value (adj, y);
+      drain_for (2);
+    }
+  gtk_adjustment_set_value (adj, gtk_adjustment_get_upper (adj));
+  drain_for (200);
+  g_test_message ("apps list: scrolled to the end in %.1f ms, %u row widgets", (g_get_monotonic_time () - s0) / 1000.0,
+                  cc_luma_view_apps_row_widgets (root));
+  g_assert_cmpuint (cc_luma_view_apps_row_widgets (root), <=, 40);
+  JsonArray *apps = json_object_get_array_member (cc_luma_fixture_get_data (model), "CFAPPS");
+  g_autofree char *last = g_strconcat ("cf-go-app:", json_array_get_string_element (apps, json_array_get_length (apps) - 1), NULL);
+  g_assert_nonnull (find_name (view, last));
+  g_assert_null (find_name (view, "cf-go-app:filer"));
+  /* A redraw with the same apps keeps the list and its rows. */
+  GtkWidget *list = find_name (view, "cf-apps-list");
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  g_assert_nonnull (v);
+  gtk_adjustment_set_value (adj, gtk_adjustment_get_upper (adj) / 2);
+  drain_for (100);
+  double before = gtk_adjustment_get_value (adj);
+  gint64 r0 = g_get_monotonic_time ();
+  cc_luma_view_queue_refresh (v);
+  drain_for (100);
+  g_test_message ("apps list: redraw kept the list, %.1f ms incl. 100 ms of frames; scroll %.0f -> %.0f",
+                  (g_get_monotonic_time () - r0) / 1000.0, before, gtk_adjustment_get_value (adj));
+  g_assert_true (find_name (view, "cf-apps-list") == list);
+  /* An owner's report while scrolling leaves the page where it was. */
+  g_assert_cmpfloat_with_epsilon (gtk_adjustment_get_value (adj), before, 1.0);
+  gtk_window_destroy (GTK_WINDOW (window));
+}
+
+/* v70's 18 apps keep the plain rows (the conformed anatomy). */
+static void few_apps_plain (void)
+{
+  g_autoptr (CcLumaFixture) model = load_many (18);
+  g_autoptr (GtkWidget) view = g_object_ref_sink (cc_luma_view_new (model, "apps", NULL));
+  g_assert_nonnull (find_name (view, "cf-go-app:depot"));
+  g_assert_null (find_name (view, "cf-apps-list"));
+  g_assert_cmpuint (cc_luma_view_apps_row_widgets (view), ==, 0);
+}
+
+int main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  gtk_init ();
+  g_test_add_func ("/luma-settings/apps/recycles", recycles);
+  g_test_add_func ("/luma-settings/apps/few-apps-plain", few_apps_plain);
+  return g_test_run ();
+}
