diff --git a/shell/luma-live-conn-probe.c b/shell/luma-live-conn-probe.c
new file mode 100644
index 0000000..1ee860f
--- /dev/null
+++ b/shell/luma-live-conn-probe.c
@@ -0,0 +1,139 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* A read-only look at a real machine's connectivity pages: the Wi‑Fi,
+ * network and Bluetooth adapters fill a live model, the pages draw it, and
+ * each page is saved as a PNG next to the model (passwords redacted).
+ *   luma-live-conn-probe OUT-DIR
+ * Nothing is changed: the model refuses every write (so the Bluetooth page's
+ * discovery lease never reaches BlueZ), no pairing agent is registered, and
+ * saved Wi‑Fi passwords are never requested. Run it on a private display and
+ * session bus (mutter --headless under dbus-run-session). */
+#include "cc-luma-live.h"
+#include "cc-luma-view.h"
+#include <NetworkManager.h>
+#include <luma-ui.h>
+
+extern const CcLumaAdapter cc_luma_adapter_network, cc_luma_adapter_airplane, cc_luma_adapter_proxy, cc_luma_adapter_bluetooth;
+
+/* Never ask NetworkManager for a saved password (the share code needs one). */
+void
+nm_remote_connection_get_secrets_async (NMRemoteConnection *connection, const char *setting_name,
+                                        GCancellable *cancellable, GAsyncReadyCallback callback, gpointer user_data)
+{
+  g_task_report_new_error (connection, callback, user_data, nm_remote_connection_get_secrets_async,
+                           G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "read-only probe");
+}
+GVariant *
+nm_remote_connection_get_secrets_finish (NMRemoteConnection *connection, GAsyncResult *result, GError **error)
+{
+  return g_task_propagate_pointer (G_TASK (result), error);
+}
+
+static gboolean
+refuse (CcLumaFixture *model, const char *key, JsonNode *value, gpointer data, GError **error)
+{
+  g_message ("probe: refused a write of %s", key);
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Read-only probe: %s is not changed", key);
+  return FALSE;
+}
+
+static void
+wait_ms (guint ms)
+{
+  gint64 end = g_get_monotonic_time () + ms * 1000;
+  while (g_get_monotonic_time () < end) g_main_context_iteration (NULL, FALSE), g_usleep (10000);
+}
+
+static void
+save_page (CcLumaFixture *model, const char *page, const char *dir)
+{
+  g_autoptr (GError) error = NULL;
+  GtkWidget *view = cc_luma_view_new (model, page, &error);
+  if (!view) { g_printerr ("%s: %s\n", page, error->message); return; }
+  GtkWidget *window = gtk_window_new ();
+  gtk_window_set_default_size (GTK_WINDOW (window), 944, 740);
+  gtk_window_set_child (GTK_WINDOW (window), view);
+  gtk_window_present (GTK_WINDOW (window));
+  wait_ms (2500);
+  g_autoptr (GdkPaintable) paintable = gtk_widget_paintable_new (view);
+  int w = gtk_widget_get_width (view), h = gtk_widget_get_height (view);
+  g_autoptr (GtkSnapshot) snapshot = gtk_snapshot_new ();
+  gdk_paintable_snapshot (paintable, snapshot, w, h);
+  g_autoptr (GskRenderNode) node = gtk_snapshot_free_to_node (g_steal_pointer (&snapshot));
+  if (node)
+    {
+      g_autoptr (GdkTexture) texture = gsk_renderer_render_texture (gtk_native_get_renderer (GTK_NATIVE (window)), node,
+                                                                    &GRAPHENE_RECT_INIT (0, 0, w, h));
+      g_autofree char *path = g_strdup_printf ("%s/%s.png", dir, page);
+      gdk_texture_save_to_png (texture, path);
+      g_print ("saved %s (%dx%d)\n", path, w, h);
+    }
+  gtk_window_destroy (GTK_WINDOW (window));
+  wait_ms (200);
+}
+
+static void
+redact (JsonObject *data)
+{
+  JsonObject *wifi = json_object_get_object_member (data, "CFWIFI");
+  JsonObject *codes = wifi ? json_object_get_object_member (wifi, "share_codes") : NULL;
+  if (wifi) json_object_set_string_member (wifi, "share_password", "(redacted)");
+  g_autoptr (GList) names = codes ? json_object_get_members (codes) : NULL;
+  for (GList *m = names; m; m = m->next)
+    if (*json_object_get_string_member (codes, m->data)) json_object_set_string_member (codes, m->data, "(svg)");
+}
+
+int
+main (int argc, char **argv)
+{
+  const CcLumaAdapter *adapters[] = { &cc_luma_adapter_network, &cc_luma_adapter_airplane, &cc_luma_adapter_proxy, &cc_luma_adapter_bluetooth };
+  gpointer states[G_N_ELEMENTS (adapters)];
+  const char *dir = argc > 1 ? argv[1] : ".";
+  g_autoptr (GError) error = NULL;
+  gtk_init ();
+  luma_init ();
+  luma_ui_add_style_resource ("/org/gnome/Settings/gtk/luma-settings.css", GTK_STYLE_PROVIDER_PRIORITY_APPLICATION);
+  g_autoptr (GBytes) bytes = g_resources_lookup_data ("/org/gnome/Settings/gtk/luma-settings-structure.json", 0, &error);
+  g_autoptr (JsonParser) parser = json_parser_new ();
+  if (!bytes || !json_parser_load_from_data (parser, g_bytes_get_data (bytes, NULL), g_bytes_get_size (bytes), &error))
+    { g_printerr ("%s\n", error->message); return 1; }
+  g_autoptr (CcLumaFixture) model = cc_luma_fixture_new_live (json_parser_get_root (parser));
+  cc_luma_fixture_set_writer (model, refuse, NULL);
+  for (guint i = 0; i < G_N_ELEMENTS (adapters); i++) states[i] = adapters[i]->start (model);
+  wait_ms (6000);
+  const char *net = cc_luma_fixture_get (model, "net") ? json_node_get_string (cc_luma_fixture_get (model, "net")) : "";
+  const char *pages[] = { "wifi", "wifi-known", "hotspot", "network", "bluetooth", *net ? "wifi-net" : NULL };
+  for (guint i = 0; i < G_N_ELEMENTS (pages) && pages[i]; i++) save_page (model, pages[i], dir);
+  for (guint i = 0; i < G_N_ELEMENTS (adapters); i++) adapters[i]->stop (states[i]);
+  /* The model as the pages saw it, without passwords. */
+  g_autofree char *text = NULL;
+  {
+    JsonObject *data = cc_luma_fixture_get_data (model);
+    redact (data);
+    g_autoptr (JsonBuilder) b = json_builder_new ();
+    const char *keys[] = { "wifi", "net", "airplane", "hotspot", "hsName", "hsBand", "autoJoin", "allUsers", "metered",
+                           "eth", "vpn", "proxy", "bt", "devName" };
+    const char *lists[] = { "CFNETS", "CFKNOWN", "CFWIFI", "CFBT", "CFNEAR" };
+    json_builder_begin_object (b);
+    for (guint i = 0; i < G_N_ELEMENTS (keys); i++)
+      {
+        JsonNode *n = cc_luma_fixture_get (model, keys[i]);
+        json_builder_set_member_name (b, keys[i]);
+        json_builder_add_value (b, n ? json_node_copy (n) : json_node_init_null (json_node_alloc ()));
+      }
+    json_builder_set_member_name (b, "hsPass");
+    json_builder_add_string_value (b, "(redacted)");
+    for (guint i = 0; i < G_N_ELEMENTS (lists); i++)
+      {
+        JsonNode *n = json_object_get_member (data, lists[i]);
+        json_builder_set_member_name (b, lists[i]);
+        json_builder_add_value (b, n ? json_node_copy (n) : json_node_init_null (json_node_alloc ()));
+      }
+    json_builder_end_object (b);
+    g_autoptr (JsonNode) out = json_builder_get_root (b);
+    text = json_to_string (out, TRUE);
+  }
+  g_autofree char *path = g_build_filename (dir, "model.json", NULL);
+  g_file_set_contents (path, text, -1, NULL);
+  g_print ("saved %s\n", path);
+  return 0;
+}
diff --git a/shell/luma-settings-desktop.css b/shell/luma-settings-desktop.css
new file mode 100644
index 0000000..805bd87
--- /dev/null
+++ b/shell/luma-settings-desktop.css
@@ -0,0 +1,81 @@
+/* Settings' desktop pages: page-only surfaces (heroes). Tokens only.
+ * The desktop diagrams (mini windows, shelves, the notification lip) are
+ * always dark like the real shelf, so they use the media tokens. */
+
+/* v70 rCu rows */
+.cf-row.cu.pad { min-height: 26px; padding: 12px 16px 14px; } /* v70 rows are 52 px tall at least */
+
+/* Appearance: .cfstyles */
+button.cf-style { min-height: 0; min-width: 0; padding: 8px 8px 10px; border-radius: 16px;
+  background: none; box-shadow: none; color: @luma_ink; }
+button.cf-style:hover { background: @luma_hover; }
+button.cf-style.on { background: @luma_chip;
+  box-shadow: inset 0 1px 0 @luma_chip_highlight, 0 0 0 1px @luma_chip_ring, 0 1px 2px @luma_chip_shadow, 0 3px 8px -3px @luma_chip_drop; }
+button.cf-style.phone { padding: 6px 6px 8px; } /* v71 phone .cfstyle */
+.cf-style-name { font-size: 12.5px; font-weight: 500; line-height: 18px; color: @luma_ink; }
+.cf-mini { border-radius: 11px; }
+.cf-edge { box-shadow: inset 0 0 0 1px alpha(black, .2); }
+.cf-mini > .cf-edge { border-radius: 11px; }
+.cf-mini-w { border-radius: 8px; box-shadow: 0 6px 16px alpha(black, .35); }
+.cf-mini-parts { padding: 5px; }
+.cf-mini-side { border-radius: 4px; }
+.cf-mini-content { border-radius: 5px; }
+.cf-mini.light .cf-mini-w { background: mix(@luma_on_media, @luma_media_ink, .3); }
+.cf-mini.light .cf-mini-content { background: @luma_media_ink; }
+.cf-mini.dark .cf-mini-w { background: mix(@luma_media_well, @luma_media_surface, .6); }
+.cf-mini.dark .cf-mini-content { background: mix(@luma_media_surface, @luma_media_chip, .52); }
+.cf-mini-acc { border-radius: 3px; }
+.cf-mini-shelf { border-radius: 4px; background: @luma_media_surface; }
+
+/* Appearance: accents and backgrounds */
+.cf-accs { padding: 5px 2px; }
+button.cf-acc { min-width: 28px; min-height: 28px; padding: 0; border-radius: 999px; box-shadow: none; }
+button.cf-wall { min-width: 0; min-height: 0; padding: 0; border-radius: 10px; background: none;
+  box-shadow: inset 0 0 0 1px alpha(black, .15); }
+button.cf-wall.add { background: @luma_well; color: @luma_muted;
+  box-shadow: inset 0 0 0 1px @luma_well_ring, inset 0 1px 2px @luma_well_shade, 0 1px 0 @luma_well_lip; }
+button.cf-wall.add image { -gtk-icon-size: 18px; }
+
+/* Shelf: .cfdesk and .cfsh (the miniature shelf is always dark) */
+.cf-desk, .cf-tiles, .cf-lip { border-radius: 12px; }
+.cf-desk > .cf-edge, .cf-tiles > .cf-edge, .cf-lip > .cf-edge { border-radius: 12px; }
+.cf-sh { padding: 5px; border-radius: 10px; background: @luma_media_surface;
+  box-shadow: 0 6px 16px alpha(black, .35), inset 0 0 0 1px alpha(white, .04); }
+.cf-sh-app { border-radius: 5px; }
+.cf-clk { padding: 0 7px; font-size: 11px; font-weight: 600; letter-spacing: 0.11px; color: @luma_media_ink; font-feature-settings: "tnum"; }
+.cf-sh.sh-left .cf-clk, .cf-sh.sh-right .cf-clk { padding: 3px 0; font-size: 9.5px; letter-spacing: 0.095px; }
+.cf-sh.sh-h.sh-at { border-radius: 10px 10px 0 0; }
+.cf-sh.sh-h.sh-at.sh-end { border-radius: 10px 0 0 0; }
+.cf-sh.sh-h.sh-top.sh-at { border-radius: 0 0 10px 10px; }
+.cf-sh.sh-left.sh-at { border-radius: 0 10px 10px 0; }
+.cf-sh.sh-right.sh-at { border-radius: 10px 0 0 10px; }
+.cf-sh.sh-full.sh-at { border-radius: 0; }
+
+/* Shelf: .cfpres */
+.cf-pres { margin: 14px 0 -4px; }
+.cf-pres > button { min-height: 30px; min-width: 0; padding: 0 12px; border-radius: 10px; background: none; box-shadow: none;
+  font-size: 12.5px; font-weight: 500; color: @luma_ink_secondary; }
+.cf-pres > button:hover { background: @luma_hover; }
+.cf-pres > button.on { background: @luma_chip; color: @luma_ink;
+  box-shadow: inset 0 1px 0 @luma_chip_highlight, 0 0 0 1px @luma_chip_ring, 0 1px 2px @luma_chip_shadow, 0 3px 8px -3px @luma_chip_drop; }
+
+/* Windows: .cftiles */
+.cf-tile { border-radius: 7px; background: alpha(@luma_content, .95); box-shadow: 0 5px 14px alpha(black, .3); }
+
+/* Notifications: .cflip (the top edge is always dark, like the shelf) */
+.cf-lip-edge { border-radius: 0 0 10px 10px; background: @luma_media_surface; color: @luma_media_ink_secondary; }
+.cf-lip-edge image { -gtk-icon-size: 12px; }
+.cf-lip-count { font-size: 11px; letter-spacing: 0.11px; color: @luma_media_ink_secondary; }
+.cf-cardn { padding: 10px 12px; border-radius: 14px; background: @luma_media_surface; box-shadow: 0 10px 24px alpha(black, .35); }
+.cf-cardn-from { font-size: 12.5px; font-weight: 700; line-height: 18px; color: @luma_media_ink; }
+.cf-cardn-text { font-size: 11.5px; line-height: 17px; letter-spacing: 0.115px; color: @luma_notice_ink_secondary; }
+.cf-cardn-when { font-size: 11px; line-height: 16px; letter-spacing: 0.11px; color: @luma_notice_muted; }
+
+/* Search: .cfgrip and .cfswb */
+.cf-grip { min-width: 14px; margin: 0 -4px 0 -6px; color: @luma_faint; }
+.cf-grip image { -gtk-icon-size: 14px; }
+button.cf-swb { min-height: 0; min-width: 0; padding: 4px; margin: -4px; border-radius: 10px; background: none; box-shadow: none; }
+button.cf-swb:hover { background: @luma_hover; }
+
+/* v70 #w-settings.phone .cfrg input { width: 140px } */
+.cf-rg.phone scale { min-width: 140px; }
diff --git a/shell/luma-settings-devices.css b/shell/luma-settings-devices.css
new file mode 100644
index 0000000..301eef1
--- /dev/null
+++ b/shell/luma-settings-devices.css
@@ -0,0 +1,109 @@
+/* Settings' devices pages: page-only surfaces (heroes). Tokens only. */
+
+/* Hero parts shared by Displays, Mouse and Keyboard (v70 .cfjoin, .cfhint, .cfdayl) */
+.cf-hero .cf-join { margin-top: -4px; }
+.cf-hint { margin: 10px 0 -4px; font-size: 12px; letter-spacing: 0.12px; color: @luma_muted; }
+.cf-hint-faint { color: @luma_faint; }
+.cf-dayl { margin-top: 6px; font-size: 10.5px; letter-spacing: 0.105px; color: @luma_faint; }
+
+/* v70 #w-settings.phone .cfrg input { width: 140px } */
+.cf-rg scale.cf-phone { min-width: 140px; }
+
+/* Chooser cards (v70 .cfmode, .cfout) */
+.cf-modes { margin-top: 18px; }
+button.cf-choice { padding: 12px 14px; border-radius: 14px; background: none; box-shadow: none; color: @luma_ink; font-weight: inherit; }
+button.cf-choice:hover { background: @luma_hover; }
+button.cf-choice.on { background: @luma_chip;
+  box-shadow: inset 0 1px 0 @luma_chip_highlight, 0 0 0 1px @luma_chip_ring, 0 1px 2px @luma_chip_shadow, 0 3px 8px -3px @luma_chip_drop; }
+button.cf-choice image { -gtk-icon-size: 18px; margin-bottom: 6px; color: @luma_muted; }
+button.cf-choice.on image { color: @luma_ink; }
+.cf-card-title { font-size: 13px; font-weight: 600; }
+.cf-card-sub { font-size: 11.5px; letter-spacing: 0.115px; color: @luma_muted; }
+
+/* Displays (v70 .cfarr, .cfmon) */
+.cf-arr { min-height: 216px; margin-top: 8px; }
+button.cf-mon { padding: 0; border-radius: 9px; background: @luma_chip; color: @luma_ink; font-weight: inherit;
+  box-shadow: inset 0 1px 0 @luma_chip_highlight, 0 0 0 1px @luma_chip_ring, 0 1px 2px @luma_chip_shadow, 0 3px 8px -3px @luma_chip_drop; }
+button.cf-mon.on { box-shadow: inset 0 1px 0 @luma_chip_highlight, 0 0 0 1px @luma_chip_ring, 0 1px 2px @luma_chip_shadow, 0 3px 8px -3px @luma_chip_drop, 0 0 0 2px @luma_accent; }
+.cf-mon-title { font-size: 12.5px; font-weight: 600; }
+.cf-mon-sub { min-height: 13px; font-size: 11px; letter-spacing: 0.11px; color: @luma_muted; }
+.cf-row.locked .cf-t { opacity: .5; }
+
+/* Night Light (v70 .cfnl) */
+.cf-temp { min-height: 14px; border-radius: 7px;
+  background-image: linear-gradient(90deg, #c1dcf0, #ede8d9, #f6ab6b, #ed7940); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.1); }
+.cf-temp-mark { min-width: 6px; min-height: 22px; border-radius: 3px; background: white; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4); }
+.cf-day { min-height: 26px; margin-top: 18px; border-radius: 8px; background: alpha(@luma_amber, 0.2); }
+.cf-night { background: rgba(68, 82, 130, 0.55); }
+.cf-now-mark { min-width: 2px; min-height: 26px; background: @luma_ink; }
+
+/* Sound (v70 .cfouts, .cfvol, .cfmeter) */
+.cf-vol { margin-top: 18px; padding: 0 4px; }
+.cf-vol > image { -gtk-icon-size: 18px; color: @luma_ink_secondary; }
+.cf-vol > .cf-out { min-width: 40px; }
+.cf-meter { min-height: 5px; margin: 10px 56px 0 34px; }
+.cf-meter > box { border-radius: 2px; background: @luma_control_fill; }
+.cf-meter > box.on { background: @luma_good; }
+.cf-meter.in { min-width: 170px; margin: 0; }
+
+/* Power (v70 .cfbat, .cfcell, .cfbars) */
+.cf-cell { min-width: 124px; min-height: 46px; padding: 4px; border-radius: 13px; box-shadow: inset 0 0 0 2px @luma_faint; }
+.cf-cell-fill { border-radius: 9px; background: @luma_good; box-shadow: 0 0 16px alpha(@luma_good, 0.35); }
+.cf-cell-nub { min-width: 4px; min-height: 18px; margin: 0 -7px 0 3px; border-radius: 0 3px 3px 0; background: @luma_faint; }
+.cf-batt-level { font-size: 28px; font-weight: 700; letter-spacing: -0.56px; line-height: 31px; }
+.cf-batt-left { font-size: 12.5px; color: @luma_muted; }
+.cf-daych { margin-top: 16px; }
+.cf-bars { min-height: 58px; }
+.cf-bars > box { border-radius: 3px 3px 2px 2px; background: alpha(@luma_faint, 0.75); }
+.cf-bars > box.chg { background: alpha(@luma_good, 0.8); }
+.cf-bars > box.fut { background: @luma_control_fill; }
+
+/* Mouse & Touchpad (v70 .cfdemo, .cfmouse, .cfpad, .cfpg, .cfdl) */
+.cf-demo { margin-top: 16px; }
+.cf-mouse { min-width: 72px; min-height: 116px; border-radius: 36px 36px 32px 32px; background: @luma_content; box-shadow: inset 0 0 0 1.5px @luma_faint; }
+.cf-mouse .l, .cf-mouse .r { min-height: 46px; }
+.cf-mouse .l { box-shadow: inset -0.75px -1.5px 0 @luma_faint; }
+.cf-mouse .r { box-shadow: inset 0.75px -1.5px 0 @luma_faint; }
+.cf-mouse.left .l, .cf-mouse.right .r { background: alpha(@luma_accent, 0.3); }
+.cf-wheel { min-width: 6px; min-height: 18px; margin: 14px 0 0 33px; border-radius: 3px;
+  background-image: repeating-linear-gradient(180deg, @luma_muted 0, @luma_muted 2px, transparent 2px, transparent 4px); }
+.cf-pad { min-width: 190px; min-height: 120px; border-radius: 14px; background: @luma_content; box-shadow: inset 0 0 0 1px @luma_line, 0 1px 0 @luma_island_lip; }
+.cf-pad.off { opacity: .4; }
+/* Fingers and page lines sit where v70's frozen animation frame has them. */
+.cf-finger { min-width: 16px; min-height: 16px; margin-top: 51px; border-radius: 999px; background: alpha(@luma_accent, 0.35); box-shadow: inset 0 0 0 1.5px @luma_accent; }
+.cf-finger.f1 { margin-left: 78px; }
+.cf-finger.f2 { margin-left: 100px; }
+.cf-finger.off { opacity: 0; }
+.cf-pg { min-width: 118px; min-height: 120px; border-radius: 11px; background: @luma_content; box-shadow: inset 0 0 0 1px @luma_line; }
+.cf-pg-lines { padding: 12px; margin-top: -20px; }
+.cf-pg-line { min-height: 7px; margin-bottom: 8px; border-radius: 3px; background: alpha(@luma_ink, 0.14); }
+.cf-pg-line.pic { min-height: 22px; background: alpha(@luma_accent, 0.35); }
+.cf-dl-title { font-size: 13px; font-weight: 600; }
+.cf-dl-sub { margin-top: 2px; font-size: 12px; letter-spacing: 0.12px; color: @luma_muted; }
+
+/* Keyboard (v70 .cfkb, .cfkr kbd, .cfgrip, .cfkeys) */
+.cf-key { min-height: 31px; border-radius: 7px; background: @luma_chip; color: @luma_ink_secondary; font-size: 12px; font-weight: 500; letter-spacing: 0.12px;
+  box-shadow: inset 0 1px 0 @luma_chip_highlight, 0 0 0 1px @luma_chip_ring, 0 1px 2px @luma_chip_shadow, 0 3px 8px -3px @luma_chip_drop; }
+.cf-key.wd { font-size: 10.5px; letter-spacing: 0.105px; color: @luma_muted; }
+.cf-key.wd.phone { font-size: 9px; letter-spacing: 0; } /* Nick, 30 Sep: a key's word fits its key on a phone */
+/* v70 .cfkr kbd.k1 / .k2: oklch(0.66 0.13 acc / .3) and oklch(0.78 0.13 80 / .3), on the accent and amber hues */
+.cf-key.k1, .cf-k1 { background: oklch(from @luma_accent 0.66 0.13 h / 0.3); color: @luma_ink; }
+.cf-key.k2, .cf-k2 { background: oklch(from @luma_amber 0.78 0.13 h / 0.3); color: @luma_ink; }
+.cf-k1, .cf-k2 { min-width: 10px; min-height: 10px; border-radius: 3px; box-shadow: none; }
+.cf-grip { min-width: 14px; margin: 0 -4px 0 -6px; }
+.cf-grip image { -gtk-icon-size: 14px; color: @luma_faint; }
+button.cf-ib { min-width: 36px; min-height: 36px; padding: 0; border-radius: 10px; background: none; box-shadow: none; color: @luma_ink_secondary; }
+button.cf-ib:hover { background: @luma_hover; }
+.cf-row.cf-addwrap { padding: 4px 8px; background-position: 0 -4px; }
+button.cf-keys { min-height: 30px; padding: 0 4px; border-radius: 9px; background: none; box-shadow: none; font-size: 12px; font-weight: 400; letter-spacing: 0.12px; color: @luma_muted; }
+button.cf-keys:hover { background: @luma_hover; }
+button.cf-keys.edit { padding: 0 12px; background: alpha(@luma_accent, 0.2); color: @luma_ink; }
+.cf-kbd { min-width: 10px; min-height: 24px; padding: 0 7px; border-radius: 6px; background: @luma_chip; color: @luma_ink_secondary; font-size: 11.5px; font-weight: 500; letter-spacing: 0.115px;
+  box-shadow: inset 0 1px 0 @luma_chip_highlight, 0 0 0 1px @luma_chip_ring, 0 1px 2px @luma_chip_shadow, 0 3px 8px -3px @luma_chip_drop; }
+
+/* Printers (v70 .cfprn, .cfbadge, .cftoner) */
+.cf-badge { min-width: 56px; min-height: 56px; border-radius: 16px; background: @luma_chip;
+  box-shadow: inset 0 1px 0 @luma_chip_highlight, 0 0 0 1px @luma_chip_ring, 0 1px 2px @luma_chip_shadow, 0 3px 8px -3px @luma_chip_drop; }
+.cf-badge image { -gtk-icon-size: 26px; color: @luma_ink_secondary; }
+.cf-dot { min-width: 7px; min-height: 7px; border-radius: 999px; background: @luma_good; box-shadow: 0 0 8px @luma_good; }
+.cf-toner { margin-top: 10px; font-size: 11.5px; letter-spacing: 0.115px; color: @luma_muted; }
