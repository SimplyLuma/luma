+/* v71 on a phone (Settings audit, 1 Oct; LUMA_FORM_FACTOR=phone at 402×874): a segmented choice drops under its
+ * label, the Appearance previews share the width in two equal columns, and, with the kit's title island, the page's
+ * name, summary and ‹ live in the island instead of the page. */
+static void load_settings_style (void);
+static GtkWidget *phone_window (GtkWidget *view)
+{
+  GtkWidget *window = gtk_window_new ();
+  gtk_window_set_default_size (GTK_WINDOW (window), 402, 874);
+  gtk_window_set_child (GTK_WINDOW (window), view);
+  /* The first frame is drawn before the phone breakpoint applies (the sweep tolerates it too); after it, the page fits. */
+  GLogLevelFlags fatal = g_log_set_always_fatal (G_LOG_FATAL_MASK);
+  gtk_window_present (GTK_WINDOW (window)); wait_ms (300);
+  g_log_set_always_fatal (fatal);
+  int min = 0;
+  gtk_widget_measure (view, GTK_ORIENTATION_HORIZONTAL, -1, &min, NULL, NULL, NULL);
+  g_assert_cmpint (min, <=, 402);
+  gtk_widget_queue_resize (view); wait_ms (50); /* a fatal layout warning now would be the page's own */
+  return window;
+}
+static void phone_device (void)
+{
+  g_autoptr (CcLumaFixture) model = load ();
+  graphene_rect_t a, b, row, hero;
+  g_setenv ("LUMA_FORM_FACTOR", "phone", TRUE);
+  load_settings_style ();
+
+  /* Mouse & Touchpad: "Scroll with" and its choices, the choices on their own line, from the row's start. */
+  GtkWidget *view = cc_luma_view_new (model, "mouse", NULL);
+  GtkWidget *window = phone_window (view);
+  GtkWidget *seg = find_name (view, "cf-tScroll");
+  g_assert_true (LUMA_IS_MODE_SWITCH (seg));
+  GtkWidget *line = gtk_widget_get_parent (gtk_widget_get_parent (seg));
+  GtkWidget *words = gtk_widget_get_first_child (line);
+  while (words && !gtk_widget_has_css_class (words, "cf-t")) words = gtk_widget_get_next_sibling (words);
+  g_assert_nonnull (words);
+  g_assert_true (gtk_widget_compute_bounds (words, line, &a));
+  g_assert_true (gtk_widget_compute_bounds (seg, line, &b));
+  g_assert_true (gtk_widget_compute_bounds (line, line, &row));
+  g_assert_cmpfloat (b.origin.y, >=, a.origin.y + a.size.height + 10 - 1);
+  g_assert_cmpfloat (fabs (b.origin.x - a.origin.x), <=, 1);
+  g_assert_cmpfloat (fabs (b.size.width - a.size.width), <=, 1); /* the row's whole width, as its words */
+  g_assert_cmpfloat (b.size.width, >=, row.size.width - 32 - 1);
+  g_assert_true (luma_mode_switch_get_fill (LUMA_MODE_SWITCH (seg)));
+  g_assert_null (cc_luma_view_get_error (view));
+  gtk_window_destroy (GTK_WINDOW (window)); drain ();
+
+  /* Appearance: Light and Dark side by side, equal, inside the hero; each preview 210:128. */
+  view = cc_luma_view_new (model, "appearance", NULL);
+  window = phone_window (view);
+  GtkWidget *light = find_name (view, "cf-mode-light"), *dark = find_name (view, "cf-mode-dark");
+  GtkWidget *well = find_name (view, "cf-appearance-styles");
+  g_assert_true (gtk_widget_compute_bounds (light, well, &a));
+  g_assert_true (gtk_widget_compute_bounds (dark, well, &b));
+  g_assert_true (gtk_widget_compute_bounds (well, well, &hero));
+  g_assert_cmpfloat (fabs (a.size.width - b.size.width), <=, 1);
+  g_assert_cmpfloat (fabs (a.origin.y - b.origin.y), <=, 1);
+  g_assert_cmpfloat (b.origin.x - (a.origin.x + a.size.width), ==, 10);
+  g_assert_cmpfloat (a.origin.x, >=, 0);
+  g_assert_cmpfloat (b.origin.x + b.size.width, <=, hero.size.width);
+  GtkWidget *mini = find_type (light, GTK_TYPE_OVERLAY);
+  g_assert_true (gtk_widget_compute_bounds (mini, mini, &a));
+  g_assert_cmpfloat (fabs (a.size.height - a.size.width * 128 / 210), <=, 1);
+  gtk_window_destroy (GTK_WINDOW (window)); drain ();
+
+  /* A subpage: with the island the page has no "‹ parent" link and no heading of its own; ‹ goes up. */
+  view = cc_luma_view_new (model, "wifi-net", NULL);
+  window = phone_window (view);
+#if defined (LUMA_TYPE_TITLE_ISLAND)
+  GtkWidget *island = find_name (window, "cf-island");
+  g_assert_true (LUMA_IS_TITLE_ISLAND (island));
+  g_assert_true (gtk_widget_get_mapped (island));
+  g_assert_cmpstr (luma_title_island_get_title (LUMA_TITLE_ISLAND (island)), ==, "Studio North");
+  g_assert_null (find_name (view, "cf-go-wifi"));
+  g_signal_emit_by_name (island, "lead"); drain ();
+  g_assert_cmpstr (cc_luma_view_get_page (view), ==, "wifi");
+  g_assert_cmpstr (luma_title_island_get_title (LUMA_TITLE_ISLAND (island)), ==, "Wi‑Fi");
+#else
+  g_assert_true (is_back (find_name (view, "cf-go-wifi")));
+#endif
+  g_assert_null (cc_luma_view_get_error (view));
+  gtk_window_destroy (GTK_WINDOW (window)); drain ();
+  g_unsetenv ("LUMA_FORM_FACTOR");
+}
