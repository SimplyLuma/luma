+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <gtk/gtk.h>
+#include "cc-luma-fixture.h"
+
+G_BEGIN_DECLS
+/* Settings' one window: the LumaUI frame (title row, sidebar with the
+ * account card, destinations and the search foot) around the page island.
+ * @view is a cc_luma_view (NULL in live mode: made on first use); the sidebar
+ * follows the page the island shows. The island's CcShell is data "cf-shell". */
+GtkWidget *cc_luma_window_new (GtkApplication *application, CcLumaFixture *model, GtkWidget *view);
+/* Search settings from the sidebar foot, as `gnome-control-center --search`. */
+void cc_luma_window_search (GtkWindow *window, const char *text);
