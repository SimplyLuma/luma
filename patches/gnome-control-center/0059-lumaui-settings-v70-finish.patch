+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* The account page and the System section. v70 CFP, drawn with the row builders.
+ * Everything here acts on the fixture only: sheets and dialogs end in a toast. */
+#include "cc-luma-rows.h"
+#include <gio/gdesktopappinfo.h>
+
+gboolean cc_luma_view_system_page (const char *page)
+{
+  const char *pages[] = { "me", "sharing", "region", "datetime", "users", "user-priya", "remote", "ssh", "about", "about-sys" };
+  for (guint i = 0; page && i < G_N_ELEMENTS (pages); i++)
+    if (g_str_equal (page, pages[i])) return TRUE;
+  return FALSE;
+}
+
+/* ── Fixture data ───────────────────────────────────────────────────────── */
+
+static JsonArray *data_array (View *v, const char *name)
+{
+  JsonObject *data = v->model ? cc_luma_fixture_get_data (v->model) : NULL;
+  return data && json_object_has_member (data, name) ? json_object_get_array_member (data, name) : NULL;
+}
+
+/* The label of id in a list of [id, label] pairs. */
+static const char *pair_label (JsonArray *pairs, const char *id)
+{
+  for (guint i = 0; pairs && i < json_array_get_length (pairs); i++)
+    {
+      JsonArray *p = json_array_get_array_element (pairs, i);
+      if (g_strcmp0 (json_array_get_string_element (p, 0), id) == 0)
+        return json_array_get_string_element (p, 1);
+    }
+  return id;
+}
+
+/* [id, label] pairs as a NULL-terminated id/label list for the pickers. */
+static char **pair_choices (JsonArray *pairs)
+{
+  GStrvBuilder *b = g_strv_builder_new ();
+  for (guint i = 0; pairs && i < json_array_get_length (pairs); i++)
+    {
+      JsonArray *p = json_array_get_array_element (pairs, i);
+      g_strv_builder_add (b, json_array_get_string_element (p, 0));
+      g_strv_builder_add (b, json_array_get_string_element (p, 1));
+    }
+  char **out = g_strv_builder_end (b);
+  g_strv_builder_unref (b);
+  return out;
+}
+
+static JsonArray *format_of (View *v, const char *id)
+{
+  JsonObject *data = v->model ? cc_luma_fixture_get_data (v->model) : NULL;
+  JsonObject *fmt = data && json_object_has_member (data, "CFFMT") ? json_object_get_object_member (data, "CFFMT") : NULL;
+  return fmt && json_object_has_member (fmt, id) ? json_object_get_array_member (fmt, id) : NULL;
+}
+
+/* ── Small pieces ───────────────────────────────────────────────────────── */
+
+static View *view_of (GtkWidget *root) { return g_object_get_data (G_OBJECT (root), "cf-view"); }
+
+static GtkWidget *control_of (GtkWidget *row)
+{
+  GtkWidget *line = GTK_IS_BUTTON (row) ? gtk_button_get_child (GTK_BUTTON (row)) : row;
+  GtkWidget *c = gtk_widget_get_last_child (line);
+  return c ? gtk_widget_get_first_child (c) : NULL;
+}
+
+/* Give a kit text button a leading glyph, the way luma_text_button_new () lays one out. */
+static void with_glyph (GtkWidget *button, const char *icon)
+{
+  GtkWidget *child = gtk_button_get_child (GTK_BUTTON (button));
+  if (GTK_IS_BOX (child)) { gtk_box_prepend (GTK_BOX (child), luma_ui_icon_new (icon)); return; }
+  g_autofree char *caption = g_strdup (GTK_IS_LABEL (child) ? gtk_label_get_text (GTK_LABEL (child)) : "");
+  GtkWidget *line = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_set_halign (line, GTK_ALIGN_CENTER);
+  gtk_widget_add_css_class (line, "lumaui-text-button-content");
+  gtk_box_append (GTK_BOX (line), luma_ui_icon_new (icon));
+  gtk_box_append (GTK_BOX (line), gtk_label_new (caption));
+  gtk_button_set_child (GTK_BUTTON (button), line);
+}
+
+/* v70 { lock }: the row's words dim, its control is disabled and wears a lock. */
+static void lock_row (GtkWidget *row, const char *why)
+{
+  GtkWidget *control = control_of (row);
+  gtk_widget_add_css_class (row, "locked");
+  if (!control) return;
+  gtk_widget_set_sensitive (control, FALSE);
+  gtk_widget_set_tooltip_text (control, why);
+  /* The picker's content is its own box (caption, chevron); a text button gets the kit's glyph line. */
+  if (gtk_widget_has_css_class (control, "cf-pk"))
+    gtk_box_prepend (GTK_BOX (gtk_button_get_child (GTK_BUTTON (control))), luma_ui_icon_new ("lock"));
+  else
+    with_glyph (control, "lock");
+}
+
+/* cf_lead_icon's glyph hexpands, and that would widen the 30 px lead. */
+static GtkWidget *lead (const char *icon)
+{
+  GtkWidget *w = cf_lead_icon (icon);
+  gtk_widget_set_hexpand (w, FALSE);
+  return w;
+}
+
+/* rTx: at phone width v70's field keeps its intrinsic 170 px beside the words. */
+static GtkWidget *tx (View *v, GtkBox *card, const char *key, const char *title, const char *subtitle)
+{
+  GtkWidget *row = cf_tx (v, card, key, title, subtitle, FALSE);
+  if (v->phone) gtk_widget_add_css_class (control_of (row), "cf-phone");
+  return row;
+}
+
+/* rPk: the picker keeps its caption on one line (v70 .cfpk span nowrap). */
+static GtkWidget *pk (View *v, GtkBox *card, const char *key, const char *title, const char *subtitle, char **choices)
+{
+  GtkWidget *row = cf_pk (v, card, key, title, subtitle, (const char * const *) choices);
+  GtkWidget *content = gtk_button_get_child (GTK_BUTTON (control_of (row)));
+  for (GtkWidget *c = content ? gtk_widget_get_first_child (content) : NULL; c; c = gtk_widget_get_next_sibling (c))
+    if (GTK_IS_LABEL (c)) gtk_label_set_wrap (GTK_LABEL (c), FALSE);
+  return row;
+}
+
+/* rBt with a lead icon ({ i }). */
+static GtkWidget *bt_lead (View *v, GtkBox *card, const char *icon, const char *title, const char *subtitle,
+                           const char *label, gboolean danger, GCallback callback, const char *name)
+{
+  GtkWidget *row = cf_bt (v, card, title, subtitle, label, danger, callback);
+  if (icon) gtk_box_prepend (GTK_BOX (row), lead (icon));
+  if (name) gtk_widget_set_name (control_of (row), name);
+  return row;
+}
+
+static void toast (View *v, const char *message, const char *kind)
+{
+  luma_toast_show (v->root, message, kind);
+}
+
+/* rNv whose target is another app (v70 '~disks'): a row that opens it. */
+static void open_app (GtkButton *button, GtkWidget *root)
+{
+  const char *app = g_object_get_data (G_OBJECT (button), "cf-app");
+  g_autofree char *message = g_strdup_printf ("Opens %s", app);
+  if (view_of (root)) luma_toast_show (root, message, "opening");
+}
+
+static GtkWidget *app_row (View *v, GtkBox *card, const char *app, const char *title, const char *subtitle, const char *value)
+{
+  GtkWidget *trail = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+  gtk_box_append (GTK_BOX (trail), cf_value (value, FALSE));
+  gtk_box_append (GTK_BOX (trail), cf_chevron ());
+  GtkWidget *row = cf_row (card, NULL, title, subtitle, trail, TRUE);
+  g_autofree char *low = g_ascii_strdown (app, -1);
+  g_autofree char *name = g_strconcat ("cf-open-", low, NULL);
+  gtk_widget_set_name (row, name);
+  g_object_set_data_full (G_OBJECT (row), "cf-app", g_strdup (app), g_free);
+  g_signal_connect_object (row, "clicked", G_CALLBACK (open_app), v->root, 0);
+  return row;
+}
+
+/* ── Editors in the action center (v70 cfSheet with a form) ────────────── */
+
+static void editor_discarded (LumaActionEditor *editor, GtkWidget *root)
+{
+  View *v = view_of (root);
+  if (v) luma_action_center_hide_bar (v->center);
+}
+
+static void editor_done (LumaBarItem *item, GtkWidget *root)
+{
+  View *v = view_of (root);
+  if (!v) return;
+  luma_action_center_hide_bar (v->center);
+  luma_toast_show (root, g_object_get_data (G_OBJECT (item), "cf-toast"), "done");
+}
+
+typedef struct { const char *label; const char *name; gboolean secret; } Field;
+
+static void open_editor (View *v, const char *title, const char *icon, const char *summary,
+                         const Field *fields, guint n_fields, const char *action, const char *done)
+{
+  LumaActionEditor *editor = LUMA_ACTION_EDITOR (luma_action_editor_new (title, icon));
+  luma_action_editor_set_form (editor, "Cancel");
+  luma_action_editor_set_summary (editor, summary, NULL);
+  g_signal_connect_object (editor, "discarded", G_CALLBACK (editor_discarded), v->root, 0);
+  luma_action_center_set_editor (v->center, editor);
+  for (guint i = 0; i < n_fields; i++)
+    {
+      GtkWidget *entry = gtk_entry_new ();
+      gtk_entry_set_visibility (GTK_ENTRY (entry), !fields[i].secret);
+      gtk_widget_set_name (entry, fields[i].name);
+      luma_action_editor_add_field (editor, fields[i].label, entry);
+    }
+  g_autoptr (LumaBarItem) primary = luma_bar_item_new_action (NULL, action, NULL) /* v70 .cflac: a words-alone key */;
+  luma_bar_item_set_primary (primary, TRUE);
+  g_object_set_data_full (G_OBJECT (primary), "cf-toast", g_strdup (done), g_free);
+  g_signal_connect_object (primary, "activated", G_CALLBACK (editor_done), v->root, 0);
+  luma_action_editor_set_primary (editor, primary);
+  luma_action_center_grow (v->center);
+}
+
+static void password_clicked (GtkButton *button, View *v)
+{
+  const Field fields[] = { { "Current password", "cf-pw-current", TRUE }, { "New password", "cf-pw-new", TRUE } };
+  open_editor (v, "Change your password", "key-round", "Your files and saved passwords stay as they are.",
+               fields, G_N_ELEMENTS (fields), "Change", "Password changed");
+}
+
+static void add_user_clicked (GtkButton *button, GtkWidget *root)
+{
+  View *v = view_of (root);
+  const Field fields[] = { { "Full name", "cf-adduser-name", FALSE }, { "Username", "cf-adduser-username", FALSE } };
+  if (v) open_editor (v, "Add someone", "user-plus", "They get their own files, settings and apps.",
+                      fields, G_N_ELEMENTS (fields), "Add", "Account added");
+}
+
+/* ── Destructive actions ────────────────────────────────────────────────── */
+
+static void signed_out (LumaDestructiveDialog *dialog, gboolean checked, GtkWidget *root)
+{
+  if (view_of (root)) luma_toast_show (root, "Signed out", "signed-out");
+}
+
+static void sign_out_clicked (GtkButton *button, View *v)
+{
+  LumaDestructiveDialog *dialog = luma_destructive_dialog_ask (v->root, "Sign out of your Luma account?",
+    "Messages and sync stop on this computer until you sign in again. Your files stay.", "Sign out", "log-out", NULL);
+  g_signal_connect_object (dialog, "confirmed", G_CALLBACK (signed_out), v->root, 0);
+}
+
+static void user_removed (LumaDestructiveDialog *dialog, gboolean checked, GtkWidget *root)
+{
+  View *v = view_of (root);
+  if (v && g_str_equal (v->page, "user-priya")) cc_luma_view_navigate (v, "users");
+}
+
+static void remove_user_clicked (GtkButton *button, View *v)
+{
+  LumaDestructiveDialog *dialog = luma_destructive_dialog_ask (v->root, "Remove Priya Raman?",
+    "Her account goes. Choose whether her files stay in /home.", "Remove", "user-minus", NULL);
+  g_signal_connect_object (dialog, "confirmed", G_CALLBACK (user_removed), v->root, 0);
+}
+
+/* ── Plain actions ──────────────────────────────────────────────────────── */
+
+static void picture_clicked (GtkButton *b, View *v) { toast (v, "Choose a picture", "done"); }
+static void parental_clicked (GtkButton *b, View *v) { toast (v, "Opens Parental Controls", "opening"); }
+static void reset_clicked (GtkButton *b, View *v) { toast (v, "Priya sets a new password when she next signs in", "done"); }
+static void live_datetime_panel (GtkButton *b, View *v);
+static gboolean live (View *v);
+static void set_time_clicked (GtkButton *b, View *v)
+{
+  if (live (v)) { live_datetime_panel (b, v); return; }
+  toast (v, "Pick a date and time", "done");
+}
+static void updates_clicked (GtkButton *b, View *v) { toast (v, "Opens Depot", "opening"); }
+
+static void copy_system_clicked (GtkButton *b, View *v)
+{
+  gdk_clipboard_set_text (gtk_widget_get_clipboard (v->root),
+                          "Luma 1.0 nightly 20260923\nLinux 6.16.8-luma1\nLuma Shell 1.0 on Wayland");
+  toast (v, "System details copied", "copied");
+}
+
+static void reveal_clicked (GtkButton *b, View *v)
+{
+  gboolean shown = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (v->root), "cf-system-reveal"));
+  g_object_set_data (G_OBJECT (v->root), "cf-system-reveal", GINT_TO_POINTER (!shown));
+  cc_luma_view_queue_refresh (v);
+}
+
+/* ── Heroes ─────────────────────────────────────────────────────────────── */
+
+static GtkWidget *avatar_for (View *v, const char *name, int hue, int size)
+{
+  GtkWidget *a = luma_person_avatar_new (name, size);
+  luma_person_avatar_set_hue (LUMA_PERSON_AVATAR (a), hue);
+  /* v70 shows Priya's photo (a face crop, supplied with the fixture). */
+  if (v && v->model && g_str_equal (name, "Priya Raman"))
+    {
+      g_autofree char *path = cc_luma_fixture_asset_path (v->model, "priya", NULL);
+      g_autoptr (GdkTexture) texture = path ? gdk_texture_new_from_filename (path, NULL) : NULL;
+      if (texture) luma_person_avatar_set_picture (LUMA_PERSON_AVATAR (a), GDK_PAINTABLE (texture));
+    }
+  return a;
+}
+#define avatar(name, hue, size) avatar_for (v, name, hue, size)
+
+/* ── Live (production) model ────────────────────────────────────────────
+ * The same pages from what the system's owners report (cc-luma-live-*.c).
+ * Rows with no owner on this system are left out; nothing here is sample
+ * data. Changes go through the model's writer to the owning adapter. */
+static gboolean live (View *v) { return v->model && cc_luma_fixture_is_live (v->model); }
+
+static GtkWidget *live_avatar (View *v, const char *name, const char *asset, int size)
+{
+  GtkWidget *a = luma_person_avatar_new (name, size);
+  g_autofree char *path = asset ? cc_luma_fixture_asset_path (v->model, asset, NULL) : NULL;
+  g_autoptr (GdkTexture) texture = path ? gdk_texture_new_from_filename (path, NULL) : NULL;
+  if (texture) luma_person_avatar_set_picture (LUMA_PERSON_AVATAR (a), GDK_PAINTABLE (texture));
+  return a;
+}
+
+/* Hands a task to the GNOME panel that owns it (password, picture, a date
+ * typed by hand): the same dialogs and polkit checks as upstream. */
+static void open_panel (View *v, const char *panel, const char *sub)
+{
+  /* The application's own "launch-panel" action (what search and the
+   * shell use); with a parameter the shell shows the GNOME panel. */
+  GVariantBuilder b;
+  g_variant_builder_init (&b, G_VARIANT_TYPE ("av"));
+  if (sub) g_variant_builder_add (&b, "v", g_variant_new_string (sub));
+  if (!gtk_widget_activate_action (v->root, "app.launch-panel", "(s@av)", panel, g_variant_builder_end (&b)))
+    {
+      g_autoptr (GError) error = g_error_new (G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "The %s panel isn’t available here", panel);
+      cc_luma_view_report_error (v, error);
+    }
+}
+
+static void live_users_panel (GtkButton *b, View *v) { open_panel (v, "system", "users"); }
+static void live_datetime_panel (GtkButton *b, View *v) { open_panel (v, "system", "datetime"); }
+
+/* Writes not yet proven on a real owner open the page's GNOME panel
+ * (cc-luma-live.c's verified list); TRUE when the panel took over. */
+static gboolean live_delegated (View *v, const char *key)
+{
+  return !cc_luma_fixture_key_verified (v->model, key) && cc_luma_view_delegated (v);
+}
+
+static gboolean live_write (View *v, const char *key, JsonNode *value)
+{
+  g_autoptr (GError) error = NULL;
+  if (cc_luma_fixture_write (v->model, key, value, &error)) return TRUE;
+  cc_luma_view_report_error (v, error);
+  return FALSE;
+}
+
+/* The other people AccountsService reports (LIVEUSERS). */
+static JsonArray *live_people (View *v)
+{
+  JsonArray *a = data_array (v, "LIVEUSERS");
+  return a;
+}
+
+static JsonObject *live_person (View *v, const char *user)
+{
+  JsonArray *people = live_people (v);
+  for (guint i = 0; people && i < json_array_get_length (people); i++)
+    {
+      JsonObject *o = json_array_get_object_element (people, i);
+      if (g_strcmp0 (json_object_get_string_member_with_default (o, "user", ""), user) == 0) return o;
+    }
+  return NULL;
+}
+
+static char *first_name (const char *name)
+{
+  const char *space = strchr (name, ' ');
+  return space ? g_strndup (name, space - name) : g_strdup (name);
+}
+
+/* v70 "last in yesterday", from AccountsService's last login. */
+static char *last_in (gint64 when)
+{
+  if (when <= 0) return NULL;
+  g_autoptr (GDateTime) now = g_date_time_new_now_local ();
+  g_autoptr (GDateTime) then = g_date_time_new_from_unix_local (when);
+  if (!then) return NULL;
+  int days = g_date_time_get_day_of_year (now) - g_date_time_get_day_of_year (then);
+  if (g_date_time_get_year (now) != g_date_time_get_year (then)) days = 999;
+  if (days == 0) return g_strdup ("last in today");
+  if (days == 1) return g_strdup ("last in yesterday");
+  return g_date_time_format (then, "last in %B %-d");
+}
+
+static char *person_line (JsonObject *o)
+{
