+/* ── The installed apps as a recycling list ─────────────────────────── */
+/* With many apps (live systems have 100+), only the rows on screen exist:
+ * a pool of v70 rows re-bound as the page scrolls, icons decoded off the
+ * main thread once and cached, and the list kept across redraws while the
+ * apps are unchanged, so an owner's unrelated report doesn't rebuild it. */
+#define RECYCLE_FROM 40
+#define OVERSCAN 3
+typedef struct { char *id, *name, *category, *size, *path; } AppItem;
+typedef struct {
+  View *v;
+  GtkWidget *section, *card;
+  GPtrArray *items;  /* AppItem */
+  GPtrArray *rows;   /* every row widget made, bound or free */
+  int row_h, width;
+  GtkAdjustment *adj;
+  gulong adj_handler;
+  guint tick;
+  char *signature;
+} Recycler;
+
+static GHashTable *icon_cache;    /* path → GdkPaintable */
+static GHashTable *icon_pending;  /* path → TRUE */
+static GPtrArray *live_recyclers; /* Recycler, for icons that arrive */
+
+static void
+app_item_free (AppItem *item)
+{
+  g_free (item->id); g_free (item->name); g_free (item->category); g_free (item->size); g_free (item->path);
+  g_free (item);
+}
+
+static void
+recycler_free (Recycler *r)
+{
+  if (r->adj_handler) g_clear_signal_handler (&r->adj_handler, r->adj);
+  g_clear_object (&r->adj);
+  if (live_recyclers) g_ptr_array_remove (live_recyclers, r);
+  g_ptr_array_unref (r->items);
+  g_ptr_array_unref (r->rows);
+  g_clear_object (&r->section);
+  g_free (r->signature);
+  g_free (r);
+}
+
+static int row_index (GtkWidget *row) { return GPOINTER_TO_INT (g_object_get_data (G_OBJECT (row), "cf-index")) - 1; }
+static void set_row_index (GtkWidget *row, int i) { g_object_set_data (G_OBJECT (row), "cf-index", GINT_TO_POINTER (i + 1)); }
