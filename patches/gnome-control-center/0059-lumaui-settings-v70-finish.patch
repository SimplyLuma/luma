+/* The rows the viewport shows, with a few either side. */
+static void
+visible_range (Recycler *r, int *first, int *last)
+{
+  int n = (int) r->items->len;
+  *first = 0; *last = n - 1;
+  GtkWidget *scroller = gtk_widget_get_ancestor (r->card, GTK_TYPE_SCROLLED_WINDOW);
+  GtkWidget *content = scroller ? gtk_scrolled_window_get_child (GTK_SCROLLED_WINDOW (scroller)) : NULL;
+  if (GTK_IS_VIEWPORT (content)) content = gtk_viewport_get_child (GTK_VIEWPORT (content));
+  graphene_point_t at;
+  if (!r->adj || !content || r->row_h <= 0 ||
+      !gtk_widget_compute_point (r->card, content, &GRAPHENE_POINT_INIT (0, 0), &at))
+    { *last = MIN (n - 1, 2 * OVERSCAN + 16); return; }
+  double top = gtk_adjustment_get_value (r->adj) - at.y;
+  double bottom = top + gtk_adjustment_get_page_size (r->adj);
+  *first = CLAMP ((int) (top / r->row_h) - OVERSCAN, 0, MAX (n - 1, 0));
+  *last = CLAMP ((int) (bottom / r->row_h) + OVERSCAN, -1, n - 1);
+}
+
+static int
+by_index (gconstpointer a, gconstpointer b)
+{
+  return row_index (*(GtkWidget **) a) - row_index (*(GtkWidget **) b);
