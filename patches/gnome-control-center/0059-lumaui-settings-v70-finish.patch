+/* The Luma mark, when the fixture carries it; otherwise its 60 px place. */
+static GtkWidget *luma_mark (View *v)
+{
+  g_autofree char *path = v->model ? cc_luma_fixture_asset_path (v->model, "luma-favicon", NULL) : NULL;
+  g_autoptr (GdkPixbuf) pixbuf = path ? gdk_pixbuf_new_from_file_at_scale (path, 120, 120, TRUE, NULL) : NULL;
+  GtkWidget *mark;
+  if (pixbuf)
+    {
+      g_autoptr (GdkTexture) texture = gdk_texture_new_for_pixbuf (pixbuf);
+      /* Drawn at 60 px from a 2× texture: a GtkImage's pixel size caps its natural width. */
+      mark = gtk_image_new_from_paintable (GDK_PAINTABLE (texture));
+      gtk_image_set_pixel_size (GTK_IMAGE (mark), 60);
+    }
+  else
+    mark = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_set_size_request (mark, 60, 60);
