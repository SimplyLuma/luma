                              const char *key, JsonNode *value, GError **error)
 {
-  if (page && key && cc_luma_privacy_validate (model)) {
+  if (page && key && cc_luma_fixture_is_live (model)) {
+    /* Live: the owner decides (or the page's GNOME panel, for unproven keys). */
+    JsonNode *current = cc_luma_fixture_get (model, key);
+    if (current && value && JSON_NODE_HOLDS_VALUE (current) && JSON_NODE_HOLDS_VALUE (value) &&
+        json_node_get_value_type (current) == json_node_get_value_type (value))
+      return cc_luma_fixture_set (model, key, value, error);
+  }
+  else if (page && key && cc_luma_privacy_validate (model)) {
     for (guint i = 0; i < G_N_ELEMENTS (fields); i++)
       if (g_str_equal (page, fields[i].page) && g_str_equal (key, fields[i].key) && valid (&fields[i], value))
         return cc_luma_fixture_set (model, key, value, error);
diff --git a/shell/cc-luma-rows.c b/shell/cc-luma-rows.c
new file mode 100644
index 0000000..9ca07d1
--- /dev/null
+++ b/shell/cc-luma-rows.c
@@ -0,0 +1,728 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-rows.h"
+#include <math.h>
+
+GtkWidget *cf_text (const char *text, const char *cls)
+{
+  GtkWidget *w = gtk_label_new (text);
+  gtk_label_set_xalign (GTK_LABEL (w), 0);
+  if (cls) gtk_widget_add_css_class (w, cls);
+  return w;
+}
+
+static GtkWidget *wrapping (const char *text, const char *cls)
+{
+  GtkWidget *w = cf_text (text, cls);
+  gtk_label_set_wrap (GTK_LABEL (w), TRUE);
+  gtk_label_set_wrap_mode (GTK_LABEL (w), PANGO_WRAP_WORD);
+  return w;
+}
+
+GtkWidget *cf_chevron (void)
+{
+  GtkWidget *w = luma_ui_icon_new ("chevron-right");
+  gtk_widget_add_css_class (w, "cf-chevron");
+  return w;
+}
+
+GtkWidget *cf_value (const char *text, gboolean mono)
+{
+  GtkWidget *w = cf_text (text, "cf-v");
+  /* A long value (an address, a device name) ends in … rather than past its row; the whole of it on hover. */
+  gtk_label_set_ellipsize (GTK_LABEL (w), PANGO_ELLIPSIZE_END);
+  gtk_widget_set_tooltip_text (w, text);
+  if (mono) { luma_ui_apply_type (w, "mono-small"); gtk_widget_add_css_class (w, "mono"); } /* v70 .cfv .mono: 12 px */
+  return w;
+}
+
+/* The LumaUI text button (v70 .bt); variant "fill", "key" or NULL (plain).
+ * "cf-bt" only marks it for Settings' own lookups. */
+GtkWidget *cf_button (const char *label, const char *variant, gboolean small)
+{
+  GtkWidget *w = luma_text_button_new (label, NULL, g_strcmp0 (variant, "primary") == 0 ? "key" : variant);
+  if (small) luma_text_button_set_small (GTK_BUTTON (w), TRUE);
+  gtk_widget_add_css_class (w, "cf-bt");
+  gtk_widget_set_valign (w, GTK_ALIGN_CENTER);
+  return w;
+}
+
+static const char *parent_of (View *v, const char **parent_title)
+{
+  JsonArray *pages = v->model ? cc_luma_fixture_get_pages (v->model) : NULL;
+  const char *parent = NULL;
+  *parent_title = NULL;
+  for (guint i = 0; pages && i < json_array_get_length (pages); i++)
+    {
+      JsonObject *page = json_array_get_object_element (pages, i);
+      if (!g_str_equal (json_object_get_string_member (page, "id"), v->page)) continue;
+      JsonNode *node = json_object_get_member (page, "parent");
+      if (node && json_node_get_value_type (node) == G_TYPE_STRING) parent = json_node_get_string (node);
+      break;
+    }
+  if (g_str_has_prefix (v->page, "app:")) parent = "apps";
+  if (v->live_lock || v->live_permission) { *parent_title = "Privacy & Security"; return "privacy"; }
+  for (guint i = 0; parent && pages && i < json_array_get_length (pages); i++)
+    {
+      JsonObject *page = json_array_get_object_element (pages, i);
+      if (g_str_equal (json_object_get_string_member (page, "id"), parent))
+        *parent_title = json_object_get_string_member_with_default (page, "title", NULL);
+    }
+  return *parent_title ? parent : NULL;
+}
+
+/* v70 .cfhd > div has min-width auto on a flex item with overflow visible: a long word in the
+ * heading (Remote Desktop at phone width) draws past its box instead of widening the page. */
+static void spill_measure (GtkWidget *w, GtkOrientation o, int for_size, int *min, int *nat, int *minb, int *natb)
+{
+  *min = *nat = 0; *minb = *natb = -1;
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c))
+    {
+      int cm = 0, cn = 0, cmin_w = 0;
+      if (!gtk_widget_should_layout (c)) continue;
+      if (o == GTK_ORIENTATION_HORIZONTAL)
+        {
+          gtk_widget_measure (c, o, -1, NULL, &cn, NULL, NULL);
+          *nat = MAX (*nat, cn);
+        }
+      else
+        {
+          gtk_widget_measure (c, GTK_ORIENTATION_HORIZONTAL, -1, &cmin_w, NULL, NULL, NULL);
+          gtk_widget_measure (c, o, for_size < 0 ? -1 : MAX (for_size, cmin_w), &cm, &cn, NULL, NULL);
+          *min += cm; *nat += cn;
+        }
+    }
+}
+static void spill_allocate (GtkWidget *w, int width, int height, int baseline)
+{
+  int y = 0;
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c))
+    {
+      int cmin_w = 0, ch = 0;
+      if (!gtk_widget_should_layout (c)) continue;
+      gtk_widget_measure (c, GTK_ORIENTATION_HORIZONTAL, -1, &cmin_w, NULL, NULL, NULL);
+      int cw = MAX (width, cmin_w);
+      gtk_widget_measure (c, GTK_ORIENTATION_VERTICAL, cw, NULL, &ch, NULL, NULL);
+      GtkAllocation a = { 0, y, cw, ch };
+      gtk_widget_size_allocate (c, &a, -1);
+      y += ch;
+    }
+}
+
+GtkLabel *cf_header (View *v, const char *title, const char *meta, GtkWidget *top)
+{
+  const char *parent_title;
+  const char *parent = parent_of (v, &parent_title);
+  GtkWidget *head = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 16);
+  GtkWidget *titles = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  GtkWidget *meta_label = wrapping (meta ? meta : "", "cf-meta");
+  /* v71 phone: the title island carries the page, its summary and ‹; the page keeps only a header's
+   * own controls (a top switch, tabs), and starts 16 under the island. */
+  gboolean island = cc_luma_view_island_mode (v);
+  luma_ui_apply_type_full (meta_label, "meta", TRUE);
+  if (island) gtk_widget_add_css_class (GTK_WIDGET (v->body), "cf-island-page");
+  else gtk_widget_remove_css_class (GTK_WIDGET (v->body), "cf-island-page");
+  if (island)
+    {
+      /* Unparented, the summary stays the page's live v->subtitle; the island follows it. */
+      g_object_set_data_full (G_OBJECT (v->body), "cf-island-meta", g_object_ref_sink (meta_label), g_object_unref);
+      v->subtitle = GTK_LABEL (meta_label);
+      cc_luma_view_island_set (v, title, GTK_LABEL (meta_label), parent, parent_title);
+      if (top)
+        {
+          gtk_widget_add_css_class (head, "cf-head");
+          gtk_widget_set_valign (top, GTK_ALIGN_CENTER);
+          gtk_widget_set_halign (top, GTK_ALIGN_START);
+          gtk_box_append (GTK_BOX (head), top);
+          gtk_box_append (v->body, head);
+        }
+      else
+        {
+          g_object_ref_sink (head);
+          g_object_unref (head);
+        }
+      g_object_ref_sink (titles);
+      g_object_unref (titles);
+      return GTK_LABEL (meta_label);
+    }
+  cc_luma_view_island_set (v, title, NULL, NULL, NULL);
+  if (parent)
+    {
+      GtkWidget *back = gtk_button_new ();
+      GtkWidget *content = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 2);
+      gtk_box_append (GTK_BOX (content), luma_ui_icon_new ("chevron-left"));
+      gtk_box_append (GTK_BOX (content), cf_text (parent_title, NULL));
+      gtk_button_set_child (GTK_BUTTON (back), content);
+      gtk_widget_add_css_class (back, "cf-back");
+      gtk_widget_set_halign (back, GTK_ALIGN_START);
+      g_autofree char *name = g_strconcat ("cf-go-", parent, NULL);
+      gtk_widget_set_name (back, name);
+      if (v->live_lock || v->live_permission)
+        gtk_actionable_set_action_name (GTK_ACTIONABLE (back), "navigation.pop");
+      else
+        cc_luma_view_bind_navigation (v, back, parent);
+      gtk_box_append (v->body, back);
+    }
+  gtk_widget_add_css_class (head, "cf-head");
+  if (top) gtk_widget_set_layout_manager (titles, gtk_custom_layout_new (NULL, spill_measure, spill_allocate));
+  gtk_widget_set_hexpand (titles, TRUE);
+  gtk_widget_set_valign (titles, GTK_ALIGN_CENTER);
+  GtkWidget *h1 = wrapping (title, "cf-h1");
+  luma_ui_apply_type (h1, "page-title");
+  gtk_box_append (GTK_BOX (titles), h1);
+  gtk_box_append (GTK_BOX (titles), meta_label);
+  gtk_box_append (GTK_BOX (head), titles);
+  if (top)
+    {
+      gtk_widget_set_valign (top, GTK_ALIGN_CENTER);
+      gtk_box_append (GTK_BOX (head), top);
+    }
+  if (top && v->phone && LUMA_IS_MODE_SWITCH (top))
+    {
+      /* Nick, 30 Sep: nothing spills. On a phone a header's tabs (Remote Desktop) take their own line
+       * under the title instead of squeezing it past its edge. */
+      gtk_orientable_set_orientation (GTK_ORIENTABLE (head), GTK_ORIENTATION_VERTICAL);
+      gtk_box_set_spacing (GTK_BOX (head), 12);
+      gtk_widget_set_halign (top, GTK_ALIGN_START);
+      gtk_widget_set_layout_manager (titles, NULL);
+      gtk_widget_set_layout_manager (titles, gtk_box_layout_new (GTK_ORIENTATION_VERTICAL));
+    }
+  gtk_box_append (v->body, head);
+  v->subtitle = GTK_LABEL (meta_label);
+  return GTK_LABEL (meta_label);
+}
+
+static void row_toggle (GtkButton *button, GtkSwitch *visual)
+{
+  if (gtk_widget_get_sensitive (GTK_WIDGET (visual)))
+    gtk_switch_set_active (visual, !gtk_switch_get_active (visual));
+}
+
+static GtkWidget *switch_button (View *v, const char *key, const char *label, const char *cls)
+{
+  GtkWidget *button = g_object_new (GTK_TYPE_BUTTON, "accessible-role", GTK_ACCESSIBLE_ROLE_SWITCH, NULL);
+  GtkWidget *visual = cc_luma_view_switch_full (v, key, g_str_equal (cls, "cf-top"));
+  gtk_widget_add_css_class (button, cls);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_PROPERTY_LABEL, label, -1);
+  gtk_accessible_update_state (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_STATE_CHECKED,
+                               gtk_switch_get_active (GTK_SWITCH (visual)) ? GTK_ACCESSIBLE_TRISTATE_TRUE : GTK_ACCESSIBLE_TRISTATE_FALSE, -1);
+  gtk_widget_set_sensitive (button, gtk_widget_get_sensitive (visual));
+  g_object_set_data (G_OBJECT (button), "cf-switch", visual);
+  g_signal_connect (button, "clicked", G_CALLBACK (row_toggle), visual);
+  g_autofree char *name = g_strconcat ("cf-", key, NULL);
+  gtk_widget_set_name (button, name);
+  return button;
+}
+
+GtkWidget *cf_top_switch (View *v, const char *key)
+{
+  GtkWidget *button = switch_button (v, key, "Turn on or off", "cf-top");
+  gtk_widget_set_tooltip_text (button, "Turn on or off");
+  GtkWidget *visual = g_object_get_data (G_OBJECT (button), "cf-switch");
+  gtk_button_set_child (GTK_BUTTON (button), visual);
+  return button;
+}
