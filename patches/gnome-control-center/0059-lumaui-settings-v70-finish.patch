diff --git a/shell/luma-settings-system.css b/shell/luma-settings-system.css
new file mode 100644
index 0000000..6480a22
--- /dev/null
+++ b/shell/luma-settings-system.css
@@ -0,0 +1,35 @@
+/* Settings' system pages: page-only surfaces (heroes). Tokens only. */
+
+/* v70 { lock }: dimmed words, a disabled control wearing a lock. */
+.cf-row.locked button:disabled { opacity: .55; filter: none; }
+.cf-row.locked button:disabled label, .cf-row.locked button:disabled image, .cf-row.locked button:disabled box { filter: none; opacity: 1; }
+.cf-row.locked button:disabled label { color: @luma_ink; }
+.cf-row.locked button.cf-pk:disabled image { color: @luma_muted; }
+
+
+
+/* .cfid: a face and who it is. */
+.cf-id-title { line-height: 25px; font-size: 17px; font-weight: 650; letter-spacing: -0.17px; }
+.cf-id-line { margin-top: 3px; line-height: 18px; font-size: 12.5px; color: @luma_muted; }
+.cf-id-note { margin-top: 4px; line-height: 17px; font-size: 12px; letter-spacing: 0.12px; color: @luma_muted; }
+
+/* .cfabout: the Luma mark and the release. */
+.cf-about-title { font-size: 22px; font-weight: 700; letter-spacing: -0.44px; }
+.cf-about-line { line-height: 18px; font-size: 12.5px; color: @luma_muted; }
+.cf-about-state { margin-top: 7px; line-height: 18px; font-size: 12.5px; color: @luma_ink_secondary; }
+.cf-dot { min-width: 7px; min-height: 7px; border-radius: 999px; background: @luma_good; box-shadow: 0 0 8px @luma_good; }
+
+/* .cffmt: how dates, numbers and money look. */
+.cf-fmt { margin: 2px 4px; }
+.cf-fmt-name { line-height: 16px; /* 16.7 would draw 17: three rows drift 2 px */ font-size: 11.5px; letter-spacing: 0.115px; color: @luma_muted; }
+.cf-fmt-value { margin-top: 3px; line-height: 20px; font-size: 13.5px; font-weight: 500; }
+
+/* .cfclock: the time, the date, the zone. */
+.cf-clock { padding: 6px 0 4px; }
+.cf-clock-time { line-height: 48px; font-size: 46px; font-weight: 600; letter-spacing: -1.38px; font-feature-settings: "tnum"; }
+.cf-clock-date { margin-top: 4px; line-height: 20px; font-size: 14px; color: @luma_ink_secondary; }
+.cf-clock-place { margin-top: 10px; margin-bottom: 4px; /* v70 span is inline: its line box adds ~4 px */ line-height: 18px; font-size: 12.5px; color: @luma_muted; }
+.cf-clock-place image { -gtk-icon-size: 14px; }
+
+/* Phone: the field keeps v70's intrinsic 170 px (padding included). */
+entry.cf-tx.cf-phone { min-width: 150px; }
