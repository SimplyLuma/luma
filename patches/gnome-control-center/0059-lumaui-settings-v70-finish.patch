+/* ── Keyboard shortcuts ──────────────────────────────────────────────── */
+static void key_clicked (GtkButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  const char *name = g_object_get_data (G_OBJECT (button), "cf-shortcut");
+  const char *editing = g_object_get_data (G_OBJECT (root), "cf-key-edit");
+  if (!v || !g_str_equal (v->page, "shortcuts")) return;
+  g_object_set_data_full (G_OBJECT (root), "cf-key-edit",
+                          g_strcmp0 (editing, name) == 0 ? NULL : g_strdup (name), g_free);
+  cc_luma_view_queue_refresh (v);
+}
+
+static gboolean key_pressed (GtkEventControllerKey *keys, guint keyval, guint keycode, GdkModifierType state, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  switch (keyval)
+    {
+    case GDK_KEY_Shift_L: case GDK_KEY_Shift_R: case GDK_KEY_Control_L: case GDK_KEY_Control_R:
+    case GDK_KEY_Alt_L: case GDK_KEY_Alt_R: case GDK_KEY_Super_L: case GDK_KEY_Super_R: case GDK_KEY_ISO_Level3_Shift:
+      return FALSE;
+    default:
+      break;
+    }
+  if (!v || !g_object_get_data (G_OBJECT (root), "cf-key-edit")) return FALSE;
+  /* Fixture only: the new keys are not stored; the edit ends. */
+  g_object_set_data (G_OBJECT (root), "cf-key-edit", NULL);
+  cc_luma_view_queue_refresh (v);
+  return TRUE;
+}
+
+static void shortcuts (View *v)
+{
+  JsonArray *groups = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFSHORT");
+  const char *editing = g_object_get_data (G_OBJECT (v->root), "cf-key-edit");
+  cf_header (v, "Keyboard shortcuts", "Click a shortcut to change it", NULL);
+  for (guint g = 0; g < json_array_get_length (groups); g++)
+    {
+      JsonArray *group = json_array_get_array_element (groups, g);
+      JsonArray *list = json_array_get_array_element (group, 1);
+      GtkBox *card = cf_group (v, json_array_get_string_element (group, 0), NULL);
+      for (guint i = 0; i < json_array_get_length (list); i++)
+        {
+          JsonArray *item = json_array_get_array_element (list, i);
+          const char *name = json_array_get_string_element (item, 0);
+          gboolean edit = g_strcmp0 (editing, name) == 0;
+          GtkWidget *button = gtk_button_new ();
+          GtkWidget *keys = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+          gtk_widget_add_css_class (button, "cf-keys");
+          if (edit)
+            {
+              gtk_widget_add_css_class (button, "edit");
+              gtk_box_append (GTK_BOX (keys), cf_text ("Press the new keys…", NULL));
+              GtkEventController *controller = gtk_event_controller_key_new ();
+              g_signal_connect_object (controller, "key-pressed", G_CALLBACK (key_pressed), v->root, 0);
+              gtk_widget_add_controller (button, controller);
+            }
+          else
+            {
+              g_auto (GStrv) parts = g_strsplit (json_array_get_string_element (item, 1), " ", -1);
+              for (guint k = 0; parts[k]; k++)
+                {
+                  GtkWidget *cap = cf_text (parts[k], "cf-kbd");
+                  gtk_widget_set_valign (cap, GTK_ALIGN_CENTER);
+                  gtk_label_set_xalign (GTK_LABEL (cap), .5);
+                  gtk_box_append (GTK_BOX (keys), cap);
+                }
+            }
+          gtk_button_set_child (GTK_BUTTON (button), keys);
+          g_autofree char *label = g_strconcat (name, " shortcut", NULL);
+          gtk_accessible_update_property (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_PROPERTY_LABEL, label, -1);
+          g_object_set_data_full (G_OBJECT (button), "cf-shortcut", g_strdup (name), g_free);
+          g_signal_connect_object (button, "clicked", G_CALLBACK (key_clicked), v->root, 0);
+          cf_row (card, NULL, name, NULL, button, FALSE);
+          if (edit) gtk_widget_grab_focus (button);
+        }
+    }
+}
+
+void cc_luma_view_hardware_render (View *v)
+{
+  if (g_str_equal (v->page, "printers")) printers (v);
+  else shortcuts (v);
+}
