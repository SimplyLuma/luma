diff --git a/shell/cc-luma-view-people.c b/shell/cc-luma-view-people.c
new file mode 100644
index 0000000..16fa349
--- /dev/null
+++ b/shell/cc-luma-view-people.c
@@ -0,0 +1,284 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Online Accounts and Wellbeing (You). v70 CFP, drawn with the row builders.
+ * Everything here is fixture-only: no account service, no screen-time daemon. */
+#include "cc-luma-rows.h"
+
+gboolean cc_luma_view_people_page (const char *page)
+{
+  const char *pages[] = { "accounts", "acct-fm", "acct-nc", "wellbeing" };
+  for (guint i = 0; page && i < G_N_ELEMENTS (pages); i++)
+    if (g_str_equal (page, pages[i])) return TRUE;
+  return FALSE;
+}
+
+/* The rBt row's button: row > cf-c > button. */
+static GtkWidget *row_button (GtkWidget *row)
+{
+  GtkWidget *c = gtk_widget_get_last_child (row);
+  return c ? gtk_widget_get_first_child (c) : NULL;
+}
+
+static void spill_subtitle (GtkWidget *row)
+{
+  /* Nick, 30 Sep: nothing spills. An address keeps its own width, so a row too narrow for it and its value
+   * puts the value on its own line. */
+  GtkWidget *line = GTK_IS_BUTTON (row) ? gtk_button_get_child (GTK_BUTTON (row)) : row;
+  for (GtkWidget *t = gtk_widget_get_first_child (line); t; t = gtk_widget_get_next_sibling (t))
+    {
+      if (!gtk_widget_has_css_class (t, "cf-t")) continue;
+      GtkWidget *sub = gtk_widget_get_last_child (t);
+      if (!sub || !GTK_IS_LABEL (sub) || !gtk_widget_has_css_class (sub, "cf-sub")) return;
+      gtk_label_set_wrap (GTK_LABEL (sub), TRUE);
+      gtk_label_set_wrap_mode (GTK_LABEL (sub), PANGO_WRAP_WORD); /* the address stays whole: a phone row wraps its control instead */
+      gtk_widget_set_tooltip_text (sub, gtk_label_get_text (GTK_LABEL (sub)));
+      return;
+    }
+}
+
+/* ── Online Accounts ─────────────────────────────────────────────────────── */
+static void connect_clicked (GtkButton *button, View *v)
+{
+  const char *name = g_object_get_data (G_OBJECT (button), "cf-provider");
+  g_autofree char *message = g_strdup_printf ("Opens %s sign-in", name ? name : "");
+  luma_toast_show (v->root, message, "done");
+}
+/* Live: goa-daemon's accounts and the providers it can add. Opening,
+ * connecting and removing are GNOME's panel's (the shell delegates). */
+static gboolean live (View *v) { return v->model && cc_luma_fixture_is_live (v->model); }
+static JsonArray *live_data (View *v, const char *name)
+{
+  JsonObject *data = cc_luma_fixture_get_data (v->model);
+  return data && json_object_has_member (data, name) ? json_object_get_array_member (data, name) : NULL;
+}
+static void live_open (GtkButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (v) cc_luma_view_delegated (v);
+}
+static void live_connect (GtkButton *button, View *v) { cc_luma_view_delegated (v); }
+static void live_accounts (View *v)
+{
+  JsonArray *accts = live_data (v, "LIVEACCTS"), *providers = live_data (v, "LIVEPROVIDERS");
+  guint n = accts ? json_array_get_length (accts) : 0;
+  g_autofree char *meta = n == 0 ? g_strdup ("No accounts") : n == 1 ? g_strdup ("One account") : g_strdup_printf ("%u accounts", n);
+  cf_header (v, "Online Accounts", meta, NULL);
+  GtkBox *rows;
+  if (n)
+    {
+      rows = cf_group (v, "Connected", NULL);
+      for (guint i = 0; i < n; i++)
+        {
+          JsonObject *o = json_array_get_object_element (accts, i);
+          GtkWidget *trail = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+          const char *services = json_object_get_string_member_with_default (o, "services", "");
+          if (*services) gtk_box_append (GTK_BOX (trail), cf_value (services, FALSE));
+          gtk_box_append (GTK_BOX (trail), cf_chevron ());
+          GtkWidget *row = cf_row (rows, cf_lead_icon (json_object_get_string_member_with_default (o, "icon", "user")),
+                                   json_object_get_string_member_with_default (o, "provider", ""),
+                                   json_object_get_string_member_with_default (o, "identity", ""), trail, TRUE);
+          g_autofree char *name = g_strdup_printf ("cf-go-acct-%u", i);
+          gtk_widget_set_name (row, name);
+          g_signal_connect_object (row, "clicked", G_CALLBACK (live_open), v->root, 0);
+          spill_subtitle (row);
+        }
+    }
+  guint p = providers ? json_array_get_length (providers) : 0;
+  if (!p) return;
+  rows = cf_group (v, "Connect an account", NULL);
+  for (guint i = 0; i < p; i++)
+    {
+      JsonArray *pair = json_array_get_array_element (providers, i);
+      GtkWidget *row = cf_bt (v, rows, json_array_get_string_element (pair, 0), NULL, "Connect…", FALSE, G_CALLBACK (live_connect));
+      g_autofree char *name = g_strdup_printf ("cf-connect-%u", i);
+      gtk_box_prepend (GTK_BOX (row), cf_lead_icon (json_array_get_string_element (pair, 1)));
+      gtk_widget_set_name (row_button (row), name);
+    }
+}
+static void accounts (View *v)
+{
+  if (live (v)) { live_accounts (v); return; }
+  static const char *providers[][2] = {
+    { "Google", "globe" }, { "Microsoft 365", "briefcase" }, { "Microsoft Exchange", "briefcase" },
+    { "Fastmail", "mail" }, { "Nextcloud", "cloud" }, { "Mail (IMAP and SMTP)", "mail" },
+    { "WebDAV", "server" }, { "Enterprise login", "key-round" } };
+  cf_header (v, "Online Accounts", "Two accounts", NULL);
+  GtkBox *rows = cf_group (v, "Connected", NULL);
+  spill_subtitle (cf_nv (v, rows, "acct-fm", "Fastmail", "nick@studionorth.net", "Mail, calendar, contacts", cf_lead_icon ("mail")));
+  spill_subtitle (cf_nv (v, rows, "acct-nc", "Nextcloud", "cloud.studionorth.net", "Files, calendar", cf_lead_icon ("cloud")));
+  rows = cf_group (v, "Connect an account", NULL);
+  for (guint i = 0; i < G_N_ELEMENTS (providers); i++)
+    {
+      GtkWidget *row = cf_bt (v, rows, providers[i][0], NULL, "Connect…", FALSE, G_CALLBACK (connect_clicked));
+      GtkWidget *button = row_button (row);
+      g_autofree char *name = g_strdup_printf ("cf-connect-%u", i);
+      gtk_box_prepend (GTK_BOX (row), cf_lead_icon (providers[i][1]));
+      gtk_widget_set_name (button, name);
+      g_object_set_data_full (G_OBJECT (button), "cf-provider", g_strdup (providers[i][0]), g_free);
+    }
+}
+static void remove_confirmed (LumaDestructiveDialog *dialog, gboolean checked, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  guint64 *generation = g_object_get_data (G_OBJECT (dialog), "cf-acct-generation");
+  if (!v || !generation || *generation != v->generation || !gtk_widget_get_root (root) ||
+      !g_str_has_prefix (v->page, "acct-")) return;
+  /* v70 only returns to the list; the fixture keeps both accounts. */
+  cc_luma_view_navigate (v, "accounts");
+}
+static void remove_clicked (GtkButton *button, View *v)
+{
+  if (!g_str_has_prefix (v->page, "acct-")) return;
+  LumaDestructiveDialog *dialog = luma_destructive_dialog_ask (v->root, "Remove this account?",
+    "Mail, events and contacts from it leave this computer. Nothing is deleted online.", "Remove", "trash-2", NULL);
+  guint64 *generation = g_new (guint64, 1);
+  *generation = v->generation;
+  g_object_set_data_full (G_OBJECT (dialog), "cf-acct-generation", generation, g_free);
+  g_signal_connect_object (dialog, "confirmed", G_CALLBACK (remove_confirmed), v->root, 0);
+}
+static void account (View *v)
+{
+  gboolean fastmail = g_str_equal (v->page, "acct-fm");
+  cf_header (v, fastmail ? "Fastmail" : "Nextcloud", fastmail ? "nick@studionorth.net" : "cloud.studionorth.net", NULL);
+  GtkBox *rows = cf_group (v, "Use this account for", NULL);
+  if (fastmail)
+    {
+      cf_sw (v, rows, "fmMail", "Mail", "In Charlie", NULL);
+      cf_sw (v, rows, "fmCal", "Calendar", NULL, NULL);
+      cf_sw (v, rows, "fmCon", "Contacts", NULL, NULL);
+      cf_sw (v, rows, "fmFiles", "Files", "In Filer", NULL);
+    }
+  else
+    {
+      cf_sw (v, rows, "ncFiles", "Files", "In Filer", NULL);
+      cf_sw (v, rows, "ncCal", "Calendar", NULL, NULL);
+      cf_sw (v, rows, "ncCon", "Contacts", NULL, NULL);
+    }
+  rows = cf_group (v, NULL, NULL);
+  GtkWidget *row = cf_bt (v, rows, "Remove this account", fastmail ? "Mail and events from it leave this computer" : NULL,
+                          "Remove…", TRUE, G_CALLBACK (remove_clicked));
+  gtk_widget_set_name (row_button (row), "cf-rmacct");
+}
+
+/* ── Wellbeing ───────────────────────────────────────────────────────────── */
+static char *hours_minutes (gint64 m)
+{
+  if (m < 60) return g_strdup_printf ("%" G_GINT64_FORMAT " min", m);
+  if (m % 60) return g_strdup_printf ("%" G_GINT64_FORMAT " h %" G_GINT64_FORMAT " min", m / 60, m % 60);
+  return g_strdup_printf ("%" G_GINT64_FORMAT " h", m / 60);
+}
+/* A dashed rule `bottom` px above the bars' foot (v70 .cfwb hr). */
+static GtkWidget *rule (double bottom, const char *cls)
+{
+  GtkWidget *hr = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_add_css_class (hr, "cf-wk-rule");
+  if (cls) gtk_widget_add_css_class (hr, cls);
+  gtk_widget_set_valign (hr, GTK_ALIGN_START);
+  gtk_widget_set_can_target (hr, FALSE);
+  /* The overlay sits inside .cfweek's padding; the rule's 1 px sits above `bottom`. */
+  gtk_widget_set_margin_top (hr, (int) (196 - bottom - 1 + 0.5));
+  return hr;
+}
+/* v70 cfWeek: seven days of screen time, today lit, the daily average dashed. */
+static GtkWidget *week (View *v)
+{
+  JsonArray *days = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFWEEK");
+  const double top = 420, scale = 130;
+  guint count = json_array_get_length (days);
+  gint64 sum = 0;
+  double limit = cc_luma_view_flag (v, "limit") ? g_ascii_strtod (cc_luma_view_text (v, "limitH"), NULL) * 60 : 0;
+  for (guint i = 0; i < count; i++) sum += json_array_get_int_element (json_array_get_array_element (days, i), 1);
+  GtkWidget *overlay = gtk_overlay_new ();
+  GtkWidget *bars = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 14);
+  gtk_widget_add_css_class (overlay, "cf-week");
+  gtk_widget_add_css_class (bars, "cf-wb");
+  gtk_box_set_homogeneous (GTK_BOX (bars), TRUE);
+  gtk_widget_set_size_request (bars, -1, 196);
+  for (guint i = 0; i < count; i++)
+    {
+      JsonArray *day = json_array_get_array_element (days, i);
+      gint64 minutes = json_array_get_int_element (day, 1);
+      g_autofree char *time = hours_minutes (minutes);
+      GtkWidget *column = gtk_box_new (GTK_ORIENTATION_VERTICAL, 5);
+      GtkWidget *bar = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+      GtkWidget *name = cf_text (json_array_get_string_element (day, 0), "cf-wk-day");
+      GtkWidget *value = cf_text (time, "cf-wk-time");
+      gtk_widget_set_valign (column, GTK_ALIGN_END);
+      if (i == count - 1) gtk_widget_add_css_class (column, "today");
+      if (limit > 0 && minutes > limit) gtk_widget_add_css_class (column, "over");
+      gtk_label_set_xalign (GTK_LABEL (value), 0.5);
+      gtk_label_set_xalign (GTK_LABEL (name), 0.5);
+      gtk_widget_set_halign (value, GTK_ALIGN_CENTER);
+      gtk_widget_set_halign (name, GTK_ALIGN_CENTER);
+      gtk_widget_add_css_class (bar, "cf-wk-bar");
+      /* width: 100%; max-width: 46px: every column is wider than 46. */
+      gtk_widget_set_size_request (bar, 46, (int) (minutes / top * scale + 0.5));
+      gtk_widget_set_halign (bar, GTK_ALIGN_CENTER);
+      gtk_box_append (GTK_BOX (column), value);
+      gtk_box_append (GTK_BOX (column), bar);
+      gtk_box_append (GTK_BOX (column), name);
+      gtk_box_append (GTK_BOX (bars), column);
+    }
+  if (v->phone)
+    {
+      /* v70's seven columns are wider than a phone's hero and spill past it;
+       * GTK can't overflow a parent, so the week keeps its width and is clipped. */
+      GtkWidget *clip = gtk_scrolled_window_new ();
+      gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (clip), GTK_POLICY_EXTERNAL, GTK_POLICY_NEVER);
+      gtk_scrolled_window_set_child (GTK_SCROLLED_WINDOW (clip), bars);
+      gtk_box_set_homogeneous (GTK_BOX (bars), FALSE);
+      gtk_overlay_set_child (GTK_OVERLAY (overlay), clip);
+    }
+  else
+    gtk_overlay_set_child (GTK_OVERLAY (overlay), bars);
+  if (count)
+    {
+      GtkWidget *average = rule ((double) sum / count / top * scale + 21, NULL);
+      gtk_accessible_update_property (GTK_ACCESSIBLE (average), GTK_ACCESSIBLE_PROPERTY_LABEL, "Daily average", -1);
+      gtk_overlay_add_overlay (GTK_OVERLAY (overlay), average);
+    }
+  if (limit > 0)
+    {
+      GtkWidget *line = rule (limit / top * scale + 21, "lim");
+      gtk_accessible_update_property (GTK_ACCESSIBLE (line), GTK_ACCESSIBLE_PROPERTY_LABEL, "Daily limit", -1);
+      gtk_overlay_add_overlay (GTK_OVERLAY (overlay), line);
+    }
+  return overlay;
+}
+static void wellbeing (View *v)
+{
+  JsonArray *days = json_object_get_array_member (cc_luma_fixture_get_data (v->model), "CFWEEK");
+  guint count = json_array_get_length (days);
+  gint64 sum = 0;
+  for (guint i = 0; i < count; i++) sum += json_array_get_int_element (json_array_get_array_element (days, i), 1);
+  g_autofree char *today = hours_minutes (count ? json_array_get_int_element (json_array_get_array_element (days, count - 1), 1) : 0);
+  /* v70: Math.round (sum / 7). */
+  g_autofree char *average = hours_minutes ((gint64) ((double) sum / 7 + 0.5));
+  /* Live with screen-time history off (or not yet written): no week. */
+  gboolean chart = count > 0 || !live (v);
+  g_autofree char *meta = chart ? g_strdup_printf ("Today %s · %s a day this week", today, average)
+                                : g_strdup (cc_luma_view_flag (v, "wb.history") ? "No screen time recorded yet" : "Screen time history is off");
+  const char * const hours[] = { "2", "2 hours", "3", "3 hours", "4", "4 hours", "5", "5 hours", "6", "6 hours", "8", "8 hours", NULL };
+  const char * const breaks[] = { "5-30", "5 minutes every half hour", "5-60", "5 minutes every hour", "10-60", "10 minutes every hour", NULL };
+  gboolean limit = cc_luma_view_flag (v, "limit");
+  cf_header (v, "Wellbeing", meta, NULL);
+  if (chart) cf_hero (v, week (v), "cf-week");
+  GtkBox *rows = cf_group (v, "Screen time", NULL);
+  cf_sw (v, rows, "limit", "Daily limit", NULL, NULL);
+  if (limit)
+    {
+      cf_pk (v, rows, "limitH", "Limit", NULL, hours);
+      cf_sw (v, rows, "gray", "Grey screen at the limit", "Colours drain away once you’re over", NULL);
+    }
+  rows = cf_group (v, "Breaks", NULL);
+  cf_sw (v, rows, "eyes", "Rest your eyes", "Look into the distance for 20 seconds, every 20 minutes", NULL);
+  cf_sw (v, rows, "move", "Move around", "A reminder to stand up", NULL);
+  if (cc_luma_view_flag (v, "move")) cf_pk (v, rows, "moveS", "How often", NULL, breaks);
+  cf_sw (v, rows, "brSound", "Sound when a break ends", NULL, NULL);
+}
+
+void cc_luma_view_people_render (View *v)
+{
+  if (g_str_equal (v->page, "accounts")) accounts (v);
+  else if (g_str_equal (v->page, "acct-fm") || g_str_equal (v->page, "acct-nc")) account (v);
+  else if (g_str_equal (v->page, "wellbeing")) wellbeing (v);
+}
