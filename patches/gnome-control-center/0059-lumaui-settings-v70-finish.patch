+/* ── Search (v70 cfSearch): rows, not pages, found across every page and
+ * working right there in the results. Each page is drawn off screen and its
+ * matching rows are moved into the results. */
+static const char *row_text (GtkWidget *row, const char *cls)
+{
+  for (GtkWidget *w = row; w; )
+    {
+      if (GTK_IS_LABEL (w) && gtk_widget_has_css_class (w, cls)) return gtk_label_get_text (GTK_LABEL (w));
+      GtkWidget *next = gtk_widget_get_first_child (w);
+      if (!next)
+        {
+          while (w && w != row && !gtk_widget_get_next_sibling (w)) w = gtk_widget_get_parent (w);
+          if (!w || w == row) return NULL;
+          next = gtk_widget_get_next_sibling (w);
+        }
+      w = next;
+    }
+  return NULL;
+}
+static void collect_rows (GtkWidget *w, GPtrArray *rows)
+{
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c))
+    {
+      if (gtk_widget_has_css_class (c, "cf-row") && GTK_IS_BOX (gtk_widget_get_parent (c)) &&
+          gtk_widget_has_css_class (gtk_widget_get_parent (c), "cf-card"))
+        g_ptr_array_add (rows, c);
+      else
+        collect_rows (c, rows);
+    }
+}
+static gboolean contains (const char *text, const char *needle)
+{
+  g_autofree char *a = text ? g_utf8_casefold (text, -1) : NULL;
+  return a && strstr (a, needle) != NULL;
+}
