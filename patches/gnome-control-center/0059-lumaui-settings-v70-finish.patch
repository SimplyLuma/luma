+/* OKLCH to sRGB, for the page wash's hue (v70 uses oklch for it). */
+static double srgb_channel (double c) { c = c <= 0.0031308 ? 12.92 * c : 1.055 * pow (c, 1 / 2.4) - 0.055; return CLAMP (c, 0, 1); }
+static void oklch_rgba (double l, double c, double h, double alpha, GdkRGBA *out)
+{
+  double a = c * cos (h * G_PI / 180), b = c * sin (h * G_PI / 180);
+  double l_ = l + 0.3963377774 * a + 0.2158037573 * b, m_ = l - 0.1055613458 * a - 0.0638541728 * b, s_ = l - 0.0894841775 * a - 1.2914855480 * b;
+  double L = l_ * l_ * l_, M = m_ * m_ * m_, S = s_ * s_ * s_;
+  out->red = srgb_channel (4.0767416621 * L - 3.3077115913 * M + 0.2309699292 * S);
+  out->green = srgb_channel (-1.2684380046 * L + 2.6097574011 * M - 0.3413193965 * S);
+  out->blue = srgb_channel (-0.0041960863 * L - 0.7034186147 * M + 1.7076127010 * S);
+  out->alpha = alpha;
+}
+static int page_hue (View *v)
+{
+  static const struct { const char *page; int hue; } hues[] = {
+    { "me", 250 }, { "wifi", 250 }, { "network", 220 }, { "bluetooth", 255 }, { "shelf", 190 }, { "windows", 170 },
+    { "notifications", 20 }, { "search", 240 }, { "displays", 200 }, { "sound", 330 }, { "power", 145 }, { "mouse", 280 },
+    { "keyboard", 60 }, { "printers", 30 }, { "apps", 300 }, { "accounts", 265 }, { "privacy", 150 }, { "wellbeing", 120 },
+    { "a11y", 235 }, { "sharing", 185 }, { "region", 95 }, { "datetime", 50 }, { "users", 290 }, { "remote", 210 },
+    { "ssh", 160 }, { "about", 250 } };
+  const char *root = v->page;
+  JsonArray *pages = v->model ? cc_luma_fixture_get_pages (v->model) : NULL;
+  if (g_str_has_prefix (root, "app:")) root = "apps";
+  for (guint i = 0; pages && i < json_array_get_length (pages); i++)
+    {
+      JsonObject *p = json_array_get_object_element (pages, i);
+      JsonNode *up = json_object_get_member (p, "parent");
+      if (g_str_equal (json_object_get_string_member (p, "id"), root) && up && json_node_get_value_type (up) == G_TYPE_STRING)
+        { root = json_node_get_string (up); i = (guint) -1; }
+    }
+  for (guint i = 0; i < G_N_ELEMENTS (hues); i++)
+    if (g_str_equal (hues[i].page, root)) return hues[i].hue;
+  JsonNode *accent = v->model ? cc_luma_fixture_get (v->model, "acc") : NULL;
+  return accent ? (int) json_node_get_int (accent) : 250;
+}
