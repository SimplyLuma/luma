+      int index = row_index (row);
+      if (index < first || index > last || (guint) index >= r->items->len)
+        {
+          set_row_index (row, -1);
+          gtk_widget_set_child_visible (row, FALSE);
+          g_ptr_array_add (free_rows, row);
+        }
+      else bound[index] = TRUE;
+    }
+  for (int i = first; i <= last && i >= 0; i++)
+    {
+      if (bound[i]) continue;
+      GtkWidget *row = free_rows->len ? g_ptr_array_steal_index_fast (free_rows, free_rows->len - 1) : recycled_row (r);
+      bind_row (r, row, i);
+    }
+  /* Children in list order: the card's first row takes no top line (v70's
+   * .cfrow + .cfrow), and the topmost bound row is above the viewport. */
+  g_autoptr (GPtrArray) order = g_ptr_array_copy (r->rows, NULL, NULL);
+  g_ptr_array_sort (order, by_index);
+  GtkWidget *previous = NULL;
+  for (guint k = 0; k < order->len; k++)
+    {
+      GtkWidget *row = order->pdata[k];
+      if (row_index (row) < 0) continue;
+      gtk_widget_insert_after (row, r->card, previous);
+      previous = row;
+    }
+  gtk_widget_queue_allocate (r->card);
+}
+
+static gboolean
+recycler_tick (GtkWidget *card, GdkFrameClock *clock, gpointer data)
+{
+  Recycler *r = data;
+  r->tick = 0;
+  /* The row height for this width, from a bound row. */
+  for (guint k = 0; k < r->rows->len; k++)
+    if (row_index (r->rows->pdata[k]) >= 0 && r->width > 0)
+      {
+        int min, nat;
+        gtk_widget_measure (r->rows->pdata[k], GTK_ORIENTATION_VERTICAL, r->width, &min, &nat, NULL, NULL);
+        if (nat > 0 && nat != r->row_h) { r->row_h = nat; gtk_widget_queue_resize (card); }
+        break;
+      }
+  recycler_update (r);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+recycler_schedule (Recycler *r)
+{
+  if (!r->tick) r->tick = gtk_widget_add_tick_callback (r->card, recycler_tick, r, NULL);
+}
+
+static void
+recycler_measure (GtkWidget *card, GtkOrientation orientation, int for_size, int *min, int *nat, int *min_base, int *nat_base)
+{
+  Recycler *r = g_object_get_data (G_OBJECT (card), "cf-recycler");
+  *min = *nat = 0;
+  if (orientation == GTK_ORIENTATION_VERTICAL)
+    {
+      *min = *nat = r ? r->row_h * (int) r->items->len : 0;
+      return;
+    }
+  for (GtkWidget *c = gtk_widget_get_first_child (card); c; c = gtk_widget_get_next_sibling (c))
+    {
+      int cmin, cnat;
+      gtk_widget_measure (c, orientation, -1, &cmin, &cnat, NULL, NULL);
+      *min = MAX (*min, cmin);
+      *nat = MAX (*nat, cnat);
+    }
+}
+
+static void
+recycler_allocate (GtkWidget *card, int width, int height, int baseline)
+{
+  Recycler *r = g_object_get_data (G_OBJECT (card), "cf-recycler");
+  if (!r) return;
+  for (GtkWidget *c = gtk_widget_get_first_child (card); c; c = gtk_widget_get_next_sibling (c))
+    {
+      int index = row_index (c);
+      if (index < 0) continue;
+      GskTransform *at = gsk_transform_translate (NULL, &GRAPHENE_POINT_INIT (0, (float) (index * r->row_h)));
+      gtk_widget_allocate (c, width, r->row_h, -1, at);
+    }
+  if (width != r->width) { r->width = width; recycler_schedule (r); }
+  int first, last, have_first = G_MAXINT, have_last = -1;
+  visible_range (r, &first, &last);
+  for (GtkWidget *c = gtk_widget_get_first_child (card); c; c = gtk_widget_get_next_sibling (c))
+    if (row_index (c) >= 0) { have_first = MIN (have_first, row_index (c)); have_last = MAX (have_last, row_index (c)); }
+  if (first != have_first || last != have_last) recycler_schedule (r);
+}
+
+static void
+recycler_scrolled (GtkAdjustment *adj, Recycler *r)
+{
+  recycler_update (r);
+}
+
+static void
+recycler_mapped (GtkWidget *card, Recycler *r)
+{
+  GtkWidget *scroller = gtk_widget_get_ancestor (card, GTK_TYPE_SCROLLED_WINDOW);
+  GtkAdjustment *adj = scroller ? gtk_scrolled_window_get_vadjustment (GTK_SCROLLED_WINDOW (scroller)) : NULL;
+  if (adj != r->adj)
+    {
+      if (r->adj_handler) g_clear_signal_handler (&r->adj_handler, r->adj);
+      g_set_object (&r->adj, adj);
+      if (adj) r->adj_handler = g_signal_connect (adj, "value-changed", G_CALLBACK (recycler_scrolled), r);
+    }
+  recycler_schedule (r);
+}
+
+static void
+recycler_dispose_card (GtkWidget *card, gpointer unused)
+{
+  GtkWidget *c;
+  while ((c = gtk_widget_get_first_child (card))) gtk_widget_unparent (c);
+}
+
+/* What the list draws: when it is unchanged, a redraw keeps the list. */
+static char *
+apps_signature (View *v, JsonArray *apps)
+{
+  JsonObject *data = cc_luma_fixture_get_data (v->model);
+  GString *s = g_string_new (v->phone ? "phone" : "desk");
+  JsonNode *cats = json_object_get_member (data, "CFAPPCATS"), *sizes = json_object_get_member (data, "CFSZ");
+  g_autofree char *c = cats ? json_to_string (cats, FALSE) : NULL, *z = sizes ? json_to_string (sizes, FALSE) : NULL;
+  g_string_append_printf (s, "|%s|%s", c ? c : "", z ? z : "");
+  for (guint i = 0; i < json_array_get_length (apps); i++)
+    {
+      const char *id = json_array_get_string_element (apps, i);
+      g_string_append_printf (s, "|%s=%s", id, cc_luma_fixture_app_name (v->model, id));
+    }
+  return g_string_free (s, FALSE);
+}
+
+static Recycler *
+recycler_new (View *v)
+{
+  Recycler *r = g_new0 (Recycler, 1);
+  r->v = v;
+  r->items = g_ptr_array_new_with_free_func ((GDestroyNotify) app_item_free);
+  r->rows = g_ptr_array_new ();
+  r->row_h = 52;
+  /* cf_group_with's section, holding the recycling card. */
+  r->section = g_object_ref_sink (gtk_box_new (GTK_ORIENTATION_VERTICAL, 0));
+  gtk_widget_add_css_class (r->section, "cf-group");
+  GtkWidget *h6 = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_add_css_class (h6, "cf-h6");
+  GtkWidget *label = cf_text ("Installed", NULL);
+  luma_ui_apply_type_full (label, "group-heading", TRUE);
+  gtk_widget_set_hexpand (label, TRUE);
+  gtk_box_append (GTK_BOX (h6), label);
+  gtk_box_append (GTK_BOX (r->section), h6);
+  r->card = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  gtk_widget_set_layout_manager (r->card, gtk_custom_layout_new (NULL, recycler_measure, recycler_allocate));
+  gtk_widget_add_css_class (r->card, "cf-card");
+  gtk_widget_set_overflow (r->card, GTK_OVERFLOW_HIDDEN);
+  gtk_widget_set_name (r->card, "cf-apps-list");
+  g_object_set_data (G_OBJECT (r->card), "cf-recycler", r);
+  g_signal_connect (r->card, "map", G_CALLBACK (recycler_mapped), r);
+  g_signal_connect (r->card, "destroy", G_CALLBACK (recycler_dispose_card), NULL);
+  gtk_box_append (GTK_BOX (r->section), r->card);
+  if (!live_recyclers) live_recyclers = g_ptr_array_new ();
+  g_ptr_array_add (live_recyclers, r);
+  return r;
+}
+
+static void
+recycler_set_items (Recycler *r, JsonArray *apps, JsonObject *categories)
+{
+  View *v = r->v;
+  g_ptr_array_set_size (r->items, 0);
+  for (guint i = 0; i < json_array_get_length (apps); i++)
+    {
+      const char *id = json_array_get_string_element (apps, i);
+      JsonNode *category = categories ? json_object_get_member (categories, id) : NULL;
+      gint64 total = app_total (v, id);
+      AppItem *item = g_new0 (AppItem, 1);
+      item->id = g_strdup (id);
+      item->name = g_strdup (cc_luma_fixture_app_name (v->model, id));
+      item->category = category && json_node_get_value_type (category) == G_TYPE_STRING ? g_strdup (json_node_get_string (category)) : NULL;
+      item->size = total >= 0 ? cc_luma_fixture_format_size (total) : NULL;
+      item->path = cc_luma_fixture_asset_path (v->model, id, NULL);
+      g_ptr_array_add (r->items, item);
+    }
+  for (guint k = 0; k < r->rows->len; k++)
+    {
+      set_row_index (r->rows->pdata[k], -1);
+      gtk_widget_set_child_visible (r->rows->pdata[k], FALSE);
+    }
+  gtk_widget_queue_resize (r->card);
+  recycler_update (r);
+}
+
+/* The Installed group as a recycling list, kept across redraws. */
+static void
+recycled_apps (View *v, JsonArray *apps, JsonObject *categories)
+{
+  Recycler *r = g_object_get_data (G_OBJECT (v->root), "cf-apps-recycler");
+  g_autofree char *signature = apps_signature (v, apps);
+  if (!r)
+    {
+      r = recycler_new (v);
+      g_object_set_data_full (G_OBJECT (v->root), "cf-apps-recycler", r, (GDestroyNotify) recycler_free);
+    }
+  if (g_strcmp0 (signature, r->signature) != 0)
+    {
+      g_free (r->signature);
+      r->signature = g_steal_pointer (&signature);
+      recycler_set_items (r, apps, categories);
+    }
+  gtk_box_append (v->body, r->section);
+}
