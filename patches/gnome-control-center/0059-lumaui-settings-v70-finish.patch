+/* v70 .cfdayl: every label is a zero-width anchor; the ends are flush. */
+static void day_measure (GtkWidget *w, GtkOrientation o, int for_size, int *min, int *nat, int *minb, int *natb)
+{
+  *min = *nat = 0; *minb = *natb = -1;
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c))
+    {
+      int cm, cn;
+      gtk_widget_measure (c, o, -1, &cm, &cn, NULL, NULL);
+      if (o == GTK_ORIENTATION_VERTICAL) *min = *nat = MAX (*nat, cn);
+    }
+}
+
+static void day_allocate (GtkWidget *w, int width, int height, int baseline)
+{
+  guint n = 0, i = 0;
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c)) n++;
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c), i++)
+    {
+      /* v70's spans are zero wide at their tick and the text runs from it (the ends flush with the
+       * timeline, the rest centred), so every word stays over the timeline. */
+      double at = n > 1 ? width * (double) i / (n - 1) : 0;
+      gtk_label_set_xalign (GTK_LABEL (c), i == 0 ? 0 : i == n - 1 ? 1 : .5);
+      graphene_point_t p = GRAPHENE_POINT_INIT ((float) at, 0);
+      gtk_widget_allocate (c, 0, height, -1, gsk_transform_translate (NULL, &p));
+    }
+}
