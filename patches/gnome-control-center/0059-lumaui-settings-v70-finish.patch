+/* ── Live models ──────────────────────────────────────────────────────── */
+CcLumaFixture *
+cc_luma_fixture_new_live (JsonNode *structure)
+{
+  CcLumaFixture *self = g_object_new (CC_TYPE_LUMA_FIXTURE, NULL);
+  self->root = json_node_copy (structure);
+  self->live = TRUE;
+  self->writable = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  self->verified = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  return self;
+}
+gboolean cc_luma_fixture_is_live (CcLumaFixture *self) { return self && self->live; }
+void
+cc_luma_fixture_set_writer (CcLumaFixture *self, CcLumaModelWriter writer, gpointer data)
+{
+  self->writer = writer;
+  self->writer_data = data;
+}
+void
+cc_luma_fixture_own_key (CcLumaFixture *self, const char *key)
+{
+  if (self->writable) g_hash_table_add (self->writable, g_strdup (key));
+}
+gboolean
+cc_luma_fixture_writable (CcLumaFixture *self, const char *key)
+{
+  if (!self || !self->live) return TRUE;
+  return key && g_hash_table_contains (self->writable, key);
+}
+gboolean
+cc_luma_fixture_write (CcLumaFixture *self, const char *key, JsonNode *value, GError **error)
+{
+  if (!self->live) return TRUE;
+  if (!cc_luma_fixture_key_verified (self, key))
+    {
+      g_set_error (error, CC_LUMA_WRITE_DELEGATED, 0, "%s changes in its GNOME panel", key);
+      return FALSE;
+    }
+  if (!cc_luma_fixture_writable (self, key) || !self->writer)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "This setting can’t be changed here yet: %s", key);
+      return FALSE;
+    }
+  return self->writer (self, key, value, self->writer_data, error);
+}
+static gboolean
+emit_changed (gpointer data)
+{
+  CcLumaFixture *self = data;
+  self->changed_idle = 0;
+  g_signal_emit (self, fixture_signals[CHANGED], 0);
+  return G_SOURCE_REMOVE;
+}
+void
+cc_luma_fixture_changed (CcLumaFixture *self)
+{
+  if (!self->changed_idle) self->changed_idle = g_idle_add (emit_changed, self);
+}
+/* Adapters publish what the system reports: no writer, no type check against
+ * a previous value (the first report creates the key). */
+void
+cc_luma_fixture_publish (CcLumaFixture *self, const char *key, JsonNode *value)
+{
+  g_auto (GStrv) parts = g_strsplit (key, ".", -1);
+  JsonObject *object = json_object_get_object_member (json_node_get_object (self->root), "settings");
+  for (guint i = 0; parts[i] && parts[i + 1]; i++)
+    {
+      if (!member_type (object, parts[i], JSON_NODE_OBJECT))
+        json_object_set_object_member (object, parts[i], json_object_new ());
+      object = json_object_get_object_member (object, parts[i]);
+    }
+  JsonNode *previous = json_object_get_member (object, parts[g_strv_length (parts) - 1]);
+  if (previous && json_node_equal (previous, value)) return; /* an echo of what is shown */
+  json_object_set_member (object, parts[g_strv_length (parts) - 1], json_node_copy (value));
+  cc_luma_fixture_changed (self);
+}
+void
+cc_luma_fixture_publish_data (CcLumaFixture *self, const char *name, JsonNode *value)
+{
+  JsonObject *data = json_object_get_object_member (json_node_get_object (self->root), "data");
+  JsonNode *previous = json_object_get_member (data, name);
+  /* An owner re-reporting the same list (a timer, a meter) must not redraw every page several times a
+   * second: that dropped clicks and images mid-load (VM, 30 Sep). */
+  if (previous && value && json_node_equal (previous, value)) return;
+  json_object_set_member (data, name, json_node_copy (value));
+  cc_luma_fixture_changed (self);
+}
+void
+cc_luma_fixture_publish_asset (CcLumaFixture *self, const char *id, const char *path)
+{
+  if (!self->live || !id) return;
+  if (!self->assets) self->assets = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+  if (path) g_hash_table_replace (self->assets, g_strdup (id), g_strdup (path));
+  else g_hash_table_remove (self->assets, id);
+}
+void cc_luma_fixture_publish_boolean (CcLumaFixture *self, const char *key, gboolean value)
+{ g_autoptr (JsonNode) n = json_node_init_boolean (json_node_alloc (), value); cc_luma_fixture_publish (self, key, n); }
+void cc_luma_fixture_publish_string (CcLumaFixture *self, const char *key, const char *value)
+{ g_autoptr (JsonNode) n = json_node_init_string (json_node_alloc (), value ? value : ""); cc_luma_fixture_publish (self, key, n); }
+void cc_luma_fixture_publish_int (CcLumaFixture *self, const char *key, gint64 value)
+{ g_autoptr (JsonNode) n = json_node_init_int (json_node_alloc (), value); cc_luma_fixture_publish (self, key, n); }
+/* An owner that stops reporting a key (the system lost the control): pages
+ * leave its row out. */
+void
+cc_luma_fixture_unpublish (CcLumaFixture *self, const char *key)
+{
+  g_autofree char *leaf = NULL;
+  JsonObject *object = parent_for_key (self, key, &leaf);
+  if (!object || !json_object_has_member (object, leaf)) return;
+  json_object_remove_member (object, leaf);
+  cc_luma_fixture_changed (self);
+}
+void cc_luma_fixture_publish_double (CcLumaFixture *self, const char *key, double value)
+{ g_autoptr (JsonNode) n = json_node_init_double (json_node_alloc (), value); cc_luma_fixture_publish (self, key, n); }
+void
+cc_luma_fixture_set_page_ready_func (CcLumaFixture *self, CcLumaPageReadyFunc func, gpointer data)
+{
+  self->ready = func;
+  self->ready_data = data;
+}
+gboolean
+cc_luma_fixture_page_ready (CcLumaFixture *self, const char *page)
+{
+  if (!self || !self->live) return TRUE;
+  return self->ready ? self->ready (self, page, self->ready_data) : FALSE;
+}
+void
+cc_luma_fixture_verify_key (CcLumaFixture *self, const char *key)
+{
+  if (self->verified) g_hash_table_add (self->verified, g_strdup (key));
+}
+gboolean
+cc_luma_fixture_key_verified (CcLumaFixture *self, const char *key)
+{
+  if (!self || !self->live) return TRUE;
+  return key && g_hash_table_contains (self->verified, key);
+}
+/* Isolated adapter tests exercise every owned key's write path. */
+void
+cc_luma_fixture_verify_owned_keys (CcLumaFixture *self)
+{
+  GHashTableIter iter;
+  gpointer key;
+  g_hash_table_iter_init (&iter, self->writable);
+  while (g_hash_table_iter_next (&iter, &key, NULL))
+    cc_luma_fixture_verify_key (self, key);
+}
