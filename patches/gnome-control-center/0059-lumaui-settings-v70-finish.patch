diff --git a/shell/cc-luma-window.c b/shell/cc-luma-window.c
new file mode 100644
index 0000000..bcdbdca
--- /dev/null
+++ b/shell/cc-luma-window.c
@@ -0,0 +1,391 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Settings' window, composed only of LumaUI parts: the title row with the
+ * app's identity and the sidebar toggle, the navigation sidebar (the account
+ * card in its own frame, the destinations in their sections, search at the
+ * foot) and the page island. */
+#include "cc-luma-window.h"
+#include <string.h>
+#include "cc-luma-view.h"
+#include "cc-luma-shell.h"
+#include <luma-ui.h>
+
+typedef struct {
+  const char *id;
+  const char *title;
+  const char *icon;
+} Destination;
+
+/* Studio v70 CFP: each top-level page's name and Lucide icon. */
+static const Destination destinations[] = {
+  { "wifi", "Wi‑Fi", "wifi" },
+  { "network", "Network", "ethernet-port" },
+  { "bluetooth", "Bluetooth", "bluetooth" },
+  { "appearance", "Appearance", "palette" },
+  { "shelf", "Shelf", "panel-bottom" },
+  { "windows", "Windows & Workspaces", "square-stack" },
+  { "notifications", "Notifications", "bell" },
+  { "search", "Search", "search" },
+  { "displays", "Displays", "monitor" },
+  { "sound", "Sound", "volume-2" },
+  { "power", "Power", "battery-medium" },
+  { "mouse", "Mouse & Touchpad", "mouse" },
+  { "keyboard", "Keyboard", "keyboard" },
+  { "printers", "Printers", "printer" },
+  { "apps", "Apps", "layout-grid" },
+  { "accounts", "Online Accounts", "at-sign" },
+  { "privacy", "Privacy & Security", "shield" },
+  { "wellbeing", "Wellbeing", "hourglass" },
+  { "a11y", "Accessibility", "accessibility" },
+  { "sharing", "Sharing", "share-2" },
+  { "region", "Region & Language", "languages" },
+  { "datetime", "Date & Time", "clock" },
+  { "users", "Users", "users" },
+  { "remote", "Remote Desktop", "monitor-up" },
+  { "ssh", "Secure Shell", "terminal" },
+  { "about", "About", "info" },
+};
+
+typedef struct {
+  CcLumaFixture *model;
+  GtkWidget *shell;
+  GtkWidget *account;
+  GtkWidget *foot;
+  GtkListBox *list;
+  GHashTable *rows; /* id → LumaNavigationRow */
+  GtkWidget *stack;  /* a phone: the list first (LumaListFirst) */
+  char *shown;       /* the page last shown, so only a new page pushes */
+  gboolean following;
+} Frame;
+
+static void frame_free (Frame *f)
+{
+  g_clear_object (&f->model);
+  g_free (f->shown);
+  g_hash_table_unref (f->rows);
+  g_free (f);
+}
+
+static const Destination *destination (const char *id)
+{
+  for (guint i = 0; i < G_N_ELEMENTS (destinations); i++)
+    if (g_str_equal (destinations[i].id, id)) return &destinations[i];
+  return NULL;
+}
+
+/* The top-level page a page belongs to (cfRoot). */
+static char *root_page (CcLumaFixture *model, const char *page)
+{
+  if (!page) return g_strdup ("wifi");
+  if (g_str_has_prefix (page, "app:")) return g_strdup ("apps");
+  g_autofree char *current = g_strdup (page);
+  JsonArray *pages = model ? cc_luma_fixture_get_pages (model) : NULL;
+  for (guint depth = 0; pages && depth < 8; depth++)
+    {
+      const char *parent = NULL;
+      for (guint i = 0; i < json_array_get_length (pages); i++)
+        {
+          JsonObject *p = json_array_get_object_element (pages, i);
+          if (g_strcmp0 (json_object_get_string_member_with_default (p, "id", ""), current) == 0)
+            {
+              JsonNode *up = json_object_get_member (p, "parent");
+              if (up && json_node_get_value_type (up) == G_TYPE_STRING) parent = json_node_get_string (up);
+              break;
+            }
+        }
+      if (!parent) break;
+      g_free (current);
+      current = g_strdup (parent);
+    }
+  return g_steal_pointer (&current);
+}
+
+/* The quiet state beside a destination (CFP em). */
+static char *meta (CcLumaFixture *model, const char *id)
+{
+  JsonNode *n;
+  if (!model) return NULL;
+  if (g_str_equal (id, "wifi"))
+    {
+      n = cc_luma_fixture_get (model, "wifi");
+      if (!n) return NULL; /* nothing reported yet */
+      if (!json_node_get_boolean (n)) return g_strdup ("Off");
+      n = cc_luma_fixture_get (model, "net");
+      return g_strdup (n && *json_node_get_string (n) ? json_node_get_string (n) : "Not connected");
+    }
+  if (g_str_equal (id, "bluetooth"))
+    {
+      n = cc_luma_fixture_get (model, "bt");
+      return n ? g_strdup (json_node_get_boolean (n) ? "On" : "Off") : NULL;
+    }
+  if (g_str_equal (id, "power"))
+    {
+      JsonObject *data = cc_luma_fixture_get_data (model);
+      JsonObject *power = data && json_object_has_member (data, "CFPOWER") ? json_object_get_object_member (data, "CFPOWER") : NULL;
+      if (power && json_object_has_member (power, "percentage"))
+        return g_strdup_printf ("%" G_GINT64_FORMAT "%%", json_object_get_int_member (power, "percentage"));
+    }
+  return NULL;
+}
+
+/* Whether this device is a phone (LUMA_FORM_FACTOR, else CHASSIS=handset), as the kit decides it.
+ * TODO(kit): use a public luma_ui_mobile_form_factor () once the kit exports it. */
+static gboolean phone_form_factor (void)
+{
+  const char *value = g_getenv ("LUMA_FORM_FACTOR");
+  g_autofree char *info = NULL;
+  if (value && *value)
+    return !g_ascii_strcasecmp (value, "phone") || !g_ascii_strcasecmp (value, "handset") || !g_ascii_strcasecmp (value, "mobile");
+  if (!g_file_get_contents ("/etc/machine-info", &info, NULL, NULL)) return FALSE;
+  return strstr (info, "CHASSIS=handset") || strstr (info, "CHASSIS=\"handset\"");
+}
+
+static void top_of_pages (GtkWidget *w)
+{
+  if (GTK_IS_SCROLLED_WINDOW (w) && gtk_widget_get_ancestor (w, CC_TYPE_LUMA_SHELL))
+    gtk_adjustment_set_value (gtk_scrolled_window_get_vadjustment (GTK_SCROLLED_WINDOW (w)), 0);
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c))
+    top_of_pages (c);
+}
+static gboolean settle_open (gpointer data)
+{
+  GtkWidget *window = data;
+  Frame *f = g_object_get_data (G_OBJECT (window), "cf-frame");
+  if (!f) return G_SOURCE_REMOVE;
+  GtkListBoxRow *row = gtk_list_box_get_selected_row (f->list);
+  GtkWidget *focus = gtk_root_get_focus (GTK_ROOT (window));
+  if (!focus || GTK_IS_EDITABLE (focus) || GTK_IS_TEXT (focus) || gtk_widget_get_ancestor (focus, CC_TYPE_LUMA_SHELL))
+    {
+      /* The destination takes it only where it is in view (focusing would scroll the sidebar, which v70
+       * never does); a phone's hidden sidebar or a destination below the fold leaves nothing focused. */
+      GtkWidget *sw = row ? gtk_widget_get_ancestor (GTK_WIDGET (row), GTK_TYPE_SCROLLED_WINDOW) : NULL;
+      graphene_rect_t b;
+      gboolean in_view = row && gtk_widget_get_mapped (GTK_WIDGET (row)) && sw &&
+                         gtk_widget_compute_bounds (GTK_WIDGET (row), sw, &b) && b.origin.y >= 0 &&
+                         b.origin.y + b.size.height <= gtk_widget_get_height (sw);
+      if (!in_view || !gtk_widget_grab_focus (GTK_WIDGET (row)))
+        gtk_root_set_focus (GTK_ROOT (window), NULL);
+      /* The first focus had scrolled the page to it: a page opens at its top. */
+      top_of_pages (window);
+    }
+  return G_SOURCE_REMOVE;
+}
+static void focus_destination (GtkWidget *window, Frame *f)
+{
+  g_idle_add_full (G_PRIORITY_LOW, settle_open, g_object_ref (window), g_object_unref);
+}
+
+static void follow_page (CcLumaShell *shell, const char *page, gpointer data)
+{
+  Frame *f = data;
+  if (!page) return;
+  g_autofree char *root = root_page (f->model, page);
+  GHashTableIter iter;
+  gpointer id, row;
+  f->following = TRUE;
+  /* v71 phone ("Settings (polish)"): the list shows no selected row, and the account card is a card,
+   * never the raised selected chip. */
+  gboolean phone = phone_form_factor ();
+  luma_account_card_set_selected (LUMA_ACCOUNT_CARD (f->account), !phone && g_str_equal (root, "me"));
+  row = phone ? NULL : g_hash_table_lookup (f->rows, root);
+  if (row)
+    {
+      gtk_list_box_select_row (f->list, row);
+    }
+  else gtk_list_box_unselect_all (f->list);
+  g_hash_table_iter_init (&iter, f->rows);
+  while (g_hash_table_iter_next (&iter, &id, &row))
+    {
+      g_autofree char *m = meta (f->model, id);
+      luma_navigation_row_set_meta (LUMA_NAVIGATION_ROW (row), m);
+    }
+  f->following = FALSE;
+  /* A phone: a page opened by any route but Back (a picked row is pushed by the kit itself, the
+   * account card, a subpage, a panel asked for from outside) shows the page, not the list. */
+  if (f->stack && g_strcmp0 (f->shown, page) != 0)
+    luma_list_first_show_detail (LUMA_LIST_FIRST (f->stack));
+  g_free (f->shown);
+  f->shown = g_strdup (page);
+}
+
+static void refresh_meta (GtkWidget *shell)
+{
+  Frame *f = g_object_get_data (G_OBJECT (gtk_widget_get_root (shell)), "cf-frame");
+  if (f && cc_luma_shell_get_page (CC_LUMA_SHELL (shell))) follow_page (CC_LUMA_SHELL (shell), cc_luma_shell_get_page (CC_LUMA_SHELL (shell)), f);
+}
+
+/* While searching, each destination shows its hit count and the rest dim (v70 cfSide). */
+static void search_counts (GtkWidget *view, GHashTable *counts, gpointer data)
+{
+  Frame *f = data;
+  GHashTableIter iter;
+  gpointer id, row;
+  if (!counts)
+    {
+      g_hash_table_iter_init (&iter, f->rows);
+      while (g_hash_table_iter_next (&iter, &id, &row))
+        {
+          luma_navigation_row_set_trail (LUMA_NAVIGATION_ROW (row), NULL);
+          gtk_widget_remove_css_class (row, "cf-dim");
+        }
+      follow_page (CC_LUMA_SHELL (f->shell), cc_luma_shell_get_page (CC_LUMA_SHELL (f->shell)), f);
+      return;
+    }
+  f->following = TRUE;
+  gtk_list_box_unselect_all (f->list);
+  luma_account_card_set_selected (LUMA_ACCOUNT_CARD (f->account), FALSE);
+  g_hash_table_iter_init (&iter, f->rows);
+  while (g_hash_table_iter_next (&iter, &id, &row))
+    {
+      guint n = GPOINTER_TO_UINT (g_hash_table_lookup (counts, id));
+      luma_navigation_row_set_meta (LUMA_NAVIGATION_ROW (row), NULL);
+      luma_navigation_row_set_trail (LUMA_NAVIGATION_ROW (row), luma_count_badge_new (n, FALSE));
+      if (n) gtk_widget_remove_css_class (row, "cf-dim");
+      else gtk_widget_add_css_class (row, "cf-dim");
+    }
+  f->following = FALSE;
+}
+
+static void search_changed (GtkWidget *foot, const char *text, Frame *f)
+{
+  cc_luma_shell_search (CC_LUMA_SHELL (f->shell), text, search_counts, f);
+}
+
+static void row_activated (GtkListBox *list, GtkListBoxRow *row, Frame *f)
+{
+  const char *id = g_object_get_data (G_OBJECT (row), "cf-page");
+  if (!f->following && id) cc_luma_shell_go (CC_LUMA_SHELL (f->shell), id);
+}
+
+static void row_selected (GtkListBox *list, GtkListBoxRow *row, Frame *f)
+{
+  if (!f->following && row) row_activated (list, row, f);
+}
+
+static void account_clicked (GtkButton *button, Frame *f)
+{
+  cc_luma_shell_go (CC_LUMA_SHELL (f->shell), "me");
+  if (f->stack) luma_list_first_show_detail (LUMA_LIST_FIRST (f->stack)); /* the card isn't a list row */
+}
+
+/* v71 phone: the page's title island leads the list (its ‹ on a top-level page is phone.js .phback →
+ * navopen; a subpage's ‹ goes up and stops there), and the list's floating ‹ steps aside for it. */
+static void page_island (GtkWidget *view, GtkWidget *island, gboolean back, gpointer data)
+{
+  Frame *f = data;
+  if (!f->stack) return;
+  if (!back) luma_list_first_attach_island (LUMA_LIST_FIRST (f->stack), LUMA_TITLE_ISLAND (island));
+}
+
+GtkWidget *cc_luma_window_new (GtkApplication *application, CcLumaFixture *model, GtkWidget *view)
+{
+  Frame *f = g_new0 (Frame, 1);
+  GtkWidget *window = luma_application_window_new (application, NULL);
+  GtkWidget *sidebar = luma_navigation_sidebar_new ("settings", NULL);
+  GtkWidget *island = luma_island_new (GTK_ORIENTATION_VERTICAL);
+  GtkWidget *foot = luma_sidebar_foot_new ("Search settings");
+  g_autoptr (GMenu) menu = g_menu_new ();
+  JsonObject *data = model ? cc_luma_fixture_get_data (model) : NULL;
+  JsonArray *groups = data && json_object_has_member (data, "CFGRPS") ? json_object_get_array_member (data, "CFGRPS") : NULL;
+
+  f->model = model ? g_object_ref (model) : NULL;
+  f->shell = cc_luma_shell_new (model, view);
+  f->rows = g_hash_table_new (g_str_hash, g_str_equal);
+  gtk_window_set_title (GTK_WINDOW (window), "Settings");
+  gtk_widget_set_name (window, "cf-window");
+  luma_application_window_set_identity (LUMA_APPLICATION_WINDOW (window), "Settings", NULL, "org.gnome.Settings");
+  g_menu_append (menu, "About Settings", "app.about");
+  luma_application_window_set_menu_model (LUMA_APPLICATION_WINDOW (window), G_MENU_MODEL (menu));
+
+  gtk_widget_set_name (sidebar, "cf-sidebar");
+  f->list = luma_navigation_sidebar_get_list (LUMA_NAVIGATION_SIDEBAR (sidebar));
+  {
+    /* The fixture's person is v70's; live, it is the person signed in. */
+    JsonNode *name = model ? cc_luma_fixture_get (model, "myName") : NULL;
+    const char *real = name && json_node_get_value_type (name) == G_TYPE_STRING ? json_node_get_string (name) :
+                       cc_luma_fixture_is_live (model) ? g_get_real_name () : "Nick";
+    if (!real || !*real || g_str_equal (real, "Unknown")) real = g_get_user_name ();
+    f->account = luma_account_card_new (real, "Luma account");
+    luma_account_card_set_compact (LUMA_ACCOUNT_CARD (f->account), TRUE);
+    /* v71 phone (Settings audit, 1 Oct): the card is a plain inset card, the kit's recessed well
+     * (#w-settings.phone .cfme { background: var(--well); padding: 10px 12px; border-radius: 16px }). */
+    if (phone_form_factor ()) luma_account_card_set_recessed (LUMA_ACCOUNT_CARD (f->account), TRUE);
+  }
+  gtk_widget_set_name (f->account, "cf-account");
+  g_signal_connect (f->account, "clicked", G_CALLBACK (account_clicked), f);
+  luma_navigation_sidebar_append_header (LUMA_NAVIGATION_SIDEBAR (sidebar), f->account);
+
+  for (guint g = 0; groups && g < json_array_get_length (groups); g++)
+    {
+      JsonArray *group = json_array_get_array_element (groups, g);
+      const char *heading = json_array_get_string_element (group, 0);
+      JsonArray *ids = json_array_get_array_element (group, 1);
+      if (heading && *heading)
+        luma_navigation_sidebar_append_section (LUMA_NAVIGATION_SIDEBAR (sidebar), heading);
+      for (guint i = 0; i < json_array_get_length (ids); i++)
+        {
+          const Destination *d = destination (json_array_get_string_element (ids, i));
+          GtkWidget *row;
+          if (!d) continue;
+          row = luma_navigation_row_new (d->title, NULL);
+          luma_navigation_row_set_lead (LUMA_NAVIGATION_ROW (row), luma_ui_icon_new (d->icon));
+          g_object_set_data (G_OBJECT (row), "cf-page", (gpointer) d->id);
+          luma_navigation_sidebar_append_row (LUMA_NAVIGATION_SIDEBAR (sidebar), GTK_LIST_BOX_ROW (row));
+          g_hash_table_insert (f->rows, (gpointer) d->id, row);
+        }
+    }
+  g_signal_connect (f->list, "row-activated", G_CALLBACK (row_activated), f);
+  g_signal_connect (f->list, "row-selected", G_CALLBACK (row_selected), f);
+
+  f->foot = foot;
+  g_signal_connect (foot, "search-changed", G_CALLBACK (search_changed), f);
+  gtk_widget_set_name (foot, "cf-foot");
+  gtk_widget_set_name (luma_sidebar_foot_get_entry (LUMA_SIDEBAR_FOOT (foot)), "cf-search");
+  luma_navigation_sidebar_append_footer (LUMA_NAVIGATION_SIDEBAR (sidebar), foot);
+
+  gtk_widget_set_name (island, "cf-main");
+  gtk_box_append (GTK_BOX (island), f->shell);
+  gtk_widget_set_vexpand (f->shell, TRUE);
+  if (phone_form_factor ())
+    {
+      /* v71 phone ("list-first apps", LumaUI #14): Settings opens on its list, full screen, under a large
+       * title; picking a page pushes it, and the page's title island ‹ brings the list back. Navigation is
+       * the list, so there is no sidebar toggle. */
+      f->stack = luma_list_first_new (sidebar, island, "Settings");
+      gtk_widget_set_name (f->stack, "cf-list-first");
+      luma_application_window_set_body (LUMA_APPLICATION_WINDOW (window), f->stack);
+      cc_luma_shell_set_list_handler (CC_LUMA_SHELL (f->shell), page_island, f);
+      if (g_getenv ("LUMA_SETTINGS_PAGE") && *g_getenv ("LUMA_SETTINGS_PAGE"))
+        luma_list_first_show_detail (LUMA_LIST_FIRST (f->stack)); /* asked for a page: open on it */
+    }
+  else
+    /* Nick, 30 Sep: no hide/show sidebar button on a computer. */
+    luma_application_window_set_frame (LUMA_APPLICATION_WINDOW (window), sidebar, island);
+
+  g_object_set_data_full (G_OBJECT (window), "cf-frame", f, (GDestroyNotify) frame_free);
+  /* Opening on a page with a text field put a blinking caret in it (About, Sharing): the window starts
+   * with its focus on the page's destination in the sidebar instead. */
+  g_signal_connect (window, "map", G_CALLBACK (focus_destination), f);
+  g_object_set_data (G_OBJECT (window), "cf-shell", f->shell);
+  if (model)
+    g_signal_connect_object (model, "changed", G_CALLBACK (refresh_meta), f->shell, G_CONNECT_SWAPPED);
+  cc_luma_shell_set_page_handler (CC_LUMA_SHELL (f->shell), follow_page, f);
+  if (cc_luma_shell_get_page (CC_LUMA_SHELL (f->shell)))
+    {
+      /* The page it opens on is the one behind the list; it is shown, not pushed. */
+      f->shown = g_strdup (cc_luma_shell_get_page (CC_LUMA_SHELL (f->shell)));
+      follow_page (CC_LUMA_SHELL (f->shell), cc_luma_shell_get_page (CC_LUMA_SHELL (f->shell)), f);
+    }
+  return window;
+}
+
+void
+cc_luma_window_search (GtkWindow *window, const char *text)
+{
+  Frame *f = g_object_get_data (G_OBJECT (window), "cf-frame");
+  GtkWidget *entry = f ? luma_sidebar_foot_get_entry (LUMA_SIDEBAR_FOOT (f->foot)) : NULL;
+  if (!entry) return;
+  g_signal_handlers_block_by_func (f->foot, search_changed, f);
+  gtk_editable_set_text (GTK_EDITABLE (entry), text);
+  g_signal_handlers_unblock_by_func (f->foot, search_changed, f);
+  search_changed (f->foot, text, f);
+}
