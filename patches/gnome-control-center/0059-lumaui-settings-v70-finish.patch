+GtkWidget *cf_row (GtkBox *card, GtkWidget *lead, const char *title, const char *subtitle,
+                   GtkWidget *control, gboolean activatable)
+{
+  GtkWidget *line = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+  GtkWidget *text = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  GtkWidget *row;
+  gtk_widget_add_css_class (text, "cf-t");
+  gtk_widget_set_hexpand (text, TRUE);
+  gtk_widget_set_valign (text, GTK_ALIGN_CENTER);
+  if (lead) gtk_box_append (GTK_BOX (line), lead);
+  if (title)
+    {
+      GtkWidget *t = wrapping (title, "cf-title");
+      luma_ui_apply_type (t, "row-title");
+      gtk_box_append (GTK_BOX (text), t);
+    }
+  if (subtitle && *subtitle)
+    {
+      GtkWidget *sub = wrapping (subtitle, "cf-sub");
+      luma_ui_apply_type_full (sub, "row-subtitle", TRUE);
+      gtk_box_append (GTK_BOX (text), sub);
+    }
+  gtk_box_append (GTK_BOX (line), text);
+  if (control)
+    {
+      GtkWidget *c = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+      gtk_widget_add_css_class (c, "cf-c");
+      gtk_widget_set_valign (c, GTK_ALIGN_CENTER);
+      gtk_box_append (GTK_BOX (c), control);
+      gtk_box_append (GTK_BOX (line), c);
+    }
+  if (activatable)
+    {
+      row = gtk_button_new ();
+      gtk_button_set_child (GTK_BUTTON (row), line);
+    }
+  else
+    {
+      row = line;
+    }
+  gtk_widget_add_css_class (row, "cf-row");
+  if (title && activatable)
+    gtk_accessible_update_property (GTK_ACCESSIBLE (row), GTK_ACCESSIBLE_PROPERTY_LABEL, title, -1);
+  if (card) gtk_box_append (card, row);
+  return row;
+}
+
+/* v70 #w-settings.phone .cfrow { flex-wrap: wrap } .cfc { margin-left: auto }: on a phone a row whose
+ * control doesn't fit beside its lead (or wants the whole row) puts it on a line of its own, at the right, 12 below.
+ * A layout of the row's line box, so it decides with the width the row really gets. */
+#define CF_GAP 12
+typedef struct { GtkWidget *lead, *text, *control; } Parts;
+static void line_parts (GtkWidget *line, Parts *p)
+{
+  p->lead = p->text = p->control = NULL;
+  for (GtkWidget *c = gtk_widget_get_first_child (line); c; c = gtk_widget_get_next_sibling (c))
+    {
+      if (!gtk_widget_should_layout (c)) continue;
+      if (gtk_widget_has_css_class (c, "cf-t")) p->text = c;
+      else if (p->text) p->control = c;
+      else p->lead = c;
+    }
+}
+static int nat_w (GtkWidget *w) { int n = 0; if (w) gtk_widget_measure (w, GTK_ORIENTATION_HORIZONTAL, -1, NULL, &n, NULL, NULL); return n; }
+static int min_w (GtkWidget *w) { int m = 0; if (w) gtk_widget_measure (w, GTK_ORIENTATION_HORIZONTAL, -1, &m, NULL, NULL, NULL); return m; }
+static int nat_h (GtkWidget *w, int for_w) { int n = 0; if (w) gtk_widget_measure (w, GTK_ORIENTATION_VERTICAL, for_w, NULL, &n, NULL, NULL); return n; }
+/* v71 phone (Settings audit, 1 Oct): a segmented choice (.cfrow.sg) drops under its label at the
+ * row's full width (row-gap 10) instead of squeezing the label into three lines. */
+#define CF_SG_GAP 10
+static gboolean is_seg (GtkWidget *control)
+{
+  GtkWidget *first = control ? gtk_widget_get_first_child (control) : NULL;
+  return first && LUMA_IS_MODE_SWITCH (first) && cc_luma_view_phone_device ();
+}
+static gboolean line_wraps (Parts *p, int width)
+{
+  if (!p->text || !p->control) return FALSE;
+  if (is_seg (p->control)) return TRUE;
+  /* .cft is flex: 1 (basis 0), so only a control that wants the whole row (.cftx { width: 100% }),
+   * or one that leaves the words less room than their longest word (Nick, 30 Sep: nothing spills),
+   * puts the control on its own line. */
+  if (gtk_widget_compute_expand (p->control, GTK_ORIENTATION_HORIZONTAL)) return TRUE;
+  int used = CF_GAP + nat_w (p->control) + min_w (p->text);
+  if (p->lead) used += nat_w (p->lead) + CF_GAP;
+  return used > width;
+}
+static void line_measure (GtkWidget *line, GtkOrientation o, int for_size, int *min, int *nat, int *minb, int *natb)
+{
+  Parts p; line_parts (line, &p);
+  int lead = p.lead ? nat_w (p.lead) + CF_GAP : 0;
+  *minb = *natb = -1;
+  if (o == GTK_ORIENTATION_HORIZONTAL)
+    {
+      int ctl = p.control ? nat_w (p.control) : 0;
+      *min = MAX (lead + min_w (p.text), ctl);
+      *nat = lead + nat_w (p.text) + (p.control ? CF_GAP + ctl : 0);
+      return;
+    }
+  int width = for_size < 0 ? lead + nat_w (p.text) + (p.control ? CF_GAP + nat_w (p.control) : 0) : for_size;
+  gboolean wrap = line_wraps (&p, width);
+  int ctl = p.control ? nat_w (p.control) : 0;
+  int text_w = MAX (0, width - lead - (wrap || !p.control ? 0 : CF_GAP + ctl));
+  int first = MAX (p.lead ? nat_h (p.lead, -1) : 0, p.text ? nat_h (p.text, MAX (text_w, min_w (p.text))) : 0);
+  int h = wrap && is_seg (p.control) ? first + CF_SG_GAP + nat_h (p.control, width) :
+          wrap ? first + CF_GAP + nat_h (p.control, ctl) : MAX (first, p.control ? nat_h (p.control, ctl) : 0);
+  *min = *nat = h;
+}
+static void place (GtkWidget *w, int x, int y, int width, int height)
+{
+  GtkAllocation a = { x, y, width, height };
+  gtk_widget_size_allocate (w, &a, -1);
+}
+static void line_allocate (GtkWidget *line, int width, int height, int baseline)
+{
+  Parts p; line_parts (line, &p);
+  gboolean wrap = line_wraps (&p, width);
+  int lead_w = p.lead ? nat_w (p.lead) : 0, ctl_w = p.control ? nat_w (p.control) : 0;
+  int x = 0, text_w;
+  text_w = MAX (0, width - (p.lead ? lead_w + CF_GAP : 0) - (wrap || !p.control ? 0 : CF_GAP + ctl_w));
+  if (p.text) text_w = MAX (text_w, min_w (p.text));
+  int text_h = p.text ? nat_h (p.text, text_w) : 0, lead_h = p.lead ? nat_h (p.lead, lead_w) : 0;
+  int ctl_h = p.control ? nat_h (p.control, ctl_w) : 0;
+  int first = wrap ? MAX (lead_h, text_h) : height;
+  if (p.lead) { place (p.lead, 0, (first - lead_h) / 2, lead_w, lead_h); x = lead_w + CF_GAP; }
+  if (p.text) place (p.text, x, (first - text_h) / 2, text_w, text_h);
+  if (p.control)
+    {
+      if (wrap && is_seg (p.control))
+        place (p.control, 0, first + CF_SG_GAP, width, nat_h (p.control, width));
+      else if (wrap && gtk_widget_compute_expand (p.control, GTK_ORIENTATION_HORIZONTAL))
+        place (p.control, 0, first + CF_GAP, width, nat_h (p.control, width)); /* .cftx { width: 100% } */
+      else if (wrap) place (p.control, width - ctl_w, first + CF_GAP, ctl_w, ctl_h);
+      else place (p.control, width - ctl_w, (height - ctl_h) / 2, ctl_w, ctl_h);
+    }
+}
+static void wrap_walk (GtkWidget *w)
+{
+  if (gtk_widget_has_css_class (w, "cf-row"))
+    {
+      GtkWidget *line = GTK_IS_BUTTON (w) ? gtk_button_get_child (GTK_BUTTON (w)) : w;
+      Parts p;
+      if (!GTK_IS_BOX (line)) return;
+      int n = 0;
+      for (GtkWidget *c = gtk_widget_get_first_child (line); c; c = gtk_widget_get_next_sibling (c)) n++;
+      line_parts (line, &p);
+      if (is_seg (p.control))
+        {
+          /* v71 .cfrow.sg > .cfc .seg { width: 100% } .seg button { flex: 1 }: equal segments over the row. */
+          GtkWidget *seg = gtk_widget_get_first_child (p.control);
+          gtk_widget_set_halign (seg, GTK_ALIGN_FILL);
+          gtk_widget_set_hexpand (seg, TRUE);
+          luma_mode_switch_set_fill (LUMA_MODE_SWITCH (seg), TRUE);
+        }
+      if (p.text && p.control && n <= 3)
+        gtk_widget_set_layout_manager (line, gtk_custom_layout_new (NULL, line_measure, line_allocate));
+      return;
+    }
+  for (GtkWidget *c = gtk_widget_get_first_child (w); c; c = gtk_widget_get_next_sibling (c))
+    wrap_walk (c);
+}
+void cf_rows_wrap (View *v)
+{
+  if (v->phone) wrap_walk (GTK_WIDGET (v->body));
+}
+
+GtkWidget *cf_sw (View *v, GtkBox *card, const char *key, const char *title, const char *subtitle, GtkWidget *lead)
+{
+  GtkWidget *button = switch_button (v, key, title, "cf-row");
+  GtkWidget *visual = g_object_get_data (G_OBJECT (button), "cf-switch");
+  GtkWidget *inner = cf_row (NULL, lead, title, subtitle, visual, FALSE);
+  gtk_widget_remove_css_class (inner, "cf-row");
+  gtk_button_set_child (GTK_BUTTON (button), inner);
+  if (card) gtk_box_append (card, button);
+  return button;
+}
+
+typedef struct { char *key; char *value; } Choice;
+static void choice_free (Choice *c) { g_free (c->key); g_free (c->value); g_free (c); }
+static void choice_clicked (GtkButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  Choice *c = g_object_get_data (G_OBJECT (button), "cf-choice");
+  if (v && c) cc_luma_view_choose (v, c->key, c->value);
+}
+
+/* A key's value as the string choices name it. */
+static char *choice_value (View *v, const char *key)
+{
+  JsonNode *n = v->model ? cc_luma_fixture_get (v->model, key) : NULL;
+  if (!n || !JSON_NODE_HOLDS_VALUE (n)) return g_strdup (cc_luma_view_text (v, key));
+  switch (json_node_get_value_type (n))
+    {
+    case G_TYPE_BOOLEAN: return g_strdup (json_node_get_boolean (n) ? "true" : "false");
+    case G_TYPE_INT64: return g_strdup_printf ("%" G_GINT64_FORMAT, json_node_get_int (n));
+    case G_TYPE_DOUBLE: { char buf[G_ASCII_DTOSTR_BUF_SIZE]; return g_strdup (g_ascii_dtostr (buf, sizeof buf, json_node_get_double (n))); }
+    default: return g_strdup (cc_luma_view_text (v, key));
+    }
+}
+
+GtkWidget *cf_rd (View *v, GtkBox *card, const char *key, const char *value, const char *title, const char *subtitle)
+{
+  g_autofree char *current = choice_value (v, key);
+  gboolean on = g_strcmp0 (current, value) == 0;
+  GtkWidget *dot = gtk_check_button_new ();
+  GtkWidget *row;
+  Choice *c = g_new0 (Choice, 1);
+  g_object_set (dot, "accessible-role", GTK_ACCESSIBLE_ROLE_PRESENTATION, NULL);
+  gtk_widget_add_css_class (dot, "cf-rd");
+  gtk_widget_set_can_target (dot, FALSE);
+  gtk_widget_set_can_focus (dot, FALSE);
+  gtk_check_button_set_active (GTK_CHECK_BUTTON (dot), on);
+  row = cf_row (NULL, NULL, title, subtitle, dot, TRUE);
+  {
+    /* v70's radio row is the radio: role and state on the row itself. */
+    GtkWidget *radio = g_object_new (GTK_TYPE_BUTTON, "accessible-role", GTK_ACCESSIBLE_ROLE_RADIO, NULL);
+    GtkWidget *line = g_object_ref (gtk_button_get_child (GTK_BUTTON (row)));
+    gtk_button_set_child (GTK_BUTTON (row), NULL);
+    gtk_button_set_child (GTK_BUTTON (radio), line);
+    g_object_unref (line);
+    g_object_ref_sink (row); g_object_unref (row);
+    row = radio;
+    gtk_widget_add_css_class (row, "cf-row");
+    gtk_accessible_update_state (GTK_ACCESSIBLE (row), GTK_ACCESSIBLE_STATE_CHECKED,
+                                 on ? GTK_ACCESSIBLE_TRISTATE_TRUE : GTK_ACCESSIBLE_TRISTATE_FALSE, -1);
+    if (card) gtk_box_append (card, row);
+  }
+  c->key = g_strdup (key); c->value = g_strdup (value);
+  g_object_set_data_full (G_OBJECT (row), "cf-choice", c, (GDestroyNotify) choice_free);
+  g_signal_connect_object (row, "clicked", G_CALLBACK (choice_clicked), v->root, 0);
+  return row;
+}
+
+GtkWidget *cf_pk (View *v, GtkBox *card, const char *key, const char *title, const char *subtitle, const char * const *choices)
+{
+  GtkWidget *picker = cc_luma_view_picker (v, key, choices);
+  gtk_widget_add_css_class (picker, "cf-pk");
+  for (GtkWidget *l = gtk_widget_get_first_child (gtk_button_get_child (GTK_BUTTON (picker))); l; l = gtk_widget_get_next_sibling (l))
+    if (GTK_IS_LABEL (l)) { gtk_label_set_wrap (GTK_LABEL (l), FALSE); gtk_label_set_ellipsize (GTK_LABEL (l), PANGO_ELLIPSIZE_NONE); }
+  return cf_row (card, NULL, title, subtitle, picker, FALSE);
+}
+
+static void segment_changed (LumaModeSwitch *seg, const char *id, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  const char *key = g_object_get_data (G_OBJECT (seg), "cf-key");
+  if (v && key && id) cc_luma_view_choose (v, key, id);
+}
+
+/* v70 .cfrow .seg: the kit's compact mode switch, words only, natural widths. */
+GtkWidget *cf_seg_new (void)
+{
+  GtkWidget *seg = luma_mode_switch_new (NULL);
+  luma_mode_switch_set_compact (LUMA_MODE_SWITCH (seg), TRUE);
+  gtk_widget_set_halign (seg, GTK_ALIGN_END);
+  gtk_widget_set_valign (seg, GTK_ALIGN_CENTER);
+  return seg;
+}
+void cf_seg_add (GtkWidget *seg, const char *key, const char *label)
+{
+  luma_mode_switch_add (LUMA_MODE_SWITCH (seg), key, label, NULL);
+}
+
+GtkWidget *cf_sg (View *v, GtkBox *card, const char *key, const char *title, const char *subtitle, const char * const *choices)
+{
+  GtkWidget *seg = cf_seg_new ();
+  for (guint i = 0; choices[i]; i += 2)
+    cf_seg_add (seg, choices[i], choices[i + 1]);
+  g_autofree char *current = choice_value (v, key);
+  luma_mode_switch_set_current (LUMA_MODE_SWITCH (seg), current);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (seg), GTK_ACCESSIBLE_PROPERTY_LABEL, title, -1);
+  g_object_set_data_full (G_OBJECT (seg), "cf-key", g_strdup (key), g_free);
+  g_signal_connect_object (seg, "changed", G_CALLBACK (segment_changed), v->root, 0);
+  g_autofree char *name = g_strconcat ("cf-", key, NULL);
+  gtk_widget_set_name (seg, name);
+  return cf_row (card, NULL, title, subtitle, seg, FALSE);
+}
+
+typedef struct { char *key; CfFormat format; GtkLabel *readout; } Range;
+static void range_free (Range *r) { g_free (r->key); g_free (r); }
+static void range_moved (GtkRange *range, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  Range *r = g_object_get_data (G_OBJECT (range), "cf-range");
+  g_autoptr (GError) error = NULL;
+  if (!v || !r || !v->model || !gtk_widget_is_ancestor (GTK_WIDGET (range), root)) return;
+  if (!cc_luma_fixture_set_number (v->model, r->key, gtk_range_get_value (range), &error))
+    { cc_luma_view_report_error (v, error); return; }
+  if (r->readout && r->format)
+    {
+      g_autofree char *text = r->format (gtk_range_get_value (range));
+      gtk_label_set_text (r->readout, text);
+    }
+}
+
+GtkWidget *cf_rg (View *v, GtkBox *card, const char *key, const char *title, const char *subtitle,
+                  double min, double max, double step, const char *lo, const char *hi, CfFormat format)
+{
+  GtkWidget *box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 10);
+  GtkWidget *scale = gtk_scale_new_with_range (GTK_ORIENTATION_HORIZONTAL, min, max, step);
+  JsonNode *n = v->model ? cc_luma_fixture_get (v->model, key) : NULL;
+  double value = n ? json_node_get_double (n) : min;
+  Range *r = g_new0 (Range, 1);
+  gtk_widget_add_css_class (box, "cf-rg");
+  if (v->phone) gtk_widget_add_css_class (box, "phone"); /* v70 #w-settings.phone .cfrg input: 140 */
+  gtk_scale_set_draw_value (GTK_SCALE (scale), FALSE);
+  gtk_range_set_value (GTK_RANGE (scale), value);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (scale), GTK_ACCESSIBLE_PROPERTY_LABEL, title, -1);
+  g_autofree char *name = g_strconcat ("cf-", key, NULL);
+  gtk_widget_set_name (scale, name);
+  if (lo) gtk_box_append (GTK_BOX (box), cf_text (lo, "cf-small"));
+  gtk_box_append (GTK_BOX (box), scale);
+  if (hi) gtk_box_append (GTK_BOX (box), cf_text (hi, "cf-small"));
+  r->key = g_strdup (key); r->format = format;
+  if (format)
+    {
+      g_autofree char *text = format (value);
+      GtkWidget *out = cf_text (text, "cf-out");
+      gtk_label_set_xalign (GTK_LABEL (out), 1);
+      r->readout = GTK_LABEL (out);
+      gtk_box_append (GTK_BOX (box), out);
+    }
+  g_object_set_data_full (G_OBJECT (scale), "cf-range", r, (GDestroyNotify) range_free);
+  g_signal_connect_object (scale, "value-changed", G_CALLBACK (range_moved), v->root, 0);
+  return cf_row (card, NULL, title, subtitle, box, FALSE);
+}
+
+static gboolean all_digits (const char *s)
+{
+  if (!s || !*s) return FALSE;
+  for (; *s; s++) if (!g_ascii_isdigit (*s)) return FALSE;
+  return TRUE;
+}
+
+GtkWidget *cf_nv (View *v, GtkBox *card, const char *to, const char *title, const char *subtitle,
+                  const char *value, GtkWidget *lead)
+{
+  GtkWidget *trail = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+  GtkWidget *row;
+  if (all_digits (value))
+    gtk_box_append (GTK_BOX (trail), luma_count_badge_new (atoi (value), FALSE));
+  else if (value)
+    gtk_box_append (GTK_BOX (trail), cf_value (value, FALSE));
+  gtk_box_append (GTK_BOX (trail), cf_chevron ());
+  if (!value) gtk_widget_add_css_class (trail, "only");
+  row = cf_row (card, lead, title, subtitle, trail, TRUE);
+  g_autofree char *name = g_strconcat ("cf-go-", to, NULL);
+  gtk_widget_set_name (row, name);
+  cc_luma_view_bind_navigation (v, row, to);
+  return row;
+}
+
+static void copy_clicked (GtkButton *button, GtkWidget *root)
+{
+  const char *value = g_object_get_data (G_OBJECT (button), "cf-copy");
+  gdk_clipboard_set_text (gtk_widget_get_clipboard (root), value);
+  luma_toast_show (root, "Copied", "copied");
+}
+
+GtkWidget *cf_vl (View *v, GtkBox *card, const char *title, const char *value, const char *subtitle,
+                  gboolean mono, const char *copy, GtkWidget *lead)
+{
+  GtkWidget *trail = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+  gtk_box_append (GTK_BOX (trail), cf_value (value, mono));
+  if (copy)
+    {
+      GtkWidget *button = luma_icon_button_new ("copy", "Copy");
+      luma_icon_button_set_size (GTK_BUTTON (button), "row");
+      gtk_widget_add_css_class (button, "cf-copy");
+      g_object_set_data_full (G_OBJECT (button), "cf-copy", g_strdup (copy), g_free);
+      g_signal_connect_object (button, "clicked", G_CALLBACK (copy_clicked), v->root, 0);
+      gtk_box_append (GTK_BOX (trail), button);
+    }
+  return cf_row (card, lead, title, subtitle, trail, FALSE);
+}
+
+GtkWidget *cf_bt (View *v, GtkBox *card, const char *title, const char *subtitle, const char *label,
+                  gboolean danger, GCallback callback)
+{
+  GtkWidget *button = cf_button (label, "fill", TRUE);
+  if (callback) cc_luma_view_bind_command (v, button, callback);
+  /* v70 draws rBt's danger buttons in plain ink (the confirmation says what is lost). */
+  (void) danger;
+  GtkWidget *row = cf_row (card, NULL, title, subtitle, button, FALSE);
+  gtk_widget_add_css_class (row, "bt");
+  /* v70's .bt keeps these words on one line, on a phone too. */
+  for (GtkWidget *l = gtk_widget_get_first_child (gtk_widget_get_first_child (row)); l; l = gtk_widget_get_next_sibling (l))
+    if (GTK_IS_LABEL (l)) { gtk_label_set_wrap (GTK_LABEL (l), FALSE); gtk_label_set_ellipsize (GTK_LABEL (l), PANGO_ELLIPSIZE_END); }
+  return row;
+}
+
+GtkWidget *cf_tx (View *v, GtkBox *card, const char *key, const char *title, const char *subtitle, gboolean mono)
+{
+  GtkWidget *field = cc_luma_view_entry (v, key, title);
+  gtk_widget_set_tooltip_text (field, title);
+  /* v70 #w-settings.phone .cftx { width: 100% } resolves inside its flex: none control box: 170 wide. */
+  if (v->phone) gtk_widget_add_css_class (field, "phone");
+  gtk_widget_add_css_class (field, "cf-tx");
+  if (mono) gtk_widget_add_css_class (field, "mono");
+  return cf_row (card, NULL, title, subtitle, field, FALSE);
+}
+
+/* A picture-like part (a desk preview, the style choices) that keeps its proportions: drawn at its
+ * natural size where that fits, scaled down to the width it gets where it doesn't, so nothing hangs
+ * past an edge on a phone. */
+static void fit_measure (GtkWidget *w, GtkOrientation o, int for_size, int *min, int *nat, int *minb, int *natb)
+{
+  GtkWidget *child = gtk_widget_get_first_child (w);
+  int cw = 0, ch = 0;
+  *minb = *natb = -1;
+  gtk_widget_measure (child, GTK_ORIENTATION_HORIZONTAL, -1, NULL, &cw, NULL, NULL);
+  gtk_widget_measure (child, GTK_ORIENTATION_VERTICAL, cw, NULL, &ch, NULL, NULL);
+  if (o == GTK_ORIENTATION_HORIZONTAL) { *min = 0; *nat = cw; return; }
+  double scale = for_size > 0 && for_size < cw ? (double) for_size / cw : 1;
+  *min = *nat = (int) ceil (ch * scale);
+}
+static void fit_allocate (GtkWidget *w, int width, int height, int baseline)
+{
+  GtkWidget *child = gtk_widget_get_first_child (w);
+  int cw = 0, ch = 0;
+  gtk_widget_measure (child, GTK_ORIENTATION_HORIZONTAL, -1, NULL, &cw, NULL, NULL);
+  gtk_widget_measure (child, GTK_ORIENTATION_VERTICAL, cw, NULL, &ch, NULL, NULL);
+  double scale = cw > width && cw > 0 ? (double) width / cw : 1;
+  float x = scale < 1 ? 0 : (width - cw) / 2.f;
+  GskTransform *t = gsk_transform_translate (NULL, &GRAPHENE_POINT_INIT (x, 0));
+  if (scale < 1) t = gsk_transform_scale (t, (float) scale, (float) scale);
+  gtk_widget_allocate (child, cw, ch, -1, t);
+}
+GtkWidget *cf_fit_new (GtkWidget *child)
+{
+  GtkWidget *box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_set_layout_manager (box, gtk_custom_layout_new (NULL, fit_measure, fit_allocate));
+  gtk_widget_add_css_class (box, "cf-fit");
+  gtk_widget_set_hexpand (box, TRUE);
+  gtk_box_append (GTK_BOX (box), child);
+  return box;
+}
diff --git a/shell/cc-luma-rows.h b/shell/cc-luma-rows.h
new file mode 100644
index 0000000..b62e09c
--- /dev/null
+++ b/shell/cc-luma-rows.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Settings' page anatomy (v70 cfRow/cfGroups/cfTop): the page header, the
+ * hero well, row groups and one builder per row kind. These are Settings'
+ * own surfaces; every shared control inside them is a LumaUI part. */
+#pragma once
+#include "cc-luma-view-private.h"
+
+G_BEGIN_DECLS
+/* Header: optional back button to the parent page, title, meta, trailing
+ * widget (the page's on/off switch or its action). Returns the meta label. */
+GtkLabel *cf_header (View *v, const char *title, const char *meta, GtkWidget *top);
+/* The big on/off switch in the header, bound to a boolean key. */
+GtkWidget *cf_top_switch (View *v, const char *key);
+/* The recessed hero well under the header. */
+GtkWidget *cf_hero (View *v, GtkWidget *child, const char *name);
+/* A row group: heading (NULL for none), its card, an optional note. */
+GtkBox *cf_group (View *v, const char *heading, const char *note);
+GtkBox *cf_group_with (View *v, const char *heading, GtkWidget *heading_action, const char *note);
+
+/* Row leads. */
+GtkWidget *cf_lead_icon (const char *icon);
+GtkWidget *cf_lead_image (View *v, const char *asset);
+
+/* A row of any kind; @activatable rows are buttons. The row is appended. */
+GtkWidget *cf_row (GtkBox *card, GtkWidget *lead, const char *title, const char *subtitle,
+                   GtkWidget *control, gboolean activatable);
+/* rSw: the whole row is the switch. */
+GtkWidget *cf_sw (View *v, GtkBox *card, const char *key, const char *title, const char *subtitle, GtkWidget *lead);
+/* rRd: a radio row setting key to value. */
+GtkWidget *cf_rd (View *v, GtkBox *card, const char *key, const char *value, const char *title, const char *subtitle);
+/* rPk: a picker; choices are value/label pairs, NULL-terminated. */
+GtkWidget *cf_pk (View *v, GtkBox *card, const char *key, const char *title, const char *subtitle, const char * const *choices);
+/* rSg: a segmented choice. */
+GtkWidget *cf_sg (View *v, GtkBox *card, const char *key, const char *title, const char *subtitle, const char * const *choices);
+/* rRg: a slider with optional end labels and a formatted readout. */
+typedef char *(*CfFormat) (double value);
+GtkWidget *cf_rg (View *v, GtkBox *card, const char *key, const char *title, const char *subtitle,
+                  double min, double max, double step, const char *lo, const char *hi, CfFormat format);
+/* rNv: goes to another page; value is text, or digits drawn as a count badge. */
+GtkWidget *cf_nv (View *v, GtkBox *card, const char *to, const char *title, const char *subtitle,
+                  const char *value, GtkWidget *lead);
+/* rVl: a fixed value, optionally monospaced and copyable. */
+GtkWidget *cf_vl (View *v, GtkBox *card, const char *title, const char *value, const char *subtitle,
+                  gboolean mono, const char *copy, GtkWidget *lead);
+/* rBt: a small button; callback(GtkButton *, View *). */
+GtkWidget *cf_bt (View *v, GtkBox *card, const char *title, const char *subtitle, const char *label,
+                  gboolean danger, GCallback callback);
+/* rTx: a text field bound to key. */
+GtkWidget *cf_tx (View *v, GtkBox *card, const char *key, const char *title, const char *subtitle, gboolean mono);
+
+/* Controls, for heroes and custom rows. */
+GtkWidget *cf_button (const char *label, const char *variant, gboolean small);
+GtkWidget *cf_value (const char *text, gboolean mono);
+GtkWidget *cf_chevron (void);
+GtkWidget *cf_text (const char *text, const char *cls);
+GtkWidget *cf_signal_bars (int strength, gboolean big);
+GtkWidget *cf_seg_new (void);
+void cf_seg_add (GtkWidget *seg, const char *key, const char *label);
+/* v70 .cfoff: a centred icon, title, line and a Turn on button. */
+GtkWidget *cf_off_hero (View *v, const char *icon, const char *title, const char *subtitle, const char *key, GCallback turn_on);
+/* On a phone, rows whose control doesn't fit beside their words put it on its own line. */
+void cf_rows_wrap (View *v);
+/* A part that keeps its proportions: natural size where it fits, scaled down where it does not. */
+GtkWidget *cf_fit_new (GtkWidget *child);
+G_END_DECLS
diff --git a/shell/cc-luma-shell.c b/shell/cc-luma-shell.c
new file mode 100644
index 0000000..d67d630
--- /dev/null
+++ b/shell/cc-luma-shell.c
@@ -0,0 +1,387 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-shell.h"
+#include "cc-luma-live.h"
+#include "cc-luma-view.h"
+#include "cc-panel-loader.h"
+#include "cc-shell.h"
+
+struct _CcLumaShell
+{
+  AdwBin parent_instance;
+  CcLumaFixture *model;
+  GtkWidget *stack;
+  GtkWidget *view;       /* the LumaUI pages, made on first use */
+  GtkWidget *panels;     /* AdwNavigationView holding a GNOME panel */
+  CcPanel *active_panel;
+  char *page;
+  char *panel_id;
+  gboolean pinned; /* a delegated action keeps the GNOME panel up */
+  CcLumaShellPageFunc handler;
+  gpointer handler_data;
+  CcLumaViewListFunc list_handler;
+  gpointer list_data;
+};
+
+static void shell_iface_init (CcShellInterface *iface);
+G_DEFINE_TYPE_WITH_CODE (CcLumaShell, cc_luma_shell, ADW_TYPE_BIN,
+                         G_IMPLEMENT_INTERFACE (CC_TYPE_SHELL, shell_iface_init))
+enum { PROP_0, PROP_ACTIVE_PANEL };
+
+/* v70 page ↔ the GNOME panel that owns the same settings. */
+static const struct { const char *page; const char *panel; } routes[] = {
+  { "wifi", "wifi" }, { "wifi-net", "wifi" }, { "wifi-known", "wifi" }, { "hotspot", "wifi" },
+  { "network", "network" }, { "bluetooth", "bluetooth" },
+  { "appearance", "background" }, { "shelf", "dash" }, { "windows", "multitasking" },
+  { "notifications", "notifications" }, { "search", "search" }, { "search-places", "search" },
+  { "displays", "display" }, { "nightlight", "display" },
+  { "sound", "sound" }, { "sound-levels", "sound" }, { "sound-alert", "sound" },
+  { "power", "power" }, { "mouse", "mouse" }, { "keyboard", "keyboard" }, { "shortcuts", "keyboard" },
+  { "printers", "printers" }, { "apps", "applications" }, { "defaults", "applications" }, { "media", "applications" },
+  { "accounts", "online-accounts" }, { "acct-fm", "online-accounts" }, { "acct-nc", "online-accounts" },
+  { "privacy", "privacy" }, { "p-lock", "privacy" }, { "p-loc", "privacy" }, { "p-cam", "privacy" },
+  { "p-mic", "privacy" }, { "p-files", "privacy" }, { "p-diag", "privacy" }, { "p-dev", "privacy" },
+  { "wellbeing", "wellbeing" }, { "a11y", "universal-access" }, { "a-see", "universal-access" },
+  { "a-hear", "universal-access" }, { "a-type", "universal-access" }, { "a-point", "universal-access" },
+  { "a-zoom", "universal-access" }, { "sharing", "sharing" },
+  { "region", "system" }, { "datetime", "system" }, { "users", "system" }, { "user-priya", "system" },
+  { "remote", "system" }, { "ssh", "system" }, { "about", "system" }, { "about-sys", "system" }, { "me", "system" },
+};
+/* System's subpages are opened with a parameter naming them. */
+static const struct { const char *page; const char *sub; } system_pages[] = {
+  { "region", "region" }, { "datetime", "datetime" }, { "users", "users" }, { "user-priya", "users" },
+  { "remote", "remote-desktop" }, { "ssh", "remote-desktop" }, { "about", "about" }, { "about-sys", "about" }, { "me", "users" },
+};
+static const struct { const char *panel; const char *page; } panel_pages[] = {
+  { "background", "appearance" }, { "appearance", "appearance" }, { "dash", "shelf" }, { "multitasking", "windows" },
+  { "display", "displays" }, { "color", "displays" }, { "applications", "apps" }, { "default-apps", "defaults" },
+  { "online-accounts", "accounts" }, { "universal-access", "a11y" }, { "remote-desktop", "remote" },
+  { "system", "about" }, { "info-overview", "about" }, { "info", "about" }, { "user-accounts", "users" },
+};
+
+const char *
+cc_luma_shell_panel_for_page (const char *page)
+{
+  if (page && g_str_has_prefix (page, "app:")) return "applications";
+  for (guint i = 0; page && i < G_N_ELEMENTS (routes); i++)
+    if (g_str_equal (routes[i].page, page)) return routes[i].panel;
+  return NULL;
+}
+
+const char *
+cc_luma_shell_page_for_panel (const char *panel)
+{
+  for (guint i = 0; panel && i < G_N_ELEMENTS (panel_pages); i++)
+    if (g_str_equal (panel_pages[i].panel, panel)) return panel_pages[i].page;
+  for (guint i = 0; panel && i < G_N_ELEMENTS (routes); i++)
+    if (g_str_equal (routes[i].page, panel)) return routes[i].page;
+  for (guint i = 0; panel && i < G_N_ELEMENTS (routes); i++)
+    if (g_str_equal (routes[i].panel, panel)) return routes[i].page;
+  return NULL;
+}
+
+static void
+set_page (CcLumaShell *self, const char *page)
+{
+  if (g_strcmp0 (self->page, page) != 0)
+    {
+      g_free (self->page);
+      self->page = g_strdup (page);
+    }
+  if (self->handler) self->handler (self, self->page, self->handler_data);
+}
+
+static void
+view_page_changed (GtkWidget *view, const char *page, gpointer data)
+{
+  set_page (CC_LUMA_SHELL (data), page);
+}
+
+/* The view asks before it draws a page: pages the live model can't draw yet
+ * go to their GNOME panel instead. */
+static gboolean
+view_route (GtkWidget *view, const char *page, gpointer data)
+{
+  CcLumaShell *self = data;
+  if (cc_luma_live_page_ready (self->model, page)) return FALSE;
+  cc_luma_shell_go (self, page);
+  return TRUE;
+}
+
+static gboolean show_panel (CcLumaShell *self, const char *panel, const char *page, GVariant *parameters, GError **error);
+/* Live: an action Luma hasn't proven on a real system runs in the page's GNOME panel. */
+static gboolean
+view_delegate (GtkWidget *view, const char *page, gpointer data)
+{
+  CcLumaShell *self = data;
+  g_autoptr (GError) error = NULL;
+  self->pinned = TRUE;
+  if (!show_panel (self, cc_luma_shell_panel_for_page (page), page, NULL, &error))
+    g_warning ("%s", error->message);
+  return TRUE;
+}
+
+static gboolean
+show_view (CcLumaShell *self, const char *page)
+{
+  if (!self->view)
+    {
+      g_autoptr (GError) error = NULL;
+      self->view = cc_luma_view_new (self->model, page, &error);
+      if (!self->view)
+        {
+          g_warning ("Settings page %s: %s", page, error->message);
+          return FALSE;
+        }
+      cc_luma_view_set_page_handler (self->view, view_page_changed, self);
+      cc_luma_view_set_list_handler (self->view, self->list_handler, self->list_data);
+      cc_luma_view_set_router (self->view, view_route, self);
+      cc_luma_view_set_delegate (self->view, view_delegate, self);
+      gtk_widget_set_vexpand (self->view, TRUE);
+      gtk_stack_add_named (GTK_STACK (self->stack), self->view, "view");
+    }
+  else
+    cc_luma_view_go (self->view, page);
+  gtk_stack_set_visible_child_name (GTK_STACK (self->stack), "view");
+  set_page (self, page);
+  return TRUE;
+}
+
+static const char *
+page_title (CcLumaShell *self, const char *page, const char *fallback)
+{
+  JsonArray *pages = cc_luma_fixture_get_pages (self->model);
+  for (guint i = 0; page && pages && i < json_array_get_length (pages); i++)
+    {
+      JsonObject *p = json_array_get_object_element (pages, i);
+      if (g_strcmp0 (json_object_get_string_member_with_default (p, "id", ""), page) == 0)
+        return json_object_get_string_member_with_default (p, "title", fallback);
+    }
+  return fallback;
+}
+
+static void
+hide_title_buttons (GtkWidget *widget)
+{
+  if (ADW_IS_HEADER_BAR (widget))
+    {
+      adw_header_bar_set_show_start_title_buttons (ADW_HEADER_BAR (widget), FALSE);
+      adw_header_bar_set_show_end_title_buttons (ADW_HEADER_BAR (widget), FALSE);
+    }
+  for (GtkWidget *c = gtk_widget_get_first_child (widget); c; c = gtk_widget_get_next_sibling (c))
+    hide_title_buttons (c);
+}
+
+/* Panels build pages and header bars as they go (a Wi-Fi panel's "no adapter" page, a subpage):
+ * any header bar mapped inside a panel drops its title buttons, so only the title row has them. */
+static gboolean
+header_bar_mapped (GSignalInvocationHint *hint, guint n_values, const GValue *values, gpointer data)
+{
+  GtkWidget *widget = g_value_get_object (&values[0]);
+  if (ADW_IS_HEADER_BAR (widget) && gtk_widget_get_ancestor (widget, CC_TYPE_LUMA_SHELL))
+    {
+      adw_header_bar_set_show_start_title_buttons (ADW_HEADER_BAR (widget), FALSE);
+      adw_header_bar_set_show_end_title_buttons (ADW_HEADER_BAR (widget), FALSE);
+    }
+  return TRUE;
+}
+
+static gboolean
+show_panel (CcLumaShell *self, const char *panel, const char *page, GVariant *parameters, GError **error)
+{
+  g_autoptr (GVariant) owned = NULL;
+  CcPanel *loaded;
+  if (!panel)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "No Settings page or panel called %s", page);
+      return FALSE;
+    }
+  if (!parameters && g_str_equal (panel, "system"))
+    for (guint i = 0; page && i < G_N_ELEMENTS (system_pages); i++)
+      if (g_str_equal (system_pages[i].page, page))
+        {
+          GVariantBuilder b;
+          g_variant_builder_init (&b, G_VARIANT_TYPE ("av"));
+          g_variant_builder_add (&b, "v", g_variant_new_string (system_pages[i].sub));
+          parameters = owned = g_variant_ref_sink (g_variant_builder_end (&b));
+          break;
+        }
+  loaded = cc_panel_loader_load_by_name (CC_SHELL (self), panel, page_title (self, page, panel), parameters);
+  if (!loaded)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "No Settings panel called %s", panel);
+      return FALSE;
+    }
+  adw_navigation_view_replace (ADW_NAVIGATION_VIEW (self->panels), (AdwNavigationPage *[]) { ADW_NAVIGATION_PAGE (loaded) }, 1);
+  /* The LumaUI title row holds the window controls; panels' own bars don't repeat them. */
+  g_signal_connect (loaded, "map", G_CALLBACK (hide_title_buttons), NULL);
+  g_set_object (&self->active_panel, loaded);
+  g_object_notify (G_OBJECT (self), "active-panel");
+  g_free (self->panel_id);
+  self->panel_id = g_strdup (panel);
+  gtk_stack_set_visible_child_name (GTK_STACK (self->stack), "panel");
+  set_page (self, page ? page : cc_luma_shell_page_for_panel (panel));
+  return TRUE;
+}
+
+void
+cc_luma_shell_go (CcLumaShell *self, const char *page)
+{
+  g_autoptr (GError) error = NULL;
+  self->pinned = FALSE;
+  if (cc_luma_live_page_ready (self->model, page) && show_view (self, page))
+    return;
+  if (!show_panel (self, cc_luma_shell_panel_for_page (page), page, NULL, &error))
+    g_warning ("%s", error->message);
+}
+
+static gboolean
+shell_set_active_panel_from_id (CcShell *shell, const char *id, GVariant *parameters, GError **error)
+{
+  CcLumaShell *self = CC_LUMA_SHELL (shell);
+  const char *page = cc_luma_shell_page_for_panel (id);
+  gboolean has_parameters = parameters && g_variant_n_children (parameters) > 0;
+  /* A panel asked for with parameters (a device, a subpage) is the panel's. */
+  if (page && !has_parameters && cc_luma_live_page_ready (self->model, page) && show_view (self, page))
+    return TRUE;
+  return show_panel (self, cc_luma_shell_panel_for_page (page) ? cc_luma_shell_panel_for_page (page) : id,
+                     page, parameters, error);
+}
+
+static GtkWidget *
+shell_get_toplevel (CcShell *shell)
+{
+  return GTK_WIDGET (gtk_widget_get_root (GTK_WIDGET (shell)));
+}
+
+static void
+shell_iface_init (CcShellInterface *iface)
+{
+  iface->set_active_panel_from_id = shell_set_active_panel_from_id;
+  iface->get_toplevel = shell_get_toplevel;
+}
+
+static void
+cc_luma_shell_get_property (GObject *object, guint prop_id, GValue *value, GParamSpec *pspec)
+{
+  if (prop_id == PROP_ACTIVE_PANEL) g_value_set_object (value, CC_LUMA_SHELL (object)->active_panel);
+  else G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+}
+
+static void
+cc_luma_shell_set_property (GObject *object, guint prop_id, const GValue *value, GParamSpec *pspec)
+{
+  if (prop_id == PROP_ACTIVE_PANEL) g_set_object (&CC_LUMA_SHELL (object)->active_panel, g_value_get_object (value));
+  else G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+}
+
+static void
+cc_luma_shell_dispose (GObject *object)
+{
+  CcLumaShell *self = CC_LUMA_SHELL (object);
+  g_clear_object (&self->active_panel);
+  g_clear_object (&self->model);
+  g_clear_pointer (&self->page, g_free);
+  g_clear_pointer (&self->panel_id, g_free);
+  G_OBJECT_CLASS (cc_luma_shell_parent_class)->dispose (object);
+}
+
+static void
+cc_luma_shell_class_init (CcLumaShellClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  object_class->get_property = cc_luma_shell_get_property;
+  object_class->set_property = cc_luma_shell_set_property;
+  object_class->dispose = cc_luma_shell_dispose;
+  g_object_class_override_property (object_class, PROP_ACTIVE_PANEL, "active-panel");
+}
+
+static void
+cc_luma_shell_init (CcLumaShell *self)
+{
+  static gsize hooked = 0;
+  if (g_once_init_enter (&hooked))
+    {
+      g_type_ensure (ADW_TYPE_HEADER_BAR);
+      g_signal_add_emission_hook (g_signal_lookup ("map", GTK_TYPE_WIDGET), 0, header_bar_mapped, NULL, NULL);
+      g_once_init_leave (&hooked, 1);
+    }
+  self->stack = gtk_stack_new ();
+  self->panels = adw_navigation_view_new ();
+  gtk_widget_add_css_class (self->panels, "cf-panel-host");
+  gtk_stack_add_named (GTK_STACK (self->stack), self->panels, "panel");
+  adw_bin_set_child (ADW_BIN (self), self->stack);
+}
+
+/* A page shown as its GNOME panel while its owners were still reporting
+ * becomes the LumaUI page once they have, unless the person went deeper. */
+static void
+model_changed (CcLumaShell *self)
+{
+  if (self->pinned || !self->page || g_strcmp0 (gtk_stack_get_visible_child_name (GTK_STACK (self->stack)), "panel") != 0)
+    return;
+  if (adw_navigation_view_get_previous_page (ADW_NAVIGATION_VIEW (self->panels),
+        adw_navigation_view_get_visible_page (ADW_NAVIGATION_VIEW (self->panels))) != NULL)
+    return;
+  if (cc_luma_live_page_ready (self->model, self->page))
+    {
+      g_autofree char *page = g_strdup (self->page);
+      show_view (self, page);
+    }
+}
+
+GtkWidget *
+cc_luma_shell_new (CcLumaFixture *model, GtkWidget *view)
+{
+  CcLumaShell *self = g_object_new (CC_TYPE_LUMA_SHELL, NULL);
+  self->model = g_object_ref (model);
+  if (cc_luma_fixture_is_live (model))
+    g_signal_connect_object (model, "changed", G_CALLBACK (model_changed), self, G_CONNECT_SWAPPED);
+  if (view)
+    {
+      self->view = view;
+      cc_luma_view_set_page_handler (view, view_page_changed, self);
+      cc_luma_view_set_router (view, view_route, self);
+      cc_luma_view_set_delegate (view, view_delegate, self);
+      gtk_widget_set_vexpand (view, TRUE);
+      gtk_stack_add_named (GTK_STACK (self->stack), view, "view");
+      gtk_stack_set_visible_child_name (GTK_STACK (self->stack), "view");
+      self->page = g_strdup (cc_luma_view_get_page (view));
+    }
+  return GTK_WIDGET (self);
+}
+
+const char *
+cc_luma_shell_get_page (CcLumaShell *self)
+{
+  return self->page;
+}
+
+void
+cc_luma_shell_set_page_handler (CcLumaShell *self, CcLumaShellPageFunc handler, gpointer data)
+{
+  self->handler = handler;
+  self->handler_data = data;
+}
+
+/* v71 phone: where the title island's ‹ goes from a top-level page (the list of pages). */
+void
+cc_luma_shell_set_list_handler (CcLumaShell *self, CcLumaViewListFunc handler, gpointer data)
+{
+  self->list_handler = handler;
+  self->list_data = data;
+  if (self->view) cc_luma_view_set_list_handler (self->view, handler, data);
+}
+
+void
+cc_luma_shell_search (CcLumaShell *self, const char *text, CcLumaViewSearchFunc handler, gpointer data)
+{
+  if (!self->view)
+    {
+      /* Search needs the LumaUI pages; start them on the page shown if it can be drawn. */
+      if (!self->page || !cc_luma_live_page_ready (self->model, self->page) || !show_view (self, self->page))
+        return;
+    }
+  cc_luma_view_set_search_handler (self->view, handler, data);
+  gtk_stack_set_visible_child_name (GTK_STACK (self->stack), "view");
+  cc_luma_view_search (self->view, text);
+}
diff --git a/shell/cc-luma-shell.h b/shell/cc-luma-shell.h
new file mode 100644
index 0000000..7cac26f
--- /dev/null
+++ b/shell/cc-luma-shell.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <adwaita.h>
+#include "cc-luma-fixture.h"
+#include "cc-luma-view.h"
+
+G_BEGIN_DECLS
+/* The page island's content and Settings' CcShell: it shows a page as the
+ * LumaUI view when the model can draw it (always in fixture mode; in live
+ * mode once the page's owners have reported), and otherwise the page's GNOME
+ * panel, so every page keeps working while its LumaUI page is wired. */
+#define CC_TYPE_LUMA_SHELL (cc_luma_shell_get_type ())
+G_DECLARE_FINAL_TYPE (CcLumaShell, cc_luma_shell, CC, LUMA_SHELL, AdwBin)
+
+GtkWidget *cc_luma_shell_new (CcLumaFixture *model, GtkWidget *view);
+/* Show a Settings page (v70 id: "wifi", "displays", "app:filer" …). */
+void cc_luma_shell_go (CcLumaShell *self, const char *page);
+const char *cc_luma_shell_get_page (CcLumaShell *self);
+typedef void (*CcLumaShellPageFunc) (CcLumaShell *shell, const char *page, gpointer data);
+void cc_luma_shell_set_page_handler (CcLumaShell *self, CcLumaShellPageFunc handler, gpointer data);
+/* v71 phone: the title island's ‹ on a top-level page goes back to the list of pages. */
+void cc_luma_shell_set_list_handler (CcLumaShell *self, CcLumaViewListFunc handler, gpointer data);
+/* GNOME panel ids (command line, other panels) to pages and back. */
+const char *cc_luma_shell_page_for_panel (const char *panel);
+const char *cc_luma_shell_panel_for_page (const char *page);
+/* Search rows across the LumaUI pages; handler gets the sidebar's counts. */
+void cc_luma_shell_search (CcLumaShell *self, const char *text, CcLumaViewSearchFunc handler, gpointer data);
+G_END_DECLS
diff --git a/shell/cc-luma-sound.c b/shell/cc-luma-sound.c
index 65741ea..e1e58a1 100644
--- a/shell/cc-luma-sound.c
+++ b/shell/cc-luma-sound.c
@@ -38,8 +38,67 @@ static gboolean output_known (CcLumaFixture *model, const char *id)
   }
   return FALSE;
 }
+static gboolean absent (JsonNode *node) { return !node || JSON_NODE_HOLDS_NULL (node); }
+static gboolean listed (CcLumaFixture *model, const char *data, const char *id)
+{
+  JsonNode *node = json_object_get_member (cc_luma_fixture_get_data (model), data);
+  if (!node || !JSON_NODE_HOLDS_ARRAY (node) || !id) return FALSE;
+  JsonArray *items = json_node_get_array (node);
+  for (guint i = 0; i < json_array_get_length (items); i++) {
+    JsonNode *item = json_array_get_element (items, i);
+    JsonNode *key = JSON_NODE_HOLDS_OBJECT (item) ? json_object_get_member (json_node_get_object (item), "id") : NULL;
+    if (key && json_node_get_value_type (key) == G_TYPE_STRING && g_str_equal (json_node_get_string (key), id)) return TRUE;
+  }
+  return FALSE;
+}
+static gboolean devices_valid (CcLumaFixture *model, const char *data)
+{
+  JsonNode *node = json_object_get_member (cc_luma_fixture_get_data (model), data);
+  if (!node) return TRUE;
+  if (!JSON_NODE_HOLDS_ARRAY (node)) return FALSE;
+  JsonArray *items = json_node_get_array (node);
+  for (guint i = 0; i < json_array_get_length (items); i++) {
+    JsonNode *item = json_array_get_element (items, i);
+    if (!JSON_NODE_HOLDS_OBJECT (item)) return FALSE;
+    const char *fields[] = { "id", "n" };
+    for (guint j = 0; j < G_N_ELEMENTS (fields); j++) {
+      JsonNode *field = json_object_get_member (json_node_get_object (item), fields[j]);
+      if (!field || json_node_get_value_type (field) != G_TYPE_STRING || !*json_node_get_string (field)) return FALSE;
+    }
+  }
+  return TRUE;
+}
