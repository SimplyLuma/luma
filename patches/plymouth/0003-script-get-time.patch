+/* Seconds on the monotonic clock. Refresh callbacks arrive at a nominal
+ * 50 Hz, but a frame that takes longer to draw delays the next one, so a
+ * theme that counts callbacks runs slow exactly when the machine is busy.
+ * With this a theme can time its animation by the clock instead. */
+static script_return_t plymouth_get_time (script_state_t *state,
+                                          void           *user_data)
+{
+        return script_return_obj (script_obj_new_number (ply_get_timestamp ()));
+}
