                                 ply_trace ("found node %s", node);
-                                create_devices_for_udev_device (manager, device);
+                                if (!create_devices_for_udev_device (manager, device) &&
+                                    drm_device_is_retryable (device) &&
+                                    ply_hashtable_lookup (manager->renderers, (void *) node) == NULL)
+                                        schedule_drm_device_retry (manager, device);
                         }
                 } else {
                         ply_trace ("it's not initialized");
@@ -469,7 +546,10 @@ on_drm_udev_add_or_change (ply_device_manager_t *manager,
                  * renderer creation fails when no outputs are connected and
