                 return;
         }
 
@@ -484,6 +564,55 @@ on_drm_udev_add_or_change (ply_device_manager_t *manager,
         }
 }
 
+static void
+retry_pending_drm_devices (ply_device_manager_t *manager)
+{
+        ply_list_node_t *node, *next_node;
+
+        manager->drm_retry_scheduled = false;
+        manager->drm_retry_attempts++;
+
+        for (node = ply_list_get_first_node (manager->pending_drm_devices);
+             node != NULL;
+             node = next_node) {
+                char *sysname = ply_list_node_get_data (node);
+                struct udev_device *device;
+                bool done = true;
+
+                next_node = ply_list_get_next_node (manager->pending_drm_devices, node);
+                device = udev_device_new_from_subsystem_sysname (manager->udev_context,
+                                                                 SUBSYSTEM_DRM, sysname);
+                if (device != NULL) {
+                        const char *device_path = udev_device_get_devnode (device);
+
+                        if (!manager->paused && device_path != NULL &&
+                            ply_hashtable_lookup (manager->renderers, (void *) device_path) == NULL) {
+                                ply_trace ("retrying DRM device %s (attempt %d)",
+                                           device_path, manager->drm_retry_attempts);
+                                done = create_devices_for_udev_device (manager, device);
+                                if (!done && manager->drm_retry_attempts >= DRM_DEVICE_RETRY_LIMIT) {
+                                        ply_trace ("giving up on DRM device %s until it changes", device_path);
+                                        done = true;
+                                }
+                        }
+                        udev_device_unref (device);
+                }
+
+                if (done) {
+                        free (sysname);
+                        ply_list_remove_node (manager->pending_drm_devices, node);
+                }
+        }
+
+        if (ply_list_get_length (manager->pending_drm_devices) > 0) {
+                manager->drm_retry_scheduled = true;
+                ply_event_loop_watch_for_timeout (manager->loop,
+                                                  DRM_DEVICE_RETRY_INTERVAL,
+                                                  (ply_event_loop_timeout_handler_t)
+                                                  retry_pending_drm_devices, manager);
+        }
+}
+
 static bool
