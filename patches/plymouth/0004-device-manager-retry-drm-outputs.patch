+#ifdef HAVE_UDEV
+/* A DRM device can appear before its outputs can be driven: its connectors
+ * still report no mode, and opening a renderer for it fails ("Could not
+ * initialize heads"). That is common when a GPU driver replaces SimpleDRM
+ * during boot, and SimpleDRM is gone by then. Opening is retried on the next
+ * udev change event, but when none follows the splash stays off screen until
+ * DeviceTimeout. So retry such a device briefly on a timer as well. */
+#define DRM_DEVICE_RETRY_INTERVAL 0.1
+#define DRM_DEVICE_RETRY_LIMIT    30
+
+static void retry_pending_drm_devices (ply_device_manager_t *manager);
+
+static bool
+drm_device_is_retryable (struct udev_device *device)
+{
+        const char *subsystem = udev_device_get_subsystem (device);
+        const char *device_path = udev_device_get_devnode (device);
+        const char *syspath = udev_device_get_syspath (device);
+
+        return subsystem != NULL && strcmp (subsystem, SUBSYSTEM_DRM) == 0 &&
+               device_path != NULL && syspath != NULL &&
+               !ply_string_has_prefix (device_path, "/dev/dri/render") &&
+               !syspath_is_simpledrm (syspath);
+}
+
+static void
+schedule_drm_device_retry (ply_device_manager_t *manager,
+                           struct udev_device   *device)
+{
+        const char *sysname = udev_device_get_sysname (device);
+        ply_list_node_t *node;
+        bool listed = false;
+
+        if (sysname == NULL || manager->loop == NULL)
+                return;
+
+        for (node = ply_list_get_first_node (manager->pending_drm_devices);
+             node != NULL;
+             node = ply_list_get_next_node (manager->pending_drm_devices, node)) {
+                if (strcmp (ply_list_node_get_data (node), sysname) == 0)
+                        listed = true;
+        }
+        if (!listed) {
+                ply_trace ("will retry DRM device %s until its outputs are ready", sysname);
+                ply_list_append_data (manager->pending_drm_devices, strdup (sysname));
+                manager->drm_retry_attempts = 0;
+        }
+
+        if (!manager->drm_retry_scheduled) {
+                manager->drm_retry_scheduled = true;
+                ply_event_loop_watch_for_timeout (manager->loop,
+                                                  DRM_DEVICE_RETRY_INTERVAL,
+                                                  (ply_event_loop_timeout_handler_t)
+                                                  retry_pending_drm_devices, manager);
+        }
+}
+
+static void
+forget_pending_drm_devices (ply_device_manager_t *manager)
+{
+        ply_list_node_t *node;
+
+        while ((node = ply_list_get_first_node (manager->pending_drm_devices)) != NULL) {
+                free (ply_list_node_get_data (node));
+                ply_list_remove_node (manager->pending_drm_devices, node);
+        }
+}
+#endif
+
 static void
 create_devices_for_subsystem (ply_device_manager_t *manager,
                               const char           *subsystem)
@@ -442,7 +516,10 @@ create_devices_for_subsystem (ply_device_manager_t *manager,
