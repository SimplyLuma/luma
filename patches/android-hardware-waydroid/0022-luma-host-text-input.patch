diff --git a/hwcomposer/luma-text-input-channel.h b/hwcomposer/luma-text-input-channel.h
new file mode 100644
index 0000000..7c27146
--- /dev/null
+++ b/hwcomposer/luma-text-input-channel.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include <cstdint>
+
+// Records between the composer and Luma's Android input method, which runs
+// as the system UID. SOCK_SEQPACKET, little endian; one record per message.
+namespace luma::text_input {
+constexpr uint32_t magic = 0x4c545849; // LTXI
+constexpr uint16_t version = 1;
+constexpr char socket_name[] = "luma-android-text-input-v1";
+// zwp_text_input_v3 limits surrounding text to 4000 bytes.
+constexpr uint32_t max_text = 4000;
+
+enum Type : uint16_t {
+    Enable = 1,      // EnableBody: a field wants the host keyboard
+    Disable = 2,     // no body
+    Surrounding = 3, // SurroundingBody, then UTF-8 text
+    Done = 16,       // DoneBody, then commit and preedit UTF-8 bytes
+    Inset = 17,      // InsetBody: Android pixels the host keyboard covers
+};
+
+struct Header {
+    uint32_t magic;
+    uint16_t version;
+    uint16_t type;
+};
+struct EnableBody {
+    uint32_t purpose; // zwp_text_input_v3 content_purpose
+    uint32_t hints;   // zwp_text_input_v3 content_hint
+};
+struct SurroundingBody {
+    int32_t cursor; // byte offsets into the text that follows
+    int32_t anchor;
+};
+struct DoneBody {
+    uint32_t delete_before; // bytes, as zwp_text_input_v3 counts them
+    uint32_t delete_after;
+    int32_t preedit_begin;
+    int32_t preedit_end;
+    uint32_t commit_length;
+    uint32_t preedit_length;
+};
+struct InsetBody {
+    uint32_t height;
+};
+static_assert(sizeof(Header) == 8 && sizeof(EnableBody) == 8 &&
+              sizeof(SurroundingBody) == 8 && sizeof(DoneBody) == 24 &&
+              sizeof(InsetBody) == 4);
+}
diff --git a/hwcomposer/luma-text-input.cpp b/hwcomposer/luma-text-input.cpp
new file mode 100644
index 0000000..4329438
--- /dev/null
+++ b/hwcomposer/luma-text-input.cpp
@@ -0,0 +1,308 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "luma-text-input.h"
+#include "luma-text-input-channel.h"
+#include "wayland-hwc.h"
+#include "luma-text-input-v3-client-protocol.h"
+
+#include <cerrno>
+#include <cstddef>
+#include <algorithm>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <log/log.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace {
+using namespace luma::text_input;
+
+constexpr uid_t kSystemUid = 1000;
+
+struct bridge {
+    display* d = nullptr;
+    zwp_text_input_manager_v3* manager = nullptr;
+    zwp_text_input_v3* input = nullptr;
+    uint32_t version = 1;
+
+    std::mutex mutex; // everything below, and requests on `input`
+    int client = -1;
+    uint32_t inset = 0;
+    bool focused = false, wanted = false, enabled = false;
+    uint32_t purpose = 0, hints = 0;
+    bool have_surrounding = false;
+    std::string surrounding;
+    int32_t cursor = 0, anchor = 0;
+    bool changed_by_input_method = false;
+    // zwp_text_input_v3 state pending until done
+    std::string commit, preedit;
+    int32_t preedit_begin = 0, preedit_end = 0;
+    uint32_t delete_before = 0, delete_after = 0;
+};
+
+bridge state;
+
+// Each request from Android is a field asking for a keyboard, so it also asks
+// the compositor to show its panel: explicitly since text-input v2, and on v1
+// by enabling again while already enabled, which compositors read as a show
+// request (the first enable only focuses the field).
+void send_state_locked() {
+    if (!state.input) return;
+    if (state.wanted && state.focused) {
+        if (!state.enabled) {
+            zwp_text_input_v3_enable(state.input);
+            uint32_t hints = state.hints;
+            // Android draws the composing text in the field itself.
+            if (state.version >= ZWP_TEXT_INPUT_V3_SHOW_INPUT_PANEL_SINCE_VERSION)
+                hints |= ZWP_TEXT_INPUT_V3_CONTENT_HINT_PREEDIT_SHOWN;
+            zwp_text_input_v3_set_content_type(state.input, hints, state.purpose);
+            if (state.have_surrounding)
+                zwp_text_input_v3_set_surrounding_text(state.input, state.surrounding.c_str(),
+                                                       state.cursor, state.anchor);
+            zwp_text_input_v3_set_text_change_cause(state.input,
+                ZWP_TEXT_INPUT_V3_CHANGE_CAUSE_OTHER);
+            if (state.version >= ZWP_TEXT_INPUT_V3_SHOW_INPUT_PANEL_SINCE_VERSION)
+                zwp_text_input_v3_show_input_panel(state.input);
+            zwp_text_input_v3_commit(state.input);
+            state.enabled = true;
+        }
+        if (state.version >= ZWP_TEXT_INPUT_V3_SHOW_INPUT_PANEL_SINCE_VERSION)
+            zwp_text_input_v3_show_input_panel(state.input);
+        else
+            zwp_text_input_v3_enable(state.input);
+        zwp_text_input_v3_commit(state.input);
+    } else if (state.enabled) {
+        zwp_text_input_v3_disable(state.input);
+        zwp_text_input_v3_commit(state.input);
+        state.enabled = false;
+    }
+    wl_display_flush(state.d->display);
+}
+
+void send_surrounding_locked() {
+    if (!state.input || !state.enabled || !state.have_surrounding) return;
+    zwp_text_input_v3_set_surrounding_text(state.input, state.surrounding.c_str(),
+                                           state.cursor, state.anchor);
+    zwp_text_input_v3_set_text_change_cause(state.input, state.changed_by_input_method
+        ? ZWP_TEXT_INPUT_V3_CHANGE_CAUSE_INPUT_METHOD
+        : ZWP_TEXT_INPUT_V3_CHANGE_CAUSE_OTHER);
+    state.changed_by_input_method = false;
+    zwp_text_input_v3_commit(state.input);
+    wl_display_flush(state.d->display);
+}
+
+void handle_enter(void*, zwp_text_input_v3*, wl_surface*) {
+    std::scoped_lock lock(state.mutex);
+    state.focused = true;
+    state.enabled = false;
+    if (state.wanted) send_state_locked();
+}
+
+void handle_leave(void*, zwp_text_input_v3*, wl_surface*) {
+    std::scoped_lock lock(state.mutex);
+    // The compositor disables text input for the surface it left.
+    state.focused = false;
+    state.enabled = false;
+}
+
+void handle_preedit(void*, zwp_text_input_v3*, const char* text, int32_t begin, int32_t end) {
+    std::scoped_lock lock(state.mutex);
+    state.preedit = text ? text : "";
+    state.preedit_begin = begin;
+    state.preedit_end = end;
+}
+
+void handle_commit(void*, zwp_text_input_v3*, const char* text) {
+    std::scoped_lock lock(state.mutex);
+    state.commit = text ? text : "";
+}
+
+void handle_delete(void*, zwp_text_input_v3*, uint32_t before, uint32_t after) {
+    std::scoped_lock lock(state.mutex);
+    state.delete_before = before;
+    state.delete_after = after;
+}
+
+void handle_done(void*, zwp_text_input_v3*, uint32_t) {
+    std::scoped_lock lock(state.mutex);
+    const size_t commit_length = std::min<size_t>(state.commit.size(), max_text);
+    const size_t preedit_length = std::min<size_t>(state.preedit.size(), max_text);
+    std::vector<uint8_t> record(sizeof(Header) + sizeof(DoneBody) + commit_length + preedit_length);
+    const Header header{magic, version, Done};
+    const DoneBody body{state.delete_before, state.delete_after, state.preedit_begin,
+                        state.preedit_end, uint32_t(commit_length), uint32_t(preedit_length)};
+    memcpy(record.data(), &header, sizeof(header));
+    memcpy(record.data() + sizeof(header), &body, sizeof(body));
+    memcpy(record.data() + sizeof(header) + sizeof(body), state.commit.data(), commit_length);
+    memcpy(record.data() + sizeof(header) + sizeof(body) + commit_length,
+           state.preedit.data(), preedit_length);
+    if (state.client >= 0 &&
+            send(state.client, record.data(), record.size(), MSG_DONTWAIT | MSG_NOSIGNAL) < 0)
+        ALOGW("Android text input record dropped: %s", strerror(errno));
+    state.changed_by_input_method = !state.commit.empty() || state.delete_before ||
+        state.delete_after;
+    state.commit.clear();
+    state.preedit.clear();
+    state.preedit_begin = state.preedit_end = 0;
+    state.delete_before = state.delete_after = 0;
+}
+
+void handle_action(void*, zwp_text_input_v3*, uint32_t, uint32_t) {}
+void handle_language(void*, zwp_text_input_v3*, const char*) {}
+void handle_preedit_hint(void*, zwp_text_input_v3*, uint32_t, uint32_t, uint32_t) {}
+
+const zwp_text_input_v3_listener listener = {
+    handle_enter, handle_leave, handle_preedit, handle_commit, handle_delete, handle_done,
+    handle_action, handle_language, handle_preedit_hint,
+};
+
+void handle_record(const uint8_t* data, size_t length) {
+    Header header;
+    if (length < sizeof(header)) return;
+    memcpy(&header, data, sizeof(header));
+    if (header.magic != magic || header.version != version) return;
+    data += sizeof(header);
+    length -= sizeof(header);
+    std::scoped_lock lock(state.mutex);
+    switch (header.type) {
+    case Enable: {
+        EnableBody body;
+        if (length != sizeof(body)) return;
+        memcpy(&body, data, sizeof(body));
+        state.purpose = body.purpose;
+        state.hints = body.hints;
+        state.wanted = true;
+        send_state_locked();
+        break;
+    }
+    case Disable:
+        state.wanted = false;
+        state.have_surrounding = false;
+        send_state_locked();
+        break;
+    case Surrounding: {
+        SurroundingBody body;
+        if (length < sizeof(body) || length - sizeof(body) > max_text) return;
+        memcpy(&body, data, sizeof(body));
+        const size_t text_length = length - sizeof(body);
+        if (body.cursor < 0 || body.anchor < 0 || size_t(body.cursor) > text_length ||
+                size_t(body.anchor) > text_length ||
+                memchr(data + sizeof(body), 0, text_length))
+            return;
+        state.surrounding.assign(reinterpret_cast<const char*>(data + sizeof(body)), text_length);
+        state.cursor = body.cursor;
+        state.anchor = body.anchor;
+        state.have_surrounding = true;
+        send_surrounding_locked();
+        break;
+    }
+    }
+}
+
+bool admitted(int fd) {
+    ucred credentials{};
+    socklen_t size = sizeof(credentials);
+    return getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &credentials, &size) == 0 &&
+        size == sizeof(credentials) && credentials.uid == kSystemUid;
+}
+
+void serve() {
+    const int listener_fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+    if (listener_fd < 0) return;
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    memcpy(address.sun_path + 1, socket_name, sizeof(socket_name) - 1);
+    const socklen_t address_length = offsetof(sockaddr_un, sun_path) + sizeof(socket_name);
+    if (bind(listener_fd, reinterpret_cast<sockaddr*>(&address), address_length) < 0 ||
+            listen(listener_fd, 2) < 0) {
+        ALOGE("Android text input channel unavailable: %s", strerror(errno));
+        close(listener_fd);
+        return;
+    }
+    std::vector<uint8_t> buffer(sizeof(Header) + sizeof(SurroundingBody) + max_text + 1);
+    int client = -1;
+    for (;;) {
+        pollfd fds[2] = {{listener_fd, POLLIN, 0}, {client, POLLIN, 0}};
+        if (poll(fds, client >= 0 ? 2 : 1, -1) < 0) {
+            if (errno == EINTR) continue;
+            break;
+        }
+        if (fds[0].revents & POLLIN) {
+            const int incoming = accept4(listener_fd, nullptr, nullptr, SOCK_CLOEXEC);
+            if (incoming >= 0 && !admitted(incoming)) {
+                close(incoming);
+            } else if (incoming >= 0) {
+                // One input method at a time; a restarted service replaces it.
+                std::scoped_lock lock(state.mutex);
+                if (client >= 0) close(client);
+                client = state.client = incoming;
+                state.wanted = false;
+                state.inset = 0;
+                send_state_locked();
+            }
+        }
+        if (client >= 0 && (fds[1].revents & (POLLIN | POLLHUP | POLLERR))) {
+            const ssize_t length = recv(client, buffer.data(), buffer.size(), 0);
+            if (length > 0) {
+                if (size_t(length) < buffer.size()) handle_record(buffer.data(), size_t(length));
+            } else if (length == 0 || (errno != EINTR && errno != EAGAIN)) {
+                std::scoped_lock lock(state.mutex);
+                close(client);
+                client = state.client = -1;
+                state.wanted = false;
+                send_state_locked();
+            }
+        }
+    }
+    close(listener_fd);
+}
+}
+
+void luma_text_input_bind(display* d, wl_registry* registry, uint32_t id, uint32_t version) {
+    state.d = d;
+    state.version = std::min<uint32_t>(version, 2);
+    state.manager = static_cast<zwp_text_input_manager_v3*>(
+        wl_registry_bind(registry, id, &zwp_text_input_manager_v3_interface, state.version));
+}
+
+bool luma_text_input_connected() {
+    std::scoped_lock lock(state.mutex);
+    return state.client >= 0;
+}
+
+void luma_text_input_set_inset(uint32_t pixels) {
+    std::scoped_lock lock(state.mutex);
+    if (state.inset == pixels || state.client < 0) return;
+    state.inset = pixels;
+    uint8_t record[sizeof(Header) + sizeof(InsetBody)];
+    const Header header{magic, version, Inset};
+    const InsetBody body{pixels};
+    memcpy(record, &header, sizeof(header));
+    memcpy(record + sizeof(header), &body, sizeof(body));
+    send(state.client, record, sizeof(record), MSG_DONTWAIT | MSG_NOSIGNAL);
+}
+
+bool luma_text_input_active() {
+    std::scoped_lock lock(state.mutex);
+    return state.enabled && state.focused;
+}
+
+void luma_text_input_start(display* d) {
+    state.d = d;
+    if (!state.manager || !d->seat) {
+        ALOGI("Host text input unavailable; Android keeps its own keyboard");
+        return;
+    }
+    {
+        std::scoped_lock lock(state.mutex);
+        state.input = zwp_text_input_manager_v3_get_text_input(state.manager, d->seat);
+        zwp_text_input_v3_add_listener(state.input, &listener, nullptr);
+    }
+    std::thread(serve).detach();
+    ALOGI("Host text input bridge ready");
+}
