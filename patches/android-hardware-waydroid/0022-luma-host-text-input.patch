+// SPDX-License-Identifier: Apache-2.0
+package org.projectluma.inputmethod;
+
+import android.content.BroadcastReceiver;
+import android.content.ComponentName;
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.Intent;
+import android.provider.Settings;
+
+/**
+ * Selects this input method in place of Android's keyboard where the composer
+ * offers host text input, and gives Android's keyboard back where it does not
+ * (a nested compositor without zwp_text_input_v3).
+ */
+public final class DefaultInputMethod extends BroadcastReceiver {
+    private static final String LATIN_IME = "com.android.inputmethod.latin";
+    private static final String LATIN_IME_ID = LATIN_IME + "/.LatinIME";
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        if (!Intent.ACTION_BOOT_COMPLETED.equals(intent.getAction())) return;
+        final PendingResult result = goAsync();
+        final ContentResolver resolver = context.getContentResolver();
+        final String self = new ComponentName(context, LumaInputMethodService.class)
+                .flattenToShortString();
+        new Thread(() -> {
+            try {
+                final String current = Settings.Secure.getString(resolver,
+                        Settings.Secure.DEFAULT_INPUT_METHOD);
+                if (HostTextInput.available()) {
+                    // A keyboard the person installed and chose stays selected.
+                    if (self.equals(current) || (current != null && !current.isEmpty()
+                            && !current.startsWith(LATIN_IME + "/")))
+                        return;
+                    select(resolver, self);
+                } else if (self.equals(current)) {
+                    select(resolver, LATIN_IME_ID);
+                }
+            } finally {
+                result.finish();
+            }
+        }, "LumaDefaultInputMethod").start();
+    }
+
+    private static void select(ContentResolver resolver, String id) {
+        Settings.Secure.putString(resolver, Settings.Secure.ENABLED_INPUT_METHODS, id);
+        Settings.Secure.putString(resolver, Settings.Secure.DEFAULT_INPUT_METHOD, id);
+    }
+}
diff --git a/LumaInputMethod/src/org/projectluma/inputmethod/HostTextInput.java b/LumaInputMethod/src/org/projectluma/inputmethod/HostTextInput.java
new file mode 100644
index 0000000..df6b928
--- /dev/null
+++ b/LumaInputMethod/src/org/projectluma/inputmethod/HostTextInput.java
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: Apache-2.0
+package org.projectluma.inputmethod;
+
+import android.net.LocalSocket;
+import android.net.LocalSocketAddress;
+import android.os.Handler;
+import android.util.Log;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.RejectedExecutionException;
+
+/**
+ * The composer's text-input channel (hwcomposer luma-text-input-channel.h):
+ * SOCK_SEQPACKET records, little endian, admitted for the system UID only.
+ * The composer serves one input method at a time and the newest connection
+ * wins, so this connects only when a field asks for the keyboard and never
+ * reconnects by itself: a process left over from a restarted Android, whose
+ * service is no longer bound, cannot take the channel back.
+ */
+final class HostTextInput {
+    interface Listener {
+        void onHostEdit(int deleteBefore, int deleteAfter, String commit, String preedit);
+        /** Android pixels of the focused task covered by the host keyboard. */
+        void onHostInset(int height);
+    }
+
+    static final int MAX_TEXT = 4000;
+    private static final String TAG = "LumaInputMethod";
+    private static final String SOCKET = "luma-android-text-input-v1";
+    private static final int MAGIC = 0x4c545849;
+    private static final short VERSION = 1;
+    private static final short ENABLE = 1, DISABLE = 2, SURROUNDING = 3, DONE = 16, INSET = 17;
+
+    private final Listener listener;
+    private final Handler main;
+    private final ExecutorService writer = Executors.newSingleThreadExecutor();
+    private LocalSocket socket; // writer thread only
+
+    HostTextInput(Listener listener, Handler main) {
+        this.listener = listener;
+        this.main = main;
+    }
+
+    /** Whether the composer serves the channel (it does only with host text input). */
+    static boolean available() {
+        try (LocalSocket probe = new LocalSocket(LocalSocket.SOCKET_SEQPACKET)) {
+            probe.connect(new LocalSocketAddress(SOCKET, LocalSocketAddress.Namespace.ABSTRACT));
+            return true;
+        } catch (IOException e) {
+            return false;
+        }
+    }
+
+    void stop() {
+        writer.shutdownNow();
+        try {
+            writer.execute(this::close);
+        } catch (RejectedExecutionException ignored) {
+        }
+        close();
+    }
+
+    /** Connect ahead of a show request, so the composer knows this window is ours. */
+    void connect() {
+        try {
+            writer.execute(() -> {
+                if (socket == null) open();
+            });
+        } catch (RejectedExecutionException ignored) {
+        }
+    }
+
+    void enable(int purpose, int hints) {
+        send(record(ENABLE, 8).putInt(purpose).putInt(hints), true);
+    }
+
+    void disable() {
+        send(record(DISABLE, 0), false);
+    }
+
+    /** Text around the caret; cursor and anchor are byte offsets into it. */
+    void surrounding(byte[] text, int cursor, int anchor) {
+        send(record(SURROUNDING, 8 + text.length).putInt(cursor).putInt(anchor).put(text), false);
+    }
+
+    private static ByteBuffer record(short type, int body) {
+        return ByteBuffer.allocate(8 + body).order(ByteOrder.LITTLE_ENDIAN)
+                .putInt(MAGIC).putShort(VERSION).putShort(type);
+    }
+
+    private void send(ByteBuffer record, boolean connect) {
+        final byte[] bytes = record.array();
+        try {
+            writer.execute(() -> {
+                if (socket == null && (!connect || !open())) return;
+                try {
+                    socket.getOutputStream().write(bytes);
+                } catch (IOException e) {
+                    close();
+                }
+            });
+        } catch (RejectedExecutionException ignored) {
+            // Stopped.
+        }
+    }
+
+    private boolean open() {
+        final LocalSocket current = new LocalSocket(LocalSocket.SOCKET_SEQPACKET);
+        try {
+            current.connect(new LocalSocketAddress(SOCKET, LocalSocketAddress.Namespace.ABSTRACT));
+        } catch (IOException e) {
+            Log.w(TAG, "Composer text input is unavailable");
+            return false;
+        }
+        socket = current;
+        new Thread(() -> read(current), "LumaHostTextInput").start();
+        return true;
+    }
+
+    private synchronized void close() {
+        if (socket == null) return;
+        try {
+            socket.close();
+        } catch (IOException ignored) {
+        }
+        socket = null;
+    }
+
+    private void read(LocalSocket current) {
+        final byte[] buffer = new byte[8 + 24 + 2 * MAX_TEXT];
+        try {
+            final InputStream in = current.getInputStream();
+            int length;
+            while ((length = in.read(buffer)) > 0) dispatch(buffer, length);
+        } catch (IOException e) {
+            // Replaced by a newer input method, or the composer restarted.
+        }
+        try {
+            writer.execute(() -> {
+                if (socket == current) close();
+            });
+        } catch (RejectedExecutionException ignored) {
+        }
+    }
+
+    private void dispatch(byte[] data, int length) {
+        if (length < 8) return;
+        final ByteBuffer in = ByteBuffer.wrap(data, 0, length).order(ByteOrder.LITTLE_ENDIAN);
+        if (in.getInt() != MAGIC || in.getShort() != VERSION) return;
+        final short type = in.getShort();
+        if (type == INSET && length == 8 + 4) {
+            final int height = in.getInt();
+            if (height >= 0) main.post(() -> listener.onHostInset(height));
+            return;
+        }
+        if (type != DONE || length < 8 + 24) return;
+        final int deleteBefore = in.getInt(), deleteAfter = in.getInt();
+        in.getInt(); // Preedit cursor range: the Android composing span has no caret.
+        in.getInt();
+        final int commitLength = in.getInt(), preeditLength = in.getInt();
+        if (commitLength < 0 || preeditLength < 0 || commitLength + preeditLength != in.remaining()) {
+            Log.w(TAG, "Malformed host text record");
+            return;
+        }
+        final String commit = new String(data, in.position(), commitLength, StandardCharsets.UTF_8);
+        final String preedit = new String(data, in.position() + commitLength, preeditLength,
+                StandardCharsets.UTF_8);
+        main.post(() -> listener.onHostEdit(deleteBefore, deleteAfter, commit, preedit));
+    }
+}
diff --git a/LumaInputMethod/src/org/projectluma/inputmethod/LumaInputMethodService.java b/LumaInputMethod/src/org/projectluma/inputmethod/LumaInputMethodService.java
new file mode 100644
index 0000000..27c2ec0
--- /dev/null
+++ b/LumaInputMethod/src/org/projectluma/inputmethod/LumaInputMethodService.java
@@ -0,0 +1,291 @@
+// SPDX-License-Identifier: Apache-2.0
+package org.projectluma.inputmethod;
+
+import android.graphics.drawable.ColorDrawable;
+import android.inputmethodservice.InputMethodService;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.ResultReceiver;
+import android.text.InputType;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.inputmethod.EditorInfo;
+import android.view.inputmethod.InputConnection;
+
+import java.nio.charset.StandardCharsets;
+
+/**
+ * An input method that draws nothing. A field asking for a keyboard enables
+ * the host's text input, so the person types on Luma's keyboard or a physical
+ * one with the host's input methods; their edits arrive here and are applied to
+ * the field. Its empty, transparent input view is as tall as the host keyboard
+ * over the task, so apps lay out above it as they would on a phone; the
+ * composer does not map this window.
+ */
+public final class LumaInputMethodService extends InputMethodService
+        implements HostTextInput.Listener {
+    // zwp_text_input_v3 content_purpose / content_hint
+    private static final int PURPOSE_NORMAL = 0, PURPOSE_DIGITS = 2, PURPOSE_NUMBER = 3,
+            PURPOSE_PHONE = 4, PURPOSE_URL = 5, PURPOSE_EMAIL = 6, PURPOSE_NAME = 7,
+            PURPOSE_PASSWORD = 8, PURPOSE_PIN = 9, PURPOSE_DATE = 10, PURPOSE_TIME = 11,
+            PURPOSE_DATETIME = 12;
+    private static final int HINT_COMPLETION = 0x1, HINT_SPELLCHECK = 0x2,
+            HINT_AUTO_CAPITALIZATION = 0x4, HINT_LOWERCASE = 0x8, HINT_UPPERCASE = 0x10, HINT_TITLECASE = 0x20,
+            HINT_HIDDEN_TEXT = 0x40, HINT_SENSITIVE_DATA = 0x80, HINT_MULTILINE = 0x200;
+    private static final int CONTEXT_CHARS = 1000;
+
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private HostTextInput host;
+    private boolean wanted, composing, sensitive;
+    private String beforeCursor = "", afterCursor = "", sentText;
+    private int sentCursor = -1, sentAnchor = -1;
+    private int keyboardHeight;
+    private View inset;
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        host = new HostTextInput(this, main);
+        getWindow().getWindow().setBackgroundDrawable(new ColorDrawable(0));
+    }
+
+    @Override
+    public void onDestroy() {
+        host.stop();
+        super.onDestroy();
+    }
+
+    // The input view carries the host keyboard's height, physical keyboard or not.
+    @Override
+    public boolean onEvaluateInputViewShown() {
+        super.onEvaluateInputViewShown();
+        return true;
+    }
+
+    @Override
+    public View onCreateInputView() {
+        inset = new View(this);
+        inset.setLayoutParams(new ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                keyboardHeight));
+        return inset;
+    }
+
+    @Override
+    public void onComputeInsets(Insets outInsets) {
+        super.onComputeInsets(outInsets);
+        // Touches over the keyboard area belong to the host keyboard.
+        outInsets.touchableInsets = Insets.TOUCHABLE_INSETS_REGION;
+        outInsets.touchableRegion.setEmpty();
+    }
+
+    @Override
+    public boolean onEvaluateFullscreenMode() {
+        return false;
+    }
+
+    @Override
+    public boolean onShowInputRequested(int flags, boolean configChange) {
+        final EditorInfo info = getCurrentInputEditorInfo();
+        if (getCurrentInputStarted() && info != null && info.inputType != InputType.TYPE_NULL) {
+            wanted = true;
+            sensitive = isSensitive(info.inputType);
+            enableHost(info);
+            return true;
+        }
+        return false;
+    }
+
+    @Override
+    public void onStartInput(EditorInfo attribute, boolean restarting) {
+        super.onStartInput(attribute, restarting);
+        composing = false;
+        sentText = null;
+        sensitive = attribute != null && isSensitive(attribute.inputType);
+        if (attribute != null && attribute.inputType != InputType.TYPE_NULL) host.connect();
+        // A restarted field keeps the host keyboard it already had.
+        if (restarting && wanted && attribute != null) enableHost(attribute);
+    }
+
+    @Override
+    public void onFinishInput() {
+        if (wanted) host.disable();
+        wanted = false;
+        composing = false;
+        super.onFinishInput();
+    }
+
+    @Override
+    public AbstractInputMethodImpl onCreateInputMethodInterface() {
+        return new Impl();
+    }
+
+    private final class Impl extends InputMethodImpl {
+        @Override
+        public void hideSoftInput(int flags, ResultReceiver resultReceiver) {
+            if (wanted) host.disable();
+            wanted = false;
+            super.hideSoftInput(flags, resultReceiver);
+        }
+    }
+
+    @Override
+    public void onUpdateSelection(int oldSelStart, int oldSelEnd, int newSelStart, int newSelEnd,
+            int candidatesStart, int candidatesEnd) {
+        super.onUpdateSelection(oldSelStart, oldSelEnd, newSelStart, newSelEnd,
+                candidatesStart, candidatesEnd);
+        if (wanted) sendSurrounding();
+    }
+
+    @Override
+    public void onHostInset(int height) {
+        keyboardHeight = height;
+        if (inset == null) return;
+        final ViewGroup.LayoutParams params = inset.getLayoutParams();
+        params.height = height;
+        inset.setLayoutParams(params);
+    }
+
+    @Override
+    public void onHostEdit(int deleteBefore, int deleteAfter, String commit, String preedit) {
+        final InputConnection ic = getCurrentInputConnection();
+        if (ic == null) return;
+        ic.beginBatchEdit();
+        if (composing) {
+            ic.setComposingText("", 1);
+            composing = false;
+        }
+        if (deleteBefore > 0 || deleteAfter > 0) {
+            ic.deleteSurroundingText(charsBefore(beforeCursor, deleteBefore),
+                    charsAfter(afterCursor, deleteAfter));
+        }
+        if (!commit.isEmpty()) ic.commitText(commit, 1);
+        if (!preedit.isEmpty()) {
+            ic.setComposingText(preedit, 1);
+            composing = true;
+        }
+        ic.endBatchEdit();
+    }
+
+    private void enableHost(EditorInfo info) {
+        host.enable(purpose(info.inputType), hints(info.inputType));
+        sentText = null;
+        sendSurrounding();
+    }
+
+    private void sendSurrounding() {
+        final InputConnection ic = getCurrentInputConnection();
+        if (ic == null) return;
+        if (sensitive) {
+            // Password text never leaves the field; byte counts fall back to UTF-16.
+            beforeCursor = afterCursor = "";
+            return;
+        }
+        String before = text(ic.getTextBeforeCursor(CONTEXT_CHARS, 0));
+        final String selected = text(ic.getSelectedText(0));
+        String after = text(ic.getTextAfterCursor(CONTEXT_CHARS, 0));
+        while (utf8(before + selected + after) > HostTextInput.MAX_TEXT && !before.isEmpty())
+            before = before.substring(before.offsetByCodePoints(0, 1));
+        while (utf8(before + selected + after) > HostTextInput.MAX_TEXT && !after.isEmpty())
+            after = after.substring(0, after.offsetByCodePoints(after.length(), -1));
+        final String all = before + selected + after;
+        if (utf8(all) > HostTextInput.MAX_TEXT) return;
+        beforeCursor = before + selected;
+        afterCursor = after;
+        final int anchor = utf8(before), cursor = utf8(beforeCursor);
+        if (all.equals(sentText) && cursor == sentCursor && anchor == sentAnchor) return;
+        sentText = all;
+        sentCursor = cursor;
+        sentAnchor = anchor;
+        host.surrounding(all.getBytes(StandardCharsets.UTF_8), cursor, anchor);
+    }
+
+    private static String text(CharSequence value) {
+        return value == null ? "" : value.toString();
+    }
+
+    private static int utf8(String value) {
+        return value.getBytes(StandardCharsets.UTF_8).length;
+    }
+
+    /** UTF-16 units covering `bytes` UTF-8 bytes before the caret. */
+    static int charsBefore(String before, int bytes) {
+        int index = before.length(), counted = 0;
+        while (index > 0 && counted < bytes) {
+            final int point = before.codePointBefore(index);
+            counted += utf8(new String(Character.toChars(point)));
+            index -= Character.charCount(point);
+        }
+        return counted < bytes ? before.length() - index + (bytes - counted) : before.length() - index;
+    }
+
+    static int charsAfter(String after, int bytes) {
+        int index = 0, counted = 0;
+        while (index < after.length() && counted < bytes) {
+            final int point = after.codePointAt(index);
+            counted += utf8(new String(Character.toChars(point)));
+            index += Character.charCount(point);
+        }
+        return counted < bytes ? index + (bytes - counted) : index;
+    }
+
+    private static boolean isSensitive(int type) {
+        final int variation = type & InputType.TYPE_MASK_VARIATION;
+        final int kind = type & InputType.TYPE_MASK_CLASS;
+        return (kind == InputType.TYPE_CLASS_TEXT
+                && (variation == InputType.TYPE_TEXT_VARIATION_PASSWORD
+                    || variation == InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD
+                    || variation == InputType.TYPE_TEXT_VARIATION_WEB_PASSWORD))
+                || (kind == InputType.TYPE_CLASS_NUMBER
+                    && variation == InputType.TYPE_NUMBER_VARIATION_PASSWORD);
+    }
+
+    static int purpose(int type) {
+        final int variation = type & InputType.TYPE_MASK_VARIATION;
+        switch (type & InputType.TYPE_MASK_CLASS) {
+            case InputType.TYPE_CLASS_NUMBER:
+                if (variation == InputType.TYPE_NUMBER_VARIATION_PASSWORD) return PURPOSE_PIN;
+                return (type & (InputType.TYPE_NUMBER_FLAG_DECIMAL | InputType.TYPE_NUMBER_FLAG_SIGNED)) != 0
+                        ? PURPOSE_NUMBER : PURPOSE_DIGITS;
+            case InputType.TYPE_CLASS_PHONE:
+                return PURPOSE_PHONE;
+            case InputType.TYPE_CLASS_DATETIME:
+                if (variation == InputType.TYPE_DATETIME_VARIATION_DATE) return PURPOSE_DATE;
+                if (variation == InputType.TYPE_DATETIME_VARIATION_TIME) return PURPOSE_TIME;
+                return PURPOSE_DATETIME;
+            case InputType.TYPE_CLASS_TEXT:
+                switch (variation) {
+                    case InputType.TYPE_TEXT_VARIATION_EMAIL_ADDRESS:
+                    case InputType.TYPE_TEXT_VARIATION_WEB_EMAIL_ADDRESS:
+                        return PURPOSE_EMAIL;
+                    case InputType.TYPE_TEXT_VARIATION_URI:
+                        return PURPOSE_URL;
+                    case InputType.TYPE_TEXT_VARIATION_PERSON_NAME:
+                        return PURPOSE_NAME;
+                    case InputType.TYPE_TEXT_VARIATION_PASSWORD:
+                    case InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD:
+                    case InputType.TYPE_TEXT_VARIATION_WEB_PASSWORD:
+                        return PURPOSE_PASSWORD;
+                    default:
+                        return PURPOSE_NORMAL;
+                }
+            default:
+                return PURPOSE_NORMAL;
+        }
+    }
+
+    static int hints(int type) {
+        if (isSensitive(type)) return HINT_HIDDEN_TEXT | HINT_SENSITIVE_DATA;
+        if ((type & InputType.TYPE_MASK_CLASS) != InputType.TYPE_CLASS_TEXT) return 0;
+        int hints = 0;
+        if ((type & InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS) == 0)
+            hints |= HINT_COMPLETION | HINT_SPELLCHECK;
+        if ((type & InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS) != 0) hints |= HINT_UPPERCASE;
+        else if ((type & InputType.TYPE_TEXT_FLAG_CAP_WORDS) != 0) hints |= HINT_TITLECASE;
+        else if ((type & InputType.TYPE_TEXT_FLAG_CAP_SENTENCES) != 0) hints |= HINT_AUTO_CAPITALIZATION;
+        // Android fields without a capitalization flag (user names, codes) expect none.
+        else hints |= HINT_LOWERCASE;
+        if ((type & (InputType.TYPE_TEXT_FLAG_MULTI_LINE | InputType.TYPE_TEXT_FLAG_IME_MULTI_LINE)) != 0)
+            hints |= HINT_MULTILINE;
+        return hints;
+    }
+}
