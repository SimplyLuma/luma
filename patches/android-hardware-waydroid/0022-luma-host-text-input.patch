+// SPDX-License-Identifier: Apache-2.0
+// Luma's Android input method: text fields use the host's keyboard and
+// input methods through the composer's zwp_text_input_v3 bridge.
+android_app {
+    name: "LumaInputMethod",
+    srcs: ["src/**/*.java"],
+    resource_dirs: ["res"],
+    manifest: "AndroidManifest.xml",
+    certificate: "platform",
+    privileged: true,
+    platform_apis: true,
+    system_ext_specific: true,
+}
