+int host_pointer_cursor_handler::apply_cursor(
+        waydroid_hwc_composer_device_1*, hwc_layer_1* hwc_layer, size_t) {
+    // The layer is intentionally not imported: Mutter continues presenting
+    // its host cursor. Complete Android's fence ownership exactly as the
+    // existing no-pointer path does so SurfaceFlinger cannot stall.
+    hwc_layer->releaseFenceFd = -1;
+    if (hwc_layer->acquireFenceFd != -1) {
+        close(hwc_layer->acquireFenceFd);
+    }
+    return 0;
+}
+
+int host_pointer_cursor_handler::reset_cursor(waydroid_hwc_composer_device_1*) {
+    return 0;
+}
+
+int host_pointer_cursor_handler::on_cursor_enter(display*) {
+    return 0;
+}
