@@ -59,6 +59,19 @@ class wl_cursor_cursor_handler : public cursor_handler {
     int on_cursor_enter(display *display) override;
 };
 
+// Desktop and tablet sessions already have an authoritative compositor cursor.
+// Consuming Android's cursor layer without assigning it a Wayland cursor role
+// keeps the pointer at the host theme's normal size and avoids a visible cursor
+// swap at the application boundary.
+class host_pointer_cursor_handler : public cursor_handler {
+  public:
+    int apply_cursor(waydroid_hwc_composer_device_1 *pdev,
+                     hwc_layer_1 *hwc_layer,
+                     size_t hwc_layer_index) override;
+    int reset_cursor(waydroid_hwc_composer_device_1 *pdev) override;
+    int on_cursor_enter(display *display) override;
+};
