+static void logical_position(void* data, zxdg_output_v1*, int32_t x, int32_t y) {
+    auto output = output_callbacks().acquire(data);
+    if (!output) return;
+    std::scoped_lock lock(output->owner->outputsMutex);
+    output->x = x; output->y = y;
+}
+static void logical_size(void* data, zxdg_output_v1*, int32_t width, int32_t height) {
+    auto output = output_callbacks().acquire(data);
+    if (!output) return;
+    std::scoped_lock lock(output->owner->outputsMutex);
+    output->width = width; output->height = height;
+}
+static void logical_done(void*, zxdg_output_v1*) {}
+static void logical_name(void*, zxdg_output_v1*, const char*) {}
+static void logical_description(void*, zxdg_output_v1*, const char*) {}
