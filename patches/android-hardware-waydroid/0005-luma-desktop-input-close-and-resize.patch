 constexpr hwc_color_t color_transparent = {0, 0, 0, 0};
 
+// On a desktop the person types on a hardware keyboard. Android still maps its
+// input-method window whenever a text field takes focus: a transparent layer the
+// size of the whole Android display. As a host window it took every click on
+// the monitor until Escape hid it. Android's own touchable region is not
+// visible to the compositor, so on desktop the window is not presented at all.
+static bool desktop_posture() {
+    char value[PROPERTY_VALUE_MAX] {};
+    property_get("persist.luma.device_class", value, "desktop");
+    return std::strcmp(value, "desktop") == 0;
+}
