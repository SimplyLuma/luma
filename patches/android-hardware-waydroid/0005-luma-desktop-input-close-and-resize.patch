+    // was sent, show the task's last frame at its own size, cut to the window.
+    // Stretching it distorted the app on every drag; a window that grows shows
+    // its own surface colour beside the frame until Android lays out again,
+    // as native applications do.
+    const bool resizing_ahead = !window->composed_canvas && window_layer.viewport &&
             window->android_task_width > 0 && window->android_task_height > 0 &&
+            hwc_layer->transform == 0 &&
             (window->task_resize_interactive ||
              std::chrono::steady_clock::now() < window->stretch_until);
