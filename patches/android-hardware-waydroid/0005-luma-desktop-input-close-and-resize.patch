-        const double scale = pdev->display->scale;
-        const double sx = geometry.content.width * scale / window->android_task_width;
-        const double sy = geometry.content.height * scale / window->android_task_height;
-        if (std::fabs(sx - 1.0) > 0.005 || std::fabs(sy - 1.0) > 0.005) {
