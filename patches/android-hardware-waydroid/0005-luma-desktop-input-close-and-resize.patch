-            wp_viewport_set_destination(window_layer.viewport, width, height);
-            scale_x = 1.0 / sx;
-            scale_y = 1.0 / sy;
+    if (resizing_ahead) {
+        const int visible_width = std::min(width,
+            geometry.content.x + geometry.content.width - x);
+        const int visible_height = std::min(height,
+            geometry.content.y + geometry.content.height - y);
+        if (visible_width < 1 || visible_height < 1) {
+            wp_viewport_set_source(window_layer.viewport, wl_fixed_from_int(0),
+                                   wl_fixed_from_int(0), wl_fixed_from_int(1),
+                                   wl_fixed_from_int(1));
+            wp_viewport_set_destination(window_layer.viewport, 1, 1);
+            width = height = 1;
+        } else if (visible_width < width || visible_height < height) {
+            const auto& crop = hwc_layer->sourceCropf;
+            const double fx = double(visible_width) / width;
+            const double fy = double(visible_height) / height;
+            wp_viewport_set_source(window_layer.viewport,
