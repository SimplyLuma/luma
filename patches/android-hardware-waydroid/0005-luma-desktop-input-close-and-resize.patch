--- a/hwcomposer/wayland-hwc.cpp
+++ b/hwcomposer/wayland-hwc.cpp
@@ -157,10 +157,11 @@
 // Most Android apps relaunch their activity for every new task size, and a
 // relaunch holds the task service, so forwarding each configure of a drag made
 // the window trail the pointer by seconds. During a drag nothing is sent: the
-// hardware composer stretches the app's last frame to the window instead. The
-// size a drag ends on is sent at once, and a drag that stops without ending is
-// sent after a short pause.
-constexpr auto kInteractiveResizePause = std::chrono::milliseconds(600);
+// hardware composer shows the app's last frame, unscaled and cut to the window,
+// instead. The size a drag ends on is sent at once, and a drag held still for
+// a second and a half is sent then; a shorter pause relaunched apps such as
+// TikTok mid-drag, which looked like the window refreshing every second.
+constexpr auto kInteractiveResizePause = std::chrono::milliseconds(1500);
 
 struct PendingTaskResize {
     int32_t left;
@@ -411,9 +412,20 @@
         window->fullscreen = fullscreen;
         window->content_width = content_width;
         window->content_height = content_height;
-        if (changed) {
-            const auto started = std::chrono::steady_clock::now();
+        // Drawing the title bar takes about ten milliseconds and a drag
+        // configures a hundred times a second, which left the Wayland thread
+        // no time for input or frames. During a drag draw it at most thirty
+        // times a second; the size a drag ends on is always drawn.
+        const int outer_width = prairie::frame(*window).outer.width;
+        const auto now = std::chrono::steady_clock::now();
+        const bool titlebar_due = !resizing ||
+            now - window->titlebar_drawn_at >= std::chrono::milliseconds(33);
+        if ((changed && titlebar_due) ||
+                (!resizing && window->titlebar_drawn_width != outer_width)) {
+            const auto started = now;
             prairie::redraw_titlebar(*window);
+            window->titlebar_drawn_at = started;
+            window->titlebar_drawn_width = outer_width;
             const auto titled = std::chrono::steady_clock::now();
             const bool stretched = resizing && prairie::stretch_shadow(*window);
             if (!stretched)
@@ -704,8 +716,31 @@
     requested_content_width = width;
     requested_content_height = height;
     task_resize_interactive = interactive;
+    task_resize_retries = 0;
     ALOGI("Luma task %s configured %dx%d logical (%dx%d px)%s", taskID.c_str(),
           width, height, px_width, px_height, interactive ? " while resizing" : "");
+}
+
+void window::confirm_task_size() {
+    constexpr int kMaximumRetries = 2;
+    if (task_resize_interactive || requested_content_width < 1 ||
+            requested_content_height < 1 || task_resize_retries >= kMaximumRetries ||
+            std::chrono::steady_clock::now() < stretch_until)
+        return;
+    const int px_width = luma_logical_to_px(display, requested_content_width);
+    const int px_height = luma_logical_to_px(display, requested_content_height);
+    // Within two pixels is the rounding of the fractional scale, not a miss.
+    if (std::abs(android_task_width - px_width) <= 2 &&
+            std::abs(android_task_height - px_height) <= 2)
+        return;
+    const int retries = task_resize_retries + 1;
+    ALOGI("Luma task %s drew %dx%d px, not %dx%d px; asking again (%d)", taskID.c_str(),
+          android_task_width, android_task_height, px_width, px_height, retries);
+    const int width = requested_content_width;
+    const int height = requested_content_height;
+    requested_content_width = 0;  // defeat the same-size shortcut
+    request_task_resize(width, height, false);
+    task_resize_retries = retries;
 }
 
 window::~window() {
