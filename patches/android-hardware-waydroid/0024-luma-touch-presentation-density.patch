+// The output's physical pixel density snapped to an Android bucket, so
+// Android lays out as a phone or tablet of that size; 0 for outputs that
+// report no physical size (virtual outputs).
+static int output_touch_density(const struct display *d)
+{
+    if (d->physical_width_mm <= 0 || d->physical_height_mm <= 0 ||
+        d->full_width <= 0 || d->full_height <= 0)
+        return 0;
+    const double ppi = (d->full_width * 25.4 / d->physical_width_mm +
+                        d->full_height * 25.4 / d->physical_height_mm) / 2;
+    static const int buckets[] = { 120, 140, 160, 180, 200, 213, 220, 240, 260, 280, 300,
+                                   320, 340, 360, 400, 420, 440, 480, 560, 600, 640 };
+    int density = buckets[0];
+    for (int bucket : buckets)
+        if (std::abs(bucket - ppi) < std::abs(density - ppi))
+            density = bucket;
+    return density;
+}
+
+// Touch presentations: Luma reserves its top bar or gesture strip over
+// Android (persist.luma.status_bar_px or nav_bar_px > 0). The desktop keeps
+// 180 per scale step once the first window calibrates.
+static bool touch_presentation()
+{
+    char property[PROPERTY_VALUE_MAX];
+    auto reserved = [&](const char *key) {
+        return property_get(key, property, "0") > 0 && atoi(property) > 0;
+    };
+    return reserved("persist.luma.status_bar_px") || reserved("persist.luma.nav_bar_px");
+}
