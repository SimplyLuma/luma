+// Nonblocking, one-way request: a missing host settings panel must never
+// stall Wayland input. The task HAL checks kernel credentials before parsing.
+static void request_app_settings(const window& window) {
+    using namespace luma::app_settings;
+    if (!valid_package(window.appID.data(), window.appID.size())) return;
+    Request request{};
+    request.magic = magic; request.version = version;
+    memcpy(request.package, window.appID.data(), window.appID.size());
+    const int fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+    if (fd < 0) return;
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    memcpy(address.sun_path + 1, socket_name, sizeof(socket_name) - 1);
+    const socklen_t length = offsetof(sockaddr_un, sun_path) + sizeof(socket_name);
+    if (connect(fd, reinterpret_cast<const sockaddr*>(&address), length) == 0)
+        send(fd, &request, sizeof(request), MSG_NOSIGNAL | MSG_DONTWAIT);
+    close(fd);
+}
+
