+// A separate listener keeps a slow host settings service off the resize
+// channel. Queue length, packet size and socket reads all remain bounded.
+void serveAppSettingsRequests() {
+    using namespace luma::app_settings;
+    const int server = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+    if (server < 0) return;
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    memcpy(address.sun_path + 1, socket_name, sizeof(socket_name) - 1);
+    const socklen_t length = offsetof(sockaddr_un, sun_path) + sizeof(socket_name);
+    if (bind(server, reinterpret_cast<const sockaddr*>(&address), length) != 0 ||
+            listen(server, 4) != 0) {
+        close(server); return;
+    }
+    for (;;) {
+        const int client = TEMP_FAILURE_RETRY(accept4(server, nullptr, nullptr, SOCK_CLOEXEC));
+        if (client < 0) continue;
+        ucred credentials{};
+        socklen_t size = sizeof(credentials);
+        const timeval deadline{0, 250000};
+        Request request{};
+        const bool admitted = getsockopt(client, SOL_SOCKET, SO_PEERCRED,
+                &credentials, &size) == 0 && size == sizeof(credentials) &&
+            credentials.uid == 1000 &&
+            setsockopt(client, SOL_SOCKET, SO_RCVTIMEO, &deadline, sizeof(deadline)) == 0 &&
+            TEMP_FAILURE_RETRY(recv(client, &request, sizeof(request), MSG_TRUNC)) ==
+                static_cast<ssize_t>(sizeof(request)) && valid(request);
+        close(client);
+        if (!admitted) continue;
+        const auto manager = android::defaultServiceManager();
+        if (manager == nullptr) continue;
+        const auto host = manager->checkService(android::String16("lumaappsettings"));
+        if (host == nullptr) continue;
+        android::Parcel data;
+        data.writeInterfaceToken(android::String16("org.projectluma.android.IAppSettings"));
+        data.writeString16(android::String16(request.package));
+        host->transact(1, data, nullptr, android::IBinder::FLAG_ONEWAY);
+    }
+}
+
 }  // namespace
 
