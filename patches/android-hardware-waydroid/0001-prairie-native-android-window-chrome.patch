+#pragma once
+
+#include <cstdint>
+#include <string>
+
+struct window;
+
+namespace prairie {
+
+constexpr int kTitlebarHeight = 34;
+constexpr int kControlDiameter = 18;
+constexpr int kControlAllocation = 20;
+constexpr int kControlSpacing = 2;
+constexpr int kControlInset = 10;
+constexpr int kControlHitSize = 26;
+constexpr int kWindowRadius = 13;
+constexpr int kBackButtonSize = 28;
+constexpr int kBackButtonInset = 7;
+
+enum class TitlebarTarget {
