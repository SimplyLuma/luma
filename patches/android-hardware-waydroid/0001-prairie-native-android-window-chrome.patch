+#include <fcntl.h>
+#include <linux/types.h>
+#include <poll.h>
+#include <errno.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include <libsync/sw_sync.h>
+
+namespace {
+
+struct sw_sync_create_fence_data {
+    __u32 value;
+    char name[32];
+    __s32 fence;
+};
+
+#define SW_SYNC_IOC_MAGIC 'W'
+#define SW_SYNC_IOC_CREATE_FENCE \
+    _IOWR(SW_SYNC_IOC_MAGIC, 0, struct sw_sync_create_fence_data)
+#define SW_SYNC_IOC_INC _IOW(SW_SYNC_IOC_MAGIC, 1, __u32)
+
+}  // namespace
+
+extern "C" int sync_wait(int fd, int timeout) {
+    if (fd < 0) {
+        errno = EINVAL;
+        return -1;
+    }
+
+    pollfd descriptor{.fd = fd, .events = POLLIN, .revents = 0};
+    int result;
+    do {
+        result = poll(&descriptor, 1, timeout);
+        if (result > 0) {
+            if (descriptor.revents & (POLLERR | POLLNVAL)) {
+                errno = EINVAL;
+                return -1;
+            }
+            return 0;
+        }
+        if (result == 0) {
+            errno = ETIME;
+            return -1;
+        }
+    } while (result == -1 && (errno == EINTR || errno == EAGAIN));
+    return result;
+}
+
+extern "C" int sw_sync_timeline_create(void) {
+    int fd = open("/sys/kernel/debug/sync/sw_sync", O_RDWR | O_CLOEXEC);
+    if (fd < 0)
+        fd = open("/dev/sw_sync", O_RDWR | O_CLOEXEC);
+    return fd;
+}
+
+extern "C" int sw_sync_timeline_inc(int fd, unsigned count) {
+    __u32 value = count;
+    return ioctl(fd, SW_SYNC_IOC_INC, &value);
+}
+
+extern "C" int sw_sync_fence_create(int fd, const char* name,
+                                      unsigned value) {
+    sw_sync_create_fence_data data{};
+    data.value = value;
+    strlcpy(data.name, name, sizeof(data.name));
+    if (ioctl(fd, SW_SYNC_IOC_CREATE_FENCE, &data) < 0)
+        return -1;
+    return data.fence;
+}
