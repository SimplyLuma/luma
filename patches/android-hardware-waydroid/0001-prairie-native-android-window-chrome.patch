diff --git a/hwcomposer/Android.bp b/hwcomposer/Android.bp
index f057bda..cf19d95 100644
--- a/hwcomposer/Android.bp
+++ b/hwcomposer/Android.bp
@@ -24,7 +24,6 @@ cc_library_shared {
         "libcutils",
         "libhardware",
         "libhidlbase",
-        "libsync",
         "libui",
         "libdrm",
         "libEGL",
@@ -43,6 +42,7 @@ cc_library_shared {
         "libffi",
         "libwayland_extension_client_protocols",
         "libxkbcommon",
+        "libft2.nodep",
     ],
     srcs: [
         "extension.cpp",
@@ -57,6 +57,8 @@ cc_library_shared {
         "modes/full-ui.cpp",
         "modes/multi-window.cpp",
         "modes/single-window.cpp",
+        "prairie-titlebar.cpp",
+        "sw-sync-compat.cpp",
     ],
     header_libs: [
         "libsystem_headers",
@@ -72,8 +74,23 @@ cc_library_shared {
         "-Wall",
         "-Werror",
     ],
-    generated_sources: ["wayland_android_client_protocol_sources"],
-    generated_headers: ["wayland_android_client_protocol_headers"],
+    required: ["prairie-figtree-font"],
+    generated_sources: [
+        "wayland_android_client_protocol_sources",
+        "wayland_fractional_scale_client_protocol_sources",
+    ],
+    generated_headers: [
+        "wayland_android_client_protocol_headers",
+        "wayland_fractional_scale_client_protocol_headers",
+    ],
+}
+
+prebuilt_etc {
+    name: "prairie-figtree-font",
+    src: "fonts/Figtree-VF.ttf",
+    sub_dir: "fonts",
+    filename_from_src: true,
+    vendor: true,
 }
 
 // Generate wayland-android protocol source file
@@ -92,3 +109,20 @@ genrule {
     cmd: "$(location wayland_scanner) client-header < $(in) > $(out)",
     out: ["wayland-android-client-protocol.h"],
 }
+
+// Generate the standard fractional-scale protocol used by upstream Waydroid.
+genrule {
+    name: "wayland_fractional_scale_client_protocol_sources",
+    srcs: ["fractional-scale-v1.xml"],
+    tools: ["wayland_scanner"],
+    cmd: "$(location wayland_scanner) code < $(in) > $(out)",
+    out: ["fractional-scale-v1-client-protocol.c"],
+}
+
+genrule {
+    name: "wayland_fractional_scale_client_protocol_headers",
+    srcs: ["fractional-scale-v1.xml"],
+    tools: ["wayland_scanner"],
+    cmd: "$(location wayland_scanner) client-header < $(in) > $(out)",
+    out: ["fractional-scale-v1-client-protocol.h"],
+}
