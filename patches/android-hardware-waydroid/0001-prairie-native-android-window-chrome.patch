+constexpr uint32_t kPrairieResizeMagic = 0x4c554d41;  // LUMA
+constexpr uint16_t kPrairieResizeVersion = 1;
+constexpr char kPrairieResizeSocket[] = "prairie-waydroid-task-v1";
+
+struct PrairieResizeRequest {
+    uint32_t magic;
+    uint16_t version;
+    uint16_t reserved;
+    uint32_t task_id;
+    int32_t left;
+    int32_t top;
+    int32_t right;
+    int32_t bottom;
+    int32_t resize_mode;
+};
+
+struct PrairieResizeReply {
+    uint32_t magic;
+    uint16_t version;
+    uint8_t success;
+    uint8_t reserved;
+};
+
+void servePrairieResizeRequests(const android::sp<WaydroidTask>& service) {
+    const int server = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+    if (server < 0) {
+        LOG(ERROR) << "Cannot create Prairie resize channel.";
+        return;
+    }
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    address.sun_path[0] = '\0';
+    memcpy(address.sun_path + 1, kPrairieResizeSocket,
+           sizeof(kPrairieResizeSocket) - 1);
+    const socklen_t address_length = offsetof(sockaddr_un, sun_path) +
+            sizeof(kPrairieResizeSocket);
+    if (bind(server, reinterpret_cast<const sockaddr*>(&address),
+             address_length) != 0 || listen(server, 4) != 0) {
+        LOG(ERROR) << "Cannot bind Prairie resize channel.";
+        close(server);
+        return;
+    }
+
+    for (;;) {
+        const int client = TEMP_FAILURE_RETRY(accept4(server, nullptr, nullptr,
+                SOCK_CLOEXEC));
+        if (client < 0)
+            continue;
+        ucred credentials{};
+        socklen_t credentials_length = sizeof(credentials);
+        PrairieResizeRequest request{};
+        PrairieResizeReply reply{kPrairieResizeMagic,
+                kPrairieResizeVersion, 0, 0};
+        if (getsockopt(client, SOL_SOCKET, SO_PEERCRED, &credentials,
+                       &credentials_length) == 0 &&
+                credentials.uid == 1000 &&
+                TEMP_FAILURE_RETRY(recv(client, &request, sizeof(request), 0)) ==
+                        static_cast<ssize_t>(sizeof(request)) &&
+                request.magic == kPrairieResizeMagic &&
+                request.version == kPrairieResizeVersion &&
+                request.right > request.left && request.bottom > request.top) {
+            reply.success = service->resizeTaskNative(request.task_id,
+                    request.left, request.top, request.right, request.bottom,
+                    request.resize_mode) ? 1 : 0;
+        }
+        TEMP_FAILURE_RETRY(send(client, &reply, sizeof(reply), MSG_NOSIGNAL));
+        close(client);
+    }
