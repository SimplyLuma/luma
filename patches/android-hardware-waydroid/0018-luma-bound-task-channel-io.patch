+// Bound client socket I/O so a peer cannot occupy the sole listener forever.
+// Framework resize Binder execution is separate and is not bounded by these
+// socket deadlines; the composer already uses an asynchronous resize worker.
+void handlePrairieResizeClient(const android::sp<WaydroidTask>& service, int client) {
+    ucred credentials{};
+    socklen_t credentials_length = sizeof(credentials);
+    if (getsockopt(client, SOL_SOCKET, SO_PEERCRED, &credentials,
+                   &credentials_length) != 0 ||
+            credentials_length != sizeof(credentials) || credentials.uid != 1000)
+        return;
+    const timeval timeout{0, 250000};
+    if (setsockopt(client, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) != 0 ||
+            setsockopt(client, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout)) != 0)
+        return;
+    PrairieResizeRequest request{};
+    PrairieResizeReply reply{kPrairieResizeMagic, kPrairieResizeVersion, 0, 0};
+    // MSG_TRUNC reports the full packet length rather than silently accepting
+    // a valid-looking prefix of an oversized SOCK_SEQPACKET message.
+    if (TEMP_FAILURE_RETRY(recv(client, &request, sizeof(request), MSG_TRUNC)) ==
+                    static_cast<ssize_t>(sizeof(request)) &&
+            request.magic == kPrairieResizeMagic &&
+            request.version == kPrairieResizeVersion && request.reserved == 0 &&
+            request.right > request.left && request.bottom > request.top) {
+        reply.success = service->resizeTaskNative(request.task_id,
+                request.left, request.top, request.right, request.bottom,
+                request.resize_mode) ? 1 : 0;
+    }
+    TEMP_FAILURE_RETRY(send(client, &reply, sizeof(reply), MSG_NOSIGNAL));
+}
