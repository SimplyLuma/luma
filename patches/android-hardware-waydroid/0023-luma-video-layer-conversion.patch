+    // Converts a mapped 4:2:0 video frame into the layer's XRGB shm storage.
+    // A frame that cannot be mapped or has an unknown layout is skipped.
+    bool convert_video_to_shm(buffer *buf) {
+        auto& mapper = android::GraphicBufferMapper::get();
+        android::Rect bounds(buf->metadata.width, buf->metadata.height);
+        android_ycbcr ycbcr {};
+        if (mapper.lockYCbCr(buf->handle, GRALLOC_USAGE_SW_READ_OFTEN, bounds, &ycbcr) != 0) {
+            static std::once_flag warned;
+            std::call_once(warned, [&] { ALOGW("Cannot map video buffer format 0x%x", buf->metadata.format); });
+            return false;
+        }
+        auto *y = static_cast<const uint8_t *>(ycbcr.y);
+        auto *cb = static_cast<const uint8_t *>(ycbcr.cb);
+        auto *cr = static_cast<const uint8_t *>(ycbcr.cr);
+        auto *rgb = static_cast<uint8_t *>(buf->shm_data);
+        const int width = buf->metadata.width, height = buf->metadata.height;
+        const int ystride = ycbcr.ystride, cstride = ycbcr.cstride, rgb_stride = width * 4;
+        int result = -1;
+        if (ycbcr.chroma_step == 1)
+            result = libyuv::I420ToARGB(y, ystride, cb, cstride, cr, cstride, rgb, rgb_stride, width, height);
+        else if (ycbcr.chroma_step == 2 && cr == cb + 1)
+            result = libyuv::NV12ToARGB(y, ystride, cb, cstride, rgb, rgb_stride, width, height);
+        else if (ycbcr.chroma_step == 2 && cb == cr + 1)
+            result = libyuv::NV21ToARGB(y, ystride, cr, cstride, rgb, rgb_stride, width, height);
+        mapper.unlock(buf->handle);
+        if (result != 0) {
+            static std::once_flag warned;
+            std::call_once(warned, [&] { ALOGW("Cannot convert video buffer format 0x%x (chroma step %zu)",
+                                               buf->metadata.format, ycbcr.chroma_step); });
+            return false;
+        }
+        return true;
+    }
