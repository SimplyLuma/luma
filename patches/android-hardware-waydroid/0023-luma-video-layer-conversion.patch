+// libwayland-client treats a full send buffer as fatal. While the compositor
+// is not reading (the screen waking, a modeset) frames are dropped instead of
+// queued; the frame's fences still complete so SurfaceFlinger carries on.
+static bool drop_frame_while_unwritable(waydroid_hwc_composer_device_1 *pdev,
+                                        hwc_display_contents_1_t *contents) {
+    static unsigned dropped = 0;
+    if (wl_display_flush(pdev->display->display) >= 0 || errno != EAGAIN) {
+        if (dropped) {
+            ALOGW("compositor reading again; dropped %u frames", dropped);
+            dropped = 0;
+        }
+        return false;
+    }
+    if (!dropped++)
+        ALOGW("compositor is not reading; dropping frames");
+    for (size_t l = 0; l < contents->numHwLayers; l++) {
+        auto *layer = &contents->hwLayers[l];
+        if (layer->acquireFenceFd != -1) {
+            close(layer->acquireFenceFd);
+            layer->acquireFenceFd = -1;
+        }
+        layer->releaseFenceFd = -1;
+    }
+    sw_sync_timeline_inc(pdev->timeline_fd, 1);
+    contents->retireFenceFd = sw_sync_fence_create(pdev->timeline_fd, "hwc_contents_release", ++pdev->next_sync_point);
+    return true;
+}
