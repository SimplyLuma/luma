+    void cancelRead() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        ++readGeneration_;
+        notifyLocked();
+    }
+    void shutdown() {
+        // Callers serialize shutdown. Submissions may race it safely.
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            stopping_ = true;
+            notifyLocked();
+        }
