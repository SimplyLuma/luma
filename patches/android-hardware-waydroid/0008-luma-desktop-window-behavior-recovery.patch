+// One in-process worker sleeps when idle. It never owns a Wayland object or
+// window pointer; Android task relaunch/bridge waits cannot block host input.
+luma::TaskResizeQueue& task_resize_queue() {
+    static luma::TaskResizeQueue queue([](const luma::TaskResize& size) {
+        if (!request_prairie_task_resize(size.task, size.left, size.top,
+                                        size.right, size.bottom, 1))
+            ALOGE("Task %u rejected host resize to %dx%d px", size.task,
+                  size.right - size.left, size.bottom - size.top);
+    });
+    return queue;
+}
