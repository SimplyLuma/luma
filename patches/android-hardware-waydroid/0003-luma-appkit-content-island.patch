+                FILE* file = fdopen(fd, "rb");
+                if (file) {
+                    png_image image {}; image.version = PNG_IMAGE_VERSION;
+                    if (png_image_begin_read_from_stdio(&image, file) && image.width > 0 && image.height > 0 && image.width <= 1024 && image.height <= 1024) {
