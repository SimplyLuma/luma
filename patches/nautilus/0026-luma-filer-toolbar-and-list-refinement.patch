 window.luma-files-window .nautilus-column-view .luma-details-value {
   font-weight: 600;
 }
+
+/* Filer simulator follow-up: native history group and undimmed metadata. */
+window.luma-files-window headerbar.luma-secondary-toolbar .luma-history-controls {
+  padding: 0;
+  border: 1px solid @luma_line;
+  border-radius: 10px;
+  background: transparent;
+}
+window.luma-files-window headerbar.luma-secondary-toolbar .luma-history-controls button {
+  min-width: 26px;
+  min-height: 26px;
+  padding: 0;
+  margin: 0;
+  border: none;
+  border-radius: 0;
+  box-shadow: none;
+  background: transparent;
+}
+window.luma-files-window headerbar.luma-secondary-toolbar .luma-history-controls button:first-child {
+  border-top-left-radius: 9px;
+  border-bottom-left-radius: 9px;
+}
+window.luma-files-window headerbar.luma-secondary-toolbar .luma-history-controls button:last-child {
+  border-top-right-radius: 9px;
+  border-bottom-right-radius: 9px;
+  box-shadow: -1px 0 @luma_line;
+}
+window.luma-files-window headerbar.luma-secondary-toolbar .luma-history-controls button:hover {
+  background: @luma_hover;
+}
+window.luma-files-window headerbar.luma-secondary-toolbar .luma-search-field {
+  min-width: 28px;
+  min-height: 28px;
+  padding: 0;
+  border: none;
+  box-shadow: none;
+  background: transparent;
+}
+window.luma-files-window headerbar.luma-secondary-toolbar .luma-search-field:hover,
+window.luma-files-window headerbar.luma-secondary-toolbar .luma-search-field:checked {
+  background: @luma_hover;
+}
+window.luma-files-window headerbar.luma-secondary-toolbar .luma-history-controls image,
+window.luma-files-window headerbar.luma-secondary-toolbar .luma-search-field image,
+window.luma-files-window headerbar.luma-secondary-toolbar .luma-view-mode-controls image {
+  -gtk-icon-size: 15px;
+}
+window.luma-files-window headerbar.luma-secondary-toolbar .luma-view-mode-controls button {
+  min-width: 26px;
+  min-height: 24px;
+  padding: 0;
+}
+window.luma-files-window .nautilus-list-view .nautilus-view-cell > label.dim-label {
+  opacity: 1;
+  color: @luma_muted;
+  font-family: "Figtree";
+  font-size: 11px;
+  font-weight: 500;
+}
