--- /dev/null
+++ b/src/nautilus-applications-directory.c
@@ -0,0 +1,380 @@
+/* nautilus-applications-directory.c
+ *
+ * Copyright (C) 2026 Project Luma contributors
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "nautilus-applications-directory.h"
+
+#include <gio/gdesktopappinfo.h>
+#include <glib/gi18n.h>
+
+#include "nautilus-directory-private.h"
+#include "nautilus-file-private.h"
+#include "nautilus-file-utilities.h"
+#include "nautilus-internal-place-file.h"
+#include "nautilus-scheme.h"
+
+struct _NautilusApplicationsDirectory
+{
+    NautilusDirectory parent_instance;
+
+    GList *files;
+    GList *monitor_list;
+    GAppInfoMonitor *app_monitor;
+};
+
+typedef struct
+{
+    gconstpointer client;
+} ApplicationsMonitor;
+
+G_DEFINE_TYPE_WITH_CODE (NautilusApplicationsDirectory, nautilus_applications_directory, NAUTILUS_TYPE_DIRECTORY,
+                         nautilus_ensure_extension_points ();
+                         g_io_extension_point_implement (NAUTILUS_DIRECTORY_PROVIDER_EXTENSION_POINT_NAME,
+                                                         g_define_type_id,
+                                                         NAUTILUS_APPLICATIONS_DIRECTORY_PROVIDER_NAME,
+                                                         0));
+
+static NautilusFile *
+real_new_as_file (NautilusDirectory *directory)
+{
+    return g_object_new (NAUTILUS_TYPE_INTERNAL_PLACE_FILE, "directory", directory, NULL);
+}
+
+static gboolean
+real_contains_file (NautilusDirectory *directory,
+                    NautilusFile      *file)
+{
+    return nautilus_file_get_directory (file) == directory;
+}
+
+static gboolean
+real_is_editable (NautilusDirectory *directory)
+{
+    (void) directory;
+
+    return FALSE;
+}
+
+static gboolean
+real_are_all_files_seen (NautilusDirectory *directory)
+{
+    (void) directory;
+
+    return TRUE;
+}
+
+static gboolean
+real_handles_location (GFile *location)
+{
+    return g_file_has_uri_scheme (location, SCHEME_APPLICATIONS);
+}
+
+static GList *
+real_get_file_list (NautilusDirectory *directory)
+{
+    NautilusApplicationsDirectory *self = NAUTILUS_APPLICATIONS_DIRECTORY (directory);
+
+    return nautilus_file_list_copy (self->files);
+}
+
+static void
+real_call_when_ready (NautilusDirectory         *directory,
+                      NautilusFileAttributes     file_attributes,
+                      gboolean                   wait_for_file_list,
+                      NautilusDirectoryCallback  callback,
+                      gpointer                   callback_data)
+{
+    NautilusApplicationsDirectory *self = NAUTILUS_APPLICATIONS_DIRECTORY (directory);
+    g_autolist (NautilusFile) files = nautilus_file_list_copy (self->files);
+
+    (void) file_attributes;
+    (void) wait_for_file_list;
+
+    if (callback != NULL)
+    {
+        callback (directory, files, callback_data);
+    }
+}
+
+static void
+real_cancel_callback (NautilusDirectory         *directory,
+                      NautilusDirectoryCallback  callback,
+                      gpointer                   callback_data)
+{
+    (void) directory;
+    (void) callback;
+    (void) callback_data;
+}
+
+static void
+real_file_monitor_add (NautilusDirectory         *directory,
+                       gconstpointer              client,
+                       gboolean                   monitor_hidden_files,
+                       NautilusFileAttributes     file_attributes,
+                       NautilusDirectoryCallback  callback,
+                       gpointer                   callback_data)
+{
+    NautilusApplicationsDirectory *self = NAUTILUS_APPLICATIONS_DIRECTORY (directory);
+    ApplicationsMonitor *monitor = g_new0 (ApplicationsMonitor, 1);
+
+    (void) monitor_hidden_files;
+    (void) file_attributes;
+
+    monitor->client = client;
+    self->monitor_list = g_list_prepend (self->monitor_list, monitor);
+
+    if (callback != NULL)
+    {
+        callback (directory, self->files, callback_data);
+    }
+}
+
+static void
+real_file_monitor_remove (NautilusDirectory *directory,
+                          gconstpointer      client)
+{
+    NautilusApplicationsDirectory *self = NAUTILUS_APPLICATIONS_DIRECTORY (directory);
+
+    for (GList *l = self->monitor_list; l != NULL; l = l->next)
+    {
+        ApplicationsMonitor *monitor = l->data;
+
+        if (monitor->client == client)
+        {
+            self->monitor_list = g_list_delete_link (self->monitor_list, l);
+            g_free (monitor);
+            return;
+        }
+    }
+}
+
+static void
+copy_source_dates (GFileInfo *destination,
+                   const char *desktop_filename)
+{
+    if (desktop_filename == NULL)
+    {
+        return;
+    }
+
+    g_autoptr (GFile) source = g_file_new_for_path (desktop_filename);
+    g_autoptr (GFileInfo) source_info = g_file_query_info (source,
+                                                           G_FILE_ATTRIBUTE_TIME_CREATED ","
+                                                           G_FILE_ATTRIBUTE_TIME_MODIFIED,
+                                                           G_FILE_QUERY_INFO_NONE,
+                                                           NULL,
+                                                           NULL);
+
+    if (source_info == NULL)
+    {
+        return;
+    }
+
+    if (g_file_info_has_attribute (source_info, G_FILE_ATTRIBUTE_TIME_CREATED))
+    {
+        g_file_info_set_attribute_uint64 (destination,
+                                          G_FILE_ATTRIBUTE_TIME_CREATED,
+                                          g_file_info_get_attribute_uint64 (source_info,
+                                                                            G_FILE_ATTRIBUTE_TIME_CREATED));
+    }
+
+    if (g_file_info_has_attribute (source_info, G_FILE_ATTRIBUTE_TIME_MODIFIED))
+    {
+        g_file_info_set_attribute_uint64 (destination,
+                                          G_FILE_ATTRIBUTE_TIME_MODIFIED,
+                                          g_file_info_get_attribute_uint64 (source_info,
+                                                                            G_FILE_ATTRIBUTE_TIME_MODIFIED));
+    }
+}
+
+static NautilusFile *
+file_for_application (NautilusApplicationsDirectory *self,
+                      GAppInfo                      *app_info)
+{
+    const char *id = g_app_info_get_id (app_info);
+    const char *display_name = g_app_info_get_display_name (app_info);
+    const char *description = g_app_info_get_description (app_info);
+    const char *desktop_filename = NULL;
+    GIcon *icon = g_app_info_get_icon (app_info);
+    g_autoptr (GIcon) fallback_icon = NULL;
+    g_autoptr (GFileInfo) info = NULL;
+
+    if (id == NULL || display_name == NULL)
+    {
+        return NULL;
+    }
+
+    if (G_IS_DESKTOP_APP_INFO (app_info))
+    {
+        desktop_filename = g_desktop_app_info_get_filename (G_DESKTOP_APP_INFO (app_info));
+    }
+
+    if (icon == NULL)
+    {
+        fallback_icon = g_themed_icon_new ("application-x-executable");
+        icon = fallback_icon;
+    }
+
+    info = g_file_info_new ();
+    g_file_info_set_name (info, id);
+    g_file_info_set_display_name (info, display_name);
+    g_file_info_set_edit_name (info, display_name);
+    g_file_info_set_file_type (info, G_FILE_TYPE_REGULAR);
+    g_file_info_set_content_type (info, "application/x-desktop");
+    g_file_info_set_icon (info, icon);
+    g_file_info_set_size (info, 0);
+    g_file_info_set_attribute_boolean (info, G_FILE_ATTRIBUTE_STANDARD_IS_VIRTUAL, TRUE);
+    g_file_info_set_attribute_boolean (info, G_FILE_ATTRIBUTE_ACCESS_CAN_READ, TRUE);
+    g_file_info_set_attribute_boolean (info, G_FILE_ATTRIBUTE_ACCESS_CAN_WRITE, FALSE);
+    g_file_info_set_attribute_boolean (info, G_FILE_ATTRIBUTE_ACCESS_CAN_DELETE, FALSE);
+    g_file_info_set_attribute_boolean (info, G_FILE_ATTRIBUTE_ACCESS_CAN_TRASH, FALSE);
+    g_file_info_set_attribute_boolean (info, G_FILE_ATTRIBUTE_ACCESS_CAN_RENAME, FALSE);
+    g_file_info_set_attribute_boolean (info, G_FILE_ATTRIBUTE_ACCESS_CAN_EXECUTE, FALSE);
+
+    if (description != NULL)
+    {
+        g_file_info_set_attribute_string (info, G_FILE_ATTRIBUTE_STANDARD_DESCRIPTION, description);
+    }
+
+    if (desktop_filename != NULL)
+    {
+        g_autoptr (GFile) source = g_file_new_for_path (desktop_filename);
+        g_autofree char *target_uri = g_file_get_uri (source);
+
+        g_file_info_set_attribute_string (info,
+                                          G_FILE_ATTRIBUTE_STANDARD_TARGET_URI,
+                                          target_uri);
+        copy_source_dates (info, desktop_filename);
+    }
+
+    return nautilus_file_new_from_info (NAUTILUS_DIRECTORY (self), info);
+}
+
+static void
+set_files (NautilusApplicationsDirectory *self)
+{
+    g_autolist (GAppInfo) applications = g_app_info_get_all ();
+    g_autoptr (GHashTable) seen_ids = g_hash_table_new_full (g_str_hash,
+                                                             g_str_equal,
+                                                             g_free,
+                                                             NULL);
+
+    for (GList *l = applications; l != NULL; l = l->next)
+    {
+        GAppInfo *app_info = l->data;
+        const char *id = g_app_info_get_id (app_info);
+
+        if (id == NULL ||
+            !g_app_info_should_show (app_info) ||
+            g_hash_table_contains (seen_ids, id))
+        {
+            continue;
+        }
+
+        NautilusFile *file = file_for_application (self, app_info);
+        if (file != NULL)
+        {
+            g_hash_table_add (seen_ids, g_strdup (id));
+            nautilus_directory_add_file (NAUTILUS_DIRECTORY (self), file);
+            self->files = g_list_prepend (self->files, file);
+        }
+    }
+
+    self->files = g_list_reverse (self->files);
+}
+
+static void
+real_force_reload (NautilusDirectory *directory)
+{
+    NautilusApplicationsDirectory *self = NAUTILUS_APPLICATIONS_DIRECTORY (directory);
+    g_autolist (NautilusFile) removed_files = g_steal_pointer (&self->files);
+
+    for (GList *l = removed_files; l != NULL; l = l->next)
+    {
+        nautilus_file_mark_gone (l->data);
+    }
+
+    if (removed_files != NULL)
+    {
+        nautilus_directory_emit_files_changed (directory, removed_files);
+    }
+
+    set_files (self);
+
+    if (self->files != NULL)
+    {
+        nautilus_directory_emit_files_added (directory, self->files);
+    }
+}
+
+static void
+on_applications_changed (GAppInfoMonitor              *monitor,
+                         NautilusApplicationsDirectory *self)
+{
+    (void) monitor;
+
+    real_force_reload (NAUTILUS_DIRECTORY (self));
+}
+
+static void
+nautilus_applications_directory_finalize (GObject *object)
+{
+    NautilusApplicationsDirectory *self = NAUTILUS_APPLICATIONS_DIRECTORY (object);
+
+    g_signal_handlers_disconnect_by_func (self->app_monitor,
+                                          on_applications_changed,
+                                          self);
+    g_clear_object (&self->app_monitor);
+
+    for (GList *l = self->files; l != NULL; l = l->next)
+    {
+        nautilus_file_mark_gone (l->data);
+    }
+
+    g_clear_list (&self->files, g_object_unref);
+    g_clear_list (&self->monitor_list, g_free);
+
+    G_OBJECT_CLASS (nautilus_applications_directory_parent_class)->finalize (object);
+}
+
+static void
+nautilus_applications_directory_class_init (NautilusApplicationsDirectoryClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+    NautilusDirectoryClass *directory_class = NAUTILUS_DIRECTORY_CLASS (klass);
+
+    object_class->finalize = nautilus_applications_directory_finalize;
+
+    directory_class->new_as_file = real_new_as_file;
+    directory_class->handles_location = real_handles_location;
+    directory_class->contains_file = real_contains_file;
+    directory_class->is_editable = real_is_editable;
+    directory_class->force_reload = real_force_reload;
+    directory_class->call_when_ready = real_call_when_ready;
+    directory_class->are_all_files_seen = real_are_all_files_seen;
+    directory_class->file_monitor_add = real_file_monitor_add;
+    directory_class->file_monitor_remove = real_file_monitor_remove;
+    directory_class->cancel_callback = real_cancel_callback;
+    directory_class->get_file_list = real_get_file_list;
+}
+
+NautilusApplicationsDirectory *
+nautilus_applications_directory_new (void)
+{
+    return g_object_new (NAUTILUS_TYPE_APPLICATIONS_DIRECTORY, NULL);
+}
+
+static void
+nautilus_applications_directory_init (NautilusApplicationsDirectory *self)
+{
+    self->app_monitor = g_app_info_monitor_get ();
+    g_signal_connect (self->app_monitor,
+                      "changed",
+                      G_CALLBACK (on_applications_changed),
+                      self);
+
+    set_files (self);
+}
