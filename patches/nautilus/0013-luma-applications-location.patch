+     * should veto it here. GtkDragSource always follows with drag-end. */
+    if (reason == GDK_DRAG_CANCEL_USER_CANCELLED)
+    {
+        end_shell_application_drag (source, FALSE);
+    }
+    return FALSE;
+}
