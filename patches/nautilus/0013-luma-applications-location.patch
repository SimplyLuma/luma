+static gboolean
+begin_shell_application_drag (const char *app_id)
+{
+    g_autoptr (GDBusConnection) bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+    g_autoptr (GVariant) reply = NULL;
+    gboolean accepted = FALSE;
+
+    if (bus == NULL)
+    {
+        return FALSE;
+    }
+
+    reply = g_dbus_connection_call_sync (bus,
+                                         SHELL_DBUS_NAME,
+                                         SHELL_DBUS_PATH,
+                                         SHELL_DBUS_INTERFACE,
+                                         "BeginApplicationDrag",
+                                         g_variant_new ("(s)", app_id),
+                                         G_VARIANT_TYPE ("(b)"),
+                                         G_DBUS_CALL_FLAGS_NO_AUTO_START,
+                                         500,
+                                         NULL,
+                                         NULL);
+    if (reply != NULL)
+    {
+        g_variant_get (reply, "(b)", &accepted);
+    }
+
+    return accepted;
+}
+
+static void
+end_shell_application_drag (GtkDragSource *source,
+                            gboolean       succeeded)
+{
+    const char *app_id = g_object_get_data (G_OBJECT (source), APPLICATION_DRAG_DATA_KEY);
+
+    if (app_id == NULL ||
+        GPOINTER_TO_INT (g_object_get_data (G_OBJECT (source), APPLICATION_DRAG_ENDED_KEY)))
+    {
+        return;
+    }
+
+    g_object_set_data (G_OBJECT (source), APPLICATION_DRAG_ENDED_KEY, GINT_TO_POINTER (TRUE));
+
+    g_autoptr (GDBusConnection) bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+    if (bus != NULL)
+    {
+        g_dbus_connection_call (bus,
+                                SHELL_DBUS_NAME,
+                                SHELL_DBUS_PATH,
+                                SHELL_DBUS_INTERFACE,
+                                "EndApplicationDrag",
+                                g_variant_new ("(b)", succeeded),
+                                NULL,
+                                G_DBUS_CALL_FLAGS_NO_AUTO_START,
+                                -1,
+                                NULL,
+                                NULL,
+                                NULL);
+    }
+}
+
+static gboolean
+on_item_drag_cancel (GtkDragSource       *source,
+                     GdkDrag             *drag,
