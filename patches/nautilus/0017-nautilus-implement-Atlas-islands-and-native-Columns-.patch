 src/resources/style.css                     | 164 +++-
 src/resources/ui/nautilus-view-controls.blp |  10 +
 src/resources/ui/nautilus-window.blp        | 140 +++-
 11 files changed, 1167 insertions(+), 58 deletions(-)
