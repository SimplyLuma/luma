From: Project Luma <devnull@projectluma.local>
Subject: [PATCH] chooser: use shared chrome and compact workflow controls

--- a/src/resources/ui/nautilus-file-chooser.blp
+++ b/src/resources/ui/nautilus-file-chooser.blp
@@ -5,6 +5,7 @@
   width-request: 320;
   height-request: 348;
   default-widget: accept_button;
+  accessibility { described-by: [title_widget, requester_label]; }
 
   content: $NautilusShortcutManager {
     child: Adw.ToastOverlay {
@@ -12,9 +13,18 @@
         [top]
         Adw.HeaderBar {
           show-title: false;
-          styles ["luma-titlebar", "luma-no-automatic-identity", "luma-no-command-row"]
-          [start] Label {label: _("File picker"); styles ["heading"]}
+          decoration-layout: ":close";
+          tooltip-text: bind title_widget.label;
+          styles ["luma-titlebar", "luma-no-command-row"]
           title-widget: Box {};
+          [end]
+          MenuButton choices_menu_button {
+            visible: false;
+            valign: center;
+            icon-name: "nautilus-file-chooser-options-symbolic";
+            tooltip-text: C_("File Chooser tooltips", "Show Options");
+          }
+
         }
 
         content: Box {
@@ -25,6 +35,7 @@
           Box {
             orientation: vertical;
             spacing: 8;
+            visible: bind filename_widget.visible;
             styles ["luma-island", "luma-island-quiet", "luma-chooser-purpose", "luma-controls-quiet"]
 
             Box {
@@ -47,12 +58,6 @@
                   wrap-mode: word_char;
                   styles ["dim-label"]
                 }
-              }
-              MenuButton choices_menu_button {
-                visible: false;
-                valign: start;
-                icon-name: "nautilus-file-chooser-options-symbolic";
-                tooltip-text: C_("File Chooser tooltips", "Show Options");
               }
             }
 
@@ -176,16 +181,18 @@
               label: _("_Cancel");
               use-underline: true;
               action-name: "window.close";
+              styles ["luma-button", "small"]
             }
             [accept-button]
             Button accept_button {
               label: "_Select";
               use-underline: true;
               action-name: "chooser.accept";
-              styles ["suggested-action"]
+              styles ["suggested-action", "luma-button", "small", "primary"]
             }
             [filter-dropdown]
             DropDown filters_dropdown {
+              styles ["luma-dropdown", "small"]
               valign: center;
               tooltip-text: _("Visible Files Filter");
               factory: BuilderListItemFactory {
--- a/src/resources/style.css
+++ b/src/resources/style.css
@@ -10,7 +10,7 @@
 }
 
 /* Filer uses a deliberate two-row native title composition. */
-.luma-files-window headerbar.luma-titlebar {
+.luma-files-window:not(.luma-native-file-chooser) headerbar.luma-titlebar {
   min-height: 42px;
   background-color: @luma_window;
   background-image: none;
@@ -19,12 +19,12 @@
 }
 
 @media (prefers-color-scheme: light) {
-  .luma-files-window.luma-treatment-light headerbar.luma-titlebar {
+  .luma-files-window.luma-treatment-light:not(.luma-native-file-chooser) headerbar.luma-titlebar {
     background-image: linear-gradient(to bottom, #f2f3f5, #e8eaee);
   }
 }
 
-.luma-files-window headerbar.luma-titlebar > windowhandle > box {
+.luma-files-window:not(.luma-native-file-chooser) headerbar.luma-titlebar > windowhandle > box {
   padding: 0 8px 0 12px;
 }
 
--- a/test/automated/display/test-luma-empty-picker.c
+++ b/test/automated/display/test-luma-empty-picker.c
@@ -88,9 +88,31 @@
                 g_autoptr(GFile) folder = g_file_new_for_path(empty);
                 nautilus_file_chooser_set_starting_location(chooser, folder);
                 if (save) nautilus_file_chooser_set_suggested_name(chooser, "result.png");
+                g_autoptr(GSimpleActionGroup) choices = g_simple_action_group_new();
+                g_autoptr(GSimpleAction) option = g_simple_action_new_stateful("editable", NULL, g_variant_new_boolean(TRUE));
+                g_action_map_add_action(G_ACTION_MAP(choices), G_ACTION(option));
+                g_autoptr(GMenu) choices_menu = g_menu_new();
+                g_menu_append(choices_menu, "Editable", "choices.editable");
+                nautilus_file_chooser_add_choices(chooser, G_ACTION_GROUP(choices), G_MENU_MODEL(choices_menu));
                 gtk_window_present(GTK_WINDOW(window));
                 wait_text(window, "This folder is empty");
                 wait_text(window, "0 items");
+                /* Open has no request island; Save keeps the filename and its
+                 * validation. The same options/action group stays reachable. */
+                GtkWidget *purpose = GTK_WIDGET(gtk_widget_get_template_child(window, NAUTILUS_TYPE_FILE_CHOOSER, "title_widget"));
+                GtkWidget *filename = GTK_WIDGET(gtk_widget_get_template_child(window, NAUTILUS_TYPE_FILE_CHOOSER, "filename_widget"));
+                GtkWidget *options = GTK_WIDGET(gtk_widget_get_template_child(window, NAUTILUS_TYPE_FILE_CHOOSER, "choices_menu_button"));
+                GtkWidget *accept = GTK_WIDGET(gtk_widget_get_template_child(window, NAUTILUS_TYPE_FILE_CHOOSER, "accept_button"));
+                g_assert_cmpint(gtk_widget_is_visible(purpose), ==, save);
+                g_assert_cmpint(gtk_widget_is_visible(filename), ==, save);
+                g_assert_true(gtk_widget_is_visible(options));
+                GtkWidget *header = gtk_widget_get_ancestor(options, ADW_TYPE_HEADER_BAR);
+                g_assert_nonnull(header);
+                g_assert_cmpstr(adw_header_bar_get_decoration_layout(ADW_HEADER_BAR(header)), ==, ":close");
+                g_assert_false(gtk_widget_has_css_class(header, "luma-no-automatic-identity"));
+                g_assert_true(gtk_widget_has_css_class(accept, "luma-button"));
+                g_assert_true(gtk_widget_has_css_class(accept, "small"));
+                g_assert_cmpstr(gtk_window_get_title(GTK_WINDOW(window)), ==, save ? "Save image" : "Open image");
                 /* Exercise resize after native initial geometry restoration. */
                 gtk_window_set_default_size(GTK_WINDOW(window), widths[n], 560);
                 settle();
