 }
 
 static int
@@ -623,9 +607,9 @@
     GtkWidget *scrolled_window = nautilus_list_base_get_scrolled_window (NAUTILUS_LIST_BASE (self));
 
     gtk_widget_add_css_class (GTK_WIDGET (self), "nautilus-grid-view");
-    g_signal_connect_swapped (self, "notify::width", G_CALLBACK (update_phone_layout), self);
+    g_signal_connect_object (luma_width_watch_get (GTK_WIDGET (self)), "notify::width",
