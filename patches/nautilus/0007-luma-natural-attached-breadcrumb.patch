+  .luma-files-window headerbar.luma-secondary-toolbar .nautilus-pathbar > .luma-path-menu > button image {
+    -gtk-icon-size: 10px;
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar .nautilus-pathbar:dir(rtl) > .luma-path-crumbs {
+    border-radius: 0 7px 7px 0;
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar .nautilus-pathbar:dir(rtl) > .luma-path-menu > button {
+    border-right: 1px solid var(--headerbar-shade-color);
