+/* Home, or the conform fixture's Home: where Everywhere searches. */
+static GFile *
+filer_search_home (void)
+{
+    const char *fixture_root = g_getenv ("LUMA_FILER_FIXTURE_ROOT");
+    if (fixture_root != NULL)
+    {
+        g_autofree char *fixture_home = g_build_filename (fixture_root, "Home", NULL);
+        return g_file_new_for_path (fixture_home);
+    }
+    return g_file_new_for_path (g_get_home_dir ());
+}
