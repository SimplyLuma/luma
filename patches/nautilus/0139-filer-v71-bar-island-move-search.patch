+typedef struct
+{
+    NautilusWindow *window;
+    char *where;
+    guint count;
+} FilerMoveData;
+
+static void
+filer_move_done (GHashTable *debuting_uris,
+                 gboolean    success,
+                 gpointer    callback_data)
+{
+    FilerMoveData *data = callback_data;
+    if (success && data->window != NULL)
+    {
+        g_autofree char *text = g_strdup_printf (ngettext ("Moved %u item to %s",
+                                                           "Moved %u items to %s", data->count),
+                                                 data->count, data->where);
+        adw_toast_overlay_add_toast (data->window->toast_overlay, adw_toast_new (text));
+    }
+    g_clear_weak_pointer (&data->window);
+    g_free (data->where);
+    g_free (data);
+}
+
+static void
+action_filer_move_here (GSimpleAction *action,
+                        GVariant      *parameter,
+                        gpointer       user_data)
+{
+    NautilusWindow *window = NAUTILUS_WINDOW (user_data);
+    if (window->held_files == NULL || window->active_slot == NULL)
+        return;
+    GFile *here = nautilus_window_slot_get_location (window->active_slot);
+    if (here == NULL)
+        return;
+    g_autofree char *where = g_file_get_basename (here);
+    guint count = g_list_length (window->held_files);
+    if (g_getenv ("LUMA_FILER_FIXTURE") != NULL)
+    {
+        /* Fixture mode never writes: say what would happen. */
+        g_autofree char *text = g_strdup_printf (ngettext ("Moved %u item to %s",
+                                                           "Moved %u items to %s", count),
+                                                 count, where);
+        adw_toast_overlay_add_toast (window->toast_overlay, adw_toast_new (text));
+    }
+    else
+    {
+        GList *uris = NULL;
+        for (GList *l = window->held_files; l != NULL; l = l->next)
+            uris = g_list_append (uris, g_file_get_uri (G_FILE (l->data)));
+        g_autofree char *target = g_file_get_uri (here);
+        FilerMoveData *data = g_new0 (FilerMoveData, 1);
+        g_set_weak_pointer (&data->window, window);
+        data->where = g_strdup (where);
+        data->count = count;
+        NautilusFilesView *view = nautilus_window_slot_get_current_view (window->active_slot);
+        nautilus_file_operations_copy_move (uris, target, GDK_ACTION_MOVE,
+                                            view != NULL ? GTK_WIDGET (view) : GTK_WIDGET (window),
+                                            NULL, filer_move_done, data);
+        g_list_free_full (uris, g_free);
+    }
+    filer_drop_hold (window);
+    luma_action_center_release (window->action_center);
+}
+
+static const char *
+filer_file_glyph (NautilusFile *file)
+{
+    const char *mime = nautilus_file_get_mime_type (file);
+    if (nautilus_file_is_directory (file))
+        return "folder";
+    if (mime != NULL && g_str_has_prefix (mime, "image/"))
+        return "image";
+    if (mime != NULL && g_str_has_prefix (mime, "video/"))
+        return "film";
+    if (mime != NULL && g_str_has_prefix (mime, "audio/"))
+        return "music";
+    return "file-text";
+}
