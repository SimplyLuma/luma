+/* The field says where it searches on a desktop ("Search Launch"); on a
+ * phone just "Search". The item is remade when that changes, keeping its text. */
+static void
+filer_sync_search_item (NautilusWindow *window,
+                        gboolean        phone)
+{
+    GFile *location = window->search_origin != NULL ? window->search_origin
+                      : window->active_slot != NULL ? nautilus_window_slot_get_location (window->active_slot)
+                      : NULL;
+    g_autofree char *name = location != NULL ? g_file_get_basename (location) : NULL;
+    g_autofree char *placeholder = phone || name == NULL || *name == '\0'
+                                   ? g_strdup (_("Search"))
+                                   : g_strdup_printf (_("Search %s"), name);
+    if (window->action_search_item != NULL &&
+        g_strcmp0 (placeholder, window->search_placeholder) == 0)
+        return;
+    g_autofree char *text = window->action_search_item != NULL
+                            ? g_strdup (luma_bar_item_search_get_text (window->action_search_item)) : NULL;
+    LumaBarItem *item = luma_bar_item_new_search (placeholder);
+    if (text != NULL && *text != '\0')
+        luma_bar_item_search_set_text (item, text);
+    g_signal_connect (item, "search-changed", G_CALLBACK (on_bar_search_changed), window);
+    g_clear_object (&window->action_search_item);
+    window->action_search_item = item;
+    g_free (window->search_placeholder);
+    window->search_placeholder = g_steal_pointer (&placeholder);
 }
 
