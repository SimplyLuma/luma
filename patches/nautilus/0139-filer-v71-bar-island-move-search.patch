+/* Sort by: picking the current key again flips the order; Date and Size
+ * start newest and largest first (v71 data-fsortby). */
+static void
+action_filer_sort (GSimpleAction *action,
+                   GVariant      *parameter,
+                   gpointer       user_data)
+{
+    NautilusWindow *window = NAUTILUS_WINDOW (user_data);
+    NautilusFilesView *view = window->active_slot != NULL
+                              ? nautilus_window_slot_get_current_view (window->active_slot) : NULL;
+    if (view == NULL)
+        return;
+    GActionGroup *group = nautilus_files_view_get_private_action_group (view);
+    const char *key = g_variant_get_string (parameter, NULL);
+    g_autoptr (GVariant) state = g_action_group_get_action_state (group, "sort");
+    const char *current = NULL;
+    gboolean reversed = FALSE;
+    if (state != NULL)
+        g_variant_get (state, "(&sb)", &current, &reversed);
+    gboolean next = g_strcmp0 (current, key) == 0
+                    ? !reversed
+                    : (g_strcmp0 (key, "date_modified") == 0 || g_strcmp0 (key, "size") == 0);
+    g_action_group_change_action_state (group, "sort", g_variant_new ("(sb)", key, next));
+    if (window->sort_choices != NULL)
+    {
+        if (current != NULL)
+            luma_panel_choices_set_decoration (window->sort_choices, current, NULL);
+        luma_panel_choices_set_selected (window->sort_choices, key);
+        luma_panel_choices_set_decoration (window->sort_choices, key, next ? "arrow-down" : "arrow-up");
+    }
+}
+
+/* ⋯ on a phone: how this folder looks and how it's ordered. */
+static GtkWidget *
+filer_view_sort_panel (LumaBarItem *item,
+                       gpointer     user_data)
+{
+    NautilusWindow *window = NAUTILUS_WINDOW (user_data);
+    NautilusFilesView *view = window->active_slot != NULL
+                              ? nautilus_window_slot_get_current_view (window->active_slot) : NULL;
+    guint current_view = filer_current_view_id (window);
+    const char *current_sort = NULL;
+    gboolean reversed = FALSE;
+    g_autoptr (GVariant) state = view != NULL
+                                 ? g_action_group_get_action_state (
+                                     nautilus_files_view_get_private_action_group (view), "sort")
+                                 : NULL;
+    if (state != NULL)
+        g_variant_get (state, "(&sb)", &current_sort, &reversed);
+
+    GtkWidget *panel = luma_bar_panel_new (_("View"));
+    GtkWidget *tiles = luma_bar_tiles_new (2, FALSE, FALSE);
+    luma_bar_tiles_add (tiles, "layout-grid", _("Grid"), "win.filer-view('grid')",
+                        current_view != NAUTILUS_VIEW_LIST_ID, FALSE);
+    luma_bar_tiles_add (tiles, "list", _("List"), "win.filer-view('list')",
+                        current_view == NAUTILUS_VIEW_LIST_ID, FALSE);
+    gtk_box_append (GTK_BOX (panel), tiles);
+    luma_bar_panel_add_heading (panel, _("Sort by"));
+    GtkWidget *choices = luma_panel_choices_new ("win.filer-sort");
+    luma_panel_choices_add (choices, "name", _("Name"), NULL);
+    luma_panel_choices_add (choices, "date_modified", _("Date"), NULL);
+    luma_panel_choices_add (choices, "size", _("Size"), NULL);
+    luma_panel_choices_add (choices, "type", _("Kind"), NULL);
+    if (current_sort != NULL)
+    {
+        luma_panel_choices_set_selected (choices, current_sort);
+        luma_panel_choices_set_decoration (choices, current_sort, reversed ? "arrow-down" : "arrow-up");
+    }
+    gtk_box_append (GTK_BOX (panel), choices);
+    g_set_weak_pointer (&window->sort_choices, choices);
+    return panel;
+}
