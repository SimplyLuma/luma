+static gboolean
+filer_is_place_root (GFile *location,
+                     GFile *home)
+{
+    if (g_file_equal (location, home))
+        return TRUE;
+    g_autoptr (GFile) parent = g_file_get_parent (location);
+    if (parent == NULL)
+        return TRUE;
+    const char *fixture_root = g_getenv ("LUMA_FILER_FIXTURE_ROOT");
+    if (fixture_root != NULL)
+    {
+        g_autoptr (GFile) root = g_file_new_for_path (fixture_root);
+        if (g_file_equal (parent, root))
+            return TRUE;
+    }
+    g_autoptr (GMount) mount = g_file_find_enclosing_mount (location, NULL, NULL);
+    if (mount != NULL)
+    {
+        g_autoptr (GFile) mount_root = g_mount_get_root (mount);
+        if (g_file_equal (mount_root, location))
+            return TRUE;
+    }
+    return FALSE;
 }
 
