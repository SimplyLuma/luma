+/* While typing: this folder, or Everywhere, above the field (v71 .fscope2). */
+static void
+action_filer_search_scope (GSimpleAction *action,
+                           GVariant      *parameter,
+                           gpointer       user_data)
+{
+    NautilusWindow *window = NAUTILUS_WINDOW (user_data);
+    window->search_everywhere = g_strcmp0 (g_variant_get_string (parameter, NULL), "all") == 0;
+    g_clear_handle_id (&window->action_search_timer, g_source_remove);
+    window->scope_changing = TRUE;
+    run_bar_search (window);
+    window->scope_changing = FALSE;
+}
+
+static void
+filer_sync_scope_panel (NautilusWindow *window)
+{
+    if (window->action_center == NULL || window->action_search_item == NULL)
+        return;
+    const char *grown = luma_action_center_get_grown (window->action_center);
+    const char *text = luma_bar_item_search_get_text (window->action_search_item);
+    gboolean want = filer_is_phone (window) && !window->action_bar_selected &&
+                    !luma_action_center_get_holding (window->action_center) &&
+                    text != NULL && *text != '\0';
+    if (!want)
+    {
+        if (g_strcmp0 (grown, "scope") == 0)
+            luma_action_center_grow_panel (window->action_center, "scope",
+                                           luma_bar_panel_new (NULL)); /* same key: folds */
+        return;
+    }
+    if (grown != NULL || window->scope_changing)
+        return;
+    GFile *origin = window->search_origin;
+    g_autofree char *name = origin != NULL ? g_file_get_basename (origin) : NULL;
+    GtkWidget *panel = luma_panel_choices_new ("win.filer-search-scope");
+    luma_panel_choices_add (panel, "here", name != NULL ? name : _("Here"), "folder");
+    luma_panel_choices_add (panel, "all", _("Everywhere"), "hard-drive");
+    luma_panel_choices_set_selected (panel, window->search_everywhere ? "all" : "here");
+    luma_action_center_grow_panel (window->action_center, "scope", panel);
+}
