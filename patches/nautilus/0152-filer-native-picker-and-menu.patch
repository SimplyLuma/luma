+/* Preserve native tab closing, drag/reorder, overflow and context actions;
+ * shared LumaUI owns the surrounding command-row surface. */
+static void
+on_tab_strip_revealed (AdwTabBar *tabs, GParamSpec *property, GtkWidget *strip)
+{
+    gtk_widget_set_visible (strip, adw_tab_bar_get_tabs_revealed (tabs));
+}
+
+static void
+setup_tab_strip (NautilusWindow *window)
+{
+    GtkWidget *tabs = GTK_WIDGET (window->tab_bar);
+    AdwToolbarView *host = ADW_TOOLBAR_VIEW (gtk_widget_get_ancestor (tabs, ADW_TYPE_TOOLBAR_VIEW));
+    g_return_if_fail (host != NULL);
+    g_object_ref (tabs);
+    adw_toolbar_view_remove (host, tabs);
+    GtkWidget *strip = luma_action_center_new (NULL);
+    luma_action_center_set_toolbar (LUMA_ACTION_CENTER (strip), TRUE);
+    gtk_widget_set_name (strip, "filer-tab-strip");
+    gtk_widget_set_margin_start (strip, 8);
+    gtk_widget_set_margin_end (strip, 8);
+    gtk_widget_set_margin_top (strip, 8);
+    gtk_widget_set_margin_bottom (strip, 4);
+    gtk_widget_set_hexpand (tabs, TRUE);
+    g_autoptr (LumaBarItem) native_tabs = luma_bar_item_new_widget (tabs);
+    LumaBarItem *items[] = { native_tabs };
+    luma_action_center_show_bar (LUMA_ACTION_CENTER (strip), items, G_N_ELEMENTS (items), NULL);
+    /* The tab row precedes the current-location heading, as before. */
+    g_object_ref (window->location_row);
+    adw_toolbar_view_remove (host, window->location_row);
+    adw_toolbar_view_add_top_bar (host, strip);
+    adw_toolbar_view_add_top_bar (host, window->location_row);
+    g_object_unref (window->location_row);
+    g_signal_connect_object (tabs, "notify::tabs-revealed", G_CALLBACK (on_tab_strip_revealed), strip, 0);
+    on_tab_strip_revealed (ADW_TAB_BAR (tabs), NULL, strip);
+    g_object_unref (tabs);
+}
