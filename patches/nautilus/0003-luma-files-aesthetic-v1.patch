diff --git a/src/resources/style.css b/src/resources/style.css
index 7ba5fa5..dd39067 100644
--- a/src/resources/style.css
+++ b/src/resources/style.css
@@ -1,3 +1,232 @@
+/* Files-specific composition for Project Luma.
+ *
+ * The distro-wide light palette and generic controls are owned by Luma's
+ * downstream libadwaita package. This file is intentionally limited to
+ * Nautilus structure and behavior that libadwaita cannot express globally. */
+@media (prefers-color-scheme: light) {
+  /* Files uses a deliberately defined two-row title composition. Keep this
+   * component treatment explicit so AdwToolbarView's flat top-bar state cannot
+   * erase the global Luma title gradient or its lower hairline. */
+  .luma-files-window headerbar.luma-titlebar {
+    background-color: #f2f3f5;
+    background-image: linear-gradient(to bottom, #f2f3f5, #e8eaee);
+    box-shadow: inset 0 -1px #dcdee0;
+  }
+
+  .luma-files-window .luma-window-title {
+    min-height: 18px;
+    padding-top: 1px;
+  }
+
+  /* The working controls remain native Nautilus actions in a second row. */
+  .luma-files-window headerbar.luma-secondary-toolbar {
+    min-height: 38px;
+    /* libadwaita owns the shared 10px headerbar inset. Keep only the
+     * Files-specific vertical contribution for this structural second row. */
+    padding: 3px 0;
+    background-color: var(--headerbar-bg-color);
+    background-image: none;
+    color: var(--headerbar-fg-color);
+    border: none;
+    border-bottom: 1px solid var(--headerbar-shade-color);
+    box-shadow: none;
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar > windowhandle > box {
+    padding-top: 4px;
+    padding-bottom: 2px;
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar .nautilus-pathbar {
+    min-height: 30px;
+    background-color: var(--view-bg-color);
+    background-image: none;
+    border: 1px solid var(--headerbar-shade-color);
+    border-radius: 8px;
+    box-shadow: none;
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar .nautilus-pathbar button {
+    min-height: 28px;
+    padding: 0 5px;
+    border-radius: 7px;
+    font-size: 12px;
+    font-weight: 400;
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar .nautilus-path-button {
+    margin: 1px 0;
+    padding: 0 3px;
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar .nautilus-path-button.luma-path-root {
+    margin-left: 8px;
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar .nautilus-path-button.current-dir {
+    font-weight: 600;
+    color: var(--headerbar-fg-color);
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar .nautilus-path-button:not(.current-dir) {
+    color: color-mix(in srgb, var(--headerbar-fg-color) 52%, transparent);
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar .nautilus-path-button image {
+    -gtk-icon-size: 14px;
+    color: var(--accent-color);
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar .nautilus-path-button.luma-path-root image {
+    -gtk-icon-size: 15px;
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar .luma-path-separator {
+    -gtk-icon-size: 7px;
+    margin: 0 3px;
+    color: color-mix(in srgb, var(--headerbar-fg-color) 42%, transparent);
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar .nautilus-pathbar > menubutton > button {
+    min-width: 8px;
+    padding: 0;
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar .nautilus-pathbar > menubutton > button image {
+    -gtk-icon-size: 6px;
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar .luma-search-field {
+    min-height: 30px;
+    padding: 0 10px;
+    background-color: var(--view-bg-color);
+    background-image: none;
+    border: 1px solid var(--headerbar-shade-color);
+    border-radius: 8px;
+    color: color-mix(in srgb, var(--headerbar-fg-color) 50%, transparent);
+    box-shadow: none;
+  }
+
+  .luma-files-window headerbar.luma-secondary-toolbar .luma-search-field:hover,
+  .luma-files-window headerbar.luma-secondary-toolbar .luma-search-field:checked {
+    background-color: var(--view-bg-color);
+    color: var(--headerbar-fg-color);
+    outline: 2px solid color-mix(in srgb, var(--accent-color) 35%, transparent);
+    outline-offset: -2px;
+  }
+
+  .luma-files-window .luma-search-placeholder {
+    color: color-mix(in srgb, var(--headerbar-fg-color) 50%, transparent);
+    font-size: 12px;
+    font-weight: 400;
+  }
+
+  /* Figtree's 12px ink rounds one device pixel above the optical center of
+   * these 30px controls. Move only the text atoms; icons and hit geometry are
+   * already centered and remain untouched. */
+  .luma-files-window headerbar.luma-secondary-toolbar .nautilus-path-button label,
+  .luma-files-window .luma-search-placeholder {
+    transform: translate(0, 1px);
+  }
+
+  .luma-files-window .luma-view-controls button {
+    min-width: 32px;
+    min-height: 30px;
+    padding: 0;
+  }
+
+  .luma-files-window .luma-view-controls {
+    margin-left: 3px;
+  }
+
+  .luma-files-window .luma-history-controls button {
+    min-width: 35px;
+    min-height: 30px;
+    padding: 0;
+  }
+
+  .luma-files-window .luma-history-controls button image {
+    -gtk-icon-size: 10px;
+  }
+
+  .luma-files-window .luma-view-controls button:checked {
+    background-color: color-mix(in srgb, var(--accent-bg-color) 12%, transparent);
+    color: var(--accent-color);
+  }
+
+  /* Sidebar and content are explicit sibling surfaces below the toolbars. */
+  .luma-files-window .luma-sidebar-surface,
+  .luma-files-window .luma-sidebar-surface viewport,
+  .luma-files-window .luma-sidebar-surface .navigation-sidebar {
+    background-color: var(--sidebar-bg-color);
+    color: var(--sidebar-fg-color);
+  }
+
+  .luma-files-window .luma-sidebar-surface {
+    border-right: 1px solid var(--sidebar-border-color);
+  }
+
+  /* GtkPaned reserves an invisible 8px resize target at the sidebar edge.
+   * Compensate only that structural gutter so the globally themed row still
+   * reads as having a true 10px inset from the visible divider. */
+  .luma-files-window placessidebar .navigation-sidebar > row {
+    margin-right: 2px;
+  }
+
+  .luma-files-window .luma-sidebar-surface:dir(rtl) {
+    border-right: none;
+    border-left: 1px solid var(--sidebar-border-color);
+  }
+
+  .luma-files-window .navigation-sidebar > row {
+    font-size: 13px;
+    font-weight: 400;
+  }
+
+  .luma-files-window .navigation-sidebar:not(.luma-trash-list) {
+    padding-top: 11px;
+    padding-bottom: 7px;
+  }
+
+  .luma-files-window .navigation-sidebar.luma-trash-list {
+    padding-top: 0;
+    padding-bottom: 10px;
+  }
+
+  .luma-files-window .navigation-sidebar > row image {
+    -gtk-icon-size: 14px;
+    color: color-mix(in srgb, var(--sidebar-fg-color) 50%, transparent);
+  }
+
+  .luma-files-window .navigation-sidebar > row:selected image {
+    color: var(--accent-fg-color);
+  }
+
+  .luma-files-window .navigation-sidebar separator {
+    min-height: 1px;
+    margin: 8px 16px;
+    background-color: var(--sidebar-shade-color);
+  }
+
+  .luma-files-window .luma-content-surface,
+  .luma-files-window .luma-content-surface .view,
+  .luma-files-window .luma-content-surface viewport {
+    background-color: var(--view-bg-color);
+    color: var(--view-fg-color);
+  }
+
+  .luma-files-window .luma-status-bar {
+    min-height: 27px;
+    padding: 0 16px;
+    background-color: var(--headerbar-bg-color);
+    color: color-mix(in srgb, var(--headerbar-fg-color) 50%, transparent);
+    border-top: 1px solid var(--headerbar-shade-color);
+    font-size: 11.5px;
+    font-weight: 400;
+  }
+
+}
