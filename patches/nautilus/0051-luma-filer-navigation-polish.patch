+static GtkDragSource *
+find_drag_source (GtkWidget *widget)
+{
+    g_autoptr (GListModel) controllers = gtk_widget_observe_controllers (widget);
+    for (guint i = 0; i < g_list_model_get_n_items (controllers); i++)
+    {
+        GObject *controller = g_list_model_get_item (controllers, i);
+        if (GTK_IS_DRAG_SOURCE (controller)) return GTK_DRAG_SOURCE (controller);
+        g_object_unref (controller);
+    }
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        GtkDragSource *found = find_drag_source (child);
+        if (found) return found;
+    }
+    return NULL;
+}
