+static void
+test_parent_drag (void)
+{
+    g_autofree char *parent = g_dir_make_tmp ("filer-parent-drag-XXXXXX", NULL);
+    g_autofree char *child = g_build_filename (parent, "Child", NULL);
+    g_assert_cmpint (g_mkdir (child, 0700), ==, 0);
+    g_autoptr (GFile) location = g_file_new_for_path (child);
+    g_autoptr (NautilusDirectory) directory = nautilus_directory_get (location);
+    NautilusColumnView *view = nautilus_column_view_new ();
+    g_autoptr (NautilusViewModel) model = nautilus_view_model_new (FALSE);
+    nautilus_list_base_set_model (NAUTILUS_LIST_BASE (view), model);
+    GtkWidget *window = gtk_window_new ();
+    gtk_window_set_default_size (GTK_WINDOW (window), 900, 600);
+    gtk_window_set_child (GTK_WINDOW (window), GTK_WIDGET (view));
+    nautilus_list_base_setup_directory (NAUTILUS_LIST_BASE (view), directory);
+    gtk_window_present (GTK_WINDOW (window));
+    settle_metadata ();
+    g_autoptr (GtkEventController) source = GTK_EVENT_CONTROLLER (find_drag_source (GTK_WIDGET (view)));
+    g_assert_nonnull (source);
+    g_autoptr (GdkContentProvider) provider = NULL;
+    g_signal_emit_by_name (source, "prepare", 2.0, 2.0, &provider);
+    g_assert_nonnull (provider);
+    GValue value = G_VALUE_INIT;
+    g_value_init (&value, GDK_TYPE_FILE_LIST);
+    g_assert_true (gdk_content_provider_get_value (provider, &value, NULL));
+    GSList *files = gdk_file_list_get_files (g_value_get_boxed (&value));
+    g_assert_cmpuint (g_slist_length (files), ==, 1);
+    g_assert_true (g_file_equal (files->data, location));
+    g_value_unset (&value);
+    gtk_window_destroy (GTK_WINDOW (window));
+    settle_metadata ();
+    g_rmdir (child); g_rmdir (parent);
+    g_print ("PASS: left column exports selected folder for native file drag\n");
+}
