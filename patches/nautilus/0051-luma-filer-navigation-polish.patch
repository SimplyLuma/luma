+#include <nautilus-tag-manager.h>
+#include <test-utilities.h>
+#include <glib/gstdio.h>
+
+static GtkColumnView *
+find_columns (GtkWidget *widget)
+{
+    if (GTK_IS_COLUMN_VIEW (widget))
+        return GTK_COLUMN_VIEW (widget);
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        GtkColumnView *found = find_columns (child);
+        if (found) return found;
+    }
+    return NULL;
+}
+
+static GtkColumnViewColumn *
+find_column (GtkColumnView *view, const char *name)
+{
+    GListModel *columns = gtk_column_view_get_columns (view);
+    for (guint i = 0; i < g_list_model_get_n_items (columns); i++)
+    {
+        GtkColumnViewColumn *column = g_list_model_get_item (columns, i);
+        if (g_strcmp0 (gtk_column_view_column_get_id (column), name) == 0)
+            return column;
+        g_object_unref (column);
+    }
+    g_assert_not_reached ();
+}
+
+static void
+toggle_column (GtkColumnView *view, const char *label)
+{
+    g_autoptr (GtkColumnViewColumn) name = find_column (view, "name");
+    GMenuModel *menu = gtk_column_view_column_get_header_menu (name);
+    g_assert_nonnull (menu);
+    g_assert_cmpint (g_menu_model_get_n_items (menu), >, 3);
+    for (int i = 0; i < g_menu_model_get_n_items (menu); i++)
+    {
+        g_autofree char *item_label = NULL;
+        g_autofree char *action = NULL;
+        g_menu_model_get_item_attribute (menu, i, G_MENU_ATTRIBUTE_LABEL, "s", &item_label);
+        if (g_strcmp0 (item_label, label) != 0) continue;
+        g_menu_model_get_item_attribute (menu, i, G_MENU_ATTRIBUTE_ACTION, "s", &action);
+        g_assert_true (gtk_widget_activate_action_variant (GTK_WIDGET (view), action, NULL));
+        return;
+    }
+    g_error ("Missing column menu item: %s", label);
+}
+
+static void
+settle_metadata (void)
+{
+    gint64 deadline = g_get_monotonic_time () + 500 * G_TIME_SPAN_MILLISECOND;
+    while (g_get_monotonic_time () < deadline)
+    {
+        while (g_main_context_iteration (NULL, FALSE));
+        g_usleep (1000);
+    }
+}
