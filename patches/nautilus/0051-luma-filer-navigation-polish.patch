+                            GVariant      *state,
+                            gpointer       user_data)
+{
+    NautilusListView *self = NAUTILUS_LIST_VIEW (user_data);
+    NautilusFile *file = nautilus_list_base_get_directory_as_file (NAUTILUS_LIST_BASE (self));
+    const char *name = g_object_get_data (G_OBJECT (action), "column-name");
+    g_auto (GStrv) visible = nautilus_column_get_visible_columns (file);
+    g_auto (GStrv) order = nautilus_column_get_column_order (file);
+    g_autoptr (GStrvBuilder) builder = g_strv_builder_new ();
+    g_auto (GStrv) updated = NULL;
+
+    if (g_str_equal (name, "name"))
+    {
+        return;
+    }
+
+    /* Start from the current view: metadata writes are asynchronous, so a
+     * second quick toggle must not restore the previous column selection. */
+    GListModel *columns = gtk_column_view_get_columns (self->view_ui);
+    for (guint i = 0; i < g_list_model_get_n_items (columns); i++)
+    {
+        g_autoptr (GtkColumnViewColumn) column = g_list_model_get_item (columns, i);
+        const char *id = gtk_column_view_column_get_id (column);
+        if (!g_str_equal (id, name) && gtk_column_view_column_get_visible (column))
+        {
+            g_strv_builder_add (builder, id);
+        }
+    }
+    /* Retain preferences belonging to extensions that are not loaded. */
+    for (guint i = 0; visible != NULL && visible[i] != NULL; i++)
+    {
+        gboolean known = FALSE;
+        for (guint j = 0; j < g_list_model_get_n_items (columns); j++)
+        {
+            g_autoptr (GtkColumnViewColumn) column = g_list_model_get_item (columns, j);
+            known |= g_strcmp0 (visible[i], gtk_column_view_column_get_id (column)) == 0;
+        }
+        if (!known)
+        {
+            g_strv_builder_add (builder, visible[i]);
+        }
+    }
+    if (g_variant_get_boolean (state))
+    {
+        g_strv_builder_add (builder, name);
+    }
+    updated = g_strv_builder_end (builder);
+    nautilus_column_save_metadata (file, order, updated);
+    g_simple_action_set_state (action, state);
+    apply_columns_settings (self, order, updated);
+}
+
+static void
+update_column_header_menus (NautilusListView *self)
+{
+    NautilusFile *file = nautilus_list_base_get_directory_as_file (NAUTILUS_LIST_BASE (self));
+    g_autolist (NautilusColumn) columns = nautilus_get_columns_for_file (file);
+    g_auto (GStrv) order = nautilus_column_get_column_order (file);
+    g_autoptr (GSimpleActionGroup) actions = g_simple_action_group_new ();
+    g_autoptr (GMenu) menu = g_menu_new ();
+    GListModel *view_columns = gtk_column_view_get_columns (self->view_ui);
+    guint index = 0;
+
+    columns = nautilus_sort_columns (columns, order);
+    for (GList *l = columns; l != NULL; l = l->next)
+    {
+        g_autofree char *name = NULL;
+        g_autofree char *label = NULL;
+        g_autofree char *action_name = NULL;
+        g_autofree char *detailed_action = NULL;
+        g_autoptr (GSimpleAction) action = NULL;
+        gboolean visible = FALSE;
+
+        g_object_get (l->data, "name", &name, "label", &label, NULL);
+        /* Luma deliberately omits the separate star column. */
+        if (g_str_equal (name, "starred"))
+        {
+            continue;
+        }
+        for (guint i = 0; i < g_list_model_get_n_items (view_columns); i++)
+        {
+            g_autoptr (GtkColumnViewColumn) column = g_list_model_get_item (view_columns, i);
+            if (g_strcmp0 (gtk_column_view_column_get_id (column), name) == 0)
+            {
+                visible = gtk_column_view_column_get_visible (column);
+                break;
+            }
+        }
+
+        /* Numeric action IDs also accommodate extension-defined column names. */
+        action_name = g_strdup_printf ("column-%u", index++);
+        detailed_action = g_strconcat ("header-columns.", action_name, NULL);
+        action = g_simple_action_new_stateful (action_name, NULL,
+                                              g_variant_new_boolean (visible));
+        g_object_set_data_full (G_OBJECT (action), "column-name", g_strdup (name), g_free);
+        g_simple_action_set_enabled (action, !g_str_equal (name, "name"));
+        g_signal_connect_object (action, "change-state",
+                                 G_CALLBACK (column_header_change_state), self, 0);
+        g_action_map_add_action (G_ACTION_MAP (actions), G_ACTION (action));
+        g_menu_append (menu, label, detailed_action);
+    }
+
+    gtk_widget_insert_action_group (GTK_WIDGET (self->view_ui), "header-columns",
+                                    G_ACTION_GROUP (actions));
+    for (guint i = 0; i < g_list_model_get_n_items (view_columns); i++)
+    {
+        g_autoptr (GtkColumnViewColumn) column = g_list_model_get_item (view_columns, i);
+        gtk_column_view_column_set_header_menu (column, G_MENU_MODEL (menu));
     }
 }
 
