+static void
+test_sidebar_customization (void)
+{
+    GtkWidget *window = gtk_window_new ();
+    NautilusSidebar *sidebar = NAUTILUS_PLACES_SIDEBAR (nautilus_sidebar_new ());
+    gtk_window_set_child (GTK_WINDOW (window), GTK_WIDGET (sidebar));
+    gtk_window_set_default_size (GTK_WINDOW (window), 280, 900);
+    gtk_window_present (GTK_WINDOW (window));
+    settle_metadata ();
+    g_autoptr (GFile) documents = g_file_new_for_path (g_get_user_special_dir (G_USER_DIRECTORY_DOCUMENTS));
+    g_autofree char *uri = g_file_get_uri (documents);
+    GtkWidget *row = find_row (GTK_WIDGET (sidebar), uri);
+    g_assert_nonnull (row);
+    int original = gtk_list_box_row_get_index (GTK_LIST_BOX_ROW (row));
+    nautilus_sidebar_set_location (sidebar, documents);
+    g_assert_true (send_menu_key (GTK_WIDGET (sidebar)));
+    g_assert_true (gtk_widget_activate_action (GTK_WIDGET (sidebar), "row.move-up", NULL));
+    g_assert_cmpint (gtk_list_box_row_get_index (GTK_LIST_BOX_ROW (row)), ==, original - 1);
+    g_auto (GStrv) order = g_settings_get_strv (nautilus_preferences, "sidebar-favorites-order");
+    g_assert_cmpstr (order[0], ==, uri);
+    g_assert_true (gtk_widget_activate_action (GTK_WIDGET (sidebar), "row.remove", NULL));
+    g_assert_null (find_row (GTK_WIDGET (sidebar), uri));
+    g_assert_true (g_file_query_exists (documents, NULL));
+    NautilusBookmarkList *bookmarks = nautilus_application_get_bookmarks (NAUTILUS_APPLICATION (g_application_get_default ()));
+    g_assert_true (nautilus_bookmark_list_can_favorite (bookmarks, documents));
+    nautilus_bookmark_list_add_favorite (bookmarks, documents);
+    g_assert_nonnull (find_row (GTK_WIDGET (sidebar), uri));
+    g_assert_false (nautilus_bookmark_list_can_favorite (bookmarks, documents));
+    gtk_window_destroy (GTK_WINDOW (window));
+    g_autoptr (NautilusSidebar) reopened = NAUTILUS_PLACES_SIDEBAR (nautilus_sidebar_new ());
+    g_object_ref_sink (reopened);
+    row = find_row (GTK_WIDGET (reopened), uri);
+    g_assert_cmpint (gtk_list_box_row_get_index (GTK_LIST_BOX_ROW (row)), ==, original - 1);
+    g_settings_reset (nautilus_preferences, "sidebar-favorites-order");
+    g_print ("PASS: Favorites reorder persists, remove keeps folder, add restores shortcut\n");
+}
