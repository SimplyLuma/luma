+static GtkWidget *
+sidebar_neighbor (GtkWidget *row, gboolean down)
+{
+    NautilusSidebarSectionType section;
+    g_object_get (row, "section-type", &section, NULL);
+    for (GtkWidget *next = down ? gtk_widget_get_next_sibling (row) : gtk_widget_get_prev_sibling (row);
+         next; next = down ? gtk_widget_get_next_sibling (next) : gtk_widget_get_prev_sibling (next))
+    {
+        if (!NAUTILUS_IS_SIDEBAR_ROW (next)) continue;
+        NautilusSidebarSectionType other;
+        g_object_get (next, "section-type", &other, NULL);
+        if (sidebar_category (section) != sidebar_category (other)) return NULL;
+        g_autofree char *id = sidebar_row_id (next);
+        if (id != NULL && gtk_widget_get_visible (next)) return next;
+    }
+    return NULL;
+}
