+static NautilusSidebarSectionType
+sidebar_category (NautilusSidebarSectionType section)
+{
+    return section == NAUTILUS_SIDEBAR_SECTION_BOOKMARKS ?
+           NAUTILUS_SIDEBAR_SECTION_FAVORITES : section;
+}
+
+static const char *
+sidebar_order_key (NautilusSidebarSectionType section)
+{
+    switch (sidebar_category (section))
+    {
+        case NAUTILUS_SIDEBAR_SECTION_DEFAULT_LOCATIONS: return "sidebar-places-order";
+        case NAUTILUS_SIDEBAR_SECTION_FAVORITES: return "sidebar-favorites-order";
+        case NAUTILUS_SIDEBAR_SECTION_MOUNTS: return "sidebar-devices-order";
+        case NAUTILUS_SIDEBAR_SECTION_CLOUD: return "sidebar-cloud-order";
+        default: return NULL;
+    }
+}
+
+static char *
+sidebar_row_id (GtkWidget *row)
+{
+    char *uri = NULL;
+    g_autoptr (GVolume) volume = NULL;
+    g_autoptr (GDrive) drive = NULL;
+    g_object_get (row, "uri", &uri, "volume", &volume, "drive", &drive, NULL);
+    if (uri != NULL) return uri;
+    if (volume != NULL)
+    {
+        g_autofree char *uuid = g_volume_get_identifier (volume, G_VOLUME_IDENTIFIER_KIND_UUID);
+        if (uuid != NULL) return g_strconcat ("volume:", uuid, NULL);
+        g_autofree char *device = g_volume_get_identifier (volume, G_VOLUME_IDENTIFIER_KIND_UNIX_DEVICE);
+        if (device != NULL) return g_strconcat ("device:", device, NULL);
+    }
+    if (drive != NULL)
+    {
+        g_autofree char *device = g_drive_get_identifier (drive, G_VOLUME_IDENTIFIER_KIND_UNIX_DEVICE);
+        if (device != NULL) return g_strconcat ("drive:", device, NULL);
+    }
+    return NULL;
+}
+
+static int
+sidebar_saved_position (const char * const *order, const char *id)
+{
+    for (int i = 0; order[i] != NULL; i++)
+        if (g_strcmp0 (order[i], id) == 0) return i;
+    return G_MAXINT;
+}
+
+static gboolean
+sidebar_reorder (NautilusSidebar *sidebar, GtkWidget *source, GtkWidget *target, gboolean after)
+{
+    NautilusSidebarSectionType from, to;
+    g_object_get (source, "section-type", &from, NULL);
+    g_object_get (target, "section-type", &to, NULL);
+    const char *key = sidebar_order_key (from);
+    g_autofree char *source_id = sidebar_row_id (source);
+    g_autofree char *target_id = sidebar_row_id (target);
+    if (key == NULL || sidebar_category (from) != sidebar_category (to) ||
+        source_id == NULL || target_id == NULL || source == target) return FALSE;
+
+    g_autoptr (GPtrArray) order = g_ptr_array_new_with_free_func (g_free);
+    for (GtkWidget *row = gtk_widget_get_first_child (sidebar->list_box); row;
+         row = gtk_widget_get_next_sibling (row))
+    {
+        if (!NAUTILUS_IS_SIDEBAR_ROW (row)) continue;
+        NautilusSidebarSectionType section;
+        g_object_get (row, "section-type", &section, NULL);
+        if (sidebar_category (section) != sidebar_category (from) || row == source) continue;
+        g_autofree char *id = sidebar_row_id (row);
+        if (id == NULL) continue;
+        if (row == target && !after) g_ptr_array_add (order, g_strdup (source_id));
+        g_ptr_array_add (order, g_strdup (id));
+        if (row == target && after) g_ptr_array_add (order, g_strdup (source_id));
+    }
+    /* Remember disconnected devices and temporarily unavailable cloud accounts. */
+    g_auto (GStrv) previous = g_settings_get_strv (nautilus_preferences, key);
+    for (guint i = 0; previous[i] != NULL; i++)
+    {
+        gboolean found = FALSE;
+        for (guint j = 0; j < order->len; j++)
+            found |= g_str_equal (previous[i], g_ptr_array_index (order, j));
+        if (!found) g_ptr_array_add (order, g_strdup (previous[i]));
+    }
+    g_ptr_array_add (order, NULL);
+    return g_settings_set_strv (nautilus_preferences, key, (const char * const *) order->pdata);
+}
