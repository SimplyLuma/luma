+/* Presentation guidance, never a permission boundary. Keep personal and
+ * removable storage outside the warning even when it lives under /var. */
+static gboolean
+is_system_location (GFile *location)
+{
+    const char *paths[] = { "/usr", "/etc", "/boot", "/bin", "/sbin", "/lib",
+        "/lib64", "/opt", "/sys", "/proc", "/dev", "/var/lib", "/var/cache",
+        "/var/log", "/ostree", NULL };
+    if (location == NULL || !g_file_is_native (location)) return FALSE;
+    g_autofree char *path = g_file_get_path (location);
+    if (g_strcmp0 (path, "/") == 0 || g_strcmp0 (path, "/var") == 0) return TRUE;
+    for (guint i = 0; paths[i] != NULL; i++)
+    {
+        g_autoptr (GFile) system = g_file_new_for_path (paths[i]);
+        if (g_file_equal (location, system) || g_file_has_prefix (location, system)) return TRUE;
+    }
+    return FALSE;
+}
