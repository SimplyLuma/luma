+/* Use the same file-list transfer format as the current-location view.
+ * Read the bound item at drag time because GtkListItem rows are recycled. */
+static GdkContentProvider *
+prepare_parent_drag (GtkDragSource *source,
+                     double         x,
+                     double         y,
+                     GtkListItem   *list_item)
+{
+    NautilusFile *file = gtk_list_item_get_item (list_item);
+    g_autoptr (GFile) location = file != NULL ? nautilus_file_get_location (file) : NULL;
+    GdkFileList *files;
+    GdkContentProvider *provider;
+
+    if (location == NULL)
+    {
+        return NULL;
+    }
+    GdkDragAction actions = GDK_ACTION_COPY | GDK_ACTION_LINK;
+    if (nautilus_file_can_delete (file)) actions |= GDK_ACTION_MOVE;
+    gtk_drag_source_set_actions (source, actions);
+    g_autoptr (GdkPaintable) icon = nautilus_file_get_icon_paintable (file, 32, 1, NAUTILUS_FILE_ICON_FLAGS_NONE);
+    gtk_drag_source_set_icon (source, icon, 0, 0);
+    files = gdk_file_list_new_from_array (&location, 1);
+    provider = gdk_content_provider_new_typed (GDK_TYPE_FILE_LIST, files);
+    g_boxed_free (GDK_TYPE_FILE_LIST, files);
+    return provider;
+}
+
+static void
+parent_action (GSimpleAction *action, GVariant *parameter, gpointer data)
+{
+    GtkListItem *list_item = data;
+    NautilusFile *file = gtk_list_item_get_item (list_item);
+    if (file == NULL) return;
+    g_autoptr (GFile) location = nautilus_file_get_location (file);
+    GtkWidget *row = gtk_list_item_get_child (list_item);
+    const char *name = g_action_get_name (G_ACTION (action));
+    if (g_str_equal (name, "favorite"))
+    {
+        if (nautilus_file_is_directory (file))
+            nautilus_bookmark_list_add_favorite (
+                nautilus_application_get_bookmarks (nautilus_application_get_default ()), location);
+    }
+    else if (g_str_equal (name, "properties"))
+    {
+        GList files = { .data = file };
+        nautilus_properties_present_dialog (&files, row);
+    }
+    else if (g_str_equal (name, "new-tab"))
+    {
+        nautilus_application_open_location_full (nautilus_application_get_default (), location,
+                                                 NAUTILUS_OPEN_FLAG_NEW_TAB, NULL, NULL);
+    }
+    else
+    {
+        g_autofree char *uri = g_file_get_uri (location);
+        gtk_widget_activate_action (row, "slot.open-location", "s", uri);
+    }
+}
