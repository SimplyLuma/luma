+static void
+test_details_selection (void)
+{
+    g_autoptr (NautilusColumnView) view = nautilus_column_view_new ();
+    g_object_ref_sink (view);
+    GtkWidget *details = find_details (GTK_WIDGET (view));
+    g_assert_nonnull (details);
+    g_assert_false (gtk_widget_is_visible (details));
+    g_autoptr (NautilusViewModel) model = nautilus_view_model_new (FALSE);
+    nautilus_list_base_set_model (NAUTILUS_LIST_BASE (view), model);
+    g_autoptr (GFile) location = g_file_new_for_path (g_get_tmp_dir ());
+    g_autoptr (NautilusFile) file = nautilus_file_get (location);
+    g_autoptr (NautilusViewItem) item = nautilus_view_item_new (file);
+    nautilus_view_model_add_item (model, item);
+    g_assert_false (gtk_widget_is_visible (details));
+    gtk_selection_model_select_item (GTK_SELECTION_MODEL (model), 0, TRUE);
+    g_assert_true (gtk_widget_is_visible (details));
+    gtk_selection_model_unselect_all (GTK_SELECTION_MODEL (model));
+    g_assert_false (gtk_widget_is_visible (details));
+    gtk_selection_model_select_item (GTK_SELECTION_MODEL (model), 0, TRUE);
+    nautilus_view_model_remove_all_items (model);
+    g_assert_false (gtk_widget_is_visible (details));
+    g_print ("PASS: Details appears on selection and collapses on clear/removal\n");
+}
