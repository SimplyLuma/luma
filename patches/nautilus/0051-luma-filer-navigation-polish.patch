+static void
+test_header_columns (void)
+{
+    g_autofree char *path = g_dir_make_tmp ("filer-header-test-XXXXXX", NULL);
+    g_autoptr (GFile) location = g_file_new_for_path (path);
+    g_autoptr (NautilusDirectory) directory = nautilus_directory_get (location);
+    g_autoptr (NautilusFile) file = nautilus_directory_get_corresponding_file (directory);
+    char *initial[] = { "name", "size", "date_modified", NULL };
+    nautilus_column_save_metadata (file, initial, initial);
+    settle_metadata ();
+
+    g_autoptr (NautilusListView) first = nautilus_list_view_new ();
+    g_object_ref_sink (first);
+    nautilus_list_base_setup_directory (NAUTILUS_LIST_BASE (first), directory);
+    GtkColumnView *view = find_columns (GTK_WIDGET (first));
+    g_assert_nonnull (view);
+    g_autoptr (GtkColumnViewColumn) size = find_column (view, "size");
+    g_autoptr (GtkColumnViewColumn) name = find_column (view, "name");
+    g_autoptr (GtkColumnViewColumn) modified = find_column (view, "date_modified");
+    g_assert_true (gtk_column_view_column_get_visible (size));
+    toggle_column (view, "Size");
+    g_assert_false (gtk_column_view_column_get_visible (size));
+    settle_metadata ();
+    g_auto (GStrv) saved = nautilus_column_get_visible_columns (file);
+    g_assert_false (g_strv_contains ((const char * const *) saved, "size"));
+    g_assert_true (gtk_column_view_column_get_visible (modified));
+    g_assert_true (gtk_column_view_column_get_visible (name));
+    g_auto (GStrv) order = nautilus_column_get_column_order (file);
+    g_assert_cmpstrv (order, initial);
+
+    g_autoptr (NautilusListView) reopened = nautilus_list_view_new ();
+    g_object_ref_sink (reopened);
+    nautilus_list_base_setup_directory (NAUTILUS_LIST_BASE (reopened), directory);
+    GtkColumnView *second = find_columns (GTK_WIDGET (reopened));
+    g_autoptr (GtkColumnViewColumn) second_size = find_column (second, "size");
+    g_assert_false (gtk_column_view_column_get_visible (second_size));
+    toggle_column (second, "Size");
+    g_assert_true (gtk_column_view_column_get_visible (second_size));
+    g_assert_nonnull (gtk_column_view_column_get_header_menu (modified));
+    nautilus_column_save_metadata (file, NULL, NULL);
+    g_assert_true (g_file_delete (location, NULL, NULL));
+}
