+/* Default favorites are preferences; custom ones remain GTK bookmarks. */
+static gboolean
+is_default_favorite (GFile *location)
+{
+    const GUserDirectory directories[] = {
+        G_USER_DIRECTORY_DESKTOP, G_USER_DIRECTORY_DOCUMENTS,
+        G_USER_DIRECTORY_DOWNLOAD, G_USER_DIRECTORY_MUSIC,
+        G_USER_DIRECTORY_PICTURES, G_USER_DIRECTORY_VIDEOS
+    };
+    for (guint i = 0; i < G_N_ELEMENTS (directories); i++)
+    {
+        const char *path = g_get_user_special_dir (directories[i]);
+        if (path == NULL || g_str_equal (path, g_get_home_dir ())) continue;
+        g_autoptr (GFile) folder = g_file_new_for_path (path);
+        if (g_file_equal (location, folder)) return TRUE;
+    }
+    return FALSE;
+}
+
+gboolean
+nautilus_bookmark_list_can_favorite (NautilusBookmarkList *self, GFile *location)
+{
+    if (is_default_favorite (location))
+    {
+        g_autofree char *uri = g_file_get_uri (location);
+        g_auto (GStrv) hidden = g_settings_get_strv (nautilus_preferences, "hidden-default-favorites");
+        return g_strv_contains ((const char * const *) hidden, uri);
+    }
+    return nautilus_bookmark_list_can_bookmark (self, location);
+}
+
+void
+nautilus_bookmark_list_add_favorite (NautilusBookmarkList *self, GFile *location)
+{
+    if (is_default_favorite (location))
+    {
+        g_autofree char *uri = g_file_get_uri (location);
+        g_auto (GStrv) hidden = g_settings_get_strv (nautilus_preferences, "hidden-default-favorites");
+        g_autoptr (GStrvBuilder) builder = g_strv_builder_new ();
+        for (guint i = 0; hidden[i] != NULL; i++)
+            if (!g_str_equal (hidden[i], uri)) g_strv_builder_add (builder, hidden[i]);
+        g_auto (GStrv) updated = g_strv_builder_end (builder);
+        g_settings_set_strv (nautilus_preferences, "hidden-default-favorites", (const char * const *) updated);
+    }
+    else if (nautilus_bookmark_list_can_bookmark (self, location))
+    {
+        nautilus_bookmark_list_add (self, location, -1);
+    }
+}
