 static gboolean
+can_add_favorite (GList *selection)
+{
+    NautilusBookmarkList *bookmarks = nautilus_application_get_bookmarks (NAUTILUS_APPLICATION (g_application_get_default ()));
+    if (selection == NULL || selection->next != NULL ||
+        !nautilus_file_is_directory (selection->data)) return FALSE;
+    g_autoptr (GFile) location = nautilus_file_get_activation_location (selection->data);
+    return location != NULL && nautilus_bookmark_list_can_favorite (bookmarks, location);
+}
