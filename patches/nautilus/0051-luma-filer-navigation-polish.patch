+static void
+action_add_favorite (GSimpleAction *action, GVariant *parameter, gpointer user_data)
+{
+    g_autolist (NautilusFile) selection = nautilus_files_view_get_selection (user_data);
+    if (!can_add_favorite (selection)) return;
+    g_autoptr (GFile) location = nautilus_file_get_activation_location (selection->data);
+    nautilus_bookmark_list_add_favorite (
+        nautilus_application_get_bookmarks (NAUTILUS_APPLICATION (g_application_get_default ())), location);
+}
