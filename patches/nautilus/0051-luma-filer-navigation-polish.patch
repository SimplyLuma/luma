+static GtkWidget *
+find_details (GtkWidget *widget)
+{
+    if (gtk_widget_has_css_class (widget, "luma-details-island")) return widget;
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        GtkWidget *found = find_details (child);
+        if (found) return found;
+    }
+    return NULL;
+}
