diff --git a/src/nautilus-window-slot.c b/src/nautilus-window-slot.c
--- a/src/nautilus-window-slot.c
+++ b/src/nautilus-window-slot.c
@@ -146,6 +146,7 @@
     GCancellable *mount_cancellable;
     GError *mount_error;
     gboolean tried_mount;
+    gboolean root_warning_bypass;
     guint default_view_id;
 
     /* Menus */
@@ -173,6 +174,74 @@
 static void nautilus_window_slot_update_extra_location_widgets (NautilusWindowSlot *self);
 static void create_and_bind_new_content_view (NautilusWindowSlot *self,
                                               guint               view_id);
+
+typedef struct
+{
+    NautilusWindowSlot *slot;
+    GFile *location;
+    NautilusFileList *selection;
+} RootWarningRequest;
+
+static void
+root_warning_request_free (RootWarningRequest *request)
+{
+    g_clear_object (&request->slot);
+    g_clear_object (&request->location);
+    g_clear_list (&request->selection, g_object_unref);
+    g_free (request);
+}
+
+static void
+on_root_warning_response (GObject      *source,
+                          GAsyncResult *result,
+                          gpointer      user_data)
+{
+    RootWarningRequest *request = user_data;
+    const char *response =
+        adw_alert_dialog_choose_finish (ADW_ALERT_DIALOG (source), result);
+
+    if (g_strcmp0 (response, "continue") == 0)
+    {
+        request->slot->root_warning_bypass = TRUE;
+        nautilus_window_slot_open_location_full (request->slot,
+                                                 request->location,
+                                                 request->selection);
+    }
+
+    root_warning_request_free (request);
+}
+
+static void
+show_root_warning (NautilusWindowSlot *self,
+                   GFile              *location,
+                   NautilusFileList   *selection)
+{
+    RootWarningRequest *request = g_new0 (RootWarningRequest, 1);
+    AdwAlertDialog *dialog = ADW_ALERT_DIALOG (
+        adw_alert_dialog_new (_("You’ve reached the system root"),
+                              _("These are the files Prairie itself runs on. Moving, editing, or deleting anything here can keep your computer from starting up — and it’s hard to undo. If you’re not sure you need to be here, you probably don’t.")));
+    GtkWidget *icon = gtk_image_new_from_icon_name ("security-high-symbolic");
+
+    gtk_image_set_pixel_size (GTK_IMAGE (icon), 32);
+    adw_alert_dialog_set_extra_child (dialog, icon);
+    adw_alert_dialog_add_responses (dialog,
+                                    "back", _("Take me back"),
+                                    "continue", _("I understand — continue"),
+                                    NULL);
+    adw_alert_dialog_set_default_response (dialog, "back");
+    adw_alert_dialog_set_close_response (dialog, "back");
+    adw_alert_dialog_set_response_appearance (dialog, "back", ADW_RESPONSE_SUGGESTED);
+
+    request->slot = g_object_ref (self);
+    request->location = g_object_ref (location);
+    request->selection = g_list_copy_deep (selection, (GCopyFunc) g_object_ref, NULL);
+
+    adw_alert_dialog_choose (dialog,
+                             GTK_WIDGET (self),
+                             NULL,
+                             on_root_warning_response,
+                             request);
+}
 static void nautilus_window_slot_update_for_new_location (NautilusWindowSlot *self);
 static void apply_pending_location_and_selection_on_view (NautilusWindowSlot *self);
 static void nautilus_window_slot_set_loading (NautilusWindowSlot *self,
@@ -1431,6 +1500,20 @@
                                          NautilusFileList   *new_selection)
 {
     GFile *old_location = nautilus_window_slot_get_location (self);
+    g_autoptr (GFile) root = g_file_new_for_path ("/");
+
+    if (g_settings_get_boolean (nautilus_preferences,
+                                NAUTILUS_PREFERENCES_PERSONAL_STORAGE_ONLY) &&
+        g_file_equal (location, root))
+    {
+        if (!self->root_warning_bypass)
+        {
+            show_root_warning (self, location, new_selection);
+            return;
+        }
+
+        self->root_warning_bypass = FALSE;
+    }
 
     nautilus_window_slot_set_search_global (self, FALSE);
 
