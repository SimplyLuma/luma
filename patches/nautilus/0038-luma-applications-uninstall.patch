+static void
+on_application_uninstall_requested (GObject *source, GAsyncResult *result, gpointer data)
+{
+    g_autoptr (NautilusFilesView) self = data;
+    g_autoptr (GError) error = NULL;
+    g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+    if (error != NULL)
+    {
+        nautilus_show_ok_dialog (_("Unable to open Install"), error->message,
+                                 gtk_widget_get_root (GTK_WIDGET (self)) ? GTK_WIDGET (self) : NULL);
+    }
+}
+
+static void
+action_uninstall_application (GSimpleAction *action, GVariant *state, gpointer user_data)
+{
+    NautilusFilesView *self = NAUTILUS_FILES_VIEW (user_data);
+    g_autolist (NautilusFile) selection = nautilus_files_view_get_selection (self);
+    g_autofree char *identity = NULL;
+    GDBusConnection *connection;
+
+    if (selection == NULL || selection->next != NULL ||
+        !nautilus_file_is_in_applications (selection->data))
+    {
+        return;
+    }
+    identity = g_strdup (nautilus_file_get_name (selection->data));
+    connection = g_application_get_dbus_connection (g_application_get_default ());
+    g_dbus_connection_call (connection, "org.projectluma.ApplicationInstaller2",
+                            "/org/projectluma/ApplicationInstaller2",
+                            "org.projectluma.ApplicationInstaller2", "RequestUninstall",
+                            g_variant_new ("(s)", identity), NULL,
+                            G_DBUS_CALL_FLAGS_NONE, 10000, NULL,
+                            on_application_uninstall_requested, g_object_ref (self));
+}
+
