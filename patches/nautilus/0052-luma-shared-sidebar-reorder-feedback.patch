+/* Resolve once by stable geometry; both the line and drop use this contract. */
+static gboolean
+resolve_sidebar_insertion (NautilusSidebar *sidebar, const GValue *value,
+                            double x, double y, GtkListBoxRow **row, gboolean *after)
+{
+    *row = gtk_list_box_get_row_at_y (GTK_LIST_BOX (sidebar->list_box), y);
+    if (value == NULL || !G_VALUE_HOLDS (value, NAUTILUS_TYPE_SIDEBAR_ROW) ||
+        !check_valid_drop_target (sidebar, NAUTILUS_SIDEBAR_ROW (*row), value))
+        return FALSE;
+    graphene_point_t point;
+    if (!gtk_widget_compute_point (sidebar->list_box, GTK_WIDGET (*row),
+                                    &GRAPHENE_POINT_INIT (x, y), &point))
+        return FALSE;
+    *after = luma_reorder_hint_is_after (GTK_WIDGET (*row), point.y);
+    return TRUE;
 }
 
