+static void
+test_sidebar_drop_position (void)
+{
+    GtkWidget *window = gtk_window_new ();
+    GtkWidget *sidebar = nautilus_sidebar_new ();
+    gtk_window_set_child (GTK_WINDOW (window), sidebar);
+    gtk_window_set_default_size (GTK_WINDOW (window), 280, 900);
+    gtk_window_present (GTK_WINDOW (window));
+    settle_metadata ();
+    g_autoptr (GFile) documents = g_file_new_for_path (g_get_user_special_dir (G_USER_DIRECTORY_DOCUMENTS));
+    g_autoptr (GFile) music = g_file_new_for_path (g_get_user_special_dir (G_USER_DIRECTORY_MUSIC));
+    g_autoptr (GFile) home = g_file_new_for_path (g_get_home_dir ());
+    g_autofree char *documents_uri = g_file_get_uri (documents);
+    g_autofree char *music_uri = g_file_get_uri (music);
+    g_autofree char *home_uri = g_file_get_uri (home);
+    GtkWidget *source = find_row (sidebar, documents_uri);
+    GtkWidget *destination = find_row (sidebar, music_uri);
+    GtkWidget *list = gtk_widget_get_parent (source);
+    g_autoptr (GListModel) controllers = gtk_widget_observe_controllers (list);
+    g_autoptr (GObject) drop = NULL;
+    for (guint i = 0; i < g_list_model_get_n_items (controllers); i++)
+    {
+        g_autoptr (GObject) item = g_list_model_get_item (controllers, i);
+        if (GTK_IS_DROP_TARGET (item)) { drop = g_object_ref (item); break; }
+    }
+    g_assert_nonnull (drop);
+    GValue value = G_VALUE_INIT;
+    g_value_init (&value, NAUTILUS_TYPE_SIDEBAR_ROW);
+    g_value_set_object (&value, source);
+    for (guint after = 0; after < 2; after++)
+    {
+        graphene_point_t point;
+        double y = gtk_widget_get_height (destination) * (after ? .75 : .25);
+        g_assert_true (gtk_widget_compute_point (destination, list,
+                       &GRAPHENE_POINT_INIT (10, y), &point));
+        gboolean accepted = FALSE;
+        g_signal_emit_by_name (drop, "drop", &value, (double) point.x, (double) point.y, &accepted);
+        g_assert_true (accepted);
+        int first = gtk_list_box_row_get_index (GTK_LIST_BOX_ROW (source));
+        int second = gtk_list_box_row_get_index (GTK_LIST_BOX_ROW (destination));
+        g_assert_cmpint (first, ==, second + (after ? 1 : -1));
+        settle_metadata ();
+    }
+    g_auto (GStrv) order = g_settings_get_strv (nautilus_preferences, "sidebar-favorites-order");
+    GtkWidget *other_category = find_row (sidebar, home_uri);
+    graphene_point_t point;
+    g_assert_true (gtk_widget_compute_point (other_category, list,
+                   &GRAPHENE_POINT_INIT (10, 10), &point));
+    gboolean accepted = TRUE;
+    g_signal_emit_by_name (drop, "drop", &value, (double) point.x, (double) point.y, &accepted);
+    g_assert_false (accepted);
+    g_auto (GStrv) unchanged = g_settings_get_strv (nautilus_preferences, "sidebar-favorites-order");
+    g_assert_cmpstrv (unchanged, order);
+    g_value_unset (&value);
+    gtk_window_destroy (GTK_WINDOW (window));
+    g_settings_reset (nautilus_preferences, "sidebar-favorites-order");
+    g_print ("PASS: native drops resolve before/after and reject cross-category moves\n");
+}
