     nautilus_dbus_launcher_create_proxy (self->data[NAUTILUS_DBUS_LAUNCHER_CONSOLE],
-                                         "org.gnome.Ptyxis", "/org/gnome/Ptyxis",
+                                         "org.projectluma.Terminal", "/org/projectluma/Terminal",
                                          "org.freedesktop.Application");
 }
diff --git a/src/nautilus-files-view.c b/src/nautilus-files-view.c
--- a/src/nautilus-files-view.c
+++ b/src/nautilus-files-view.c
@@ -2509,6 +2509,25 @@
     nautilus_files_view_new_folder (NAUTILUS_FILES_VIEW (user_data), TRUE);
 }
 
+/* A terminal opens a local directory, never a document or a remote URI. */
+static GFile *
+terminal_directory (NautilusFile *file)
+{
+    if (file == NULL)
+        return NULL;
+    g_autoptr (GFile) location = nautilus_file_get_location (file);
+    if (!g_file_is_native (location) || nautilus_file_is_in_trash (file))
+        return NULL;
+    return nautilus_file_is_directory (file) ? g_steal_pointer (&location) : g_file_get_parent (location);
+}
+
+static gboolean
+can_open_terminal (NautilusFile *file)
+{
+    g_autoptr (GFile) directory = terminal_directory (file);
+    return directory != NULL;
+}
+
 static void
 real_open_console (NautilusFile      *file,
                    NautilusFilesView *view)
@@ -2517,7 +2536,10 @@
     GVariant *parameters;
     g_autofree gchar *uri = NULL;
 
-    uri = nautilus_file_get_uri (file);
+    g_autoptr (GFile) directory = terminal_directory (file);
+    if (directory == NULL)
+        return;
+    uri = g_file_get_uri (directory);
     parameters = g_variant_new_parsed ("([%s], @a{sv} {})", uri);
     nautilus_dbus_launcher_call (nautilus_dbus_launcher_get (),
                                  NAUTILUS_DBUS_LAUNCHER_CONSOLE,
@@ -7966,13 +7988,13 @@
                                          "console");
     g_simple_action_set_enabled (G_SIMPLE_ACTION (action),
                                  mode == NAUTILUS_MODE_BROWSE &&
-                                 list_len_is_one (selection) && nautilus_file_is_directory (selection->data) &&
+                                 list_len_is_one (selection) && can_open_terminal (selection->data) &&
                                  nautilus_dbus_launcher_is_available (nautilus_dbus_launcher_get (),
