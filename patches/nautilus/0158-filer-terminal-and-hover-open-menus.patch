                                             "hidden-when",
-                                            !item_opens_in_view ? "action-missing" : NULL);
+                                            NULL);
+    nautilus_g_menu_replace_string_in_item (G_MENU (object), i, "label",
+                                            item_opens_in_view ? _("Open") : _("Open With"));
 
