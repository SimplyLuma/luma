-        }
-        else
-        {
-            object = gtk_builder_get_object (builder, "open-with-application-section");
-            i = nautilus_g_menu_model_find_by_string (G_MENU_MODEL (object),
-                                                      "nautilus-menu-item",
-                                                      "open_with_in_main_menu");
-            g_menu_remove (G_MENU (object), i);
-        }
