+typedef struct {GObject parent_instance;} PreviewSlowIcon;
+typedef GObjectClass PreviewSlowIconClass;
+static GType preview_slow_icon_get_type(void);
+static guint slow_icon_hash(GIcon *icon){return g_direct_hash(icon);}
