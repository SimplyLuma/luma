+
+static void
+applications_ready (GObject *source_object, GAsyncResult *result, gpointer user_data)
+{
+    NautilusApplicationsDirectory *self = NAUTILUS_APPLICATIONS_DIRECTORY (source_object);
+    NautilusDirectory *directory = NAUTILUS_DIRECTORY (self);
+    g_autoptr (GPtrArray) infos = g_task_propagate_pointer (G_TASK (result), NULL);
+    g_autolist (NautilusFile) removed = g_steal_pointer (&self->files);
+    (void) user_data;
+    for (GList *l = removed; l != NULL; l = l->next)
+        nautilus_file_mark_gone (l->data);
+    if (removed != NULL)
+        nautilus_directory_emit_files_changed (directory, removed);
+    for (guint i = 0; i < infos->len; i++)
+    {
+        NautilusFile *file = nautilus_file_new_from_info (directory, g_ptr_array_index (infos, i));
+        nautilus_directory_add_file (directory, file);
+        self->files = g_list_prepend (self->files, file);
+    }
     self->files = g_list_reverse (self->files);
+    self->loading = FALSE;
+    self->loaded = TRUE;
+    if (self->files != NULL)
+        nautilus_directory_emit_files_added (directory, self->files);
+    nautilus_directory_emit_done_loading (directory);
+    /* A callback may reenter/cancel another callback. Remove each entry from
+     * the live queue before invoking it, so cancellation still works. */
+    while (self->ready_callbacks != NULL && !self->loading)
+    {
+        GList *entry = self->ready_callbacks;
+        ApplicationsReady *ready = entry->data;
+        self->ready_callbacks = g_list_delete_link (self->ready_callbacks, entry);
+        g_autolist (NautilusFile) files = nautilus_file_list_copy (self->files);
+        ready->callback (directory, files, ready->data);
+        g_free (ready);
+    }
+    if (self->reload_pending)
+    {
+        self->reload_pending = FALSE;
+        start_loading (self);
+    }
+}
+
+static void
+start_loading (NautilusApplicationsDirectory *self)
+{
+    if (self->loading)
+    {
+        self->reload_pending = TRUE;
+        return;
+    }
+    self->loading = TRUE;
+    g_autoptr (GTask) task = g_task_new (self, NULL, applications_ready, NULL);
+    g_task_run_in_thread (task, scan_applications);
 }
 
