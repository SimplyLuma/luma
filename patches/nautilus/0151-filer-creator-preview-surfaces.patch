+static void slow_icon_iface(GIconIface *iface){iface->hash=slow_icon_hash;iface->equal=slow_icon_equal;}
+static GInputStream *slow_icon_load(GLoadableIcon *icon,int size,char **type,GCancellable *cancellable,GError **error)
+{
+    (void)icon;(void)size;(void)cancellable;(void)error;
+    g_usleep(250000);
+    if(type)*type=g_strdup("image/svg+xml");
+    const char *svg="<svg xmlns='http://www.w3.org/2000/svg' width='64' height='64'><rect width='64' height='64' fill='#ff0000'/></svg>";
+    return g_memory_input_stream_new_from_data(g_strdup(svg),strlen(svg),g_free);
+}
+static void slow_loadable_iface(GLoadableIconIface *iface){iface->load=slow_icon_load;}
