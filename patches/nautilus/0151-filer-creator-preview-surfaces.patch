+/* File-backed application icons may start an image-loader sandbox. Never
+ * perform that I/O or decoding while GtkGridView binds a scrolling cell.
+ * The existing bounded icon cache shares this paintable while it loads. */
+typedef struct
+{
+    GObject parent_instance;
+    GLoadableIcon *icon;
+    GdkPaintable *fallback;
+    GdkTexture *texture;
+    int size;
+    int scale;
+} NautilusLoadablePaintable;
+typedef GObjectClass NautilusLoadablePaintableClass;
+static GType nautilus_loadable_paintable_get_type (void);
+static void loadable_paintable_iface_init (GdkPaintableInterface *iface);
+G_DEFINE_TYPE_WITH_CODE (NautilusLoadablePaintable, nautilus_loadable_paintable, G_TYPE_OBJECT,
+                         G_IMPLEMENT_INTERFACE (GDK_TYPE_PAINTABLE, loadable_paintable_iface_init))
+
+static void
+loadable_paintable_snapshot (GdkPaintable *paintable, GdkSnapshot *snapshot,
+                             double width, double height)
+{
+    NautilusLoadablePaintable *self = (NautilusLoadablePaintable *) paintable;
+    if (self->texture == NULL)
+    {
+        gdk_paintable_snapshot (self->fallback, snapshot, width, height);
+        return;
+    }
+    double tw = gdk_texture_get_width (self->texture);
+    double th = gdk_texture_get_height (self->texture);
+    double factor = MIN (width / tw, height / th);
+    graphene_rect_t bounds = GRAPHENE_RECT_INIT ((width - tw * factor) / 2,
+                                                (height - th * factor) / 2,
+                                                tw * factor, th * factor);
+    gtk_snapshot_append_texture (GTK_SNAPSHOT (snapshot), self->texture, &bounds);
+}
+
+static int
+loadable_paintable_size (GdkPaintable *paintable)
+{
+    return ((NautilusLoadablePaintable *) paintable)->size;
+}
+
+static double
+loadable_paintable_ratio (GdkPaintable *paintable)
+{
+    (void) paintable;
+    return 1;
+}
+
+static GdkPaintableFlags
+loadable_paintable_flags (GdkPaintable *paintable)
+{
+    (void) paintable;
+    return GDK_PAINTABLE_STATIC_SIZE;
+}
+
+static void
+loadable_paintable_iface_init (GdkPaintableInterface *iface)
+{
+    iface->snapshot = loadable_paintable_snapshot;
+    iface->get_intrinsic_width = loadable_paintable_size;
+    iface->get_intrinsic_height = loadable_paintable_size;
+    iface->get_intrinsic_aspect_ratio = loadable_paintable_ratio;
+    iface->get_flags = loadable_paintable_flags;
+}
+
+static void
+nautilus_loadable_paintable_finalize (GObject *object)
+{
+    NautilusLoadablePaintable *self = (NautilusLoadablePaintable *) object;
+    g_clear_object (&self->icon);
+    g_clear_object (&self->fallback);
+    g_clear_object (&self->texture);
+    G_OBJECT_CLASS (nautilus_loadable_paintable_parent_class)->finalize (object);
+}
+
+static void
+nautilus_loadable_paintable_class_init (NautilusLoadablePaintableClass *klass)
+{
+    klass->finalize = nautilus_loadable_paintable_finalize;
+}
+
+static void
+nautilus_loadable_paintable_init (NautilusLoadablePaintable *self)
+{
+    (void) self;
+}
+
+static void
+loadable_paintable_decode (GTask *task, gpointer source_object,
+                           gpointer task_data, GCancellable *cancellable)
+{
+    NautilusLoadablePaintable *self = source_object;
+    g_autoptr (GError) error = NULL;
+    g_autoptr (GInputStream) stream = g_loadable_icon_load (self->icon,
+        self->size * self->scale, NULL, cancellable, &error);
+    (void) task_data;
+    if (stream != NULL)
+    {
+        g_autoptr (GlyLoader) loader = gly_loader_new_for_stream (stream);
+        g_autoptr (GlyImage) image = gly_loader_load (loader, &error);
+        if (image != NULL)
+        {
+            g_autoptr (GlyFrameRequest) request = gly_frame_request_new ();
+            gly_frame_request_set_scale (request, self->size * self->scale, self->size * self->scale);
+            g_autoptr (GlyFrame) frame = gly_image_get_specific_frame (image, request, &error);
+            if (frame != NULL)
+            {
+                g_task_return_pointer (task, gly_gtk_frame_get_texture (frame), g_object_unref);
+                return;
+            }
+        }
+    }
+    if (error != NULL)
+        g_task_return_error (task, g_steal_pointer (&error));
+    else
+        g_task_return_pointer (task, NULL, NULL);
+}
+
+static void
+loadable_paintable_ready (GObject *source_object, GAsyncResult *result, gpointer user_data)
+{
+    NautilusLoadablePaintable *self = (NautilusLoadablePaintable *) source_object;
+    (void) user_data;
+    g_autoptr (GError) error = NULL;
+    self->texture = g_task_propagate_pointer (G_TASK (result), &error);
+    if (error != NULL)
+        g_debug ("Could not load application icon: %s", error->message);
+    gdk_paintable_invalidate_contents (GDK_PAINTABLE (self));
+}
+
+static GdkPaintable *
+loadable_paintable_new (GLoadableIcon *icon, int size, int scale)
+{
+    NautilusLoadablePaintable *self = g_object_new (nautilus_loadable_paintable_get_type (), NULL);
+    g_autoptr (NautilusIconInfo) fallback = nautilus_icon_info_get_fallback (size, scale);
+    self->icon = g_object_ref (icon);
+    self->fallback = nautilus_icon_info_get_paintable (fallback);
+    self->size = size;
+    self->scale = scale;
+    g_autoptr (GTask) task = g_task_new (self, NULL, loadable_paintable_ready, NULL);
+    g_task_run_in_thread (task, loadable_paintable_decode);
+    return GDK_PAINTABLE (self);
+}
