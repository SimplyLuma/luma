+
+/* ── Corrections from the design review ──────────────────────────────────
+ *
+ * Every rule here carries `window.` before the window class, so it holds
+ * wherever it lands in the sheet rather than depending on being the last rule
+ * of equal weight. They sit outside the light-mode block: Filer is read in
+ * both treatments and every value here is a token, not a colour. */
+
+/* The sidebar's list owns a 6px inset, and a section heading's text begins on
+ * the same left edge as a row's icon — 6 + 8 in both cases. Measured from
+ * different origins, the headings sat inboard of the rows they caption. */
+window.luma-files-window .navigation-sidebar:not(.luma-trash-list) {
+  padding: 6px;
+}
+
+window.luma-files-window .navigation-sidebar > row {
+  margin: 0;
+  padding: 0 8px;
+  min-height: 32px;
+  border-radius: 10px;
+}
+
+window.luma-files-window .luma-sidebar-section-heading {
+  padding: 4px 8px 0;
+  color: alpha(currentColor, 0.46);
+}
+
+/* Back and forward are quiet until looked for, and grey out rather than
+ * vanish: a control that disappears makes the toolbar jump. */
+window.luma-files-window .luma-history-controls button {
+  min-width: 28px;
+  min-height: 28px;
+  padding: 0;
+  background: none;
+  background-color: transparent;
+  border: none;
+  color: @luma_muted;
+  box-shadow: none;
+}
+
+window.luma-files-window .luma-history-controls button:hover {
+  background-color: @luma_hover;
+  color: @luma_ink;
+}
+
+window.luma-files-window .luma-history-controls button:disabled {
+  opacity: 0.38;
+}
+
+window.luma-files-window .luma-history-controls button image {
+  -gtk-icon-size: 14px;
+}
+
+/* Search is an icon, not a field dressed as a button. */
+window.luma-files-window .luma-search-field {
+  min-width: 28px;
+  min-height: 28px;
+  padding: 0;
+  background: none;
+  background-color: transparent;
+  border: none;
+  color: @luma_muted;
+  box-shadow: none;
+}
+
+window.luma-files-window .luma-search-field:hover,
+window.luma-files-window .luma-search-field:checked {
+  background-color: @luma_hover;
+  color: @luma_ink;
+  outline: none;
+}
+
+/* The three pickers are one segment: every corner rounded, not just the pair
+ * at the leading end, and the chosen one is ink so its glyph reads against it.
+ * It was drawing ink on ink, which is the blank block. */
+window.luma-files-window .luma-view-mode-controls {
+  padding: 2px;
+  border-radius: 10px;
+  background-color: alpha(@luma_ink, 0.04);
+  box-shadow: none;
+}
+
+window.luma-files-window .luma-view-controls button,
+window.luma-files-window .luma-view-mode-controls button {
+  min-width: 28px;
+  min-height: 26px;
+  padding: 0;
+  border: none;
+  border-radius: 8px;
+  background: none;
+  background-color: transparent;
+  color: @luma_muted;
+  box-shadow: none;
+}
+
+window.luma-files-window .luma-view-controls button:hover,
+window.luma-files-window .luma-view-mode-controls button:hover {
+  background-color: @luma_hover;
+  color: @luma_ink;
+}
+
+window.luma-files-window .luma-view-controls button:checked,
+window.luma-files-window .luma-view-mode-controls button:checked {
+  background-color: @luma_ink;
+  color: @luma_content;
+}
+
+window.luma-files-window .luma-view-controls button image,
+window.luma-files-window .luma-view-mode-controls button image {
+  -gtk-icon-size: 15px;
+}
+
+/* The breadcrumb is text on the toolbar, not a boxed control. */
+window.luma-files-window .nautilus-pathbar {
+  min-height: 24px;
+  background: none;
+  background-color: transparent;
+  border: none;
+  box-shadow: none;
+}
+
+window.luma-files-window .nautilus-path-button {
+  min-height: 24px;
+  margin: 0;
+  padding: 0 6px;
+  border-radius: 10px;
+  background: none;
+  background-color: transparent;
+  box-shadow: none;
+  font-size: 13px;
+  font-weight: 550;
+}
+
+window.luma-files-window .nautilus-path-button:hover {
+  background-color: @luma_hover;
+}
+
+window.luma-files-window .nautilus-path-button:not(.current-dir) {
+  color: @luma_muted;
+}
+
+window.luma-files-window .nautilus-path-button.current-dir {
+  color: @luma_ink;
+  font-weight: 700;
+}
+
+/* Figtree needed a one-pixel nudge at 12px inside the old boxed pathbar. At
+ * 13px on a flat toolbar it does not, and the nudge reads as misalignment. */
+window.luma-files-window .nautilus-path-button label {
+  transform: none;
+}
+
+/* The root crumb drew a folder mark in front of "Home". The breadcrumb is
+ * text; the mark was the one thing in it that was not. */
+window.luma-files-window .nautilus-path-button image {
+  -gtk-icon-size: 0;
+  min-width: 0;
+  margin: 0;
+}
+
+/* A column is an island in its own right: a lighter wash than the pane behind
+ * it, its own corner, and a flatter shadow than the window's lift. It had a
+ * minimum width and nothing else, so three columns read as one surface with
+ * gutters cut into it. */
+window.luma-files-window .nautilus-column-view .luma-column-island {
+  border-radius: 10px;
+  background-color: alpha(@luma_ink, 0.035);
+  box-shadow: inset 0 0 0 1px @luma_line,
+              0 1px 2px alpha(@luma_window, 0.07);
+}
+
+/* Rows are 32px and take the shared 10px corner in every view. */
+window.luma-files-window .nautilus-column-view listview > row,
+window.luma-files-window .nautilus-list-view columnview > listview > row {
+  min-height: 32px;
+  border-radius: 10px;
+}
+
+/* Hover and focus render identically, as everywhere else in Luma. An accent
+ * ring on top of the fill is a second visual language for one state. */
+window.luma-files-window .nautilus-column-view listview > row:focus-visible,
+window.luma-files-window .nautilus-list-view columnview > listview > row:focus-visible,
+window.luma-files-window .nautilus-grid-view gridview > child:focus-visible {
+  background-color: @luma_hover;
+  outline: none;
+}
+
+/* A tile's name and caption take the design's label and meta steps. */
+window.luma-files-window .nautilus-grid-view .icon-ui-labels-box > label:not(.caption) {
+  font-size: 11px;
+  font-weight: 650;
+}
+
+window.luma-files-window .nautilus-grid-view .icon-ui-labels-box > label.caption {
+  font-size: 9px;
+}
