diff --git a/src/nautilus-sidebar.c b/src/nautilus-sidebar.c
index d1dc09f..8d38b7b 100644
--- a/src/nautilus-sidebar.c
+++ b/src/nautilus-sidebar.c
@@ -812,6 +812,18 @@ update_places (NautilusSidebar *sidebar)
     }
 #endif
 
+    /* The root filesystem is not exposed by every GVolumeMonitor backend,
+     * especially inside virtual machines. Represent it as a real local place
+     * so the hardware section is always present; removable and optical media
+     * continue to come from the live GDrive/GVolume/GMount pipeline below. */
+    start_icon = g_themed_icon_new_with_default_fallbacks ("drive-harddisk-symbolic");
+    add_place (sidebar, NAUTILUS_SIDEBAR_ROW_BUILT_IN,
+               NAUTILUS_SIDEBAR_SECTION_MOUNTS,
+               _("System Disk"), start_icon, NULL, "file:///",
+               NULL, NULL, NULL, NULL, 0,
+               _("Open the system disk"));
+    g_object_unref (start_icon);
+
     /* go through all connected drives */
     drives = g_volume_monitor_get_connected_drives (sidebar->volume_monitor);
 
