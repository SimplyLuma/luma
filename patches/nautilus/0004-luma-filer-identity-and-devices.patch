diff --git a/src/resources/style.css b/src/resources/style.css
index decca3c..242b6bf 100644
--- a/src/resources/style.css
+++ b/src/resources/style.css
@@ -122,6 +122,29 @@
     padding: 0;
   }
 
+  /* History, view, and main-menu actions are one secondary-control family.
+   * Keep their neutral material identical; checked view modes alone carry the
+   * blue selection treatment below. */
+  .luma-files-window .luma-history-controls button,
+  .luma-files-window .luma-view-controls button,
+  .luma-files-window .luma-main-menu > button {
+    background-color: var(--view-bg-color);
+    background-image: none;
+    color: var(--headerbar-fg-color);
+    box-shadow: inset 0 0 0 1px var(--headerbar-shade-color);
+  }
+
+  .luma-files-window .luma-main-menu > button {
+    min-width: 32px;
+    min-height: 30px;
+    padding: 0;
+    border-radius: 8px;
+  }
+
+  .luma-files-window .luma-main-menu > button image {
+    -gtk-icon-size: 14px;
+  }
+
   .luma-files-window .luma-view-controls {
     margin-left: 3px;
   }
