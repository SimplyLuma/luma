--- a/test/automated/meson.build
+++ b/test/automated/meson.build
@@ -26,3 +26,9 @@
 if get_option('tests') == 'all'
   subdir('display')
 endif
+
+# Native About mutations use the same library and resources as the application.
+about_test = executable('test-properties-about', 'test-properties-about.c',
+  dependencies: [libnautilus_dep, libtestutils_dep])
+test('test-properties-about', about_test, env: test_env,
+  suite: ['display'], is_parallel: false, timeout: 120)
--- /dev/null
+++ b/test/automated/test-properties-about.c
@@ -0,0 +1,124 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include <adwaita.h>
+#include <glib/gstdio.h>
+#include <sys/stat.h>
+#include "nautilus-application.h"
+#include "nautilus-properties.h"
+#include "nautilus-file.h"
+#include "nautilus-tag-manager.h"
+#include "nautilus-resources.h"
+
+static void spin (guint milliseconds)
+{
+    gint64 end=g_get_monotonic_time()+milliseconds*1000;
+    do {while(g_main_context_iteration(NULL,FALSE));g_usleep(1000);} while(g_get_monotonic_time()<end);
+}
+static GtkWidget *find (GtkWidget *root,const char *id)
+{
+    if(GTK_IS_BUILDABLE(root) && !g_strcmp0(gtk_buildable_get_buildable_id(GTK_BUILDABLE(root)),id))return root;
+    for(GtkWidget *c=gtk_widget_get_first_child(root);c;c=gtk_widget_get_next_sibling(c))
+    {GtkWidget *r=find(c,id);if(r)return r;}
+    return NULL;
+}
+static GtkWidget *required (GtkWidget *root,const char *id)
+{GtkWidget *w=find(root,id);g_assert_nonnull(w);return w;}
+static void click (GtkWidget *root,const char *id)
+{g_signal_emit_by_name(required(root,id),"clicked");spin(50);}
+static guint32 mode (const char *path)
+{struct stat s;g_assert_cmpint(g_stat(path,&s),==,0);return s.st_mode&07777;}
+static GtkWindow *open_paths (const char *first,const char *second)
+{
+    GList *files=NULL;
+    g_autoptr(GFile) loc=g_file_new_for_path(first);
+    NautilusFile *file=nautilus_file_get(loc);files=g_list_append(files,file);
+    if(second){g_autoptr(GFile) next=g_file_new_for_path(second);files=g_list_append(files,nautilus_file_get(next));}
+    GtkWindow *window=nautilus_properties_present_window(files,NULL);
+    g_list_free_full(files,g_object_unref);
+    for(guint i=0;i<200;i++){spin(20);GtkWidget *name=find(GTK_WIDGET(window),"name_value_label");if(name && *gtk_label_get_text(GTK_LABEL(name)))return window;}
+    g_error("About window did not finish loading");return NULL;
+}
+static void begin_permissions(GtkWidget *w)
+{adw_expander_row_set_expanded(ADW_EXPANDER_ROW(required(w,"access_expander")),TRUE);spin(50);g_signal_emit_by_name(required(w,"permissions_navigation_row"),"activated");spin(30);g_assert_true(gtk_widget_get_visible(required(w,"permissions_editor")));}
+static void fixture(void)
+{
+    g_autofree char *dir=g_dir_make_tmp("luma-about-test-XXXXXX",NULL);
+    g_autofree char *file=g_build_filename(dir,"build.sh",NULL);
+    g_autofree char *renamed=g_build_filename(dir,"renamed.sh",NULL);
+    g_autofree char *conflict=g_build_filename(dir,"occupied.sh",NULL);
+    g_assert_true(g_file_set_contents(file,"#!/bin/sh\n",-1,NULL));g_assert_cmpint(g_chmod(file,02641),==,0);
+    g_assert_true(g_file_set_contents(conflict,"keep",-1,NULL));
+    GtkWindow *window=open_paths(file,NULL);GtkWidget *w=GTK_WIDGET(window);
+    g_assert_cmpstr(gtk_window_get_title(window),==,"About build.sh");
+    g_assert_false(gtk_widget_get_visible(required(w,"preview_box")));
+    g_assert_false(gtk_widget_get_visible(required(w,"profile_fact")));
+    g_assert_false(gtk_widget_get_visible(required(w,"permissions_editor")));
+    begin_permissions(w);
+    struct stat initial; g_assert_cmpint(g_stat(file,&initial),==,0);
+    const char *ownership_rows[]={"owner_row","group_row"};
+    for(guint r=0;r<2;r++) {
+        AdwComboRow *row=ADW_COMBO_ROW(required(w,ownership_rows[r]));
+        GListModel *model=adw_combo_row_get_model(row); guint original=adw_combo_row_get_selected(row);
+        if(model && g_list_model_get_n_items(model)>1 && original!=GTK_INVALID_LIST_POSITION) {
+            adw_combo_row_set_selected(row,(original+1)%g_list_model_get_n_items(model));
+            adw_combo_row_set_selected(row,original);
+        }
+    }
+    click(w,"permission_apply");spin(200);
+    struct stat reverted;g_assert_cmpint(g_stat(file,&reverted),==,0);
+    g_assert_cmpuint(reverted.st_uid,==,initial.st_uid);g_assert_cmpuint(reverted.st_gid,==,initial.st_gid);
+    begin_permissions(w);
+    GtkCheckButton *group=GTK_CHECK_BUTTON(required(w,"group_exec"));
+    g_assert_false(gtk_check_button_get_active(group));
+    gtk_check_button_set_active(group,TRUE);spin(50);
+    g_assert_cmpuint(mode(file),==,02641);
+    click(w,"permission_cancel");g_assert_cmpuint(mode(file),==,02641);
+    begin_permissions(w);gtk_check_button_set_active(group,TRUE);click(w,"permission_apply");
+    for(guint i=0;i<200 && mode(file)!=02651;i++)spin(20);
+    g_assert_cmpuint(mode(file),==,02651);
+    spin(200);
+    click(w,"rename_button");gtk_editable_set_text(GTK_EDITABLE(required(w,"rename_entry")),"cancelled.sh");click(w,"rename_cancel_button");
+    g_assert_true(g_file_test(file,G_FILE_TEST_EXISTS));
+    click(w,"rename_button");gtk_editable_set_text(GTK_EDITABLE(required(w,"rename_entry")),"occupied.sh");click(w,"rename_apply_button");
+    for(guint i=0;i<200 && !gtk_widget_get_sensitive(required(w,"rename_editor"));i++)spin(20);
+    g_assert_true(g_file_test(file,G_FILE_TEST_EXISTS));
+    g_assert_cmpstr(gtk_window_get_title(window),==,"About build.sh");
+    gtk_editable_set_text(GTK_EDITABLE(required(w,"rename_entry")),"renamed.sh");click(w,"rename_apply_button");
+    for(guint i=0;i<200 && !g_file_test(renamed,G_FILE_TEST_EXISTS);i++)spin(20);
+    g_assert_true(g_file_test(renamed,G_FILE_TEST_EXISTS));spin(200);
+    g_assert_cmpstr(gtk_window_get_title(window),==,"About renamed.sh");
+    begin_permissions(w);gtk_check_button_set_active(group,FALSE);
+    g_assert_cmpint(g_chmod(renamed,0644),==,0);spin(700);click(w,"permission_apply");
+    g_assert_cmpuint(mode(renamed),==,0644);
+    g_assert_nonnull(strstr(gtk_label_get_text(GTK_LABEL(required(w,"permission_status"))),"changed"));
+    for(guint i=0;i<200 && !gtk_widget_get_sensitive(required(w,"permissions_editor"));i++)spin(20);
+    click(w,"permission_cancel");begin_permissions(w);
+    g_assert_false(gtk_check_button_get_active(group));
+    gtk_check_button_set_active(group,TRUE);click(w,"permission_apply");
+    for(guint i=0;i<200 && mode(renamed)!=0654;i++)spin(20);
+    g_assert_cmpuint(mode(renamed),==,0654);
+    gtk_window_destroy(window);spin(50);
+    g_chmod(conflict,0701);
+    window=open_paths(renamed,conflict);w=GTK_WIDGET(window);
+    g_assert_cmpstr(gtk_window_get_title(window),==,"About 2 items");
+    g_assert_false(gtk_widget_get_visible(required(w,"rename_button")));
+    begin_permissions(w);g_assert_true(gtk_check_button_get_inconsistent(GTK_CHECK_BUTTON(required(w,"owner_exec"))));
+    click(w,"permission_cancel");gtk_window_destroy(window);spin(50);
+    window=open_paths(dir,NULL);w=GTK_WIDGET(window);
+    begin_permissions(w);g_assert_false(gtk_widget_get_visible(required(w,"execution_choices")));
+    gtk_window_destroy(window);spin(50);
+    g_remove(renamed);g_remove(conflict);g_rmdir(dir);
+}
+int main(int argc,char **argv)
+{
+    g_test_init(&argc,&argv,G_TEST_OPTION_ISOLATE_DIRS,NULL);
+    g_setenv("XDG_DATA_DIRS", "/usr/local/share:/usr/share", TRUE);
+    adw_init();
+    nautilus_register_resource();
+    /* Match upstream display fixtures: star indexing is outside this mutation test. */
+    g_autoptr(NautilusTagManager) tag_manager=nautilus_tag_manager_new_dummy();
+    g_autoptr(NautilusApplication) app=nautilus_application_new();
+    g_application_set_flags(G_APPLICATION(app),G_APPLICATION_NON_UNIQUE);
+    g_autoptr(GError) error=NULL;g_assert_true(g_application_register(G_APPLICATION(app),NULL,&error));
+    g_test_add_func("/luma/about/native-mutations",fixture);
+    return g_test_run();
+}
