+
+/* Native About presentation. The file model remains the authority for every
+ * mutation and the existing monitor owns external-change/deletion handling. */
+static void
+about_status (GtkLabel *label, const char *message)
+{
+    gtk_label_set_text (label, message ? message : "");
+    gtk_widget_set_visible (GTK_WIDGET (label), message && *message);
+}
+
+static void
+about_rename_cancel (NautilusPropertiesWidget *self, GtkWidget *button)
+{
+    gtk_widget_set_visible (self->rename_editor, FALSE);
+    gtk_widget_grab_focus (self->rename_button);
+}
+
+static void
+about_rename_finished (NautilusFile *file, GFile *location, GError *error, gpointer data)
+{
+    g_autoptr (NautilusPropertiesWidget) self = data;
+    self->renaming = FALSE;
+    gtk_widget_set_sensitive (self->rename_editor, TRUE);
+    if (error)
+        about_status (self->rename_status, error->message);
+    else
+    {
+        update_name_field (self);
+        about_rename_cancel (self, NULL);
+    }
+}
+
+static void
+about_rename_apply (NautilusPropertiesWidget *self, GtkWidget *button)
+{
+    const char *name = gtk_editable_get_text (GTK_EDITABLE (self->rename_entry));
+    if (self->renaming || is_multi_file_window (self)) return;
+    if (!*name || strchr (name, '/') || !strcmp (name, ".") || !strcmp (name, ".."))
+    {
+        about_status (self->rename_status, _("Enter a valid file name without a slash."));
+        return;
+    }
+    if (!nautilus_file_can_rename (get_file (self)))
+    {
+        about_status (self->rename_status, _("This item cannot be renamed here."));
+        return;
+    }
+    self->renaming = TRUE;
+    gtk_widget_set_sensitive (self->rename_editor, FALSE);
+    nautilus_file_rename (get_file (self), name, about_rename_finished, g_object_ref (self));
+}
+
+static void
+about_rename_begin (NautilusPropertiesWidget *self, GtkWidget *button)
+{
+    if (is_multi_file_window (self)) return;
+    gtk_editable_set_text (GTK_EDITABLE (self->rename_entry), nautilus_file_get_display_name (get_file (self)));
+    about_status (self->rename_status, NULL);
+    gtk_widget_set_visible (self->rename_editor, TRUE);
+    gtk_widget_grab_focus (GTK_WIDGET (self->rename_entry));
+    gtk_editable_select_region (GTK_EDITABLE (self->rename_entry), 0, -1);
+}
+
+static void
+about_update (NautilusPropertiesWidget *self)
+{
+    guint count = g_list_length (self->files);
+    if (!count) return;
+    g_autofree char *title = count == 1
+        ? g_strdup_printf (_("About %s"), nautilus_file_get_display_name (get_file (self)))
+        : g_strdup_printf (ngettext ("About %u item", "About %u items", count), count);
+    gtk_label_set_text (self->about_title, title);
+    adw_navigation_page_set_title (self->main_page, title);
+    if (gtk_widget_get_root(GTK_WIDGET(self)) && self->dialog) adw_dialog_set_title (self->dialog, title);
+    else if (GTK_IS_WINDOW (gtk_widget_get_root (GTK_WIDGET (self))))
+        gtk_window_set_title (GTK_WINDOW (gtk_widget_get_root (GTK_WIDGET (self))), title);
+    gtk_widget_set_visible (self->rename_button, count == 1);
+    gtk_widget_set_sensitive (self->rename_button, count == 1 && nautilus_file_can_rename (get_file (self)));
+    gtk_widget_set_visible (self->popout_button, FALSE);
+    gtk_widget_set_visible (GTK_WIDGET (self->execution_row), FALSE);
+    if (count == 1)
+    {
+        NautilusFile *file = get_file (self);
+        const char *summary = nautilus_file_can_write (file) ? _("You can edit") :
+                              nautilus_file_can_read (file) ? _("You can view") : _("No access");
+        gtk_label_set_text (GTK_LABEL (self->permissions_value_label), summary);
+        g_autofree char *type = g_content_type_get_description (nautilus_file_get_mime_type (file));
+        if (type) gtk_label_set_text (GTK_LABEL (self->type_value_label), type);
+    }
+    else gtk_label_set_text (GTK_LABEL (self->permissions_value_label), _("Multiple items"));
+    gtk_label_set_text (self->facts_size_caption,
+        count > 1 || nautilus_file_is_directory (get_file (self)) ? _("Contents") : _("File size"));
+}
+
+static void
+about_permissions_cancel (NautilusPropertiesWidget *self, GtkWidget *button)
+{
+    if (self->permission_applying || self->permission_refreshing) return;
+    self->permission_editing = FALSE;
+    self->permission_external_change = FALSE;
+    g_hash_table_remove_all (self->staged_permissions);
+    g_clear_pointer (&self->staged_owner, g_free);
+    g_clear_pointer (&self->staged_group, g_free);
+    gtk_widget_set_visible (self->permissions_editor, FALSE);
+    properties_widget_update (self, NULL);
+    gtk_widget_grab_focus (self->permissions_navigation_row);
+}
+
+static void
+about_permissions_begin (NautilusPropertiesWidget *self)
+{
+    if (self->permission_applying || self->permission_refreshing) return;
+    about_permissions_cancel (self, NULL);
+    self->permission_editing = TRUE;
+    gtk_widget_set_visible (self->permissions_editor, TRUE);
+    about_status (self->permission_status, NULL);
+    self->syncing_execution = TRUE;
+    const guint32 masks[] = {S_IXUSR, S_IXGRP, S_IXOTH};
+    GtkCheckButton *checks[] = {self->owner_exec, self->group_exec, self->others_exec};
+    gboolean has_files = FALSE;
+    for (guint i=0; i<3; i++)
+    {
+        guint yes=0, no=0;
+        gboolean can_change = TRUE;
+        for (GList *l=self->files; l; l=l->next)
+        {
+            NautilusFile *file=l->data;
+            if (nautilus_file_is_directory (file)) continue;
+            has_files = TRUE;
+            if (nautilus_file_get_permissions (file) & masks[i]) yes++; else no++;
+            can_change &= nautilus_file_can_set_permissions (file);
+        }
+        gtk_check_button_set_active (checks[i], yes && !no);
+        gtk_check_button_set_inconsistent (checks[i], yes && no);
+        gtk_widget_set_sensitive (GTK_WIDGET (checks[i]), can_change);
+    }
+    gtk_widget_set_visible (self->execution_choices, has_files);
+    self->syncing_execution = FALSE;
+}
+
+static void
+about_execution_changed (NautilusPropertiesWidget *self, GtkCheckButton *check)
+{
+    if (self->syncing_execution || !self->permission_editing) return;
+    guint32 mask = check == self->owner_exec ? S_IXUSR : check == self->group_exec ? S_IXGRP : S_IXOTH;
+    gtk_check_button_set_inconsistent (check, FALSE);
+    update_permissions (self, gtk_check_button_get_active (check) ? mask : 0, mask, FILES_ONLY, FALSE);
+}
+
+typedef struct {
+    NautilusPropertiesWidget *self;
+    NautilusFile *file;
+    guint32 mask, value, expected_mode, expected_uid, expected_gid;
+    gboolean check_mode, check_uid, check_gid;
+    char *owner, *group;
+    guint step;
+} AboutPermissionOperation;
+
+static void about_permission_next (AboutPermissionOperation *op);
+
+static void
+about_permission_done (NautilusFile *file, GFile *location, GError *error, gpointer data)
+{
+    AboutPermissionOperation *op=data;
+    if (error)
+    {
+        op->self->permission_failures++;
+        g_autofree char *message=g_strdup_printf (_("Could not apply changes to %s: %s"),
+                                                   nautilus_file_get_display_name (file), error->message);
+        about_status (op->self->permission_status, message);
+        op->step=3;
+    }
+    about_permission_next (op);
+}
+
+static void
+about_permission_next (AboutPermissionOperation *op)
+{
+    if (op->step++ == 0 && op->owner)
+    {
+        nautilus_file_set_owner (op->file, op->owner, about_permission_done, op);
+        return;
+    }
+    if (op->step <= 2)
+    {
+        op->step=2;
