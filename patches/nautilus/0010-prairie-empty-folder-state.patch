         nautilus_files_view_is_empty (self))
     {
         adw_status_page_set_child (status_page, NULL);
+        gtk_widget_remove_css_class (self->empty_view_page, "luma-empty-folder");
 
         if (NAUTILUS_IS_SEARCH_DIRECTORY (self->directory))
         {
@@ -3778,8 +3779,9 @@ nautilus_files_view_update_status_overlay (NautilusFilesView *self)
         }
         else
         {
