diff --git a/src/resources/style.css b/src/resources/style.css
index 086c392..fd86830 100644
--- a/src/resources/style.css
+++ b/src/resources/style.css
@@ -671,3 +671,29 @@ rubberband {
 .toolbar.no-bottom-padding {
   padding-bottom: 0px;
 }
+
+/* Prairie's ordinary empty-folder state. Keep the existing AdwStatusPage and
+ * Nautilus empty-directory state machine; only its state-specific presentation
+ * changes. Other empty states retain their upstream treatment. */
+statuspage.luma-empty-folder > scrolledwindow > viewport > box {
+  margin: 0 12px;
+  padding-bottom: 26px;
+  border-spacing: 0;
+}
+
+statuspage.luma-empty-folder > scrolledwindow > viewport > box > clamp > box {
+  border-spacing: 15px;
+}
+
+statuspage.luma-empty-folder > scrolledwindow > viewport > box > clamp > box > .icon {
+  color: #ccd1d7;
+  -gtk-icon-size: 82px;
+  margin-bottom: 0;
+}
+
+statuspage.luma-empty-folder > scrolledwindow > viewport > box > clamp > box > .title {
+  color: #a4aab2;
+  font-size: 14px;
+  font-weight: 500;
+  letter-spacing: 0.01em;
+}
