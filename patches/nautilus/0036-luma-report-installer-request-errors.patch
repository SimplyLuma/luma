+static void
+application_install_requested (GObject *source, GAsyncResult *result, gpointer data)
+{
+    GWeakRef *parent_ref = data;
+    g_autoptr (GtkWidget) parent = g_weak_ref_get (parent_ref);
+    g_autoptr (GError) error = NULL;
+    g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+
+    g_weak_ref_clear (parent_ref);
+    g_free (parent_ref);
+    if (error != NULL)
+    {
+        g_autofree char *message = g_strdup_printf (_("The application installer could not be opened: %s"), error->message);
+        nautilus_show_ok_dialog (_("Installation unavailable"), message,
+                                 parent && gtk_widget_get_root (parent) ? parent : NULL);
+    }
+}
