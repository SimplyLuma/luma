From 4814d31a5f093a2028ca92e8fcf468987468c29d Mon Sep 17 00:00:00 2001
From: Nick McMillen <153555205+nmcmil@users.noreply.github.com>
Date: Sat, 26 Sep 2026 03:41:11 +0000
Subject: [PATCH] Filer: materialize scratch fixture for native conform

---
 src/nautilus-main.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/nautilus-main.c b/src/nautilus-main.c
index 4bf4fb9..a59d746 100644
--- a/src/nautilus-main.c
+++ b/src/nautilus-main.c
@@ -70,6 +70,30 @@ main (int   argc,
     {
         const char *fixture = g_getenv ("LUMA_FILER_FIXTURE");
         const char *root = g_getenv ("LUMA_FILER_FIXTURE_ROOT");
+        const char *tool = g_getenv ("LUMA_FILER_FIXTURE_TOOL");
+
+        if (tool != NULL && root != NULL && g_path_is_absolute (root) &&
+            g_file_test (fixture, G_FILE_TEST_IS_REGULAR) &&
+            !g_file_test (root, G_FILE_TEST_EXISTS))
+        {
+            const char *command[] = { "python3", tool, "--fixture", fixture,
+                                      "--root", root, NULL };
+            g_autofree char *output = NULL;
+            g_autofree char *diagnostic = NULL;
+            g_autoptr (GError) error = NULL;
+            int status = 0;
+
+            if (!g_spawn_sync (NULL, (char **) command, NULL, G_SPAWN_SEARCH_PATH,
+                               NULL, NULL, &output, &diagnostic, &status, &error) ||
+                !g_spawn_check_wait_status (status, &error))
+            {
+                g_printerr ("Filer fixture setup failed: %s %s\n",
+                            error != NULL ? error->message : "unknown error",
+                            diagnostic != NULL ? diagnostic : "");
+                return EXIT_FAILURE;
+            }
+        }
+
         if (*fixture == '\0' || !g_file_test (fixture, G_FILE_TEST_IS_REGULAR) ||
             root == NULL || !g_path_is_absolute (root) ||
             !g_file_test (root, G_FILE_TEST_IS_DIR))
-- 
