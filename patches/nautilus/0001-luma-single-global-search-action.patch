+static void
+set_sidebar_width (NautilusWindow *window,
+                   gdouble         width)
+{
+    AdwOverlaySplitView *split_view = ADW_OVERLAY_SPLIT_VIEW (window->split_view);
+    gdouble current_width;
+
+    width = CLAMP (width, 120.0, 480.0);
+    current_width = adw_overlay_split_view_get_max_sidebar_width (split_view);
+
+    /* Keep min <= max throughout the update so libadwaita never clamps an
+     * intermediate invalid range and visibly relayouts twice. */
+    if (width > current_width)
+    {
+        adw_overlay_split_view_set_max_sidebar_width (split_view, width);
+        adw_overlay_split_view_set_min_sidebar_width (split_view, width);
+    }
+    else
+    {
+        adw_overlay_split_view_set_min_sidebar_width (split_view, width);
+        adw_overlay_split_view_set_max_sidebar_width (split_view, width);
+    }
+}
+
+static gboolean
+get_current_pointer_x (GtkGestureDrag *gesture,
+                       gdouble        *pointer_x)
+{
+    GdkEvent *event;
+    gdouble pointer_y;
+
+    event = gtk_event_controller_get_current_event (GTK_EVENT_CONTROLLER (gesture));
+    return event != NULL && gdk_event_get_position (event, pointer_x, &pointer_y);
+}
+
+static void
+sidebar_resize_drag_begin (GtkGestureDrag *gesture,
+                           gdouble         start_x,
+                           gdouble         start_y,
+                           NautilusWindow *window)
+{
+    if (!get_current_pointer_x (gesture, &window->sidebar_resize_start_pointer_x))
+    {
+        window->sidebar_resize_start_pointer_x = start_x;
+    }
+
+    window->sidebar_resize_start_width =
+        gtk_widget_get_width (GTK_WIDGET (window->places_sidebar)) +
+        gtk_widget_get_width (window->sidebar_resize_handle);
+    window->sidebar_resize_current_width = window->sidebar_resize_start_width;
+}
+
+static void
+sidebar_resize_drag_update (GtkGestureDrag *gesture,
+                            gdouble         offset_x,
+                            gdouble         offset_y,
+                            NautilusWindow *window)
+{
+    gdouble pointer_x;
+    gdouble width;
+
+    if (!get_current_pointer_x (gesture, &pointer_x))
+    {
+        return;
+    }
+
+    offset_x = pointer_x - window->sidebar_resize_start_pointer_x;
+    if (gtk_widget_get_direction (GTK_WIDGET (window)) == GTK_TEXT_DIR_RTL)
+    {
+        offset_x = -offset_x;
+    }
+
+    width = CLAMP (window->sidebar_resize_start_width + offset_x, 120.0, 480.0);
+    window->sidebar_resize_current_width = width;
+    set_sidebar_width (window, width);
+}
+
+static void
+sidebar_resize_drag_end (GtkGestureDrag *gesture,
+                         gdouble         offset_x,
+                         gdouble         offset_y,
+                         NautilusWindow *window)
+{
+    g_settings_set_int (nautilus_window_state,
+                        NAUTILUS_WINDOW_STATE_SIDEBAR_WIDTH,
+                        (gint) (window->sidebar_resize_current_width + 0.5));
+}
+
 static void
 nautilus_window_init (NautilusWindow *window)
 {
@@ -1579,6 +1669,20 @@ nautilus_window_init (NautilusWindow *window)
     g_type_ensure (NAUTILUS_TYPE_SHORTCUT_MANAGER);
     gtk_widget_init_template (GTK_WIDGET (window));
 
