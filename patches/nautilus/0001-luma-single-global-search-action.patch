+                                           NAUTILUS_WINDOW_STATE_SIDEBAR_WIDTH));
+    gtk_widget_set_cursor_from_name (window->sidebar_resize_handle, "col-resize");
+    controller = GTK_EVENT_CONTROLLER (gtk_gesture_drag_new ());
+    gtk_event_controller_set_propagation_phase (controller, GTK_PHASE_CAPTURE);
+    g_signal_connect (controller, "drag-begin",
+                      G_CALLBACK (sidebar_resize_drag_begin), window);
+    g_signal_connect (controller, "drag-update",
+                      G_CALLBACK (sidebar_resize_drag_update), window);
+    g_signal_connect (controller, "drag-end",
+                      G_CALLBACK (sidebar_resize_drag_end), window);
+    gtk_widget_add_controller (window->sidebar_resize_handle, controller);
+
     g_signal_connect (window, "notify::maximized",
                       G_CALLBACK (on_is_maximized_changed), NULL);
 
@@ -1699,6 +1803,7 @@ nautilus_window_class_init (NautilusWindowClass *class)
