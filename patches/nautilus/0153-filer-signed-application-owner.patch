--- a/src/nautilus-main.c
+++ b/src/nautilus-main.c
@@ -41,6 +41,8 @@
 #include <stdlib.h>
 #include <string.h>
 #include <unistd.h>
+#include <errno.h>
+#include <sys/wait.h>
 
 int
 main (int   argc,
@@ -48,6 +50,59 @@
 {
     gint retval;
     NautilusApplication *application;
+    /* The signed OS role owns launcher, MIME and D-Bus activation together.
+     * Resolve before GTK/profile initialization: removal or a broken signed
+     * baseline must never open a stale native application. The same app source
+     * owns FileManager1 and the file-chooser portal in the signed deployment.
+     */
+    if (!g_file_test ("/.flatpak-info", G_FILE_TEST_EXISTS) && getuid () != 0)
+    {
+        const char *resolve[] = { "/usr/bin/python3", "-I", "-m",
+                                  "luma_installer.native_app_roles", "--resolve",
+                                  "org.gnome.Nautilus", NULL };
+        g_autofree char *target = NULL;
+        g_autofree char *diagnostic = NULL;
+        g_autoptr (GError) error = NULL;
+        int status = 0;
+        if (!g_spawn_sync (NULL, (char **) resolve, NULL, 0, NULL, NULL,
+                           &target, &diagnostic, &status, &error) ||
+            !WIFEXITED (status))
+        {
+            g_printerr ("Filer application owner could not be resolved: %s\n",
+                        error != NULL ? error->message : "resolver did not exit normally");
+            return EXIT_FAILURE;
+        }
+        if (WEXITSTATUS (status) == 10)
+        {
+            g_auto (GStrv) launch = NULL;
+            /* Bound and independently validate the host verifier's exact
+             * fixed app identity; never interpret a command or executable.
+             */
+            if (target == NULL || strlen (target) > 128 ||
+                !g_regex_match_simple ("^app/org[.]gnome[.]Nautilus/(x86_64|aarch64)/(stable|beta|nightly)\\n\\z",
+                                       target, 0, 0))
+            {
+                g_printerr ("Filer signed application target is malformed\n");
+                return EXIT_FAILURE;
+            }
+            target[strlen (target) - 1] = '\0';
+            launch = g_new0 (char *, argc + 5);
+            launch[0] = g_strdup ("/usr/bin/flatpak");
+            launch[1] = g_strdup ("run");
+            launch[2] = g_strdup ("--system");
+            launch[3] = g_strdup (target);
+            for (int i = 1; i < argc; i++)
+                launch[i + 3] = g_strdup (argv[i]);
+            execv (launch[0], launch);
+            g_printerr ("Filer signed application could not be started: %s\n", g_strerror (errno));
+            return EXIT_FAILURE;
+        }
+        if (WEXITSTATUS (status) != 0 || (target != NULL && *target != '\0'))
+        {
+            g_printerr ("Filer signed application needs repair: %s\n", diagnostic != NULL ? diagnostic : "");
+            return EXIT_FAILURE;
+        }
+    }
     g_auto (GStrv) fixture_argv = NULL;
     /* Initialize gettext support */
     setlocale (LC_ALL, "");
