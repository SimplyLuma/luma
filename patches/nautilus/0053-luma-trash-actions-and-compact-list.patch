+/* The banner retains location state; Trash uses the shared compact action bar. */
+GtkWidget *
+nautilus_location_banner_create_trash_bar (AdwBanner *banner)
+{
+    GtkWidget *bar = luma_action_bar_new ();
+    GtkWidget *empty = gtk_button_new_with_mnemonic (_("_Empty Trash…"));
+    GtkWidget *settings = gtk_button_new_from_icon_name ("emblem-system-symbolic");
+
+    luma_action_bar_set_title (LUMA_ACTION_BAR (bar), _("Items in Trash"));
+    luma_action_bar_add_leading (LUMA_ACTION_BAR (bar),
+                                gtk_image_new_from_icon_name ("user-trash-symbolic"));
+    gtk_widget_set_tooltip_text (settings, _("Trash Settings"));
+    gtk_accessible_update_property (GTK_ACCESSIBLE (settings),
+                                    GTK_ACCESSIBLE_PROPERTY_LABEL, _("Trash Settings"), -1);
+    luma_action_bar_add_trailing (LUMA_ACTION_BAR (bar), settings);
+    luma_action_bar_add_trailing (LUMA_ACTION_BAR (bar), empty);
+    gtk_widget_set_margin_start (bar, 12);
+    gtk_widget_set_margin_end (bar, 12);
+    gtk_widget_set_margin_top (bar, 6);
+    gtk_widget_set_margin_bottom (bar, 6);
+    gtk_widget_set_visible (bar, FALSE);
+    g_signal_connect_object (empty, "clicked", G_CALLBACK (on_trash_clear_clicked),
+                             banner, G_CONNECT_SWAPPED);
+    g_signal_connect_object (settings, "clicked", G_CALLBACK (on_trash_auto_emptied_clicked),
+                             banner, G_CONNECT_SWAPPED);
+    g_object_set_data (G_OBJECT (bar), "empty-button", empty);
+    g_object_set_data (G_OBJECT (bar), "settings-button", settings);
+    g_object_set_data_full (G_OBJECT (banner), "trash-bar", g_object_ref_sink (bar), g_object_unref);
+    return bar;
+}
