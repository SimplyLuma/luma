+static void
+update_information (NautilusWindow *window)
+{
+    g_autoptr (NautilusFile) directory = NULL;
+    g_autoptr (GdkPaintable) paintable = NULL;
+    g_autofree char *kind = NULL;
+    g_autofree char *size = NULL;
+    g_autofree char *modified = NULL;
+    g_autofree char *where = NULL;
+    GList *selection;
+    NautilusFile *file;
+    GFile *location;
+    GtkWidget *icon;
+
+    if (window->information_pane == NULL)
+    {
+        return;
+    }
+
+    location = window->active_slot != NULL
+               ? nautilus_window_slot_get_location (window->active_slot) : NULL;
+    selection = window->active_slot != NULL
+                ? nautilus_window_slot_get_selection (window->active_slot) : NULL;
+    directory = location != NULL ? nautilus_file_get (location) : NULL;
+    file = selection != NULL ? NAUTILUS_FILE (selection->data) : directory;
+    luma_details_pane_set_subject (window->information_pane,
+                                    file != NULL ? G_OBJECT (file) : NULL);
+    luma_details_pane_clear (window->information_pane);
+    if (file == NULL)
+    {
+        return;
+    }
+
+    paintable = nautilus_file_get_icon_paintable (
+        file, 72, gtk_widget_get_scale_factor (GTK_WIDGET (window)),
+        NAUTILUS_FILE_ICON_FLAGS_NONE);
+    icon = paintable != NULL ? gtk_image_new_from_paintable (paintable)
+                             : gtk_image_new_from_icon_name ("folder-symbolic");
+    gtk_image_set_pixel_size (GTK_IMAGE (icon), 72);
+    luma_details_pane_add_hero (window->information_pane,
+                                nautilus_file_get_display_name (file), NULL, icon);
+
+    kind = nautilus_file_get_string_attribute_with_default (file, "type");
+    size = nautilus_file_get_string_attribute_with_default (file, "size");
+    modified = nautilus_file_get_string_attribute_with_default (file, "date_modified");
+    if (kind != NULL)
+    {
+        luma_details_pane_add_fact (window->information_pane, _("Kind"), kind);
+    }
+    if (size != NULL)
+    {
