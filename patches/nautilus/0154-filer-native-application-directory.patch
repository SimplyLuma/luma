--- a/src/nautilus-files-view.c
+++ b/src/nautilus-files-view.c
@@ -1272,6 +1272,49 @@
 }
 
 static void
+host_application_launched (GObject *source, GAsyncResult *result, gpointer data)
+{
+    GtkWindow *window = data;
+    g_autoptr (GError) error = NULL;
+    g_autoptr (GVariant) response = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+    gboolean accepted = FALSE;
+    if (response != NULL) g_variant_get (response, "(b)", &accepted);
+    if (!accepted)
+        {
+        AdwDialog *dialog = adw_alert_dialog_new (_("Could not open application"),
+            error != NULL ? error->message : _("The application did not accept the request"));
+        adw_alert_dialog_add_response (ADW_ALERT_DIALOG (dialog), "close", _("Close"));
+        adw_alert_dialog_set_close_response (ADW_ALERT_DIALOG (dialog), "close");
+        adw_dialog_present (dialog, GTK_WIDGET (window));
+        }
+    g_object_unref (window);
+}
+
+static void
+host_launch_bus_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+    GTask *task = data;
+    g_autoptr (GError) error = NULL;
+    g_autoptr (GDBusConnection) bus = g_bus_get_finish (result, &error);
+    GtkWindow *window = g_task_get_source_object (task);
+    (void) source;
+    if (bus == NULL)
+        {
+        AdwDialog *dialog = adw_alert_dialog_new (_("Could not open application"), error->message);
+        adw_alert_dialog_add_response (ADW_ALERT_DIALOG (dialog), "close", _("Close"));
+        adw_alert_dialog_set_close_response (ADW_ALERT_DIALOG (dialog), "close");
+        adw_dialog_present (dialog, GTK_WIDGET (window));
+        }
+    else
+        g_dbus_connection_call (bus, "org.projectluma.ApplicationDirectory1",
+            "/org/projectluma/ApplicationDirectory1", "org.projectluma.ApplicationDirectory1", "Launch",
+            g_variant_new ("(s@as)", (const char *) g_task_get_task_data (task), g_variant_new_strv (NULL, 0)),
+            G_VARIANT_TYPE ("(b)"), G_DBUS_CALL_FLAGS_NONE, 15000, NULL,
+            host_application_launched, g_object_ref (window));
+    g_object_unref (task);
+}
