+/* Host desktop IDs never carry an executable, argv, or desktop file path
+ * into the sandbox. The authenticated native directory owns actual launch. */
+static GPtrArray *
+infos_from_host (GCancellable *cancellable, GError **error)
+{
+    g_autoptr (GDBusConnection) bus = g_bus_get_sync (G_BUS_TYPE_SESSION, cancellable, error);
+    if (bus == NULL) return NULL;
+    g_autoptr (GVariant) result = g_dbus_connection_call_sync (bus,
+        "org.projectluma.ApplicationDirectory1", "/org/projectluma/ApplicationDirectory1",
+        "org.projectluma.ApplicationDirectory1", "List", g_variant_new ("(s)", ""),
+        G_VARIANT_TYPE ("(a(sssbbb))"), G_DBUS_CALL_FLAGS_NONE, 15000, cancellable, error);
+    if (result == NULL) return NULL;
+    g_autoptr (GVariant) rows = g_variant_get_child_value (result, 0);
+    if (g_variant_n_children (rows) > 4096)
+    {
+        g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Installed application catalogue is too large");
+        return NULL;
+    }
+    GPtrArray *infos = g_ptr_array_new_with_free_func (g_object_unref);
+    GVariantIter iter;
+    const char *identity, *name, *icon_name;
+    gboolean is_default, files, uris;
+    g_variant_iter_init (&iter, rows);
+    while (g_variant_iter_loop (&iter, "(&s&s&sbbb)", &identity, &name, &icon_name, &is_default, &files, &uris))
+    {
+        if (!g_str_has_suffix (identity, ".desktop") || strchr (identity, '/') != NULL || strlen (identity) > 255)
+            continue;
+        g_autoptr (GFileInfo) info = g_file_info_new ();
+        g_autoptr (GIcon) icon = g_themed_icon_new (*icon_name ? icon_name : "application-x-executable");
+        g_file_info_set_name (info, identity);
+        g_file_info_set_display_name (info, name);
+        g_file_info_set_edit_name (info, name);
+        g_file_info_set_file_type (info, G_FILE_TYPE_REGULAR);
+        g_file_info_set_content_type (info, "application/x-desktop");
+        g_file_info_set_icon (info, icon);
+        g_file_info_set_size (info, 0);
+        g_file_info_set_attribute_boolean (info, G_FILE_ATTRIBUTE_STANDARD_IS_VIRTUAL, TRUE);
+        g_file_info_set_attribute_boolean (info, G_FILE_ATTRIBUTE_ACCESS_CAN_READ, TRUE);
+        g_file_info_set_attribute_boolean (info, G_FILE_ATTRIBUTE_ACCESS_CAN_WRITE, FALSE);
+        g_file_info_set_attribute_boolean (info, G_FILE_ATTRIBUTE_ACCESS_CAN_DELETE, FALSE);
+        g_file_info_set_attribute_boolean (info, G_FILE_ATTRIBUTE_ACCESS_CAN_TRASH, FALSE);
+        g_file_info_set_attribute_boolean (info, G_FILE_ATTRIBUTE_ACCESS_CAN_RENAME, FALSE);
+        g_ptr_array_add (infos, g_steal_pointer (&info));
+    }
+    return infos;
+}
