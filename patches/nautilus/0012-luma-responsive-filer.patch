+static void
+update_compact_path (NautilusPathBar *self)
+{
+    ButtonData *current_data;
+    ButtonData *root_data;
+    const char *current_name;
+    const char *root_name;
+    gboolean at_root;
+    g_autofree char *accessible_name = NULL;
+    g_autoptr (GIcon) root_icon = NULL;
+
+    if (self->button_list == NULL)
+        return;
+
+    current_data = BUTTON_DATA (self->button_list->data);
+    root_data = BUTTON_DATA (g_list_last (self->button_list)->data);
+    current_name = get_dir_name (current_data);
+    root_name = get_dir_name (root_data);
+    at_root = current_data == root_data;
+
+    gtk_label_set_text (GTK_LABEL (self->compact_root_label), root_name);
+    gtk_label_set_text (GTK_LABEL (self->compact_current_label), current_name);
+    gtk_widget_set_visible (self->compact_separator, !at_root);
+    gtk_widget_set_visible (self->compact_current_label, !at_root);
+
+    root_icon = get_gicon (root_data);
+    if (root_icon != NULL)
+    {
+        gtk_image_set_from_gicon (GTK_IMAGE (self->compact_root_icon), root_icon);
+        gtk_widget_set_visible (self->compact_root_icon, TRUE);
+    }
+    else
+    {
+        gtk_widget_set_visible (self->compact_root_icon, FALSE);
+    }
+
+    accessible_name = at_root
+                      ? g_strdup (root_name)
+                      : g_strdup_printf ("%s, %s", root_name, current_name);
+    gtk_accessible_update_property (GTK_ACCESSIBLE (self->compact_button),
+                                    GTK_ACCESSIBLE_PROPERTY_LABEL,
+                                    accessible_name, -1);
+}
+
 static void
 nautilus_path_bar_update_button_appearance (ButtonData *button_data,
                                             gboolean    current_dir)
