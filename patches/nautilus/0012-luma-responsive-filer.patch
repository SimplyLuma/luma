+static void
+rebuild_ancestor_menu (NautilusPathBar *self)
+{
+    GList *l;
+
+    g_menu_remove_all (self->ancestor_menu);
+
+    /* button_list is current-to-root. Menus read naturally root-to-current. */
+    for (l = g_list_last (self->button_list); l != NULL; l = l->prev)
+    {
+        ButtonData *button_data = BUTTON_DATA (l->data);
+        g_autofree gchar *uri = NULL;
+        g_autoptr (GMenuItem) item = NULL;
+
+        if (!self->compact && l == self->button_list)
+            continue;
+
+        uri = g_file_get_uri (button_data->path);
+        item = g_menu_item_new (get_dir_name (button_data), NULL);
+        g_menu_item_set_action_and_target (item, "pathbar.open-ancestor", "s", uri);
+        g_menu_append_item (self->ancestor_menu, item);
+    }
+}
+
+static void
+update_presentation (NautilusPathBar *self)
+{
+    GtkAdjustment *adjustment;
+    gboolean overflowing;
+
+    adjustment = gtk_scrolled_window_get_hadjustment (GTK_SCROLLED_WINDOW (self->scrolled));
+    overflowing = gtk_adjustment_get_upper (adjustment) >
+                  gtk_adjustment_get_page_size (adjustment) + 1.0;
+
+    gtk_widget_set_visible (self->current_view_menu_button, !self->compact);
+    gtk_widget_set_visible (self->ancestor_overflow_button,
+                            !self->compact && overflowing);
+    gtk_widget_set_visible (self->scrolled, !self->compact);
+    gtk_widget_set_visible (self->compact_button, self->compact);
+
+    if (self->compact)
+        gtk_widget_add_css_class (GTK_WIDGET (self), "compact");
+    else
+        gtk_widget_remove_css_class (GTK_WIDGET (self), "compact");
+
+    rebuild_ancestor_menu (self);
+}
+
