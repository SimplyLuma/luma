 %build
 %meson \
+  -Dtests=all \
+  -Dc_link_args="%{build_ldflags} %{build_cflags} -flto=2" \
   -Ddocs=true \
   -Dextensions=true \
   -Dintrospection=true \
   -Dselinux=true \
   -Dcloudproviders=%{?with_cloudproviders:true}%{?!with_cloudproviders:false}
   %{nil}
+# Blueprint declares a directory target; regenerate its inputs explicitly so
+# incremental source builds cannot package stale UI resources.
+generated_ui=$(mktemp -d)
+blueprint-compiler batch-compile --minify "$generated_ui" src/resources src/resources/ui/*.blp
+for ui in "$generated_ui"/ui/*.ui; do
+  target="%{_vpath_builddir}/src/resources/ui/${ui##*/}"
+  if ! cmp -s "$ui" "$target"; then
+    install -D -m 0644 "$ui" "$target"
+  fi
+done
+rm -rf "$generated_ui"
 %meson_build
 
 %install
