@@ -1308,3 +1308,80 @@
 window.luma-files-window .luma-view-mode-controls button:checked image {
   color: @luma_content;
 }
+
+/* Reviewed against the desktop Filer simulator: compact native list rows,
+ * readable metadata and one continuous material per browsing column. */
+window.luma-files-window .nautilus-list-view columnview {
+  padding-left: 8px;
+  padding-right: 8px;
+}
+window.luma-files-window .nautilus-list-view columnview > listview {
+  padding-top: 6px;
+  padding-bottom: 6px;
+  margin-left: -8px;
+  margin-right: -8px;
+  border-spacing: 1px;
+}
+window.luma-files-window .nautilus-list-view columnview > listview > row {
+  min-height: 32px;
+  padding: 0;
+  margin-left: 8px;
+  margin-right: 8px;
+  font-family: "Figtree";
+  font-size: 13px;
+  font-weight: 600;
+}
+window.luma-files-window .nautilus-list-view .nautilus-view-cell {
+  padding: 0 8px;
+}
+window.luma-files-window .nautilus-list-view .luma-column-symbolic-folder {
+  -gtk-icon-size: 14px;
+  color: @luma_folder;
+}
+window.luma-files-window .nautilus-list-view columnview > header > button,
+window.luma-files-window .nautilus-list-view columnview > header > button label {
+  font-family: "Figtree";
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  color: @luma_muted;
+}
+window.luma-files-window .nautilus-list-view .nautilus-view-cell > label,
+window.luma-files-window .nautilus-list-view label.dim-label {
+  font-family: "Figtree";
+  font-size: 11px;
+  font-weight: 500;
+  color: @luma_muted;
+  font-feature-settings: "tnum";
+}
+window.luma-files-window headerbar.luma-secondary-toolbar .nautilus-pathbar button,
+window.luma-files-window headerbar.luma-secondary-toolbar .nautilus-pathbar button label {
+  font-family: "Figtree";
+  font-size: 13px;
+  font-weight: 600;
+}
+window.luma-files-window headerbar.luma-secondary-toolbar .nautilus-pathbar .current-dir,
+window.luma-files-window headerbar.luma-secondary-toolbar .nautilus-pathbar .current-dir label {
+  font-weight: 700;
+}
+window.luma-files-window .luma-sidebar-section-divider {
+  min-height: 1px;
+  margin: 5px 7px;
+  background-color: @luma_line;
+  border: none;
+}
+window.luma-files-window .nautilus-column-view .luma-column-island {
+  background-color: @luma_island;
+  border-radius: 10px;
+  box-shadow: inset 0 0 0 1px @luma_line;
+}
+window.luma-files-window .nautilus-column-view .luma-column-island > scrolledwindow {
+  background-color: transparent;
+  border-radius: 0 0 10px 10px;
+}
+window.luma-files-window .nautilus-column-view .luma-details-content {
+  padding: 16px;
+}
+window.luma-files-window .nautilus-column-view .luma-details-value {
+  font-weight: 600;
+}
