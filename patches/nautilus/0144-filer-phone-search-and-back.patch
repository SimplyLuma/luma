From: Luma UI maintainers <noreply@projectluma.org>
Subject: [PATCH] Keep phone search visible and name the Back destination

Use the shared search keep option instead of a glyph-only empty field.
Back names its destination for accessibility and consistent title islands.

--- a/src/nautilus-window.c
+++ b/src/nautilus-window.c
@@ -1316,6 +1316,7 @@
     g_autofree char *text = window->action_search_item != NULL
                             ? g_strdup (luma_bar_item_search_get_text (window->action_search_item)) : NULL;
     LumaBarItem *item = luma_bar_item_new_search (placeholder);
+    luma_bar_item_search_set_keep (item, TRUE);
     if (text != NULL && *text != '\0')
         luma_bar_item_search_set_text (item, text);
     g_signal_connect (item, "search-changed", G_CALLBACK (on_bar_search_changed), window);
@@ -1533,9 +1534,11 @@
     g_autofree char *subtitle = parent_name != NULL && count_meta != NULL
                                 ? g_strdup_printf ("%s · %s", parent_name, count_meta)
                                 : g_strdup (count_meta);
+    g_autofree char *back_label = parent_name != NULL
+                                  ? g_strdup_printf (_("Back to %s"), parent_name) : NULL;
     luma_title_island_set_lead (window->title_island,
                                 top ? LUMA_TITLE_ISLAND_LEAD_MENU : LUMA_TITLE_ISLAND_LEAD_BACK,
-                                parent_name);
+                                back_label);
     luma_title_island_set_title (window->title_island, title, subtitle);
 }
 
