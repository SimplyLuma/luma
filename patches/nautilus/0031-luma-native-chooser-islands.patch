+/* A request title is purpose text, never an authenticated application name. */
+static void
+update_purpose (NautilusFileChooser *self)
+{
+    const char *title = gtk_window_get_title (GTK_WINDOW (self));
+
+    if (title == NULL || *title == '\0' || g_strcmp0 (title, _("Filer")) == 0)
+    {
+        switch (self->mode)
+        {
+            case NAUTILUS_MODE_SAVE_FILE:
+                title = _("Save your document");
+                break;
+            case NAUTILUS_MODE_SAVE_FILES:
+                title = _("Save your documents");
+                break;
+            case NAUTILUS_MODE_OPEN_FOLDER:
+                title = _("Choose a folder");
+                break;
+            case NAUTILUS_MODE_OPEN_FOLDERS:
+                title = _("Choose folders");
+                break;
+            case NAUTILUS_MODE_OPEN_FILES:
+                title = _("Open files");
+                break;
+            default:
+                title = _("Open a file");
+                break;
+        }
+    }
+    gtk_label_set_text (GTK_LABEL (self->title_widget), title);
+}
+
+static void
+update_input_capabilities (NautilusFileChooser *self)
+{
+    GdkSeat *seat = gdk_display_get_default_seat (gtk_widget_get_display (GTK_WIDGET (self)));
+    if (seat != NULL && (gdk_seat_get_capabilities (seat) & GDK_SEAT_CAPABILITY_TOUCH))
+        gtk_widget_add_css_class (GTK_WIDGET (self), "luma-touch");
+    else
+        gtk_widget_remove_css_class (GTK_WIDGET (self), "luma-touch");
+}
+
 static void
 nautilus_file_chooser_constructed (GObject *object)
 {
     G_OBJECT_CLASS (nautilus_file_chooser_parent_class)->constructed (object);
 
     NautilusFileChooser *self = (NautilusFileChooser *) object;
+
+    GdkSeat *seat = gdk_display_get_default_seat (gtk_widget_get_display (GTK_WIDGET (self)));
+    update_input_capabilities (self);
+    if (seat != NULL)
+    {
+        g_signal_connect_object (seat, "device-added", G_CALLBACK (update_input_capabilities),
+                                 self, G_CONNECT_SWAPPED);
+        g_signal_connect_object (seat, "device-removed", G_CALLBACK (update_input_capabilities),
+                                 self, G_CONNECT_SWAPPED);
+    }
 
     /* Setup slot. */
     self->slot = nautilus_window_slot_new (self->mode);
@@ -781,8 +825,9 @@
         gtk_widget_add_css_class (GTK_WIDGET (self), "devel");
     }
 
-    gtk_widget_add_css_class (self->title_widget, "windowtitle");
-    gtk_widget_add_css_class (self->title_widget, "title");
+    g_signal_connect_swapped (self, "notify::title",
+                              G_CALLBACK (update_purpose), self);
+    update_purpose (self);
