+/* Native Grid presentation. Selection and focus decorate the real GtkGridView
+ * child; file models, thumbnails, captions, and zoom remain Nautilus-owned. */
+.luma-files-window .nautilus-grid-view gridview {
+  padding: 12px;
+  border-spacing: 8px;
+}
+
+.luma-files-window .nautilus-grid-view gridview > child,
+.luma-files-window .nautilus-grid-view .nautilus-view-cell {
+  border-radius: 10px;
+}
+
+.luma-files-window .nautilus-grid-view gridview > child.activatable:hover {
+  background-color: @luma_hover;
+}
+
+.luma-files-window .nautilus-grid-view gridview > child:selected {
+  background-color: @luma_selected;
+  color: @luma_ink;
+}
+
+.luma-files-window .nautilus-grid-view gridview > child:focus-visible {
+  outline: 2px solid var(--accent-color);
+  outline-offset: -2px;
+}
+
+.luma-files-window .nautilus-grid-view .icon-ui-labels-box > label:not(.caption) {
+  color: @luma_ink;
+  font-size: 13px;
+  font-weight: 625;
+}
+
+.luma-files-window .nautilus-grid-view .icon-ui-labels-box > label.caption {
+  color: @luma_muted;
+  font-size: 11px;
+  font-weight: 500;
+  font-feature-settings: "tnum";
+}
+
+/* Native List presentation. GtkColumnView remains the one column/sort model. */
+.luma-files-window .nautilus-list-view columnview {
+  padding-left: 12px;
+  padding-right: 12px;
+}
+
+.luma-files-window .nautilus-list-view columnview > listview {
+  padding-top: 8px;
+  padding-bottom: 12px;
+  border-spacing: 0;
+  margin-left: -12px;
+  margin-right: -12px;
+}
+
+.luma-files-window .nautilus-list-view columnview > listview > row {
+  min-height: 30px;
+  margin-left: 12px;
+  margin-right: 12px;
+  border-radius: 8px;
+  color: @luma_ink;
+  font-size: 13px;
+  font-weight: 525;
+}
+
+.luma-files-window .nautilus-list-view columnview > listview > row.activatable:hover {
+  background-color: @luma_hover;
+}
+
+.luma-files-window .nautilus-list-view columnview > listview > row:selected {
+  background-color: @luma_selected;
+  color: @luma_ink;
+  font-weight: 650;
+}
+
+.luma-files-window .nautilus-list-view columnview > listview > row:focus-visible {
+  outline: 2px solid var(--accent-color);
+  outline-offset: -2px;
+}
+
+.luma-files-window .nautilus-list-view .nautilus-view-cell {
+  padding: 4px 8px;
+}
+
+.luma-files-window .nautilus-list-view .column-name-labels-box > box > label {
+  color: @luma_ink;
+}
+
+.luma-files-window .nautilus-list-view .nautilus-view-cell > label,
+.luma-files-window .nautilus-list-view label.dim-label {
+  color: @luma_muted;
+  font-feature-settings: "tnum";
+}
+
+.luma-files-window .nautilus-list-view columnview > header > button {
