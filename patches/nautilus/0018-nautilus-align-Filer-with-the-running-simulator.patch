+void
+nautilus_name_cell_set_column_mode (NautilusNameCell *self,
+                                    gboolean          column_mode)
+{
+    g_return_if_fail (NAUTILUS_IS_NAME_CELL (self));
+
+    if (self->column_mode == column_mode)
+    {
+        return;
+    }
+
+    self->column_mode = column_mode;
+
+    /* The list factory can establish presentation mode after the item has
+     * already produced its first icon. Refresh explicitly so Columns never
+     * flashes or retains the ordinary full-colour folder asset. */
+    if (nautilus_view_cell_get_item (NAUTILUS_VIEW_CELL (self)) != NULL)
+    {
+        update_icon (self);
+    }
+}
