+    else if (row_section_type == NAUTILUS_SIDEBAR_SECTION_MOUNTS &&
+             before_section_type != row_section_type)
+    {
+        heading = _("DEVICES");
+    }
+
+    /* Bookmarks remain part of Places in Luma. They are genuine locations,
+     * and separating them under another administrative heading makes the
+     * navigation noisier than the simulator's hierarchy. */
+    if (heading != NULL)
+    {
+        header = gtk_label_new (heading);
+        gtk_label_set_xalign (GTK_LABEL (header), 0.0f);
+        gtk_widget_add_css_class (header, "luma-sidebar-section-heading");
+        gtk_list_box_row_set_header (row, header);
     }
 }
 
