From c711432959828fc5971280e6fccf138c34689e5a Mon Sep 17 00:00:00 2001
From: Nick McMillen <153555205+nmcmil@users.noreply.github.com>
Date: Sat, 26 Sep 2026 02:28:04 +0000
Subject: [PATCH] Filer: use LumaUI ModeSwitch for file views

---
 src/nautilus-view-controls.c                  | 107 ++++++++++++++++++
 src/nautilus-window-slot.c                    |   8 ++
 src/nautilus-window-slot.h                    |   1 +
 src/resources/style.css                       |  58 ++--------
 src/resources/ui/nautilus-view-controls.blp   |  46 +-------
 .../display/test-luma-column-header-menu.c    |  35 ++++++
 6 files changed, 159 insertions(+), 96 deletions(-)

diff --git a/src/nautilus-view-controls.c b/src/nautilus-view-controls.c
index cdd3ece..9ae0048 100644
--- a/src/nautilus-view-controls.c
+++ b/src/nautilus-view-controls.c
@@ -8,12 +8,16 @@
 
 #include "nautilus-toolbar-menu-sections.h"
 #include "nautilus-window-slot.h"
+#include <glib/gi18n.h>
+#include <luma-ui.h>
 
 struct _NautilusViewControls
 {
     AdwBin parent_instance;
 
     GtkWidget *view_controls;
+    GtkWidget *mode_host;
+    LumaModeSwitch *mode_switch;
     GMenuModel *view_menu;
 
     NautilusWindowSlot *window_slot;
@@ -31,6 +35,80 @@ enum
 
 static GParamSpec *properties[N_PROPS];
 
+static const char *
+view_mode_key (guint view_id)
+{
+    switch (view_id)
+    {
+        case 2: return "grid";
+        case 1: return "list";
+        case 4: return "columns";
+        default: return NULL;
+    }
+}
+
+static void
+on_view_mode_state_changed (GActionGroup *group,
+                            const char   *action_name,
+                            GVariant     *state,
+                            gpointer      user_data)
+{
+    NautilusViewControls *self = NAUTILUS_VIEW_CONTROLS (user_data);
+    const char *key;
+
+    if (g_strcmp0 (action_name, "files-view-mode") != 0)
+    {
+        return;
+    }
+
+    key = view_mode_key (g_variant_get_uint32 (state));
+    if (key != NULL)
+    {
+        luma_mode_switch_set_current (self->mode_switch, key);
+    }
+}
+
+static void
+on_view_mode_enabled_changed (GActionGroup *group,
+                              const char   *action_name,
+                              gboolean      enabled,
+                              gpointer      user_data)
+{
+    NautilusViewControls *self = NAUTILUS_VIEW_CONTROLS (user_data);
+
+    if (g_strcmp0 (action_name, "files-view-mode") == 0)
+    {
+        gtk_widget_set_sensitive (GTK_WIDGET (self->mode_switch), enabled);
+    }
+}
+
+static void
+on_mode_changed (LumaModeSwitch *switcher,
+                 const char     *key,
+                 gpointer        user_data)
+{
+    NautilusViewControls *self = NAUTILUS_VIEW_CONTROLS (user_data);
+    GActionGroup *group;
+    guint view_id;
+
+    if (self->window_slot == NULL)
+    {
+        return;
+    }
+
+    view_id = g_strcmp0 (key, "grid") == 0 ? 2 :
+              g_strcmp0 (key, "list") == 0 ? 1 :
+              g_strcmp0 (key, "columns") == 0 ? 4 : 0;
+    if (view_id == 0)
+    {
+        return;
+    }
+
+    group = nautilus_window_slot_get_action_group (self->window_slot);
+    g_action_group_change_action_state (group, "files-view-mode",
+                                        g_variant_new_uint32 (view_id));
+}
+
 static void
 on_slot_toolbar_menu_sections_changed (NautilusViewControls *self,
                                        GParamSpec           *param,
@@ -68,6 +146,8 @@ disconnect_toolbar_menu_sections_change_handler (NautilusViewControls *self)
     g_signal_handlers_disconnect_by_func (self->window_slot,
                                           G_CALLBACK (on_slot_toolbar_menu_sections_changed),
                                           self);
+    g_signal_handlers_disconnect_by_data (
+        nautilus_window_slot_get_action_group (self->window_slot), self);
 }
 
 
@@ -89,9 +169,27 @@ nautilus_view_controls_set_window_slot (NautilusViewControls *self,
 
     if (self->window_slot != NULL)
     {
+        GActionGroup *group = nautilus_window_slot_get_action_group (self->window_slot);
+        g_autoptr (GVariant) state = g_action_group_get_action_state (group, "files-view-mode");
+
         on_slot_toolbar_menu_sections_changed (self, NULL, self->window_slot);
         g_signal_connect_swapped (self->window_slot, "notify::toolbar-menu-sections",
                                   G_CALLBACK (on_slot_toolbar_menu_sections_changed), self);
+        g_signal_connect (group, "action-state-changed",
+                          G_CALLBACK (on_view_mode_state_changed), self);
+        g_signal_connect (group, "action-enabled-changed",
+                          G_CALLBACK (on_view_mode_enabled_changed), self);
+        if (state != NULL)
+        {
+            on_view_mode_state_changed (group, "files-view-mode", state, self);
+        }
+        on_view_mode_enabled_changed (
+            group, "files-view-mode",
+            g_action_group_get_action_enabled (group, "files-view-mode"), self);
+    }
+    else
+    {
+        gtk_widget_set_sensitive (GTK_WIDGET (self->mode_switch), FALSE);
     }
 
     g_object_notify_by_pspec (G_OBJECT (self), properties[PROP_WINDOW_SLOT]);
@@ -190,12 +288,21 @@ nautilus_view_controls_class_init (NautilusViewControlsClass *klass)
                                                  "/org/gnome/nautilus/ui/nautilus-view-controls.ui");
     gtk_widget_class_bind_template_child (widget_class, NautilusViewControls, view_menu);
     gtk_widget_class_bind_template_child (widget_class, NautilusViewControls, view_controls);
+    gtk_widget_class_bind_template_child (widget_class, NautilusViewControls, mode_host);
 }
 
 static void
 nautilus_view_controls_init (NautilusViewControls *self)
 {
     gtk_widget_init_template (GTK_WIDGET (self));
+    self->mode_switch = LUMA_MODE_SWITCH (luma_mode_switch_new (_("View mode")));
+    gtk_widget_set_name (GTK_WIDGET (self->mode_switch), "filer-view-modes");
+    luma_mode_switch_add (self->mode_switch, "grid", _("Grid"), "grid-2x2");
+    luma_mode_switch_add (self->mode_switch, "list", _("List"), "list");
+    luma_mode_switch_add (self->mode_switch, "columns", _("Columns"), "columns-3");
+    gtk_box_append (GTK_BOX (self->mode_host), GTK_WIDGET (self->mode_switch));
+    g_signal_connect (self->mode_switch, "changed", G_CALLBACK (on_mode_changed), self);
+    gtk_widget_set_sensitive (GTK_WIDGET (self->mode_switch), FALSE);
 }
 
 GMenuModel *
