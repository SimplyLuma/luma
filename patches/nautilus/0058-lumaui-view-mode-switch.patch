+++ b/test/automated/display/test-luma-column-header-menu.c
@@ -13,10 +13,44 @@
 #include <nautilus-global-preferences.h>
 #include <nautilus-list-base.h>
 #include <nautilus-list-view.h>
+#include <nautilus-view-controls.h>
+#include <nautilus-window-slot.h>
 #include <nautilus-resources.h>
 #include <nautilus-tag-manager.h>
 #include <test-utilities.h>
 #include <glib/gstdio.h>
+#include <luma-ui.h>
+
+static GtkWidget *
+find_named_widget (GtkWidget *widget, const char *name)
+{
+    if (g_strcmp0 (gtk_widget_get_name (widget), name) == 0)
+        return widget;
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        GtkWidget *found = find_named_widget (child, name);
+        if (found != NULL) return found;
+    }
+    return NULL;
+}
+
+static void
+test_view_modes_follow_slot (void)
+{
+    g_autoptr (NautilusWindowSlot) slot = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    g_autoptr (NautilusViewControls) controls = g_object_ref_sink (
+        g_object_new (NAUTILUS_TYPE_VIEW_CONTROLS, "window-slot", slot, NULL));
+    GtkWidget *widget = find_named_widget (GTK_WIDGET (controls), "filer-view-modes");
+    GActionGroup *group = nautilus_window_slot_get_action_group (slot);
+    GAction *action = g_action_map_lookup_action (G_ACTION_MAP (group), "files-view-mode");
+
+    g_assert_true (LUMA_IS_MODE_SWITCH (widget));
+    g_simple_action_set_state (G_SIMPLE_ACTION (action), g_variant_new_uint32 (4));
+    g_assert_cmpstr (luma_mode_switch_get_current (LUMA_MODE_SWITCH (widget)), ==, "columns");
+    g_simple_action_set_state (G_SIMPLE_ACTION (action), g_variant_new_uint32 (2));
+    g_assert_cmpstr (luma_mode_switch_get_current (LUMA_MODE_SWITCH (widget)), ==, "grid");
+}
 
 static GtkColumnView *
 find_columns (GtkWidget *widget)
@@ -409,6 +443,7 @@ main (int argc, char **argv)
     g_autoptr (NautilusApplication) app = nautilus_application_new ();
     g_log_set_always_fatal (G_LOG_LEVEL_ERROR | G_LOG_LEVEL_CRITICAL | G_LOG_LEVEL_WARNING);
     test_v70_table_labels ();
+    test_view_modes_follow_slot ();
     test_header_columns ();
     test_details_selection ();
     test_favorites ();
