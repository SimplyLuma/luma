--- a/test/automated/meson.build
+++ b/test/automated/meson.build
@@ -7,8 +7,16 @@
   include_directories: include_directories('.')
 )
 
+# Fat LTO objects retain native code. Avoid repeating whole-library LTO for
+# each non-installed test executable; production targets remain optimized.
+test_link_args = []
+if '-ffat-lto-objects' in get_option('c_args')
+  test_link_args += ['-fno-lto']
+endif
+
 libtestutils_dep = declare_dependency(
   link_with: libtestutils,
+  link_args: test_link_args,
   include_directories: include_directories('.'),
   dependencies: libnautilus_dep,
   sources: resources
