+    g_assert_cmpint(g_mkdir_with_parents(g_get_home_dir(),0700),==,0);
+    NautilusWindow *window=nautilus_window_new();
+    gtk_window_set_default_size(GTK_WINDOW(window),402,740);
+    gtk_window_present(GTK_WINDOW(window));
+    g_autoptr(GFile) home=g_file_new_for_path(g_get_home_dir());
+    nautilus_window_open_location_full(window,home,0,NULL);spin(600);
+    AdwDialog *unexpected=adw_application_window_get_visible_dialog(ADW_APPLICATION_WINDOW(window));
+    if(ADW_IS_ALERT_DIALOG(unexpected))g_test_message("Unexpected dialog: %s / %s",adw_alert_dialog_get_heading(ADW_ALERT_DIALOG(unexpected)),adw_alert_dialog_get_body(ADW_ALERT_DIALOG(unexpected)));
+    g_assert_null(unexpected);
+    GtkWidget *island=find_css(GTK_WIDGET(window),"lumaui-title-island");
+    g_assert_nonnull(island);
+    g_assert_true(gtk_widget_get_mapped(island));
+    GtkWidget *title=find_css(island,"lumaui-title-island-title");
+    GtkWidget *lead=find_css(island,"lumaui-title-island-lead");
+    for(guint i=0;i<3;i++)
+    {
+        g_signal_emit_by_name(title,"clicked");spin(400);
+        g_assert_true(luma_title_island_get_grown(LUMA_TITLE_ISLAND(island)));
+        GtkWidget *sidebar=required(GTK_WIDGET(window),"places_sidebar");
+        g_assert_true(gtk_widget_is_ancestor(sidebar,island));
+        g_assert_true(gtk_widget_get_mapped(sidebar));
+        g_signal_emit_by_name(lead,"clicked");spin(400);
+        g_assert_false(luma_title_island_get_grown(LUMA_TITLE_ISLAND(island)));
+        g_assert_false(gtk_widget_is_ancestor(sidebar,island));
+    }
+    gtk_window_set_default_size(GTK_WINDOW(window),1180,740);spin(400);
+    g_assert_false(gtk_widget_get_mapped(island));
+    g_assert_true(gtk_widget_get_mapped(required(GTK_WIDGET(window),"places_sidebar")));
+    g_autoptr(NautilusWindowSlot) active_slot=NULL;
+    g_object_get(window,"active-slot",&active_slot,NULL);
+    GActionGroup *slot_actions=nautilus_window_slot_get_action_group(active_slot);
+    g_autoptr(NautilusQuery) query=nautilus_query_new();
+    nautilus_query_set_text(query,"private-review-query");
+    nautilus_query_set_location(query,home);
+    nautilus_window_search(window,query);spin(600);
+    const int search_widths[]={360,402,720,1180,402};
+    for(guint i=0;i<G_N_ELEMENTS(search_widths);i++) {
