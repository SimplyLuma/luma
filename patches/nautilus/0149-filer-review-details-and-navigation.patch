+    }
+    g_assert_nonnull(details);g_assert_nonnull(copy);
+    g_signal_emit_by_name(details,"clicked");spin(400);
+    g_assert_cmpstr(luma_action_center_get_grown(center),==,"details");
+    GtkWidget *panel=required(GTK_WIDGET(window),"filer-details-panel");
+    g_assert_false(luma_details_pane_get_is_drawer(LUMA_DETAILS_PANE(panel)));
+    g_assert_true(gtk_widget_get_mapped(copy));
+    g_assert_true(gtk_widget_compute_bounds(copy,GTK_WIDGET(window),&files_box));
+    g_assert_true(gtk_widget_compute_bounds(panel,GTK_WIDGET(window),&pane_box));
+    g_assert_cmpfloat(files_box.origin.y,>=,pane_box.origin.y+pane_box.size.height);
+    g_signal_emit_by_name(details,"clicked");spin(300);
+    g_assert_null(luma_action_center_get_grown(center));
+    gtk_window_destroy(GTK_WINDOW(window));spin(100);
+    g_remove(path);
+}
