+    g_assert_nonnull(luma_details_pane_get_subject(info));
+    g_assert_true(luma_details_pane_show(info,TRUE));spin(400);
+    GtkWidget *sheet=find_css(GTK_WIDGET(info),"lumaui-details");
+    graphene_rect_t pane_box, files_box;
+    g_assert_true(gtk_widget_compute_bounds(sheet,GTK_WIDGET(window),&pane_box));
+    g_assert_true(gtk_widget_compute_bounds(required(GTK_WIDGET(window),"filer-island"),GTK_WIDGET(window),&files_box));
+    GtkBorder pane_margin;
+    gtk_style_context_get_margin(gtk_widget_get_style_context(sheet),&pane_margin);
+    g_test_message("Info bounds %.0f %.0f %.0f %.0f; file bounds %.0f %.0f %.0f %.0f; margin %d %d %d %d",
+      pane_box.origin.x,pane_box.origin.y,pane_box.size.width,pane_box.size.height,
+      files_box.origin.x,files_box.origin.y,files_box.size.width,files_box.size.height,
+      pane_margin.left,pane_margin.right,pane_margin.top,pane_margin.bottom);
+    GtkSnapshot *snapshot=gtk_snapshot_new();
+    GdkPaintable *paintable=gtk_widget_paintable_new(GTK_WIDGET(window));
+    gdk_paintable_snapshot(paintable,snapshot,gtk_widget_get_width(GTK_WIDGET(window)),gtk_widget_get_height(GTK_WIDGET(window)));
+    GskRenderNode *node=gtk_snapshot_free_to_node(snapshot);
+    if(node) {
+      GdkTexture *texture=gsk_renderer_render_texture(gtk_native_get_renderer(GTK_NATIVE(window)),node,NULL);
+      gdk_texture_save_to_png(texture,"/tmp/filer-info-review.png");
+      g_object_unref(texture);gsk_render_node_unref(node);
+    }
+    g_object_unref(paintable);
+    g_assert_cmpfloat(pane_box.origin.x-(files_box.origin.x+files_box.size.width),>=,8);
+    g_assert_cmpfloat(gtk_widget_get_width(GTK_WIDGET(window))-(pane_box.origin.x+pane_box.size.width),>=,8);
+    luma_details_pane_show(info,FALSE);spin(100);
+    g_autofree char *path=g_build_filename(g_get_home_dir(),"review.txt",NULL);
+    g_assert_true(g_file_set_contents(path,"Review fixture",-1,NULL));
+    g_autoptr(GFile) location=g_file_new_for_path(path);
+    NautilusFile *file=nautilus_file_get(location);
+    GList *selection=g_list_append(NULL,file);
+    gtk_window_set_default_size(GTK_WINDOW(window),402,740);spin(300);
+    nautilus_window_open_location_full(window,home,0,selection);spin(600);
+    g_list_free_full(selection,g_object_unref);
+    LumaActionCenter *center=LUMA_ACTION_CENTER(find_css(GTK_WIDGET(window),"lumaui-action-center"));
+    GtkWidget *details=NULL,*copy=NULL;
+    for(guint i=0;i<6;i++) {
+        GtkWidget *control=luma_action_center_get_bar_control(center,i);
