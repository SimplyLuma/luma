+static GtkWidget *find_text(GtkWidget *widget, const char *text) {
+    if (GTK_IS_LABEL(widget) && g_strcmp0(gtk_label_get_text(GTK_LABEL(widget)), text) == 0)
+        return widget;
+    for (GtkWidget *child = gtk_widget_get_first_child(widget); child;
+         child = gtk_widget_get_next_sibling(child)) {
+        GtkWidget *found = find_text(child, text);
+        if (found != NULL) return found;
+    }
+    return NULL;
+}
+static void settle(void) {
+    gint64 until = g_get_monotonic_time() + 150000;
+    while (g_get_monotonic_time() < until) {
+        while (g_main_context_iteration(NULL, FALSE));
+        g_usleep(1000);
+    }
+}
+static void wait_text(GtkWidget *widget, const char *text) {
+    gint64 until = g_get_monotonic_time() + 10000000;
+    while (g_get_monotonic_time() < until) {
+        settle();
+        GtkWidget *label = find_text(widget, text);
+        if (label != NULL && gtk_widget_is_visible(label)) return;
+    }
+    g_error("Expected visible picker text: %s", text);
+}
+static void capture(GtkWidget *widget, const char *name) {
+    const char *directory = g_getenv("LUMA_PICKER_CAPTURE_DIR");
+    if (directory == NULL) return;
+    g_autoptr(GdkPaintable) paintable = gtk_widget_paintable_new(widget);
+    GtkSnapshot *snapshot = gtk_snapshot_new();
+    gdk_paintable_snapshot(paintable, GDK_SNAPSHOT(snapshot),
+                          gtk_widget_get_width(widget), gtk_widget_get_height(widget));
+    GskRenderNode *node = gtk_snapshot_free_to_node(snapshot);
+    g_assert_nonnull(node);
+    GskRenderer *renderer = gtk_native_get_renderer(GTK_NATIVE(widget));
+    g_autoptr(GdkTexture) texture = gsk_renderer_render_texture(renderer, node, NULL);
+    g_autofree char *path = g_build_filename(directory, name, NULL);
+    g_assert_true(gdk_texture_save_to_png(texture, path));
+    gsk_render_node_unref(node);
+}
+static void accepted(NautilusFileChooser *chooser, GList *locations,
+                     GtkFileFilter *filter, GFile **result) {
+    g_assert_cmpuint(g_list_length(locations), ==, 1);
+    *result = g_object_ref(locations->data);
+}
+int main(int argc, char **argv) {
+    g_test_init(&argc, &argv, NULL);
+    if (!gtk_init_check()) return 77;
+    const char *icon_theme = g_getenv("LUMA_PICKER_ICON_THEME");
+    if (icon_theme != NULL)
+        g_object_set(gtk_settings_get_default(), "gtk-icon-theme-name", icon_theme, NULL);
+    nautilus_register_resource();
+    g_autoptr(NautilusTagManager) tags = nautilus_tag_manager_new_dummy();
+    g_autoptr(GApplication) app = G_APPLICATION(nautilus_application_new());
+    g_application_hold(app);
+    g_assert_true(g_application_register(app, NULL, NULL));
+    g_autofree char *root = g_dir_make_tmp("luma-picker-XXXXXX", NULL);
+    g_assert_nonnull(root);
+    g_autofree char *empty = g_build_filename(root, "empty", NULL);
+    g_autofree char *filtered = g_build_filename(root, "filtered", NULL);
+    g_assert_cmpint(g_mkdir(empty, 0700), ==, 0);
+    g_assert_cmpint(g_mkdir(filtered, 0700), ==, 0);
+    for (int n = 0; n < 4; n++) {
+        g_autofree char *name = g_strdup_printf("file%d.txt", n);
+        g_autofree char *path = g_build_filename(filtered, name, NULL);
+        g_assert_true(g_file_set_contents(path, "fixture", -1, NULL));
+    }
+    const int widths[] = {360, 500, 1024, 1440};
+    for (int dark = 0; dark < 2; dark++) {
+        adw_style_manager_set_color_scheme(adw_style_manager_get_default(),
+            dark ? ADW_COLOR_SCHEME_FORCE_DARK : ADW_COLOR_SCHEME_FORCE_LIGHT);
+        for (int save = 0; save < 2; save++) {
+            for (guint n = 0; n < G_N_ELEMENTS(widths); n++) {
+                NautilusFileChooser *chooser = nautilus_file_chooser_new(save ? NAUTILUS_MODE_SAVE_FILE : NAUTILUS_MODE_OPEN_FILE);
+                GtkWidget *window = GTK_WIDGET(chooser);
+                gtk_window_set_application(GTK_WINDOW(window), GTK_APPLICATION(app));
+                gtk_window_set_title(GTK_WINDOW(window), save ? "Save image" : "Open image");
+                gtk_window_set_default_size(GTK_WINDOW(window), widths[n], 560);
+                g_autoptr(GFile) folder = g_file_new_for_path(empty);
+                nautilus_file_chooser_set_starting_location(chooser, folder);
+                if (save) nautilus_file_chooser_set_suggested_name(chooser, "result.png");
+                gtk_window_present(GTK_WINDOW(window));
+                wait_text(window, "This folder is empty");
+                wait_text(window, "0 items");
+                /* Exercise resize after native initial geometry restoration. */
+                gtk_window_set_default_size(GTK_WINDOW(window), widths[n], 560);
+                settle();
+                g_assert_cmpint(gtk_widget_get_width(window), >=, widths[n] - 16);
+                g_assert_cmpint(gtk_widget_get_width(window), <=, widths[n]);
+                if (n == 0 || n == 2) {
+                    g_autofree char *name = g_strdup_printf("%s-empty-%s-%d.png", save ? "save" : "open", dark ? "dark" : "light", widths[n]);
+                    capture(window, name);
+                }
+                if (save && n == 2) {
+                    GFile *result = NULL;
+                    g_signal_connect(chooser, "accepted", G_CALLBACK(accepted), &result);
+                    g_assert_true(gtk_widget_activate_action(window, "chooser.accept", NULL));
+                    settle();
+                    g_assert_nonnull(result);
+                    g_autofree char *name = g_file_get_basename(result);
+                    g_assert_cmpstr(name, ==, "result.png");
+                    g_assert_false(g_file_query_exists(result, NULL));
+                    g_object_unref(result);
+                }
+                gtk_window_destroy(GTK_WINDOW(window));
+            }
+        }
+    }
+    NautilusFileChooser *chooser = nautilus_file_chooser_new(NAUTILUS_MODE_OPEN_FILE);
+    gtk_window_set_application(GTK_WINDOW(chooser), GTK_APPLICATION(app));
+    g_autoptr(GListStore) filters = g_list_store_new(GTK_TYPE_FILE_FILTER);
+    g_autoptr(GtkFileFilter) png = gtk_file_filter_new();
+    gtk_file_filter_set_name(png, "PNG images");
+    gtk_file_filter_add_pattern(png, "*.png");
+    g_list_store_append(filters, png);
+    g_autoptr(GtkFileFilter) all = gtk_file_filter_new();
+    gtk_file_filter_set_name(all, "All files");
+    gtk_file_filter_add_pattern(all, "*");
+    g_list_store_append(filters, all);
+    nautilus_file_chooser_set_filters(chooser, G_LIST_MODEL(filters));
+    g_autoptr(GFile) folder = g_file_new_for_path(filtered);
+    nautilus_file_chooser_set_starting_location(chooser, folder);
+    gtk_window_present(GTK_WINDOW(chooser));
+    wait_text(GTK_WIDGET(chooser), "Nothing here this app can open");
+    wait_text(GTK_WIDGET(chooser), "0 of 4 items shown");
+    capture(GTK_WIDGET(chooser), "open-filtered-dark.png");
+    nautilus_file_chooser_set_current_filter(chooser, 1);
+    wait_text(GTK_WIDGET(chooser), "4 items");
+    GtkWidget *title = find_text(GTK_WIDGET(chooser), "Nothing here this app can open");
+    g_assert_true(title == NULL || !gtk_widget_is_visible(title));
+    nautilus_file_chooser_set_current_filter(chooser, 0);
+    wait_text(GTK_WIDGET(chooser), "0 of 4 items shown");
+    g_assert_true(gtk_widget_activate_action(GTK_WIDGET(chooser), "window.close", NULL));
+    settle();
+    for (int n = 0; n < 4; n++) {
+        g_autofree char *name = g_strdup_printf("file%d.txt", n);
+        g_autofree char *path = g_build_filename(filtered, name, NULL);
+        g_assert_cmpint(g_unlink(path), ==, 0);
+    }
+    g_autoptr(GFile) browse_folder = g_file_new_for_path(empty);
+    GFile *locations[] = {browse_folder};
+    g_application_open(app, locations, 1, "");
+    settle();
+    GtkWindow *filer = gtk_application_get_active_window(GTK_APPLICATION(app));
+    g_assert_nonnull(filer);
+    wait_text(GTK_WIDGET(filer), "This folder is empty");
+    wait_text(GTK_WIDGET(filer), "0 items");
+    capture(GTK_WIDGET(filer), "filer-empty-dark.png");
+    gtk_window_destroy(filer);
+    g_assert_cmpint(g_rmdir(filtered), ==, 0);
+    g_assert_cmpint(g_rmdir(empty), ==, 0);
+    g_assert_cmpint(g_rmdir(root), ==, 0);
+    g_application_quit(app);
+    return 0;
+}
