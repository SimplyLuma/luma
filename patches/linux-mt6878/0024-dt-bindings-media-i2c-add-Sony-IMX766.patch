From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <builds@project-luma.local>
Date: Mon, 19 Oct 2026 21:05:56 -0400
Subject: [PATCH 24/33] dt-bindings: media: i2c: add Sony IMX766

Describe the Sony IMX766 50 MP CMOS sensor with its MIPI CSI-2 C-PHY
output on three trios.
---
 .../bindings/media/i2c/sony,imx766.yaml       | 114 ++++++++++++++++++
 1 file changed, 114 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/sony,imx766.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/sony,imx766.yaml b/Documentation/devicetree/bindings/media/i2c/sony,imx766.yaml
new file mode 100644
index 000000000..02fdef797
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/sony,imx766.yaml
@@ -0,0 +1,114 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/sony,imx766.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sony IMX766 50 MP CMOS image sensor
+
+maintainers:
+  - Project Luma <builds@project-luma.local>
+
+description:
+  The Sony IMX766 is a 1/1.56-inch 50 MP quad-Bayer CMOS image sensor with a
+  MIPI CSI-2 C-PHY output on up to three trios, controlled over I2C.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: sony,imx766
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: INCK, 24 MHz
+    maxItems: 1
+
+  avdd-supply:
+    description: Analogue supply, 2.8 V
+
+  dvdd-supply:
+    description: Digital core supply, 1.1 V
+
+  dovdd-supply:
+    description: Interface supply, 1.8 V
+
+  reset-gpios:
+    description: XCLR, active low
+    maxItems: 1
+
+  powerdown-gpios:
+    description: Power-down control, active low
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          bus-type:
+            const: 1  # MEDIA_BUS_TYPE_CSI2_CPHY
+
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+
+          link-frequencies: true
+
+        required:
+          - bus-type
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - avdd-supply
+  - dvdd-supply
+  - dovdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@1a {
+            compatible = "sony,imx766";
+            reg = <0x1a>;
+            clocks = <&inck>;
+            avdd-supply = <&cam_avdd>;
+            dvdd-supply = <&cam_dvdd>;
+            dovdd-supply = <&cam_dovdd>;
+            reset-gpios = <&pio 26 GPIO_ACTIVE_LOW>;
+            powerdown-gpios = <&pio 28 GPIO_ACTIVE_LOW>;
+            orientation = <1>;
+            rotation = <180>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&csi_in>;
+                    bus-type = <1>;
+                    data-lanes = <1 2 3>;
+                    link-frequencies = /bits/ 64 <574000000>;
+                };
+            };
+        };
+    };
+...
-- 
2.55.0

