From ae5329e64d59b9805a2dd4fc199ca611e3424431 Mon Sep 17 00:00:00 2001
From: Project Luma <builds@project-luma.local>
Date: Tue, 20 Oct 2026 03:00:23 -0400
Subject: [PATCH] ASoC: mediatek: mt6878-titan2e: add the speech links

A Hostless_Speech front end and the PCM 1 back end to the modem.
---
 sound/soc/mediatek/mt6878/mt6878-titan2e.c | 23 ++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/sound/soc/mediatek/mt6878/mt6878-titan2e.c b/sound/soc/mediatek/mt6878/mt6878-titan2e.c
index d7f588995..75e90b448 100644
--- a/sound/soc/mediatek/mt6878/mt6878-titan2e.c
+++ b/sound/soc/mediatek/mt6878/mt6878-titan2e.c
@@ -236,6 +236,14 @@ SND_SOC_DAILINK_DEFS(capture0,
 	DAILINK_COMP_ARRAY(COMP_CPU("UL0")),
 	DAILINK_COMP_ARRAY(COMP_DUMMY()),
 	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+SND_SOC_DAILINK_DEFS(hostless_speech,
+	DAILINK_COMP_ARRAY(COMP_CPU("Hostless Speech DAI")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+SND_SOC_DAILINK_DEFS(modem_pcm,
+	DAILINK_COMP_ARRAY(COMP_CPU("PCM 1")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
 SND_SOC_DAILINK_DEFS(spk_i2s,
 	DAILINK_COMP_ARRAY(COMP_CPU("I2SOUT4")),
 	DAILINK_COMP_ARRAY(COMP_DUMMY()),
@@ -285,6 +293,15 @@ static struct snd_soc_dai_link titan_dai_links[] = {
 		.capture_only = 1,
 		SND_SOC_DAILINK_REG(capture0),
 	},
+	{
+		/* opened for the duration of a call; moves no data */
+		.name = "Hostless_Speech",
+		.stream_name = "Hostless_Speech",
+		.trigger = {SND_SOC_DPCM_TRIGGER_PRE, SND_SOC_DPCM_TRIGGER_PRE},
+		.dynamic = 1,
+		.ignore_suspend = 1,
+		SND_SOC_DAILINK_REG(hostless_speech),
+	},
 	{
 		.name = "Speaker Amp",
 		.no_pcm = 1,
@@ -293,6 +310,12 @@ static struct snd_soc_dai_link titan_dai_links[] = {
 		.be_hw_params_fixup = titan_spk_fixup,
 		SND_SOC_DAILINK_REG(spk_i2s),
 	},
+	{
+		.name = "Modem PCM",
+		.no_pcm = 1,
+		.ignore_suspend = 1,
+		SND_SOC_DAILINK_REG(modem_pcm),
+	},
 	{
 		.name = "Primary Codec",
 		.no_pcm = 1,
-- 
2.55.0

