+#define IMX766_REG_LINE_LENGTH		CCI_REG16(0x0342)
+#define IMX766_REG_EXPOSURE		CCI_REG16(0x0202)
+#define IMX766_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+#define IMX766_REG_DIGITAL_GAIN		CCI_REG16(0x020e)
+#define IMX766_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define IMX766_INCK_FREQ		24000000
+#define IMX766_PIXEL_RATE		787200000LL
+/* v4l2_get_link_freq() convention for C-PHY: pixel_rate * bpp * 7 / (2 * 16 * trios) */
+#define IMX766_LINK_FREQ		574000000LL
+#define IMX766_WIDTH			4096
+#define IMX766_HEIGHT			3072
+#define IMX766_LINE_LENGTH		15616
+#define IMX766_FRAME_LENGTH		3176
+#define IMX766_FRAME_LENGTH_MAX		0xfffc
+#define IMX766_EXPOSURE_MARGIN		48
+#define IMX766_EXPOSURE_MIN		8
+#define IMX766_EXPOSURE_DEFAULT		0x3d0
+/* Sony analogue gain code: gain = 16384 / (16384 - code), 1x..64x */
+#define IMX766_ANA_GAIN_MIN		0
+#define IMX766_ANA_GAIN_MAX		16128
+#define IMX766_ANA_GAIN_DEFAULT		12288
+#define IMX766_DGTL_GAIN_MIN		0x0100
+#define IMX766_DGTL_GAIN_MAX		0x0fff
+#define IMX766_DGTL_GAIN_DEFAULT	0x0100
+
+static const char * const imx766_supply_names[] = {
+	"dovdd",	/* 1.8 V interface */
+	"avdd",		/* 2.8 V analogue */
+	"dvdd",		/* 1.1 V core */
+};
