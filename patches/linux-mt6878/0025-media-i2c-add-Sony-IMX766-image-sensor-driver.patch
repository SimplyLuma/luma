+static const s64 imx766_link_freqs[] = { IMX766_LINK_FREQ };
+
+static const char * const imx766_test_pattern_menu[] = {
+	"Disabled",
+	"Solid Colour",
+	"Colour Bars",
+	"Fade To Grey Colour Bars",
+	"PN9",
+};
+
+struct imx766 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct clk *inck;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(imx766_supply_names)];
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+};
+
+static inline struct imx766 *to_imx766(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx766, sd);
+}
+
+static u32 imx766_mbus_code(struct imx766 *imx766)
+{
+	/* The sensor is mounted rotated by 180 degrees; flips shift the CFA. */
+	static const u32 codes[2][2] = {
+		{ MEDIA_BUS_FMT_SRGGB10_1X10, MEDIA_BUS_FMT_SGRBG10_1X10 },
+		{ MEDIA_BUS_FMT_SGBRG10_1X10, MEDIA_BUS_FMT_SBGGR10_1X10 },
+	};
+	bool h = imx766->hflip && imx766->hflip->val;
+	bool v = imx766->vflip && imx766->vflip->val;
+
+	return codes[v][h];
+}
+
+static int imx766_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx766 *imx766 = container_of(ctrl->handler, struct imx766, ctrls);
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_subdev_state *state;
+	int ret = 0;
+
+	state = v4l2_subdev_get_locked_active_state(&imx766->sd);
+	fmt = v4l2_subdev_state_get_format(state, 0);
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		int max = fmt->height + ctrl->val - IMX766_EXPOSURE_MARGIN;
+
+		__v4l2_ctrl_modify_range(imx766->exposure, IMX766_EXPOSURE_MIN, max, 1,
+					 min(imx766->exposure->val, max));
+	}
+	if (ctrl->id == V4L2_CID_HFLIP || ctrl->id == V4L2_CID_VFLIP)
+		fmt->code = imx766_mbus_code(imx766);
+
+	if (!pm_runtime_get_if_in_use(imx766->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(imx766->regmap, IMX766_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(imx766->regmap, IMX766_REG_ANALOG_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		cci_write(imx766->regmap, IMX766_REG_DIGITAL_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(imx766->regmap, IMX766_REG_FRAME_LENGTH,
+			  fmt->height + ctrl->val, &ret);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		cci_write(imx766->regmap, IMX766_REG_ORIENTATION,
+			  imx766->hflip->val | imx766->vflip->val << 1, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(imx766->regmap, IMX766_REG_TEST_PATTERN, ctrl->val, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(imx766->dev);
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx766_ctrl_ops = {
+	.s_ctrl = imx766_set_ctrl,
+};
+
+static int imx766_init_controls(struct imx766 *imx766)
+{
+	struct v4l2_ctrl_handler *hdl = &imx766->ctrls;
+	const struct v4l2_ctrl_ops *ops = &imx766_ctrl_ops;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	int vblank = IMX766_FRAME_LENGTH - IMX766_HEIGHT;
+	int hblank = IMX766_LINE_LENGTH - IMX766_WIDTH;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(imx766->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 12);
+
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE, IMX766_PIXEL_RATE,
+			  IMX766_PIXEL_RATE, 1, IMX766_PIXEL_RATE);
+	ctrl = v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				      imx766_link_freqs);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	imx766->vblank = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK, vblank,
+					   IMX766_FRAME_LENGTH_MAX - IMX766_HEIGHT,
+					   2, vblank);
+	ctrl = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK, hblank, hblank, 1, hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	imx766->exposure = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE,
+					     IMX766_EXPOSURE_MIN,
+					     IMX766_FRAME_LENGTH - IMX766_EXPOSURE_MARGIN,
+					     1, IMX766_EXPOSURE_DEFAULT);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, IMX766_ANA_GAIN_MIN,
+			  IMX766_ANA_GAIN_MAX, 1, IMX766_ANA_GAIN_DEFAULT);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_DIGITAL_GAIN, IMX766_DGTL_GAIN_MIN,
+			  IMX766_DGTL_GAIN_MAX, 1, IMX766_DGTL_GAIN_DEFAULT);
+	imx766->hflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HFLIP, 0, 1, 1, 0);
+	imx766->vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (imx766->hflip)
+		imx766->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+	if (imx766->vflip)
+		imx766->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+	v4l2_ctrl_new_std_menu_items(hdl, ops, V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx766_test_pattern_menu) - 1, 0, 0,
+				     imx766_test_pattern_menu);
+	v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+
+	imx766->sd.ctrl_handler = hdl;
+	return 0;
+}
+
+static int imx766_enable_streams(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				 u32 pad, u64 streams_mask)
+{
+	struct imx766 *imx766 = to_imx766(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(imx766->dev);
+	if (ret)
+		return ret;
+
+	ret = cci_multi_reg_write(imx766->regmap, imx766_init_regs,
+				  ARRAY_SIZE(imx766_init_regs), NULL);
+	if (!ret)
+		ret = cci_multi_reg_write(imx766->regmap, imx766_4096x3072_regs,
+					  ARRAY_SIZE(imx766_4096x3072_regs), NULL);
+	if (!ret)
+		ret = __v4l2_ctrl_handler_setup(&imx766->ctrls);
+	if (!ret)
+		ret = cci_write(imx766->regmap, IMX766_REG_MODE_SELECT,
+				IMX766_MODE_STREAMING, NULL);
+	if (ret) {
+		dev_err(imx766->dev, "failed to start streaming: %d\n", ret);
+		pm_runtime_put(imx766->dev);
+		return ret;
+	}
+
+	__v4l2_ctrl_grab(imx766->hflip, true);
+	__v4l2_ctrl_grab(imx766->vflip, true);
+	return 0;
+}
+
+static int imx766_disable_streams(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct imx766 *imx766 = to_imx766(sd);
+	int ret;
+
+	ret = cci_write(imx766->regmap, IMX766_REG_MODE_SELECT, IMX766_MODE_STANDBY, NULL);
+	__v4l2_ctrl_grab(imx766->hflip, false);
+	__v4l2_ctrl_grab(imx766->vflip, false);
+	pm_runtime_put(imx766->dev);
+	return ret;
+}
+
+static void imx766_fill_format(struct imx766 *imx766, struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = IMX766_WIDTH;
+	fmt->height = IMX766_HEIGHT;
+	fmt->code = imx766_mbus_code(imx766);
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int imx766_set_format(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_format *fmt)
+{
+	imx766_fill_format(to_imx766(sd), &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	return 0;
+}
+
+static int imx766_enum_mbus_code(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = imx766_mbus_code(to_imx766(sd));
+	return 0;
+}
+
+static int imx766_enum_frame_size(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != imx766_mbus_code(to_imx766(sd)))
+		return -EINVAL;
+	fse->min_width = IMX766_WIDTH;
+	fse->max_width = IMX766_WIDTH;
+	fse->min_height = IMX766_HEIGHT;
+	fse->max_height = IMX766_HEIGHT;
+	return 0;
+}
+
+static int imx766_get_selection(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = IMX766_WIDTH * 2;
+		sel->r.height = IMX766_HEIGHT * 2;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int imx766_init_state(struct v4l2_subdev *sd, struct v4l2_subdev_state *state)
+{
+	imx766_fill_format(to_imx766(sd), v4l2_subdev_state_get_format(state, 0));
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops imx766_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops imx766_pad_ops = {
+	.enum_mbus_code = imx766_enum_mbus_code,
+	.enum_frame_size = imx766_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = imx766_set_format,
+	.get_selection = imx766_get_selection,
+	.enable_streams = imx766_enable_streams,
+	.disable_streams = imx766_disable_streams,
+};
+
+static const struct v4l2_subdev_ops imx766_subdev_ops = {
+	.video = &imx766_video_ops,
+	.pad = &imx766_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx766_internal_ops = {
+	.init_state = imx766_init_state,
+};
+
+static int imx766_power_on(struct device *dev)
+{
+	struct imx766 *imx766 = to_imx766(dev_get_drvdata(dev));
+	int ret;
+
+	gpiod_set_value_cansleep(imx766->reset_gpio, 1);
+	gpiod_set_value_cansleep(imx766->powerdown_gpio, 1);
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(imx766->supplies), imx766->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(imx766->inck);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(imx766->supplies), imx766->supplies);
+		return ret;
+	}
+
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(imx766->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(imx766->reset_gpio, 0);
+	usleep_range(2000, 3000);
+	return 0;
+}
+
+static int imx766_power_off(struct device *dev)
+{
+	struct imx766 *imx766 = to_imx766(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(imx766->reset_gpio, 1);
+	gpiod_set_value_cansleep(imx766->powerdown_gpio, 1);
+	clk_disable_unprepare(imx766->inck);
+	regulator_bulk_disable(ARRAY_SIZE(imx766->supplies), imx766->supplies);
+	return 0;
+}
+
+static int imx766_check_hwcfg(struct imx766 *imx766)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_CPHY };
+	struct fwnode_handle *fwnode;
+	int ret;
+
+	fwnode = fwnode_graph_get_next_endpoint(dev_fwnode(imx766->dev), NULL);
+	if (!fwnode)
+		return dev_err_probe(imx766->dev, -ENXIO, "endpoint node not found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(fwnode, &ep);
+	fwnode_handle_put(fwnode);
+	if (ret)
+		return dev_err_probe(imx766->dev, ret, "failed to parse endpoint\n");
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 3)
+		ret = dev_err_probe(imx766->dev, -EINVAL, "only 3 C-PHY trios are supported\n");
+	else if (ep.nr_of_link_frequencies != 1 ||
+		 ep.link_frequencies[0] != IMX766_LINK_FREQ)
+		ret = dev_err_probe(imx766->dev, -EINVAL, "link-frequencies must be <%lld>\n",
+				    IMX766_LINK_FREQ);
+
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int imx766_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx766 *imx766;
+	unsigned long rate;
+	u64 id;
+	int ret, i;
+
+	imx766 = devm_kzalloc(dev, sizeof(*imx766), GFP_KERNEL);
+	if (!imx766)
+		return -ENOMEM;
+	imx766->dev = dev;
+
+	v4l2_i2c_subdev_init(&imx766->sd, client, &imx766_subdev_ops);
+	imx766->sd.internal_ops = &imx766_internal_ops;
+
+	ret = imx766_check_hwcfg(imx766);
+	if (ret)
+		return ret;
+
+	imx766->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(imx766->regmap))
+		return dev_err_probe(dev, PTR_ERR(imx766->regmap), "failed to init CCI\n");
+
+	/*
+	 * Do not call clk_set_rate() here: the board firmware parents INCK
+	 * to a fixed 24 MHz source and the rate must only be checked.
+	 */
+	imx766->inck = devm_clk_get(dev, NULL);
+	if (IS_ERR(imx766->inck))
+		return dev_err_probe(dev, PTR_ERR(imx766->inck), "failed to get INCK\n");
+	rate = clk_get_rate(imx766->inck);
+	if (rate != IMX766_INCK_FREQ)
+		return dev_err_probe(dev, -EINVAL, "INCK is %lu Hz, need 24 MHz\n", rate);
+
+	for (i = 0; i < ARRAY_SIZE(imx766_supply_names); i++)
+		imx766->supplies[i].supply = imx766_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(imx766->supplies), imx766->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supplies\n");
+
+	imx766->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(imx766->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(imx766->reset_gpio), "failed to get reset\n");
+	imx766->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown", GPIOD_OUT_HIGH);
+	if (IS_ERR(imx766->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(imx766->powerdown_gpio),
+				     "failed to get powerdown\n");
+
+	ret = imx766_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = cci_read(imx766->regmap, IMX766_REG_CHIP_ID, &id, NULL);
+	if (ret || id != IMX766_CHIP_ID) {
+		ret = dev_err_probe(dev, ret ?: -ENODEV, "chip id 0x%llx, expected 0x%x\n",
+				    id, IMX766_CHIP_ID);
+		goto err_power_off;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = imx766_init_controls(imx766);
+	if (ret)
+		goto err_pm;
+
+	imx766->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx766->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	imx766->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&imx766->sd.entity, 1, &imx766->pad);
+	if (ret)
+		goto err_ctrls;
+
+	imx766->sd.state_lock = imx766->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&imx766->sd);
+	if (ret)
+		goto err_entity;
+
+	ret = v4l2_async_register_subdev_sensor(&imx766->sd);
+	if (ret)
+		goto err_subdev;
+
+	pm_runtime_idle(dev);
+	return 0;
+
+err_subdev:
+	v4l2_subdev_cleanup(&imx766->sd);
+err_entity:
+	media_entity_cleanup(&imx766->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&imx766->ctrls);
+err_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_power_off:
+	imx766_power_off(dev);
+	return ret;
+}
+
+static void imx766_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx766 *imx766 = to_imx766(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&imx766->ctrls);
+	pm_runtime_disable(imx766->dev);
+	if (!pm_runtime_status_suspended(imx766->dev))
+		imx766_power_off(imx766->dev);
+	pm_runtime_set_suspended(imx766->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(imx766_pm_ops, imx766_power_off, imx766_power_on, NULL);
+
+static const struct of_device_id imx766_of_match[] = {
+	{ .compatible = "sony,imx766" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, imx766_of_match);
+
+static struct i2c_driver imx766_driver = {
+	.driver = {
+		.name = "imx766",
+		.of_match_table = imx766_of_match,
+		.pm = pm_ptr(&imx766_pm_ops),
+	},
+	.probe = imx766_probe,
+	.remove = imx766_remove,
+};
+module_i2c_driver(imx766_driver);
+
+MODULE_DESCRIPTION("Sony IMX766 image sensor driver");
+MODULE_LICENSE("GPL");
