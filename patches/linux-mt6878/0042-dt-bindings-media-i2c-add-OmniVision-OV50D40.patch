From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <builds@project-luma.local>
Date: Mon, 19 Oct 2026 22:17:31 -0400
Subject: [PATCH 42/47] dt-bindings: media: i2c: add OmniVision OV50D40

Describe the OmniVision OV50D40 50 MP CMOS sensor with its MIPI CSI-2
D-PHY output on four data lanes.
---
 .../bindings/media/i2c/ovti,ov50d40.yaml      | 114 ++++++++++++++++++
 1 file changed, 114 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/ovti,ov50d40.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/ovti,ov50d40.yaml b/Documentation/devicetree/bindings/media/i2c/ovti,ov50d40.yaml
new file mode 100644
index 000000000..fcf2ca88e
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/ovti,ov50d40.yaml
@@ -0,0 +1,114 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/ovti,ov50d40.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OmniVision OV50D40 50 MP CMOS image sensor
+
+maintainers:
+  - Project Luma <builds@project-luma.local>
+
+description:
+  The OmniVision OV50D40 is a 32 MP quad-Bayer CMOS image sensor with a
+  MIPI CSI-2 D-PHY output on up to four data lanes, controlled over I2C.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: ovti,ov50d40
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: XVCLK, 24 MHz
+    maxItems: 1
+
+  avdd-supply:
+    description: Analogue supply, 2.8 V
+
+  dvdd-supply:
+    description: Digital core supply, 1.2 V
+
+  dovdd-supply:
+    description: Interface supply, 1.8 V
+
+  reset-gpios:
+    description: XSHUTDOWN, active low
+    maxItems: 1
+
+  powerdown-gpios:
+    description: Power-down control, active low
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          bus-type:
+            const: 4  # MEDIA_BUS_TYPE_CSI2_DPHY
+
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - avdd-supply
+  - dvdd-supply
+  - dovdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@36 {
+            compatible = "ovti,ov50d40";
+            reg = <0x36>;
+            clocks = <&xvclk>;
+            avdd-supply = <&cam_avdd>;
+            dvdd-supply = <&cam_dvdd>;
+            dovdd-supply = <&cam_dovdd>;
+            reset-gpios = <&pio 25 GPIO_ACTIVE_LOW>;
+            powerdown-gpios = <&pio 189 GPIO_ACTIVE_LOW>;
+            orientation = <1>;
+            rotation = <270>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&csi_in>;
+                    bus-type = <4>;
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <951000000>;
+                };
+            };
+        };
+    };
+...
-- 
