+// SPDX-License-Identifier: GPL-2.0
+/*
+ * OmniVision OV32B40 image sensor driver.
+ *
+ * One 2x2-binned mode, 3264x2448 RAW10 at 30 fps over four MIPI D-PHY
+ * lanes at 852 Mbps, from a 24 MHz XVCLK.
+ *
+ * The register settings come from the GPL-2.0 MediaTek imgsensor driver
+ * for this sensor (mot_aito_ov32b, Motorola Mobility,
+ * vendor-mediatek-kernel_modules-mtkcam); the initialisation table is a
+ * subset of the global table in the GPL-2.0 Rockchip ov32b40 driver
+ * (Copyright (C) 2025 Rockchip Electronics Co., Ltd.), with identical
+ * values. Exposure, gain, VTS and test pattern registers as used by both.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define OV32B40_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define OV32B40_MODE_STANDBY		0x00
+#define OV32B40_MODE_STREAMING		0x01
+#define OV32B40_REG_SOFTWARE_RESET	CCI_REG8(0x0103)
+#define OV32B40_REG_CHIP_ID		CCI_REG24(0x300a)
+#define OV32B40_CHIP_ID			0x563242
+#define OV32B40_REG_EXPOSURE		CCI_REG24(0x3500)
+#define OV32B40_REG_ANALOG_GAIN		CCI_REG16(0x3508)
+#define OV32B40_REG_VTS			CCI_REG16(0x380e)
+#define OV32B40_REG_TEST_PATTERN	CCI_REG8(0x50c1)
+#define OV32B40_TEST_PATTERN_ENABLE	BIT(0)
+
+#define OV32B40_XVCLK_FREQ		24000000
+#define OV32B40_LINK_FREQ		426000000LL
+/* pixel rate = link frequency * 2 * 4 lanes / 10 bits */
+#define OV32B40_PIXEL_RATE		340800000LL
+#define OV32B40_WIDTH			3264
+#define OV32B40_HEIGHT			2448
+/* HTS 1440 at the 115.2 MHz system clock: 12.5 us per line, 4260 pixel periods */
+#define OV32B40_LINE_LENGTH		4260
+#define OV32B40_VTS			2664
+#define OV32B40_VTS_MAX			0x7fff
+#define OV32B40_EXPOSURE_MARGIN		31
+#define OV32B40_EXPOSURE_MIN		16
+#define OV32B40_EXPOSURE_DEFAULT	0x0a48
+/* 0x3508[4:0].0x3509[7:1], 0x0100 = 1x */
+#define OV32B40_ANA_GAIN_MIN		0x0100
+#define OV32B40_ANA_GAIN_MAX		0x0ff0
+#define OV32B40_ANA_GAIN_DEFAULT	0x0100
+
+static const char * const ov32b40_supply_names[] = {
+	"dovdd",	/* 1.8 V interface */
+	"avdd",		/* 2.8 V analogue */
+	"dvdd",		/* 1.1 V core */
+};
+
+static const s64 ov32b40_link_freqs[] = { OV32B40_LINK_FREQ };
+
+static const char * const ov32b40_test_pattern_menu[] = {
+	"Disabled",
+	"Colour Bars",
+};
