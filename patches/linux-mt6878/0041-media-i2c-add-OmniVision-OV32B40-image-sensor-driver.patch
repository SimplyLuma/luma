+struct ov32b40 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct clk *xvclk;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(ov32b40_supply_names)];
+	struct gpio_desc *reset_gpio;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+};
+
+static inline struct ov32b40 *to_ov32b40(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct ov32b40, sd);
+}
+
+static int ov32b40_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ov32b40 *ov32b40 = container_of(ctrl->handler, struct ov32b40, ctrls);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		int max = OV32B40_HEIGHT + ctrl->val - OV32B40_EXPOSURE_MARGIN;
+
+		__v4l2_ctrl_modify_range(ov32b40->exposure, OV32B40_EXPOSURE_MIN, max, 1,
+					 min(ov32b40->exposure->val, max));
+	}
+
+	if (!pm_runtime_get_if_in_use(ov32b40->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(ov32b40->regmap, OV32B40_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(ov32b40->regmap, OV32B40_REG_ANALOG_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(ov32b40->regmap, OV32B40_REG_VTS, OV32B40_HEIGHT + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(ov32b40->regmap, OV32B40_REG_TEST_PATTERN,
+			  ctrl->val ? OV32B40_TEST_PATTERN_ENABLE : 0, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(ov32b40->dev);
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops ov32b40_ctrl_ops = {
+	.s_ctrl = ov32b40_set_ctrl,
+};
+
+static int ov32b40_init_controls(struct ov32b40 *ov32b40)
+{
+	struct v4l2_ctrl_handler *hdl = &ov32b40->ctrls;
+	const struct v4l2_ctrl_ops *ops = &ov32b40_ctrl_ops;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	int vblank = OV32B40_VTS - OV32B40_HEIGHT;
+	int hblank = OV32B40_LINE_LENGTH - OV32B40_WIDTH;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(ov32b40->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 9);
+
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE, OV32B40_PIXEL_RATE,
+			  OV32B40_PIXEL_RATE, 1, OV32B40_PIXEL_RATE);
+	ctrl = v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				      ov32b40_link_freqs);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	ov32b40->vblank = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK, vblank,
+					    OV32B40_VTS_MAX - OV32B40_HEIGHT, 1, vblank);
+	ctrl = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK, hblank, hblank, 1, hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	ov32b40->exposure = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE,
+					      OV32B40_EXPOSURE_MIN,
+					      OV32B40_VTS - OV32B40_EXPOSURE_MARGIN,
+					      1, OV32B40_EXPOSURE_DEFAULT);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, OV32B40_ANA_GAIN_MIN,
+			  OV32B40_ANA_GAIN_MAX, 1, OV32B40_ANA_GAIN_DEFAULT);
+	v4l2_ctrl_new_std_menu_items(hdl, ops, V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(ov32b40_test_pattern_menu) - 1, 0, 0,
+				     ov32b40_test_pattern_menu);
+	v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+
+	ov32b40->sd.ctrl_handler = hdl;
+	return 0;
+}
+
+static int ov32b40_enable_streams(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct ov32b40 *ov32b40 = to_ov32b40(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(ov32b40->dev);
+	if (ret)
+		return ret;
+
+	ret = cci_write(ov32b40->regmap, OV32B40_REG_SOFTWARE_RESET, 0x01, NULL);
+	if (!ret) {
+		usleep_range(5000, 6000);
+		ret = cci_multi_reg_write(ov32b40->regmap, ov32b40_init_regs,
+					  ARRAY_SIZE(ov32b40_init_regs), NULL);
+	}
+	if (!ret)
+		ret = cci_multi_reg_write(ov32b40->regmap, ov32b40_3264x2448_regs,
+					  ARRAY_SIZE(ov32b40_3264x2448_regs), NULL);
+	if (!ret)
+		ret = __v4l2_ctrl_handler_setup(&ov32b40->ctrls);
+	if (!ret)
+		ret = cci_write(ov32b40->regmap, OV32B40_REG_MODE_SELECT,
+				OV32B40_MODE_STREAMING, NULL);
+	if (ret) {
+		dev_err(ov32b40->dev, "failed to start streaming: %d\n", ret);
+		pm_runtime_put(ov32b40->dev);
+	}
+	return ret;
+}
+
+static int ov32b40_disable_streams(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				   u32 pad, u64 streams_mask)
+{
+	struct ov32b40 *ov32b40 = to_ov32b40(sd);
+	int ret;
+
+	ret = cci_write(ov32b40->regmap, OV32B40_REG_MODE_SELECT, OV32B40_MODE_STANDBY, NULL);
+	pm_runtime_put(ov32b40->dev);
+	return ret;
+}
+
+static void ov32b40_fill_format(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = OV32B40_WIDTH;
+	fmt->height = OV32B40_HEIGHT;
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int ov32b40_set_format(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			      struct v4l2_subdev_format *fmt)
+{
+	ov32b40_fill_format(&fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	return 0;
+}
+
+static int ov32b40_enum_mbus_code(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	return 0;
+}
+
+static int ov32b40_enum_frame_size(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+	fse->min_width = OV32B40_WIDTH;
+	fse->max_width = OV32B40_WIDTH;
+	fse->min_height = OV32B40_HEIGHT;
+	fse->max_height = OV32B40_HEIGHT;
+	return 0;
+}
+
+static int ov32b40_get_selection(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = OV32B40_WIDTH * 2;
+		sel->r.height = OV32B40_HEIGHT * 2;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int ov32b40_init_state(struct v4l2_subdev *sd, struct v4l2_subdev_state *state)
+{
+	ov32b40_fill_format(v4l2_subdev_state_get_format(state, 0));
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops ov32b40_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops ov32b40_pad_ops = {
+	.enum_mbus_code = ov32b40_enum_mbus_code,
+	.enum_frame_size = ov32b40_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = ov32b40_set_format,
+	.get_selection = ov32b40_get_selection,
+	.enable_streams = ov32b40_enable_streams,
+	.disable_streams = ov32b40_disable_streams,
+};
+
+static const struct v4l2_subdev_ops ov32b40_subdev_ops = {
+	.video = &ov32b40_video_ops,
+	.pad = &ov32b40_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops ov32b40_internal_ops = {
+	.init_state = ov32b40_init_state,
+};
+
+static int ov32b40_power_on(struct device *dev)
+{
+	struct ov32b40 *ov32b40 = to_ov32b40(dev_get_drvdata(dev));
+	int ret;
+
+	gpiod_set_value_cansleep(ov32b40->reset_gpio, 1);
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ov32b40->supplies), ov32b40->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(ov32b40->xvclk);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(ov32b40->supplies), ov32b40->supplies);
+		return ret;
+	}
+
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ov32b40->reset_gpio, 0);
+	usleep_range(5000, 6000);
+	return 0;
+}
+
+static int ov32b40_power_off(struct device *dev)
+{
+	struct ov32b40 *ov32b40 = to_ov32b40(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(ov32b40->reset_gpio, 1);
+	clk_disable_unprepare(ov32b40->xvclk);
+	regulator_bulk_disable(ARRAY_SIZE(ov32b40->supplies), ov32b40->supplies);
+	return 0;
+}
+
+static int ov32b40_check_hwcfg(struct ov32b40 *ov32b40)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *fwnode;
+	int ret;
+
+	fwnode = fwnode_graph_get_next_endpoint(dev_fwnode(ov32b40->dev), NULL);
+	if (!fwnode)
+		return dev_err_probe(ov32b40->dev, -ENXIO, "endpoint node not found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(fwnode, &ep);
+	fwnode_handle_put(fwnode);
+	if (ret)
+		return dev_err_probe(ov32b40->dev, ret, "failed to parse endpoint\n");
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 4)
+		ret = dev_err_probe(ov32b40->dev, -EINVAL, "only 4 data lanes are supported\n");
+	else if (ep.nr_of_link_frequencies != 1 ||
+		 ep.link_frequencies[0] != OV32B40_LINK_FREQ)
+		ret = dev_err_probe(ov32b40->dev, -EINVAL, "link-frequencies must be <%lld>\n",
+				    OV32B40_LINK_FREQ);
+
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int ov32b40_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct ov32b40 *ov32b40;
+	unsigned long rate;
+	u64 id;
+	int ret, i;
+
+	ov32b40 = devm_kzalloc(dev, sizeof(*ov32b40), GFP_KERNEL);
+	if (!ov32b40)
+		return -ENOMEM;
+	ov32b40->dev = dev;
+
+	v4l2_i2c_subdev_init(&ov32b40->sd, client, &ov32b40_subdev_ops);
+	ov32b40->sd.internal_ops = &ov32b40_internal_ops;
+
+	ret = ov32b40_check_hwcfg(ov32b40);
+	if (ret)
+		return ret;
+
+	ov32b40->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(ov32b40->regmap))
+		return dev_err_probe(dev, PTR_ERR(ov32b40->regmap), "failed to init CCI\n");
+
+	ov32b40->xvclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(ov32b40->xvclk))
+		return dev_err_probe(dev, PTR_ERR(ov32b40->xvclk), "failed to get XVCLK\n");
+	rate = clk_get_rate(ov32b40->xvclk);
+	if (rate != OV32B40_XVCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL, "XVCLK is %lu Hz, need 24 MHz\n", rate);
+
+	for (i = 0; i < ARRAY_SIZE(ov32b40_supply_names); i++)
+		ov32b40->supplies[i].supply = ov32b40_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ov32b40->supplies), ov32b40->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supplies\n");
+
+	ov32b40->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ov32b40->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ov32b40->reset_gpio), "failed to get reset\n");
+
+	ret = ov32b40_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = cci_read(ov32b40->regmap, OV32B40_REG_CHIP_ID, &id, NULL);
+	if (ret || id != OV32B40_CHIP_ID) {
+		ret = dev_err_probe(dev, ret ?: -ENODEV, "chip id 0x%llx, expected 0x%x\n",
+				    id, OV32B40_CHIP_ID);
+		goto err_power_off;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = ov32b40_init_controls(ov32b40);
+	if (ret)
+		goto err_pm;
+
+	ov32b40->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	ov32b40->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	ov32b40->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&ov32b40->sd.entity, 1, &ov32b40->pad);
+	if (ret)
+		goto err_ctrls;
+
+	ov32b40->sd.state_lock = ov32b40->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&ov32b40->sd);
+	if (ret)
+		goto err_entity;
+
+	ret = v4l2_async_register_subdev_sensor(&ov32b40->sd);
+	if (ret)
+		goto err_subdev;
+
+	pm_runtime_idle(dev);
+	return 0;
+
+err_subdev:
+	v4l2_subdev_cleanup(&ov32b40->sd);
+err_entity:
+	media_entity_cleanup(&ov32b40->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&ov32b40->ctrls);
+err_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_power_off:
+	ov32b40_power_off(dev);
+	return ret;
+}
+
+static void ov32b40_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov32b40 *ov32b40 = to_ov32b40(sd);
+
+	v4l2_async_unregister_subdev(sd);
