+// SPDX-License-Identifier: GPL-2.0
+/*
+ * OmniVision OV50D40 image sensor driver.
+ *
+ * One 2x2-binned mode, 4096x3072 RAW10 at 30 fps over four MIPI D-PHY
+ * lanes at 1902 Mbps, from a 24 MHz XVCLK.
+ *
+ * The register settings come from the GPL-2.0 MediaTek imgsensor driver
+ * for this sensor on MT6878 (ov50d40_mipi_raw, HelloVolla
+ * android_kernel_modules_volla_mt6878); PLL, timing and window settings
+ * match the same driver in the CMF Phone 2 Pro (MT6878) kernel modules.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define OV50D40_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define OV50D40_MODE_STANDBY		0x00
+#define OV50D40_MODE_STREAMING		0x01
+#define OV50D40_REG_SOFTWARE_RESET	CCI_REG8(0x0103)
+#define OV50D40_REG_CHIP_ID		CCI_REG24(0x300a)
+#define OV50D40_CHIP_ID			0x565044
+#define OV50D40_REG_EXPOSURE		CCI_REG24(0x3500)
+#define OV50D40_REG_ANALOG_GAIN		CCI_REG16(0x3508)
+#define OV50D40_REG_VTS			CCI_REG16(0x380e)
+#define OV50D40_REG_TEST_PATTERN	CCI_REG8(0x50c1)
+#define OV50D40_TEST_PATTERN_ENABLE	0x81
+
+#define OV50D40_XVCLK_FREQ		24000000
+/* 1902 Mbps per lane */
+#define OV50D40_LINK_FREQ		951000000LL
+/* HTS 425 at the 99.96 MHz system clock: 4.25 us per line, 5100 pixel periods */
+#define OV50D40_PIXEL_RATE		1199520000LL
+#define OV50D40_WIDTH			4096
+#define OV50D40_HEIGHT			3072
+#define OV50D40_LINE_LENGTH		5100
+#define OV50D40_VTS			7840
+#define OV50D40_VTS_MAX			0xffff
+#define OV50D40_EXPOSURE_MARGIN		22
+#define OV50D40_EXPOSURE_MIN		8
+#define OV50D40_EXPOSURE_DEFAULT	0x1dc4
+/* 0x3508[4:0].0x3509[7:1], 0x0100 = 1x */
+#define OV50D40_ANA_GAIN_MIN		0x0100
+#define OV50D40_ANA_GAIN_MAX		0x0f80
+#define OV50D40_ANA_GAIN_DEFAULT	0x0100
+
+static const char * const ov50d40_supply_names[] = {
+	"dovdd",	/* 1.8 V interface */
+	"avdd",		/* 2.8 V analogue */
+	"dvdd",		/* 1.2 V core */
+};
+
+static const s64 ov50d40_link_freqs[] = { OV50D40_LINK_FREQ };
+
+static const char * const ov50d40_test_pattern_menu[] = {
+	"Disabled",
+	"Colour Bars",
+};
