+struct ov50d40 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct clk *xvclk;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(ov50d40_supply_names)];
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+};
+
+static inline struct ov50d40 *to_ov50d40(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct ov50d40, sd);
+}
+
+static int ov50d40_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ov50d40 *ov50d40 = container_of(ctrl->handler, struct ov50d40, ctrls);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		int max = OV50D40_HEIGHT + ctrl->val - OV50D40_EXPOSURE_MARGIN;
+
+		__v4l2_ctrl_modify_range(ov50d40->exposure, OV50D40_EXPOSURE_MIN, max, 1,
+					 min(ov50d40->exposure->val, max));
+	}
+
+	if (!pm_runtime_get_if_in_use(ov50d40->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(ov50d40->regmap, OV50D40_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(ov50d40->regmap, OV50D40_REG_ANALOG_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(ov50d40->regmap, OV50D40_REG_VTS, OV50D40_HEIGHT + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(ov50d40->regmap, OV50D40_REG_TEST_PATTERN,
+			  ctrl->val ? OV50D40_TEST_PATTERN_ENABLE : 0, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(ov50d40->dev);
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops ov50d40_ctrl_ops = {
+	.s_ctrl = ov50d40_set_ctrl,
+};
