+static int ov50d40_init_controls(struct ov50d40 *ov50d40)
+{
+	struct v4l2_ctrl_handler *hdl = &ov50d40->ctrls;
+	const struct v4l2_ctrl_ops *ops = &ov50d40_ctrl_ops;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	int vblank = OV50D40_VTS - OV50D40_HEIGHT;
+	int hblank = OV50D40_LINE_LENGTH - OV50D40_WIDTH;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(ov50d40->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 9);
+
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE, OV50D40_PIXEL_RATE,
+			  OV50D40_PIXEL_RATE, 1, OV50D40_PIXEL_RATE);
+	ctrl = v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				      ov50d40_link_freqs);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	ov50d40->vblank = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK, vblank,
+					    OV50D40_VTS_MAX - OV50D40_HEIGHT, 1, vblank);
+	ctrl = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK, hblank, hblank, 1, hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	ov50d40->exposure = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE,
+					      OV50D40_EXPOSURE_MIN,
+					      OV50D40_VTS - OV50D40_EXPOSURE_MARGIN,
+					      1, OV50D40_EXPOSURE_DEFAULT);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, OV50D40_ANA_GAIN_MIN,
+			  OV50D40_ANA_GAIN_MAX, 1, OV50D40_ANA_GAIN_DEFAULT);
+	v4l2_ctrl_new_std_menu_items(hdl, ops, V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(ov50d40_test_pattern_menu) - 1, 0, 0,
+				     ov50d40_test_pattern_menu);
+	v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+
+	ov50d40->sd.ctrl_handler = hdl;
+	return 0;
+}
+
+static int ov50d40_enable_streams(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct ov50d40 *ov50d40 = to_ov50d40(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(ov50d40->dev);
+	if (ret)
+		return ret;
+
+	ret = cci_write(ov50d40->regmap, OV50D40_REG_SOFTWARE_RESET, 0x01, NULL);
+	if (!ret) {
+		usleep_range(10000, 11000);
+		ret = cci_multi_reg_write(ov50d40->regmap, ov50d40_init_regs,
+					  ARRAY_SIZE(ov50d40_init_regs), NULL);
+	}
+	if (!ret)
+		ret = cci_multi_reg_write(ov50d40->regmap, ov50d40_4096x3072_regs,
+					  ARRAY_SIZE(ov50d40_4096x3072_regs), NULL);
+	if (!ret)
+		ret = __v4l2_ctrl_handler_setup(&ov50d40->ctrls);
+	if (!ret)
+		ret = cci_write(ov50d40->regmap, OV50D40_REG_MODE_SELECT,
+				OV50D40_MODE_STREAMING, NULL);
+	if (ret) {
+		dev_err(ov50d40->dev, "failed to start streaming: %d\n", ret);
+		pm_runtime_put(ov50d40->dev);
+	}
+	return ret;
+}
+
+static int ov50d40_disable_streams(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				   u32 pad, u64 streams_mask)
+{
+	struct ov50d40 *ov50d40 = to_ov50d40(sd);
+	int ret;
+
+	ret = cci_write(ov50d40->regmap, OV50D40_REG_MODE_SELECT, OV50D40_MODE_STANDBY, NULL);
+	pm_runtime_put(ov50d40->dev);
+	return ret;
+}
+
+static void ov50d40_fill_format(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = OV50D40_WIDTH;
+	fmt->height = OV50D40_HEIGHT;
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int ov50d40_set_format(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			      struct v4l2_subdev_format *fmt)
+{
+	ov50d40_fill_format(&fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	return 0;
+}
+
+static int ov50d40_enum_mbus_code(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	return 0;
+}
+
+static int ov50d40_enum_frame_size(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+	fse->min_width = OV50D40_WIDTH;
+	fse->max_width = OV50D40_WIDTH;
+	fse->min_height = OV50D40_HEIGHT;
+	fse->max_height = OV50D40_HEIGHT;
+	return 0;
+}
+
+static int ov50d40_get_selection(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = OV50D40_WIDTH * 2;
+		sel->r.height = OV50D40_HEIGHT * 2;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int ov50d40_init_state(struct v4l2_subdev *sd, struct v4l2_subdev_state *state)
+{
+	ov50d40_fill_format(v4l2_subdev_state_get_format(state, 0));
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops ov50d40_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops ov50d40_pad_ops = {
+	.enum_mbus_code = ov50d40_enum_mbus_code,
+	.enum_frame_size = ov50d40_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = ov50d40_set_format,
+	.get_selection = ov50d40_get_selection,
+	.enable_streams = ov50d40_enable_streams,
+	.disable_streams = ov50d40_disable_streams,
+};
+
+static const struct v4l2_subdev_ops ov50d40_subdev_ops = {
+	.video = &ov50d40_video_ops,
+	.pad = &ov50d40_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops ov50d40_internal_ops = {
+	.init_state = ov50d40_init_state,
+};
+
+static int ov50d40_power_on(struct device *dev)
+{
+	struct ov50d40 *ov50d40 = to_ov50d40(dev_get_drvdata(dev));
+	int ret;
+
+	gpiod_set_value_cansleep(ov50d40->reset_gpio, 1);
+	gpiod_set_value_cansleep(ov50d40->powerdown_gpio, 1);
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ov50d40->supplies), ov50d40->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(ov50d40->xvclk);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(ov50d40->supplies), ov50d40->supplies);
+		return ret;
+	}
+
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(ov50d40->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(ov50d40->reset_gpio, 0);
+	usleep_range(5000, 6000);
+	return 0;
+}
+
+static int ov50d40_power_off(struct device *dev)
+{
+	struct ov50d40 *ov50d40 = to_ov50d40(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(ov50d40->reset_gpio, 1);
+	gpiod_set_value_cansleep(ov50d40->powerdown_gpio, 1);
+	clk_disable_unprepare(ov50d40->xvclk);
+	regulator_bulk_disable(ARRAY_SIZE(ov50d40->supplies), ov50d40->supplies);
+	return 0;
+}
+
+static int ov50d40_check_hwcfg(struct ov50d40 *ov50d40)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *fwnode;
+	int ret;
+
+	fwnode = fwnode_graph_get_next_endpoint(dev_fwnode(ov50d40->dev), NULL);
+	if (!fwnode)
+		return dev_err_probe(ov50d40->dev, -ENXIO, "endpoint node not found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(fwnode, &ep);
+	fwnode_handle_put(fwnode);
+	if (ret)
+		return dev_err_probe(ov50d40->dev, ret, "failed to parse endpoint\n");
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 4)
+		ret = dev_err_probe(ov50d40->dev, -EINVAL, "only 4 data lanes are supported\n");
+	else if (ep.nr_of_link_frequencies != 1 ||
+		 ep.link_frequencies[0] != OV50D40_LINK_FREQ)
+		ret = dev_err_probe(ov50d40->dev, -EINVAL, "link-frequencies must be <%lld>\n",
+				    OV50D40_LINK_FREQ);
+
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int ov50d40_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct ov50d40 *ov50d40;
+	unsigned long rate;
+	u64 id;
+	int ret, i;
+
+	ov50d40 = devm_kzalloc(dev, sizeof(*ov50d40), GFP_KERNEL);
+	if (!ov50d40)
+		return -ENOMEM;
+	ov50d40->dev = dev;
+
+	v4l2_i2c_subdev_init(&ov50d40->sd, client, &ov50d40_subdev_ops);
+	ov50d40->sd.internal_ops = &ov50d40_internal_ops;
+
+	ret = ov50d40_check_hwcfg(ov50d40);
+	if (ret)
+		return ret;
+
+	ov50d40->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(ov50d40->regmap))
+		return dev_err_probe(dev, PTR_ERR(ov50d40->regmap), "failed to init CCI\n");
+
+	ov50d40->xvclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(ov50d40->xvclk))
+		return dev_err_probe(dev, PTR_ERR(ov50d40->xvclk), "failed to get XVCLK\n");
+	rate = clk_get_rate(ov50d40->xvclk);
+	if (rate != OV50D40_XVCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL, "XVCLK is %lu Hz, need 24 MHz\n", rate);
+
+	for (i = 0; i < ARRAY_SIZE(ov50d40_supply_names); i++)
+		ov50d40->supplies[i].supply = ov50d40_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ov50d40->supplies), ov50d40->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supplies\n");
+
+	ov50d40->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ov50d40->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ov50d40->reset_gpio), "failed to get reset\n");
+	ov50d40->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown", GPIOD_OUT_HIGH);
+	if (IS_ERR(ov50d40->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(ov50d40->powerdown_gpio),
+				     "failed to get powerdown\n");
+
+	ret = ov50d40_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = cci_read(ov50d40->regmap, OV50D40_REG_CHIP_ID, &id, NULL);
+	if (ret || id != OV50D40_CHIP_ID) {
+		ret = dev_err_probe(dev, ret ?: -ENODEV, "chip id 0x%llx, expected 0x%x\n",
+				    id, OV50D40_CHIP_ID);
+		goto err_power_off;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = ov50d40_init_controls(ov50d40);
+	if (ret)
+		goto err_pm;
+
+	ov50d40->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	ov50d40->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	ov50d40->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&ov50d40->sd.entity, 1, &ov50d40->pad);
+	if (ret)
+		goto err_ctrls;
+
+	ov50d40->sd.state_lock = ov50d40->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&ov50d40->sd);
+	if (ret)
+		goto err_entity;
+
+	ret = v4l2_async_register_subdev_sensor(&ov50d40->sd);
+	if (ret)
+		goto err_subdev;
+
+	pm_runtime_idle(dev);
+	return 0;
+
+err_subdev:
+	v4l2_subdev_cleanup(&ov50d40->sd);
+err_entity:
+	media_entity_cleanup(&ov50d40->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&ov50d40->ctrls);
+err_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_power_off:
+	ov50d40_power_off(dev);
+	return ret;
+}
+
+static void ov50d40_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov50d40 *ov50d40 = to_ov50d40(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&ov50d40->ctrls);
+	pm_runtime_disable(ov50d40->dev);
+	if (!pm_runtime_status_suspended(ov50d40->dev))
+		ov50d40_power_off(ov50d40->dev);
+	pm_runtime_set_suspended(ov50d40->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(ov50d40_pm_ops, ov50d40_power_off, ov50d40_power_on, NULL);
+
+static const struct of_device_id ov50d40_of_match[] = {
+	{ .compatible = "ovti,ov50d40" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ov50d40_of_match);
+
+static struct i2c_driver ov50d40_driver = {
+	.driver = {
+		.name = "ov50d40",
+		.of_match_table = ov50d40_of_match,
+		.pm = pm_ptr(&ov50d40_pm_ops),
+	},
+	.probe = ov50d40_probe,
+	.remove = ov50d40_remove,
+};
+module_i2c_driver(ov50d40_driver);
+
+MODULE_DESCRIPTION("OmniVision OV50D40 image sensor driver");
+MODULE_LICENSE("GPL");
