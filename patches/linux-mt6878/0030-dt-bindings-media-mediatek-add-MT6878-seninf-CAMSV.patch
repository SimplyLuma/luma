From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <builds@project-luma.local>
Date: Mon, 19 Oct 2026 21:05:58 -0400
Subject: [PATCH 30/33] dt-bindings: media: mediatek: add MT6878 seninf + CAMSV

The MT6878 CSI-2 receiver (seninf, CSI PHY 3.1) feeding a CAMSV DMA
engine, used for raw Bayer capture without the ISP.
---
 .../mediatek,mt6878-seninf-camsv.yaml         | 106 ++++++++++++++++++
 1 file changed, 106 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/mediatek/mediatek,mt6878-seninf-camsv.yaml

diff --git a/Documentation/devicetree/bindings/media/mediatek/mediatek,mt6878-seninf-camsv.yaml b/Documentation/devicetree/bindings/media/mediatek/mediatek,mt6878-seninf-camsv.yaml
new file mode 100644
index 000000000..1e3983851
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/mediatek/mediatek,mt6878-seninf-camsv.yaml
@@ -0,0 +1,106 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/mediatek/mediatek,mt6878-seninf-camsv.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6878 seninf + CAMSV raw capture
+
+maintainers:
+  - Project Luma <builds@project-luma.local>
+
+description:
+  The CSI-2 receiver (seninf, CSI PHY 3.1) feeding a CAMSV DMA engine, used
+  for raw Bayer capture without the ISP. CAMSV writes through the MM M4U.
+
+properties:
+  compatible:
+    const: mediatek,mt6878-seninf-camsv
+
+  reg:
+    items:
+      - description: seninf top, SENINF blocks, muxes and cammux
+      - description: CSI PHYs and CSI-2 MACs
+      - description: camsys_main
+      - description: CAMSV central, outer and inner pages
+      - description: CAMSV DMA, outer and inner pages
+      - description: CAMSV command queue
+      - description: camsys_mraw
+      - description: cam_vcore
+
+  reg-names:
+    items:
+      - const: seninf
+      - const: csi
+      - const: camsys
+      - const: camsv
+      - const: camsv-dma
+      - const: camsv-cq
+      - const: camsys-mraw
+      - const: cam-vcore
+
+  interrupts:
+    maxItems: 1
+    description: CAMSV frame done
+
+  power-domains:
+    items:
+      - description: CAM_MAIN
+      - description: CSI_RX
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    unevaluatedProperties: false
+    description: CSI-2 input
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          bus-type:
+            const: 1
+          data-lanes:
+            minItems: 1
+            maxItems: 3
+
+        required:
+          - bus-type
+          - data-lanes
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - power-domains
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/power/mediatek,mt6878-power.h>
+
+    camera-capture@1a00e000 {
+        compatible = "mediatek,mt6878-seninf-camsv";
+        reg = <0x1a00e000 0x18000>, <0x11c80000 0x30000>,
+              <0x1a000000 0x1000>, <0x1a101000 0x9000>,
+              <0x1a111000 0x9000>, <0x1a121000 0x1000>,
+              <0x1a170000 0x1000>, <0x1b204000 0x1000>;
+        reg-names = "seninf", "csi", "camsys", "camsv", "camsv-dma",
+                    "camsv-cq", "camsys-mraw", "cam-vcore";
+        interrupts = <GIC_SPI 654 IRQ_TYPE_LEVEL_HIGH 0>;
+        power-domains = <&spm MT6878_POWER_DOMAIN_CAM_MAIN>,
+                        <&spm MT6878_POWER_DOMAIN_CSI_RX>;
+
+        port {
+            endpoint {
+                remote-endpoint = <&sensor_out>;
+                bus-type = <1>;
+                data-lanes = <1 2 3>;
+            };
+        };
+    };
-- 
