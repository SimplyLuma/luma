From: Project Luma <builds@project-luma.local>
Date: Tue, 22 Sep 2026 22:30:00 +0000
Subject: [PATCH] housekeeping: Name the app systemd-oomd stopped, once

The memory notice said "An application was using a lot of memory" for any
app without a desktop entry matching upstream's parse, posted as
gnome-settings-daemon, and every PropertiesChanged signal carrying
Result=oom-kill showed another banner.

Resolve the stopped unit to its app (every app-*.scope/service and dbus-*
form, \xNN escapes decoded; an app ID with no desktop entry still gives its
last component), describe anything else plainly ("A background task",
"A terminal tab"), post from Monitor (io.luma.Monitor) with the stopped
app's icon, and fold stops within 10 seconds into one notice that is
updated in place ("Stage and 1 other app were stopped because memory was
full.").
---
diff --git a/plugins/housekeeping/gsd-oom-notice-test.c b/plugins/housekeeping/gsd-oom-notice-test.c
new file mode 100644
index 0000000..3071e92
--- /dev/null
+++ b/plugins/housekeeping/gsd-oom-notice-test.c
@@ -0,0 +1,215 @@
+/*
+ * Copyright (C) 2026 Project Luma
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+/* The cases are the two real kills on a Luma laptop on 2026-09-22:
+ * app-org.chromium.Chromium-10478.scope at 14:23 and
+ * luma-dev-env-20260922192102.service at 14:36. */
+
+#include "config.h"
+
+#include <glib.h>
+#include <glib/gstdio.h>
+
+#include "gsd-oom-notice.h"
+
+#define SECOND G_USEC_PER_SEC
+
+static char *data_dir;
+
+static void
+assert_describes (const char     *unit,
+                  GsdOomKillKind  expected_kind,
+                  const char     *expected_name,
+                  const char     *expected_desktop_id)
+{
+        g_autofree char *name = NULL;
+        g_autofree char *desktop_id = NULL;
+        GsdOomKillKind kind = -1;
+
+        name = gsd_oom_unit_describe (unit, &kind, &desktop_id);
+        g_test_message ("%s -> %s (%d, %s)", unit, name, kind, desktop_id);
+        g_assert_cmpstr (name, ==, expected_name);
+        g_assert_cmpint (kind, ==, expected_kind);
+        g_assert_cmpstr (desktop_id, ==, expected_desktop_id);
+}
+
+static void
+test_app_is_named (void)
+{
+        /* Every way systemd names an app's unit finds its desktop entry. */
+        assert_describes ("app-org.projectluma.Stage-10478.scope",
+                          GSD_OOM_KILL_APP, "Stage", "org.projectluma.Stage.desktop");
+        assert_describes ("app-gnome-org.projectluma.Stage-10478.scope",
+                          GSD_OOM_KILL_APP, "Stage", "org.projectluma.Stage.desktop");
+        assert_describes ("app-flatpak-org.projectluma.Stage-1078923878.scope",
+                          GSD_OOM_KILL_APP, "Stage", "org.projectluma.Stage.desktop");
+        assert_describes ("app-org.projectluma.Stage@a1b2c3.service",
+                          GSD_OOM_KILL_APP, "Stage", "org.projectluma.Stage.desktop");
+        assert_describes ("dbus-:1.2-org.projectluma.Stage@0.service",
+                          GSD_OOM_KILL_APP, "Stage", "org.projectluma.Stage.desktop");
+        /* systemd escapes "-" in an app ID as \x2d. */
+        assert_describes ("app-org.projectluma.Installed.rpm\\x2dstage\\x2dbeta-77.scope",
+                          GSD_OOM_KILL_APP, "Stage Beta",
+                          "org.projectluma.Installed.rpm-stage-beta.desktop");
+        /* 14:23: no desktop entry, but the app ID still says what it was. */
+        assert_describes ("app-org.chromium.Chromium-10478.scope",
+                          GSD_OOM_KILL_APP, "Chromium", NULL);
+}
+
+static void
+test_non_app_is_described (void)
+{
+        /* 14:36: a systemd-run tool is not an app and gets no made-up name. */
+        assert_describes ("luma-dev-env-20260922192102.service",
+                          GSD_OOM_KILL_TASK, "A background task", NULL);
+        assert_describes ("luma-dev-run-live-preview.sh-20260922181857.service",
+                          GSD_OOM_KILL_TASK, "A background task", NULL);
+        assert_describes ("evolution-calendar-factory.service",
+                          GSD_OOM_KILL_TASK, "A background task", NULL);
+        assert_describes ("vte-spawn-3f0c2a5e-8d9b-4b53-9b1e-6c1f0e2d7a44.scope",
+                          GSD_OOM_KILL_TERMINAL, "A terminal tab", NULL);
+        assert_describes ("app-gnome-mystery-4242.scope",
+                          GSD_OOM_KILL_UNNAMED_APP, "An app", NULL);
+}
+
+static void
+assert_body (GsdOomNotice *notice,
+             const char   *expected)
+{
+        g_autofree char *summary = NULL;
+        g_autofree char *body = NULL;
+
+        gsd_oom_notice_format (notice, &summary, &body);
+        g_assert_cmpstr (summary, ==, "Memory Full");
+        g_assert_cmpstr (body, ==, expected);
+}
+
+static void
+test_single_kill (void)
+{
+        g_autoptr(GsdOomNotice) notice = gsd_oom_notice_new ();
+
+        g_assert_cmpint (gsd_oom_notice_add (notice, "app-org.projectluma.Stage-10478.scope", 100 * SECOND),
+                         ==, GSD_OOM_NOTICE_NEW);
+        assert_body (notice, "Stage was stopped because memory was full.");
+        g_assert_cmpstr (gsd_oom_notice_get_lead_desktop_id (notice), ==, "org.projectluma.Stage.desktop");
+}
+
+static void
+test_repeats_collapse (void)
+{
+        g_autoptr(GsdOomNotice) notice = gsd_oom_notice_new ();
+        gint64 t = 1000 * SECOND;
+
+        g_assert_cmpint (gsd_oom_notice_add (notice, "app-org.chromium.Chromium-10478.scope", t),
+                         ==, GSD_OOM_NOTICE_NEW);
+        /* The same stop, signalled again: nothing new to show. */
+        g_assert_cmpint (gsd_oom_notice_add (notice, "app-org.chromium.Chromium-10478.scope", t + SECOND / 5),
+                         ==, GSD_OOM_NOTICE_DUPLICATE);
+        g_assert_cmpuint (gsd_oom_notice_get_count (notice), ==, 1);
+        assert_body (notice, "Chromium was stopped because memory was full.");
+
+        /* A second app within the window joins the same notice, named app first. */
+        g_assert_cmpint (gsd_oom_notice_add (notice, "app-org.projectluma.Stage-2002.scope", t + 3 * SECOND),
+                         ==, GSD_OOM_NOTICE_UPDATED);
+        assert_body (notice, "Chromium and 1 other app were stopped because memory was full.");
+        g_assert_cmpint (gsd_oom_notice_add (notice, "app-flatpak-org.projectluma.Stage-99.scope", t + 5 * SECOND),
+                         ==, GSD_OOM_NOTICE_UPDATED);
+        assert_body (notice, "Chromium and 2 other apps were stopped because memory was full.");
+        g_assert_cmpint (gsd_oom_notice_add (notice, "luma-dev-env-20260922192102.service", t + 8 * SECOND),
+                         ==, GSD_OOM_NOTICE_UPDATED);
+        assert_body (notice, "Chromium and 3 others were stopped because memory was full.");
+
+        /* Well after the last kill a stop is news again. */
+        g_assert_cmpint (gsd_oom_notice_add (notice, "luma-dev-env-20260922192102.service", t + 30 * SECOND),
+                         ==, GSD_OOM_NOTICE_NEW);
+        g_assert_cmpuint (gsd_oom_notice_get_count (notice), ==, 1);
+        assert_body (notice, "A background task was stopped because memory was full.");
+        g_assert_null (gsd_oom_notice_get_lead_desktop_id (notice));
+}
+
+static void
+test_named_app_leads (void)
+{
+        g_autoptr(GsdOomNotice) notice = gsd_oom_notice_new ();
+
+        gsd_oom_notice_add (notice, "luma-dev-env-20260922192102.service", 0);
+        gsd_oom_notice_add (notice, "app-org.projectluma.Stage-10478.scope", SECOND);
+        assert_body (notice, "Stage and 1 other were stopped because memory was full.");
+
+        g_clear_pointer (&notice, gsd_oom_notice_free);
+        notice = gsd_oom_notice_new ();
+        gsd_oom_notice_add (notice, "luma-dev-env-1.service", 0);
+        gsd_oom_notice_add (notice, "luma-dev-env-2.service", SECOND);
+        assert_body (notice, "2 background tasks were stopped because memory was full.");
+}
+
+static void
+write_desktop_entry (const char *dir,
+                     const char *id,
+                     const char *name)
+{
+        g_autofree char *path = g_build_filename (dir, id, NULL);
+        g_autofree char *contents = g_strdup_printf ("[Desktop Entry]\nType=Application\n"
+                                                     "Name=%s\nExec=true\nIcon=%s\n",
+                                                     name, "application-x-executable");
+        g_autoptr(GError) error = NULL;
+
+        g_file_set_contents (path, contents, -1, &error);
+        g_assert_no_error (error);
+}
+
+int
+main (int argc, char **argv)
+{
+        g_autoptr(GError) error = NULL;
+        g_autofree char *apps = NULL;
+        g_autofree char *home = NULL;
+        int result;
+
+        /* Only this test's desktop entries exist, before GIO reads any. */
+        data_dir = g_dir_make_tmp ("gsd-oom-notice-XXXXXX", &error);
+        g_assert_no_error (error);
+        apps = g_build_filename (data_dir, "applications", NULL);
+        home = g_build_filename (data_dir, "home", NULL);
+        g_mkdir_with_parents (apps, 0700);
+        g_mkdir_with_parents (home, 0700);
+        write_desktop_entry (apps, "org.projectluma.Stage.desktop", "Stage");
+        write_desktop_entry (apps, "org.projectluma.Installed.rpm-stage-beta.desktop", "Stage Beta");
+        g_setenv ("XDG_DATA_DIRS", data_dir, TRUE);
+        g_setenv ("XDG_DATA_HOME", home, TRUE);
+        g_setenv ("LC_ALL", "C", TRUE);
+
+        g_test_init (&argc, &argv, NULL);
+        g_test_add_func ("/luma/oom-notice/app-is-named", test_app_is_named);
+        g_test_add_func ("/luma/oom-notice/non-app-is-described", test_non_app_is_described);
+        g_test_add_func ("/luma/oom-notice/single-kill", test_single_kill);
+        g_test_add_func ("/luma/oom-notice/repeats-collapse", test_repeats_collapse);
+        g_test_add_func ("/luma/oom-notice/named-app-leads", test_named_app_leads);
+        result = g_test_run ();
+
+        for (const char * const *id = (const char * const[]) { "org.projectluma.Stage.desktop",
+                                                               "org.projectluma.Installed.rpm-stage-beta.desktop",
+                                                               NULL }; *id; id++) {
+                g_autofree char *path = g_build_filename (apps, *id, NULL);
+                g_remove (path);
+        }
+        g_rmdir (apps);
+        g_rmdir (home);
+        g_rmdir (data_dir);
+        return result;
+}
diff --git a/plugins/housekeeping/gsd-oom-notice.c b/plugins/housekeeping/gsd-oom-notice.c
new file mode 100644
index 0000000..08b3682
--- /dev/null
+++ b/plugins/housekeeping/gsd-oom-notice.c
@@ -0,0 +1,311 @@
+/*
+ * Copyright (C) 2026 Project Luma
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+/* What to say when systemd-oomd stops something: which app it was, told
+ * once, however many units and property signals the stop produced. */
+
+#include "config.h"
+
+#include <string.h>
+#include <glib/gi18n.h>
+#include <gio/gdesktopappinfo.h>
+
+#include "gsd-oom-notice.h"
+
+typedef struct {
+        char           *unit;
+        char           *name;
+        char           *desktop_id;
+        GsdOomKillKind  kind;
+} OomKill;
+
+struct _GsdOomNotice {
+        GPtrArray *kills;
+        gint64     last_usec;
+};
+
+static void
+oom_kill_free (OomKill *kill)
+{
+        g_free (kill->unit);
+        g_free (kill->name);
+        g_free (kill->desktop_id);
+        g_free (kill);
+}
+
+/* systemd escapes characters in unit names as \xNN, "-" as \x2d. */
+static char *
+unescape_unit_part (const char *part)
+{
+        GString *out = g_string_new (NULL);
+
+        for (; *part; part++) {
+                if (part[0] == '\\' && part[1] == 'x' &&
+                    g_ascii_isxdigit (part[2]) && g_ascii_isxdigit (part[3])) {
+                        g_string_append_c (out, (char) (g_ascii_xdigit_value (part[2]) << 4 |
+                                                        g_ascii_xdigit_value (part[3])));
+                        part += 3;
+                } else {
+                        g_string_append_c (out, *part);
+                }
+        }
+
+        return g_string_free (out, FALSE);
+}
+
+static gboolean
+is_plain_word (const char *word)
+{
+        if (!g_ascii_isalpha (*word))
+                return FALSE;
+        for (; *word; word++) {
+                if (!g_ascii_isalnum (*word))
+                        return FALSE;
+        }
+        return TRUE;
+}
+
+/* Units are app[-<launcher>]-<app id>-<n>.scope,
+ * app[-<launcher>]-<app id>[@<n>].service or dbus-<bus>-<app id>@<n>.service.
+ * The app ID is the reverse-DNS part; the desktop entry of the same name
+ * gives the app's name. Anything else is described, not named. */
+char *
+gsd_oom_unit_describe (const char      *unit,
+                       GsdOomKillKind  *kind,
+                       char           **desktop_id)
+{
+        g_autofree char *core = NULL;
+        g_auto(GStrv) parts = NULL;
+        gboolean app_unit;
+        char *pos;
+        guint n, i;
+
+        g_return_val_if_fail (unit != NULL, NULL);
+        g_return_val_if_fail (kind != NULL, NULL);
+
+        if (desktop_id)
+                *desktop_id = NULL;
+
+        if (g_str_has_suffix (unit, ".service")) {
+                core = g_strndup (unit, strlen (unit) - strlen (".service"));
+                pos = strchr (core, '@');
+                if (pos)
+                        *pos = '\0';
+        } else if (g_str_has_suffix (unit, ".scope")) {
+                core = g_strndup (unit, strlen (unit) - strlen (".scope"));
+                /* The last part is the PID or a random number. */
+                pos = strrchr (core, '-');
+                if (pos)
+                        *pos = '\0';
+        } else {
+                core = g_strdup (unit);
+        }
+
+        parts = g_strsplit (core, "-", -1);
+        n = g_strv_length (parts);
+        app_unit = n >= 2 && g_str_equal (parts[0], "app");
+
+        for (i = n; i > 0; i--) {
+                g_autofree char *app_id = NULL;
+                g_autofree char *id = NULL;
+                g_autoptr(GDesktopAppInfo) app = NULL;
+                const char *part = parts[i - 1];
+
+                if (strchr (part, '.') == NULL && !(app_unit && i == n))
+                        continue;
+
+                app_id = unescape_unit_part (part);
+                if (*app_id == '\0')
+                        continue;
+                id = g_strconcat (app_id, ".desktop", NULL);
+                app = g_desktop_app_info_new (id);
+                if (app == NULL)
+                        continue;
+
+                *kind = GSD_OOM_KILL_APP;
+                if (desktop_id)
+                        *desktop_id = g_steal_pointer (&id);
+                return g_strdup (g_app_info_get_name (G_APP_INFO (app)));
+        }
+
+        if (g_str_has_prefix (unit, "vte-spawn-")) {
+                *kind = GSD_OOM_KILL_TERMINAL;
+                /* TRANSLATORS: starts a sentence: "A terminal tab was stopped…" */
+                return g_strdup (_("A terminal tab"));
+        }
+
+        if (app_unit) {
+                g_autofree char *app_id = unescape_unit_part (parts[n - 1]);
+                const char *last = strrchr (app_id, '.');
+
+                /* org.chromium.Chromium with no desktop entry is still "Chromium". */
+                if (last && is_plain_word (last + 1)) {
+                        *kind = GSD_OOM_KILL_APP;
+                        return g_strdup (last + 1);
+                }
+
+                *kind = GSD_OOM_KILL_UNNAMED_APP;
+                /* TRANSLATORS: starts a sentence: "An app was stopped…" */
+                return g_strdup (_("An app"));
+        }
+
+        *kind = GSD_OOM_KILL_TASK;
+        /* TRANSLATORS: starts a sentence: "A background task was stopped…" */
+        return g_strdup (_("A background task"));
+}
+
+GsdOomNotice *
+gsd_oom_notice_new (void)
+{
+        GsdOomNotice *notice = g_new0 (GsdOomNotice, 1);
+
+        notice->kills = g_ptr_array_new_with_free_func ((GDestroyNotify) oom_kill_free);
+        return notice;
+}
+
+void
+gsd_oom_notice_free (GsdOomNotice *notice)
+{
+        if (notice == NULL)
+                return;
+        g_ptr_array_unref (notice->kills);
+        g_free (notice);
+}
+
+GsdOomNoticeChange
+gsd_oom_notice_add (GsdOomNotice *notice,
+                    const char   *unit,
+                    gint64        now_usec)
+{
+        gboolean fresh;
+        OomKill *kill;
+        guint i;
+
+        fresh = notice->kills->len == 0 ||
+                now_usec - notice->last_usec > GSD_OOM_NOTICE_WINDOW_USEC;
+
+        if (fresh) {
+                g_ptr_array_set_size (notice->kills, 0);
+        } else {
+                for (i = 0; i < notice->kills->len; i++) {
+                        OomKill *seen = g_ptr_array_index (notice->kills, i);
+
+                        if (g_str_equal (seen->unit, unit))
+                                return GSD_OOM_NOTICE_DUPLICATE;
+                }
+        }
+
+        kill = g_new0 (OomKill, 1);
+        kill->unit = g_strdup (unit);
+        kill->name = gsd_oom_unit_describe (unit, &kill->kind, &kill->desktop_id);
+        g_ptr_array_add (notice->kills, kill);
+        notice->last_usec = now_usec;
+
+        return fresh ? GSD_OOM_NOTICE_NEW : GSD_OOM_NOTICE_UPDATED;
+}
+
+guint
+gsd_oom_notice_get_count (GsdOomNotice *notice)
+{
+        return notice->kills->len;
+}
+
+/* A named app leads; failing that an unnamed app; failing that the first. */
+static OomKill *
+lead_kill (GsdOomNotice *notice)
+{
+        OomKill *unnamed = NULL;
+        guint i;
+
+        for (i = 0; i < notice->kills->len; i++) {
+                OomKill *kill = g_ptr_array_index (notice->kills, i);
+
+                if (kill->kind == GSD_OOM_KILL_APP)
+                        return kill;
+                if (kill->kind == GSD_OOM_KILL_UNNAMED_APP && unnamed == NULL)
+                        unnamed = kill;
+        }
+
+        if (unnamed)
+                return unnamed;
+        return notice->kills->len > 0 ? g_ptr_array_index (notice->kills, 0) : NULL;
+}
+
+const char *
+gsd_oom_notice_get_lead_desktop_id (GsdOomNotice *notice)
+{
+        OomKill *lead = lead_kill (notice);
+
+        return lead ? lead->desktop_id : NULL;
+}
+
+void
+gsd_oom_notice_format (GsdOomNotice  *notice,
+                       char         **summary,
+                       char         **body)
+{
+        OomKill *lead = lead_kill (notice);
+        guint total = notice->kills->len;
+        guint others = total - 1;
+        gboolean others_are_apps = TRUE;
+        gboolean all_tasks = TRUE;
+        guint i;
+
+        g_return_if_fail (lead != NULL);
+
+        for (i = 0; i < total; i++) {
+                OomKill *kill = g_ptr_array_index (notice->kills, i);
+                gboolean is_app = kill->kind == GSD_OOM_KILL_APP ||
+                                  kill->kind == GSD_OOM_KILL_UNNAMED_APP;
+
+                if (kill->kind != GSD_OOM_KILL_TASK)
+                        all_tasks = FALSE;
+                if (kill != lead && !is_app)
+                        others_are_apps = FALSE;
+        }
+
+        *summary = g_strdup (_("Memory Full"));
+
+        if (others == 0) {
+                /* TRANSLATORS: %s is an app name ("Stage") or a description
+                 * ("A background task"). */
+                *body = g_strdup_printf (_("%s was stopped because memory was full."),
+                                         lead->name);
+        } else if (all_tasks) {
+                *body = g_strdup_printf (ngettext ("%u background task was stopped because memory was full.",
+                                                   "%u background tasks were stopped because memory was full.",
+                                                   total),
+                                         total);
+        } else if (lead->kind == GSD_OOM_KILL_UNNAMED_APP && others_are_apps) {
+                *body = g_strdup_printf (ngettext ("%u app was stopped because memory was full.",
+                                                   "%u apps were stopped because memory was full.",
+                                                   total),
+                                         total);
+        } else if (others_are_apps) {
+                /* TRANSLATORS: %s is an app name, %u how many more apps. */
+                *body = g_strdup_printf (ngettext ("%s and %u other app were stopped because memory was full.",
+                                                   "%s and %u other apps were stopped because memory was full.",
+                                                   others),
+                                         lead->name, others);
+        } else {
+                /* TRANSLATORS: %s is an app name or a description, %u how many more. */
+                *body = g_strdup_printf (ngettext ("%s and %u other were stopped because memory was full.",
+                                                   "%s and %u others were stopped because memory was full.",
+                                                   others),
+                                         lead->name, others);
+        }
+}
