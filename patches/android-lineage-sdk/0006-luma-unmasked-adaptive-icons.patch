+    // The host masks every application icon itself. Drawing an adaptive icon
+    // whole applies system_server's own mask, so composite its layers
+    // unmasked instead: the visible square of the larger layer canvas.
+    private Bitmap adaptiveIconToBitmap(AdaptiveIconDrawable icon) {
+        int size = icon.getIntrinsicWidth();
+        if (size <= 0 || size != icon.getIntrinsicHeight())
+            return null;
+        int inset = Math.round(size * AdaptiveIconDrawable.getExtraInsetFraction());
+        Bitmap bitmap = Bitmap.createBitmap(size, size, Config.ARGB_8888);
+        Canvas canvas = new Canvas(bitmap);
+        for (Drawable layer : new Drawable[] {icon.getBackground(), icon.getForeground()}) {
+            if (layer == null)
+                continue;
+            layer.setBounds(-inset, -inset, size + inset, size + inset);
+            layer.draw(canvas);
+        }
+        return bitmap;
+    }
