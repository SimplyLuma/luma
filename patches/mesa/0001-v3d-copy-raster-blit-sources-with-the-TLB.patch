From ed6ce1cdc23af76d4936f6119a8027684567d74e Mon Sep 17 00:00:00 2001
From: Project Luma <maintainers@projectluma.org>
Date: Mon, 2 Nov 2026 22:12:55 -0600
Subject: [PATCH 1/2] v3d: copy raster blit sources to the tiled temporary with
 the TLB

v3d_render_blit() samples a raster (linear) source through a tiled
temporary. It filled that temporary with resource_copy_region(), which
is util_resource_copy_region(): the whole source level is mapped and
(de)tiled on the CPU, after waiting for the job that renders the source.

Blits that read from a linear scanout buffer into a texture of another
format or at another offset (a compositor copying the backdrop behind a
blurred panel, for example) take this path every frame. On a Raspberry Pi
5 at 3840x2160 that was a full-screen CPU copy per blit and most of the
compositor's frame time.

Fill the temporary with a TLB load/store job instead, limited to the
tiles the blit reads. Keep the CPU copy as the fallback for sources the
TLB cannot load (multisampled, depth/stencil, non-renderable formats,
arrays and 3D).
---
 src/gallium/drivers/v3d/v3d_blit.c | 87 ++++++++++++++++++++++++++++--
 1 file changed, 82 insertions(+), 5 deletions(-)

diff --git a/src/gallium/drivers/v3d/v3d_blit.c b/src/gallium/drivers/v3d/v3d_blit.c
index c5c07d1..dd47a6e 100644
--- a/src/gallium/drivers/v3d/v3d_blit.c
+++ b/src/gallium/drivers/v3d/v3d_blit.c
@@ -83,6 +83,80 @@ v3d_blitter_save(struct v3d_context *v3d, enum v3d_blitter_op op)
         }
 }
 
+static void
+v3d_tlb_blit(struct pipe_context *pctx, struct pipe_blit_info *info);
+
+/* Copies the region a blit reads from a raster (linear) source, such as a
+ * scanout buffer, into a tiled temporary of the same size and format with a
+ * TLB load/store job. This keeps the copy on the GPU and limited to the
+ * blit's source box, instead of mapping both resources and (de)tiling the
+ * whole level on the CPU.
+ */
+static bool
+v3d_tlb_copy_raster_region(struct pipe_context *ctx,
+                           struct pipe_resource *tiled,
+                           const struct pipe_blit_info *info)
+{
+        struct v3d_context *v3d = v3d_context(ctx);
+        struct v3d_device_info *devinfo = &v3d->screen->devinfo;
+        struct pipe_resource *src = info->src.resource;
+        int width = u_minify(src->width0, info->src.level);
+        int height = u_minify(src->height0, info->src.level);
+
+        if ((src->target != PIPE_TEXTURE_2D &&
+             src->target != PIPE_TEXTURE_RECT) ||
+            src->nr_samples > 1 ||
+            info->src.box.z != 0 || info->src.box.depth != 1 ||
+            util_format_is_depth_or_stencil(src->format) ||
+            !v3d_rt_format_supported(devinfo, src->format)) {
+                return false;
+        }
+
+        int x0 = info->src.box.x;
+        int y0 = info->src.box.y;
+        int x1 = x0 + info->src.box.width;
+        int y1 = y0 + info->src.box.height;
+        if (x1 < x0)
+                SWAP(x0, x1);
+        if (y1 < y0)
+                SWAP(y0, y1);
+
+        /* One texel of margin for filtered blits, rounded out to whole
+         * 64x64 tiles (the largest TLB tile size) and clamped to the level,
+         * so v3d_tlb_blit accepts the box for any tile size.
+         */
+        x0 = MAX2(x0 - 1, 0) & ~63;
+        y0 = MAX2(y0 - 1, 0) & ~63;
+        x1 = MIN2(align(MAX2(x1 + 1, 0), 64), width);
+        y1 = MIN2(align(MAX2(y1 + 1, 0), 64), height);
+        if (x1 <= x0 || y1 <= y0)
+                return false;
+
+        struct pipe_blit_info copy = {
+                .src = {
+                        .resource = src,
+                        .level = info->src.level,
+                        .format = src->format,
+                        .box = { .x = x0, .y = y0, .z = 0,
+                                 .width = x1 - x0, .height = y1 - y0,
+                                 .depth = 1 },
+                },
+                .dst = {
+                        .resource = tiled,
+                        .level = 0,
+                        .format = tiled->format,
+                        .box = { .x = x0, .y = y0, .z = 0,
+                                 .width = x1 - x0, .height = y1 - y0,
+                                 .depth = 1 },
+                },
+                .mask = PIPE_MASK_RGBA,
+                .filter = PIPE_TEX_FILTER_NEAREST,
+        };
+
+        v3d_tlb_blit(ctx, &copy);
+        return copy.mask == 0;
+}
+
 static void
 v3d_render_blit(struct pipe_context *ctx, struct pipe_blit_info *info)
 {
@@ -118,11 +192,14 @@ v3d_render_blit(struct pipe_context *ctx, struct pipe_blit_info *info)
                         mesa_loge("Failed to create tiled blit temp");
                         return;
                 }
-                ctx->resource_copy_region(ctx,
-                                          tiled, 0,
-                                          0, 0, 0,
-                                          info->src.resource, info->src.level,
-                                          &box);
+                if (!v3d_tlb_copy_raster_region(ctx, tiled, info)) {
+                        ctx->resource_copy_region(ctx,
+                                                  tiled, 0,
+                                                  0, 0, 0,
+                                                  info->src.resource,
+                                                  info->src.level,
+                                                  &box);
+                }
                 info->src.level = 0;
                 info->src.resource = tiled;
         }
-- 
