+
+/**
+ * sushi_media_bin_get_media_duration:
+ * @self: a #SushiMediaBin
+ *
+ * Returns: the known stream duration in seconds, or -1 if unavailable.
+ */
+gdouble
+sushi_media_bin_get_media_duration (SushiMediaBin *self)
+{
+  gint64 duration;
+  g_return_val_if_fail (SUSHI_IS_MEDIA_BIN (self), -1);
+  duration = SMB_PRIVATE (self)->duration;
+  return duration > 0 ? (gdouble) duration / GST_SECOND : -1;
+}
+
+/**
+ * sushi_media_bin_get_video_width:
+ * @self: a #SushiMediaBin
+ * Returns: the negotiated video width, or 0 if unavailable.
+ */
+gint
+sushi_media_bin_get_video_width (SushiMediaBin *self)
+{
+  g_return_val_if_fail (SUSHI_IS_MEDIA_BIN (self), 0);
+  return SMB_PRIVATE (self)->video_width;
+}
+
+/**
+ * sushi_media_bin_get_video_height:
+ * @self: a #SushiMediaBin
+ * Returns: the negotiated video height, or 0 if unavailable.
+ */
+gint
+sushi_media_bin_get_video_height (SushiMediaBin *self)
+{
+  g_return_val_if_fail (SUSHI_IS_MEDIA_BIN (self), 0);
+  return SMB_PRIVATE (self)->video_height;
 }
