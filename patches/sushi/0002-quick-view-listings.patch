+#!/usr/bin/python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Bounded read-only listing. No archive entry is extracted or followed."""
+import ctypes as C
+import ctypes.util
+import json
+import os
+import resource
+import stat
+import sys
+import time
+
+MAX_ROWS = 1000
+MAX_NODES = 10000
+
+def folder(path):
+    entries = []
+    with os.scandir(path) as scan:
+        for entry in scan:
+            if len(entries) >= MAX_ROWS:
+                raise ValueError('Folder listing exceeds preview limit')
+            info = entry.stat(follow_symlinks=False)
+            entries.append({'name': entry.name, 'directory': stat.S_ISDIR(info.st_mode),
+                            'size': info.st_size if stat.S_ISREG(info.st_mode) else None, 'depth': 0})
+    entries.sort(key=lambda row: (not row['directory'], row['name'].casefold()))
+    # Bound recursive accounting separately. An incomplete total is unavailable.
+    deadline, nodes, total, pending = time.monotonic() + 2, 0, 0, [path]
+    while pending:
+        if time.monotonic() > deadline or nodes >= MAX_NODES:
+            total = None
+            break
+        try:
+            with os.scandir(pending.pop()) as scan:
+                for entry in scan:
+                    nodes += 1
+                    if nodes >= MAX_NODES or time.monotonic() > deadline:
+                        total = None; pending.clear(); break
+                    info = entry.stat(follow_symlinks=False)
+                    if stat.S_ISDIR(info.st_mode): pending.append(entry.path)
+                    elif stat.S_ISREG(info.st_mode): total += info.st_size
+        except OSError:
+            total = None
+            break
+    return {'rows': entries, 'size': total, 'count': len(entries)}
+
+def archive(path):
+    library = C.CDLL(ctypes.util.find_library('archive'))
+    signatures = {
+        'archive_read_new': (C.c_void_p, []),
+        'archive_read_support_filter_all': (C.c_int, [C.c_void_p]),
+        'archive_read_support_format_all': (C.c_int, [C.c_void_p]),
+        'archive_read_open_fd': (C.c_int, [C.c_void_p, C.c_int, C.c_size_t]),
+        'archive_read_next_header': (C.c_int, [C.c_void_p, C.POINTER(C.c_void_p)]),
+        'archive_entry_pathname': (C.c_char_p, [C.c_void_p]),
+        'archive_entry_size': (C.c_longlong, [C.c_void_p]),
+        'archive_entry_filetype': (C.c_uint, [C.c_void_p]),
+        'archive_read_free': (C.c_int, [C.c_void_p]),
+    }
+    for name, (result, args) in signatures.items():
+        function = getattr(library, name); function.restype = result; function.argtypes = args
+    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
+    reader = library.archive_read_new()
+    try:
+        if not stat.S_ISREG(os.fstat(fd).st_mode): raise ValueError('Not a regular archive')
+        library.archive_read_support_filter_all(reader)
+        library.archive_read_support_format_all(reader)
+        if library.archive_read_open_fd(reader, fd, 65536) != 0: raise ValueError('Archive cannot be read')
+        rows, total = [], 0
+        while True:
+            entry = C.c_void_p()
+            result = library.archive_read_next_header(reader, C.byref(entry))
+            if result == 1: break
+            if result < 0: raise ValueError('Archive cannot be read')
+            if len(rows) >= MAX_ROWS: raise ValueError('Archive listing exceeds preview limit')
+            name = (library.archive_entry_pathname(entry) or b'').decode('utf-8', 'replace')
+            # Paths are display strings only, never passed to any file API.
+            if len(name) > 4096: raise ValueError('Archive name exceeds preview limit')
+            directory = library.archive_entry_filetype(entry) == stat.S_IFDIR
+            size = max(0, library.archive_entry_size(entry))
+            total += size
+            rows.append({'name': name, 'directory': directory, 'size': size,
+                         'depth': min(16, max(0, len(name.rstrip('/').split('/')) - 1))})
+        count = len(rows)
+        tree = {}
+        for row in rows:
+            parts = row['name'].rstrip('/').split('/')
+            parent = tree
+            for index, part in enumerate(parts):
+                node = parent.setdefault(part, {'children': {}, 'row': None})
+                if index == len(parts) - 1: node['row'] = row
+                parent = node['children']
+        rendered = []
+        def flatten(nodes, depth=0):
+            for name, node in sorted(nodes.items(), key=lambda item: item[0].casefold()):
+                row = dict(node['row'] or {'name': name, 'size': None, 'directory': True})
+                row.update(display=name, depth=min(16, depth))
+                if node['children']:
+                    row['directory'] = True
+                    row['items'] = len(node['children'])
+                rendered.append(row)
+                if len(rendered) > MAX_ROWS: raise ValueError('Archive tree exceeds preview limit')
+                flatten(node['children'], depth + 1)
+        flatten(tree)
+        return {'rows': rendered, 'size': total, 'count': count}
+    finally:
+        library.archive_read_free(reader)
+        os.close(fd)
+
+if __name__ == '__main__':
+    resource.setrlimit(resource.RLIMIT_CPU, (4, 4))
+    resource.setrlimit(resource.RLIMIT_AS, (256 * 1024 * 1024,) * 2)
+    resource.setrlimit(resource.RLIMIT_FSIZE, (0, 0))
+    try:
+        result = folder(sys.argv[1]) if sys.argv[2] == 'folder' else archive(sys.argv[1])
+        output = json.dumps(result, ensure_ascii=True)
+        if len(output) > 8 * 1024 * 1024: raise ValueError('Listing exceeds output limit')
+        print(output)
+    except Exception:
+        print(json.dumps({'error': True}))
+        sys.exit(1)
