+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Luma read-only archive and folder listing renderer.
+ */
+const {Gio, GLib, GObject, Gtk} = imports.gi;
+const Renderer = imports.ui.renderer;
+
+function size(bytes) {
+    if (bytes === null || bytes === undefined) return '—';
+    for (const unit of ['B', 'KB', 'MB', 'GB']) {
+        if (bytes < 1024 || unit === 'GB') return `${bytes.toFixed(unit === 'B' ? 0 : 1)} ${unit}`;
+        bytes /= 1024;
+    }
+}
+
+var Klass = GObject.registerClass({
+    Implements: [Renderer.Renderer],
+    Properties: {
+        fullscreen: GObject.ParamSpec.boolean('fullscreen', '', '', GObject.ParamFlags.READABLE, false),
+        ready: GObject.ParamSpec.boolean('ready', '', '', GObject.ParamFlags.READABLE, false),
+    },
+}, class ListingRenderer extends Gtk.Box {
+    _init(file, info) {
+        super._init({orientation: Gtk.Orientation.VERTICAL, spacing: 8, margin: 12});
+        this._cancel = new Gio.Cancellable();
+        this._folder = info.get_file_type() === Gio.FileType.DIRECTORY;
+        const heading = new Gtk.Box({spacing: 12});
+        heading.add(new Gtk.Image({gicon: info.get_icon(), pixel_size: 48}));
+        const labels = new Gtk.Box({orientation: Gtk.Orientation.VERTICAL, spacing: 4});
+        const title = new Gtk.Label({label: info.get_display_name(), xalign: 0, ellipsize: 3});
+        title.get_style_context().add_class('heading');
+        labels.add(title);
+        this._summary = new Gtk.Label({label: 'Preparing a preview…', xalign: 0});
+        this._summary.get_style_context().add_class('dim-label');
+        labels.add(this._summary); heading.add(labels); this.add(heading);
+        this.add(new Gtk.Separator());
+        const scroll = new Gtk.ScrolledWindow({hexpand: true, vexpand: true});
+        this._list = new Gtk.ListBox({selection_mode: Gtk.SelectionMode.NONE});
+        scroll.add(this._list); this.add(scroll);
+        this.connect('destroy', () => {
+            this._cancel.cancel();
+            if (this._timeout) GLib.source_remove(this._timeout);
+            this._timeout = 0;
+            this._process?.force_exit();
+        });
+        this._load(file, info).catch(() => {
+            if (!this._cancel.is_cancelled()) this._summary.set_text('There is no preview for this kind of file.');
+        });
+        this.isReady();
+    }
+
+    async _load(file, info) {
+        const path = file.get_path();
+        if (!path || ![Gio.FileType.REGULAR, Gio.FileType.DIRECTORY].includes(info.get_file_type()))
+            throw new Error('Unsupported file');
+        // No network, writable host mounts or archive extraction; native parser
+        // sees only the selected input and read-only system runtime.
+        this._process = Gio.Subprocess.new(['/usr/bin/bwrap', '--unshare-all', '--die-with-parent',
+            '--new-session', '--clearenv', '--ro-bind', '/usr', '/usr', '--symlink', 'usr/lib', '/lib',
+            '--symlink', 'usr/lib64', '/lib64', '--proc', '/proc', '--dev', '/dev',
+            '--tmpfs', '/tmp', '--ro-bind', path, '/input', '--', '/usr/bin/python3', '-I',
+            '/usr/libexec/luma-quick-view-listing', '/input', this._folder ? 'folder' : 'archive'],
+            Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE);
+        this._timeout = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 6000, () => {
+            this._timeout = 0;
+            this._process.force_exit();
+            return GLib.SOURCE_REMOVE;
+        });
+        const output = await new Promise((resolve, reject) => this._process.communicate_utf8_async(null,
+            this._cancel, (process, result) => {
+                try {
+                    const [, text] = process.communicate_utf8_finish(result);
+                    if (!process.get_successful()) throw new Error('Listing unavailable');
+                    resolve(text);
+                } catch (error) { reject(error); }
+            }));
+        if (this._timeout) GLib.source_remove(this._timeout);
+        this._timeout = 0;
+        if (this._cancel.is_cancelled()) return;
+        const data = JSON.parse(output);
+        const modified = GLib.DateTime.new_from_unix_local(info.get_attribute_uint64('time::modified'));
+        const today = GLib.DateTime.new_now_local();
+        const sameDay = modified.format('%Y-%m-%d') === today.format('%Y-%m-%d');
+        const modifiedText = sameDay ? `Today, ${modified.format('%H:%M')}` : modified.format('%b %e, %H:%M');
+        this._summary.set_text(this._folder ? `${data.count} items · ${size(data.size)} · Modified ${modifiedText}` :
+            `${data.count} items · ${size(data.size)} when extracted · ${size(info.get_size())} compressed`);
+        for (const entry of data.rows) {
+            const row = new Gtk.Box({spacing: 8, margin_start: 8 + entry.depth * 18,
+                margin_end: 8, height_request: 30});
+            row.add(new Gtk.Image({icon_name: entry.directory ? 'folder-symbolic' : 'text-x-generic-symbolic', pixel_size: 14}));
+            row.add(new Gtk.Label({label: entry.display ?? entry.name, xalign: 0, hexpand: true, ellipsize: 3}));
+            const value = new Gtk.Label({label: entry.directory ? (entry.items === undefined ? '' : `${entry.items} items`) : size(entry.size), xalign: 1});
+            value.get_style_context().add_class('dim-label'); row.add(value);
+            this._list.add(row);
+        }
+        this._list.show_all();
+    }
+    get ready() { return !!this._ready; }
+    get fullscreen() { return !!this._fullscreen; }
+    get moveOnClick() { return false; }
+    get hideOpen() { return true; }
+});
+var mimeTypes = ['inode/directory', 'application/zip', 'application/x-tar',
+    'application/gzip', 'application/x-gzip', 'application/x-bzip2', 'application/x-xz',
+    'application/zstd', 'application/x-zstd', 'application/x-7z-compressed',
+    'application/vnd.rar', 'application/x-rar', 'application/x-compressed-tar',
+    'application/x-bzip-compressed-tar', 'application/x-xz-compressed-tar', 'application/x-zstd-compressed-tar'];
