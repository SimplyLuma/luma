+int32_t Layer::getWaydroidTaskId() const {
+    // WindowManager owns task containers and their existing METADATA_TASK_ID.
+    // Child video/BLAST surfaces need the same identity even with generic names.
+    // Never accept application-authored task metadata as the ownership source.
+    const Layer* current = this;
+    sp<Layer> parent;
+    for (unsigned depth = 0; current && depth < 128; ++depth) {
+        if (current->mOwnerUid == AID_SYSTEM) {
+            const int32_t taskId = current->mDrawingState.metadata.getInt32(METADATA_TASK_ID, -1);
+            if (taskId >= 0) return taskId;
+        }
+        parent = current->mDrawingParent.promote();
+        current = parent.get();
+    }
+    return -1;
+}
