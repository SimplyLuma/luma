+#define MM_IS_BROADBAND_BEARER_EXTERNAL(obj)         (G_TYPE_CHECK_INSTANCE_TYPE ((obj), MM_TYPE_BROADBAND_BEARER_EXTERNAL))
+#define MM_IS_BROADBAND_BEARER_EXTERNAL_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass),  MM_TYPE_BROADBAND_BEARER_EXTERNAL))
+#define MM_BROADBAND_BEARER_EXTERNAL_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj),  MM_TYPE_BROADBAND_BEARER_EXTERNAL, MMBroadbandBearerExternalClass))
+
