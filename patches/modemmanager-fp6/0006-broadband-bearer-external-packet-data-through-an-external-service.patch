@@ -366,6 +366,23 @@
  */
 #define ID_MM_AT_VOICE_IDLE_CALL_LIST_POLL "ID_MM_AT_VOICE_IDLE_CALL_LIST_POLL"
 
+/**
+ * ID_MM_AT_DATA_SERVICE:
+ *
+ * This is a port specific tag applied to the primary AT port, whose value is
+ * the D-Bus system bus name of a service that sets up packet data for the
+ * modem.
+ *
+ * Bearers then connect through the service's &lt;name&gt;.Data interface at
+ * /&lt;name with dots as slashes&gt;/Data: Connect (s apn, s ip_type) returns the
+ * net port to use and an id that Disconnect (u id) releases. Use it for
+ * modems whose AT port cannot bind a PDN to a net port by itself, e.g.
+ * MediaTek CCCI modems that need their MIPC host channel for it.
+ *
+ * Since: 1.26
+ */
+#define ID_MM_AT_DATA_SERVICE "ID_MM_AT_DATA_SERVICE"
+
