diff --git a/src/pos-clipboard-history.c b/src/pos-clipboard-history.c
new file mode 100644
index 0000000..302e2dc
--- /dev/null
+++ b/src/pos-clipboard-history.c
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Bounded, memory-only clipboard storage. Time is monotonic microseconds.
+ */
+#include "pos-clipboard-history.h"
+#define MAX_CLIPS 10
+#define CLIP_TTL (G_GINT64_CONSTANT (3600) * G_USEC_PER_SEC)
+typedef struct { char *text; gint64 copied; gboolean pinned; } Clip;
+struct _PosClipboardHistory { GPtrArray *items; };
+static void clip_free (gpointer data) { Clip *clip = data; g_free (clip->text); g_free (clip); }
+static void prune (PosClipboardHistory *self, gint64 now) {
+  for (int i = self->items->len - 1; i >= 0; i--) {
+    Clip *clip = g_ptr_array_index (self->items, i);
+    if (!clip->pinned && now - clip->copied >= CLIP_TTL)
+      g_ptr_array_remove_index (self->items, i);
+  }
+}
+PosClipboardHistory *pos_clipboard_history_new (void) {
+  PosClipboardHistory *self = g_new0 (PosClipboardHistory, 1);
+  self->items = g_ptr_array_new_with_free_func (clip_free); return self;
+}
+void pos_clipboard_history_free (PosClipboardHistory *self) {
+  if (!self) return;
+  g_ptr_array_unref (self->items); g_free (self);
+}
+static Clip *find (PosClipboardHistory *self, const char *text) {
+  for (guint i = 0; i < self->items->len; i++) {
+    Clip *clip = g_ptr_array_index (self->items, i);
+    if (g_strcmp0 (clip->text, text) == 0) return clip;
+  }
+  return NULL;
+}
+void pos_clipboard_history_remove (PosClipboardHistory *self, const char *text) {
+  Clip *clip = find (self, text);
+  if (clip) g_ptr_array_remove (self->items, clip);
+}
+void pos_clipboard_history_add (PosClipboardHistory *self, const char *text, gint64 now) {
+  Clip *clip;
+  g_autofree char *owned = NULL;
+  gboolean pinned = FALSE;
+  if (!text || !*text || strlen (text) > 65536 || !g_utf8_validate (text, -1, NULL)) return;
+  owned = g_strdup (text);
+  text = owned;
+  prune (self, now);
+  clip = find (self, text);
+  if (clip) { pinned = clip->pinned; pos_clipboard_history_remove (self, text); }
+  if (self->items->len == MAX_CLIPS) {
+    gboolean removed = FALSE;
+    for (guint i = 0; i < self->items->len; i++) {
+      Clip *old = g_ptr_array_index (self->items, i);
+      if (!old->pinned) { g_ptr_array_remove_index (self->items, i); removed = TRUE; break; }
+    }
+    if (!removed) return;
+  }
+  clip = g_new0 (Clip, 1);
+  clip->text = g_strdup (text); clip->copied = now; clip->pinned = pinned;
+  g_ptr_array_add (self->items, clip);
+}
+GStrv pos_clipboard_history_list (PosClipboardHistory *self, gint64 now) {
+  g_autoptr (GStrvBuilder) builder = g_strv_builder_new ();
+  prune (self, now);
+  for (int i = self->items->len - 1; i >= 0; i--)
+    g_strv_builder_add (builder, ((Clip *)g_ptr_array_index (self->items, i))->text);
+  return g_strv_builder_end (builder);
+}
+const char *pos_clipboard_history_latest (PosClipboardHistory *self, gint64 now) {
+  prune (self, now);
+  return self->items->len ? ((Clip *)g_ptr_array_index (self->items, self->items->len - 1))->text : NULL;
+}
+void pos_clipboard_history_pin (PosClipboardHistory *self, const char *text, gboolean pin) {
+  Clip *clip = find (self, text);
+  if (clip) clip->pinned = pin;
+}
+gboolean pos_clipboard_history_is_pinned (PosClipboardHistory *self, const char *text) {
+  Clip *clip = find (self, text); return clip && clip->pinned;
+}
