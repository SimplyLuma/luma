+  const char *settings_labels[] = { N_("Key preview"), N_("Haptics"), N_("Sound"), N_("Auto-capitalise"), N_("Double-space period"), N_("Suggestions") };
+  self->tools_row = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
