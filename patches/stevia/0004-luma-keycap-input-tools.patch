+gboolean pos_keycap_is_sensitive (PosInputMethodPurpose purpose, guint hints);
+gboolean pos_keycap_should_capitalise (PosInputMethodPurpose purpose, guint hints, const char *text, guint cursor);
+gboolean pos_keycap_can_end_sentence (const char *before);
diff --git a/src/pos-keycap-surface-private.h b/src/pos-keycap-surface-private.h
new file mode 100644
index 0000000..aec8010
--- /dev/null
+++ b/src/pos-keycap-surface-private.h
@@ -0,0 +1,456 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Luma tools around Stevia's existing input, emoji and cursor implementations.
+ * Included after PosInputSurface is declared; no second input engine.
+ */
+#include "pos-keycap-policy.h"
+static gboolean pos_input_surface_set_backspace_pressed (PosInputSurface *self, const char *symbol);
+static void keycap_update_strip (PosInputSurface *self);
+static void keycap_fill_clipboard (PosInputSurface *self);
+static void keycap_search_close (GtkButton *unused, PosInputSurface *self);
+
+static gboolean
+keycap_sensitive (PosInputSurface *self)
+{
+  PosInputMethodPurpose purpose;
+  guint hints;
+  if (!self->input_method)
+    return TRUE;
+  purpose = pos_input_method_get_purpose (self->input_method);
+  hints = pos_input_method_get_hint (self->input_method);
+  return pos_keycap_is_sensitive (purpose, hints);
+}
+
+static void
+keycap_update_privacy (PosInputSurface *self)
+{
+  gboolean sensitive = keycap_sensitive (self);
+  if (self->clipboard_manager)
+    pos_clipboard_manager_set_sensitive (self->clipboard_manager, sensitive);
+  if (sensitive) {
+    self->emoji_search_active = FALSE;
+    if (self->emoji_query) g_string_truncate (self->emoji_query, 0);
+    if (self->emoji_search_entry) gtk_entry_set_text (GTK_ENTRY (self->emoji_search_entry), "");
+    pos_emoji_picker_set_query (POS_EMOJI_PICKER (self->emoji_picker), "");
+    g_clear_pointer (&self->surround_before, g_free);
+    self->space_tap = 0;
+    if (self->completer)
+      pos_completer_set_preedit (self->completer, NULL);
+    if (self->clipboard_panel && hdy_deck_get_visible_child (self->deck) == self->clipboard_panel && self->last_layout)
+      hdy_deck_set_visible_child (self->deck, self->last_layout);
+  }
+  keycap_update_strip (self);
+}
+
+static void
+keycap_auto_caps (PosInputSurface *self, const char *text, guint cursor)
+{
+  GtkWidget *child = hdy_deck_get_visible_child (self->deck);
+  PosInputMethodPurpose purpose = pos_input_method_get_purpose (self->input_method);
+  guint hints = pos_input_method_get_hint (self->input_method);
+  gboolean caps;
+  if (!POS_INPUT_SURFACE_IS_LANG_LAYOUT (child) || !self->osk_settings) return;
+  caps = g_settings_get_boolean (self->osk_settings, "auto-capitalise") &&
+         pos_keycap_should_capitalise (purpose, hints, text, cursor);
+  pos_osk_widget_set_auto_caps (POS_OSK_WIDGET (child), caps);
+}
+
+static void
+keycap_refresh_caps (PosInputSurface *self)
+{
+  guint anchor, cursor;
+  const char *text;
+  if (!self->input_method) return;
+  text = pos_input_method_get_surrounding_text (self->input_method, &anchor, &cursor);
+  keycap_auto_caps (self, text ?: "", text ? cursor : 0);
+}
+
+static void
+keycap_preferences_changed (PosInputSurface *self, const char *key, GSettings *settings)
+{
+  if (!self->tools_row) return;
+  /* Disabling suggestions must preserve the literal word already being edited. */
+  if (g_str_equal (key, "suggestions") && !g_settings_get_boolean (settings, key) &&
+      self->completer && self->input_method && pos_input_method_get_active (self->input_method) &&
+      !keycap_sensitive (self)) {
+    g_autofree char *preedit = g_strdup (pos_completer_get_preedit (self->completer));
+    if (preedit && *preedit) {
+      pos_completer_set_preedit (self->completer, NULL);
+      pos_input_method_send_preedit (self->input_method, "", 0, 0, FALSE);
+      pos_input_method_send_string (self->input_method, preedit, TRUE);
+    }
+  }
+  keycap_update_strip (self);
+  keycap_refresh_caps (self);
+  g_object_notify (G_OBJECT (self), "completer-active");
+}
+
+static void
+keycap_clipboard_changed (PosInputSurface *self)
+{
+  if (self->clipboard_panel && hdy_deck_get_visible_child (self->deck) == self->clipboard_panel)
+    keycap_fill_clipboard (self);
+}
+
+static gboolean
+keycap_double_space (PosInputSurface *self, const char *symbol)
+{
+  gint64 previous = self->space_tap;
+  const char *text = self->surround_before;
+  gboolean space = g_str_equal (symbol, " ");
+  self->space_tap = space ? g_get_monotonic_time () : 0;
+  if (!space || !previous || self->space_tap - previous > 400000 ||
+      !self->osk_settings || !g_settings_get_boolean (self->osk_settings, "double-space-period") ||
+      !self->input_method || !pos_input_method_get_active (self->input_method) || keycap_sensitive (self) ||
+      pos_input_method_get_purpose (self->input_method) != POS_INPUT_METHOD_PURPOSE_NORMAL || !pos_keycap_can_end_sentence (text))
+    return FALSE;
+  self->space_tap = 0;
+  pos_input_method_delete_surrounding_text (self->input_method, 1, 0, FALSE);
+  pos_input_method_send_string (self->input_method, ". ", TRUE);
+  return TRUE;
+}
+
+static void
+keycap_update_strip (PosInputSurface *self)
+{
+  const char *preedit = self->completer ? pos_completer_get_preedit (self->completer) : NULL;
+  if (!self->strip || !self->tools_row) return;
+  if (self->strip_enter && self->input_method) {
+    PosInputMethodPurpose purpose = pos_input_method_get_purpose (self->input_method);
+    gboolean numeric = purpose == POS_INPUT_METHOD_PURPOSE_PIN || purpose == POS_INPUT_METHOD_PURPOSE_PHONE ||
+                       purpose == POS_INPUT_METHOD_PURPOSE_NUMBER || purpose == POS_INPUT_METHOD_PURPOSE_DIGITS;
+    GList *children = gtk_container_get_children (GTK_CONTAINER (self->tools_row));
+    guint i = 0;
+    for (GList *it = children; it; it = it->next, i++)
+      gtk_widget_set_visible (it->data, i >= 4 || !numeric);
+    g_list_free (children);
+    gtk_widget_set_visible (self->strip_enter, numeric);
+  }
+  if (self->emoji_search && (self->emoji_search_active ||
+      hdy_deck_get_visible_child (self->deck) == self->emoji_picker)) {
+    gtk_stack_set_visible_child_name (self->strip, "emoji-search");
+    return;
+  }
+  gtk_stack_set_visible_child_name (self->strip,
+    !keycap_sensitive (self) && self->osk_settings && g_settings_get_boolean (self->osk_settings, "suggestions") && preedit && *preedit ? "suggestions" : "tools");
+}
+
+static GtkWidget *
+keycap_button (const char *icon, const char *label, GCallback callback, PosInputSurface *self)
+{
+  GtkWidget *button = gtk_button_new ();
+  GtkWidget *image = gtk_image_new_from_icon_name (icon, GTK_ICON_SIZE_BUTTON);
+  gtk_image_set_pixel_size (GTK_IMAGE (image), 21);
+  gtk_button_set_image (GTK_BUTTON (button), image);
+  gtk_widget_set_tooltip_text (button, label);
+  atk_object_set_name (gtk_widget_get_accessible (button), label);
+  gtk_widget_set_can_focus (button, FALSE);
+  g_signal_connect_object (button, "clicked", callback, self, 0);
+  return button;
+}
+
+static void
+keycap_show_emoji (GtkButton *unused, PosInputSurface *self)
+{
+  pos_input_surface_submit_current_preedit (self);
+  self->emoji_search_active = FALSE;
+  g_string_truncate (self->emoji_query, 0);
+  gtk_entry_set_text (GTK_ENTRY (self->emoji_search_entry), "");
+  pos_emoji_picker_set_query (POS_EMOJI_PICKER (self->emoji_picker), "");
+  hdy_deck_set_visible_child (self->deck, self->emoji_picker);
+}
+
+static void
+keycap_hide (GtkButton *unused, PosInputSurface *self)
+{
+  pos_input_surface_set_visible (self, FALSE);
+}
+
+static void
+keycap_back (GtkButton *unused, PosInputSurface *self)
+{
+  if (self->last_layout) hdy_deck_set_visible_child (self->deck, self->last_layout);
+}
+
+static void
+keycap_paste_clip (GtkButton *button, PosInputSurface *self)
+{
+  const char *text = g_object_get_data (G_OBJECT (button), "clip-text");
+  g_auto (GStrv) clips = NULL;
+  if (!self->clipboard_manager || keycap_sensitive (self) || !pos_input_method_get_active (self->input_method)) return;
+  clips = pos_clipboard_manager_get_texts (self->clipboard_manager);
+  if (!g_strv_contains ((const char * const *)clips, text)) { keycap_fill_clipboard (self); return; }
+  pos_input_surface_submit_current_preedit (self);
+  pos_input_method_send_string (self->input_method, text, TRUE);
+}
+
+static void
+keycap_clip_action (GtkMenuItem *item, PosInputSurface *self)
+{
+  const char *text = g_object_get_data (G_OBJECT (item), "clip-text");
+  if (keycap_sensitive (self)) return;
+  if (g_object_get_data (G_OBJECT (item), "remove"))
+    pos_clipboard_manager_remove (self->clipboard_manager, text);
+  else
+    pos_clipboard_manager_pin (self->clipboard_manager, text,
+      !pos_clipboard_manager_is_pinned (self->clipboard_manager, text));
+  keycap_fill_clipboard (self);
+}
+
+static void
+keycap_clip_long_press (GtkGestureLongPress *gesture, double x, double y, PosInputSurface *self)
+{
+  GtkWidget *button = gtk_event_controller_get_widget (GTK_EVENT_CONTROLLER (gesture));
+  const char *text = g_object_get_data (G_OBJECT (button), "clip-text");
+  GtkWidget *menu = gtk_menu_new ();
+  const char *labels[] = { pos_clipboard_manager_is_pinned (self->clipboard_manager, text) ? _("Unpin") : _("Pin"), _("Delete") };
+  if (keycap_sensitive (self)) { gtk_widget_destroy (menu); return; }
+  for (guint i = 0; i < G_N_ELEMENTS (labels); i++) {
+    GtkWidget *item = gtk_menu_item_new_with_label (labels[i]);
+    g_object_set_data_full (G_OBJECT (item), "clip-text", g_strdup (text), g_free);
+    g_object_set_data (G_OBJECT (item), "remove", GINT_TO_POINTER (i));
+    g_signal_connect_object (item, "activate", G_CALLBACK (keycap_clip_action), self, 0);
+    gtk_menu_shell_append (GTK_MENU_SHELL (menu), item);
+  }
+  g_signal_connect (menu, "deactivate", G_CALLBACK (gtk_widget_destroy), NULL);
+  gtk_widget_show_all (menu);
+  gtk_menu_popup_at_widget (GTK_MENU (menu), button, GDK_GRAVITY_NORTH, GDK_GRAVITY_SOUTH, NULL);
+  gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_CLAIMED);
+}
+
+static void
+keycap_fill_clipboard (PosInputSurface *self)
+{
+  GtkWidget *box;
+  g_auto (GStrv) clips = NULL;
+  if (!self->clipboard_panel) return;
+  box = gtk_bin_get_child (GTK_BIN (self->clipboard_panel));
+  if (GTK_IS_VIEWPORT (box)) box = gtk_bin_get_child (GTK_BIN (box));
+  gtk_container_foreach (GTK_CONTAINER (box), (GtkCallback)gtk_widget_destroy, NULL);
+  clips = self->clipboard_manager ? pos_clipboard_manager_get_texts (self->clipboard_manager) : NULL;
+  if (!clips || !*clips || keycap_sensitive (self)) {
+    GtkWidget *empty = gtk_label_new (_("Copied text shows up here."));
+    gtk_box_pack_start (GTK_BOX (box), empty, TRUE, TRUE, 0);
+  } else {
+    for (guint i = 0; clips[i]; i++) {
+      GtkWidget *button = gtk_button_new_with_label (clips[i]);
+      GtkWidget *label = gtk_bin_get_child (GTK_BIN (button));
+      GtkGesture *hold = gtk_gesture_long_press_new (button);
+      gtk_label_set_ellipsize (GTK_LABEL (label), PANGO_ELLIPSIZE_END);
+      gtk_label_set_single_line_mode (GTK_LABEL (label), TRUE);
+      gtk_label_set_max_width_chars (GTK_LABEL (label), 40);
+      g_object_set_data_full (G_OBJECT (button), "clip-text", g_strdup (clips[i]), g_free);
+      g_signal_connect_object (button, "clicked", G_CALLBACK (keycap_paste_clip), self, 0);
+      g_signal_connect_object (hold, "pressed", G_CALLBACK (keycap_clip_long_press), self, 0);
+      g_object_set_data_full (G_OBJECT (button), "hold", hold, g_object_unref);
+      gtk_box_pack_start (GTK_BOX (box), button, FALSE, FALSE, 0);
+    }
+  }
+  {
+    GtkWidget *back = gtk_button_new_with_label (_("ABC"));
+    g_signal_connect_object (back, "clicked", G_CALLBACK (keycap_back), self, 0);
+    gtk_box_pack_end (GTK_BOX (box), back, FALSE, FALSE, 0);
+  }
+  gtk_widget_show_all (box);
+}
+
+static void
+keycap_show_clipboard (GtkButton *unused, PosInputSurface *self)
+{
+  if (keycap_sensitive (self)) return;
+  keycap_fill_clipboard (self);
+  hdy_deck_set_visible_child (self->deck, self->clipboard_panel);
+}
+
+static void
+keycap_cursor_key (GtkButton *button, PosInputSurface *self)
+{
+  guint key = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (button), "keyval"));
+  guint mods = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (button), "modifiers"));
+  if (keycap_sensitive (self) && mods) return;
+  pos_input_surface_submit_current_preedit (self);
+  pos_vk_driver_key_press_gdk (self->keyboard_driver, key, mods);
+}
