+static void
+keycap_search_close (GtkButton *unused, PosInputSurface *self)
+{
+  self->emoji_search_active = FALSE;
+  if (self->last_layout) hdy_deck_set_visible_child (self->deck, self->last_layout);
+  keycap_update_strip (self);
+}
+
+static gboolean
+keycap_handle_search (PosInputSurface *self, const char *symbol)
+{
+  if (!self->emoji_search_active) return FALSE;
+  if (keycap_sensitive (self)) { keycap_search_close (NULL, self); return TRUE; }
+  if (g_str_equal (symbol, "KEY_ENTER") || g_str_equal (symbol, "KEY_EMOJI")) {
+    self->emoji_search_active = FALSE;
+    hdy_deck_set_visible_child (self->deck, self->emoji_picker);
+  } else if (g_str_equal (symbol, "KEY_BACKSPACE")) {
+    if (self->emoji_query->len) {
+      char *end = g_utf8_find_prev_char (self->emoji_query->str, self->emoji_query->str + self->emoji_query->len);
+      g_string_truncate (self->emoji_query, end - self->emoji_query->str);
+    }
+  } else if (!g_str_has_prefix (symbol, "KEY_") && self->emoji_query->len + strlen (symbol) <= 256) {
+    g_string_append (self->emoji_query, symbol);
+  }
+  gtk_entry_set_text (GTK_ENTRY (self->emoji_search_entry), self->emoji_query->str);
+  pos_emoji_picker_set_query (POS_EMOJI_PICKER (self->emoji_picker), self->emoji_query->str);
+  keycap_update_strip (self);
+  return TRUE;
+}
+
+static void
+keycap_enter (GtkButton *unused, PosInputSurface *self)
+{
+  pos_input_surface_submit_symbol (self, "KEY_ENTER");
+}
