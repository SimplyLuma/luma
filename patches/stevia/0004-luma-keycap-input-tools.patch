diff --git a/tests/test-keycap-emoji.c b/tests/test-keycap-emoji.c
new file mode 100644
index 0000000..c9ca93e
--- /dev/null
+++ b/tests/test-keycap-emoji.c
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "pos-emoji-picker.c"
+#include "pos-main.h"
+static void drain (void) {
+  for (int i=0;i<80;i++) { while (g_main_context_iteration (NULL,FALSE)); g_usleep (5000); }
+}
+static guint shown (GtkWidget *box) {
+  GList *items=gtk_container_get_children (GTK_CONTAINER (box)); guint count=0;
+  for (GList *it=items;it;it=it->next) count+=gtk_widget_get_child_visible (it->data);
+  g_list_free (items);return count;
+}
+static void test_filter_and_recents (void) {
+  GtkWidget *window=gtk_window_new (GTK_WINDOW_TOPLEVEL);
+  PosEmojiPicker *picker=POS_EMOJI_PICKER (pos_emoji_picker_new ());
+  guint total;
+  g_autoptr(GVariant) recent = NULL;
+  GList *items;
+  guint used = 0;
+  gtk_window_set_default_size (GTK_WINDOW (window),390,220);
+  gtk_container_add (GTK_CONTAINER (window),GTK_WIDGET (picker));gtk_widget_show_all (window);drain ();
+  total=shown(picker->people.box);g_assert_cmpuint(total,>,0);
+  pos_emoji_picker_set_query(picker,"smil");drain();
+  g_assert_cmpuint(shown(picker->people.box),>,0);g_assert_cmpuint(shown(picker->people.box),<,total);
+  pos_emoji_picker_set_query(picker,"!not-an-emoji-name!");drain();g_assert_cmpuint(shown(picker->people.box),==,0);
+  pos_emoji_picker_set_query(picker,"");drain();g_assert_cmpuint(shown(picker->people.box),==,total);
+  items = gtk_container_get_children (GTK_CONTAINER (picker->people.box));
+  for (GList *it = items; it && used < 45; it = it->next, used++)
+    add_recent_item (picker, get_recent_emoji_data (it->data), 0);
+  g_list_free (items);
+  g_assert_cmpuint (used, ==, 45);
+  recent=g_settings_get_value(picker->settings,"recent-emoji");g_assert_cmpuint(g_variant_n_children(recent),==,32);
+  gtk_widget_destroy(window);
+}
+int main(int argc,char **argv) {
+ gtk_test_init(&argc,&argv,NULL);pos_init();
+ g_test_add_func("/pos/keycap/emoji/search-and-recents",test_filter_and_recents);
+ return g_test_run();
+}
diff --git a/tests/test-keycap-history.c b/tests/test-keycap-history.c
new file mode 100644
index 0000000..03c44c7
--- /dev/null
+++ b/tests/test-keycap-history.c
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "pos-clipboard-history.h"
+#include "pos-enums.h"
+#include "pos-keycap-policy.h"
+#include <glib.h>
+static void test_history (void) {
+  PosClipboardHistory *h = pos_clipboard_history_new ();
+  g_auto (GStrv) items = NULL;
+  for (int i = 0; i < 11; i++) { g_autofree char *s = g_strdup_printf ("clip%d", i); pos_clipboard_history_add (h, s, 0); }
+  items = pos_clipboard_history_list (h, 0);
+  g_assert_cmpint (g_strv_length (items), ==, 10);
+  g_assert_cmpstr (items[0], ==, "clip10");
+  g_assert_false (g_strv_contains ((const char * const *)items, "clip0"));
+  g_clear_pointer (&items, g_strfreev);
+  pos_clipboard_history_pin (h, "clip3", TRUE);
+  items = pos_clipboard_history_list (h, G_GINT64_CONSTANT (3600) * G_USEC_PER_SEC);
+  g_assert_cmpint (g_strv_length (items), ==, 1);
+  g_assert_cmpstr (items[0], ==, "clip3");
+  pos_clipboard_history_pin (h, "clip3", FALSE);
+  g_clear_pointer (&items, g_strfreev);
+  items = pos_clipboard_history_list (h, G_GINT64_CONSTANT (3600) * G_USEC_PER_SEC);
+  g_assert_cmpint (g_strv_length (items), ==, 0);
+  pos_clipboard_history_free (h);
+}
+static void test_pinned_limit (void) {
+  PosClipboardHistory *h = pos_clipboard_history_new ();
+  g_auto (GStrv) items = NULL;
+  for (int i = 0; i < 10; i++) { g_autofree char *s = g_strdup_printf ("pin%d", i); pos_clipboard_history_add (h, s, 0); pos_clipboard_history_pin (h, s, TRUE); }
+  pos_clipboard_history_add (h, "new", 10);
+  items = pos_clipboard_history_list (h, 10);
+  g_assert_cmpint (g_strv_length (items), ==, 10);
+  g_assert_false (g_strv_contains ((const char * const *)items, "new"));
+  pos_clipboard_history_add (h, "pin5", 10);
+  g_assert_true (pos_clipboard_history_is_pinned (h, "pin5"));
+  g_assert_cmpstr (pos_clipboard_history_latest (h, 10), ==, "pin5");
+  pos_clipboard_history_remove (h, "pin5");
+  g_assert_false (pos_clipboard_history_is_pinned (h, "pin5"));
+  pos_clipboard_history_free (h);
+}
+static void test_hints (void) {
+  g_assert_cmpint (POS_INPUT_METHOD_HINT_AUTO_CAPITALIZATION, ==, 4);
+  g_assert_cmpint (POS_INPUT_METHOD_HINT_SENSITIVE_DATA, ==, 128);
+  g_assert_cmpint (POS_INPUT_METHOD_HINT_MULTILINE, ==, 512);
+  g_assert_cmpint ((POS_INPUT_METHOD_HINT_COMPLETION | POS_INPUT_METHOD_HINT_SENSITIVE_DATA) & POS_INPUT_METHOD_HINT_HIDDEN_TEXT, ==, 0);
+}
+static void test_privacy_and_sentences (void) {
+  guint hints = POS_INPUT_METHOD_HINT_COMPLETION | POS_INPUT_METHOD_HINT_SENSITIVE_DATA;
+  g_assert_true (pos_keycap_is_sensitive (POS_INPUT_METHOD_PURPOSE_NORMAL, hints));
+  g_assert_true (pos_keycap_is_sensitive (POS_INPUT_METHOD_PURPOSE_PIN, 0));
+  g_assert_true (pos_keycap_is_sensitive (POS_INPUT_METHOD_PURPOSE_PASSWORD, 0));
+  g_assert_true (pos_keycap_is_sensitive (POS_INPUT_METHOD_PURPOSE_NORMAL, POS_INPUT_METHOD_HINT_HIDDEN_TEXT));
+  g_assert_false (pos_keycap_is_sensitive (POS_INPUT_METHOD_PURPOSE_NORMAL, POS_INPUT_METHOD_HINT_AUTO_CAPITALIZATION));
+  g_assert_true (pos_keycap_should_capitalise (POS_INPUT_METHOD_PURPOSE_NORMAL, 0, "Hello! ", 7));
+  g_assert_true (pos_keycap_should_capitalise (POS_INPUT_METHOD_PURPOSE_NORMAL, 0, "", 0));
+  g_assert_false (pos_keycap_should_capitalise (POS_INPUT_METHOD_PURPOSE_URL, 0, "", 0));
+  g_assert_false (pos_keycap_should_capitalise (POS_INPUT_METHOD_PURPOSE_NORMAL, hints, "", 0));
+  g_assert_false (pos_keycap_should_capitalise (POS_INPUT_METHOD_PURPOSE_NORMAL, POS_INPUT_METHOD_HINT_LOWERCASE, "", 0));
+  g_assert_false (pos_keycap_should_capitalise (POS_INPUT_METHOD_PURPOSE_NORMAL, 0, "hello ", 6));
+  g_assert_false (pos_keycap_should_capitalise (POS_INPUT_METHOD_PURPOSE_NORMAL, 0, "é", 1));
+  g_assert_true (pos_keycap_can_end_sentence ("café "));
+  g_assert_false (pos_keycap_can_end_sentence ("hello. "));
+  g_assert_false (pos_keycap_can_end_sentence ("  "));
+}
+int main (int argc, char **argv) {
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/pos/keycap/history", test_history);
+  g_test_add_func ("/pos/keycap/pinned-limit", test_pinned_limit);
+  g_test_add_func ("/pos/keycap/wire-hints", test_hints);
+  g_test_add_func ("/pos/keycap/privacy-and-sentences", test_privacy_and_sentences);
+  return g_test_run ();
+}
diff --git a/tests/test-keycap-widget.c b/tests/test-keycap-widget.c
new file mode 100644
index 0000000..022d02d
--- /dev/null
+++ b/tests/test-keycap-widget.c
@@ -0,0 +1,165 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "pos-osk-widget.c"
+#include "pos-main.h"
+#include "pos-keypad.h"
+#include <gdesktop-enums.h>
+#include "pos-completion-bar.h"
+#include "pos-style-manager.h"
+
+static void drain (void) {
+  for (int i = 0; i < 20; i++) {
+    while (g_main_context_iteration (NULL, FALSE));
+    g_usleep (5000);
+  }
+}
+static PosOskWidget *make_osk (void) {
+  PosOskWidget *osk = g_object_ref_sink (pos_osk_widget_new (PHOSH_OSK_FEATURE_DEFAULT));
+  g_autoptr (GError) error = NULL;
+  g_assert_true (pos_osk_widget_set_layout (osk, "us", "us", "English (US)", "us", NULL, &error));
+  g_assert_no_error (error);
+  pos_osk_widget_set_key_height (osk, 55);
+  return osk;
+}
+static void test_caps_and_hints (void) {
+  PosOskWidget *osk = make_osk ();
+  PosOskWidgetRow *row = pos_osk_widget_get_row (osk, 2);
+  PosOskKey *shift = g_ptr_array_index (row->keys, 0);
+  pos_osk_widget_key_press_action (osk, shift);
+  pos_osk_widget_key_release_action (osk, shift);
+  g_assert_cmpint (osk->layer, ==, POS_OSK_WIDGET_LAYER_CAPS);
+  row = pos_osk_widget_get_row (osk, 2);
+  shift = g_ptr_array_index (row->keys, 0);
+  pos_osk_widget_key_press_action (osk, shift);
+  pos_osk_widget_key_release_action (osk, shift);
+  g_assert_true (osk->caps_lock);
+  pos_osk_widget_set_auto_caps (osk, FALSE);
+  g_assert_cmpint (osk->layer, ==, POS_OSK_WIDGET_LAYER_CAPS);
+  set_caps_lock (osk, FALSE);
+  osk->shift_tap = 0;
+  pos_osk_widget_set_auto_caps (osk, TRUE);
+  g_assert_cmpint (osk->layer, ==, POS_OSK_WIDGET_LAYER_CAPS);
+  pos_osk_widget_set_auto_caps (osk, FALSE);
+  g_assert_cmpint (osk->layer, ==, POS_OSK_WIDGET_LAYER_NORMAL);
+  row = pos_osk_widget_get_row (osk, 0);
+  g_assert_cmpint (row->keys->len, ==, 10);
+  for (int i = 0; i < 10; i++) {
+    PosOskKey *key = g_ptr_array_index (row->keys, i);
+    char digit[2] = { '0' + (i + 1) % 10, 0 };
+    g_assert_cmpstr (pos_osk_key_get_symbols (key)[0], ==, digit);
+  }
+  pos_osk_widget_set_key_height (osk, 10);
+  g_assert_cmpint (osk->key_height, ==, 44);
+  gtk_widget_destroy (GTK_WIDGET (osk)); g_object_unref (osk);
+}
+typedef struct { int words; gboolean commit; } Drag;
+static void on_delete_drag (PosOskWidget *osk, int words, gboolean commit, Drag *drag) { drag->words = words; drag->commit = commit; }
+static void test_drag_gestures (void) {
+  PosOskWidget *osk = make_osk ();
+  PosOskWidgetRow *row = pos_osk_widget_get_row (osk, 2);
+  PosOskKey *del = g_ptr_array_index (row->keys, row->keys->len - 1);
+  Drag drag = {0};
+  g_signal_connect (osk, "delete-swipe", G_CALLBACK (on_delete_drag), &drag);
+  pos_osk_widget_key_press_action (osk, del);
+  on_drag_begin (osk, 380, 130);
+  on_drag_update (osk, -65, 0);
+  g_assert_cmpint (drag.words, ==, 2); g_assert_false (drag.commit);
+  on_drag_update (osk, -35, 0);
+  g_assert_cmpint (drag.words, ==, 1);
+  on_drag_end (osk);
+  g_assert_true (drag.commit);
+  pos_osk_widget_key_press_action (osk, del);
+  on_drag_begin (osk, 380, 130); on_drag_update (osk, -60, 0); on_drag_cancel (osk);
+  g_assert_cmpint (drag.words, ==, -1); g_assert_false (drag.commit);
+  row = pos_osk_widget_get_row (osk, 3);
+  for (guint k = 0; k < row->keys->len; k++) {
+    PosOskKey *key = g_ptr_array_index (row->keys, k);
+    if (g_strcmp0 (pos_osk_key_get_symbol (key), " ") != 0) continue;
+    pos_osk_widget_key_press_action (osk, key); on_drag_begin (osk, 150, 190); on_drag_update (osk, 30, 0);
+    g_assert_cmpint (osk->mode, ==, POS_OSK_WIDGET_MODE_CURSOR);
+    on_drag_end (osk);
+    g_assert_cmpint (osk->mode, ==, POS_OSK_WIDGET_MODE_KEYBOARD);
+  }
+  gtk_widget_destroy (GTK_WIDGET (osk)); g_object_unref (osk);
+}
+static void test_lucide_strokes (void) {
+  PosOskWidget *osk = make_osk ();
+  g_autoptr (GtkIconInfo) info = gtk_icon_theme_lookup_icon (gtk_icon_theme_get_default (), "luma-keycap-smile-symbolic", 21, 0);
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GdkPixbuf) pixbuf = gtk_icon_info_load_symbolic_for_context (info, osk->key_context, NULL, &error);
+  const guchar *pixels;
+  int x, y;
+  g_assert_no_error (error); g_assert_nonnull (pixbuf); g_assert_true (gdk_pixbuf_get_has_alpha (pixbuf));
+  pixels = gdk_pixbuf_get_pixels (pixbuf);
+  x = gdk_pixbuf_get_width (pixbuf) / 2; y = gdk_pixbuf_get_height (pixbuf) / 2;
+  g_assert_cmpint (pixels[y*gdk_pixbuf_get_rowstride (pixbuf)+x*4+3], <, 32);
+  gtk_widget_destroy (GTK_WIDGET (osk)); g_object_unref (osk);
+}
+static void test_numeric_pad (void) {
+  GtkWidget *pad = g_object_ref_sink (pos_keypad_new ());
+  GtkWidget *grid = gtk_bin_get_child (GTK_BIN (pad));
+  GtkWidget *end = pos_keypad_get_end_action (POS_KEYPAD (pad));
+  g_assert_true (GTK_IS_BUTTON (end));
+  g_assert_null (gtk_grid_get_child_at (GTK_GRID (grid), 3, 0));
+  pos_keypad_set_symbols_visible (POS_KEYPAD (pad), TRUE);
+  pos_keypad_set_symbols_visible (POS_KEYPAD (pad), FALSE);
+  pos_keypad_set_decimal_separator_visible (POS_KEYPAD (pad), TRUE);
+  gtk_widget_destroy (pad); g_object_unref (pad);
+}
+static void test_skin_capture (void) {
+  const char *out = g_getenv ("LUMA_KEYCAP_CAPTURE_DIR");
+  const int widths[] = { 360, 390, 768 };
+  GSettings *settings = g_settings_new ("org.gnome.desktop.interface");
+  PosStyleManager *style;
+  g_object_set (gtk_settings_get_default (), "gtk-theme-name", "Luma", NULL);
+  style = pos_style_manager_new ();
+  for (int dark = 0; dark < 2; dark++) {
+    g_settings_set_enum (settings, "color-scheme", dark ? G_DESKTOP_COLOR_SCHEME_PREFER_DARK : G_DESKTOP_COLOR_SCHEME_DEFAULT);
+    for (guint w = 0; w < G_N_ELEMENTS (widths); w++) {
+      GtkWidget *window = gtk_window_new (GTK_WINDOW_TOPLEVEL);
+      GtkWidget *box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+      PosOskWidget *osk = make_osk ();
+      PosCompletionBar *bar = pos_completion_bar_new ();
+      const char *words[] = { "Sure", "Sounds", "Sunday", NULL };
+      gtk_style_context_add_class (gtk_widget_get_style_context (box), "luma-keycap-tray");
+      pos_completion_bar_set_completions (bar, (GStrv)words);
+      pos_completion_bar_set_keycap (bar, TRUE, "Sure");
+      gtk_window_set_decorated (GTK_WINDOW (window), FALSE);
+      gtk_window_set_default_size (GTK_WINDOW (window), widths[w], 262);
+      gtk_box_pack_start (GTK_BOX (box), GTK_WIDGET (bar), FALSE, FALSE, 0);
+      gtk_box_pack_start (GTK_BOX (box), GTK_WIDGET (osk), TRUE, TRUE, 0);
+      gtk_container_add (GTK_CONTAINER (window), box);
+      gtk_widget_show_all (window);
+      pos_completion_bar_set_keycap (bar, TRUE, "Sure");
+      drain ();
+      g_assert_cmpint (gtk_widget_get_allocated_width (GTK_WIDGET (osk)), ==, widths[w]);
+      g_assert_cmpint (gtk_widget_get_allocated_height (GTK_WIDGET (osk)), >=, 220);
+      for (int rownum = 0; rownum < 4; rownum++) {
+        PosOskWidgetRow *row = pos_osk_widget_get_row (osk, rownum);
+        for (guint k = 0; k < row->keys->len; k++) {
+          const GdkRectangle *rect = pos_osk_key_get_box (g_ptr_array_index (row->keys, k));
+          g_assert_cmpint (rect->x, >=, 0);
+          g_assert_cmpint (rect->x + rect->width, <=, widths[w]);
+          g_assert_cmpint (rect->height, >=, 44);
+        }
+      }
+      if (out) {
+        g_autofree char *file = g_strdup_printf ("%s/keycap-%s-%d.png", out, dark ? "dark" : "light", widths[w]);
+        g_autoptr (GdkPixbuf) pixbuf = gdk_pixbuf_get_from_window (gtk_widget_get_window (window), 0, 0, widths[w], gtk_widget_get_allocated_height (window));
+        g_autoptr (GError) error = NULL;
+        g_assert_true (gdk_pixbuf_save (pixbuf, file, "png", &error, NULL));
+        g_assert_no_error (error);
+      }
+      gtk_widget_destroy (window); g_object_unref (osk);
+    }
+  }
+  g_object_unref (style); g_object_unref (settings);
+}
+int main (int argc, char **argv) {
+  gtk_test_init (&argc, &argv, NULL); pos_init ();
+  g_test_add_func ("/pos/keycap/widget/caps-and-hints", test_caps_and_hints);
+  g_test_add_func ("/pos/keycap/widget/number-pad", test_numeric_pad);
+  g_test_add_func ("/pos/keycap/widget/drag-gestures", test_drag_gestures);
+  g_test_add_func ("/pos/keycap/widget/lucide-strokes", test_lucide_strokes);
+  g_test_add_func ("/pos/keycap/widget/native-skin", test_skin_capture);
+  return g_test_run ();
+}
