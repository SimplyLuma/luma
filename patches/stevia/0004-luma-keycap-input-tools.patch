+
+static void
+keycap_delete_swipe (PosInputSurface *self, int words, gboolean commit)
+{
+  pos_input_surface_set_backspace_pressed (self, NULL);
+  if (!self->input_method || !pos_input_method_get_active (self->input_method) || keycap_sensitive (self) ||
+      pos_input_method_get_purpose (self->input_method) == POS_INPUT_METHOD_PURPOSE_TERMINAL) return;
+  pos_input_surface_submit_current_preedit (self);
+  if (commit) {
+    if (self->delete_drag_count > 0)
+      pos_vk_driver_key_press_gdk (self->keyboard_driver, GDK_KEY_BackSpace, 0);
+    self->delete_drag_count = 0;
+    return;
+  }
+  /* Collapse to the original anchor before rebuilding selection. This also
+   * handles a cursor in the middle of a word without selecting forward text. */
+  if (self->delete_drag_count > 0)
+    pos_vk_driver_key_press_gdk (self->keyboard_driver, GDK_KEY_Right, 0);
+  self->delete_drag_count = CLAMP (words, 0, 32);
+  for (int i = 0; i < self->delete_drag_count; i++)
+    pos_vk_driver_key_press_gdk (self->keyboard_driver, GDK_KEY_Left, GDK_CONTROL_MASK | GDK_SHIFT_MASK);
+}
