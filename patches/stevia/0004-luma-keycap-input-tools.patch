new file mode 100644
index 0000000..bc80f7d
--- /dev/null
+++ b/src/stylesheet/luma-keycap.css
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Shared Keycap geometry. GTK3 Cairo keys use the same palette as real widgets.
+ * Row allocation is separate from cap geometry: margins are the gutters.
+ */
+pos-input-surface, pos-osk-widget, pos-emoji-picker, pos-keypad {
+  font-family: Figtree, sans-serif;
+  color: @pos_fg_color;
+  background: transparent;
+}
+pos-input-surface, .luma-keycap-tray { background-image: linear-gradient(@tray_top, @tray_bottom); box-shadow: inset 0 2px 6px rgba(0,0,0,.14); }
+pos-osk-widget { padding: 0; }
+pos-key, pos-keypad button, pos-char-popup button {
+  color: @pos_key_fg_color;
+  background-image: linear-gradient(@cap_top, @cap_bottom);
+  border: none;
+  border-radius: 8px;
+  margin: 4px 2.5px 5px;
+  padding: 0;
+  font-size: 20px;
+  font-weight: 600;
+  text-shadow: 0 1px 0 @text_glint;
+  box-shadow: inset 0 1px 0 @glint, inset 0 -2px 2px @dish, 0 3px 0 @edge, 0 5px 6px @drop;
+}
+pos-key.sys, pos-key.toggle, pos-key.space, pos-keypad button.sys {
+  background-image: linear-gradient(@fn_top, @fn_bottom);
+  font-size: 15px;
+  font-weight: 500;
+}
+pos-key.space { background-image: linear-gradient(@cap_top, @cap_bottom); }
+pos-key.pressed, pos-keypad button:active, pos-char-popup button:active {
+  background-image: linear-gradient(@down_top, @down_bottom);
+  box-shadow: inset 0 1px 0 @glint, 0 1px 0 @edge, 0 1px 2px @drop;
+}
+pos-key.return, pos-keypad button.return {
+  background-image: linear-gradient(@enter_top, @enter_bottom);
+  color: #fff;
+  text-shadow: none;
+}
+pos-key.return.pressed, pos-keypad button.return:active { background-image: linear-gradient(@enter_bottom, @enter_top); }
+pos-key.hint { font-size: 10px; font-weight: 600; color: alpha(@pos_key_fg_color,.45); text-shadow: none; }
+pos-completion-bar, .luma-tools { min-height: 42px; background: transparent; border: none; box-shadow: none; }
+pos-completion-bar button, .luma-tools button {
+  color: @pos_fg_color; background: transparent; background-image: none;
+  border: none; box-shadow: none; text-shadow: none; border-radius: 8px;
+  padding: 0 6px; margin: 0; min-width: 30px; min-height: 42px;
+  font-size: 15px; font-weight: 500;
+}
+pos-completion-bar button.suggested { font-weight: 700; }
+pos-completion-bar button:active, .luma-tools button:active { background: alpha(@pos_key_fg_color,.12); }
+pos-completion-bar separator, pos-emoji-picker separator, #pos-menu-popup separator { min-width:0; min-height:0; margin:0; padding:0; background:transparent; }
+pos-char-popup, pos-indicator-popup { color:@pos_fg_color; background-image:linear-gradient(@cap_top,@cap_bottom); border:none; border-radius:10px; box-shadow:inset 0 1px 0 @glint, inset 0 -2px 2px @dish, 0 3px 0 @edge, 0 5px 6px @drop; }
+pos-char-popup grid { padding: 4px; }
+pos-char-popup button { min-width:34px; min-height:46px; }
+pos-indicator-popup label { font-family:Figtree; font-size:30px; font-weight:600; margin:8px 10px 10px; }
+pos-keypad .digit { font-size:26px; font-weight:600; }
+pos-keypad .letters { font-size:10px; font-weight:500; }
+pos-keypad button { min-height:52px; }
+pos-emoji-picker button.action { color:@pos_fg_color; background-image:linear-gradient(@fn_top,@fn_bottom); border:none; border-radius:8px; box-shadow:inset 0 1px 0 @glint, inset 0 -2px 2px @dish, 0 3px 0 @edge, 0 5px 6px @drop; }
+pos-emoji-picker .view { background:transparent; }
+pos-emoji-picker scrollbar { background:transparent; border:none; }
+.luma-clipboard button, .luma-cursor button { border:none; border-radius:8px; background-image:linear-gradient(@fn_top,@fn_bottom); color:@pos_fg_color; box-shadow:inset 0 1px 0 @glint, inset 0 -2px 2px @dish, 0 3px 0 @edge, 0 5px 6px @drop; padding:10px; margin:4px; }
+.luma-clipboard label { color:@pos_fg_color; }
+
+.luma-tools button.return { min-width:52px; min-height:36px; margin:3px; border-radius:8px; background-image:linear-gradient(@enter_top,@enter_bottom); color:#fff; }
+
+pos-keypad button.blank { background:transparent; box-shadow:none; }
+
+pos-key.space { color:alpha(@pos_key_fg_color,.45); }
