Subject: [PATCH] Shared Keycap skin, input tools and sensitive-field policy

Extends the pinned Stevia surface; retains language layouts and hardware
keyboard detection. Figtree is supplied by prepare-luma-stevia.py.

diff --git a/data/meson.build b/data/meson.build
index 69733fe..a14152c 100644
--- a/data/meson.build
+++ b/data/meson.build
@@ -89,3 +89,6 @@ if appstream_util.found()
 endif
 
 subdir('completers')
+
+# The Luma source-preparation step supplies the shared vendored font.
+install_data('fonts/Figtree.ttf', 'fonts/OFL.txt', install_dir: datadir / 'fonts' / 'luma-figtree')
diff --git a/data/mobi.phosh.osk.gschema.xml b/data/mobi.phosh.osk.gschema.xml
index 81687c3..6052955 100644
--- a/data/mobi.phosh.osk.gschema.xml
+++ b/data/mobi.phosh.osk.gschema.xml
@@ -1,6 +1,12 @@
 <schemalist>
   <schema id="mobi.phosh.osk"
           path="/mobi/phosh/osk/">
+    <key name="suggestions" type="b"><default>true</default><summary>Show word suggestions</summary></key>
+    <key name="key-preview" type="b"><default>true</default><summary>Show pressed letter previews</summary></key>
+    <key name="sound" type="b"><default>false</default><summary>Key press sound</summary></key>
+    <key name="haptics" type="b"><default>true</default><summary>Key press vibration</summary></key>
+    <key name="auto-capitalise" type="b"><default>true</default><summary>Capitalise sentences automatically</summary></key>
+    <key name="double-space-period" type="b"><default>true</default><summary>Insert a period after two spaces</summary></key>
     <key name="completion-mode" flags="mobi.phosh.osk.PhoshOskCompletionModeFlags">
       <default>['hint']</default>
       <summary>When to enable the on screen keyboard's text completion</summary>
@@ -57,6 +63,7 @@
 
   <schema id='mobi.phosh.osk.EmojiPicker'
           path='/mobi/phosh/osk/emoji-picker/'>
+    <key name='preferred-tone' type='u'><default>0</default><summary>Preferred emoji skin tone</summary></key>
     <key name='recent-emoji' type='a((auss)u)'>
       <default>[]</default>
       <summary>Recently used Emoji</summary>
diff --git a/meson.build b/meson.build
index b584620..8f19ef1 100644
--- a/meson.build
+++ b/meson.build
@@ -104,6 +104,7 @@ add_project_arguments(global_c_args, language: 'c')
 gnome = import('gnome')
 i18n = import('i18n')
 
+canberra_dep = dependency('libcanberra-gtk3')
 dconf_dep = dependency('dconf', version: '>= 0.49')
 glib_dep = dependency('glib-2.0', version: glib_ver_cmp)
 gio_dep = dependency('gio-2.0', version: glib_ver_cmp)
@@ -177,7 +178,7 @@ config_h.set('POS_HAVE_UIM', uim_dep.found())
 config_h.set('POS_HAVE_VARNAM', varnam_dep.found())
 config_h.set(
   'POS_INPUT_SURFACE_DEFAULT_HEIGHT',
-  200,
+  220,
   description: 'Default height of the input surface',
 )
 config_h.set(
diff --git a/src/completers/pos-completer-luma.c b/src/completers/pos-completer-luma.c
index 37668ac..960513c 100644
--- a/src/completers/pos-completer-luma.c
+++ b/src/completers/pos-completer-luma.c
@@ -493,3 +493,9 @@ pos_completer_luma_new (GError **error)
 {
   return POS_COMPLETER (g_initable_new (POS_TYPE_COMPLETER_LUMA, NULL, error, NULL));
 }
+
+const char *
+pos_completer_luma_get_autocorrect (PosCompleterLuma *self)
+{
+  return self->autocorrect ?: self->preedit->str;
+}
diff --git a/src/completers/pos-completer-luma.h b/src/completers/pos-completer-luma.h
index 56046dd..0c6931f 100644
--- a/src/completers/pos-completer-luma.h
