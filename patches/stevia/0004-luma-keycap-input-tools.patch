@@ -20,4 +20,6 @@ G_DECLARE_FINAL_TYPE (PosCompleterLuma, pos_completer_luma, POS, COMPLETER_LUMA,
 
 PosCompleter *pos_completer_luma_new (GError **error);
 
+const char *pos_completer_luma_get_autocorrect (PosCompleterLuma *self);
+
 G_END_DECLS
