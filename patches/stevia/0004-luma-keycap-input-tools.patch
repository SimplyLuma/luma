diff --git a/src/pos-keycap-policy.c b/src/pos-keycap-policy.c
new file mode 100644
index 0000000..b513888
--- /dev/null
+++ b/src/pos-keycap-policy.c
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "pos-keycap-policy.h"
+#include <string.h>
+gboolean
+pos_keycap_is_sensitive (PosInputMethodPurpose purpose, guint hints)
+{
+  return purpose == POS_INPUT_METHOD_PURPOSE_PASSWORD || purpose == POS_INPUT_METHOD_PURPOSE_PIN ||
+         (hints & (POS_INPUT_METHOD_HINT_HIDDEN_TEXT | POS_INPUT_METHOD_HINT_SENSITIVE_DATA));
+}
+gboolean
+pos_keycap_should_capitalise (PosInputMethodPurpose purpose, guint hints, const char *text, guint cursor)
+{
+  const char *p;
+  if (pos_keycap_is_sensitive (purpose, hints) || (hints & POS_INPUT_METHOD_HINT_LOWERCASE) ||
+      !(purpose == POS_INPUT_METHOD_PURPOSE_NORMAL || purpose == POS_INPUT_METHOD_PURPOSE_ALPHA || purpose == POS_INPUT_METHOD_PURPOSE_NAME) ||
+      !text || cursor > strlen (text) || !g_utf8_validate (text, cursor, NULL))
+    return FALSE;
+  if (cursor == 0 || (hints & POS_INPUT_METHOD_HINT_UPPERCASE)) return TRUE;
+  p = text + cursor;
+  while (p > text) {
+    gunichar ch;
+    p = g_utf8_find_prev_char (text, p);
+    ch = g_utf8_get_char (p);
+    if (ch == '\n') return TRUE;
+    if (!g_unichar_isspace (ch)) return ch == '.' || ch == '!' || ch == '?';
+  }
+  return TRUE;
+}
+gboolean
+pos_keycap_can_end_sentence (const char *before)
+{
+  const char *last;
+  gsize len = before ? strlen (before) : 0;
+  if (len < 2 || before[len-1] != ' ' || !g_utf8_validate (before, len, NULL)) return FALSE;
+  last = g_utf8_find_prev_char (before, before + len - 1);
+  return last && g_unichar_isalnum (g_utf8_get_char (last));
+}
