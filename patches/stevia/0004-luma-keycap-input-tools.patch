+  GtkWidget *drag_selection;
 };
 G_DEFINE_TYPE (PosCharPopup, pos_char_popup, GTK_TYPE_POPOVER)
 
@@ -181,3 +182,30 @@ pos_char_popup_set_symbols (PosCharPopup *self, GStrv symbols)
     left++;
   }
 }
+
+/* Follow the touch sequence which began on the original key. A new tap on a
+ * popup button still uses GTK's normal button activation. */
+void
+pos_char_popup_drag (PosCharPopup *self, double x, double y, gboolean commit)
+{
+  GtkWidget *relative = gtk_popover_get_relative_to (GTK_POPOVER (self));
+  GList *children;
+  int px, py;
+  GtkWidget *selected = NULL;
+  if (!relative || !gtk_widget_translate_coordinates (relative, self->symbols_grid, x, y, &px, &py)) return;
+  children = gtk_container_get_children (GTK_CONTAINER (self->symbols_grid));
+  for (GList *it = children; it; it = it->next) {
+    GtkAllocation a;
+    gtk_widget_get_allocation (it->data, &a);
+    if (px >= a.x && px < a.x + a.width && py >= a.y && py < a.y + a.height) selected = it->data;
+  }
+  g_list_free (children);
+  if (!self->drag_selection)
+    self->drag_selection = gtk_grid_get_child_at (GTK_GRID (self->symbols_grid), 0, 0);
+  if (selected) {
+    gtk_widget_unset_state_flags (self->drag_selection, GTK_STATE_FLAG_PRELIGHT);
+    self->drag_selection = selected;
+    gtk_widget_set_state_flags (selected, GTK_STATE_FLAG_PRELIGHT, FALSE);
+  }
+  if (commit && self->drag_selection) on_button_clicked (self, GTK_BUTTON (self->drag_selection));
+}
