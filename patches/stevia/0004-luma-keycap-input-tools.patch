+static void
+keycap_languages (GtkButton *unused, PosInputSurface *self)
+{
+  GVariant *point = g_variant_new ("(ii)", 0, 0);
+  gtk_popover_popdown (GTK_POPOVER (self->preferences));
+  g_action_group_activate_action (G_ACTION_GROUP (self->action_map), "menu", point);
+}
+
+static gboolean
+keycap_search_open (GtkWidget *entry, GdkEventButton *event, PosInputSurface *self)
+{
+  if (keycap_sensitive (self)) return TRUE;
+  self->emoji_search_active = TRUE;
+  if (self->last_layout) hdy_deck_set_visible_child (self->deck, self->last_layout);
+  keycap_update_strip (self);
+  return TRUE;
+}
