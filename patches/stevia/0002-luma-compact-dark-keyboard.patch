diff --git a/src/stylesheet/luma-dark.css b/src/stylesheet/luma-dark.css
new file mode 100644
index 0000000..b2d437d
--- /dev/null
+++ b/src/stylesheet/luma-dark.css
@@ -0,0 +1,57 @@
+/* Project Luma's compact dark handheld keyboard palette. */
+@define-color pos_key_fg_color #f4f5f6;
+@define-color pos_key_bg_color #30363d;
+@define-color pos_fg_color #f4f5f6;
+@define-color pos_bg_color #171b20;
+@define-color theme_selected_bg_color #f3f4f5;
+@define-color theme_selected_fg_color #171b20;
+
+@import url("resource:///mobi/phosh/stevia/stylesheet/common.css");
+
+pos-input-surface,
+pos-osk-widget {
+  color: #f4f5f6;
+  background-color: #171b20;
+  font-family: Figtree, sans-serif;
+}
+
+pos-key {
+  color: #f4f5f6;
+  background: #30363d;
+  border-radius: 8px;
+  margin: 3px;
+  font-weight: 500;
+  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.28);
+}
+
+pos-key.pressed {
+  color: #ffffff;
+  background: #444c55;
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15);
+}
+
+pos-key.sys,
+pos-key.toggle,
+pos-shortcuts-bar button {
+  color: #f4f5f6;
+  background: #292f35;
+}
+
+pos-key.return {
+  color: #171b20;
+  background: #f3f4f5;
+  font-weight: 600;
+}
+
+pos-key.return.pressed {
+  color: #171b20;
+  background: #d8dbde;
+}
+
+pos-completion-bar {
+  color: #f4f5f6;
+  background: #171b20;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
+}
+
+pos-completion-bar button,
+pos-completion-bar button label {
+  color: #f4f5f6;
+  background: transparent;
+  text-shadow: none;
+}
+
+pos-completion-bar button:active {
+  color: #ffffff;
+  background: #30363d;
+}
