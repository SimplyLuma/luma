+/* Project Luma's high-contrast light handheld keyboard palette. */
+@define-color pos_key_fg_color #1f2937;
+@define-color pos_key_bg_color #ffffff;
+@define-color pos_fg_color #1f2937;
+@define-color pos_bg_color #e7ebf0;
+@define-color theme_selected_bg_color #4878b8;
+@define-color theme_selected_fg_color #ffffff;
+
+@import url("resource:///mobi/phosh/stevia/stylesheet/common.css");
+
