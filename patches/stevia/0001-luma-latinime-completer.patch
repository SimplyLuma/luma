diff --git a/tests/test-completer-luma.c b/tests/test-completer-luma.c
new file mode 100644
index 0000000..0cfe89e
--- /dev/null
+++ b/tests/test-completer-luma.c
@@ -0,0 +1,116 @@
+/*
+ * Copyright (C) 2026 Project Luma
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "pos-config.h"
+
+#include "pos-test-completer.h"
+
+#include "pos.h"
+#include "pos-completer-luma.h"
+
+#include <gio/gio.h>
+#include <glib.h>
+
+typedef struct {
+  char *text;
+  int before;
+  int after;
+} Commit;
+
+static void
+on_commit (PosCompleter *completer,
+           const char   *text,
+           int           before,
+           int           after,
+           Commit       *commit)
+{
+  commit->text = g_strdup (text);
+  commit->before = before;
+  commit->after = after;
+}
+
+static char *
+commit_word (const char *word)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (PosCompleter) luma = pos_completer_luma_new (&error);
+  Commit commit = {0};
+
+  g_assert_no_error (error);
+  g_assert_nonnull (luma);
+  pos_completer_assert_initial_state (luma, "luma", "Luma");
+  g_signal_connect (luma, "commit-string", G_CALLBACK (on_commit), &commit);
+
+  for (const char *cursor = word; *cursor; cursor = g_utf8_next_char (cursor)) {
+    g_autofree char *symbol = g_strndup (cursor, g_utf8_next_char (cursor) - cursor);
+    g_assert_true (pos_completer_feed_symbol (luma, symbol));
+  }
+  g_assert_true (pos_completer_feed_symbol (luma, " "));
+  g_assert_cmpint (commit.before, ==, 0);
+  g_assert_cmpint (commit.after, ==, 0);
+  return commit.text;
+}
+
+static void
+test_completer_luma_preserves_valid_words (void)
+{
+  const char *valid_words[] = { "if", "bath", "pour", "crash", NULL };
+
+  for (guint i = 0; valid_words[i]; i++) {
+    g_autofree char *expected = g_strconcat (valid_words[i], " ", NULL);
+    g_autofree char *actual = commit_word (valid_words[i]);
+
+    g_assert_cmpstr (actual, ==, expected);
+  }
+}
+
+static void
+test_completer_luma_autocorrects_decisive_typos (void)
+{
+  const struct {
+    const char *typed;
+    const char *expected;
+  } cases[] = {
+    { "woudl", "would " },
+    { "adn", "and " },
+    { "becuase", "because " },
+    { "recieve", "receive " },
+    { "andbsee", "and see " },
+    { "tyojng", "typing " },
+    { "whenbi", "when I " },
+  };
+
+  for (guint i = 0; i < G_N_ELEMENTS (cases); i++) {
+    g_autofree char *actual = commit_word (cases[i].typed);
+
+    g_assert_cmpstr (actual, ==, cases[i].expected);
+  }
+}
+
+static void
+test_completer_luma_leaves_ambiguous_typo (void)
+{
+  g_autofree char *helo = commit_word ("helo");
+  g_autofree char *socool = commit_word ("socool");
+  g_autofree char *multiple_boundaries = commit_word ("itnfeelsnokah");
+
+  g_assert_cmpstr (helo, ==, "helo ");
+  g_assert_cmpstr (socool, ==, "socool ");
+  g_assert_cmpstr (multiple_boundaries, ==, "itnfeelsnokah ");
+}
+
+int
+main (int argc, char *argv[])
+{
+  gtk_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/pos/completer/luma/preserves-valid-words",
+                   test_completer_luma_preserves_valid_words);
+  g_test_add_func ("/pos/completer/luma/autocorrects-decisive-typos",
+                   test_completer_luma_autocorrects_decisive_typos);
+  g_test_add_func ("/pos/completer/luma/leaves-ambiguous-typo",
+                   test_completer_luma_leaves_ambiguous_typo);
+  return g_test_run ();
+}
