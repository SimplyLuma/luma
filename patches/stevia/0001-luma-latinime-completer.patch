index 0000000..37668ac
--- /dev/null
+++ b/src/completers/pos-completer-luma.c
@@ -0,0 +1,495 @@
+/*
+ * Copyright (C) 2026 Project Luma
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#define G_LOG_DOMAIN "pos-completer-luma"
+
+#include "pos-config.h"
+
+#include "pos-completer-luma.h"
+#include "pos-completer-priv.h"
+
+#include <gio/gio.h>
+
+#define LUMA_DECODER "/usr/libexec/luma-latinime-decoder"
+#define LUMA_DICTIONARY "/usr/share/luma-keyboard/main_en.dict"
+#define LUMA_APPROPRIATE_FOR_AUTOCORRECTION 0x10000000
+#define LUMA_KIND_MASK 0xff
+#define LUMA_KIND_CORRECTION 1
+#define LUMA_MAX_COMPLETIONS 3
+#define LUMA_MIN_AUTOCORRECT_SCORE 200000
+#define LUMA_MIN_AUTOCORRECT_MARGIN 100000
+#define LUMA_MIN_COMPOUND_SCORE 225000
+#define LUMA_MIN_COMPOUND_MARGIN 150000
+
+enum {
+  PROP_0,
+  PROP_NAME,
+  PROP_PREEDIT,
+  PROP_COMPLETIONS,
+  PROP_MODE_NAME,
+  PROP_LAST_PROP
+};
+static GParamSpec *props[PROP_LAST_PROP];
+
+struct _PosCompleterLuma {
+  PosCompleterBase parent;
+
+  GString          *preedit;
+  GStrv             completions;
+  char             *autocorrect;
+  char             *previous;
+  GSubprocess      *decoder;
+  GOutputStream    *decoder_stdin;
+  GDataInputStream *decoder_stdout;
+};
+
+static void pos_completer_luma_interface_init (PosCompleterInterface *iface);
+static void pos_completer_luma_initable_interface_init (GInitableIface *iface);
+
+G_DEFINE_TYPE_WITH_CODE (PosCompleterLuma, pos_completer_luma, POS_TYPE_COMPLETER_BASE,
+                         G_IMPLEMENT_INTERFACE (POS_TYPE_COMPLETER,
+                                                pos_completer_luma_interface_init)
+                         G_IMPLEMENT_INTERFACE (G_TYPE_INITABLE,
+                                                pos_completer_luma_initable_interface_init))
+
+static void
+pos_completer_luma_set_completions (PosCompleterLuma *self, GStrv completions)
+{
+  g_strfreev (self->completions);
+  self->completions = g_strdupv (completions);
+  g_object_notify_by_pspec (G_OBJECT (self), props[PROP_COMPLETIONS]);
+}
+
+static char *
+match_input_case (const char *candidate, const char *typed)
+{
+  gunichar first;
+  gunichar upper;
+  char encoded[7] = {0};
+  int length;
+
+  if (!candidate || !*candidate || !typed || !*typed)
+    return g_strdup (candidate);
+  if (!g_unichar_isupper (g_utf8_get_char (typed)))
+    return g_strdup (candidate);
+
+  first = g_utf8_get_char (candidate);
+  upper = g_unichar_toupper (first);
+  length = g_unichar_to_utf8 (upper, encoded);
+  encoded[length] = '\0';
+  return g_strconcat (encoded, g_utf8_next_char (candidate), NULL);
+}
+
+static void
+pos_completer_luma_clear_decoder (PosCompleterLuma *self)
+{
+  if (self->decoder) {
+    g_subprocess_send_signal (self->decoder, SIGTERM);
+    g_subprocess_wait (self->decoder, NULL, NULL);
+  }
+  g_clear_object (&self->decoder_stdin);
+  g_clear_object (&self->decoder_stdout);
+  g_clear_object (&self->decoder);
+}
+
+static gboolean
+pos_completer_luma_start_decoder (PosCompleterLuma *self, GError **error)
+{
+  g_autofree char *ready = NULL;
+  gsize ready_len = 0;
+  const char *decoder = g_getenv ("LUMA_LATINIME_DECODER");
+  const char *dictionary = g_getenv ("LUMA_LATINIME_DICTIONARY");
+
+  if (!decoder || !*decoder)
+    decoder = LUMA_DECODER;
+  if (!dictionary || !*dictionary)
+    dictionary = LUMA_DICTIONARY;
+
+  pos_completer_luma_clear_decoder (self);
+  self->decoder = g_subprocess_new (G_SUBPROCESS_FLAGS_STDIN_PIPE |
+                                    G_SUBPROCESS_FLAGS_STDOUT_PIPE |
+                                    G_SUBPROCESS_FLAGS_STDERR_SILENCE,
+                                    error,
+                                    decoder,
+                                    dictionary,
+                                    NULL);
+  if (!self->decoder)
+    return FALSE;
+
+  self->decoder_stdin = g_object_ref (g_subprocess_get_stdin_pipe (self->decoder));
+  self->decoder_stdout = g_data_input_stream_new (g_subprocess_get_stdout_pipe (self->decoder));
+  ready = g_data_input_stream_read_line (self->decoder_stdout, &ready_len, NULL, error);
+  if (!ready || g_strcmp0 (ready, "READY") != 0) {
+    if (error && *error == NULL)
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                           "Luma decoder did not become ready");
+    pos_completer_luma_clear_decoder (self);
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+static gboolean
+parse_candidate (const char *field, char **text, guint *kind, gint64 *score)
+{
+  g_autofree char *copy = g_strdup (field);
+  char *score_sep;
+  char *kind_sep;
+  guint64 parsed;
+
+  score_sep = strrchr (copy, ':');
+  if (!score_sep)
+    return FALSE;
+  *score_sep = '\0';
+  kind_sep = strrchr (copy, ':');
+  if (!kind_sep)
+    return FALSE;
+  *kind_sep = '\0';
+  parsed = g_ascii_strtoull (kind_sep + 1, NULL, 10);
+  if (!*copy)
+    return FALSE;
+
+  *text = g_strdup (copy);
+  *kind = (guint)parsed;
+  *score = g_ascii_strtoll (score_sep + 1, NULL, 10);
+  return TRUE;
+}
+
+static gboolean
+is_autocorrect_candidate (guint kind)
+{
+  return (kind & LUMA_APPROPRIATE_FOR_AUTOCORRECTION) &&
+         ((kind & LUMA_KIND_MASK) == LUMA_KIND_CORRECTION);
+}
+
+static gboolean
+has_decisive_score (const char *candidate, gint64 score, gint64 runner_up_score)
+{
+  const gboolean compound = strchr (candidate, ' ') != NULL;
+  const gint64 score_floor = compound ? LUMA_MIN_COMPOUND_SCORE
+                                      : LUMA_MIN_AUTOCORRECT_SCORE;
+  const gint64 margin_floor = compound ? LUMA_MIN_COMPOUND_MARGIN
+                                       : LUMA_MIN_AUTOCORRECT_MARGIN;
+
+  if (score < score_floor)
+    return FALSE;
+  if (runner_up_score == G_MININT64)
+    return TRUE;
+  if (score - runner_up_score < margin_floor)
+    return FALSE;
+
+  /* Multiword recovery must lead by 2x; ordinary correction by 1.5x. */
+  if (runner_up_score > 0)
+    return compound ? score >= runner_up_score * 2
+                    : score * 2 >= runner_up_score * 3;
+  return TRUE;
+}
+
+static gboolean
+pos_completer_luma_query (PosCompleterLuma *self, GError **error)
+{
+  g_autofree char *lower = NULL;
+  g_autofree char *request = NULL;
+  g_autofree char *response = NULL;
+  g_auto (GStrv) fields = NULL;
+  g_autoptr (GStrvBuilder) builder = g_strv_builder_new ();
+  gsize response_len = 0;
+  gsize written = 0;
+  guint accepted = 0;
+  gboolean exact_match = FALSE;
+  g_autofree char *autocorrect = NULL;
+  gint64 autocorrect_score = G_MININT64;
+  gint64 runner_up_score = G_MININT64;
+
+  g_clear_pointer (&self->autocorrect, g_free);
+  if (!self->preedit->len) {
+    pos_completer_luma_set_completions (self, NULL);
+    return TRUE;
+  }
+
+  if (!self->decoder && !pos_completer_luma_start_decoder (self, error))
+    return FALSE;
+
+  lower = g_utf8_strdown (self->preedit->str, -1);
+  request = g_strdup_printf ("%s\t%s\t\n", lower, self->previous ?: "");
+  if (!g_output_stream_write_all (self->decoder_stdin,
+                                  request,
+                                  strlen (request),
+                                  &written,
+                                  NULL,
+                                  error) ||
+      !g_output_stream_flush (self->decoder_stdin, NULL, error)) {
+    pos_completer_luma_clear_decoder (self);
+    return FALSE;
+  }
+
+  response = g_data_input_stream_read_line (self->decoder_stdout,
+                                             &response_len,
+                                             NULL,
+                                             error);
+  if (!response || !g_str_has_prefix (response, "R")) {
+    if (error && *error == NULL)
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                           "Invalid Luma decoder response");
+    pos_completer_luma_clear_decoder (self);
+    return FALSE;
+  }
+
+  fields = g_strsplit (response, "\t", -1);
+  /*
+   * LatinIME includes the typed token when it already considers the word
+   * valid.  Treat that as an absolute veto: suggestions remain useful, but a
+   * valid word must never be silently replaced by a more frequent neighbour.
+   */
+  for (guint i = 1; fields[i]; i++) {
+    g_autofree char *candidate = NULL;
+    guint kind = 0;
+    gint64 score = 0;
+
+    if (!parse_candidate (fields[i], &candidate, &kind, &score))
+      continue;
+    if (g_ascii_strcasecmp (candidate, lower) == 0) {
+      exact_match = TRUE;
+      break;
+    }
+  }
+
+  for (guint i = 1; fields[i] && accepted < LUMA_MAX_COMPLETIONS; i++) {
+    g_autofree char *candidate = NULL;
+    g_autofree char *display = NULL;
+    guint kind = 0;
+    gint64 score = 0;
+
+    if (!parse_candidate (fields[i], &candidate, &kind, &score))
+      continue;
+    display = match_input_case (candidate, self->preedit->str);
+    g_strv_builder_add (builder, display);
+    accepted++;
+
+    if (!exact_match && is_autocorrect_candidate (kind)) {
+      if (!autocorrect) {
+        autocorrect = g_strdup (display);
+        autocorrect_score = score;
+      } else if (g_ascii_strcasecmp (candidate, autocorrect) != 0 &&
+                 runner_up_score == G_MININT64) {
+        runner_up_score = score;
+      }
+    }
+  }
+
+  /*
+   * Autocorrect only when an invalid token has one genuinely decisive result.
+   * Ambiguous results are displayed as suggestions and left to the user.
+   */
+  if (!exact_match && autocorrect &&
+      has_decisive_score (autocorrect, autocorrect_score, runner_up_score))
+    self->autocorrect = g_steal_pointer (&autocorrect);
+
+  if (accepted) {
+    g_auto (GStrv) completions = g_strv_builder_end (builder);
+    pos_completer_luma_set_completions (self, completions);
+  } else {
+    pos_completer_luma_set_completions (self, NULL);
+  }
+  return TRUE;
+}
+
+static const char *
+pos_completer_luma_get_name (PosCompleter *iface)
+{
+  return "luma";
+}
+
+static char *
+pos_completer_luma_get_display_name (PosCompleter *iface)
+{
+  return g_strdup ("Luma");
+}
+
+static const char *
+pos_completer_luma_get_preedit (PosCompleter *iface)
+{
+  return POS_COMPLETER_LUMA (iface)->preedit->str;
+}
+
+static void
+pos_completer_luma_set_preedit (PosCompleter *iface, const char *preedit)
+{
+  PosCompleterLuma *self = POS_COMPLETER_LUMA (iface);
+
+  if (g_strcmp0 (self->preedit->str, preedit) == 0)
+    return;
+  g_string_assign (self->preedit, preedit ?: "");
+  if (!preedit) {
+    g_clear_pointer (&self->autocorrect, g_free);
+    pos_completer_luma_set_completions (self, NULL);
+  }
+  g_object_notify_by_pspec (G_OBJECT (self), props[PROP_PREEDIT]);
+}
+
+static gboolean
+pos_completer_luma_feed_symbol (PosCompleter *iface, const char *symbol)
+{
+  PosCompleterLuma *self = POS_COMPLETER_LUMA (iface);
+  g_autofree char *before = g_strdup (self->preedit->str);
+  g_autoptr (GError) error = NULL;
+
+  if (pos_completer_add_preedit (iface, self->preedit, symbol)) {
+    g_autofree char *commit = NULL;
+    const char *suffix = self->preedit->str + strlen (before);
+    const char *word = self->autocorrect ?: before;
+
+    commit = g_strconcat (word, suffix, NULL);
+    g_signal_emit_by_name (self, "commit-string", commit, 0, 0);
+    if (*word) {
+      g_free (self->previous);
+      self->previous = g_utf8_strdown (word, -1);
+    }
+    pos_completer_luma_set_preedit (iface, NULL);
+    return g_strcmp0 (symbol, "KEY_ENTER") != 0;
+  }
+
+  if (g_strcmp0 (self->preedit->str, before) == 0)
+    return FALSE;
+  g_object_notify_by_pspec (G_OBJECT (self), props[PROP_PREEDIT]);
+  if (!pos_completer_luma_query (self, &error))
+    g_warning ("Luma decoder query failed: %s", error->message);
+  return TRUE;
+}
+
+static gboolean
+pos_completer_luma_set_selected (PosCompleter *iface, const char *selected)
+{
+  PosCompleterLuma *self = POS_COMPLETER_LUMA (iface);
+
+  g_free (self->previous);
+  self->previous = g_utf8_strdown (selected, -1);
+  return FALSE;
+}
+
+static gboolean
+pos_completer_luma_set_language (PosCompleter *iface,
+                                 const char   *lang,
+                                 const char   *region,
+                                 GError      **error)
+{
+  if (g_strcmp0 (lang, "en") == 0)
+    return TRUE;
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+               "Luma decoder has no %s-%s dictionary", lang, region ?: "");
+  return FALSE;
+}
+
+static void
+pos_completer_luma_set_property (GObject      *object,
+                                 guint         property_id,
+                                 const GValue *value,
+                                 GParamSpec   *pspec)
+{
+  switch (property_id) {
+  case PROP_PREEDIT:
+    pos_completer_luma_set_preedit (POS_COMPLETER (object), g_value_get_string (value));
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+  }
+}
+
+static void
+pos_completer_luma_get_property (GObject    *object,
+                                 guint       property_id,
+                                 GValue     *value,
+                                 GParamSpec *pspec)
+{
+  PosCompleterLuma *self = POS_COMPLETER_LUMA (object);
+
+  switch (property_id) {
+  case PROP_NAME:
+    g_value_set_string (value, "luma");
+    break;
+  case PROP_PREEDIT:
+    g_value_set_string (value, self->preedit->str);
+    break;
+  case PROP_COMPLETIONS:
+    g_value_set_boxed (value, self->completions);
+    break;
+  case PROP_MODE_NAME:
+    g_value_set_string (value, "Luma");
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+  }
+}
+
+static void
+pos_completer_luma_finalize (GObject *object)
+{
+  PosCompleterLuma *self = POS_COMPLETER_LUMA (object);
+
+  pos_completer_luma_clear_decoder (self);
+  g_clear_pointer (&self->completions, g_strfreev);
+  g_clear_pointer (&self->autocorrect, g_free);
+  g_clear_pointer (&self->previous, g_free);
+  g_string_free (self->preedit, TRUE);
+  G_OBJECT_CLASS (pos_completer_luma_parent_class)->finalize (object);
+}
+
+static void
+pos_completer_luma_class_init (PosCompleterLumaClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->get_property = pos_completer_luma_get_property;
+  object_class->set_property = pos_completer_luma_set_property;
+  object_class->finalize = pos_completer_luma_finalize;
+  g_object_class_override_property (object_class, PROP_NAME, "name");
+  g_object_class_override_property (object_class, PROP_PREEDIT, "preedit");
+  g_object_class_override_property (object_class, PROP_COMPLETIONS, "completions");
+  g_object_class_override_property (object_class, PROP_MODE_NAME, "mode-name");
+  props[PROP_NAME] = g_object_class_find_property (object_class, "name");
+  props[PROP_PREEDIT] = g_object_class_find_property (object_class, "preedit");
+  props[PROP_COMPLETIONS] = g_object_class_find_property (object_class, "completions");
+  props[PROP_MODE_NAME] = g_object_class_find_property (object_class, "mode-name");
+}
+
+static gboolean
+pos_completer_luma_initable_init (GInitable *initable,
+                                  GCancellable *cancelable,
+                                  GError **error)
+{
+  return pos_completer_luma_start_decoder (POS_COMPLETER_LUMA (initable), error);
+}
+
+static void
+pos_completer_luma_initable_interface_init (GInitableIface *iface)
+{
+  iface->init = pos_completer_luma_initable_init;
+}
+
+static void
+pos_completer_luma_interface_init (PosCompleterInterface *iface)
+{
+  iface->get_name = pos_completer_luma_get_name;
+  iface->get_display_name = pos_completer_luma_get_display_name;
+  iface->feed_symbol = pos_completer_luma_feed_symbol;
+  iface->get_preedit = pos_completer_luma_get_preedit;
+  iface->set_preedit = pos_completer_luma_set_preedit;
+  iface->set_selected = pos_completer_luma_set_selected;
+  iface->set_language = pos_completer_luma_set_language;
+}
+
+static void
+pos_completer_luma_init (PosCompleterLuma *self)
+{
+  self->preedit = g_string_new (NULL);
+}
+
+PosCompleter *
+pos_completer_luma_new (GError **error)
+{
+  return POS_COMPLETER (g_initable_new (POS_TYPE_COMPLETER_LUMA, NULL, error, NULL));
+}
