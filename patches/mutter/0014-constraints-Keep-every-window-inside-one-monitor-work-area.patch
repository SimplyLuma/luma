+  guint placed_outside_work_area_by_user : 1;
+
   /* Whether we're sticky in the multi-workspace sense
    * (vs. the not-scroll-with-viewport sense, we don't
    * have no stupid viewports)
diff --git a/src/core/window.c b/src/core/window.c
index 6155cb6..6f1e357 100644
--- a/src/core/window.c
+++ b/src/core/window.c
@@ -4165,6 +4165,10 @@ meta_window_update_for_monitors_changed (MetaWindow *window)
       goto out;
     }
 
+  /* A new monitor layout: whatever the person left partly off a work area
+   * in the old one is brought fully inside a work area of the new one. */
+  window->placed_outside_work_area_by_user = FALSE;
+
   old = window->monitor;
   new = meta_window_find_monitor_from_id (window);
 
diff --git a/src/wayland/meta-window-wayland.c b/src/wayland/meta-window-wayland.c
index 6d20598..f373a24 100644
--- a/src/wayland/meta-window-wayland.c
+++ b/src/wayland/meta-window-wayland.c
@@ -1705,6 +1705,19 @@ meta_window_wayland_finish_move_resize (MetaWindow              *window,
                   place_flags |= META_PLACE_FLAG_CALCULATE;
                   flags |= META_MOVE_RESIZE_CONSTRAIN;
                 }
+              else
+                {
+                  MetaWindowDrag *window_drag =
+                    meta_compositor_get_current_window_drag (window->display->compositor);
+
+                  /* The position in an acknowledged configuration was right
+                   * when it was sent; a client that acknowledges it late (after
