+#include "meta/common.h"
+#include "meta/meta-context.h"
+
+G_BEGIN_DECLS
+
+/**
+ * MetaDataDragAction:
+ * @META_DATA_DRAG_ACTION_NONE: no action
+ * @META_DATA_DRAG_ACTION_COPY: the target copies the data
+ * @META_DATA_DRAG_ACTION_MOVE: the target moves the data
+ * @META_DATA_DRAG_ACTION_ASK: the target asks what to do
+ *
+ * The actions a #MetaDataDrag offers, with the values of
+ * `wl_data_device_manager.dnd_action`.
+ */
+typedef enum
+{
+  META_DATA_DRAG_ACTION_NONE = 0,
+  META_DATA_DRAG_ACTION_COPY = 1 << 0,
+  META_DATA_DRAG_ACTION_MOVE = 1 << 1,
+  META_DATA_DRAG_ACTION_ASK = 1 << 2,
+} MetaDataDragAction;
+
+/**
+ * MetaDataDragResult:
+ * @META_DATA_DRAG_RESULT_CANCELLED: nothing took the drop, or it was
+ *   cancelled
+ * @META_DATA_DRAG_RESULT_DROPPED: a client took the drop
+ * @META_DATA_DRAG_RESULT_DROPPED_ON_COMPOSITOR: a #MetaDataDrag::drop
+ *   handler took the drop
+ */
+typedef enum
+{
+  META_DATA_DRAG_RESULT_CANCELLED,
+  META_DATA_DRAG_RESULT_DROPPED,
+  META_DATA_DRAG_RESULT_DROPPED_ON_COMPOSITOR,
+} MetaDataDragResult;
+
+#define META_TYPE_DATA_DRAG (meta_data_drag_get_type ())
+
+META_EXPORT
+G_DECLARE_FINAL_TYPE (MetaDataDrag,
+                      meta_data_drag,
+                      META, DATA_DRAG,
+                      GObject)
+
+META_EXPORT
+MetaDataDrag * meta_data_drag_new (MetaContext *context);
+
+META_EXPORT
+void meta_data_drag_set_content (MetaDataDrag *drag,
+                                 const char   *mime_type,
+                                 GBytes       *content);
+
+META_EXPORT
+void meta_data_drag_offer (MetaDataDrag *drag,
+                           const char   *mime_type);
+
+META_EXPORT
+void meta_data_drag_set_actions (MetaDataDrag       *drag,
+                                 MetaDataDragAction  actions,
+                                 MetaDataDragAction  preferred);
+
+META_EXPORT
+gboolean meta_data_drag_begin (MetaDataDrag        *drag,
+                               const ClutterEvent  *event,
+                               GError             **error);
+
+META_EXPORT
+void meta_data_drag_cancel (MetaDataDrag *drag);
+
+META_EXPORT
+MetaDataDragAction meta_data_drag_get_action (MetaDataDrag *drag);
+
+META_EXPORT
+gboolean meta_data_drag_is_over_client (MetaDataDrag *drag);
+
+G_END_DECLS
