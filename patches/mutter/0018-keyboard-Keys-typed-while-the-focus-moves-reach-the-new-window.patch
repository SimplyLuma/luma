diff --git a/src/tests/key-handover-test.c b/src/tests/key-handover-test.c
new file mode 100644
index 0000000..647f796
--- /dev/null
+++ b/src/tests/key-handover-test.c
@@ -0,0 +1,204 @@
+/*
+ * Copyright (C) 2026 Project Luma
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ */
+
+/* Luma: the keyboard focus handover rules (meta-key-handover.c). Prints one
+ * TAP line per test; the %check counts the "ok" lines. */
+
+#include "config.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#include "wayland/meta-key-handover.h"
+
+static int test_number;
+static int failures;
+
+static void
+report (gboolean    passed,
+        const char *name)
+{
+  test_number++;
+  printf ("%s %d - %s\n", passed ? "ok" : "not ok", test_number, name);
+  if (!passed)
+    failures++;
+}
+
+typedef struct
+{
+  int key;
+  gboolean press;
+} FakeKey;
+
+typedef struct
+{
+  GString *log;
+  MetaKeyHandoverDestination last_destination;
+  int named_key;
+} Sink;
+
+static FakeKey *
+fake_key (int      key,
+          gboolean press)
+{
+  FakeKey *k = g_new0 (FakeKey, 1);
+
+  k->key = key;
+  k->press = press;
+  return k;
+}
+
+static void
+sink_deliver (gpointer                   event,
+              MetaKeyHandoverDestination destination,
+              gpointer                   user_data)
+{
+  Sink *sink = user_data;
+  FakeKey *k = event;
+
+  g_string_append_printf (sink->log, "%c%d ", k->press ? '+' : '-', k->key);
+  sink->last_destination = destination;
+}
+
+static gboolean
+sink_is_named_press (gpointer event,
+                     gpointer user_data)
+{
+  Sink *sink = user_data;
+  FakeKey *k = event;
+
+  return k->press && k->key == sink->named_key;
+}
+
+static GPtrArray *
+held (void)
+{
+  GPtrArray *events = g_ptr_array_new_with_free_func (g_free);
+
+  g_ptr_array_add (events, fake_key (30, TRUE));
+  g_ptr_array_add (events, fake_key (30, FALSE));
+  g_ptr_array_add (events, fake_key (48, TRUE));
+  return events;
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  MetaKeyHandoverState lock_screen = {
+    .stage_has_grab = TRUE, .stage_has_key_focus = FALSE,
+    .windows_interactable = FALSE, .keyboard_focus_is_client = FALSE,
+    .target_is_other_client = TRUE,
+  };
+  MetaKeyHandoverState lock_screen_old_focus = {
+    .stage_has_grab = TRUE, .stage_has_key_focus = FALSE,
+    .windows_interactable = FALSE, .keyboard_focus_is_client = TRUE,
+    .target_is_other_client = TRUE,
+  };
+  MetaKeyHandoverState shell_entry_no_grab = {
+    .stage_has_grab = FALSE, .stage_has_key_focus = FALSE,
+    .windows_interactable = TRUE, .keyboard_focus_is_client = TRUE,
+    .target_is_other_client = TRUE,
+  };
+  MetaKeyHandoverState grab_only = {
+    .stage_has_grab = TRUE, .stage_has_key_focus = TRUE,
+    .windows_interactable = FALSE, .keyboard_focus_is_client = TRUE,
+    .target_is_other_client = TRUE,
+  };
+  MetaKeyHandoverState from_nothing = {
+    .stage_has_grab = FALSE, .stage_has_key_focus = TRUE,
+    .windows_interactable = TRUE, .keyboard_focus_is_client = FALSE,
+    .target_is_other_client = TRUE,
+  };
+  MetaKeyHandoverState client_to_client = {
+    .stage_has_grab = FALSE, .stage_has_key_focus = TRUE,
+    .windows_interactable = TRUE, .keyboard_focus_is_client = TRUE,
+    .target_is_other_client = TRUE,
+  };
+  MetaKeyHandoverState settled = client_to_client;
+  Sink sink = { 0 };
+  GPtrArray *events;
+  guint delivered;
+
+  settled.target_is_other_client = FALSE;
+
+  /* 1-4: the focus is on the shell (the lock screen, the unlock dialog, a
+   * shell entry, a modal): a key is not held, it goes straight on. */
+  report (!meta_key_handover_should_hold (&lock_screen) &&
+          meta_key_handover_destination (&lock_screen) == META_KEY_HANDOVER_TO_SHELL,
+          "lock screen: a key is delivered to the shell at once, not held");
+  report (!meta_key_handover_should_hold (&lock_screen_old_focus) &&
+          meta_key_handover_destination (&lock_screen_old_focus) == META_KEY_HANDOVER_TO_SHELL,
+          "lock screen over a window that had the keyboard: not held");
+  report (!meta_key_handover_should_hold (&shell_entry_no_grab) &&
+          meta_key_handover_destination (&shell_entry_no_grab) == META_KEY_HANDOVER_TO_SHELL,
+          "shell actor with the key focus, no grab: not held");
+  report (!meta_key_handover_should_hold (&grab_only),
+          "any grab: not held");
+
+  /* 5-7: only a move between two client windows holds keys. */
+  report (!meta_key_handover_should_hold (&from_nothing),
+          "no client had the keyboard: not held");
+  report (meta_key_handover_should_hold (&client_to_client) &&
+          meta_key_handover_destination (&client_to_client) == META_KEY_HANDOVER_TO_CLIENT,
+          "client to client: held for the new window");
+  report (!meta_key_handover_should_hold (&settled),
+          "focus already arrived: not held");
+
+  /* 8: a handover that times out while the shell has the keyboard (the
+   * machine locked meanwhile) delivers every key to the shell, in order. */
+  sink.log = g_string_new (NULL);
+  sink.named_key = 30;
+  events = held ();
+  delivered = meta_key_handover_release (events,
+                                         meta_key_handover_destination (&lock_screen),
+                                         sink_is_named_press, sink_deliver,
+                                         g_free, &sink);
+  report (delivered == 3 && events->len == 0 &&
+          g_str_equal (sink.log->str, "+30 -30 +48 ") &&
+          sink.last_destination == META_KEY_HANDOVER_TO_SHELL,
+          "timeout with the focus on the shell: all keys delivered in order");
+  g_ptr_array_unref (events);
+
+  /* 9: a timeout with a window still holding the keyboard delivers to it. */
+  g_string_truncate (sink.log, 0);
+  events = held ();
+  delivered = meta_key_handover_release (events,
+                                         META_KEY_HANDOVER_TO_CLIENT,
+                                         NULL, sink_deliver, g_free, &sink);
+  report (delivered == 3 && events->len == 0 &&
+          g_str_equal (sink.log->str, "+30 -30 +48 "),
+          "timeout with a window focused: all keys delivered, none dropped");
+  g_ptr_array_unref (events);
+
+  /* 10: once the enter event named a key that is down, only its press is
+   * left out; everything else still arrives, in order. */
+  g_string_truncate (sink.log, 0);
+  sink.named_key = 48;
+  events = held ();
+  delivered = meta_key_handover_release (events,
+                                         META_KEY_HANDOVER_TO_CLIENT,
+                                         sink_is_named_press, sink_deliver,
+                                         g_free, &sink);
+  report (delivered == 2 && events->len == 0 &&
+          g_str_equal (sink.log->str, "+30 -30 "),
+          "focus arrived: a press named in the enter event is not sent twice");
+  g_ptr_array_unref (events);
+
+  /* 11: releasing nothing delivers nothing and does not crash. */
+  events = g_ptr_array_new_with_free_func (g_free);
+  report (meta_key_handover_release (events, META_KEY_HANDOVER_TO_SHELL,
+                                     NULL, sink_deliver, g_free, &sink) == 0,
+          "nothing held: nothing delivered");
+  g_ptr_array_unref (events);
+
+  g_string_free (sink.log, TRUE);
+  printf ("1..%d\n", test_number);
+  return failures == 0 ? 0 : 1;
+}
diff --git a/src/wayland/meta-key-handover.c b/src/wayland/meta-key-handover.c
new file mode 100644
index 0000000..f705f5e
--- /dev/null
+++ b/src/wayland/meta-key-handover.c
@@ -0,0 +1,86 @@
+/*
+ * Copyright (C) 2026 Project Luma
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include "wayland/meta-key-handover.h"
+
+/* A key is held only while the keyboard moves from one client window to
+ * another. Whenever the shell has the keyboard -- a grab or modal, the lock
+ * screen and its unlock dialog, the overview search, the run dialog, any
+ * actor with the key focus -- nothing is held: those keys are the shell's
+ * and reach it at once. */
+gboolean
+meta_key_handover_should_hold (const MetaKeyHandoverState *state)
+{
+  return (!state->stage_has_grab &&
+          state->stage_has_key_focus &&
+          state->windows_interactable &&
+          state->keyboard_focus_is_client &&
+          state->target_is_other_client);
+}
+
+/* Whoever has the keyboard now: a client only when there is no grab and
+ * the stage itself has the key focus; otherwise the shell. */
+MetaKeyHandoverDestination
+meta_key_handover_destination (const MetaKeyHandoverState *state)
+{
+  if (!state->stage_has_grab &&
+      state->stage_has_key_focus &&
+      state->keyboard_focus_is_client)
+    return META_KEY_HANDOVER_TO_CLIENT;
+
+  return META_KEY_HANDOVER_TO_SHELL;
+}
+
+/* Hands every held key to @destination in the order it was typed and
+ * empties @events. Nothing is dropped. The one key not sent again is a
+ * press a client was already told about in its enter event
+ * (@is_named_press); the shell gets everything. Each key is freed with
+ * @free_event once it has been handed on. Returns the number of keys
+ * delivered. */
+guint
+meta_key_handover_release (GPtrArray                   *events,
+                           MetaKeyHandoverDestination   destination,
+                           MetaKeyHandoverIsNamedPress  is_named_press,
+                           MetaKeyHandoverDeliver       deliver,
+                           GDestroyNotify               free_event,
+                           gpointer                     user_data)
+{
+  g_autofree gpointer *taken = NULL;
+  gsize n_taken = 0;
+  guint delivered = 0;
+  gsize i;
+
+  if (!events || events->len == 0)
+    return 0;
+
+  /* Take the keys first: delivering one can hold or release keys again. */
+  taken = g_ptr_array_steal (events, &n_taken);
+
+  for (i = 0; i < n_taken; i++)
+    {
+      gpointer event = taken[i];
+
+      if (destination == META_KEY_HANDOVER_TO_CLIENT &&
+          is_named_press && is_named_press (event, user_data))
+        {
+          if (free_event)
+            free_event (event);
+          continue;
+        }
+
+      deliver (event, destination, user_data);
+      delivered++;
+      if (free_event)
+        free_event (event);
+    }
+
+  return delivered;
+}
diff --git a/src/wayland/meta-key-handover.h b/src/wayland/meta-key-handover.h
new file mode 100644
index 0000000..a82c5cb
--- /dev/null
+++ b/src/wayland/meta-key-handover.h
@@ -0,0 +1,54 @@
+/*
+ * Copyright (C) 2026 Project Luma
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ */
+
+#pragma once
+
+#include <glib.h>
+
+/* Luma: the rules for keys typed while the keyboard focus moves between
+ * windows, kept apart from the rest of Mutter so they can be tested alone. */
+
+typedef enum
+{
+  META_KEY_HANDOVER_TO_CLIENT,
+  META_KEY_HANDOVER_TO_SHELL,
+} MetaKeyHandoverDestination;
+
+typedef struct
+{
+  /* The shell has a grab: a modal, the lock screen, the overview. */
+  gboolean stage_has_grab;
+  /* The stage itself has the key focus, so keys go to Wayland clients. A
+   * shell actor with the key focus (an entry, the unlock dialog) is not. */
+  gboolean stage_has_key_focus;
+  gboolean windows_interactable;
+  /* A client surface has the keyboard now. */
+  gboolean keyboard_focus_is_client;
+  /* The focused window is a client whose surface does not have the
+   * keyboard yet. */
+  gboolean target_is_other_client;
+} MetaKeyHandoverState;
+
+gboolean meta_key_handover_should_hold (const MetaKeyHandoverState *state);
+
+MetaKeyHandoverDestination meta_key_handover_destination (const MetaKeyHandoverState *state);
+
+typedef gboolean (* MetaKeyHandoverIsNamedPress) (gpointer event,
+                                                  gpointer user_data);
+
+typedef void (* MetaKeyHandoverDeliver) (gpointer                   event,
+                                         MetaKeyHandoverDestination destination,
+                                         gpointer                   user_data);
+
+guint meta_key_handover_release (GPtrArray                   *events,
+                                 MetaKeyHandoverDestination   destination,
+                                 MetaKeyHandoverIsNamedPress  is_named_press,
+                                 MetaKeyHandoverDeliver       deliver,
+                                 GDestroyNotify               free_event,
+                                 gpointer                     user_data);
diff --git a/src/wayland/meta-wayland-keyboard.c b/src/wayland/meta-wayland-keyboard.c
index 27b101c..f5d2b78 100644
--- a/src/wayland/meta-wayland-keyboard.c
+++ b/src/wayland/meta-wayland-keyboard.c
@@ -54,6 +54,8 @@
 #include "backends/meta-backend-private.h"
 #include "core/display-private.h"
 #include "mtk/mtk.h"
+#include "clutter/clutter-mutter.h"
+#include "wayland/meta-key-handover.h"
 #include "wayland/meta-wayland-private.h"
 
 typedef struct
@@ -90,6 +92,20 @@ struct _MetaWaylandKeyboard
   MetaWaylandXkbInfo xkb_info;
   GSettings *settings;
 
+  /* Luma: the keys typed while the keyboard focus is on its way to another
+   * window. See meta_wayland_keyboard_hold_for_handover(). */
+  struct {
+    MetaWaylandSurface *surface;
+    struct wl_listener surface_destroy_listener;
+    GPtrArray *events;
+    GHashTable *held_keys;
+    int64_t since_us;
+    guint timeout_id;
+    /* The keyboard focus has entered a surface since the keys were held,
+     * and the enter event named the keys that are down. */
+    gboolean entered;
+  } handover;
+
   /* Modifier state last sent to the client under the pointer while that
    * client has no keyboard focus. See
    * meta_wayland_keyboard_sync_pointer_modifiers(). */
@@ -110,6 +126,40 @@ G_DEFINE_TYPE (MetaWaylandKeyboard, meta_wayland_keyboard,
 static void meta_wayland_keyboard_update_xkb_state (MetaWaylandKeyboard *keyboard);
 static void notify_modifiers (MetaWaylandKeyboard *keyboard);
 static void invalidate_pointer_modifiers (MetaWaylandKeyboard *keyboard);
+static void send_key_to_focus (MetaWaylandKeyboard *keyboard,
+                               const ClutterEvent  *event);
+static guint release_held_keys (MetaWaylandKeyboard *keyboard,
+                                const char          *why);
+
+
+/* Luma: how long, and how many keys, a handover may hold. A person typing
+ * fast enough to run into a handover types a few letters; past this the
+ * keys are not part of the switch any more and go, in order, to whoever
+ * has the keyboard. They are never dropped. */
+#define META_KEY_HANDOVER_MAX_MS 1000
+#define META_KEY_HANDOVER_MAX_KEYS 64
+
+static MetaDisplay *
+display_from_keyboard (MetaWaylandKeyboard *keyboard)
+{
+  MetaWaylandInputDevice *input_device = META_WAYLAND_INPUT_DEVICE (keyboard);
+  MetaWaylandSeat *seat = meta_wayland_input_device_get_seat (input_device);
+  MetaWaylandCompositor *compositor = meta_wayland_seat_get_compositor (seat);
+  MetaContext *context = meta_wayland_compositor_get_context (compositor);
+
+  return meta_context_get_display (context);
+}
+
+static gboolean
+handover_debug (void)
+{
+  static int debug = -1;
+
+  if (debug < 0)
+    debug = g_getenv ("MUTTER_DEBUG_KEY_HANDOVER") != NULL ? 1 : 0;
+
+  return debug == 1;
+}
 
 static MetaBackend *
 backend_from_keyboard (MetaWaylandKeyboard *keyboard)
@@ -249,9 +299,27 @@ keyboard_handle_focus_surface_destroy (struct wl_listener *listener, void *data)
   meta_wayland_keyboard_set_focus (keyboard, NULL);
 }
 
+/* Whether a key is down as far as the client has been told (the enter
+ * event carries these). */
 static gboolean
-meta_wayland_keyboard_broadcast_key (MetaWaylandKeyboard *keyboard,
-                                     const ClutterEvent  *event)
+key_is_pressed (MetaWaylandKeyboard *keyboard,
+                uint32_t             key)
+{
+  uint32_t *keys = keyboard->pressed_keys.data;
+  size_t i, n = keyboard->pressed_keys.size / sizeof (uint32_t);
+
+  for (i = 0; i < n; i++)
+    {
+      if (keys[i] == key)
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+static void
+send_key_to_focus (MetaWaylandKeyboard *keyboard,
+                   const ClutterEvent  *event)
 {
   struct wl_resource *resource;
   enum wl_keyboard_key_state key_state;
@@ -309,6 +377,23 @@ meta_wayland_keyboard_broadcast_key (MetaWaylandKeyboard *keyboard,
           wl_keyboard_send_key (resource, serial, time, key, key_state);
         }
     }
+}
+
+static gboolean
+meta_wayland_keyboard_broadcast_key (MetaWaylandKeyboard *keyboard,
+                                     const ClutterEvent  *event)
+{
+  if (handover_debug ())
+    {
+      g_message ("[luma-keys] key %u (%s) %s at %" G_GINT64_FORMAT " us",
+                 clutter_event_get_event_code (event),
+                 clutter_event_type (event) == CLUTTER_KEY_PRESS ? "press" : "release",
+                 keyboard->focus_surface ? "sent to the focused window"
+                                         : "went nowhere: no window has the keyboard",
+                 g_get_monotonic_time ());
+    }
+
+  send_key_to_focus (keyboard, event);
 
   /* Eat the key events if we have a focused surface. */
