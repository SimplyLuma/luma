+/* Luma: where the keyboard focus is going, if it is not there yet. Mutter
+ * decides which window is focused at once, but the focus reaches the
+ * client's surface later -- the client has to be told, and the surface only
+ * takes the focus when the compositor next updates it. A key that arrives
+ * in between belongs to the window the person is switching to, not to the
+ * one they left and not to nobody. This only ever applies between two
+ * client windows: see meta_key_handover_should_hold().
+ */
+static MetaKeyHandoverState
+handover_state (MetaWaylandKeyboard  *keyboard,
+                MetaWaylandSurface  **out_target)
+{
+  MetaKeyHandoverState state = { 0 };
+  MetaDisplay *display = display_from_keyboard (keyboard);
+  MetaBackend *backend = backend_from_keyboard (keyboard);
+  ClutterStage *stage = CLUTTER_STAGE (meta_backend_get_stage (backend));
+  ClutterActor *key_focus = clutter_stage_get_key_focus (stage);
+  MetaWindow *window = display ? meta_display_get_focus_window (display) : NULL;
+  MetaWaylandSurface *surface = window ? meta_window_get_wayland_surface (window) : NULL;
+
+  state.stage_has_grab = clutter_stage_get_grab_actor (stage) != NULL;
+  state.stage_has_key_focus = (key_focus == NULL ||
+                               key_focus == CLUTTER_ACTOR (stage));
+  state.windows_interactable = (display &&
+                                meta_display_windows_are_interactable (display));
+  state.keyboard_focus_is_client = keyboard->focus_surface != NULL;
+  state.target_is_other_client = (surface && surface->resource &&
+                                  surface != keyboard->focus_surface);
+
+  if (out_target)
+    *out_target = state.target_is_other_client ? surface : NULL;
+
+  return state;
+}
+
+/* Ends the handover without touching the keys it holds. */
+static void
+stop_handover (MetaWaylandKeyboard *keyboard)
+{
+  g_clear_handle_id (&keyboard->handover.timeout_id, g_source_remove);
+  if (keyboard->handover.surface)
+    {
+      wl_list_remove (&keyboard->handover.surface_destroy_listener.link);
+      keyboard->handover.surface = NULL;
+    }
+  if (keyboard->handover.held_keys)
+    g_hash_table_remove_all (keyboard->handover.held_keys);
+  keyboard->handover.entered = FALSE;
+}
+
+static gboolean
+held_key_was_named (gpointer data,
+                    gpointer user_data)
+{
+  MetaWaylandKeyboard *keyboard = user_data;
+  const ClutterEvent *event = data;
+
+  /* The enter event named the keys that are down, so sending their press
+   * again would give the client the same key twice. */
+  return (clutter_event_type (event) == CLUTTER_KEY_PRESS &&
+          key_is_pressed (keyboard, clutter_event_get_event_code (event)));
+}
+
+static void
+deliver_held_key (gpointer                   data,
+                  MetaKeyHandoverDestination destination,
+                  gpointer                   user_data)
+{
+  MetaWaylandKeyboard *keyboard = user_data;
+  const ClutterEvent *event = data;
+  ClutterModifierSet raw_modifiers;
+  ClutterEvent *copy;
+
+  if (destination == META_KEY_HANDOVER_TO_CLIENT)
+    {
+      send_key_to_focus (keyboard, event);
+      return;
+    }
+
+  /* The shell has the keyboard: the key goes back through the stage to the
+   * actor with the key focus (the unlock dialog, a modal, an entry). It is
+   * marked synthetic so it is neither held again nor sent to a client. */
+  clutter_event_get_key_state (event,
+                               &raw_modifiers.pressed,
+                               &raw_modifiers.latched,
+                               &raw_modifiers.locked);
+  copy = clutter_event_key_new (clutter_event_type (event),
+                                clutter_event_get_flags (event) |
+                                CLUTTER_EVENT_FLAG_SYNTHETIC,
+                                clutter_event_get_time_us (event),
+                                clutter_event_get_source_device (event),
+                                raw_modifiers,
+                                clutter_event_get_state (event),
+                                clutter_event_get_key_symbol (event),
+                                clutter_event_get_event_code (event),
+                                clutter_event_get_key_code (event),
+                                clutter_event_get_key_unicode (event));
+  clutter_event_put (copy);
+  clutter_event_free (copy);
+}
+
+/* Ends the handover and hands every key it held, in order, to whoever has
+ * the keyboard now: the window, or the shell. Nothing is dropped. */
+static guint
+release_held_keys (MetaWaylandKeyboard *keyboard,
+                   const char          *why)
+{
+  MetaKeyHandoverState state;
+  MetaKeyHandoverDestination destination;
+  gboolean entered = keyboard->handover.entered;
+  double waited_ms;
+  guint held, delivered;
+
+  waited_ms = (g_get_monotonic_time () - keyboard->handover.since_us) / 1000.0;
+  stop_handover (keyboard);
+
+  if (!keyboard->handover.events || keyboard->handover.events->len == 0)
+    return 0;
+
+  held = keyboard->handover.events->len;
+  state = handover_state (keyboard, NULL);
+  destination = meta_key_handover_destination (&state);
+  delivered = meta_key_handover_release (keyboard->handover.events,
+                                         destination,
+                                         entered ? held_key_was_named : NULL,
+                                         deliver_held_key,
+                                         (GDestroyNotify) clutter_event_free,
+                                         keyboard);
+
+  g_message ("[luma-keys] delivered %u of %u key event(s) typed while the "
+             "keyboard focus was moving, %.1f ms later, to %s: %s",
+             delivered, held, waited_ms,
+             destination == META_KEY_HANDOVER_TO_CLIENT ?
+             "the window with the keyboard" : "the shell",
+             why);
+
+  return delivered;
+}
+
+void
+meta_wayland_keyboard_release_held_keys (MetaWaylandKeyboard *keyboard,
+                                         const char          *why)
+{
+  release_held_keys (keyboard, why);
+}
+
+static void
+handover_surface_destroyed (struct wl_listener *listener,
+                            void               *data)
+{
+  MetaWaylandKeyboard *keyboard =
+    wl_container_of (listener, keyboard, handover.surface_destroy_listener);
+
+  wl_list_remove (&keyboard->handover.surface_destroy_listener.link);
+  keyboard->handover.surface = NULL;
+  release_held_keys (keyboard, "the window went away");
+}
+
+static gboolean
+handover_timed_out (gpointer user_data)
+{
+  MetaWaylandKeyboard *keyboard = user_data;
+
+  keyboard->handover.timeout_id = 0;
+  release_held_keys (keyboard, "the focus did not arrive in time");
+
+  return G_SOURCE_REMOVE;
+}
+
+/* Hold a key that was typed during a handover between two client windows,
+ * to be given to the window the focus is going to as soon as it has it.
+ * Only a press and the release that goes with it are held: a release of a
+ * key whose press the window being left already had goes to that window,
+ * so no client is left with a key it thinks is still down.
+ */
+gboolean
+meta_wayland_keyboard_maybe_hold_key (MetaWaylandKeyboard *keyboard,
+                                      const ClutterEvent  *event)
+{
+  MetaKeyHandoverState state;
+  MetaWaylandSurface *target = NULL;
+  ClutterEventType type = clutter_event_type (event);
+  uint32_t key;
+  gboolean is_press = type == CLUTTER_KEY_PRESS;
+  gboolean pending;
+
+  if (type != CLUTTER_KEY_PRESS && type != CLUTTER_KEY_RELEASE)
+    return FALSE;
+
+  key = clutter_event_get_event_code (event);
+
+  if (clutter_event_get_flags (event) & CLUTTER_EVENT_FLAG_REPEATED)
+    return FALSE;
+
+  if (clutter_event_get_flags (event) & CLUTTER_EVENT_FLAG_SYNTHETIC &&
+      !(clutter_event_get_flags (event) & CLUTTER_EVENT_FLAG_INPUT_METHOD))
+    return FALSE;
+
+  pending = keyboard->handover.events && keyboard->handover.events->len > 0;
+  state = handover_state (keyboard, &target);
+
+  if (!meta_key_handover_should_hold (&state))
+    {
+      if (pending &&
+          meta_key_handover_destination (&state) == META_KEY_HANDOVER_TO_SHELL)
+        {
+          /* The held keys go back through the stage, so this one follows
+           * them there to keep the order they were typed in. */
+          g_ptr_array_add (keyboard->handover.events, clutter_event_copy (event));
+          release_held_keys (keyboard, "the shell has the keyboard");
+          return TRUE;
+        }
+
+      if (pending)
+        release_held_keys (keyboard, "the focus is not moving between windows");
+
+      if (handover_debug ())
+        {
+          g_message ("[luma-keys] key %u (%s) not held: grab %s, key focus on "
+                     "%s, keyboard focus %s, at %" G_GINT64_FORMAT " us", key,
+                     is_press ? "press" : "release",
+                     state.stage_has_grab ? "yes" : "no",
+                     state.stage_has_key_focus ? "the stage" : "a shell actor",
+                     state.keyboard_focus_is_client ? "a surface" : "nothing",
+                     g_get_monotonic_time ());
+        }
+      return FALSE;
+    }
+
+  if (!keyboard->handover.events)
+    {
+      keyboard->handover.events =
+        g_ptr_array_new_with_free_func ((GDestroyNotify) clutter_event_free);
+      keyboard->handover.held_keys = g_hash_table_new (NULL, NULL);
+      keyboard->handover.surface_destroy_listener.notify =
+        handover_surface_destroyed;
+    }
+
+  if (keyboard->handover.surface && keyboard->handover.surface != target)
+    release_held_keys (keyboard, "the focus went to another window first");
+
+  if (!is_press &&
+      !g_hash_table_contains (keyboard->handover.held_keys,
+                              GUINT_TO_POINTER (key)))
+    return FALSE;
+
+  if (keyboard->handover.events->len >= META_KEY_HANDOVER_MAX_KEYS)
+    {
+      release_held_keys (keyboard, "more keys than a handover holds");
+      return FALSE;
+    }
+
+  if (!keyboard->handover.surface)
+    {
+      keyboard->handover.surface = target;
+      wl_resource_add_destroy_listener (target->resource,
+                                        &keyboard->handover.surface_destroy_listener);
+      keyboard->handover.since_us = g_get_monotonic_time ();
+      keyboard->handover.entered = FALSE;
+      keyboard->handover.timeout_id =
+        g_timeout_add (META_KEY_HANDOVER_MAX_MS, handover_timed_out, keyboard);
+    }
+
+  if (is_press)
+    g_hash_table_add (keyboard->handover.held_keys, GUINT_TO_POINTER (key));
+  else
+    g_hash_table_remove (keyboard->handover.held_keys, GUINT_TO_POINTER (key));
+
+  g_ptr_array_add (keyboard->handover.events, clutter_event_copy (event));
+
+  if (handover_debug ())
+    {
+      g_message ("[luma-keys] holding key %u (%s) %.1f ms into a handover",
+                 key, is_press ? "press" : "release",
+                 (g_get_monotonic_time () - keyboard->handover.since_us) / 1000.0);
+    }
+
+  return TRUE;
+}
+
+/* The window has the focus now: give it the keys typed on the way. A key
+ * still held down was already named in the enter event, so its press is not
+ * sent again -- only what the client has not been told about.
+ */
+static void
+flush_handover (MetaWaylandKeyboard *keyboard)
+{
+  if (!keyboard->handover.surface ||
+      keyboard->handover.surface != keyboard->focus_surface ||
+      !keyboard->handover.events ||
+      keyboard->handover.events->len == 0)
+    return;
+
+  keyboard->handover.entered = TRUE;
+  release_held_keys (keyboard, "the focus arrived");
+}
+
 static void
 broadcast_focus (MetaWaylandKeyboard *keyboard,
                  struct wl_resource  *resource)
@@ -1022,6 +1412,28 @@ meta_wayland_keyboard_set_focus (MetaWaylandKeyboard *keyboard,
               broadcast_focus (keyboard, resource);
             }
         }
+
+      /* Luma: the window has the focus now, so it gets the keys that were
+       * typed on the way. */
+      flush_handover (keyboard);
+    }
+
+  if (keyboard->handover.surface && keyboard->handover.surface != surface)
+    {
+      keyboard->handover.entered = surface != NULL;
+      release_held_keys (keyboard, "the focus went elsewhere");
+    }
+
+  if (handover_debug ())
+    {
+      MetaDisplay *display = display_from_keyboard (keyboard);
+      MetaWindow *window = display ? meta_display_get_focus_window (display) : NULL;
+
+      g_message ("[luma-keys] keyboard focus is now %s (focus window %s) at %"
+                 G_GINT64_FORMAT " us",
+                 surface ? "a surface" : "nothing",
+                 window ? meta_window_get_title (window) : "none",
+                 g_get_monotonic_time ());
     }
 }
 
