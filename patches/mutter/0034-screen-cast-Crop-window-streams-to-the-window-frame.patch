   };
 }
 
+/* The frame rectangle in buffer pixels, relative to the buffer origin: what
+ * the window shows, without the client's shadow margin or the invisible
+ * borders of a server-side frame. */
+static void
+meta_window_actor_get_frame_bounds (MetaScreenCastWindow *screen_cast_window,
+                                    MtkRectangle         *bounds)
+{
+  MetaWindowActor *window_actor = META_WINDOW_ACTOR (screen_cast_window);
+  MetaWindowActorPrivate *priv =
+    meta_window_actor_get_instance_private (window_actor);
+  MetaShapedTexture *stex;
+  MtkRectangle buffer_bounds;
+  MtkRectangle buffer_rect;
+  MtkRectangle frame_rect;
+  MtkRectangle frame_bounds;
+  float stage_width, stage_height;
+  float scale_x, scale_y;
+  int x1, y1, x2, y2;
+
+  meta_window_actor_get_buffer_bounds (screen_cast_window, &buffer_bounds);
+  *bounds = buffer_bounds;
+
+  if (!priv->window || !priv->surface)
+    return;
+
+  /* Buffer pixels per stage unit: the texture's size in buffer pixels over
+   * its size on the stage (surface size times the geometry scale). This
+   * covers buffer scales, fractional scales through a viewport and
+   * Xwayland scaling. */
+  stex = meta_surface_actor_get_texture (priv->surface);
+  stage_width = meta_shaped_texture_get_width (stex) * priv->geometry_scale;
+  stage_height = meta_shaped_texture_get_height (stex) * priv->geometry_scale;
+  if (stage_width <= 0.0f || stage_height <= 0.0f)
+    return;
+
+  scale_x = buffer_bounds.width / stage_width;
+  scale_y = buffer_bounds.height / stage_height;
+
+  meta_window_get_buffer_rect (priv->window, &buffer_rect);
+  meta_window_get_frame_rect (priv->window, &frame_rect);
+
+  x1 = (int) roundf ((frame_rect.x - buffer_rect.x) * scale_x);
+  y1 = (int) roundf ((frame_rect.y - buffer_rect.y) * scale_y);
+  x2 = (int) roundf ((frame_rect.x + frame_rect.width - buffer_rect.x) * scale_x);
+  y2 = (int) roundf ((frame_rect.y + frame_rect.height - buffer_rect.y) * scale_y);
+
+  frame_bounds = (MtkRectangle) {
+    .x = x1,
+    .y = y1,
+    .width = x2 - x1,
+    .height = y2 - y1,
+  };
+
+  if (!mtk_rectangle_intersect (&buffer_bounds, &frame_bounds, bounds))
+    *bounds = buffer_bounds;
+}
+
 static void
 meta_window_actor_transform_relative_position (MetaScreenCastWindow *screen_cast_window,
                                                double                x,
@@ -1424,60 +1481,81 @@ meta_window_actor_transform_cursor_position (MetaScreenCastWindow *screen_cast_w
   return TRUE;
 }
 
+static gboolean meta_window_actor_blit_to_framebuffer (MetaScreenCastWindow *screen_cast_window,
+                                                       MtkRectangle         *bounds,
+                                                       CoglFramebuffer      *framebuffer);
+
+/* Draws the window the way the DMA-BUF path does, through
+ * meta_window_actor_blit_to_framebuffer(), so a memory buffer holds the
+ * window in buffer pixels from the buffer origin, as the stream's crop
+ * assumes. meta_window_actor_get_image() draws at the actor's resource
+ * scale, which differs from the buffer's at fractional scales. */
 static void
 meta_window_actor_capture_into (MetaScreenCastWindow *screen_cast_window,
                                 MtkRectangle         *bounds,
                                 uint8_t              *data)
 {
   MetaWindowActor *window_actor = META_WINDOW_ACTOR (screen_cast_window);
-  cairo_surface_t *image;
-  uint8_t *cr_data;
-  int cr_stride;
-  int cr_width;
-  int cr_height;
-  int bpp = 4;
+  MetaWindowActorPrivate *priv =
+    meta_window_actor_get_instance_private (window_actor);
+  MetaDisplay *display = meta_compositor_get_display (priv->compositor);
+  MetaContext *context = meta_display_get_context (display);
+  MetaBackend *backend = meta_context_get_backend (context);
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  CoglContext *cogl_context =
+    clutter_backend_get_cogl_context (clutter_backend);
+  g_autoptr (GError) error = NULL;
+  MtkRectangle buffer_bounds;
+  MtkRectangle capture_rect;
+  CoglTexture *texture;
+  CoglFramebuffer *framebuffer;
+  CoglBitmap *bitmap;
+  int stride = bounds->width * 4;
 
-  if (meta_window_actor_is_destroyed (window_actor))
-    return;
+  memset (data, 0, (size_t) stride * bounds->height);
 
-  image = meta_window_actor_get_image (window_actor, bounds);
-  cr_data = cairo_image_surface_get_data (image);
-  cr_width = cairo_image_surface_get_width (image);
-  cr_height = cairo_image_surface_get_height (image);
-  cr_stride = cairo_image_surface_get_stride (image);
+  if (meta_window_actor_is_destroyed (window_actor) || !priv->surface)
+    return;
 
-  if (cr_width == bounds->width && cr_height == bounds->height)
-    {
-      memcpy (data, cr_data, cr_height * cr_stride);
-    }
-  else
-    {
-      int width = MIN (bounds->width, cr_width);
-      int height = MIN (bounds->height, cr_height);
-      int stride = width * bpp;
-      uint8_t *src, *dst;
+  meta_window_actor_get_buffer_bounds (screen_cast_window, &buffer_bounds);
+  if (!mtk_rectangle_intersect (bounds, &buffer_bounds, &capture_rect))
+    return;
 
-      src = cr_data;
-      dst = data;
+  texture = cogl_texture_2d_new_with_size (cogl_context,
+                                           capture_rect.width,
+                                           capture_rect.height);
+  if (!texture)
+    return;
 
-      for (int i = 0; i < height; i++)
-        {
-          memcpy (dst, src, stride);
-          if (width < bounds->width)
-            memset (dst + stride, 0, (bounds->width * bpp) - stride);
+  cogl_texture_2d_set_auto_mipmap (COGL_TEXTURE_2D (texture), FALSE);
+  framebuffer = COGL_FRAMEBUFFER (cogl_offscreen_new_with_texture (texture));
+  g_object_unref (texture);
 
-          src += cr_stride;
-          dst += bounds->width * bpp;
-        }
+  if (!cogl_framebuffer_allocate (framebuffer, &error))
+    {
+      g_warning ("Failed to allocate a window screencast framebuffer: %s",
+                 error->message);
+      g_object_unref (framebuffer);
+      return;
+    }
 
-      for (int i = height; i < bounds->height; i++)
-        {
-          memset (dst, 0, bounds->width * bpp);
-          dst += bounds->width * bpp;
-        }
+  if (meta_window_actor_blit_to_framebuffer (screen_cast_window,
+                                             &capture_rect,
+                                             framebuffer))
+    {
+      bitmap = cogl_bitmap_new_for_data (cogl_context,
+                                         capture_rect.width,
+                                         capture_rect.height,
+                                         COGL_PIXEL_FORMAT_CAIRO_ARGB32_COMPAT,
+                                         stride,
+                                         data);
+      cogl_framebuffer_read_pixels_into_bitmap (framebuffer, 0, 0,
+                                                COGL_READ_PIXELS_COLOR_BUFFER,
+                                                bitmap);
+      g_object_unref (bitmap);
     }
 
-  cairo_surface_destroy (image);
+  g_object_unref (framebuffer);
 }
 
 static gboolean
@@ -1490,6 +1568,7 @@ meta_window_actor_blit_to_framebuffer (MetaScreenCastWindow *screen_cast_window,
     meta_window_actor_get_instance_private (window_actor);
   ClutterActor *actor = CLUTTER_ACTOR (window_actor);
   ClutterPaintContext *paint_context;
+  ClutterActorBox allocation;
   graphene_rect_t scaled_clip;
   CoglColor clear_color;
   MetaShapedTexture *stex;
@@ -1503,6 +1582,12 @@ meta_window_actor_blit_to_framebuffer (MetaScreenCastWindow *screen_cast_window,
   if (!priv->surface)
     return FALSE;
 
+  /* A commit that resizes the window queues a relayout that the stage runs
+   * on its next update. A frame recorded before that would paint the new
+   * buffer into the old allocation, while the stream's crop already follows
+   * the new frame; bring the allocation up to date first. */
+  clutter_actor_get_allocation_box (CLUTTER_ACTOR (priv->surface), &allocation);
+
   stex = meta_surface_actor_get_texture (priv->surface);
 
   width = meta_shaped_texture_get_width (stex);
@@ -1599,6 +1684,7 @@ static void
 screen_cast_window_iface_init (MetaScreenCastWindowInterface *iface)
 {
   iface->get_buffer_bounds = meta_window_actor_get_buffer_bounds;
+  iface->get_frame_bounds = meta_window_actor_get_frame_bounds;
   iface->transform_relative_position = meta_window_actor_transform_relative_position;
   iface->transform_cursor_position = meta_window_actor_transform_cursor_position;
   iface->capture_into = meta_window_actor_capture_into;
