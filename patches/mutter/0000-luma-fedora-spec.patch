@@ -179,6 +202,25 @@
 
 %find_lang %{name}
 
+%check
+# Luma: the scroll speed arithmetic (0019). Every test must report ok; a run
+# that reaches fewer than all of them fails with the count.
+gcc -o scroll-scale-test -I%{_vpath_builddir} -Isrc \
+  src/tests/scroll-scale-test.c src/backends/meta-scroll-scale.c \
+  $(pkg-config --cflags --libs glib-2.0) -lm
+./scroll-scale-test --tap | tee scroll-scale-test.log
+passed=$(grep -c "^ok " scroll-scale-test.log)
+test "$passed" -eq 6 || { echo "scroll-scale-test: $passed of 6 passed"; exit 1; }
+# Luma: the keyboard focus handover (0018). Keys are never held while the
+# shell has the keyboard and are never dropped. Every test must report ok.
+gcc -o key-handover-test -I%{_vpath_builddir} -Isrc \
+  src/tests/key-handover-test.c src/wayland/meta-key-handover.c \
+  $(pkg-config --cflags --libs glib-2.0)
+./key-handover-test | tee key-handover-test.log
+passed=$(grep -c "^ok " key-handover-test.log)
+test "$passed" -eq 11 || { echo "key-handover-test: $passed of 11 passed"; exit 1; }
+glib-compile-schemas --strict --dry-run %{buildroot}%{_datadir}/glib-2.0/schemas
+
 %files -f %{name}.lang
