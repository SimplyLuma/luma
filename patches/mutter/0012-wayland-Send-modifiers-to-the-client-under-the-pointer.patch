diff --git a/src/tests/wayland-test-clients/pointer-modifiers.c b/src/tests/wayland-test-clients/pointer-modifiers.c
new file mode 100644
index 0000000..3e7f6dd
--- /dev/null
+++ b/src/tests/wayland-test-clients/pointer-modifiers.c
@@ -0,0 +1,452 @@
+/*
