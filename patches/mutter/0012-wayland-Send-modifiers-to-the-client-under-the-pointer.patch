diff --git a/src/tests/wayland-keyboard-tests.c b/src/tests/wayland-keyboard-tests.c
index 5e43ccd..7813610 100644
--- a/src/tests/wayland-keyboard-tests.c
+++ b/src/tests/wayland-keyboard-tests.c
@@ -219,6 +219,139 @@ keyboard_focus_switch (void)
   meta_wayland_test_client_finish (wayland_test_client2);
 }
 
+static MetaWindow *
+wait_for_shown_window (const char *title)
+{
+  MetaWindow *window;
+
+  window = meta_wait_for_client_window (test_context, title);
+  while (meta_window_is_hidden (window))
+    g_main_context_iteration (NULL, TRUE);
+  meta_wait_for_effects (window);
+
+  return window;
+}
+
+static void
+move_pointer_to_window (ClutterVirtualInputDevice *virtual_pointer,
+                        MetaWindow                *window)
+{
+  MtkRectangle rect;
+
+  meta_window_get_frame_rect (window, &rect);
+  clutter_virtual_input_device_notify_absolute_motion (virtual_pointer,
+                                                       g_get_monotonic_time (),
+                                                       rect.x + rect.width / 2,
+                                                       rect.y + rect.height / 2);
+  meta_flush_input (test_context);
+}
+
+static void
+notify_key (ClutterVirtualInputDevice *virtual_keyboard,
+            uint32_t                   key,
+            ClutterKeyState            state)
+{
+  clutter_virtual_input_device_notify_key (virtual_keyboard,
+                                           g_get_monotonic_time (),
+                                           key, state);
+  meta_flush_input (test_context);
+}
+
+static void
+scroll_down (ClutterVirtualInputDevice *virtual_pointer)
+{
+  clutter_virtual_input_device_notify_discrete_scroll (virtual_pointer,
+                                                       g_get_monotonic_time (),
+                                                       CLUTTER_SCROLL_DOWN,
+                                                       CLUTTER_SCROLL_SOURCE_WHEEL);
+  meta_flush_input (test_context);
+}
+
+static void
+keyboard_pointer_modifiers (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaDisplay *display = meta_context_get_display (test_context);
+  ClutterSeat *seat = meta_backend_get_default_seat (backend);
+  g_autoptr (ClutterVirtualInputDevice) virtual_keyboard = NULL;
+  g_autoptr (ClutterVirtualInputDevice) virtual_pointer = NULL;
+  MetaWaylandTestClient *bystander_client, *hover_client, *focus_client;
+  MetaWindow *bystander_window, *hover_window, *focus_window;
+
+  /* The window under the pointer is told the modifier state with its pointer
+   * events even without keyboard focus (wl_keyboard.modifiers without enter),
+   * only then, and is reset when the pointer leaves; other clients learn
+   * nothing. The assertions on the wire order live in the client. */
+  meta_backend_inhibit_hw_cursor (backend);
+  virtual_keyboard = clutter_seat_create_virtual_device (seat,
+                                                         CLUTTER_KEYBOARD_DEVICE);
+  virtual_pointer = clutter_seat_create_virtual_device (seat,
+                                                        CLUTTER_POINTER_DEVICE);
+  /* Park the pointer where no window will be. */
+  clutter_virtual_input_device_notify_absolute_motion (virtual_pointer,
+                                                       g_get_monotonic_time (),
+                                                       630, 470);
+  meta_flush_input (test_context);
+
+  bystander_client =
+    meta_wayland_test_client_new_with_args (test_context,
+                                            "pointer-modifiers",
+                                            "bystander",
+                                            NULL);
+  bystander_window = wait_for_shown_window ("pointer-modifiers-bystander");
+  hover_client =
+    meta_wayland_test_client_new_with_args (test_context,
+                                            "pointer-modifiers",
+                                            "hover",
+                                            NULL);
+  hover_window = wait_for_shown_window ("pointer-modifiers-hover");
+  focus_client =
+    meta_wayland_test_client_new_with_args (test_context,
+                                            "pointer-modifiers",
+                                            "focus",
+                                            NULL);
+  focus_window = wait_for_shown_window ("pointer-modifiers-focus");
+
+  meta_window_move_frame (bystander_window, FALSE, 0, 300);
+  meta_window_move_frame (hover_window, FALSE, 0, 0);
+  meta_window_move_frame (focus_window, FALSE, 300, 0);
+  while (meta_display_get_focus_window (display) != focus_window)
+    g_main_context_iteration (NULL, TRUE);
+
+  move_pointer_to_window (virtual_pointer, hover_window);
+  wait_for_sync_point (200);
+
+  notify_key (virtual_keyboard, KEY_LEFTCTRL, CLUTTER_KEY_STATE_PRESSED);
+  meta_wayland_test_driver_emit_sync_event (test_driver, 0);
+
+  scroll_down (virtual_pointer);
+  wait_for_sync_point (201);
+
+  notify_key (virtual_keyboard, KEY_LEFTCTRL, CLUTTER_KEY_STATE_RELEASED);
+  meta_wayland_test_driver_emit_sync_event (test_driver, 1);
+
+  scroll_down (virtual_pointer);
+  wait_for_sync_point (202);
+
+  notify_key (virtual_keyboard, KEY_LEFTCTRL, CLUTTER_KEY_STATE_PRESSED);
+  scroll_down (virtual_pointer);
+  wait_for_sync_point (203);
+
+  move_pointer_to_window (virtual_pointer, focus_window);
+  wait_for_sync_point (204);
+
+  notify_key (virtual_keyboard, KEY_LEFTCTRL, CLUTTER_KEY_STATE_RELEASED);
+  notify_key (virtual_keyboard, KEY_LEFTSHIFT, CLUTTER_KEY_STATE_PRESSED);
+  notify_key (virtual_keyboard, KEY_LEFTSHIFT, CLUTTER_KEY_STATE_RELEASED);
+  g_assert_true (meta_display_get_focus_window (display) == focus_window);
+  meta_wayland_test_driver_emit_sync_event (test_driver, 2);
+
+  meta_wayland_test_client_finish (hover_client);
+  meta_wayland_test_client_finish (focus_client);
+  meta_wayland_test_client_finish (bystander_client);
+  meta_backend_uninhibit_hw_cursor (backend);
+}
+
 static void
 on_before_tests (void)
 {
@@ -267,6 +400,8 @@ init_tests (void)
                    keyboard_client_shortcut);
   g_test_add_func ("/wayland/keyboard/focus-switch",
                    keyboard_focus_switch);
+  g_test_add_func ("/wayland/keyboard/pointer-modifiers",
+                   keyboard_pointer_modifiers);
 }
 
