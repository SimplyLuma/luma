+/*
+ * Modifier state for the client under the pointer
+ *
+ * wl_pointer events carry no modifier state, and a client learns modifiers
+ * only through wl_keyboard. Without the following, a window that is hovered
+ * but not focused sees no Control or Shift on its scroll, button, motion and
+ * gesture events, unlike on X11, macOS and Windows.
+ *
+ * wayland.xml explicitly allows wl_keyboard.modifiers "without a surface of
+ * the client having keyboard focus, for example to tie modifier information
+ * to pointer focus instead", and a reset by sending no pressed modifiers.
+ *
+ * Mutter uses that permission narrowly:
+ *
+ *  - only the client that owns the pointer focus surface is told, and only
+ *    while it has no keyboard focus (otherwise the focus path already keeps
+ *    it current);
+ *  - it is told only immediately before a pointer event is delivered to it
+ *    (enter, motion, button, axis, touchpad gesture), and only when the
+ *    state differs from what that client was last sent, so modifier changes
+ *    are never streamed to a client while nothing happens on its surface;
+ *  - when the pointer leaves it, a client that was sent pressed or latched
+ *    modifiers is sent a reset with none pressed.
+ */
+
+static void
+invalidate_pointer_modifiers (MetaWaylandKeyboard *keyboard)
+{
+  keyboard->pointer_modifiers.sent = FALSE;
+}
+
+static gboolean
+client_has_keyboard_focus (MetaWaylandKeyboard *keyboard,
+                           struct wl_client    *client)
+{
+  return (keyboard->focus_surface &&
+          keyboard->focus_surface->resource &&
+          wl_resource_get_client (keyboard->focus_surface->resource) == client);
+}
+
+static void
+set_pointer_modifiers_client (MetaWaylandKeyboard *keyboard,
+                              struct wl_client    *client)
+{
+  if (keyboard->pointer_modifiers.client == client)
+    return;
+
+  wl_list_remove (&keyboard->pointer_modifiers.client_destroy_listener.link);
+  wl_list_init (&keyboard->pointer_modifiers.client_destroy_listener.link);
+
+  keyboard->pointer_modifiers.client = client;
+  keyboard->pointer_modifiers.sent = FALSE;
+
+  if (client)
+    {
+      wl_client_add_destroy_listener (client,
+                                      &keyboard->pointer_modifiers.client_destroy_listener);
+    }
+}
+
+static void
+pointer_modifiers_client_destroyed (struct wl_listener *listener,
+                                    void               *data)
+{
+  MetaWaylandKeyboard *keyboard =
+    wl_container_of (listener, keyboard,
+                     pointer_modifiers.client_destroy_listener);
+
+  set_pointer_modifiers_client (keyboard, NULL);
+}
+
+static void
+send_pointer_modifiers (MetaWaylandKeyboard *keyboard,
+                        struct wl_client    *client,
+                        xkb_mod_mask_t       pressed,
+                        xkb_mod_mask_t       latched,
+                        xkb_mod_mask_t       locked,
+                        uint32_t             group)
+{
+  MetaWaylandInputDevice *input_device = META_WAYLAND_INPUT_DEVICE (keyboard);
+  struct wl_resource *resource;
+  uint32_t serial = 0;
+  gboolean any = FALSE;
+
+  wl_resource_for_each (resource, &keyboard->resource_list)
+    {
+      if (wl_resource_get_client (resource) != client)
+        continue;
+
+      if (!any)
+        serial = meta_wayland_input_device_next_serial (input_device);
+
+      wl_keyboard_send_modifiers (resource, serial,
+                                  pressed, latched, locked, group);
+      any = TRUE;
+    }
+
+  keyboard->pointer_modifiers.sent = any;
+  keyboard->pointer_modifiers.pressed = pressed;
+  keyboard->pointer_modifiers.latched = latched;
+  keyboard->pointer_modifiers.locked = locked;
+  keyboard->pointer_modifiers.group = group;
+}
+
+static void
+get_pointer_event_modifiers (MetaWaylandKeyboard *keyboard,
+                             const ClutterEvent  *event,
+                             xkb_mod_mask_t      *pressed,
+                             xkb_mod_mask_t      *latched,
+                             xkb_mod_mask_t      *locked)
+{
+  MetaBackend *backend = backend_from_keyboard (keyboard);
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  ClutterSeat *seat = clutter_backend_get_default_seat (clutter_backend);
+  ClutterKeymap *keymap = clutter_seat_get_keymap (seat);
+
+  clutter_keymap_get_modifier_state (keymap, pressed, latched, locked);
+
+  if (!event)
+    return;
+
+  switch (clutter_event_type (event))
+    {
+    case CLUTTER_MOTION:
+    case CLUTTER_BUTTON_PRESS:
+    case CLUTTER_BUTTON_RELEASE:
+    case CLUTTER_SCROLL:
+      {
+        /* The event carries the effective XKB modifier state at the time it
+         * happened (plus button bits); prefer it over the keymap, whose
+         * state is updated asynchronously from the input thread. */
+        ClutterModifierType state;
+
+        state = clutter_event_get_state (event) &
+                ~(CLUTTER_BUTTON1_MASK | CLUTTER_BUTTON2_MASK |
+                  CLUTTER_BUTTON3_MASK | CLUTTER_BUTTON4_MASK |
+                  CLUTTER_BUTTON5_MASK);
+        *pressed = state & ~(*latched | *locked);
+      }
+      break;
+    default:
+      break;
+    }
+}
+
+/**
+ * meta_wayland_keyboard_sync_pointer_modifiers:
+ * @keyboard: the seat keyboard
+ * @client: (nullable): the client about to receive a pointer event
+ * @event: (nullable): the pointer event, or %NULL for pointer enter
+ *
+ * Called right before a pointer event is delivered to @client. If @client
+ * has no keyboard focus and has not yet been sent the current modifier
+ * state, sends it through wl_keyboard.modifiers.
+ */
+void
+meta_wayland_keyboard_sync_pointer_modifiers (MetaWaylandKeyboard *keyboard,
+                                              struct wl_client    *client,
+                                              const ClutterEvent  *event)
+{
+  xkb_mod_mask_t pressed, latched, locked;
+  uint32_t group;
+
+  if (keyboard->pointer_modifiers.client != client)
+    {
+      meta_wayland_keyboard_release_pointer_modifiers (keyboard,
+                                                       keyboard->pointer_modifiers.client);
+      set_pointer_modifiers_client (keyboard, client);
+    }
+
+  if (!client || client_has_keyboard_focus (keyboard, client))
+    return;
+
+  get_pointer_event_modifiers (keyboard, event, &pressed, &latched, &locked);
+  group = keyboard->xkb_info.group;
+
+  if (keyboard->pointer_modifiers.sent &&
+      keyboard->pointer_modifiers.pressed == pressed &&
+      keyboard->pointer_modifiers.latched == latched &&
+      keyboard->pointer_modifiers.locked == locked &&
+      keyboard->pointer_modifiers.group == group)
+    return;
+
+  meta_topic (META_DEBUG_WAYLAND,
+              "Sending pointer-focus modifiers 0x%x/0x%x/0x%x to unfocused client",
+              pressed, latched, locked);
+
+  send_pointer_modifiers (keyboard, client, pressed, latched, locked, group);
+}
+
+/**
+ * meta_wayland_keyboard_release_pointer_modifiers:
+ * @keyboard: the seat keyboard
+ * @client: (nullable): the client the pointer is leaving
+ *
+ * Called when the pointer leaves @client. A client without keyboard focus
+ * that was sent pressed or latched modifiers is sent a reset, so it cannot
+ * keep a stale Control or Shift.
+ */
+void
+meta_wayland_keyboard_release_pointer_modifiers (MetaWaylandKeyboard *keyboard,
+                                                 struct wl_client    *client)
+{
+  if (!client || keyboard->pointer_modifiers.client != client)
+    return;
+
+  if (keyboard->pointer_modifiers.sent &&
+      (keyboard->pointer_modifiers.pressed ||
+       keyboard->pointer_modifiers.latched) &&
+      !client_has_keyboard_focus (keyboard, client))
+    {
+      send_pointer_modifiers (keyboard, client, 0, 0,
+                              keyboard->pointer_modifiers.locked,
+                              keyboard->pointer_modifiers.group);
+    }
+
+  set_pointer_modifiers_client (keyboard, NULL);
+}
