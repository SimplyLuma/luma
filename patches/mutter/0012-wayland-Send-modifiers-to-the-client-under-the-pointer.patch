+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * Test client for modifier state delivered to the client under the pointer.
+ *
+ *   pointer-modifiers hover      the window the pointer moves over; never
+ *                                has keyboard focus while hovered
+ *   pointer-modifiers focus      holds keyboard focus
+ *   pointer-modifiers bystander  mapped first, then neither focused nor
+ *                                hovered: must receive no modifier events
+ *
+ * The compositor side is wayland-keyboard-tests.c, pointer-modifiers.
+ */
+
+#include "config.h"
+
+#include <glib.h>
+#include <linux/input-event-codes.h>
+#include <wayland-client.h>
+
+#include "wayland-test-client-utils.h"
+
+#define CONTROL_MASK (1 << 2)
+
+typedef enum
+{
+  ROLE_HOVER,
+  ROLE_FOCUS,
+  ROLE_BYSTANDER,
+} Role;
+
+static Role role;
+static gboolean running;
+static struct wl_seat *seat;
+static struct wl_pointer *pointer;
+static struct wl_keyboard *keyboard;
+
+static gboolean has_keyboard_focus;
+static gboolean has_pointer_focus;
+static gboolean axis_in_frame;
+static int axis_frames;
+static gboolean left_pointer;
+
+static int modifiers_count;
+static int modifiers_count_at_checkpoint;
+static uint32_t pressed_mods;
+static uint32_t modifiers_while_unfocused;
+
+static void
+checkpoint (void)
+{
+  modifiers_count_at_checkpoint = modifiers_count;
+}
+
+/* wl_keyboard */
+
+static void
+keyboard_handle_keymap (void               *data,
+                        struct wl_keyboard *wl_keyboard,
+                        uint32_t            format,
+                        int                 fd,
+                        uint32_t            size)
+{
+}
+
+static void
+keyboard_handle_enter (void               *data,
+                       struct wl_keyboard *wl_keyboard,
+                       uint32_t            serial,
+                       struct wl_surface  *surface,
+                       struct wl_array    *keys)
+{
+  has_keyboard_focus = TRUE;
+}
+
+static void
+keyboard_handle_leave (void               *data,
+                       struct wl_keyboard *wl_keyboard,
+                       uint32_t            serial,
+                       struct wl_surface  *surface)
+{
+  has_keyboard_focus = FALSE;
+  pressed_mods = 0;
+  modifiers_while_unfocused = 0;
+}
+
+static void
+keyboard_handle_key (void               *data,
+                     struct wl_keyboard *wl_keyboard,
+                     uint32_t            serial,
+                     uint32_t            time,
+                     uint32_t            key,
+                     uint32_t            state)
+{
+  g_assert_true (has_keyboard_focus);
+}
+
+static void
+keyboard_handle_modifiers (void               *data,
+                           struct wl_keyboard *wl_keyboard,
+                           uint32_t            serial,
+                           uint32_t            mods_pressed,
+                           uint32_t            mods_latched,
+                           uint32_t            mods_locked,
+                           uint32_t            group)
+{
+  WaylandDisplay *display = data;
+
+  pressed_mods = mods_pressed;
+
+  if (has_keyboard_focus)
+    return;
+
+  modifiers_count++;
+  modifiers_while_unfocused++;
+
+  /* An unfocused client is only told the modifier state while the pointer
+   * is on its surface, or once to reset it when the pointer leaves. */
+  g_assert_true (role == ROLE_HOVER);
+
+  if (left_pointer)
+    {
+      g_assert_cmpuint (mods_pressed, ==, 0);
+      test_driver_sync_point (display->test_driver, 204, NULL);
+    }
+  else
+    {
+      g_assert_true (has_pointer_focus);
+    }
+}
+
+static void
+keyboard_handle_repeat_info (void               *data,
+                             struct wl_keyboard *wl_keyboard,
+                             int32_t             rate,
+                             int32_t             delay)
+{
+}
+
+static const struct wl_keyboard_listener keyboard_listener = {
+  keyboard_handle_keymap,
+  keyboard_handle_enter,
+  keyboard_handle_leave,
+  keyboard_handle_key,
+  keyboard_handle_modifiers,
+  keyboard_handle_repeat_info,
+};
+
+/* wl_pointer */
+
+static void
+pointer_handle_enter (void              *data,
+                      struct wl_pointer *wl_pointer,
+                      uint32_t           serial,
+                      struct wl_surface *surface,
+                      wl_fixed_t         x,
+                      wl_fixed_t         y)
+{
+  WaylandDisplay *display = data;
+
+  has_pointer_focus = TRUE;
+
+  if (role == ROLE_HOVER && !left_pointer)
+    test_driver_sync_point (display->test_driver, 200, NULL);
+}
+
+static void
+pointer_handle_leave (void              *data,
+                      struct wl_pointer *wl_pointer,
+                      uint32_t           serial,
+                      struct wl_surface *surface)
+{
+  has_pointer_focus = FALSE;
+
+  if (role == ROLE_HOVER)
+    {
+      g_assert_cmpint (axis_frames, ==, 3);
+      left_pointer = TRUE;
+    }
+}
+
+static void
+pointer_handle_motion (void              *data,
+                       struct wl_pointer *wl_pointer,
+                       uint32_t           time,
+                       wl_fixed_t         x,
+                       wl_fixed_t         y)
+{
+}
+
+static void
+pointer_handle_button (void              *data,
+                       struct wl_pointer *wl_pointer,
+                       uint32_t           serial,
+                       uint32_t           time,
+                       uint32_t           button,
+                       uint32_t           state)
+{
+}
+
+static void
+pointer_handle_axis (void              *data,
+                     struct wl_pointer *wl_pointer,
+                     uint32_t           time,
+                     uint32_t           axis,
+                     wl_fixed_t         value)
+{
+  axis_in_frame = TRUE;
+}
+
+static void
+pointer_handle_frame (void              *data,
+                      struct wl_pointer *wl_pointer)
+{
+  WaylandDisplay *display = data;
+
+  if (!axis_in_frame || role != ROLE_HOVER)
+    return;
+
+  axis_in_frame = FALSE;
+  g_assert_false (has_keyboard_focus);
+
+  /* The state that applies to this scroll arrived before its axis events. */
+  switch (axis_frames++)
+    {
+    case 0:
+      g_assert_cmpuint (pressed_mods & CONTROL_MASK, ==, CONTROL_MASK);
+      break;
+    case 1:
+      g_assert_cmpuint (pressed_mods & CONTROL_MASK, ==, 0);
+      break;
+    case 2:
+      g_assert_cmpuint (pressed_mods & CONTROL_MASK, ==, CONTROL_MASK);
+      break;
+    default:
+      g_assert_not_reached ();
+    }
+
+  checkpoint ();
+  test_driver_sync_point (display->test_driver, 201 + axis_frames - 1, NULL);
+}
+
+static void
+pointer_handle_axis_source (void              *data,
+                            struct wl_pointer *wl_pointer,
+                            uint32_t           axis_source)
+{
+}
+
+static void
+pointer_handle_axis_stop (void              *data,
+                          struct wl_pointer *wl_pointer,
+                          uint32_t           time,
+                          uint32_t           axis)
+{
+}
+
+static void
+pointer_handle_axis_discrete (void              *data,
+                              struct wl_pointer *wl_pointer,
+                              uint32_t           axis,
+                              int32_t            discrete)
+{
+}
+
+static const struct wl_pointer_listener pointer_listener = {
+  pointer_handle_enter,
+  pointer_handle_leave,
+  pointer_handle_motion,
+  pointer_handle_button,
+  pointer_handle_axis,
+  pointer_handle_frame,
+  pointer_handle_axis_source,
+  pointer_handle_axis_stop,
+  pointer_handle_axis_discrete,
+};
+
+/* wl_seat */
+
+static void
+seat_handle_capabilities (void                    *data,
+                          struct wl_seat          *wl_seat,
+                          enum wl_seat_capability  caps)
+{
+  WaylandDisplay *display = data;
+
+  if ((caps & WL_SEAT_CAPABILITY_KEYBOARD) && !keyboard)
+    {
+      keyboard = wl_seat_get_keyboard (wl_seat);
+      wl_keyboard_add_listener (keyboard, &keyboard_listener, display);
+    }
+
+  if ((caps & WL_SEAT_CAPABILITY_POINTER) && !pointer)
+    {
+      pointer = wl_seat_get_pointer (wl_seat);
+      wl_pointer_add_listener (pointer, &pointer_listener, display);
+    }
+}
+
+static void
+seat_handle_name (void           *data,
+                  struct wl_seat *wl_seat,
+                  const char     *name)
+{
+}
+
+static const struct wl_seat_listener seat_listener = {
+  seat_handle_capabilities,
+  seat_handle_name,
+};
+
+static void
+handle_registry_global (void               *data,
+                        struct wl_registry *registry,
+                        uint32_t            id,
+                        const char         *interface,
+                        uint32_t            version)
+{
+  WaylandDisplay *display = data;
+
+  if (strcmp (interface, "wl_seat") == 0)
+    {
+      seat = wl_registry_bind (registry, id, &wl_seat_interface,
+                               MIN (version, 5));
+      wl_seat_add_listener (seat, &seat_listener, display);
+    }
+}
+
+static void
+handle_registry_global_remove (void               *data,
+                               struct wl_registry *registry,
+                               uint32_t            name)
+{
+}
+
+static const struct wl_registry_listener registry_listener = {
+  handle_registry_global,
+  handle_registry_global_remove
+};
+
+static void
+on_sync_event (WaylandDisplay *display,
+               uint32_t        serial,
+               gpointer        user_data)
+{
+  switch (serial)
+    {
+    case 0:
+      /* Control pressed while hovered, before any further pointer event:
+       * the client was told the state once on enter (nothing pressed), and
+       * the key press itself must not be streamed to it. */
+      if (role == ROLE_HOVER)
+        {
+          g_assert_true (has_pointer_focus);
+          g_assert_cmpint (modifiers_count, ==, 1);
+          g_assert_cmpuint (pressed_mods & CONTROL_MASK, ==, 0);
+          checkpoint ();
+        }
+      break;
+    case 1:
+      /* Control released after a scroll, likewise not streamed. */
+      if (role == ROLE_HOVER)
+        {
+          g_assert_true (has_pointer_focus);
+          g_assert_cmpint (modifiers_count, ==, modifiers_count_at_checkpoint);
+          g_assert_cmpuint (pressed_mods & CONTROL_MASK, ==, CONTROL_MASK);
+        }
+      break;
+    case 2:
+      /* Control released and Shift toggled after the pointer left. */
+      if (role == ROLE_HOVER)
+        {
+          g_assert_true (left_pointer);
+          g_assert_cmpint (modifiers_count, ==, modifiers_count_at_checkpoint + 1);
+        }
+      else if (role == ROLE_BYSTANDER)
+        {
+          g_assert_false (has_keyboard_focus);
+          g_assert_cmpuint (modifiers_while_unfocused, ==, 0);
+        }
+      running = FALSE;
+      break;
+    default:
+      g_assert_not_reached ();
+    }
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (WaylandDisplay) display = NULL;
+  g_autoptr (WaylandSurface) surface = NULL;
+  struct wl_registry *registry;
+  const char *title;
+
+  g_assert_cmpint (argc, ==, 2);
+
+  if (g_strcmp0 (argv[1], "hover") == 0)
+    {
+      role = ROLE_HOVER;
+      title = "pointer-modifiers-hover";
+    }
+  else if (g_strcmp0 (argv[1], "focus") == 0)
+    {
+      role = ROLE_FOCUS;
+      title = "pointer-modifiers-focus";
+    }
+  else if (g_strcmp0 (argv[1], "bystander") == 0)
+    {
+      role = ROLE_BYSTANDER;
+      title = "pointer-modifiers-bystander";
+    }
+  else
+    {
+      g_assert_not_reached ();
+    }
+
+  display = wayland_display_new (WAYLAND_DISPLAY_CAPABILITY_TEST_DRIVER);
+  g_signal_connect (display, "sync-event", G_CALLBACK (on_sync_event), NULL);
+
+  registry = wl_display_get_registry (display->display);
+  wl_registry_add_listener (registry, &registry_listener, display);
+  wl_display_roundtrip (display->display);
+  wl_display_roundtrip (display->display);
+
+  surface = wayland_surface_new (display, title, 100, 100, 0xffffffff);
+  wl_surface_commit (surface->wl_surface);
+
+  running = TRUE;
+  while (running)
+    wayland_display_dispatch (display);
+
+  wl_display_roundtrip (display->display);
+
+  return EXIT_SUCCESS;
+}
diff --git a/src/wayland/meta-wayland-keyboard.c b/src/wayland/meta-wayland-keyboard.c
index 8d7849c..27b101c 100644
--- a/src/wayland/meta-wayland-keyboard.c
+++ b/src/wayland/meta-wayland-keyboard.c
@@ -89,6 +89,19 @@ struct _MetaWaylandKeyboard
 
   MetaWaylandXkbInfo xkb_info;
   GSettings *settings;
+
+  /* Modifier state last sent to the client under the pointer while that
+   * client has no keyboard focus. See
+   * meta_wayland_keyboard_sync_pointer_modifiers(). */
+  struct {
+    struct wl_client *client;
+    struct wl_listener client_destroy_listener;
+    gboolean sent;
+    xkb_mod_mask_t pressed;
+    xkb_mod_mask_t latched;
+    xkb_mod_mask_t locked;
+    uint32_t group;
+  } pointer_modifiers;
 };
 
 G_DEFINE_TYPE (MetaWaylandKeyboard, meta_wayland_keyboard,
@@ -96,6 +109,7 @@ G_DEFINE_TYPE (MetaWaylandKeyboard, meta_wayland_keyboard,
 
 static void meta_wayland_keyboard_update_xkb_state (MetaWaylandKeyboard *keyboard);
 static void notify_modifiers (MetaWaylandKeyboard *keyboard);
+static void invalidate_pointer_modifiers (MetaWaylandKeyboard *keyboard);
 
