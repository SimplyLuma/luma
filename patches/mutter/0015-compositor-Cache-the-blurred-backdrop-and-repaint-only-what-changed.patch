 };
@@ -610,6 +611,9 @@ meta_stage_apply_redraw_clip_filters (MetaStage        *stage,
   if (!redraw_clip || !stage->redraw_clip_filters)
     return;
 
+  /* Filters may keep per-pass state; a new generation starts a new pass. */
