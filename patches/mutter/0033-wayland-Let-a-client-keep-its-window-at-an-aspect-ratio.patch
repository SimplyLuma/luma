+/**
+ * meta_window_wayland_set_aspect_ratio:
+ * @window: a Wayland window
+ * @width: width part of the ratio, 0 to remove it
+ * @height: height part of the ratio, 0 to remove it
+ * @base_width: surface-local width of the geometry outside the content
+ * @base_height: surface-local height of the geometry outside the content
+ *
+ * Keeps the window geometry less the base at @width:@height
+ * (luma_window_shape_v1). Setting the ratio the window already has does
+ * nothing.
+ */
+void
+meta_window_wayland_set_aspect_ratio (MetaWindow *window,
+                                      int         width,
+                                      int         height,
+                                      int         base_width,
+                                      int         base_height)
+{
+  MetaSizeHints *hints = &window->size_hints;
+  float scale;
+
+  if (width <= 0 || height <= 0)
+    {
+      if (!window->frame_aspect.set)
+        return;
+
+      meta_topic (META_DEBUG_GEOMETRY, "Window %s unsets its aspect ratio",
+                  window->desc);
+
+      window->frame_aspect.set = FALSE;
+      window->frame_aspect.base_width = 0;
+      window->frame_aspect.base_height = 0;
+      hints->min_aspect.x = 1;
+      hints->min_aspect.y = G_MAXINT;
+      hints->max_aspect.x = G_MAXINT;
+      hints->max_aspect.y = 1;
+      meta_window_queue (window, META_QUEUE_MOVE_RESIZE);
+      return;
+    }
+
+  scale = (float) meta_window_wayland_get_geometry_scale (window);
+  scale_size (&base_width, &base_height, scale);
+
+  if (window->frame_aspect.set &&
+      hints->min_aspect.x == width && hints->min_aspect.y == height &&
+      hints->max_aspect.x == width && hints->max_aspect.y == height &&
+      window->frame_aspect.base_width == base_width &&
+      window->frame_aspect.base_height == base_height)
+    return;
+
+  meta_topic (META_DEBUG_GEOMETRY,
+              "Window %s keeps its content at %d:%d, base %dx%d",
+              window->desc, width, height, base_width, base_height);
+
+  window->frame_aspect.set = TRUE;
+  window->frame_aspect.base_width = base_width;
+  window->frame_aspect.base_height = base_height;
+  hints->min_aspect.x = hints->max_aspect.x = width;
+  hints->min_aspect.y = hints->max_aspect.y = height;
+  hints->flags |= META_SIZE_HINTS_PROGRAM_ASPECT;
+  meta_window_queue (window, META_QUEUE_MOVE_RESIZE);
+}
