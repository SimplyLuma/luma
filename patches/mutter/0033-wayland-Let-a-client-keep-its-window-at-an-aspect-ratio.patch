+
+/* luma_window_shape_v1: a client keeps its toplevel's content at a fixed
+ * aspect ratio. The ratio is pending state of the wl_surface; the
+ * xdg_toplevel role hands it to its MetaWindow's size hints on commit, and
+ * the constraints apply it the way they apply ICCCM aspect hints. */
+
+#include "config.h"
+
+#include "wayland/meta-wayland-window-shape.h"
+
+#include "core/window-private.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-surface-private.h"
+#include "wayland/meta-wayland-versions.h"
+#include "wayland/meta-window-wayland.h"
+
+#include "luma-window-shape-v1-server-protocol.h"
+
+#define MAX_ASPECT_VALUE 65535
+
+static GQuark quark_window_shape = 0;
+
+typedef struct
+{
+  int width;
+  int height;
+  int base_width;
+  int base_height;
+} AspectRatio;
+
+typedef struct _MetaWaylandWindowShape
+{
+  struct wl_resource *resource;
+  MetaWaylandSurface *surface;
+
+  gboolean has_pending;
+  AspectRatio pending;
+  AspectRatio current;
+} MetaWaylandWindowShape;
+
+static void
+window_shape_surface_destroyed (gpointer data)
+{
+  MetaWaylandWindowShape *shape = data;
+
+  shape->surface = NULL;
+}
+
+static void
+window_shape_destructor (struct wl_resource *resource)
+{
+  MetaWaylandWindowShape *shape = wl_resource_get_user_data (resource);
+
+  if (shape->surface)
+    {
+      MetaWindow *window = meta_wayland_surface_get_window (shape->surface);
+
+      if (window && META_IS_WINDOW_WAYLAND (window) && !window->unmanaging)
+        meta_window_wayland_set_aspect_ratio (window, 0, 0, 0, 0);
+
+      g_object_steal_qdata (G_OBJECT (shape->surface), quark_window_shape);
+    }
+
+  g_free (shape);
+}
+
+static void
+window_shape_destroy (struct wl_client   *client,
+                      struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+window_shape_set_aspect_ratio (struct wl_client   *client,
+                               struct wl_resource *resource,
+                               uint32_t            width,
+                               uint32_t            height,
+                               uint32_t            base_width,
+                               uint32_t            base_height)
+{
+  MetaWaylandWindowShape *shape = wl_resource_get_user_data (resource);
+
+  if (width == 0 || height == 0 ||
+      width > MAX_ASPECT_VALUE || height > MAX_ASPECT_VALUE ||
+      base_width > MAX_ASPECT_VALUE || base_height > MAX_ASPECT_VALUE)
+    {
+      wl_resource_post_error (resource,
+                              LUMA_WINDOW_SHAPE_V1_ERROR_INVALID_ASPECT_RATIO,
+                              "invalid aspect ratio %u:%u (base %ux%u)",
+                              width, height, base_width, base_height);
+      return;
+    }
+
+  shape->has_pending = TRUE;
+  shape->pending = (AspectRatio) {
+    .width = (int) width,
+    .height = (int) height,
+    .base_width = (int) base_width,
+    .base_height = (int) base_height,
+  };
+}
+
+static void
+window_shape_unset_aspect_ratio (struct wl_client   *client,
+                                 struct wl_resource *resource)
+{
+  MetaWaylandWindowShape *shape = wl_resource_get_user_data (resource);
+
+  shape->has_pending = TRUE;
+  shape->pending = (AspectRatio) { 0 };
+}
+
+static const struct luma_window_shape_v1_interface window_shape_interface = {
+  window_shape_destroy,
+  window_shape_set_aspect_ratio,
+  window_shape_unset_aspect_ratio,
+};
+
+/**
+ * meta_wayland_window_shape_apply:
+ * @surface: the surface of an xdg_toplevel
+ * @window: its window
+ * @has_new_geometry: whether this commit changed the window geometry
+ *
+ * Called by the xdg_toplevel role after a commit: applies a pending aspect
+ * ratio, and applies the current one again to a window that does not have
+ * it yet (a new window after the role was reset).
+ */
+void
+meta_wayland_window_shape_apply (MetaWaylandSurface *surface,
+                                 MetaWindow         *window,
+                                 gboolean            has_new_geometry)
+{
+  MetaWaylandWindowShape *shape;
+
+  if (!quark_window_shape)
+    return;
+
+  shape = g_object_get_qdata (G_OBJECT (surface), quark_window_shape);
+  if (!shape)
+    return;
+
+  if (shape->has_pending)
+    {
+      shape->has_pending = FALSE;
+      shape->current = shape->pending;
+    }
+  else if (!has_new_geometry)
+    {
+      return;
+    }
+
+  /* Idempotent: nothing is queued when the window already has this ratio. */
+  meta_window_wayland_set_aspect_ratio (window,
+                                        shape->current.width,
+                                        shape->current.height,
+                                        shape->current.base_width,
+                                        shape->current.base_height);
+}
+
+static void
+window_shape_manager_destroy (struct wl_client   *client,
+                              struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+window_shape_manager_get_window_shape (struct wl_client   *client,
+                                       struct wl_resource *resource,
+                                       uint32_t            id,
+                                       struct wl_resource *surface_resource)
+{
+  MetaWaylandSurface *surface = wl_resource_get_user_data (surface_resource);
+  MetaWaylandWindowShape *shape;
+
+  if (g_object_get_qdata (G_OBJECT (surface), quark_window_shape))
+    {
+      wl_resource_post_error (resource,
+                              LUMA_WINDOW_SHAPE_MANAGER_V1_ERROR_ALREADY_CONSTRUCTED,
+                              "the wl_surface already has a luma_window_shape_v1");
+      return;
+    }
+
+  shape = g_new0 (MetaWaylandWindowShape, 1);
+  shape->surface = surface;
+  shape->resource = wl_resource_create (client,
+                                        &luma_window_shape_v1_interface,
+                                        wl_resource_get_version (resource),
+                                        id);
+  wl_resource_set_implementation (shape->resource,
+                                  &window_shape_interface,
+                                  shape, window_shape_destructor);
+
+  g_object_set_qdata_full (G_OBJECT (surface), quark_window_shape,
+                           shape, window_shape_surface_destroyed);
+}
+
+static const struct luma_window_shape_manager_v1_interface window_shape_manager_interface = {
+  window_shape_manager_destroy,
+  window_shape_manager_get_window_shape,
+};
+
+static void
+bind_window_shape_manager (struct wl_client *client,
+                           void             *data,
+                           uint32_t          version,
+                           uint32_t          id)
+{
+  struct wl_resource *resource;
+
+  resource = wl_resource_create (client, &luma_window_shape_manager_v1_interface,
+                                 version, id);
+  wl_resource_set_implementation (resource, &window_shape_manager_interface,
+                                  data, NULL);
+}
+
+void
+meta_wayland_init_window_shape (MetaWaylandCompositor *compositor)
+{
+  quark_window_shape =
+    g_quark_from_static_string ("-meta-wayland-luma-window-shape");
+
+  if (wl_global_create (compositor->wayland_display,
+                        &luma_window_shape_manager_v1_interface,
+                        META_LUMA_WINDOW_SHAPE_V1_VERSION,
+                        compositor, bind_window_shape_manager) == NULL)
+    g_error ("Failed to register a global luma_window_shape_manager_v1 object");
+}
