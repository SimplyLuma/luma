 src/core/window-private.h               |  10 +
 src/meson.build                         |   5 +
 src/wayland/meta-wayland-versions.h     |   1 +
 src/wayland/meta-wayland-window-shape.c | 246 ++++++++++++++++++++++++
 src/wayland/meta-wayland-window-shape.h |  27 +++
 src/wayland/meta-wayland-xdg-shell.c    |   3 +
 src/wayland/meta-wayland.c              |   2 +
 src/wayland/meta-window-wayland.c       |  66 +++++++
 src/wayland/meta-window-wayland.h       |   6 +
 10 files changed, 457 insertions(+), 8 deletions(-)
 create mode 100644 src/wayland/meta-wayland-window-shape.c
 create mode 100644 src/wayland/meta-wayland-window-shape.h

diff --git a/src/core/constraints.c b/src/core/constraints.c
index a3e7c7f..7838c76 100644
--- a/src/core/constraints.c
+++ b/src/core/constraints.c
@@ -1335,6 +1335,31 @@ constrain_modal_dialog (MetaWindow         *window,
                                                      check_only);
 }
 
+/* The largest size inside *width x *height whose content keeps the aspect
+ * ratio a Wayland client set through luma_window_shape_v1. The content is
+ * the frame rectangle less the client's fixed chrome (frame_aspect.base_*).
+ */
+static void
+fit_size_to_frame_aspect (MetaWindow *window,
+                          int        *width,
+                          int        *height)
+{
+  int base_width = window->frame_aspect.base_width;
+  int base_height = window->frame_aspect.base_height;
+  double ratio = window->size_hints.min_aspect.x /
+                 (double) window->size_hints.min_aspect.y;
+  int content_width = MAX (*width - base_width, 1);
+  int content_height = MAX (*height - base_height, 1);
+
+  if (content_width > content_height * ratio)
+    content_width = MAX ((int) (content_height * ratio + 0.5), 1);
+  else
+    content_height = MAX ((int) (content_width / ratio + 0.5), 1);
+
+  *width = content_width + base_width;
+  *height = content_height + base_height;
+}
+
 static gboolean
 constrain_maximization (MetaWindow         *window,
                         ConstraintInfo     *info,
@@ -1420,6 +1445,24 @@ constrain_maximization (MetaWindow         *window,
         }
     }
 
+  /* A window that keeps its content at an aspect ratio
+   * (luma_window_shape_v1) maximizes to the largest size with that ratio,
+   * centred in the area it would otherwise fill, rather than stretching its
+   * content or leaving the client to letterbox a screen-sized window. */
+  if (window->frame_aspect.set &&
+      meta_window_is_maximized (window) &&
+      !meta_window_is_fullscreen (window))
+    {
+      int width = target_size.width;
+      int height = target_size.height;
+
+      fit_size_to_frame_aspect (window, &width, &height);
+      target_size.x += (target_size.width - width) / 2;
+      target_size.y += (target_size.height - height) / 2;
+      target_size.width = width;
+      target_size.height = height;
+    }
+
   /* Check min size constraints; max size constraints are ignored for maximized
    * windows, as per bug 327543.
    */
@@ -1712,6 +1755,7 @@ constrain_aspect_ratio (MetaWindow         *window,
       meta_window_is_maximized (window) ||
       meta_window_is_fullscreen (window) ||
       meta_window_is_tiled_side_by_side (window) ||
+      window->externally_tiled ||
       info->action_type == ACTION_MOVE)
     return TRUE;
 
@@ -1751,7 +1795,21 @@ constrain_aspect_ratio (MetaWindow         *window,
       break;
     }
 
-  meta_window_frame_rect_to_client_rect (window, &info->current, &client_rect);
+  /* A ratio set through luma_window_shape_v1 is for the frame rectangle less
+   * the client's fixed chrome; ICCCM hints are for the client rectangle. */
+  if (window->frame_aspect.set)
+    {
+      client_rect = info->current;
+      client_rect.width = MAX (client_rect.width -
+                               window->frame_aspect.base_width, 1);
+      client_rect.height = MAX (client_rect.height -
+                                window->frame_aspect.base_height, 1);
+    }
+  else
+    {
+      meta_window_frame_rect_to_client_rect (window, &info->current,
+                                             &client_rect);
+    }
 
   constraint_already_satisfied =
     client_rect.width - (client_rect.height * minr ) > -minr*fudge &&
@@ -1807,13 +1865,19 @@ constrain_aspect_ratio (MetaWindow         *window,
       break;
     }
 
-  {
-    client_rect.width = new_width;
-    client_rect.height = new_height;
-    meta_window_client_rect_to_frame_rect (window, &client_rect, &client_rect);
-    new_width = client_rect.width;
-    new_height = client_rect.height;
-  }
+  if (window->frame_aspect.set)
+    {
+      new_width += window->frame_aspect.base_width;
+      new_height += window->frame_aspect.base_height;
+    }
+  else
+    {
+      client_rect.width = new_width;
+      client_rect.height = new_height;
+      meta_window_client_rect_to_frame_rect (window, &client_rect, &client_rect);
+      new_width = client_rect.width;
+      new_height = client_rect.height;
+    }
 
   start_rect = get_start_rect_for_resize (window, info);
 
@@ -2277,6 +2341,25 @@ constrain_inside_work_area (MetaWindow         *window,
    * keeping the top-left corner in the work area if even that does not fit. */
   target.width = MAX (MIN (rect->width, area.width), min_size.width);
   target.height = MAX (MIN (rect->height, area.height), min_size.height);
+  /* Shrinking one side alone would undo an aspect ratio a client set through
+   * luma_window_shape_v1; keep it while it still fits the minimum size. */
+  if (window->frame_aspect.set &&
+      (target.width != rect->width || target.height != rect->height) &&
+      !meta_window_is_maximized (window) &&
+      !meta_window_is_fullscreen (window) &&
+      !meta_window_is_tiled_side_by_side (window) &&
+      !window->externally_tiled)
+    {
+      int width = target.width;
+      int height = target.height;
+
+      fit_size_to_frame_aspect (window, &width, &height);
+      if (width >= min_size.width && height >= min_size.height)
+        {
+          target.width = width;
+          target.height = height;
+        }
+    }
   target.x = target.width >= area.width ?
     area.x : CLAMP (rect->x, area.x, area.x + area.width - target.width);
   target.y = target.height >= area.height ?
