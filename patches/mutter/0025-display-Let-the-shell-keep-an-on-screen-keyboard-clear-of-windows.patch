@@ -1005,6 +1005,10 @@ meta_workspace_ensure_work_areas_validated (MetaWorkspace *workspace)
                                                     logical_monitor->number,
                                                     &logical_monitor->rect,
                                                     &work_area);
+      meta_display_apply_input_panel_inset (workspace->display,
+                                            logical_monitor->number,
+                                            &logical_monitor->rect,
+                                            &work_area);
 
       if (workspace->display->work_area_inset > 0)
         {
