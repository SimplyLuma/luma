   N_SIGNALS
@@ -1941,6 +1942,23 @@
 update_touch_mode (MetaSeatImpl *seat_impl)
 {
   gboolean touch_mode;
+  int switch_state = seat_impl->has_tablet_switch
+    ? (seat_impl->tablet_mode_switch_state ? 1 : 0) : -1;
+
+  /* Preserve the distinction between SW_TABLET_MODE and touch-mode's
+   * no-pointer fallback. Presentation policy must not mistake a missing
+   * mouse for a physical tablet posture. Dispatch on the main thread using
+   * the same path as touch-mode, including switch removal and hotplug. */
+  if (seat_impl->reported_tablet_mode_switch != switch_state)
+    {
+      GValue value = G_VALUE_INIT;
+
+      seat_impl->reported_tablet_mode_switch = switch_state;
+      g_value_init (&value, G_TYPE_INT);
+      g_value_set_int (&value, switch_state);
+      emit_signal (seat_impl, signals[TABLET_MODE_SWITCH], &value, 1);
+      g_value_unset (&value);
+    }
 
   /* No touch mode if we don't have a touchscreen, easy */
   if (!seat_impl->has_touchscreen)
@@ -3621,6 +3639,12 @@
