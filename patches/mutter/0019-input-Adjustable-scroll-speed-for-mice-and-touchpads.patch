+static void
+meta_input_settings_native_set_scroll_speed (MetaInputSettings  *settings,
+                                             ClutterInputDevice *device,
+                                             double              speed)
+{
+  MetaInputDeviceNative *device_native;
+  double factor;
+
+  if (!META_IS_INPUT_DEVICE_NATIVE (device))
+    return;
+
+  device_native = META_INPUT_DEVICE_NATIVE (device);
+  factor = meta_scroll_speed_clamp (speed);
+  if (device_native->scroll_factor == factor)
+    return;
+
+  device_native->scroll_factor = factor;
+  device_native->scroll_residual_x = 0;
+  device_native->scroll_residual_y = 0;
+
+  meta_topic (META_DEBUG_INPUT, "Scroll speed of %s is now %.2f",
+              clutter_input_device_get_device_name (device), factor);
+}
+
 static void
 meta_input_settings_native_set_left_handed (MetaInputSettings  *settings,
                                             ClutterInputDevice *device,
@@ -830,6 +856,7 @@ meta_input_settings_native_class_init (MetaInputSettingsNativeClass *klass)
   input_settings_class->set_tap_and_drag_lock_enabled =
     meta_input_settings_native_set_tap_and_drag_lock_enabled;
   input_settings_class->set_invert_scroll = meta_input_settings_native_set_invert_scroll;
+  input_settings_class->set_scroll_speed = meta_input_settings_native_set_scroll_speed;
   input_settings_class->set_edge_scroll = meta_input_settings_native_set_edge_scroll;
