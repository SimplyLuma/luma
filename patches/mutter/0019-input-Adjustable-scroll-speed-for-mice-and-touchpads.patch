   if (libinput_event_pointer_has_axis (axis_event,
                                        LIBINPUT_POINTER_AXIS_SCROLL_HORIZONTAL))
@@ -2280,10 +2291,32 @@ notify_discrete_axis (MetaSeatImpl                  *seat_impl,
           axis_event, LIBINPUT_POINTER_AXIS_SCROLL_VERTICAL);
