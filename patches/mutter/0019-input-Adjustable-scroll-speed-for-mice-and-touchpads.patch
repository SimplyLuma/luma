diff --git a/src/tests/scroll-scale-test.c b/src/tests/scroll-scale-test.c
new file mode 100644
index 0000000..fb686b9
--- /dev/null
+++ b/src/tests/scroll-scale-test.c
@@ -0,0 +1,137 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Scroll speed arithmetic. Built and run by the package's %check, which
+ * requires every test below to report ok.
+ */
+
+#include "config.h"
+
+#include <math.h>
+
+#include "backends/meta-scroll-scale.h"
+
+static void
+test_identity_is_untouched (void)
+{
+  double residual = 0;
+  int i;
+
+  g_assert_true (meta_scroll_speed_is_identity (1.0));
+  g_assert_false (meta_scroll_speed_is_identity (1.0 + 1e-9));
+  g_assert_false (meta_scroll_speed_is_identity (0.25));
+
+  for (i = 1; i <= 240; i++)
+    {
+      g_assert_cmpint (meta_scroll_scale_value120 (1.0, i, &residual), ==, i);
+      g_assert_cmpint (meta_scroll_scale_value120 (1.0, -i, &residual), ==, -i);
+      g_assert_cmpfloat (residual, ==, 0);
+    }
+
+  g_assert_cmpfloat (meta_scroll_scale_delta (1.0, 3.75), ==, 3.75);
+}
+
+static void
+test_speed_is_clamped (void)
+{
+  g_assert_cmpfloat (meta_scroll_speed_clamp (NAN), ==, 1.0);
+  g_assert_cmpfloat (meta_scroll_speed_clamp (INFINITY), ==, 1.0);
+  g_assert_cmpfloat (meta_scroll_speed_clamp (0), ==, META_SCROLL_SPEED_MIN);
+  g_assert_cmpfloat (meta_scroll_speed_clamp (-2), ==, META_SCROLL_SPEED_MIN);
+  g_assert_cmpfloat (meta_scroll_speed_clamp (40), ==, META_SCROLL_SPEED_MAX);
+  g_assert_cmpfloat (meta_scroll_speed_clamp (1.5), ==, 1.5);
+}
+
+/* A slow speed on a high-resolution wheel: every event is a fraction of a
+ * unit after scaling. Nothing may be lost, or slow wheels stop scrolling. */
+static void
+test_slow_wheel_accumulates (void)
+{
+  double residual = 0;
+  int32_t total = 0;
+  int i, events_sent = 0;
+
+  for (i = 0; i < 16; i++) /* two detents, 15 units each */
+    {
+      int32_t out = meta_scroll_scale_value120 (0.3, 15, &residual);
+
+      total += out;
+      if (out != 0)
+        events_sent++;
+    }
+
+  g_assert_cmpint (total, ==, 72);
+  g_assert_cmpint (events_sent, ==, 16);
+
+  /* A classic wheel at the slowest speed: a quarter step per detent, and a
+   * whole one every fourth. */
+  residual = 0;
+  total = 0;
+  for (i = 0; i < 4; i++)
+    total += meta_scroll_scale_value120 (META_SCROLL_SPEED_MIN, -120, &residual);
+  g_assert_cmpint (total, ==, -120);
+}
+
+/* What was left over in one direction must not be spent in the other. */
+static void
+test_reversal_drops_residual (void)
+{
+  double residual = 0;
+  int32_t total = 0;
+
+  g_assert_cmpint (meta_scroll_scale_value120 (0.25, 10, &residual), ==, 2);
+  g_assert_cmpfloat (residual, >, 0);
+
+  total += meta_scroll_scale_value120 (0.25, -10, &residual);
+  total += meta_scroll_scale_value120 (0.25, -10, &residual);
+  g_assert_cmpint (total, ==, -5);
+}
+
+/* A fast speed turns one detent into several wheel steps, each delivered on
+ * its own so clients that count steps see all of them. */
+static void
+test_fast_wheel_splits_into_steps (void)
+{
+  double residual = 0;
+  int32_t remaining;
+  int n_steps = 0;
+  int32_t steps[8];
+
+  remaining = meta_scroll_scale_value120 (2.5, -120, &residual);
+  g_assert_cmpint (remaining, ==, -300);
+
+  while (remaining != 0 && n_steps < 8)
+    steps[n_steps++] = meta_scroll_value120_take_step (&remaining);
+
+  g_assert_cmpint (n_steps, ==, 3);
+  g_assert_cmpint (steps[0], ==, -120);
+  g_assert_cmpint (steps[1], ==, -120);
+  g_assert_cmpint (steps[2], ==, -60);
+  g_assert_cmpint (remaining, ==, 0);
+}
+
+/* Touchpad and continuous deltas scale linearly, and the zero delta that
+ * ends a gesture (and starts kinetic scrolling in the client) stays zero. */
+static void
+test_smooth_deltas_scale (void)
+{
+  g_assert_cmpfloat (meta_scroll_scale_delta (0.5, 10.0), ==, 5.0);
+  g_assert_cmpfloat (meta_scroll_scale_delta (3.0, -2.0), ==, -6.0);
+  g_assert_cmpfloat (meta_scroll_scale_delta (3.0, 0.0), ==, 0.0);
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+
+  g_test_add_func ("/scroll-scale/identity", test_identity_is_untouched);
+  g_test_add_func ("/scroll-scale/clamp", test_speed_is_clamped);
+  g_test_add_func ("/scroll-scale/slow-wheel", test_slow_wheel_accumulates);
+  g_test_add_func ("/scroll-scale/reversal", test_reversal_drops_residual);
+  g_test_add_func ("/scroll-scale/fast-wheel", test_fast_wheel_splits_into_steps);
+  g_test_add_func ("/scroll-scale/smooth", test_smooth_deltas_scale);
+
+  return g_test_run ();
+}
