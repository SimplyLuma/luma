+static void
+update_device_scroll_speed (MetaInputSettings  *input_settings,
+                            ClutterInputDevice *device)
+{
+  MetaInputSettingsPrivate *priv =
+    meta_input_settings_get_instance_private (input_settings);
+  ConfigDoubleFunc func;
+  const char *key = "scroll-speed";
+
+  func = META_INPUT_SETTINGS_GET_CLASS (input_settings)->set_scroll_speed;
+  if (!func)
+    return;
+
+  /* Same device split as natural-scroll: touchpads follow the touchpad
+   * setting, every other pointer (mice, trackballs, pointing sticks) the
+   * mouse one. */
+  if (device)
+    {
+      ClutterInputCapabilities capabilities;
+      GSettings *settings = NULL;
+
+      capabilities = clutter_input_device_get_capabilities (device);
+
+      if (capabilities & CLUTTER_INPUT_CAPABILITY_TOUCHPAD)
+        settings = priv->touchpad_scroll_settings;
+      else if (capabilities & CLUTTER_INPUT_CAPABILITY_POINTER)
+        settings = priv->mouse_scroll_settings;
+
+      if (!settings)
+        return;
+
+      settings_device_set_double_setting (input_settings, device, func,
+                                          g_settings_get_double (settings, key));
+    }
+  else
+    {
+      if (priv->mouse_scroll_settings)
+        settings_set_double_setting (input_settings,
+                                     CLUTTER_INPUT_CAPABILITY_POINTER,
+                                     CLUTTER_INPUT_CAPABILITY_TOUCHPAD,
+                                     func,
+                                     g_settings_get_double (priv->mouse_scroll_settings, key));
+
+      if (priv->touchpad_scroll_settings)
+        settings_set_double_setting (input_settings,
+                                     CLUTTER_INPUT_CAPABILITY_TOUCHPAD,
+                                     CLUTTER_INPUT_CAPABILITY_NONE,
+                                     func,
+                                     g_settings_get_double (priv->touchpad_scroll_settings, key));
+    }
+}
+
+static void
+scroll_speed_changed_cb (GSettings  *settings,
+                         const char *key,
+                         gpointer    user_data)
+{
+  MetaInputSettings *input_settings = META_INPUT_SETTINGS (user_data);
+
+  if (strcmp (key, "scroll-speed") == 0)
+    update_device_scroll_speed (input_settings, NULL);
+}
+
+static GSettings *
+maybe_new_settings (const char *schema_id)
+{
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
