diff --git a/src/backends/meta-scroll-scale.c b/src/backends/meta-scroll-scale.c
new file mode 100644
index 0000000..def12ab
--- /dev/null
+++ b/src/backends/meta-scroll-scale.c
@@ -0,0 +1,66 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "config.h"
+
+#include "backends/meta-scroll-scale.h"
+
+#include <math.h>
+
+double
+meta_scroll_speed_clamp (double speed)
+{
+  if (!isfinite (speed))
+    return 1.0;
+
+  return CLAMP (speed, META_SCROLL_SPEED_MIN, META_SCROLL_SPEED_MAX);
+}
+
+gboolean
+meta_scroll_speed_is_identity (double factor)
+{
+  return factor == 1.0;
+}
+
+double
+meta_scroll_scale_delta (double factor,
+                         double delta)
+{
+  return delta * factor;
+}
+
+int32_t
+meta_scroll_scale_value120 (double  factor,
+                            double  value120,
+                            double *residual)
+{
+  double scaled;
+  int32_t whole;
+
+  if (value120 == 0)
+    return 0;
+
+  if ((value120 > 0 && *residual < 0) ||
+      (value120 < 0 && *residual > 0))
+    *residual = 0;
+
+  scaled = value120 * factor + *residual;
+  whole = (int32_t) trunc (scaled);
+  *residual = scaled - whole;
+
+  return whole;
+}
+
+int32_t
+meta_scroll_value120_take_step (int32_t *remaining)
+{
+  int32_t step;
+
+  step = CLAMP (*remaining,
+                -META_SCROLL_VALUE120_STEP,
+                META_SCROLL_VALUE120_STEP);
+  *remaining -= step;
+
+  return step;
+}
diff --git a/src/backends/meta-scroll-scale.h b/src/backends/meta-scroll-scale.h
new file mode 100644
index 0000000..421601e
--- /dev/null
+++ b/src/backends/meta-scroll-scale.h
@@ -0,0 +1,43 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Per-device scroll speed: the arithmetic, kept free of any backend state so
+ * it can be tested on its own.
+ */
+
+#pragma once
+
+#include <glib.h>
+#include <stdint.h>
+
+#define META_SCROLL_SPEED_MIN 0.25
+#define META_SCROLL_SPEED_MAX 4.0
+
+/* One wheel detent in libinput's high-resolution units. */
+#define META_SCROLL_VALUE120_STEP 120
+
+/* Clamp a configured speed to the supported range; anything that is not a
+ * finite number means the default, 1.0. */
+double meta_scroll_speed_clamp (double speed);
+
+/* TRUE when scaling by @factor would change nothing. Callers take the
+ * unmodified upstream path in that case. */
+gboolean meta_scroll_speed_is_identity (double factor);
+
+/* Scale a smooth (finger or continuous) scroll delta. A zero delta, which
+ * marks the end of a scroll sequence, stays zero. */
+double meta_scroll_scale_delta (double factor,
+                                double delta);
+
+/* Scale a high-resolution wheel value (120 per detent). The fractional part
+ * that cannot be sent is kept in @residual and added to the next value in the
+ * same direction, so a slow speed still scrolls: at 0.25 every fourth detent
+ * produces a whole step. A value in the other direction drops the residual so
+ * a reversal is never eaten by what was left over. */
+int32_t meta_scroll_scale_value120 (double  factor,
+                                    double  value120,
+                                    double *residual);
+
+/* Take the next piece of at most one detent off @remaining, so a scaled value
+ * of several detents is delivered as that many wheel steps rather than one. */
+int32_t meta_scroll_value120_take_step (int32_t *remaining);
