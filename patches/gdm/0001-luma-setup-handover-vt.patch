         if (g_strcmp0 (worker->display_seat_id, "seat0") == 0 && worker->seat0_has_vts) {
-                if (worker->display_mode == GDM_SESSION_DISPLAY_MODE_NEW_VT) {
+                if (worker->display_mode == GDM_SESSION_DISPLAY_MODE_NEW_VT &&
+                    !luma_handover_defer (worker)) {
                         jump_to_vt (worker, worker->session_vt);
                 }
         }
