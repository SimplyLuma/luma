diff --git a/device.mk b/device.mk
index d8f703d..fd14d77 100644
--- a/device.mk
+++ b/device.mk
@@ -149,6 +149,12 @@ PRODUCT_PACKAGES += \
 PRODUCT_COPY_FILES += \
     $(LOCAL_PATH)/configs/init.waydroid.vendor.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/init.waydroid.vendor.rc
 
+# Task profiles for a cgroup v2-only host (Waydroid on Luma). The v1 cpuset,
+# schedtune, blkio, cpu and memory controllers cannot be mounted there, so the
+# profiles that join them or set their attributes are emptied.
+PRODUCT_COPY_FILES += \
+    $(LOCAL_PATH)/configs/task_profiles.json:$(TARGET_COPY_OUT_VENDOR)/etc/task_profiles.json
+
 # Keymaster
 PRODUCT_PACKAGES += \
     android.hardware.keymaster@4.0-service
