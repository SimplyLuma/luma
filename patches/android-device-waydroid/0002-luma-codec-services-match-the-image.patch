diff --git a/configs/init.waydroid.codec2.rc b/configs/init.waydroid.codec2.rc
new file mode 100644
index 0000000..2e55aee
--- /dev/null
+++ b/configs/init.waydroid.codec2.rc
@@ -0,0 +1,4 @@
+# Waydroid's host tools set debug.stagefright.ccodec=0, which turns Codec2
+# off. Without the 32-bit OMX service that would leave no codecs at all.
+on early-boot
+    setprop debug.stagefright.ccodec 4
diff --git a/configs/media.omx.xml b/configs/media.omx.xml
new file mode 100644
index 0000000..0b6ce80
--- /dev/null
+++ b/configs/media.omx.xml
@@ -0,0 +1,15 @@
+<manifest version="1.0" type="device">
+    <hal format="hidl">
+        <name>android.hardware.media.omx</name>
+        <transport>hwbinder</transport>
+        <version>1.0</version>
+        <interface>
+            <name>IOmx</name>
+            <instance>default</instance>
+        </interface>
+        <interface>
+            <name>IOmxStore</name>
+            <instance>default</instance>
+        </interface>
+    </hal>
+</manifest>
diff --git a/device.mk b/device.mk
index 7c17ece..d26e171 100644
--- a/device.mk
+++ b/device.mk
@@ -162,6 +162,15 @@ PRODUCT_COPY_FILES += \
     $(LOCAL_PATH)/configs/mediaextractor.32bit.policy:$(TARGET_COPY_OUT_VENDOR)/etc/seccomp_policy/mediaextractor.policy
 endif
 
+# Media - OMX is declared only where its (32-bit) service is built
+ifneq ($(TARGET_SUPPORTS_OMX_SERVICE),false)
+PRODUCT_COPY_FILES += \
+    $(LOCAL_PATH)/configs/media.omx.xml:$(TARGET_COPY_OUT_VENDOR)/etc/vintf/manifest/media.omx.xml
+else
+PRODUCT_COPY_FILES += \
+    $(LOCAL_PATH)/configs/init.waydroid.codec2.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/init.waydroid.codec2.rc
+endif
+
 # Media - Stagefright FFMPEG plugin
 ifneq ($(filter %_waydroid_x86 %_waydroid_x86_64 %_waydroid_tv_x86 %_waydroid_tv_x86_64,$(TARGET_PRODUCT)),)
 PRODUCT_PACKAGES += \
