diff --git a/configs/init.luma.forced-density.rc b/configs/init.luma.forced-density.rc
new file mode 100644
index 0000000..e6be77d
--- /dev/null
+++ b/configs/init.luma.forced-density.rc
@@ -0,0 +1,7 @@
+# The host's presentation (persist.luma.forced_density) becomes Android's
+# forced display density once the system is up.
+on property:sys.boot_completed=1
+    exec_background - system system -- /system/bin/luma-forced-density
+
+on property:persist.luma.forced_density=*
+    exec_background - system system -- /system/bin/luma-forced-density
diff --git a/configs/luma-forced-density.sh b/configs/luma-forced-density.sh
new file mode 100755
index 0000000..c9710ec
--- /dev/null
+++ b/configs/luma-forced-density.sh
@@ -0,0 +1,21 @@
+#!/system/bin/sh
+# Applies persist.luma.forced_density, which the host publishes for its
+# current presentation, as WindowManager's forced density. Android's boot
+# density (ro.sf.lcd_density) follows the presentation it booted into. Only an
+# override this script applied is replaced, so a display size chosen in
+# Android's own settings is kept.
+[ "$(getprop sys.boot_completed)" = 1 ] || exit 0
+target=$(getprop persist.luma.forced_density)
+ours=$(getprop persist.luma.density_override)
+physical=$(getprop ro.sf.lcd_density)
+current=$(wm density | sed -n 's/^Override density: //p')
+if [ -n "$current" ] && [ "$current" != "$ours" ]; then
+    exit 0
+fi
+if [ -z "$target" ] || [ "$target" = 0 ] || [ "$target" = "$physical" ]; then
+    [ -n "$current" ] && wm density reset
+    setprop persist.luma.density_override 0
+elif [ "$target" != "$current" ]; then
+    wm density "$target"
+    setprop persist.luma.density_override "$target"
+fi
