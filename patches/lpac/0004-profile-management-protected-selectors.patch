--- /dev/null
+++ b/src/applet/profile/secure-input.h
@@ -0,0 +1,40 @@
+/* Luma protected profile-selector input. SPDX-License-Identifier: AGPL-3.0-only */
+#pragma once
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+
+static void secure_profile_id_free(char **id) {
+    if (id == NULL || *id == NULL) return;
+    explicit_bzero(*id, 34);
+    (void)munlock(*id, 34);
+    free(*id);
+    *id = NULL;
+}
+
+/* Never include supplied bytes in errors. Fail closed if memory cannot lock.
+ * Read the whole bounded line bytewise so embedded NUL cannot hide a suffix. */
+static char *read_profile_id(void) {
+    char *id = calloc(34, 1);
+    if (id == NULL) return NULL;
+    if (mlock(id, 34) != 0) { secure_profile_id_free(&id); return NULL; }
+    size_t length = 0;
+    int ch;
+    while ((ch = fgetc(stdin)) != EOF && ch != '\n') {
+        if (ch == 0 || length == 33) { secure_profile_id_free(&id); return NULL; }
+        id[length++] = (char)ch;
+    }
+    if (ferror(stdin)) { secure_profile_id_free(&id); return NULL; }
+    if (length && id[length - 1] == '\r') id[--length] = 0;
+    if (length != 19 && length != 20 && length != 32) {
+        secure_profile_id_free(&id); return NULL;
+    }
+    for (size_t i = 0; i < length; i++) {
+        if (!(length == 32 ? isxdigit((unsigned char)id[i]) : isdigit((unsigned char)id[i]))) {
+            secure_profile_id_free(&id); return NULL;
+        }
+    }
+    return id;
+}
