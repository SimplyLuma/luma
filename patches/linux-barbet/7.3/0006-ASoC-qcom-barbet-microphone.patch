+			else
+				regmap_write(rt5514->i2c_regmap,
+					RT5514_DSP_FUNC,
+					RT5514_DSP_FUNC_SUSPEND);
+		}
+
+		rt5514_filter_power_reset(rt5514);
+	}
+	rt5514->is_streaming = false;
+	if (rt5514->need_reload)
