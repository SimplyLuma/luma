diff --git a/src/stylesheet/_common.scss b/src/stylesheet/_common.scss
--- a/src/stylesheet/_common.scss
+++ b/src/stylesheet/_common.scss
@@ -491,3 +491,74 @@
 }
 
 @import 'widgets';
+
+// Opt-in preference surfaces, shared by native Luma applications.
+// Keep toolkit row types, state colours, focus rings and accessible widgets.
+.luma-preferences {
+  preferencespage > scrolledwindow > viewport > clamp > box {
+    margin: 16px;
+    border-spacing: 16px;
+  }
+
+  headerbar.luma-pane-header {
+    min-height: 40px;
+    padding: 0 8px;
+  }
+
+  preferencesgroup > box > box > list.boxed-list {
+    border-radius: 10px;
+    background-color: unquote("@luma_island");
+    box-shadow: inset 0 0 0 1px unquote("@luma_line");
+
+    @media (prefers-contrast: more) {
+      background-color: var(--card-bg-color);
+      box-shadow: inset 0 0 0 1px $border_color;
+    }
+
+    // Native boxed-list rows already own rounded first/last edges and
+    // internal separators. Match those edges without clipping focus rings.
+    > row:first-child {
+      border-top-left-radius: 10px;
+      border-top-right-radius: 10px;
+    }
+    > row:last-child {
+      border-bottom-left-radius: 10px;
+      border-bottom-right-radius: 10px;
+    }
+
+    > row > box.header {
+      min-height: 46px;
+      margin-left: 12px;
+      margin-right: 12px;
+      border-spacing: 12px;
+
+      > box.title {
+        margin-top: 8px;
+        margin-bottom: 8px;
+        border-spacing: 2px;
+
+        > label.title { font-weight: 650; }
+        > label.subtitle { font-weight: 500; }
+      }
+    }
+  }
+}
+
+// Navigation density is a minimum, never a fixed allocation: wrapped
+// translated labels and enlarged text retain their full natural height.
+list.navigation-sidebar.luma-preferences-navigation {
+  padding: 6px;
+
+  > row {
+    min-height: 32px;
+    padding: 0 8px;
+    margin: 0;
+    border-radius: 10px;
+    font-weight: 600;
+  }
+
+  .luma-preferences-navigation-content {
+    margin: 0;
+    border-spacing: 10px;
+  }
+}
