diff --git a/src/stylesheet/widgets/_header-bar.scss b/src/stylesheet/widgets/_header-bar.scss
index cbae40ae02e1fdec50b644445d10972a930502e2..e946f5add6c45cc5da218c8c1e99982446432655 100644
--- a/src/stylesheet/widgets/_header-bar.scss
+++ b/src/stylesheet/widgets/_header-bar.scss
@@ -83,6 +83,43 @@ headerbar {
   font-weight: 600;
 }
 
+// Shared Luma application-identity trigger. Applications supply their real
+// GMenuModel and registered icon; the toolkit owns reusable geometry only.
+headerbar .luma-identity-button {
+  min-height: 32px;
+  padding: 0;
+  border-radius: 10px;
+}
+
+headerbar .luma-identity-button > button {
+  min-height: 32px;
+  padding: 4px 8px 4px 4px;
+  border-radius: 10px;
+  background: transparent;
+  box-shadow: none;
+  color: var(--headerbar-fg-color);
+  font-size: 13px;
+  font-weight: 650;
+}
+
+headerbar .luma-identity-button > button:hover {
+  background: unquote("@luma_hover");
+}
+
+headerbar .luma-identity-button > button:active,
+headerbar .luma-identity-button > button:checked {
+  background: unquote("@luma_selected");
+}
+
+headerbar .luma-identity-icon {
+  -gtk-icon-size: 20px;
+}
+
+headerbar .luma-identity-chevron {
+  -gtk-icon-size: 10px;
+  color: unquote("@luma_muted");
+}
+
 // Figtree 12.5px needs a 16px logical line at 1x. Keep one-line stock titles
 // from being rounded down to a 15px allocation without altering their native
 // alignment or attaching them to Prairie's custom title component.
