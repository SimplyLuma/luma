+@define-color luma_image #865f9f;
+@define-color luma_audio #b17a3c;
+@define-color luma_code #3b8967;
+@define-color luma_frost_outer RGB(241 242 243 / 73%);
+@define-color luma_frost_content RGB(251 251 250 / 92%);
+@define-color luma_glass_outer RGB(255 255 255 / 31%);
+@define-color luma_glass_content RGB(246 244 240 / 85%);
+@define-color luma_translucent_ink #2c343a;
+@define-color luma_translucent_line RGB(37 46 54 / 10.5%);
