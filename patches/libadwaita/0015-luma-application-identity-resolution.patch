   gtk_dep,
   appstream_dep,
   cc.find_library('m', required: false),
diff --git a/src/stylesheet/widgets/_header-bar.scss b/src/stylesheet/widgets/_header-bar.scss
index 768974d..6907ad5 100644
--- a/src/stylesheet/widgets/_header-bar.scss
+++ b/src/stylesheet/widgets/_header-bar.scss
@@ -112,7 +112,31 @@ headerbar .luma-identity-button > button:checked {
   background: unquote("@luma_selected");
 }
 
+// The non-interactive display form is a plain box; it must carry the same
+// geometry and Figtree weight as the menu-button form instead of inheriting
+// generic label styling.
+headerbar box.luma-identity-button {
+  min-height: 32px;
+  padding: 4px 8px 4px 4px;
+  border-radius: 10px;
+  color: var(--headerbar-fg-color);
+}
+
+headerbar .luma-identity-button,
+headerbar .luma-identity-button > button,
+headerbar .luma-identity-label {
+  font-family: "Figtree", sans-serif;
+  font-size: 13px;
+  font-weight: 650;
+}
+
 headerbar .luma-identity-icon {
+  min-width: 22px;
+  min-height: 22px;
+  border-radius: 6px;
+}
+
+headerbar .luma-identity-icon > image {
   -gtk-icon-size: 20px;
 }
 
