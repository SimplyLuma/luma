From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <devnull@projectluma.local>
Date: Wed, 2 Sep 2026 11:30:00 -0500
Subject: [PATCH] header-bar: host title-slot controls on the command row; split views become sidebar islands

The clean title row carries text only. A header bar that owns the automatic
Luma identity keeps AdwWindowTitle, GtkLabel and GtkInscription title widgets
centered and hosts any other title widget (view switchers, buttons, search)
at the center of its command row; adw_header_bar_get_title_widget() keeps
returning the application's widget. A navigation or overlay split view that is
the native work surface becomes transparent and presents its sidebar and
content panes as sibling islands with the 9px gap; both split views drop their
pane classes while collapsed, so the rules fall back on their own.
---

diff --git a/src/adw-header-bar.c b/src/adw-header-bar.c
index f9d82db..cf1a6a5 100644
--- a/src/adw-header-bar.c
+++ b/src/adw-header-bar.c
@@ -193,6 +193,7 @@ struct _AdwHeaderBar {
   GtkWidget *luma_command_bar;
   GtkWidget *luma_command_start;
   GtkWidget *luma_command_end;
+  GtkWidget *luma_hosted_title;
 
   char *decoration_layout;
 
@@ -235,6 +236,8 @@ static void luma_update_title_widget_duplicate (AdwHeaderBar *self);
 static void luma_enter_command_row (AdwHeaderBar *self);
 static void luma_leave_command_row (AdwHeaderBar *self);
 static void luma_update_command_bar_visibility (AdwHeaderBar *self);
+static void luma_host_title (AdwHeaderBar *self);
+static void luma_unhost_title (AdwHeaderBar *self);
 
 static void adw_header_bar_buildable_init (GtkBuildableIface *iface);
 
@@ -865,7 +868,65 @@ luma_update_command_bar_visibility (AdwHeaderBar *self)
 
   gtk_widget_set_visible (self->luma_command_bar,
                           gtk_widget_get_visible (self->luma_command_start) ||
-                          gtk_widget_get_visible (self->luma_command_end));
+                          gtk_widget_get_visible (self->luma_command_end) ||
+                          (self->luma_hosted_title &&
+                           gtk_widget_get_visible (self->luma_hosted_title)));
+}
+
+/* Luma title slot.
+ *
+ * The clean title row carries text only.  A header that owns the automatic
+ * identity keeps AdwWindowTitle, GtkLabel and GtkInscription title widgets
+ * centered; any other title widget is a control (view switchers, stack
+ * switchers, search entries, buttons) and is hosted in the command row's
+ * center slot instead.  The widget stays the application's; only its parent
+ * changes, and adw_header_bar_get_title_widget() keeps returning it.
+ */
+static gboolean
+luma_title_widget_is_text (GtkWidget *widget)
+{
+  return widget == NULL ||
+         ADW_IS_WINDOW_TITLE (widget) ||
+         GTK_IS_LABEL (widget) ||
+         GTK_IS_INSCRIPTION (widget);
+}
+
+static void
+luma_host_title (AdwHeaderBar *self)
+{
+  GtkWidget *title = self->title_widget;
+
+  if (!self->luma_command_bar || self->luma_hosted_title ||
+      luma_title_widget_is_text (title))
+    return;
+
+  g_object_ref (title);
+  adw_bin_set_child (ADW_BIN (self->center_bin), NULL);
+  gtk_widget_add_css_class (title, "luma-command-title");
+  gtk_center_box_set_center_widget (GTK_CENTER_BOX (self->luma_command_bar), title);
+  g_signal_connect_swapped (title, "notify::visible",
+                            G_CALLBACK (luma_update_command_bar_visibility), self);
+  g_object_unref (title);
+  self->luma_hosted_title = title;
+  luma_update_command_bar_visibility (self);
+}
+
+static void
+luma_unhost_title (AdwHeaderBar *self)
+{
+  GtkWidget *title = self->luma_hosted_title;
+
+  if (!title)
+    return;
+
+  g_object_ref (title);
+  g_signal_handlers_disconnect_by_func (title, luma_update_command_bar_visibility, self);
+  gtk_center_box_set_center_widget (GTK_CENTER_BOX (self->luma_command_bar), NULL);
+  gtk_widget_remove_css_class (title, "luma-command-title");
+  self->luma_hosted_title = NULL;
+  if (self->title_widget == title)
+    adw_bin_set_child (ADW_BIN (self->center_bin), title);
+  g_object_unref (title);
 }
 
 static void
@@ -905,6 +966,7 @@ luma_enter_command_row (AdwHeaderBar *self)
 
   luma_move_children (self, self->start_box, self->luma_command_start, NULL);
   luma_move_children (self, self->end_box, self->luma_command_end, NULL);
+  luma_host_title (self);
   luma_update_command_bar_visibility (self);
 
   toolbar_view = gtk_widget_get_ancestor (GTK_WIDGET (self), ADW_TYPE_TOOLBAR_VIEW);
@@ -929,6 +991,7 @@ luma_leave_command_row (AdwHeaderBar *self)
   g_signal_handlers_disconnect_by_func (self->luma_command_end,
                                         luma_update_command_bar_visibility, self);
 
+  luma_unhost_title (self);
   luma_move_children (self, self->luma_command_start, self->start_box, NULL);
   luma_move_children (self, self->luma_command_end, self->end_box, self->end_controls);
 
@@ -1812,6 +1875,14 @@ adw_header_bar_set_title_widget (AdwHeaderBar *self,
     gtk_widget_remove_css_class (self->title_widget, "luma-repeats-identity");
   }
 
+  if (self->luma_hosted_title) {
+    g_signal_handlers_disconnect_by_func (self->luma_hosted_title,
+                                          luma_update_command_bar_visibility, self);
+    gtk_widget_remove_css_class (self->luma_hosted_title, "luma-command-title");
+    gtk_center_box_set_center_widget (GTK_CENTER_BOX (self->luma_command_bar), NULL);
+    self->luma_hosted_title = NULL;
+  }
+
   adw_bin_set_child (ADW_BIN (self->center_bin), NULL);
   self->title_widget = NULL;
 
@@ -1819,6 +1890,7 @@ adw_header_bar_set_title_widget (AdwHeaderBar *self,
     self->title_widget = title_widget;
 
     adw_bin_set_child (ADW_BIN (self->center_bin), title_widget);
+    luma_host_title (self);
 
     self->title_label = NULL;
 
diff --git a/src/adw-widget-utils.c b/src/adw-widget-utils.c
index 23c46d1..39c52f9 100644
--- a/src/adw-widget-utils.c
+++ b/src/adw-widget-utils.c
@@ -18,6 +18,8 @@
 #include "config.h"
 
 #include "adw-widget-utils-private.h"
+#include "adw-navigation-split-view.h"
+#include "adw-overlay-split-view.h"
 
 #include <pango/pango.h>
 
@@ -811,10 +813,15 @@ adw_widget_set_luma_work_surface (GtkWidget *widget,
       gtk_widget_set_overflow (widget, GTK_OVERFLOW_HIDDEN);
     }
     gtk_widget_add_css_class (widget, "luma-native-work-surface");
+    /* Luma: a split view as the work surface presents its sidebar and content
+     * panes as sibling islands instead of one slab with a divider. */
+    if (ADW_IS_NAVIGATION_SPLIT_VIEW (widget) || ADW_IS_OVERLAY_SPLIT_VIEW (widget))
+      gtk_widget_add_css_class (widget, "luma-split-surface");
   } else {
     gpointer saved = g_object_get_data (G_OBJECT (widget), luma_work_surface_overflow_key);
 
     gtk_widget_remove_css_class (widget, "luma-native-work-surface");
+    gtk_widget_remove_css_class (widget, "luma-split-surface");
     if (saved) {
       gtk_widget_set_overflow (widget, GPOINTER_TO_INT (saved) - 1);
       g_object_set_data (G_OBJECT (widget), luma_work_surface_overflow_key, NULL);
diff --git a/src/stylesheet/_common.scss b/src/stylesheet/_common.scss
index 53b1121..333fbda 100644
--- a/src/stylesheet/_common.scss
+++ b/src/stylesheet/_common.scss
@@ -280,6 +280,46 @@ window.luma-native-window:not(.luma-app-window):not(.luma-files-window):not(.lum
     opacity: 1;
   }
 
+  // A split view as the work surface: the container is transparent and its
+  // panes are sibling islands with the canonical 9px gap.  Both split views
+  // drop the pane classes while collapsed, so the rules fall back naturally.
+  .luma-native-work-surface.luma-split-surface {
+    background: none;
+    border: none;
+    box-shadow: none;
+
+    > .sidebar-pane,
+    > .content-pane {
+      background-color: unquote("@luma_content");
+      border: 1px solid unquote("@luma_line");
+      border-radius: 10px;
+      box-shadow: 0 2px 5px RGB(25 27 31 / 16%),
+                  0 18px 36px -16px RGB(25 27 31 / 48%);
+      outline: none;
+      --shade-color: transparent;
+      --sidebar-shade-color: transparent;
+    }
+
+    > .sidebar-pane:not(.end):dir(ltr),
+    > .sidebar-pane.end:dir(rtl) { margin-right: 9px; }
+    > .sidebar-pane:not(.end):dir(rtl),
+    > .sidebar-pane.end:dir(ltr) { margin-left: 9px; }
+  }
+
+  &:backdrop .luma-native-work-surface.luma-split-surface {
+    background: none;
+    border: none;
+    box-shadow: none;
+
+    > .sidebar-pane,
+    > .content-pane {
+      background-color: unquote("@luma_content");
+      border-color: unquote("@luma_line");
+      filter: none;
+      opacity: 1;
+    }
+  }
+
   @media (prefers-color-scheme: dark) {
     box-shadow: inset 0 0 0 1px RGB(255 255 255 / 4.5%),
                 0 3px 8px RGB(9 11 14 / 38%),
@@ -290,6 +330,16 @@ window.luma-native-window:not(.luma-app-window):not(.luma-files-window):not(.lum
       box-shadow: 0 2px 6px RGB(0 0 0 / 42%),
                   0 20px 38px -15px RGB(0 0 0 / 78%);
     }
+
+    .luma-native-work-surface.luma-split-surface {
+      box-shadow: none;
+
+      > .sidebar-pane,
+      > .content-pane {
+        box-shadow: 0 2px 6px RGB(0 0 0 / 42%),
+                    0 20px 38px -15px RGB(0 0 0 / 78%);
+      }
+    }
   }
 }
 
diff --git a/src/stylesheet/widgets/_header-bar.scss b/src/stylesheet/widgets/_header-bar.scss
index 56ad7a5..b4d1e5f 100644
--- a/src/stylesheet/widgets/_header-bar.scss
+++ b/src/stylesheet/widgets/_header-bar.scss
@@ -483,6 +483,42 @@ headerbar.luma-command-host {
     margin: 5px 0;
   }
 
+  // A control hosted from the title slot sits in the command row's center.
+  // View switchers take the connected-group material; other controls keep
+  // their own presentation at the 30px command height.
+  > .luma-command-bar > .luma-command-title {
+    margin: 5px 0;
+  }
+
+  > .luma-command-bar > viewswitcher.luma-command-title,
+  > .luma-command-bar > .luma-command-title viewswitcher {
+    min-height: 30px;
+    margin-top: 0;
+    margin-bottom: 0;
+    border-spacing: 0;
+    border-radius: 8px;
+    background-color: unquote("@luma_fill");
+    box-shadow: inset 0 0 0 1px unquote("@luma_line");
+
+    > button {
+      min-height: 30px;
+      margin: 0;
+      padding: 0 12px;
+      border-radius: 0;
+      border-right: 1px solid unquote("@luma_line");
+      background: transparent;
+      box-shadow: none;
+
+      &:dir(rtl) { border-right: none; border-left: 1px solid unquote("@luma_line"); }
+      &:first-child { border-radius: 8px 0 0 8px; }
+      &:last-child { border-right: none; border-left: none; border-radius: 0 8px 8px 0; }
+      &:first-child:dir(rtl) { border-radius: 0 8px 8px 0; }
+      &:last-child:dir(rtl) { border-radius: 8px 0 0 8px; }
+      &:hover { background-color: unquote("@luma_hover"); }
+      &:checked { background-color: unquote("@luma_selected"); }
+    }
+  }
+
   .luma-command-group > button,
   .luma-command-group > button.image-button,
   .luma-command-group > button.text-button,
-- 
2.54.0
