+    -gtk-icon-size: 12px;
+  }
+
+  > button:hover,
+  > button.image-button:hover {
     background-color: unquote("@luma_hover");
   }
 
-  > button:active > image,
-  > button.image-button:active > image {
+  > button:active,
+  > button.image-button:active {
     background-color: unquote("@luma_selected");
   }
 
-  > button.close:hover > image,
-  > button.close:active > image {
