+// Opted-in split views use their child surfaces as the visible work islands.
+// The libadwaita pane bins must therefore remain transparent; painting the
+// stock sidebar surface here creates a second, false sidebar behind the app.
+.luma-island-split > .sidebar-pane,
+.luma-island-split > .content-pane {
+  background-color: transparent;
+  box-shadow: none;
+}
+
 // Luma product windows opt into the simulator's shared elevation. Keep this
 // class-scoped: ordinary libadwaita applications retain upstream decoration.
 window.luma-files-window,
