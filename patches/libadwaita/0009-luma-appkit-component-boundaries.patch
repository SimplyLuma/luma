+    min-height: 20px;
+    padding: 0;
+    border-radius: 999px;
+    background-color: transparent;
+    box-shadow: none;
+  }
 
   > button > image,
   > button.image-button > image {
+    -gtk-icon-size: 11px;
+    padding: 0;
     color: unquote("@luma_muted");
     background-color: transparent;
     box-shadow: none;
   }
 
