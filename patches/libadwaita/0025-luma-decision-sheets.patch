+
+/* Project Luma shared decision sheets. No application CSS provider required.
+ * GTK legacy message dialogs and non-alert AdwDialogs retain their contracts. */
+dialog-host > dialog.alert {
+  dimming { background: rgba(8, 11, 16, .52); }
+  sheet {
+    border-radius: 0 0 15px 15px;
+    background: #f6f7f8;
+    box-shadow: inset 0 0 0 1px rgba(9, 11, 14, .12),
+                0 3px 8px rgba(9, 11, 14, .24),
+                0 22px 48px -16px rgba(9, 11, 14, .5);
+    @media (prefers-color-scheme: dark) { background: #252a30; }
+  }
+}
+dialog.alert {
+  .message-area, &.short .message-area {
+    padding-top: 16px;
+    padding-bottom: 0;
+    border-spacing: 6px;
+    &.has-heading.has-body { border-spacing: 6px; }
+    > .heading-bin, > .body, > .child { padding-left: 16px; padding-right: 16px; }
+    .heading-bin label { font-size: 15px; font-weight: 750; letter-spacing: -0.18px; }
+    > .body { font-size: 13px; line-height: 1.53846; opacity: .66; }
+  }
+  .response-area, &.short .response-area {
+    padding: 16px 16px 12px;
+    border-spacing: 8px;
+    > button {
+      min-height: 34px; min-width: 0;
+      padding: 0 14px; border-radius: 10px;
+      font-size: 13px; font-weight: 650;
+      &.destructive-action {
+        background: transparent; color: #a6494d;
+        @media (prefers-color-scheme: dark) { color: #c05a5f; }
+        &:hover { background: unquote("alpha(currentColor, .1)"); }
+        &:active { background: unquote("alpha(currentColor, .18)"); }
+      }
+    }
+  }
+  @media (prefers-contrast: more) {
+    sheet { outline: 2px solid currentColor; }
+    .message-area > .body { opacity: 1; }
+  }
+}
