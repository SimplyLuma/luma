 }
 
+/* Luma: one title row per window.
+ *
+ * When a window's header bars live inside the panes of the split view that is
+ * its work surface, the window provides the 42px title row itself (identity
+ * and window controls).  The pane header bars then take pane roles: the
+ * sidebar pane's header becomes a pane toolbar that carries its actions on the
+ * command row and no title row of its own; the content pane's header stays a
+ * flat pane header with the page title and its actions.  Neither owns the
+ * identity or shows window controls.  The roles lift while a split view is
+ * collapsed, when the panes are a navigation stack again. */
+static GtkWidget *
+luma_window_title_row (GtkRoot *root)
+{
+  GtkWidget *row;
+
+  if (!GTK_IS_WINDOW (root))
+    return NULL;
+
+  row = g_object_get_data (G_OBJECT (root), "luma-window-title-row");
+
+  return row && gtk_widget_get_visible (row) ? row : NULL;
+}
+
+static gboolean
+luma_split_views_collapsed (AdwHeaderBar *self)
+{
+  GSList *l;
+
+  for (l = self->split_views; l; l = l->next) {
+    SplitViewData *data = l->data;
+
+    if (ADW_IS_NAVIGATION_SPLIT_VIEW (data->split_view) &&
+        adw_navigation_split_view_get_collapsed (ADW_NAVIGATION_SPLIT_VIEW (data->split_view)))
+      return TRUE;
+    if (ADW_IS_OVERLAY_SPLIT_VIEW (data->split_view) &&
+        adw_overlay_split_view_get_collapsed (ADW_OVERLAY_SPLIT_VIEW (data->split_view)))
+      return TRUE;
+  }
+
+  return FALSE;
+}
+
+static gboolean
+luma_widget_in_sidebar_pane (GtkWidget *widget)
+{
+  GtkWidget *ancestor = gtk_widget_get_parent (widget);
+
+  while (ancestor && !GTK_IS_ROOT (ancestor)) {
+    if (gtk_widget_has_css_class (ancestor, "sidebar-pane"))
+      return TRUE;
+    if (gtk_widget_has_css_class (ancestor, "content-pane"))
+      return FALSE;
+    ancestor = gtk_widget_get_parent (ancestor);
+  }
+
+  return FALSE;
+}
+
+static void
+luma_update_pane_role (AdwHeaderBar *self)
+{
+  GtkRoot *root = gtk_widget_get_root (GTK_WIDGET (self));
+  GtkWidget *row = luma_window_title_row (root);
+  gboolean pane = FALSE, toolbar = FALSE;
+
+  if (row && row != GTK_WIDGET (self) && self->split_views &&
+      !self->dialog && !self->sheet && !self->adaptive_preview &&
+      !luma_split_views_collapsed (self)) {
+    pane = TRUE;
+    toolbar = luma_widget_in_sidebar_pane (GTK_WIDGET (self));
+  }
+
+  if (pane == self->luma_pane_header && toolbar == self->luma_pane_toolbar)
+    return;
+
+  self->luma_pane_header = pane;
+  self->luma_pane_toolbar = toolbar;
+
+  if (pane) {
+    remove_automatic_luma_identity (self);
+    gtk_widget_add_css_class (GTK_WIDGET (self), "luma-pane-header");
+  } else {
+    gtk_widget_remove_css_class (GTK_WIDGET (self), "luma-pane-header");
+  }
+
+  if (toolbar) {
+    gtk_widget_add_css_class (GTK_WIDGET (self), "luma-pane-toolbar");
+    luma_enter_command_row (self);
+    gtk_widget_set_visible (self->handle, FALSE);
+  } else {
+    gtk_widget_remove_css_class (GTK_WIDGET (self), "luma-pane-toolbar");
+    gtk_widget_set_visible (self->handle, TRUE);
+    if (!self->luma_identity)
+      luma_leave_command_row (self);
+  }
+
+  if (!pane)
+    add_automatic_luma_identity (self);
+
+  update_title_buttons (self);
+  gtk_widget_queue_resize (GTK_WIDGET (self));
+}
+
+void
+adw_header_bar_luma_release_identity (AdwHeaderBar *self)
+{
+  remove_automatic_luma_identity (self);
+}
+
+void
+adw_header_bar_luma_claim_identity (AdwHeaderBar *self)
+{
+  add_automatic_luma_identity (self);
+}
+
+void
+adw_header_bar_luma_update_pane_role (AdwHeaderBar *self)
+{
+  luma_update_pane_role (self);
+}
+
 static void
 update_visible_dialog (AdwHeaderBar  *self)
 {
@@ -1318,6 +1451,8 @@ adw_header_bar_root (GtkWidget *widget)
 
       g_signal_connect_swapped (split_view, "notify::collapsed",
                                 G_CALLBACK (update_title_buttons), widget);
+      g_signal_connect_swapped (split_view, "notify::collapsed",
+                                G_CALLBACK (luma_update_pane_role), widget);
       g_signal_connect_swapped (split_view, "notify::sidebar-position",
                                 G_CALLBACK (update_title_buttons), widget);
 
@@ -1334,6 +1469,8 @@ adw_header_bar_root (GtkWidget *widget)
 
       g_signal_connect_swapped (split_view, "notify::collapsed",
                                 G_CALLBACK (update_title_buttons), widget);
+      g_signal_connect_swapped (split_view, "notify::collapsed",
+                                G_CALLBACK (luma_update_pane_role), widget);
       g_signal_connect_swapped (split_view, "notify::sidebar-position",
                                 G_CALLBACK (update_title_buttons), widget);
       g_signal_connect_swapped (split_view, "notify::show-sidebar",
@@ -1361,6 +1498,7 @@ adw_header_bar_root (GtkWidget *widget)
   update_title_buttons (self);
   update_decoration_layout (self, TRUE, TRUE);
   add_automatic_luma_identity (self);
+  luma_update_pane_role (self);
 }
 
 static void
@@ -1407,12 +1545,23 @@ adw_header_bar_unroot (GtkWidget *widget)
 
     g_signal_handlers_disconnect_by_func (data->split_view,
                                           update_title_buttons, widget);
+    g_signal_handlers_disconnect_by_func (data->split_view,
+                                          luma_update_pane_role, widget);
 
     g_free (data);
   }
 
   g_clear_pointer (&self->split_views, g_slist_free);
 
+  if (self->luma_pane_header) {
+    self->luma_pane_header = FALSE;
+    self->luma_pane_toolbar = FALSE;
+    gtk_widget_remove_css_class (GTK_WIDGET (self), "luma-pane-header");
+    gtk_widget_remove_css_class (GTK_WIDGET (self), "luma-pane-toolbar");
+    gtk_widget_set_visible (self->handle, TRUE);
+    luma_leave_command_row (self);
+  }
+
   GTK_WIDGET_CLASS (adw_header_bar_parent_class)->unroot (widget);
 }
 
