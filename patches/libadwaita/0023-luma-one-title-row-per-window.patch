diff --git a/src/stylesheet/widgets/_header-bar.scss b/src/stylesheet/widgets/_header-bar.scss
index b4d1e5f..145d951 100644
--- a/src/stylesheet/widgets/_header-bar.scss
+++ b/src/stylesheet/widgets/_header-bar.scss
@@ -483,6 +483,18 @@ headerbar.luma-command-host {
     margin: 5px 0;
   }
 
+  // The window's own title row above a split-view work surface: identity and
+  // window controls only, on the window material.
+  &.luma-window-title-row {
+    background: none;
+    box-shadow: none;
+  }
+
+  // A pane toolbar is the sidebar pane's header reduced to its command row.
+  &.luma-pane-toolbar > .luma-command-bar {
+    margin-top: 8px;
+  }
+
   // A control hosted from the title slot sits in the command row's center.
   // View switchers take the connected-group material; other controls keep
   // their own presentation at the 30px command height.
