   priv->bin = adw_breakpoint_bin_new ();
   adw_breakpoint_bin_set_warning_widget (ADW_BREAKPOINT_BIN (priv->bin),
                                          GTK_WIDGET (self));
-  adw_dialog_host_set_child (ADW_DIALOG_HOST (priv->dialog_host), priv->bin);
+  /* Luma: the window owns one title row.  It stays hidden unless the window's
+   * header bars live inside the panes of its split-view work surface, in which
+   * case it carries the identity and the window controls above the islands. */
+  priv->luma_title_row = adw_header_bar_new ();
+  adw_header_bar_set_show_title (ADW_HEADER_BAR (priv->luma_title_row), FALSE);
+  gtk_widget_add_css_class (priv->luma_title_row, "luma-window-title-row");
+  gtk_widget_set_visible (priv->luma_title_row, FALSE);
+  g_object_set_data (G_OBJECT (self), "luma-window-title-row", priv->luma_title_row);
+
+  priv->luma_frame = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  gtk_box_append (GTK_BOX (priv->luma_frame), priv->luma_title_row);
+  gtk_widget_set_vexpand (priv->bin, TRUE);
+  gtk_box_append (GTK_BOX (priv->luma_frame), priv->bin);
+  adw_dialog_host_set_child (ADW_DIALOG_HOST (priv->dialog_host), priv->luma_frame);
 
   g_signal_connect_swapped (priv->bin, "notify::current-breakpoint",
                             G_CALLBACK (notify_current_breakpoint_cb), self);
@@ -404,6 +422,52 @@ set_luma_content_classes (GtkWidget *content,
   adw_widget_set_luma_work_surface (work_surface, enabled);
 }
 
+
+/* Luma: decide whether this window provides the title row (see AdwHeaderBar's
+ * pane roles), hand the identity to it, and let every header bar in the
+ * content pick its role. */
+static void
+luma_foreach_header_bar (GtkWidget *widget)
+{
+  GtkWidget *child;
+
+  if (ADW_IS_HEADER_BAR (widget)) {
+    adw_header_bar_luma_update_pane_role (ADW_HEADER_BAR (widget));
+    return;
+  }
+
+  for (child = gtk_widget_get_first_child (widget); child; child = gtk_widget_get_next_sibling (child))
+    luma_foreach_header_bar (child);
+}
+
+static void
+luma_update_title_row (AdwApplicationWindow *self)
+{
+  AdwApplicationWindowPrivate *priv = adw_application_window_get_instance_private (self);
+  GtkWidget *content = adw_application_window_get_content (self);
+  gboolean split = content &&
+                   gtk_widget_has_css_class (GTK_WIDGET (self), "luma-adw-native-window") &&
+                   (ADW_IS_NAVIGATION_SPLIT_VIEW (content) || ADW_IS_OVERLAY_SPLIT_VIEW (content)) &&
+                   gtk_widget_has_css_class (content, "luma-split-surface");
+  AdwHeaderBar *owner;
+
+  owner = g_object_get_data (G_OBJECT (self), "adw-header-bar-luma-identity-owner");
+
+  if (!split && owner == ADW_HEADER_BAR (priv->luma_title_row))
+    adw_header_bar_luma_release_identity (owner);
+
+  gtk_widget_set_visible (priv->luma_title_row, split);
+
+  if (split) {
+    if (owner && owner != ADW_HEADER_BAR (priv->luma_title_row))
+      adw_header_bar_luma_release_identity (owner);
+    adw_header_bar_luma_claim_identity (ADW_HEADER_BAR (priv->luma_title_row));
+  }
+
+  if (content)
+    luma_foreach_header_bar (content);
+}
+
 /**
  * adw_application_window_set_content:
  * @self: an application window
@@ -437,6 +501,7 @@ adw_application_window_set_content (AdwApplicationWindow *self,
   adw_breakpoint_bin_set_child (ADW_BREAKPOINT_BIN (priv->bin), content);
 
   set_luma_content_classes (content, TRUE);
+  luma_update_title_row (self);
 
   g_object_notify_by_pspec (G_OBJECT (self), props[PROP_CONTENT]);
 }
