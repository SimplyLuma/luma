-    // upstream shadows. The shared neutral hairline defines the edge.
-    box-shadow: 0 5px 16px RGB(30 41 59 / 4%),
-                0 0 0 1px RGB(17 24 39 / 10%);
-    margin: 0px;
-    border-radius: var(--window-radius);
-
-    // A neutral hairline replaces upstream's light-catching white rim.
-    outline: 1px solid color-mix(in srgb, #111827 10%, transparent);
