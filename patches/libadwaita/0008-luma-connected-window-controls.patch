diff --git a/src/stylesheet/widgets/_header-bar.scss b/src/stylesheet/widgets/_header-bar.scss
--- a/src/stylesheet/widgets/_header-bar.scss
+++ b/src/stylesheet/widgets/_header-bar.scss
@@ -311,6 +311,62 @@ windowcontrols {
     margin: 4px;
   }
 }
+
+// Luma product windows use one quiet connected control island. Keep this
+// class-scoped so ordinary libadwaita applications retain the upstream window
+// controls, while source-integrated Luma apps converge with Luma AppKit.
+window.luma-files-window headerbar.luma-titlebar windowcontrols,
+window.luma-calculator-window headerbar.luma-calculator-titlebar windowcontrols,
+window.luma-app-window headerbar.luma-titlebar windowcontrols {
+  padding: 2px;
+  border-spacing: 1px;
+  border-radius: 999px;
+  background-color: unquote("@luma_content");
+  box-shadow: inset 0 0 0 1px RGB(33 37 43 / 5.5%),
+              0 2px 5px RGB(25 27 31 / 16%),
+              0 18px 36px -16px RGB(25 27 31 / 48%);
+
+  > button > image,
+  > button.image-button > image {
+    color: unquote("@luma_muted");
+    background-color: transparent;
+    box-shadow: none;
+  }
+
+  > button:hover > image,
+  > button.image-button:hover > image {
+    background-color: unquote("@luma_hover");
+  }
+
+  > button:active > image,
+  > button.image-button:active > image {
+    background-color: unquote("@luma_selected");
+  }
+
+  > button.close:hover > image,
+  > button.close:active > image {
+    color: #9f4037;
+    background-color: RGB(189 90 78 / 16%);
+  }
+
+  > button.minimize:hover > image,
+  > button.minimize:active > image {
+    color: #8c5b1e;
+    background-color: RGB(176 120 43 / 16%);
+  }
+
+  > button.maximize:hover > image,
+  > button.maximize:active > image {
+    color: #376f3a;
+    background-color: RGB(79 138 82 / 16%);
+  }
+
+  @media (prefers-color-scheme: dark) {
+    box-shadow: inset 0 0 0 1px RGB(255 255 255 / 5.5%),
+                0 2px 6px RGB(0 0 0 / 42%),
+                0 20px 38px -15px RGB(0 0 0 / 78%);
+  }
+}
 
