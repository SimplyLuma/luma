 }
 
+// A checked button in a smoked header takes the smoked state slate
+// (ADR-043): a light-mode slate stands only ~3:1 from the veil there.
+window.csd.luma-treatment-frost headerbar,
+window.csd.luma-treatment-glass headerbar {
+  --luma-state: #a9b5c1;
+  --luma-state-ink: #161a1f;
+  --luma-knob-ring: #a9b5c1;
+}
+window.csd.luma-treatment-frost headerbar { --luma-knob: #1f252d; }
+window.csd.luma-treatment-glass headerbar { --luma-knob: #151a21; }
+
