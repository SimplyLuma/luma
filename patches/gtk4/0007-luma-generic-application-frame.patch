+/* Luma command row.
+ *
+ * A window-level GtkHeaderBar that owns the automatic application identity
+ * keeps the clean title row (identity, title, native window controls) and
+ * re-hosts its packed start/end children on a secondary command surface
+ * directly below. The widgets, their actions, signals, tooltips, accessible
+ * names and visibility are untouched; gtk_header_bar_pack_start/pack_end and
+ * gtk_header_bar_remove keep working. Only structurally safe patterns opt in:
+ * the header bar must be the window titlebar or the first child of a vertical
+ * GtkBox that is the window child, in a non-transient application window that
+ * is not an explicit Luma product window, and must not carry the
+ * luma-no-command-row escape class.
+ */
+
+static gboolean
+luma_window_is_generic (GtkWindow *window)
+{
+  GtkWidget *widget = GTK_WIDGET (window);
+
+  return !gtk_widget_has_css_class (widget, "luma-app-window") &&
+         !gtk_widget_has_css_class (widget, "luma-files-window") &&
+         !gtk_widget_has_css_class (widget, "luma-calculator-window") &&
+         !gtk_widget_has_css_class (widget, "luma-no-native-surfaces");
+}
+
+static gboolean
+luma_command_row_allowed (GtkHeaderBar *bar)
+{
+  GtkRoot *root = gtk_widget_get_root (GTK_WIDGET (bar));
+  GtkWidget *parent;
+
+  if (!bar->luma_identity ||
+      !GTK_IS_WINDOW (root) ||
+      gtk_widget_has_css_class (GTK_WIDGET (bar), "luma-no-command-row") ||
+      gtk_widget_has_css_class (GTK_WIDGET (bar), "luma-no-automatic-identity") ||
+      !luma_window_is_generic (GTK_WINDOW (root)))
+    return FALSE;
+
+  if (gtk_window_get_titlebar (GTK_WINDOW (root)) == GTK_WIDGET (bar))
+    return TRUE;
+
+  parent = gtk_widget_get_parent (GTK_WIDGET (bar));
+  if (GTK_IS_BOX (parent) &&
+      gtk_orientable_get_orientation (GTK_ORIENTABLE (parent)) == GTK_ORIENTATION_VERTICAL &&
+      gtk_widget_get_first_child (parent) == GTK_WIDGET (bar) &&
+      gtk_window_get_child (GTK_WINDOW (root)) == parent)
+    return TRUE;
+
+  return FALSE;
+}
+
+static gboolean
+luma_is_title_row_child (GtkHeaderBar *bar,
+                         GtkWidget    *child)
+{
+  return child == bar->start_window_controls ||
+         child == bar->end_window_controls ||
+         child == bar->luma_identity;
+}
+
+static void
+luma_update_group_visibility (GtkWidget *group)
+{
+  GtkWidget *child;
+  gboolean has_visible = FALSE;
+
+  for (child = gtk_widget_get_first_child (group);
+       child;
+       child = gtk_widget_get_next_sibling (child))
+    {
+      if (gtk_widget_get_visible (child))
+        {
+          has_visible = TRUE;
+          break;
+        }
+    }
+
+  gtk_widget_set_visible (group, has_visible);
+}
+
+static void
+luma_update_command_bar_visibility (GtkHeaderBar *bar)
+{
+  if (!bar->luma_command_bar)
+    return;
+
+  gtk_widget_set_visible (bar->luma_command_bar,
+                          gtk_widget_get_visible (bar->luma_command_start) ||
+                          gtk_widget_get_visible (bar->luma_command_end));
+}
+
+static void
+luma_move_children (GtkHeaderBar *bar,
+                    GtkWidget    *from,
+                    GtkWidget    *to,
+                    GtkWidget    *before,
+                    gboolean      track)
+{
+  GtkWidget *child = gtk_widget_get_first_child (from);
+  GtkWidget *anchor = before ? gtk_widget_get_prev_sibling (before) : NULL;
+  gboolean anchored = before != NULL;
+
+  while (child)
+    {
+      GtkWidget *next = gtk_widget_get_next_sibling (child);
+
+      if (!luma_is_title_row_child (bar, child))
+        {
+          g_object_ref (child);
+          g_signal_handlers_disconnect_by_func (child, luma_update_group_visibility, from);
+          gtk_box_remove (GTK_BOX (from), child);
+          if (anchored)
+            {
+              gtk_box_insert_child_after (GTK_BOX (to), child, anchor);
+              anchor = child;
+            }
+          else
+            {
+              gtk_box_append (GTK_BOX (to), child);
+            }
+          if (track)
+            g_signal_connect_swapped (child, "notify::visible",
+                                      G_CALLBACK (luma_update_group_visibility), to);
+          g_object_unref (child);
+        }
+
+      child = next;
+    }
+}
+
+static void
+luma_enter_command_row (GtkHeaderBar *bar)
+{
+  GtkRoot *root;
+
+  if (bar->luma_command_bar || !luma_command_row_allowed (bar))
+    return;
+
+  root = gtk_widget_get_root (GTK_WIDGET (bar));
+
+  bar->luma_command_start = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_add_css_class (bar->luma_command_start, "luma-command-group");
+  gtk_widget_set_valign (bar->luma_command_start, GTK_ALIGN_CENTER);
+  bar->luma_command_end = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_add_css_class (bar->luma_command_end, "luma-command-group");
+  gtk_widget_set_valign (bar->luma_command_end, GTK_ALIGN_CENTER);
+
+  bar->luma_command_bar = gtk_center_box_new ();
+  gtk_widget_add_css_class (bar->luma_command_bar, "luma-command-bar");
+  gtk_center_box_set_start_widget (GTK_CENTER_BOX (bar->luma_command_bar), bar->luma_command_start);
+  gtk_center_box_set_end_widget (GTK_CENTER_BOX (bar->luma_command_bar), bar->luma_command_end);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (bar->luma_command_bar),
+                                  GTK_ACCESSIBLE_PROPERTY_LABEL,
+                                  g_dgettext (GETTEXT_PACKAGE, "Toolbar"),
+                                  -1);
+
+  g_signal_connect_swapped (bar->luma_command_start, "notify::visible",
+                            G_CALLBACK (luma_update_command_bar_visibility), bar);
+  g_signal_connect_swapped (bar->luma_command_end, "notify::visible",
+                            G_CALLBACK (luma_update_command_bar_visibility), bar);
+
+  gtk_widget_set_layout_manager (GTK_WIDGET (bar),
+                                 gtk_box_layout_new (GTK_ORIENTATION_VERTICAL));
+  gtk_widget_insert_after (bar->luma_command_bar, GTK_WIDGET (bar), bar->handle);
+  gtk_widget_add_css_class (GTK_WIDGET (bar), "luma-command-host");
+  gtk_widget_add_css_class (GTK_WIDGET (root), "luma-has-command-row");
+
+  luma_move_children (bar, bar->start_box, bar->luma_command_start, NULL, TRUE);
+  luma_move_children (bar, bar->end_box, bar->luma_command_end, NULL, TRUE);
+  luma_update_group_visibility (bar->luma_command_start);
+  luma_update_group_visibility (bar->luma_command_end);
+  luma_update_command_bar_visibility (bar);
+  update_default_decoration (bar);
+}
+
+static void
+luma_leave_command_row (GtkHeaderBar *bar)
+{
+  GtkRoot *root;
+
+  if (!bar->luma_command_bar)
+    return;
+
+  root = gtk_widget_get_root (GTK_WIDGET (bar));
+  if (GTK_IS_WINDOW (root))
+    gtk_widget_remove_css_class (GTK_WIDGET (root), "luma-has-command-row");
+
+  g_signal_handlers_disconnect_by_func (bar->luma_command_start,
+                                        luma_update_command_bar_visibility, bar);
+  g_signal_handlers_disconnect_by_func (bar->luma_command_end,
+                                        luma_update_command_bar_visibility, bar);
+
+  luma_move_children (bar, bar->luma_command_start, bar->start_box, NULL, FALSE);
+  luma_move_children (bar, bar->luma_command_end, bar->end_box, bar->end_window_controls, FALSE);
+
+  gtk_widget_remove_css_class (GTK_WIDGET (bar), "luma-command-host");
+  g_clear_pointer (&bar->luma_command_bar, gtk_widget_unparent);
+  bar->luma_command_start = NULL;
+  bar->luma_command_end = NULL;
+  gtk_widget_set_layout_manager (GTK_WIDGET (bar), gtk_bin_layout_new ());
   update_default_decoration (bar);
 }
 
@@ -453,6 +798,11 @@ update_default_decoration (GtkHeaderBar *bar)
                 break;
               }
           }
+
+      if (!have_children && bar->luma_command_start &&
+          (_gtk_widget_get_first_child (bar->luma_command_start) ||
+           _gtk_widget_get_first_child (bar->luma_command_end)))
+        have_children = TRUE;
     }
 
   if (have_children || bar->title_widget != NULL)
@@ -492,6 +842,9 @@ update_title (GtkHeaderBar *bar)
     title = g_get_prgname ();
 
   gtk_label_set_text (GTK_LABEL (bar->title_label), title);
+  gtk_widget_set_visible (bar->title_label,
+                          !(bar->luma_identity && bar->luma_identity_name &&
+                            title && g_str_equal (title, bar->luma_identity_name)));
 }
 
 static void
@@ -619,6 +972,10 @@ gtk_header_bar_dispose (GObject *object)
   bar->start_box = NULL;
   bar->end_box = NULL;
 
+  g_clear_pointer (&bar->luma_identity_name, g_free);
+  g_clear_pointer (&bar->luma_command_bar, gtk_widget_unparent);
+  bar->luma_command_start = NULL;
+  bar->luma_command_end = NULL;
   g_clear_pointer (&bar->handle, gtk_widget_unparent);
 
   G_OBJECT_CLASS (gtk_header_bar_parent_class)->dispose (object);
@@ -705,7 +1062,21 @@ gtk_header_bar_pack (GtkHeaderBar *bar,
 {
   g_return_if_fail (gtk_widget_get_parent (widget) == NULL);
 
-  if (pack_type == GTK_PACK_START)
+  if (bar->luma_command_bar)
+    {
+      GtkWidget *group = pack_type == GTK_PACK_START ? bar->luma_command_start
+                                                     : bar->luma_command_end;
+
+      if (pack_type == GTK_PACK_START)
+        gtk_box_append (GTK_BOX (group), widget);
+      else
+        gtk_box_prepend (GTK_BOX (group), widget);
+
+      g_signal_connect_swapped (widget, "notify::visible",
+                                G_CALLBACK (luma_update_group_visibility), group);
+      luma_update_group_visibility (group);
+    }
+  else if (pack_type == GTK_PACK_START)
     {
       gtk_box_append (GTK_BOX (bar->start_box), widget);
     }
@@ -754,6 +1125,14 @@ gtk_header_bar_remove (GtkHeaderBar *bar,
       gtk_center_box_set_center_widget (GTK_CENTER_BOX (bar->center_box), NULL);
       removed = TRUE;
     }
+  else if (parent && bar->luma_command_bar &&
+           (parent == bar->luma_command_start || parent == bar->luma_command_end))
+    {
+      g_signal_handlers_disconnect_by_func (child, luma_update_group_visibility, parent);
