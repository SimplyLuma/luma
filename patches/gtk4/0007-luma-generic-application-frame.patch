diff --git a/gtk/theme/Default/_common.scss b/gtk/theme/Default/_common.scss
index 31bb218..5d95b73 100644
--- a/gtk/theme/Default/_common.scss
+++ b/gtk/theme/Default/_common.scss
@@ -4611,3 +4611,104 @@ menubutton {
     }
   }
 }
+
+// Luma generic application frame: identity typography and icon clip, title-row
+// geometry, the command row hosted by the window's header bar, and the work
+// surface rhythm. Kept in sync with Default-light.css / Default-dark.css.
+window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) {
+  headerbar {
+    padding: 0 8px 0 12px;
+    background: if($variant == 'light', #f1f2f3, #21252b);
+    box-shadow: none;
+
+    &:backdrop {
+      background: if($variant == 'light', #f1f2f3, #21252b);
+      color: if($variant == 'light', #283038, #e4e8ea);
+      transition: none;
+
+      > windowhandle { filter: none; transition: none; }
+    }
+
+    &.luma-command-host {
+      padding: 0;
+
+      > windowhandle { min-height: 42px; padding: 0 8px 0 12px; }
+
+      > .luma-command-bar {
+        min-height: 40px;
+        margin: 0 9px 8px;
+        padding: 0 8px;
+        border: 1px solid if($variant == 'light', rgba(39, 48, 56, 0.095), rgba(255, 255, 255, 0.08));
+        border-radius: 10px;
+        background-color: if($variant == 'light', #fbfbfa, #2a2e34);
+        color: if($variant == 'light', #283038, #e4e8ea);
+        box-shadow: if($variant == 'light',
+                       (0 2px 5px rgba(25, 27, 31, 0.12), 0 14px 30px -18px rgba(25, 27, 31, 0.42)),
+                       (0 2px 6px rgba(0, 0, 0, 0.32), 0 16px 32px -18px rgba(0, 0, 0, 0.72)));
+      }
+
+      .luma-command-group {
+        margin: 5px 0;
+        border-radius: 8px;
+        background-color: if($variant == 'light', rgba(39, 48, 56, 0.04), rgba(255, 255, 255, 0.038));
+        box-shadow: inset 0 0 0 1px if($variant == 'light', rgba(39, 48, 56, 0.095), rgba(255, 255, 255, 0.08));
+      }
+
+      // GTK's stock header rule gives every button and menubutton 6px vertical
+      // margins; the connected group owns its own 30px targets.
+      .luma-command-group > menubutton { margin: 0; }
+
+      .luma-command-group > button,
+      .luma-command-group > menubutton > button {
+        min-width: 30px;
+        min-height: 30px;
+        padding: 0 9px;
+        margin: 0;
+        border: none;
+        border-right: 1px solid if($variant == 'light', rgba(39, 48, 56, 0.095), rgba(255, 255, 255, 0.08));
+        border-radius: 0;
+        background: transparent;
+        box-shadow: none;
+        color: if($variant == 'light', #283038, #e4e8ea);
+
+        > image { -gtk-icon-size: 14px; color: inherit; }
+        &:hover { background-color: if($variant == 'light', rgba(39, 48, 56, 0.06), rgba(255, 255, 255, 0.06)); }
+        &:active, &:checked { background-color: if($variant == 'light', rgba(39, 48, 56, 0.105), rgba(255, 255, 255, 0.108)); }
+        &:disabled { color: if($variant == 'light', #757e87, #8b949c); }
+      }
+
+      .luma-command-group > :first-child,
+      .luma-command-group > menubutton:first-child > button { border-radius: 8px 0 0 8px; }
+      .luma-command-group > :last-child,
+      .luma-command-group > menubutton:last-child > button { border-right: none; border-radius: 0 8px 8px 0; }
+      .luma-command-group > :only-child,
+      .luma-command-group > menubutton:only-child > button { border-right: none; border-radius: 8px; }
+    }
+
+    .luma-identity-button, .luma-identity-label { font-weight: 650; }
+    .luma-identity-content { border-spacing: 0; }
+    .luma-identity-icon { min-width: 20px; min-height: 20px; border-radius: 6px; }
+    .luma-identity-icon > image { -gtk-icon-size: 20px; }
+
+    // The connected control pill is 24px tall inside the 42px row; the stock
+    // image-button width and the row-filling height must not apply to it.
+    windowcontrols {
+      margin-top: 9px;
+      margin-bottom: 9px;
+      padding: 2px;
+
+      > button, > button.image-button {
+        min-width: 20px;
+        min-height: 20px;
+        padding: 0;
+        margin: 0;
+        border-radius: 9999px;
+
+        > image { min-width: 20px; min-height: 20px; padding: 0; -gtk-icon-size: 11px; }
+      }
+    }
+  }
+
+  > .luma-native-work-surface { margin-top: 9px; }
+  &.luma-has-command-row > .luma-native-work-surface { margin-top: 0; }
+}
