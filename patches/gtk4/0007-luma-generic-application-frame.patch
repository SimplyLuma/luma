+/* The desktop entry is the user-visible identity authority: it carries the
+ * localized application name and the registered icon. GtkApplication only
+ * knows the application ID, so resolve through GDesktopAppInfo before falling
+ * back to process metadata. */
+static GDesktopAppInfo *
+luma_lookup_desktop_info (GtkApplication *application)
+{
+#ifdef G_OS_UNIX
+  const char *application_id = g_application_get_application_id (G_APPLICATION (application));
+  char *desktop_id;
+  GDesktopAppInfo *info;
+
+  if (!application_id || !*application_id)
+    return NULL;
+
+  desktop_id = g_strconcat (application_id, ".desktop", NULL);
+  info = g_desktop_app_info_new (desktop_id);
+  g_free (desktop_id);
+
+  return info;
+#else
+  return NULL;
+#endif
+}
+
+static char *
+luma_resolve_application_name (GtkApplication *application,
+                               GtkWindow      *window)
+{
+  GDesktopAppInfo *info = luma_lookup_desktop_info (application);
+  const char *application_name = NULL;
+  char *result;
+
+  if (info)
+    application_name = g_app_info_get_display_name (G_APP_INFO (info));
+  if (!application_name || !*application_name)
+    application_name = g_get_application_name ();
+  if (!application_name || !*application_name)
+    application_name = gtk_window_get_title (window);
+  if (!application_name || !*application_name)
+    application_name = g_get_prgname ();
+  if (!application_name || !*application_name)
+    application_name = g_dgettext (GETTEXT_PACKAGE, "Application");
+
+  result = g_strdup (application_name);
+  g_clear_object (&info);
+
+  return result;
+}
+
+static gboolean
+luma_theme_has_icon (GtkWindow  *window,
+                     const char *icon_name)
+{
+  GtkIconTheme *theme;
+
+  if (!icon_name || !*icon_name)
+    return FALSE;
+
+  theme = gtk_icon_theme_get_for_display (gtk_widget_get_display (GTK_WIDGET (window)));
+
+  return gtk_icon_theme_has_icon (theme, icon_name);
+}
