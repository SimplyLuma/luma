 static GtkWidget *
-create_luma_identity (GtkApplication *application,
-                      GtkWindow      *window)
+luma_create_application_icon (GtkApplication *application,
+                              GtkWindow      *window)
+{
+  GDesktopAppInfo *info = luma_lookup_desktop_info (application);
+  const char *application_id = g_application_get_application_id (G_APPLICATION (application));
+  const char *icon_name;
+  GtkWidget *icon = NULL;
+
+  icon_name = gtk_window_get_icon_name (window);
+  if (luma_theme_has_icon (window, icon_name))
+    icon = gtk_image_new_from_icon_name (icon_name);
+
+  if (!icon)
+    {
+      icon_name = gtk_window_get_default_icon_name ();
+      if (luma_theme_has_icon (window, icon_name))
+        icon = gtk_image_new_from_icon_name (icon_name);
+    }
+
+  if (!icon && info)
+    {
+      GIcon *gicon = g_app_info_get_icon (G_APP_INFO (info));
+
+      if (G_IS_THEMED_ICON (gicon))
+        {
+          const char * const *names = g_themed_icon_get_names (G_THEMED_ICON (gicon));
+          guint i;
+
+          for (i = 0; names && names[i] && !icon; i++)
+            if (luma_theme_has_icon (window, names[i]))
+              icon = gtk_image_new_from_icon_name (names[i]);
+        }
+      else if (gicon)
+        {
+          icon = gtk_image_new_from_gicon (gicon);
+        }
+    }
+
+  if (!icon && luma_theme_has_icon (window, application_id))
+    icon = gtk_image_new_from_icon_name (application_id);
+
+  if (!icon)
+    icon = gtk_image_new_from_icon_name ("application-x-executable");
+
+  gtk_image_set_pixel_size (GTK_IMAGE (icon), 20);
+  g_clear_object (&info);
+
+  return icon;
+}
