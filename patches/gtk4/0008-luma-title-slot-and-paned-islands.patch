index c6504e5..a6afd30 100644
--- a/gtk/theme/Default/Default-dark.css
+++ b/gtk/theme/Default/Default-dark.css
@@ -643,6 +643,12 @@ window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfa
 
 window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) { background-color: #21252b; color: #e4e8ea; font-family: "Figtree", sans-serif; }
 
+window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) > paned.luma-native-work-surface.luma-split-surface { background: none; border: none; box-shadow: none; }
