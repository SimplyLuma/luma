From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <devnull@projectluma.local>
Date: Wed, 2 Sep 2026 11:30:00 -0500
Subject: [PATCH] headerbar: host title-slot controls on the command row; paned surfaces become islands

The clean title row carries text only. A GtkHeaderBar that owns the automatic
Luma identity keeps GtkLabel and GtkInscription titles centered and hosts any
other title widget at the center of its command row;
gtk_header_bar_get_title_widget() keeps returning the application's widget.
A GtkPaned that is the native work surface becomes transparent and both panes
become clipped islands separated by the 9px handle, in the maintained SCSS and
the generated release CSS.
---

diff --git a/gtk/gtkheaderbar.c b/gtk/gtkheaderbar.c
index de49187..64be119 100644
--- a/gtk/gtkheaderbar.c
+++ b/gtk/gtkheaderbar.c
@@ -29,6 +29,7 @@
 #include "gtkcenterbox.h"
 #include "gtkimage.h"
 #include "gtklabel.h"
+#include "gtkinscription.h"
 #include "gtkmenubutton.h"
 #include "gtkprivate.h"
 #include "gtktypebuiltins.h"
@@ -149,6 +150,7 @@ struct _GtkHeaderBar
   GtkWidget *luma_command_bar;
   GtkWidget *luma_command_start;
   GtkWidget *luma_command_end;
+  GtkWidget *luma_hosted_title;
 
   char *decoration_layout;
 
@@ -180,6 +182,9 @@ static void add_automatic_luma_identity (GtkHeaderBar *bar);
 static void update_title (GtkHeaderBar *bar);
 static void luma_enter_command_row (GtkHeaderBar *bar);
 static void luma_leave_command_row (GtkHeaderBar *bar);
+static void luma_update_command_bar_visibility (GtkHeaderBar *bar);
+static void luma_host_title (GtkHeaderBar *bar);
+static void luma_unhost_title (GtkHeaderBar *bar);
 
 static void gtk_header_bar_buildable_init (GtkBuildableIface *iface);
 static void update_default_decoration (GtkHeaderBar *bar);
@@ -615,7 +620,57 @@ luma_update_command_bar_visibility (GtkHeaderBar *bar)
 
   gtk_widget_set_visible (bar->luma_command_bar,
                           gtk_widget_get_visible (bar->luma_command_start) ||
-                          gtk_widget_get_visible (bar->luma_command_end));
+                          gtk_widget_get_visible (bar->luma_command_end) ||
+                          (bar->luma_hosted_title &&
+                           gtk_widget_get_visible (bar->luma_hosted_title)));
+}
+
+/* Luma title slot: the clean title row carries text only.  A header that owns
+ * the automatic identity keeps GtkLabel and GtkInscription titles centered;
+ * any other title widget is a control and is hosted in the command row's
+ * center slot.  gtk_header_bar_get_title_widget() keeps returning it. */
+static gboolean
+luma_title_widget_is_text (GtkWidget *widget)
+{
+  return widget == NULL || GTK_IS_LABEL (widget) || GTK_IS_INSCRIPTION (widget);
+}
+
+static void
+luma_host_title (GtkHeaderBar *bar)
+{
+  GtkWidget *title = bar->title_widget;
+
+  if (!bar->luma_command_bar || bar->luma_hosted_title ||
+      luma_title_widget_is_text (title))
+    return;
+
+  g_object_ref (title);
+  gtk_center_box_set_center_widget (GTK_CENTER_BOX (bar->center_box), NULL);
+  gtk_widget_add_css_class (title, "luma-command-title");
+  gtk_center_box_set_center_widget (GTK_CENTER_BOX (bar->luma_command_bar), title);
+  g_signal_connect_swapped (title, "notify::visible",
+                            G_CALLBACK (luma_update_command_bar_visibility), bar);
+  g_object_unref (title);
+  bar->luma_hosted_title = title;
+  luma_update_command_bar_visibility (bar);
+}
+
+static void
+luma_unhost_title (GtkHeaderBar *bar)
+{
+  GtkWidget *title = bar->luma_hosted_title;
+
+  if (!title)
+    return;
+
+  g_object_ref (title);
+  g_signal_handlers_disconnect_by_func (title, luma_update_command_bar_visibility, bar);
+  gtk_center_box_set_center_widget (GTK_CENTER_BOX (bar->luma_command_bar), NULL);
+  gtk_widget_remove_css_class (title, "luma-command-title");
+  bar->luma_hosted_title = NULL;
+  if (bar->title_widget == title)
+    gtk_center_box_set_center_widget (GTK_CENTER_BOX (bar->center_box), title);
+  g_object_unref (title);
 }
 
 static void
@@ -696,6 +751,7 @@ luma_enter_command_row (GtkHeaderBar *bar)
 
   luma_move_children (bar, bar->start_box, bar->luma_command_start, NULL, TRUE);
   luma_move_children (bar, bar->end_box, bar->luma_command_end, NULL, TRUE);
+  luma_host_title (bar);
   luma_update_group_visibility (bar->luma_command_start);
   luma_update_group_visibility (bar->luma_command_end);
   luma_update_command_bar_visibility (bar);
@@ -719,6 +775,7 @@ luma_leave_command_row (GtkHeaderBar *bar)
   g_signal_handlers_disconnect_by_func (bar->luma_command_end,
                                         luma_update_command_bar_visibility, bar);
 
+  luma_unhost_title (bar);
   luma_move_children (bar, bar->luma_command_start, bar->start_box, NULL, FALSE);
   luma_move_children (bar, bar->luma_command_end, bar->end_box, bar->end_window_controls, FALSE);
 
@@ -896,6 +953,15 @@ gtk_header_bar_set_title_widget (GtkHeaderBar *bar,
   if (bar->title_widget == title_widget)
     return;
 
+  if (bar->luma_hosted_title)
+    {
+      g_signal_handlers_disconnect_by_func (bar->luma_hosted_title,
+                                            luma_update_command_bar_visibility, bar);
+      gtk_widget_remove_css_class (bar->luma_hosted_title, "luma-command-title");
+      gtk_center_box_set_center_widget (GTK_CENTER_BOX (bar->luma_command_bar), NULL);
+      bar->luma_hosted_title = NULL;
+    }
+
   gtk_center_box_set_center_widget (GTK_CENTER_BOX (bar->center_box), NULL);
   bar->title_widget = NULL;
 
@@ -906,6 +972,7 @@ gtk_header_bar_set_title_widget (GtkHeaderBar *bar,
       gtk_center_box_set_center_widget (GTK_CENTER_BOX (bar->center_box), title_widget);
 
       bar->title_label = NULL;
+      luma_host_title (bar);
     }
   else
     {
diff --git a/gtk/gtkpaned.c b/gtk/gtkpaned.c
index e4c9743..079b79c 100644
--- a/gtk/gtkpaned.c
+++ b/gtk/gtkpaned.c
@@ -1657,6 +1657,12 @@ gtk_paned_set_start_child (GtkPaned  *paned,
       gtk_widget_insert_before (child, GTK_WIDGET (paned), paned->handle_widget);
     }
 
+  if (child && gtk_widget_has_css_class (GTK_WIDGET (paned), "luma-split-surface"))
+    {
+      gtk_widget_add_css_class (child, "luma-pane-island");
+      gtk_widget_set_overflow (child, GTK_OVERFLOW_HIDDEN);
+    }
+
   g_object_notify (G_OBJECT (paned), "start-child");
 }
 
@@ -1777,6 +1783,12 @@ gtk_paned_set_end_child (GtkPaned  *paned,
       gtk_widget_insert_after (child, GTK_WIDGET (paned), paned->handle_widget);
     }
 
+  if (child && gtk_widget_has_css_class (GTK_WIDGET (paned), "luma-split-surface"))
+    {
+      gtk_widget_add_css_class (child, "luma-pane-island");
+      gtk_widget_set_overflow (child, GTK_OVERFLOW_HIDDEN);
+    }
+
   g_object_notify (G_OBJECT (paned), "end-child");
 }
 
diff --git a/gtk/gtkwindow.c b/gtk/gtkwindow.c
index e9e564d..e6b97e1 100644
--- a/gtk/gtkwindow.c
+++ b/gtk/gtkwindow.c
@@ -25,6 +25,7 @@
 #include "config.h"
 
 #include "gtkwindowprivate.h"
+#include "gtkpaned.h"
 
 #include "gtkaccessibleprivate.h"
 #include "gtkapplicationprivate.h"
@@ -7036,6 +7037,23 @@ gtk_window_set_child (GtkWindow *window,
                              GINT_TO_POINTER (gtk_widget_get_overflow (child) + 1));
           gtk_widget_set_overflow (child, GTK_OVERFLOW_HIDDEN);
           gtk_widget_add_css_class (child, "luma-native-work-surface");
+          /* Luma: a paned work surface presents both panes as islands. Children
+           * placed before the window adopted the paned are marked here; later
+           * children are marked by the paned setters. */
+          if (GTK_IS_PANED (child))
+            {
+              GtkWidget *panes[2] = { gtk_paned_get_start_child (GTK_PANED (child)),
+                                      gtk_paned_get_end_child (GTK_PANED (child)) };
+              guint i;
+
+              gtk_widget_add_css_class (child, "luma-split-surface");
+              for (i = 0; i < 2; i++)
+                if (panes[i])
+                  {
+                    gtk_widget_add_css_class (panes[i], "luma-pane-island");
+                    gtk_widget_set_overflow (panes[i], GTK_OVERFLOW_HIDDEN);
+                  }
+            }
         }
 
       priv->child = child;
