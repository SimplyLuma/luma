+window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host > .luma-command-bar > .luma-command-title { margin: 5px 0; }
+
+window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host > .luma-command-bar > stackswitcher.luma-command-title { min-height: 30px; border-spacing: 0; border-radius: 8px; background-color: rgba(39, 48, 56, 0.04); box-shadow: inset 0 0 0 1px rgba(39, 48, 56, 0.095); }
