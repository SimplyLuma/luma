 window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host .luma-command-group > button, window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host .luma-command-group > menubutton > button { min-width: 30px; min-height: 30px; padding: 0 9px; margin: 0; border: none; border-right: 1px solid rgba(39, 48, 56, 0.095); border-radius: 0; background: transparent; box-shadow: none; color: #283038; }
 
 window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host .luma-command-group > button > image, window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host .luma-command-group > menubutton > button > image { -gtk-icon-size: 14px; color: inherit; }
diff --git a/gtk/theme/Default/_common.scss b/gtk/theme/Default/_common.scss
index 5d95b73..f7ccc58 100644
--- a/gtk/theme/Default/_common.scss
+++ b/gtk/theme/Default/_common.scss
@@ -1718,6 +1718,32 @@ window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfa
   color: if($variant == 'light', #283038, #e4e8ea);
   font-family: "Figtree", sans-serif;
 
+  > paned.luma-native-work-surface.luma-split-surface {
+    background: none;
+    border: none;
+    box-shadow: none;
+
+    > separator {
+      min-width: 9px;
+      min-height: 9px;
+      margin: 0;
+      background: none;
+      border: none;
+      box-shadow: none;
+    }
+
+    > .luma-pane-island {
+      border: 1px solid if($variant == 'light', rgba(39, 48, 56, 0.095), rgba(255, 255, 255, 0.08));
+      border-radius: 10px;
+      background-color: if($variant == 'light', #fbfbfa, #2a2e34);
+      box-shadow: if($variant == 'light',
+                     (0 2px 5px rgba(25, 27, 31, 0.16),
+                      0 18px 36px -16px rgba(25, 27, 31, 0.48)),
+                     (0 2px 6px rgba(0, 0, 0, 0.42),
+                      0 20px 38px -15px rgba(0, 0, 0, 0.78)));
+    }
+  }
+
   > .luma-native-work-surface {
     margin: 0 9px 9px;
     border: 1px solid if($variant == 'light', rgba(39, 48, 56, 0.095), rgba(255, 255, 255, 0.08));
@@ -4658,6 +4684,36 @@ window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfa
       // margins; the connected group owns its own 30px targets.
       .luma-command-group > menubutton { margin: 0; }
 
+      // A control hosted from the title slot sits at the command row's center.
+      // Stack switchers take the connected-group material; other controls keep
+      // their own presentation at the 30px command height.
+      > .luma-command-bar > .luma-command-title { margin: 5px 0; }
+
+      > .luma-command-bar > stackswitcher.luma-command-title {
+        min-height: 30px;
+        border-spacing: 0;
+        border-radius: 8px;
+        background-color: if($variant == 'light', rgba(39, 48, 56, 0.04), rgba(255, 255, 255, 0.038));
+        box-shadow: inset 0 0 0 1px if($variant == 'light', rgba(39, 48, 56, 0.095), rgba(255, 255, 255, 0.08));
+
+        > button {
+          min-height: 30px;
+          margin: 0;
+          padding: 0 12px;
+          border: none;
+          border-right: 1px solid if($variant == 'light', rgba(39, 48, 56, 0.095), rgba(255, 255, 255, 0.08));
+          border-radius: 0;
+          background: transparent;
+          box-shadow: none;
+          color: if($variant == 'light', #283038, #e4e8ea);
+
+          &:first-child { border-radius: 8px 0 0 8px; }
+          &:last-child { border-right: none; border-radius: 0 8px 8px 0; }
+          &:hover { background-color: if($variant == 'light', rgba(39, 48, 56, 0.06), rgba(255, 255, 255, 0.06)); }
+          &:checked { background-color: if($variant == 'light', rgba(39, 48, 56, 0.105), rgba(255, 255, 255, 0.108)); }
+        }
+      }
+
       .luma-command-group > button,
       .luma-command-group > menubutton > button {
         min-width: 30px;
