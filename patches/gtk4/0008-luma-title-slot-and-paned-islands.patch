+
 window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) > .luma-native-work-surface { margin: 0 9px 9px; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px; background-color: #2a2e34; color: #e4e8ea; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.42), 0 20px 38px -15px rgba(0, 0, 0, 0.78); }
 
 headerbar switch { margin-top: 10px; margin-bottom: 10px; }
@@ -1967,6 +1973,21 @@ window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfa
 
 window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host .luma-command-group > menubutton { margin: 0; }
 
+window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host > .luma-command-bar > .luma-command-title { margin: 5px 0; }
+
+window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host > .luma-command-bar > stackswitcher.luma-command-title { min-height: 30px; border-spacing: 0; border-radius: 8px; background-color: rgba(255, 255, 255, 0.038); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08); }
+
+window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host > .luma-command-bar > stackswitcher.luma-command-title > button { min-height: 30px; margin: 0; padding: 0 12px; border: none; border-right: 1px solid rgba(255, 255, 255, 0.08); border-radius: 0; background: transparent; box-shadow: none; color: #e4e8ea; }
+
+window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host > .luma-command-bar > stackswitcher.luma-command-title > button:first-child { border-radius: 8px 0 0 8px; }
+
+window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host > .luma-command-bar > stackswitcher.luma-command-title > button:last-child { border-right: none; border-radius: 0 8px 8px 0; }
+
+window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host > .luma-command-bar > stackswitcher.luma-command-title > button:hover { background-color: rgba(255, 255, 255, 0.06); }
+
+window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host > .luma-command-bar > stackswitcher.luma-command-title > button:checked { background-color: rgba(255, 255, 255, 0.108); }
+
+
 window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host .luma-command-group > button, window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host .luma-command-group > menubutton > button { min-width: 30px; min-height: 30px; padding: 0 9px; margin: 0; border: none; border-right: 1px solid rgba(255, 255, 255, 0.08); border-radius: 0; background: transparent; box-shadow: none; color: #e4e8ea; }
 
 window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host .luma-command-group > button > image, window.luma-native-window:not(.luma-adw-native-window):not(.luma-no-native-surfaces) headerbar.luma-command-host .luma-command-group > menubutton > button > image { -gtk-icon-size: 14px; color: inherit; }
