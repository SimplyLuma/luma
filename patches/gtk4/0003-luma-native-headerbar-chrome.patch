From 9b1f8c25103b47a6e3d69bd9f32cb5046ba43d9a Mon Sep 17 00:00:00 2001
From: Project Luma <devnull@projectluma.local>
Date: Mon, 31 Aug 2026 17:58:00 -0500
Subject: [PATCH] theme: make Luma headerbar chrome the native GTK default

Give ordinary GTK 4 client-side decorations the same 42px title row,
Figtree typography, and compact connected window controls as libadwaita.
Applications keep their native GtkWindowControls actions and accessibility;
the toolkit owns only their system presentation.

diff --git a/gtk/theme/Default/_common.scss b/gtk/theme/Default/_common.scss
index e73a470..501619f 100644
--- a/gtk/theme/Default/_common.scss
+++ b/gtk/theme/Default/_common.scss
@@ -1457,32 +1457,50 @@ infobar {
  *****************/
 
 windowcontrols {
-  border-spacing: 6px;
-
-  &:not(.empty) {
-    &.start:dir(ltr),
-    &.end:dir(rtl) {
-      margin-right: 7px;
-    }
-
-    &.start:dir(rtl),
-    &.end:dir(ltr) {
-      margin-left: 7px;
-    }
-  }
+  min-height: 20px;
+  padding: 2px;
+  border-spacing: 0;
+  border-radius: 9999px;
+  background-color: $base_color;
+  box-shadow: if($variant == 'light',
+                 (inset 0 0 0 1px rgba(33, 37, 43, 0.055),
+                  0 2px 5px rgba(25, 27, 31, 0.16),
+                  0 18px 36px -16px rgba(25, 27, 31, 0.48)),
+                 (inset 0 0 0 1px rgba(255, 255, 255, 0.055),
+                  0 2px 6px rgba(0, 0, 0, 0.42),
+                  0 20px 38px -15px rgba(0, 0, 0, 0.78)));
 
   button {
     @extend %button_basic_flat;
 
     box-shadow: none;
     border: none;
-    min-width: 34px;
+    border-radius: 9999px;
+    min-width: 20px;
+    min-height: 20px;
     padding: 0;
 
     > image {
         border-radius: 9999px;
-        min-height: 30px;
-        min-width: 30px;
+        min-height: 20px;
+        min-width: 20px;
+        -gtk-icon-size: 11px;
+        color: $insensitive_fg_color;
+    }
+    &.close:hover > image,
+    &.close:active > image {
+      color: #9f4037;
+      background-color: rgba(189, 90, 78, 0.16);
+    }
+    &.minimize:hover > image,
+    &.minimize:active > image {
+      color: #8c5b1e;
+      background-color: rgba(176, 120, 43, 0.16);
+    }
+    &.maximize:hover > image,
+    &.maximize:active > image {
+      color: #376f3a;
+      background-color: rgba(79, 138, 82, 0.16);
     }
     &:hover > image {
       //special case hover colors inside a headerbar
@@ -1506,11 +1525,12 @@ windowcontrols {
 %titlebar,
 headerbar {
   padding: 0 6px;
-  min-height: 46px;
-  border-width: 0 0 1px;
+  min-height: 42px;
+  border-width: 0;
   border-style: solid;
   border-color: $alt_borders_color;
   border-radius: 0;
+  font-family: "Figtree", sans-serif;
 
   @include headerbar_fill(darken($bg_color, 10%));
 
@@ -1564,7 +1584,7 @@ headerbar {
   }
 
   &.default-decoration {
-    min-height: 28px;
+    min-height: 42px;
     padding: 4px;
 
     windowcontrols {
@@ -1627,11 +1647,7 @@ headerbar {
     }
 
     &.end {
-      margin-right: -6px;
-
-      > button:last-child {
-        padding-right: 6px;
-      }
+      margin-right: 0;
     }
   }
 
diff --git a/gtk/theme/Default/Default-dark.css b/gtk/theme/Default/Default-dark.css
index 00f5333..7023355 100644
--- a/gtk/theme/Default/Default-dark.css
+++ b/gtk/theme/Default/Default-dark.css
@@ -568,15 +568,17 @@ infobar .close:hover, searchbar .close:hover { color: #eeeeec; border-color: #1b
 infobar .close:hover, searchbar .close:hover { color: #eeeeec; border-color: #1b1b1b; background-image: linear-gradient(to top, #303030 20%, #323232 90%); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.07); }
 
 /***************** Title buttons * */
-windowcontrols { border-spacing: 6px; }
+windowcontrols { min-height: 20px; padding: 2px; border-spacing: 0; border-radius: 9999px; background-color: #2d2d2d; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.055), 0 2px 6px rgba(0, 0, 0, 0.42), 0 20px 38px -15px rgba(0, 0, 0, 0.78); }
 
-windowcontrols:not(.empty).start:dir(ltr), windowcontrols:not(.empty).end:dir(rtl) { margin-right: 7px; }
+windowcontrols button { box-shadow: none; border: none; border-radius: 9999px; min-width: 20px; min-height: 20px; padding: 0; }
 
-windowcontrols:not(.empty).start:dir(rtl), windowcontrols:not(.empty).end:dir(ltr) { margin-left: 7px; }
+windowcontrols button > image { border-radius: 9999px; min-height: 20px; min-width: 20px; -gtk-icon-size: 11px; color: #919190; }
 
-windowcontrols button { box-shadow: none; border: none; min-width: 34px; padding: 0; }
+windowcontrols button.close:hover > image, windowcontrols button.close:active > image { color: #9f4037; background-color: rgba(189, 90, 78, 0.16); }
 
-windowcontrols button > image { border-radius: 9999px; min-height: 30px; min-width: 30px; }
+windowcontrols button.minimize:hover > image, windowcontrols button.minimize:active > image { color: #8c5b1e; background-color: rgba(176, 120, 43, 0.16); }
+
+windowcontrols button.maximize:hover > image, windowcontrols button.maximize:active > image { color: #376f3a; background-color: rgba(79, 138, 82, 0.16); }
 
 windowcontrols button:hover > image { border-color: transparent; background-image: none; box-shadow: none; background-color: #1b1b1b; }
 
@@ -585,7 +587,7 @@ windowcontrols button:active > image, windowcontrols button:checked > image { bo
 windowcontrols button:hover, windowcontrols button:active, windowcontrols button:checked { background: none; }
 
 /*************** Header bars * */
-.titlebar:not(headerbar), headerbar { padding: 0 6px; min-height: 46px; border-width: 0 0 1px; border-style: solid; border-color: #070707; border-radius: 0; background: #1b1b1b linear-gradient(to top, #262626, #2b2b2b); /* Darken switchbuttons for headerbars. issue #1588 */ }
+.titlebar:not(headerbar), headerbar { padding: 0 6px; min-height: 42px; border-width: 0; border-style: solid; border-color: #070707; border-radius: 0; font-family: "Figtree", sans-serif; background: #1b1b1b linear-gradient(to top, #262626, #2b2b2b); /* Darken switchbuttons for headerbars. issue #1588 */ }
 
 .titlebar:backdrop:not(headerbar), headerbar:backdrop { border-color: #202020; background-color: #353535; background-image: none; transition: 200ms ease-out; }
 
@@ -601,7 +603,7 @@ windowcontrols button:hover, windowcontrols button:active, windowcontrols button
 
 .tiled .titlebar:not(headerbar), .tiled-top .titlebar:not(headerbar), .tiled-left .titlebar:not(headerbar), .tiled-right .titlebar:not(headerbar), .tiled-bottom .titlebar:not(headerbar), .maximized .titlebar:not(headerbar), .fullscreen .titlebar:not(headerbar), .tiled headerbar, .tiled-top headerbar, .tiled-left headerbar, .tiled-right headerbar, .tiled-bottom headerbar, .maximized headerbar, .fullscreen headerbar { border-radius: 0; }
 
-.default-decoration.titlebar:not(headerbar), headerbar.default-decoration { min-height: 28px; padding: 4px; }
+.default-decoration.titlebar:not(headerbar), headerbar.default-decoration { min-height: 42px; padding: 4px; }
 
 .default-decoration.titlebar:not(headerbar) windowcontrols button, .default-decoration.titlebar:not(headerbar) windowcontrols menubutton, headerbar.default-decoration windowcontrols button, headerbar.default-decoration windowcontrols menubutton { min-height: 26px; min-width: 26px; margin: 0; padding: 0; }
 
@@ -617,9 +619,7 @@ headerbar windowcontrols > button { margin: 0; }
 
 headerbar windowcontrols.start > image.icon { -gtk-icon-size: 20px; }
 
-headerbar windowcontrols.end { margin-right: -6px; }
-
-headerbar windowcontrols.end > button:last-child { padding-right: 6px; }
+headerbar windowcontrols.end { margin-right: 0; }
 
 headerbar menubutton > button { margin-top: 0px; margin-bottom: 0px; }
 
diff --git a/gtk/theme/Default/Default-light.css b/gtk/theme/Default/Default-light.css
index c639464..60f78eb 100644
--- a/gtk/theme/Default/Default-light.css
+++ b/gtk/theme/Default/Default-light.css
@@ -576,15 +576,17 @@ infobar .close:hover, searchbar .close:hover { color: #2e3436; border-color: #cd
 infobar .close:hover, searchbar .close:hover { color: #2e3436; border-color: #cdc7c2; background-image: linear-gradient(to top, #d6d1cd, #e8e6e3 1px); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.07); }
 
 /***************** Title buttons * */
-windowcontrols { border-spacing: 6px; }
+windowcontrols { min-height: 20px; padding: 2px; border-spacing: 0; border-radius: 9999px; background-color: #ffffff; box-shadow: inset 0 0 0 1px rgba(33, 37, 43, 0.055), 0 2px 5px rgba(25, 27, 31, 0.16), 0 18px 36px -16px rgba(25, 27, 31, 0.48); }
 
-windowcontrols:not(.empty).start:dir(ltr), windowcontrols:not(.empty).end:dir(rtl) { margin-right: 7px; }
+windowcontrols button { box-shadow: none; border: none; border-radius: 9999px; min-width: 20px; min-height: 20px; padding: 0; }
 
-windowcontrols:not(.empty).start:dir(rtl), windowcontrols:not(.empty).end:dir(ltr) { margin-left: 7px; }
+windowcontrols button > image { border-radius: 9999px; min-height: 20px; min-width: 20px; -gtk-icon-size: 11px; color: #929595; }
 
-windowcontrols button { box-shadow: none; border: none; min-width: 34px; padding: 0; }
+windowcontrols button.close:hover > image, windowcontrols button.close:active > image { color: #9f4037; background-color: rgba(189, 90, 78, 0.16); }
 
-windowcontrols button > image { border-radius: 9999px; min-height: 30px; min-width: 30px; }
+windowcontrols button.minimize:hover > image, windowcontrols button.minimize:active > image { color: #8c5b1e; background-color: rgba(176, 120, 43, 0.16); }
+
+windowcontrols button.maximize:hover > image, windowcontrols button.maximize:active > image { color: #376f3a; background-color: rgba(79, 138, 82, 0.16); }
 
 windowcontrols button:hover > image { border-color: transparent; background-image: none; box-shadow: none; background-color: #d1ccc7; }
 
@@ -593,7 +595,7 @@ windowcontrols button:active > image, windowcontrols button:checked > image { bo
 windowcontrols button:hover, windowcontrols button:active, windowcontrols button:checked { background: none; }
 
 /*************** Header bars * */
-.titlebar:not(headerbar), headerbar { padding: 0 6px; min-height: 46px; border-width: 0 0 1px; border-style: solid; border-color: #bfb8b1; border-radius: 0; background: #dfdcd8 linear-gradient(to top, #dad6d2, #e1dedb); /* Darken switchbuttons for headerbars. issue #1588 */ }
+.titlebar:not(headerbar), headerbar { padding: 0 6px; min-height: 42px; border-width: 0; border-style: solid; border-color: #bfb8b1; border-radius: 0; font-family: "Figtree", sans-serif; background: #dfdcd8 linear-gradient(to top, #dad6d2, #e1dedb); /* Darken switchbuttons for headerbars. issue #1588 */ }
 
 .titlebar:backdrop:not(headerbar), headerbar:backdrop { border-color: #d5d0cc; background-color: #f6f5f4; background-image: none; transition: 200ms ease-out; }
 
@@ -609,7 +611,7 @@ windowcontrols button:hover, windowcontrols button:active, windowcontrols button
 
 .tiled .titlebar:not(headerbar), .tiled-top .titlebar:not(headerbar), .tiled-left .titlebar:not(headerbar), .tiled-right .titlebar:not(headerbar), .tiled-bottom .titlebar:not(headerbar), .maximized .titlebar:not(headerbar), .fullscreen .titlebar:not(headerbar), .tiled headerbar, .tiled-top headerbar, .tiled-left headerbar, .tiled-right headerbar, .tiled-bottom headerbar, .maximized headerbar, .fullscreen headerbar { border-radius: 0; }
 
-.default-decoration.titlebar:not(headerbar), headerbar.default-decoration { min-height: 28px; padding: 4px; }
+.default-decoration.titlebar:not(headerbar), headerbar.default-decoration { min-height: 42px; padding: 4px; }
 
 .default-decoration.titlebar:not(headerbar) windowcontrols button, .default-decoration.titlebar:not(headerbar) windowcontrols menubutton, headerbar.default-decoration windowcontrols button, headerbar.default-decoration windowcontrols menubutton { min-height: 26px; min-width: 26px; margin: 0; padding: 0; }
 
@@ -625,9 +627,7 @@ headerbar windowcontrols > button { margin: 0; }
 
 headerbar windowcontrols.start > image.icon { -gtk-icon-size: 20px; }
 
-headerbar windowcontrols.end { margin-right: -6px; }
-
-headerbar windowcontrols.end > button:last-child { padding-right: 6px; }
+headerbar windowcontrols.end { margin-right: 0; }
 
 headerbar menubutton > button { margin-top: 0px; margin-bottom: 0px; }
 
-- 
