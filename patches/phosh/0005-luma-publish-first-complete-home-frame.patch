From: Project Luma <maintainers@projectluma.org>
Date: Sun, 30 Aug 2026 22:01:00 -0500
Subject: [PATCH] shell: publish readiness once the desktop actually exists

Phosh normally holds its startup shield for an arbitrary extra second after the
shell is ready, which makes an authenticated Luma handoff linger on the
wallpaper even though the home surface is already assembled. Replacing that
timeout with the top panel's first frame removed the delay but published
readiness far too early.

The desktop the handoff reveals is not one surface. The wallpaper, the top
panel and the home bar are three independent layer surfaces, each with its own
configure round trip and its own frame clock, and the top panel is the smallest
and quickest of them. Releasing Presence on its first paint exposed a bare
desktop while the wallpaper was still undrawn and let the drag surfaces commit
their folded state in view, which is what produced a blank frame followed by a
flash of quick options between Presence and Home.

Wait for every one of those surfaces to be configured by the compositor, then
for two frame-clock cycles on the home surface. GDK drives that clock from
wl_surface.frame callbacks, so a second cycle means the compositor presented
the first rather than merely accepting it.

A five second deadline publishes anyway and warns, so a surface that never
configures degrades to the old early reveal instead of stranding the user on
the greeter with no way forward.

---
--- a/src/shell.c
+++ b/src/shell.c
@@ -209,7 +209,11 @@
   PhoshRotationManager       *rotation_manager;
 
   gboolean                    startup_finished;
-  guint startup_finished_id;
+  GdkFrameClock              *startup_frame_clock;
+  gulong                      startup_finished_id;
+  guint                       luma_pending_surfaces;
+  guint                       luma_frames;
+  guint                       luma_deadline_id;
 
   GSimpleActionGroup         *action_map;
 
@@ -601,7 +605,9 @@
   PhoshShell *self = PHOSH_SHELL (object);
   PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
 
-  g_clear_handle_id (&priv->startup_finished_id, g_source_remove);
+  g_clear_handle_id (&priv->luma_deadline_id, g_source_remove);
+  g_clear_signal_handler (&priv->startup_finished_id, priv->startup_frame_clock);
+  g_clear_object (&priv->startup_frame_clock);
 
   panels_dispose (self);
   g_clear_pointer (&priv->faders, g_ptr_array_unref);
@@ -826,21 +832,160 @@
 }
 
 
-static void
-on_startup_finished (gpointer data)
+/* The handoff releases Presence, so it must not fire until the desktop the user
+ * is about to see actually exists. That desktop is not one surface: the
+ * wallpaper, the top panel and the home bar are three independent layer
+ * surfaces, each with its own configure round trip and its own frame clock.
+ * Waiting on the top panel alone published readiness while the wallpaper had
+ * not been drawn and the drag surfaces had not committed their folded state,
+ * which is exactly what exposed a bare desktop and a flash of quick options
+ * between Presence and Home. */
+
+#define LUMA_HANDOFF_DEADLINE_MS 5000
+
+
+static void
+luma_publish_home_ready (PhoshShell *self, const char *why)
 {
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  g_autoptr (GError) error = NULL;
+
+  g_clear_handle_id (&priv->luma_deadline_id, g_source_remove);
+  g_clear_signal_handler (&priv->startup_finished_id, priv->startup_frame_clock);
+  g_clear_object (&priv->startup_frame_clock);
+
+  if (!g_file_set_contents ("/run/luma-display/home-ready", "ready\n", -1, &error))
+    g_warning ("Failed to publish complete Home frame: %s", error->message);
+  else
+    g_message ("Luma handoff: releasing Presence (%s)", why);
+
+  notify_compositor_up_state (self, PHOSH_PRIVATE_SHELL_STATE_UP);
+}
+
+
+static gboolean
+on_luma_handoff_deadline (gpointer data)
+{
   PhoshShell *self = PHOSH_SHELL (data);
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+
+  priv->luma_deadline_id = 0;
+  /* Never strand the user on the greeter because one surface stayed quiet. */
+  g_warning ("Luma handoff: %u shell surface(s) never configured; revealing anyway",
+             priv->luma_pending_surfaces);
+  luma_publish_home_ready (self, "deadline");
+
+  return G_SOURCE_REMOVE;
+}
+
+
+static void
+on_luma_home_frame (GdkFrameClock *frame_clock, PhoshShell *self)
+{
   PhoshShellPrivate *priv;
 
   g_return_if_fail (PHOSH_IS_SHELL (self));
   priv = phosh_shell_get_instance_private (self);
 
-  notify_compositor_up_state (self, PHOSH_PRIVATE_SHELL_STATE_UP);
+  /* GDK drives this clock from wl_surface.frame callbacks, so a second cycle
+   * means the compositor has presented the first one rather than merely
+   * accepting it. */
+  if (++priv->luma_frames < 2) {
+    gdk_frame_clock_request_phase (frame_clock, GDK_FRAME_CLOCK_PHASE_PAINT);
+    return;
+  }
 
-  priv->startup_finished_id = 0;
+  luma_publish_home_ready (self, "all shell surfaces configured and presented");
 }
 
 
+static void
+luma_maybe_publish_ready (PhoshShell *self)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  GdkFrameClock *frame_clock;
+
+  if (priv->luma_pending_surfaces > 0 || priv->startup_frame_clock)
+    return;
+
+  frame_clock = gtk_widget_get_frame_clock (GTK_WIDGET (priv->home));
+  if (!GDK_IS_FRAME_CLOCK (frame_clock))
+    frame_clock = gtk_widget_get_frame_clock (GTK_WIDGET (priv->top_panel));
+  if (!GDK_IS_FRAME_CLOCK (frame_clock)) {
+    luma_publish_home_ready (self, "no frame clock available");
+    return;
+  }
+
+  priv->luma_frames = 0;
+  priv->startup_frame_clock = g_object_ref (frame_clock);
+  priv->startup_finished_id = g_signal_connect_object (frame_clock,
+                                                       "after-paint",
+                                                       G_CALLBACK (on_luma_home_frame),
+                                                       self,
+                                                       0);
+  gdk_frame_clock_request_phase (frame_clock, GDK_FRAME_CLOCK_PHASE_PAINT);
+}
+
+
+static void
+on_luma_surface_configured (PhoshLayerSurface *surface, PhoshShell *self)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+
+  g_signal_handlers_disconnect_by_func (surface, on_luma_surface_configured, self);
+  if (priv->luma_pending_surfaces > 0)
+    priv->luma_pending_surfaces--;
+
+  g_debug ("Luma handoff: shell surface configured, %u still pending",
+           priv->luma_pending_surfaces);
+  luma_maybe_publish_ready (self);
+}
+
+
+static void
+luma_await_surface (PhoshShell *self, gpointer surface)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  int configured_height = 0;
+
+  if (!PHOSH_IS_LAYER_SURFACE (surface))
+    return;
+
+  g_object_get (surface, "configured-height", &configured_height, NULL);
+  if (configured_height > 0)
+    return;
+
+  priv->luma_pending_surfaces++;
+  g_signal_connect_object (surface,
+                           "configured",
+                           G_CALLBACK (on_luma_surface_configured),
+                           self,
+                           0);
+}
+
+
+static void
+publish_startup_on_first_frame (PhoshShell *self)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  GList *backgrounds;
+
+  priv->luma_pending_surfaces = 0;
+  luma_await_surface (self, priv->top_panel);
+  luma_await_surface (self, priv->home);
+
+  backgrounds = phosh_background_manager_get_backgrounds (priv->background_manager);
+  for (GList *l = backgrounds; l; l = l->next)
+    luma_await_surface (self, l->data);
+
+  g_debug ("Luma handoff: waiting on %u shell surface(s)", priv->luma_pending_surfaces);
+  priv->luma_deadline_id = g_timeout_add (LUMA_HANDOFF_DEADLINE_MS,
+                                          on_luma_handoff_deadline,
+                                          self);
+  luma_maybe_publish_ready (self);
+}
+
+
 static gboolean
 setup_idle_cb (PhoshShell *self)
 {
@@ -935,10 +1080,10 @@
   /* Export the debug interface late so everything is up when the name appears */
   phosh_debug_control_set_exported (priv->debug_control, TRUE);
 
-  /* Delay signaling to the compositor a bit so that idle handlers get a chance to run and
-     the user can unlock right away. Ideally we'd not need this */
-  priv->startup_finished_id = g_timeout_add_seconds_once (1, on_startup_finished, self);
-  g_source_set_name_by_id (priv->startup_finished_id, "[PhoshShell] startup finished");
+  /* Keep Phoc's safety shield until GTK has rendered the complete top panel and
+   * home surface. Readiness follows a real frame instead of an arbitrary
+   * timeout, so the authenticated handoff is both atomic and immediate. */
+  publish_startup_on_first_frame (self);
 
   priv->startup_finished = TRUE;
   g_signal_emit (self, signals[READY], 0);
-- 
2.53.0
