+}
+
+
+void
+phosh_notify_manager_mark_all_seen (PhoshNotifyManager *self)
+{
+  GListModel *source_list;
+
+  g_return_if_fail (PHOSH_IS_NOTIFY_MANAGER (self));
+  source_list = G_LIST_MODEL (phosh_notify_manager_get_list (self));
+
+  for (guint i = 0; i < g_list_model_get_n_items (source_list); i++) {
+    g_autoptr (GListModel) notifications =
+      G_LIST_MODEL (g_list_model_get_object (source_list, i));
+
+    for (guint j = 0; j < g_list_model_get_n_items (notifications); j++) {
+      g_autoptr (PhoshNotification) notification =
+        PHOSH_NOTIFICATION (g_list_model_get_object (notifications, j));
+      PhoshNotificationLifecycleState state =
+        phosh_notification_get_lifecycle_state (notification);
+
+      if (state == PHOSH_NOTIFICATION_LIFECYCLE_QUEUED ||
+          state == PHOSH_NOTIFICATION_LIFECYCLE_ARRIVING ||
+          state == PHOSH_NOTIFICATION_LIFECYCLE_WAITING)
+        phosh_notification_set_lifecycle_state (
+          notification, PHOSH_NOTIFICATION_LIFECYCLE_SEEN);
     }
   }
 }
