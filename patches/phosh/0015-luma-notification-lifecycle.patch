From: Project Luma <maintainers@projectluma.org>
Date: Tue, 1 Sep 2026 20:10:00 -0500
Subject: [PATCH] notifications: make the shared lifecycle explicit

Record queued, arriving, waiting, seen, acted, dismissed, expired, and replaced
as native notification state. Banner timeout now rests an ordinary record,
opening Quick Options marks unresolved records seen without removing them, and
actions/producer close paths retain the freedesktop close reason contract.

--- a/src/notifications/notification.h
+++ b/src/notifications/notification.h
@@ -36,7 +36,29 @@
   PHOSH_NOTIFICATION_REASON_UNDEFINED = 4,
 } PhoshNotificationReason;
 
+/**
+ * PhoshNotificationLifecycleState:
+ * @PHOSH_NOTIFICATION_LIFECYCLE_QUEUED: accepted and waiting for policy
+ * @PHOSH_NOTIFICATION_LIFECYCLE_ARRIVING: visible as a heads-up banner
+ * @PHOSH_NOTIFICATION_LIFECYCLE_WAITING: retained in the collection
+ * @PHOSH_NOTIFICATION_LIFECYCLE_SEEN: collection opened by the user
+ * @PHOSH_NOTIFICATION_LIFECYCLE_ACTED: an action or default target was used
+ * @PHOSH_NOTIFICATION_LIFECYCLE_DISMISSED: explicitly removed by the user
+ * @PHOSH_NOTIFICATION_LIFECYCLE_EXPIRED: withdrawn or expired by policy
+ * @PHOSH_NOTIFICATION_LIFECYCLE_REPLACED: superseded in place
+ */
+typedef enum {
+  PHOSH_NOTIFICATION_LIFECYCLE_QUEUED = 0,
+  PHOSH_NOTIFICATION_LIFECYCLE_ARRIVING,
+  PHOSH_NOTIFICATION_LIFECYCLE_WAITING,
+  PHOSH_NOTIFICATION_LIFECYCLE_SEEN,
+  PHOSH_NOTIFICATION_LIFECYCLE_ACTED,
+  PHOSH_NOTIFICATION_LIFECYCLE_DISMISSED,
+  PHOSH_NOTIFICATION_LIFECYCLE_EXPIRED,
+  PHOSH_NOTIFICATION_LIFECYCLE_REPLACED,
+} PhoshNotificationLifecycleState;
 
+
 #define PHOSH_NOTIFICATION_DEFAULT_ACTION "default"
 #define PHOSH_NOTIFICATION_DEFAULT_TIMEOUT 5000 /* ms */
 
@@ -102,6 +124,9 @@
 void                      phosh_notification_set_urgency   (PhoshNotification        *self,
                                                             PhoshNotificationUrgency  urgency);
 PhoshNotificationUrgency  phosh_notification_get_urgency   (PhoshNotification        *self);
+void                      phosh_notification_set_lifecycle_state (PhoshNotification   *self,
+                                                                  PhoshNotificationLifecycleState state);
+PhoshNotificationLifecycleState phosh_notification_get_lifecycle_state (PhoshNotification *self);
 void                      phosh_notification_set_actions   (PhoshNotification        *self,
                                                             GStrv                     actions);
 GStrv                     phosh_notification_get_actions   (PhoshNotification        *self);
