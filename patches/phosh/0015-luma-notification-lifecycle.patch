@@ -819,6 +835,38 @@
   priv = phosh_notification_get_instance_private (self);
 
   return priv->urgency;
+}
+
+
+void
+phosh_notification_set_lifecycle_state (PhoshNotification               *self,
+                                        PhoshNotificationLifecycleState  state)
+{
+  PhoshNotificationPrivate *priv;
+
+  g_return_if_fail (PHOSH_IS_NOTIFICATION (self));
+  g_return_if_fail (state >= PHOSH_NOTIFICATION_LIFECYCLE_QUEUED &&
+                    state <= PHOSH_NOTIFICATION_LIFECYCLE_REPLACED);
+  priv = phosh_notification_get_instance_private (self);
+
+  if (priv->lifecycle_state == state)
+    return;
+
+  priv->lifecycle_state = state;
+  g_object_notify_by_pspec (G_OBJECT (self), props[PROP_LIFECYCLE_STATE]);
+}
+
+
+PhoshNotificationLifecycleState
+phosh_notification_get_lifecycle_state (PhoshNotification *self)
+{
+  PhoshNotificationPrivate *priv;
+
+  g_return_val_if_fail (PHOSH_IS_NOTIFICATION (self),
+                        PHOSH_NOTIFICATION_LIFECYCLE_QUEUED);
+  priv = phosh_notification_get_instance_private (self);
+
+  return priv->lifecycle_state;
 }
 
 /**
