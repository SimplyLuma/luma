+/* Align the cards with the artwork centered in the outer Home grid cells.
+ * Keep the card-to-card spacing independent of these responsive gutters. */
+static gboolean
+update_home_widget_gutters (gpointer data)
+{
+  PhoshAppGrid *self = PHOSH_APP_GRID (data);
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+  GtkWidget *grid = priv->favs;
+  GtkAllocation allocation;
+
+  priv->widget_gutters_pending = FALSE;
+  if (!gtk_widget_get_mapped (GTK_WIDGET (self)))
+    return G_SOURCE_REMOVE;
+  gtk_widget_get_allocation (grid, &allocation);
+  int columns = gtk_flow_box_get_max_children_per_line (GTK_FLOW_BOX (grid));
+  int inset = MAX (0, (allocation.width / columns - HOME_ICON_SIZE) / 2);
+  int start = gtk_widget_get_margin_start (grid) + inset;
+  int end = gtk_widget_get_margin_end (grid) + inset;
+
+  if (gtk_widget_get_margin_start (priv->today_slot) != start)
+    gtk_widget_set_margin_start (priv->today_slot, start);
+  if (gtk_widget_get_margin_end (priv->today_slot) != end)
+    gtk_widget_set_margin_end (priv->today_slot, end);
+  return G_SOURCE_REMOVE;
+}
+
+
+static void
+on_home_grid_allocated (GtkWidget *grid, GtkAllocation *allocation, PhoshAppGrid *self)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+
+  if (priv->widget_gutters_pending)
+    return;
+  /* The parent is allocating siblings now; apply margins after this cycle. */
+  priv->widget_gutters_pending = TRUE;
+  g_idle_add_full (G_PRIORITY_DEFAULT_IDLE, update_home_widget_gutters,
+                   g_object_ref (self), g_object_unref);
+}
