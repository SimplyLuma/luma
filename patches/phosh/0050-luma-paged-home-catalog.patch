+  g_print("PASS live registration and filters: GUI included; hidden/helper/CLI/Search/other-desktop excluded\n");
+  before=changes;g_autofree char *real=g_build_filename(apps,"real.desktop",NULL);g_assert_cmpint(g_remove(real),==,0);
+  wait_change(before);g_assert_cmpuint(count_visible(),==,0);
+  g_print("PASS live removal invalidates catalog\n");
+  for(guint i=1;i<G_N_ELEMENTS(ids);i++){g_autofree char *path=g_build_filename(apps,ids[i],NULL);g_remove(path);}
+  g_rmdir(apps);g_rmdir(root);return 0;
