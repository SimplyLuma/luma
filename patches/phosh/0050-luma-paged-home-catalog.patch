+}
+static void wait_change(guint before) {
+  gint64 end=g_get_monotonic_time()+5000000;
+  while(changes<=before && g_get_monotonic_time()<end){while(g_main_context_pending(NULL))g_main_context_iteration(NULL,FALSE);g_usleep(1000);}
+  g_assert_cmpuint(changes,>,before);
+}
+int main(void) {
+  g_autofree char *root=g_dir_make_tmp("luma-home-catalog-XXXXXX",NULL);
+  g_autofree char *apps=g_build_filename(root,"applications",NULL);
+  g_mkdir_with_parents(apps,0700);
+  g_setenv("XDG_DATA_HOME",root,TRUE);g_setenv("XDG_DATA_DIRS","/nonexistent",TRUE);
+  g_setenv("XDG_CURRENT_DESKTOP","Luma",TRUE);
+  GAppInfoMonitor *monitor=g_app_info_monitor_get();g_signal_connect(monitor,"changed",G_CALLBACK(changed),NULL);
+  g_assert_cmpuint(count_visible(),==,0);
+  const char *ids[]={"real.desktop","helper.desktop","cli.desktop","org.projectluma.SearchSettings.desktop","hidden.desktop","wrong-desktop.desktop"};
+  const char *extras[]={"","NoDisplay=true\n","Terminal=true\n","","Hidden=true\n","OnlyShowIn=OtherDesktop;\n"};
+  guint before=changes;
+  for(guint i=0;i<G_N_ELEMENTS(ids);i++){
+    g_autofree char *path=g_build_filename(apps,ids[i],NULL);
+    g_autofree char *text=g_strdup_printf("[Desktop Entry]\nType=Application\nName=Test App\nExec=/bin/true\n%s",extras[i]);
+    g_assert_true(g_file_set_contents(path,text,-1,NULL));
+    g_autoptr(GDesktopAppInfo) app=g_desktop_app_info_new_from_filename(path);
+    g_assert_nonnull(app);g_print("filter %s id=%s result=%d\n",ids[i],g_app_info_get_id(G_APP_INFO(app)),phosh_home_app_should_show(G_APP_INFO(app)));g_assert_cmpint(phosh_home_app_should_show(G_APP_INFO(app)),==,i==0);
+  }
