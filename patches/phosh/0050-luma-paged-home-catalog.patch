+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "luma-home-pages.h"
+#include <handy.h>
+#include <math.h>
+#include <glib/gi18n.h>
+#include <gio/gdesktopappinfo.h>
+
+gboolean
+phosh_home_app_should_show (GAppInfo *info)
+{
+  if (!G_IS_DESKTOP_APP_INFO (info) || !g_app_info_should_show (info) ||
+      g_desktop_app_info_get_is_hidden (G_DESKTOP_APP_INFO (info)))
+    return FALSE;
+  /* Search settings has a launcher for desktop discovery, but belongs to
+   * Settings and the dock Search action on Mobile. CLI launchers stay out. */
+  return g_strcmp0 (g_app_info_get_id (info), "org.projectluma.SearchSettings.desktop") != 0 &&
+    !g_desktop_app_info_get_boolean (G_DESKTOP_APP_INFO (info), "Terminal");
+}
+
+typedef struct {
+  GtkContainer parent;
+  HdyCarousel *carousel;
+  GtkWidget *dots;
+  GtkWidget *indicator;
+  GtkWidget *today;
+  GListModel *model;
+  GtkFlowBoxCreateWidgetFunc factory;
+  gpointer factory_data;
+  guint idle;
+  guint columns, first_capacity, capacity;
+  gboolean widgets_scroll;
+  int last_width, last_height;
+  gboolean dirty, stopped;
+} PhoshHomePages;
+typedef GtkContainerClass PhoshHomePagesClass;
+G_DEFINE_TYPE (PhoshHomePages, phosh_home_pages, GTK_TYPE_CONTAINER)
+
+static void queue_layout (PhoshHomePages *self);
+
+static void
+update_dots (PhoshHomePages *self)
+{
+  if (self->stopped) return;
+  guint selected = (guint) floor (hdy_carousel_get_position (self->carousel) + .5);
+  GList *children = gtk_container_get_children (GTK_CONTAINER (self->dots));
+  guint index = 0;
+
+  for (GList *p = children; p; p = p->next, index++) {
+    GtkStyleContext *style = gtk_widget_get_style_context (p->data);
+    if (index == selected) gtk_style_context_add_class (style, "selected");
+    else gtk_style_context_remove_class (style, "selected");
+    atk_object_set_description (gtk_widget_get_accessible (p->data),
+                                 index == selected ? _("Current page") : _("Go to page"));
+  }
+  g_list_free (children);
+  g_autofree char *name = g_strdup_printf (_("Home page %u of %u"), selected + 1,
+                                          hdy_carousel_get_n_pages (self->carousel));
+  atk_object_set_name (gtk_widget_get_accessible (GTK_WIDGET (self->carousel)), name);
+}
+
+static void
+position_changed (HdyCarousel *carousel, GParamSpec *pspec, PhoshHomePages *self)
+{
+  update_dots (self);
+}
+
+static void
+dot_clicked (GtkButton *button, PhoshHomePages *self)
+{
+  guint index = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (button), "page"));
+  GList *pages = gtk_container_get_children (GTK_CONTAINER (self->carousel));
+  GtkWidget *page = g_list_nth_data (pages, index);
+  if (page) hdy_carousel_scroll_to (self->carousel, page);
+  g_list_free (pages);
+}
+
+static GtkWidget *
+new_grid (guint columns)
+{
+  GtkWidget *grid = gtk_flow_box_new ();
+  gtk_flow_box_set_homogeneous (GTK_FLOW_BOX (grid), TRUE);
+  gtk_flow_box_set_min_children_per_line (GTK_FLOW_BOX (grid), columns);
+  gtk_flow_box_set_max_children_per_line (GTK_FLOW_BOX (grid), columns);
+  gtk_flow_box_set_selection_mode (GTK_FLOW_BOX (grid), GTK_SELECTION_NONE);
+  gtk_flow_box_set_activate_on_single_click (GTK_FLOW_BOX (grid), FALSE);
+  gtk_flow_box_set_row_spacing (GTK_FLOW_BOX (grid), 18);
+  gtk_widget_set_margin_start (grid, 18);
+  gtk_widget_set_margin_end (grid, 18);
+  gtk_widget_set_margin_top (grid, 18);
+  gtk_widget_set_margin_bottom (grid, 12);
+  gtk_widget_set_valign (grid, GTK_ALIGN_START);
+  gtk_widget_set_hexpand (grid, TRUE);
+  gtk_style_context_add_class (gtk_widget_get_style_context (grid), "luma-home-grid");
+  return grid;
+}
+
+static void
+clear_container (GtkContainer *container)
+{
+  GList *children = gtk_container_get_children (container);
+  for (GList *p = children; p; p = p->next) gtk_widget_destroy (p->data);
+  g_list_free (children);
+}
+
+static gboolean
+layout_pages (gpointer data)
+{
+  PhoshHomePages *self = data;
+  GtkWidget *carousel = GTK_WIDGET (self->carousel);
+  int width = gtk_widget_get_allocated_width (carousel);
+  int height = gtk_widget_get_allocated_height (carousel);
+  int today_min, today_height, tile_min = 0, tile_height = 80;
+  int tile_width_min = 68, tile_width = 68;
+  guint columns, first_capacity, capacity;
+  gboolean widgets_scroll;
+  guint count = g_list_model_get_n_items (self->model);
+  self->idle = 0;
+  if (self->stopped || width < 100 || height < 100) return G_SOURCE_REMOVE;
+  if (!self->dirty && width == self->last_width && height == self->last_height)
+    return G_SOURCE_REMOVE;
+  self->last_width = width;
+  self->last_height = height;
+
+  columns = MAX (1, (width - 36) / (tile_width + 18));
+  gtk_widget_get_preferred_height_for_width (self->today, width, &today_min, &today_height);
+  if (count) {
+    g_autoptr (GObject) item = g_list_model_get_item (self->model, 0);
+    GtkWidget *sample = self->factory (item, self->factory_data);
+    GtkWidget *grid = new_grid (1);
+    g_object_ref_sink (grid);
+    gtk_container_add (GTK_CONTAINER (grid), sample);
+    gtk_widget_show_all (grid);
+    gtk_widget_get_preferred_width (sample, &tile_width_min, &tile_width);
+    columns = MAX (1, (width - 36) / (MAX (tile_width_min, tile_width) + 18));
+    gtk_widget_get_preferred_height_for_width (sample, (width - 36) / columns,
+                                              &tile_min, &tile_height);
+    tile_height = MAX (80, MAX (tile_min, tile_height));
+    gtk_widget_destroy (grid);
+    g_object_unref (grid);
+  }
+  /* Include the top/bottom grid margins and inter-row spacing. */
+  capacity = MAX (1, (height - 12) / (tile_height + 18)) * columns;
+  first_capacity = MAX (0, (height - today_height - 12) / (tile_height + 18)) * columns;
+  widgets_scroll = today_height > height;
+  if (!self->dirty && columns == self->columns && capacity == self->capacity &&
+      first_capacity == self->first_capacity && widgets_scroll == self->widgets_scroll) return G_SOURCE_REMOVE;
+  self->dirty = FALSE;
+  self->columns = columns;
+  self->capacity = capacity;
+  self->first_capacity = first_capacity;
+  self->widgets_scroll = widgets_scroll;
+
+  guint selected = (guint) floor (hdy_carousel_get_position (self->carousel) + .5);
+  GtkWidget *parent = gtk_widget_get_parent (self->today);
+  if (parent) gtk_container_remove (GTK_CONTAINER (parent), self->today);
+  clear_container (GTK_CONTAINER (self->carousel));
+  clear_container (GTK_CONTAINER (self->dots));
+
+  guint offset = 0, page_number = 0;
+  do {
+    GtkWidget *page = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+    gtk_widget_set_hexpand (page, TRUE);
+    GtkWidget *grid = new_grid (columns);
+    guint page_capacity = page_number == 0 ? first_capacity : capacity;
+    if (page_number == 0) {
+      int gutter = 18 + MAX (0, ((width - 36) / (int) columns - 58) / 2);
+      gtk_widget_set_margin_start (self->today, gutter);
+      gtk_widget_set_margin_end (self->today, gutter);
+      if (widgets_scroll) {
+        GtkWidget *scroller = gtk_scrolled_window_new (NULL, NULL);
+        gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scroller),
+                                         GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+        gtk_container_add (GTK_CONTAINER (scroller), self->today);
+        gtk_box_pack_start (GTK_BOX (page), scroller, TRUE, TRUE, 0);
+      } else {
+        gtk_box_pack_start (GTK_BOX (page), self->today, FALSE, FALSE, 0);
+      }
+    } else gtk_widget_set_margin_top (grid, 16);
+    for (guint i = 0; i < page_capacity && offset < count; i++, offset++) {
+      g_autoptr (GObject) item = g_list_model_get_item (self->model, offset);
+      gtk_container_add (GTK_CONTAINER (grid), self->factory (item, self->factory_data));
+    }
+    if (page_capacity)
+      gtk_box_pack_start (GTK_BOX (page), grid, FALSE, FALSE, 0);
+    else
+      gtk_widget_destroy (grid);
+    gtk_widget_show_all (page);
+    hdy_carousel_insert (self->carousel, page, -1);
+
+    GtkWidget *dot = gtk_button_new ();
+    GtkWidget *circle = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+    gtk_widget_set_size_request (circle, 6, 6);
+    gtk_widget_set_halign (circle, GTK_ALIGN_CENTER);
+    gtk_widget_set_valign (circle, GTK_ALIGN_CENTER);
+    gtk_style_context_add_class (gtk_widget_get_style_context (circle), "luma-page-dot");
+    gtk_style_context_add_class (gtk_widget_get_style_context (dot), "luma-page-button");
+    gtk_container_add (GTK_CONTAINER (dot), circle);
+    g_object_set_data (G_OBJECT (dot), "page", GUINT_TO_POINTER (page_number));
+    g_signal_connect (dot, "clicked", G_CALLBACK (dot_clicked), self);
+    g_autofree char *label = g_strdup_printf (_("Home page %u"), page_number + 1);
+    atk_object_set_name (gtk_widget_get_accessible (dot), label);
+    gtk_widget_set_tooltip_text (dot, label);
+    gtk_box_pack_start (GTK_BOX (self->dots), dot, FALSE, FALSE, 0);
+    gtk_widget_show_all (dot);
+    page_number++;
+  } while (offset < count);
+
+  GList *pages = gtk_container_get_children (GTK_CONTAINER (self->carousel));
+  hdy_carousel_scroll_to_full (self->carousel,
+    g_list_nth_data (pages, MIN (selected, page_number - 1)), 0);
+  g_list_free (pages);
+  gtk_widget_show_all (self->dots);
+  gtk_widget_set_visible (self->dots, page_number > 1);
+  update_dots (self);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+queue_layout (PhoshHomePages *self)
+{
+  if (!self->stopped && !self->idle)
+    self->idle = g_idle_add_full (G_PRIORITY_DEFAULT_IDLE, layout_pages,
+                                 g_object_ref (self), g_object_unref);
+}
+
+static void
+allocated (GtkWidget *widget, GtkAllocation *allocation, PhoshHomePages *self)
+{
+  queue_layout (self);
+}
+
+static void
+items_changed (GListModel *model, guint position, guint removed, guint added,
+               PhoshHomePages *self)
+{
+  self->dirty = TRUE;
+  queue_layout (self);
+}
+
+static void
+preferred_height (GtkWidget *widget, int *minimum, int *natural)
+{
+  *minimum = 0;
+  *natural = 600;
+}
+
+static void
+preferred_height_for_width (GtkWidget *widget, int width, int *minimum, int *natural)
+{
+  preferred_height (widget, minimum, natural);
+}
+
+static void
+preferred_width (GtkWidget *widget, int *minimum, int *natural)
+{
+  *minimum = 0;
+  *natural = 427;
+}
+
+static GtkSizeRequestMode
+request_mode (GtkWidget *widget)
+{
+  return GTK_SIZE_REQUEST_CONSTANT_SIZE;
+}
+
+static void
+size_allocate (GtkWidget *widget, GtkAllocation *allocation)
+{
+  PhoshHomePages *self = (PhoshHomePages *) widget;
+  gtk_widget_set_allocation (widget, allocation);
+  /* Allocate the viewport independently of the pages it contains. */
+  GtkAllocation viewport = *allocation;
+  viewport.height = MAX (1, allocation->height - 44);
+  gtk_widget_size_allocate (GTK_WIDGET (self->carousel), &viewport);
+  GtkAllocation indicator = *allocation;
+  indicator.y += viewport.height;
+  indicator.height = MIN (44, allocation->height);
+  gtk_widget_size_allocate (self->indicator, &indicator);
+}
+
+static void
+preferred_height_and_baseline (GtkWidget *widget, int width, int *minimum,
+                                int *natural, int *minimum_baseline, int *natural_baseline)
+{
+  preferred_height (widget, minimum, natural);
+  if (minimum_baseline) *minimum_baseline = -1;
+  if (natural_baseline) *natural_baseline = -1;
+}
+
+static void
+destroy (GtkWidget *widget)
+{
+  PhoshHomePages *self = (PhoshHomePages *) widget;
+  self->stopped = TRUE;
+  g_clear_handle_id (&self->idle, g_source_remove);
+  if (self->model) g_signal_handlers_disconnect_by_data (self->model, self);
+  GTK_WIDGET_CLASS (phosh_home_pages_parent_class)->destroy (widget);
+}
+
+static void
+dispose (GObject *object)
+{
+  PhoshHomePages *self = (PhoshHomePages *) object;
+  g_clear_object (&self->model);
+  g_clear_object (&self->today);
+  G_OBJECT_CLASS (phosh_home_pages_parent_class)->dispose (object);
+}
+
+static void
+forall (GtkContainer *container, gboolean internals, GtkCallback callback, gpointer data)
+{
+  PhoshHomePages *self = (PhoshHomePages *) container;
+  if (self->carousel) callback (GTK_WIDGET (self->carousel), data);
+  if (self->indicator) callback (self->indicator, data);
+}
+
+static void
+remove_child (GtkContainer *container, GtkWidget *child)
+{
+  PhoshHomePages *self = (PhoshHomePages *) container;
+  if (child == GTK_WIDGET (self->carousel)) self->carousel = NULL;
+  else if (child == self->indicator) self->indicator = NULL;
+  else return;
+  gtk_widget_unparent (child);
+}
+
+static void
+style_updated (GtkWidget *widget)
+{
+  PhoshHomePages *self = (PhoshHomePages *) widget;
+  GTK_WIDGET_CLASS (phosh_home_pages_parent_class)->style_updated (widget);
+  self->dirty = TRUE;
+  queue_layout (self);
+}
+
+static gboolean
+key_press (GtkWidget *widget, GdkEventKey *event)
+{
+  PhoshHomePages *self = (PhoshHomePages *) widget;
+  if (event->keyval == GDK_KEY_Page_Down || event->keyval == GDK_KEY_Page_Up) {
+    GList *pages = gtk_container_get_children (GTK_CONTAINER (self->carousel));
+    int count = g_list_length (pages);
+    int selected = (int) floor (hdy_carousel_get_position (self->carousel) + .5);
+    int next = CLAMP (selected + (event->keyval == GDK_KEY_Page_Down ? 1 : -1), 0, count - 1);
+    if (count > 1) hdy_carousel_scroll_to (self->carousel, g_list_nth_data (pages, next));
+    g_list_free (pages);
+    return count > 1;
+  }
+  return GTK_WIDGET_CLASS (phosh_home_pages_parent_class)->key_press_event (widget, event);
+}
+
+static void
+phosh_home_pages_class_init (PhoshHomePagesClass *klass)
+{
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+  G_OBJECT_CLASS (klass)->dispose = dispose;
+  GTK_CONTAINER_CLASS (klass)->forall = forall;
+  GTK_CONTAINER_CLASS (klass)->remove = remove_child;
+  widget_class->style_updated = style_updated;
+  widget_class->key_press_event = key_press;
+  widget_class->destroy = destroy;
+  widget_class->get_preferred_height = preferred_height;
+  widget_class->get_preferred_height_for_width = preferred_height_for_width;
+  widget_class->get_preferred_width = preferred_width;
+  widget_class->get_request_mode = request_mode;
+  widget_class->size_allocate = size_allocate;
+  widget_class->get_preferred_height_and_baseline_for_width = preferred_height_and_baseline;
+}
+
+static void
+phosh_home_pages_init (PhoshHomePages *self)
+{
+  GtkWidget *indicator = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  self->indicator = indicator;
+  gtk_widget_set_has_window (GTK_WIDGET (self), FALSE);
+  self->carousel = HDY_CAROUSEL (hdy_carousel_new ());
+  hdy_carousel_set_allow_mouse_drag (self->carousel, TRUE);
+  hdy_carousel_set_animation_duration (self->carousel, 240);
+  hdy_carousel_set_reveal_duration (self->carousel, 0);
+  gtk_widget_set_parent (GTK_WIDGET (self->carousel), GTK_WIDGET (self));
+  self->dots = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_set_halign (self->dots, GTK_ALIGN_CENTER);
+  gtk_widget_set_no_show_all (self->dots, TRUE);
+  gtk_widget_set_size_request (indicator, -1, 44);
+  gtk_box_pack_start (GTK_BOX (indicator), self->dots, TRUE, FALSE, 0);
+  gtk_widget_set_parent (indicator, GTK_WIDGET (self));
+  gtk_widget_show (indicator);
+  gtk_widget_show (GTK_WIDGET (self->carousel));
+  g_signal_connect (self->carousel, "size-allocate", G_CALLBACK (allocated), self);
+  g_signal_connect (self->carousel, "notify::position", G_CALLBACK (position_changed), self);
+}
