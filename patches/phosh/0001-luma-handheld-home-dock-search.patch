diff --git a/src/app-grid-icon.c b/src/app-grid-icon.c
new file mode 100644
index 0000000..f7de6db
--- /dev/null
+++ b/src/app-grid-icon.c
@@ -0,0 +1,200 @@
+/*
+ * Copyright © 2026 Project Luma
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#define G_LOG_DOMAIN "phosh-app-grid-icon"
+
+#include "app-grid-icon.h"
+
+#define LUMA_ICON_SIZE 58
+#define LUMA_ICON_RADIUS 13.5
+
+struct _PhoshAppGridIcon {
+  GtkDrawingArea parent_instance;
+
+  GIcon *icon;
+  GdkPixbuf *pixbuf;
+  int pixbuf_scale;
+};
+
+G_DEFINE_TYPE (PhoshAppGridIcon, phosh_app_grid_icon, GTK_TYPE_DRAWING_AREA)
+
+static void
+rounded_rectangle (cairo_t *cr, double x, double y, double width, double height, double radius)
+{
+  const double degrees = G_PI / 180.0;
+
+  cairo_new_sub_path (cr);
+  cairo_arc (cr, x + width - radius, y + radius, radius, -90 * degrees, 0 * degrees);
+  cairo_arc (cr, x + width - radius, y + height - radius, radius, 0 * degrees, 90 * degrees);
+  cairo_arc (cr, x + radius, y + height - radius, radius, 90 * degrees, 180 * degrees);
+  cairo_arc (cr, x + radius, y + radius, radius, 180 * degrees, 270 * degrees);
+  cairo_close_path (cr);
+}
+
+static void
+clear_pixbuf (PhoshAppGridIcon *self)
+{
+  g_clear_object (&self->pixbuf);
+  self->pixbuf_scale = 0;
+}
+
+static void
+ensure_pixbuf (PhoshAppGridIcon *self)
+{
+  GtkIconTheme *theme;
+  GtkIconInfo *info;
+  g_autoptr (GError) error = NULL;
+  int scale;
+
+  if (self->icon == NULL)
+    return;
+
+  scale = MAX (1, gtk_widget_get_scale_factor (GTK_WIDGET (self)));
+  if (self->pixbuf != NULL && self->pixbuf_scale == scale)
+    return;
+
+  clear_pixbuf (self);
+  theme = gtk_icon_theme_get_for_screen (gtk_widget_get_screen (GTK_WIDGET (self)));
+  info = gtk_icon_theme_lookup_by_gicon (theme,
+                                         self->icon,
+                                         LUMA_ICON_SIZE * scale,
+                                         GTK_ICON_LOOKUP_FORCE_SIZE);
+  if (info == NULL)
+    return;
+
+  self->pixbuf = gtk_icon_info_load_icon (info, &error);
+  g_object_unref (info);
+  if (self->pixbuf == NULL) {
+    g_debug ("Unable to load launcher icon: %s", error->message);
+    return;
+  }
+
+  self->pixbuf_scale = scale;
+}
+
+static gboolean
+pixbuf_needs_canvas (GdkPixbuf *pixbuf)
+{
+  const guchar *pixels;
+  int width, height, stride, channels;
+  int min_x, min_y, max_x = -1, max_y = -1;
+
+  if (!gdk_pixbuf_get_has_alpha (pixbuf))
+    return FALSE;
+
+  width = gdk_pixbuf_get_width (pixbuf);
+  height = gdk_pixbuf_get_height (pixbuf);
+  stride = gdk_pixbuf_get_rowstride (pixbuf);
+  channels = gdk_pixbuf_get_n_channels (pixbuf);
+  pixels = gdk_pixbuf_get_pixels (pixbuf);
+  min_x = width;
+  min_y = height;
+
+  for (int y = 0; y < height; y++) {
+    for (int x = 0; x < width; x++) {
+      if (pixels[y * stride + x * channels + channels - 1] <= 16)
+        continue;
+      min_x = MIN (min_x, x);
+      min_y = MIN (min_y, y);
+      max_x = MAX (max_x, x);
+      max_y = MAX (max_y, y);
+    }
+  }
+
+  if (max_x < 0 || max_y < 0)
+    return TRUE;
+
+  return (max_x - min_x + 1) < width * 0.78 ||
+         (max_y - min_y + 1) < height * 0.78;
+}
+
+static gboolean
+phosh_app_grid_icon_draw (GtkWidget *widget, cairo_t *cr)
+{
+  PhoshAppGridIcon *self = PHOSH_APP_GRID_ICON (widget);
+  GtkAllocation allocation;
+  cairo_pattern_t *gradient;
+  double x, y;
+  int scale;
+
+  gtk_widget_get_allocation (widget, &allocation);
+  x = (allocation.width - LUMA_ICON_SIZE) / 2.0;
+  y = (allocation.height - LUMA_ICON_SIZE) / 2.0;
+  ensure_pixbuf (self);
+
+  /* A bounded, deliberately subtle shadow gives every launcher the same
+   * physical depth without modifying application-owned artwork. */
+  rounded_rectangle (cr, x + 0.5, y + 2.5, LUMA_ICON_SIZE - 1, LUMA_ICON_SIZE - 1,
+                     LUMA_ICON_RADIUS);
+  cairo_set_source_rgba (cr, 0.0, 0.0, 0.0, 0.31);
+  cairo_fill (cr);
+
+  cairo_save (cr);
+  rounded_rectangle (cr, x, y, LUMA_ICON_SIZE, LUMA_ICON_SIZE, LUMA_ICON_RADIUS);
+  cairo_clip (cr);
+
+  /* Only small, logo-like artwork receives a Prairie canvas. Authored
+   * full-size icons keep their own transparent rounded corners. */
+  if (self->pixbuf == NULL || pixbuf_needs_canvas (self->pixbuf)) {
+    gradient = cairo_pattern_create_linear (x, y, x + LUMA_ICON_SIZE, y + LUMA_ICON_SIZE);
+    cairo_pattern_add_color_stop_rgb (gradient, 0.0, 0.38, 0.58, 0.88);
+    cairo_pattern_add_color_stop_rgb (gradient, 1.0, 0.20, 0.31, 0.66);
+    cairo_set_source (cr, gradient);
+    cairo_paint (cr);
+    cairo_pattern_destroy (gradient);
+  }
+
+  if (self->pixbuf != NULL) {
+    scale = MAX (1, self->pixbuf_scale);
+    cairo_save (cr);
+    cairo_translate (cr, x, y);
+    cairo_scale (cr, 1.0 / scale, 1.0 / scale);
+    gdk_cairo_set_source_pixbuf (cr, self->pixbuf, 0, 0);
+    cairo_paint (cr);
+    cairo_restore (cr);
+  }
+  cairo_restore (cr);
+
+  return GDK_EVENT_STOP;
+}
+
+static void
+phosh_app_grid_icon_finalize (GObject *object)
+{
+  PhoshAppGridIcon *self = PHOSH_APP_GRID_ICON (object);
+
+  g_clear_object (&self->icon);
+  clear_pixbuf (self);
+  G_OBJECT_CLASS (phosh_app_grid_icon_parent_class)->finalize (object);
+}
+
+static void
+phosh_app_grid_icon_class_init (PhoshAppGridIconClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->finalize = phosh_app_grid_icon_finalize;
+  widget_class->draw = phosh_app_grid_icon_draw;
+  gtk_widget_class_set_css_name (widget_class, "phosh-app-grid-icon");
+}
+
+static void
+phosh_app_grid_icon_init (PhoshAppGridIcon *self)
+{
+  gtk_widget_set_size_request (GTK_WIDGET (self), LUMA_ICON_SIZE, LUMA_ICON_SIZE);
+}
+
+void
+phosh_app_grid_icon_set_gicon (PhoshAppGridIcon *self, GIcon *icon)
+{
+  g_return_if_fail (PHOSH_IS_APP_GRID_ICON (self));
+  g_return_if_fail (icon == NULL || G_IS_ICON (icon));
+
+  if (g_set_object (&self->icon, icon)) {
+    clear_pixbuf (self);
+    gtk_widget_queue_draw (GTK_WIDGET (self));
+  }
+}
