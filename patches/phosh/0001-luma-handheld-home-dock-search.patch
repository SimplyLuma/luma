+static void
+on_search_swipe (PhoshAppGrid *self, double offset_x, double offset_y)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+
+  if (priv->search_mode && ABS (offset_x) > ABS (offset_y) && offset_x > 48) {
+    phosh_app_grid_reset (self);
+    return;
+  }
+
+  if (ABS (offset_y) <= ABS (offset_x))
+    return;
+
+  if (priv->search_mode && offset_y < -48) {
+    phosh_app_grid_reset (self);
+    return;
+  }
+
+  if (!priv->search_mode && offset_y > 72)
+    phosh_app_grid_focus_search (self);
+}
