+static void
+on_search_background_released (PhoshAppGrid        *self,
+                               int                  n_press,
+                               double               x,
+                               double               y,
+                               GtkGestureMultiPress *gesture)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+  const GdkEvent *event;
+  GtkWidget *event_widget;
+
+  if (!priv->search_mode || n_press != 1)
+    return;
+
+  event = gtk_gesture_get_last_event (GTK_GESTURE (gesture), NULL);
+  event_widget = event ? gtk_get_event_widget ((GdkEvent *) event) : NULL;
+  if (event_widget != NULL &&
+      (GTK_IS_BUTTON (event_widget) ||
+       gtk_widget_get_ancestor (event_widget, GTK_TYPE_BUTTON) != NULL ||
+       GTK_IS_FLOW_BOX_CHILD (event_widget) ||
+       gtk_widget_get_ancestor (event_widget, GTK_TYPE_FLOW_BOX_CHILD) != NULL))
+    return;
+
+  phosh_app_grid_reset (self);
+  gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_CLAIMED);
+}
