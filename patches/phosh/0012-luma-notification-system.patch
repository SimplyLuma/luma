-      !priv->locked) {
-    priv->notification_banner = phosh_notification_banner_new (notification);
-    g_signal_connect (priv->notification_banner,
-                      "destroy",
-                      G_CALLBACK (gtk_widget_destroyed),
-                      &priv->notification_banner);
-
-    gtk_widget_set_visible (GTK_WIDGET (priv->notification_banner), TRUE);
+      !priv->locked && priv->notification_banners->len < 3) {
+    GtkWidget *banner = phosh_notification_banner_new (notification);
+
+    g_ptr_array_insert (priv->notification_banners, 0, banner);
+    g_signal_connect (banner, "destroy",
+                      G_CALLBACK (on_notification_banner_destroyed), self);
+    for (guint i = 0; i < priv->notification_banners->len; i++)
+      phosh_notification_banner_set_stack_position (
+        PHOSH_NOTIFICATION_BANNER (g_ptr_array_index (priv->notification_banners, i)), i);
+    gtk_widget_set_visible (banner, TRUE);
   }
 }
 
