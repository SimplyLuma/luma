@@ -18,7 +18,11 @@
 
 #include <handy.h>
 
-#define BANNER_MIN_WIDTH 360
+#define BANNER_MIN_WIDTH 320
+#define LUMA_BANNER_TOP_INSET 54
+#define LUMA_BANNER_SIDE_INSET 12
+#define LUMA_BANNER_GAP 8
+#define LUMA_BANNER_TIMEOUT_MS 8500
 
 /**
  * PhoshNotificationBanner:
@@ -43,12 +47,17 @@ struct _PhoshNotificationBanner {
 
   gboolean slide_up;
   PhoshAnimation *animation;
+  guint timeout_id;
+  guint stack_position;
 };
 typedef struct _PhoshNotificationBanner PhoshNotificationBanner;
 
 
 G_DEFINE_TYPE (PhoshNotificationBanner, phosh_notification_banner, PHOSH_TYPE_LAYER_SURFACE)
 
+static void phosh_notification_banner_slide (double value, gpointer user_data);
+static void phosh_notification_banner_slide_done (gpointer user_data);
+
 
 static void
 clear_handler (PhoshNotificationBanner *self)
@@ -57,17 +66,76 @@ clear_handler (PhoshNotificationBanner *self)
   g_clear_signal_handler (&self->handler_closed, self->notification);
 }
 
+static gboolean
+luma_banner_timeout (PhoshNotificationBanner *self)
+{
+  self->timeout_id = 0;
+
+  /* Resting is presentation state, not protocol expiry.  Fade only the layer
+   * surface and leave the record in PhoshNotifyManager's collection. */
+  if (gtk_widget_get_mapped (GTK_WIDGET (self))) {
+    self->slide_up = TRUE;
+    self->animation = phosh_animation_new (GTK_WIDGET (self),
+                                           0.0,
+                                           1.0,
+                                           240 * PHOSH_ANIMATION_SLOWDOWN,
+                                           PHOSH_ANIMATION_TYPE_EASE_OUT_CUBIC,
+                                           phosh_notification_banner_slide,
+                                           phosh_notification_banner_slide_done,
+                                           self);
+    phosh_animation_start (self->animation);
+  } else {
+    gtk_widget_destroy (GTK_WIDGET (self));
+  }
+  return G_SOURCE_REMOVE;
+}
+
+static void
+luma_banner_resume_timeout (PhoshNotificationBanner *self)
+{
+  if (self->timeout_id ||
+      phosh_notification_get_urgency (self->notification) == PHOSH_NOTIFICATION_URGENCY_CRITICAL)
+    return;
+
+  self->timeout_id = g_timeout_add (LUMA_BANNER_TIMEOUT_MS,
+                                    (GSourceFunc) luma_banner_timeout,
+                                    self);
+  g_source_set_name_by_id (self->timeout_id, "[Luma] notification heads-up timeout");
+}
+
+static gboolean
+luma_banner_enter (PhoshNotificationBanner *self, GdkEvent *event)
+{
+  g_clear_handle_id (&self->timeout_id, g_source_remove);
+  return GDK_EVENT_PROPAGATE;
+}
+
+static gboolean
+luma_banner_leave (PhoshNotificationBanner *self, GdkEvent *event)
+{
+  luma_banner_resume_timeout (self);
+  return GDK_EVENT_PROPAGATE;
+}
+
 
 static void
 phosh_notification_banner_slide (double value, gpointer user_data)
 {
   PhoshNotificationBanner *self = PHOSH_NOTIFICATION_BANNER (user_data);
+  double reveal = self->slide_up ? 1.0 - value : value;
   int margin, height;
 
   gtk_window_get_size (GTK_WINDOW (self), NULL, &height);
-  margin = -(height * 0.9) * (self->slide_up ? value : (1.0 - value));
+  margin = LUMA_BANNER_TOP_INSET +
+           self->stack_position * (height + LUMA_BANNER_GAP) -
+           (int) (12 * (1.0 - reveal));
 
-  phosh_layer_surface_set_margins (PHOSH_LAYER_SURFACE (self), margin, 0, 0, 0);
+  gtk_widget_set_opacity (GTK_WIDGET (self), reveal);
+  phosh_layer_surface_set_margins (PHOSH_LAYER_SURFACE (self),
+                                   margin,
+                                   LUMA_BANNER_SIDE_INSET,
+                                   0,
+                                   LUMA_BANNER_SIDE_INSET);
 
   phosh_layer_surface_wl_surface_commit (PHOSH_LAYER_SURFACE (self));
 }
@@ -191,6 +259,7 @@ phosh_notification_banner_dispose (GObject *object)
 
   clear_handler (self);
 
+  g_clear_handle_id (&self->timeout_id, g_source_remove);
   g_clear_pointer (&self->animation, phosh_animation_unref);
   g_clear_object (&self->notification);
 
