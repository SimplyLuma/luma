+void
+phosh_notification_banner_set_stack_position (PhoshNotificationBanner *self,
+                                              guint                    position)
+{
+  int height = 100;
+
+  g_return_if_fail (PHOSH_IS_NOTIFICATION_BANNER (self));
+
+  self->stack_position = position;
+  if (gtk_widget_get_mapped (GTK_WIDGET (self)))
+    gtk_window_get_size (GTK_WINDOW (self), NULL, &height);
+
+  phosh_layer_surface_set_margins (PHOSH_LAYER_SURFACE (self),
+                                   LUMA_BANNER_TOP_INSET +
+                                   position * (height + LUMA_BANNER_GAP),
+                                   LUMA_BANNER_SIDE_INSET,
+                                   0,
+                                   LUMA_BANNER_SIDE_INSET);
+}
+
 /**
  * phosh_notification_banner_get_notification
