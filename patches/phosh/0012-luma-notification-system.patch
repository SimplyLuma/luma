+static void
+clear_notification_banners (PhoshShell *self)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+
+  if (!priv->notification_banners)
+    return;
+
+  while (priv->notification_banners->len) {
+    GtkWidget *banner = g_ptr_array_steal_index (
+      priv->notification_banners, priv->notification_banners->len - 1);
+    g_signal_handlers_disconnect_by_func (banner,
+                                          on_notification_banner_destroyed,
+                                          self);
+    gtk_widget_destroy (banner);
+  }
+}
+
+
+static void
+on_notification_banner_destroyed (GtkWidget *banner, PhoshShell *self)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+
+  if (!priv->notification_banners)
+    return;
+
+  for (guint i = 0; i < priv->notification_banners->len; i++) {
+    if (g_ptr_array_index (priv->notification_banners, i) == banner) {
+      g_ptr_array_steal_index (priv->notification_banners, i);
+      break;
+    }
+  }
+  for (guint i = 0; i < priv->notification_banners->len; i++)
+    phosh_notification_banner_set_stack_position (
+      PHOSH_NOTIFICATION_BANNER (g_ptr_array_index (priv->notification_banners, i)), i);
+}
