diff --git a/src/shell.c b/src/shell.c
index f249fba..37be745 100644
--- a/src/shell.c
+++ b/src/shell.c
@@ -17,6 +17,7 @@
 #include <stdlib.h>
 #include <string.h>
 
+#include <gio/gdesktopappinfo.h>
 #include <call-ui.h>
 #include <glib-object.h>
 #include <glib-unix.h>
@@ -214,6 +215,10 @@ typedef struct {
   guint                       luma_pending_surfaces;
   guint                       luma_frames;
   guint                       luma_deadline_id;
+  GDBusConnection            *luma_surface_bus;
+  guint                       luma_surface_subscription;
+  char                       *luma_surface_app_id;
+  char                       *luma_surface;
 
   GSimpleActionGroup         *action_map;
 
@@ -337,10 +342,70 @@ has_activated_toplevel (PhoshShell *self)
 }
 
 
+static char *
+get_foreground_status_surface (PhoshShell *self,
+                               gboolean    allow_unactivated)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  guint n_toplevels;
+
+  if (!priv->toplevel_manager)
+    return NULL;
+
+  n_toplevels = phosh_toplevel_manager_get_num_toplevels (priv->toplevel_manager);
+  for (guint i = 0; i < n_toplevels; i++) {
+    PhoshToplevel *toplevel = phosh_toplevel_manager_get_toplevel (priv->toplevel_manager, i);
+    g_autoptr (GDesktopAppInfo) info = NULL;
+    g_autofree char *desktop_id = NULL;
+    g_autofree char *surface = NULL;
+    const char *app_id;
+
+    if (!phosh_toplevel_is_activated (toplevel) &&
+        (!allow_unactivated || i + 1 != n_toplevels))
+      continue;
+
+    app_id = phosh_toplevel_get_app_id (toplevel);
+    if (!app_id || !*app_id)
+      return NULL;
+
+    desktop_id = g_str_has_suffix (app_id, ".desktop")
+      ? g_strdup (app_id)
+      : g_strconcat (app_id, ".desktop", NULL);
+    info = g_desktop_app_info_new (desktop_id);
+    if (!info)
+      return NULL;
+
+    if (g_strcmp0 (priv->luma_surface_app_id, desktop_id) == 0 &&
+        (g_strcmp0 (priv->luma_surface, "deep") == 0 ||
+         g_strcmp0 (priv->luma_surface, "immersive") == 0)) {
+      g_autofree char *allowed =
+        g_desktop_app_info_get_string (info, "X-Luma-Status-Surfaces");
+      g_auto (GStrv) surfaces = g_strsplit (allowed ?: "", ";", -1);
+
+      for (guint j = 0; surfaces[j]; j++) {
+        if (g_strcmp0 (surfaces[j], priv->luma_surface) == 0)
+          return g_strdup (priv->luma_surface);
+      }
+    }
+
+    surface = g_desktop_app_info_get_string (info, "X-Luma-Status-Surface");
+    if (g_strcmp0 (surface, "deep") == 0 ||
+        g_strcmp0 (surface, "immersive") == 0)
+      return g_steal_pointer (&surface);
+
+    return NULL;
+  }
+
+  return NULL;
+}
+
+
 static void
 update_top_bar_transparency (PhoshShell *self)
 {
   PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  g_autofree char *surface = NULL;
+  guint n_toplevels;
   PhoshHomeState state;
 
   if (!priv->top_panel)
@@ -352,12 +417,81 @@ update_top_bar_transparency (PhoshShell *self)
   }
 
   state = phosh_home_get_state (PHOSH_HOME (priv->home));
+  n_toplevels = priv->toplevel_manager
+    ? phosh_toplevel_manager_get_num_toplevels (priv->toplevel_manager)
+    : 0;
+  surface = get_foreground_status_surface (
+    self,
+    state == PHOSH_HOME_STATE_FOLDED ||
+    n_toplevels == 1);
+  g_debug ("Luma status projection: state=%d toplevels=%u surface=%s",
+           state, n_toplevels, surface ?: "none");
+  phosh_top_panel_set_bar_surface (PHOSH_TOP_PANEL (priv->top_panel), surface);
+  phosh_home_set_bar_surface (PHOSH_HOME (priv->home), surface);
+
   phosh_top_panel_set_bar_transparent (PHOSH_TOP_PANEL (priv->top_panel),
                                        (state != PHOSH_HOME_STATE_FOLDED) &&
                                        !has_activated_toplevel (self));
 }
 
 
+static void
+set_luma_transient_surface (PhoshShell *self,
+                            const char *app_id,
+                            const char *surface)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  gboolean valid = app_id && *app_id &&
+    (g_strcmp0 (surface, "deep") == 0 ||
+     g_strcmp0 (surface, "immersive") == 0);
+
+  g_set_str (&priv->luma_surface_app_id, valid ? app_id : NULL);
+  g_set_str (&priv->luma_surface, valid ? surface : NULL);
+  update_top_bar_transparency (self);
+}
+
+
+static void
+on_luma_transient_surface_changed (GDBusConnection *connection,
+                                   const char      *sender_name,
+                                   const char      *object_path,
+                                   const char      *interface_name,
+                                   const char      *signal_name,
+                                   GVariant        *parameters,
+                                   gpointer         user_data)
+{
+  PhoshShell *self = PHOSH_SHELL (user_data);
+  const char *app_id;
+  const char *surface;
+
+  g_variant_get (parameters, "(&s&s)", &app_id, &surface);
+  set_luma_transient_surface (self, app_id, surface);
+}
+
+
+static void
+on_luma_transient_surface_read (GObject      *source,
+                                GAsyncResult *result,
+                                gpointer      user_data)
+{
+  PhoshShell *self = PHOSH_SHELL (user_data);
+  g_autoptr (GVariant) current = NULL;
+
+  current = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source),
+                                           result,
+                                           NULL);
+  if (current) {
+    const char *app_id;
+    const char *surface;
+
+    g_variant_get (current, "(&s&s)", &app_id, &surface);
+    set_luma_transient_surface (self, app_id, surface);
+  }
+
+  g_object_unref (self);
+}
+
+
 static void
 on_home_state_changed (PhoshShell *self, GParamSpec *pspec, PhoshHome *home)
 {
@@ -631,6 +765,15 @@ phosh_shell_dispose (GObject *object)
   g_clear_signal_handler (&priv->startup_finished_id, priv->startup_frame_clock);
   g_clear_object (&priv->startup_frame_clock);
 
+  if (priv->luma_surface_bus && priv->luma_surface_subscription) {
+    g_dbus_connection_signal_unsubscribe (priv->luma_surface_bus,
+                                          priv->luma_surface_subscription);
+    priv->luma_surface_subscription = 0;
+  }
+  g_clear_object (&priv->luma_surface_bus);
+  g_clear_pointer (&priv->luma_surface_app_id, g_free);
+  g_clear_pointer (&priv->luma_surface, g_free);
+
   panels_dispose (self);
   g_clear_pointer (&priv->faders, g_ptr_array_unref);
 
@@ -751,6 +894,8 @@ on_toplevel_added (PhoshShell *self, PhoshToplevel *toplevel, PhoshToplevelManag
   priv = phosh_shell_get_instance_private (self);
   g_signal_connect_object (toplevel, "notify::activated",
                            G_CALLBACK (on_toplevel_activated_changed), self, 0);
+  g_signal_connect_object (toplevel, "notify::app-id",
+                           G_CALLBACK (on_toplevel_activated_changed), self, 0);
   if (phosh_toplevel_manager_get_num_toplevels (toplevel_manager) == 1)
     phosh_home_set_state (PHOSH_HOME (priv->home), PHOSH_HOME_STATE_FOLDED);
   update_top_bar_transparency (self);
@@ -1371,6 +1516,38 @@ phosh_shell_constructed (GObject *object)
     g_warning ("Failed to initialize keyboard events: %s", err->message);
   }
 
+  g_clear_error (&err);
+  priv->luma_surface_bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, &err);
+  if (priv->luma_surface_bus) {
+    priv->luma_surface_subscription =
+      g_dbus_connection_signal_subscribe (
+        priv->luma_surface_bus,
+        "org.project_luma.ShellState1",
+        "org.project_luma.ShellState1",
+        "TransientSurfaceChanged",
+        "/org/project_luma/ShellState1",
+        NULL,
+        G_DBUS_SIGNAL_FLAGS_NONE,
+        on_luma_transient_surface_changed,
+        self,
+        NULL);
+    g_dbus_connection_call (
+      priv->luma_surface_bus,
+      "org.project_luma.ShellState1",
+      "/org/project_luma/ShellState1",
+      "org.project_luma.ShellState1",
+      "GetTransientSurface",
+      NULL,
+      G_VARIANT_TYPE ("(ss)"),
+      G_DBUS_CALL_FLAGS_NONE,
+      -1,
+      NULL,
+      on_luma_transient_surface_read,
+      g_object_ref (self));
+  } else {
+    g_debug ("Luma transient surface broker unavailable: %s", err->message);
+  }
+
   id = g_idle_add ((GSourceFunc) setup_idle_cb, self);
   g_source_set_name_by_id (id, "[PhoshShell] idle");
 }
diff --git a/src/stylesheet/common.css b/src/stylesheet/common.css
index ef2647d..8c5583f 100644
--- a/src/stylesheet/common.css
+++ b/src/stylesheet/common.css
@@ -15,6 +15,29 @@ phosh-top-panel-bg {
   transition: background-color 200ms ease;
 }
 
+/* Luma applications can request only these named design-system surfaces.
+ * These rules live in Phosh's application-priority sheet: placing them only
+ * in the selected GTK theme lets upstream's own provider win and exposes the
+ * compositor's black reserved region above an otherwise complete app. */
+#top-bar-bin.luma-surface-deep {
+  background: #131518;
+}
+
+#top-bar-bin.luma-surface-immersive {
+  background: #1f3536;
+}
+
+.phosh-home-bar.luma-surface-deep {
+  background: #131518;
+}
+.phosh-home-bar.luma-surface-deep #powerbar {
+  opacity: 0;
+}
+
+.phosh-home-bar.luma-surface-immersive {
+  background: #1f2a38;
+}
+
 #top-bar-bin:not(.p-solid) #top-bar label {
   text-shadow: 1px 1px 1.1px rgba(0, 0, 0, 0.3);
 }
diff --git a/src/top-panel.c b/src/top-panel.c
index 2ea2f77..1d40369 100644
--- a/src/top-panel.c
+++ b/src/top-panel.c
@@ -1220,3 +1220,17 @@ phosh_top_panel_set_bar_transparent (PhoshTopPanel *self, gboolean transparent)
 
   phosh_util_toggle_style_class (GTK_WIDGET (self->top_bar_bin), "p-solid", !transparent);
 }
