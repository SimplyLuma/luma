From f71e9cd67a90feab465bc17ac8a2f8933bba6860 Mon Sep 17 00:00:00 2001
From: Project Luma <maintainers@projectluma.org>
Date: Mon, 31 Aug 2026 21:29:30 -0500
Subject: [PATCH] shell: project foreground app status surfaces

Luma applications share the reserved status and home-bar regions with the shell. Project bounded desktop metadata and a sender-lifetime transient call-state lease onto semantic native Phosh classes.

Only surfaces declared by the foreground application are honored. Read the initial lease asynchronously so shell startup never waits for the state broker.
---
 src/home.c                |  14 +++
 src/home.h                |   1 +
 src/shell.c               | 177 ++++++++++++++++++++++++++++++++++++++
 src/stylesheet/common.css |  23 +++++
 src/top-panel.c           |  14 +++
 src/top-panel.h           |   1 +
 6 files changed, 230 insertions(+)

diff --git a/src/home.c b/src/home.c
index 6eb4248..880cab3 100644
--- a/src/home.c
+++ b/src/home.c
@@ -793,3 +793,17 @@ phosh_home_get_overview (PhoshHome *self)
 
   return PHOSH_OVERVIEW (self->overview);
 }
+
+
+void
+phosh_home_set_bar_surface (PhoshHome *self, const char *surface)
+{
+  g_return_if_fail (PHOSH_IS_HOME (self));
+
+  phosh_util_toggle_style_class (self->evbox_home_bar,
+                                 "luma-surface-deep",
+                                 g_strcmp0 (surface, "deep") == 0);
+  phosh_util_toggle_style_class (self->evbox_home_bar,
+                                 "luma-surface-immersive",
+                                 g_strcmp0 (surface, "immersive") == 0);
+}
diff --git a/src/home.h b/src/home.h
index f049a7f..babc9d8 100644
--- a/src/home.h
+++ b/src/home.h
@@ -37,3 +37,4 @@ GtkWidget     *phosh_home_new (struct zwlr_layer_shell_v1          *layer_shell,
 PhoshHomeState phosh_home_get_state (PhoshHome *self);
 void           phosh_home_set_state (PhoshHome *self, PhoshHomeState state);
 PhoshOverview *phosh_home_get_overview (PhoshHome *self);
