+
+void
+phosh_top_panel_set_bar_surface (PhoshTopPanel *self, const char *surface)
+{
+  g_return_if_fail (PHOSH_IS_TOP_PANEL (self));
+
+  phosh_util_toggle_style_class (GTK_WIDGET (self->top_bar_bin),
+                                 "luma-surface-deep",
+                                 g_strcmp0 (surface, "deep") == 0);
+  phosh_util_toggle_style_class (GTK_WIDGET (self->top_bar_bin),
+                                 "luma-surface-immersive",
+                                 g_strcmp0 (surface, "immersive") == 0);
+}
diff --git a/src/top-panel.h b/src/top-panel.h
index ce79b41..5833668 100644
--- a/src/top-panel.h
+++ b/src/top-panel.h
@@ -40,3 +40,4 @@ void               phosh_top_panel_unfold (PhoshTopPanel *self);
 PhoshTopPanelState phosh_top_panel_get_state (PhoshTopPanel *self);
 void               phosh_top_panel_set_layer (PhoshTopPanel *self, guint32 layer);
 void               phosh_top_panel_set_bar_transparent (PhoshTopPanel *self, gboolean transparent);
+void               phosh_top_panel_set_bar_surface (PhoshTopPanel *self, const char *surface);
