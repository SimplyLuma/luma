 static void
+clear_search_results (PhoshAppGrid *self)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+  GList *children = gtk_container_get_children (GTK_CONTAINER (priv->search_results));
+
+  for (GList *child = children; child; child = child->next)
+    gtk_widget_destroy (GTK_WIDGET (child->data));
+  g_list_free (children);
+}
+
+
+static const char *
+search_kind_label (const char *kind)
+{
+  if (g_strcmp0 (kind, "app") == 0) return _("App");
+  if (g_strcmp0 (kind, "setting") == 0) return _("Setting");
+  if (g_strcmp0 (kind, "file") == 0) return _("File");
+  if (g_strcmp0 (kind, "mail") == 0) return _("Mail");
+  if (g_strcmp0 (kind, "contact") == 0) return _("Contact");
+  if (g_strcmp0 (kind, "calendar") == 0) return _("Calendar");
+  if (g_strcmp0 (kind, "message") == 0) return _("Message");
+  if (g_strcmp0 (kind, "photo") == 0) return _("Photo");
+  if (g_strcmp0 (kind, "music") == 0) return _("Music");
+  if (g_strcmp0 (kind, "place") == 0) return _("Place");
+  return _("Result");
+}
+
+
+static void
+activate_search_result (GtkButton *button, PhoshAppGrid *self)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+  const char *provider_id = g_object_get_data (G_OBJECT (button), "luma-provider-id");
+  const char *result_id = g_object_get_data (G_OBJECT (button), "luma-result-id");
+  const char *query = gtk_entry_get_text (GTK_ENTRY (priv->search));
+  g_auto (GStrv) terms = g_strsplit (query, " ", -1);
+
+  if (!provider_id || !result_id || !priv->search_proxy)
+    return;
+
+  g_dbus_proxy_call (priv->search_proxy,
+                     "Activate",
+                     g_variant_new ("(ss^asu)", provider_id, result_id, terms,
+                                    gtk_get_current_event_time ()),
+                     G_DBUS_CALL_FLAGS_NONE,
+                     1000,
+                     NULL,
+                     NULL,
+                     NULL);
+  phosh_app_grid_reset (self);
+}
+
+
+typedef struct {
+  PhoshAppGrid *self;
+  guint generation;
+} SearchRequest;
+
+
+static void
+search_request_free (SearchRequest *request)
+{
+  g_object_unref (request->self);
+  g_free (request);
+}
+
+
+static void
+search_query_finished (GObject *source, GAsyncResult *result, gpointer user_data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = NULL;
+  g_autoptr (GVariant) results = NULL;
+  SearchRequest *request = user_data;
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (request->self);
+  GVariantIter iter;
+  GVariant *item;
+  guint count = 0;
+
+  reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+  if (request->generation != priv->search_generation)
+    goto out;
+
+  clear_search_results (request->self);
+  if (!reply) {
+    g_warning ("Unable to query Luma Search: %s", error->message);
+    gtk_widget_set_visible (priv->search_empty, TRUE);
+    goto out;
+  }
+
+  results = g_variant_get_child_value (reply, 0);
+  g_variant_iter_init (&iter, results);
+  while (g_variant_iter_next (&iter, "@a{sv}", &item)) {
+    const char *provider_id = NULL;
+    const char *result_id = NULL;
+    const char *kind = NULL;
+    const char *title = NULL;
+    const char *subtitle = NULL;
+    const char *snippet = NULL;
+    const char *icon_name = NULL;
+    g_autofree char *detail = NULL;
+    GtkWidget *button, *row, *labels, *label, *icon;
+
+    g_variant_lookup (item, "provider-id", "&s", &provider_id);
+    g_variant_lookup (item, "result-id", "&s", &result_id);
+    g_variant_lookup (item, "kind", "&s", &kind);
+    g_variant_lookup (item, "title", "&s", &title);
+    g_variant_lookup (item, "subtitle", "&s", &subtitle);
+    g_variant_lookup (item, "snippet", "&s", &snippet);
+    g_variant_lookup (item, "icon-name", "&s", &icon_name);
+    if (!provider_id || !result_id || !title) {
+      g_variant_unref (item);
+      continue;
+    }
+
+    button = gtk_button_new ();
+    gtk_widget_set_visible (button, TRUE);
+    gtk_style_context_add_class (gtk_widget_get_style_context (button),
+                                 "luma-search-result");
+    gtk_widget_set_tooltip_text (button, title);
+    atk_object_set_name (gtk_widget_get_accessible (button), title);
+    g_object_set_data_full (G_OBJECT (button), "luma-provider-id",
+                            g_strdup (provider_id), g_free);
+    g_object_set_data_full (G_OBJECT (button), "luma-result-id",
+                            g_strdup (result_id), g_free);
+    g_signal_connect (button, "clicked", G_CALLBACK (activate_search_result), request->self);
+
+    row = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+    gtk_widget_set_visible (row, TRUE);
+    gtk_container_set_border_width (GTK_CONTAINER (row), 10);
+    icon = gtk_image_new_from_icon_name (
+      icon_name && *icon_name ? icon_name : "edit-find-symbolic",
+      GTK_ICON_SIZE_DIALOG);
+    gtk_widget_set_visible (icon, TRUE);
+    gtk_box_pack_start (GTK_BOX (row), icon, FALSE, FALSE, 0);
+
+    labels = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+    gtk_widget_set_visible (labels, TRUE);
+    label = gtk_label_new (title);
+    gtk_widget_set_visible (label, TRUE);
+    gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+    gtk_style_context_add_class (gtk_widget_get_style_context (label),
+                                 "luma-search-result-title");
+    gtk_box_pack_start (GTK_BOX (labels), label, FALSE, FALSE, 0);
+    if (snippet && *snippet)
+      detail = g_strdup_printf ("%s · %s · %s", search_kind_label (kind),
+                                subtitle ? subtitle : "", snippet);
+    else if (subtitle && *subtitle)
+      detail = g_strdup_printf ("%s · %s", search_kind_label (kind), subtitle);
+    else
+      detail = g_strdup (search_kind_label (kind));
+    label = gtk_label_new (detail);
+    gtk_widget_set_visible (label, TRUE);
+    gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+    gtk_label_set_ellipsize (GTK_LABEL (label), PANGO_ELLIPSIZE_END);
+    gtk_style_context_add_class (gtk_widget_get_style_context (label),
+                                 "luma-search-result-subtitle");
+    gtk_box_pack_start (GTK_BOX (labels), label, FALSE, FALSE, 0);
+    gtk_box_pack_start (GTK_BOX (row), labels, TRUE, TRUE, 0);
+    gtk_container_add (GTK_CONTAINER (button), row);
+    gtk_list_box_insert (GTK_LIST_BOX (priv->search_results), button, -1);
+    count++;
+    g_variant_unref (item);
+  }
+  gtk_widget_set_visible (priv->search_empty, count == 0);
+
+out:
+  search_request_free (request);
+}
+
