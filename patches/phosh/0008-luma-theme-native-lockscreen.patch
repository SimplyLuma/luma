+/* Luma lockscreen ---------------------------------------------------------
+ *
+ * These rules live here rather than in common.css because this is the file
+ * phosh loads by name (style-manager.c picks adwaita-dark.css or
+ * adwaita-hc-light.css). Appended after the @import so nothing in the imported
+ * sheet can outrank them on cascade order.
+ *
+ * Sizes and colours are copied from the pre-session greeter's stylesheet, not
+ * approximated, so the session lock and the greeter are the same design. Do not
+ * add a rule here that selects bare labels inside the unlock page: at (0,1,1)
+ * it outranks every .luma-* class and flattens the whole page to one size.
+ */
+
+phosh-lockscreen,
+phosh-lockscreen label,
+phosh-lockscreen entry,
+phosh-lockscreen button {
+  font-family: "Figtree";
+}
+
+/* The greeter shows the same 46px clock on both of its states. Upstream phosh
+ * uses 84px here, which is what made the quiet page look oversized beside it. */
+#phosh-lockscreen-clock {
+  font-size: 46px;
+  font-weight: 500;
+  padding-top: 0;
+  margin: 0;
+  text-shadow: 0 2px 16px rgba(0, 0, 0, 0.28);
+}
+
+#phosh-lockscreen-date {
+  font-size: 13px;
+  font-weight: 600;
+  margin-top: 2px;
+  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.34);
+}
+
+.p-small #phosh-lockscreen-clock {
+  font-size: 46px;
+  font-weight: 500;
+}
+
+.p-small #phosh-lockscreen-date {
+  font-size: 13px;
+  font-weight: 600;
+}
+
+.phosh-lockscreen-arrow + label {
+  margin-bottom: 36px;
+  font-size: 13px;
+  font-weight: 600;
+  opacity: 0.82;
+  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.36);
+}
+
+.phosh-lockscreen-unlocker .luma-unlock-clock {
+  font-size: 46px;
+  font-weight: 500;
+  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.28);
+}
+
+.phosh-lockscreen-unlocker .luma-unlock-date {
+  font-size: 13px;
+  font-weight: 600;
+  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.34);
+}
+
+/* Phosh's status label becomes the greeter's feedback line: it is what reports
+ * "Checking..." and a wrong passcode, so it stays in the tree and is simply
+ * quiet until it has something to say. */
+.phosh-lockscreen-unlocker .luma-unlock-feedback {
+  font-size: 12px;
+  font-weight: 600;
+  text-shadow: 0 1px 7px rgba(0, 0, 0, 0.44);
+}
+
+/* Keypad: the greeter's dark translucent keys, not pale white ones. */
+phosh-keypad {
+  min-width: 288px;
+}
+
+phosh-keypad button {
+  min-width: 88px;
+  min-height: 64px;
+  padding: 0;
+  margin: 6px;
+  border: 1px solid rgba(255, 255, 255, 0.16);
+  border-radius: 999px;
+  background-image: none;
+  background-color: rgba(31, 37, 46, 0.42);
+  box-shadow: inset 0 1px rgba(255, 255, 255, 0.10),
+              0 3px 12px rgba(0, 0, 0, 0.16);
+}
+
+phosh-keypad button:hover {
+  background-color: rgba(48, 56, 67, 0.54);
+}
+
+phosh-keypad button:active,
+phosh-keypad button:checked {
+  background-color: rgba(255, 255, 255, 0.22);
+}
+
+phosh-keypad button:disabled {
+  opacity: 0.55;
+}
+
+phosh-keypad label.digit {
+  font-size: 26px;
+  font-weight: 500;
+  text-shadow: none;
+}
+
+phosh-keypad image {
+  -gtk-icon-shadow: none;
+}
+
+.luma-emergency {
+  min-height: 44px;
+  padding: 0 16px;
+  border: 1px solid rgba(255, 255, 255, 0.15);
+  border-radius: 999px;
+  background-image: none;
+  background-color: rgba(27, 32, 38, 0.68);
+  box-shadow: inset 0 1px rgba(255, 255, 255, 0.08),
+              0 3px 12px rgba(0, 0, 0, 0.22);
+  color: #ffffff;
+}
+
+.luma-emergency label {
+  font-size: 13px;
+  font-weight: 600;
+}
