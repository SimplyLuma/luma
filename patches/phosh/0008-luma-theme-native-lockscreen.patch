+/* Trim Unicode whitespace, not just ASCII: the clock's padding is U+2007. */
+static char *
+luma_trim_clock (const char *time)
+{
+  const char *start = time;
+  char *out;
 
+  while (*start != '\0' && g_unichar_isspace (g_utf8_get_char (start)))
+    start = g_utf8_next_char (start);
 
+  out = g_strdup (start);
+
+  return g_strchomp (out);
+}
