-#define MAX_EVENTS 512
-#define WEATHER_MAX_AGE (6 * 60 * 60)
-#define CALENDAR_NAME "mobi.phosh.Shell.CalendarServer"
-#define CALENDAR_PATH "/mobi/phosh/Shell/CalendarServer"
