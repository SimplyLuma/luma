--- a/tests/test-app-grid-dock.c
+++ b/tests/test-app-grid-dock.c
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "app-grid.h"
+#include "app-grid-button.h"
+#include "metainfo-cache.h"
+
+static void
+assert_dock (GtkWidget *dock, const char **ids, guint count)
+{
+  g_autoptr (GList) children = gtk_container_get_children (GTK_CONTAINER (dock));
+
+  g_assert_cmpuint (g_list_length (children), ==, count);
+  for (guint i = 0; i < count; i++) {
+    GtkWidget *button = GTK_WIDGET (g_list_nth_data (children, i));
+    GAppInfo *info = phosh_app_grid_button_get_app_info (PHOSH_APP_GRID_BUTTON (button));
+
+    g_assert_cmpstr (g_app_info_get_id (info), ==, ids[i]);
+  }
+}
+
+static void
+test_dock_favorite_limit (void)
+{
+  const char *six[] = { "demo.app.First.desktop", "demo.app.Second.desktop",
+                       "demo.app.Third.desktop", "demo.app.Fourth.desktop",
+                       "demo.app.Fifth.desktop", "demo.app.Sixth.desktop", NULL };
+  const char *three[] = { "demo.app.First.desktop", "demo.app.Second.desktop",
+                         "demo.app.Third.desktop", NULL };
+  const char *reordered[] = { "demo.app.Sixth.desktop", "demo.app.Fifth.desktop",
+                             "demo.app.First.desktop", "demo.app.Second.desktop",
+                             "demo.app.Third.desktop", "demo.app.Fourth.desktop", NULL };
+  const char *missing[] = { "not-installed.desktop", "demo.app.First.desktop",
+                           "demo.app.Second.desktop", "demo.app.Third.desktop",
+                           "demo.app.Fourth.desktop", "demo.app.Fifth.desktop", NULL };
+  g_autoptr (GSettings) favorites = g_settings_new ("sm.puri.phosh");
+  g_autoptr (GSettings) state = g_settings_new ("org.project_luma.shell-state");
+  GtkWidget *grid, *dock, *home;
+  g_autoptr (GList) home_children = NULL;
+
+  g_settings_set_strv (state, "home-apps", NULL);
+  g_settings_set_strv (favorites, "favorites", six);
+  grid = phosh_app_grid_new ();
+  dock = GTK_WIDGET (gtk_widget_get_template_child (grid, PHOSH_TYPE_APP_GRID, "dock"));
+  home = GTK_WIDGET (gtk_widget_get_template_child (grid, PHOSH_TYPE_APP_GRID, "favs"));
+  g_assert_nonnull (dock);
+  g_assert_nonnull (home);
+  assert_dock (dock, six, 4);
+  /* Overflow stays in Home; limiting the dock must not change saved favorites. */
+  home_children = gtk_container_get_children (GTK_CONTAINER (home));
+  g_assert_cmpuint (g_list_length (home_children), ==, 6);
+  g_settings_set_strv (favorites, "favorites", three);
+  assert_dock (dock, three, 3);
+  g_settings_set_strv (favorites, "favorites", reordered);
+  assert_dock (dock, reordered, 4);
+  g_settings_set_strv (favorites, "favorites", missing);
+  assert_dock (dock, six, 4);
+  g_settings_set_strv (favorites, "favorites", NULL);
+  assert_dock (dock, NULL, 0);
+  gtk_widget_destroy (grid);
+}
+
+int
+main (int argc, char *argv[])
+{
+  g_autoptr (PhoshMetainfoCache) cache = phosh_metainfo_cache_get_default ();
+
+  gtk_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/phosh/app-grid/dock-limit-order", test_dock_favorite_limit);
+  return g_test_run ();
+}
