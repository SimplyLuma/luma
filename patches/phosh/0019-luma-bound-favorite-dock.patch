+/* A bound GtkFlowBox ignores widget filters. Limit the source model instead.
+ * Favorite items are reconstructed per lookup, so compare app identity. */
+static gboolean
+is_dock_favorite (gpointer item, gpointer user_data)
+{
+  GListModel *favorites = G_LIST_MODEL (user_data);
+  guint count = MIN (4, g_list_model_get_n_items (favorites));
+
+  for (guint i = 0; i < count; i++) {
+    g_autoptr (GAppInfo) favorite = g_list_model_get_item (favorites, i);
+
+    if (g_app_info_equal (G_APP_INFO (item), favorite))
+      return TRUE;
+  }
+  return FALSE;
+}
