                     <property name="vexpand">1</property>
                     <property name="orientation">vertical</property>
                     <property name="spacing">5</property>
-                    <property name="margin-bottom">16</property>
+                    <property name="margin-top">178</property>
                     <style>
                       <class name="p-large"/>
                     </style>
@@ -347,6 +347,14 @@
       </object>
     </child>
   </template>
+  <object class="GtkGestureMultiPress" id="luma_unlock_tap">
+    <property name="widget">PhoshLockscreen</property>
+    <property name="propagation-phase">capture</property>
+    <property name="touch-only">0</property>
+    <signal name="pressed" handler="on_luma_unlock_press" object="PhoshLockscreen" swapped="true"/>
+    <signal name="released" handler="on_luma_unlock_tap" object="PhoshLockscreen" swapped="true"/>
+    <signal name="cancel" handler="on_luma_unlock_cancelled" object="PhoshLockscreen" swapped="true"/>
+  </object>
   <object class="GtkGestureSwipe" id="swipe_gesture">
     <property name="widget">PhoshLockscreen</property>
     <property name="propagation-phase">capture</property>
