+                            <child><object class="PhoshWifiInfo" id="top_wifi"><property name="visible">1</property><property name="pixel-size">13</property><style><class name="luma-status-wifi"/></style></object></child>
                             <child>
                               <object class="PhoshBatteryInfo" id="batteryinfo">
