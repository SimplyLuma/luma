+/* The wall clock pads single-digit hours for centered presentation. Edge
+ * placement uses the visible time as its anchor, without leading whitespace. */
+static gboolean
+clock_label_transform (GBinding *binding, const GValue *from, GValue *to, gpointer data)
+{
+  const char *text = g_value_get_string (from);
+
+  if (text)
+    while (*text && g_unichar_isspace (g_utf8_get_char (text)))
+      text = g_utf8_next_char (text);
+  g_value_set_string (to, text);
+  return TRUE;
+}
