-void Af::step(double& start, double& stop, double& step, double& focus_pos, double& max_pos, uint64_t& max_sharp, uint64_t sharp, bool& sweep){
-	if(!sweep){
-		if(utils::abs_diff(sharp, max_sharp) > max_sharp*0.3){
