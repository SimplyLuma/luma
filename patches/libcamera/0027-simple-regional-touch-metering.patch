+bool GstCameraControls::setFocusPoint(guint x, guint y)
+{
+	if (capabilities_.empty())
+		return false;
+
+	const auto windowInfo = capabilities_.find(&controls::AfWindows);
+	const auto afMeteringInfo = capabilities_.find(&controls::AfMetering);
+	const auto aeMeteringInfo = capabilities_.find(&controls::AeMeteringMode);
+	if (windowInfo == capabilities_.end() ||
+	    afMeteringInfo == capabilities_.end())
+		return false;
+
+	const Rectangle maximum = windowInfo->second.max().get<Rectangle>();
+	const unsigned int areaWidth = maximum.width;
+	const unsigned int areaHeight = maximum.height;
+	if (!areaWidth || !areaHeight)
+		return false;
+
+	x = std::min(x, 1000u);
+	y = std::min(y, 1000u);
+	const unsigned int width = std::max(1u, areaWidth / 5);
+	const unsigned int height = std::max(1u, areaHeight / 5);
+	const unsigned int centreX = areaWidth * x / 1000;
+	const unsigned int centreY = areaHeight * y / 1000;
+	const unsigned int left = std::min(
+		centreX > width / 2 ? centreX - width / 2 : 0,
+		areaWidth - width);
+	const unsigned int top = std::min(
+		centreY > height / 2 ? centreY - height / 2 : 0,
+		areaHeight - height);
+	const std::array<Rectangle, 1> windows{
+		Rectangle(left, top, width, height)
+	};
+	const Span<const Rectangle> windowSpan(windows);
+
+	controls_.set(controls::AfMetering,
+		      static_cast<int32_t>(controls::AfMeteringWindows));
+	controls_.set(controls::AfWindows, windowSpan);
+	controls_acc_.set(controls::AfMetering,
+			  static_cast<int32_t>(controls::AfMeteringWindows));
+	controls_acc_.set(controls::AfWindows, windowSpan);
+	if (aeMeteringInfo != capabilities_.end()) {
+		controls_.set(controls::AeMeteringMode,
+			      static_cast<int32_t>(controls::MeteringSpot));
+		controls_acc_.set(controls::AeMeteringMode,
+				  static_cast<int32_t>(controls::MeteringSpot));
+	}
+
+	return true;
 }
 
