--- a/include/libcamera/internal/software_isp/swisp_stats.h	2026-08-17 19:06:03
+++ b/include/libcamera/internal/software_isp/swisp_stats.h	2026-08-18 12:41:12
@@ -47,6 +47,18 @@
 	 * \brief Holds the sharpness of an image
 	 */
 	uint64_t sharpness;
+	/**
+	 * \brief Sharpness measurements for a 3x3 grid over the image
+	 *
+	 * The centre entry preserves the default autofocus behaviour while the
+	 * remaining entries allow a requested focus window to select a local
+	 * subject without copying image frames out of the software ISP.
+	 */
+	std::array<uint64_t, 9> sharpnessGrid;
+	/**
+	 * \brief Luminance histograms for the same 3x3 metering grid
+	 */
+	std::array<Histogram, 9> yHistogramGrid;
 };
 
 } /* namespace libcamera */
