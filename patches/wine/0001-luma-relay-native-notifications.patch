+/*
+ * Luma Relay private Wine integration
+ *
+ * Copyright 2026 Project Luma
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wine/unixlib.h"
+#include "luma_relay.h"
+
+static BOOL unix_ready;
+
+BOOL WINAPI LumaRelayNotify( const char *message, DWORD length )
+{
+    struct relay_notify_params params;
+
+    if (!unix_ready || !message || !length || length > 16 * 1024) return FALSE;
+    params.message = message;
+    params.length = length;
+    return !WINE_UNIX_CALL( relay_unix_notify, &params );
+}
+
+BOOL WINAPI DllMain( HINSTANCE instance, DWORD reason, void *reserved )
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        DisableThreadLibraryCalls( instance );
+        unix_ready = !__wine_init_unix_call();
+    }
+    return TRUE;
+}
