+static BOOL append_json_wide( char **cursor, const char *end, const WCHAR *text )
+{
+    char utf8[4096];
+    int length, i;
+
+    if (!(length = WideCharToMultiByte( CP_UTF8, WC_ERR_INVALID_CHARS, text, -1,
+                                        utf8, sizeof(utf8), NULL, NULL ))) return FALSE;
+    for (i = 0; i < length - 1; ++i)
+    {
+        unsigned char character = utf8[i];
+        const char *escape = NULL;
+
+        if (character == '"') escape = "\\\"";
+        else if (character == '\\') escape = "\\\\";
+        else if (character == '\n') escape = "\\n";
+        else if (character == '\r') escape = "\\r";
+        else if (character == '\t') escape = "\\t";
+        if (escape)
+        {
+            if (*cursor + 2 >= end) return FALSE;
+            *(*cursor)++ = escape[0];
+            *(*cursor)++ = escape[1];
+        }
+        else if (character < 0x20)
+        {
+            int written;
+            if (*cursor + 6 >= end) return FALSE;
+            written = snprintf( *cursor, end - *cursor, "\\u%04x", character );
+            if (written != 6) return FALSE;
+            *cursor += written;
+        }
+        else
+        {
+            if (*cursor + 1 >= end) return FALSE;
+            *(*cursor)++ = character;
+        }
+    }
+    return TRUE;
+}
+
+/* Relay owns the host boundary. Wine receives only a private per-app socket. */
+static BOOL relay_native_notification( struct icon *icon )
+{
+    char disabled[2], message[8192], *cursor = message;
+    const char *end = message + sizeof(message);
+    int result;
+
+    if (GetEnvironmentVariableA( "LUMA_RELAY_NOTIFICATIONS", disabled, sizeof(disabled) ) &&
+        disabled[0] == '0') return TRUE;
+    if (!GetEnvironmentVariableA( "LUMA_RELAY_NOTIFY_SOCKET", NULL, 0 )) return FALSE;
+
+    result = snprintf( cursor, end - cursor,
+                       "{\"schema\":1,\"operation\":\"add\",\"id\":\"tray-%p-%u\","
+                       "\"urgency\":%u,\"title\":\"",
+                       icon->owner, icon->id,
+                       (icon->info_flags & NIIF_ICONMASK) == NIIF_ERROR ? 2 : 1 );
+    if (result < 0 || result >= end - cursor) return FALSE;
+    cursor += result;
+    if (!append_json_wide( &cursor, end, icon->info_title )) return FALSE;
+    if (cursor + 10 >= end) return FALSE;
+    memcpy( cursor, "\",\"body\":\"", 10 );
+    cursor += 10;
+    if (!append_json_wide( &cursor, end, icon->info_text )) return FALSE;
+    if (cursor + 3 >= end) return FALSE;
+    memcpy( cursor, "\"}", 2 );
+    cursor += 2;
+
+    return LumaRelayNotify( message, cursor - message );
+}
+
 /* Retrieves icon record by owner window and ID */
 static struct icon *get_icon(HWND owner, UINT id)
 {
@@ -735,7 +808,8 @@ static BOOL modify_icon( struct icon *icon, NOTIFYICONDATAW *nid )
         if (icon->info_icon) DestroyIcon( icon->info_icon );
         icon->info_icon = CopyIcon( nid->hBalloonIcon );
 
-        update_balloon( icon );
+        if (relay_native_notification( icon )) icon->info_text[0] = 0;
+        else update_balloon( icon );
     }
     if (icon->state & NIS_HIDDEN) hide_icon( icon );
     else show_icon( icon );
