+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "wine/unixlib.h"
+#include "luma_relay.h"
+
+#ifndef MSG_NOSIGNAL
+#define MSG_NOSIGNAL 0
+#endif
+
+static NTSTATUS relay_notify( void *args )
+{
+    const struct relay_notify_params *params = args;
+    const char *path = getenv( "LUMA_RELAY_NOTIFY_SOCKET" );
+    struct sockaddr_un address = {0};
+    size_t path_length, sent = 0;
+    int fd, result;
+
+    if (!path || !params->message || !params->length || params->length > 16 * 1024)
+        return STATUS_INVALID_PARAMETER;
+    path_length = strlen( path );
+    if (!path_length || path_length >= sizeof(address.sun_path)) return STATUS_NAME_TOO_LONG;
+
+    address.sun_family = AF_UNIX;
+    memcpy( address.sun_path, path, path_length + 1 );
+    if ((fd = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 )) < 0)
+        return STATUS_UNSUCCESSFUL;
+    if (connect( fd, (struct sockaddr *)&address,
+                 offsetof(struct sockaddr_un, sun_path) + path_length + 1 ) < 0)
+        goto failed;
+    while (sent < params->length)
+    {
+        result = send( fd, params->message + sent, params->length - sent, MSG_NOSIGNAL );
+        if (result <= 0) goto failed;
+        sent += result;
+    }
+    shutdown( fd, SHUT_WR );
+    close( fd );
+    return STATUS_SUCCESS;
+
+failed:
+    close( fd );
+    return STATUS_UNSUCCESSFUL;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    relay_notify,
+};
+
+#ifdef _WIN64
+
+struct relay_notify_params32
+{
+    UINT32 message;
+    UINT32 length;
+};
+
+static NTSTATUS wow64_relay_notify( void *args )
+{
+    const struct relay_notify_params32 *params32 = args;
+    struct relay_notify_params params;
+
+    params.message = (const char *)(ULONG_PTR)params32->message;
+    params.length = params32->length;
+    return relay_notify( &params );
+}
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    wow64_relay_notify,
+};
+
+#endif
