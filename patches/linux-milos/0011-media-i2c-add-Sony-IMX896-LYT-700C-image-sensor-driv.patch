+static const struct imx896_mode imx896_supported_modes[] = {
+	{
+		/* 2x2 binned, full field of view, 30 fps. LLP 11904, FLL 3791 */
+		.width = 4096,
+		.height = 3072,
+		.hblank = 7808,
+		.vblank = 719,
+		.vblank_max = IMX896_FLL_MAX - 3072,
+		.regs = imx896_mode_4096x3072_regs,
+		.num_regs = ARRAY_SIZE(imx896_mode_4096x3072_regs),
+	},
+	{
+		/* Full resolution, 15 fps. LLP 14032, FLL 6451 */
+		.width = 8192,
+		.height = 6144,
+		.hblank = 5840,
+		.vblank = 307,
+		.vblank_max = IMX896_FLL_MAX - 6144,
+		.regs = imx896_mode_8192x6144_regs,
+		.num_regs = ARRAY_SIZE(imx896_mode_8192x6144_regs),
+	},
+};
