From 059899bf1519293b1c1409f6da0252dcdd01c164 Mon Sep 17 00:00:00 2001
From: Jorijn van der Graaf <jorijnvdgraaf@catcrafts.net>
Date: Sun, 16 Aug 2026 19:47:13 +0200
Subject: [PATCH] media: i2c: add Sony IMX896 (LYT-700C) image sensor driver

Minimal driver for the 50MP quad-bayer C-PHY sensor used as the
Fairphone 6 main camera: 4096x3072 binned and 8192x6144 full-res
modes, exposure/analogue-gain/vblank/test-pattern controls, runtime
PM. Register tables derived from Motorola's GPL-2.0 vendor driver
(mot_vienna_imx896_mipi_raw, Copyright MediaTek Inc.); mode timings
cross-checked against the FP6's own CamX sensormodule data (line
lengths identical, frame lengths within 4 lines). Link frequency
1.2 GHz derived from the OP PLL chain and confirmed against the
vendor pixel rate to 2.6 ppm.

Untested on hardware at commit time; first-light validation follows.

Assisted-by: Claude:claude-fable-5
---
 drivers/media/i2c/Kconfig  |   11 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/imx896.c | 1475 ++++++++++++++++++++++++++++++++++++
 3 files changed, 1487 insertions(+)
 create mode 100644 drivers/media/i2c/imx896.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 8f2ba41..f69a914 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -287,6 +287,17 @@ config VIDEO_IMX415
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx415.
 
+config VIDEO_IMX896
+	tristate "Sony IMX896 sensor support"
+	depends on OF_GPIO
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony
+	  IMX896 camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx896.
+
 config VIDEO_MAX9271_LIB
 	tristate
 
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 90b276a..d6d988f 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -61,6 +61,7 @@ obj-$(CONFIG_VIDEO_IMX335) += imx335.o
 obj-$(CONFIG_VIDEO_IMX355) += imx355.o
 obj-$(CONFIG_VIDEO_IMX412) += imx412.o
 obj-$(CONFIG_VIDEO_IMX415) += imx415.o
+obj-$(CONFIG_VIDEO_IMX896) += imx896.o
 obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
 obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
 obj-$(CONFIG_VIDEO_KS0127) += ks0127.o
diff --git a/drivers/media/i2c/imx896.c b/drivers/media/i2c/imx896.c
new file mode 100644
