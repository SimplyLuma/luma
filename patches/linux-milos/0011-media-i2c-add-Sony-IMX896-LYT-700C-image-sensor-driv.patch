+static inline struct imx896 *to_imx896(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx896, sd);
+}
+
+static int imx896_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx896 *imx896 =
+		container_of(ctrl->handler, struct imx896, ctrl_handler);
+	const struct imx896_mode *mode = imx896->cur_mode;
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 exp_max = mode->height + ctrl->val - IMX896_EXPOSURE_OFFSET;
+
+		__v4l2_ctrl_modify_range(imx896->exposure,
+					 imx896->exposure->minimum, exp_max,
+					 imx896->exposure->step,
+					 min_t(s64, imx896->exposure->val,
+					       exp_max));
+	}
+
+	/* The sensor is not reachable while powered down. */
+	if (pm_runtime_get_if_in_use(imx896->dev) == 0)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(imx896->cci, IMX896_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(imx896->cci, IMX896_REG_ANALOGUE_GAIN, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(imx896->cci, IMX896_REG_FLL,
+			  mode->height + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(imx896->cci, IMX896_REG_TEST_PATTERN, ctrl->val,
+			  &ret);
+		break;
+	default:
+		dev_err(imx896->dev, "unhandled control 0x%x\n", ctrl->id);
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(imx896->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx896_ctrl_ops = {
+	.s_ctrl = imx896_set_ctrl,
+};
+
+static void imx896_fill_format(const struct imx896_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int imx896_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int imx896_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(imx896_supported_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = imx896_supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = imx896_supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int imx896_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state)
+{
+	imx896_fill_format(&imx896_supported_modes[0],
+			   v4l2_subdev_state_get_format(sd_state, 0));
+
+	return 0;
+}
+
+/* Update the mode dependent control limits. Called with the ctrl lock held. */
+static void imx896_update_ctrl_limits(struct imx896 *imx896,
+				      const struct imx896_mode *mode)
+{
+	s64 exp_max = mode->height + mode->vblank - IMX896_EXPOSURE_OFFSET;
+
+	imx896->cur_mode = mode;
+
+	__v4l2_ctrl_modify_range(imx896->hblank, mode->hblank, mode->hblank, 1,
+				 mode->hblank);
+	__v4l2_ctrl_modify_range(imx896->vblank, mode->vblank,
+				 mode->vblank_max, 1, mode->vblank);
+	__v4l2_ctrl_s_ctrl(imx896->vblank, mode->vblank);
+	__v4l2_ctrl_modify_range(imx896->exposure, IMX896_EXPOSURE_MIN, exp_max,
+				 IMX896_EXPOSURE_STEP,
+				 min_t(s64, imx896->exposure->val, exp_max));
+}
+
+static int imx896_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx896 *imx896 = to_imx896(sd);
+	const struct imx896_mode *mode;
+
+	mode = v4l2_find_nearest_size(imx896_supported_modes,
+				      ARRAY_SIZE(imx896_supported_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+
+	imx896_fill_format(mode, &fmt->format);
+	*v4l2_subdev_state_get_format(sd_state, 0) = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE)
+		imx896_update_ctrl_limits(imx896, mode);
+
+	return 0;
+}
+
+static int imx896_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		/* Both modes read out the whole pixel array. */
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = IMX896_NATIVE_WIDTH;
+		sel->r.height = IMX896_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int imx896_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state, u32 pad,
+				 u64 streams_mask)
+{
+	struct imx896 *imx896 = to_imx896(sd);
+	const struct v4l2_mbus_framefmt *fmt;
+	const struct imx896_mode *mode;
+	int ret;
+
+	fmt = v4l2_subdev_state_get_format(sd_state, 0);
+	mode = v4l2_find_nearest_size(imx896_supported_modes,
+				      ARRAY_SIZE(imx896_supported_modes),
+				      width, height, fmt->width, fmt->height);
+
+	ret = pm_runtime_resume_and_get(imx896->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(imx896->cci, imx896_init_regs,
+				  ARRAY_SIZE(imx896_init_regs), NULL);
+	if (ret) {
+		dev_err(imx896->dev, "failed to write the init table\n");
+		goto err_rpm_put;
+	}
+
+	ret = cci_multi_reg_write(imx896->cci, mode->regs, mode->num_regs,
+				  NULL);
+	if (ret) {
+		dev_err(imx896->dev, "failed to write the mode table\n");
+		goto err_rpm_put;
+	}
+
+	ret = __v4l2_ctrl_handler_setup(&imx896->ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(imx896->cci, IMX896_REG_MODE_SELECT,
+			IMX896_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(imx896->dev);
+
+	return ret;
+}
+
+static int imx896_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state, u32 pad,
+				  u64 streams_mask)
+{
+	struct imx896 *imx896 = to_imx896(sd);
+	int ret = 0;
+
+	cci_write(imx896->cci, IMX896_REG_MODE_SELECT, IMX896_MODE_STANDBY,
+		  &ret);
+	if (ret)
+		dev_err(imx896->dev, "failed to stop streaming\n");
+
+	pm_runtime_put_autosuspend(imx896->dev);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops imx896_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops imx896_pad_ops = {
+	.enum_mbus_code = imx896_enum_mbus_code,
+	.enum_frame_size = imx896_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = imx896_set_pad_format,
+	.get_selection = imx896_get_selection,
+	.enable_streams = imx896_enable_streams,
+	.disable_streams = imx896_disable_streams,
+};
+
+static const struct v4l2_subdev_ops imx896_subdev_ops = {
+	.video = &imx896_video_ops,
+	.pad = &imx896_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx896_internal_ops = {
+	.init_state = imx896_init_state,
+};
+
+static int imx896_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx896 *imx896 = to_imx896(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(imx896_supply_names),
+				    imx896->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable regulators\n");
+		return ret;
+	}
+
+	usleep_range(1000, 2000);
+
+	ret = clk_prepare_enable(imx896->inclk);
+	if (ret) {
+		dev_err(dev, "failed to enable inclk\n");
+		goto err_reg_off;
+	}
+
+	gpiod_set_value_cansleep(imx896->reset_gpio, 0);
+
+	/*
+	 * The sensor needs the input clock to be stable before XCLR is
+	 * released, and a further settling period before it answers on I2C.
+	 */
+	usleep_range(5000, 6000);
+
+	return 0;
+
+err_reg_off:
+	regulator_bulk_disable(ARRAY_SIZE(imx896_supply_names),
+			       imx896->supplies);
+
+	return ret;
+}
+
+static int imx896_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx896 *imx896 = to_imx896(sd);
+
+	gpiod_set_value_cansleep(imx896->reset_gpio, 1);
+	clk_disable_unprepare(imx896->inclk);
+	regulator_bulk_disable(ARRAY_SIZE(imx896_supply_names),
+			       imx896->supplies);
+
+	return 0;
+}
+
+static int imx896_identify_module(struct imx896 *imx896)
+{
+	int ret = 0;
+	u64 val;
+
+	cci_read(imx896->cci, IMX896_REG_CHIP_ID, &val, &ret);
+	if (ret)
+		return dev_err_probe(imx896->dev, ret,
+				     "failed to read the chip id\n");
+
+	if (val != IMX896_CHIP_ID)
+		return dev_err_probe(imx896->dev, -ENXIO,
+				     "chip id mismatch: %x != %llx\n",
+				     IMX896_CHIP_ID, val);
+
+	cci_read(imx896->cci, IMX896_REG_HW_REVISION, &val, &ret);
+	if (ret)
+		return dev_err_probe(imx896->dev, ret,
+				     "failed to read the hardware revision\n");
+
+	if (!(val & IMX896_HW_REVISION_MP))
+		dev_warn(imx896->dev,
+			 "pre-production silicon (revision 0x%02llx), the initialisation table may not match\n",
+			 val);
+
+	return 0;
+}
+
+static int imx896_init_controls(struct imx896 *imx896)
+{
+	const struct imx896_mode *mode = &imx896_supported_modes[0];
+	struct v4l2_ctrl_handler *ctrl_hdlr = &imx896->ctrl_handler;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *link_freq;
+	s64 exp_max;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 10);
+	if (ret)
+		return ret;
+
+	link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, &imx896_ctrl_ops,
+					   V4L2_CID_LINK_FREQ,
+					   __fls(imx896->link_freq_bitmap),
+					   __ffs(imx896->link_freq_bitmap),
+					   imx896_link_freq_menu);
+	if (link_freq)
+		link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &imx896_ctrl_ops, V4L2_CID_PIXEL_RATE,
+			  IMX896_PIXEL_RATE, IMX896_PIXEL_RATE, 1,
+			  IMX896_PIXEL_RATE);
+
+	imx896->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &imx896_ctrl_ops,
+					   V4L2_CID_HBLANK, mode->hblank,
+					   mode->hblank, 1, mode->hblank);
+	if (imx896->hblank)
+		imx896->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx896->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &imx896_ctrl_ops,
+					   V4L2_CID_VBLANK, mode->vblank,
+					   mode->vblank_max, 1, mode->vblank);
+
+	exp_max = mode->height + mode->vblank - IMX896_EXPOSURE_OFFSET;
+	imx896->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &imx896_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX896_EXPOSURE_MIN, exp_max,
+					     IMX896_EXPOSURE_STEP,
+					     IMX896_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &imx896_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  IMX896_ANA_GAIN_MIN, IMX896_ANA_GAIN_MAX,
+			  IMX896_ANA_GAIN_STEP, IMX896_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &imx896_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx896_test_pattern_menu) - 1,
+				     0, 0, imx896_test_pattern_menu);
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		dev_err(imx896->dev, "control init failed (%d)\n", ret);
+		goto err_free;
+	}
+
+	ret = v4l2_fwnode_device_parse(imx896->dev, &props);
+	if (ret)
+		goto err_free;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &imx896_ctrl_ops,
+					      &props);
+	if (ret)
+		goto err_free;
+
+	imx896->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+err_free:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+static int imx896_parse_endpoint(struct imx896 *imx896)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_CPHY,
+	};
+	struct fwnode_handle *ep;
+	int ret;
+
+	ep = fwnode_graph_get_next_endpoint(dev_fwnode(imx896->dev), NULL);
+	if (!ep)
+		return dev_err_probe(imx896->dev, -ENXIO,
+				     "no endpoint found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return dev_err_probe(imx896->dev, ret,
+				     "failed to parse the endpoint\n");
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != IMX896_NUM_DATA_LANES) {
+		ret = dev_err_probe(imx896->dev, -EINVAL,
+				    "only %u C-PHY trios are supported, got %u\n",
+				    IMX896_NUM_DATA_LANES,
+				    bus_cfg.bus.mipi_csi2.num_data_lanes);
+		goto err_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(imx896->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       imx896_link_freq_menu,
+				       ARRAY_SIZE(imx896_link_freq_menu),
+				       &imx896->link_freq_bitmap);
+
+err_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static int imx896_probe(struct i2c_client *client)
+{
+	struct imx896 *imx896;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	imx896 = devm_kzalloc(&client->dev, sizeof(*imx896), GFP_KERNEL);
+	if (!imx896)
+		return -ENOMEM;
+
+	imx896->dev = &client->dev;
+	imx896->cur_mode = &imx896_supported_modes[0];
+
+	v4l2_i2c_subdev_init(&imx896->sd, client, &imx896_subdev_ops);
+
+	imx896->cci = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(imx896->cci))
+		return dev_err_probe(imx896->dev, PTR_ERR(imx896->cci),
+				     "failed to initialise CCI\n");
+
+	imx896->inclk = devm_v4l2_sensor_clk_get(imx896->dev, NULL);
+	if (IS_ERR(imx896->inclk))
+		return dev_err_probe(imx896->dev, PTR_ERR(imx896->inclk),
+				     "failed to get inclk\n");
+
+	rate = clk_get_rate(imx896->inclk);
+	if (rate != IMX896_INCLK_RATE)
+		return dev_err_probe(imx896->dev, -EINVAL,
+				     "inclk rate %lu Hz is unsupported\n",
+				     rate);
+
+	for (i = 0; i < ARRAY_SIZE(imx896_supply_names); i++)
+		imx896->supplies[i].supply = imx896_supply_names[i];
+
+	ret = devm_regulator_bulk_get(imx896->dev,
+				      ARRAY_SIZE(imx896_supply_names),
+				      imx896->supplies);
+	if (ret)
+		return dev_err_probe(imx896->dev, ret,
+				     "failed to get the regulators\n");
+
+	imx896->reset_gpio = devm_gpiod_get_optional(imx896->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(imx896->reset_gpio))
+		return dev_err_probe(imx896->dev, PTR_ERR(imx896->reset_gpio),
+				     "failed to get the reset gpio\n");
+
+	ret = imx896_parse_endpoint(imx896);
+	if (ret)
+		return ret;
+
+	/* The sensor must be powered up to answer the chip id read. */
+	ret = imx896_power_on(imx896->dev);
+	if (ret)
+		return ret;
+
+	ret = imx896_identify_module(imx896);
+	if (ret)
+		goto err_power_off;
+
+	/*
+	 * The device is powered on already, so mark it active and take a
+	 * reference without resuming it again.
+	 */
+	pm_runtime_set_active(imx896->dev);
+	pm_runtime_get_noresume(imx896->dev);
+	pm_runtime_enable(imx896->dev);
+	pm_runtime_set_autosuspend_delay(imx896->dev, 1000);
+	pm_runtime_use_autosuspend(imx896->dev);
+
+	ret = imx896_init_controls(imx896);
+	if (ret)
+		goto err_pm;
+
+	imx896->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx896->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	imx896->sd.internal_ops = &imx896_internal_ops;
+	imx896->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&imx896->sd.entity, 1, &imx896->pad);
+	if (ret)
+		goto err_ctrls;
+
+	imx896->sd.state_lock = imx896->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&imx896->sd);
+	if (ret < 0)
+		goto err_media_entity;
+
+	ret = v4l2_async_register_subdev_sensor(&imx896->sd);
+	if (ret < 0)
+		goto err_subdev;
+
+	pm_runtime_put_autosuspend(imx896->dev);
+
+	return 0;
+
+err_subdev:
+	v4l2_subdev_cleanup(&imx896->sd);
+err_media_entity:
+	media_entity_cleanup(&imx896->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&imx896->ctrl_handler);
+err_pm:
+	pm_runtime_disable(imx896->dev);
+	pm_runtime_set_suspended(imx896->dev);
+err_power_off:
+	imx896_power_off(imx896->dev);
+
+	return ret;
+}
+
+static void imx896_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx896 *imx896 = to_imx896(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&imx896->ctrl_handler);
+
+	pm_runtime_disable(imx896->dev);
+	if (!pm_runtime_status_suspended(imx896->dev))
+		imx896_power_off(imx896->dev);
+	pm_runtime_set_suspended(imx896->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(imx896_pm_ops, imx896_power_off,
+				 imx896_power_on, NULL);
+
+static const struct of_device_id imx896_of_match[] = {
+	{ .compatible = "sony,imx896" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, imx896_of_match);
+
+static struct i2c_driver imx896_driver = {
+	.probe = imx896_probe,
+	.remove = imx896_remove,
+	.driver = {
+		.name = "imx896",
+		.pm = pm_ptr(&imx896_pm_ops),
+		.of_match_table = imx896_of_match,
+	},
+};
+module_i2c_driver(imx896_driver);
+
+MODULE_DESCRIPTION("Sony IMX896 sensor driver");
+MODULE_AUTHOR("Jorijn van der Graaf <jorijnvdgraaf@catcrafts.net>");
+MODULE_LICENSE("GPL");
