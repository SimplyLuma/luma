+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define IMX896_REG_CHIP_ID		CCI_REG16(0x0016)
+#define IMX896_CHIP_ID			0x0896
+
+/* Hardware revision, bit 4 distinguishes mass production from early silicon */
+#define IMX896_REG_HW_REVISION		CCI_REG8(0x0018)
+#define IMX896_HW_REVISION_MP		BIT(4)
+
+#define IMX896_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define IMX896_MODE_STANDBY		0x00
+#define IMX896_MODE_STREAMING		0x01
+
+/* Frame length lines */
+#define IMX896_REG_FLL			CCI_REG16(0x0340)
+#define IMX896_FLL_MAX			0xfffc
+
+/* Coarse integration time, in lines */
+#define IMX896_REG_EXPOSURE		CCI_REG16(0x0202)
+#define IMX896_EXPOSURE_MIN		4
+#define IMX896_EXPOSURE_STEP		1
+#define IMX896_EXPOSURE_DEFAULT		0x03e8
+/* Exposure must stay this many lines below the frame length */
+#define IMX896_EXPOSURE_OFFSET		48
+
+/*
+ * Analogue gain. The gain register holds a 14 bit code with
+ *
+ *	gain = 16384 / (16384 - code)
+ *
+ * so code 0 is 1x and code 16128 is 64x. Only multiples of 4 are programmable.
+ */
+#define IMX896_REG_ANALOGUE_GAIN	CCI_REG16(0x0204)
+#define IMX896_ANA_GAIN_MIN		0
+#define IMX896_ANA_GAIN_MAX		16128
+#define IMX896_ANA_GAIN_STEP		4
+#define IMX896_ANA_GAIN_DEFAULT		0
+
+#define IMX896_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define IMX896_INCLK_RATE		24000000
+
+/*
+ * CSI-2 C-PHY, 3 trios. The output PLL runs at 2400 MHz, which is the C-PHY
+ * symbol rate; V4L2 expresses the link frequency as half of that. See the
+ * pixel rate formula in Documentation/driver-api/media/tx-rx.rst.
+ */
+#define IMX896_LINK_FREQ		1200000000ULL
+#define IMX896_NUM_DATA_LANES		3
+
+/* Pixel array readout rate, identical for all modes */
+#define IMX896_PIXEL_RATE		1360000000ULL
+
+#define IMX896_NATIVE_WIDTH		8192
+#define IMX896_NATIVE_HEIGHT		6144
+
+static const char * const imx896_supply_names[] = {
+	"dovdd",	/* Digital I/O power, 1.8 V */
+	"avdd2",	/* Analog power, 1.8 V */
+	"avdd1",	/* Analog power, 2.8 V */
+	"dvdd",		/* Digital core power, 1.1 V */
+};
+
+static const s64 imx896_link_freq_menu[] = {
+	IMX896_LINK_FREQ,
+};
+
+static const char * const imx896_test_pattern_menu[] = {
+	"Disabled",
+	"Solid Colour",
+	"Eight Vertical Colour Bars",
+	"Colour Bars With Fade to Grey",
+	"Pseudorandom Sequence (PN9)",
+};
+
+/**
+ * struct imx896_mode - imx896 sensor mode structure
+ * @width: Frame width in pixels
+ * @height: Frame height in pixels
+ * @hblank: Horizontal blanking in pixels, fixed for the mode
+ * @vblank: Vertical blanking in lines, also the minimum for the mode
+ * @vblank_max: Maximum vertical blanking in lines
+ * @regs: Register list for the mode
+ * @num_regs: Number of entries in @regs
+ */
+struct imx896_mode {
+	u32 width;
+	u32 height;
+	u32 hblank;
+	u32 vblank;
+	u32 vblank_max;
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+/**
+ * struct imx896 - imx896 sensor device structure
+ * @dev: Pointer to the generic device
+ * @sd: V4L2 sub-device
+ * @pad: Media pad, only a single source pad is supported
+ * @cci: CCI register map
+ * @inclk: Sensor input clock
+ * @reset_gpio: Sensor reset (XCLR) gpio
+ * @supplies: Regulator supplies
+ * @ctrl_handler: V4L2 control handler
+ * @exposure: Pointer to the exposure control
+ * @hblank: Pointer to the horizontal blanking control
+ * @vblank: Pointer to the vertical blanking control
+ * @cur_mode: Pointer to the currently selected sensor mode
+ * @link_freq_bitmap: Bitmap of the link frequencies enabled in firmware
+ */
+struct imx896 {
+	struct device *dev;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct regmap *cci;
+	struct clk *inclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(imx896_supply_names)];
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+
+	const struct imx896_mode *cur_mode;
+	unsigned long link_freq_bitmap;
+};
+
