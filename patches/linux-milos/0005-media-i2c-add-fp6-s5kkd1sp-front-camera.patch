+struct s5kkd1sp {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[S5KKD1SP_NUM_SUPPLIES];
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrl_handler;
+};
+
+#define to_s5kkd1sp(_sd) container_of(_sd, struct s5kkd1sp, sd)
+
+static void s5kkd1sp_log_reg(struct s5kkd1sp *sensor, u32 reg,
+			     const char *name)
+{
+	u64 value;
+	int ret;
+
+	ret = cci_read(sensor->regmap, CCI_REG16(reg), &value, NULL);
+	if (ret)
+		dev_err(sensor->dev, "failed to read %s (0x%04x): %d\n",
+			name, reg, ret);
+	else
+		dev_info(sensor->dev, "%s[0x%04x]=0x%04llx\n",
+			 name, reg, value);
+}
+
+static void s5kkd1sp_fill_format(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	fmt->width = 3104;
+	fmt->height = 2336;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5kkd1sp_set_pad_format(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_format *fmt)
+{
+	s5kkd1sp_fill_format(&fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	return 0;
+}
+
+static int s5kkd1sp_enum_mbus_code(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	return 0;
+}
+
+static int s5kkd1sp_enum_frame_size(struct v4l2_subdev *sd,
+				    struct v4l2_subdev_state *state,
+				    struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != MEDIA_BUS_FMT_SGRBG10_1X10)
+		return -EINVAL;
+	fse->min_width = fse->max_width = 3104;
+	fse->min_height = fse->max_height = 2336;
+	return 0;
+}
+
+static int s5kkd1sp_get_selection(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_selection *sel)
+{
+	if (sel->which != V4L2_SUBDEV_FORMAT_ACTIVE)
+		return -EINVAL;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = 3104;
+		sel->r.height = 2336;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int s5kkd1sp_enable_streams(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   u32 pad, u64 streams_mask)
+{
+	struct s5kkd1sp *sensor = to_s5kkd1sp(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret)
+		return ret;
+
+	/*
+	 * The stock profile requires 10 ms after both reset-release writes.
+	 * cci_reg_sequence has no delay member, so preserve those boundaries
+	 * explicitly instead of collapsing the profile into one bulk write.
+	 */
+	cci_multi_reg_write(sensor->regmap, s5kkd1sp_init_regs,
+			    S5KKD1SP_INIT_RESET1_END, &ret);
+	if (!ret)
+		usleep_range(S5KKD1SP_INIT_DELAY_US,
+			     S5KKD1SP_INIT_DELAY_US + 1000);
+	cci_multi_reg_write(sensor->regmap,
+			    s5kkd1sp_init_regs + S5KKD1SP_INIT_RESET1_END,
+			    S5KKD1SP_INIT_RESET2_END -
+			    S5KKD1SP_INIT_RESET1_END, &ret);
+	if (!ret)
+		usleep_range(S5KKD1SP_INIT_DELAY_US,
+			     S5KKD1SP_INIT_DELAY_US + 1000);
+	cci_multi_reg_write(sensor->regmap,
+			    s5kkd1sp_init_regs + S5KKD1SP_INIT_RESET2_END,
+			    ARRAY_SIZE(s5kkd1sp_init_regs) -
+			    S5KKD1SP_INIT_RESET2_END, &ret);
+	cci_multi_reg_write(sensor->regmap, s5kkd1sp_3104x2336_regs,
+			    ARRAY_SIZE(s5kkd1sp_3104x2336_regs), &ret);
+	cci_write(sensor->regmap, S5KKD1SP_REG_CTRL_MODE,
+		  S5KKD1SP_MODE_STREAMING, &ret);
+	if (!ret) {
+		s5kkd1sp_log_reg(sensor, 0x0000, "model");
+		s5kkd1sp_log_reg(sensor, 0x0100, "mode");
+		s5kkd1sp_log_reg(sensor, 0x0112, "bit-depth");
+		s5kkd1sp_log_reg(sensor, 0x0114, "lane-mode");
+		s5kkd1sp_log_reg(sensor, 0x0136, "input-clock");
+		s5kkd1sp_log_reg(sensor, 0x0306, "pll-multiplier");
+		s5kkd1sp_log_reg(sensor, 0x0310, "mipi-pll-multiplier");
+		s5kkd1sp_log_reg(sensor, 0x0340, "frame-length");
+		s5kkd1sp_log_reg(sensor, 0x0342, "line-length");
+		s5kkd1sp_log_reg(sensor, 0x034c, "output-width");
+		s5kkd1sp_log_reg(sensor, 0x034e, "output-height");
+	}
+	if (!ret)
+		return 0;
+
+	dev_err(sensor->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(sensor->dev);
+	return ret;
+}
+
+static int s5kkd1sp_disable_streams(struct v4l2_subdev *sd,
+				    struct v4l2_subdev_state *state,
+				    u32 pad, u64 streams_mask)
+{
+	struct s5kkd1sp *sensor = to_s5kkd1sp(sd);
+	int ret;
+
+	ret = cci_write(sensor->regmap, S5KKD1SP_REG_CTRL_MODE,
+			S5KKD1SP_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(sensor->dev, "failed to stop streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(sensor->dev);
+	return ret;
+}
+
+static int s5kkd1sp_init_state(struct v4l2_subdev *sd,
+			       struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+	};
+
+	return s5kkd1sp_set_pad_format(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops s5kkd1sp_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5kkd1sp_pad_ops = {
+	.set_fmt = s5kkd1sp_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.enum_mbus_code = s5kkd1sp_enum_mbus_code,
+	.enum_frame_size = s5kkd1sp_enum_frame_size,
+	.get_selection = s5kkd1sp_get_selection,
+	.enable_streams = s5kkd1sp_enable_streams,
+	.disable_streams = s5kkd1sp_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5kkd1sp_subdev_ops = {
+	.video = &s5kkd1sp_video_ops,
+	.pad = &s5kkd1sp_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5kkd1sp_internal_ops = {
+	.init_state = s5kkd1sp_init_state,
+};
+
+static const struct media_entity_operations s5kkd1sp_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int s5kkd1sp_check_hwcfg(struct s5kkd1sp *sensor)
+{
+	struct fwnode_handle *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus = {
+			.mipi_csi2 = {
+				.num_data_lanes = S5KKD1SP_DATA_LANES,
+			},
+		},
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	ep = fwnode_graph_get_next_endpoint(dev_fwnode(sensor->dev), NULL);
+	if (!ep)
+		return -EINVAL;
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5KKD1SP_DATA_LANES) {
+		ret = -EINVAL;
+		goto out;
+	}
+	ret = v4l2_link_freq_to_bitmap(sensor->dev,
+				       bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       s5kkd1sp_link_freq_menu,
+				       ARRAY_SIZE(s5kkd1sp_link_freq_menu),
+				       &freq_bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static int s5kkd1sp_power_on(struct device *dev)
+{
+	struct s5kkd1sp *sensor = to_s5kkd1sp(dev_get_drvdata(dev));
+	int ret;
+
+	/* Preserve the signed stock profile's ordered power-up sequence. */
+	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+	usleep_range(S5KKD1SP_POWER_DELAY_US, S5KKD1SP_POWER_DELAY_US + 5);
+
+	ret = regulator_set_voltage(
+		sensor->supplies[S5KKD1SP_SUPPLY_VDDIO].consumer,
+		S5KKD1SP_VDDIO_MIN_UV, S5KKD1SP_VDDIO_MAX_UV);
+	if (ret)
+		return ret;
+	ret = regulator_set_load(
+		sensor->supplies[S5KKD1SP_SUPPLY_VDDIO].consumer,
+		S5KKD1SP_VDDIO_LOAD_UA);
+	if (ret < 0)
+		return ret;
+	ret = regulator_enable(sensor->supplies[S5KKD1SP_SUPPLY_VDDIO].consumer);
+	if (ret)
+		return ret;
+	usleep_range(S5KKD1SP_POWER_DELAY_US, S5KKD1SP_POWER_DELAY_US + 5);
+
+	ret = regulator_set_voltage(
+		sensor->supplies[S5KKD1SP_SUPPLY_VDDD].consumer,
+		S5KKD1SP_VDDD_MIN_UV, S5KKD1SP_VDDD_MAX_UV);
+	if (ret)
+		goto disable_vddio;
+	ret = regulator_set_load(
+		sensor->supplies[S5KKD1SP_SUPPLY_VDDD].consumer,
+		S5KKD1SP_VDDD_LOAD_UA);
+	if (ret < 0)
+		goto disable_vddio;
+	ret = regulator_enable(sensor->supplies[S5KKD1SP_SUPPLY_VDDD].consumer);
+	if (ret)
+		goto disable_vddio;
+	usleep_range(S5KKD1SP_POWER_DELAY_US, S5KKD1SP_POWER_DELAY_US + 5);
+
+	ret = regulator_set_voltage(
+		sensor->supplies[S5KKD1SP_SUPPLY_VDDA].consumer,
+		S5KKD1SP_VDDA_MIN_UV, S5KKD1SP_VDDA_MAX_UV);
+	if (ret)
+		goto disable_vddd;
+	ret = regulator_set_load(
+		sensor->supplies[S5KKD1SP_SUPPLY_VDDA].consumer,
+		S5KKD1SP_VDDA_LOAD_UA);
+	if (ret < 0)
+		goto disable_vddd;
+	ret = regulator_enable(sensor->supplies[S5KKD1SP_SUPPLY_VDDA].consumer);
+	if (ret)
+		goto disable_vddd;
+	usleep_range(S5KKD1SP_POWER_DELAY_US, S5KKD1SP_POWER_DELAY_US + 5);
+
+	gpiod_set_value_cansleep(sensor->reset_gpio, 0);
+	usleep_range(S5KKD1SP_POWER_DELAY_US, S5KKD1SP_POWER_DELAY_US + 5);
+
+	ret = clk_prepare_enable(sensor->mclk);
+	if (ret)
+		goto assert_reset;
+	return 0;
+
+assert_reset:
+	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+	regulator_disable(sensor->supplies[S5KKD1SP_SUPPLY_VDDA].consumer);
+	regulator_set_load(sensor->supplies[S5KKD1SP_SUPPLY_VDDA].consumer, 0);
+	regulator_set_voltage(sensor->supplies[S5KKD1SP_SUPPLY_VDDA].consumer,
+			      0, S5KKD1SP_VDDA_MAX_UV);
+disable_vddd:
+	regulator_disable(sensor->supplies[S5KKD1SP_SUPPLY_VDDD].consumer);
+	regulator_set_load(sensor->supplies[S5KKD1SP_SUPPLY_VDDD].consumer, 0);
+	regulator_set_voltage(sensor->supplies[S5KKD1SP_SUPPLY_VDDD].consumer,
+			      0, S5KKD1SP_VDDD_MAX_UV);
+disable_vddio:
+	regulator_disable(sensor->supplies[S5KKD1SP_SUPPLY_VDDIO].consumer);
+	regulator_set_load(sensor->supplies[S5KKD1SP_SUPPLY_VDDIO].consumer, 0);
+	regulator_set_voltage(sensor->supplies[S5KKD1SP_SUPPLY_VDDIO].consumer,
+			      0, S5KKD1SP_VDDIO_MAX_UV);
+	return ret;
+}
+
+static int s5kkd1sp_power_off(struct device *dev)
+{
+	struct s5kkd1sp *sensor = to_s5kkd1sp(dev_get_drvdata(dev));
+
+	clk_disable_unprepare(sensor->mclk);
+	usleep_range(S5KKD1SP_OFF_DELAY_US, S5KKD1SP_OFF_DELAY_US + 5);
+	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+	usleep_range(S5KKD1SP_OFF_DELAY_US, S5KKD1SP_OFF_DELAY_US + 5);
+	regulator_disable(sensor->supplies[S5KKD1SP_SUPPLY_VDDA].consumer);
+	regulator_set_load(sensor->supplies[S5KKD1SP_SUPPLY_VDDA].consumer, 0);
+	regulator_set_voltage(sensor->supplies[S5KKD1SP_SUPPLY_VDDA].consumer,
+			      0, S5KKD1SP_VDDA_MAX_UV);
+	regulator_disable(sensor->supplies[S5KKD1SP_SUPPLY_VDDD].consumer);
+	regulator_set_load(sensor->supplies[S5KKD1SP_SUPPLY_VDDD].consumer, 0);
+	regulator_set_voltage(sensor->supplies[S5KKD1SP_SUPPLY_VDDD].consumer,
+			      0, S5KKD1SP_VDDD_MAX_UV);
+	regulator_disable(sensor->supplies[S5KKD1SP_SUPPLY_VDDIO].consumer);
+	regulator_set_load(sensor->supplies[S5KKD1SP_SUPPLY_VDDIO].consumer, 0);
+	regulator_set_voltage(sensor->supplies[S5KKD1SP_SUPPLY_VDDIO].consumer,
+			      0, S5KKD1SP_VDDIO_MAX_UV);
+	return 0;
+}
+
+static int s5kkd1sp_init_controls(struct s5kkd1sp *sensor)
+{
+	struct v4l2_ctrl_handler *handler = &sensor->ctrl_handler;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	s64 pixel_rate = S5KKD1SP_LINK_FREQ * 2 * S5KKD1SP_DATA_LANES / 10;
+	int ret;
+
+	v4l2_ctrl_handler_init(handler, 8);
+	ctrl = v4l2_ctrl_new_int_menu(handler, NULL, V4L2_CID_LINK_FREQ,
+				      0, 0, s5kkd1sp_link_freq_menu);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	v4l2_ctrl_new_std(handler, NULL, V4L2_CID_PIXEL_RATE,
+			  pixel_rate, pixel_rate, 1, pixel_rate);
+	ctrl = v4l2_ctrl_new_std(handler, NULL, V4L2_CID_HBLANK,
+				3640 - 3104, 3640 - 3104, 1, 3640 - 3104);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	ctrl = v4l2_ctrl_new_std(handler, NULL, V4L2_CID_VBLANK,
+				5078 - 2336, 5078 - 2336, 1, 5078 - 2336);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	/*
+	 * The stock diagnostic table currently supplies fixed exposure and gain.
+	 * Keep writable cached controls for libcamera bring-up until the matching
+	 * Samsung indirect-register writes are physically validated.
+	 */
+	v4l2_ctrl_new_std(handler, NULL, V4L2_CID_EXPOSURE,
+			  1, 5078 - 48, 1, 1000);
+	v4l2_ctrl_new_std(handler, NULL, V4L2_CID_ANALOGUE_GAIN,
+			  0, 1023, 1, 0);
+	if (handler->error)
+		return handler->error;
+
+	ret = v4l2_fwnode_device_parse(sensor->dev, &props);
+	if (ret)
+		return ret;
+	ret = v4l2_ctrl_new_fwnode_properties(handler, NULL, &props);
+	if (ret)
+		return ret;
+	sensor->sd.ctrl_handler = handler;
+	return 0;
+}
+
+static int s5kkd1sp_probe(struct i2c_client *client)
+{
+	struct s5kkd1sp *sensor;
+	u64 chip_id;
+	unsigned int i;
+	int ret;
+
+	sensor = devm_kzalloc(&client->dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+	sensor->dev = &client->dev;
+	v4l2_i2c_subdev_init(&sensor->sd, client, &s5kkd1sp_subdev_ops);
+	sensor->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sensor->regmap))
+		return dev_err_probe(sensor->dev, PTR_ERR(sensor->regmap),
+				     "failed to initialize CCI\n");
+	sensor->mclk = devm_v4l2_sensor_clk_get(sensor->dev, NULL);
+	if (IS_ERR(sensor->mclk))
+		return dev_err_probe(sensor->dev, PTR_ERR(sensor->mclk),
+				     "failed to get MCLK\n");
+	if (clk_get_rate(sensor->mclk) != S5KKD1SP_MCLK_FREQ)
+		return dev_err_probe(sensor->dev, -EINVAL,
+				     "unsupported MCLK frequency\n");
+	ret = s5kkd1sp_check_hwcfg(sensor);
+	if (ret)
+		return dev_err_probe(sensor->dev, ret, "invalid endpoint\n");
+	sensor->reset_gpio = devm_gpiod_get_optional(sensor->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset_gpio))
+		return dev_err_probe(sensor->dev, PTR_ERR(sensor->reset_gpio),
+				     "failed to get reset GPIO\n");
+	for (i = 0; i < S5KKD1SP_NUM_SUPPLIES; i++)
+		sensor->supplies[i].supply = s5kkd1sp_supply_names[i];
+	ret = devm_regulator_bulk_get(sensor->dev, S5KKD1SP_NUM_SUPPLIES,
+				      sensor->supplies);
+	if (ret)
+		return dev_err_probe(sensor->dev, ret, "failed to get supplies\n");
+
+	ret = s5kkd1sp_power_on(sensor->dev);
+	if (ret)
+		return ret;
+	ret = cci_read(sensor->regmap, CCI_REG16(0x0000), &chip_id, NULL);
+	if (ret) {
+		dev_err_probe(sensor->dev, ret, "failed to read sensor identity\n");
+		goto power_off;
+	}
+	dev_info(sensor->dev, "sensor identity 0x%04llx\n", chip_id);
+	ret = s5kkd1sp_init_controls(sensor);
+	if (ret)
+		goto power_off;
+	sensor->sd.state_lock = sensor->ctrl_handler.lock;
+	sensor->sd.internal_ops = &s5kkd1sp_internal_ops;
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->sd.entity.ops = &s5kkd1sp_entity_ops;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		goto free_controls;
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto cleanup_entity;
+	pm_runtime_set_active(sensor->dev);
+	pm_runtime_enable(sensor->dev);
+	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	if (ret)
+		goto cleanup_subdev;
+	pm_runtime_set_autosuspend_delay(sensor->dev, 1000);
+	pm_runtime_use_autosuspend(sensor->dev);
+	pm_runtime_idle(sensor->dev);
+	return 0;
+
+cleanup_subdev:
+	v4l2_subdev_cleanup(&sensor->sd);
+	pm_runtime_disable(sensor->dev);
+	pm_runtime_set_suspended(sensor->dev);
+cleanup_entity:
+	media_entity_cleanup(&sensor->sd.entity);
+free_controls:
+	v4l2_ctrl_handler_free(&sensor->ctrl_handler);
+power_off:
+	s5kkd1sp_power_off(sensor->dev);
+	return ret;
+}
+
+static void s5kkd1sp_remove(struct i2c_client *client)
+{
+	struct s5kkd1sp *sensor = to_s5kkd1sp(i2c_get_clientdata(client));
+
+	v4l2_async_unregister_subdev(&sensor->sd);
+	v4l2_subdev_cleanup(&sensor->sd);
+	media_entity_cleanup(&sensor->sd.entity);
+	v4l2_ctrl_handler_free(&sensor->ctrl_handler);
+	pm_runtime_disable(sensor->dev);
+	if (!pm_runtime_status_suspended(sensor->dev)) {
+		s5kkd1sp_power_off(sensor->dev);
+		pm_runtime_set_suspended(sensor->dev);
+	}
+}
+
+static const struct dev_pm_ops s5kkd1sp_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5kkd1sp_power_off, s5kkd1sp_power_on, NULL)
+};
+
+static const struct of_device_id s5kkd1sp_of_match[] = {
+	{ .compatible = "samsung,s5kkd1sp" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s5kkd1sp_of_match);
+
+static struct i2c_driver s5kkd1sp_i2c_driver = {
+	.driver = {
+		.name = "s5kkd1sp",
+		.pm = &s5kkd1sp_pm_ops,
+		.of_match_table = s5kkd1sp_of_match,
+	},
+	.probe = s5kkd1sp_probe,
+	.remove = s5kkd1sp_remove,
+};
+module_i2c_driver(s5kkd1sp_i2c_driver);
+
+MODULE_DESCRIPTION("Samsung S5KKD1SP image sensor driver");
+MODULE_LICENSE("GPL");
