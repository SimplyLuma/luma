From: Project Luma <luma@local>
Subject: [PATCH] media: i2c: add FP6 S5KKD1SP front camera

--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -780,6 +780,16 @@
 
 	  To compile this driver as a module, choose M here: the
 	  module will be called s5k3m5.
+
+config VIDEO_S5KKD1SP
+	tristate "Samsung S5KKD1SP sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a V4L2 sensor driver for the Samsung S5KKD1SP raw
+	  camera sensor used as the front camera on the Fairphone 6.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called s5kkd1sp.
 
 config VIDEO_S5K5BAF
 	tristate "Samsung S5K5BAF sensor support"
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -128,6 +128,7 @@
 obj-$(CONFIG_VIDEO_RJ54N1) += rj54n1cb0c.o
 obj-$(CONFIG_VIDEO_S5C73M3) += s5c73m3/
 obj-$(CONFIG_VIDEO_S5K3M5) += s5k3m5.o
+obj-$(CONFIG_VIDEO_S5KKD1SP) += s5kkd1sp.o
 obj-$(CONFIG_VIDEO_S5K5BAF) += s5k5baf.o
 obj-$(CONFIG_VIDEO_S5K6A3) += s5k6a3.o
 obj-$(CONFIG_VIDEO_S5KJN1) += s5kjn1.o
--- a/drivers/media/i2c/s5kkd1sp.c
+++ b/drivers/media/i2c/s5kkd1sp.c
@@ -0,0 +1,1068 @@
