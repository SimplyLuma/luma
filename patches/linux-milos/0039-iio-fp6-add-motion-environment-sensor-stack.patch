From af49850e65bdf5dc6f4a14fb9e8e5c5814522d33 Mon Sep 17 00:00:00 2001
From: Project Luma <codex@local>
Date: Wed, 19 Aug 2026 23:20:00 -0500
Subject: [PATCH] iio: fp6: add motion and environment sensor stack

Consolidate the final sensor state from Catcrafts combined-stable at
af49850. The source series adds the QMC6308 magnetometer, an ICM-42631
fallback for the FP6 ICM-42630-compatible IMU, SPL07-003 pressure
support, STK36C61 ambient-light/proximity support, and the matching
bit-banged FP6 I2C/SPI device-tree buses.

Upstream commits: f2750740b74e, a01ea24ecc0b, 2220e81336d9,
909458a93229, 587458fe6998, c2a1ae5241b8, bb538ee5c1ae,
6cef99d4908e, c7f64bd563b3, 7d1d5238124b, ad947e6e4a07,
6e1a1ab6feab, b91e924457f9, 40c5f87a75d7, ddb00ff3ee13,
df5dd98fd2d5, c76b42e1897d, and 4405a0026a24.
---
diff --git a/arch/arm64/boot/dts/qcom/milos-fairphone-fp6.dts b/arch/arm64/boot/dts/qcom/milos-fairphone-fp6.dts
index 501220945..29a8e4fc3 100644
--- a/arch/arm64/boot/dts/qcom/milos-fairphone-fp6.dts
+++ b/arch/arm64/boot/dts/qcom/milos-fairphone-fp6.dts
@@ -27,6 +27,89 @@ aliases {
 		serial1 = &uart11;
 	};
 
+	/*
+	 * The sensor I2C bus sits on TLMM eGPIO pads that have no AP QUP
+	 * function; on the stock OS it is driven by an island QUP of the
+	 * Snapdragon Sensor Core (ADSP). From the AP the pads are only
+	 * usable as software GPIOs, so bit-bang the bus.
+	 * Devices on the bus: QMC6308 magnetometer @ 0x2c, SPL07
+	 * barometer @ 0x76, STK36C61 ALS/proximity @ 0x48.
+	 */
+	i2c-sensors {
+		compatible = "i2c-gpio";
+		sda-gpios = <&tlmm 153 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&tlmm 154 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <2>;
+		pinctrl-0 = <&sensor_i2c_default>;
+		pinctrl-names = "default";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		magnetometer@2c {
+			compatible = "qstcorp,qmc6308";
+			reg = <0x2c>;
+			vdd-supply = <&vreg_l10b>;
+			mount-matrix = "0", "-1", "0",
+				       "1", "0", "0",
+				       "0", "0", "1";
+		};
+
+		light-sensor@48 {
+			compatible = "sensortek,stk36c61", "sensortek,stk3310";
+			reg = <0x48>;
+		};
+
+		pressure-sensor@76 {
+			compatible = "goertek,spl07-003";
+			reg = <0x76>;
+			vdd-supply = <&vreg_l10b>;
+			vddio-supply = <&vreg_l10b>;
+		};
+	};
+
+	/*
+	 * Like the sensor I2C bus above, the IMU SPI bus sits on eGPIO
+	 * pads owned by the Sensor Core island QUP on the stock OS, so
+	 * bit-bang it. The ICM-42630 also answers I2C on the same pads
+	 * (0x68/0x69 with CS held high), but downstream runs it as
+	 * 4-wire SPI and all four pads are wired.
+	 */
+	spi-imu {
+		compatible = "spi-gpio";
+		sck-gpios = <&tlmm 157 GPIO_ACTIVE_HIGH>;
+		mosi-gpios = <&tlmm 156 GPIO_ACTIVE_HIGH>;
+		miso-gpios = <&tlmm 155 GPIO_ACTIVE_HIGH>;
+		cs-gpios = <&tlmm 158 GPIO_ACTIVE_LOW>;
+		num-chipselects = <1>;
+		pinctrl-0 = <&imu_spi_default>;
+		pinctrl-names = "default";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		imu@0 {
+			compatible = "invensense,icm42630", "invensense,icm42631";
+			reg = <0>;
+			spi-max-frequency = <9600000>;
+			interrupts-extended = <&tlmm 72 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "INT1";
+			pinctrl-0 = <&imu_int_default>;
+			pinctrl-names = "default";
+			vdd-supply = <&vreg_l10b>;
+			vddio-supply = <&vreg_l10b>;
+			/*
+			 * x/y signs follow iio-sensor-proxy's convention
+			 * (upright device reads 1g on -y): the vendor
+			 * registry .orient maps sensor (x,y,z) to device
+			 * (x,-y,-z) in the Android reaction-force frame,
+			 * which is x/y-negated relative to what
+			 * iio-sensor-proxy expects.
+			 */
+			mount-matrix = "-1", "0", "0",
+				       "0", "1", "0",
+				       "0", "0", "-1";
+		};
+	};
+
 	gpio-keys {
 		compatible = "gpio-keys";
 
@@ -1130,6 +1213,30 @@ &tlmm {
 			       <13 1>, /* NC */
 			       <63 2>; /* WLAN UART */
 
+	imu_int_default: imu-int-default-state {
+		/* INT1, push-pull active-high */
+		pins = "gpio72";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	imu_spi_default: imu-spi-default-state {
+		/* MISO, MOSI, CLK, CS_N */
+		pins = "gpio155", "gpio156", "gpio157", "gpio158";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	sensor_i2c_default: sensor-i2c-default-state {
+		/* SDA, SCL; external pull-ups to vreg_l10b */
+		pins = "gpio153", "gpio154";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	ts_active: ts-irq-active-state {
 		pins = "gpio19";
 		function = "gpio";
diff --git a/drivers/iio/imu/inv_icm42600/inv_icm42600_core.c b/drivers/iio/imu/inv_icm42600/inv_icm42600_core.c
index 76eb22488..6dd665a62 100644
--- a/drivers/iio/imu/inv_icm42600/inv_icm42600_core.c
+++ b/drivers/iio/imu/inv_icm42600/inv_icm42600_core.c
@@ -5,6 +5,7 @@
 
 #include <linux/kernel.h>
 #include <linux/device.h>
+#include <linux/limits.h>
 #include <linux/module.h>
 #include <linux/slab.h>
 #include <linux/delay.h>
@@ -510,9 +511,18 @@ static int inv_icm42600_setup(struct inv_icm42600_state *st,
 	if (ret)
 		return ret;
 	if (val != hw->whoami) {
-		dev_err(dev, "invalid whoami %#02x expected %#02x (%s)\n",
-			val, hw->whoami, hw->name);
-		return -ENODEV;
+		/*
+		 * SPI interface has no ack mechanism.
+		 * 0xFF or 0x00 whoami means no response from the device.
+		 */
+		if (val == U8_MAX || val == 0)
+			return dev_err_probe(dev, -ENODEV,
+					     "invalid whoami %#04x expected %#04x (%s)\n",
+					     val, hw->whoami, hw->name);
+
+		dev_info(dev,
+			 "device id %#04x is not the %#04x associated with the FW-specified device (%s), probably using a valid fallback compatible\n",
+			 val, hw->whoami, hw->name);
 	}
 	st->name = hw->name;
 
