From: Project Luma <luma@projectluma.dev>
Subject: [PATCH] arm64: dts: qcom: milos: complete FP6 IMX896 camera

Bring Luma's earlier diagnostic IMX896 node in line with the physically
validated CatCrafts main-camera stack. Describe the C-PHY bus and 1.2 GHz
V4L2 link frequency, use the rail names consumed by the upstream-style
driver, compensate for the sensor table's H+V mirror, and connect the
Dongwoon DW9784 autofocus controller.

The orientation and autofocus details are based on CatCrafts commits
0642eefee45210bd1c7df3bd7321a2884c7bc8b1 and
32a2b3216427e06527617524a8cc5bc3e1fa440b.

---
 arch/arm64/boot/dts/qcom/milos-fairphone-fp6.dts | 36 ++++++++++++++++++-----
 arch/arm64/boot/dts/qcom/milos.dtsi              |  1 +
 2 files changed, 30 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/milos.dtsi b/arch/arm64/boot/dts/qcom/milos.dtsi
--- a/arch/arm64/boot/dts/qcom/milos.dtsi
+++ b/arch/arm64/boot/dts/qcom/milos.dtsi
@@ -2559,5 +2559,6 @@
 					csiphy0_ep: endpoint {
 						remote-endpoint = <&imx896_ep>;
+						bus-type = <1>; /* MEDIA_BUS_TYPE_CSI2_CPHY */
 						data-lanes = <0 1 2>;
 					};
 				};
diff --git a/arch/arm64/boot/dts/qcom/milos-fairphone-fp6.dts b/arch/arm64/boot/dts/qcom/milos-fairphone-fp6.dts
--- a/arch/arm64/boot/dts/qcom/milos-fairphone-fp6.dts
+++ b/arch/arm64/boot/dts/qcom/milos-fairphone-fp6.dts
@@ -651,10 +651,17 @@ camera@1a {
 		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
 		assigned-clock-rates = <24000000>;
 
-		vddaux-supply = <&vreg_l5p>;
-		vdda-supply = <&vreg_ois_avdd0_1p8>;
-		vddd-supply = <&vreg_l1p>;
-		vddio-supply = <&vreg_l6p>;
+		/*
+		 * IMX896 rails: avdd1 2.8V = vreg_l5p (pm8008), avdd2 1.8V =
+		 * the tlmm27-enabled discrete LDO, dvdd 1.1V = vreg_l1p, and
+		 * dovdd 1.8V = vreg_l6p (shared with the camera EEPROMs).
+		 */
+		avdd1-supply = <&vreg_l5p>;
+		avdd2-supply = <&vreg_ois_avdd0_1p8>;
+		dvdd-supply = <&vreg_l1p>;
+		dovdd-supply = <&vreg_l6p>;
+
+		lens-focus = <&main_vcm>;
 
 		reset-gpios = <&tlmm 40 GPIO_ACTIVE_LOW>;
 		pinctrl-names = "default";
@@ -662,12 +669,14 @@ camera@1a {
 
 		orientation = <1>;
-		rotation = <270>;
+		/* The vendor table enables H+V mirror, so compensate by 180 degrees. */
+		rotation = <90>;
 
 		port {
 			imx896_ep: endpoint {
 				remote-endpoint = <&csiphy0_ep>;
+				bus-type = <1>; /* MEDIA_BUS_TYPE_CSI2_CPHY */
 				data-lanes = <0 1 2>;
-				link-frequencies = /bits/ 64 <1131433333>;
+				link-frequencies = /bits/ 64 <1200000000>;
 			};
 		};
 	};
@@ -681,5 +690,18 @@ eeprom@50 {
 		read-only;
 	};
 
-	/* Dongwoon DW9784 VCM/OIS @ 0x72 */
+	/*
+	 * Dongwoon DW9784 OIS/AF controller. Autofocus is enabled while the
+	 * OIS servo remains centered with stabilization disabled.
+	 */
+	main_vcm: focus@72 {
+		compatible = "dongwoon,dw9784";
+		reg = <0x72>;
+
+		vdd-supply = <&vreg_ois_vdd>;
+		vaf-supply = <&vreg_l7p>;
+		vio-supply = <&vreg_l6p>;
+		avdd-supply = <&vreg_ois_avdd0_1p8>;
+	};
+
 };
-- 
2.51.0
