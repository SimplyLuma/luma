diff --git a/src/style.css b/src/style.css
index 4b82ff1..12f7573 100644
--- a/src/style.css
+++ b/src/style.css
@@ -165,4 +165,19 @@
 /* Always show "Location" row subtitle w/o desenstized visuals */
 row.location.property .subtitle {
   filter: none;
 }
+
+/* Project Luma native application-frame composition. This source-level opt-in
+ * preserves Text Editor's real actions and adaptive widgets while consuming
+ * the shared toolkit-owned materials, identity and work-surface primitives. */
+window.luma-text-editor-window .luma-editor-surface {
+  margin: 0 9px 9px;
+  color: @luma_ink;
+}
+
+window.luma-text-editor-window .luma-editor-surface tabbar,
+window.luma-text-editor-window .luma-editor-surface taboverview,
+window.luma-text-editor-window .luma-editor-surface textview,
+window.luma-text-editor-window .luma-editor-surface textview text {
+  background-color: transparent;
+}
