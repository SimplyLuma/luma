From 4a440fac3e62e3784e2a93c454b58158ad61e511 Mon Sep 17 00:00:00 2001
From: luma <luma@luma.invalid>
Date: Fri, 30 Oct 2026 21:26:24 -0400
Subject: [PATCH 06/10] drm/panel: tokay: enable like the comet panels

Re-running the TK4C cold-start init on the live panel the bootloader
hands over left it on the bootloader DSC setup: the boot logo stayed
with garbage over the top.  Keep the bootloader setup and restate only
compression, the PPS and display on.
---
 drivers/gpu/drm/panel/panel-google-tokay.c | 57 ++++------------------
 1 file changed, 9 insertions(+), 48 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-google-tokay.c b/drivers/gpu/drm/panel/panel-google-tokay.c
index 6513b057f..ae869c338 100644
--- a/drivers/gpu/drm/panel/panel-google-tokay.c
+++ b/drivers/gpu/drm/panel/panel-google-tokay.c
@@ -133,21 +133,6 @@ static int tokay_panel_disable(struct drm_panel *panel)
 	return 0;
 }
 
-#define tk4c_cmd(dsi, seq...)						\
-	mipi_dsi_dcs_write_buffer((dsi), (const u8[]){ seq },		\
-				  sizeof((const u8[]){ seq }))
-
-static int tokay_cur_vrefresh(struct tokay_panel *ctx)
-{
-	struct drm_connector *conn = ctx->connector;
-
-	if (conn && conn->state && conn->state->crtc &&
-	    conn->state->crtc->state)
-		return drm_mode_vrefresh(&conn->state->crtc->state->adjusted_mode);
-
-	return 60;
-}
-
 static int tokay_panel_enable(struct drm_panel *panel)
 {
 	struct tokay_panel *ctx = to_tokay_panel(panel);
@@ -155,45 +140,21 @@ static int tokay_panel_enable(struct drm_panel *panel)
 	struct drm_dsc_picture_parameter_set pps;
 	int ret;
 
-	ret = mipi_dsi_dcs_exit_sleep_mode(dsi);
-	if (ret < 0)
-		return ret;
-	msleep(120);
-
-	/* TK4C normal-mode init, retaining MTP-programmed TE/FGZ values. */
-	tk4c_cmd(dsi, MIPI_DCS_SET_TEAR_ON);
-	tk4c_cmd(dsi, MIPI_DCS_SET_COLUMN_ADDRESS,
-		 0x00, 0x00, 0x04, 0x37);
-	tk4c_cmd(dsi, MIPI_DCS_SET_PAGE_ADDRESS,
-		 0x00, 0x00, 0x09, 0x77);
-
-	/* FFC-off setup for the 756 Mbps link. */
-	tk4c_cmd(dsi, 0xF0, 0x5A, 0x5A);
-	tk4c_cmd(dsi, 0xFC, 0x5A, 0x5A);
-	tk4c_cmd(dsi, 0xB0, 0x00, 0x3A, 0xC5);
-	tk4c_cmd(dsi, 0xC5, 0x6C, 0x5C);
-	tk4c_cmd(dsi, 0xB0, 0x00, 0x36, 0xC5);
-	tk4c_cmd(dsi, 0xC5, 0x10);
-	tk4c_cmd(dsi, 0xF0, 0xA5, 0xA5);
-	tk4c_cmd(dsi, 0xFC, 0xA5, 0xA5);
-
-	/* Select 60 or 120 Hz and latch the LTPS update. */
-	tk4c_cmd(dsi, 0xF0, 0x5A, 0x5A);
-	tk4c_cmd(dsi, 0x83, tokay_cur_vrefresh(ctx) == 60 ? 0x08 : 0x00);
-	tk4c_cmd(dsi, 0xF7, 0x2F);
-	tk4c_cmd(dsi, 0xF0, 0xA5, 0xA5);
-
+	/*
+	 * The bootloader powers and initialises the TK4C and leaves it running;
+	 * nothing here resets it (see prepare).  Re-running the cold-start init
+	 * on that live panel left it decoding with the bootloader's DSC setup:
+	 * the screen kept the boot logo with garbage over the top.  Like the
+	 * comet panels, only restate compression and the PPS, then display on.
+	 */
 	ret = mipi_dsi_compression_mode(dsi, true);
 	if (ret < 0)
-		dev_err(&dsi->dev, "failed to enable DSC: %d\n", ret);
+		dev_warn(&dsi->dev, "failed to enable DSC: %d\n", ret);
 
 	drm_dsc_pps_payload_pack(&pps, &tokay_tk4c_dsc);
 	ret = mipi_dsi_picture_parameter_set(dsi, &pps);
 	if (ret < 0)
-		dev_err(&dsi->dev, "failed to send DSC PPS: %d\n", ret);
-
-	tk4c_cmd(dsi, 0x9D, 0x01);
-	tk4c_cmd(dsi, MIPI_DCS_WRITE_CONTROL_DISPLAY, 0x20);
+		dev_warn(&dsi->dev, "failed to send DSC PPS: %d\n", ret);
 
 	return mipi_dsi_dcs_set_display_on(dsi);
 }
-- 
2.55.0

