From 8c707fc7f81b71a25a35e9dce5e94914ba04413a Mon Sep 17 00:00:00 2001
From: Luma <luma@simplyluma.com>
Date: Sun, 25 Oct 2026 16:21:48 -0400
Subject: [PATCH 55/88] iio: aoc_usf: per-axis raw reads, wait for the first
 sample, label devices

Three-axis sensors get a raw attribute per axis so pollers can read them without a trigger; a raw read that starts a stream waits up to a second for its first sample instead of returning -EAGAIN; each device is labelled with its USF sensor name.
---
 drivers/iio/common/aoc_usf/usf-iio.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/drivers/iio/common/aoc_usf/usf-iio.c b/drivers/iio/common/aoc_usf/usf-iio.c
index 5caeeb837..74cf8077d 100644
--- a/drivers/iio/common/aoc_usf/usf-iio.c
+++ b/drivers/iio/common/aoc_usf/usf-iio.c
@@ -20,6 +20,7 @@
 #include <linux/ctype.h>
 #include <linux/device.h>
 #include <linux/err.h>
+#include <linux/delay.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/of.h>
@@ -193,6 +194,7 @@ static const unsigned long usf_scan_masks_2axis[] = { GENMASK(1, 0), 0 };
 	.type = _type,						\
 	.modified = 1,						\
 	.channel2 = IIO_MOD_##_mod,				\
+	.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),		\
 	.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE),	\
 	.info_mask_shared_by_all = BIT(IIO_CHAN_INFO_SAMP_FREQ),	\
 	.ext_info = usf_ext_info,				\
@@ -351,6 +353,15 @@ static int usf_read_raw(struct iio_dev *indio_dev,
 				return ret;
 		}
 
+		/*
+		 * A stream that was just started sends its first sample within
+		 * a few periods; wait for it rather than failing the first
+		 * poll, which pollers such as iio-sensor-proxy take as "no
+		 * sensor". An on-change sensor that stays quiet still gets
+		 * -EAGAIN after a second.
+		 */
+		for (int i = 0; i < 50 && !READ_ONCE(s->have_last); i++)
+			msleep(20);
 		if (!READ_ONCE(s->have_last))
 			return -EAGAIN;
 
@@ -725,6 +736,8 @@ static int usf_register_sensor(struct usf_iio *usf, u32 handle,
 	usf_set_scale(s, map, res_bits);
 
 	indio->name = map->iio_name;
+	/* the USF name tells the instances of one type apart (two IMUs, ALS) */
+	indio->label = devm_kstrdup(usf->dev, name, GFP_KERNEL);
 	indio->info = &usf_iio_info;
 	indio->modes = INDIO_DIRECT_MODE;
 	indio->channels = map->channels;
