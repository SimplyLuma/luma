From 7262043526e627ec62823181ef6c9b58b15bb441 Mon Sep 17 00:00:00 2001
From: Luma <luma@simplyluma.com>
Date: Thu, 22 Oct 2026 16:41:22 -0400
Subject: [PATCH 41/88] arm64: zumapro_defconfig: hci_aoc, RFCOMM, BNEP, HIDP
 and UHID as modules

They load after the AOC, from the same loader as its other clients. Built in, the four protocol drivers kept the Fold from booting: it reset before the journal reached disk and left no pstore. Which one was not bisected.
---
 arch/arm64/configs/zumapro_defconfig | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/configs/zumapro_defconfig b/arch/arm64/configs/zumapro_defconfig
index 8703ed89c..d2c3d2a0b 100644
--- a/arch/arm64/configs/zumapro_defconfig
+++ b/arch/arm64/configs/zumapro_defconfig
@@ -189,8 +189,15 @@ CONFIG_NET_ACT_MIRRED=y
 CONFIG_CGROUP_NET_PRIO=y
 CONFIG_CGROUP_NET_CLASSID=y
 CONFIG_BT=y
+CONFIG_BT_RFCOMM=m
+CONFIG_BT_RFCOMM_TTY=y
+CONFIG_BT_BNEP=m
+CONFIG_BT_BNEP_MC_FILTER=y
+CONFIG_BT_BNEP_PROTO_FILTER=y
+CONFIG_BT_HIDP=m
 # CONFIG_BT_DEBUGFS is not set
 CONFIG_BT_HCIUART=y
+CONFIG_BT_HCIAOC=m
 CONFIG_CFG80211=y
 CONFIG_MAC80211=y
 CONFIG_MAC80211_LEDS=y
@@ -429,6 +436,7 @@ CONFIG_SND_SOC_MT6357=y
 CONFIG_SND_SOC_GOOGLE_AOC=m
 CONFIG_SND_SOC_CS35L41_SPI=m
 CONFIG_HID_MULTITOUCH=y
+CONFIG_UHID=m
 CONFIG_I2C_HID_OF=y
 CONFIG_I2C_HID_OF_ELAN=y
 CONFIG_USB_HIDDEV=y
