From 8d091550d66a129780caa7cdc882d2adb7fc9f63 Mon Sep 17 00:00:00 2001
From: Luma <luma@simplyluma.com>
Date: Thu, 22 Oct 2026 23:47:34 -0400
Subject: [PATCH 49/88] ASoC: google: aoc: let the telephony endpoint take the
 speaker formats

The endpoint only ever opened at 16 kHz mono, the call media format.
Nothing reaches the AOC from it, so that shape only mattered to the
mixer above: swapping the speaker sink for one of a different rate and
channel count made its clients renegotiate, which failed and left them
silent after the call. Accept the speaker stream's formats and rates
too, so a sink on the endpoint replaces the speaker sink like for like.
---
 sound/soc/google/aoc-audio.c | 23 ++++++++++++++---------
 1 file changed, 14 insertions(+), 9 deletions(-)

diff --git a/sound/soc/google/aoc-audio.c b/sound/soc/google/aoc-audio.c
index 0779aa5fb..b12ad0301 100644
--- a/sound/soc/google/aoc-audio.c
+++ b/sound/soc/google/aoc-audio.c
@@ -949,16 +949,20 @@ static const struct snd_pcm_hardware aoc_pcm_hw = {
  * 48000/2, the speaker's rate, which is not a configuration the voice path
  * ever has.
  *
- * Nothing is written here, so the buffer sizes only have to be legal.
+ * Nothing reaches the AOC from here (the stream runs on the clock), so the
+ * endpoint also takes what the speaker stream takes: a sink opened on it then
+ * has the same shape as the one it replaces, and the mixer graph above it
+ * does not have to renegotiate.
  */
 static const struct snd_pcm_hardware aoc_voice_hw = {
 	.info = SNDRV_PCM_INFO_INTERLEAVED | SNDRV_PCM_INFO_BLOCK_TRANSFER,
-	.formats = SNDRV_PCM_FMTBIT_S16_LE,
-	.rates = SNDRV_PCM_RATE_16000,
+	.formats = SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S32_LE,
+	.rates = SNDRV_PCM_RATE_16000 | SNDRV_PCM_RATE_44100 |
+		 SNDRV_PCM_RATE_48000,
 	.rate_min = 16000,
-	.rate_max = 16000,
+	.rate_max = 48000,
 	.channels_min = 1,
-	.channels_max = 1,
+	.channels_max = 2,
 	.buffer_bytes_max = AOC_PCM_BUFFER_BYTES,
 	.period_bytes_min = 256,
 	.period_bytes_max = 65536,
@@ -1560,11 +1564,12 @@ static struct snd_soc_dai_driver aoc_dais[] = {
 		.name = "aoc-voice-fe",
 		.playback = {
 			.stream_name = "AOC Voice",
-			/* Call media is 16 kHz mono; see aoc_voice_hw. */
+			/* Call media and the speaker shapes; see aoc_voice_hw. */
 			.channels_min = 1,
-			.channels_max = 1,
-			.rates = SNDRV_PCM_RATE_16000,
-			.formats = SNDRV_PCM_FMTBIT_S16_LE,
+			.channels_max = 2,
+			.rates = SNDRV_PCM_RATE_16000 | SNDRV_PCM_RATE_44100 |
+				 SNDRV_PCM_RATE_48000,
+			.formats = SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S32_LE,
 		},
 	},
 	{
