From 00f7fe083ef518039a6e876a7f797cfd36eabfbf Mon Sep 17 00:00:00 2001
From: Luma <luma@simplyluma.com>
Date: Thu, 22 Oct 2026 16:26:33 -0400
Subject: [PATCH 44/88] ASoC: google: aoc: keep the playback pointer within
 what was written

The playback pointer was the AOC's read counter less its value at
prepare. A restart of that counter after prepare made the difference
wrap, ran the hardware pointer past the application's and put every
stream, and every recovery from it, straight into an underrun. Advance
the position by the counter's steps instead, only as far as data was
handed to the ring, and follow the counter across a step that cannot be
a read.
---
 sound/soc/google/aoc-audio.c | 46 ++++++++++++++++++++++++++++++++----
 1 file changed, 41 insertions(+), 5 deletions(-)

diff --git a/sound/soc/google/aoc-audio.c b/sound/soc/google/aoc-audio.c
index 2066b20d0..47720c2b6 100644
--- a/sound/soc/google/aoc-audio.c
+++ b/sound/soc/google/aoc-audio.c
@@ -20,6 +20,7 @@
 #include <linux/completion.h>
 #include <linux/delay.h>
 #include <linux/hrtimer.h>
+#include <linux/math64.h>
 #include <linux/workqueue.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
@@ -360,7 +361,10 @@ struct aoc_audio_stream {
 	bool playback;
 	u8 source;				/* AOC entry point = PCM device */
 	bool voice;				/* the telephony endpoint */
-	u32 base;				/* AOC byte position at start */
+	u32 rx_prev;				/* AOC read counter last seen */
+	u64 consumed;				/* bytes the AOC has read since prepare */
+	unsigned int jumps;			/* read-counter discontinuities seen */
+	struct device *dev;
 	snd_pcm_uframes_t pushed;		/* frames handed to the ring */
 	spinlock_t ring_lock;			/* serialises ring fill: .ack vs tick */
 };
@@ -1042,6 +1046,7 @@ static int aoc_pcm_open(struct snd_soc_component *comp,
 		return -ENOMEM;
 	s->svc = svc;
 	s->substream = substream;
+	s->dev = comp->dev;
 	s->playback = playback;
 	spin_lock_init(&s->ring_lock);
 	hrtimer_setup(&s->tick, aoc_pcm_tick, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
@@ -1085,6 +1090,31 @@ static int aoc_pcm_new(struct snd_soc_component *comp,
 	return 0;
 }
 
+/*
+ * Advance the playback position by what the AOC has read since the last look.
+ * Its read counter can only move up to what was written; a step past that is
+ * the AOC restarting its count (as on an endpoint start), not consumption, so
+ * the position stays put and follows the counter from there.  Reporting such a
+ * step as reads ran the hardware pointer past the application's and the
+ * stream into an underrun on every start.
+ */
+static void aoc_pcm_update_consumed(struct aoc_audio_stream *s)
+{
+	struct snd_pcm_runtime *rt = s->substream->runtime;
+	u32 rx = aoc_service_progress(s->svc, true);
+	u32 delta = rx - s->rx_prev;
+	u64 written = frames_to_bytes(rt, s->pushed);
+
+	if (s->consumed + delta > written) {
+		if (s->jumps++ < 8)
+			dev_warn(s->dev, "playback: AOC read counter %u -> %u with %llu of %llu bytes read, following it\n",
+				 s->rx_prev, rx, s->consumed, written);
+	} else {
+		s->consumed += delta;
+	}
+	s->rx_prev = rx;
+}
+
 static int aoc_pcm_prepare(struct snd_soc_component *comp,
 			   struct snd_pcm_substream *substream)
 {
@@ -1093,8 +1123,10 @@ static int aoc_pcm_prepare(struct snd_soc_component *comp,
 	if (aoc_pcm_is_be(substream))
 		return 0;
 
-	s->base = aoc_service_progress(s->svc, s->playback);
-	s->prev_consumed = s->base;
+	s->rx_prev = aoc_service_progress(s->svc, s->playback);
+	s->prev_consumed = s->rx_prev;
+	s->consumed = 0;
+	s->jumps = 0;
 	s->pushed = 0;
 	return 0;
 }
@@ -1184,14 +1216,18 @@ static snd_pcm_uframes_t aoc_pcm_pointer(struct snd_soc_component *comp,
 	struct snd_pcm_runtime *rt = substream->runtime;
 	struct aoc_audio_stream *s = rt->private_data;
 	u32 buf_bytes = frames_to_bytes(rt, rt->buffer_size);
+	unsigned long flags;
 	u32 pos;
 
 	/* Capture position is what we have moved into the buffer ourselves. */
 	if (!s->playback)
 		return s->pushed % rt->buffer_size;
 
-	pos = aoc_service_progress(s->svc, s->playback) - s->base;
-	return bytes_to_frames(rt, pos % buf_bytes);
+	spin_lock_irqsave(&s->ring_lock, flags);
+	aoc_pcm_update_consumed(s);
+	div_u64_rem(s->consumed, buf_bytes, &pos);
+	spin_unlock_irqrestore(&s->ring_lock, flags);
+	return bytes_to_frames(rt, pos);
 }
 
 /* Program the AOC endpoint before it is started, from the negotiated format. */
