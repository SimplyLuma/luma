From f80f471bb5c0be5ba9d030a766e47cd9c24f2a76 Mon Sep 17 00:00:00 2001
From: Luma <luma@simplyluma.com>
Date: Sun, 25 Oct 2026 18:01:24 -0400
Subject: [PATCH 61/88] thermal: samsung: add S2MPG15 thermistor channels

The eight NTC inputs of the S2MPG15 meter block as thermal-of sensors, as an MFD cell bound by compatible. Channel enable sequence and ADC-to-temperature table from Google's s2mpg15_spmic_thermal driver (google-modules/soc/gs 3045cdcfebf9, GPL-2.0). Reads only; the PMIC over-temperature thresholds and interrupts are not programmed, trips are polled, and a sudden jump is held for 30 s before it is believed.
---
 drivers/mfd/sec-common.c                      |   1 +
 drivers/thermal/samsung/Kconfig               |   9 +
 drivers/thermal/samsung/Makefile              |   1 +
 drivers/thermal/samsung/s2mpg15-ntc-thermal.c | 251 ++++++++++++++++++
 4 files changed, 262 insertions(+)
 create mode 100644 drivers/thermal/samsung/s2mpg15-ntc-thermal.c

diff --git a/drivers/mfd/sec-common.c b/drivers/mfd/sec-common.c
index 1fbc96fbd..7b997a363 100644
--- a/drivers/mfd/sec-common.c
+++ b/drivers/mfd/sec-common.c
@@ -68,6 +68,7 @@ static const struct mfd_cell s2mpg15_devs[] = {
 	MFD_CELL_NAME("s2mpg15-meter"),
 	MFD_CELL_NAME("s2mpg15-regulator"),
 	MFD_CELL_OF("s2mpg15-gpio", NULL, NULL, 0, 0, "samsung,s2mpg15-gpio"),
+	MFD_CELL_OF("s2mpg15-ntc", NULL, NULL, 0, 0, "samsung,s2mpg15-ntc"),
 };
 
 static const struct resource s2mps11_rtc_resources[] = {
diff --git a/drivers/thermal/samsung/Kconfig b/drivers/thermal/samsung/Kconfig
index 6ee721a62..804502dc2 100644
--- a/drivers/thermal/samsung/Kconfig
+++ b/drivers/thermal/samsung/Kconfig
@@ -11,6 +11,15 @@ config EXYNOS_THERMAL
