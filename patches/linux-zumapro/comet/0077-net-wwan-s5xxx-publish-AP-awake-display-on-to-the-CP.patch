From f4a0b6c011f9fd79676816227177f5aeb9a54bf5 Mon Sep 17 00:00:00 2001
From: Luma <luma@simplyluma.com>
Date: Mon, 26 Oct 2026 14:02:15 -0400
Subject: [PATCH 77/88] net: wwan: s5xxx: publish AP awake + display on to the
 CP, follow its wakelock

ap2cp_united_status carried only ds_det, so the CP read the AP as asleep with
the display off and held every unsolicited message until the AP next
transmitted. Publish pda_active (bit 5) and lcd_status (bit 27) as stock does,
announce them on doorbells 3 and 4 at ONLINE, clear/restore pda_active across
system sleep, and hold a wakeup source while the CP asserts its cp2ap wakelock
bit. ap_awake=0 restores the old word.
---
 drivers/net/wwan/s5xxx_modem.c | 80 +++++++++++++++++++++++++++++++++-
 1 file changed, 79 insertions(+), 1 deletion(-)

diff --git a/drivers/net/wwan/s5xxx_modem.c b/drivers/net/wwan/s5xxx_modem.c
index f77000e9d..afcea8187 100644
--- a/drivers/net/wwan/s5xxx_modem.c
+++ b/drivers/net/wwan/s5xxx_modem.c
@@ -269,6 +269,8 @@ struct s5xxx_variant {
  * FMT/RAW rings are CP-paced and stay open.
  */
 #define S5XXX_CP2AP_FLOWCTL		BIT(2)
+/* cp2ap_united_status wakelock (stock sbi_cp2ap_wakelock_pos=6, irq 8). */
+#define S5XXX_CP2AP_WAKELOCK		BIT(6)
 /*
  * Handover block (downstream ap2cp_handover_block_info = <0x02 0x82c>): a
  * 161-byte struct t_handover_block_info the AP stages before BL1, carrying the
@@ -331,6 +333,16 @@ struct s5xxx_variant {
  * IPC.  Published in s5xxx_init_control_messages().
  */
 #define S5XXX_IPC_DS_DET		(1u << 14)		/* 0x4000 */
+/*
+ * The rest of ap2cp_united_status the CP reads as the AP's state (stock cpif
+ * sbi_pda_active_pos=5, sbi_lcd_status_pos=27).  Left at 0 the word says the
+ * AP is asleep with the display off, and the CP holds every unsolicited
+ * message -- indications, late answers, GIPC requests -- until the AP next
+ * transmits.  Each change is announced on its own doorbell (stock
+ * int_ap2cp_active=3, int_ap2cp_lcd_status=4).
+ */
+#define S5XXX_IPC_PDA_ACTIVE		(1u << 5)
+#define S5XXX_IPC_LCD_STATUS		(1u << 27)
 
 #define S5XXX_IPC_SRINFO_OFFSET		0x400000
 #define S5XXX_IPC_SRINFO_SIZE		0x300000
@@ -409,6 +421,8 @@ struct s5xxx_variant {
 #define S5XXX_DB_TRIGGER		BIT(16)
 #define S5XXX_DB_MSG			(S5XXX_DB_TRIGGER | 0x0)	/* int_ap2cp_msg */
 #define S5XXX_DB_LINK_ACK		(S5XXX_DB_TRIGGER | 0xe)	/* pcie_link_ack */
+#define S5XXX_DB_ACTIVE			(S5XXX_DB_TRIGGER | 0x3)	/* int_ap2cp_active */
+#define S5XXX_DB_LCD			(S5XXX_DB_TRIGGER | 0x4)	/* int_ap2cp_lcd_status */
 
 /* PBL lands at IPC base + this offset (round_up(raw buffer offset, 64K)). */
 #define S5XXX_BOOT_IMG_OFFSET		0x10000
@@ -706,6 +720,8 @@ struct s5xxx_modem {
 	bool			ul_active;
 	bool			tx_suspended;	/* CP TX flow control (cp2ap_status) */
 	int			nvec;		/* MSI vectors actually allocated */
+	struct wakeup_source	*cp_ws;		/* held while the CP asserts its wakelock */
+	bool			cp_wakelock;
 };
 
 /*
@@ -1015,6 +1031,47 @@ static void s5xxx_send_ipc_irq(struct s5xxx_modem *sm, u32 val)
  * address.  MAIN rebuilds its own inbound doorbell decode on its link-up ISR;
  * this repairs the AP-side outbound routing the PERST cycle reset.
  */
+static bool ap_awake = true;
+module_param(ap_awake, bool, 0444);
+MODULE_PARM_DESC(ap_awake,
+		 "publish pda_active + lcd_status in ap2cp_united_status (0: ds_det only)");
+
+/* Set or clear one ap2cp_united_status field and ring its doorbell. */
+static void s5xxx_ap_status_update(struct s5xxx_modem *sm, u32 bit, bool on,
+				   u32 db)
+{
+	unsigned long flags;
+	bool rang = false;
+	u32 v;
+
+	spin_lock_irqsave(&sm->lock, flags);
+	v = readl(sm->ipc + S5XXX_IPC_AP2CP_STATUS);
+	v = on ? (v | bit) : (v & ~bit);
+	writel(v, sm->ipc + S5XXX_IPC_AP2CP_STATUS);
+	if (sm->link_up)
+		rang = s5xxx_send_doorbell(sm, db);
+	spin_unlock_irqrestore(&sm->lock, flags);
+	dev_info(sm->dev, "ap2cp_united_status %#x (doorbell %#x %s)\n", v, db,
+		 rang ? "rung" : "not rung: link parked");
+}
+
+/* Follow the CP's wakelock bit on every CP interrupt. */
+static void s5xxx_cp_wakelock_check(struct s5xxx_modem *sm)
+{
+	bool held = readl(sm->ipc + S5XXX_IPC_CP2AP_STATUS) & S5XXX_CP2AP_WAKELOCK;
+
+	if (held == READ_ONCE(sm->cp_wakelock))
+		return;
+	WRITE_ONCE(sm->cp_wakelock, held);
+	if (sm->cp_ws) {
+		if (held)
+			__pm_stay_awake(sm->cp_ws);
+		else
+			__pm_relax(sm->cp_ws);
+	}
+	dev_dbg(sm->dev, "CP wakelock %s\n", held ? "held" : "released");
+}
+
 static void s5xxx_relink_restore(struct s5xxx_modem *sm)
 {
 	pci_set_power_state(sm->pdev, PCI_D0);
@@ -1099,6 +1156,7 @@ static irqreturn_t s5xxx_tx_state_irq(int irq, void *data)
 	u32 status = readl(sm->ipc + S5XXX_IPC_CP2AP_STATUS);
 	bool suspend = status & S5XXX_CP2AP_FLOWCTL;
 
+	s5xxx_cp_wakelock_check(sm);
 	if (suspend == READ_ONCE(sm->tx_suspended))
 		return IRQ_HANDLED;
 
@@ -1505,7 +1563,9 @@ static void s5xxx_init_control_messages(struct s5xxx_modem *sm)
 	 * ds_det=0 keeps the link pinned at L0 -- diagnostic for the post-ONLINE
 	 * crash, and not what stock does (stock ap2cp_united reads 0x4000).
 	 */
-	writel(ds_det ? S5XXX_IPC_DS_DET : 0, sm->ipc + S5XXX_IPC_AP2CP_STATUS);
+	writel((ds_det ? S5XXX_IPC_DS_DET : 0) |
+	       (ap_awake ? S5XXX_IPC_PDA_ACTIVE | S5XXX_IPC_LCD_STATUS : 0),
+	       sm->ipc + S5XXX_IPC_AP2CP_STATUS);
 	writel(0, sm->ipc + S5XXX_IPC_CP2AP_STATUS);
 	for (i = 0; i < S5XXX_IPC_CAP_WORDS; i++)
 		writel(0, sm->ipc + S5XXX_IPC_CAP_BASE + 4 * i);
@@ -3327,6 +3387,12 @@ static void s5xxx_online(struct s5xxx_modem *sm)
 	}
 	mutex_unlock(&sm->pcie_onoff_lock);
 
+	/* Tell the CP the AP is awake with the display on (stock power_on_cp + LCD notifier). */
+	if (ap_awake) {
+		s5xxx_ap_status_update(sm, S5XXX_IPC_PDA_ACTIVE, true, S5XXX_DB_ACTIVE);
+		s5xxx_ap_status_update(sm, S5XXX_IPC_LCD_STATUS, true, S5XXX_DB_LCD);
+	}
+
 	if (sm->cp_active)
 		dev_info(sm->dev, "CP2AP_PHONE_ACTIVE at ONLINE: %d\n",
 			 gpiod_get_value_cansleep(sm->cp_active));
@@ -3492,6 +3558,7 @@ static irqreturn_t s5xxx_irq_handler(int irq, void *data)
 	 * otherwise a DL-only interrupt returns here having done nothing.
 	 */
 	if (sm->online) {
+		s5xxx_cp_wakelock_check(sm);
 		s5xxx_pktproc_dl_drain(sm);
 		/* Any CP interrupt may come with txq space freed. */
 		wake_up_interruptible(&sm->fmt_tx_wq);
@@ -5242,6 +5309,7 @@ static int s5xxx_probe(struct platform_device *pdev)
 		dev_err(dev, "CP2AP_WAKEUP enable_irq_wake: %d\n", ret);
 		goto err_cp2ap_irq;
 	}
+	sm->cp_ws = wakeup_source_register(dev, "s5xxx-cp-wakelock");
 
 	/*
 	 * Armed from the start (unlike the wakeup IRQ): logs the CP coming
@@ -5281,6 +5349,8 @@ static int s5xxx_probe(struct platform_device *pdev)
 		free_irq(pci_irq_vector(sm->pdev, 1), sm);
 err_irq0:
 	free_irq(pci_irq_vector(sm->pdev, 0), sm);
+	wakeup_source_unregister(sm->cp_ws);
+	sm->cp_ws = NULL;
 err_vectors:
 	pci_free_irq_vectors(sm->pdev);
 err_disable:
@@ -5317,6 +5387,8 @@ static void s5xxx_remove(struct platform_device *pdev)
 	if (sm->nvec > 1)
 		free_irq(pci_irq_vector(sm->pdev, 1), sm);
 	free_irq(pci_irq_vector(sm->pdev, 0), sm);
+	wakeup_source_unregister(sm->cp_ws);
+	sm->cp_ws = NULL;
 	/* Main IRQ gone -> no more DL drains or RFS enqueues. */
 	for (i = 0; i < S5XXX_PDP_CH_COUNT; i++)
 		if (sm->ndev[i])
@@ -5365,6 +5437,8 @@ static int s5xxx_suspend_noirq(struct device *dev)
 		return -EBUSY;
 	}
 
+	if (ap_awake)
+		s5xxx_ap_status_update(sm, S5XXX_IPC_PDA_ACTIVE, false, S5XXX_DB_ACTIVE);
 	s5xxx_publish_kernel_time(sm);
 	return zumapro_pcie_modem_set_ap_active(sm->rc_dev, false);
 }
@@ -5378,6 +5452,8 @@ static int s5xxx_resume_noirq(struct device *dev)
 
 	s5xxx_publish_kernel_time(sm);
 	ret = zumapro_pcie_modem_set_ap_active(sm->rc_dev, true);
+	if (ap_awake)
+		s5xxx_ap_status_update(sm, S5XXX_IPC_PDA_ACTIVE, true, S5XXX_DB_ACTIVE);
 
 	/*
 	 * The work runs only once pm_wq thaws, i.e. after every device resume
@@ -5437,6 +5513,8 @@ static void s5xxx_shutdown(struct platform_device *pdev)
 	if (sm->nvec > 1)
 		free_irq(pci_irq_vector(sm->pdev, 1), sm);
 	free_irq(pci_irq_vector(sm->pdev, 0), sm);
+	wakeup_source_unregister(sm->cp_ws);
+	sm->cp_ws = NULL;
 	cancel_work_sync(&sm->rfs_work);
 	dev_info(sm->dev, "quiesced for shutdown\n");
 }
