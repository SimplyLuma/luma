From d4e326b71648c9af91d9a60ec5ec04dc4e9b84bc Mon Sep 17 00:00:00 2001
From: Nick McMillen <153555205+nmcmil@users.noreply.github.com>
Date: Sat, 31 Oct 2026 21:22:47 -0400
Subject: [PATCH 91/91] arm64: luma: keep the bootloader write zone of the
 Image empty

The Pixel bootloader writes a 0xa00-byte table at Image offset 0x1800000
after loading the kernel and before entering it. It corrupted whatever
the kernel had there: the built-in initramfs (cpio headers, firmware
files) and, as the kernel grows, init data and code.

Leave [LUMA_FW_HOLE_START, LUMA_FW_HOLE_END) of the Image empty and
start init text after it; the padding is freed with init memory. The
link fails if text and rodata ever reach the zone.
---
 arch/arm64/Kconfig              | 16 ++++++++++++++++
 arch/arm64/kernel/vmlinux.lds.S | 13 +++++++++++++
 2 files changed, 29 insertions(+)

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index d6cf09dd6..8e7cc387d 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2528,6 +2528,22 @@ config LUMA_EMBEDDED_DTB
 	  out of init memory before unflattening. For bounded Project Luma
 	  bring-up kernels booted with fastboot boot only; not a release option.
 
+config LUMA_FW_HOLE_START
+	hex "Start of the Image range the bootloader writes before entry"
+	depends on LUMA_EMBEDDED_DTB
+	default 0x17f0000
+	help
+	  The Pixel 9 / 9 Pro Fold bootloader writes a 0xa00-byte table at
+	  Image offset 0x1800000 after it has loaded the kernel and before it
+	  jumps to it.  The linker keeps [LUMA_FW_HOLE_START, LUMA_FW_HOLE_END)
+	  of the Image empty: init text, init data and the built-in initramfs
+	  start after it, and the link fails if text or rodata reach it.
+
+config LUMA_FW_HOLE_END
+	hex "End of the Image range the bootloader writes before entry"
+	depends on LUMA_EMBEDDED_DTB
+	default 0x1840000
+
 config EFI_STUB
 	bool
 
diff --git a/arch/arm64/kernel/vmlinux.lds.S b/arch/arm64/kernel/vmlinux.lds.S
index af1d72020..584192d7f 100644
--- a/arch/arm64/kernel/vmlinux.lds.S
+++ b/arch/arm64/kernel/vmlinux.lds.S
@@ -250,6 +250,19 @@ SECTIONS
 	__init_begin = .;
 	__inittext_begin = .;
 
+#ifdef CONFIG_LUMA_EMBEDDED_DTB
+	/*
+	 * The bootloader writes into the loaded Image at a fixed offset before
+	 * it enters the kernel.  Leave that range empty and start init text
+	 * there; it is freed with the rest of init memory.
+	 */
+	ASSERT(. - KIMAGE_VADDR <= CONFIG_LUMA_FW_HOLE_START,
+	       "text and rodata reach the bootloader write zone (LUMA_FW_HOLE_START)")
+	__luma_fw_hole_start = .;
+	. = MAX(., KIMAGE_VADDR + CONFIG_LUMA_FW_HOLE_END);
+	__luma_fw_hole_end = .;
+
+#endif
 	INIT_TEXT_SECTION(8)
 
 	__exittext_begin = .;
