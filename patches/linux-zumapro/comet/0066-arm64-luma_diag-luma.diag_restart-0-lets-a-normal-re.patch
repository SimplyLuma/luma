From e5d194871addf2d760900c37a6bc08f631df2262 Mon Sep 17 00:00:00 2001
From: Luma <luma@simplyluma.com>
Date: Sun, 25 Oct 2026 17:51:38 -0400
Subject: [PATCH 66/88] arm64: luma_diag: luma.diag_restart=0 lets a normal
 restart boot

---
 arch/arm64/kernel/luma_diag.c | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/kernel/luma_diag.c b/arch/arm64/kernel/luma_diag.c
index a19b6ec25..c8b0da51a 100644
--- a/arch/arm64/kernel/luma_diag.c
+++ b/arch/arm64/kernel/luma_diag.c
@@ -6,6 +6,7 @@
  * instead of booting the installed OS over the log.
  */
 #include <linux/init.h>
+#include <linux/kstrtox.h>
 #include <linux/notifier.h>
 #include <linux/panic_notifier.h>
 #include <linux/printk.h>
@@ -16,6 +17,15 @@
 #define LUMA_PMU_SYSIP_DAT0	0x0810
 #define LUMA_REBOOT_BOOTLOADER	0xfc
 
+/* luma.diag_restart=0: only panics go to fastboot, a normal restart boots */
+static bool luma_diag_restart = true;
+
+static int __init luma_diag_restart_param(char *s)
+{
+	return kstrtobool(s, &luma_diag_restart) ? -EINVAL : 0;
+}
+early_param("luma.diag_restart", luma_diag_restart_param);
+
 /*
  * Registered at early_initcall, before the PMU probes, so a panic in an early
  * built-in driver is covered too; the PMU regmap is looked up when needed.
@@ -43,8 +53,10 @@ static struct notifier_block luma_diag_reboot_nb = {
 static int __init luma_diag_init(void)
 {
 	atomic_notifier_chain_register(&panic_notifier_list, &luma_diag_nb);
-	register_reboot_notifier(&luma_diag_reboot_nb);
-	pr_info("luma-diag: panic and restart go to the bootloader\n");
+	if (luma_diag_restart)
+		register_reboot_notifier(&luma_diag_reboot_nb);
+	pr_info("luma-diag: panic%s go to the bootloader\n",
+		luma_diag_restart ? " and restart" : "");
 	return 0;
 }
 early_initcall(luma_diag_init);
