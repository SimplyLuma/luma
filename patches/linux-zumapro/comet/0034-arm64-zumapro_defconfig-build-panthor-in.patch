From 6e809a3d6ab9fedeaa54869545c81b2be9a10806 Mon Sep 17 00:00:00 2001
From: Luma <luma@simplyluma.com>
Date: Wed, 21 Oct 2026 17:37:54 -0400
Subject: [PATCH 34/88] arm64: zumapro_defconfig: build panthor in

Built in, panthor needs arm/mali/arch11.8/mali_csffw.bin at probe time,
from the initramfs or CONFIG_EXTRA_FIRMWARE.
---
 arch/arm64/configs/zumapro_defconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/configs/zumapro_defconfig b/arch/arm64/configs/zumapro_defconfig
index 05903820f..3b633e70b 100644
--- a/arch/arm64/configs/zumapro_defconfig
+++ b/arch/arm64/configs/zumapro_defconfig
@@ -403,7 +403,7 @@ CONFIG_DRM_PANEL_SAMSUNG_S6E63M0=y
 CONFIG_DRM_PANEL_SAMSUNG_S6E63M0_DSI=y
 CONFIG_DRM_PANEL_SAMSUNG_S6E8AA0=y
 CONFIG_DRM_PANEL_SAMSUNG_SOFEF00=y
-CONFIG_DRM_PANTHOR=m
+CONFIG_DRM_PANTHOR=y
 CONFIG_DRM_SIMPLEDRM=y
 CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
 CONFIG_DRM_UDL=y
