From 93bfd65eb68fbb93a9ccb221b3c767a61c2775d6 Mon Sep 17 00:00:00 2001
From: Luma <luma@simplyluma.com>
Date: Sun, 25 Oct 2026 18:01:40 -0400
Subject: [PATCH 82/88] soc: google: aoc: log_info parameter for the AOC log

The AOC log is drained at debug level.  log_info=1, writable at runtime,
prints it at info level.
---
 drivers/soc/google/aoc.c | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/google/aoc.c b/drivers/soc/google/aoc.c
index 79999beac..fb5fdd68d 100644
--- a/drivers/soc/google/aoc.c
+++ b/drivers/soc/google/aoc.c
@@ -1278,6 +1278,15 @@ static int aoc_ipc_init(struct aoc_data *aoc, struct platform_device *pdev)
  * read all work against the live firmware.  We poll for the reply rather than
  * wait on the interrupt so the data path is validated even if delivery is not.
  */
+/*
+ * The AOC's own log is drained at debug level; log_info=1 (writable at
+ * runtime) prints it at info level instead, for a bring-up step whose only
+ * account is what the AOC says about it.
+ */
+static bool log_info;
+module_param(log_info, bool, 0644);
+MODULE_PARM_DESC(log_info, "print the AOC log at info level");
+
 static void aoc_log_work(struct work_struct *w)
 {
 	struct aoc_data *aoc = container_of(to_delayed_work(w), struct aoc_data,
@@ -1290,7 +1299,10 @@ static void aoc_log_work(struct work_struct *w)
 		if (ret <= 0)
 			break;
 		buf[ret] = '\0';
-		dev_dbg(aoc->dev, "AOC: %s\n", buf);
+		if (log_info)
+			dev_info(aoc->dev, "AOC: %s\n", buf);
+		else
+			dev_dbg(aoc->dev, "AOC: %s\n", buf);
 	}
 	schedule_delayed_work(&aoc->log_work, msecs_to_jiffies(200));
 }
