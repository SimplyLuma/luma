+++ b/arch/arm64/boot/dts/exynos/google/zumapro-comet.dts
@@ -244,7 +244,7 @@ controller-data {
  * Read-only: nothing here writes the gauge.
  */
 &hsi2c_10 {
-	fuel-gauge@36 {
+	max17201_fg: fuel-gauge@36 {
 		compatible = "maxim,max17201";
 		reg = <0x36>, <0x0b>;
 		reg-names = "m5", "nvmem";
@@ -252,6 +252,25 @@ fuel-gauge@36 {
 	};
 };
 
+/*
+ * Wired charging by battery temperature, from the vendor google,battery
+ * profile: its temperature bands (0, 10, 20, 42, 46, 48, 55 C) and, per band,
+ * the highest voltage tier with a non-zero rate as the float voltage and the
+ * lowest non-zero rate up to it as the current (rates are % of the 4560 mAh
+ * pack). The driver caps that at 1.5 A input, 1 A charge and 4.40 V (the
+ * vendor charger's own chg-term-voltage), below the vendor step-charging
+ * maximum. Outside 0..55 C charging pauses; the charger's own JEITA stays on.
+ * The temperature is the hotter of the two gauges.
+ */
+&max77779_pmic {
+	maxim,charge-temp-limits-decicelsius = <0 100 200 420 460 480 550>;
+	maxim,charge-current-microamp = <456000 1000000 1000000 1000000 1000000 1000000>;
+	maxim,charge-float-voltage-millivolt = <4300 4400 4400 4400 4250 4100>;
+	maxim,input-current-max-microamp = <1500000>;
+	maxim,battery-temperature-supply = <&max77779_fg>;
+	maxim,battery-temperature-supply-secondary = <&max17201_fg>;
+};
+
 /delete-node/ &eusb_repeater;
 
 &hsi2c_6 {
