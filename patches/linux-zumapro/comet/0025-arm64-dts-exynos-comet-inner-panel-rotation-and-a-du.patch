--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/google/zumapro-comet-dual.dts
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Pixel 9 Pro Fold (comet), both screens through the Exynos DRM path:
+ * DECON1 -> DSIM0 -> outer CT3D and DECON0 -> DSIM1 -> inner CT3B, each with
+ * its own plane (GF1, GF0). Which screen is in use follows the hinge (SW_LID
+ * on gpio-keys); that policy belongs to userspace.
+ */
+
+#include "zumapro-comet-panel.dts"
+
+/ {
+	model = "Pixel 9 Pro Fold (dual display)";
+};
+
+&soc {
+	dsim1: dsi@19450000 {
+		compatible = "google,zuma-dsim";
+		reg = <0x19450000 0x300>,	/* dsi         */
+		      <0x19460900 0x700>,	/* dphy        */
+		      <0x19460000 0x100>;	/* dphy-extra, shared with DSIM0 */
+		reg-names = "dsi", "dphy", "dphy-extra";
+		interrupts = <GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH 0>;
+		clocks = <&cmu_dpu CLK_GOUT_DPU_PCLK>;
+		clock-names = "bus_clk";
+		power-domains = <&pd_dpuf0>;
+		samsung,disp-sysreg = <&sysreg_dpu>;
+		google,dsim-index = <1>;
+		google,dsc-comp-align = <1>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&disp_te_sec_on>;
+		te-gpio = <&gpp0 4 0>;
+
+		inner_panel: panel@0 {
+			compatible = "google,gs-ct3b";
+			reg = <0>;
+			/* scans out with its top on the device's left */
+			rotation = <270>;
+
+			port {
+				inner_panel_in: endpoint {
+					remote-endpoint = <&dsim1_out>;
+				};
+			};
+		};
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				dsim1_in: endpoint {
+					remote-endpoint = <&decon0_inner_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+				dsim1_out: endpoint {
+					remote-endpoint = <&inner_panel_in>;
+				};
+			};
+		};
+	};
+};
+
+/* zumapro-comet-panel.dts deleted decon0's DSIM0 endpoint; point it at DSIM1 */
+&decon0 {
+	status = "okay";
+	google,dsc-single-encoder;
+	google,te-from = <1>;
+	google,dsi-output = <1>;
+
+	ports {
+		port@0 {
+			decon0_inner_out: endpoint {
+				remote-endpoint = <&dsim1_in>;
+			};
+		};
+	};
+};
+
+&dpp0 {
+	status = "okay";
+};
