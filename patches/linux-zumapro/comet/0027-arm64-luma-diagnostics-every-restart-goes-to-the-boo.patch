From 1c7d751411961c1a34ac2021077107723db7e96f Mon Sep 17 00:00:00 2001
From: Project-Luma <dev@simplyluma.com>
Date: Tue, 20 Oct 2026 22:19:38 -0400
Subject: [PATCH 27/88] arm64: luma diagnostics: every restart goes to the
 bootloader

A normal reboot from the booted OS also boots the installed Android over
the ramoops log; send all restarts of a diagnostic kernel to fastboot.
---
 arch/arm64/kernel/luma_diag.c | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/kernel/luma_diag.c b/arch/arm64/kernel/luma_diag.c
index 089f0b1ed..62d0658fc 100644
--- a/arch/arm64/kernel/luma_diag.c
+++ b/arch/arm64/kernel/luma_diag.c
@@ -1,13 +1,15 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Luma RAM-boot diagnostics: on panic, set the Exynos PMU reboot reason to
- * "bootloader" (SYSIP_DAT0 = 0xfc, as syscon-reboot-mode does) so the phone
- * lands in fastboot with RAM, and so ramoops, intact.
+ * Luma RAM-boot diagnostics: on panic and on every restart, set the Exynos
+ * PMU reboot reason to "bootloader" (SYSIP_DAT0 = 0xfc, as syscon-reboot-mode
+ * does) so the phone lands in fastboot with RAM, and so ramoops, intact,
+ * instead of booting the installed OS over the log.
  */
 #include <linux/init.h>
 #include <linux/notifier.h>
 #include <linux/panic_notifier.h>
 #include <linux/printk.h>
+#include <linux/reboot.h>
 #include <linux/regmap.h>
 #include <linux/soc/samsung/exynos-pmu.h>
 
@@ -28,6 +30,12 @@ static struct notifier_block luma_diag_nb = {
 	.priority = INT_MAX,
 };
 
+/* runs first; syscon-reboot-mode may still override it for an explicit mode */
+static struct notifier_block luma_diag_reboot_nb = {
+	.notifier_call = luma_diag_panic,
+	.priority = INT_MAX,
+};
+
 static int __init luma_diag_init(void)
 {
 	struct regmap *pmu = exynos_get_pmu_regmap();
@@ -38,7 +46,8 @@ static int __init luma_diag_init(void)
 	}
 	luma_pmu = pmu;
 	atomic_notifier_chain_register(&panic_notifier_list, &luma_diag_nb);
-	pr_info("luma-diag: panic reboots to the bootloader\n");
+	register_reboot_notifier(&luma_diag_reboot_nb);
+	pr_info("luma-diag: panic and restart go to the bootloader\n");
 	return 0;
 }
 late_initcall(luma_diag_init);
