From f87310f831edafe940bec1f106ac96cf028b362a Mon Sep 17 00:00:00 2001
From: Luma <luma@simplyluma.com>
Date: Wed, 21 Oct 2026 14:01:14 -0400
Subject: [PATCH 32/88] arm64: dts: comet: inner touch contacts are 14 bytes

The checksum validates after 14-byte contact records.
---
 arch/arm64/boot/dts/exynos/google/zumapro-comet.dts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/google/zumapro-comet.dts b/arch/arm64/boot/dts/exynos/google/zumapro-comet.dts
index cce5dadd9..f7bcb8a14 100644
--- a/arch/arm64/boot/dts/exynos/google/zumapro-comet.dts
+++ b/arch/arm64/boot/dts/exynos/google/zumapro-comet.dts
@@ -119,8 +119,8 @@ inner_touch: touchscreen@0 {
 		reset-gpios = <&gpp1 1 GPIO_ACTIVE_LOW>;
 		vddio-supply = <&m_ldo25_reg>;
 		avdd-supply = <&m_ldo4_reg>;
-		/* contacts are 16 bytes, coordinates in 1/10 pixel */
-		goodix,touch-size = <16>;
+		/* contacts are 14 bytes, coordinates in 1/10 pixel */
+		goodix,touch-size = <14>;
 		touchscreen-size-x = <20760>;
 		touchscreen-size-y = <21520>;
 
