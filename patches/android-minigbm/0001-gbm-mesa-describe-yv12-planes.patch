+	if (!bo_layout_ready && format == DRM_FORMAT_YVU420_ANDROID)
+		drv_bo_from_format(bo, alloc_args.out_stride, height, format);
+	else if (!bo_layout_ready)
+		drv_bo_from_format(bo, alloc_args.out_stride, alloc_args.height, format);
 
