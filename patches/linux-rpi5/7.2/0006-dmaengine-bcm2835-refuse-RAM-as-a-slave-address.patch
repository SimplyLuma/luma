From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <maintainers@projectluma.org>
Date: Mon, 2 Nov 2026 12:32:24 -0600
Subject: [PATCH 6/8] dmaengine: bcm2835: refuse RAM as a slave address

Slave addresses are mapped with dma_map_resource(), which is for MMIO.
A client that still passes a legacy VideoCore bus address would make
the 40-bit engine write to system RAM. Fail the slave config instead.
---
 drivers/dma/bcm2835-dma.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/dma/bcm2835-dma.c b/drivers/dma/bcm2835-dma.c
index 4f6e660ed..4fa92d12c 100644
--- a/drivers/dma/bcm2835-dma.c
+++ b/drivers/dma/bcm2835-dma.c
@@ -29,6 +29,7 @@
 #include <linux/platform_device.h>
 #include <linux/slab.h>
 #include <linux/io.h>
+#include <linux/mm.h>
 #include <linux/spinlock.h>
 #include <linux/of.h>
 #include <linux/of_dma.h>
@@ -1135,6 +1136,19 @@ static int bcm2835_dma_slave_config(struct dma_chan *chan,
 {
 	struct bcm2835_chan *c = to_bcm2835_dma_chan(chan);
 
+	/*
+	 * Slave addresses are physical MMIO addresses, mapped with
+	 * dma_map_resource(). A client still passing a legacy bus address
+	 * would point the engine at system RAM; refuse it.
+	 */
+	if ((cfg->src_addr && pfn_valid(PHYS_PFN(cfg->src_addr))) ||
+	    (cfg->dst_addr && pfn_valid(PHYS_PFN(cfg->dst_addr)))) {
+		dev_err(chan->device->dev,
+			"slave address %pa/%pa is RAM, not MMIO\n",
+			&cfg->src_addr, &cfg->dst_addr);
+		return -EINVAL;
+	}
+
 	c->cfg = *cfg;
 
 	return 0;
