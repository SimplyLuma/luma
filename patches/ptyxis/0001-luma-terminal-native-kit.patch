+
+
+/* ── Luma ─────────────────────────────────────────────────────────────────
+ *
+ * The window frame, the title row, the identity, the close/minimise/maximise
+ * island and the island the terminal sits in are all drawn by the Application
+ * Kit's stylesheet, loaded at startup. Nothing about them is restated here.
+ *
+ * What is here is the one widget the kit has no equivalent for — the tab strip
+ * — and the two places Terminal differs from a kit application: the island
+ * carries the body's own inset, and the terminal keeps the island's corners.
+ */
+
+.luma-terminal-island { margin: 0 9px 9px 9px; }
+vte-terminal { border-radius: 0 0 10px 10px; }
+
+/* ── Tab strip ─────────────────────────────────────────────────────────── */
+
+/* 40px including padding and divider; 4px between items. */
+lumatabstrip {
+  font-family: Figtree, sans-serif;
+  /* GTK minima exclude padding and borders: 28 + 5 + 6 + 1 = 40. */
+  min-height: 28px;
+  padding: 5px 15px 6px 5px;
+  border-bottom: 1px solid alpha(@luma_line, 0.9);
+}
+
+/* 28px tall, 116 wide at the floor, ten-pixel corners all round. */
+lumatabstrip .luma-tab {
+  min-height: 28px;
+  /* 96 content pixels plus 20 padding pixels gives the 116px tab. */
+  min-width: 96px;
+  padding: 0 10px;
+  border-radius: 10px;
+  background: transparent;
+  color: @luma_muted;
+  font-size: 13px;
+  font-weight: 600;
+  box-shadow: none;
+}
+
+lumatabstrip .luma-tab:hover { background: @luma_hover; }
+lumatabstrip .luma-tab.active { background: mix(@luma_content, @luma_ink, 0.06); color: @luma_ink; }
+lumatabstrip .luma-tab-title { font-size: 13px; font-weight: 600; }
+
+/* Follow the platform treatment for both semantic status colours. */
+lumatabstrip .luma-tab-dot {
+  min-width: 7px;
+  min-height: 7px;
+  border-radius: 999px;
+  background: @luma_green;
+  transform: translateY(1px);
+  box-shadow: 0 0 0 3px alpha(@luma_green, 0.12);
+}
+
+lumatabstrip .luma-tab-dot.activity {
+  background: @luma_amber;
+  box-shadow: 0 0 0 3px alpha(@luma_amber, 0.13);
+  animation: luma-activity-dot 1.6s ease-in-out infinite;
+}
+
+@keyframes luma-activity-dot {
+  0%, 100% { opacity: 1; }
+  50% { opacity: 0.45; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  lumatabstrip .luma-tab-dot.activity { animation: none; }
+}
+
+/* The badge says what the tab is; the close sits in the same place and they
+ * cross-fade, so reaching for the close moves nothing. */
+lumatabstrip .luma-tab-badge {
+  color: @luma_muted;
+  font-size: 11px;
+  font-weight: 500;
+  transition: opacity 120ms ease;
+}
+
+lumatabstrip .luma-tab-close {
+  min-width: 16px;
+  min-height: 16px;
+  margin-right: 7px;
+  padding: 0;
+  border: 0;
+  border-radius: 10px;
+  background: transparent;
+  color: @luma_muted;
+  opacity: 0;
+  transition: opacity 120ms ease, background 120ms ease, color 120ms ease;
+}
+
+lumatabstrip .luma-tab-close image { -gtk-icon-size: 10px; }
+lumatabstrip .luma-tab:hover .luma-tab-badge { opacity: 0; }
+lumatabstrip .luma-tab:hover .luma-tab-close,
+lumatabstrip .luma-tab:focus-within .luma-tab-close { opacity: 1; }
+lumatabstrip .luma-tab-close:hover { background: alpha(@luma_ink, 0.13); color: @luma_ink; }
+
+lumatabstrip .luma-tab-new,
+lumatabstrip .luma-tab-overflow {
+  min-width: 28px;
+  min-height: 28px;
+  padding: 0;
+  border: 0;
+  border-radius: 10px;
+  background: transparent;
+  color: @luma_muted;
+  box-shadow: none;
+}
+
+lumatabstrip .luma-tab-new label { font-size: 17px; font-weight: 500; line-height: 1; transform: translate(0.5px, 1px); }
+lumatabstrip .luma-tab-overflow label { font-size: 11px; font-weight: 500; line-height: 1; letter-spacing: 0.08em; }
+lumatabstrip .luma-tab-new:hover,
+lumatabstrip .luma-tab-overflow:hover { background: @luma_hover; }
