+/* luma-tab-strip.c
+ *
+ * Copyright 2026 Project Luma
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * The tab strip Luma draws. Everything a tab *means* — which pages exist,
+ * which is selected, what closing one does, where a dragged tab lands — stays
+ * with the AdwTabView this strip is attached to. Only the drawing is ours, so
+ * upstream keeps owning the behaviour and this file stays rebaseable.
+ */
+
+#include "config.h"
+
+#include <glib/gi18n.h>
+
+#include "luma-tab-strip.h"
+#include "ptyxis-tab.h"
+
+struct _LumaTabStrip
+{
+  GtkWidget   parent_instance;
+
+  AdwTabView *view;
+  GListModel *pages;
+  GtkWidget  *box;
+  GtkWidget  *tabs;
+  GtkWidget  *new_tab;
+  GtkWidget  *overflow;
+  GtkPopover *profile_popover;
+
+  gulong      pages_changed_handler;
+  gulong      selected_handler;
+};
+
+enum {
+  PROP_0,
+  PROP_VIEW,
+  N_PROPS
+};
+
+static GParamSpec *properties[N_PROPS];
+
+G_DEFINE_FINAL_TYPE (LumaTabStrip, luma_tab_strip, GTK_TYPE_WIDGET)
+
+static void luma_tab_strip_rebuild (LumaTabStrip *self);
+
+/* What the tab is, rather than what it is called: the running command when
+ * there is one, otherwise the shell. The design puts this where the close
+ * button appears on hover, so it has to be short. */
+static char *
+luma_tab_strip_badge_for (PtyxisTab *tab)
+{
+  const char *command = ptyxis_tab_get_command_line (tab);
+  if (command != NULL && *command != 0)
+    {
+      g_auto(GStrv) parts = g_strsplit (command, " ", 2);
+      if (parts != NULL && parts[0] != NULL && *parts[0] != 0)
+        return g_path_get_basename (parts[0]);
+    }
+
+  return NULL;
+}
+
+/* Process and attention state arrive after the page is attached. Update the
+ * existing content widgets instead of waiting for another tab selection. */
+static void
+luma_tab_strip_badge_changed (PtyxisTab  *tab,
+                              GParamSpec *pspec,
+                              GtkLabel   *badge)
+{
+  g_autofree char *text = luma_tab_strip_badge_for (tab);
+
+  gtk_label_set_text (badge, text != NULL ? text : "");
+  gtk_widget_set_visible (GTK_WIDGET (badge), text != NULL);
+}
+
+static void
+luma_tab_strip_attention_changed (AdwTabPage *page,
+                                  GParamSpec *pspec,
+                                  GtkWidget  *dot)
+{
+  if (adw_tab_page_get_needs_attention (page))
+    gtk_widget_add_css_class (dot, "activity");
+  else
+    gtk_widget_remove_css_class (dot, "activity");
+}
+
+static void
+luma_tab_strip_close_clicked (GtkButton *button,
+                              AdwTabPage *page)
+{
+  LumaTabStrip *self = LUMA_TAB_STRIP (gtk_widget_get_ancestor (GTK_WIDGET (button),
+                                                                LUMA_TYPE_TAB_STRIP));
+
+  /* close_page(), not remove_page(): it runs upstream's close handler, which is
+   * what asks before killing a running process. */
+  if (self != NULL && self->view != NULL)
+    adw_tab_view_close_page (self->view, page);
+}
+
+static void
+luma_tab_strip_tab_clicked (GtkGestureClick *gesture,
+                            int              n_press,
+                            double           x,
+                            double           y,
+                            AdwTabPage      *page)
+{
+  GtkWidget *widget = gtk_event_controller_get_widget (GTK_EVENT_CONTROLLER (gesture));
+  LumaTabStrip *self = LUMA_TAB_STRIP (gtk_widget_get_ancestor (widget, LUMA_TYPE_TAB_STRIP));
+  guint button;
+
+  if (self == NULL || self->view == NULL)
+    return;
+
+  button = gtk_gesture_single_get_current_button (GTK_GESTURE_SINGLE (gesture));
+
+  if (button == GDK_BUTTON_MIDDLE)
+    {
+      adw_tab_view_close_page (self->view, page);
+      return;
+    }
+
+  adw_tab_view_set_selected_page (self->view, page);
+
+  /* Double-click renames, through the window's own action so the dialog and
+   * the title semantics stay upstream's. */
+  if (n_press == 2)
+    gtk_widget_activate_action (widget, "win.set-title", NULL);
+}
+
+static GdkContentProvider *
+luma_tab_strip_drag_prepare (GtkDragSource *source,
+                             double         x,
+                             double         y,
+                             AdwTabPage    *page)
+{
+  return gdk_content_provider_new_typed (ADW_TYPE_TAB_PAGE, page);
+}
+
+static gboolean
+luma_tab_strip_drop (GtkDropTarget *target,
+                     const GValue  *value,
+                     double         x,
+                     double         y,
+                     AdwTabPage    *page)
+{
+  GtkWidget *widget = gtk_event_controller_get_widget (GTK_EVENT_CONTROLLER (target));
+  LumaTabStrip *self = LUMA_TAB_STRIP (gtk_widget_get_ancestor (widget, LUMA_TYPE_TAB_STRIP));
+  AdwTabPage *dragged;
+  int position;
+
+  if (self == NULL || self->view == NULL || !G_VALUE_HOLDS (value, ADW_TYPE_TAB_PAGE))
+    return FALSE;
+
+  dragged = g_value_get_object (value);
+  if (dragged == NULL || dragged == page)
+    return FALSE;
+
+  position = adw_tab_view_get_page_position (self->view, page);
+  adw_tab_view_reorder_page (self->view, dragged, position);
+  return TRUE;
+}
+
+static GtkWidget *
+luma_tab_strip_build_tab (LumaTabStrip *self,
+                          AdwTabPage   *page)
+{
+  GtkWidget *overlay;
+  GtkWidget *content;
+  GtkWidget *dot;
+  GtkWidget *label;
+  GtkWidget *close;
+  GtkGesture *click;
+  GtkDragSource *source;
+  GtkDropTarget *target;
+  GtkWidget *child;
+
+  overlay = gtk_overlay_new ();
+  gtk_widget_add_css_class (overlay, "luma-tab");
+  gtk_widget_set_focusable (overlay, TRUE);
+
+  content = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 7);
+  gtk_widget_add_css_class (content, "luma-tab-content");
+
+  dot = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_add_css_class (dot, "luma-tab-dot");
+  gtk_widget_set_valign (dot, GTK_ALIGN_CENTER);
+  /* Upstream already tracks whether a background tab wants you: the amber,
+   * pulsing state is that same signal, drawn the way the design asks. */
+  luma_tab_strip_attention_changed (page, NULL, dot);
+  g_signal_connect_object (page, "notify::needs-attention",
+                           G_CALLBACK (luma_tab_strip_attention_changed), dot, 0);
+  gtk_box_append (GTK_BOX (content), dot);
+
+  label = gtk_label_new (NULL);
+  g_object_bind_property (page, "title", label, "label", G_BINDING_SYNC_CREATE);
+  gtk_label_set_ellipsize (GTK_LABEL (label), PANGO_ELLIPSIZE_END);
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0f);
+  gtk_widget_set_hexpand (label, TRUE);
+  gtk_widget_add_css_class (label, "luma-tab-title");
+  gtk_box_append (GTK_BOX (content), label);
+
+  child = adw_tab_page_get_child (page);
+  if (PTYXIS_IS_TAB (child))
+    {
+      GtkWidget *badge = gtk_label_new (NULL);
+      gtk_widget_add_css_class (badge, "luma-tab-badge");
+      gtk_widget_set_halign (badge, GTK_ALIGN_END);
+      gtk_box_append (GTK_BOX (content), badge);
+      luma_tab_strip_badge_changed (PTYXIS_TAB (child), NULL, GTK_LABEL (badge));
+      g_signal_connect_object (child, "notify::command-line",
+                               G_CALLBACK (luma_tab_strip_badge_changed), badge, 0);
+    }
+
+  gtk_overlay_set_child (GTK_OVERLAY (overlay), content);
+  gtk_widget_set_hexpand (overlay, FALSE);
+
+  /* The close sits over the badge rather than beside it, so the crossfade
+   * between them moves nothing. */
+  close = gtk_button_new_from_icon_name ("window-close-symbolic");
+  gtk_widget_add_css_class (close, "luma-tab-close");
+  gtk_widget_set_halign (close, GTK_ALIGN_END);
+  gtk_widget_set_valign (close, GTK_ALIGN_CENTER);
+  gtk_widget_set_tooltip_text (close, _("Close Tab"));
+  gtk_accessible_update_property (GTK_ACCESSIBLE (close),
+                                  GTK_ACCESSIBLE_PROPERTY_LABEL, _("Close Tab"),
+                                  -1);
+  g_signal_connect_object (close, "clicked",
+                           G_CALLBACK (luma_tab_strip_close_clicked), page, 0);
+  gtk_overlay_add_overlay (GTK_OVERLAY (overlay), close);
+
+  if (page == adw_tab_view_get_selected_page (self->view))
+    gtk_widget_add_css_class (overlay, "active");
+
+  click = gtk_gesture_click_new ();
+  gtk_gesture_single_set_button (GTK_GESTURE_SINGLE (click), 0);
+  g_signal_connect_object (click, "pressed",
+                           G_CALLBACK (luma_tab_strip_tab_clicked), page, 0);
+  gtk_widget_add_controller (overlay, GTK_EVENT_CONTROLLER (click));
+
+  source = gtk_drag_source_new ();
+  g_signal_connect_object (source, "prepare",
+                           G_CALLBACK (luma_tab_strip_drag_prepare), page, 0);
+  gtk_widget_add_controller (overlay, GTK_EVENT_CONTROLLER (source));
+
+  target = gtk_drop_target_new (ADW_TYPE_TAB_PAGE, GDK_ACTION_MOVE);
+  g_signal_connect_object (target, "drop",
+                           G_CALLBACK (luma_tab_strip_drop), page, 0);
+  gtk_widget_add_controller (overlay, GTK_EVENT_CONTROLLER (target));
+
+  gtk_accessible_update_property (GTK_ACCESSIBLE (overlay),
+                                  GTK_ACCESSIBLE_PROPERTY_LABEL,
+                                  adw_tab_page_get_title (page),
+                                  -1);
+  gtk_accessible_update_state (GTK_ACCESSIBLE (overlay),
+                               GTK_ACCESSIBLE_STATE_SELECTED,
+                               page == adw_tab_view_get_selected_page (self->view),
+                               -1);
+
+  return overlay;
+}
+
+static void
+luma_tab_strip_rebuild (LumaTabStrip *self)
+{
+  GtkWidget *child;
+  guint n_pages;
+
+  g_assert (LUMA_IS_TAB_STRIP (self));
+
+  while ((child = gtk_widget_get_first_child (self->tabs)))
+    gtk_box_remove (GTK_BOX (self->tabs), child);
+
+  if (self->view == NULL)
+    return;
+
+  n_pages = adw_tab_view_get_n_pages (self->view);
+  for (guint i = 0; i < n_pages; i++)
+    {
+      AdwTabPage *page = adw_tab_view_get_nth_page (self->view, i);
+      gtk_box_append (GTK_BOX (self->tabs), luma_tab_strip_build_tab (self, page));
+    }
+  if (gtk_widget_get_parent (self->new_tab) == NULL)
+    gtk_box_append (GTK_BOX (self->tabs), self->new_tab);
+
+  /* One tab is not a strip: with nothing to switch between, the row is chrome
+   * that earns nothing. Upstream hides its own bar on the same rule. */
+  gtk_widget_set_visible (GTK_WIDGET (self), n_pages > 1);
+}
+
+static void
+luma_tab_strip_pages_changed_cb (LumaTabStrip *self)
+{
+  luma_tab_strip_rebuild (self);
+}
+
+static void
+luma_tab_strip_dispose (GObject *object)
+{
+  LumaTabStrip *self = (LumaTabStrip *)object;
+
+  luma_tab_strip_set_view (self, NULL);
+  if (self->profile_popover != NULL)
+    {
+      gtk_widget_unparent (GTK_WIDGET (self->profile_popover));
+      self->profile_popover = NULL;
+    }
+  g_clear_pointer (&self->box, gtk_widget_unparent);
+  g_clear_object (&self->new_tab);
+
+  G_OBJECT_CLASS (luma_tab_strip_parent_class)->dispose (object);
+}
+
+static void
+luma_tab_strip_get_property (GObject    *object,
+                             guint       prop_id,
+                             GValue     *value,
+                             GParamSpec *pspec)
+{
+  LumaTabStrip *self = LUMA_TAB_STRIP (object);
+
+  switch (prop_id)
+    {
+    case PROP_VIEW:
+      g_value_set_object (value, luma_tab_strip_get_view (self));
+      break;
+
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+    }
+}
+
+static void
+luma_tab_strip_set_property (GObject      *object,
+                             guint         prop_id,
+                             const GValue *value,
+                             GParamSpec   *pspec)
+{
+  LumaTabStrip *self = LUMA_TAB_STRIP (object);
+
+  switch (prop_id)
+    {
+    case PROP_VIEW:
+      luma_tab_strip_set_view (self, g_value_get_object (value));
+      break;
+
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+    }
+}
+
+/* The upstream picker is parented to this visible content widget. Its own
+ * GtkPopover still owns rendering, focus, dismissal and profile selection. */
+static void
+luma_tab_strip_measure (GtkWidget *widget, GtkOrientation orientation,
+                        int for_size, int *minimum, int *natural,
+                        int *minimum_baseline, int *natural_baseline)
+{
+  LumaTabStrip *self = LUMA_TAB_STRIP (widget);
+  gtk_widget_measure (self->box, orientation, for_size, minimum, natural,
+                      minimum_baseline, natural_baseline);
+}
+
+static void
+luma_tab_strip_size_allocate (GtkWidget *widget, int width, int height, int baseline)
+{
+  LumaTabStrip *self = LUMA_TAB_STRIP (widget);
+  graphene_rect_t bounds;
+
+  gtk_widget_allocate (self->box, width, height, baseline, NULL);
+  if (self->profile_popover != NULL &&
+      gtk_widget_get_visible (GTK_WIDGET (self->profile_popover)) &&
+      gtk_widget_compute_bounds (self->new_tab, widget, &bounds))
+    {
+      GdkRectangle rect = {bounds.origin.x, bounds.origin.y,
+                           bounds.size.width, bounds.size.height};
+      gtk_popover_set_pointing_to (self->profile_popover, &rect);
+      gtk_popover_present (self->profile_popover);
+    }
+}
+
+static void
+luma_tab_strip_profiles_closed (LumaTabStrip *self)
+{
+  if (self->view != NULL && adw_tab_view_get_n_pages (self->view) < 2)
+    gtk_widget_set_visible (GTK_WIDGET (self), FALSE);
+}
+
+static void
+luma_tab_strip_class_init (LumaTabStripClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->dispose = luma_tab_strip_dispose;
+  object_class->get_property = luma_tab_strip_get_property;
+  object_class->set_property = luma_tab_strip_set_property;
+
+  properties[PROP_VIEW] =
+    g_param_spec_object ("view", NULL, NULL,
+                         ADW_TYPE_TAB_VIEW,
+                         (G_PARAM_READWRITE | G_PARAM_EXPLICIT_NOTIFY | G_PARAM_STATIC_STRINGS));
+
+  g_object_class_install_properties (object_class, N_PROPS, properties);
+
+  widget_class->measure = luma_tab_strip_measure;
+  widget_class->size_allocate = luma_tab_strip_size_allocate;
+  gtk_widget_class_set_css_name (widget_class, "lumatabstrip");
+  gtk_widget_class_set_accessible_role (widget_class, GTK_ACCESSIBLE_ROLE_TAB_LIST);
+}
+
+static void
+luma_tab_strip_init (LumaTabStrip *self)
+{
+  GtkWidget *scroller;
+
+  self->box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gtk_widget_add_css_class (self->box, "luma-tab-strip");
+  gtk_widget_set_parent (self->box, GTK_WIDGET (self));
+
+  self->tabs = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gtk_widget_set_valign (self->tabs, GTK_ALIGN_CENTER);
+
+  /* Overflow scrolls; a tab never shrinks below the width the design gives it. */
+  scroller = gtk_scrolled_window_new ();
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scroller),
+                                  GTK_POLICY_EXTERNAL, GTK_POLICY_NEVER);
+  gtk_scrolled_window_set_child (GTK_SCROLLED_WINDOW (scroller), self->tabs);
+  gtk_widget_set_hexpand (scroller, TRUE);
+  gtk_box_append (GTK_BOX (self->box), scroller);
+
+  self->new_tab = gtk_button_new_with_label ("+");
+  gtk_widget_add_css_class (self->new_tab, "luma-tab-new");
+  gtk_widget_set_tooltip_text (self->new_tab, _("New Tab"));
+  /* Upstream's new-tab takes (profile, command); empty strings mean
+   * "the default profile, the default command". */
+  gtk_widget_set_valign (self->new_tab, GTK_ALIGN_CENTER);
+  gtk_actionable_set_action_name (GTK_ACTIONABLE (self->new_tab), "win.new-tab");
+  gtk_actionable_set_action_target (GTK_ACTIONABLE (self->new_tab), "(ss)", "", "");
+  g_object_ref_sink (self->new_tab);
+
+  self->overflow = gtk_button_new_with_label ("\u2022\u2022\u2022");
+  gtk_widget_add_css_class (self->overflow, "luma-tab-overflow");
+  gtk_widget_set_tooltip_text (self->overflow, _("All Tabs"));
+  gtk_widget_set_valign (self->overflow, GTK_ALIGN_CENTER);
+  gtk_actionable_set_action_name (GTK_ACTIONABLE (self->overflow), "win.tab-overview");
+  gtk_box_append (GTK_BOX (self->box), self->overflow);
+}
+
+GtkWidget *
+luma_tab_strip_new (void)
+{
+  return g_object_new (LUMA_TYPE_TAB_STRIP, NULL);
+}
+
+AdwTabView *
+luma_tab_strip_get_view (LumaTabStrip *self)
+{
+  g_return_val_if_fail (LUMA_IS_TAB_STRIP (self), NULL);
+
+  return self->view;
+}
+
+void
+luma_tab_strip_set_view (LumaTabStrip *self,
+                         AdwTabView   *view)
+{
+  g_return_if_fail (LUMA_IS_TAB_STRIP (self));
+  g_return_if_fail (view == NULL || ADW_IS_TAB_VIEW (view));
+
+  if (self->view == view)
+    return;
+
+  if (self->view != NULL)
+    {
+      g_clear_signal_handler (&self->pages_changed_handler, self->pages);
+      g_clear_signal_handler (&self->selected_handler, self->view);
+      g_clear_object (&self->pages);
+      g_clear_object (&self->view);
+    }
+
+  if (view != NULL)
+    {
+      self->view = g_object_ref (view);
+      self->pages = G_LIST_MODEL (adw_tab_view_get_pages (view));
+      self->pages_changed_handler =
+        g_signal_connect_object (self->pages, "items-changed",
+                                 G_CALLBACK (luma_tab_strip_pages_changed_cb),
+                                 self, G_CONNECT_SWAPPED);
+      self->selected_handler =
+        g_signal_connect_object (view, "notify::selected-page",
+                                 G_CALLBACK (luma_tab_strip_pages_changed_cb),
+                                 self, G_CONNECT_SWAPPED);
+    }
+
+  luma_tab_strip_rebuild (self);
+  g_object_notify_by_pspec (G_OBJECT (self), properties[PROP_VIEW]);
+}
+
+void
+luma_tab_strip_set_profile_popover (LumaTabStrip *self, GtkPopover *popover)
+{
+  g_return_if_fail (LUMA_IS_TAB_STRIP (self));
+  g_return_if_fail (GTK_IS_POPOVER (popover));
+  g_return_if_fail (self->profile_popover == NULL);
+
+  self->profile_popover = popover;
+  gtk_widget_set_parent (GTK_WIDGET (popover), GTK_WIDGET (self));
+  g_signal_connect_object (popover, "closed",
+                           G_CALLBACK (luma_tab_strip_profiles_closed), self,
+                           G_CONNECT_SWAPPED);
+}
+
+void
+luma_tab_strip_popup_profiles (LumaTabStrip *self)
+{
+  g_return_if_fail (LUMA_IS_TAB_STRIP (self));
+  g_return_if_fail (self->profile_popover != NULL);
+
+  /* A single terminal normally hides its strip; reveal the real anchor for
+   * the duration of the picker, then restore that policy on dismissal. */
+  gtk_widget_set_visible (GTK_WIDGET (self), TRUE);
+  gtk_popover_popup (self->profile_popover);
+  gtk_widget_queue_allocate (GTK_WIDGET (self));
+}
