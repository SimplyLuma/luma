From: Project Luma <luma@local>
Subject: [PATCH] Skip stale GDM lock restore in the greetd bake-off

GNOME Shell persists whether the previous session was locked and restores that
state after startup. The rollback-safe mobile candidate is deliberately run by
greetd, where no GDM reauthentication service exists, so restoring a stale GDM
lock creates an unlock dialog that can never authenticate.

Skip only that persisted-lock restoration path when the explicit Luma greetd
bake-off marker is present. Ordinary GNOME and Luma sessions retain the normal
lock restore behavior, and the candidate's dim, blank, suspend, and wake paths
remain active.
---
 js/ui/main.js | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/js/ui/main.js b/js/ui/main.js
--- a/js/ui/main.js
+++ b/js/ui/main.js
@@ -363,7 +363,8 @@ export async function start() {
         if (actionMode === Shell.ActionMode.NONE)
             actionMode = Shell.ActionMode.NORMAL;
 
-        if (screenShield)
+        if (screenShield &&
+            GLib.getenv('LUMA_GREETD_SESSION') !== '1')
             screenShield.lockIfWasLocked();
 
         if (sessionMode.currentMode !== 'gdm' &&
