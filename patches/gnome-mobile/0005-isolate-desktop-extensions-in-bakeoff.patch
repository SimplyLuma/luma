From: Project Luma <luma@local>
Subject: [PATCH] Isolate desktop extensions in the mobile bake-off

Luma's installed user extensions target the desktop Shell ABI. Loading those
extensions into the private GNOME Mobile 48 candidate both contaminates the
bake-off and can fail on changed mobile APIs. Skip user extensions only in the
explicitly marked greetd candidate session, leaving all settings untouched.
---
 js/ui/extensionSystem.js | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/js/ui/extensionSystem.js b/js/ui/extensionSystem.js
index 1e5a73c..21842fb 100644
--- a/js/ui/extensionSystem.js
+++ b/js/ui/extensionSystem.js
@@ -546,7 +546,11 @@ export class ExtensionManager {
     _getEnabledExtensions() {
         let extensions = this._getModeExtensions();
 
-        if (!global.settings.get_boolean(DISABLE_USER_EXTENSIONS_KEY))
+        // Keep the isolated mobile bake-off neutral: desktop extensions target
+        // the installed Luma Shell ABI and must not be loaded into Shell 48.
+        // Their settings remain untouched and take effect again in Luma Shell.
+        if (!global.settings.get_boolean(DISABLE_USER_EXTENSIONS_KEY) &&
+            GLib.getenv('LUMA_GREETD_SESSION') !== '1')
             extensions = extensions.concat(global.settings.get_strv(ENABLED_EXTENSIONS_KEY));
 
         extensions.sort((a, b) => this._compareExtensions(this.lookup(a), this.lookup(b)));
