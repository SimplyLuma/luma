diff --git a/lumaPreferences.js b/lumaPreferences.js
new file mode 100644
index 0000000..fc1b8f4
--- /dev/null
+++ b/lumaPreferences.js
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import {
+    Gio,
+    GLib,
+} from './dependencies/gi.js';
+
+const DOMAIN = 'org.luma.shell.dock.appearance';
+const DEFAULT_SURFACE = 'prairie-default';
+const ALLOWED_SURFACES = new Set([DEFAULT_SURFACE, 'green-glow']);
+const MAX_PREFERENCES_BYTES = 64 * 1024;
+
+/**
+ * Read the bounded Luma preference contract and notify the dock manager.
+ *
+ * Mods write semantic values through luma-mods. This consumer never accepts
+ * CSS, selectors, paths, commands, or arbitrary style properties. Monitoring
+ * the parent directory also catches the backend's atomic rename.
+ */
+export class DockPreferenceMonitor {
+    constructor(callback) {
+        this._callback = callback;
+        this._surface = DEFAULT_SURFACE;
+        this._idleId = 0;
+        this._file = Gio.File.new_for_path(GLib.build_filenamev([
+            GLib.get_user_config_dir(),
+            'luma',
+            'preferences.json',
+        ]));
+        this._directory = this._file.get_parent();
+
+        try {
+            GLib.mkdir_with_parents(this._directory.get_path(), 0o700);
+            this._monitor = this._directory.monitor_directory(
+                Gio.FileMonitorFlags.NONE, null);
+            this._changedId = this._monitor.connect(
+                'changed', (_monitor, file, otherFile) => {
+                    if (file?.equal(this._file) || otherFile?.equal(this._file))
+                        this._queueRefresh();
+                });
+        } catch (error) {
+            console.warn(`Luma dock preferences are not monitored: ${error.message}`);
+        }
+
+        this._refresh();
+    }
+
+    get surface() {
+        return this._surface;
+    }
+
+    _queueRefresh() {
+        if (this._idleId)
+            return;
+        this._idleId = GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
+            this._idleId = 0;
+            this._refresh();
+            return GLib.SOURCE_REMOVE;
+        });
+    }
+
+    _readSurface() {
+        try {
+            const info = this._file.query_info(
+                'standard::type,standard::size',
+                Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS,
+                null);
+            if (info.get_file_type() !== Gio.FileType.REGULAR ||
+                info.get_size() > MAX_PREFERENCES_BYTES)
+                return DEFAULT_SURFACE;
+            const [loaded, contents] = this._file.load_contents(null);
+            if (!loaded || contents.length > MAX_PREFERENCES_BYTES)
+                return DEFAULT_SURFACE;
+            const preferences = JSON.parse(new TextDecoder().decode(contents));
+            const value = preferences?.[DOMAIN];
+            if (!value || typeof value !== 'object' || Array.isArray(value) ||
+                Object.keys(value).length !== 1 ||
+                !ALLOWED_SURFACES.has(value.surface))
+                return DEFAULT_SURFACE;
+            return value.surface;
+        } catch (_error) {
+            return DEFAULT_SURFACE;
+        }
+    }
+
+    _refresh() {
+        const next = this._readSurface();
+        if (next === this._surface)
+            return;
+        this._surface = next;
+        this._callback(next);
+    }
+
+    destroy() {
+        if (this._idleId) {
+            GLib.source_remove(this._idleId);
+            this._idleId = 0;
+        }
+        if (this._changedId)
+            this._monitor.disconnect(this._changedId);
+        this._monitor?.cancel();
+        this._monitor = null;
+        this._callback = null;
+    }
+}
