+
+// Planar YUV memory belongs to this allocator, just like its RGB buffers.
+int gralloc_lock_ycbcr(gralloc_module_t const* module,
+        buffer_handle_t handle, int usage, int l, int t, int w, int h,
+        struct android_ycbcr* ycbcr)
+{
+    if (!ycbcr || private_handle_t::validate(handle) < 0)
+        return -EINVAL;
+    const private_handle_t* hnd = (const private_handle_t*)handle;
+    if ((hnd->format != HAL_PIXEL_FORMAT_YV12 &&
+         hnd->format != HAL_PIXEL_FORMAT_YCbCr_420_888) ||
+        hnd->stride <= 0 || hnd->stride > 16384 ||
+        hnd->height <= 0 || hnd->height > 16384 ||
+        (hnd->stride & 15) || (hnd->height & 1))
+        return -EINVAL;
+    const size_t ysize = size_t(hnd->stride) * hnd->height;
+    const size_t cstride = (size_t(hnd->stride) / 2 + 15) & ~size_t(15);
+    const size_t csize = cstride * (hnd->height / 2);
+    if (hnd->size < 0 || ysize + 2 * csize > size_t(hnd->size))
+        return -EINVAL;
+    void* base = nullptr;
+    int result = gralloc_lock(module, handle, usage, l, t, w, h, &base);
+    if (result != 0 || !base)
+        return result != 0 ? result : -EINVAL;
+    memset(ycbcr, 0, sizeof(*ycbcr));
+    ycbcr->y = base;
+    ycbcr->ystride = hnd->stride;
+    ycbcr->cstride = cstride;
+    ycbcr->chroma_step = 1;
+    unsigned char* first = (unsigned char*)base + ysize;
+    ycbcr->cb = hnd->format == HAL_PIXEL_FORMAT_YV12 ? first + csize : first;
+    ycbcr->cr = hnd->format == HAL_PIXEL_FORMAT_YV12 ? first : first + csize;
+    return 0;
+}
