From: Project Luma
Subject: [PATCH] luma: remember where windows live, per app and monitor setup

Tiling Shell forgot where windows were. Apps opened wherever Mutter put
them, and after moving between desks, sleeping, unplugging or opening the
lid, windows stayed wherever Mutter moved them. Windows are now remembered
by app identity and window role, per monitor setup (physical monitors by
maker, model and serial, with arrangement and scale), as a last placement
and a long-term habit: hours lived in each Tiling Shell tile, maximized
state or normalized floating rect, with a six-month half-life. The first
main window of an app opens in its strong habit, otherwise its last
placement however old; a move kept for three sessions replaces the habit.
When the monitors settle after a change, open windows go back to where
they were left in that setup; in a setup never seen
before, nothing is scattered. Dialogs, transients, popups and splash
windows are never touched, and a window the person moves wins. A window
with a place of its own is kept invisible until it is there, so it opens
already in its tile. Tiling Shell also runs on the lock screen, so windows
keep their tiles across lock and sleep, and restores finish before unlock. Decisions
are logged to the journal for Luma Vitals, the memory lives in
$XDG_STATE_HOME/luma/window-memory.json, and Tiling Settings has one switch
and a Forget button. See ADR-036.

diff -ruN a/components/lumaWindowMemory/windowMemory.js b/components/lumaWindowMemory/windowMemory.js
--- a/components/lumaWindowMemory/windowMemory.js
+++ b/components/lumaWindowMemory/windowMemory.js
@@ -0,0 +1,1321 @@
+// Project Luma: window placement memory (ADR-036).
+//
+// Windows are remembered by app identity (desktop-file id, GApplication id,
+// Flatpak id, Wayland app_id or WM_CLASS) and a stable ordinal among that app's
+// open main windows, never by PID or window id. For every monitor setup (the
+// physical monitors by maker, model and serial, with their arrangement and
+// scale) each window keeps its last placement and a long-term habit: the hours
+// it lived in each place (six-month half-life) and how many sessions. A
+// placement is a monitor identity plus a Tiling Shell tile, a maximized state
+// or a normalized floating rect.
+//
+// Launch: a strong habit wins; otherwise the last placement, however old; with
+// no history nothing happens. A move kept for 3+ sessions demotes the old habit.
+// Setup change: once the monitors have been stable for a moment, open windows go
+// back to where they were left in that setup (windows opened since follow the
+// launch rule). In a setup never seen before nothing
+// is scattered: windows keep still-connected monitors, and windows from a
+// monitor that went away go to the new monitor with the same role.
+// Dialogs, transients, popups and splash windows are never remembered or moved,
+// and a window the person touches wins.
+import { Clutter, GLib, Gio, Meta, Shell, St } from "../../gi/ext.js";
+import { buildRectangle } from "../../utils/ui.js";
+import * as Main from "resource:///org/gnome/shell/ui/main.js";
+import Tile from "../layout/Tile.js";
+import { maximizeWindow, unmaximizeWindow } from "../../utils/gnomesupport.js";
+
+const VERSION = 1;
+export const KEY_ENABLED = "luma-remember-window-positions";
+export const KEY_RESET = "luma-window-memory-reset";
+const HOUR = 3600 * 1e3;
+const DAY = 24 * HOUR;
+const DEFAULT_TIMING = {
+  settle: 1500,
+  // a window the person moved or tiled is remembered and saved right away
+  touchedSettle: 400,
+  touchedSave: 250,
+  // a monitor setup is final once nothing changed for this long
+  stable: 1500,
+  // after a restore, Mutter and clients settle before recording resumes
+  quiet: 1000,
+  launchDelay: 120,
+  // a window held invisible until it is in its place is shown anyway this long
+  // after the client first shows it, or this long after it was created
+  holdAfterShown: 700,
+  holdMax: 10 * 1e3,
+  // a stay shorter than this is a detour: it adds hours but not a session
+  dwell: 60 * 1e3,
+  // open windows credit their hours this often, so a crash loses little
+  flush: 10 * 60 * 1e3,
+  save: 5000
+};
+// Habit = hours a window lived in a place, fading with a six-month half-life.
+const HALF_LIFE_MS = 182 * DAY;
+const EXPIRE_MS = 400 * DAY;
+// one uninterrupted stay counts at most this long (a window left open overnight)
+const SEGMENT_CAP_MS = 8 * HOUR;
+const HABIT_MIN_HOURS = 2;
+const HABIT_MIN_SESSIONS = 3;
+const HABIT_MIN_SHARE = 0.6;
+// A sustained move: the last 3+ sessions in one new place, with most of the
+// hours of the last 6 sessions, demotes the old habit to a quarter.
+const RECENT_SESSIONS = 6;
+const SHIFT_MIN_STREAK = 3;
+const SHIFT_MIN_SHARE = 0.6;
+const SHIFT_DEMOTE = 0.25;
+const MAX_SETUPS = 16;
+const MAX_APPS = 48;
+const MAX_HISTOGRAM = 6;
+const MAX_ORDINALS = 4;
+const TOLERANCE = 0.02;
+const APP = Symbol("luma-window-memory-app");
+const ORDINAL = Symbol("luma-window-memory-ordinal");
+const TOUCHED = Symbol("luma-window-memory-touched");
+const OWN_UNTIL = Symbol("luma-window-memory-own");
+const LEFT = Symbol("luma-window-memory-left");
+// Where a window was when Tiling Shell last stopped (lock-time re-enable of
+// later extensions, the Quick Settings switch, Shell shutdown).
+const PAUSED = Symbol("luma-window-memory-paused");
+const FRAME_SLACK = 2;
+// A disable and enable this close together is GNOME re-ordering extensions.
+const REBASE_MS = 5000;
+
+function stateFile() {
+  return GLib.build_filenamev([GLib.get_user_state_dir(), "luma", "window-memory.json"]);
+}
+
+// Journal entries for Luma Vitals: GLIB_DOMAIN=luma-window-memory, LUMA_EVENT=...
+function vitals(event, message, fields = {}) {
+  const entry = {
+    MESSAGE: `window memory: ${message}`,
+    LUMA_COMPONENT: "window-memory",
+    LUMA_EVENT: event
+  };
+  for (const [key, value] of Object.entries(fields)) {
+    if (value !== void 0 && value !== null)
+      entry[`LUMA_${key.toUpperCase()}`] = String(value);
+  }
+  try {
+    GLib.log_structured("luma-window-memory", GLib.LogLevelFlags.LEVEL_MESSAGE, entry);
+  } catch (e) {
+    console.log(`[luma-window-memory] ${message}`);
+  }
+}
+
+function normalizeId(id) {
+  if (typeof id !== "string") return null;
+  let value = id.trim().toLowerCase();
+  if (value.endsWith(".desktop")) value = value.slice(0, -8);
+  if (!value || value.startsWith("window:") || value === "gjs") return null;
+  return value;
+}
+
+export function appIdentity(window) {
+  const candidates = [];
+  const app = Shell.WindowTracker.get_default().get_window_app(window);
+  if (app && !app.is_window_backed()) candidates.push(app.get_id());
+  candidates.push(
+    window.get_gtk_application_id(),
+    window.get_sandboxed_app_id(),
+    window.get_wm_class(),
+    window.get_wm_class_instance()
+  );
+  for (const candidate of candidates) {
+    const id = normalizeId(candidate);
+    if (id) return id;
+  }
+  return null;
+}
+
+// Only main windows: normal, resizable, top-level and on the taskbar.
+export function isRememberable(window) {
+  if (!window || window.is_override_redirect()) return false;
+  if (window.get_window_type() !== Meta.WindowType.NORMAL) return false;
+  if (window.get_transient_for() !== null || window.is_attached_dialog()) return false;
+  if (window.is_skip_taskbar() || !resizable(window)) return false;
+  if (window.is_always_on_all_workspaces?.()) return false;
+  return true;
+}
+
+function ordinalName(ordinal) {
+  return ordinal === 0 ? "main" : `main-${ordinal + 1}`;
+}
+
+function round(value) {
+  return Math.round(value * 1e4) / 1e4;
+}
+
+function samePlacement(a, b) {
+  return !!a && !!b && a.m === b.m && a.k === b.k && a.r.every((v, i) => Math.abs(v - b.r[i]) <= TOLERANCE);
+}
+
+function bucketId(p) {
+  return `${p.m}|${p.k}|${p.r.map((v) => Math.round(v / TOLERANCE)).join(",")}`;
+}
+
+function decayed(item, now) {
+  return item.w * Math.pow(0.5, Math.max(0, now - item.t) / HALF_LIFE_MS);
+}
+
+function emptyMemory(reset) {
+  return { version: VERSION, reset, active: null, setups: {} };
+}
+
+function describe(p) {
+  return p ? `${p.k} [${p.r.map((v) => v.toFixed(2)).join(" ")}] on ${p.m}` : "nothing";
+}
+
+// Mutter reports maximized and fullscreen windows as not resizable; only a
+// window that cannot be resized in its normal state is fixed-size.
+function resizable(window) {
+  return window.allows_resize() || window.maximizedHorizontally || window.maximizedVertically || window.is_fullscreen();
+}
+
+function frameOf(window) {
+  const r = window.get_frame_rect();
+  return [r.x, r.y, r.width, r.height];
+}
+
+function sameFrame(a, b) {
+  return !!a && !!b && a.every((v, i) => Math.abs(v - b[i]) <= FRAME_SLACK);
+}
+
+// Why a window is never remembered or moved, for the journal.
+function notRememberableReason(window) {
+  if (window.is_override_redirect()) return "override-redirect";
+  if (window.get_window_type() !== Meta.WindowType.NORMAL) return "not a normal window";
+  if (window.get_transient_for() !== null || window.is_attached_dialog()) return "dialog or transient";
+  if (window.is_skip_taskbar()) return "skips the taskbar";
+  if (!resizable(window)) return "not resizable (splash or fixed-size)";
+  if (window.is_always_on_all_workspaces?.()) return "on all workspaces";
+  return null;
+}
+
+export default class LumaWindowMemory {
+  // Test harness only: fake EDIDs for virtual monitors, a clock offset and short
+  // timings, shared by every instance (Tiling Shell may be re-enabled mid-test).
+  static testHooks = null;
+
+  // settings: Tiling Shell Gio.Settings. managerFor(index): that monitor's
+  // TilingManager. keybindings: Tiling Shell KeyBindings (user moves).
+  constructor({ settings, managerFor, keybindings }) {
+    this._settings = settings;
+    this._managerFor = managerFor;
+    this._keybindings = keybindings;
+    this._windows = /* @__PURE__ */ new Map();
+    this._signals = [];
+    this._sources = /* @__PURE__ */ new Set();
+    this._stable = false;
+    this._setupKey = null;
+    this._monitorsCache = null;
+    this._transition = null;
+    this._stableId = 0;
+    this._saveId = 0;
+    this._quietUntil = 0;
+    this._sleepSubscription = 0;
+    this._locked = false;
+    this._memory = emptyMemory(0);
+    this.timing = { ...DEFAULT_TIMING, ...LumaWindowMemory.testHooks?.timing ?? {} };
+  }
+
+  enable() {
+    this._load();
+    this._enabled = this._settings.get_boolean(KEY_ENABLED);
+    this._connect(this._settings, `changed::${KEY_ENABLED}`, () => this._onEnabledChanged());
+    this._connect(this._settings, `changed::${KEY_RESET}`, () => this._onReset());
+    this._connect(global.display, "window-created", (_d, window) => this._onWindowCreated(window));
+    this._connect(global.display, "grab-op-begin", (_d, window) => this.touch(window, "grab"));
+    this._connect(Main.layoutManager, "monitors-changed", () => this._beginTransition("monitors-changed"));
+    this._connect(global.display, "workareas-changed", () => {
+      if (!this._stable && this._stableId) this._scheduleStable();
+      else if (this._stable && !this._locked) this._reassertLockRestores("work area changed after unlock");
+    });
+    for (const signal of ["move-window", "span-window", "span-window-all-tiles", "untile-window", "move-window-center"]) {
+      if (this._keybindings)
+        this._connect(this._keybindings, signal, (_k, display) => this.touch(display.get_focus_window(), signal));
+    }
+    this._flushId = GLib.timeout_add_seconds(GLib.PRIORITY_LOW, Math.max(1, Math.round(this.timing.flush / 1e3)), () => {
+      if (this._stable) {
+        const now = this._now();
+        this._windows.forEach((data, window) => this._credit(window, data, now));
+        this._queueSave();
+      }
+      return GLib.SOURCE_CONTINUE;
+    });
+    this._sleepSubscription = Gio.DBus.system.signal_subscribe(
+      "org.freedesktop.login1",
+      "org.freedesktop.login1.Manager",
+      "PrepareForSleep",
+      "/org/freedesktop/login1",
+      null,
+      Gio.DBusSignalFlags.NONE,
+      (_c, _s, _p, _i, _n, parameters) => this.onPrepareForSleep(parameters.deep_unpack()[0])
+    );
+    const windows = global.display.list_all_windows().sort((a, b) => a.get_stable_sequence() - b.get_stable_sequence());
+    windows.forEach((window) => this._track(window, true));
+    // Shell start, the Quick Settings switch, or GNOME re-enabling extensions:
+    // the monitors may have changed while Tiling Shell was off. Compare with the
+    // setup that was active when it last ran.
+    this._beginTransition("enable", this._memory.active);
+    // Stopped and started again at once (GNOME re-orders extensions when one
+    // before Tiling Shell is switched off, as at lock): settle now, so every
+    // window keeps its tile without a visible gap.
+    const now = this._now();
+    const paused = windows.map((w) => w[PAUSED]).filter(Boolean);
+    if (paused.length > 0 && paused.every((pause) => now - pause.t <= REBASE_MS) && this._setupKeys(this._monitors()).key === this._memory.active) {
+      this._stableId = this._clearTimeout(this._stableId);
+      this._transition.reason = "re-enable";
+      this._settle();
+    }
+  }
+
+  // The session mode changed (lock screen shown or dismissed). Anything still
+  // waiting to be restored is done before the desktop is revealed.
+  onSessionModeChanged(locked) {
+    if (locked === this._locked) return;
+    this._locked = locked;
+    if (locked) {
+      this._lockRestores = null;
+      vitals("locked", "screen locked; windows stay where they are");
+      return;
+    }
+    if (!this._stable && this._transition) {
+      this._stableId = this._clearTimeout(this._stableId);
+      this._asleep = false;
+      this._transition.reason = `${this._transition.reason}, before unlock`;
+      vitals("unlock-restore", "unlocking with monitors just changed: restoring before the desktop is shown");
+      this._settle();
+    }
+    // Windows restored behind the lock screen were placed in the lock screen's
+    // work area; if the desktop's differs they are re-placed as it returns.
+    if (this._lockRestores?.size) {
+      this._clearTimeout(this._lockRestoreExpiry);
+      this._lockRestoreExpiry = this._timeout(3000, () => {
+        this._lockRestoreExpiry = 0;
+        this._lockRestores = null;
+      });
+    }
+  }
+
+  _reassertLockRestores(why) {
+    if (!this._lockRestores?.size) return;
+    const monitors = this._monitors();
+    let count = 0;
+    for (const [window, p] of this._lockRestores) {
+      if (!this._windows.has(window) || (window[TOUCHED] ?? 0) > this._lockRestoresAt) continue;
+      if (this._exactlyAt(window, p, monitors)) continue;
+      this._apply(window, p, monitors);
+      count++;
+    }
+    if (count > 0) vitals("restore-reasserted", `${count} window(s) re-placed: ${why}`, { reason: why, windows: count });
+  }
+
+  destroy() {
+    if (this._stable) this._windows.forEach((_d, window) => this._flushSettle(window));
+    const now = this._now();
+    const monitors = this._monitors();
+    for (const [window, data] of this._windows) {
+      if (!data.mapped || notRememberableReason(window)) continue;
+      window[PAUSED] = { t: now, setup: this._stable ? this._setupKey : null, frame: frameOf(window), p: this._placementOf(window, monitors) };
+    }
+    this._windows.forEach((data, window) => this._commitSession(window, data));
+    if (this._flushId) GLib.source_remove(this._flushId);
+    this._flushId = 0;
+    for (const [object, id] of this._signals) {
+      try {
+        object.disconnect(id);
+      } catch (e) {
+      }
+    }
+    this._signals = [];
+    for (const [window, data] of this._windows) this._untrack(window, data, false);
+    this._windows.clear();
+    for (const id of this._sources) GLib.source_remove(id);
+    this._sources.clear();
+    this._stableId = 0;
+    if (this._saveId) {
+      GLib.source_remove(this._saveId);
+      this._saveId = 0;
+    }
+    if (this._sleepSubscription) Gio.DBus.system.signal_unsubscribe(this._sleepSubscription);
+    this._sleepSubscription = 0;
+    this._save();
+  }
+
+  // The person moved, resized, tiled or maximized this window.
+  touch(window, why) {
+    if (!window || !this._windows.has(window)) return;
+    window[TOUCHED] = this._now();
+    this._windows.get(window).touchedWhy = why;
+  }
+
+  onPrepareForSleep(sleeping) {
+    vitals(sleeping ? "sleep" : "wake", sleeping ? "going to sleep; recording paused" : "woke up; waiting for monitors");
+    this._asleep = sleeping;
+    if (sleeping) this._beginTransition("sleep", this._setupKey, false);
+    else this._beginTransition("wake", this._transition?.from ?? this._setupKey);
+  }
+
+  debugState() {
+    return {
+      enabled: this._enabled,
+      stable: this._stable,
+      setup: this._setupKey,
+      monitors: this._monitors().map((m) => ({ index: m.index, key: m.key, role: m.role })),
+      windows: [...this._windows.keys()].map((w) => ({
+        title: w.get_title(),
+        app: w[APP] ?? null,
+        ordinal: w[ORDINAL] ?? null,
+        touched: !!w[TOUCHED],
+        placement: this._placementOf(w, this._monitors())
+      })),
+      memory: this._memory
+    };
+  }
+
+  _now() {
+    return Date.now() + (LumaWindowMemory.testHooks?.timeOffset ?? 0);
+  }
+
+  _connect(object, signal, callback) {
+    this._signals.push([object, object.connect(signal, callback)]);
+  }
+
+  _timeout(ms, callback) {
+    const id = GLib.timeout_add(GLib.PRIORITY_DEFAULT, ms, () => {
+      this._sources.delete(id);
+      callback();
+      return GLib.SOURCE_REMOVE;
+    });
+    this._sources.add(id);
+    return id;
+  }
+
+  _clearTimeout(id) {
+    if (id && this._sources.delete(id)) GLib.source_remove(id);
+    return 0;
+  }
+
+  // ---- memory file -------------------------------------------------------
+
+  _load() {
+    const reset = Number(this._settings.get_int64(KEY_RESET));
+    try {
+      const [ok, bytes] = GLib.file_get_contents(stateFile());
+      const value = ok ? JSON.parse(new TextDecoder().decode(bytes)) : null;
+      if (value?.version === VERSION && value.reset === reset && typeof value.setups === "object") {
+        this._memory = value;
+        return;
+      }
+    } catch (e) {
+    }
+    this._memory = emptyMemory(reset);
+  }
+
+  _queueSave() {
+    if (this._saveId) return;
+    this._saveId = GLib.timeout_add(GLib.PRIORITY_LOW, this.timing.save, () => {
+      this._saveId = 0;
+      this._save();
+      return GLib.SOURCE_REMOVE;
+    });
+  }
+
+  // The person just placed a window: survive a reboot or Shell crash seconds later.
+  _saveSoon() {
+    if (this._saveId) GLib.source_remove(this._saveId);
+    this._saveId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, this.timing.touchedSave, () => {
+      this._saveId = 0;
+      this._save();
+      return GLib.SOURCE_REMOVE;
+    });
+  }
+
+  _prune() {
+    const now = this._now();
+    const setups = Object.entries(this._memory.setups).sort((a, b) => (b[1].seen ?? 0) - (a[1].seen ?? 0));
+    setups.slice(MAX_SETUPS).forEach(([key]) => delete this._memory.setups[key]);
+    for (const [, setup] of setups.slice(0, MAX_SETUPS)) {
+      const apps = Object.entries(setup.apps ?? {}).map(([app, roles]) => {
+        let latest = 0;
+        for (const [role, entry] of Object.entries(roles)) {
+          entry.hist = (entry.hist ?? []).filter((h) => now - h.t < EXPIRE_MS).sort((a, b) => decayed(b, now) - decayed(a, now)).slice(0, MAX_HISTOGRAM);
