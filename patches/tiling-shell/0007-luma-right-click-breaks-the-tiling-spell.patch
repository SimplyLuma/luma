From: Project Luma
Subject: [PATCH] luma: a right-click or a Control tap while dragging breaks the tiling spell

A person dragging with the mouse should be able to say "not this one"
without holding a key. A right-click, or a tap of Control, during the drag
now turns tiling off for the rest of that drag: the layout, previews,
snap assist and edge tiling close, and the window is dropped where it is.
Doing it again brings tiling back. Each toggle is logged. Mutter keeps the
drag running for the click (mutter patch 0009).

--- a/components/tilingsystem/tilingManager.js
+++ b/components/tilingsystem/tilingManager.js
@@ -429,6 +429,13 @@
       });
     }
     this._isGrabbingWindow = true;
+    // Luma: a right-click or a tap of Control while dragging breaks the spell
+    // -- the window moves freely and is not tiled when dropped. Doing it again
+    // brings tiling back. Mutter leaves the drag running for the click (0009).
+    const lumaStart = global.get_pointer()[2];
+    this._lumaTilingSuspended = false;
+    this._lumaSecondaryHeld = (lumaStart & Clutter.ModifierType.BUTTON3_MASK) !== 0;
+    this._lumaControlHeld = (lumaStart & Clutter.ModifierType.CONTROL_MASK) !== 0;
     this._movingWindowTimerId = GLib.timeout_add(
       GLib.PRIORITY_DEFAULT_IDLE,
       this._movingWindowTimerDuration,
@@ -518,6 +525,24 @@
       extWin.originalSize = void 0;
       this._grabStartPosition = null;
     }
+    const lumaSecondaryHeld = (modifier & Clutter.ModifierType.BUTTON3_MASK) !== 0;
+    const lumaControlHeld = (modifier & Clutter.ModifierType.CONTROL_MASK) !== 0;
+    if ((lumaSecondaryHeld && !this._lumaSecondaryHeld) || (lumaControlHeld && !this._lumaControlHeld)) {
+      this._lumaTilingSuspended = !this._lumaTilingSuspended;
+      this._lastCursorPos = null;
+      console.log(`[luma-tiling] ${lumaSecondaryHeld ? "right-click" : "Control"}: tiling ${this._lumaTilingSuspended ? "off" : "on"} for this drag`);
+    }
+    this._lumaSecondaryHeld = lumaSecondaryHeld;
+    this._lumaControlHeld = lumaControlHeld;
+    if (this._lumaTilingSuspended) {
+      tilingLayout.close();
+      this._selectedTilesPreview.close(true);
+      this._snapAssist.close(true);
+      this._snapAssistingInfo.update(void 0);
+      this._edgeTilingManager.abortEdgeTiling();
+      this._wasTilingSystemActivated = false;
+      return GLib.SOURCE_CONTINUE;
+    }
     const isSpanMultiTilesActivated = this._activationKeyStatus(
       modifier,
       Settings.SPAN_MULTIPLE_TILES_ACTIVATION_KEY
@@ -610,6 +635,12 @@
     this._selectedTilesPreview.close(true);
     this._snapAssist.close(true);
     this._lastCursorPos = null;
+    if (this._lumaTilingSuspended) {
+      this._lumaTilingSuspended = false;
+      this._snapAssistingInfo.update(void 0);
+      this._edgeTilingManager.abortEdgeTiling();
+      return;
+    }
     const modifier = global.get_pointer()[2];
     const deactivationKey = Settings.TILING_SYSTEM_DEACTIVATION_KEY;
     const isTilingSystemDeactivated = deactivationKey === ActivationKey.NONE ? false : this._activationKeyStatus(modifier, deactivationKey);
