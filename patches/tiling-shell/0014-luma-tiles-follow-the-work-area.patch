+      if (window._lumaReflowMoves.length >= LUMA_REFLOW_BURST) {
+        if (!window._lumaReflowStopped) {
+          window._lumaReflowStopped = true;
+          lumaTilingVitals("reflow-stopped", `stopped re-tiling "${window.title}": moved ${window._lumaReflowMoves.length} times in ${LUMA_REFLOW_WINDOW} ms`, { title: window.title, monitor: this._monitor.index });
