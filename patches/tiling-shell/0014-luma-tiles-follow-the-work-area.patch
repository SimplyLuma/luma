+// Luma: one gap everywhere. The Dash's reservation on an edge already
+// includes the margin a window keeps from an island, so the outer gap on
+// that edge is only what is left to make up the gap between windows; on an
+// edge the Dash does not hold, the whole gap is the outer gap. A window is
+// then exactly one gap from another window, from an island and from the
+// screen.
+function lumaOuterGaps(monitorIndex, scaleFactor = 1) {
+  const gaps = Settings.get_outer_gaps(scaleFactor);
+  const reserved = Main.shelf?.reservedMargins?.(monitorIndex) ?? {};
+  const side = (name) => Math.max(0, gaps[name] - (reserved[name] ?? 0) * scaleFactor);
