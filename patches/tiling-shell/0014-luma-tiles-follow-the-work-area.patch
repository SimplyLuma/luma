+      if (dest.width <= 0 || dest.height <= 0 || before.equal(dest))
+        continue;
+      window._lumaReflowMoves.push(now);
+      // One continuous glide of the window's frame, no fade, on the Dash's
+      // curve (Luma Shell); never move_to_monitor: a window stays on its
+      // tile's monitor.
