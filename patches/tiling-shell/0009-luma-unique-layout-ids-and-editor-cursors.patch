 import { getWindows } from "./ui.js";
 import * as LumaLayoutMemory from "./lumaLayoutMemory.js";
 const debug = logger("GlobalState");
+// Luma: every layout needs its own id. New layouts were named after the
+// current event time, which is 0 when no event is being handled, so several
+// layouts could share "0" and choosing any of them selected the first. A
+// repeated id is renamed; the first layout keeps it.
+function lumaUniqueLayoutIds(layouts) {
+  const seen = new Set();
+  let changed = false;
+  for (const layout of layouts) {
+    let id = typeof layout.id === "string" && layout.id !== "" ? layout.id : "Layout";
+    if (seen.has(id) || id !== layout.id) {
+      let n = 2;
+      while (seen.has(`${id} ${n}`)) n++;
+      id = `${id} ${n}`;
+      layout.id = id;
+      changed = true;
+    }
+    seen.add(id);
+  }
+  return changed;
+}
+export function lumaNewLayoutId(layouts) {
+  const taken = new Set(layouts.map((layout) => layout.id));
+  let id = `${Date.now()}`;
+  while (taken.has(id)) id = `${Number(id) + 1}`;
+  return id;
+}
 const _GlobalState = class _GlobalState extends GObject.Object {
   _signals;
   _layouts;
