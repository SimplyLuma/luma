index 0000000..a728708
--- /dev/null
+++ b/tests/templates/audiocapture.py
@@ -0,0 +1,142 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+#
+# This file is formatted with Python Black
+# mypy: disable-error-code="misc"
+
+from tests.templates.xdp_utils import Response, init_logger, ImplRequest, ImplSession
+
+import dbus
+import dbus.service
+from dataclasses import dataclass
+
+
+BUS_NAME = "org.freedesktop.impl.portal.Test"
+MAIN_OBJ = "/org/freedesktop/portal/desktop"
+SYSTEM_BUS = False
+MAIN_IFACE = "org.freedesktop.impl.portal.AudioCapture"
+VERSION = 1
+
+
+logger = init_logger(__name__)
+
+
+@dataclass
+class AudioCaptureParameters:
+    delay: int
+    response: int
+    n_streams: int
+    node_id: int
+
+
+def load(mock, parameters={}):
+    logger.debug(f"Loading parameters: {parameters}")
+
+    assert not hasattr(mock, "audiocapture_params")
+    mock.audiocapture_params = AudioCaptureParameters(
+        delay=parameters.get("delay", 50),
+        response=parameters.get("response", 0),
+        n_streams=parameters.get("n-streams", 1),
+        node_id=parameters.get("node-id", 42),
+    )
+
+    mock.AddProperties(
+        MAIN_IFACE,
+        dbus.Dictionary(
+            {
+                "version": dbus.UInt32(parameters.get("version", VERSION)),
+                "AvailableSourceTypes": dbus.UInt32(
+                    parameters.get("source-types", 0b11)
+                ),
+                "AvailableAudioModes": dbus.UInt32(parameters.get("audio-modes", 0b110)),
+            }
+        ),
+    )
+    mock.sessions: dict[str, ImplSession] = {}
+    mock.selected: dict[str, dict] = {}
+
+
+@dbus.service.method(
+    MAIN_IFACE,
+    in_signature="oosa{sv}",
+    out_signature="ua{sv}",
+    async_callbacks=("cb_success", "cb_error"),
+)
+def CreateSession(self, handle, session_handle, app_id, options, cb_success, cb_error):
+    logger.debug(f"CreateSession({handle}, {session_handle}, {app_id}, {options})")
+    params = self.audiocapture_params
+
+    session = ImplSession(self, BUS_NAME, session_handle, app_id).export()
+    self.sessions[session_handle] = session
+
+    request = ImplRequest(self, BUS_NAME, handle, logger, cb_success, cb_error)
+    request.respond(
+        Response(params.response, {"session_handle": session.handle}),
+        delay=params.delay,
+    )
+
+
+@dbus.service.method(
+    MAIN_IFACE,
+    in_signature="oosa{sv}",
+    out_signature="ua{sv}",
+    async_callbacks=("cb_success", "cb_error"),
+)
+def SelectSources(self, handle, session_handle, app_id, options, cb_success, cb_error):
+    logger.debug(f"SelectSources({handle}, {session_handle}, {app_id}, {options})")
+    params = self.audiocapture_params
+
+    assert session_handle in self.sessions
+    self.selected[session_handle] = dict(options)
+
+    request = ImplRequest(self, BUS_NAME, handle, logger, cb_success, cb_error)
+    request.respond(Response(params.response, {}), delay=params.delay)
+
+
+@dbus.service.method(
+    MAIN_IFACE,
+    in_signature="oossa{sv}",
+    out_signature="ua{sv}",
+    async_callbacks=("cb_success", "cb_error"),
+)
+def Start(
+    self, handle, session_handle, app_id, parent_window, options, cb_success, cb_error
+):
+    logger.debug(f"Start({handle}, {session_handle}, {app_id}, {parent_window}, {options})")
+    params = self.audiocapture_params
+
+    assert session_handle in self.sessions
+    selected = self.selected.get(session_handle, {})
+
+    streams = [
+        (
+            dbus.UInt32(params.node_id + index),
+            dbus.Dictionary(
+                {
+                    "source_type": dbus.UInt32(1),
+                    "applications": dbus.Array(["Test Tone"], signature="s"),
+                    "pipewire-serial": dbus.UInt64(1000 + index),
+                },
+                signature="sv",
+            ),
+        )
+        for index in range(params.n_streams)
+    ]
+    results = {"streams": dbus.Array(streams, signature="(ua{sv})")}
+    persist_mode = selected.get("persist_mode", 0)
+    if persist_mode:
+        results["persist_mode"] = dbus.UInt32(persist_mode)
+        results["restore_data"] = dbus.Struct(
+            (
+                "test",
+                dbus.UInt32(1),
+                dbus.Dictionary(
+                    {"apps": dbus.Array(["test.tone"], signature="s")},
+                    signature="sv",
+                    variant_level=1,
+                ),
+            ),
+            signature="suv",
+        )
+
+    request = ImplRequest(self, BUS_NAME, handle, logger, cb_success, cb_error)
+    request.respond(Response(params.response, results), delay=params.delay)
diff --git a/tests/test_audiocapture.py b/tests/test_audiocapture.py
new file mode 100644
index 0000000..96a55ee
--- /dev/null
+++ b/tests/test_audiocapture.py
@@ -0,0 +1,152 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+#
+# This file is formatted with Python Black
+
+import tests.xdp_utils as xdp
+
+import dbus
+import pytest
+
+
+@pytest.fixture
+def required_templates():
+    return {"audiocapture": {}}
+
+
+def create_session(dbus_con, token="session_token0"):
+    audiocapture_intf = xdp.get_portal_iface(dbus_con, "AudioCapture")
+    request = xdp.Request(dbus_con, audiocapture_intf)
+    response = request.call("CreateSession", options={"session_handle_token": token})
+    assert response
+    assert response.response == 0
+    return audiocapture_intf, xdp.Session.from_response(dbus_con, response)
+
+
+def select_sources(dbus_con, intf, session, **options):
+    request = xdp.Request(dbus_con, intf)
+    return request.call("SelectSources", session_handle=session.handle, options=options)
+
+
+def start(dbus_con, intf, session):
+    request = xdp.Request(dbus_con, intf)
+    return request.call("Start", session_handle=session.handle, parent_window="", options={})
+
+
+class TestAudioCapture:
+    def test_version(self, portals, dbus_con):
+        xdp.check_version(dbus_con, "AudioCapture", 1)
+
+    def test_properties(self, portals, dbus_con):
+        properties = dbus.Interface(
+            dbus_con.get_object("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop"),
+            "org.freedesktop.DBus.Properties",
+        )
+        iface = "org.freedesktop.portal.AudioCapture"
+        assert properties.Get(iface, "AvailableSourceTypes") == 0b11
+        assert properties.Get(iface, "AvailableAudioModes") == 0b110
+
+    def test_create_close_session(self, portals, dbus_con, xdp_app_info):
+        mock_intf = xdp.get_mock_iface(dbus_con)
+        intf, session = create_session(dbus_con)
+
+        method_calls = mock_intf.GetMethodCalls("CreateSession")
+        assert len(method_calls) > 0
+        _, args = method_calls[-1]
+        assert args[1] == session.handle
+        assert args[2] == xdp_app_info.app_id
+
+        session.close()
+        xdp.wait_for(lambda: session.closed)
+
+    @pytest.mark.parametrize("types", (0, 4, 0b111))
+    def test_invalid_types(self, portals, dbus_con, types):
+        intf, session = create_session(dbus_con)
+        with pytest.raises(dbus.exceptions.DBusException) as excinfo:
+            select_sources(dbus_con, intf, session, types=dbus.UInt32(types))
+        assert excinfo.value.get_dbus_name() == "org.freedesktop.portal.Error.InvalidArgument"
+
+    @pytest.mark.parametrize("mode", (1, 0b110, 8))
+    def test_invalid_audio_mode(self, portals, dbus_con, mode):
+        intf, session = create_session(dbus_con)
+        with pytest.raises(dbus.exceptions.DBusException) as excinfo:
+            select_sources(dbus_con, intf, session, audio_mode=dbus.UInt32(mode))
+        assert excinfo.value.get_dbus_name() == "org.freedesktop.portal.Error.InvalidArgument"
+
+    def test_start_returns_one_stream(self, portals, dbus_con):
+        mock_intf = xdp.get_mock_iface(dbus_con)
+        intf, session = create_session(dbus_con)
+
+        response = select_sources(
+            dbus_con, intf, session, types=dbus.UInt32(1), multiple=True,
+            audio_mode=dbus.UInt32(2),
+        )
+        assert response.response == 0
+        _, args = mock_intf.GetMethodCalls("SelectSources")[-1]
+        assert args[3]["types"] == 1
+        assert args[3]["multiple"] is True or args[3]["multiple"] == 1
+        assert args[3]["audio_mode"] == 2
+
+        response = start(dbus_con, intf, session)
+        assert response.response == 0
+        streams = response.results["streams"]
+        assert len(streams) == 1
+        node_id, props = streams[0]
+        assert node_id == 42
+        assert props["source_type"] == 1
+        assert list(props["applications"]) == ["Test Tone"]
+        assert props["pipewire-serial"] == 1000
+        assert "restore_token" not in response.results
+
+    def test_start_twice_fails(self, portals, dbus_con):
+        intf, session = create_session(dbus_con)
+        select_sources(dbus_con, intf, session)
+        assert start(dbus_con, intf, session).response == 0
+        with pytest.raises(dbus.exceptions.DBusException):
+            start(dbus_con, intf, session)
+
+    def test_start_before_select_fails(self, portals, dbus_con):
+        intf, session = create_session(dbus_con)
+        with pytest.raises(dbus.exceptions.DBusException):
+            start(dbus_con, intf, session)
+
+    @pytest.mark.parametrize("template_params", ({"audiocapture": {"n-streams": 2}},))
+    def test_backend_must_return_one_stream(self, portals, dbus_con):
+        intf, session = create_session(dbus_con)
+        select_sources(dbus_con, intf, session)
+        response = start(dbus_con, intf, session)
+        assert response.response == 2
+        xdp.wait_for(lambda: session.closed)
+
+    def test_restore_token(self, portals, dbus_con):
+        mock_intf = xdp.get_mock_iface(dbus_con)
+        intf, session = create_session(dbus_con)
+        select_sources(dbus_con, intf, session, persist_mode=dbus.UInt32(2))
+        response = start(dbus_con, intf, session)
+        assert response.response == 0
+        token = response.results["restore_token"]
+        assert token
+        # Backends never see tokens, only their own data.
+        assert "restore_data" not in response.results
+
+        session.close()
