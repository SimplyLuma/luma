+ *
+ */
+
+/*
+ * The Audio Capture portal. Sessions, requests, restore tokens and the
+ * restricted PipeWire remote follow the ScreenCast portal (screen-cast.c);
+ * the backend decides what the user shares and returns the one node that
+ * carries it.
+ */
+
+#include "config.h"
+
+#include "audio-capture.h"
+
+#include <stdint.h>
+
+#include <gio/gunixfdlist.h>
+#include <pipewire/pipewire.h>
+
+#include "pipewire.h"
+#include "xdp-context.h"
+#include "xdp-dbus.h"
+#include "xdp-impl-dbus.h"
+#include "xdp-portal-config.h"
+#include "xdp-request.h"
+#include "xdp-session-persistence.h"
+#include "xdp-session.h"
+#include "xdp-utils.h"
+
+#define AUDIO_CAPTURE_SOURCE_TYPE_APPLICATIONS (1 << 0)
+#define AUDIO_CAPTURE_SOURCE_TYPE_SYSTEM (1 << 1)
+#define AUDIO_CAPTURE_SOURCE_TYPES_ALL \
+  (AUDIO_CAPTURE_SOURCE_TYPE_APPLICATIONS | AUDIO_CAPTURE_SOURCE_TYPE_SYSTEM)
+
+#define PERMISSION_ITEM(item_id, item_permissions) \
+  ((struct pw_permission) { \
+    .id = item_id, \
+    .permissions = item_permissions \
+  })
+
+typedef struct _AudioCapture AudioCapture;
+typedef struct _AudioCaptureClass AudioCaptureClass;
+
+struct _AudioCapture
+{
+  XdpDbusAudioCaptureSkeleton parent_instance;
+
+  XdpContext *context;
+  XdpDbusImplAudioCapture *impl;
+};
+
+struct _AudioCaptureClass
+{
+  XdpDbusAudioCaptureSkeletonClass parent_class;
+};
+
+GType audio_capture_get_type (void);
+static void audio_capture_iface_init (XdpDbusAudioCaptureIface *iface);
+
+static GQuark quark_request_session;
+
+G_DEFINE_TYPE_WITH_CODE (AudioCapture, audio_capture,
+                         XDP_DBUS_TYPE_AUDIO_CAPTURE_SKELETON,
+                         G_IMPLEMENT_INTERFACE (XDP_DBUS_TYPE_AUDIO_CAPTURE,
+                                                audio_capture_iface_init));
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (AudioCapture, g_object_unref)
+
+typedef enum _AudioCaptureSessionState
+{
+  AUDIO_CAPTURE_SESSION_STATE_INIT,
+  AUDIO_CAPTURE_SESSION_STATE_SELECTING_SOURCES,
+  AUDIO_CAPTURE_SESSION_STATE_SOURCES_SELECTED,
+  AUDIO_CAPTURE_SESSION_STATE_STARTING,
+  AUDIO_CAPTURE_SESSION_STATE_STARTED,
+  AUDIO_CAPTURE_SESSION_STATE_CLOSED
+} AudioCaptureSessionState;
+
+typedef struct _AudioCaptureSession
+{
+  XdpSession parent;
+
+  AudioCaptureSessionState state;
+
+  /* The one node the backend created for this session, or 0. */
+  uint32_t node_id;
+  char *restore_token;
+  XdpSessionPersistenceMode persist_mode;
+  GVariant *restore_data;
+} AudioCaptureSession;
+
+typedef struct _AudioCaptureSessionClass
+{
+  XdpSessionClass parent_class;
+} AudioCaptureSessionClass;
+
+GType audio_capture_session_get_type (void);
+
+G_DEFINE_TYPE (AudioCaptureSession, audio_capture_session, xdp_session_get_type ())
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (AudioCaptureSession, g_object_unref);
+
+G_GNUC_UNUSED static inline AudioCaptureSession *
+AUDIO_CAPTURE_SESSION (gpointer ptr)
+{
+  return G_TYPE_CHECK_INSTANCE_CAST (ptr, audio_capture_session_get_type (), AudioCaptureSession);
+}
+
+G_GNUC_UNUSED static inline gboolean
+IS_AUDIO_CAPTURE_SESSION (gpointer ptr)
+{
+  return G_TYPE_CHECK_INSTANCE_TYPE (ptr, audio_capture_session_get_type ());
+}
+
+static void
+audio_capture_session_close (XdpSession *session)
+{
+  AudioCaptureSession *audio_capture_session = AUDIO_CAPTURE_SESSION (session);
+
+  audio_capture_session->state = AUDIO_CAPTURE_SESSION_STATE_CLOSED;
+
+  xdp_session_persistence_generate_and_save_restore_token (session,
+                                                           AUDIO_CAPTURE_PERMISSION_TABLE,
+                                                           audio_capture_session->persist_mode,
+                                                           &audio_capture_session->restore_token,
+                                                           &audio_capture_session->restore_data);
+
+  g_debug ("audio capture session owned by '%s' closed", session->sender);
+}
+
+static void
+audio_capture_session_finalize (GObject *object)
+{
+  AudioCaptureSession *audio_capture_session = AUDIO_CAPTURE_SESSION (object);
+
+  g_clear_pointer (&audio_capture_session->restore_token, g_free);
+  g_clear_pointer (&audio_capture_session->restore_data, g_variant_unref);
+
+  G_OBJECT_CLASS (audio_capture_session_parent_class)->finalize (object);
+}
+
+static void
+audio_capture_session_init (AudioCaptureSession *audio_capture_session)
+{
+}
+
+static void
+audio_capture_session_class_init (AudioCaptureSessionClass *klass)
+{
+  GObjectClass *object_class;
+  XdpSessionClass *session_class;
+
+  object_class = G_OBJECT_CLASS (klass);
+  object_class->finalize = audio_capture_session_finalize;
+
+  session_class = (XdpSessionClass *)klass;
+  session_class->close = audio_capture_session_close;
+}
+
+static AudioCaptureSession *
+audio_capture_session_new (AudioCapture  *audio_capture,
+                           GVariant      *options,
+                           XdpRequest    *request,
+                           GError       **error)
+{
+  XdpSession *session;
+  GDBusInterfaceSkeleton *interface_skeleton =
+    G_DBUS_INTERFACE_SKELETON (request);
+  const char *session_token;
+  GDBusConnection *connection =
+    g_dbus_interface_skeleton_get_connection (interface_skeleton);
+  GDBusConnection *impl_connection =
+    g_dbus_proxy_get_connection (G_DBUS_PROXY (audio_capture->impl));
+  const char *impl_dbus_name =
+    g_dbus_proxy_get_name (G_DBUS_PROXY (audio_capture->impl));
+
+  session_token = lookup_session_token (options);
+  session = g_initable_new (audio_capture_session_get_type (), NULL, error,
+                            "context", audio_capture->context,
+                            "sender", request->sender,
+                            "app-id", xdp_app_info_get_id (request->app_info),
+                            "token", session_token,
+                            "connection", connection,
+                            "impl-connection", impl_connection,
+                            "impl-dbus-name", impl_dbus_name,
+                            NULL);
+
+  if (session)
+    g_debug ("audio capture session owned by '%s' created", session->sender);
+
+  return (AudioCaptureSession *) session;
+}
+
+/* CreateSession ------------------------------------------------------------ */
+
+static void
+create_session_done (GObject      *source_object,
+                     GAsyncResult *res,
+                     gpointer      data)
+{
+  XdpDbusImplAudioCapture *impl = (XdpDbusImplAudioCapture *) source_object;
+  g_autoptr(XdpRequest) request = data;
+  XdpSession *session;
+  guint response = 2;
+  gboolean should_close_session;
+  g_auto(GVariantBuilder) results_builder =
+    G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE_VARDICT);
+  g_autoptr(GError) error = NULL;
+
+  REQUEST_AUTOLOCK (request);
+
+  session = g_object_get_qdata (G_OBJECT (request), quark_request_session);
+  SESSION_AUTOLOCK_UNREF (g_object_ref (session));
+  g_object_set_qdata (G_OBJECT (request), quark_request_session, NULL);
+
+  if (!xdp_dbus_impl_audio_capture_call_create_session_finish (impl,
+                                                               &response,
+                                                               NULL,
+                                                               res,
+                                                               &error))
+    {
+      g_dbus_error_strip_remote_error (error);
+      g_warning ("A backend call failed: %s", error->message);
+      should_close_session = TRUE;
+      goto out;
+    }
+
+  if (request->exported && response == 0)
+    {
+      if (!xdp_session_export (session, &error))
+        {
+          g_warning ("Failed to export session: %s", error->message);
+          response = 2;
+          should_close_session = TRUE;
+          goto out;
+        }
+
+      should_close_session = FALSE;
+      xdp_session_register (session);
+    }
+  else
+    {
+      should_close_session = TRUE;
+    }
+
+  g_variant_builder_add (&results_builder, "{sv}",
+                         "session_handle", g_variant_new_string (session->id));
+
+out:
+  if (request->exported)
+    {
+      xdp_dbus_request_emit_response (XDP_DBUS_REQUEST (request),
+                                      response,
+                                      g_variant_builder_end (&results_builder));
+      xdp_request_unexport (request);
+    }
+
+  if (should_close_session)
+    xdp_session_close (session, FALSE);
+}
+
+static gboolean
+handle_create_session (XdpDbusAudioCapture   *object,
+                       GDBusMethodInvocation *invocation,
+                       GVariant              *arg_options)
+{
+  AudioCapture *audio_capture = (AudioCapture *) object;
+  XdpRequest *request = xdp_request_from_invocation (invocation);
+  g_autoptr(GError) error = NULL;
+  g_autoptr(XdpDbusImplRequest) impl_request = NULL;
+  XdpSession *session;
+  g_auto(GVariantBuilder) options_builder =
+    G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE_VARDICT);
+  g_autoptr(GVariant) options = NULL;
+
+  REQUEST_AUTOLOCK (request);
+
+  impl_request = xdp_dbus_impl_request_proxy_new_sync (
+    g_dbus_proxy_get_connection (G_DBUS_PROXY (audio_capture->impl)),
+    G_DBUS_PROXY_FLAGS_DO_NOT_LOAD_PROPERTIES,
+    g_dbus_proxy_get_name (G_DBUS_PROXY (audio_capture->impl)),
+    request->id,
+    NULL, &error);
+
+  if (!impl_request)
+    {
+      g_dbus_method_invocation_return_gerror (invocation, error);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  xdp_request_set_impl_request (request, impl_request);
+  xdp_request_export (request, g_dbus_method_invocation_get_connection (invocation));
+
+  session = XDP_SESSION (audio_capture_session_new (audio_capture,
+                                                    arg_options,
+                                                    request,
+                                                    &error));
+  if (!session)
+    {
+      g_dbus_method_invocation_return_gerror (invocation, error);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  options = g_variant_ref_sink (g_variant_builder_end (&options_builder));
+
+  g_object_set_qdata_full (G_OBJECT (request),
+                           quark_request_session,
+                           g_object_ref (session),
+                           g_object_unref);
+
+  xdp_dbus_impl_audio_capture_call_create_session (audio_capture->impl,
+                                                   request->id,
+                                                   session->id,
+                                                   xdp_app_info_get_id (request->app_info),
+                                                   options,
+                                                   NULL,
+                                                   create_session_done,
+                                                   g_object_ref (request));
+
+  xdp_dbus_audio_capture_complete_create_session (object, invocation, request->id);
+
+  return G_DBUS_METHOD_INVOCATION_HANDLED;
+}
+
+/* SelectSources ------------------------------------------------------------ */
+
+static void
+select_sources_done (GObject      *source_object,
+                     GAsyncResult *res,
+                     gpointer      data)
+{
+  XdpDbusImplAudioCapture *impl = (XdpDbusImplAudioCapture *) source_object;
+  g_autoptr(XdpRequest) request = data;
+  XdpSession *session;
+  guint response = 2;
+  gboolean should_close_session;
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GVariant) results = NULL;
+
+  REQUEST_AUTOLOCK (request);
+
+  session = g_object_get_qdata (G_OBJECT (request), quark_request_session);
+  SESSION_AUTOLOCK_UNREF (g_object_ref (session));
+  g_object_set_qdata (G_OBJECT (request), quark_request_session, NULL);
+
+  if (!xdp_dbus_impl_audio_capture_call_select_sources_finish (impl,
+                                                               &response,
+                                                               &results,
+                                                               res,
+                                                               &error))
+    {
+      g_dbus_error_strip_remote_error (error);
+      g_warning ("A backend call failed: %s", error->message);
+    }
+
+  should_close_session = !request->exported || response != 0;
+
+  if (request->exported)
+    {
+      if (!results)
+        {
+          g_auto(GVariantBuilder) results_builder =
+            G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE_VARDICT);
+
+          results = g_variant_ref_sink (g_variant_builder_end (&results_builder));
+        }
+
+      xdp_dbus_request_emit_response (XDP_DBUS_REQUEST (request), response, results);
+      xdp_request_unexport (request);
+    }
+
+  if (should_close_session)
+    {
+      xdp_session_close (session, TRUE);
+    }
+  else if (!session->closed)
+    {
+      AudioCaptureSession *audio_capture_session = AUDIO_CAPTURE_SESSION (session);
+
+      g_assert_cmpint (audio_capture_session->state,
+                       ==,
+                       AUDIO_CAPTURE_SESSION_STATE_SELECTING_SOURCES);
+      audio_capture_session->state = AUDIO_CAPTURE_SESSION_STATE_SOURCES_SELECTED;
+    }
+}
+
+static gboolean
+validate_source_types (const char  *key,
+                       GVariant    *value,
+                       GVariant    *options,
+                       gpointer     user_data,
+                       GError     **error)
+{
+  AudioCapture *audio_capture = user_data;
+  uint32_t available =
+    xdp_dbus_audio_capture_get_available_source_types (XDP_DBUS_AUDIO_CAPTURE (audio_capture));
+  uint32_t types = g_variant_get_uint32 (value);
+
+  if (types == 0 || (types & ~AUDIO_CAPTURE_SOURCE_TYPES_ALL) != 0)
+    {
+      g_set_error (error, XDG_DESKTOP_PORTAL_ERROR, XDG_DESKTOP_PORTAL_ERROR_INVALID_ARGUMENT,
+                   "Unsupported source types: %x", types);
+      return FALSE;
+    }
+
+  if ((types & available) == 0)
+    {
+      g_set_error (error, XDG_DESKTOP_PORTAL_ERROR, XDG_DESKTOP_PORTAL_ERROR_INVALID_ARGUMENT,
+                   "Unavailable source types: %x", types);
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+validate_audio_mode (const char  *key,
+                     GVariant    *value,
+                     GVariant    *options,
+                     gpointer     user_data,
+                     GError     **error)
+{
+  AudioCapture *audio_capture = user_data;
+  uint32_t available =
+    xdp_dbus_audio_capture_get_available_audio_modes (XDP_DBUS_AUDIO_CAPTURE (audio_capture));
+  uint32_t mode = g_variant_get_uint32 (value);
+
+  if (__builtin_popcount (mode) != 1)
+    {
+      g_set_error (error, XDG_DESKTOP_PORTAL_ERROR, XDG_DESKTOP_PORTAL_ERROR_INVALID_ARGUMENT,
+                   "Invalid audio mode %x", mode);
+      return FALSE;
+    }
+
+  if (!(available & mode))
+    {
+      g_set_error (error, XDG_DESKTOP_PORTAL_ERROR, XDG_DESKTOP_PORTAL_ERROR_INVALID_ARGUMENT,
+                   "Unavailable audio mode %x", mode);
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+validate_restore_token (const char  *key,
+                        GVariant    *value,
+                        GVariant    *options,
+                        gpointer     user_data,
+                        GError     **error)
+{
+  const char *restore_token = g_variant_get_string (value, NULL);
+  return xdp_session_persistence_validate_restore_token (restore_token, error);
+}
+
+static gboolean
+validate_persist_mode (const char  *key,
+                       GVariant    *value,
+                       GVariant    *options,
+                       gpointer     user_data,
+                       GError     **error)
+{
+  return xdp_session_persistence_validate_persist_mode (g_variant_get_uint32 (value),
+                                                        error);
+}
+
+static XdpOptionKey audio_capture_select_sources_options[] = {
+  { "types", G_VARIANT_TYPE_UINT32, validate_source_types },
+  { "multiple", G_VARIANT_TYPE_BOOLEAN, NULL },
+  { "audio_mode", G_VARIANT_TYPE_UINT32, validate_audio_mode },
+  { "restore_token", G_VARIANT_TYPE_STRING, validate_restore_token },
+  { "persist_mode", G_VARIANT_TYPE_UINT32, validate_persist_mode },
+};
+
+static gboolean
+handle_select_sources (XdpDbusAudioCapture   *object,
+                       GDBusMethodInvocation *invocation,
+                       const char            *arg_session_handle,
+                       GVariant              *arg_options)
+{
+  AudioCapture *audio_capture = (AudioCapture *) object;
+  XdpRequest *request = xdp_request_from_invocation (invocation);
+  XdpSession *session;
+  AudioCaptureSession *audio_capture_session;
+  g_autoptr(GError) error = NULL;
+  g_autoptr(XdpDbusImplRequest) impl_request = NULL;
+  g_auto(GVariantBuilder) options_builder =
+    G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE_VARDICT);
+  g_autoptr(GVariant) options = NULL;
+  XdpSessionPersistenceMode persist_mode;
+
+  REQUEST_AUTOLOCK (request);
+
+  session = xdp_session_from_request (arg_session_handle, request);
+  if (!session || !IS_AUDIO_CAPTURE_SESSION (session))
+    {
+      g_dbus_method_invocation_return_error (invocation,
+                                             G_DBUS_ERROR,
+                                             G_DBUS_ERROR_ACCESS_DENIED,
+                                             "Invalid session");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  SESSION_AUTOLOCK_UNREF (session);
+
+  audio_capture_session = AUDIO_CAPTURE_SESSION (session);
+  switch (audio_capture_session->state)
+    {
+    case AUDIO_CAPTURE_SESSION_STATE_INIT:
+      break;
+    case AUDIO_CAPTURE_SESSION_STATE_SELECTING_SOURCES:
+    case AUDIO_CAPTURE_SESSION_STATE_SOURCES_SELECTED:
+      g_dbus_method_invocation_return_error (invocation,
+                                             G_DBUS_ERROR,
+                                             G_DBUS_ERROR_FAILED,
+                                             "Sources already selected");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    case AUDIO_CAPTURE_SESSION_STATE_STARTING:
+    case AUDIO_CAPTURE_SESSION_STATE_STARTED:
+      g_dbus_method_invocation_return_error (invocation,
+                                             G_DBUS_ERROR,
+                                             G_DBUS_ERROR_FAILED,
+                                             "Can only select sources before starting");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    case AUDIO_CAPTURE_SESSION_STATE_CLOSED:
+      g_dbus_method_invocation_return_error (invocation,
+                                             G_DBUS_ERROR,
+                                             G_DBUS_ERROR_FAILED,
+                                             "Invalid session");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  impl_request = xdp_dbus_impl_request_proxy_new_sync (
+    g_dbus_proxy_get_connection (G_DBUS_PROXY (audio_capture->impl)),
+    G_DBUS_PROXY_FLAGS_DO_NOT_LOAD_PROPERTIES,
+    g_dbus_proxy_get_name (G_DBUS_PROXY (audio_capture->impl)),
+    request->id,
+    NULL, &error);
+
+  if (!impl_request)
+    {
+      g_dbus_method_invocation_return_gerror (invocation, error);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  xdp_request_set_impl_request (request, impl_request);
+  xdp_request_export (request, g_dbus_method_invocation_get_connection (invocation));
+
+  if (!xdp_filter_options (arg_options, &options_builder,
+                           audio_capture_select_sources_options,
+                           G_N_ELEMENTS (audio_capture_select_sources_options),
+                           audio_capture, &error))
+    {
+      g_dbus_method_invocation_return_gerror (invocation, error);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  options = g_variant_ref_sink (g_variant_builder_end (&options_builder));
+
+  if (!g_variant_lookup (options, "persist_mode", "u", &persist_mode))
+    persist_mode = XDP_SESSION_PERSISTENCE_MODE_NONE;
+  audio_capture_session->persist_mode = persist_mode;
+
+  /* A restore token becomes the data it stands for. Backends never see
+   * tokens, only what they returned for an earlier session of the same app.
+   */
+  xdp_session_persistence_replace_restore_token_with_data (session,
+                                                           AUDIO_CAPTURE_PERMISSION_TABLE,
+                                                           &options,
+                                                           &audio_capture_session->restore_token);
+
+  g_object_set_qdata_full (G_OBJECT (request),
+                           quark_request_session,
+                           g_object_ref (session),
+                           g_object_unref);
+  audio_capture_session->state = AUDIO_CAPTURE_SESSION_STATE_SELECTING_SOURCES;
+
+  xdp_dbus_impl_audio_capture_call_select_sources (audio_capture->impl,
+                                                   request->id,
+                                                   arg_session_handle,
+                                                   xdp_app_info_get_id (request->app_info),
+                                                   options,
+                                                   NULL,
+                                                   select_sources_done,
+                                                   g_object_ref (request));
+
+  xdp_dbus_audio_capture_complete_select_sources (object, invocation, request->id);
+
+  return G_DBUS_METHOD_INVOCATION_HANDLED;
+}
+
+/* Start -------------------------------------------------------------------- */
+
+static gboolean
+process_results (AudioCaptureSession  *audio_capture_session,
+                 GVariant            **in_out_results,
+                 GError              **error)
+{
+  g_autoptr(GVariantIter) streams_iter = NULL;
+  g_autoptr(GVariant) stream_options = NULL;
+  uint32_t node_id;
+  GVariant *results = *in_out_results;
+
+  if (!g_variant_lookup (results, "streams", "a(ua{sv})", &streams_iter))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED, "No streams");
+      return FALSE;
+    }
+
+  /* Exactly one node: everything the user chose, mixed by the backend. */
+  if (g_variant_iter_n_children (streams_iter) != 1 ||
+      !g_variant_iter_next (streams_iter, "(u@a{sv})", &node_id, &stream_options) ||
+      node_id == 0 || node_id == SPA_ID_INVALID)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                   "The backend must return exactly one stream");
+      return FALSE;
+    }
+
+  audio_capture_session->node_id = node_id;
+
+  xdp_session_persistence_replace_restore_data_with_token (XDP_SESSION (audio_capture_session),
+                                                           AUDIO_CAPTURE_PERMISSION_TABLE,
+                                                           in_out_results,
+                                                           &audio_capture_session->persist_mode,
+                                                           &audio_capture_session->restore_token,
+                                                           &audio_capture_session->restore_data);
+  return TRUE;
+}
+
+static void
+start_done (GObject      *source_object,
+            GAsyncResult *res,
+            gpointer      data)
+{
+  XdpDbusImplAudioCapture *impl = (XdpDbusImplAudioCapture *) source_object;
+  g_autoptr(XdpRequest) request = data;
+  XdpSession *session;
+  AudioCaptureSession *audio_capture_session;
+  guint response = 2;
+  gboolean should_close_session;
+  g_autoptr(GVariant) results = NULL;
+  g_autoptr(GError) error = NULL;
+
+  REQUEST_AUTOLOCK (request);
+
+  session = g_object_get_qdata (G_OBJECT (request), quark_request_session);
+  SESSION_AUTOLOCK_UNREF (g_object_ref (session));
+  g_object_set_qdata (G_OBJECT (request), quark_request_session, NULL);
+
+  if (!xdp_dbus_impl_audio_capture_call_start_finish (impl,
+                                                      &response,
+                                                      &results,
+                                                      res,
+                                                      &error))
+    {
+      g_dbus_error_strip_remote_error (error);
+      g_warning ("A backend call failed: %s", error->message);
+      g_clear_error (&error);
+    }
+
+  should_close_session = !request->exported || response != 0;
+
+  audio_capture_session = AUDIO_CAPTURE_SESSION (session);
+
+  if (request->exported)
+    {
+      if (response == 0)
+        {
+          if (!process_results (audio_capture_session, &results, &error))
+            {
+              g_warning ("Failed to process results: %s", error->message);
+              g_clear_error (&error);
+              g_clear_pointer (&results, g_variant_unref);
+              response = 2;
+              should_close_session = TRUE;
+            }
+        }
+
+      if (!results)
+        {
+          g_auto(GVariantBuilder) results_builder =
+            G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE_VARDICT);
+
+          results = g_variant_ref_sink (g_variant_builder_end (&results_builder));
+        }
+
+      xdp_dbus_request_emit_response (XDP_DBUS_REQUEST (request), response, results);
+      xdp_request_unexport (request);
+    }
+
+  if (should_close_session)
+    {
+      xdp_session_close (session, TRUE);
+    }
+  else if (!session->closed)
+    {
+      g_assert (audio_capture_session->state ==
+                AUDIO_CAPTURE_SESSION_STATE_STARTING);
+      g_debug ("audio capture session owned by '%s' started", session->sender);
+      audio_capture_session->state = AUDIO_CAPTURE_SESSION_STATE_STARTED;
+    }
+}
+
+static gboolean
+handle_start (XdpDbusAudioCapture   *object,
+              GDBusMethodInvocation *invocation,
+              const char            *arg_session_handle,
+              const char            *arg_parent_window,
+              GVariant              *arg_options)
+{
+  AudioCapture *audio_capture = (AudioCapture *) object;
+  XdpRequest *request = xdp_request_from_invocation (invocation);
+  XdpSession *session;
+  AudioCaptureSession *audio_capture_session;
+  g_autoptr(GError) error = NULL;
+  g_autoptr(XdpDbusImplRequest) impl_request = NULL;
+  g_auto(GVariantBuilder) options_builder =
+    G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE_VARDICT);
+  g_autoptr(GVariant) options = NULL;
+
+  REQUEST_AUTOLOCK (request);
+
+  session = xdp_session_from_request (arg_session_handle, request);
+  if (!session || !IS_AUDIO_CAPTURE_SESSION (session))
+    {
+      g_dbus_method_invocation_return_error (invocation,
+                                             G_DBUS_ERROR,
+                                             G_DBUS_ERROR_ACCESS_DENIED,
+                                             "Invalid session");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  SESSION_AUTOLOCK_UNREF (session);
+
+  audio_capture_session = AUDIO_CAPTURE_SESSION (session);
+  switch (audio_capture_session->state)
+    {
+    case AUDIO_CAPTURE_SESSION_STATE_SOURCES_SELECTED:
+      break;
+    case AUDIO_CAPTURE_SESSION_STATE_INIT:
+    case AUDIO_CAPTURE_SESSION_STATE_SELECTING_SOURCES:
+      g_dbus_method_invocation_return_error (invocation,
+                                             G_DBUS_ERROR,
+                                             G_DBUS_ERROR_FAILED,
+                                             "Sources not selected");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    case AUDIO_CAPTURE_SESSION_STATE_STARTING:
+    case AUDIO_CAPTURE_SESSION_STATE_STARTED:
+      g_dbus_method_invocation_return_error (invocation,
+                                             G_DBUS_ERROR,
+                                             G_DBUS_ERROR_FAILED,
+                                             "Can only start once");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    case AUDIO_CAPTURE_SESSION_STATE_CLOSED:
+      g_dbus_method_invocation_return_error (invocation,
+                                             G_DBUS_ERROR,
+                                             G_DBUS_ERROR_FAILED,
+                                             "Invalid session");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  impl_request = xdp_dbus_impl_request_proxy_new_sync (
+    g_dbus_proxy_get_connection (G_DBUS_PROXY (audio_capture->impl)),
+    G_DBUS_PROXY_FLAGS_DO_NOT_LOAD_PROPERTIES,
+    g_dbus_proxy_get_name (G_DBUS_PROXY (audio_capture->impl)),
+    request->id,
+    NULL, &error);
+
+  if (!impl_request)
+    {
+      g_dbus_method_invocation_return_gerror (invocation, error);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  xdp_request_set_impl_request (request, impl_request);
+  xdp_request_export (request, g_dbus_method_invocation_get_connection (invocation));
+
+  options = g_variant_ref_sink (g_variant_builder_end (&options_builder));
+
+  g_object_set_qdata_full (G_OBJECT (request),
+                           quark_request_session,
+                           g_object_ref (session),
+                           g_object_unref);
+  audio_capture_session->state = AUDIO_CAPTURE_SESSION_STATE_STARTING;
+
+  xdp_dbus_impl_audio_capture_call_start (audio_capture->impl,
+                                          request->id,
+                                          arg_session_handle,
+                                          xdp_app_info_get_id (request->app_info),
+                                          arg_parent_window,
+                                          options,
+                                          NULL,
+                                          start_done,
+                                          g_object_ref (request));
+
+  xdp_dbus_audio_capture_complete_start (object, invocation, request->id);
+
+  return G_DBUS_METHOD_INVOCATION_HANDLED;
+}
+
+/* OpenPipeWireRemote ------------------------------------------------------- */
+
+static PipeWireRemote *
+open_pipewire_audio_capture_remote (const char  *app_id,
+                                    uint32_t     node_id,
+                                    GError     **error)
+{
+  struct pw_properties *pipewire_properties;
+  PipeWireRemote *remote;
+  g_autoptr(GArray) permission_items = NULL;
+
+  /* The same client properties as a ScreenCast remote: WirePlumber's portal
+   * access script leaves a remote with no media roles alone, and the session
+   * manager knows which app it belongs to. */
+  pipewire_properties = pw_properties_new ("pipewire.access.portal.app_id", app_id,
+                                           "pipewire.access.portal.media_roles", "",
+                                           NULL);
+  remote = pipewire_remote_new_sync (pipewire_properties,
+                                     NULL, NULL, NULL, NULL,
+                                     error);
+  if (!remote)
+    return NULL;
+
+  permission_items = g_array_new (FALSE, TRUE, sizeof (struct pw_permission));
+
+  /* Core rwx and the node factory r, to create the recording stream. */
+  g_array_append_val (permission_items,
+                      PERMISSION_ITEM (PW_ID_CORE, PW_PERM_RWX));
+  g_array_append_val (permission_items,
+                      PERMISSION_ITEM (remote->node_factory_id, PW_PERM_R));
+
+  /* The capture node can be seen and its parameters read; nothing else. */
+  g_array_append_val (permission_items,
+                      PERMISSION_ITEM (node_id, PW_PERM_R | PW_PERM_X));
+
+  /* Hide all existing and future objects except the ones listed above. */
+  g_array_append_val (permission_items,
+                      PERMISSION_ITEM (PW_ID_ANY, 0));
+
+  pw_client_update_permissions (pw_core_get_client (remote->core),
+                                permission_items->len,
+                                (const struct pw_permission *)permission_items->data);
+
+  pipewire_remote_roundtrip (remote);
+
+  return remote;
+}
+
+static gboolean
+handle_open_pipewire_remote (XdpDbusAudioCapture   *object,
+                             GDBusMethodInvocation *invocation,
+                             GUnixFDList           *in_fd_list,
+                             const char            *arg_session_handle,
+                             GVariant              *arg_options)
+{
+  XdpAppInfo *app_info = xdp_invocation_get_app_info (invocation);
+  XdpSession *session;
+  AudioCaptureSession *audio_capture_session;
+  PipeWireRemote *remote;
+  g_autoptr(GUnixFDList) out_fd_list = NULL;
+  int fd;
+  int fd_id;
+  g_autoptr(GError) error = NULL;
+
+  session = xdp_session_from_app_info (arg_session_handle, app_info);
+  if (!session || !IS_AUDIO_CAPTURE_SESSION (session))
+    {
+      g_dbus_method_invocation_return_error (invocation,
+                                             G_DBUS_ERROR,
+                                             G_DBUS_ERROR_ACCESS_DENIED,
+                                             "Invalid session");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  SESSION_AUTOLOCK_UNREF (session);
+
+  audio_capture_session = AUDIO_CAPTURE_SESSION (session);
+  if (audio_capture_session->state != AUDIO_CAPTURE_SESSION_STATE_STARTED ||
+      audio_capture_session->node_id == 0)
+    {
+      g_dbus_method_invocation_return_error (invocation,
+                                             G_DBUS_ERROR,
+                                             G_DBUS_ERROR_FAILED,
+                                             "No streams available");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  remote = open_pipewire_audio_capture_remote (session->app_id,
+                                               audio_capture_session->node_id,
+                                               &error);
+  if (!remote)
+    {
+      g_dbus_method_invocation_return_error (invocation,
+                                             G_DBUS_ERROR,
+                                             G_DBUS_ERROR_FAILED,
+                                             "%s", error->message);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  out_fd_list = g_unix_fd_list_new ();
+  fd = pw_core_steal_fd (remote->core);
+  fd_id = g_unix_fd_list_append (out_fd_list, fd, &error);
+  close (fd);
+  pipewire_remote_destroy (remote);
+
+  if (fd_id == -1)
+    {
+      g_dbus_method_invocation_return_error (invocation,
+                                             G_DBUS_ERROR,
+                                             G_DBUS_ERROR_ACCESS_DENIED,
+                                             "Failed to append fd: %s",
+                                             error->message);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  xdp_dbus_audio_capture_complete_open_pipewire_remote (object, invocation,
+                                                        out_fd_list,
+                                                        g_variant_new_handle (fd_id));
+  return G_DBUS_METHOD_INVOCATION_HANDLED;
+}
+
+static void
+audio_capture_iface_init (XdpDbusAudioCaptureIface *iface)
+{
+  iface->handle_create_session = handle_create_session;
+  iface->handle_select_sources = handle_select_sources;
+  iface->handle_start = handle_start;
+  iface->handle_open_pipewire_remote = handle_open_pipewire_remote;
+}
+
+static void
+audio_capture_dispose (GObject *object)
+{
+  AudioCapture *audio_capture = (AudioCapture *) object;
+
+  g_clear_object (&audio_capture->impl);
+
+  G_OBJECT_CLASS (audio_capture_parent_class)->dispose (object);
+}
+
+static void
+audio_capture_init (AudioCapture *audio_capture)
+{
+}
+
+static void
+audio_capture_class_init (AudioCaptureClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->dispose = audio_capture_dispose;
+
+  quark_request_session =
+    g_quark_from_static_string ("-xdp-request-audio-capture-session");
+}
+
+static AudioCapture *
+audio_capture_new (XdpContext              *context,
+                   XdpDbusImplAudioCapture *impl)
+{
+  AudioCapture *audio_capture;
+
+  audio_capture = g_object_new (audio_capture_get_type (), NULL);
+  audio_capture->context = context;
+  audio_capture->impl = g_object_ref (impl);
+
+  /* The backend shows a dialog; Start waits for the user. */
+  g_dbus_proxy_set_default_timeout (G_DBUS_PROXY (audio_capture->impl), G_MAXINT);
+
+  xdp_dbus_audio_capture_set_version (XDP_DBUS_AUDIO_CAPTURE (audio_capture),
+                                      MIN (xdp_dbus_impl_audio_capture_get_version (audio_capture->impl), 1));
+
+  g_object_bind_property (G_OBJECT (audio_capture->impl), "available-source-types",
+                          G_OBJECT (audio_capture), "available-source-types",
+                          G_BINDING_SYNC_CREATE);
+  g_object_bind_property (G_OBJECT (audio_capture->impl), "available-audio-modes",
+                          G_OBJECT (audio_capture), "available-audio-modes",
+                          G_BINDING_SYNC_CREATE);
+
+  return audio_capture;
+}
+
+void
+init_audio_capture (XdpContext *context)
+{
+  g_autoptr(AudioCapture) audio_capture = NULL;
+  GDBusConnection *connection = xdp_context_get_connection (context);
+  XdpPortalConfig *config = xdp_context_get_config (context);
+  XdpImplConfig *impl_config;
+  g_autoptr(XdpDbusImplAudioCapture) impl = NULL;
+  g_autoptr(GError) error = NULL;
+
+  impl_config = xdp_portal_config_find (config, AUDIO_CAPTURE_DBUS_IMPL_IFACE);
+  if (impl_config == NULL)
+    return;
+
+  impl = xdp_dbus_impl_audio_capture_proxy_new_sync (connection,
+                                                     G_DBUS_PROXY_FLAGS_NONE,
+                                                     impl_config->dbus_name,
+                                                     DESKTOP_DBUS_PATH,
+                                                     NULL,
+                                                     &error);
+  if (impl == NULL)
+    {
+      g_warning ("Failed to create audio capture proxy: %s", error->message);
+      return;
+    }
+
+  audio_capture = audio_capture_new (context, impl);
+
+  xdp_context_take_and_export_portal (context,
+                                      G_DBUS_INTERFACE_SKELETON (g_steal_pointer (&audio_capture)),
+                                      XDP_CONTEXT_EXPORT_FLAGS_NONE);
+}
