From: Project Luma <noreply@projectluma.org>
Subject: [PATCH] open-uri: open files in the default chosen for their type

OpenURI and OpenFile showed the application chooser for every file
type whose default was not a system installer named in
/usr/share/luma/open-directly.list, until one application had been
picked three times from the same caller. A screenshot or a PDF
double-clicked in a sandboxed file manager therefore asked which
application to use on a fresh install, although Luma names Viewer the
default for both, and "Always Open" in the chooser had no effect: it
records the choice as the default in $XDG_CONFIG_HOME/mimeapps.list,
which the portal never read for files.

While the type's default is named in [Default Applications] of a
mimeapps list in the person's configuration directory or in a system
configuration directory (/etc/xdg), the file opens in it directly.
Defaults GIO falls back to and lists in data directories still ask, as
do an application's request to ask and always-ask for the type.

---
--- a/src/open-uri.c
+++ b/src/open-uri.c
@@ -572,6 +572,95 @@ luma_opens_directly (const char *app_id,
   return TRUE;
 }
 
+/* Luma: a default someone chose. "Always Open" in Luma's application chooser
+ * (luma-portal) and Settings record the person's choice with
+ * g_app_info_set_as_default_for_type(), in [Default Applications] of
+ * $XDG_CONFIG_HOME/mimeapps.list; the operating system names its defaults in
+ * /etc/xdg/gnome-mimeapps.list (luma-desktop-launcher-policy). While the
+ * type's default is named in a mimeapps list of the person's configuration
+ * directory or of a system configuration directory, the file opens in it
+ * directly. Defaults GIO falls back to (the first application that claims
+ * the type) and lists in data directories, which any installed package can
+ * ship, still ask. An application's request to ask and always-ask for the
+ * type still win.
+ */
+static gboolean
+luma_mimeapps_names_default (const char *dir,
+                             const char *name,
+                             const char *content_type,
+                             const char *desktop_id)
+{
+  g_autoptr(GKeyFile) mimeapps = g_key_file_new ();
+  g_autofree char *path = g_build_filename (dir, name, NULL);
+  g_auto(GStrv) defaults = NULL;
+
+  if (!g_key_file_load_from_file (mimeapps, path, G_KEY_FILE_NONE, NULL))
+    return FALSE;
+
+  defaults = g_key_file_get_string_list (mimeapps, "Default Applications",
+                                         content_type, NULL, NULL);
+  if (defaults == NULL)
+    return FALSE;
+
+  for (char **d = defaults; *d != NULL; d++)
+    {
+      if (g_strcmp0 (g_strstrip (*d), desktop_id) == 0)
+        {
+          g_debug ("%s names %s the default for %s", path, desktop_id, content_type);
+          return TRUE;
+        }
+    }
+
+  return FALSE;
+}
+
+static gboolean
+luma_default_was_chosen (const char *app_id,
+                         const char *content_type)
+{
+  g_autofree char *desktop_id = NULL;
+  g_auto(GStrv) desktops = NULL;
+  g_autoptr(GPtrArray) dirs = NULL;
+  g_autoptr(GPtrArray) names = NULL;
+  const char *current_desktop;
+  const char * const *system_dirs;
+
+  if (app_id == NULL || content_type == NULL)
+    return FALSE;
+
+  desktop_id = g_strconcat (app_id, ".desktop", NULL);
+
+  /* The names GIO reads in each directory, desktop-specific first. */
+  names = g_ptr_array_new_with_free_func (g_free);
+  current_desktop = g_getenv ("XDG_CURRENT_DESKTOP");
+  if (current_desktop != NULL)
+    {
+      desktops = g_strsplit (current_desktop, G_SEARCHPATH_SEPARATOR_S, 0);
+      for (char **d = desktops; *d != NULL; d++)
+        if (**d != '\0')
+          {
+            g_autofree char *lower = g_ascii_strdown (*d, -1);
+            g_ptr_array_add (names, g_strconcat (lower, "-mimeapps.list", NULL));
+          }
+    }
+  g_ptr_array_add (names, g_strdup ("mimeapps.list"));
+
+  dirs = g_ptr_array_new ();
+  g_ptr_array_add (dirs, (gpointer) g_get_user_config_dir ());
+  system_dirs = g_get_system_config_dirs ();
+  for (gsize i = 0; system_dirs[i] != NULL; i++)
+    g_ptr_array_add (dirs, (gpointer) system_dirs[i]);
+
+  for (guint i = 0; i < dirs->len; i++)
+    for (guint j = 0; j < names->len; j++)
+      if (luma_mimeapps_names_default (g_ptr_array_index (dirs, i),
+                                       g_ptr_array_index (names, j),
+                                       content_type, desktop_id))
+        return TRUE;
+
+  return FALSE;
+}
+
 static void
 find_recommended_choices (const char *scheme,
                           const char *content_type,
@@ -894,6 +983,15 @@ handle_open_in_thread_func (GTask *task,
       use_default_app = TRUE;
     }
 
+  /* Luma: the default the person or the operating system chose for the type */
+  if (!skip_app_chooser && default_app != NULL &&
+      luma_default_was_chosen (default_app, content_type))
+    {
+      reason = "Allowing to skip app chooser: chosen default";
+      skip_app_chooser = TRUE;
+      use_default_app = TRUE;
+    }
+
   if (n_choices == 1)
     {
       if (!skip_app_chooser)
--- a/tests/test_openuri.py
+++ b/tests/test_openuri.py
@@ -107,6 +107,15 @@ def xdg_data_home_files():
     }
 
 
+@pytest.fixture
+def luma_system_config_dir(monkeypatch):
+    """A system configuration directory, as /etc/xdg is, for the portal."""
+    directory = Path(os.environ["XDG_CONFIG_HOME"]).parent / "luma-system-config"
+    directory.mkdir()
+    monkeypatch.setenv("XDG_CONFIG_DIRS", directory.as_posix())
+    return directory
+
+
 @pytest.fixture
 def luma_open_directly():
     """The policy file and a trusted installer, at their real system paths.
@@ -562,3 +571,44 @@ class TestOpenURI:
         assert len(method_calls) == 1
         _, args = method_calls[-1]
         assert args[4]["content_type"] == "application/vnd.debian.binary-package"
+
+    def open_luma_text(self, dbus_con):
+        openuri_intf = xdp.get_portal_iface(dbus_con, "OpenURI")
+        file_path = Path.home() / "chosen.txt"
+        file_path.write_text("chosen")
+        fd = os.open(file_path.absolute().as_posix(), os.O_RDONLY)
+        try:
+            request = xdp.Request(dbus_con, openuri_intf)
+            response = request.call(
+                "OpenFile", parent_window="", fd=fd, options={"writable": False}
+            )
+        finally:
+            os.close(fd)
+        assert response
+        assert response.response == 0
+        return xdp.get_mock_iface(dbus_con).GetMethodCalls("ChooseApplication")
+
+    def choose_luma_default(self, desktop_id, directory=None):
+        config = Path(directory or os.environ["XDG_CONFIG_HOME"]) / "mimeapps.list"
+        config.write_text(f"[Default Applications]\ntext/plain={desktop_id};\n")
+
+    def test_luma_chosen_default_opens_directly(self, portals, dbus_con):
+        # "Always Open" records the choice in the person's mimeapps.list.
+        self.choose_luma_default("furrfix2.desktop")
+        assert self.open_luma_text(dbus_con) == []
+
+    def test_luma_data_dir_default_still_asks(self, portals, dbus_con):
+        # A default from a data directory's defaults.list was not chosen.
+        assert len(self.open_luma_text(dbus_con)) == 1
+
+    def test_luma_chosen_default_respects_always_ask(self, portals, dbus_con):
+        self.choose_luma_default("furrfix2.desktop")
+        self.enable_paranoid_mode(dbus_con, "text/plain")
+        assert len(self.open_luma_text(dbus_con)) == 1
+
+    def test_luma_system_default_opens_directly(
+        self, luma_system_config_dir, portals, dbus_con
+    ):
+        # The operating system's default, from a system configuration directory.
+        self.choose_luma_default("furrfix2.desktop", luma_system_config_dir)
+        assert self.open_luma_text(dbus_con) == []
