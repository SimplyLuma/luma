# Canonical Waydroid vendor-image source inputs.
#
# Keep the hardware revision aligned across x86_64 desktop and AArch64 mobile.
# The accepted vendor image is recorded separately in images-*.env because its
# immutable build manifest includes every LineageOS repository revision.
LUMA_WAYDROID_LINEAGE_BRANCH=lineage-20.0
LUMA_LINEAGE_MANIFEST_REVISION=569c0d5ee26a7ebbda1e1bd91dc6f7e392c67fd7
LUMA_WAYDROID_HARDWARE_BRANCH=lineage-20
LUMA_WAYDROID_HARDWARE_REVISION=85f31a9103b84faba24eb7cbca47750d12e64e4b
LUMA_WAYDROID_VENDOR_BRANCH=lineage-20
LUMA_WAYDROID_VENDOR_REVISION=1b95b85221f4faaa357932fa5e93eacb7430f636
LUMA_ANDROID_FRAMEWORKS_BASE_REVISION=45a6bfd66cd878aad7988e9506c12035f8eee127
LUMA_ANDROID_LIBHARDWARE_REVISION=0eb202d7ebd7d2410eb2f62c908c0341964a4829
LUMA_WAYDROID_DEVICE_REVISION=2234f4b75220be7065546a2a23f9a4091b8c77d4
LUMA_WAYDROID_MANIFEST_GENERATOR_SHA256=7cdeba2c782d2fc92e2dca9f8ada45120d309af131c32b15945f7695ca123124
