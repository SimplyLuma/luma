# LUMA_DEVELOPER_PLATFORM_RELEASE is the release this tree's spec builds, and
# tests/smoke/internal-stage-contract.sh holds it equal to it. The per-arch
# NEVRAs below are what each image pins and are the only thing a package build
# may resolve the platform from: an architecture may legitimately sit on an
# older qualified build, so nothing keys off RELEASE for a specific machine.
LUMA_DEVELOPER_PLATFORM_VERSION=0.1.0
LUMA_DEVELOPER_PLATFORM_RELEASE=1.luma.107.creator20261007.1
LUMA_DEVELOPER_PLATFORM_X86_64_NEVRA=luma-developer-platform-0.1.0-1.luma.107.creator20261007.1.fc44.x86_64
# Requested aarch64 build target follows the owned source/spec release.
# This declaration does not admit an ARM artifact; the native aarch64 build
# and runtime qualification remain pending release gates.
LUMA_DEVELOPER_PLATFORM_AARCH64_NEVRA=luma-developer-platform-0.1.0-1.luma.107.creator20261007.1.fc44.aarch64
LUMA_DEVELOPER_PLATFORM_SDK_NEVRA=luma-developer-platform-sdk-0.1.0-1.luma.107.creator20261007.1.fc44.noarch

# Architecture-specific official Fedora 44 container image digests used only
# as isolated RPM build environments. Source and artifacts remain separately
# pinned; an x86_64 image must never produce an artifact labeled aarch64.
FEDORA_RPM_BUILD_CONTAINER=registry.fedoraproject.org/fedora@sha256:69b1219730fe52d6cbb0874cbc1a36dd43b722354a603f6cdf73acbff8dd7c59
FEDORA_RPM_BUILD_CONTAINER_AARCH64=registry.fedoraproject.org/fedora@sha256:22dbf85bb441d15ebec58522f98636699b4dc722d89f19a3f01c8ed382695b57

