LUMA_APK_METADATA_AARCH64_NEVRA=luma-apk-metadata-0.1.0-1.luma.1~preview.20260910.1.fc44.aarch64

LUMA_QUICK_VIEW_NEVRA=luma-quick-view-46.0-1.luma.18.lumaui20260928.fc44.x86_64

# Shared Luma-native replacements; these noarch binaries serve desktop/mobile.
LUMA_CALCULATOR_NEVRA=luma-calculator-0.1.0-1.luma.4.creator20261004.1.fc44.noarch
LUMA_TERMINAL_NEVRA=luma-terminal-0.1.0-1.luma.4.creator20261004.1.fc44.noarch
LUMA_DISKS_NEVRA=luma-disks-0.1.0-1.luma.4.creator20261004.1.fc44.noarch

# Shared ADR-051 Luma-to-Luma messaging helper.
LUMA_MESSAGES_E2EE_VERSION=0.1.0
LUMA_MESSAGES_E2EE_RELEASE=1.luma.2.creator20261007.1
LUMA_MESSAGES_E2EE_NEVRA=luma-messages-e2ee-0.1.0-1.luma.2.creator20261007.1.fc44.x86_64
LUMA_MESSAGES_E2EE_AARCH64_NEVRA=luma-messages-e2ee-0.1.0-1.luma.2.creator20261007.1.fc44.aarch64

# Source-owned WebKit/JavaScriptCore dual API pair (normal native Release3).
# Installed pointer/touch qualification is recorded separately from producer
# closure; runtime assembly must carry these exact maintained owner bytes.
WEBKITGTK6_NEVRA=webkitgtk6.0-2.54.1-1.luma.3.creator20261007.1.fc44.x86_64
JAVASCRIPTCOREGTK6_NEVRA=javascriptcoregtk6.0-2.54.1-1.luma.3.creator20261007.1.fc44.x86_64
WEBKIT2GTK41_NEVRA=webkit2gtk4.1-2.54.1-1.luma.3.creator20261007.1.fc44.x86_64
JAVASCRIPTCOREGTK41_NEVRA=javascriptcoregtk4.1-2.54.1-1.luma.3.creator20261007.1.fc44.x86_64
