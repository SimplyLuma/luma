#!/usr/bin/python3 -sP
# SPDX-License-Identifier: MPL-2.0
"""Keep bootupd's static grub.cfg carrying Luma's hidden-menu piece.

bootupd assembles /boot/grub2/grub.cfg from /usr/lib/bootupd/grub2-static
only when it installs a bootloader; neither `bootupctl update` nor
`bootupctl migrate-static-grub-config` rewrites an existing static file. A
computer that updates instead of reinstalling would therefore keep GRUB's
one-second text menu forever. This brings the file to what bootupd would
write today for exactly one piece, 09_luma_hidden_menu.cfg, and nothing else:

- it adds the piece as its own `### BEGIN/END ###` section in bootupd's name
  order, or refreshes that section's body; a section under the piece's first
  name (13_luma_hidden_menu.cfg, luma-boot-theme 1.luma.14) is replaced by it;
- it never edits another line, and `--remove` is its exact inverse;
- it leaves alone, saying why, any grub.cfg bootupd did not generate and any
  whose menu timing an administrator changed: the preamble's timeout lines, a
  timeout set outside the pieces that own one, or one in custom.cfg;
- it checks the result with grub2-script-check, then replaces the file
  atomically with its mode and owner, keeping the first original beside it.

Run at boot by luma-boot-hidden-menu.service, in its own mount namespace so it
may remount /boot read-write as bootupd does, and by luma-update right after it
stages a release, from that release's tree. Exit status: 0 when the file is
current, was changed or was deliberately left alone; 1 on an error.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile

NAME = "09_luma_hidden_menu.cfg"
LEGACY_NAMES = ("13_luma_hidden_menu.cfg",)
DEFAULT_SOURCE = "/usr/lib/bootupd/grub2-static/configs.d/" + NAME
DEFAULT_GRUB_CFG = "/boot/grub2/grub.cfg"
BACKUP_SUFFIX = ".pre-luma-hidden-menu"
HEADER = "# Generated by bootupd"
# Pieces whose own timeout lines are expected: bootupd's show-once and Luma's.
TIMEOUT_OWNERS = (NAME, *LEGACY_NAMES, "14_menu_show_once.cfg")
TIMEOUT = re.compile(r"^[ \t]*set[ \t]+timeout(?:_style)?=\S*", re.M)
ANY_BEGIN = re.compile(r"^### BEGIN (\S+) ###$", re.M)


def say(message):
    print(f"luma-boot-hidden-menu: {message}", flush=True)


def section(text, name):
    """The piece's section, wherever it is (migrate-to-channel.sh put the first
    one inside 10_blscfg's section, before the BLS line)."""
    escaped = re.escape(name)
    return re.search(rf"^### BEGIN {escaped} ###\n(?P<body>.*?)^### END {escaped} ###\n", text, re.M | re.S)


def remove_section(text, name):
    match = section(text, name)
    if match is None:
        return text
    start, end = match.start(), match.end()
    if text.startswith("\n### BEGIN ", end):
        end += 1  # a piece between two others brings one blank line with it
    elif end == len(text) and text[:start].endswith("\n\n"):
        start -= 1  # the last piece is preceded by one
    return text[:start] + text[end:]


def add_section(text, body):
    match = section(text, NAME)
    if match is not None:
        return text[: match.start("body")] + body + text[match.end("body"):]
    block = f"### BEGIN {NAME} ###\n{body}### END {NAME} ###\n"
    for begin in ANY_BEGIN.finditer(text):
        if begin.group(1) > NAME:
            return text[: begin.start()] + block + "\n" + text[begin.start():]
    return text + ("" if text.endswith("\n") else "\n") + "\n" + block


def timing_changed_by_administrator(text, directory):
    first = ANY_BEGIN.search(text)
    preamble = text[: first.start()] if first else text
    if [line.strip() for line in TIMEOUT.findall(preamble)] != ["set timeout_style=menu", "set timeout=1"]:
        return "the preamble's menu timeout is not bootupd's"
    rest = text[len(preamble):]
    for owner in TIMEOUT_OWNERS:
        match = section(rest, owner)
        if match is not None:
            rest = rest[: match.start()] + rest[match.end():]
    foreign = TIMEOUT.findall(rest)
    if foreign:
        return "a menu timeout is set outside the pieces that own one (" + "; ".join(l.strip() for l in foreign) + ")"
    custom = os.path.join(directory, "custom.cfg")
    try:
        with open(custom, encoding="utf-8", errors="replace") as stream:
            if TIMEOUT.search(stream.read()):
                return f"{custom} sets a menu timeout"
    except FileNotFoundError:
        pass
    return None


def script_check(text):
    checker = shutil.which("grub2-script-check")
    if checker is None:
        return True
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", prefix="luma-grub-check.") as stream:
        stream.write(text)
        stream.flush()
        return subprocess.run([checker, stream.name], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode == 0


def writable(path, remount):
    if not os.statvfs(os.path.dirname(path)).f_flag & os.ST_RDONLY:
        return True
    mount = os.path.dirname(path)
    while not os.path.ismount(mount) and mount != "/":
        mount = os.path.dirname(mount)
    if not remount:
        say(f"{mount} is read-only; {path} stays as it is until the next boot")
        return False
    # Only ever inside a private mount namespace (MountFlags=slave), as bootupd.
    result = subprocess.run(["mount", "-o", "remount,rw", mount], capture_output=True, text=True)
    if result.returncode != 0:
        say(f"could not remount {mount} read-write: {result.stderr.strip()}")
        return False
    return True


def replace_file(path, text, backup):
    directory = os.path.dirname(path)
    status = os.stat(path)
    if backup and not os.path.exists(path + BACKUP_SUFFIX):
        shutil.copy2(path, path + BACKUP_SUFFIX)
    descriptor, temporary = tempfile.mkstemp(dir=directory, prefix=".grub.cfg.luma.")
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(text)
            stream.flush()
            os.fchmod(stream.fileno(), status.st_mode & 0o7777)
            os.fchown(stream.fileno(), status.st_uid, status.st_gid)
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    except BaseException:
        if os.path.exists(temporary):
            os.unlink(temporary)
        raise
    directory_fd = os.open(directory, os.O_RDONLY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def main(argv=None):
    parser = argparse.ArgumentParser(description="Keep bootupd's grub.cfg carrying Luma's hidden-menu piece.")
    parser.add_argument("--source", default=DEFAULT_SOURCE, help="the piece (default: %(default)s)")
    parser.add_argument("--grub-cfg", default=DEFAULT_GRUB_CFG, help="default: %(default)s")
    parser.add_argument("--remove", action="store_true", help="take the piece out again")
    parser.add_argument("--dry-run", action="store_true", help="only say what would change")
    parser.add_argument("--remount", action="store_true",
                        help="remount a read-only /boot read-write (only in a private mount namespace)")
    args = parser.parse_args(argv)
    path = args.grub_cfg

    try:
        with open(path, encoding="utf-8") as stream:
            text = stream.read()
    except FileNotFoundError:
        say(f"{path} does not exist; nothing to do")
        return 0
    except (OSError, UnicodeDecodeError) as error:
        say(f"cannot read {path}: {error}")
        return 1
    if not text.startswith(HEADER):
        say(f"{path} was not generated by bootupd; leaving it alone")
        return 0

    new = text
    for name in (NAME, *LEGACY_NAMES) if args.remove else LEGACY_NAMES:
        new = remove_section(new, name)
    if args.remove:
        verb = "removed the hidden-menu piece from"
    else:
        try:
            with open(args.source, encoding="utf-8") as stream:
                body = stream.read()
        except FileNotFoundError:
            say(f"{args.source} is not installed; leaving {path} as it is")
            return 0
        body += "" if body.endswith("\n") else "\n"
        reason = timing_changed_by_administrator(text, os.path.dirname(path))
        if reason:
            say(f"{reason}; leaving {path} alone")
            return 0
        verb = "refreshed the hidden-menu piece in" if section(text, NAME) else "added the hidden-menu piece to"
        new = add_section(new, body)

    if new == text:
        say(f"{path} is current" if not args.remove else f"{path} carries no hidden-menu piece")
        return 0
    if args.dry_run:
        say(f"would have {verb} {path}")
        return 0
    if not script_check(new):
        say(f"{path} with the change fails grub2-script-check; leaving it as it is")
        return 1
    if not writable(path, args.remount):
        return 0
    try:
        replace_file(path, new, backup=not args.remove)
    except OSError as error:
        say(f"could not change {path}: {error}")
        return 1
    say(f"{verb} {path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
