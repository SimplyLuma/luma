FP6_AUDIO_SPEAKER_DTB_SHA256=5a5b0be91937576ce20e0c17c63e2ac696f5a797b74bdb14e9052c978f51347e

# Fairphone Gen. 6 Awinic AW88261 profile container.  This is a proprietary
# device calibration input and is verified/installed, never redistributed by
# the Luma source tree.
