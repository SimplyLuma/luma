# Handheld login screen. GDM's greeter reads its own dconf profile (gdm), not
# the luma profile the signed-in session uses, so the handheld power defaults
# in luma-shell-handheld.dconf never reach it. Keep these keys equal to that
# file's.

[org/gnome/desktop/session]
idle-delay=uint32 60

[org/gnome/settings-daemon/plugins/power]
# A short press is display sleep/wake, not the power-off dialog.
power-button-action='nothing'
# No system suspend from the login screen either: see luma-shell-handheld.dconf.
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'

[org/gnome/desktop/interface]
# The handheld default appearance, so the login screen and its keyboard match
# the session a person signs in to.
color-scheme='prefer-dark'

[org/gnome/settings-daemon/plugins/media-keys]
# The Shell's handheld power button blanks and wakes the login screen too
# (gnome-shell patch 0337); without this the settings daemon's static grab
# can take the power key first and the press does nothing.
power-static=@as []
