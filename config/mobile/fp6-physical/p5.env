# Exact decompressed postmarketOS control disk used only as the offline P5
# partition/layout and board-support source. Its compressed upstream checksum
# remains pinned in ../fp6-control/inputs.env.
FP6_P5_CONTROL_BUILD=20260807-2341
FP6_P5_CONTROL_RAW_SHA256=d68dd378799b34c9b6fe9fbfde9a379b5404250c424b9aa524911174edc1a48a
FP6_P5_PROVEN_BOOT_SHA256=5885e62324115ae9cce929318df24251992ef705952dcbe6b16cef549a505efb
FP6_P5_MODULE_ABI=7.1.2
FP6_P5_BOOT_PARTITION_TYPE=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
FP6_P5_ROOT_PARTITION_TYPE=B921B045-1DF0-41C3-AF44-4C6F280D3FAE

# The bridge may copy data-only kernel support from the verified control
# filesystem. It must never import Alpine/musl executables or libraries.
FP6_P5_REQUIRED_FIRMWARE_1=gen80300_sqe.fw
FP6_P5_REQUIRED_FIRMWARE_2=gen80300_gmu.bin
FP6_P5_REQUIRED_FIRMWARE_3=qcom/milos/fairphone/fp6/gen80300_zap.mbn

# Source preparation cannot authorize a phone write.
FP6_P5_INSTALL_AUTHORIZED=false
