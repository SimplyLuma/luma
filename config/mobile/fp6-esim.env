# SPDX-License-Identifier: Apache-2.0

# lpac contains the Fairphone-authored QMI-over-QRTR APDU transport needed by
# the FP6's embedded UICC. Keep the exact source immutable and build only the
# QRTR and HTTPS backends used on this device.
FP6_ESIM_LPAC_REPO=https://github.com/estkme-group/lpac.git
FP6_ESIM_LPAC_COMMIT=3ff35594ec15062a3ed10c3da1c26eb0a13390b8
FP6_ESIM_LPAC_VERSION=2.3.0
FP6_ESIM_LPAC_RELEASE=3.luma1
FP6_ESIM_PROFILE_SELECTOR_19_DIGIT_ACCEPTED=true
FP6_ESIM_LPAC_RUNTIME_BINARY_SHA256=53f730e06a15260f1d57e78eda9989399a1ef2b94040511965c00b824389afe8
FP6_ESIM_LPAC_RUNTIME_RPM_SHA256=633333e6f06e9e19b51f82c4b8ccba194bacf1edcfb746d037882df315fa62f2
FP6_ESIM_LPAC_LICENSE='AGPL-3.0-only AND LGPL-2.1-only AND MIT AND CC0-1.0'
FP6_ESIM_LPAC_APDU_BACKEND=qmi_qrtr
FP6_ESIM_LPAC_HTTP_BACKEND=curl

# The factory QREL 16.95.0 modem image and FP6 Android device configuration
# agree on this hardware profile. Loading or activating it is a separate,
# persistent physical-device gate; these values are identity pins only.
FP6_ESIM_PDC_PLATFORM_PROFILE=DSDS-LA-Milos
FP6_ESIM_PDC_PLATFORM_SHA256=281cf305a5bcd98b709a0446f9733d1859cb423a791b2af17ab9776ffeaf0400
FP6_ESIM_PDC_PLATFORM_ID_SHA1=00b4217c22737e3fc64ddea978a4218c4282769e
FP6_ESIM_PDC_QMICLI_SHA256=1b4adcd3d949e8d0f68065ba0022bbc35fe4462717deaaeae0ec244557f76b9c
FP6_ESIM_PDC_PLATFORM_ACCEPTED=true

# ROW was the conservative initial software candidate. Physical diagnosis
# later identified the operational profile as T-Mobile-family; TMO is now the
# accepted active software configuration and ROW is retained only as evidence.
FP6_ESIM_PDC_SOFTWARE_PROFILE=ROW-Commercial
FP6_ESIM_PDC_SOFTWARE_SHA256=9ab2da76aa381b95e7f26287cd74d1669bda1eeefc928952832c9244862e8296
FP6_ESIM_PDC_SOFTWARE_ID_SHA1=cd827348499492530643b7245e726526fea3217c
FP6_ESIM_PDC_SOFTWARE_ACCEPTED=true

# The operational U.S. profile requires the factory T-Mobile family. This
# candidate replaced ROW only after separate bounded physical acceptance.
FP6_ESIM_PDC_TMO_PROFILE=TMO-Commercial
FP6_ESIM_PDC_TMO_SHA256=817e5f33a18a176a14859184de88c60921318864dea994a845133bc841e3edda
FP6_ESIM_PDC_TMO_ID_SHA1=88f589369ff3a066511dd1b21ed42cf3496686a3
FP6_ESIM_PDC_TMO_LOADED=true
FP6_ESIM_PDC_TMO_REFRESH_PERSISTED=true
FP6_ESIM_PDC_TMO_ACCEPTED=true

# The owner-selected Dark Star (AT&T-family) eSIM is a separate carrier gate.
# The exact QREL AT&T VoLTE MBN is accepted in the live read-only-rmtfs
# shadow only; durable activation is intentionally deferred while voice
# entitlement remains unproven.
FP6_ESIM_PDC_ATT_PROFILE=ATT-VoLTE
FP6_ESIM_PDC_ATT_SHA256=32e7f3d9059e63323f70cf113b1ecc040dc7e9c82238a1d5bde2b21ca2eb7d6e
FP6_ESIM_PDC_ATT_ID_SHA1=444954dcfbd6d5bf196cd8fecf6770ff3c6b34fc
FP6_ESIM_PDC_ATT_VOLATILE_ACCEPTED=true
FP6_ESIM_PDC_ATT_PERSISTED=false
FP6_ESIM_DARKSTAR_PROFILE_ACCEPTED=true
FP6_ESIM_DARKSTAR_DATA_ACCEPTED=true
FP6_ESIM_DARKSTAR_SMS_INBOUND_ACCEPTED=true
FP6_ESIM_DARKSTAR_SMS_OUTBOUND_ACCEPTED=true
FP6_ESIM_DARKSTAR_IMS_ACCEPTED=true
FP6_ESIM_DARKSTAR_VOLTE_ACCEPTED=false

# The normal rmtfs unit remains read-only and shadows modem writes in RAM. A
# bounded recovery invocation can make only exact 10 MiB modemst1/modemst2
# writable; it must be stopped and the read-only service restored before modem
# restart or shutdown. Installing the RPM remains a separate gate.
FP6_ESIM_MODEMST_PERSISTENCE_ACCEPTED=true
FP6_ESIM_MODEMST1_ACCEPTED_SHA256=8c772c191fb5230ceea40e9ad482b25e3219dc5cd8196fcab00592f0b6ff76c7
FP6_ESIM_MODEMST2_ACCEPTED_SHA256=986888b7f859f5ca85f5f397639e965e6d8105a712f97397a328da0cbf1d4143
FP6_ESIM_FSG_ACCEPTED_SHA256=a776c844c220fa278479f63b3dd0ea6ebdd12bc5267af02592dd895dd76494ab
FP6_ESIM_RMTFS_RUNTIME_BINARY_SHA256=c9781b0d25e0bedb5e6ff4e96dd553f0ec443f9d65c64b4d3032ef9fa3245280
FP6_ESIM_RMTFS_RUNTIME_RPM_SHA256=4ba9f6a8744a180bda7819b28a32afd7d8cf06ef23fbd5929133fc33565021e7
FP6_ESIM_RMTFS_RUNTIME_INSTALLED=false

# Physical acceptance is deliberately split. The first gate may inspect chip
# metadata and profile count only. It may not download, enable, disable, delete,
# nickname, purge, or otherwise mutate an eUICC.
FP6_ESIM_READ_ONLY_PROBE_ACCEPTED=true
FP6_ESIM_PROFILE_DOWNLOAD_ACCEPTED=true
FP6_ESIM_PROFILE_ENABLE_ACCEPTED=true
FP6_ESIM_CARRIER_REGISTRATION_ACCEPTED=true
FP6_ESIM_CELLULAR_DATA_ACCEPTED=true
FP6_ESIM_CELLULAR_LINK_ADAPTER_ACCEPTED=true
FP6_ESIM_CELLULAR_RECONNECT_ACCEPTED=true
FP6_ESIM_SMS_INBOUND_TRANSPORT_ACCEPTED=true
FP6_ESIM_SMS_OUTBOUND_TRANSPORT_ACCEPTED=true
FP6_ESIM_SMS_UI_INTEGRATION_ACCEPTED=true
FP6_ESIM_SMS_ACCEPTED=true
FP6_ESIM_MMS_ACCEPTED=false
FP6_ESIM_VOLTE_ACCEPTED=false
FP6_ESIM_IMAGE_INCLUSION_ACCEPTED=false
