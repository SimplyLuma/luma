# Official postmarketOS edge/Phosh build published for fairphone-fp6.
FP6_CONTROL_CHANNEL=edge
FP6_CONTROL_UI=phosh
FP6_CONTROL_BUILD=20260807-2341
FP6_CONTROL_IMAGE_VERSION=32
FP6_CONTROL_BASE_URL=https://images.postmarketos.org/bpo/edge/fairphone-fp6/phosh/20260807-2341
FP6_CONTROL_BOOT_IMAGE=20260807-2341-postmarketOS-edge-phosh-32-fairphone-fp6-boot.img.xz
FP6_CONTROL_BOOT_SHA256=6cbc2892f5c17ea2bc29e104fd483df7cd1ecfc5baa27aecca80095c8ece44d4
FP6_CONTROL_ROOTFS_IMAGE=20260807-2341-postmarketOS-edge-phosh-32-fairphone-fp6.img.xz
FP6_CONTROL_ROOTFS_SHA256=eab5d6c90131eb531bd7c22a788aea62f4127bceaaaf7d464bbe741b03829134
FP6_CONTROL_WIKI_REVISION=102743

# The current upstream procedure flashes boot and erases dtbo even when the
# rootfs lives on an SD card. Artifact preparation never authorizes install.
FP6_CONTROL_INSTALL_MUTATES_PHONE=true
FP6_CONTROL_INSTALL_AUTHORIZED=false
