# Exact upstream inputs for the initial Google Pixel 9 (tokay) native-Linux
# bring-up. Branch names are recorded for provenance; builds fetch the immutable
# commit IDs and must not silently advance them.
PIXEL9_EXPECTED_MANUFACTURER=Google
PIXEL9_EXPECTED_MODEL_REGEX='^Pixel 9$'
PIXEL9_EXPECTED_DEVICE_REGEX='^tokay$'

PIXEL9_LINUX_URL=https://github.com/orgwithsomething/linux-zumapro.git
PIXEL9_LINUX_BRANCH=tokay
PIXEL9_LINUX_COMMIT=0def32ea0ff0a71247a063e78f41c3c954133b9e
PIXEL9_LINUX_DEFCONFIG=zumapro_defconfig
PIXEL9_LINUX_DEFCONFIG_SHA256=a8fa3e6f9ab7e3dea2a329184271f168a19b38e936f5d4b91dcdde6b28a7a6df
PIXEL9_DIRECT_KERNEL_PATCH=patches/linux-zumapro/0001-luma-tokay-embedded-diagnostic.patch
PIXEL9_DIRECT_KERNEL_PATCH_SHA256=ac7f2f9ab8358a33b8ef8cdff5f683aada8cafb14240bd691323d8a2772ce1b0
PIXEL9_DIRECT_KERNEL_PERSISTENT_DTB_PATCH=patches/linux-zumapro/0002-luma-tokay-persist-embedded-dtb.patch
PIXEL9_DIRECT_KERNEL_PERSISTENT_DTB_PATCH_SHA256=143e8c16fd4c1d4eadd04a3b1527808e6085f3aafebb1ffae379c9ce4641534e
PIXEL9_DIRECT_KERNEL_COPY_DTB_PATCH=patches/linux-zumapro/0003-luma-tokay-copy-embedded-dtb.patch
PIXEL9_DIRECT_KERNEL_COPY_DTB_PATCH_SHA256=5104b86851b08b72475e104e05bafcacda94f3483ffe0fb195a3db71ae5249bf

PIXEL9_UBOOT_URL=https://github.com/alex92567/u-boot-zumapro.git
PIXEL9_UBOOT_BRANCH=master
PIXEL9_UBOOT_COMMIT=e5bbffaa8835626d957ad4d3e0d290afd6be8603
PIXEL9_UBOOT_DEFCONFIG=google_tokay_defconfig
PIXEL9_UBOOT_DEFCONFIG_SHA256=0eb72c93a7300614638825f605732bdd5a6e043ff18826e5370394482ef349ef
PIXEL9_UBOOT_RAMBOOT_PATCH=patches/u-boot-zumapro/0001-luma-read-only-ramboot.patch
PIXEL9_UBOOT_RAMBOOT_PATCH_SHA256=d598bb0227d5525be10fbaecb6c77a3a6c01a45b01a9d03816e093b3c3eaec3a
PIXEL9_UBOOT_LOAD_WINDOW_PATCH=patches/u-boot-zumapro/0002-luma-bound-fit-load-windows.patch
PIXEL9_UBOOT_LOAD_WINDOW_PATCH_SHA256=eca12191d898bcab656c4f1433e42a4f8f9048df1b2529492658cca018439e01
PIXEL9_UBOOT_HANDOFF_OBSERVABILITY_PATCH=patches/u-boot-zumapro/0003-luma-fit-size-handoff-observability.patch
PIXEL9_UBOOT_HANDOFF_OBSERVABILITY_PATCH_SHA256=34f6151be813bdb8ba0868a02f0f9f9f766de28fbc8dee2d271299308f878868
PIXEL9_UBOOT_EMBEDDED_FIT_PATCH=patches/u-boot-zumapro/0004-luma-embed-fit-in-kernel-payload.patch
PIXEL9_UBOOT_EMBEDDED_FIT_PATCH_SHA256=81f6f0ee7f9db48dcd14d453a79be508a4ae50ebc27019c27ec196daef5409ba

# The first Linux payload uses Fedora's statically linked BusyBox only as a
# diagnostic initramfs. It contains no Android userspace, root filesystem, or
# release package set. Pin both the exact package identity and installed ELF.
PIXEL9_DIAGNOSTIC_BUSYBOX_NEVRA=busybox-1.37.0-7.fc44.aarch64
PIXEL9_DIAGNOSTIC_BUSYBOX_SOURCE_RPM=busybox-1.37.0-7.fc44.src.rpm
PIXEL9_DIAGNOSTIC_BUSYBOX_BYTES=1546952
PIXEL9_DIAGNOSTIC_BUSYBOX_SHA256=5149092cf1238d65959b76df72d981f9825d09760f7ace9f56f570ea4c73d4b8
PIXEL9_DIAGNOSTIC_INIT_SHA256=5121dc39eba459dc7ad2f5d93c1abba553d3f33883a711e956d68ddb4dcc8de4
PIXEL9_DIAGNOSTIC_INITRAMFS_BYTES=1552384
PIXEL9_DIAGNOSTIC_INITRAMFS_SHA256=619345356ee77502932f53b09d49c2884b16f919c23bc51a9caa673f9a503d99
# Transport-only successor to the physically accepted v1 diagnostic. It keeps
# ACM and adds CDC ECM plus a static read-only HTTP report from tmpfs. The
# source epoch is the immutable U-Boot commit epoch used by the original CPIO.
PIXEL9_DIAGNOSTIC_SOURCE_DATE_EPOCH=1781732916
PIXEL9_DIAGNOSTIC_ECM_INIT=diagnostic-init-ecm
PIXEL9_DIAGNOSTIC_ECM_INIT_SHA256=9c78b9857348fb8920e40e2f7c5b206973af86c5ca4a0acca7c4877c0647743f
PIXEL9_DIAGNOSTIC_ECM_INITRAMFS_BYTES=1553920
PIXEL9_DIAGNOSTIC_ECM_INITRAMFS_SHA256=3bd9edc908c5f16753df631092bde184860a35cb12c24d2170c572602f5b9de6
# Delayed, allowlisted successor used only to distinguish asynchronous UFS
# discovery from a failed host/PHY probe. It exposes the marker gadget before
# waiting 15 seconds and serves a version-3 immutable report afterward.
PIXEL9_DIAGNOSTIC_UFS_INIT=diagnostic-init-ufs
PIXEL9_DIAGNOSTIC_UFS_INIT_SHA256=02e94a1a5d10bb4de1a5d8b1d42059051727e9803a3c0a3f8008d81391df7c01
PIXEL9_DIAGNOSTIC_UFS_INITRAMFS_BYTES=1554432
PIXEL9_DIAGNOSTIC_UFS_INITRAMFS_SHA256=de419d9f601545d808f8216c47a4561102898f66bafae573751a35d148b70183
# First real Fedora userspace successor. BusyBox remains the closed early-init
# and report boundary, while this exact signed Fedora 44 closure supplies the
# dynamically linked AArch64 Bash/glibc execution proof. It remains an
# initramfs only: no block filesystem is mounted or written.
PIXEL9_DIAGNOSTIC_FEDORA_RPM_LOCK=fedora44-ram-userspace-rpms.lock
PIXEL9_DIAGNOSTIC_FEDORA_RPM_LOCK_SHA256=2eefef1af6cda54055ab32ea8ceec9dc8cf97c2313225eef12a4022525cb189d
PIXEL9_DIAGNOSTIC_FEDORA_RPM_COUNT=16
PIXEL9_DIAGNOSTIC_FEDORA_INIT=diagnostic-init-fedora
PIXEL9_DIAGNOSTIC_FEDORA_INIT_SHA256=c2535b28645566f2fc90794dc34ee4415b4c08276b366816b39b8012755cdcb3
PIXEL9_DIAGNOSTIC_FEDORA_INITRAMFS_BYTES=42850816
PIXEL9_DIAGNOSTIC_FEDORA_INITRAMFS_SHA256=c786f309b257b9065ff5d401972e82add65f371eaade2fa46c5bf1d007802be7

# Every FIT destination is below Tokay's first known reserved-memory region at
# 0x90200000. The loader additionally rejects any source/destination overlap.
PIXEL9_DIAGNOSTIC_KERNEL_LOAD=0x80000000
PIXEL9_DIAGNOSTIC_KERNEL_WINDOW_END=0x82000000
PIXEL9_DIAGNOSTIC_FDT_LOAD=0x82000000
PIXEL9_DIAGNOSTIC_FDT_WINDOW_END=0x82100000
PIXEL9_DIAGNOSTIC_INITRAMFS_LOAD=0x83000000
PIXEL9_DIAGNOSTIC_INITRAMFS_WINDOW_END=0x84000000
PIXEL9_DIAGNOSTIC_FIRST_RESERVED_START=0x90200000

# The zumapro-mainline pmaports fork is a packaging/status reference only. At
# this immutable revision it packages Komodo and Tegu, but has no Tokay device
# package; its kernel APKBUILD also follows a moving `master` archive. Luma
# records it to avoid overstating the postmarketOS Tokay release boundary.
PIXEL9_PMAPORTS_URL=https://github.com/zumapro-mainline/pmaports.git
PIXEL9_PMAPORTS_BRANCH=main
PIXEL9_PMAPORTS_COMMIT=e399e127a363dae42ab58f27557a70590b5117b7
PIXEL9_PMAPORTS_KERNEL_APKBUILD_SHA256=fe47281bbfa4ec3c3079c3ec85286ab5fcd61c93f1ef05a7aba3780f9f189f10
PIXEL9_PMAPORTS_KOMODO_APKBUILD_SHA256=f11ae1dcef2148932bc7baed9ecf4f43dae8a63e13ed633cda45a28aeedd76f0
PIXEL9_PMAPORTS_KOMODO_DEVICEINFO_SHA256=9b8ea49d7579592f9f997d9161e96aa8d6041f7ab548ac12b3f034d022a88992

# Google's factory-supported Android 16 Pixel kernel manifest is a reference
# and recovery oracle, not the Luma release kernel. It enumerates the Pixel
# drivers and modules that shipped for the Caimito family.
PIXEL9_ANDROID_KERNEL_MANIFEST_URL=https://android.googlesource.com/kernel/manifest
PIXEL9_ANDROID_KERNEL_MANIFEST_BRANCH=android-gs-caimito-6.1-android16
PIXEL9_ANDROID_KERNEL_MANIFEST_COMMIT=cdef6011c8645d62360c08c557291cf54d930596
PIXEL9_ANDROID_KERNEL_MANIFEST_SHA256=2b3d74d2f0455b89af898e0d67ecfe65b7d3bde708d9d7b8c0d77f001f6031fb

# Official AOSP inspection tools used only for offline decoding of the stock
# boot boundary. Pin both source revisions and the fetched script content so a
# moving main branch cannot silently change the evidence.
PIXEL9_MKBOOTIMG_URL=https://android.googlesource.com/platform/system/tools/mkbootimg
PIXEL9_MKBOOTIMG_COMMIT=d2bb0af5ba6d3198a3e99529c97eda1be0b5a093
PIXEL9_MKBOOTIMG_SHA256=37d84b3d162e0bc62e36c1f4e1c63c85ea0caa9f29be023eb2f8efe006ad948c
PIXEL9_GKI_CERTIFICATE_TOOL_SHA256=1bb1feec68a13da18d581aa2c631798f86f6bc10b55d587b2dd31446a0f8a203
PIXEL9_UNPACK_BOOTIMG_SHA256=a9d260978a63bd06a24b6347e7dee8a28ff96639793caea15dff6aa491316308
PIXEL9_AVB_URL=https://android.googlesource.com/platform/external/avb
PIXEL9_AVB_COMMIT=761178607206f4cb2af79ed9eec52d8cbd814adb
PIXEL9_AVBTOOL_SHA256=e5a664a38db623da00f080219bc0ee60a640a9dc4a872803616fae4938ac749b
# Public AOSP test material used only to make a deterministic, structurally
# signed RAM-boot diagnostic. This is a widely known test private key, not a
# Luma or Google production trust root. It is fetched from the exact AVB commit
# and must never be installed in avb_custom_key or used for a release image.
PIXEL9_AVB_TESTKEY_PATH=test/data/testkey_rsa4096.pem
PIXEL9_AVB_TESTKEY_BYTES=3243
PIXEL9_AVB_TESTKEY_SHA256=6a224754880a57ab9cbd308267cd157d94cf05a1c8cb851aec4090e045d24121
PIXEL9_AVB_TEST_PUBLIC_KEY_BYTES=1032
PIXEL9_AVB_TEST_PUBLIC_KEY_SHA256=7728e30f50bfa5cea165f473175a08803f6a8346642b5aa10913e9d9e6defef6
PIXEL9_AVB_TEST_PUBLIC_KEY_SHA1=2597c218aae470a130f61162feaae70afd97f011

# Fedora's legacy-frame LZ4 encoder is the exact compressor used for the
# stock-shaped embedded-FIT wrapper. Pin its package and executable, because
# encoder changes can alter the bytes downloaded by the bootloader.
PIXEL9_LZ4_NEVRA=lz4-1.10.0-4.fc44.aarch64
PIXEL9_LZ4_BINARY_SHA256=aa017e1fd7565c7fe28ff4cc9b5bbae02dd54a360da99937a9c599d88170dce9
PIXEL9_LZ4_X86_64_NEVRA=lz4-1.10.0-4.fc44.x86_64
PIXEL9_LZ4_X86_64_BINARY_SHA256=ce49301044481d57f5c2a61bcedef3b66ef6cf0058c79148aae913286993f01e

# Recovery material selected after the 2026-09-01 read-only inventories. The
# first bootloader inspection completed a staged A/B transition from QPR1 slot
# A to QPR2 slot B, so these are the exact official QPR2 artifacts for the
# currently booted and green-verified build.
# Selection records the rollback set; it does not accept Google's download
# terms, download a payload, or authorize any phone operation.
PIXEL9_OBSERVED_BUILD_ID=CP41.260814.003.B1
PIXEL9_OBSERVED_SECURITY_PATCH=2026-08-05
PIXEL9_OBSERVED_BOOTLOADER=ripcurrentpro-17.0-15739203
PIXEL9_RECOVERY_REQUIRED_BASEBAND=g5400c-260728-260806-B-16025591
PIXEL9_OBSERVED_SLOT_SUFFIX=_a
PIXEL9_OBSERVED_VIRTUAL_AB=true
PIXEL9_OBSERVED_SLOT_A_SUCCESSFUL=true
PIXEL9_OBSERVED_SLOT_A_UNBOOTABLE=false
PIXEL9_OBSERVED_SLOT_B_SUCCESSFUL=true
PIXEL9_OBSERVED_SLOT_B_UNBOOTABLE=false

