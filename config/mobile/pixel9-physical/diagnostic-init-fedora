#!/bin/busybox sh
# SPDX-License-Identifier: Apache-2.0

# Volatile, non-interactive Fedora userspace execution proof for Tokay. BusyBox
# owns early init and the immutable report transport; the proof succeeds only
# if Fedora's dynamically linked AArch64 Bash executes against the Fedora 44
# glibc payload. No persistent filesystem is mounted and no command endpoint is
# exposed.

PATH=/bin:/usr/bin
export PATH
umask 077

bb=/bin/busybox
report=/run/luma-pixel9-fedora-report.txt
fedora_proof=/run/luma-fedora-userspace-proof.txt
glibc_proof=/run/luma-fedora-glibc-proof.txt
gadget=/sys/kernel/config/usb_gadget/luma_pixel9_diagnostic
device_address=192.168.77.1
host_address=192.168.77.2
proof_delay=5

$bb mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
$bb mkdir -p /dev/pts /proc /sys /run /sys/kernel/config
$bb mount -t devpts devpts /dev/pts 2>/dev/null || true
$bb mount -t proc proc /proc 2>/dev/null || true
$bb mount -t sysfs sysfs /sys 2>/dev/null || true
$bb mount -t tmpfs -o mode=0700,nosuid,nodev tmpfs /run 2>/dev/null || true
$bb mount -t configfs configfs /sys/kernel/config 2>/dev/null || true

exec </dev/null >/dev/console 2>&1

read_one() {
	[ -r "$1" ] || return 0
	$bb tr -d '\000\r\n' <"$1"
}

setup_composite_gadget() {
	[ -d /sys/kernel/config/usb_gadget ] || return 1
	$bb mkdir -p "$gadget" || return 1
	echo 0x1d6b >"$gadget/idVendor" || return 1
	echo 0x0106 >"$gadget/idProduct" || return 1
	echo 0xef >"$gadget/bDeviceClass" || return 1
	echo 0x02 >"$gadget/bDeviceSubClass" || return 1
	echo 0x01 >"$gadget/bDeviceProtocol" || return 1
	$bb mkdir -p "$gadget/strings/0x409" "$gadget/configs/c.1/strings/0x409" || return 1
	echo 'luma-pixel9-fedora-v4' >"$gadget/strings/0x409/serialnumber" || return 1
	echo 'Luma Project' >"$gadget/strings/0x409/manufacturer" || return 1
	echo 'Pixel 9 volatile Fedora proof v4' >"$gadget/strings/0x409/product" || return 1
	echo 'Read-only Fedora execution report over ECM' >"$gadget/configs/c.1/strings/0x409/configuration" || return 1
	echo 250 >"$gadget/configs/c.1/MaxPower" || return 1
	$bb mkdir -p "$gadget/functions/acm.usb0" "$gadget/functions/ecm.usb0" || return 1
	echo '02:4c:55:4d:42:01' >"$gadget/functions/ecm.usb0/dev_addr" || return 1
	echo '02:4c:55:4d:42:02' >"$gadget/functions/ecm.usb0/host_addr" || return 1
	$bb ln -s "$gadget/functions/acm.usb0" "$gadget/configs/c.1/acm.usb0" || return 1
	$bb ln -s "$gadget/functions/ecm.usb0" "$gadget/configs/c.1/ecm.usb0" || return 1
	for node in /sys/class/udc/*; do
		[ -e "$node" ] || continue
		echo "${node##*/}" >"$gadget/UDC" || return 1
		return 0
	done
	return 1
}

run_fedora_proof() {
	: >"$fedora_proof"
	if /usr/bin/bash --noprofile --norc -c '
		set -eu
		. /usr/lib/os-release
		[ "$ID" = fedora ]
		[ "$VERSION_ID" = 44 ]
		printf "FEDORA_ID=%s\n" "$ID"
		printf "FEDORA_VERSION_ID=%s\n" "$VERSION_ID"
		printf "FEDORA_PRETTY_NAME=%s\n" "$PRETTY_NAME"
		printf "FEDORA_BASH_VERSION=%s\n" "$BASH_VERSION"
		printf "FEDORA_BASH_EXECUTION_TOKEN=LUMA_PIXEL9_FEDORA44_AARCH64_OK\n"
	' >"$fedora_proof" 2>&1; then
		echo 'FEDORA_BASH_EXECUTED=true' >>"$fedora_proof"
	else
		echo 'FEDORA_BASH_EXECUTED=false' >>"$fedora_proof"
	fi
	/lib64/libc.so.6 >"$glibc_proof" 2>&1 || true
	$bb chmod 0444 "$fedora_proof" "$glibc_proof"
}

make_report() {
	lock_sha=$($bb sha256sum /usr/share/luma/pixel9-fedora44-rpms.lock | $bb awk '{print $1}')
	{
		echo 'LUMA_PIXEL9_DIAGNOSTIC_REPORT_VERSION=4'
		echo 'SCOPE=volatile-allowlisted-fedora44-aarch64-userspace-execution-proof'
		echo 'ROOT_FILESYSTEM=initramfs'
		echo 'PERSISTENT_FILESYSTEMS_MOUNTED=false'
		echo 'PERSISTENT_BLOCK_DEVICES_WRITTEN=false'
		echo 'MODULES_AUTOLOADED=false'
		echo 'INTERACTIVE_SHELL_EXPOSED=false'
		echo 'COMMAND_ENDPOINT_EXPOSED=false'
		echo 'ACM_FUNCTION_PRESENT=true'
		echo 'ACM_GETTY_PRESENT=false'
		echo 'REPORT_TRANSPORTS=usb-ecm-http'
		echo "FEDORA_RPM_LOCK_SHA256=$lock_sha"
		echo "PROOF_DELAY_SECONDS=$proof_delay"
		echo "KERNEL_RELEASE=$($bb uname -r)"
		echo "MACHINE=$($bb uname -m)"
		echo "MODEL=$(read_one /sys/firmware/devicetree/base/model)"
		if [ -r /sys/firmware/devicetree/base/compatible ]; then
			echo 'COMPATIBLE_BEGIN'
			$bb tr '\000' '\n' </sys/firmware/devicetree/base/compatible
			echo 'COMPATIBLE_END'
		fi

		echo 'FEDORA_USERSPACE_PROOF_BEGIN'
		$bb cat "$fedora_proof"
		echo 'FEDORA_USERSPACE_PROOF_END'
		echo 'FEDORA_GLIBC_PROOF_BEGIN'
		$bb cat "$glibc_proof"
		echo 'FEDORA_GLIBC_PROOF_END'

		echo 'MOUNTS_BEGIN'
		$bb cat /proc/mounts
		echo 'MOUNTS_END'
		echo 'BLOCK_DEVICES_BEGIN'
		for node in /sys/class/block/*; do
			[ -e "$node" ] || continue
			name=${node##*/}
			size=$(read_one "$node/size")
			readonly=$(read_one "$node/ro")
			echo "$name sectors=$size read_only=$readonly"
		done
		echo 'BLOCK_DEVICES_END'
		echo 'REPORT_END=true'
	} >"$report"
	$bb chmod 0444 "$report"
}

setup_report_network() {
	interface=$(read_one "$gadget/functions/ecm.usb0/ifname")
	[ -n "$interface" ] || return 1
	$bb ifconfig "$interface" "$device_address" netmask 255.255.255.0 up || return 1
	$bb mkdir -p /run/www
	$bb cp "$report" /run/www/luma-pixel9-report.txt || return 1
	$bb chmod 0555 /run/www
	$bb chmod 0444 /run/www/luma-pixel9-report.txt
	{
		echo "start $host_address"
		echo "end $host_address"
		echo "interface $interface"
		echo 'option subnet 255.255.255.0'
		echo 'option lease 600'
		echo 'lease_file /run/udhcpd.leases'
		echo 'pidfile /run/udhcpd.pid'
	} >/run/udhcpd.conf
	$bb touch /run/udhcpd.leases
	$bb udhcpd -f /run/udhcpd.conf >/dev/console 2>&1 &
	$bb httpd -f -p "$device_address:80" -h /run/www >/dev/console 2>&1 &
	return 0
}

if setup_composite_gadget; then
	echo 'USB_COMPOSITE_GADGET_READY=true'
else
	echo 'USB_COMPOSITE_GADGET_READY=false'
fi

echo "Luma Pixel 9 Fedora proof waiting $proof_delay seconds before execution."
$bb sleep "$proof_delay"
run_fedora_proof
make_report
$bb cat "$report"

if setup_report_network; then
	echo "USB_ECM_HTTP_READY=true address=http://$device_address/luma-pixel9-report.txt"
else
	echo 'USB_ECM_HTTP_READY=false'
fi

iteration=0
while [ "$iteration" -lt 36 ]; do
	iteration=$((iteration + 1))
	$bb sleep 5
done

echo 'Luma Pixel 9 Fedora proof timeout; rebooting to the bootloader-selected stock path.'
$bb reboot -f
$bb sleep 10
echo o >/proc/sysrq-trigger 2>/dev/null || true
exit 1
