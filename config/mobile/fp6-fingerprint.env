FP6_FINGERPRINT_MDT_ELF64_CONFIG_SHA256=0b6b26b38573cf8414378edc56e0ebadb42ee12f59761ad28311edf762a41d57
FP6_FINGERPRINT_MDT_ELF64_DTB_SHA256=2a689d6163551634760455f4700b6aa2b2c745cd1baac70dc6b39bafff62d46b
FP6_FINGERPRINT_MDT_ELF64_RAMDISK_SHA256=3ed23188d9fb5ae8ed90b8d3b274e8d4d4432c3f60a25b14d718c33d9391a8a4
FP6_FINGERPRINT_MDT_ELF64_BOOT_SHA256=0b8cd15b0b718dea3433a106c96eb141e0ca62d880f547265a25ce919f3bbb3b
FP6_FINGERPRINT_MDT_ELF64_ASSEMBLED_IMAGE_SIZE=3595661
FP6_FINGERPRINT_MDT_ELF64_VERIFIER_SHA256=d6e06352e87ac84f564d1e484a97879c45a2db0a8bd3834278f4b673db2d3b86
