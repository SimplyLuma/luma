FP6_FINGERPRINT_DMA_CMA_BOOT_CANDIDATE_READY=true
FP6_FINGERPRINT_DMA_CMA_PHYSICAL_ACCEPTED=false

# Identity-v5 physically booted the DMA-CMA candidate and accepted its exact
# 32 MiB reservation, slot, kernel, modules, and device nodes. It stopped
# before staging any TA file because the boot log contained a kernel Oops in
# software_node_notify() while the pre-existing evdev.ko was loaded. Enabling
# CONFIG_DMA_CMA adds cma_area to struct device, so a kernel-only config change
# is ABI-incompatible with the installed non-CMA module set. The authorized
# listener-v2 rollback restored a clean running system.
