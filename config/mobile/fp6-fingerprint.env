# Secure-backend identity-v4 physically accepted the ELF64-loader kernel and
# reached normal-world trustlet staging. The 3,595,661-byte image plus QSEE's
# 4 MiB alignment margin required an order-11 dma_alloc_coherent allocation;
# the post-boot non-CMA allocator returned ENOMEM before SCM app-start. The
# warning was noncritical, cleanup was complete, and secure world made no TA
# identity decision.
FP6_FINGERPRINT_IDENTITY_V4_ATTEMPTED=true
FP6_FINGERPRINT_IDENTITY_V4_LISTENER_FS_ACCEPTED=true
FP6_FINGERPRINT_IDENTITY_V4_LISTENER_GPFS_ACCEPTED=true
FP6_FINGERPRINT_IDENTITY_V4_ATTACH_ERRNO=2
FP6_FINGERPRINT_IDENTITY_V4_LOAD_ERRNO=12
FP6_FINGERPRINT_IDENTITY_V4_REATTACH_ERRNO=2
FP6_FINGERPRINT_IDENTITY_V4_TA_SESSION_ACCEPTED=false
FP6_FINGERPRINT_IDENTITY_V4_CLEANUP_ACCEPTED=true
FP6_FINGERPRINT_IDENTITY_V4_PAGE_ALLOC_WARNING=true
FP6_FINGERPRINT_IDENTITY_V4_CRITICAL_FAULT=false

# Reproducible offline successor to identity-v4. It retains the exact
# listener-v2 DTB, ramdisk, modules, boot-header fields, and patchsets while
# enabling Linux's reusable DMA-CMA pool with a conservative 32 MiB default.
# This candidate has not accessed the phone and needs new exact authority.
FP6_FINGERPRINT_DMA_CMA_SIZE_MBYTES=32
FP6_FINGERPRINT_DMA_CMA_KERNEL_SHA256=1c08af8a27856a87092b47673862f28dff44001c37e9a056c134b93d643f8fbc
FP6_FINGERPRINT_DMA_CMA_CONFIG_SHA256=fb83e40603ea6567e174fb13f28351560dfd7e83461903723f3fa013b9a7c604
FP6_FINGERPRINT_DMA_CMA_DTB_SHA256=2a689d6163551634760455f4700b6aa2b2c745cd1baac70dc6b39bafff62d46b
FP6_FINGERPRINT_DMA_CMA_RAMDISK_SHA256=3ed23188d9fb5ae8ed90b8d3b274e8d4d4432c3f60a25b14d718c33d9391a8a4
FP6_FINGERPRINT_DMA_CMA_BOOT_SHA256=f0ae4d5288818c57515211a8187ccafe17bf7a12231cf2aa6bd761fd6c0e7e7b
