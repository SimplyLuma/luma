#!/bin/busybox sh
# SPDX-License-Identifier: Apache-2.0
# Unihertz Titan 2 Elite initramfs, built into the kernel: mount the Luma root
# from partition 1 of the microSD card, pick the OSTree deployment from
# ostree's boot entries, let that deployment's own ostree-prepare-root set up
# the root, and start systemd in it. On failure the phone restarts after 30 s.
#
# Boot counting: the newest entry boots until it is blessed
# (/boot/luma-boot-ok, written once greenboot passes). An unblessed newest
# entry gets two tries (/boot/luma-boot-attempt); after that the previous
# entry boots instead.
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
log() { echo "luma-initramfs: $*" >/dev/kmsg; }
fail() { log "$*; restarting in 30 s"; sleep 30; reboot -f; }

i=0
while [ ! -b /dev/mmcblk0p1 ] && [ $i -lt 60 ]; do sleep 1; i=$((i + 1)); done
[ -b /dev/mmcblk0p1 ] || fail "no microSD root (mmcblk0p1)"
mount /dev/mmcblk0p1 /sysroot || fail "cannot mount the microSD root"

B=/sysroot/boot
# ostree gives the default (newest) deployment the highest version.
set -- $(for f in "$B"/loader/entries/*.conf; do
	[ -e "$f" ] && echo "$(sed -n 's/^version //p' "$f") $f"
done | sort -rn | cut -d' ' -f2)
[ $# -gt 0 ] || fail "no boot entries in /boot/loader/entries"
entry_target() { sed -n 's/^options .*ostree=\([^ ]*\).*/\1/p' "$1"; }
newest=$(entry_target "$1")
previous=
[ $# -gt 1 ] && previous=$(entry_target "$2")
target=$newest
if [ "$newest" != "$(cat "$B/luma-boot-ok" 2>/dev/null)" ]; then
	id= tries=0
	[ -e "$B/luma-boot-attempt" ] && read -r id tries <"$B/luma-boot-attempt"
	[ "$id" = "$newest" ] || tries=0
	if [ "${tries:-0}" -ge 2 ] && [ -n "$previous" ]; then
		log "$newest did not finish booting twice; booting $previous"
		target=$previous
	else
		echo "$newest $((${tries:-0} + 1))" >"$B/luma-boot-attempt.new" &&
			mv "$B/luma-boot-attempt.new" "$B/luma-boot-attempt" && sync
	fi
fi
[ -n "$target" ] || fail "boot entry without ostree="
D=$(cd "/sysroot$target" 2>/dev/null && pwd -P) || fail "no OSTree deployment at $target"

# prepare-root and the booted system read the deployment from ostree= on the
# command line; add it to what the kernel was given.
echo "$(cat /proc/cmdline) ostree=$target" >/run/luma-cmdline
mount --bind /run/luma-cmdline /proc/cmdline
# prepare-root mounts the stateroot's /var as well.
mkdir -p /run/ostree && : >/run/ostree/initramfs-mount-var
"$D/usr/lib/ld-linux-aarch64.so.1" --library-path "$D/usr/lib64:$D/usr/lib" \
	"$D/usr/lib/ostree/ostree-prepare-root" /sysroot || fail "ostree-prepare-root failed for $target"
for m in /run /dev /sys /proc; do mount --move "$m" "/sysroot$m"; done
log "starting Luma from $target"
exec switch_root /sysroot /usr/lib/systemd/systemd
