# SPDX-License-Identifier: Apache-2.0

FP6_HAPTIC_CONTROLLER=Awinic-AW86938
FP6_HAPTIC_OF_COMPATIBLES=awinic,aw86938,awinic,aw86927
FP6_HAPTIC_INPUT_NAME=aw86927-haptics
FP6_HAPTIC_I2C_ADDRESS=0x5a
FP6_HAPTIC_IRQ_GPIO=80
FP6_HAPTIC_RESET_GPIO=78

# The current Linux driver and DT are pinned to the same audited tree as the
# other FP6 hardware candidates.  The driver embeds its single sine waveform.
FP6_HAPTIC_KERNEL_REPO=https://forgejo.catcrafts.net/Catcrafts/milos-linux.git
FP6_HAPTIC_KERNEL_COMMIT=af49850e65bdf5dc6f4a14fb9e8e5c5814522d33
FP6_HAPTIC_DRIVER_SHA256=f1176c6165b2850bc1aad28cd96d4d953f683ef1dd1e38fe61d002daa7e95e92
FP6_HAPTIC_STOCK_FIRMWARE_REQUIRED=false
FP6_HAPTIC_STOCK_FIRMWARE_REDISTRIBUTION_ACCEPTED=false

# Conservative first-test limits.  The helper refuses values beyond these.
FP6_HAPTIC_MAX_TEST_MAGNITUDE=24576
FP6_HAPTIC_MAX_TEST_DURATION_MS=150
FP6_HAPTIC_BOUNDED_TEST_READY=true
FP6_HAPTIC_STANDARD_FF_TRANSPORT_ACCEPTED=true
FP6_HAPTIC_BOUNDED_PULSE_EXECUTED=true
FP6_HAPTIC_PHYSICAL_ACCEPTED=true
FP6_HAPTIC_SUSPEND_ACCEPTED=false
FP6_HAPTIC_THERMAL_ACCEPTED=false
