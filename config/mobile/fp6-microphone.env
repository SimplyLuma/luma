# The first Luma FP6 microphone trial is a RAM-boot-only integration of the
# current upstream WCD9378/SoundWire series.  It is based on the exact boot
# image that physically passed Luma speaker and receiver playback.
FP6_MICROPHONE_BASE_BOOT_SHA256=44e8e2a04d960ea33cd7bee3e52251d20ce0b70432a2368408e08978042117a7

# The proven kernel must remain byte-identical so every pre-existing split-BTF
# module retains its base-type identity. The first rebuilt-kernel RAM boot
# reached userspace but correctly rejected those modules and had no display.
FP6_MICROPHONE_PROVEN_KERNEL_SHA256=62556c8a87a0b8c345fdfd11770bffad7b112526e17cdb353600bec8648583ef
