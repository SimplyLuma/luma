# Fedora 44's stock packages are libqmi 1.36.0 and ModemManager 1.24.2.
# The FP6 GNSS engine needs the newer LOC client-identification API plus the
# still-experimental ModemManager position-report path below.
FP6_GNSS_LIBQMI_REPO=https://gitlab.freedesktop.org/mobile-broadband/libqmi.git
FP6_GNSS_LIBQMI_COMMIT=30f3e998e6cbda364ac1bc73223de20561e6d555
FP6_GNSS_LIBQMI_VERSION=1.39.1
FP6_GNSS_LIBQMI_FEDORA44_PACKAGING_COMMIT=32aca7e0d590afe52af469577344dafb201d3058
FP6_GNSS_LIBQMI_FEDORA44_VERSION=1.36.0-3.fc44

FP6_GNSS_MODEMMANAGER_REPO=https://gitlab.freedesktop.org/mobile-broadband/ModemManager.git
FP6_GNSS_MODEMMANAGER_COMMIT=d776ea38d29ca472a12323c1d45002ee19a66f57
FP6_GNSS_MODEMMANAGER_VERSION=1.25.95
FP6_GNSS_MODEMMANAGER_FEDORA44_PACKAGING_COMMIT=8fc8008d6bc39f95999ce7b7848ef291e7959217
FP6_GNSS_MODEMMANAGER_FEDORA44_VERSION=1.24.2-3.fc44

FP6_GNSS_LIBQMI_MR=https://gitlab.freedesktop.org/mobile-broadband/libqmi/-/merge_requests/470
FP6_GNSS_MODEMMANAGER_MR=https://gitlab.freedesktop.org/mobile-broadband/ModemManager/-/merge_requests/1463

# One-time physical diagnostic state.  PACKAGE_INSTALL_AUTHORIZED remains
# false because the completed authorization is not reusable for future writes.
FP6_GNSS_LIVE_PACKAGE_STATE=installed-diagnostic
FP6_GNSS_ROLLBACK_STAGED=true
FP6_GNSS_ROLLBACK_LIBQMI_SHA256=86fd48f41708564c51e488536a2c57c8d722f4fb99a94fb59210693800aa578a
FP6_GNSS_ROLLBACK_LIBQMI_UTILS_SHA256=628aec6c22a2b0732e23ba4eb3482e518ec6a804f83ca725517c6ee540104f6b
FP6_GNSS_ROLLBACK_MODEMMANAGER_SHA256=2101d6662e914ba5e2329f25c1479999a04f7d8c83d08c3f972b3f80671306c1
FP6_GNSS_ROLLBACK_MODEMMANAGER_GLIB_SHA256=bfac5045a95b38089bf606e56fed9b3f030011eb1837004ec6b5aa83f871d322
FP6_GNSS_CAPABILITY_ACCEPTED=true
FP6_GNSS_NMEA_STREAM_ACCEPTED=true
FP6_GNSS_COORDINATE_FIX_ACCEPTED=false
FP6_GNSS_IMAGE_INCLUSION_ACCEPTED=false
FP6_GNSS_PHYSICAL_ACCEPTED=false
FP6_GNSS_PACKAGE_INSTALL_AUTHORIZED=false
