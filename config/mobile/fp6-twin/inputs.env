# SPDX-License-Identifier: Apache-2.0

# Official Fedora 44 aarch64 Cloud image recorded from Fedora's download page.
FEDORA_CLOUD_RELEASE=44
FEDORA_CLOUD_COMPOSE=1.7
FEDORA_CLOUD_IMAGE=Fedora-Cloud-Base-Generic-44-1.7.aarch64.qcow2
# Fedora MirrorManager currently selects incomplete mirrors for this compose.
# This HTTPS endpoint is returned by Fedora's official mirror list and serves
# the exact file whose Fedora-published checksum is pinned below.
FEDORA_CLOUD_URL=https://sjc.mirror.rackspace.com/fedora/releases/44/Cloud/aarch64/images/Fedora-Cloud-Base-Generic-44-1.7.aarch64.qcow2
FEDORA_CLOUD_SHA256=55c60a3b80d3616a08705afd0459e75fe9f03c54aba7a46e4002a41a72fa0d5b

# Fairphone-published behavioral dimensions. These constrain presentation and
# scenario testing only; they do not claim that QEMU emulates FP6 silicon.
FP6_MACHINE_ID=fairphone-fp6
FP6_SOC_ID=sm7635
FP6_PLATFORM_ID=milos
FP6_DISPLAY_WIDTH=1116
FP6_DISPLAY_HEIGHT=2484
FP6_DISPLAY_PPI=431
FP6_DISPLAY_MIN_HZ=10
FP6_DISPLAY_MAX_HZ=120
FP6_TOUCH_SAMPLE_HZ=240
FP6_MEMORY_MIB=8192
FP6_BATTERY_MAH=4415

# The virtual machine intentionally exposes the generic QEMU hardware contract.
LUMA_TWIN_MACHINE=virt
LUMA_TWIN_CPU_COUNT=8
LUMA_TWIN_MEMORY_MIB=8192
LUMA_TWIN_SSH_PORT=2226
LUMA_TWIN_VNC_DISPLAY=6
