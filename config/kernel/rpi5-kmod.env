# SPDX-License-Identifier: Apache-2.0
# Kernel the Raspberry Pi 5 kmods (luma-rpi5-kmod) are built for. It must be
# the ARM runtime kernel (config/install/atlas/runtime-kernel-aarch64.env);
# bump both together. Sources come from that kernel's own Fedora SRPM, so the
# rebuilt vc4 is the shipped vc4 plus patches/linux-rpi5/<series>.
RPI5_KMOD_KERNEL_NVR=7.2.11-200.fc44
RPI5_KMOD_KERNEL_ARCH=aarch64
RPI5_KMOD_KOJI_URL=https://kojipkgs.fedoraproject.org/packages/kernel/7.2.11/200.fc44
RPI5_KMOD_SRPM_SHA256=5e7c2d81cd5fc54749e94917b6c2604c23c089dd0d277681e85e54d04bf6edc6
RPI5_KMOD_DEVEL_SHA256=9e70a3d3c474fca6765ea3990f3091a25f968e9bba3bee5063a3fa25c6a27470
RPI5_KMOD_SERIES=7.2
