# SPDX-License-Identifier: GPL-2.0-only
# OnePlus 6T (fajita): Luma additions to postmarketOS's
# config-postmarketos-qcom-sdm845.aarch64 (pmaports fa22430585a1), merged with
# scripts/kconfig/merge_config.sh -m, then make olddefconfig (LLVM=1).
# Fedora / ostree / systemd
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_LSM="landlock,lockdown,yama,selinux,bpf"
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_OVERLAY_FS=y
CONFIG_EROFS_FS=y
CONFIG_FS_VERITY=y
CONFIG_SQUASHFS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_AUTOFS_FS=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_FANOTIFY=y
CONFIG_USER_NS=y
CONFIG_PSI=y
# Android app container
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_MEMFD_CREATE=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_CT=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_IP_NF_NAT=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
# VoLTE / IMS
CONFIG_XFRM_USER=y
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
# Debug help (ramoops, watchdog, PM)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_QCOM_WDT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# Own release name so our modules never mix with Nura's
CONFIG_LOCALVERSION="-sdm845-luma"
# CONFIG_LOCALVERSION_AUTO is not set

# The pm8xxx RTC is not usable (1970); do not let it set the clock at load.
# CONFIG_RTC_HCTOSYS is not set
# Fedora modprobe.d loads snd-seq with snd-pcm.
CONFIG_SND_SEQUENCER=m
