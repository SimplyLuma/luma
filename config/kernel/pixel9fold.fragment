# Pixel 9 Pro Fold (comet) options on top of zumapro_defconfig. Appended to
# the defconfig's .config before olddefconfig by
# scripts/mobile/pixel9-fold/build-boot-image.sh, which also sets
# CONFIG_CMDLINE, CONFIG_INITRAMFS_SOURCE and CONFIG_EXTRA_FIRMWARE_DIR.

# Boot: built-in device tree and initramfs, forced command line
CONFIG_LUMA_EMBEDDED_DTB=y
CONFIG_EFI=y
CONFIG_CMDLINE_FORCE=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=y
# CONFIG_IO_STRICT_DEVMEM is not set
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y
# Keeps the kernel clear of the RAM the bootloader overwrites at
# Image+0x1800000 (see the README)
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_KALLSYMS_ALL is not set

# Display, GPU firmware
CONFIG_DRM_EXYNOS=y
CONFIG_EXTRA_FIRMWARE="arm/mali/arch11.8/mali_csffw.bin"

# Security
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_AUDIT=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,selinux,bpf,landlock"

# Storage: zram swap; F2FS for the phone's efs, persist and modem_userdata
CONFIG_ZRAM=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y

# Not used on this phone
# CONFIG_KVM is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_MAC80211 is not set

# Android apps (Waydroid)
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y

# Netfilter: nf_tables, iptables-nft compatibility, NAT and masquerade for
# Waydroid, podman and firewalld
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_REJECT_IPV6=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_HASH=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_LABELS=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_UNIX_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_NETLINK_DIAG=y
