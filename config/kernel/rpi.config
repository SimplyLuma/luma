# SPDX-License-Identifier: GPL-2.0-only
# Luma Raspberry Pi kernel: settings that win over both Fedora's configuration
# and Raspberry Pi's bcm2711_defconfig (scripts/kernel/merge-rpi-config.py).
CONFIG_LOCALVERSION="-1.luma.rpi.fc44.aarch64"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_BUILD_SALT="luma-rpi"
# 4K pages, as Fedora and Raspberry Pi's kernel8 (Pi 3/4/5): Android apps,
# Waydroid, box64/FEX and some JITs assume 4K. Pi 5's kernel_2712 uses 16K.
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
# Fedora's choices where the two sides differ and userspace notices.
CONFIG_DEFAULT_SECURITY_SELINUX=y
# CONFIG_DEFAULT_SECURITY_APPARMOR is not set
CONFIG_PROC_MEM_ALWAYS_FORCE=y
# CONFIG_PROC_MEM_FORCE_PTRACE is not set
# Raspberry Pi builds DWC3 in; its ULPI PHY interface then needs the bus in.
CONFIG_USB_ULPI_BUS=y
# Fedora's: no symbol versions. Raspberry Pi enables them; with genksyms they
# rule out Rust (Fedora's Rust drivers, DRM panic QR code).
# CONFIG_MODVERSIONS is not set
