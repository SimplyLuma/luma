# SPDX-License-Identifier: GPL-2.0-only
# Surface Pro 12-inch Gen 1 additions to Fedora 44's aarch64 configuration.
# Hardware selections informed by SayaAndy kernel-surface at
# 7b576ce5d97648bee3db87906deafcfcc82fa848/config/surface.config.
CONFIG_LOCALVERSION="-1.luma.surface12.fc44.aarch64"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_SURFACE_PLATFORMS=y
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m
CONFIG_SURFACE_AGGREGATOR_HUB=m
CONFIG_SURFACE_AGGREGATOR_TABLET_SWITCH=m
CONFIG_SURFACE_HID=m
CONFIG_SURFACE_HID_CORE=m
CONFIG_SURFACE_KBD=m
CONFIG_BATTERY_SURFACE=m
CONFIG_CHARGER_SURFACE=m
CONFIG_RTC_DRV_SURFACE=m
CONFIG_PHY_QCOM_MIPI_CSI2=m
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_OV13858=m
CONFIG_VIDEO_OV02C10=m
CONFIG_FASTRPC=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_SMP2P=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_ATH12K=m
CONFIG_BT_QCA=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_ARM64_4K_PAGES=y
# CONFIG_ARM64_16K_PAGES is not set
# CONFIG_ARM64_64K_PAGES is not set
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_SNAPSHOT=y
CONFIG_ISO9660_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
# Keep Fedora's security and BPF/debug capabilities. No vendor private keys
# exist in upstream source. The build creates a private module signing key;
# signing the boot image is a separate release-infrastructure operation.
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_LSM=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
# Device-scoped kernel: other ARM SoCs remain in the generic ARM image.
# Keep QEMU's reference platform for automated boot checks.
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_VEXPRESS=y
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
