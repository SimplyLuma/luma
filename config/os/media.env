# SPDX-License-Identifier: CC-BY-4.0
# Nightly installer media (scripts/os/nightly-media.sh). Plain KEY=value lines.

# Atlas, the installer the media carry: an exact revision on a pushed branch,
# and the RPM built from it with its SHA-256. Both change only by a reviewed
# commit here.
LUMA_MEDIA_ATLAS_BRANCH=main
LUMA_MEDIA_ATLAS_REVISION=4a736acacfe15f62e8044dca73ad5d86ca807371
LUMA_MEDIA_ATLAS_NEVRA=luma-installer-atlas-0.1.0-1.luma.20.creator20261021.1.fc44.noarch
LUMA_MEDIA_ATLAS_SHA256=9c4cda033f26eb15c63e4252e838806bea161ad8b208bc76ff18599fa7f178a1

# Channels that get media every time a release is published on them.
LUMA_MEDIA_CHANNELS=nightly beta stable

# Where media are served on dl.simplyluma.com, below its web root. Nightly
# media are one medium per build with no credential, served openly on an
# unlisted path (owner decision 2026-09-16): <public prefix>/<channel>/.
# The staff prefix only names where earlier credential media still sit; the
# stage no longer builds them.
LUMA_MEDIA_STAFF_PREFIX=preview-media
LUMA_MEDIA_PUBLIC_PREFIX=media

# Public installer downloads remain available for at least seven days after
# the confirmed website switch. Missing confirmation keeps old downloads.
# The host ledger preserves longer deadlines; current never expires.
# Count/budget cleanup can only retire installers outside this protected window.
LUMA_MEDIA_RETENTION_DAYS=7
LUMA_MEDIA_KEEP=2
# What else the origin holds that the budget must leave room for, in GiB,
# beyond the repository generation and the served media the budget measures
# directly. Measured on the origin 2026-09-20: the Depot app repository 2.3,
# the instrument sounds 0.5, everything else a few megabytes. It was 8, which
# was four GiB of room for two, and that alone cost a nightly its place: the
# budget dropped to one medium where two fit.
LUMA_MEDIA_DL_OTHER_GIB=3
# Media kept on the build host per channel, as build directories. At least 2:
# the previous medium proves the update path to the next build.
LUMA_MEDIA_LOCAL_KEEP=2

# Release-blocking out-of-box checks on every install made from the medium:
# tests/os/gate/<name>.sh from the release's own source, with arguments after
# ":" ("+" for a space). A missing script fails the medium.
LUMA_MEDIA_REQUIRED_CHECKS=luma-identity default-browser default-pdf-viewer update-out-of-box:--medium+public+--expect-channel+@CHANNEL@ depot-out-of-box no-install-hurdles fedora-cannot-replace-luma
