[Unit]
Description=Luma Mobile simulator display readiness
After=mobi.phosh.Shell.service
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/luma-tester-mobile-ready
TimeoutStartSec=190
RemainAfterExit=yes

[Install]
WantedBy=graphical-session.target
