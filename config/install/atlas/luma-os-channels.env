# SPDX-License-Identifier: LGPL-2.1-or-later
# Luma OS delivery contract the installer media follow (ADR-030, sections 4, 5
# and 9). build-installer-iso.sh reads this file; change it here, not in the
# script, when the contract changes.

# The HTTPS remote every installed system updates from, whatever it was
# installed from.
LUMA_OS_REMOTE=luma
LUMA_OS_URL=https://dl.simplyluma.com/os/repo
# The remote never names that URL itself: its url is
# mirrorlist=file://$LUMA_OS_MIRRORLIST, and this root-only file (0600) holds
# the repository URL (luma-update's mirror-list layout; enrollment rewrites
# only the file).
LUMA_OS_MIRRORLIST=/etc/luma/update-mirrorlist
LUMA_OS_COLLECTION_ID=org.projectluma.OS

# Refs are luma/1/x86_64/<channel>.
LUMA_OS_REF_PREFIX=luma/1/x86_64
LUMA_OS_CHANNELS="stable beta nightly"
LUMA_OS_PREVIEW_CHANNELS="beta nightly"
# Preview repositories are https://dl.simplyluma.com/os/preview/<credential>/repo;
# a preview credential, when a staff medium carries one, is recorded in
# luma-update's enrollment file.
LUMA_OS_PREVIEW_URL_PREFIX=https://dl.simplyluma.com/os/preview
LUMA_OS_PREVIEW_RECORD=/etc/luma/update-preview-credential

# Install media built for staff default to nightly; public media pass
# --channel stable.
LUMA_OS_DEFAULT_CHANNEL=nightly

# The Luma OS Release public key. The OS release pipeline publishes it at this
# path on the build host; --release-key overrides it.
LUMA_OS_RELEASE_KEY=/etc/pki/ostree/luma-release.gpg

# Where the installed system keeps that key (the image ships the same path).
LUMA_OS_TARGET_KEY=/etc/pki/ostree/luma-release.gpg

# The OSTree stateroot of a fresh install.
LUMA_OS_STATEROOT=luma

# Where a carried payload lives on the install medium.
LUMA_OS_MEDIUM_REPO=luma/repo
