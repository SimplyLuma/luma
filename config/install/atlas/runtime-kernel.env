# The kernel the Atlas installer runtime boots, read by
# scripts/install/atlas-iso/build-installer-iso.sh.
#
# Fedora 44's release repository is frozen at the GA kernel, so an installer
# built from it alone runs an older kernel than the system it installs. On
# Lunar Lake that GA kernel takes the xe display-port tunnel hang that hard
# resets the machine, which mid-install is the worst moment for it.
#
# Fedora's updates repository is rolling and cannot be a build input here (two
# builds of one source revision would differ). So the kernel is pinned the way
# every other upstream input in this repository is: an exact NVR fetched from
# Koji's immutable path and checked against its sha256. It goes into the
# medium's own package repository, which lorax already takes as its second
# --source, and the build fails unless the runtime ends up on exactly this
# kernel.
#
# Keep this at or above the kernel of the release the media carry
# (builds/<id>/export.env, LUMA_EXPORT_KERNEL). Creator preview 20261004.2 runs
# 7.2.8-200.fc44.

ATLAS_RUNTIME_KERNEL_NVR=7.2.8-200.fc44
ATLAS_RUNTIME_KERNEL_ARCH=x86_64
ATLAS_RUNTIME_KERNEL_BASE_URL=https://kojipkgs.fedoraproject.org/packages/kernel/7.2.8/200.fc44/x86_64
ATLAS_RUNTIME_KERNEL_PACKAGES="kernel kernel-core kernel-modules kernel-modules-core"

ATLAS_RUNTIME_KERNEL_SHA256_kernel=1c5071fafb53ce61b79cf1abedefcb9de1983526bcc81ce674d35ef2245bcae4
ATLAS_RUNTIME_KERNEL_SHA256_kernel_core=5cb3d8dda0bb97143fdeb0d1e780cd36fd0fd7d9fa6cabb4108b96eaf60eaad3
ATLAS_RUNTIME_KERNEL_SHA256_kernel_modules=9bb0975b32ee9cec46443b242bfd058596dd7d6d1579fbe5c65e7d2d19258e77
ATLAS_RUNTIME_KERNEL_SHA256_kernel_modules_core=867e184bcf20e5ed996f3dcae36b3fe18de132839bd87df732654dada29eb339
