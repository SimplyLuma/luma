+/*
+ * MT6878 MD MTCMOS sequence (scpsys "md" domain: PWR_CON 0xE00, EXT_BUCK_ISO
+ * 0xF24[1:0], three bus-protect steps, no RST_B). The kernel has no MT6878
+ * scpsys driver, so the modem driver drives the domain itself.
+ */
+#define MD_SPM_BASE		0x1c001000
+#define MD_IFR_BASE		0x10001000
+#define MD_NEMI_BASE		0x10270000
+#define MD_PWR_CON		0xe00
+#define MD_EXTB_ISO		0xf24
+#define MD_PWR_ON		BIT(2)
+#define MD_PWR_ACK		BIT(30)
+
+struct md_bus_prot { void __iomem **base; u32 set, clr, sta, mask; };
+static void __iomem *md_spm, *md_ifr, *md_nemi;
+static const struct md_bus_prot md_bp[] = {
+	{ &md_ifr, 0xc54, 0xc58, 0xc5c, BIT(9) },
+	{ &md_ifr, 0xc44, 0xc48, 0xc4c, BIT(11) },
+	{ &md_nemi, 0x84, 0x88, 0x8c, BIT(6) | BIT(7) },
+};
+
+/* bring-up knobs: split the power sequence to find which step resets the phone */
+static unsigned int md_dbg_step_ms;
+module_param(md_dbg_step_ms, uint, 0644);
+static bool md_skip_mtcmos;
+module_param(md_skip_mtcmos, bool, 0644);
+static bool md_no_go;
+module_param(md_no_go, bool, 0644);
+/* stock kernel starts DVFSRC (MTK_SIP_VCOREFS_CONTROL, DVFSRC_START) at late init */
+static bool md_dvfsrc_start;
+module_param(md_dvfsrc_start, bool, 0644);
+
+static void md_dbg_step(const char *what)
+{
+	pr_info("ccci: md step: %s\n", what);
+	if (md_dbg_step_ms)
+		msleep(md_dbg_step_ms);
+}
+
+static int md_mtcmos(bool on)
+{
+	u32 v;
+	int i, ret;
+
+	md_dbg_step(on ? "mtcmos on" : "mtcmos off");
+	if (md_skip_mtcmos)
+		return 0;
+	if (!md_spm) {
+		md_spm = ioremap(MD_SPM_BASE, 0x1000);
+		md_ifr = ioremap(MD_IFR_BASE, 0x1000);
+		md_nemi = ioremap(MD_NEMI_BASE, 0x1000);
+		if (!md_spm || !md_ifr || !md_nemi)
+			return -ENOMEM;
+	}
+	if (on) {
+		writel(readl(md_spm + MD_EXTB_ISO) & ~0x3, md_spm + MD_EXTB_ISO);
+		writel(readl(md_spm + MD_PWR_CON) | MD_PWR_ON, md_spm + MD_PWR_CON);
+		ret = readl_poll_timeout_atomic(md_spm + MD_PWR_CON, v, v & MD_PWR_ACK, 10, USEC_PER_SEC);
+		if (ret)
+			goto out;
+		for (i = ARRAY_SIZE(md_bp) - 1; i >= 0; i--) {
+			writel(md_bp[i].mask, *md_bp[i].base + md_bp[i].clr);
+			ret = readl_poll_timeout_atomic(*md_bp[i].base + md_bp[i].sta, v,
+				!(v & md_bp[i].mask), 10, USEC_PER_SEC);
+			if (ret)
+				goto out;
+		}
+	} else {
+		for (i = 0; i < ARRAY_SIZE(md_bp); i++) {
+			writel(md_bp[i].mask, *md_bp[i].base + md_bp[i].set);
+			ret = readl_poll_timeout_atomic(*md_bp[i].base + md_bp[i].sta, v,
+				(v & md_bp[i].mask) == md_bp[i].mask, 10, USEC_PER_SEC);
+			if (ret)
+				goto out;
+		}
+		writel(readl(md_spm + MD_PWR_CON) & ~MD_PWR_ON, md_spm + MD_PWR_CON);
+		ret = readl_poll_timeout_atomic(md_spm + MD_PWR_CON, v, !(v & MD_PWR_ACK), 10, USEC_PER_SEC);
+		if (ret)
+			goto out;
+		writel(readl(md_spm + MD_EXTB_ISO) | 0x3, md_spm + MD_EXTB_ISO);
+	}
+out:
+	CCCI_NORMAL_LOG(0, TAG, "md mtcmos %s: %d pwr_con=0x%x\n", on ? "on" : "off",
+		ret, readl(md_spm + MD_PWR_CON));
+	return ret;
+}
