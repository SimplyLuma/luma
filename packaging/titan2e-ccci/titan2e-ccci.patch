+/*
+ * The AT channel (ttyC0, CCCI_UART2) is also offered as a WWAN AT port: the
+ * kernel WWAN framework is what ModemManager probes, CCCI char nodes are not.
+ * The char node and the WWAN port exclude each other through usage_cnt.
+ */
+static struct wwan_port *at_wwan;
+static atomic_t at_wwan_open = ATOMIC_INIT(0);
+
+static int at_wwan_start(struct wwan_port *wport)
+{
+	struct port_t *port = wwan_port_get_drvdata(wport);
+
+	if (atomic_inc_return(&port->usage_cnt) > 1) {
+		atomic_dec(&port->usage_cnt);
+		return -EBUSY;
+	}
+	atomic_set(&at_wwan_open, 1);
+	return 0;
+}
+
+static void at_wwan_stop(struct wwan_port *wport)
+{
+	struct port_t *port = wwan_port_get_drvdata(wport);
+
+	atomic_set(&at_wwan_open, 0);
+	atomic_dec(&port->usage_cnt);
+}
+
+static int at_wwan_send(struct port_t *port, const void *data, unsigned int len)
+{
+	struct ccci_header *ccci_h;
+	struct sk_buff *skb;
+	int ret;
+
+	if (len > CCCI_MTU)
+		return -EMSGSIZE;
+	skb = ccci_alloc_skb(len + sizeof(*ccci_h), 1, 0);
+	if (!skb)
+		return -ENOMEM;
+	ccci_h = (struct ccci_header *)skb_put(skb, sizeof(*ccci_h));
+	ccci_h->data[0] = 0;
+	ccci_h->data[1] = len + sizeof(*ccci_h);
+	ccci_h->channel = port->tx_ch;
+	ccci_h->reserved = 0;
+	skb_put_data(skb, data, len);
+	ret = port_send_skb_to_md(port, skb, 0);
+	if (ret) {
+		ccci_free_skb(skb);
+		return ret == -EBUSY ? -EAGAIN : ret;
+	}
+	return 0;
+}
+
+static int at_wwan_tx(struct wwan_port *wport, struct sk_buff *skb)
+{
+	struct port_t *port = wwan_port_get_drvdata(wport);
+	struct sk_buff *frag;
+	int ret;
+
+	/* the WWAN core splits writes into linear frag_len (CCCI_MTU) pieces */
+	if (skb_headlen(skb)) {
+		ret = at_wwan_send(port, skb->data, skb_headlen(skb));
+		if (ret)
+			return ret;
+	}
+	skb_walk_frags(skb, frag) {
+		ret = at_wwan_send(port, frag->data, skb_headlen(frag));
+		if (ret)
+			return ret;
+	}
+	consume_skb(skb);
+	return 0;
+}
+
+static const struct wwan_port_ops at_wwan_ops = {
+	.start = at_wwan_start,
+	.stop = at_wwan_stop,
+	.tx = at_wwan_tx,
+};
+
+static void at_wwan_register(struct port_t *port)
+{
+	struct wwan_port_caps caps = { .frag_len = CCCI_MTU };
+	struct device_node *np;
+	struct platform_device *pdev;
+
+	np = of_find_compatible_node(NULL, NULL, "mediatek,mddriver");
+	pdev = np ? of_find_device_by_node(np) : NULL;
+	of_node_put(np);
+	if (!pdev) {
+		CCCI_ERROR_LOG(0, CHAR, "no mddriver device for the WWAN AT port\n");
+		return;
+	}
+	at_wwan = wwan_create_port(&pdev->dev, WWAN_PORT_AT, &at_wwan_ops, &caps, port);
+	if (IS_ERR(at_wwan)) {
+		CCCI_ERROR_LOG(0, CHAR, "WWAN AT port: %ld\n", PTR_ERR(at_wwan));
+		at_wwan = NULL;
+	}
+	put_device(&pdev->dev);
+}
