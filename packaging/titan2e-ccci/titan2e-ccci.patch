diff --git a/luma/titan-md.dtso b/luma/titan-md.dtso
new file mode 100644
index 0000000..dfaf378
--- /dev/null
+++ b/luma/titan-md.dtso
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Titan 2 Elite (MT6878) modem nodes: MD driver, CCIF, DPMAIF. Values from the stock DT. */
+/dts-v1/;
+/plugin/;
+
+/ {
+	/* LK adds these to the DT it boots stock with; values copied from it. */
+	fragment@1 {
+		target-path = "/";
+		__overlay__ {
+			md_attr_node {
+				compatible = "mediatek,md_attr_node";
+				mediatek,md_product_name_model_id = <0x0f0f0f0f>;
+				mediatek,md_drdi_rf_set_idx = <0x0f0f0f0f>;
+			};
+
+			/* <controller pin flags>; the controller cell is unused (MT6878 pinctrl) */
+			/*
+			 * SIM hot-plug EINT attributes the modem queries over CCCI RPC (stock
+			 * values). Looked up by node name; no compatible or interrupt-parent,
+			 * so no device is created for them.
+			 */
+			MD1-SIM1-HOT-PLUG-EINT {
+				interrupts = <0x00 0x08>;
+				debounce = <0x00 0x2710>;
+				dedicated = <0x00 0x00>;
+				src-pin = <0x00 0x01>;
+				sockettype = <0x00 0x00>;
+			};
+
+			MD1-SIM2-HOT-PLUG-EINT {
+				interrupts = <0x01 0x08>;
+				debounce = <0x01 0x2710>;
+				dedicated = <0x01 0x00>;
+				src-pin = <0x01 0x02>;
+				sockettype = <0x01 0x00>;
+			};
+
+			gpio-usage-mapping {
+				compatible = "mediatek,gpio_usage_mapping";
+				GPIO-SIM1-HOT-PLUG = <0 0x2e 0>;
+				GPIO-SIM2-HOT-PLUG = <0 0x2f 0>;
+				GPIO-SIM1-SCLK = <0 0x53 0>;
+				GPIO-SIM1-SRST = <0 0x54 0>;
+				GPIO-SIM1-SIO = <0 0x55 0>;
+				GPIO-SIM2-SCLK = <0 0x56 0>;
+				GPIO-SIM2-SRST = <0 0x57 0>;
+				GPIO-SIM2-SIO = <0 0x58 0>;
+				GPIO-FDD-BAND-SUPPORT-DETECT-1ST-PIN = <0 0xba 0>;
+				GPIO-FDD-BAND-SUPPORT-DETECT-2ND-PIN = <0 0xbb 0>;
+			};
+		};
+	};
+
+	fragment@0 {
+		target-path = "/soc@0";
+		__overlay__ {
+			/* infracfg_ao and topckgen: the board's syscon@10001000/@10000000 */
+			infracfg@1020e000 {
+				compatible = "mediatek,infracfg";
+				reg = <0x1020e000 0x1000>;
+			};
+
+			infracfg-ao-mem@10270000 {
+				compatible = "mediatek,infracfg_ao_mem";
+				reg = <0x10270000 0x1000>;
+			};
+
+			md-ccif4@1024d000 {
+				compatible = "mediatek,md_ccif4";
+				reg = <0x1024d000 0x1000>;
+			};
+
+			md-ccif5@1025d000 {
+				compatible = "mediatek,md_ccif5";
+				reg = <0x1025d000 0x1000>;
+			};
+
+			dpmaif@10014000 {
+				compatible = "mediatek,dpmaif";
+				reg = <0x10014000 0x1000>, <0x1022d000 0x1000>,
+				      <0x1022c000 0x1000>, <0x1022e000 0x1000>;
+				interrupts = <0 0xee 4 0>, <0 0x103 4 0>;
+				mediatek,dpmaif-ver = <3>;
+				mediatek,dpmaif-cap = <4>;
+				mediatek,plat-info = <6878>;
+				net-spd-ver = <5>;
+				hw-reset-ver = <1>;
+			};
+
+			ccifdriver@10209000 {
+				compatible = "mediatek,ccci_ccif";
+				reg = <0x10209000 0x1000>, <0x1020a000 0x1000>;
+				mediatek,sram-size = <0x200>;
+				mediatek,ccif-hw-reset-ver = <1>;
+				mediatek,ccif-hw-reset-bit = <0x1a>;
+				/* clocks are left running by LK; there is no MT6878 infra_ao clock driver */
+				mediatek,ccif-clk-free-run = <1>;
+				interrupts = <0 0xe4 4 0>, <0 0xe5 4 0>;
+			};
+
+			mddriver@d180000 {
+				compatible = "mediatek,mddriver";
+				mediatek,mdhif-type = <6>;
+				mediatek,ap-plat-info = <6878>;
+				mediatek,md-generation = <6299>;
+				mediatek,offset-epon-md1 = <0x64 0x06>;
+				mediatek,cldma-capability = <0x0e>;
+				mediatek,boot-status-config = <1>;
+				reg = <0xd180000 0x2000>;
+				interrupts = <0 0x1eb 4 0>, <0 0xe4 4 0>, <0 0xe5 4 0>;
+			};
+		};
+	};
+};
diff --git a/luma/titan_md_dt.c b/luma/titan_md_dt.c
new file mode 100644
index 0000000..3a8c026
--- /dev/null
+++ b/luma/titan_md_dt.c
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Applies the Titan 2 Elite modem DT overlay until the nodes live in the board DT. */
+#include <linux/module.h>
+#include <linux/of.h>
+
+extern const char titan_md_dtbo[], titan_md_dtbo_end[];
+static int ovcs_id;
+
+static int __init titan_md_dt_init(void)
+{
+	int ret;
+
+	if (of_find_compatible_node(NULL, NULL, "mediatek,mddriver")) {
+		pr_info("titan-md-dt: mddriver node already present\n");
+		return 0;
+	}
+	ret = of_overlay_fdt_apply(titan_md_dtbo, titan_md_dtbo_end - titan_md_dtbo,
+				   &ovcs_id, NULL);
+	pr_info("titan-md-dt: overlay apply %d (id %d)\n", ret, ovcs_id);
+	return ret;
+}
+
+static void __exit titan_md_dt_exit(void)
+{
+	if (ovcs_id)
+		of_overlay_remove(&ovcs_id);
+}
+
+module_init(titan_md_dt_init);
+module_exit(titan_md_dt_exit);
+MODULE_LICENSE("GPL");
