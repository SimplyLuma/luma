+/*
+ * LK only adds ccci,modem_info_v2 to the DT it hands over. When the kernel
+ * boots with its own DT, rebuild that record from the ccci_tag_mem reserved
+ * region LK filled in (v2 tags: 64-byte name, offset, size, next).
+ */
+static int lk_info_from_tag_mem(struct _ccci_lk_info_v2 *inf)
+{
+	struct device_node *np;
+	struct resource res;
+	struct _ccci_tag_v2 tag;
+	void __iomem *base;
+	unsigned int off = 0, n = 0;
+
+	np = of_find_compatible_node(NULL, NULL, "mediatek,ccci_tag_mem");
+	if (!np || of_address_to_resource(np, 0, &res))
+		return -ENODEV;
+	base = ioremap_wc(res.start, MAX_LK_INFO_SIZE);
+	if (!base)
+		return -ENOMEM;
+	while (off + sizeof(tag) <= MAX_LK_INFO_SIZE) {
+		memcpy_fromio(&tag, base + off, sizeof(tag));
+		if (!tag.tag_name[0] || tag.data_offset >= MAX_LK_INFO_SIZE)
+			break;
+		n++;
+		if (tag.next_tag_offset <= off)
+			break;
+		off = tag.next_tag_offset;
+	}
+	iounmap(base);
+	if (!n)
+		return -ENOENT;
+	memset(inf, 0, sizeof(*inf));
+	inf->lk_info_base_addr = res.start;
+	inf->lk_info_size = off;
+	inf->lk_info_version = CCCI_LK_INFO_VER_V2;
+	inf->lk_info_tag_num = n;
+	CCCI_UTIL_INF_MSG("lk info from ccci_tag_mem: %u tags, 0x%x bytes\n", n, off);
+	return 0;
+}
+
