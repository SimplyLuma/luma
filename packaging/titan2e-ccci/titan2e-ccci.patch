+# SPDX-License-Identifier: GPL-2.0
+# Out-of-tree build of the MediaTek CCCI modem stack (ccci_util, eccci, ccmni)
+# for the Unihertz Titan 2 Elite (MT6878), plus the modem DT overlay module.
+DEVICE_MODULES_PATH := $(KBUILD_EXTMOD)
+export DEVICE_MODULES_PATH
+subdir-ccflags-y += -DCONFIG_MTK_ECCCI_DRIVER_MODULE=1 -DCONFIG_MTK_NET_CCMNI_MODULE=1 \
+	-I$(DEVICE_MODULES_PATH)/compat -I$(DEVICE_MODULES_PATH)/include-kdm \
+	-include $(DEVICE_MODULES_PATH)/compat/luma_compat.h -Wno-error
+obj-m += luma/ drivers/misc/mediatek/ccci_util/ drivers/misc/mediatek/eccci/ drivers/misc/mediatek/ccmni/
diff --git a/compat/linux/of_gpio.h b/compat/linux/of_gpio.h
new file mode 100644
index 0000000..834e225
--- /dev/null
+++ b/compat/linux/of_gpio.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * of_gpio.h is gone in 7.x. CCCI looks up modem GPIOs by name in the
+ * "mediatek,gpio_usage_mapping" node (<phandle pin flags>); resolve the pin on
+ * the MT6878 pinctrl gpiochip and return its global GPIO number.
+ */
+#ifndef _LUMA_OF_GPIO_H
+#define _LUMA_OF_GPIO_H
+#include <linux/of.h>
+#include <linux/gpio.h>
+#include <linux/gpio/consumer.h>
+#include <linux/gpio/driver.h>
+
+static inline int of_get_named_gpio(const struct device_node *np, const char *name, int idx)
+{
+	struct device_node *pc;
+	struct gpio_device *gdev;
+	u32 pin;
+	int base;
+
+	if (of_property_read_u32_index(np, name, 1, &pin))
+		return -ENOENT;
+	pc = of_find_compatible_node(NULL, NULL, "mediatek,mt6878-pinctrl");
+	if (!pc)
+		return -ENODEV;
+	gdev = gpio_device_find_by_fwnode(of_fwnode_handle(pc));
+	of_node_put(pc);
+	if (!gdev)
+		return -EPROBE_DEFER;
+	base = gpio_device_get_base(gdev);
+	gpio_device_put(gdev);
+	return base + pin;
+}
+
+static inline int gpio_set_debounce(unsigned int g, unsigned int d) { return 0; }
+#endif
diff --git a/compat/luma_compat.h b/compat/luma_compat.h
new file mode 100644
index 0000000..ab6ab55
--- /dev/null
+++ b/compat/luma_compat.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Kernel 7.x API shims for the vendor CCCI stack. */
+#ifndef _LUMA_CCCI_COMPAT_H
+#define _LUMA_CCCI_COMPAT_H
+#include <linux/version.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/sched/clock.h>
+#include <linux/timer.h>
+#include <linux/hrtimer.h>
+#include <linux/syscore_ops.h>
+#include <linux/preempt.h>
+#include <linux/arm-smccc.h>
+#include <linux/soc/mediatek/mtk_sip_svc.h>
+
+#ifndef MTK_SIP_KERNEL_CCCI_CONTROL
+#define MTK_SIP_KERNEL_CCCI_CONTROL MTK_SIP_SMC_CMD(0x505)
+#include <linux/vmalloc.h>
+#endif
+#define in_irq()		in_hardirq()
+#define from_timer(var, t, f)	timer_container_of(var, t, f)
+#define del_timer(t)		timer_delete(t)
+#define del_timer_sync(t)	timer_delete_sync(t)
+#define strncpy(d, s, n)	({ char *__d = (d); strscpy_pad(__d, s, n); __d; })
+#include <linux/vmalloc.h>
+
+#include <linux/mfd/syscon.h>
+#include <linux/err.h>
+/*
+ * The modem drivers find the infracfg_ao and topckgen syscons by phandle. The
+ * Titan board DT already describes both blocks (without __symbols__, so a DT
+ * overlay cannot reference them); fall back to the board's node by compatible.
+ */
+static inline struct regmap *luma_syscon_lookup(struct device_node *np,
+						const char *prop,
+						const char *compatible)
+{
+	struct regmap *map = syscon_regmap_lookup_by_phandle(np, prop);
+
+	if (IS_ERR(map))
+		map = syscon_regmap_lookup_by_compatible(compatible);
+	return map;
+}
+
+#endif
