@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/delay.h>
+#include <linux/iopoll.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <scsi/scsi_host.h>
+#include <ufs/ufshcd.h>
+#include <linux/workqueue.h>
+
+static DEFINE_MUTEX(ufs_hold_lock);
+static bool ufs_hold = true;
+module_param(ufs_hold, bool, 0644);
+static struct ufs_hba *held;
+static void ufs_hold_expire(struct work_struct *w);
+static DECLARE_DELAYED_WORK(ufs_hold_work, ufs_hold_expire);
+
+/*
+ * The modem calibrates the 26 MHz reference clock it shares with UFS (AFC) and
+ * asks the AP to hold UFS I/O meanwhile (IPC_RPC_AFC_UFC_IO_BLOCK_OP). Mainline
+ * equivalent of the vendor ufs_mtk_cali_hold/release: block new requests, drain
+ * the doorbell and give auto-hibern8/clock gating time to stop the link clock.
+ */
+static struct ufs_hba *ccci_ufs_hba(void)
+{
+	struct device_node *np;
+	struct platform_device *pdev;
+
+	np = of_find_compatible_node(NULL, NULL, "mediatek,mt8183-ufshci");
+	if (!np)
+		return NULL;
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	return pdev ? platform_get_drvdata(pdev) : NULL;
+}
+
+static void ufs_unhold(void)
+{
+	if (!held)
+		return;
+	scsi_unblock_requests(held->host);
+	pm_runtime_put(&held->ufs_device_wlun->sdev_gendev);
+	held = NULL;
+}
+
+/* Never leave the root filesystem blocked if the modem does not release. */
+static void ufs_hold_expire(struct work_struct *w)
+{
+	mutex_lock(&ufs_hold_lock);
+	if (held)
+		pr_warn("ccci: UFS hold not released by modem, releasing\n");
+	ufs_unhold();
+	mutex_unlock(&ufs_hold_lock);
+}
+
+int ccci_ufs_hold(void)
+{
+	struct ufs_hba *hba = ccci_ufs_hba();
+	u32 db;
+	int ret;
+
+	pr_info("ccci: modem asks for UFS hold (%s, in_atomic=%d)\n", ufs_hold ? "on" : "off", in_atomic());
+	if (!ufs_hold)
+		return 0;
+	if (!hba || !hba->ufs_device_wlun)
+		return -EINVAL;
+	mutex_lock(&ufs_hold_lock);
+	if (!held) {
+		pm_runtime_get_sync(&hba->ufs_device_wlun->sdev_gendev);
+		scsi_block_requests(hba->host);
+		held = hba;
+	}
+	mutex_unlock(&ufs_hold_lock);
+	schedule_delayed_work(&ufs_hold_work, 3 * HZ);
+	ret = readl_poll_timeout(hba->mmio_base + REG_UTP_TRANSFER_REQ_DOOR_BELL,
+				 db, !db, 100, USEC_PER_SEC);
+	mdelay(15);
+	pr_info("ccci: UFS requests blocked for modem AFC, ret=%d\n", ret);
+	return ret ? -EBUSY : 0;
+}
+
+int ccci_ufs_release(void)
+{
+	cancel_delayed_work_sync(&ufs_hold_work);
+	mutex_lock(&ufs_hold_lock);
+	ufs_unhold();
+	mutex_unlock(&ufs_hold_lock);
+	pr_info("ccci: UFS requests unblocked\n");
+	return 0;
+}
