 	if (IS_ERR(md_cd_plat_val_ptr.infra_ao_base)) {
 		CCCI_ERROR_LOG(0, TAG,
 			"infra_ao fail: NULL!\n");
@@ -1546,8 +1645,8 @@ static int md_cd_get_modem_hw_info(struct platform_device *dev_ptr,
