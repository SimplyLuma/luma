# Tools for composing and testing the Luma installer ISO with Atlas.
# lorax is pinned to the version Fedora 44's own installer images were made with.
ARG BASE_IMAGE=registry.fedoraproject.org/fedora:44
FROM ${BASE_IMAGE}
ARG TARGET_ARCH=x86_64
# Fedora's container image limits installed translations to en_US through an
# rpm macro, and rpm applies it inside lorax's install root too: the runtime
# then has no Anaconda catalogues and Anaconda offers English only.
RUN rm -f /etc/rpm/macros.image-language-conf && \
    printf '%%_install_langs all\n' > /etc/rpm/macros.luma-atlas-install-langs
RUN case "$TARGET_ARCH" in \
      x86_64) vm_packages="qemu-system-x86-core edk2-ovmf" ;; \
      aarch64) vm_packages="qemu-system-aarch64-core edk2-aarch64" ;; \
      *) exit 1 ;; \
    esac && test "$(rpm --eval '%{_arch}')" = "$TARGET_ARCH" && \
    dnf5 -y install --setopt=install_weak_deps=False --repo=fedora lorax-44.6-1.fc44 && \
    dnf5 -y install --setopt=install_weak_deps=False \
      xorriso createrepo_c squashfs-tools erofs-utils mtools dosfstools isomd5sum \
      ${vm_packages} qemu-img python3 util-linux e2fsprogs file cpio findutils \
      ostree ostree-libs python3-gobject-base gnupg2 fedora-gpg-keys diffutils dconf glib2 && \
    dnf5 clean all
# Retain the cached common tools layer when adding the GRUB grammar check.
# Lorax dependencies may already supply this package on either architecture.
RUN rpm -q grub2-tools >/dev/null 2>&1 || \
    { dnf5 -y install --setopt=install_weak_deps=False grub2-tools && dnf5 clean all; }
