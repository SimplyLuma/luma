#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# A shared developer image selects presentation from its per-session NoCloud seed.
set -euo pipefail
[ "$(id -u)" = 0 ]
[ -f /etc/luma/tester-image ]
profile=${1:-}
if [ -z "$profile" ] && [ -r /etc/luma-tester-target ]; then
  IFS= read -r profile </etc/luma-tester-target || true
fi
case "$profile" in
  mobile) device_class=handheld ;;
  desktop) device_class=desktop ;;
  *) printf 'error: tester target must be mobile or desktop\n' >&2; exit 2 ;;
esac
install -Dm644 /usr/share/luma-tester/profiles/desktop.dconf /etc/dconf/db/luma.d/00-luma-desktop
if [ "$profile" = mobile ]; then
  install -Dm644 /usr/share/luma-tester/profiles/mobile.dconf /etc/dconf/db/luma.d/10-luma-handheld
else
  rm -f /etc/dconf/db/luma.d/10-luma-handheld
fi
printf '%s\n' "$device_class" >/etc/luma-device-class
cat >/etc/environment.d/90-luma-tester.conf <<ENV
LUMA_DEVICE_CLASS=$device_class
LUMA_MUTTER_ALLOW_SOFTWARE_BLUR=1
ENV
# Keep the build identity; update only this session's presentation field.
sed -i "s/^LUMA_TESTER_TARGET=.*/LUMA_TESTER_TARGET=$profile/" /etc/luma/tester-image
dconf update
printf 'Luma Tester profile selected: %s (%s)\n' "$profile" "$device_class"
