 #include "ui/egl-helpers.h"
 #include "ui/egl-context.h"
 #include "ui/shader.h"
+#include "system/system.h"
+#include "system/system.h"
+
+/* Native desktop OpenGL for Darwin headless readback. ANGLE's GLES-only
+ * context cannot expose desktop GL features needed by modern Linux shells. */
+#ifdef CONFIG_DARWIN
+#include <OpenGL/OpenGL.h>
+static CGLPixelFormatObj headless_pixel;
+static CGLContextObj headless_cgl;
+static bool headless_use_cgl;
+
+static CGLContextObj headless_cgl_create(CGLContextObj shared)
+{
+    CGLContextObj context = NULL;
+    CGLError result = CGLCreateContext(headless_pixel, shared, &context);
+    if (result != kCGLNoError) {
+        error_report("cgl-headless: %s", CGLErrorString(result));
+        return NULL;
+    }
+    return context;
+}
+#endif
+
+static void headless_make_current(void)
+{
+#ifdef CONFIG_DARWIN
+    if (headless_use_cgl) {
+        CGLSetCurrentContext(headless_cgl);
+        return;
+    }
+#endif
+    eglMakeCurrent(qemu_egl_display, EGL_NO_SURFACE,
+                   EGL_NO_SURFACE, qemu_egl_rn_ctx);
+}
+
+static void headless_destroy_context(DisplayGLCtx *ctx, QEMUGLContext context)
+{
+#ifdef CONFIG_DARWIN
+    if (headless_use_cgl) {
+        CGLDestroyContext((CGLContextObj)context);
+        return;
+    }
+#endif
+    qemu_egl_destroy_context(ctx, context);
+}
+
+static int headless_context_current(DisplayGLCtx *ctx, QEMUGLContext context)
+{
+#ifdef CONFIG_DARWIN
+    if (headless_use_cgl) {
+        return CGLSetCurrentContext((CGLContextObj)context) == kCGLNoError ? 0 : -1;
+    }
+#endif
+    return qemu_egl_make_context_current(ctx, context);
+}
 
 typedef struct egl_dpy {
     DisplayChangeListener dcl;
@@ -45,6 +100,15 @@
 static QEMUGLContext egl_create_context(DisplayGLCtx *dgc,
                                         QEMUGLParams *params)
 {
+#ifdef CONFIG_DARWIN
+    if (headless_use_cgl) {
+        if (params->major_ver > 4 ||
+            (params->major_ver == 4 && params->minor_ver > 1)) {
+            return NULL;
+        }
+        return headless_cgl_create(headless_cgl);
+    }
+#endif
     return qemu_egl_create_context(dgc, params, qemu_egl_rn_ctx);
 }
 
