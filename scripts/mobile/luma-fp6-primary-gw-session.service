[Unit]
Description=Project Luma FP6 primary eSIM provisioning session
After=rmtfs.service tqftpserv.service luma-fp6-carrier-pdc.service
Wants=rmtfs.service tqftpserv.service luma-fp6-carrier-pdc.service
Before=ModemManager.service luma-fp6-cellular-link.service luma-fp6-imsd.service
ConditionPathExists=/sys/firmware/devicetree/base/model

[Service]
Type=oneshot
ExecStart=/usr/libexec/luma-fp6-primary-gw-session
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_QIPCRTR

[Install]
WantedBy=multi-user.target
