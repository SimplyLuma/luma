# Pixel 9: power_allocator held the mid and little CPUs and the GPU at low
# steps at ~53 C; step_wise throttles them only past the 70 C passive trip.
# The X4 (big-thermal) stays on power_allocator: under step_wise it reached
# 98 C before throttling. The 115 C critical trips are unchanged.
ACTION=="add|change", SUBSYSTEM=="thermal", KERNEL=="thermal_zone*", ATTR{type}=="mid-thermal|little-thermal|g3d-thermal", ATTR{policy}="step_wise"
