#!/bin/sh
# SPDX-License-Identifier: Apache-2.0

set -eu

export LUMA_DEVICE_CLASS=${LUMA_DEVICE_CLASS:-handheld}
export LUMA_PRESENTATION_MODE=${LUMA_PRESENTATION_MODE:-fullscreen-mobile}
export LUMA_INPUT_MODE=${LUMA_INPUT_MODE:-touch}
export WAYLAND_DISPLAY=/run/luma-display/wayland-0

# The display belongs to the persistent pre-authentication compositor, but all
# user-session IPC must belong to the authenticated account. greetd itself is
# reached from the greeter's user session, so inherited D-Bus/runtime variables
# are untrusted here even when they are non-empty.
user_runtime=/run/user/$(id -u)
export XDG_RUNTIME_DIR=$user_runtime
export DBUS_SESSION_BUS_ADDRESS=unix:path=$user_runtime/bus

# The user bus is not necessarily listening the instant this session starts.
# greetd's autologin runs at boot alongside user@1000.service, and the bus
# socket has been observed appearing a second later; bailing out immediately
# killed the session and dropped the phone back to the greeter. Wait a bounded
# while for it rather than racing it.
bus_deadline=$(( $(date +%s) + 15 ))
while [ ! -S "$XDG_RUNTIME_DIR/bus" ]; do
  if [ "$(date +%s)" -ge "$bus_deadline" ]; then
    printf 'Authenticated user bus never appeared: %s\n' "$XDG_RUNTIME_DIR/bus" >&2
    exit 1
  fi
  sleep 0.1
done

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=phosh
export XDG_CURRENT_DESKTOP=Phosh:GNOME
export DESKTOP_SESSION=phosh

# Phoc is owned by the persistent pre-authentication session. This process is
# deliberately only the authenticated GNOME/Phosh client session.
# Hand the session's environment to the user manager before starting anything
# under it, so services it launches inherit the display rather than guessing.
systemctl --user import-environment \
  WAYLAND_DISPLAY XDG_RUNTIME_DIR XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
  XDG_CURRENT_DESKTOP DESKTOP_SESSION LUMA_DEVICE_CLASS LUMA_PRESENTATION_MODE \
  LUMA_INPUT_MODE 2>/dev/null || true

exec gnome-session --session=phosh
