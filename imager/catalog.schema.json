{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SimplyLuma/luma/imager/catalog.schema.json",
  "title": "Luma Imager catalog (catalog.json, schema 1)",
  "description": "Generated by tools/build-imager-catalog.py and signed with the update-graph minisign key. See docs/imager-catalog.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_utc", "imager", "desktop", "mods", "phones"],
  "properties": {
    "schema": {"const": 1},
    "generated_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "imager": {
      "type": "object", "additionalProperties": false, "required": ["min_version"],
      "properties": {"min_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}
    },
    "desktop": {
      "type": "object", "additionalProperties": false,
      "required": ["architectures", "channels", "hub_catalog_url", "guide"],
      "properties": {
        "architectures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/architecture"}},
        "channels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/channel"}},
        "hub_catalog_url": {"$ref": "#/$defs/url"},
        "guide": {"$ref": "#/$defs/guide"}
      }
    },
    "mods": {"type": "array", "items": {"$ref": "#/$defs/mod"}},
    "phones": {"type": "array", "items": {"$ref": "#/$defs/phone"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64},
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "url": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+/[A-Za-z0-9._~/%?&=+-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["available", "coming_soon", "unavailable"]},
    "arch": {"enum": ["x86_64", "aarch64"]},
    "guide": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "body"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 80},
          "body": {"$ref": "#/$defs/text"}
        }
      }
    },
    "architecture": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/arch"},
        "name": {"type": "string", "minLength": 1, "maxLength": 40},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "channel": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "status"],
      "properties": {
        "id": {"enum": ["nightly", "beta", "stable"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 40},
        "default": {"type": "boolean"},
        "status": {"$ref": "#/$defs/status"},
        "index_url": {"$ref": "#/$defs/url"}
      }
    },
    "mod": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "summary", "arch", "status", "kind", "note", "suggest_when"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "summary": {"$ref": "#/$defs/text"},
        "arch": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/arch"}},
        "status": {"$ref": "#/$defs/status"},
        "kind": {"enum": ["derived_channel", "macos_installer"]},
        "note": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "suggest_when": {
          "type": ["object", "null"], "additionalProperties": false, "minProperties": 1,
          "properties": {"dmi_sys_vendor": {"type": "string", "minLength": 1, "maxLength": 80}}
        }
      }
    },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["role", "name", "url", "sha256", "size_bytes"],
      "properties": {
        "role": {"enum": ["boot", "system", "sd_image", "checksums", "other"]},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128},
        "url": {"$ref": "#/$defs/url"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "release": {
      "type": "object", "additionalProperties": false, "required": ["name", "date", "files"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
      }
    },
    "phone": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "vendor", "codename", "name", "summary", "picture_url", "tier", "status", "method",
                   "fastboot_product", "never_write", "needs", "release", "guide"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "vendor": {"$ref": "#/$defs/id"},
        "codename": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "summary": {"$ref": "#/$defs/text"},
        "picture_url": {"anyOf": [{"$ref": "#/$defs/url"}, {"type": "null"}]},
        "tier": {"enum": ["supported", "community", "experimental"]},
        "status": {"$ref": "#/$defs/status"},
        "method": {"enum": ["fastboot_bundle", "sd_card", "none"]},
        "fastboot_product": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+$"},
        "never_write": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "needs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "release": {"anyOf": [{"$ref": "#/$defs/release"}, {"type": "null"}]},
        "guide": {"$ref": "#/$defs/guide"}
      }
    }
  }
}
